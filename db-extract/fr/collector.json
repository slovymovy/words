                    }
                ],
                "senses": [
                    {
                        "sense_id": "273f433a-758d-3e43-9408-3937c0636200",
                        "entry_id": "9eb88d12-b9b1-3247-92d9-5ab9fd3bc2a6",
                        "glosses": [
                            "En édition spéciale ou limitée, en général destinée aux collectionneurs."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f5eae6c8-048a-4668-a902-d65735c05fcd",
                                "sense_id": "273f433a-758d-3e43-9408-3937c0636200",
                                "text": "Seuls des « films évènements » bénéficient parfois d’une édition collector en tirage limité, mais cette édition ne modifie pas le film ni même l’objet DVD : l’éditeur se contente de sertir le DVD standard et son boîtier d’une simple boîte cartonnée plus grande, et d’ajouter des photos des acteurs, des photos du tournage ou des gadgets."
                            },
                            {
                                "example_id": "bba1befb-cd96-458d-ab75-9b22fbd6e22f",
                                "sense_id": "273f433a-758d-3e43-9408-3937c0636200",
                                "text": "Ce coffret comprend un Nokia 3330, une carte avec un code secret permettant de télécharger gratuitement deux écrans de veille (un fixe et un animé), ainsi qu’un livre collector exclusif de 32 pages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44994f89-bfde-45f7-b4be-ec5391e6059e",
                        "source_entry_id": "9eb88d12-b9b1-3247-92d9-5ab9fd3bc2a6",
                        "source_sense_id": "273f433a-758d-3e43-9408-3937c0636200",
                        "target_lang_word": "collectible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collectible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41cf66c6-7ea6-3db3-8542-5bcd83cdd1b0",
                                        "entry_id": "149c5a66-444e-3e4a-b46c-6cceefe5d5f4",
                                        "glosses": [
                                            "Worthy or suitable for collecting on historical/financial grounds, or for meeting a personal aesthetic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d437d7df-951e-4e5a-9557-85536aeee645",
                                                "sense_id": "41cf66c6-7ea6-3db3-8542-5bcd83cdd1b0",
                                                "text": "collectible stamps, collectible china, collectible Beatles memorabilia"
                                            },
                                            {
                                                "example_id": "ddf16d21-70c1-4d21-8857-44e1399d2e8e",
                                                "sense_id": "41cf66c6-7ea6-3db3-8542-5bcd83cdd1b0",
                                                "text": "With the lifting of his “depression,” he’d developed a new interest, hobbylike in its intensity, in framable and collectible railroad memorabilia, and he could happily have spent the whole day—the whole week!—pursuing it. . ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35683f27-af6a-397d-b07d-23617070dad2",
                                        "entry_id": "149c5a66-444e-3e4a-b46c-6cceefe5d5f4",
                                        "glosses": [
                                            "Rightfully subject to payment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14d14ae-5541-46b8-9fec-20a5a9382db6",
                                                "sense_id": "35683f27-af6a-397d-b07d-23617070dad2",
                                                "text": "a collectible bill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c82806e-eb49-30db-a9e3-8fc9a8618300",
                                        "entry_id": "149c5a66-444e-3e4a-b46c-6cceefe5d5f4",
                                        "glosses": [
                                            "That is likely to be paid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167250a3-fee0-4c0f-afb1-f747ccbfa253",
                                                "sense_id": "6c82806e-eb49-30db-a9e3-8fc9a8618300",
                                                "text": "He's owed it to us for six months, but it doesn't look very collectible to me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
