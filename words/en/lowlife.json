    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07c35a29-3ffd-3b8c-bc73-2bbfa682fa89",
                    "sense_definition": "An untrustworthy, despicable, or disreputable person, especially one suspected of being a criminal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disreputable person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police warned the residents about a group of <w>lowlifes</w> hanging around the alleyway.",
                            "target_lang_translations": {
                                "ru": "Полиция предупредила жителей о группе <w>подонков</w>, ошивающихся в переулке."
                            }
                        },
                        {
                            "text": "He was known as a local <w>lowlife</w> who spent most of his time plotting petty crimes.",
                            "target_lang_translations": {
                                "ru": "Он был известен как местный <w>отморозок</w>, который проводил большую часть времени, планируя мелкие преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "criminal and Thesaurus:jerk"
                    ],
                    "antonyms": [
                        "gentleman",
                        "saint"
                    ],
                    "common_phrases": [
                        "local lowlife",
                        "criminal lowlife"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a derogatory term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ненадежный, подлый или пользующийся дурной славой человек, особенно подозреваемый в преступной деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отморозок",
                                "target_lang_sense_clarification": "человек без нравственных принципов"
                            },
                            {
                                "target_lang_word": "сволочь",
                                "target_lang_sense_clarification": "подлый, скверный человек"
                            },
                            {
                                "target_lang_word": "подонок",
                                "target_lang_sense_clarification": "ничтожный, преступный элемент"
                            },
                            {
                                "target_lang_word": "шваль",
                                "target_lang_sense_clarification": "ничтожный, опустившийся человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "161b5814-828b-3ec0-918a-1dab5f6f62bd",
                    "sense_definition": "A person of low socio-economic status, especially one associated with an illicit or disreputable background.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disreputable person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie depicts the gritty reality of <w>lowlifes</w> living on the fringes of the city.",
                            "target_lang_translations": {
                                "ru": "Фильм изображает суровую реальность <w>отбросов общества</w>, живущих на окраинах города."
                            }
                        },
                        {
                            "text": "He managed to escape his past as a <w>lowlife</w> and built a successful legal career.",
                            "target_lang_translations": {
                                "ru": "Ему удалось сбежать от своего прошлого <w>ничтожества</w> и построить успешную юридическую карьеру."
                            }
                        }
                    ],
                    "antonyms": [
                        "aristocrat",
                        "elite"
                    ],
                    "common_phrases": [
                        "urban lowlife"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory and socio-economic connotation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек низкого социально-экономического статуса, часто связанный с незаконной или сомнительной средой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сброд",
                                "target_lang_sense_clarification": "собирательное название для людей из низов общества"
                            },
                            {
                                "target_lang_word": "отбросы общества",
                                "target_lang_sense_clarification": "люди на задворках жизни"
                            },
                            {
                                "target_lang_word": "низы",
                                "target_lang_sense_clarification": "социально неблагополучные слои"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf5ec124-a29f-3d33-b28a-015168d858da",
                    "sense_definition": "Lacking morality or having a despicable character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "immoral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was criticized for his <w>lowlife</w> tactics during the election campaign.",
                            "target_lang_translations": {
                                "ru": "Политика критиковали за его <w>подлые</w> методы во время предвыборной кампании."
                            }
                        },
                        {
                            "text": "She refused to associate with such <w>lowlife</w> individuals who had no sense of ethics.",
                            "target_lang_translations": {
                                "ru": "Она отказывалась общаться с такими <w>низкими</w> личностями, у которых не было чувства этики."
                            }
                        }
                    ],
                    "antonyms": [
                        "moral",
                        "honorable"
                    ],
                    "common_phrases": [
                        "lowlife tactics",
                        "lowlife behavior"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal derogatory adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный морали или обладающий подлым характером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "о поведении или характере"
                            },
                            {
                                "target_lang_word": "низкий",
                                "target_lang_sense_clarification": "бесчестный, недостойный"
                            },
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "о методах или поступках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfaec629-3338-39a8-a23f-5a837d739bd9",
                    "sense_definition": "Seemingly mischievous and troublesome to society.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "immoral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighborhood was plagued by <w>lowlife</w> activities that kept the residents on edge.",
                            "target_lang_translations": {
                                "ru": "Район страдал от <w>криминальной</w> деятельности, которая держала жителей в напряжении."
                            }
                        },
                        {
                            "text": "He had a <w>lowlife</w> reputation that made it difficult for him to find a steady job.",
                            "target_lang_translations": {
                                "ru": "У него была <w>дурная</w> репутация, из-за которой ему было трудно найти постоянную работу."
                            }
                        }
                    ],
                    "antonyms": [
                        "law-abiding",
                        "respectable"
                    ],
                    "common_phrases": [
