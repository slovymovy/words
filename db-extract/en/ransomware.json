                                        "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                        "entry_id": "5daef05f-8e55-3123-b230-f093168202d7",
                                        "glosses": [
                                            "Schadsoftware, die Daten auf fremden Computern verschlüsselt und nur gegen eine Zahlung von Geld oder Internetwährungen wieder entschlüsselt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4348ee9b-cfb9-4f25-b0dc-b7c435e0318d",
                                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                                "text": "„Wahrscheinlich gelangte die Ransomware über eine infizierte E-Mail in das Netzwerk der Polizeistation von Midlothian, sagte der mit dem Fall befasste IT-Fachmann Calvin Harden der amerikanischen Zeitung.“"
                                            },
                                            {
                                                "example_id": "eab9c85e-3a8b-446e-aaa1-3f46391ff019",
                                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                                "text": "„Kaspersky Lab ist es gelungen, die Verschlüsselung der Ransomware CryptXXX zu knacken.“"
                                            },
                                            {
                                                "example_id": "141ffff3-f9d2-4177-b023-4603bb05886e",
                                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                                "text": "„Inzwischen gibt es bei einigen Ransomwares Lösungen, wie man die Daten auch ohne das Bezahlen des Lösegelds wieder entschlüsselt bekommt.“"
                                            },
                                            {
                                                "example_id": "001b2fd0-98c1-496c-aca7-f82301f1d366",
                                                "sense_id": "711fea22-6cb5-39e0-98c5-b7eff9eba7cb",
                                                "text": "„Bereits drei Mal in diesem Jahr haben Ransomwares wie ‚Locky‘, ‚Fanton‘ oder ‚Stampado‘ Schlagzeilen gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
