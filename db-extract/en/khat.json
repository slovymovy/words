                                            {
                                                "example_id": "c8f36761-3b8a-4f6d-9798-89ed94d833a4",
                                                "sense_id": "3ba6f44a-b849-3d1a-9bb7-2487fe9317d0",
                                                "text": "Раз кат, два кат, три кат… — повторяла запыхавшаяся от усталости Катя, перекатывая огромный снежный ком для создания снежной бабы."
                                            },
                                            {
                                                "example_id": "02664b8f-f42d-4ccb-86cc-1e8c38177cfc",
                                                "sense_id": "3ba6f44a-b849-3d1a-9bb7-2487fe9317d0",
                                                "text": "Кат, кат — перекат!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
