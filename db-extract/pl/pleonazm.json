                "translations": [
                    {
                        "translation_id": "7d7da462-1925-45a9-9e13-cb8721381ec1",
                        "source_entry_id": "c577e165-cc05-3ee2-a9e5-4c0ca48ec638",
                        "source_sense_id": "ef1642a0-f46d-3578-88d4-ea42d6ff7e61",
                        "target_lang_word": "pleonasm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleonasm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                        "entry_id": "fc3b30a6-889e-3b24-9e6d-8b9e5d074e70",
                                        "glosses": [
                                            "Redundancy in wording."
                                        ],
                                        "tags": [
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16967a0f-f97d-4ec2-9314-aeaa2692e01f",
                                                "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                                "text": "St. Jerome and St. Augustine are both sparing in the employment of the device of pleonasm."
                                            },
                                            {
                                                "example_id": "578bed0b-b25a-400f-a453-2ede51da62b4",
                                                "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                                "text": "Indeed, pleonasm, the use of superfluous or redundant words, is only part of the broader features of that style, the expressions of which have been so thoroughly analyzed by Franz Neirynck² and which for convenience will here be referred to as \"dualisms.\""
                                            },
                                            {
                                                "example_id": "6f332293-2efb-4858-bc02-a7d4d0a9095e",
                                                "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                                "text": "My salvation is in my Saviour who saveth me hence the redundancy and pleonasm of my asseveration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23c870b0-5fdc-3367-91d3-620a1722106a",
                                        "entry_id": "fc3b30a6-889e-3b24-9e6d-8b9e5d074e70",
                                        "glosses": [
                                            "A phrase involving pleonasm; a phrase containing one or more words which are redundant because their meaning is expressed elsewhere in the phrase."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb206031-8b14-48f8-9539-0338f314841b",
                        "source_entry_id": "c577e165-cc05-3ee2-a9e5-4c0ca48ec638",
                        "source_sense_id": "ef1642a0-f46d-3578-88d4-ea42d6ff7e61",
