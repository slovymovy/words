                ],
                "senses": [
                    {
                        "sense_id": "9492b885-1e94-350c-adb9-eaf8eeee5354",
                        "entry_id": "49cab957-66b8-3022-b3da-64f4aeed119a",
                        "glosses": [
                            "Adverb, dessen Bedeutung einen Zeitbezug herstellt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554c2a66-0674-41e3-af8a-075baa3c3c25",
                                "sense_id": "9492b885-1e94-350c-adb9-eaf8eeee5354",
                                "text": "In dem Satz: \"Zuerst kommt Inge, danach erst Peter\" sind \"zuerst\" und \"danach\" Temporaladverbien."
                            },
                            {
                                "example_id": "97ab1614-83fb-4da8-b634-55661a269d90",
                                "sense_id": "9492b885-1e94-350c-adb9-eaf8eeee5354",
                                "text": "Temporaladverbien können Zeitpunkt, Dauer oder Wiederholung angeben."
                            },
                            {
                                "example_id": "70e65cda-5116-421c-a21a-c57c7cbfe86d",
                                "sense_id": "9492b885-1e94-350c-adb9-eaf8eeee5354",
                                "text": "„Durch das Temporaladverb »diesmal« wird die Parallelität der Vorgänge auf unerträgliche Weise verstärkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
