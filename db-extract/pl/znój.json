                                            {
                                                "example_id": "0f8b38fd-b35a-4df7-8edd-ae19a1ae6390",
                                                "sense_id": "2ebf1fd0-e122-398f-860b-31a0e1efb05d",
                                                "text": "If train services of this kind were to be cut off, without any provision of alternative services, there would, of course, be hardship in some cases."
                                            },
                                            {
                                                "example_id": "740adedf-9da8-45d1-86fa-a8accdc6a22f",
                                                "sense_id": "2ebf1fd0-e122-398f-860b-31a0e1efb05d",
                                                "text": "The TUCC's role was to assess what (if any) hardship a BR closure proposal would cause, and to make recommendations to ministers who would have the final say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0a4aa9-6fa6-30ff-ab0b-4417bd57a20b",
                                        "entry_id": "267a1dd3-0455-3a46-9e63-4550547b2f36",
                                        "glosses": [
                                            "A burden, a source of difficulty that could impose a barrier."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7ed1e56-b6fc-46dc-a821-5af3f314fcee",
                                                "sense_id": "3c0a4aa9-6fa6-30ff-ab0b-4417bd57a20b",
                                                "text": "When you visit the museum, we invite you to make a donation of $10 if this will not be a hardship."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hardship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1816017-f2a1-31ac-8fa3-f8d3d4295bb5",
                                        "entry_id": "9160abe5-f4e0-34f7-a1ae-0866e7f5baa7",
                                        "glosses": [
                                            "To treat (a person) badly; to subject to hardships."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3268a18c-8958-46b3-b04f-d5d4ffe416b4",
                                                "sense_id": "f1816017-f2a1-31ac-8fa3-f8d3d4295bb5",
                                                "text": "[…] an adjustment of the income tax could easily produce the twenty millions without hardshipping any industrious person in the community […]"
                                            },
                                            {
                                                "example_id": "f248b0aa-aef8-4bf0-8934-852e466b09eb",
                                                "sense_id": "f1816017-f2a1-31ac-8fa3-f8d3d4295bb5",
                                                "text": "Although we lost the election by the narrowest of margins, the people of Oregon heard a great deal about education, and particularly about how \"look-say\" reading instruction was hardshipping Oregon school children."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f29ee9a7-020b-4ab7-a829-2f916aff4e06",
                        "source_entry_id": "61416636-d093-34e6-b839-93c631594909",
                        "source_sense_id": "bc9d53ff-2392-331a-91b2-8ec9c434b0eb",
                        "target_lang_word": "Mühe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mühe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                        "entry_id": "1284be3e-709c-3116-9fff-895ba9322401",
                                        "glosses": [
                                            "körperliche oder geistige Anstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62147a17-1767-4a83-ba50-003688c8cbbc",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "Sie erledigte ihre Aufgabe mit viel Mühe und es war dennoch zu wenig."
                                            },
                                            {
                                                "example_id": "b743ade3-f0f7-4525-ac27-ec1b1f13ec7a",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "Mit viel Mühe fanden sie den richtigen Weg."
                                            },
                                            {
                                                "example_id": "fba9e893-eb83-4fa1-b566-a2dc02670276",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "Vielen Dank für deine Mühen."
                                            },
                                            {
                                                "example_id": "5100fc46-462d-433a-864b-e758f0c38dab",
                                                "sense_id": "f4df0c4a-1ad4-3649-afd7-aa67902bb300",
                                                "text": "„[Der Entwickler Michael] Stapelberg [schreibt], dass technische Veränderungen in Debian nur sehr langsam und mit großer Mühe umsetzbar seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mühe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                        "entry_id": "80290248-517b-3144-af58-7d465277a65f",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5429fbff-aee4-4d0b-8292-7e0cdde26737",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Herr Mühe war mir vom ersten Moment an sympathisch."
                                            },
                                            {
                                                "example_id": "80cf710e-2acd-40e8-8c30-7b413e5cb567",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Frau Mühe ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "93301224-4850-4fa1-9222-8c7c127e95d7",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Herr Mühe wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "559c500d-56c0-4a62-bd2f-3a13c05bfee0",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Die Mühes fliegen heute nach Boston."
                                            },
                                            {
                                                "example_id": "1d5af4c1-e775-4587-b849-6894a4db85a8",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Der Mühe trägt nie die Pullover, die die Mühe ihm strickt."
                                            },
                                            {
                                                "example_id": "94955646-9824-41f0-912b-912d3e535161",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mühe kommt, geht der Herr Mühe.“"
                                            },
                                            {
                                                "example_id": "953f27b6-f831-45d6-95a7-875af045b62e",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Mühe kommt und geht."
                                            },
                                            {
                                                "example_id": "9dd201ee-8f68-4b68-8434-0a2cba34716f",
                                                "sense_id": "5c8e2734-6af7-3ab2-abdb-ad38683a5191",
                                                "text": "Mühes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
