                        ],
                        "examples": [
                            {
                                "example_id": "270d918e-a29d-49f7-9c2e-fbf4ff91debf",
                                "sense_id": "02da71ff-e03e-34bc-b178-af93197c431f",
                                "text": "Auch an Geschichtsklitterung grenzende größenwahnsinnige Projekte wie das Berliner Humboldt Forum haben eine Diskussion ausgelöst, die für das lange mit Gedächtnisschwund behaftete Kapitel deutscher Gewaltgeschichte in Übersee sensibilisiert."
                            },
                            {
                                "example_id": "4ecfcadc-2c86-48db-a06f-0ef7fea63c04",
                                "sense_id": "02da71ff-e03e-34bc-b178-af93197c431f",
                                "text": "Wo sind eigentlich die Fachleute, die ernsthaft den Dialog mit den linksrheinischen Experten suchen über so demokratieuntaugliche Dinge wie das Präsidialsystem, das Mehrheitswahlrecht, das Zwei-Klassen-Bildungssystem, Geschichtsklitterung, die Zerschlagung von Parteien und ihr Ersetzen durch „mouvements“?"
                            }
                        ]
                    }
