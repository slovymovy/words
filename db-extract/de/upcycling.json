                                        "glosses": [
                                            "bewerken van afval tot hoogwaardige materialen of producten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2142a35-6d11-4562-ad5e-680fdefa199e",
                                                "sense_id": "0cb8939e-960f-3d51-ad5a-3e24dba6b05e",
                                                "text": "Hergebruik en upcycling waren in het werk van de ontwerpers die hier hun werk presenteerden eerder regel dan uitzondering."
                                            },
                                            {
                                                "example_id": "1759c75f-48a7-4b01-9909-d161b6819d6c",
                                                "sense_id": "0cb8939e-960f-3d51-ad5a-3e24dba6b05e",
                                                "text": "Hier is sprake van ‘upcycling’: uit oude materialen worden geen laagwaardiger, maar hoogwaardiger producten gemaakt."
                                            }
