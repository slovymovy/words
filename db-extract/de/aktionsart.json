                        "form": "den Aktionsarten"
                    },
                    {
                        "form_id": "6cbec50d-50ea-4426-bfbe-14778289dfde",
                        "entry_id": "774abbb5-5376-3020-a318-9df875302ad0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Aktionsart"
                    },
                    {
                        "form_id": "e7d0b44c-075f-4488-949d-45844c986de0",
                        "entry_id": "774abbb5-5376-3020-a318-9df875302ad0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Aktionsarten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cbfbea1a-c188-37aa-8b7c-8f8d7da1bcd1",
                        "entry_id": "774abbb5-5376-3020-a318-9df875302ad0",
                        "glosses": [
                            "lexikalische/semantische Kategorie des Verbs; spezifische Bedeutung eines Verbs hinsichtlich der Art und Weise, wie das im Verb Ausgedrückte verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f64e988-05a7-452a-b9eb-dd599ce35b1c",
                                "sense_id": "cbfbea1a-c188-37aa-8b7c-8f8d7da1bcd1",
                                "text": "Das Deutsche hat im angegebenen Sinne Aktionsarten, wie auch die Beispiele zeigen, aber keinen Aspekt."
                            },
                            {
                                "example_id": "936a278a-5ff6-48c4-a8d3-1ef366803371",
                                "sense_id": "cbfbea1a-c188-37aa-8b7c-8f8d7da1bcd1",
                                "text": "„In der nichtslavistischen Literatur werden die Begriffe Aspekt und Aktionsart meist noch undifferenziert gebraucht…“"
                            },
                            {
                                "example_id": "7e4461f0-419c-45c3-8d8f-2c6d561563b5",
                                "sense_id": "cbfbea1a-c188-37aa-8b7c-8f8d7da1bcd1",
                                "text": "„So verfügen wir z. B. mit Verbalpräfixen über Mittel zur Bildung von Verben bestimmter Aktionsarten: verblühen, zerlegen, loslaufen sind egressive und ingressive Verben, d. h. sie bezeichnen Ende und Beginn der Handlung oder des Prozesses....“"
                            },
                            {
                                "example_id": "a0d7a3fb-7840-4a44-8258-a9d182984713",
                                "sense_id": "cbfbea1a-c188-37aa-8b7c-8f8d7da1bcd1",
                                "text": "Aktionsarten werden in der Verbbedeutung ausgedrückt, Aspekte dagegen sind grammatikalisiert und werden durch paradigmatische Beziehungen zwischen Verben ausgedrückt."
                            },
                            {
                                "example_id": "264da032-25c2-4e4d-ac89-e7d49de946c6",
                                "sense_id": "cbfbea1a-c188-37aa-8b7c-8f8d7da1bcd1",
                                "text": "„Wichtig ist nun die Beobachtung, daß viele Präsensformen nicht temporal ausgerichtet sind, sondern die Aktionsart des Iterativen (der Wiederholung) ausdrücken…“"
                            },
                            {
                                "example_id": "02d50cd1-3a68-41ce-9eb7-7a3810ca386d",
                                "sense_id": "cbfbea1a-c188-37aa-8b7c-8f8d7da1bcd1",
                                "text": "„Das Andauern einer Handlung, ihre Intensität, ihre Abgeschlossenheit oder ihr Anfang ( so genannte Aktionsarten) können durch besondere Präfixe (Vorsilben) bezeichnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
