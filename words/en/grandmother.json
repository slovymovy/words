                {
                    "sense_id": "8cd1cfe4-cc9c-3d10-be08-fd6c964e937b",
                    "sense_definition": "A female ancestor or progenitor from whom a person is descended.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ancestry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is often considered the <w>grandmother</w> of modern invention in this field.",
                            "target_lang_translations": {
                                "ru": "Ее часто считают <w>прародительницей</w> современных изобретений в этой области.",
                                "zh": "她常被认为是该领域现代发明的<w>奠基人</w>。"
                            }
                        },
                        {
                            "text": "We must honor the wisdom and struggles of our <w>grandmothers</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны чтить мудрость и борьбу наших <w>прародительниц</w>.",
                                "zh": "我们必须铭记我们<w>祖母</w>辈的智慧与奋斗。"
                            }
                        }
