                                    {
                                        "sense_id": "e931f42c-ea8f-3137-82f0-a7e4bc2de4ac",
                                        "entry_id": "711f1255-63bd-3614-82bc-f7a331fb023d",
                                        "glosses": [
                                            "de drang hebben om iets snel te doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2559bd-32e5-4ce1-97aa-b87c7f1f39bf",
                                                "sense_id": "e931f42c-ea8f-3137-82f0-a7e4bc2de4ac",
                                                "text": "Ik heb haast."
                                            },
                                            {
                                                "example_id": "272ed290-35f1-4aed-9ff4-fa6cf98dd7b9",
                                                "sense_id": "e931f42c-ea8f-3137-82f0-a7e4bc2de4ac",
                                                "text": "Het Duitse reizen staat in het teken van de haast en de productiviteit: zo snel mogelijk van Hamburg naar München in een hard geveerde BMW, met een korte stop voor een vette hap in de Raststätte."
                                            },
                                            {
                                                "example_id": "790ef315-9afa-4a36-9a5d-97e96222db0a",
                                                "sense_id": "e931f42c-ea8f-3137-82f0-a7e4bc2de4ac",
                                                "text": "Ik begrijp al die haast van tegenwoordig niet. Wij vonden 25 kilometer per dag al prima, terwijl jullie nu ruim 40 kilometer per dag doorjakkeren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haast",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6d300c32-60b3-33d9-aa5e-da124205fef6",
                                        "entry_id": "2a0b7e1e-f993-3387-8d07-c5cfe093dd0d",
                                        "glosses": [
                                            "bijna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
