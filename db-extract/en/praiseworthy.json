                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2018aa36-86d1-4ea8-a157-cd98f5a5afa4",
                                                "sense_id": "f838eaa1-ab95-3f24-b1b1-1c9677b24349",
                                                "text": "„Jedes Warenhaus muß ein paar Artikel führen, die gut und preiswürdig sind.“"
