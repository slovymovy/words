{
    "word_family": [
        "opaque",
        "opacify"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4c90bd2-5419-3369-884e-679720a2902c",
                    "sense_definition": "The physical condition of being opaque, preventing light from passing through.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fog increased in <w>opacity</w> until we could hardly see the road ahead."
                        },
                        {
                            "text": "We could not see the bottom of the lake due to the high <w>opacity</w> of the muddy water."
                        }
                    ],
                    "synonyms": [
                        "nontransparency",
                        "opaqueness"
                    ],
                    "antonyms": [
                        "transparency",
                        "clarity"
                    ],
                    "common_phrases": [
                        "high opacity",
                        "degree of opacity"
                    ]
                },
                {
                    "sense_id": "b798e3e6-b622-35ed-b858-9d82886f79ee",
                    "sense_definition": "The quality of being difficult to understand or obscure; lack of transparency or clarity in meaning or process.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_obscurity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics pointed out the deliberate <w>opacity</w> of the committee's decision-making process."
                        },
                        {
                            "text": "The <w>opacity</w> of these new legal regulations has confused many small business owners."
                        }
                    ],
                    "synonyms": [
                        "opaqueness"
                    ],
                    "antonyms": [
                        "transparency",
                        "clarity"
                    ],
                    "common_phrases": [
                        "financial opacity",
                        "opacity of the system"
                    ]
                },
                {
                    "sense_id": "3e3b46bd-fb46-378b-a06e-d226a5053eeb",
                    "sense_definition": "A measurable degree of impenetrability to electromagnetic radiation, such as light or radio waves.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can easily adjust the layer <w>opacity</w> to fifty percent using the image editing software."
                        },
                        {
                            "text": "The measured <w>opacity</w> of a completely clean glass window should be close to zero."
                        }
                    ],
                    "common_phrases": [
                        "layer opacity",
                        "adjust opacity",
                        "measure opacity"
                    ]
                },
                {
                    "sense_id": "23f4d5a3-9830-3dc3-9a91-57991ccfb2a3",
                    "sense_definition": "An opaque spot or area, especially an abnormal spot on an X-ray or inside an organ like the eye or lung.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ophthalmologist examined the patient and detected a small <w>opacity</w> on the cornea."
                        },
                        {
                            "text": "A chest radiograph revealed an irregular <w>opacity</w> in the lower lobe of the left lung."
                        }
                    ],
                    "common_phrases": [
                        "corneal opacity"
                    ]
                }
            ]
        }
    ]
}