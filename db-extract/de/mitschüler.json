                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43c1c31-1335-43e3-8804-9852859b4510",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Emmanuel Macron : \"Il était…\", une ancienne camarade de classe balance sur le président"
                                            },
                                            {
                                                "example_id": "88bcc320-def8-4d43-919a-8497c54d4af4",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Âgée de 11 ans, elle sauve héroïquement son camarade de classe de l'étouffement"
                                            },
                                            {
                                                "example_id": "03ab6567-0d40-4e72-9e7b-9f7635590635",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Une amie et camarade de classe d'Anne Frank décède à 96 ans"
                                            },
                                            {
                                                "example_id": "959dc7bd-fb94-4f77-a980-e48ed9a9b007",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Grâce à la manœuvre de Heimlich, un Américain de 9 ans sauve la vie de son camarade de classe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eebaf35-b825-3334-827b-96da86e01b96",
                                        "entry_id": "81117bbb-1305-3cac-8f35-d3e2a48aa9a4",
                                        "glosses": [
                                            "Personne issue de la même classe sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7801fcfa-4eb1-4427-a7d5-14dee79eb955",
                                                "sense_id": "9eebaf35-b825-3334-827b-96da86e01b96",
                                                "text": "Mais Isa peut compter sur un camarade de classe (dans tous les sens du terme) : son valet Jean-François et sa tête à porter des badges « Les jeunes avec Juppé » avant même que ce soit tendance."
                                            }
