                    {
                        "form_id": "261e23c7-1bd8-479e-b657-521e107f8de6",
                        "entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "tags": [
                            "past"
                        ],
                        "form": "symbolized"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1e1245d-afaf-3511-83f3-1607adaeafb0",
                        "entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "glosses": [
                            "To be symbolic of; to represent."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2b3f88e7-efe8-4ad5-b9d7-3a4f00ba9719",
                                "sense_id": "c1e1245d-afaf-3511-83f3-1607adaeafb0",
                                "text": "The popular late Middle Ages fictional character Robin Hood, dressed in green to symbolize the forest, dodged fines for forest offenses and stole from the rich to give to the poor. But his appeal was painfully real and embodied the struggle over wood."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e342c8a-0b48-31fb-91f3-afd1eacc9f44",
                        "entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "glosses": [
                            "To use symbols; to represent ideas symbolically."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4a6e1c22-311e-3dd1-9dd9-129a5985fc82",
                        "entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "glosses": [
                            "To resemble each other in qualities or properties; to correspond; to harmonize."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "91fc953d-7e7c-48bf-a0ac-62ee24a9b9a8",
                                "sense_id": "4a6e1c22-311e-3dd1-9dd9-129a5985fc82",
                                "text": "The pleasing of colour symbolizeth with the pleasing of any single tone to the ear; but the pleasing of order doth symbolize with harmony."
                            },
                            {
                                "example_id": "febedc22-4d29-457c-b1a3-7d078f2eb67d",
                                "sense_id": "4a6e1c22-311e-3dd1-9dd9-129a5985fc82",
                                "text": "They both symbolize in this, that they love to look upon themselves through multiplying glasses."
                            }
                        ]
                    },
                    {
                        "sense_id": "433958b6-7c2f-3f01-86dc-d000cff87211",
                        "entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "glosses": [
                            "To hold the same faith; to agree."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a6d21c8f-f3e6-4fb8-91e8-4738f0661c0c",
                                "sense_id": "433958b6-7c2f-3f01-86dc-d000cff87211",
                                "text": "The believers in pretended miracles have always previously symbolized with the performers of them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3ebab27-c563-4fd5-a2b2-b07c46309809",
                        "source_entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "source_sense_description": "To be symbolic of; to represent",
                        "target_lang_word": "symboliseren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symboliseren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "09ccbe81-c2cc-3686-831b-46cef10b951b",
                                        "entry_id": "b83936c4-1a74-3d44-92a3-288bb493dd3d",
                                        "glosses": [
                                            "een betekenis hebben die verwijst naar, een kenteken zijn van\\nVaak gezegd van een eenvoudig te herkennen afbeelding of situatie die wordt gebruikt als aanduiding voor iets dat veel ingewikkelder of abstracter is."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8117fdc0-f598-4a2e-a8be-7bd344c1cd4c",
                                                "sense_id": "09ccbe81-c2cc-3686-831b-46cef10b951b",
                                                "text": "De Azteekse adelaar symboliseerde de stichting van de stad Mexico."
                                            },
                                            {
                                                "example_id": "e05fd324-a2ed-4872-807b-0ed74f429a2d",
                                                "sense_id": "09ccbe81-c2cc-3686-831b-46cef10b951b",
                                                "text": "De boom moet de meest gebruikte beeldspraak voor de wetenschap zijn (…). De takken van de boom symboliseren de zich steeds splitsende kennis, de bladeren en vruchten de concrete toepassingen en producten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4990dd91-a15b-4981-8f91-1b9c5b72f2f2",
                        "source_entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "source_sense_description": "To be symbolic of; to represent",
                        "target_lang_word": "symboliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symboliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f761570f-bea1-3acf-9985-cb616e6c9495",
                                        "entry_id": "0e7f8774-6167-37b2-b72f-e971d58fa120",
                                        "glosses": [
                                            "Représenter par un symbole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30f58ed6-5430-4b72-8d29-32aa25ac633f",
                                                "sense_id": "f761570f-bea1-3acf-9985-cb616e6c9495",
                                                "text": "Les vices et les passions dans l'art chrétien sont, comme le diable, symbolisés par des animaux. Pris en général, ils sont figurés par des rats, parce qu'ils dévorent l'âme et rongent celui qui leur donne asile en son cœur, comme l'animal ronge-maille dévore et détruit tout ce qu'il touche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "symboliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "208ad474-03d7-3722-8a9a-c72973f1dcdb",
                                        "entry_id": "0ad0a338-464b-3606-9132-9c113208b8a5",
                                        "glosses": [
                                            "Être en accord ; avoir de la conformité."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48621ed-9df7-44c1-b621-9571fb68c8db",
                                                "sense_id": "208ad474-03d7-3722-8a9a-c72973f1dcdb",
                                                "text": "Le troisième se roidit là-dessus et commence à dire qu'il n'avait que faire de messe, qu'il aimait mieux un bon dîner, et qu'il lui feroit plus de profit. Puis à mesure que sa manie s'augmentait, possédé par ses furies, & touché de l'esprit malin, il commence à vomir une infinité d'exécrables blasphèmes contre Dieu, contre la sainte messe, & contre ses compagnons, voyant qu'ils ne voulaient pas symboliser à sa gourmandise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a189d3d7-3fd9-30b5-88b5-f3ceef75edd4",
                                        "entry_id": "0ad0a338-464b-3606-9132-9c113208b8a5",
                                        "glosses": [
                                            "Parler par symboles."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "865c51e4-16d3-46a2-8abe-326fee8724d1",
                        "source_entry_id": "d6cdc68d-b2c8-3e4c-b303-f33c38b80c85",
                        "source_sense_description": "To be symbolic of; to represent",
                        "target_lang_word": "symbolisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbolisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99865543-53c7-3416-9d3e-8eba1d5aaf75",
                                        "entry_id": "ebc68220-432f-33fc-9430-65da76c98d35",
                                        "glosses": [
                                            "etwas durch ein Merkzeichen, Sinnbild oder Symbol darstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44b2f9c-0c2c-4c97-8cc7-b79d9878a942",
                                                "sense_id": "99865543-53c7-3416-9d3e-8eba1d5aaf75",
                                                "text": "\"Die Linien sollen die Verbundenheit der Menschen miteinander symbolisieren\", erklärt sie einem der knapp 60 Besucher ihrer Kunstaktion und ermutigt ihn, auch etwas auf die Leinwand zu malen."
                                            },
                                            {
                                                "example_id": "b39ace58-4792-4694-8e2a-67b713db21e5",
                                                "sense_id": "99865543-53c7-3416-9d3e-8eba1d5aaf75",
                                                "text": "Wenn der Titel ein Foto ist, muss es Inhalt und Substanz gleichermaßen symbolisieren wie das Bild des knienden Willy Brandt in Warschau."
                                            },
                                            {
                                                "example_id": "60bb2f11-7a8f-45e3-8213-f7b2bd20325a",
                                                "sense_id": "99865543-53c7-3416-9d3e-8eba1d5aaf75",
                                                "text": "Eine künstlerisch mutige, dekonstruktive Fassadengestaltung wäre auch für den Palast der Republik eine Möglichkeit gewesen, die das Ende der DDR und die demokratische Wiedervereinigung besser symbolisieren könnte als der Wiederaufbau des Berliner Stadtschlosses."
                                            },
                                            {
                                                "example_id": "77ea85ab-5e30-4783-ae7b-2bd1dcfda86c",
                                                "sense_id": "99865543-53c7-3416-9d3e-8eba1d5aaf75",
                                                "text": "Leer stehende Büros symbolisieren die Wirtschaftslage."
                                            },
                                            {
                                                "example_id": "a9204feb-8b6c-4c49-9b84-45f1f04d00a6",
                                                "sense_id": "99865543-53c7-3416-9d3e-8eba1d5aaf75",
                                                "text": "Die Flagge der USA, das Sternbanner (»Stars and Stripes«), besteht aus sieben roten und sechs weißen Streifen, die die ersten 13 Staaten der Union symbolisieren, sowie einem blauen Sternenfeld in der linken oberen Ecke, dessen Sterne für die 50 Bundesstaaten stehen. Die Farben symbolisieren Tapferkeit (Rot), Reinheit (Weiß) und Wachsamkeit und Gerechtigtkeit (Blau)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99ce6b6c-d7ab-4761-8548-a43893ca77d0",
