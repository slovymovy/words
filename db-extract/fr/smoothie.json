                                    {
                                        "sense_id": "71f3213c-3426-3f12-a1f2-b329858559a1",
                                        "entry_id": "b7d15edd-fa76-3069-9202-bf7aba9a5781",
                                        "glosses": [
                                            "zachte, half vloeibare puree van groente of fruit gemengd in melk of yoghurt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "657d8dc1-0b61-4e85-b63c-2ad76b7a7430",
                                                "sense_id": "71f3213c-3426-3f12-a1f2-b329858559a1",
                                                "text": "Dit jaar startte SIRE nog een campagne tegen voedselverspilling door huishoudens. Die richt zich op kliekjes. Want die rotte banaan is een potentiële smoothie en een appeloverschot staat gelijk aan zelfgemaakte appelmoes."
                                            },
                                            {
                                                "example_id": "867de8f8-71d4-4cf0-8452-d8f75e993c5c",
                                                "sense_id": "71f3213c-3426-3f12-a1f2-b329858559a1",
                                                "text": "Volgens hem vullen veel mensen hun lichaam enkel met eten, maar voeden ze het niet. \"Daardoor komen ze voedingsstoffen tekort die we wel hard nodig hebben, zoals jodium en magnesium. Met gezonde smoothies en salades kan je deze tekorten weer aanvullen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
