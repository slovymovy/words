    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e3a42e9-b9ce-393a-b716-4c0437194481",
                    "sense_definition": "To commit money or capital in the hope of financial gain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resource_allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>invest</w> his savings in the stock market.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>вложить</w> свои сбережения в фондовый рынок.",
                                "zh": "他决定把积蓄<w>投资</w>到股市里。"
                            }
                        },
                        {
                            "text": "Many companies <w>invest</w> heavily in new technology to stay competitive.",
                            "target_lang_translations": {
                                "ru": "Многие компании <w>инвестируют</w> значительные средства в новые технологии, чтобы оставаться конкурентоспособными.",
                                "zh": "许多公司为了保持竞争力，在新技术上<w>投入</w>了大量资金。"
                            }
                        }
                    ],
                    "antonyms": [
                        "disinvest",
                        "divest"
                    ],
                    "common_phrases": [
                        "invest money",
                        "invest capital",
                        "invest in stocks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вкладывать деньги или капитал в надежде на финансовую прибыль.",
                        "zh": "投入金钱或资本以期获得经济收益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвестировать",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "вкладывать",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投资",
                                "target_lang_sense_clarification": "金融"
                            },
                            {
                                "target_lang_word": "投入",
                                "target_lang_sense_clarification": "资金"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41d590ed-607d-39c0-b081-e488c722b0bf",
                    "sense_definition": "To spend time, energy, or effort on something, especially for some benefit or purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "resource_allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>invested</w> a lot of time in learning to play the piano.",
                            "target_lang_translations": {
                                "ru": "Она <w>вложила</w> много времени в обучение игре на пианино.",
                                "zh": "她在学习弹钢琴上<w>投入</w>了大量时间。"
                            }
                        },
                        {
                            "text": "Teachers <w>invest</w> significant energy in helping their students succeed.",
                            "target_lang_translations": {
                                "ru": "Учителя <w>вкладывают</w> значительную энергию в то, чтобы помочь своим ученикам добиться успеха.",
                                "zh": "老师们<w>倾注</w>了大量精力去帮助学生取得成功。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "invest time",
                        "invest energy",
                        "invest effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тратить время, энергию или усилия на что-либо, особенно ради какой-либо пользы или цели.",
                        "zh": "在某事上花费时间、精力或努力，通常是为了某种利益或目的。"
                    },
                    "translations": {
                        "ru": [
                            {
