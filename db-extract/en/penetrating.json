                                "sense_id": "75ae121f-20d9-312c-b9aa-c6747bfde947",
                                "text": "His novel shows a penetrating insight into the criminal mind."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c9f2317-9f50-48aa-94bf-ebf4d227d71b",
