{
    "word_family": [
        "consonance",
        "consonantal",
        "consonantly",
        "inconsonant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5160a313-ba13-3537-a0af-483b463284c9",
                    "sense_definition": "A speech sound produced by restricting or blocking the flow of air through the mouth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "phonetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The English language has many words that begin with a <w>consonant</w>.",
                            "target_lang_translations": {
                                "ru": "В английском языке много слов, начинающихся на <w>согласный</w>.",
                                "zh": "英语中有很多以<w>辅音</w>开头的单词。"
                            }
                        },
                        {
                            "text": "When you pronounce a <w>consonant</w> like p or b, you briefly stop the airflow with your lips.",
                            "target_lang_translations": {
                                "ru": "Когда вы произносите <w>согласный</w>, такой как «p» или «b», вы на мгновение прерываете поток воздуха губами.",
                                "zh": "当你发像 p 或 b 这样的<w>辅音</w>时，你会用嘴唇短暂地阻断气流。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "consonant sound",
                        "initial consonant",
                        "final consonant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук речи, образующийся при ограничении или блокировке потока воздуха через рот.",
                        "zh": "一种通过限制或阻碍口腔气流而发出的语音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласный",
                                "target_lang_sense_clarification": "звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辅音",
                                "target_lang_sense_clarification": "语音学中的辅音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83b7189d-43fb-3ab4-97b1-ac37b899804e",
                    "sense_definition": "A letter of the alphabet that represents a speech sound produced by restricting airflow.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "phonetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the word cat, the letter c is a <w>consonant</w> and a is a vowel.",
                            "target_lang_translations": {
                                "ru": "В слове «cat» буква «c» — это <w>согласная</w>, а «a» — гласная.",
                                "zh": "在单词 cat 中，字母 c 是<w>辅音字母</w>，而 a 是元音字母。"
                            }
                        },
                        {
                            "text": "Children learn to distinguish between a vowel and a <w>consonant</w> early in school.",
                            "target_lang_translations": {
                                "ru": "В школе дети рано учатся различать гласные и <w>согласные</w>.",
                                "zh": "孩子们在学校很早就学会了区分元音和<w>辅音字母</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "double consonant",
                        "consonant cluster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Буква алфавита, представляющая звук речи, образующийся при ограничении потока воздуха.",
                        "zh": "字母表中代表辅音的字母。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласная",
                                "target_lang_sense_clarification": "буква"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辅音字母",
                                "target_lang_sense_clarification": "书写系统中的辅音字母"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                    "sense_definition": "In agreement or harmony with something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy is <w>consonant</w> with the company's long-term goals.",
                            "target_lang_translations": {
                                "ru": "Новая политика <w>созвучна</w> долгосрочным целям компании.",
                                "zh": "这项新政策与公司的长期目标是<w>一致的</w>。"
                            }
                        },
                        {
                            "text": "His actions were not <w>consonant</w> with his stated beliefs.",
                            "target_lang_translations": {
                                "ru": "Его действия не <w>согласовались</w> с его заявленными убеждениями.",
                                "zh": "他的行为与他所宣称的信仰并不<w>相符</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consistent",
                        "harmonious",
                        "compatible",
                        "accordant"
                    ],
                    "antonyms": [
                        "disconsonant",
                        "dissonant",
                        "discordant"
                    ],
                    "common_phrases": [
                        "consonant with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в согласии или гармонии с чем-либо другим.",
                        "zh": "与某事物一致或和谐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласующийся",
                                "target_lang_sense_clarification": "соответствующий чему-либо"
                            },
                            {
                                "target_lang_word": "созвучный",
                                "target_lang_sense_clarification": "гармонирующий с идеями или целями"
                            },
                            {
                                "target_lang_word": "сообразный",
                                "target_lang_sense_clarification": "соответствующий правилам или целям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一致的",
                                "target_lang_sense_clarification": "与某事相符"
                            },
                            {
                                "target_lang_word": "相符的",
                                "target_lang_sense_clarification": "与原则或目标协调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51135789-bda1-3be6-8dd5-5b7b734705fc",
                    "sense_definition": "Describing sounds or musical notes that are pleasing and harmonious when played together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer used <w>consonant</w> chords to create a sense of peace.",
                            "target_lang_translations": {
                                "ru": "Композитор использовал <w>консонирующие</w> аккорды, чтобы создать ощущение покоя.",
                                "zh": "作曲家使用了<w>协和</w>和弦来营造一种宁静感。"
                            }
                        },
                        {
                            "text": "The <w>consonant</w> tones of the bells echoed through the valley.",
                            "target_lang_translations": {
                                "ru": "<w>Созвучные</w> тона колоколов эхом разносились по долине.",
                                "zh": "钟声<w>和谐</w>的音调在山谷中回荡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harmonious",
                        "accordant"
                    ],
                    "antonyms": [
                        "dissonant",
                        "discordant"
                    ],
                    "common_phrases": [
                        "consonant chords",
                        "consonant intervals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание звуков или музыкальных нот, которые звучат приятно и гармонично при совместном исполнении.",
                        "zh": "描述一起演奏时听起来悦耳和谐的声音或音符。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консонирующий",
                                "target_lang_sense_clarification": "музыкальный термин"
                            },
                            {
                                "target_lang_word": "созвучный",
                                "target_lang_sense_clarification": "гармоничный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "协和的",
                                "target_lang_sense_clarification": "音乐术语"
                            },
                            {
                                "target_lang_word": "和谐的",
                                "target_lang_sense_clarification": "听感悦耳的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e967bab-1c95-396f-acc1-0eddcd91b762",
                    "sense_definition": "Relating to or consisting of consonants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet was known for his complex <w>consonant</w> structures.",
                            "target_lang_translations": {
                                "ru": "Поэт был известен своими сложными <w>консонантными</w> структурами.",
                                "zh": "这位诗人以其复杂的<w>辅音</w>结构而闻名。"
                            }
                        },
                        {
                            "text": "Some languages have a very high <w>consonant</w> density compared to others.",
                            "target_lang_translations": {
                                "ru": "В некоторых языках очень высокая плотность <w>согласных</w> по сравнению с другими.",
                                "zh": "与其他语言相比，某些语言的<w>辅音</w>密度非常高。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к согласным звукам или состоящий из них.",
                        "zh": "与辅音有关的或由辅音组成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласный",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "консонантный",
                                "target_lang_sense_clarification": "состоящий из согласных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辅音的",
                                "target_lang_sense_clarification": "语言学描述"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}