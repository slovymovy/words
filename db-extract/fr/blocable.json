                        "glosses": [
                            "Que l’on peut bloquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b235ad6-aa90-4a70-a438-bde7659cc082",
                                "sense_id": "0d8c0aae-786f-38d1-a9ed-10e0e82d6a0d",
                                "text": "Pour ce qui est du solde des sommes inscrites au crédit du compte bancaire, il est blocable et saisissable dans sa totalité, jusqu’à concurrence des sommes dues évidemment."
                            },
                            {
                                "example_id": "3032f8a6-c705-49b1-9a1f-8fcaa738c998",
                                "sense_id": "0d8c0aae-786f-38d1-a9ed-10e0e82d6a0d",
                                "text": "Cette suspension est blocable et les téléspectateurs ont pu remarquer que le coureur bloquait ou ouvrait selon qu’il se trouvait sur la route ou les pavés."
                            },
                            {
                                "example_id": "77539e7d-581b-4c42-bd4a-00d3dee6a7a4",
                                "sense_id": "0d8c0aae-786f-38d1-a9ed-10e0e82d6a0d",
                                "text": "Ce couteau de poche intègre également un coupe-capsules avec une lame dentée en forme de bec d’oiseau et une grande lame blocable, parfaite pour découper tant fromages que petits plats ou saucisson."
                            }
                        ]
                    }
