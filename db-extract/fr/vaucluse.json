                                "example_id": "e7dd4654-af5f-4fe1-9e51-a9f37eb48f89",
                                "sense_id": "784dc222-34fb-3701-8ba3-4d66f411eb2b",
                                "text": "Le département de Vaucluse ou le département du Vaucluse. (Voir la note d’usage ci-dessous)"
                            },
