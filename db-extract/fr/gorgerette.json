            {
                "entry_id": "fc53a8d0-fc8b-3333-8d5b-a5866f523c14",
                "word": "gorgerette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1ee3474-22b4-4b5e-80fa-7a64569ce0c5",
                        "entry_id": "fc53a8d0-fc8b-3333-8d5b-a5866f523c14",
                        "tags": [
                            "plural"
                        ],
                        "form": "gorgerettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "286f0d10-7f01-3473-962f-4abd13556de9",
                        "entry_id": "fc53a8d0-fc8b-3333-8d5b-a5866f523c14",
                        "glosses": [
                            "Espèce de collerette servant à couvrir la gorge des femmes."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5182b00b-af32-4cf3-b2fe-acdc4f69c0d5",
                                "sense_id": "286f0d10-7f01-3473-962f-4abd13556de9",
                                "text": "Leur fine gorgerette blanche, leur jupe de tiretaine rayée rouge et bleue."
                            },
                            {
                                "example_id": "fa7d054d-ae5e-4c3d-8181-d0caa7eb707c",
                                "sense_id": "286f0d10-7f01-3473-962f-4abd13556de9",
                                "text": "— Son parfum ne se répand pas, parce qu’elle a froid, » reprit Isabelle, en mettant dans sa gorgerette la fleur frileuse."
                            },
                            {
                                "example_id": "2d2e96a0-3557-458f-879c-e8ad259145c1",
                                "sense_id": "286f0d10-7f01-3473-962f-4abd13556de9",
                                "text": "Par la guimpe entrebâillée, je voyais de petites médailles d’argent qui reluisaient au fond de la gorgerette."
                            },
                            {
                                "example_id": "894e4bc4-534d-4f38-9bf1-4d1019a8a4b8",
                                "sense_id": "286f0d10-7f01-3473-962f-4abd13556de9",
                                "text": "C'est ton sein dont la gorgerette\nMe dévoile la blanche chair."
                            },
                            {
                                "example_id": "e11f366c-830f-45fb-8ae6-c9ea7f873926",
                                "sense_id": "286f0d10-7f01-3473-962f-4abd13556de9",
                                "text": "— Une lettre pour Michel Corbier !\nIl tint un moment la lettre haut en humant l’air. — Bigre ! celle-ci ne sent pas le tabac à priser... Une belle fille pourrait la mettre dans sa gorgerette."
                            }
                        ]
                    },
