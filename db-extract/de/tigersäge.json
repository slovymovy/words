                "senses": [
                    {
                        "sense_id": "4b123c37-7d08-3906-a08e-05884ffa2b47",
                        "entry_id": "58650d85-5ddc-371d-90ca-6fa351947cc0",
                        "glosses": [
                            "„handgeführte Elektrosäge mit wie bei einer Stichsäge vorstehendem, hin und her laufendem, an nur einem Ende in der Maschine eingespanntem Sägeblatt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccfe4685-fb8b-487d-9aa7-485c6b08fa98",
                                "sense_id": "4b123c37-7d08-3906-a08e-05884ffa2b47",
                                "text": "„Dazu solltest du eine Kreis- oder Tigersäge verwenden. Wenn der Reifen halbiert ist, miss mit einem Zollstock die lichte Breite des Reifens aus und säge aus dem Kantholz zwei passende Stücke zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
