                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aacdc517-57cf-42d5-9d1d-3a2fae9afda5",
                        "source_entry_id": "b766422d-a1e0-3bc1-824c-6a50fd5162b1",
                        "source_sense_id": "c1e13b1b-c8c8-3994-9caf-9f02142f1bef",
