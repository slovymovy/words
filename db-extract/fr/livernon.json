                        "glosses": [
                            "Commune française, située dans le département du Lot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8867689a-670e-41a6-8021-e4decdff7d1a",
                                "sense_id": "97024df5-4124-34c4-8b36-6d335d63f10c",
                                "text": "Livernon est dominée par son église fortifiée avec clocher et abside romans. La commune possède le dolmen le plus important du Quercy : le dolmen de la Pierre Martine."
                            },
                            {
                                "example_id": "c7b4e4ed-8f9d-41bb-a77c-3f518e0e6021",
                                "sense_id": "97024df5-4124-34c4-8b36-6d335d63f10c",
                                "text": "Selon Gaston de Balzagues, « tout au long de l’Ancien Régime on trouve écrits qui attestent de la permanence d’élevage caprin sur les causses de Martel, Gramat, Livernon et de Limogne ». Il évoque également des textes de notaire du XVIIᵉsiècle qui mentionnent la fabrication de fromage."
                            }
                        ]
                    }
