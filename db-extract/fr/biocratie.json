                "senses": [
                    {
                        "sense_id": "e50c0cfc-7838-37b4-a574-5d29a8c4a60c",
                        "entry_id": "89f7b35e-df09-30bf-8dfa-569e582bb22b",
                        "glosses": [
                            "Darwinisme, sélection naturelle selon la loi du plus fort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d8b41ea-bd16-4f8c-8260-b5843e94aa3a",
                                "sense_id": "e50c0cfc-7838-37b4-a574-5d29a8c4a60c",
                                "text": "Le régime intérieur de cette biocratie finale n'est pas moins lié que sa puissance extérieure à l'évolution fondamentale de l'humanité."
                            }
                        ]
                    },
                    {
                        "sense_id": "20b612cd-873e-3d98-8e3a-2b091b1be376",
                        "entry_id": "89f7b35e-df09-30bf-8dfa-569e582bb22b",
                        "glosses": [
                            "Eugénisme, état de droit où le pouvoir est donné aux médecins biologistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25312c0f-cce4-4795-a5c0-472b9fd81ad8",
                                "sense_id": "20b612cd-873e-3d98-8e3a-2b091b1be376",
                                "text": "L’application la plus radicale, la plus extrême et la plus inhumaine d'une telle « biocratie » nous a été révélée par le IIIe Reich."
                            }
                        ]
                    },
                    {
                        "sense_id": "317f4cd7-b8c6-3d41-80a2-5c582c8a305a",
                        "entry_id": "89f7b35e-df09-30bf-8dfa-569e582bb22b",
                        "glosses": [
                            "Société fondée sur les fonctions et aptitudes biologiques des individus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086a3714-6f7c-43e3-9612-2240a489c766",
                                "sense_id": "317f4cd7-b8c6-3d41-80a2-5c582c8a305a",
                                "text": "La biocratie est la science du gouvernement des peuples et de la conduite personnelle."
                            }
                        ]
                    }
