        "fr-extract.jsonl": [
            {
                "entry_id": "31b437d8-2647-3a7a-9ec3-6b31dead15a3",
                "word": "полтинник",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7be6264b-b635-34ef-8882-4e91b2fb8564",
                        "entry_id": "31b437d8-2647-3a7a-9ec3-6b31dead15a3",
                        "glosses": [
                            "Cinquante kopecks, demi-rouble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9bd16f-6738-4631-89d9-ab070931a95a",
                                "sense_id": "7be6264b-b635-34ef-8882-4e91b2fb8564",
                                "text": "20 центов ― цена баночки кока-колы, полтинник ― билет в автобусе, 40 центов ― проезд в метро.",
                                "translation": "20 cents c'est le prix d'une canette de Coca-Cola, cinquante (cents) c'est un ticket de bus, 40 cents c'est un ticket de métro."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4d8464c-700b-34c6-8f72-e00dd5d3591c",
                        "entry_id": "31b437d8-2647-3a7a-9ec3-6b31dead15a3",
                        "glosses": [
                            "Cinquante roubles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23170640-d177-4c46-b87d-8e3e09fb5df8",
                                "sense_id": "d4d8464c-700b-34c6-8f72-e00dd5d3591c",
                                "text": "Купец быстренько подбирает их, стучит в ящике медью и с шестидесяти рублей суёт Сёмке в карман сдачу — зелёный полтинник и две сверкающие медные копейки.",
                                "translation": "Le marchand les ramasse rapidement, frappe le cuivre dans la boîte et, avec soixante roubles, met la monnaie dans la poche de Syomka - un (billet) vert de cinquante roubles et deux kopecks en cuivre étincelants."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba8a9b4e-5bf2-34b2-bcda-f57d7c6ca11d",
                        "entry_id": "31b437d8-2647-3a7a-9ec3-6b31dead15a3",
                        "glosses": [
                            "Cinquantenaire, homme âgé de cinquante ans."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9f7cf759-9e40-47c7-9983-7f4298e0451d",
                                "sense_id": "ba8a9b4e-5bf2-34b2-bcda-f57d7c6ca11d",
                                "text": "Либо ему уже стукнуло полтинник, но выглядел он очень хорошо.",
                                "translation": "Il avait bon air pour un cinquantenaire."
                            }
                        ]
                    }
