    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1675d0aa-9fa0-3d59-8ee0-547b6588019f",
                    "sense_definition": "ein gleichmäßiges, kontinuierliches, oft dumpfes oder zischendes Geräusch erzeugen (wie von Blättern im Wind, fließendem Wasser oder technischen Geräten)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Blätter der hohen Bäume <w>rauschen</w> sanft im kühlen Abendwind."
                        },
                        {
                            "text": "Wenn der Sender verstellt ist, <w>rauscht</w> das Radio nur noch laut."
                        }
                    ],
                    "synonyms": [
                        "brausen",
                        "rascheln",
                        "zischen"
                    ],
                    "common_phrases": [
                        "im Wind rauschen",
                        "das Meer rauscht"
                    ]
                },
                {
                    "sense_id": "b7e8c39d-eaca-36b4-8f86-acf0ff6c367f",
                    "sense_definition": "sich mit großer Geschwindigkeit und unter Erzeugung eines brausenden Geräusches fortbewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Wasser des wilden Gebirgsbaches <w>rauscht</w> unaufhörlich in die Tiefe."
                        },
                        {
                            "text": "Riesige Wellen <w>rauschten</w> während des Sturms mit großer Wucht an den Strand."
                        }
                    ],
                    "synonyms": [
                        "brausen",
                        "sausen"
                    ],
                    "common_phrases": [
                        "in die Tiefe rauschen",
                        "ins Tal rauschen"
                    ]
                },
                {
                    "sense_id": "dec5cb38-f4e4-39c8-bd21-25675e99bb63",
                    "sense_definition": "einen Ort plötzlich, auffällig schwungvoll oder verärgert verlassen oder betreten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem lauten Streit <w>rauschte</w> die wütende Chefin einfach aus dem Zimmer."
                        },
                        {
                            "text": "Ohne sich von den Gästen zu verabschieden, ist er hastig zur Tür hinaus <w>gerauscht</w>."
                        }
                    ],
                    "synonyms": [
                        "abdampfen",
                        "abzischen",
                        "sich davonmachen",
                        "verschwinden"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "aus dem Zimmer rauschen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich für hastiges oder theatralisches Fortbewegen"
                        }
                    ]
                },
                {
                    "sense_id": "41a4344b-a856-3008-9588-c9515185cf27",
                    "sense_definition": "von Wildschweinen: in der Paarungszeit brünstig sein",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den kalten Monaten November und Dezember <w>rauscht</w> das heimische Schwarzwild im Wald."
                        },
                        {
                            "text": "Wenn die Bachen paarungsbereit sind, <w>rauscht</w> das Wild und die Tiere suchen einander."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db01c6c0-dc2c-362a-a1c9-e9e5354605ee",
                    "sense_definition": "ein anhaltendes, monotones Geräusch, das durch viele unregelmäßige Schwingungen entsteht (wie bei Wellen, Wind oder Rundfunkstörungen)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das beruhigende <w>Rauschen</w> des Meeres half ihm dabei, nach der Arbeit einzuschlafen."
                        },
                        {
                            "text": "Ein leises <w>Rauschen</w> in der Telefonleitung störte unser wichtiges Gespräch am Abend."
                        }
                    ],
                    "common_phrases": [
                        "das Rauschen des Meeres",
                        "ein leises Rauschen",
                        "weißes Rauschen"
                    ]
                }
            ]
        }
    ]
