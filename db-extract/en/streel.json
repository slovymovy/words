                        "glosses": [
                            "A disreputable woman, a slut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517cf5fb-0c03-40cf-be1d-3896116c702e",
                                "sense_id": "5cc38b6f-a0bb-359c-a58a-920a448eb483",
                                "text": "Cissy came up along the strand with the two twins and their ball with her hat anyhow on her to one side after her run and she did look a streel tugging the two kids along with the flimsy blouse she bought only a fortnight before like a rag on her back and bit of her petticoat hanging like a caricature."
                            }
                        ]
                    }
                ],
