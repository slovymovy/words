        "fr-extract.jsonl": [
            {
                "entry_id": "09f1e410-058c-322c-b6b5-b632a02a1bbd",
                "word": "Chiers",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "481d5b33-20e2-3281-81e1-5c69ad9844af",
                        "entry_id": "09f1e410-058c-322c-b6b5-b632a02a1bbd",
                        "glosses": [
                            "Rivière franco-belgo-luxembourgeoise tributaire de la Meuse."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "755b2f0d-8004-437e-a4d1-510730569ac6",
                                "sense_id": "481d5b33-20e2-3281-81e1-5c69ad9844af",
                                "text": "Dans les vallées de la Meuse et de la Chiers, il existe également de belles prairies qui sont souvent d'une étendue immense."
                            },
                            {
                                "example_id": "8b522259-0f19-4982-899e-0643820ff231",
                                "sense_id": "481d5b33-20e2-3281-81e1-5c69ad9844af",
                                "text": "Nous commençons par la Ferté, reposant sur la cote 215 entre les villages de Villy et de la Ferté-sur-Chiers. La voie ferrée de Longuyon à Charleville, serpente en contre bas le long de la rivière Chiers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be8a6cc5-6596-4625-a86b-6b26f324d001",
                        "source_entry_id": "09f1e410-058c-322c-b6b5-b632a02a1bbd",
                        "source_sense_id": "481d5b33-20e2-3281-81e1-5c69ad9844af",
                        "target_lang_word": "Chiers",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ccf1dbb1-56a9-4ad5-81f0-fcc0f88bd931",
                        "source_entry_id": "09f1e410-058c-322c-b6b5-b632a02a1bbd",
                        "source_sense_id": "481d5b33-20e2-3281-81e1-5c69ad9844af",
                        "target_lang_word": "Korn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13b6be4c-9454-3f52-875c-cbe4461a1fc9",
                                        "entry_id": "5e983aab-2741-3939-9300-babe298937c0",
                                        "glosses": [
                                            "Getreide"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d3a214-d1b4-4a40-b93c-e0950d90308e",
                                                "sense_id": "13b6be4c-9454-3f52-875c-cbe4461a1fc9",
                                                "text": "Das Korn reift auf dem Felde."
                                            },
                                            {
                                                "example_id": "55e6a184-5694-4e6a-ab6d-1a441c09486b",
                                                "sense_id": "13b6be4c-9454-3f52-875c-cbe4461a1fc9",
                                                "text": "„Indem er auf eigene Kosten einen 28 Meter langen Kai hatte bauen lassen, von dem aus Korn in kleine Leichter verladen werden kann, hatte Robert Billy dokumentiert, wie sehr ihm daran gelegen war, dass der Getreidehandel der Stadt Vannes weiter expandierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c214221e-907a-3984-8926-4936d61c5467",
                                        "entry_id": "5e983aab-2741-3939-9300-babe298937c0",
                                        "glosses": [
                                            "einzelner, sehr stärkehaltiger Samen verschiedener Getreidesorten"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6106ed7b-bde8-41f5-a051-a54dfee44619",
                                                "sense_id": "c214221e-907a-3984-8926-4936d61c5467",
                                                "text": "Körner sind die Hauptnahrung von vielen Singvögeln."
                                            },
                                            {
                                                "example_id": "bc11de47-1db9-4c5b-82f8-039d35426865",
                                                "sense_id": "c214221e-907a-3984-8926-4936d61c5467",
                                                "text": "„Doch sicherheitshalber verkaufte er nicht an die Großhändler der unmittelbaren Umgebung, denn da war die Gefahr zu groß, dass mal einer hereinschneite und feststellte, dass auf Bosses Hof kein einziges Huhn seine Körner pickte.“"
                                            },
                                            {
                                                "example_id": "602b0f65-99e2-43e2-b92d-b3c6a9015ac8",
                                                "sense_id": "c214221e-907a-3984-8926-4936d61c5467",
                                                "text": "„Die Pferde frassen Hafer aus den Futtersäcken, um sie her hatten sich Sperlinge gesammelt und klaubten die verschütteten Körner auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d850430-4863-30c1-ae37-0a053e05135b",
                                        "entry_id": "5e983aab-2741-3939-9300-babe298937c0",
                                        "glosses": [
                                            "kleines, festes, annähernd rundes Objekt"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f73eeca0-c801-42c7-9849-b1102662f471",
                                                "sense_id": "5d850430-4863-30c1-ae37-0a053e05135b",
                                                "text": "Ich bekam ein Sandkorn ins Auge."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f9d1eb98-6a0b-3645-b1ba-b37dd97df95c",
                                        "entry_id": "5e983aab-2741-3939-9300-babe298937c0",
                                        "glosses": [
                                            "winzige Menge von etwas, auch im übertragenen Sinne"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c6e9943-62d6-40ca-bc8b-8290691f0875",
                                                "sense_id": "f9d1eb98-6a0b-3645-b1ba-b37dd97df95c",
                                                "text": "Ein Körnchen Wahrheit findet sich immer darin."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "600c2205-c5a4-35ea-a948-949f56e20038",
                                        "entry_id": "5e983aab-2741-3939-9300-babe298937c0",
                                        "glosses": [
                                            "Einrichtung zum Zielen über den Lauf bei Schusswaffen"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51fa44c5-deb8-4844-ab57-4b1cbd8434d5",
                                                "sense_id": "600c2205-c5a4-35ea-a948-949f56e20038",
                                                "text": "Gezielt wird über Kimme und Korn."
                                            },
                                            {
                                                "example_id": "a382a685-a014-4792-a966-d6920a2d4928",
                                                "sense_id": "600c2205-c5a4-35ea-a948-949f56e20038",
                                                "text": "„Da versuchten wir die Korne zum Zielen abzuschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "54f04f22-2c69-3728-968c-0d22eea614e2",
                                        "entry_id": "5e983aab-2741-3939-9300-babe298937c0",
                                        "glosses": [
                                            "Auflösungsvermögen von Fotopapier"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "05c60012-f4a3-3c8b-9d70-9ddf96017e09",
                                        "entry_id": "5e983aab-2741-3939-9300-babe298937c0",
                                        "glosses": [
                                            "Masse des in einer Legierung enthaltenen Edelmetalls einer Münze oder von Schmuck"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddef2071-45f7-4250-a403-448dcc46ed82",
                                                "sense_id": "05c60012-f4a3-3c8b-9d70-9ddf96017e09",
                                                "text": "„Der Münzfuß bestimmte Schrot und Korn einer Münze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Korn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dba36ffb-f5c5-32d4-998f-11967402bdef",
                                        "entry_id": "77601fe9-70ea-3f3f-be4d-ea771562c59f",
                                        "glosses": [
                                            "alkoholisches Getränk, klar und hochprozentig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd12409-65c2-4d01-ab24-11dab8126c8a",
                                                "sense_id": "dba36ffb-f5c5-32d4-998f-11967402bdef",
                                                "text": "Korn trinkt man aus kleinen Gläsern."
                                            },
                                            {
                                                "example_id": "7f09c399-e5d0-4a22-95bf-86c85d74fe46",
                                                "sense_id": "dba36ffb-f5c5-32d4-998f-11967402bdef",
                                                "text": "Bitte noch zwei Korn!"
                                            },
                                            {
                                                "example_id": "a20155d6-c3c6-4212-be88-84fafb0e1f20",
                                                "sense_id": "dba36ffb-f5c5-32d4-998f-11967402bdef",
                                                "text": "Der schüttet die Körner nur so in sich rein!"
                                            },
                                            {
                                                "example_id": "7bd1ea8f-43cc-467c-b389-c6336fca0b61",
                                                "sense_id": "dba36ffb-f5c5-32d4-998f-11967402bdef",
                                                "text": "Sie sind auf Obstler, Korne und Branntweine spezialisiert."
                                            },
                                            {
                                                "example_id": "9af75fcf-1f84-43d6-9674-c5d544a41e7b",
                                                "sense_id": "dba36ffb-f5c5-32d4-998f-11967402bdef",
                                                "text": "„Die eine oder andere Lage Korn, gemischt mit einigen Bierchen, versetzt die Stehenden hinter der Theke in immer bessere Stimmung.“"
                                            },
                                            {
                                                "example_id": "352647f7-9897-4b2f-92c7-2c882e8512cf",
                                                "sense_id": "dba36ffb-f5c5-32d4-998f-11967402bdef",
                                                "text": "„Riesenfeld trinkt seinen Korn aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
