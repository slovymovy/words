{
    "word_family": [
        "worgen",
        "greep",
        "grijpen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4513439-516e-30bb-a024-5e5764ca93e7",
                    "sense_definition": "Een fysieke greep om iemands nek die de ademhaling of bloedtoevoer afsnijdt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_greep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieagent hield de verdachte in een gevaarlijke <w>wurggreep</w>.",
                            "target_lang_translations": {
                                "en": "The police officer held the suspect in a dangerous <w>chokehold</w>."
                            }
                        },
                        {
                            "text": "Tijdens de judotraining leerden we hoe we uit een <w>wurggreep</w> konden ontsnappen.",
                            "target_lang_translations": {
                                "en": "During judo training, we learned how to escape from a <w>chokehold</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "worggreep"
                    ],
                    "common_phrases": [
                        "iemand in een wurggreep houden"
                    ],
                    "target_lang_definitions": {
                        "en": "A physical hold around someone's neck that cuts off breathing or blood flow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chokehold",
                                "target_lang_sense_clarification": "physical grip around the neck"
                            },
                            {
                                "target_lang_word": "stranglehold",
                                "target_lang_sense_clarification": "physical grip that strangles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44b768c1-d023-36f5-a80b-fc8a6a0e32fd",
                    "sense_definition": "Een situatie waarin men volledige controle over iemand heeft of waarin men sterk afhankelijk is.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke_controle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hoge schulden hielden het jonge gezin in een ijzeren <w>wurggreep</w>.",
                            "target_lang_translations": {
                                "en": "The high debts held the young family in an iron <w>stranglehold</w>."
                            }
                        },
                        {
                            "text": "Het land probeert te ontsnappen aan de economische <w>wurggreep</w> van de buurstaat.",
                            "target_lang_translations": {
                                "en": "The country is trying to escape the economic <w>stranglehold</w> of the neighboring state."
                            }
                        }
                    ],
                    "synonyms": [
                        "worggreep"
                    ],
                    "common_phrases": [
                        "ontsnappen aan de wurggreep"
                    ],
                    "target_lang_definitions": {
                        "en": "A situation in which one has complete control over someone or in which there is strong dependency."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stranglehold",
                                "target_lang_sense_clarification": "figurative complete control or restriction"
                            },
                            {
                                "target_lang_word": "grip",
                                "target_lang_sense_clarification": "tight control or influence"
                            },
                            {
                                "target_lang_word": "chokehold",
                                "target_lang_sense_clarification": "figurative tight grip or control"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}