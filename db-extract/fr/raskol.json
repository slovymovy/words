                "entry_id": "841edf6f-ef43-3fec-8f1b-832af564b970",
                "word": "raskol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "31619d0d-dae1-42e4-a492-c7ee38d15013",
                        "entry_id": "841edf6f-ef43-3fec-8f1b-832af564b970",
