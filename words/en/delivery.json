    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51a119f0-e9ee-3924-8a77-89077228f3df",
                    "sense_definition": "The act of conveying or transporting something to a destination.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "logistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The courier confirmed that the <w>delivery</w> was completed by four o'clock.",
                            "target_lang_translations": {
                                "ru": "Курьер подтвердил, что <w>доставка</w> была завершена к четырем часам.",
                                "tr": "Kurye, <w>teslimatın</w> saat dört itibarıyla tamamlandığını doğruladı."
                            }
                        },
                        {
                            "text": "We offer a fast <w>delivery</w> service for all online orders placed before noon.",
                            "target_lang_translations": {
                                "ru": "Мы предлагаем услугу быстрой <w>доставки</w> для всех онлайн-заказов, сделанных до полудня.",
                                "tr": "Öğleden önce verilen tüm online siparişler için hızlı <w>teslimat</w> hizmeti sunuyoruz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fast delivery service",
                        "home delivery",
                        "delivery address"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по транспортировке или передаче чего-либо в пункт назначения.",
                        "tr": "Bir şeyi bir yere veya kişiye taşıma veya ulaştırma eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставка",
                                "target_lang_sense_clarification": "процесс транспортировки"
                            },
                            {
                                "target_lang_word": "развозка",
                                "target_lang_sense_clarification": "доставка по нескольким адресам"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "teslimat",
                                "target_lang_sense_clarification": "ürün veya paket taşıma süreci"
                            },
                            {
                                "target_lang_word": "dağıtım",
                                "target_lang_sense_clarification": "siparişlerin adreslere ulaştırılması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f922ad9-f1d8-3c9b-b8a6-26fb1fb65814",
                    "sense_definition": "The actual item or package that has been conveyed or brought to someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "logistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your <w>delivery</w> is on the table in the hallway.",
