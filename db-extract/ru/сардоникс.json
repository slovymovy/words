                                                "sense_id": "9e2e2cbf-672b-3651-9186-35ce2a9f1478",
                                                "text": "De kleur van sardonyx hangt sterk af van kleine hoeveelheden verontreinigingen opgelost in het kristalrooster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa38358c-4dfc-3029-b2b1-359ae565cb1d",
