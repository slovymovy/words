                "entry_id": "51d90604-e5d9-319f-9af6-99297f58b9c3",
                "word": "sandcastle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4e9bde7d-6c52-4b76-8bf5-41703d6a1041",
                        "entry_id": "51d90604-e5d9-319f-9af6-99297f58b9c3",
