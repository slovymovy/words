                ],
                "senses": [
                    {
                        "sense_id": "e277d85a-179a-3658-996a-539402f73ff3",
                        "entry_id": "0e6de880-15c5-3147-a692-e9e9e687490b",
                        "glosses": [
                            "to measure out [with genitive ‘enough (usually a large amount) of material’]"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f63f64b7-9950-49db-82db-c1ae421983a4",
                                "sense_id": "e277d85a-179a-3658-996a-539402f73ff3",
                                "text": "наме́рить арши́н сукна́",
                                "translation": "to measure out one arshin of broadcloth",
                                "english": "to measure out one arshin of broadcloth"
                            },
                            {
                                "example_id": "85e13c76-f559-4440-bec5-e98170c78376",
                                "sense_id": "e277d85a-179a-3658-996a-539402f73ff3",
                                "text": "наме́рить сукна́ на сюрту́к",
                                "translation": "to measure out enough broadcloth for a frock coat",
                                "english": "to measure out enough broadcloth for a frock coat"
                            }
                        ]
                    },
                    {
                        "sense_id": "7475d9ee-6522-3800-8617-062b2ec30878",
                        "entry_id": "0e6de880-15c5-3147-a692-e9e9e687490b",
                        "glosses": [
                            "to measure (something to be)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bb1bbe59-ffcb-48bc-bceb-b77092b16f2b",
                                "sense_id": "7475d9ee-6522-3800-8617-062b2ec30878",
                                "text": "Три са́жени в длину́, две поперёк и одну́ вверх наме́рил.",
                                "translation": "He measured it to be three sazhens in length, two across and one up.",
                                "english": "He measured it to be three sazhens in length, two across and one up."
                            },
                            {
                                "example_id": "4c4431b4-debf-44cc-9bd8-53fe25a4896d",
                                "sense_id": "7475d9ee-6522-3800-8617-062b2ec30878",
                                "text": "Врач наме́рил две́сти два́дцать на сто со́рок, ввёл магне́зию и стро́го сказа́л сыновья́м, что больно́му необходи́м по́лный поко́й и никаки́х отрица́тельных эмо́ций.",
                                "translation": "The doctor measured his blood pressure to be two twenty over one forty, gave him a magnesium injection, and told the sons strictly that the patient requires total rest and no negative emotions.",
                                "english": "The doctor measured his blood pressure to be two twenty over one forty, gave him a magnesium injection, and told the sons strictly that the patient requires total rest and no negative emotions."
                            }
                        ]
                    },
                    {
                        "sense_id": "535485ad-29e7-3bef-a930-910d4969a6b8",
                        "entry_id": "0e6de880-15c5-3147-a692-e9e9e687490b",
                        "glosses": [
                            "to intend, to plan"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6ad37335-6dbb-4050-81e1-120ca81f8130",
                                "sense_id": "535485ad-29e7-3bef-a930-910d4969a6b8",
                                "text": "Госуда́рь […] сперва́ наме́рил в Москве́ ра́ди вся́ких определе́ней побыва́ть.",
                                "translation": "His Majesty […] intended to first visit Moscow for the determination of various affairs.",
                                "english": "His Majesty […] intended to first visit Moscow for the determination of various affairs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
