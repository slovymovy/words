                        "examples": [
                            {
                                "example_id": "06380d78-dfcf-4320-aa19-96550484e58f",
                                "sense_id": "51cb149c-229d-3af8-a143-4e30c12b41f2",
                                "text": "When the world is moving towards globalisation and standardisation, India seems to be taking a step back. For something like clothing sizes for the Indian consumer market, singularisation makes way more sense than putting efforts into into introducing an entirely new size chart."
                            },
                            {
                                "example_id": "ed623ca9-4ef2-4857-b958-48312ade1e5a",
                                "sense_id": "51cb149c-229d-3af8-a143-4e30c12b41f2",
                                "text": "Migrant in the singular is used as a noun or as a premodification of another noun, e.g., migrant worker (individualisation, singularisation), migrant labour (functionalisation) or migrant community (collectivisation, singularisation) and migrant families (collectivisation, pluralization), and such cases appear in all papers."
                            }
                        ]
                    }
