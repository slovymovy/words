                "senses": [
                    {
                        "sense_id": "ec400de7-c000-3825-ba1a-dee1c880c6e3",
                        "entry_id": "84174e2e-97f4-3209-b4db-ed8230761c4e",
                        "glosses": [
                            "Nettoyer (quelque chose qui était empoissé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f3d4c4a-52fa-40d7-9d59-e4a521c8a636",
                                "sense_id": "ec400de7-c000-3825-ba1a-dee1c880c6e3",
                                "text": "La scénographie d'une manière générale obéit à ce même désir de désempoisser et donc de rendre présent aux spectateurs un texte vieux de plus de quatre siècles."
                            },
                            {
                                "example_id": "76d1272e-b154-459f-91dc-2e54b6708a5f",
                                "sense_id": "ec400de7-c000-3825-ba1a-dee1c880c6e3",
                                "text": "'Dès lors comment \"désempoisser\" le message de l'élève du signifié pour l'introduire à la maîtrise du signifiant ? — (site www.lecture.org)"
                            },
                            {
                                "example_id": "ce78bc66-42be-401d-94d5-6c69faafddf9",
                                "sense_id": "ec400de7-c000-3825-ba1a-dee1c880c6e3",
                                "text": "D'accord, Maître », accepte distraitement la blonde, encore toute occupée à se désempoisser la physionomie."
                            }
                        ]
                    }
