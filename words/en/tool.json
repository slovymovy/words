    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c74e640-1863-38f0-a610-c41b502a9443",
                    "sense_definition": "Any physical device, such as a hammer, saw, or screwdriver, used to carry out a particular function or task.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "instrumentality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A screwdriver is a <w>tool</w> that no household should be without.",
                            "target_lang_translations": {
                                "ru": "Отвертка — это <w>инструмент</w>, без которого не обойтись ни в одном доме.",
                                "zh": "螺丝刀是每个家庭都不可或缺的<w>工具</w>。"
                            }
                        },
                        {
                            "text": "He keeps all his garden <w>tools</w> in the shed.",
                            "target_lang_translations": {
                                "ru": "Он хранит все свои садовые <w>инструменты</w> в сарае.",
                                "zh": "他把所有的园艺<w>工具</w>都放在棚子里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "implement",
                        "instrument",
                        "device",
                        "utensil",
                        "gadget"
                    ],
                    "common_phrases": [
