                                        "examples": [
                                            {
                                                "example_id": "fe721ffb-99c5-4029-b5b9-2e525900ddf7",
                                                "sense_id": "7d5e7a2b-093e-39c4-a3a9-a7341483109e",
                                                "text": "\"Still,\" Suit echoed. \"The way she handles the gun jamming.\" Suit shook their head in admiration. \"Tap, rack, bang, without hesitation. That's extraordinary retention.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb6e80dd-4ff6-3008-ba5e-c481bffc3ad3",
