                        ],
                        "examples": [
                            {
                                "example_id": "1e4fb6cc-fa4b-4f26-ba74-661ebd9ce38e",
                                "sense_id": "a24737fd-befb-38d0-a0be-a41458b770d2",
                                "text": "Soit ce type est mytho, soit il enseigne réellement."
                            },
                            {
                                "example_id": "213b647d-2a10-475f-a4aa-fb83579aac57",
                                "sense_id": "a24737fd-befb-38d0-a0be-a41458b770d2",
                                "text": "Dis donc, Ambroise, il était pas un peu mytho, ton pote ?"
                            }
                        ]
                    }
                ],
