                        "examples": [
                            {
                                "example_id": "833794ec-d4fa-43ea-ad84-71f27097db67",
                                "sense_id": "59d09b03-8654-3da3-bb1c-8b9074ac11f2",
                                "text": "De haai is meteen het grootste object van het museum, dat ook al een vin en onderwaterapparatuur uit Jaws in zijn bezit heeft. Daarnaast zullen er ook het paardenhoofd uit The Godfather, een masker uit Planet of the Apes en de schoenen van Dorothy uit The Wizard of Oz te zien zijn."
                            },
                            {
                                "example_id": "bfb7ac91-72a3-4a0e-bb22-2988cab3b97e",
                                "sense_id": "59d09b03-8654-3da3-bb1c-8b9074ac11f2",
                                "text": "De politie in Nieuw-Zeeland heeft 35 kilo cocaïne gevonden in een sculptuur van een paardenhoofd. Het is de grootste drugsvangst in de geschiedenis van het land."
                            }
                        ]
