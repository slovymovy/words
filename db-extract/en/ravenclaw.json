                        "entry_id": "a8f5e063-d044-37db-a41c-6373241a8c37",
                        "glosses": [
                            "A person having traits associated with Ravenclaw house from the Harry Potter series, including intelligence, creativity, and love of learning or an affinity for eagles or the colours blue and bronze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "028c44b2-39a0-4179-8036-3f156178951f",
                                "sense_id": "b89cc0f4-fb5e-3a1e-af94-19e74843e433",
                                "text": "“Let's go, Ravenclaws!” Kristen cheered loudly. Lizbeth laughed and nudged her in the arm.\n“You're such a dork,” she told her. “They're just warming up.”"
                            },
                            {
                                "example_id": "0facf15b-e52e-4151-a362-6c6cda92e33f",
                                "sense_id": "b89cc0f4-fb5e-3a1e-af94-19e74843e433",
                                "text": "“I've always thought of myself as more of a Ravenclaw.”"
                            },
                            {
                                "example_id": "9d9b6bb6-adf9-48c9-a83c-44f3cbe833ee",
                                "sense_id": "b89cc0f4-fb5e-3a1e-af94-19e74843e433",
                                "text": "“I know we've met, but I'm Tom. Law.”\n“And I'm Will,” I said. “English.”\nShe rolled her eyes. “I'm Ella. Ravenclaw.”"
                            }
                        ]
                    }
