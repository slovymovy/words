                    },
                    {
                        "translation_id": "9ef73168-4afd-43d8-bed1-8fc1ff5118cc",
                        "source_entry_id": "40844630-9f90-3230-a1f1-6c4e55270e3f",
                        "source_sense_id": "ff51dd15-b4b0-3798-8d12-bc103d92011d",
                        "target_lang_word": "Antwerpener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antwerpener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88e3b83f-ae9b-3f19-bcde-549abf857e33",
                                        "entry_id": "44cd7f2f-a716-3305-baac-88bed2203184",
                                        "glosses": [
                                            "Person, die in Antwerpen lebt oder dort geboren ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29f2613-d4bd-411e-ac8b-e9a35acf696f",
                                                "sense_id": "88e3b83f-ae9b-3f19-bcde-549abf857e33",
                                                "text": "Sein Geschäftspartner ist Antwerpener."
                                            },
                                            {
                                                "example_id": "489d5eb9-41c6-4b7d-ad30-f16bc20e21fd",
                                                "sense_id": "88e3b83f-ae9b-3f19-bcde-549abf857e33",
                                                "text": "„Härter traf es die Antwerpener, die fast 1000 Mal beschossen wurden, sowie die Londoner, die über 400 Mal unter dem V2-Terror leiden mussten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Antwerpener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7be028bd-d9da-357c-a10a-a2cb29c90d9f",
                                        "entry_id": "444dc3f8-56c1-3f2a-babd-1919ac4b5822",
                                        "glosses": [
                                            "zu Antwerpen gehörig, aus ihm kommend oder es betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aae8e34-50f5-4fe8-8e4d-d6c8b68ffeca",
                                                "sense_id": "7be028bd-d9da-357c-a10a-a2cb29c90d9f",
                                                "text": "Morgen kommt das Schlachtschiff im Antwerpener Hafen an."
                                            },
                                            {
                                                "example_id": "c2a960d7-33e4-4134-bcb5-9138cdc250a0",
                                                "sense_id": "7be028bd-d9da-357c-a10a-a2cb29c90d9f",
                                                "text": "„Die belgische Regierung unter Paul Graf de Smet de Nayer bringt in der Abgeordnetenkammer in Brüssel ihre Gesetzesvorlage über die Befestigung Antwerpens und die Erweiterung des Antwerpener Hafens ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
