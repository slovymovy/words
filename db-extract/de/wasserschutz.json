                ],
                "senses": [
                    {
                        "sense_id": "d8b8f257-aef0-3f3d-9001-aadeeaba39aa",
                        "entry_id": "e222ff67-fd57-35ec-8ff1-1c0619c708bb",
                        "glosses": [
                            "Gesamtheit aller vorbeugenden Sicherheitsmaßnahmen, die Wasserverschmutzungen verhindern oder dessen Einwirkungen begrenzen; Gewässerschutz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "605be9b5-fda4-4508-bf41-227842f220a8",
                                "sense_id": "d8b8f257-aef0-3f3d-9001-aadeeaba39aa",
                                "text": "„Welchen Beitrag zum Wasserschutz kann also jeder einzelne leisten? “"
                            },
                            {
                                "example_id": "dbf8e970-5576-47bc-af16-6e56df627a0e",
                                "sense_id": "d8b8f257-aef0-3f3d-9001-aadeeaba39aa",
                                "text": "„Somit dient der Kooperative Wasserschutz zum einen der Versorgung der Bevölkerung mit Trinkwasser und zum anderen der Versorgung mit hochwertigen Lebensmitteln aus der Region.“"
                            },
                            {
                                "example_id": "4d08db24-6d33-47d4-9ad4-ffc0907a02b2",
                                "sense_id": "d8b8f257-aef0-3f3d-9001-aadeeaba39aa",
                                "text": "„Bei BASF senken wir unsere Emissionen in das Wasser und bieten Produkte an, die zum Wasserschutz beitragen.“"
                            },
                            {
                                "example_id": "1283631f-c580-4966-9985-40218b969494",
                                "sense_id": "d8b8f257-aef0-3f3d-9001-aadeeaba39aa",
                                "text": "„Der Wasserschutz hat in der landwirtschaftlichen Ausbildung eine zunehmende Bedeutung, das zeigt auch die große Resonanz der Berufsschulen auf die Einladung zu diesem Feldtag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69fd9f50-307b-3dbe-a8b0-ce83723971e6",
                        "entry_id": "e222ff67-fd57-35ec-8ff1-1c0619c708bb",
                        "glosses": [
                            "Gesamtheit aller vorbeugenden Sicherheitsmaßnahmen, die Hochwasser verhindern oder dessen Einwirkung begrenzen; Hochwasserschutz"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d8896bda-6040-35ab-aa36-78ff2ac5858f",
                        "entry_id": "e222ff67-fd57-35ec-8ff1-1c0619c708bb",
                        "glosses": [
                            "Kurzwort für die polizeiliche Hoheit über alle Wasserfahrzeuge auf Wasserstraßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d020bce9-def6-4310-bb3d-8b2068abde89",
                                "sense_id": "d8896bda-6040-35ab-aa36-78ff2ac5858f",
                                "text": "„Der Polizeivizepräsident hat die Direktion Wasserschutz und Verkehr 2015 offiziell getrennt.“"
                            }
