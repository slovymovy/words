                "senses": [
                    {
                        "sense_id": "58530d82-75e5-3380-b027-b96869076d83",
                        "entry_id": "bda6b7da-b298-399d-9e88-ab9b8273043f",
                        "glosses": [
                            "Regen- oder Wettergott im präkolumbischen Mesoamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "323d307c-458f-449c-9b03-e2c9fcc97da7",
                                "sense_id": "58530d82-75e5-3380-b027-b96869076d83",
                                "text": "„Ab und zu war die Stimmung quälend traurig: Das Reich des Regengottes Tlaloc und seiner Frau Chalchiutlicue oder Jaderock konnte eine leidvolle Welt sein, die nicht nur Leben spendete, sondern oft auch den Tod brachte.“"
                            },
                            {
                                "example_id": "ef055d06-56dd-4fa2-ac55-048650897a69",
                                "sense_id": "58530d82-75e5-3380-b027-b96869076d83",
                                "text": "„An der Westseite führte eine doppelte Treppe zu den beiden Heiligtümern an der Spitze der Pyramide hinauf, die im Westen dem Regengott Tlaloc und im Süden Huitzilopochtli gewidmet waren.“"
                            }
                        ],
