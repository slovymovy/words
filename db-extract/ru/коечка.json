                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76fbb809-138c-47e8-a741-045f9aaa1905",
                                                "sense_id": "f7fb6881-5d00-3243-b29c-86afe82726bd",
                                                "text": "It small avails my mood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efcc9484-7e50-3fc9-9cf5-c3d941866331",
                                        "entry_id": "7f38e01b-7896-3545-9515-a1bf28a52a80",
                                        "glosses": [
                                            "In a low tone; softly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "669b1793-0e16-453a-a2e2-c407983e93b4",
                                                "sense_id": "efcc9484-7e50-3fc9-9cf5-c3d941866331",
                                                "text": "That's all one: you shall play it in a mask, and / you may speak as small as you will."
                                            }
