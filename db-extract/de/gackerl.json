                        ],
                        "examples": [
                            {
                                "example_id": "aab13041-4b40-4b27-8910-72d408f6d281",
                                "sense_id": "d5e0d237-3c2c-3b07-a5fd-66b7837f1386",
                                "text": "„Wir wollen keinen Luxus auf der Alten Donau, aber ein stilles Örtchen muss es geben. Oder sollen zukünftig auch Sackerl fürs Gackerl fürs Herrl ausgeteilt werden?“"
                            },
                            {
                                "example_id": "003cc4f1-8091-4c10-b507-1c06badcc251",
                                "sense_id": "d5e0d237-3c2c-3b07-a5fd-66b7837f1386",
                                "text": "„Man muss gar nichts sagen. Man muss nicht verbal zum Gackerl-Sackerl-Benutzen auffordern. Man muss nur schauen. Einfach hinschauen, während das Hundi sein Geschäft verrichtet.“"
                            },
                            {
                                "example_id": "4b1beaf8-0b1b-499a-aee3-76d57fb585e5",
                                "sense_id": "d5e0d237-3c2c-3b07-a5fd-66b7837f1386",
                                "text": "„Teures Geschäft von Hundedame Kessja in Wien: Nach dem \"Gackerl\" hatte Besitzer Daniel S. (28) kein Sackerl und auch kein Bargeld. Die Folge war eine saftige Anzeige – Kosten: 470 Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
