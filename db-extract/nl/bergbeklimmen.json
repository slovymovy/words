                        "glosses": [
                            "het beklimmen van bergen als sport of liefhebberij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684ff25f-545c-4e53-bad6-a3964dcf4057",
                                "sense_id": "0e7f6dc3-85e1-30fc-a5c3-d550cc86a81a",
                                "text": "Gevreesd wordt dat de nog steeds niet gevonden Pool op de ruim 8100 meter hoge berg het leven heeft gelaten, aldus Karrar Haidri van de Pakistaanse vereniging van bergbeklimmers."
                            },
                            {
                                "example_id": "0b910a71-3ca0-48b4-9126-fd0b8b7518b4",
                                "sense_id": "0e7f6dc3-85e1-30fc-a5c3-d550cc86a81a",
                                "text": "Mensen die de Mount Everest en andere hoge bergen in Nepal willen beklimmen, mogen voortaan niet meer in hun eentje naar boven. Nepal heeft daartoe besloten om het aantal ongevallen onder bergbeklimmers te verminderen. Sinds 1920 zijn zeker tweehonderd mensen op de Mount Everest overleden."
                            }
                        ]
