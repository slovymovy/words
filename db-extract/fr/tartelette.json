                "senses": [
                    {
                        "sense_id": "ed162188-01f1-338b-a758-264d9298974e",
                        "entry_id": "524d3b85-53ba-3e4b-b068-9aa7fc5dc0e1",
                        "glosses": [
                            "Petite tarte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4df5b5-d15f-45e4-b289-602d5ebab698",
                                "sense_id": "ed162188-01f1-338b-a758-264d9298974e",
                                "text": "« On les a bien eus, ahahahah ! Une autre tartelette, Horacio ? »"
                            },
                            {
                                "example_id": "34451c70-2dbf-4b26-80d8-f3acea2d8f61",
                                "sense_id": "ed162188-01f1-338b-a758-264d9298974e",
                                "text": "Par éviscération abdominale, le légiste (aidé d’une brigade de mitrons) dénombra par ordre d’entrée en scène : 18 tartelettes amandines, 26 pets-de-nonne, 13 paris-brest, 8 polonaises, 3 apfelstrudels, 1 demi saint-honoré, 5 poires Bourdaloue, 6 religieuses, 34 profiteroles, 3 quarts de kugelhopf, 1 brioche à la parisienne, 1 cake à l’ancienne, 3 babas au rhum et 137 éclairs au chocolat et 2 au café."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "326f5ffe-7f61-4201-8aee-084894c50732",
                        "source_entry_id": "524d3b85-53ba-3e4b-b068-9aa7fc5dc0e1",
                        "source_sense_id": "ed162188-01f1-338b-a758-264d9298974e",
                        "target_lang_word": "tartlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tartlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de53cc27-6623-31c4-a6c4-83fb5c962633",
                                        "entry_id": "06200a3d-8020-3536-8af5-4e942ca882a1",
                                        "glosses": [
                                            "A small tart (pastry)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71791bc0-c80a-4bf9-ae76-c372a51a2638",
                                                "sense_id": "de53cc27-6623-31c4-a6c4-83fb5c962633",
                                                "text": "Place the cream in a piping bag with a fairly large star pipe attached, fill each tartlet with a twirl of cream and top with a strawberry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                        "entry_id": "06200a3d-8020-3536-8af5-4e942ca882a1",
                                        "glosses": [
                                            "A promiscuous young woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75b425b0-d6b0-4a35-bcc2-d4d338ac26a8",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "The only excitement I had was watching a tartlet in a teeny-weeny bikini that barely contained her truly mammoth assets light a cigarette and suck on it with puckered, painted, Lolita lips."
                                            },
                                            {
                                                "example_id": "4872260a-4f20-4560-931a-2d8359243ad0",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "\"She's a whore. A tartlet. Junia, he bought her for a hundred and fifty guineas, and then had the nerve to ask me to marry him!\""
                                            },
                                            {
                                                "example_id": "a233e8a4-b3bb-4790-a451-296ac661c9f4",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "She hated that a large chunk of Jerry's income supported his little tartlets instead of being directed into their household as it should have been.."
                                            },
                                            {
                                                "example_id": "14bf244d-233b-4c09-b80b-1bc25c9addc6",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "'Be gone tartlets! Your feminine charms hold no power over me,' he said, […]"
                                            },
                                            {
                                                "example_id": "ace07ac6-f33b-405b-8ae0-d5f10e642d49",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "I have yet to see a Hollywood tartlet apologize for weighing 95 pounds, or for playing dumb to stay popular, or for always being the sidekick when there's action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
