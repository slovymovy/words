    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                "word": "cookery",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a4c3051b-b951-44b5-847f-f2c8c09f3515",
                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                        "tags": [
                            "plural"
                        ],
                        "form": "cookeries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9bb1fca6-96c4-366b-b5c6-64ba6703bd2d",
                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                        "glosses": [
                            "The art and practice of preparing food for consumption, especially by the application of heat; cooking."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "efe23a67-671a-4350-8fb0-f6ea4fbf83a2",
                                "sense_id": "9bb1fca6-96c4-366b-b5c6-64ba6703bd2d",
                                "text": "Henry was not very good at cookery and most of his meals ended up burned."
                            },
                            {
                                "example_id": "1eae3864-7592-49fc-a39f-413a2df798d2",
                                "sense_id": "9bb1fca6-96c4-366b-b5c6-64ba6703bd2d",
                                "text": "together with excellent directions for cookery, as also for preserving, conserving, candying, &c."
                            }
                        ]
                    },
                    {
                        "sense_id": "35064240-6717-3b67-b805-58956a471eb9",
                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                        "glosses": [
                            "A delicacy; a dainty."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5fec1d90-b4da-45de-a946-cc5fab479736",
                                "sense_id": "35064240-6717-3b67-b805-58956a471eb9",
                                "text": "I've got a bit of cookery that will astonish him — my marinated pheasants' poults a la braise imperiale."
                            }
                        ]
                    },
                    {
                        "sense_id": "16ed7b2b-9430-3f93-8373-2e654c39939b",
                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                        "glosses": [
                            "Cooking tools or apparatus."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ecdd65cc-2577-4990-ad0d-101e2e4397ad",
                                "sense_id": "16ed7b2b-9430-3f93-8373-2e654c39939b",
                                "text": "She directed the servants, inspected both the cookery and arrangements of the table, held council with an old steward..."
                            },
                            {
                                "example_id": "ce71348d-0b52-444c-8c9b-ffce3e4f355b",
                                "sense_id": "16ed7b2b-9430-3f93-8373-2e654c39939b",
                                "text": "...and would not be just dead weight, as on the trail it could conveniently be filled with the cookery and other odds and ends..."
                            }
                        ]
                    },
                    {
                        "sense_id": "70bbe826-8f4a-3efa-8b97-533e028a7f0d",
                        "entry_id": "fac01e94-98a8-36b3-8d91-a0f407b0bc81",
                        "glosses": [
                            "A place where cooking is done."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2511011-3add-4441-87d7-43dc600636f2",
                                "sense_id": "70bbe826-8f4a-3efa-8b97-533e028a7f0d",
                                "text": "Mr. Weller produced upon the little dining-table, a roast leg of mutton and an enormous meat-pie, with sundry dishes of vegetables, and pots of porter, which stood upon the chairs or the sofa bedstead, or where they could, everybody felt disposed to do justice to the meal, notwithstanding that the meat had been purchased, and dressed, and the pie made, and baked, at the prison cookery hard by."
                            }
                        ]
                    }
                ],
