{
    "word_family": [
        "spanning",
        "overspanning",
        "ontspannen",
        "inspannen",
        "uitspannen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97d5f5a2-3644-3f9a-adac-c770fb0b4c77",
                    "sense_definition": "geestelijk uitgeput of ziek door een te zware psychische belasting",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mentale toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dat zware jaar op kantoor bleek hij toch <w>overspannen</w> te zijn geraakt.",
                            "target_lang_translations": {
                                "en": "After that difficult year at the office, it turned out he had become <w>overstrained</w> after all."
                            }
                        },
                        {
                            "text": "Veel werknemers raken <w>overspannen</w> door de constante druk en het gebrek aan rust.",
                            "target_lang_translations": {
                                "en": "Many employees suffer <w>burnout</w> due to constant pressure and lack of rest."
                            }
                        }
                    ],
                    "antonyms": [
                        "ontspannen"
                    ],
                    "common_phrases": [
                        "overspannen raken",
                        "overspannen zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "mentally exhausted or ill due to excessive psychological pressure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overstrained",
                                "target_lang_sense_clarification": "mentally or physically exhausted"
                            },
                            {
                                "target_lang_word": "burnt out",
                                "target_lang_sense_clarification": "suffering from severe work-related exhaustion"
                            },
                            {
                                "target_lang_word": "overworked",
                                "target_lang_sense_clarification": "having worked too hard or too much"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1146539d-82de-3477-92dd-168a1b131173",
                    "sense_definition": "te zwaar belast of te actief, vaak met betrekking tot een markt of situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overbelasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De huizenmarkt is momenteel volledig <w>overspannen</w> door het tekort aan woningen.",
                            "target_lang_translations": {
                                "en": "The housing market is currently completely <w>overheated</w> due to the shortage of homes."
                            }
                        },
                        {
                            "text": "Door de enorme vraag naar grondstoffen is de markt <w>overspannen</w> geraakt.",
                            "target_lang_translations": {
                                "en": "Due to the enormous demand for raw materials, the market has become <w>overstretched</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ómspannen"
                    ],
                    "common_phrases": [
                        "overspannen woningmarkt",
                        "overspannen arbeidsmarkt"
                    ],
                    "target_lang_definitions": {
                        "en": "excessively burdened or active, often referring to a market or economic situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overheated",
                                "target_lang_sense_clarification": "referring to an economy or market with excessive demand"
                            },
                            {
                                "target_lang_word": "overstretched",
                                "target_lang_sense_clarification": "having more work or debt than can be managed"
                            },
                            {
                                "target_lang_word": "strained",
                                "target_lang_sense_clarification": "under severe pressure"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0884613f-2bba-3705-92b4-3bd5f237241c",
                    "sense_definition": "iets te strak uitrekken of te ver buigen waardoor het kan breken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke spanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doordat het touw werd <w>overspannen</w> knapte het plotseling tijdens het trekken.",
                            "target_lang_translations": {
                                "en": "Because the rope was <w>overstretched</w>, it suddenly snapped during the pull."
                            }
                        },
                        {
                            "text": "Je moet de snaren van de gitaar niet <w>overspannen</w> want dan breken ze.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>overtighten</w> the guitar strings because they will break."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een boog overspannen",
                        "een snaar overspannen"
                    ],
                    "target_lang_definitions": {
                        "en": "to stretch something too tightly or bend it too far, causing it to potentially break"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overstrain",
                                "target_lang_sense_clarification": "to subject to excessive physical tension"
                            },
                            {
                                "target_lang_word": "overstretch",
                                "target_lang_sense_clarification": "to pull or extend something too far"
                            },
                            {
                                "target_lang_word": "overtighten",
                                "target_lang_sense_clarification": "to make something too tight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96dae904-e6b3-33f8-bac1-233be2d2c1b9",
                    "sense_definition": "zich over een bepaalde ruimte uitstrekken of iets overdekken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overdekking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is ze gelukt het hele stadion te <w>overspannen</w> met een gigantisch doek.",
                            "target_lang_translations": {
                                "en": "They managed to <w>cover</w> the entire stadium with a gigantic canvas."
                            }
                        },
                        {
                            "text": "De nieuwe brug zal de hele rivier in één keer <w>overspannen</w>.",
                            "target_lang_translations": {
                                "en": "The new bridge will <w>span</w> the entire river in one go."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een ruimte overspannen",
                        "een rivier overspannen"
                    ],
                    "target_lang_definitions": {
                        "en": "to extend across a certain space or to cover something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "span",
                                "target_lang_sense_clarification": "to extend across a distance or river"
                            },
                            {
                                "target_lang_word": "stretch across",
                                "target_lang_sense_clarification": "to reach from one side to another"
                            },
                            {
                                "target_lang_word": "bridge",
                                "target_lang_sense_clarification": "to connect two sides over a gap"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a724910-4424-3f41-a10d-1d1f38464c93",
                    "sense_definition": "dieren of een voertuig voor een ander voertuig plaatsen of wisselen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de herberg moesten ze de paarden <w>overspannen</w> voor de volgende etappe.",
                            "target_lang_translations": {
                                "en": "At the inn, they had to <w>change</w> the horses for the next stage."
                            }
                        },
                        {
                            "text": "De koetsier besloot de vermoeide dieren direct te <w>overspannen</w>.",
                            "target_lang_translations": {
                                "en": "The coachman decided to <w>unhitch</w> the tired animals immediately."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paarden overspannen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "voornamelijk gebruikt in de context van paarden en koetsen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to place or change animals or a vehicle in front of another vehicle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "change horses",
                                "target_lang_sense_clarification": "to replace tired horses with fresh ones"
                            },
                            {
                                "target_lang_word": "hitch up",
                                "target_lang_sense_clarification": "to attach animals to a vehicle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}