    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c4fd4b5b-d3ff-3f65-84e7-5aaf87570f97",
                    "sense_definition": "Arranged in a systematic way; in good order.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "orderly_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please keep your desk <w>organized</w> so you can find things easily.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, содержи свой стол <w>в порядке</w>, чтобы можно было легко находить вещи.",
                                "zh": "请保持你的书桌<w>有序</w>，这样你就能轻松找到东西。"
                            }
                        },
                        {
                            "text": "The library books are <w>organized</w> alphabetically by author.",
                            "target_lang_translations": {
                                "ru": "Библиотечные книги <w>упорядочены</w> по алфавиту по авторам.",
                                "zh": "图书馆的书籍是按作者姓氏字母顺序<w>排列</w>的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "messy",
                        "chaotic",
                        "cluttered",
                        "disorganized"
                    ],
                    "common_phrases": [
                        "well organized",
                        "highly organized",
                        "poorly organized"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упорядоченный, систематизированный; находящийся в хорошем порядке.",
                        "zh": "以系统的方式安排；处于良好的秩序中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организованный",
                                "target_lang_sense_clarification": "систематизированный"
                            },
                            {
                                "target_lang_word": "упорядоченный",
                                "target_lang_sense_clarification": "приведенный в порядок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有序的",
                                "target_lang_sense_clarification": "指事物排列整齐"
                            },
                            {
                                "target_lang_word": "整理好的",
                                "target_lang_sense_clarification": "指经过整理的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0229b847-cabb-3564-bb27-07c6537e604e",
                    "sense_definition": "Able to plan things carefully and keep things tidy and efficient.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orderly_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very <w>organized</w> student who never misses a deadline.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>организованная</w> студентка, которая никогда не пропускает сроки сдачи.",
                                "zh": "她是一位非常有<w>条理</w>的学生，从不耽误截止日期。"
                            }
                        },
                        {
                            "text": "You need to get <w>organized</w> if you want to finish this project on time.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>организоваться</w>, если ты хочешь закончить этот проект вовремя.",
                                "zh": "如果你想按时完成这个项目，你需要把事情<w>规划</w>好。"
                            }
                        }
                    ],
                    "antonyms": [
                        "disorganized"
                    ],
                    "common_phrases": [
                        "get organized",
                        "stay organized",
                        "organized person"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умеющий тщательно планировать дела, поддерживать порядок и действовать эффективно.",
                        "zh": "能够仔细规划事务，保持整洁并高效行事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организованный",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "собранный",
                                "target_lang_sense_clarification": "дисциплинированный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有条理的",
                                "target_lang_sense_clarification": "指人做事有计划"
                            },
                            {
                                "target_lang_word": "有组织能力的",
                                "target_lang_sense_clarification": "指人具备管理和规划能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e02da95-4a26-3bce-bca2-0e57f0217cb5",
                    "sense_definition": "Formed into a structured group, such as a trade union or a criminal group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police have launched a new investigation into <w>organized</w> crime.",
                            "target_lang_translations": {
                                "ru": "Полиция начала новое расследование в отношении <w>организованной</w> преступности.",
                                "zh": "警方已对<w>有组织</w>犯罪展开了新的调查。"
                            }
                        },
                        {
                            "text": "Workers in <w>organized</w> labor unions often negotiate for better wages.",
                            "target_lang_translations": {
                                "ru": "Рабочие в <w>организованных</w> профсоюзах часто ведут переговоры о повышении зарплаты.",
                                "zh": "在<w>有组织</w>工会里的工人经常通过谈判争取更好的工资。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unionized"
                    ],
                    "antonyms": [
                        "ununionized"
                    ],
                    "common_phrases": [
                        "organized crime",
                        "organized labor",
                        "organized religion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединенный в структурированную группу (например, профсоюз или преступную группировку).",
                        "zh": "形成结构化的团体，例如工会或犯罪集团。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организованный",
                                "target_lang_sense_clarification": "объединенный в структуру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有组织的",
                                "target_lang_sense_clarification": "指形成特定结构的团体"
                            }
                        ]
                    }
                }
            ]
        },
        {
