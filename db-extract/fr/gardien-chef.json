                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8110fd97-2135-465f-ad06-fe0ffda4cbe3",
                                "sense_id": "11ac7124-39c7-3c97-b514-97ca085d0b1a",
                                "text": "Déjà, Dupuis, le gardien-chef, a fait une première tournée ; il a amassé les rapports des soigneurs."
                            },
                            {
                                "example_id": "246bb92d-8f6f-4f63-9d98-a17af8ecaf65",
                                "sense_id": "11ac7124-39c7-3c97-b514-97ca085d0b1a",
                                "text": "Une fois arrivé au Muséum, l’animal fut rapidement installé au deuxième étage du pavillon des singes, dans un grenier attenant à l’appartement du gardien-chef des singes."
                            },
                            {
                                "example_id": "574a1965-3185-4733-b55e-2793435a276f",
                                "sense_id": "11ac7124-39c7-3c97-b514-97ca085d0b1a",
                                "text": "Tous, du président de la Cour au médecin légiste qui officialisera le décès, en passant par le directeur de la prison, le gardien-chef, l’avocat général et l’aumônier, ont le visage de cire."
                            }
                        ]
