                    {
                        "sense_id": "a84b3549-9413-3575-b533-7361264cd3f8",
                        "entry_id": "24c04874-735e-3cf8-bd78-17f515c60051",
                        "glosses": [
                            "Fest im Garten, bei dem gegrillt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113244a5-ed7d-40e4-afd1-888452b93b00",
                                "sense_id": "a84b3549-9413-3575-b533-7361264cd3f8",
                                "text": "Egal, ob die Sonne scheint, es stürmt oder schneit, unsere Nachbarn veranstalten jedes Wochenende eine Grillparty."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e25bee14-6a53-4121-8e35-e20bf59c3fd5",
                        "source_entry_id": "24c04874-735e-3cf8-bd78-17f515c60051",
                        "source_sense_id": "a84b3549-9413-3575-b533-7361264cd3f8",
                        "source_sense_description": "Fest im Garten, bei dem gegrillt wird",
                        "target_lang_word": "barbecue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbecue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb214f3d-e001-392a-a56f-c350eb789839",
                                        "entry_id": "6705a9f5-b238-3b8f-9f99-2689d9c453bb",
                                        "glosses": [
                                            "A fireplace or pit for grilling food, typically used outdoors and traditionally employing hot charcoal as the heating medium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9fae02c-111a-4f49-86cb-9a23a76d2c94",
                                                "sense_id": "cb214f3d-e001-392a-a56f-c350eb789839",
                                                "text": "We cooked our food on the barbecue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd9f4fab-6840-32cd-88ab-bdd92534c4a1",
                                        "entry_id": "6705a9f5-b238-3b8f-9f99-2689d9c453bb",
                                        "glosses": [
                                            "A meal or event highlighted by food cooked in such an apparatus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "618bf881-1243-4196-ba33-6bf4096947d3",
                                                "sense_id": "fd9f4fab-6840-32cd-88ab-bdd92534c4a1",
                                                "text": "We're having a barbecue on Saturday, and you're invited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77873d02-9d45-3621-91c9-afd9461fc945",
                                        "entry_id": "6705a9f5-b238-3b8f-9f99-2689d9c453bb",
                                        "glosses": [
                                            "Meat, especially pork or beef, which has been cooked in such an apparatus (i.e. smoked over indirect heat from high-smoke fuels) and then chopped up or shredded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "602693af-f290-440a-b28d-0010c593c55f",
                                                "sense_id": "77873d02-9d45-3621-91c9-afd9461fc945",
                                                "text": "She ordered a plate of barbecue with a side of slaw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba61d60a-097a-38e5-aeb4-72ff33d58695",
                                        "entry_id": "6705a9f5-b238-3b8f-9f99-2689d9c453bb",
                                        "glosses": [
                                            "A hog, ox, or other large animal roasted or broiled whole for a feast."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1eb2cbf-cbef-31fd-b436-c99547ade05c",
                                        "entry_id": "6705a9f5-b238-3b8f-9f99-2689d9c453bb",
                                        "glosses": [
                                            "A floor on which coffee beans are sun-dried."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b84ed2-a175-476d-9cd0-aa2c48ca6569",
                                                "sense_id": "a1eb2cbf-cbef-31fd-b436-c99547ade05c",
                                                "text": "Drying the coffee beans took place in a barbecue, basically a large, flat platform, where the pulped coffee beans could be laid out and turned as they dried. Barbecues were often walled around and raised above ground level."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "634ead2c-61e9-3e92-bf0c-03c7e2fb4e03",
                                        "entry_id": "6705a9f5-b238-3b8f-9f99-2689d9c453bb",
                                        "glosses": [
                                            "A framework of sticks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28503c34-9900-4870-a8c5-7232997d249e",
                                                "sense_id": "634ead2c-61e9-3e92-bf0c-03c7e2fb4e03",
                                                "text": "1705, William Dampier, Voyages and Descriptions, Volume 2, London: James Knapton, “A Supplement of the Voyage Round the World,” Chapter 5, p. 90,\nWe found no Houses of Entertainment on the Road, yet at every Village we came we got Houseroom, and a Barbacue of split Bambooes to sleep on."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barbecue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2f6370-4b30-34b2-aa83-2d3b301c22a3",
