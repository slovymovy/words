                "senses": [
                    {
                        "sense_id": "498871cd-6dcd-32bc-892e-1baffb635d39",
                        "entry_id": "ec68493a-63e5-36bf-b042-ab973ccf66bc",
                        "glosses": [
                            "Aufzeichnung von Zeiträumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81cfcd83-a733-40a4-9043-c69a5747143c",
                                "sense_id": "498871cd-6dcd-32bc-892e-1baffb635d39",
                                "text": "„Eine spanische Gewerkschaft hatte geklagt, weil sie für Angestellte der Deutschen Bank in Spanien eine Zeiterfassung erstreiten wollte.“"
                            },
                            {
                                "example_id": "7a59c41c-ab1d-477d-99fd-bb84dbec592f",
                                "sense_id": "498871cd-6dcd-32bc-892e-1baffb635d39",
                                "text": "„Beschäftigte können durch die exakte Zeiterfassung ihren Einsatz nachweisen-ist er überdurchschnittlich, kann das ein überzeugendes Argument zum Beispiel bei Gehaltsverhandlungen sein.“"
                            },
                            {
                                "example_id": "c8ca7833-fb58-494c-a321-b11cf3062e0b",
                                "sense_id": "498871cd-6dcd-32bc-892e-1baffb635d39",
                                "text": "„Tests finden immer wieder mittels Sensoren, Blickanalysen, Gehstudien und Zeiterfassungen statt. Mit diesen Daten werden dann die Einkaufstricks umgesetzt, um Verbraucherinnen und Verbraucher zu verführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
