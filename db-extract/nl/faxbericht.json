                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b598680d-80b2-470f-a1ad-d21784314750",
                                "sense_id": "48b5193e-fb66-37c7-85c9-54e72863429a",
                                "text": "Sandra Bullock (54) ontdekte bedrog via faxbericht: Sandra Bullock ontdekte in 2010 op opmerkelijke wijze dat haar man Jesse James haar bijna een jaar lang bedroog met tatoeagemodel Michelle ‘Bombshell’ McGee."
                            },
                            {
                                "example_id": "cfb86c9f-a51f-4340-bab5-8e8bfeae4bf6",
                                "sense_id": "48b5193e-fb66-37c7-85c9-54e72863429a",
                                "text": "De gevolgen van het faillissement ondervonden Dijkstra en co gisteren al. Toen bleek ineens dat ze nogmaals moesten betalen voor een excursie naar de vulkaan op het eiland, Teide By Night. Daarvan werden ze middels een faxbericht („volgens mij lopen ze wat achter hier”) op de hoogte gebracht."
                            }
                        ]
                    }
