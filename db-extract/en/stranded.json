                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "344cf085-c9bc-4c57-983c-987f6169a107",
                                                "sense_id": "fda3947f-3ef8-3472-86c0-2432de571217",
                                                "text": "Door annuleringen vanwege de dichte mist zijn honderden passagiers gestrand op het vliegveld."
                                            },
                                            {
                                                "example_id": "542540a0-60f9-4d69-b684-65e049c91ce6",
                                                "sense_id": "fda3947f-3ef8-3472-86c0-2432de571217",
                                                "text": "Er dreigen acties nu de onderhandelingen over een nieuwe cao zijn gestrand."
                                            },
                                            {
                                                "example_id": "40993261-a84f-43ac-9b4c-f23d4a92ae32",
                                                "sense_id": "fda3947f-3ef8-3472-86c0-2432de571217",
                                                "text": "De jongen naast me deed zijn koplamp aan waardoor de in de muur gekraste namen zichtbaar werden: hier waren al eerder mensen gestrand."
                                            },
                                            {
                                                "example_id": "1b57b4bb-a745-4a3d-902a-be1026697037",
                                                "sense_id": "fda3947f-3ef8-3472-86c0-2432de571217",
                                                "text": "Het gestrande tankschip lekt stookolie."
                                            },
                                            {
                                                "example_id": "05b82863-c836-44d1-89ac-0062de1dcf27",
                                                "sense_id": "fda3947f-3ef8-3472-86c0-2432de571217",
                                                "text": "Er zijn bussen ingezet om gestrande treinreizigers verder te vervoeren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
