                                        "sense_id": "99ff779c-707b-3183-9fe2-e65823cf1b3d",
                                        "entry_id": "fc5f2a27-b9ab-3772-a46b-f3987f77e7d1",
                                        "glosses": [
                                            "Relating to, affected with, or associated with abnormally enlarged adenoids."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
