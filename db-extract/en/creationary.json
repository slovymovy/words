    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f3f4a356-11bb-38c9-834d-4255f672157c",
                "word": "creationary",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "883f1612-9034-3c89-9e60-ec0955c189ad",
                        "entry_id": "f3f4a356-11bb-38c9-834d-4255f672157c",
                        "glosses": [
                            "Of or relating to creation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4f16a8-5370-4793-9b37-3bb0b9a4cdaf",
                                "sense_id": "883f1612-9034-3c89-9e60-ec0955c189ad",
                                "text": "Nay, let us but consider this, that, under a general creationary theory,—before any one evolutionary doctrine, Lamarckian, Vestigian, Erasmo-Darwinian, Carlo-Darwinian, or other, came up,—never, whether in affinities, or embryology, or geology, or geography, or even rudimentary organs, was there a single difficulty felt,—let us but consider this I say, and it will be plain to be seen that all that concerns affinities and the rest constitutes no fee-simple that shall be proper and peculiar to natural selection alone. (p. 151)\nBut these homologies and the rest we hold ourselves dispensed from the consideration of, simply in view of the fact that they were a material common to all the evolutionary theories, and never on the whole denied even by the creationary ones. (p. 341)"
                            },
                            {
                                "example_id": "ff8942fd-f290-4c32-a0b1-f23ebb0f7eda",
                                "sense_id": "883f1612-9034-3c89-9e60-ec0955c189ad",
                                "text": "The evolutionary hypothesis or theory is a much better theory than the creationary theory, but it is still only a theory, and Dr. Straton had only to point out that fact."
                            },
                            {
                                "example_id": "ec65a7cb-ada0-4b6c-aa99-23968e0ebc39",
                                "sense_id": "883f1612-9034-3c89-9e60-ec0955c189ad",
                                "text": "These verses are directed to individuals who don't acknowledge the incomprehensible aspects of God as represented by His wondrous creationary power."
                            }
                        ]
                    }
                ],
