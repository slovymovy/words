                ],
                "senses": [
                    {
                        "sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                        "entry_id": "b1d6923f-507d-32ef-bfa5-3d31a2a66636",
                        "glosses": [
                            "Jovial; exuberant; lighthearted; merry and in high spirits; exhibiting happiness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46367b3-ba66-4dd4-8c37-0f0da4412540",
                                "sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                                "text": "Nights candles are burnt out, and iocond Day / Stands tiptoes on the myſtie mountaine tops."
                            },
                            {
                                "example_id": "dc0acac1-f678-49b4-a1d6-4e0effcf21e6",
                                "sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                                "text": "Thou mak'ſt me merry: I am full of pleaſure, / Let vs be iocond. Will you troule the Catch / You taught me but whileare?"
                            },
                            {
                                "example_id": "247fb3d1-50ce-4ee6-8462-e3cbeadf6c3e",
                                "sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                                "text": "There was once a widdow faire, young, free, rich, and withall very pleaſant and iocund, that fell in loue with a certaine round and well-ſet ſeruant of a Colledge: […]"
                            },
                            {
                                "example_id": "e628f449-0e43-43f1-83ee-a18a8e0151cc",
                                "sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                                "text": "First in his train is jocund Health,\nContent, who o'er her distaff sings,\nAnd from the plough that honest Wealth\nWhich scorns the tear-bought robe of kings.—"
                            },
                            {
                                "example_id": "c811f997-28fb-4210-b1bd-babf28c3fa05",
                                "sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                                "text": "I was feeling blithe, almost jocund."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33ecb5da-21db-44ef-94ff-0648004d622b",
                        "source_entry_id": "b1d6923f-507d-32ef-bfa5-3d31a2a66636",
                        "source_sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                        "source_sense_description": "jovial, exuberant, lighthearted; merry and in high spirits",
                        "target_lang_word": "enjoué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enjoué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a95ae77-8e82-3c40-90d2-ea0676b61d4a",
                                        "entry_id": "7a1f70cf-7a39-320b-9555-389125c4edc4",
                                        "glosses": [
                                            "Qui a de l’enjouement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7cb51eb-b1ca-4ff4-a3c4-04ff96a31aa9",
                                                "sense_id": "2a95ae77-8e82-3c40-90d2-ea0676b61d4a",
                                                "text": "Ce fut pour ces raisons sans doute qu’il accueillit d’un air enjoué et d’une âme égale l’annonce câlinement faite par la Julie d’une paternité future […]."
                                            },
                                            {
                                                "example_id": "01e582f1-35e1-46e9-bc2f-bb913bd68ec0",
                                                "sense_id": "2a95ae77-8e82-3c40-90d2-ea0676b61d4a",
                                                "text": "Cette femme est très enjouée. — Sa conversation est toujours enjouée. — Il écrit d’un style enjoué."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enjoué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "713d0de0-724b-33d0-aa3d-88ed218ed540",
                                        "entry_id": "292b13ec-6858-352f-8089-53ea0c90daa1",
                                        "glosses": [
                                            "Mauvais plaisant."
                                        ],
                                        "tags": [
                                            "Guadeloupe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce2db1b2-7a54-45cd-84fc-f6230fee2d4d",
                                                "sense_id": "713d0de0-724b-33d0-aa3d-88ed218ed540",
                                                "text": "Je m’en souviens parfaitement, mais je n’ai rien à dire à un enjoué qui a eu l’audace de me soupçonner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enjoué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efe9b11c-11ea-3345-b57b-cbf916090f01",
                                        "entry_id": "1b191d17-3de1-3c21-a4c6-715fdeea429e",
                                        "glosses": [
                                            "Participe passé masculin singulier de enjouer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42788ab6-fea4-49c8-8b4a-ab38fb25727f",
                        "source_entry_id": "b1d6923f-507d-32ef-bfa5-3d31a2a66636",
                        "source_sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                        "source_sense_description": "jovial, exuberant, lighthearted; merry and in high spirits",
                        "target_lang_word": "gai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4ad8cc5-3345-3772-9afd-4aebda3e5c58",
                                        "entry_id": "be6e5a89-ac74-3a9f-a3af-82e5be2d4383",
                                        "glosses": [
                                            "Interjection qui s’emploie pour exciter à la gaieté et aussi au mouvement, à l’action."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19fb8519-d0e4-453b-a9d7-b02a2a9fc0b6",
                                                "sense_id": "b4ad8cc5-3345-3772-9afd-4aebda3e5c58",
                                                "text": "Allons, gai ! vous a-t-on donné votre congé ?"
                                            },
                                            {
                                                "example_id": "893b0426-d7d1-4318-84f9-9da0c87ad516",
                                                "sense_id": "b4ad8cc5-3345-3772-9afd-4aebda3e5c58",
                                                "text": "Gai ! gai ! serrons nos rangs, Espérance De la France ; Gai ! gai ! serrons nos rangs, En avant, Gaulois et Francs !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec0f5294-0f46-3aa4-9281-59fc5bc0bf60",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Enjoué, joyeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fa95a8-d3dc-48b5-9193-915826ef22e8",
                                                "sense_id": "ec0f5294-0f46-3aa4-9281-59fc5bc0bf60",
                                                "text": "Quoi qu’il en soit, l’espérance de revoir le pauvre baron gai et gaillard m’a bien épargné de la tristesse."
                                            },
                                            {
                                                "example_id": "bf95409e-851c-4c60-9c99-e5310625d9f3",
                                                "sense_id": "ec0f5294-0f46-3aa4-9281-59fc5bc0bf60",
                                                "text": "Et presque tous les jours, sur le minuit, il se croyait gai, parce qu’il était un peu ivre."
                                            },
                                            {
                                                "example_id": "d24d9d73-a6f7-4e02-bd35-d1412abccddb",
                                                "sense_id": "ec0f5294-0f46-3aa4-9281-59fc5bc0bf60",
                                                "text": "On ne pouvait rien voir de plus gracieux que cette svelte blondine, jeune, gaie, folâtre ; pas un homme qui eût résisté à ses agaceries."
                                            },
                                            {
                                                "example_id": "2bc79943-8fb3-4ec3-99de-b478c544eb0d",
                                                "sense_id": "ec0f5294-0f46-3aa4-9281-59fc5bc0bf60",
                                                "text": "Tout en procédant à sa toilette, elle parle toute seule, bavarde, gaie, animée, à cause qu’on est encore au printemps de la journée."
                                            },
                                            {
                                                "example_id": "cf81dca5-aaa5-4d31-9d06-0028da7f60af",
                                                "sense_id": "ec0f5294-0f46-3aa4-9281-59fc5bc0bf60",
                                                "text": "Un parent qui ne croit pas au Père Noël, n’est pas un bon parent car il ne croit pas en sa propre étoile ni en tout ce qui est positif dans la vie et gai !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d7e8a8-7ce8-3370-a4f9-94febac7282a",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Qui porte le caractère de la gaieté, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5e75bf-ab87-48ca-bbdd-51b4e9d2d46e",
                                                "sense_id": "77d7e8a8-7ce8-3370-a4f9-94febac7282a",
                                                "text": "Son visage était gai, sa bouche était vermeille."
                                            },
                                            {
                                                "example_id": "941f719d-1dba-4af9-ac1f-4a945d157ab3",
                                                "sense_id": "77d7e8a8-7ce8-3370-a4f9-94febac7282a",
                                                "text": "Un ravissant cimetière, tout gai, tout ensoleillé, tout fleuri de clématites et de roses entoure l’église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bcf8298-f1ae-3afa-8180-2f9cc9a9b5a1",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Où règne la gaieté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425d06e6-3acd-4bd1-987a-000bd10e51de",
                                                "sense_id": "2bcf8298-f1ae-3afa-8180-2f9cc9a9b5a1",
                                                "text": "Notre repas fut le plus gai du monde, et j’y fus plus gai que personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9e6d61d-2602-3c61-9891-6fdbd84987b1",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Qui inspire la gaieté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a6ad79-470e-460c-9f22-6cd7ebf3e8d3",
                                                "sense_id": "c9e6d61d-2602-3c61-9891-6fdbd84987b1",
                                                "text": "La frontière est passée, c’est l’Apennin qui commence. Un soleil gai luit sur les arêtes vives des cimes; la poitrine aspire un air sain."
                                            },
                                            {
                                                "example_id": "996df3ee-8b0f-43bc-b534-431c284bf072",
                                                "sense_id": "c9e6d61d-2602-3c61-9891-6fdbd84987b1",
                                                "text": "Sa maison était propre, bien tenue ; elle tranchait avec la blancheur gaie de sa façade et le luisant de ses meubles, sur les taudis immondes où, d’ordinaire, croupissent dans la fange et dans la vermine, les marins bretons."
                                            },
                                            {
                                                "example_id": "c1492d75-50d8-4bd0-a668-5969c211f763",
                                                "sense_id": "c9e6d61d-2602-3c61-9891-6fdbd84987b1",
                                                "text": "Un gai soleil éclairait la scène : une large avenue bordée de cavaliers, toute blanche de fleurs, éblouissante sous le dôme bleu du ciel."
                                            },
                                            {
                                                "example_id": "44b29be7-5dff-443b-a538-21ac9179a9fb",
                                                "sense_id": "c9e6d61d-2602-3c61-9891-6fdbd84987b1",
                                                "text": "Le vert est plus gai ; vous avez raison, il n’y a qu’à le laisser comme cela."
                                            },
                                            {
                                                "example_id": "7ebb5472-7020-4a44-ba79-4ca9370d5f5b",
                                                "sense_id": "c9e6d61d-2602-3c61-9891-6fdbd84987b1",
                                                "text": "Chambre gaie, appartement gai",
                                                "translation": "chambre, appartement qui, par sa disposition, et l’abondance du jour qu’il reçoit, inspire la gaieté."
                                            },
                                            {
                                                "example_id": "a2b8f98b-f935-43dc-a691-c83e2037598b",
                                                "sense_id": "c9e6d61d-2602-3c61-9891-6fdbd84987b1",
                                                "text": "Avoir le vin gai",
                                                "translation": "être ordinairement de belle humeur quand on a un peu bu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad505d1-5ed0-3770-b82f-7ed994a128f8",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Qui a ingéré une substance enivrante."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42d84da4-bcd0-43c9-8872-955d74f7b62c",
                                                "sense_id": "1ad505d1-5ed0-3770-b82f-7ed994a128f8",
                                                "text": "Le vieillard, que le vin de Montmeillan avait rendu gai et bavard, ne demandait pas mieux que de me les conter."
                                            },
                                            {
                                                "example_id": "217ba50c-cc33-4134-a57d-fce9c743fd61",
                                                "sense_id": "1ad505d1-5ed0-3770-b82f-7ed994a128f8",
                                                "text": "Comme ils devenaient un peu plus gais sur la fin du repas, selon la coutume des philosophes qui dînent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cbfce4a-cb77-3a25-82ea-6dbf084a1068",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Allegro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a703e6e3-c629-4938-80bb-a02958bfa803",
                                                "sense_id": "9cbfce4a-cb77-3a25-82ea-6dbf084a1068",
                                                "text": "Un air d’un mouvement gai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93b55105-548a-36a9-9371-40c5f85aa348",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Qui a trop de jeu, qui n’est pas assez serré."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d56094-d4e7-42de-a945-f778642ff137",
                                                "sense_id": "93b55105-548a-36a9-9371-40c5f85aa348",
                                                "text": "Cette vis est trop gaie."
                                            },
                                            {
                                                "example_id": "c0d736d9-7417-41a4-8033-7e39c55bd700",
                                                "sense_id": "93b55105-548a-36a9-9371-40c5f85aa348",
                                                "text": "Ma tabatière était trop gaie, elle s’est ouverte dans ma poche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c3e7499-d052-39b6-aaa6-a3fd5c359af0",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Se dit d’un mât ou de tout autre objet, lorsqu’il est trop lâche dans son trou ou dans la place qu’il occupe."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17478d54-ad10-32e5-8978-b1e20c275d3a",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Vif, léger et brillant, en parlant des couleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9560f7eb-98ca-4d3a-9533-93248e55cbb0",
                                                "sense_id": "17478d54-ad10-32e5-8978-b1e20c275d3a",
                                                "text": "Des couleurs gaies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18fa2c49-38dc-3ff9-81a3-a38ee49d2e79",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Gaillard, libertin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7893bb6-f80e-4140-872c-e4cd686ae0e3",
                                                "sense_id": "18fa2c49-38dc-3ff9-81a3-a38ee49d2e79",
                                                "text": "Propos, conte gai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6daf9de7-fd20-388a-99ef-9a30c81c1121",
                                        "entry_id": "3d242353-41bb-3274-9bcc-b76b22275e35",
                                        "glosses": [
                                            "Gay."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Acadie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "786fb546-f641-4ab1-bdf4-212ba4d5a1c6",
                                                "sense_id": "6daf9de7-fd20-388a-99ef-9a30c81c1121",
                                                "text": "Elle est gaie. C’est évident. Elle aime les filles. Florence préfère les filles aux garçons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gai",
                                "target_lang_code": "fr",
                                "target_senses": [
