                        "form": "das Antihistaminikum"
                    },
                    {
                        "form_id": "6f0d7d82-1bd4-48b2-a9c1-46773bd598c3",
                        "entry_id": "cde327be-b708-32ce-be66-ec534c686fff",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Antihistaminika"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66ec26da-36fc-3837-8426-90eea8bd2022",
                        "entry_id": "cde327be-b708-32ce-be66-ec534c686fff",
                        "glosses": [
                            "ein Medikament gegen Allergien, das über eine Blockade des H₁- oder H₂-Rezeptors antiallergisch, spasmolytisch, juckreizstillend und auch die Magensäuresekretion hemmend wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d320c428-74b5-4899-bb76-b866341b4194",
                                "sense_id": "66ec26da-36fc-3837-8426-90eea8bd2022",
                                "text": "„Antihistaminika werden entsprechend ihrer Selektivität für die vier verschiedenen Histaminrezeptoren in H1-, H2-, H3- und H4-Antihistaminika unterteilt.“"
                            },
                            {
                                "example_id": "251e19ce-e22f-4b7e-8372-d20afd5b139c",
                                "sense_id": "66ec26da-36fc-3837-8426-90eea8bd2022",
                                "text": "„Auch ein Antihistaminikum könne helfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f25db505-a71e-4e0c-a6cb-ac786b5eca68",
                        "source_entry_id": "cde327be-b708-32ce-be66-ec534c686fff",
                        "source_sense_id": "66ec26da-36fc-3837-8426-90eea8bd2022",
                        "source_sense_description": "ein Medikament gegen Allergien",
                        "target_lang_word": "antihistamine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antihistamine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36df36c3-bec5-31ba-8967-f79e44afb6a2",
                                        "entry_id": "e1680466-ad6b-3258-a567-92096c4115d0",
                                        "glosses": [
                                            "A drug or substance that counteracts the effects of a histamine. Commonly used to alleviate the symptoms of hay fever and other allergies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e300df73-5c62-4b01-b97a-02ad591421e1",
                                                "sense_id": "36df36c3-bec5-31ba-8967-f79e44afb6a2",
                                                "text": "Perhaps the most striking method of demonstrating the effect of antihistamine substances is to use them to protect guinea-pigs against the action of histamine sprayed into the air from an atomizer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a60759b-ba50-4e04-9b3c-64b134c1fe9a",
                        "source_entry_id": "cde327be-b708-32ce-be66-ec534c686fff",
                        "source_sense_id": "66ec26da-36fc-3837-8426-90eea8bd2022",
                        "source_sense_description": "ein Medikament gegen Allergien",
                        "target_lang_word": "antihistaminic drug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a48223ef-550d-4b06-894b-7e0ef460c1db",
                        "source_entry_id": "cde327be-b708-32ce-be66-ec534c686fff",
                        "source_sense_id": "66ec26da-36fc-3837-8426-90eea8bd2022",
                        "source_sense_description": "ein Medikament gegen Allergien",
                        "target_lang_word": "antihistaminique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antihistaminique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                        "entry_id": "d4eb9bf9-5419-3928-9800-994b8e6d25d6",
                                        "glosses": [
                                            "Médicament qui sert à réduire ou à éliminer les effets de l'histamine, un médiateur chimique endogène libéré, entre autres, au cours des réactions allergiques."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47d4ac7-0f68-4ffe-859c-57aa4336a2d9",
                                                "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                                "text": "Outre le GHB, de nombreuses substances sont utilisées pour soumettre chimiquement une personne. Des drogues, comme le GBL, l’ecstasy ou la MDMA, mais aussi des médicaments comme les antihistaminiques ou les benzodiazépines (Valium, Xanax…)."
                                            },
                                            {
                                                "example_id": "9ac7f1dc-6418-4273-84d9-7989ba1667dc",
                                                "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                                "text": "Parmi eux, l’ébastine, un antihistaminique (utilisé pour le traitement des rhinites ou de l’urticaire) et l’atovaquone (utilisée dans le traitement du paludisme)."
                                            },
                                            {
                                                "example_id": "e87266f9-8938-4a49-b8f1-57943e6e95f3",
                                                "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                                "text": "Un antihistaminique au long cours peut être utilisé ; il convient d’avoir recours aux médicaments les mieux tolérés (non sédatifs, non anticholinergiques)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
