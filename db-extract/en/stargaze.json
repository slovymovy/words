                "senses": [
                    {
                        "sense_id": "bccf2bcb-e171-3135-8325-d9cfb8c5eef6",
                        "entry_id": "fa96f45f-f9ea-3e1f-9536-ac6c8b65f5ca",
                        "glosses": [
                            "To look at the stars at night."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61263746-6b35-40ad-ba82-30ffe6f3053e",
                                "sense_id": "bccf2bcb-e171-3135-8325-d9cfb8c5eef6",
                                "text": "It was a very clear night so I paused to stargaze until I got cold and went in."
                            },
                            {
                                "example_id": "3b675817-4412-4cc0-ac4e-4ae511f5abec",
                                "sense_id": "bccf2bcb-e171-3135-8325-d9cfb8c5eef6",
                                "text": "\"That's right,\" declared Browning's companion. \"I was out stargazing last night. Looked at the Long-Handled Dipper a long time, and it gave me an awful thirst. I've had it with me all day. Yes, mine's ale.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "1758cc30-48b6-3776-a5ff-e1b80602d733",
                        "entry_id": "fa96f45f-f9ea-3e1f-9536-ac6c8b65f5ca",
                        "glosses": [
                            "To gaze engrossed with emotion or contemplatively."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b8ee3b17-77bd-479d-bbfd-f7439836d21c",
                                "sense_id": "1758cc30-48b6-3776-a5ff-e1b80602d733",
                                "text": "Before books came into my life, I was given to stargazing and daydreaming. When books were given me, I fell upon them as a glutton pounces on his meat after a period of enforced starvation."
                            }
                        ]
                    }
                ],
