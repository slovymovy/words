                        "translation_id": "2eaf7006-86e3-4fcd-a792-7be75c324c14",
                        "source_entry_id": "dc2d31c4-6a24-34f4-b9b3-621cf73839e4",
                        "source_sense_id": "a7509f9b-02f8-3140-8915-e8071c6f5e6f",
                        "target_lang_word": "nuclear physicist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear physicist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                        "entry_id": "59dcb22c-9c55-3a37-9ae9-9881f318e0c3",
                                        "glosses": [
                                            "a scientist of nuclear physics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6358af6-f516-41c2-b3d8-be7e4f04365f",
                                                "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                                "text": "Certainly it would be better if he were a nuclear physicist. On the other hand, I believe that a team of that sort would give stronger support to industrial work than a team of four nuclear engineers."
                                            },
                                            {
                                                "example_id": "b47fb971-0e1b-4380-a179-2c0e4789077f",
                                                "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                                "text": "Explaining the history is a nuclear physicist who is also an accomplished writer."
                                            },
                                            {
                                                "example_id": "9d2bf31a-f746-48d1-aaaf-4ad5e525bc04",
                                                "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                                "text": "And Theodore Taylor, the nuclear physicist who designed America's smallest and largest atomic bombs, has repeatedly stated that given fissile material, building a bomb is \"very easy. Double underline. Very easy.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
