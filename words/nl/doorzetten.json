{
    "word_family": [
        "doorzetter",
        "doorzettingsvermogen",
        "doorzetting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97184dd4-0bcd-3ed7-89a9-d65dbe5a49be",
                    "sense_definition": "volhouden met een bepaalde actie of een plan, ondanks moeilijkheden of weerstand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "volharden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks het slechte weer <w>zette</w> de fietser de zware tocht <w>door</w>.",
                            "target_lang_translations": {
                                "en": "Despite the bad weather, the cyclist <w>pushed through</w> the difficult journey."
                            }
                        },
                        {
                            "text": "Je moet echt even <w>doorzetten</w> om je diploma te halen.",
                            "target_lang_translations": {
                                "en": "You really need to <w>persevere</w> for a bit to get your diploma."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorbijten",
                        "doordrukken"
                    ],
                    "antonyms": [
                        "opgeven"
                    ],
                    "common_phrases": [
                        "even doorzetten",
                        "een plan doorzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "To persist with a certain action or plan despite difficulties or resistance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "persevere",
                                "target_lang_sense_clarification": "to continue despite obstacles"
                            },
                            {
                                "target_lang_word": "push through",
                                "target_lang_sense_clarification": "to complete something difficult"
                            },
                            {
                                "target_lang_word": "carry on",
                                "target_lang_sense_clarification": "to continue an activity"
                            },
                            {
                                "target_lang_word": "persist",
                                "target_lang_sense_clarification": "to continue firmly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c56224fe-1675-322c-9f4c-03e70cffcdcc",
                    "sense_definition": "zich verder ontwikkelen of in kracht toenemen, vaak gezegd van ziekte of weersomstandigheden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik dacht ziek te worden, maar het <w>zette</w> gelukkig niet <w>door</w>.",
                            "target_lang_translations": {
                                "en": "I thought I was getting sick, but fortunately it didn't <w>take hold</w>."
                            }
                        },
                        {
                            "text": "De regen <w>zet door</w> en het zal de hele middag blijven vallen.",
                            "target_lang_translations": {
                                "en": "The rain is <w>persisting</w> and it will continue to fall all afternoon."
                            }
                        }
                    ],
                    "common_phrases": [
                        "niet doorzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "To develop further or increase in intensity, often said of illness or weather conditions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "persist",
                                "target_lang_sense_clarification": "of weather or symptoms continuing"
                            },
                            {
                                "target_lang_word": "set in",
                                "target_lang_sense_clarification": "of weather or illness becoming established"
                            },
                            {
                                "target_lang_word": "take hold",
                                "target_lang_sense_clarification": "to become established or stronger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb1378d2-0641-3667-8549-754aa80d388f",
                    "sense_definition": "meervoud verleden tijd van <w>doorzetten</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij vertelden dat zij de actie ondanks de kritiek toch <w>doorzetten</w>.",
                            "target_lang_translations": {
                                "en": "They said that they <w>pushed through</w> with the action despite the criticism."
                            }
                        },
                        {
                            "text": "Het was bewonderenswaardig hoe de studenten vorig jaar <w>doorzetten</w>.",
                            "target_lang_translations": {
                                "en": "It was admirable how the students <w>persevered</w> last year."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural past tense of 'doorzetten' (persevered/pushed through)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "persevered",
                                "target_lang_sense_clarification": "past tense of persevere"
                            },
                            {
                                "target_lang_word": "pushed through",
                                "target_lang_sense_clarification": "past tense of push through"
                            }
                        ]
                    }
                }
            ]
        }
    ]
