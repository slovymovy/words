                                            {
                                                "example_id": "0650cb1f-ef87-4731-ba0d-ca433d728699",
                                                "sense_id": "b32b44c8-ed22-3e99-a4cd-685ba2bec369",
                                                "text": "What an exceptional meal!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a35869b5-3eff-39f7-96d3-0b36900a042f",
                                        "entry_id": "5109be1c-e596-30f2-a5ca-553511677b5c",
                                        "glosses": [
                                            "Forming an exception; not ordinary; uncommon; rare.",
                                            "Requiring special schooling for reasons of intellectual giftedness or physical or mental disability."
                                        ],
                                        "tags": [
                                            "of a student"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ea6e19f-17d0-48dc-8070-b27466f4f95f",
                                                "sense_id": "a35869b5-3eff-39f7-96d3-0b36900a042f",
                                                "text": "The origins of the conditions and disorders that exceptional learners have are not always well understood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc475660-fe74-3a24-8320-476bcbce48e5",
                                        "entry_id": "5109be1c-e596-30f2-a5ca-553511677b5c",
                                        "glosses": [
                                            "Better than the average; superior due to exception or rarity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ff7ff8-bb1f-4fbe-bc75-8bff0852de3f",
                                                "sense_id": "fc475660-fe74-3a24-8320-476bcbce48e5",
                                                "text": "The quality of the beer was exceptional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27279db9-6755-3120-b30e-8d75eb0e087d",
                                        "entry_id": "5109be1c-e596-30f2-a5ca-553511677b5c",
                                        "glosses": [
                                            "Corresponding to something of lower dimension under a birational correspondence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f771268-f3bb-4e86-8637-ddfe0d3f7d88",
                                                "sense_id": "27279db9-6755-3120-b30e-8d75eb0e087d",
                                                "text": "an exceptional curve; an exceptional divisor"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exceptional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7ab4f4-cc6e-3fd8-bb9f-b8e67ec0c137",
                                        "entry_id": "dd05d34f-50e3-3c8c-b8e6-7b43797aa8a7",
                                        "glosses": [
                                            "An exception, or something having an exceptional value"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede382e2-5306-48ac-b0b7-e196864e4ca7",
                                                "sense_id": "0b7ab4f4-cc6e-3fd8-bb9f-b8e67ec0c137",
                                                "text": "Above and beyond all these exceptionals, by reason of divergencies from the norms of mental and of physical status, there are quite a number of moral defectives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c520a1b-ec4c-4b35-84f9-46b716a4902c",
                        "source_entry_id": "47a046c0-8a2f-3bc9-9374-3056e3a356d6",
                        "source_sense_id": "e6645467-a034-3d01-90bf-d7a7b0d66038",
                        "target_lang_word": "exceptionnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exceptionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7502c854-5ab1-3d15-aea8-b0702a2364b7",
                                        "entry_id": "cd7793e3-87af-36c4-bbbd-20021a36349b",
                                        "glosses": [
                                            "Qui est relatif à une exception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedb7b62-6f4a-4a05-987d-c28d0688419a",
                                                "sense_id": "7502c854-5ab1-3d15-aea8-b0702a2364b7",
                                                "text": "Brest, exceptionnelle enclave, est, en somme, la seule commune où un esprit anticlérical, se manifeste ouvertement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                        "entry_id": "cd7793e3-87af-36c4-bbbd-20021a36349b",
                                        "glosses": [
                                            "Qui est rare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71a11cc-1f8c-4418-943d-ad38df53fb02",
                                                "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                                "text": "Le pape Innocent III (1193-1216) devait rompre avec cette tradition de tolérance et se faire l'inspirateur d'une politique hostile, qu'il mena avec une vigueur exceptionnelle."
                                            },
                                            {
                                                "example_id": "243c75af-bd0f-42a4-ac15-a5381530050c",
                                                "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                                "text": "C'est un garçon fort agréable que Bernard. Soigné, rasé de près, le teint clair, il s'exprime dans une langue choisie et ne fait usage de l'argot qu'en d'exceptionnelles circonstances."
                                            },
                                            {
                                                "example_id": "1c9d3029-7a3b-4c00-a040-436be0b1eac1",
                                                "sense_id": "2dd53905-c32d-3173-a512-f2ad02210344",
                                                "text": "Mais il fallait que ce bon mouvement ne demeurât point exceptionnel, et se prolongeât au-delà du succès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
