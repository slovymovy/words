                        "cross_references": []
                    },
                    {
                        "translation_id": "ae737a38-5822-4b18-8c53-78d9f04b2fa5",
                        "source_entry_id": "117b3852-66f9-337a-88e1-79039569c78b",
                        "source_sense_id": "0c717bb3-82b7-3183-92e2-bbb47fb6a19b",
                        "target_lang_word": "Notation",
