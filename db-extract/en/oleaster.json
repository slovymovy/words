                        "cross_references": [
                            {
                                "target_word": "лох",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7e23c7-8cbc-379a-9164-751e5ff69c26",
                                        "entry_id": "4a2c9ce7-ce28-3213-bcb1-db00a9fe8df9",
                                        "glosses": [
                                            "ботан. род кустарников и небольших деревьев семейства лоховые (лат. Elaeagnus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce688db-97c6-485e-870a-7eca6eb497df",
                                                "sense_id": "4d7e23c7-8cbc-379a-9164-751e5ff69c26",
                                                "text": "Для этой цели были подобраны .. наиболее засухоустойчивые и солевыносливые породы деревьев и кустарников: для первого (верхнего) яруса посадок — карагач и лох узколистный и для второго (нижнего) — тамарикс."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b148983-a1ef-3c6c-978a-6f815cb0c333",
                                        "entry_id": "4a2c9ce7-ce28-3213-bcb1-db00a9fe8df9",
                                        "glosses": [
                                            "ботан. эфироносный, медоносный кустарник или деревце с узкими длинными листьями и съедобными плодами (ягодами) семейства лоховые; дикая маслина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9be66b1-5be2-4ed6-8a16-ad8e2acf103c",
                                                "sense_id": "3b148983-a1ef-3c6c-978a-6f815cb0c333",
                                                "text": "Они пересекли прямиком неглубокий сай, заросший тамариском и лохом."
                                            },
                                            {
                                                "example_id": "ae715aef-1893-43a5-abc0-c8f06c5dff68",
                                                "sense_id": "3b148983-a1ef-3c6c-978a-6f815cb0c333",
                                                "text": "На пустошах колючий лох отворял свой невидный жёлтенький цвет, задошливо-пряный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c814bc6-62a7-33a8-bde1-57c20c286feb",
                                        "entry_id": "4a2c9ce7-ce28-3213-bcb1-db00a9fe8df9",
                                        "glosses": [
                                            "плод такого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba28588-acfa-45a4-99b8-06ebe2ebff14",
                                                "sense_id": "1c814bc6-62a7-33a8-bde1-57c20c286feb",
                                                "text": "Чтобы приготовить из лоха сироп, нужно залить плоды водой и довести её до кипения."
                                            },
                                            {
                                                "example_id": "952ffd70-8b53-43ea-a040-9d7d543a468d",
                                                "sense_id": "1c814bc6-62a7-33a8-bde1-57c20c286feb",
                                                "text": "Под белёсой их кожицей — кофейное, сладкое масло: недаром лох называют у нас «маслёнкой»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "лох",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5e9d9361-b07a-3eb0-b361-62ddbc7b01be",
                                        "entry_id": "b5da886b-a2c7-3090-9bc0-8f204dca84b4",
                                        "glosses": [
                                            "рег. (обонежск.), рег. (нарвск.) то же, что лосось"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b4f85c0-a769-447a-911b-0c918c667a30",
                                                "sense_id": "5e9d9361-b07a-3eb0-b361-62ddbc7b01be",
                                                "text": "В сих водах, невских и морских, родятся рыбы различнаго рода: осетры, которые величиною болше яицких (весом от шести до десяти пуд), но весма мало или редко оных родятся; стерледи (которые называются костерка, весом бывают около тридцати фунтов), оных очень редко случается, и то, сказывают, ежели подлинно, будто оные нарочно с Волги привезенныя для размножения выпущены; щуки; лещи; судаки; сиги; харьюзы; лохи; окуни; плотва; караси, и то редко; ряпуха; корюха; временем сия рыба воняет или пахнет огурцами; минога; налимы; пескари; ерьши; угри."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58daadfc-7832-3132-9186-4f2f18438db9",
                                        "entry_id": "b5da886b-a2c7-3090-9bc0-8f204dca84b4",
                                        "glosses": [
                                            "устар. и рег. (сев.-русск.) самец сёмги в период нереста и после него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d3ff44-601a-411e-acae-4646780b2512",
                                                "sense_id": "58daadfc-7832-3132-9186-4f2f18438db9",
                                                "text": "То сын Карелы молчаливый // Беспечных лохов стан сонливый // Тревожит меткой острогой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0267cc7-e39e-372a-8312-b252bf1fea90",
                                        "entry_id": "b5da886b-a2c7-3090-9bc0-8f204dca84b4",
                                        "glosses": [
                                            "рег. (ср.-волжск.), рег. (смол.) ручьёвая форель Salmo trutta"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03c04e3d-170b-3a7b-a0b5-69ee5c43c9f1",
                                        "entry_id": "b5da886b-a2c7-3090-9bc0-8f204dca84b4",
                                        "glosses": [
                                            "рег. (вятск.), рег. (уфимск.), рег. (оренб.) то же, что таймень"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "лох",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "33aa3416-13f9-3401-bf5f-9792112ff262",
                                        "entry_id": "4a2320af-1d77-31c4-b5c1-51dab0019134",
                                        "glosses": [
                                            "жарг., бран. глупый, ограниченный человек; растяпа, простак, простофиля; потенциальная жертва преступника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "847f6efd-1147-4ebc-a399-7b46b19d61ee",
                                                "sense_id": "33aa3416-13f9-3401-bf5f-9792112ff262",
                                                "text": "Это отбросы Тьмы, неудачники, лохи, либо лишённые перспектив, либо имеющие слишком много недостатков."
                                            },
                                            {
                                                "example_id": "b4974d17-b164-46d4-a9b9-471247c6ba45",
                                                "sense_id": "33aa3416-13f9-3401-bf5f-9792112ff262",
                                                "text": "— Значит, кинули меня, — констатировал Олег. — Да ещё и лохом обозвали."
                                            },
                                            {
                                                "example_id": "9503bb76-cd57-4061-a42b-f152eb3b7a4a",
                                                "sense_id": "33aa3416-13f9-3401-bf5f-9792112ff262",
                                                "text": "Страшным оскорблением у школьников (и у предпринимателей) является лексема лох — «дурак; неполноценная личность» (в арго — «жертва преступления; дурак»). ❬…❭ Кстати, в прессе часто встречаются слово лох и его производные: лоходром — «место скопления лохов», лохотрон, «лотерея, устраиваемая мошенниками на улице», лохотронщик — «организатор или участник лохотрона»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030f2848-f803-3895-8aad-cdeca6f1def4",
                                        "entry_id": "4a2320af-1d77-31c4-b5c1-51dab0019134",
                                        "glosses": [
                                            "жарг., пренебр. человек, не сведущий в чём-либо; дилетант"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272e0cbd-d560-4b87-96b5-24a19ccde817",
                                                "sense_id": "030f2848-f803-3895-8aad-cdeca6f1def4",
                                                "text": "Лох щёки раздувает, коллекционера из себя корчит."
                                            },
                                            {
                                                "example_id": "6d693fad-65a3-4e0b-a1a7-243bbeb50518",
                                                "sense_id": "030f2848-f803-3895-8aad-cdeca6f1def4",
                                                "text": "Ну, обращался он к нам по автомобильным делам. Он ведь в моторах — лох полный, чайник! Вентилятора от карбюратора не отличает!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "881584a7-844b-32e9-a0d2-671b31d13340",
                                        "entry_id": "4a2320af-1d77-31c4-b5c1-51dab0019134",
                                        "glosses": [
                                            "рег. (Пск.), устар. лоховес, шалопай (на офенском: мужик, крестьянин вообще) [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8159f02e-f8d8-4dcf-b1c1-c4bdd7f80cfa",
                                                "sense_id": "881584a7-844b-32e9-a0d2-671b31d13340",
                                                "text": "Афенский язык, который мне выдаётся за портновский. Баба — кубася ❬…❭ Мужик — лох ❬…❭ «Чёрт-мужик! Я тебя, чёрта-мужика, обшиваю, часто обшиваю хорошо, в тачку я те, чёрт-мужик, пуговку пришил». «Йос лох, я тебе, ясалоха, обутываю, кунавать лолмавато кумлевата, я тебе, йос лох, сутлачку прибутал». ❬…❭ Этот язык называется офенским, но он, как говорят, разнится от офенского владимирского: те цыган понимать не могут."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "лох",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9aa60d44-7d2d-31b0-a0ca-7e768d646e61",
                                        "entry_id": "03784afd-8100-3daa-90b3-0888b0c48596",
                                        "glosses": [
                                            "истор. воинское подразделение в Древней Греции, содержавшее от 100 до 1000 человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937496d0-2ff3-4c77-a793-45135f9c3233",
                                                "sense_id": "9aa60d44-7d2d-31b0-a0ca-7e768d646e61",
                                                "text": "К концу V века до н. э. спартанская армия имела 8 лохов."
                                            },
                                            {
                                                "example_id": "4f292f1e-5d8b-4219-853a-6ff2e90b5756",
                                                "sense_id": "9aa60d44-7d2d-31b0-a0ca-7e768d646e61",
                                                "text": "Каждая мора состояла из четырёх лохов, лох — из двух пентекостий, пентекостия — из двух эномотий."
                                            },
                                            {
                                                "example_id": "9fa44d7d-2ed0-45e0-9411-302cf182f996",
                                                "sense_id": "9aa60d44-7d2d-31b0-a0ca-7e768d646e61",
                                                "text": ".. но при переходе через горы в долину погибли два лоха Менона. Одни рассказывали, будто они были изрублены киликийцами во время какого-то грабежа, другие - что они отстали от своих .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55babc5f-bbb3-4e5d-bac1-f01c2787e794",
