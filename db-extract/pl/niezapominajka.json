                        "cross_references": [
                            {
                                "target_word": "ne-m’oubliez-pas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0076e2cd-8fda-3ff0-a681-17b89e933f5c",
                                        "entry_id": "8a247a18-a579-3f24-ad03-d7e63c30f80e",
                                        "glosses": [
                                            "Myosotis."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea98c6f6-322f-3d0b-bcb0-08ccaed2c95b",
                                        "entry_id": "8a247a18-a579-3f24-ad03-d7e63c30f80e",
                                        "glosses": [
                                            "De la couleur du myosotis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57b060a-6a0b-4869-8e1e-c351a5010d6f",
                                                "sense_id": "ea98c6f6-322f-3d0b-bcb0-08ccaed2c95b",
                                                "text": "Qu’on se figure le globe terrestre bleu ciel, mais d’un bleu tirant légèrement sur le ne-m’oubliez-pas de la tunique de Stumm, fait tout entier de bonheur, de fierté, et de ce mystérieux phosphore de l’illumination intérieure ; au centre de ce globe, le cœur du général, et sur ce cœur, comme Marie sur la tête du serpent, une femme divine dont le sourire, mêlé à toutes choses, est en même temps leur pesanteur secrète : on obtiendra à peu près l’impression que Diotime fit sur Stumm von Bordwehr dès la première heure où son image avait enchaîné les lents mouvements de ses yeux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dea39f9d-6c28-4903-9beb-a1ca8441f7ce",
                        "source_entry_id": "46a0bfb3-171d-3431-a389-7ba0e31b3d04",
                        "source_sense_id": "bd465060-41e9-311c-b0b1-956f9ee137b5",
                        "target_lang_word": "oreille-de-souris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oreille-de-souris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd7e2a43-d57c-313b-bc50-f756af102a04",
                                        "entry_id": "cae2160b-e46a-36e0-8478-6bda1f17d49b",
                                        "glosses": [
                                            "Myosotis, sorte de petite plante à fleurs bleues et quelquefois blanches, dont une espèce, à feuilles velues, croît au bord des eaux et dans les lieux humides; on l’appelle communément ne m’oubliez pas."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "685852ca-6ee0-439f-affe-c1e26b34da5a",
                        "source_entry_id": "46a0bfb3-171d-3431-a389-7ba0e31b3d04",
                        "source_sense_id": "bd465060-41e9-311c-b0b1-956f9ee137b5",
                        "target_lang_word": "myosotis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myosotis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b46ee99-e230-3036-ae4b-5b62b0bc3585",
                                        "entry_id": "446b7fb1-24ac-3971-87db-6889d15b1182",
                                        "glosses": [
                                            "Plante du genre Myosotis de la famille des Boraginaceae (borraginées ou Boraginacées) aux fleurs généralement bleues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6654469-2ec0-408d-9ad0-551588f4c220",
                                                "sense_id": "1b46ee99-e230-3036-ae4b-5b62b0bc3585",
                                                "text": "Le bouquet de myosotis montait lentement à ses lèvres."
                                            },
                                            {
                                                "example_id": "b45641da-c858-4eef-b1a1-cfbcb02cc4b4",
                                                "sense_id": "1b46ee99-e230-3036-ae4b-5b62b0bc3585",
                                                "text": "Les anémones empourprées par le sang d’Adonis, les myosotis bleus, et tous ces charmants bouquets qu’elle composait aux jours lointains de votre court bonheur."
                                            },
                                            {
                                                "example_id": "c78c93af-79f7-4ab4-af15-a28590f5a07a",
                                                "sense_id": "1b46ee99-e230-3036-ae4b-5b62b0bc3585",
                                                "text": "C’est ce brin de myosotis qui devait lui rafraîchir la mémoire. Le myosotis a toujours passé pour un végétal mémorifère en diable."
                                            },
                                            {
                                                "example_id": "9882a706-0caa-4764-9a2a-95e88193ad4b",
                                                "sense_id": "1b46ee99-e230-3036-ae4b-5b62b0bc3585",
                                                "text": "La scène où Lady Chatterley regarde Mellors poser un myosotis sur son pubis glorifie l’instinct sexuel, exalte son emprise sur l’esprit et provoqua, en son temps, un scandale absolu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "myosotis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0744fbc-b326-3e8a-974b-9cec7aa7c171",
                                        "entry_id": "ed891e09-a64f-39ab-81a0-a88912818eb7",
                                        "glosses": [
                                            "De la couleur du myosotis."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8faa1d7d-7220-4824-85b0-e6e187783b7c",
                                                "sense_id": "d0744fbc-b326-3e8a-974b-9cec7aa7c171",
                                                "text": "L’homme, un énorme sergent-major aux yeux myosotis, abandonna une seconde le garde-à-vous dans lequel il s’était immobilisé."
                                            },
                                            {
                                                "example_id": "81a9c5d3-5c8e-4d71-bfc3-c8b9e579daf6",
                                                "sense_id": "d0744fbc-b326-3e8a-974b-9cec7aa7c171",
                                                "text": "Ses yeux qui avaient le bleu du myosotis exprimaient une mélancolie profonde sauf quand il vous plongeait son crochet dans la chair. À cet instant, deux points rouges apparaissaient dans ses prunelles et les illuminaient abominablement"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
