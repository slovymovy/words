                                        "glosses": [
                                            "η προσπάθεια που γίνεται για να προλάβουμε εκ των προτέρων και να αποτρέψουμε κάποιες αρνητικές ή ανεπιθυμητες καταστάσεις, ενέργειες ή συνέπειες"
                                        ],
                                        "tags": [],
