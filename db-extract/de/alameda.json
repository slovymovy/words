                "senses": [
                    {
                        "sense_id": "01adac91-49d7-37e2-896c-2add11d29dfd",
                        "entry_id": "a12512d8-9a9a-3447-9a1c-61dc8b54a16c",
                        "glosses": [
                            "mit Bäumen bestandene Promenade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e111787-9049-45f4-8699-6765e3c9b35f",
                                "sense_id": "01adac91-49d7-37e2-896c-2add11d29dfd",
                                "text": "„Der Abend war mild und warm, und in der kleinen Alameda ließen sich unter gegenseitigem Zurufen Stärlinge auf den Bäumen nieder.“"
                            },
                            {
                                "example_id": "8e82a307-a758-4d61-b1c3-e56cc49b9426",
                                "sense_id": "01adac91-49d7-37e2-896c-2add11d29dfd",
                                "text": "„Sie warteten in der heruntergekommenen kleinen Alameda bei ihren Pferden; der Wind peitschte die Bäume, die im grauen Dämmer hockenden Vögel schrien und klammerten sich an die Zweige, der Schnee wehte wirbelnd über den kleinen Platz, hüllte die Lehmhäuser dahinter in Totengewänder, ließ die Rufe der Händler, die dem Trupp gefolgt waren, verstummen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
