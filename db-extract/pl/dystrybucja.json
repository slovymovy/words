                        "examples": [
                            {
                                "example_id": "03643604-b2c3-40c3-ab34-3b4d7d58345e",
                                "sense_id": "acd6b36e-97c8-312b-aed3-54a129f426a3",
                                "text": "Przedsiębiorstwo zajmuje się dystrybucją odzieży, obuwia, sprzętu i akcesoriów sportowych oraz wyposażenia trekkingowego na terenie Europy Środkowej, Południowej i Wschodniej głównie przez własną sieć salonów sportowych."
                            },
                            {
                                "example_id": "9f89611e-0de2-4324-876f-382356154935",
                                "sense_id": "acd6b36e-97c8-312b-aed3-54a129f426a3",
                                "text": "Dystrybucją kosmetyków z najwyższej półki cenowej zajmują się głównie firmy działające na zasadzie ajencji oraz oficjalni przedstawiciele […]"
                            }
