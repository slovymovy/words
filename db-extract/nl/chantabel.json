                ],
                "senses": [
                    {
                        "sense_id": "31fded6d-53e5-372b-bed2-e8387879c47c",
                        "entry_id": "9cfa7dde-379e-3824-b4a0-6ae33b98a19c",
                        "glosses": [
                            "van een persoon de hij of zij af te persen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1486c06-68a1-42eb-bda1-bf8096d0448b",
                                "sense_id": "31fded6d-53e5-372b-bed2-e8387879c47c",
                                "text": "Hij werkte voor een particulier onderzoeksbureau dat was ingehuurd door de Democraten. Die hoopten vuile was te vinden van Trump tijdens de verkiezingscampagne. Steele schreef onder meer dat kandidaat Donald Trump chantabel was omdat de Russische regering gevoelige informatie en ook beelden van een orgie in Moskou over hem zou bezitten."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c46a1bb-31d6-3b13-a55d-675bd39365ee",
                        "entry_id": "9cfa7dde-379e-3824-b4a0-6ae33b98a19c",
                        "glosses": [
                            "van een organisatie dat deze af te persen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d152ea5-1455-4ed7-aaf7-88b4eb5a6258",
                                "sense_id": "1c46a1bb-31d6-3b13-a55d-675bd39365ee",
                                "text": "Bedrijven als Shell en Unilever zouden overwegen om hun hoofdkantoor uit Nederland terug te trekken. Afschaffing van de dividendbelasting, wat gunstig is voor aandeelhouders, zou dat kunnen voorkomen. GroenLinks-leider Jesse Klaver zegt in reactie daarop dat het kabinet ‘chantabel’ is gebleken voor grote bedrijven."
                            },
                            {
                                "example_id": "5a0095ff-76c1-472d-8422-b603b8cb0572",
                                "sense_id": "1c46a1bb-31d6-3b13-a55d-675bd39365ee",
                                "text": "We leven in een netwerk van fiscale afspraken, die vooral voordelig zijn voor de fiscaal adviseurs die door de bomen het bos nog zien. Het Centraal Planbureau zegt geen goede studies te kennen naar het daadwerkelijke effect van verlaging van dividendbelasting voor bedrijven. Macro-economen constateren met gebrekkig bewijs dat het ineffectief is. Wat is waar? Willen we het risico nemen om stoer te zeggen dat wij niet chantabel zijn met dreigement van multinationals om te vertrekken? Wat als ze het toch doen?"
                            }
                        ]
                    }
