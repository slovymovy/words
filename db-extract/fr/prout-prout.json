                "senses": [
                    {
                        "sense_id": "fa794659-8ab3-3597-a78e-62d27e7e8b09",
                        "entry_id": "0353174b-8501-3aac-a9cf-840ca4a375e6",
                        "glosses": [
                            "Se dit de quelqu’un qui est trop distingué, précieux, qui fait beaucoup de manières."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b2ecdb06-8964-4e14-8334-4e5986141b9d",
                                "sense_id": "fa794659-8ab3-3597-a78e-62d27e7e8b09",
                                "text": "Très prout-prout la dame. La lèvre pincée, le regard jaugeur, la mine inquisitrice, le maintien guindé, le geste maniéré, tout cela contribue à bâtir cet être de bois et de pierre."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4318eaa-f681-3245-b42b-abfc9f2127c3",
                        "entry_id": "0353174b-8501-3aac-a9cf-840ca4a375e6",
                        "glosses": [
                            "Qui dénote des manières précieuses, ou qui en est le lieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0c92a4-7ec0-4dee-928e-460a4a0f4f90",
                                "sense_id": "b4318eaa-f681-3245-b42b-abfc9f2127c3",
                                "text": "Faut m’tutoyer, ma p’tite Mack, sinon ça fait trop prout prout pour les lieux ! »"
                            },
                            {
                                "example_id": "052efef6-2d0a-49e9-aef8-cfafa4d3958e",
                                "sense_id": "b4318eaa-f681-3245-b42b-abfc9f2127c3",
                                "text": "A New York City, tous les restos un peu prout-prout portent des noms de prénoms français."
                            }
                        ]
                    }
