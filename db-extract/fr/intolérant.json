                                        "sense_id": "d02df952-2bc0-3278-b512-5501997ca92b",
                                        "entry_id": "5702f346-da0c-366d-9b84-6e1eda103598",
                                        "glosses": [
                                            "Unable or indisposed to tolerate, endure or bear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5e69931-88bf-4ef7-ae04-9042d9541d03",
                                                "sense_id": "d02df952-2bc0-3278-b512-5501997ca92b",
                                                "text": "I am lactose-intolerant, so I can't drink milk."
                                            },
                                            {
                                                "example_id": "14c3efad-9170-4b30-803e-b902fc41a8fa",
                                                "sense_id": "d02df952-2bc0-3278-b512-5501997ca92b",
                                                "text": "When our bodies no longer create the enzyme needed to break down lactose, we can become intolerant to it."
                                            },
                                            {
                                                "example_id": "87eec3a8-30b0-4ca7-bb4a-30548c37083e",
                                                "sense_id": "d02df952-2bc0-3278-b512-5501997ca92b",
                                                "text": "The oak, as is well known, is a slow-growing, dicotyledonous tree of peculiar spreading habit, and very intolerant of shade."
                                            },
                                            {
                                                "example_id": "bb2956be-2aab-4725-97e2-8c9a1722c39a",
                                                "sense_id": "d02df952-2bc0-3278-b512-5501997ca92b",
                                                "text": "The powers of human bodies being limited and intolerant of excesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc71a604-7eb9-3bd3-9da2-f61d62e5a975",
                                        "entry_id": "5702f346-da0c-366d-9b84-6e1eda103598",
                                        "glosses": [
                                            "Not tolerant; close-minded about new or different ideas; indisposed to tolerate contrary opinions or beliefs; impatient of dissent or opposition; denying or refusing the right of private opinion or choice in others; inclined to persecute or suppress dissent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "intolerant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18019eb7-ebbd-3eae-bd20-c9e162b11d36",
                                        "entry_id": "4ea979fc-3d0a-3683-9f80-e64ed9eb550a",
                                        "glosses": [
                                            "One who is intolerant; a bigot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573c03fd-15b1-40a4-bd9f-18b23011a02f",
                                                "sense_id": "18019eb7-ebbd-3eae-bd20-c9e162b11d36",
                                                "text": "[…] a portion of the prejudice which darkened the spirits of these intolerants, might perhaps have cast its shadow over him."
                                            }
                                        ]
