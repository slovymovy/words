                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "challah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aed441ae-d198-37dd-83dc-c3c3ae67c98a",
                                        "entry_id": "649e5ef9-2e77-37e9-ab58-f5c86ced06d2",
                                        "glosses": [
                                            "A traditional bread eaten by Ashkenazi Jews, usually braided for the Sabbath and round for a yom tov."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30f8ae85-c86f-4570-a8e3-c901fc2f5457",
                                                "sense_id": "aed441ae-d198-37dd-83dc-c3c3ae67c98a",
                                                "text": "[…]it is a time-honored custom that when women bake challah-loaves for Sabbath and Yom Tov use, they specifically prepare a dough large enough to be obligated in challah, so they can fulfill the mitzvah of separating challah[…]."
                                            },
                                            {
                                                "example_id": "912c3594-c0b7-4a01-9da9-d8a11accf262",
                                                "sense_id": "aed441ae-d198-37dd-83dc-c3c3ae67c98a",
                                                "text": "Posting photos of his Shabbat candles and challah on Friday night, [Mark] Zuckerberg said that he would be giving the ceremonial cup to his eldest daughter, Maxima."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cafe0406-a360-3ce8-86a8-b844df874bcb",
                                        "entry_id": "649e5ef9-2e77-37e9-ab58-f5c86ced06d2",
                                        "glosses": [
                                            "The commandment to separate a portion of bread or bread dough for the cohanim (Numbers 15:17–21); in contemporary practice, the portion is burned until inedible."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3a7c7e5-5d1a-376f-bbaa-1f457cef98e9",
                                        "entry_id": "649e5ef9-2e77-37e9-ab58-f5c86ced06d2",
                                        "glosses": [
                                            "The portion separated in fulfillment of the above."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
