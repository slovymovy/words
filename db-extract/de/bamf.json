                "senses": [
                    {
                        "sense_id": "12494792-5f3c-3f04-92fa-69a257db1b90",
                        "entry_id": "6afb6557-2d29-3d01-a10e-dad908ce382e",
                        "glosses": [
                            "Bundesamt für Migration und Flüchtlinge"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "eb9e7a67-0ba1-4596-aecb-af7779d2ebec",
                                "sense_id": "12494792-5f3c-3f04-92fa-69a257db1b90",
                                "text": "Das BAMF hieß bis 2004 „Bundesamt für die Anerkennung ausländischer Flüchtlinge“."
                            },
                            {
                                "example_id": "f19b8edc-b99d-44cd-b14a-ab41d5dcc43a",
                                "sense_id": "12494792-5f3c-3f04-92fa-69a257db1b90",
                                "text": "Integration und Migration sind zwei Kompetenzfelder, die dem Bundesamt für Migration und Flüchtlinge durch das Zuwanderungsgesetz übertragen worden sind. In den letzten zehn Jahren hat das BAMF diese Felder ausgebaut und den gesellschaftlichen Entwicklungen angepasst."
                            },
                            {
                                "example_id": "934c271c-5de6-4434-8c49-f712876ccd4e",
                                "sense_id": "12494792-5f3c-3f04-92fa-69a257db1b90",
                                "text": "Nach wie vor müssen BAMF-Mitarbeiter jeden Bescheid für Flüchtlinge stempeln, versiegeln und mit der Post versenden."
                            },
                            {
                                "example_id": "ba6cf827-4e96-43b4-ac58-e43731528d24",
                                "sense_id": "12494792-5f3c-3f04-92fa-69a257db1b90",
                                "text": "Das BAMF brauche schnell mehr Mitarbeiter, neue Stellen zu genehmigen reiche nicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be211c18-d093-49cd-a3c7-178d1ce071f7",
                        "source_entry_id": "6afb6557-2d29-3d01-a10e-dad908ce382e",
                        "source_sense_id": "12494792-5f3c-3f04-92fa-69a257db1b90",
