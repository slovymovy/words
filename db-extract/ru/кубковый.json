                                "target_senses": [
                                    {
                                        "sense_id": "f9a1f631-29bf-348e-9bb6-55283a4f8b2d",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A concave vessel for drinking, usually made of opaque material (as opposed to a glass) and with a handle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d686a66-cf6e-4247-8718-5c49e3ffe430",
                                                "sense_id": "f9a1f631-29bf-348e-9bb6-55283a4f8b2d",
                                                "text": "Pour the tea into the cup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2959d9e-6f66-3d50-9050-49b0800a3805",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "The contents of said vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a58ef0-a1d6-4d3f-8cbe-dbac726f509c",
                                                "sense_id": "b2959d9e-6f66-3d50-9050-49b0800a3805",
                                                "text": "I drank two cups of water but still felt thirsty."
                                            },
                                            {
                                                "example_id": "9a192d0d-d6af-459f-b0c3-c8472e0393d3",
                                                "sense_id": "b2959d9e-6f66-3d50-9050-49b0800a3805",
                                                "text": "In Starbucks’s case, the firm has in effect turned the process of making an expensive cup of coffee into intellectual property."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceaaf3ba-d59c-3b66-9fc1-0edb77b14fc2",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A customary unit of measure",
                                            "A US unit of liquid measure equal to 8 fluid ounces (¹⁄₁₆ of a US gallon; 236.5882365 mL) or 240 mL."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e70ea18-5f9e-36a0-b146-db425a209ae0",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A customary unit of measure",
                                            "A Canadian unit of measure equal to 8 imperial ounces (¹⁄₂₀ imperial gallon; 227.3 mL) or 250 mL."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1bdab551-3792-3852-aca8-593ccd11478f",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A customary unit of measure",
                                            "A British unit of measure equal to ¹⁄₂ imperial pint (10 imperial ounces; 284 mL) or 300 mL."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd433a89-129b-31d8-8561-7595e99f82b3",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A customary unit of measure",
                                            "A metric unit of measure equal to 250 mL."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a07cdf83-a47c-381a-8535-12bf67896820",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A trophy in the shape of an oversized cup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bf336a4-56a9-4a59-9b03-bf7a8b253834",
                                                "sense_id": "a07cdf83-a47c-381a-8535-12bf67896820",
                                                "text": "The World Cup is awarded to the winner of a quadrennial football tournament."
                                            },
                                            {
                                                "example_id": "6ba044ad-ec5f-4e6c-88d4-7bb6cec12c2e",
                                                "sense_id": "a07cdf83-a47c-381a-8535-12bf67896820",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf793de9-25c1-3a4a-a524-215e9b1c56bc",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A contest for which a cup is awarded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10252940-8ea0-4993-bfa5-3b1cd41fabb1",
                                                "sense_id": "bf793de9-25c1-3a4a-a524-215e9b1c56bc",
                                                "text": "The World Cup is the world's most widely watched sporting event."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "The main knockout tournament in a country, organised alongside the league."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c011e01-d12b-40d8-8bcc-aa566725449b",
                                                "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                                "text": "Until it was disbanded in 1999, the European Cup-Winners Cup was contested annually by the winners of Europe's national cups."
                                            },
                                            {
                                                "example_id": "991e1b11-01f9-4c6e-b449-28e0a6f6a48e",
                                                "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                                "text": "Wallace had the unique distinction of being the only player ever to play in the English, Welsh and Scottish Cups in the same season."
                                            },
                                            {
                                                "example_id": "697c5901-c66a-4f73-91bb-f8cbc835523b",
                                                "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                                "text": "One week earlier, they had lost 5-2 to Borussia Dortmund in the DFB-Pokal [the German cup] final in Berlin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aaea091-79be-31bd-bf91-aff2bcc96318",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A cup-shaped object placed in the target hole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde526c8-1eba-4dd4-88e0-f42bac8418fc",
                                                "sense_id": "6aaea091-79be-31bd-bf91-aff2bcc96318",
                                                "text": "The ball just misses the cup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d806bf2-d608-3616-bf01-6604cc44eac2",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A container in which dice are held and shaken before being thrown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f00d9810-2624-3611-bece-5201b3de38cf",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "Any of various sweetened alcoholic drinks."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa93279-51b7-4419-866d-f207cfc2dd1e",
                                                "sense_id": "f00d9810-2624-3611-bece-5201b3de38cf",
                                                "text": "cider cup"
                                            },
                                            {
                                                "example_id": "18c55de6-8f4e-4324-b69a-244d0194f562",
                                                "sense_id": "f00d9810-2624-3611-bece-5201b3de38cf",
                                                "text": "gin cup"
                                            },
                                            {
                                                "example_id": "a30f5129-f7be-47c3-9d97-da479d833916",
                                                "sense_id": "f00d9810-2624-3611-bece-5201b3de38cf",
                                                "text": "claret cup"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2460832a-d64b-3108-bca2-90a3a32a385a",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A rigid concave protective covering for the male genitalia."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf353209-58f6-4164-b361-d26661baac56",
                                                "sense_id": "2460832a-d64b-3108-bca2-90a3a32a385a",
                                                "text": "Players of contact sports are advised to wear a cup."
                                            },
                                            {
                                                "example_id": "cc47ba51-d075-48c0-b10d-fc0999eeac3b",
                                                "sense_id": "2460832a-d64b-3108-bca2-90a3a32a385a",
                                                "text": "Boys, I thought I told you to let the store tell you what cup size you needed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c6941a-5be0-3d20-bb37-2c8cb61eaea5",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "One of the two parts of a brassiere which each cover a breast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6f7501-7dfe-4080-8c01-c95e3672134b",
                                                "sense_id": "29c6941a-5be0-3d20-bb37-2c8cb61eaea5",
                                                "text": "The cups are made of a particularly uncomfortable material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df759dd-8022-377f-a2d2-5dbbd5476687",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "One of the two parts of a brassiere which each cover a breast.",
                                            "Prefixed with a letter, used as a measurement of bra or breast size."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ea0054-6d92-4c06-ac3f-de1546e04f25",
                                                "sense_id": "9df759dd-8022-377f-a2d2-5dbbd5476687",
                                                "text": "\"For cleavage to show up in these photos, a girl has to have C-cup breasts — at least that's what they told me once.\""
                                            }
