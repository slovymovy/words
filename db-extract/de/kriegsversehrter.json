                ],
                "senses": [
                    {
                        "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                        "entry_id": "7d71ae80-dc20-3a03-9075-d6bf3420515b",
                        "glosses": [
                            "(männliche) Person, die infolge eines Krieges bleibende körperliche Schäden erlitten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b9bb03-0278-4adf-b4ed-63cb78d13d0a",
                                "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                                "text": "„Die Zahl der Kriegsversehrten beläuft sich auf mehrere Hunderttausend.“"
                            },
                            {
                                "example_id": "bbb73676-a710-4a5f-b364-57236d1b7677",
                                "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                                "text": "„Nach Hause zurückgekehrt absolvierte der Kriegsversehrte, der nun keine Landwirtschaft mehr führen konnte, eine kaufmännische Lehre.“"
                            },
                            {
                                "example_id": "0c0e68c2-91c1-4dfa-bd5c-049d8e88aca9",
                                "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                                "text": "„17 Millionen Männer dienten in der Wehrmacht, fünf Millionen fielen oder wurden vermisst, drei Millionen kamen als Kriegsversehrte zurück.“"
                            },
                            {
                                "example_id": "48942205-6d99-47fd-9998-a7aa3b429e3c",
                                "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                                "text": "„Amerikanischer Soldat ist er, ein Kriegsversehrter.“"
                            },
                            {
                                "example_id": "4dab4c00-d4c9-4376-b6d0-dbffb351e361",
                                "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                                "text": "„Zwei Cracks wurden vom Sportlehrer, einem einbeinigen Kriegsversehrten, zu Mannschaftskapitänen ernannt und haben sich abwechselnd ihre Mitspieler gewählt.“"
                            },
                            {
                                "example_id": "41108a25-ad03-4430-856a-222332b13b43",
                                "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                                "text": "„Faszinierend und erschreckend tritt der psychisch derangierte Kriegsversehrte Max in ihr Leben, liebebedürftig, doch gefährlich verrückt.“"
                            },
                            {
                                "example_id": "995564fb-7e03-424d-bc2f-78f2fe5b3487",
                                "sense_id": "242289d7-0b2b-3977-a2b3-efa9492eb389",
                                "text": "„Er ist kein Kriegsversehrter, sondern ein Opfer der Scharia, des islamischen Rechtes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
