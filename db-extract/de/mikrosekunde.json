                        "glosses": [
                            "eine Millionstel Sekunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589fb5a2-1d8e-4a57-b027-e511dadb54b5",
                                "sense_id": "3ea3e95f-dac5-3b47-a1d2-2eead6342098",
                                "text": "Das Licht legt in einer Mikrosekunde etwa 300 Meter zurück."
                            }
