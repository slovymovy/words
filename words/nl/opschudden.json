{
    "word_family": [
        "schudden",
        "opschudding",
        "afschudden",
        "uitschudden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2987fa67-c57e-3b93-be92-aa6a18b2d3e3",
                    "sense_definition": "Door schudden weer luchtig, netjes of in orde maken (met name van een kussen of dekbed)",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_schudden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>schudde</w> het dekbed <w>op</w> voordat ze ging slapen.",
                            "target_lang_translations": {
                                "en": "She <w>shook up</w> the duvet before she went to sleep."
                            }
                        },
                        {
                            "text": "Kun je alsjeblieft mijn kussen <w>opschudden</w>?",
                            "target_lang_translations": {
                                "en": "Could you please <w>plump up</w> my pillow?"
                            }
                        }
                    ],
                    "synonyms": [
                        "opschudden"
                    ],
                    "common_phrases": [
                        "een kussen opschudden",
                        "het bed opschudden"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something (especially a pillow or duvet) fluffy, neat, or tidy again by shaking it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shake up",
                                "target_lang_sense_clarification": "of a pillow or duvet"
                            },
                            {
                                "target_lang_word": "plump up",
                                "target_lang_sense_clarification": "of pillows or cushions"
                            },
                            {
                                "target_lang_word": "fluff up",
                                "target_lang_sense_clarification": "of pillows or bedding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20122d66-2a3b-3ad9-919f-a3430e7ccf5f",
                    "sense_definition": "Uit de gewone, passieve toestand halen om te activeren, wakker te schudden of te veranderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_schudden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gehele Midden-Oosten werd <w>opgeschud</w> door de plotselinge gebeurtenissen in Tunesië.",
                            "target_lang_translations": {
                                "en": "The entire Middle East was <w>shaken up</w> by the sudden events in Tunisia."
                            }
                        },
                        {
                            "text": "De nieuwe directeur wilde de ingeslapen organisatie flink <w>opschudden</w>.",
                            "target_lang_translations": {
                                "en": "The new director wanted to thoroughly <w>shake up</w> the dormant organization."
                            }
                        }
                    ],
                    "synonyms": [
                        "wakker schudden",
                        "opschrikken"
                    ],
                    "common_phrases": [
                        "de boel opschudden",
                        "de markt opschudden"
                    ],
                    "target_lang_definitions": {
                        "en": "To shake up, activate, or change an organization or situation from a passive state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shake up",
                                "target_lang_sense_clarification": "to reorganize or revitalize"
                            },
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "to activate or provoke change"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d49dc7db-4247-384e-a837-1bb6fcab8438",
                    "sense_definition": "Onrust, opschudding of opschudding veroorzaken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk_schudden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn gewaagde uitspraken <w>schudden</w> de politieke wereld flink <w>op</w>.",
                            "target_lang_translations": {
                                "en": "His daring statements really <w>shook up</w> the political world."
                            }
                        },
                        {
                            "text": "Het schandaal zal de hele gemeenschap <w>opschudden</w>.",
                            "target_lang_translations": {
                                "en": "The scandal will <w>shake up</w> the entire community."
                            }
                        }
                    ],
                    "synonyms": [
                        "opschudding verwekken",
                        "onrust zaaien"
                    ],
                    "common_phrases": [
                        "de gemoederen opschudden"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause unrest, commotion, or a major disturbance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shake up",
                                "target_lang_sense_clarification": "to cause a major disturbance or shock"
                            },
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "to cause unrest or commotion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}