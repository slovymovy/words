                                "target_lang_sense_clarification": "eine Auswahl treffen"
                            },
                            {
                                "target_lang_word": "auswählen",
                                "target_lang_sense_clarification": "gezielt eine Option nehmen"
                            },
                            {
                                "target_lang_word": "aussuchen",
                                "target_lang_sense_clarification": "informell eine Wahl treffen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edbadfe6-b0a1-32c6-93fc-5ed6867e1ab7",
                    "sense_definition": "een bepaalde handelwijze of mogelijkheid prefereren boven alle andere",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "selectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd bewust <w>gekozen</w> voor een vrij voorzichtige aanpak.",
                            "target_lang_translations": {
