                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dab9454-268e-3149-bf2b-1086acbdb84e",
                        "entry_id": "134ef4d5-90bf-3d82-9372-16f72eb2a887",
                        "glosses": [
                            "A female given name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9402a464-599b-45f8-8966-ad9306b597f5",
                                "sense_id": "1dab9454-268e-3149-bf2b-1086acbdb84e",
                                "text": "\"Do excuse me, and forgive my inquisitiveness. I was struck with the name Lulu.\" \"You think it a baby name,\" she said, laughing. \"O, no; it is wonderfully sweet to me! and may I sometimes call you so?\""
                            },
                            {
                                "example_id": "88fab2e9-a07c-4475-86a8-c9da1ee1756b",
                                "sense_id": "1dab9454-268e-3149-bf2b-1086acbdb84e",
                                "text": "There emerged from the fringe of things, where she perpetually hovered, Mrs. Deacon's older sister, Lulu Bett, who was \"making her home with us.\" And that was precisely the case. They were not making her a home, goodness knows. Lulu was the family beast of burden."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb17f2cd-dd7c-3e4e-86c7-427ecb9b54c8",
                        "entry_id": "134ef4d5-90bf-3d82-9372-16f72eb2a887",
                        "glosses": [
                            "A female given name.",
                            "A diminutive of the female given names Louisa, Louise, Lucy, or Lucille."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
