                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c31e8c8-c1b2-43c3-b850-a5acdf202a06",
                        "entry_id": "c309e6ca-4986-3471-991b-1057c26734d1",
