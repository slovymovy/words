                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71546b0-6e2d-42f4-a755-09330f9d87f4",
                                "sense_id": "dae6d061-b1b4-3ca4-ab3d-092588053d75",
                                "text": "Een vierdegraads brandwond, ook wel verkoling genoemd, is een brandwond die zo diep is, dat niet alleen de huid maar ook bot en spierweefsel vernietigd zijn."
                            },
                            {
                                "example_id": "2197ea87-174f-4edb-8e6c-67780b65669b",
                                "sense_id": "dae6d061-b1b4-3ca4-ab3d-092588053d75",
                                "text": "Bij een derdegraads verbranding wordt de hele huid vernietigd. Er is slechts een graad hoger: vierdegraads. Dat noemt men ook wel verkoling."
                            }
                        ]
                    }
