        "fr-extract.jsonl": [
            {
                "entry_id": "81b721e1-d06a-3306-84cd-1f954787c200",
                "word": "notoirement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5c006d2-ff4a-3105-8073-983a732c6c66",
                        "entry_id": "81b721e1-d06a-3306-84cd-1f954787c200",
                        "glosses": [
                            "D’une manière notoire, manifestement, au vu et au su de tous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfda1bf8-80d1-4dcc-93b3-f9451830b980",
                                "sense_id": "e5c006d2-ff4a-3105-8073-983a732c6c66",
                                "text": "Les avoués ne pourront enchérir pour les personnes notoirement insolvables."
                            },
                            {
                                "example_id": "81d6647b-0e7a-4773-9a9a-553c49406b39",
                                "sense_id": "e5c006d2-ff4a-3105-8073-983a732c6c66",
                                "text": "Du moment, n’est-ce pas, ajouta-t-il, que la recherche de la paternité est autorisée dans ce cas-là, attendu que ta fille notoirement a vécu avec lui comme concubine."
                            },
                            {
                                "example_id": "5757d13c-72ae-401c-a333-4dd02393bd20",
                                "sense_id": "e5c006d2-ff4a-3105-8073-983a732c6c66",
                                "text": "Margaret Thatcher et Ronald Reagan accédèrent au pouvoir en se fondant sur cette notion, et tous deux assouplirent notoirement les réglementations, sacrifièrent et privatisèrent les services publics, réduisirent les impôts des corporations et bradèrent la souveraineté économique au nom du \"libre-échange\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57276517-5226-4508-8524-1f3887e73f6e",
                        "source_entry_id": "81b721e1-d06a-3306-84cd-1f954787c200",
                        "source_sense_id": "e5c006d2-ff4a-3105-8073-983a732c6c66",
                        "target_lang_word": "manifestly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6a161a-20c0-3cbc-87c4-9a28f41abb65",
                                        "entry_id": "fab1b0c3-43a7-34e1-9fa5-2ce867c5431b",
                                        "glosses": [
                                            "In a manifest manner; obviously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b716feb4-84a9-4029-a47a-9af6282e5535",
                                                "sense_id": "ad6a161a-20c0-3cbc-87c4-9a28f41abb65",
                                                "text": "Folk lore, legends, myths and fairy tales have followed childhood through the ages, for every healthy youngster has a wholesome and instinctive love for stories fantastic, marvelous and manifestly unreal."
                                            },
                                            {
                                                "example_id": "b463f314-1c85-4ab4-9989-ca97b490df32",
                                                "sense_id": "ad6a161a-20c0-3cbc-87c4-9a28f41abb65",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record. With this biological framework in place, Corning endeavors to show that the capitalist system as currently practiced in the United States and elsewhere is manifestly unfair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4747bda-614d-4fcc-8e2f-37eeea29acdb",
                        "source_entry_id": "81b721e1-d06a-3306-84cd-1f954787c200",
                        "source_sense_id": "e5c006d2-ff4a-3105-8073-983a732c6c66",
                        "target_lang_word": "notoriously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notoriously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0208b9da-976e-329e-a0b9-771f521691b8",
                                        "entry_id": "dd44d96e-ef28-3cf8-b125-37c66f43a2dd",
                                        "glosses": [
                                            "In a notorious or notable manner; as is commonly known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68402e49-dde9-4028-a6d9-33bdc0c68268",
                                                "sense_id": "0208b9da-976e-329e-a0b9-771f521691b8",
                                                "text": "The Hempshocks' sheep were notoriously the finest for miles around: shaggy-coated and intelligent (for sheep), with curling horns and sharp hooves."
                                            },
                                            {
                                                "example_id": "dd23afb2-07be-42e3-9d21-af581481ad9f",
                                                "sense_id": "0208b9da-976e-329e-a0b9-771f521691b8",
                                                "text": "Orton himself notoriously defaced library books before starting to write books himself."
                                            },
                                            {
                                                "example_id": "151c85b5-8a7f-4ef0-8770-973bf78d8953",
                                                "sense_id": "0208b9da-976e-329e-a0b9-771f521691b8",
                                                "text": "Johnson's contract expires in November, and four weeks as memorable for scandals off the pitch as any achievements on it will do little to appease the notoriously twitchy committee-men at the Rugby Football Union."
                                            },
                                            {
                                                "example_id": "9447a2fb-d2e8-4068-ac37-aa691b570d4c",
                                                "sense_id": "0208b9da-976e-329e-a0b9-771f521691b8",
                                                "text": "Jointed track will be replaced, with standard ballast instead of shingle beneath, to stabilise the rails and improve the notoriously dreadful ride quality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bfaa17e-b08f-49e6-a515-e182d6b47938",
                        "source_entry_id": "81b721e1-d06a-3306-84cd-1f954787c200",
