                        "examples": [
                            {
                                "example_id": "56531962-b549-4dc0-927f-481221fb7fd2",
                                "sense_id": "40ab497b-3916-3892-9475-0c6d44564510",
                                "text": "„Er war Soldat und gehörte zum 23. Infanterieregiment im Dienst des Königs von Großbritannien.“"
                            },
                            {
                                "example_id": "6d365df9-1f0e-499c-a679-796416bf98b1",
                                "sense_id": "40ab497b-3916-3892-9475-0c6d44564510",
                                "text": "„Am 11. Oktober 1805 stand eins der soeben im Raume von Braunau angelangten Infanterieregimenter eine halbe Meile von der Stadt entfernt und erwartete den Oberkommandierenden, der es besichtigen wollte.“"
                            }
                        ],
