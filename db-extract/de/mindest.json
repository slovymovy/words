                "senses": [
                    {
                        "sense_id": "a5b503a8-f3d5-37db-860c-ed19bfe08b50",
                        "entry_id": "60cb9a06-752b-3520-bec8-139642895b45",
                        "glosses": [
                            "superlative degree of minder"
                        ],
                        "tags": [
                            "archaic",
