                        ]
                    },
                    {
                        "sense_id": "4eebcc3d-3a61-37b3-a8b8-96dd78567c6d",
                        "entry_id": "f97b837f-1621-3db6-a539-5c8ef6b97a86",
                        "glosses": [
                            "Qualifie l’assemblée littéraire constituée par Charlemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46ac27d-a52e-4706-8a29-916aac79fa36",
                                "sense_id": "4eebcc3d-3a61-37b3-a8b8-96dd78567c6d",
                                "text": "École palatine."
                            },
                            {
                                "example_id": "da49620b-da9c-4f6e-897f-e0f30e2e623d",
                                "sense_id": "4eebcc3d-3a61-37b3-a8b8-96dd78567c6d",
                                "text": "Académie palatine."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8d1560a-1ca3-31bd-b243-5aa8825f73bb",
                        "entry_id": "f97b837f-1621-3db6-a539-5c8ef6b97a86",
                        "glosses": [
                            "Qualifiait un seigneur revêtu d’un office, d’une charge dans le palais d’un prince."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "821781ea-bf09-4e2e-93c3-2c8213b449fb",
                                "sense_id": "c8d1560a-1ca3-31bd-b243-5aa8825f73bb",
                                "text": "Il y a eu quatre comtes palatins en Angleterre."
                            }
                        ]
                    },
                    {
                        "sense_id": "62739c48-dbfb-3d30-beac-58ea9323b008",
                        "entry_id": "f97b837f-1621-3db6-a539-5c8ef6b97a86",
                        "glosses": [
                            "Relatif au Palatinat, à la Rhénanie-Palatinat en Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c70932a3-cd71-42d9-8443-a4cb26835716",
                                "sense_id": "62739c48-dbfb-3d30-beac-58ea9323b008",
                                "text": "L’électeur palatin s’appelait aussi comte palatin du Rhin."
                            },
                            {
                                "example_id": "0177d42c-232d-48ae-9de7-1d47d0bca6a8",
                                "sense_id": "62739c48-dbfb-3d30-beac-58ea9323b008",
                                "text": "C’est ce que demande de vous Très haute et très puissante princesse Anne de Gonzague de Clèves, princesse de Mantoue et de Montferrat, et comtesse Palatine du Rhin."
                            },
                            {
                                "example_id": "84a256ea-3cc0-4979-b294-35df95b7bec5",
                                "sense_id": "62739c48-dbfb-3d30-beac-58ea9323b008",
                                "text": "De grands candélabres d’or brillaient entre les miroirs sur le mur, et Le Brun avait prodigué toute la richesse de sa palette sur le plafond, où Louis lui-même, dans le rôle de Jupiter, lançait ses foudres sur un amoncellement convulsé de Titans hollandais et palatins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad43d23e-e7cc-4cc8-8b3e-b695d014390a",
                        "source_entry_id": "f97b837f-1621-3db6-a539-5c8ef6b97a86",
                        "source_sense_description": "relatif au Palatinat",
                        "target_lang_word": "pfälzisch",
