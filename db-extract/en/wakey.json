                        "sense_id": "25113dd1-1eab-3fc5-b286-1dcd6c8cd209",
                        "entry_id": "8d08d3e7-d744-3b42-83e1-05a6f7868bea",
                        "glosses": [
                            "The day on which one wakes up and travels home."
                        ],
                        "tags": [
                            "no-plural",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "89780762-cd03-4510-8cda-1239837bf7cf",
                                "sense_id": "25113dd1-1eab-3fc5-b286-1dcd6c8cd209",
                                "text": "'You beauty, only 364 and a wakey to go,' the countdown had begun and would continue, as few days passed without someone calling the time. I spared a thought for our temporary enemy whose tour would endure to the end of the war[…]"
                            },
                            {
                                "example_id": "0c62d174-4488-455d-8bb9-194fd0fe72ac",
                                "sense_id": "25113dd1-1eab-3fc5-b286-1dcd6c8cd209",
                                "text": "Morale was also usually high, helped by the men's recognition that their service in Vietnam had strict limits – one year, or, to use a soldiers' expression of the time, 364 days and a 'wakey' (the day the men woke to prepare to fly out)."
                            },
                            {
                                "example_id": "85224695-cc62-458b-bf60-a086c8ba16c0",
                                "sense_id": "25113dd1-1eab-3fc5-b286-1dcd6c8cd209",
                                "text": "When you became a 'short timer' (20 days and a wakey) you delighted in sticking it up to the new arrivals."
                            }
                        ]
                    }
