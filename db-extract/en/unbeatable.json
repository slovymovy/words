    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8fdac6f8-cec2-3634-a3d1-35c8e01412df",
                "word": "unbeatable",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                        "entry_id": "8fdac6f8-cec2-3634-a3d1-35c8e01412df",
                        "glosses": [
                            "That cannot be beaten, defeated or overcome"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "168edcf8-afc0-4171-9620-528154aa1f85",
                                "sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                                "text": "Deep-set and steady, with eyelashes that many a woman had envied, they showed the man for what he was—a sportsman and a gentleman. And the combination of the two is an unbeatable production."
                            },
                            {
                                "example_id": "6bc6bb75-5ad6-4861-8728-8d9853e2b123",
                                "sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                                "text": "Lauren James was exceptional out wide, Millie Bright unbeatable in defence and Lucy Bronze tireless in dealing with Spain forward Salma Paralluelo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c6be3aa-5326-47a5-8ec0-2c0a49d7a99b",
                        "source_entry_id": "8fdac6f8-cec2-3634-a3d1-35c8e01412df",
                        "source_sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                        "source_sense_description": "that cannot be beaten, defeated or overcome",
                        "target_lang_word": "imbattable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbattable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92203f55-951a-3d83-99b0-e1a60cf43204",
                                        "entry_id": "b6c03acb-5627-374c-bd9a-6bb1a93a1eea",
                                        "glosses": [
                                            "Que l'on ne peut pas battre, toujours victorieux, invincible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "449a172e-7135-4352-9c94-43d51a58d751",
                                                "sense_id": "92203f55-951a-3d83-99b0-e1a60cf43204",
                                                "text": "Elle est imbattable à la crapette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b70f41f3-0e73-40be-9b5c-8d273a932305",
                        "source_entry_id": "8fdac6f8-cec2-3634-a3d1-35c8e01412df",
                        "source_sense_id": "6c3d546b-f8a1-3984-84f7-63487757f312",
                        "source_sense_description": "that cannot be beaten, defeated or overcome",
                        "target_lang_word": "invincible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invincible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27f7344f-ec04-3704-ade7-1ef85daba1d4",
                                        "entry_id": "85f6a024-77c0-347f-945d-c068090ca6f2",
                                        "glosses": [
                                            "Que l’on ne peut vaincre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d018a160-b0c1-409b-8387-b997fc910dea",
                                                "sense_id": "27f7344f-ec04-3704-ade7-1ef85daba1d4",
                                                "text": "Une armée invincible."
                                            },
                                            {
                                                "example_id": "05ad8c3d-c585-4d64-a54c-c108d89e9271",
                                                "sense_id": "27f7344f-ec04-3704-ade7-1ef85daba1d4",
                                                "text": "— Croiriez-vous, dit-il, que je me trouve arrêté net par cette petite peste de Marthe ? Rien ne la touche. Le père, la mère sont décidés au mariage ; elle seule me fait une résistance invincible.\n— Invincible, une femme !\n— Non, une jeune fille, ce qui n’est pas du tout la même chose."
                                            },
                                            {
                                                "example_id": "b7aabcc6-114e-49c7-af89-aff405fb8718",
                                                "sense_id": "27f7344f-ec04-3704-ade7-1ef85daba1d4",
                                                "text": "Un courage invincible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76691817-339d-33de-8b7d-8c6205e87489",
                                        "entry_id": "85f6a024-77c0-347f-945d-c068090ca6f2",
                                        "glosses": [
                                            "Auquel il n’y a pas de bonne réplique ; imparable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15bd19c6-02b9-4770-9f1a-3f4d7f65117d",
                                                "sense_id": "76691817-339d-33de-8b7d-8c6205e87489",
                                                "text": "Argument invincible, raison invincible, raisonnement invincible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608c4f68-2def-325f-a5f4-73ac2c9cf459",
                                        "entry_id": "85f6a024-77c0-347f-945d-c068090ca6f2",
                                        "glosses": [
                                            "Qui est insurmontable, qui est irrésistible, plus fort que la volonté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a886d9f-d22a-4183-8a04-95d8a1becf7f",
                                                "sense_id": "608c4f68-2def-325f-a5f4-73ac2c9cf459",
                                                "text": "Malgré ces belles résolutions, dès qu'il l'aperçut à vingt pas de lui, il fut saisi d'une invincible timidité."
                                            },
                                            {
                                                "example_id": "8a12294f-f1e2-4626-a8f0-d806da68d614",
                                                "sense_id": "608c4f68-2def-325f-a5f4-73ac2c9cf459",
                                                "text": "[…]; puis il céda à l'aphasie, s'accota au placard, les bras collés aux cuisses, image vivante de l'animal assailli par un invincible ahurissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca69552c-a67e-4147-a648-1779e139f7ab",
                        "source_entry_id": "8fdac6f8-cec2-3634-a3d1-35c8e01412df",
