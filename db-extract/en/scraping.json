                "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                "word": "scraping",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "30f692b2-a3b0-42f9-bfe9-a7a3071d10c0",
                        "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
