                "senses": [
                    {
                        "sense_id": "00adf4c0-ef01-3dd5-b62c-27906c6d3965",
                        "entry_id": "56e4462d-cd10-3e34-b436-2c8d5ec1ab88",
                        "glosses": [
                            "Tentative d’accommodement, de réconciliation ; volonté d’amadouer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "325d3356-cc73-4ea1-a9d5-449e37ab4cae",
                                "sense_id": "00adf4c0-ef01-3dd5-b62c-27906c6d3965",
                                "text": "Dick, bien qu’également irrité, vint au rambin :\n- C’est pas ce que tu crois."
                            },
                            {
                                "example_id": "4bdf510b-4588-4c47-abab-69b987b00725",
                                "sense_id": "00adf4c0-ef01-3dd5-b62c-27906c6d3965",
                                "text": "Mettant mes mains en avant en signe de conciliation, je vais au rambin : « Ça va comme ça. C’est idiot de s’engueuler. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "06fd834f-c945-3e09-a0f4-8b98293247d4",
                        "entry_id": "56e4462d-cd10-3e34-b436-2c8d5ec1ab88",
                        "glosses": [
                            "Réconfort."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "81571c28-bdbe-4a51-8624-3b5db370cb9e",
                                "sense_id": "06fd834f-c945-3e09-a0f4-8b98293247d4",
                                "text": "Ma frime devait pas être brillante. Tout de suite, le Gros, qu’avait le génie du rambin, m’a invité :\n— T’arrives juste pour la deuxième séance, tu veux en croquer ? Après on mange un morceau."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2b6c848-b19c-3855-88ad-0ed92e560b97",
                        "entry_id": "56e4462d-cd10-3e34-b436-2c8d5ec1ab88",
                        "glosses": [
                            "Baratin, drague."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d74fc3ec-9443-41ff-847c-38e7e824d730",
                                "sense_id": "b2b6c848-b19c-3855-88ad-0ed92e560b97",
                                "text": "Elle est placée, tu perds ton temps à lui faire du rambin."
                            }
                        ]
                    }
