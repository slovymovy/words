                    ],
                    "common_phrases": [
                        "high CTR",
                        "improve CTR"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношение числа кликов по ссылке к общему числу показов страницы, письма или рекламного объявления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "CTR",
                                "target_lang_sense_clarification": "общепринятый маркетинговый термин (кликабельность)"
                            },
                            {
                                "target_lang_word": "кликабельность",
                                "target_lang_sense_clarification": "русский эквивалент показателя эффективности рекламы"
                            }
                        ]
