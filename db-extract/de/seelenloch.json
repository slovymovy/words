                "senses": [
                    {
                        "sense_id": "f36911e4-9d6d-3640-9063-ccff5990ddb7",
                        "entry_id": "ddf94ad0-99aa-332c-aa3c-fdd4ac83069f",
                        "glosses": [
                            "Brauchtum: Öffnung, durch die die Seele eines Verstorbenen entweichen kann (kleines Fenster in einem Haus, Loch in einer Urne)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924153cd-e39b-415f-994d-d6ebfb310742",
                                "sense_id": "f36911e4-9d6d-3640-9063-ccff5990ddb7",
                                "text": "„Und er erzählte mir, dass es im Dorf nebenan bis heute noch Häuser mit einem »Seelenloch« gebe - winzigen Fenstern, die beim Eintritt eines Todesfalles geöffnet wurden, damit die Seele des Verstorbenen mühelos entweichen könne.“"
                            },
                            {
                                "example_id": "1ead9bce-ba6b-4541-b09f-4f3f596e4009",
                                "sense_id": "f36911e4-9d6d-3640-9063-ccff5990ddb7",
                                "text": "„Wo ich aufgewachsen bin, zeigt man ein Steinkammergrab, der Clou ist das Seelenloch am Kopfende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
