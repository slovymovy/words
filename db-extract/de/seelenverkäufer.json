                "senses": [
                    {
                        "sense_id": "d984f2b9-fbf2-3abf-9eda-8a58c8181c7d",
                        "entry_id": "52e0b28d-4c3f-3d88-8359-08ea903bb373",
                        "glosses": [
                            "nicht mehr voll seetüchtiges Wasserfahrzeug"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "917c9324-e690-4b56-8cd9-45d27bc120e4",
                                "sense_id": "d984f2b9-fbf2-3abf-9eda-8a58c8181c7d",
                                "text": "Das alte rostige Schiff, das sie für die Überfahrt gebucht hatten, war ein Seelenverkäufer."
                            },
                            {
                                "example_id": "71fe795c-e74b-4b58-acac-a119707f9e97",
                                "sense_id": "d984f2b9-fbf2-3abf-9eda-8a58c8181c7d",
                                "text": "„Die elenden Seelenverkäufer, die gegen die Konkurrenz der Dampfschiffe nicht ankamen, segelten mit Bauholz und Fisch nach Lübeck, Rostock, Danzig, Sankt Petersburg und wie die verschiedenen Häfen der Ostsee alle hießen.“"
                            },
                            {
                                "example_id": "138a2221-b454-4790-b85c-d0fcdb3300b6",
                                "sense_id": "d984f2b9-fbf2-3abf-9eda-8a58c8181c7d",
                                "text": "„Du liebe Zeit, Passagiere und Waren werden da unter Geschrei, Lamento und Handgemenge auf einen wahrhaftigen Seelenverkäufer bugsiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
