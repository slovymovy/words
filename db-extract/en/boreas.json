                                            {
                                                "example_id": "59a66c96-1ebe-4690-aa7f-ca80fdebdfc6",
                                                "sense_id": "9fd906fb-f72a-3b29-a291-1862bd14b998",
                                                "text": "D’un souffle l’aquilon écarte les nuages.\nEt chasse au loin la foudre et les orages."
                                            },
                                            {
                                                "example_id": "764fa3d9-cbe9-418c-a30d-22df4b45e815",
                                                "sense_id": "9fd906fb-f72a-3b29-a291-1862bd14b998",
                                                "text": "[Il] eut grand soin de l’entourer d’un papier transparent pour prévenir les malices des aquilons."
                                            }
