{
    "word_family": [
        "symptomatisch",
        "symptomatologie",
        "symptoombestrijding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e50fe7a-bc3d-380a-897b-20ce83dd1f7a",
                    "sense_definition": "Een lichamelijk of geestelijk verschijnsel dat wijst op een bepaalde ziekte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eerste <w>symptomen</w> komen bij sommige ziekten pas jaren na de besmetting.",
                            "target_lang_translations": {
                                "en": "The first <w>symptoms</w> of some diseases only appear years after infection."
                            }
                        },
                        {
                            "text": "Koorts is een veelvoorkomend <w>symptoom</w> van een infectie in het lichaam.",
                            "target_lang_translations": {
                                "en": "Fever is a common <w>symptom</w> of an infection in the body."
                            }
                        }
                    ],
                    "synonyms": [
                        "ziekteteken"
                    ],
                    "common_phrases": [
                        "medisch symptoom",
                        "vroege symptomen",
                        "symptomen vertonen"
                    ],
                    "target_lang_definitions": {
                        "en": "A physical or mental phenomenon that indicates a particular disease."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "symptom",
                                "target_lang_sense_clarification": "medical sign of a disease"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e54331a-b0e6-316b-94cd-568a0c6d0a66",
                    "sense_definition": "Een verschijnsel dat als aanwijzing dient voor iets anders dat gaande is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stijgende werkloosheid is een <w>symptoom</w> van de economische crisis.",
                            "target_lang_translations": {
                                "en": "Rising unemployment is a <w>symptom</w> of the economic crisis."
                            }
                        },
                        {
                            "text": "Dit gedrag is een duidelijk <w>symptoom</w> van een dieper liggend probleem.",
                            "target_lang_translations": {
                                "en": "This behavior is a clear <w>symptom</w> of an underlying problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanduiding",
                        "aanwijzing",
                        "signaal",
                        "verklikker"
                    ],
                    "common_phrases": [
                        "symptoom van crisis",
                        "duidelijk symptoom"
                    ],
                    "target_lang_definitions": {
                        "en": "A phenomenon that serves as an indication of something else that is going on."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "symptom",
                                "target_lang_sense_clarification": "figurative indication of a situation"
                            },
                            {
                                "target_lang_word": "sign",
                                "target_lang_sense_clarification": "general indication or signal"
                            },
                            {
                                "target_lang_word": "indication",
                                "target_lang_sense_clarification": "a sign or piece of information"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}