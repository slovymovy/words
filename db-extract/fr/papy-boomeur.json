                        "sense_id": "53ea0166-b4de-33fe-ad5e-46c4ec99340f",
                        "entry_id": "646882eb-0db2-38b3-80d2-812b168258b9",
                        "glosses": [
                            "Personne née pendant un baby-boom et qui va prendre, ou a déjà pris, sa retraite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208c7309-a075-473a-8549-ada43ea76255",
                                "sense_id": "53ea0166-b4de-33fe-ad5e-46c4ec99340f",
                                "text": "Autrefois baby-boomeurs, les papy-boomeurs vont peser autant dans les transformations du marché du travail qu’ils le firent sur le marché de l’emploi pendant leurs jeunes années."
                            },
                            {
                                "example_id": "ca568a98-0ab2-4bf4-9f9e-2e7c9cf21018",
                                "sense_id": "53ea0166-b4de-33fe-ad5e-46c4ec99340f",
                                "text": "Grands consommateurs, les papy-boomeurs constituent un formidable moteur pour de nombreux secteurs et un soutien essentiel pour les autres générations."
                            }
                        ]
                    }
