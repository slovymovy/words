                "senses": [
                    {
                        "sense_id": "47b7607a-abd2-3c21-a29b-e300f320b2c4",
                        "entry_id": "097a8e03-1217-3b84-843a-f7253df8cd08",
                        "glosses": [
                            "Variante orthographique de terraformer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29bc34b0-047b-4927-aa49-b6cd1b21419a",
                                "sense_id": "47b7607a-abd2-3c21-a29b-e300f320b2c4",
                                "text": "Ils doivent «terra-former» un paysage sur ce ruban qui flotte dans l’espace intersidéral."
                            },
                            {
                                "example_id": "ea502cf1-672c-40fd-b8f3-47f85e50eb85",
                                "sense_id": "47b7607a-abd2-3c21-a29b-e300f320b2c4",
                                "text": "Oui, mais il reste quand même que des conditions minimales sont nécessaires pour terra-former un monde et, malheureusement, ce qui reste de terraformable dans cette partie de la galaxie, est très limité, même avec vos technologies."
                            },
                            {
                                "example_id": "7df73b33-f654-4cc6-a35b-0b7048c92779",
                                "sense_id": "47b7607a-abd2-3c21-a29b-e300f320b2c4",
                                "text": "Pour cela, il faudra terra-former la planète, créer des populations et les faire muter pour les implanter sur ces terrains vierges très divers, nécessitant donc des combinaisons de mutations particulières, et qui produiront une partie des ressources nécessaires au joueur."
                            }
                        ]
                    }
