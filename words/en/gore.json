{
    "word_family": [
        "gory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51e9383d-cdd3-3703-ac0f-68cb7a5d0b06",
                    "sense_definition": "Carnage, bloodshed, murder, and violence, often depicted in media.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "violence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was criticized for its excessive use of <w>gore</w> and violence.",
                            "target_lang_translations": {
                                "ru": "Фильм критиковали за чрезмерное <w>кровопролитие</w> и насилие.",
                                "de": "Der Film wurde für seinen übermäßigen Einsatz von <w>Gore</w> und Gewalt kritisiert."
                            }
                        },
                        {
                            "text": "I usually avoid horror films that rely too heavily on <w>gore</w> to scare the audience.",
                            "target_lang_translations": {
                                "ru": "Я обычно избегаю фильмов ужасов, которые слишком полагаются на <w>кровавые сцены</w>, чтобы напугать зрителей.",
                                "de": "Normalerweise meide ich Horrorfilme, die zu sehr auf <w>Blutvergießen</w> setzen, um das Publikum zu erschrecken."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloodshed",
                        "carnage",
                        "violence",
                        "slaughter"
                    ],
                    "common_phrases": [
                        "blood and gore",
                        "movie gore",
                        "graphic gore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение насилия, кровопролития и жестокости, часто в фильмах или других медиа.",
                        "de": "Darstellung von Blutvergießen, Gemetzel und Gewalt, insbesondere in Filmen oder Medien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кровопролитие",
                                "target_lang_sense_clarification": "убийства и насилие"
                            },
                            {
                                "target_lang_word": "резня",
                                "target_lang_sense_clarification": "жестокое массовое убийство"
                            },
                            {
                                "target_lang_word": "кровавые сцены",
                                "target_lang_sense_clarification": "в кино или играх"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gore",
                                "target_lang_sense_clarification": "als Film- oder Medien-Genre"
                            },
                            {
                                "target_lang_word": "Blutvergießen",
                                "target_lang_sense_clarification": "Gewaltdarstellung oder Gemezel"
                            },
                            {
                                "target_lang_word": "Gemetzel",
                                "target_lang_sense_clarification": "brutale Gewaltszenen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "816ee63c-de43-38ac-bcca-0f52a6d68183",
                    "sense_definition": "Blood that has thickened or clotted, especially from a wound.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "violence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier's uniform was stained with mud and <w>gore</w> after the battle.",
                            "target_lang_translations": {
                                "ru": "После битвы форма солдата была испачкана грязью и <w>запёкшейся кровью</w>.",
                                "de": "Die Uniform des Soldaten war nach der Schlacht mit Schlamm und <w>geronnenem Blut</w> befleckt."
                            }
                        },
                        {
                            "text": "He wiped the <w>gore</w> from his face to see the extent of the injury.",
                            "target_lang_translations": {
                                "ru": "Он вытер <w>сгустки крови</w> с лица, чтобы увидеть степень повреждения.",
                                "de": "Er wischte das <w>Blut</w> von seinem Gesicht, um das Ausmaß der Verletzung zu sehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "blood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загустевшая или свернувшаяся кровь, особенно из раны.",
                        "de": "Dickes, geronnenes Blut, insbesondere aus einer Wunde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запёкшаяся кровь",
                                "target_lang_sense_clarification": "свернувшаяся"
                            },
                            {
                                "target_lang_word": "сгустки крови",
                                "target_lang_sense_clarification": "масса свернувшейся крови"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "geronnenes Blut",
                                "target_lang_sense_clarification": "dick gewordenes Blut"
                            },
                            {
                                "target_lang_word": "Blut",
                                "target_lang_sense_clarification": "Körperflüssigkeit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fb9a3b1-94e0-3d48-853b-77a2a896fb98",
                    "sense_definition": "A triangular or rhomboid piece of fabric used to add width or shape to a garment, such as a skirt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shape_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor inserted a <w>gore</w> into the skirt to give it a fuller shape.",
                            "target_lang_translations": {
                                "ru": "Портной вставил <w>клин</w> в юбку, чтобы придать ей более пышную форму.",
                                "de": "Der Schneider setzte einen <w>Zwickel</w> in den Rock ein, um ihm eine vollere Form zu geben."
                            }
                        },
                        {
                            "text": "She had to cut a <w>gore</w> from the extra silk to fix the dress.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось вырезать <w>клин</w> из лишнего шелка, чтобы поправить платье.",
                                "de": "Sie musste eine <w>Gehre</w> aus der zusätzlichen Seide zuschneiden, um das Kleid zu reparieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "gusset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Треугольный или ромбовидный кусок ткани, вшиваемый для расширения одежды.",
                        "de": "Ein dreieckiger oder keilförmiger Stoffeinsatz, um einem Kleidungsstück Weite oder Form zu geben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клин",
                                "target_lang_sense_clarification": "кусок ткани"
                            },
                            {
                                "target_lang_word": "ластовица",
                                "target_lang_sense_clarification": "вставка в одежде"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zwickel",
                                "target_lang_sense_clarification": "keilförmiger Stoffeinsatz"
                            },
                            {
                                "target_lang_word": "Gehre",
                                "target_lang_sense_clarification": "Stoffkeil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ca4e4b1-86cc-3558-8280-60ecedf2f181",
                    "sense_definition": "A triangular piece of land, often found where roads merge or diverge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car broke down in the <w>gore</w> between the highway exit and the main lane.",
                            "target_lang_translations": {
                                "ru": "Машина сломалась на <w>треугольном участке</w> между съездом с шоссе и основной полосой.",
                                "de": "Das Auto hatte auf der <w>Sperrfläche</w> zwischen der Autobahnausfahrt und der Hauptspur eine Panne."
                            }
                        },
                        {
                            "text": "City planners decided to plant flowers in the <w>gore</w> to improve the intersection's appearance.",
                            "target_lang_translations": {
                                "ru": "Городские планировщики решили высадить цветы на <w>разделительном островке</w>, чтобы улучшить вид перекрестка.",
                                "de": "Die Stadtplaner beschlossen, auf dem <w>Zwickel</w> Blumen zu pflanzen, um das Aussehen der Kreuzung zu verbessern."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Треугольный участок земли, часто образующийся при слиянии или разветвлении дорог.",
                        "de": "Ein dreieckiges Stück Land, wie etwa eine Verkehrsinsel an Straßenabzweigungen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клин",
                                "target_lang_sense_clarification": "участок земли"
                            },
                            {
                                "target_lang_word": "треугольный участок",
                                "target_lang_sense_clarification": "земли"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zwickel",
                                "target_lang_sense_clarification": "dreieckiges Flurstück"
                            },
                            {
                                "target_lang_word": "Sperrfläche",
                                "target_lang_sense_clarification": "an Autobahnauffahrten oder -ausfahrten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80f17200-b661-38ef-90e7-a4572560adf1",
                    "sense_definition": "To pierce or stab someone or something with a horn or tusk.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry bull tried to <w>gore</w> the matador during the fight.",
                            "target_lang_translations": {
                                "ru": "Разъяренный бык пытался <w>поддеть рогом</w> матадора во время боя.",
                                "de": "Der wütende Stier versuchte, den Matador während des Kampfes <w>aufzuspießen</w>."
                            }
                        },
                        {
                            "text": "He was lucky to survive after being <w>gored</w> by a wild boar in the forest.",
                            "target_lang_translations": {
                                "ru": "Ему повезло выжить после того, как в лесу его <w>пронзил клыком</w> дикий кабан.",
                                "de": "Er hatte Glück zu überleben, nachdem er im Wald von einem Wildschwein <w>aufgespießt worden war</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "impale",
                        "pierce",
                        "stab",
                        "spear"
                    ],
                    "common_phrases": [
                        "gored by a bull",
                        "gored to death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пронзить или ударить кого-либо рогом или клыком.",
                        "de": "Jemanden oder etwas mit einem Horn oder Stoßzahn aufspießen oder durchbohren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронзить рогом",
                                "target_lang_sense_clarification": "ранить"
                            },
                            {
                                "target_lang_word": "бодать",
                                "target_lang_sense_clarification": "бить рогами"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufspießen",
                                "target_lang_sense_clarification": "mit Horn oder Zahn durchbohren"
                            },
                            {
                                "target_lang_word": "auf die Hörner nehmen",
                                "target_lang_sense_clarification": "von einem Stier etc."
                            }
                        ]
                    }
                }
            ]
        },
        {
