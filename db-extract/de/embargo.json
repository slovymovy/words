                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a659ab0f-46cb-4897-8ce8-86680683ca4a",
                                "sense_id": "ac9869b9-409e-3017-8df7-90dd359990cc",
                                "text": "Die Vereinten Nationen beraten zur Stunde über ein Embargo gegen Blauland."
                            },
                            {
                                "example_id": "8d767330-e79e-49d9-a114-02185a9a08d9",
                                "sense_id": "ac9869b9-409e-3017-8df7-90dd359990cc",
                                "text": "Rotland droht Blauland mit einem Embargo."
                            },
                            {
                                "example_id": "d6becd3a-0838-4f28-bf87-5bdf38f9dfa5",
                                "sense_id": "ac9869b9-409e-3017-8df7-90dd359990cc",
                                "text": "Blauland wurde mit einem Embargo belegt."
                            },
                            {
                                "example_id": "d15de369-1744-46c8-aa10-2387490b97d5",
                                "sense_id": "ac9869b9-409e-3017-8df7-90dd359990cc",
                                "text": "„Das Embargo bestärkte die niederländischen Großkaufleute darin, eigene Handelsbeziehungen nach Fernost aufzubauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
