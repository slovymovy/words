                                            {
                                                "example_id": "4478cf33-db88-4952-9990-cef6c5ed92da",
                                                "sense_id": "db195dbe-effd-3074-94ef-5207f1f8e33c",
                                                "text": "Husa při housatech vztyčila svůj hadovitý krk do výše, rozevřela zobák a sici zlostně k oblakům pohlížejíc."
                                            }
                                        ]
                                    }
