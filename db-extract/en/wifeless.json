                    {
                        "sense_id": "f2fc837d-33da-39af-bfc7-cebaab2a5c53",
                        "entry_id": "fa4a78fb-fcb8-313b-9b30-8cee39cd172b",
                        "glosses": [
                            "Having no wife; unmarried or celibate."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c6e83fc9-04b9-47b9-9b59-9658dfea2baf",
                                "sense_id": "f2fc837d-33da-39af-bfc7-cebaab2a5c53",
                                "text": "I am a lone wolf, a solitary man, wandering through a world in which I have no part. I am wifeless—childless—who is it speaks of the childless as the dead twigs on the tree of life?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9825ab99-a144-308d-aa8a-315475895e9b",
                        "entry_id": "fa4a78fb-fcb8-313b-9b30-8cee39cd172b",
                        "glosses": [
                            "Without a wife present."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "df8051d4-669e-40c7-ba59-5c92d1dfadf5",
                                "sense_id": "9825ab99-a144-308d-aa8a-315475895e9b",
                                "text": "I at once telephoned. The Shades were out, said the cheeky ancillula, an obnoxious little fan who came to cook for them on Sundays and no doubt dreamt of getting the old poet to cuddle her some wifeless day."
                            }
                        ]
                    }
