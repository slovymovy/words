                ],
                "senses": [
                    {
                        "sense_id": "5d090be2-995e-3aa1-8543-1eb7e1af07cd",
                        "entry_id": "0e51157e-91e7-3d70-90e5-75dd37c81eec",
                        "glosses": [
                            "(geächtete) erwerbliche Arbeit, die von Kindern verrichtet werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77675b6-2dc2-428c-9944-e99c4c7fda3b",
                                "sense_id": "5d090be2-995e-3aa1-8543-1eb7e1af07cd",
                                "text": "Wenn Kinder keine freie, unbeschwerte Jugend haben, sondern zur Kinderarbeit gezwungen, verkauft, versklavt werden, sind sie ein Symbol für die verkaufte und geschändete Zukunft der gesamten Menschheit."
                            },
                            {
                                "example_id": "304bc8bc-3c03-44b2-a194-0f101f2aa5d1",
                                "sense_id": "5d090be2-995e-3aa1-8543-1eb7e1af07cd",
                                "text": "„Dass Kinderarbeit so märchenhaft daherkommen konnte, störte mich erst später.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f992c57-5f51-3b08-9055-4a5976841c9f",
                        "entry_id": "0e51157e-91e7-3d70-90e5-75dd37c81eec",
                        "glosses": [
                            "etwas, das von einem Kind spielerisch angefertigt wurde"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "32f170b2-f678-4982-93b2-3f79dbdbd4a7",
                                "sense_id": "7f992c57-5f51-3b08-9055-4a5976841c9f",
                                "text": "Im Kindergarten werden die bunten Bilder an großen Wänden aufgehängt und zeigen ideenreiche Kinderarbeiten um Sonne, Mond und Sterne."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
