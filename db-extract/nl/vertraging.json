                    },
                    {
                        "translation_id": "a369fd30-1fd3-4903-ab8c-ad850c15ade8",
                        "source_entry_id": "ac65c434-712e-34e3-a996-b582f1f5f02f",
                        "source_sense_id": "e22e8dfe-de02-37e4-9381-d3c84148ac1a",
