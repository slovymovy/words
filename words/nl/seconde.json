                        },
                        {
                            "text": "Hij twijfelde geen <w>seconde</w> aan zijn beslissing.",
                            "target_lang_translations": {
                                "ru": "Он ни <w>секунды</w> не сомневался в своём решении.",
                                "en": "He didn't doubt his decision for a <w>second</w>.",
                                "pl": "Nie wątpił w swoją decyzję ani przez <w>sekundę</w>.",
                                "de": "Er zweifelte keine <w>Sekunde</w> an seiner Entscheidung.",
                                "fr": "Il n'a pas hésité une <w>seconde</w> sur sa décision.",
                                "it": "Non ha dubitato un <w>secondo</w> della sua decisione.",
                                "cs": "O svém rozhodnutí nepochyboval ani na <w>vteřinu</w>.",
                                "tr": "Kararından bir <w>saniye</w> bile şüphe etmedi.",
                                "es": "No dudó ni un <w>segundo</w> de su decisión."
                            }
