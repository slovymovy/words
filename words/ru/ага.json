        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d0a85fd-ec85-30e6-8edc-e841889745e8",
                    "sense_definition": "Исторический титул военачальников и начальников в султанской Турции, а также лицо, носящее этот титул.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Важный <w>ага</w> отдавал приказы своим слугам.",
                            "target_lang_translations": {
                                "en": "The important <w>agha</w> gave orders to his servants.",
                                "nl": "De belangrijke <w>agha</w> gaf bevelen aan zijn dienaren.",
                                "pl": "Ważny <w>aga</w> wydawał rozkazy swoim sługom.",
                                "de": "Der wichtige <w>Agha</w> gab seinen Dienern Befehle.",
                                "fr": "L'important <w>agha</w> donnait des ordres à ses serviteurs.",
                                "it": "L'importante <w>aga</w> dava ordini ai suoi servitori.",
                                "cs": "Důležitý <w>aga</w> vydával rozkazy svým služebníkům.",
                                "tr": "Önemli bir <w>ağa</w> hizmetkarlarına emirler veriyordu.",
                                "es": "El importante <w>aga</w> daba órdenes a sus sirvientes.",
                                "zh": "那位重要的<w>阿迦</w>向仆人们下达命令。"
                            }
                        },
