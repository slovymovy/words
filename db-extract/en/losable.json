                        "translation_id": "9829b5a5-6637-4432-bcea-c13494e90c7a",
                        "source_entry_id": "f8802781-2d47-30c3-86dc-3e82bd384714",
                        "source_sense_id": "ebc217f4-d85b-3aaa-a778-e1525203d334",
                        "source_sense_description": "Translations",
                        "target_lang_word": "verlierbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verlierbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                        "entry_id": "1ccb77db-b8ef-314f-ab57-5598ad400ac9",
                                        "glosses": [
                                            "so, dass es verloren werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beaa522a-5379-4e67-9cad-4b7bb46037c0",
                                                "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                                "text": "„Diese törichten Kameraden, die sich für konservative Aristokraten hielten und doch die adelige Qualität für verlierbar, durch eine Kleinigkeit verlierbar ansahen!“"
                                            },
                                            {
                                                "example_id": "3f0593d3-701d-45aa-a499-5202a2cdd5c8",
                                                "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                                "text": "„Der Fuchs war dicht hinter ihm her. Ganz eingenommen von der Beute, die er schon im Fang geglaubt hatte, die ihm nicht mehr verlierbar schien, verfolgte er Hops.“"
                                            },
                                            {
                                                "example_id": "7dc14169-a75d-412f-be8e-18a4e34241ad",
                                                "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                                "text": "„Ich lebte meine Stunde, / Nach der das Leben nichts mehr ist, und – alles! / Zum Haben und Verlieren! nein, wo nichts / (An Leib und Seele!) mehr verlierbar ist.“"
                                            },
                                            {
                                                "example_id": "5ea4d1a6-2b4c-45d8-871d-9f540694e6fb",
                                                "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                                "text": "„Noch hab ich dich? So hab ich doch noch was, / Was noch verlierbar ist ….“"
                                            },
                                            {
                                                "example_id": "fbcc6932-bdef-4c5e-b09b-f32fc0d2e86c",
                                                "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                                "text": "„Hier sind schon Stichworte gefallen. Fast zu viele. Das erste – das, mit dem ich zu sprechen angefangen habe – war »unverlierbar«. Das Unverlierbare, das sich als so verlierbar erwiesen hat. Und von dem, seither, man schon weiß, daß es auf Widerruf ist. »Vaterland«? Ich will lieber von Mutterland reden, dem Land meiner Herkunft, dem Land meiner Sprache.“"
                                            },
                                            {
                                                "example_id": "5bdcf98b-a768-4d06-a010-4d1563d098da",
                                                "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                                "text": "„Wir achten die Würde jedes Menschen. Die Würde ist nicht verlierbar. Wir sehen den Menschen als individuelles und selbstbestimmtes Wesen an und richten danach unser Handeln aus.“"
                                            },
                                            {
                                                "example_id": "5b70dbc5-42eb-427f-879b-1baaa35b8465",
                                                "sense_id": "807fcaa6-d831-3b4c-b0ad-fcc985d89b28",
                                                "text": "„[Der Autor] untersucht zunächst die klaren Aussagen der Bibel über das Heil. Dann zeigt er sehr einleuchtend, welche fatalen Folgen es hätte, wenn das Heil verlierbar wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
