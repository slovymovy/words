{
    "word_family": [
        "remontée",
        "remontant",
        "remontoir",
        "remonte",
        "montée",
        "monteur",
        "monture"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6517d66-0289-3a0a-8c8f-fc0027bbfa94",
                    "sense_definition": "Aller ou monter de nouveau vers un endroit plus élevé après être descendu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une courte pause au rez-de-chaussée, il <w>remonte</w> immédiatement dans sa chambre."
                        },
                        {
                            "text": "Le plongeur a passé dix minutes sous l'eau avant de <w>remonter</w> à la surface."
                        }
                    ],
                    "synonyms": [
                        "réascensionner"
                    ],
                    "antonyms": [
                        "redescendre"
                    ],
                    "common_phrases": [
                        "remonter à la surface",
                        "remonter les escaliers"
                    ]
                },
                {
                    "sense_id": "66e15fbe-34d1-3a1b-8516-7d964a3a4e99",
                    "sense_definition": "Dater d'une époque précise ou avoir son origine dans le passé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fondations de ce vieux château fort <w>remontent</w> au douzième siècle."
                        },
                        {
                            "text": "Leur amitié est très solide car elle <w>remonte</w> à l'école primaire."
                        }
                    ],
                    "synonyms": [
                        "dater"
                    ],
                    "common_phrases": [
                        "remonter à longtemps",
                        "remonter le fil du temps"
                    ]
                },
                {
                    "sense_id": "c8ac42f5-84c2-3ef1-b95b-69e29ec6ad66",
                    "sense_definition": "Augmenter de nouveau après une baisse, en parlant d'un niveau, d'un prix ou d'une valeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les températures <w>remontent</w> progressivement après plusieurs jours d'un froid glacial."
                        },
                        {
                            "text": "Le cours des actions en bourse commence enfin à <w>remonter</w> cette semaine."
                        }
                    ],
                    "synonyms": [
                        "augmenter",
                        "progresser"
                    ],
                    "antonyms": [
                        "chuter",
                        "baisser"
                    ],
                    "common_phrases": [
                        "remonter en flèche",
                        "faire remonter la température"
                    ]
                },
                {
                    "sense_id": "d9f64ac1-075b-3dce-aa01-b1db9d4a4a83",
                    "sense_definition": "Redonner du courage, de l'énergie ou de l'enthousiasme à une personne abattue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses amis sont venus passer la soirée avec elle pour lui <w>remonter</w> le moral."
                        },
                        {
                            "text": "Une tasse de chocolat chaud va certainement vous <w>remonter</w> après cette longue marche."
                        }
                    ],
                    "synonyms": [
                        "réconforter",
                        "encourager"
                    ],
                    "antonyms": [
                        "démoraliser",
                        "abattre"
                    ],
                    "common_phrases": [
                        "remonter le moral"
                    ]
                },
                {
                    "sense_id": "61bdf990-5f58-3160-980b-eab3b26fa018",
                    "sense_definition": "Transporter ou hisser de nouveau quelque chose vers le haut.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu m'aider à <w>remonter</w> les valises au deuxième étage avant le dîner ?"
                        },
                        {
                            "text": "Il fait froid dehors alors pensez à <w>remonter</w> votre fermeture éclair."
                        }
                    ],
                    "synonyms": [
                        "monter",
                        "hisser"
                    ],
                    "antonyms": [
                        "descendre"
                    ],
                    "common_phrases": [
                        "remonter les valises",
                        "remonter ses manches"
                    ]
                },
                {
                    "sense_id": "1bd1a049-ca12-3cfa-8449-981c65bb82c4",
                    "sense_definition": "Parcourir une voie, une file ou un cours d'eau en direction de l'amont ou en sens inverse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les saumons nagent avec force pour <w>remonter</w> le courant de la rivière tumultueuse."
                        },
                        {
                            "text": "Cette moto a failli provoquer un accident en voulant <w>remonter</w> la file de voitures."
                        }
                    ],
                    "antonyms": [
                        "descendre"
                    ],
                    "common_phrases": [
                        "remonter le courant",
                        "remonter une file"
                    ]
                },
                {
                    "sense_id": "1bba798b-e58c-3a9b-96b3-4a18bda0054d",
                    "sense_definition": "Assembler de nouveau les différentes pièces d'un meuble, d'une machine ou d'un appareil qui avait été démonté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien a nettoyé toutes les pièces avant de <w>remonter</w> le moteur de la voiture."
                        },
                        {
                            "text": "Après le déménagement, nous avons passé tout le week-end à <w>remonter</w> nos armoires."
                        }
                    ],
                    "synonyms": [
                        "réassembler"
                    ],
                    "antonyms": [
                        "démonter"
                    ],
                    "common_phrases": [
                        "remonter un meuble",
                        "remonter le moteur"
                    ]
                },
                {
                    "sense_id": "58bd9d85-3fed-38c1-877a-544fb18e6323",
                    "sense_definition": "Signaler ou transmettre une information, une difficulté ou une alerte à une autorité ou à un échelon hiérarchique supérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le technicien a promis de <w>remonter</w> ce problème récurrent à l'équipe de développement."
                        },
                        {
                            "text": "Dès qu'un client exprime un mécontentement, nous devons <w>remonter</w> la réclamation sans tarder."
                        }
                    ],
                    "synonyms": [
                        "rapporter",
                        "transmettre"
                    ],
                    "common_phrases": [
                        "remonter un problème",
                        "remonter une information"
                    ]
                },
                {
                    "sense_id": "f1591053-bef5-3c5f-9a52-47c311025973",
                    "sense_definition": "Tendre à nouveau le ressort d'un mécanisme d'horlogerie ou d'un jouet mécanique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille horloge de salon s'arrête si on oublie de la <w>remonter</w> chaque dimanche."
                        },
                        {
                            "text": "L'enfant aimait beaucoup <w>remonter</w> son petit train mécanique avec la clé en métal."
                        }
                    ],
                    "common_phrases": [
                        "remonter une horloge",
                        "remonter une montre"
                    ]
                }
            ]
        }
    ]
}