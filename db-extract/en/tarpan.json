                        "glosses": [
                            "An extinct Northern European wild horse, Equus ferus ferus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245179ed-b494-4bbc-b299-3fa25b7a1124",
                                "sense_id": "dc0eb805-d651-3c08-839a-fa2639d37f5f",
                                "text": "It’s possible that wild horses, known as tarpans, survived in southern Russia until the nineteenth century, but these may have been hybrids, with genes from domestic horses."
                            }
                        ]
                    }
                ],
