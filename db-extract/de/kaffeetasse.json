                                    {
                                        "sense_id": "6b6d3384-c38e-3e2f-9396-eaf7c7b4810a",
                                        "entry_id": "7fb21bf9-f95d-3dca-9624-065e7d3ebbaf",
                                        "glosses": [
                                            "A cup, typically a small one, in which coffee can be served."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1107d302-0d42-4395-80b1-c4554eca8b68",
                                                "sense_id": "6b6d3384-c38e-3e2f-9396-eaf7c7b4810a",
                                                "text": "“It’s nothing much, but—well, if you are going, will you tell him——” he dropped his voice to a whisper—“I think I’ve found the extra coffee-cup!”"
                                            },
                                            {
                                                "example_id": "2dc020e4-4b03-4d8a-b6c4-b12229de8cce",
                                                "sense_id": "6b6d3384-c38e-3e2f-9396-eaf7c7b4810a",
                                                "text": "Got a picture of you beside me / Got your lipstick mark still on your coffee cup"
                                            }
                                        ]
