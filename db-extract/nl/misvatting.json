                    {
                        "translation_id": "8050325f-820a-45c7-99b7-943bf431e085",
                        "source_entry_id": "e0030661-286f-3cfb-912d-0ab7d888a8f8",
                        "source_sense_id": "91f06e1e-4aff-3835-8839-c3034e00a32f",
