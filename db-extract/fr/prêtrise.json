                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1726ba63-4aaf-4e80-858f-3dfd0be7d174",
                                                "sense_id": "b70eb7ef-0656-3b62-88df-0f9571d402b8",
                                                "text": "De priesterschap van Amon kreeg onder de latere Ramessiden steeds meer politieke macht en oefende onder de volgende dynastie koninklijke macht uit."
                                            }
