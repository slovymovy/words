                                        "glosses": [
                                            "bewust doden van vrouwen of meisjes omdat ze vrouw of meisje zijn, moord uit vrouwenhaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8fac11-58ba-40e2-9ca6-677a4f41b333",
                                                "sense_id": "e8588d75-ed1d-3b97-994d-4cd71904b97e",
                                                "text": "Woensdag werd bekend dat er in Frankrijk elke drie dagen een vrouw omkomt door partnergeweld. Alleen dit jaar al zijn het er al zesenzeventig. Feminicide heet het daar. Bij ons mag dat ook wel eens ingeburgerd gaan raken, dat woord dat precies het juiste is. Hard en lelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
