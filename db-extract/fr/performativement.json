                                            {
                                                "example_id": "0e9b5ba6-ffda-4c99-8249-e95b6a442aef",
                                                "sense_id": "c04aa5d0-49d1-3f43-9d36-811ceb3a6d53",
                                                "text": "He is the God of all comfort, First, Purposely; Second, Provisionally; Third, Prescriptively and performatively."
                                            },
                                            {
                                                "example_id": "13c7aee3-81e4-400a-8621-f998dafa2e63",
                                                "sense_id": "c04aa5d0-49d1-3f43-9d36-811ceb3a6d53",
                                                "text": "Most of them can also be used performatively, however, i.e. to make explicit what kind of speech act it is the speaker performs (not all illocutionary verbs can be so used however: cf e.g. boast, threaten)."
                                            }
                                        ]
