                            {
                                "example_id": "fca20247-145e-4273-9d6d-063ae9b855be",
                                "sense_id": "bb3bea14-90ac-3084-9189-7107c15d3919",
                                "text": "Zo zagen we schermers omringd door violisten hun kunsten vertonen, werd er polsstokhooggesprongen onder begeleiding van een orkest of werden er plotseling grote zwarte ballen tussen het publiek gegooid."
                            },
                            {
                                "example_id": "5fc66e0a-375c-4cd3-a498-c3813ee9898b",
                                "sense_id": "bb3bea14-90ac-3084-9189-7107c15d3919",
                                "text": "De verspringbak voldoet niet aan de eisen en vooral de jeugd zouden we er graag de mogelijkheden scheppen om hoog en polstokhoog te springen of speer te werpen."
                            },
                            {
                                "example_id": "7dc2ca89-7d96-4dc7-a1aa-eadae8e306c4",
                                "sense_id": "bb3bea14-90ac-3084-9189-7107c15d3919",
                                "text": "Twee atleten waren aan het polsstokhoogspringen om te oefenen voor de wedstrijd."
                            }
                        ]
                    }
