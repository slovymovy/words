                ],
                "translations": [
                    {
                        "translation_id": "46921cb5-88a6-47f3-8643-9663fb4df27a",
                        "source_entry_id": "41b5fc03-14b1-3fe0-b25f-121e9fd0ca0d",
                        "source_sense_id": "eb5f3f65-6bd3-382a-b4a4-35b7664ce5dd",
                        "target_lang_word": "Pharisäer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pharisäer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbbb9651-2996-32f2-9a24-6bb3f6a88e51",
                                        "entry_id": "c80d92a0-8483-3ea1-acf0-a862f172af36",
                                        "glosses": [
                                            "ein Vertreter einer politisch-religiösen Bewegung im antiken Judentum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5127b9c1-7437-4662-8f10-385129df2599",
                                                "sense_id": "dbbb9651-2996-32f2-9a24-6bb3f6a88e51",
                                                "text": "„Er will den Haufen hören, nicht mich oder dich oder einen der abseits geht, wie die Pharisäer die sich abgesondert haben.“"
                                            },
                                            {
                                                "example_id": "94e43276-2ef0-4fe6-a52a-9e46f858a81a",
                                                "sense_id": "dbbb9651-2996-32f2-9a24-6bb3f6a88e51",
                                                "text": "„Nur wenige Jahre nach Jesu Tod wurde der Pharisäer Paulus zum Christentum bekehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b114f3ee-314d-3c1b-be29-c68e2bb2a45b",
                                        "entry_id": "c80d92a0-8483-3ea1-acf0-a862f172af36",
                                        "glosses": [
                                            "Person, die heuchlerisch und hochmütig ist"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative",
                                            "literary"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "681ff791-7793-3b48-92bd-6a373a3fe385",
                                        "entry_id": "c80d92a0-8483-3ea1-acf0-a862f172af36",
                                        "glosses": [
                                            "Heißgetränk, das aus einem Kaffee mit einer alkoholischen Beigabe (Kognak, Whisky oder Ähnlichem) und geschlagener Sahne besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b2889c6-6402-4664-b333-aea722ed3909",
                                                "sense_id": "681ff791-7793-3b48-92bd-6a373a3fe385",
                                                "text": "„Der zähe Kampf wurde belohnt: 1954 wurde das Café eröffnet. Unten war die Bäckerei, oben tranken die Gäste Melange, Pharisäer und aßen heiße Waffeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cd02942-93fc-4626-8450-cb8169358c91",
                        "source_entry_id": "41b5fc03-14b1-3fe0-b25f-121e9fd0ca0d",
                        "source_sense_id": "eb5f3f65-6bd3-382a-b4a4-35b7664ce5dd",
                        "target_lang_word": "Pharisee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pharisee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c34afa4-6f3b-3300-9c8b-8d70bfe1707e",
                                        "entry_id": "cf7e6434-2775-304a-b6e1-932fd37836e9",
                                        "glosses": [
                                            "A member of an ancient Jewish political party, a social movement, and a school of thought among Jews that flourished during the Second Temple Era (536 B.C.E.–70 C.E.). The movement was ultimately the basis for most contemporary forms of Judaism."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001d5ae7-b80e-404e-b8eb-d57ac8300f95",
                                                "sense_id": "3c34afa4-6f3b-3300-9c8b-8d70bfe1707e",
                                                "text": "Then understood they how that he bade them not beware of the leaven of bread, but of the doctrine of the Pharisees and of the Sadducees."
                                            },
                                            {
                                                "example_id": "0b1d8a06-6594-40d5-8461-448b12508bfd",
                                                "sense_id": "3c34afa4-6f3b-3300-9c8b-8d70bfe1707e",
                                                "text": "I cannot tell. They [Jews]are always doing it. The Pharisees, for instance, say that there are angels, and the Sadducees declare that angels do not exist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6da67f54-f4ee-3037-b49f-f216d8c98096",
                                        "entry_id": "cf7e6434-2775-304a-b6e1-932fd37836e9",
                                        "glosses": [
                                            "A person who values the letter of the law over its spirit or intention."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcca898b-9387-498d-9cea-46a42b1ce7b7",
                                                "sense_id": "6da67f54-f4ee-3037-b49f-f216d8c98096",
                                                "text": "He was, and is yet most likely, the wearisomest self-righteous Pharisee that ever ransacked a Bible to rake the promises to himself and fling the curses to his neighbours."
                                            },
                                            {
                                                "example_id": "5d440e18-4298-471f-b1e0-1db05af1aa51",
                                                "sense_id": "6da67f54-f4ee-3037-b49f-f216d8c98096",
                                                "text": "The spider fattens himself on flies, and the Pharisee has his reward. Foolish persons are easily entrapped by the loud professions of pretenders, and even the more judicious cannot always escape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec2e8aad-916e-4183-85aa-e5a26f4d4d8f",
                        "source_entry_id": "41b5fc03-14b1-3fe0-b25f-121e9fd0ca0d",
                        "source_sense_id": "eb5f3f65-6bd3-382a-b4a4-35b7664ce5dd",
                        "target_lang_word": "pharisien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharisien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "063bb8f8-1521-364a-964d-2acaa596c949",
                                        "entry_id": "61c0b850-e9c3-3a01-a7bc-a6291b3d1140",
                                        "glosses": [
                                            "Membre d’un courant du peuple juif."
                                        ],
                                        "tags": [
                                            "Biblical",
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95666d49-a359-4237-ae2b-4540f1720253",
                                                "sense_id": "063bb8f8-1521-364a-964d-2acaa596c949",
                                                "text": "Ces gens-là, en vertu de leur observation rigide-de la loi ainsi grossie de leurs traditions, se regardoient comme plus saints que les autres, & se séparoient de ceux qu’ils traitoient de pécheurs & de profanes, avec qui ils ne vouloient pas seulement manger ou boire ; c’est de-là que leur est venu le nom de Pharisiens, du mot de pharas, qui signifie séparé, quoique cette séparation dans leur premiere intention, eût été de s’écarter du petit peuple, qu’ils appellaient am haaretz, le peuple de la terre, & qu’ils regardaient avec un souverain mépris comme la balayure du monde ; leurs prétentions hypocrites d’une sainteté au-dessus du commun, imposèrent à ce petit peuple même & l’entraînèrent, par la vénération & l’admiration qu’elles lui causèrent."
                                            },
                                            {
                                                "example_id": "7c601929-9d02-49ea-a61c-4a2286993a9a",
                                                "sense_id": "063bb8f8-1521-364a-964d-2acaa596c949",
                                                "text": "Les pharisiens affectaient de se distinguer par la sainteté extérieure de leur vie."
                                            },
                                            {
                                                "example_id": "9eb4fcd6-500b-4467-8518-b6c394af245b",
                                                "sense_id": "063bb8f8-1521-364a-964d-2acaa596c949",
                                                "text": "Je ne compris pas bien pourquoi les pharisiens, dont le nom ressemblait de façon troublante à celui des habitants de Paris, s’étaient acharnés contre Jésus, mais je compatis à ses malheurs."
                                            },
                                            {
                                                "example_id": "6cd2f38a-d59f-42be-be7b-ae3b12d8ca8a",
                                                "sense_id": "063bb8f8-1521-364a-964d-2acaa596c949",
                                                "text": "Je n’obtins aucun succès à Jérusalem, pas même de curiosité. Ma seule réussite consista à me faire détester chaque jour davantage des prêtres, docteurs de la Loi, saducéens et pharisiens."
                                            },
                                            {
                                                "example_id": "685928e7-122b-4e0f-a6a0-c6e93c362eae",
                                                "sense_id": "063bb8f8-1521-364a-964d-2acaa596c949",
                                                "text": "L’Évangile nous parle des pharisiens et des hérodiens. Pour le premier groupe, l’occupation de leur pays par l’armée romaine est interprétée comme une punition venant de Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f60a095-9667-390e-9569-413be5ee6d97",
                                        "entry_id": "61c0b850-e9c3-3a01-a7bc-a6291b3d1140",
                                        "glosses": [
                                            "Personne qui n’a que l’ostentation de la piété ou de la vertu, généralement de façon hypocrite."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c007bf-d509-4e82-9d22-2378355fc819",
                                                "sense_id": "4f60a095-9667-390e-9569-413be5ee6d97",
                                                "text": "Cette distinction, pourtant « élémentaire », en effet, échappe apparemment à ces nouveaux pharisiens qui préfèrent, renouant ainsi avec une conception primitive et magique du langage, décréter certains mots tabous, tout comme ils s'offusquent davantage d'une image que de la réalité dont elle est supposée témoigner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8860111-c3f5-3a59-9d72-a48d94571bac",
                                        "entry_id": "61c0b850-e9c3-3a01-a7bc-a6291b3d1140",
                                        "glosses": [
                                            "Personne qui, sûre de soi, juge de haut, avec orgueil et dureté, les actions ou les opinions des autres."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23dd56b-b155-41c0-a870-11fe09ec854f",
                                                "sense_id": "f8860111-c3f5-3a59-9d72-a48d94571bac",
                                                "text": "À Rome, tout à côté du gouvernement central de l'Église, il était resté en marge, il avait fondé l’oratorio, foyer de ferveur et de joie, loin des vétilleux, des dogmatiques, des inquisiteurs-nés, des scribes et des pharisiens de son époque."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pharisien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df318f40-70bc-301f-b0db-0649546da5d5",
                                        "entry_id": "0f79e0aa-473c-3d87-b1b5-e92c30554b66",
                                        "glosses": [
                                            "Qui appartient à la doctrine des pharisiens de l'antiquité juive."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "086410e9-87c9-40bf-a7ea-d85d95f9d7ee",
                                                "sense_id": "df318f40-70bc-301f-b0db-0649546da5d5",
                                                "text": "Parallèlement à cet attachement foncier à l'héritage juif, on perçoit dans cet évangile un affrontement avec le courant pharisien, devenu après l'an 70 la composante dominante du judaïsme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6210b850-a91a-38d3-9eaa-fffb4d1d6159",
                                        "entry_id": "0f79e0aa-473c-3d87-b1b5-e92c30554b66",
                                        "glosses": [
                                            "Pharisaïque, qui observe plus la forme que le fond."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b70c41-e666-42f2-82f7-49d1babee934",
                                                "sense_id": "6210b850-a91a-38d3-9eaa-fffb4d1d6159",
                                                "text": "Quand je dis moralistes, j’entends pseudo-moralistes pharisiens."
                                            },
                                            {
                                                "example_id": "a34ec742-5c25-46a1-8d26-640d9ea32669",
                                                "sense_id": "6210b850-a91a-38d3-9eaa-fffb4d1d6159",
                                                "text": "Rien d’autre n’existait – pas même sa religion pharisienne et fétichiste dont il ne restait que l’écorce. Tout avait été dévoré du dedans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
