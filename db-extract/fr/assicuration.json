                                        ]
                                    },
                                    {
                                        "sense_id": "25bac244-2f4f-3fc8-b17c-7eb47f4aa86c",
                                        "entry_id": "c915bcd5-f687-3eef-85fe-0214baf5a35c",
                                        "glosses": [
                                            "A bet made after the deal, which pays off if the dealer has blackjack."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
