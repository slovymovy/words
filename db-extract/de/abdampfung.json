                "senses": [
                    {
                        "sense_id": "d7c0897c-fca7-3532-9449-6e0e55695aa3",
                        "entry_id": "6ba5e582-b6f5-3eac-b628-d3c0b7de5f7f",
                        "glosses": [
                            "Vorgang, bei dem ein Gas oder Wasserdampf ausgestoßen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60591e8-97ef-45eb-ba0f-a066059a906e",
                                "sense_id": "d7c0897c-fca7-3532-9449-6e0e55695aa3",
                                "text": "„Für schwächer gebundene Cluster ist diese Abdampfung wahrscheinlicher, so daß ihre Intensität im Massenspektrum abnimmt und sich auf den stärker gebundenen Clustern ansammelt.“"
                            },
                            {
                                "example_id": "7eedddfa-29c1-4f9a-8779-cbc2455534b6",
                                "sense_id": "d7c0897c-fca7-3532-9449-6e0e55695aa3",
                                "text": "„Als die beste Art, Milch, z.B. für weite Seereisen, aufzubewahren, wird die Abdampfung frisch gemolkener empfohlen, der vorher 1/50 oder 1/100 Zucker beigemengt wurde.“"
                            },
                            {
                                "example_id": "deafa99a-763b-4f99-bb6f-263a034c4dec",
                                "sense_id": "d7c0897c-fca7-3532-9449-6e0e55695aa3",
                                "text": "„Wenn die verdunstende Flüssigkeit wieder gewonnen wird, so heißt die Abdampfung Destillation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
