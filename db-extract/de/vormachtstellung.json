                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e67b2ad1-d531-377c-836e-cff4e5a467f3",
                                        "entry_id": "cf477ca7-bf6b-3115-8c9e-02fb42ad8a2d",
                                        "glosses": [
                                            "The ideology that a specified group is superior to others or should have supreme power over them."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "010ffa87-ac3e-46f9-8f37-bcbdf8ee55b3",
                                                "sense_id": "e67b2ad1-d531-377c-836e-cff4e5a467f3",
                                                "text": "white supremacy"
                                            },
                                            {
                                                "example_id": "37aff184-a9c5-4478-bbc0-cd32f9288119",
                                                "sense_id": "e67b2ad1-d531-377c-836e-cff4e5a467f3",
                                                "text": "Fighting a war against Hitler's Nazi ideology, with its doctrine of Aryan supremacy and its \"final solution\" to protect against an \"inferior people,\" accentuated the final irony of an America fighting a racist ideology while trying to keep its own racist ideology intact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a78a973-45f5-3fab-a77b-ba5aea084892",
                                        "entry_id": "cf477ca7-bf6b-3115-8c9e-02fb42ad8a2d",
                                        "glosses": [
                                            "A state of privilege for a specified group relative to other people in society."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
