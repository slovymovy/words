                        "sense_id": "f251005e-6b9a-3332-a113-7032ece185f0",
                        "entry_id": "ff40207a-e914-3f31-aa23-8e70091c5abc",
                        "glosses": [
                            "The god of marriage and marriage ceremonies."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "3d1881a0-39da-4df3-a4e0-7427608b6211",
                                "sense_id": "f251005e-6b9a-3332-a113-7032ece185f0",
                                "text": "\"By the saffron robe of Hymen,\" cried Lord Norbourne, \"but that would be a blessing! I own that I am no great friend to marriage in general; […] If a young man has his way to make in the world, a wife is a dead weight upon his hands.[…]\""
                            }
                        ]
                    }
                ],
