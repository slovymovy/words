            "senses": [
                {
                    "sense_id": "d9741463-c7d4-322e-be32-b9313a6c0297",
                    "sense_definition": "Remaining firm, steady, or resolute; not disturbed or weakened emotionally or mentally.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite facing intense criticism from the media, his confidence remained <w>unshaken</w>.",
                            "target_lang_translations": {
                                "es": "A pesar de enfrentar intensas críticas de los medios, su confianza permaneció <w>inquebrantable</w>."
                            }
                        },
                        {
                            "text": "Her faith was <w>unshaken</w> even throughout the darkest moments of the crisis.",
                            "target_lang_translations": {
                                "es": "Su fe fue <w>inquebrantable</w> incluso durante los momentos más oscuros de la crisis."
                            }
                        }
                    ],
                    "synonyms": [
                        "steadfast",
                        "unwavering",
                        "firm",
                        "resolute"
                    ],
                    "antonyms": [
                        "shaken",
                        "wavering"
                    ],
                    "common_phrases": [
                        "remain unshaken",
                        "unshaken faith",
                        "unshaken belief"
                    ],
                    "target_lang_definitions": {
