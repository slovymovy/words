            {
                "entry_id": "923c0bdd-5ba7-3254-84af-4d9f7db50419",
                "word": "красив",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "b1451f21-5602-41f8-9481-c42ed02d713b",
                        "entry_id": "923c0bdd-5ba7-3254-84af-4d9f7db50419",
                        "tags": [
