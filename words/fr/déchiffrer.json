            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ac596b8-10a0-34e0-a4b0-04077159f60f",
                    "sense_definition": "Parvenir à lire une écriture difficile, effacée ou confuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a une écriture si serrée que je n'arrive pas à la <w>déchiffrer</w>."
                        },
                        {
                            "text": "L'historien passe ses journées à <w>déchiffrer</w> de vieux manuscrits poussiéreux."
                        }
                    ],
                    "synonyms": [
                        "lire",
                        "décrypter"
                    ],
                    "common_phrases": [
                        "déchiffrer une écriture",
                        "déchiffrer une lettre",
                        "déchiffrer un manuscrit"
                    ]
                },
                {
                    "sense_id": "d0446a14-03b1-3785-b83e-00d299cec2d6",
                    "sense_definition": "Transformer en langage clair un message codé, chiffré ou secret.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cryptographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les experts militaires travaillent jour et nuit pour <w>déchiffrer</w> cette communication ennemie."
                        },
                        {
                            "text": "Il a réussi à <w>déchiffrer</w> un message secret grâce à un algorithme puissant."
                        }
                    ],
                    "synonyms": [
                        "décoder",
                        "décrypter"
                    ],
                    "antonyms": [
                        "chiffrer",
                        "encoder"
                    ],
                    "common_phrases": [
                        "déchiffrer un message",
                        "déchiffrer un code"
                    ]
                },
                {
                    "sense_id": "8ea11287-2e0f-3f30-baa4-d9dc83444259",
                    "sense_definition": "Comprendre et interpréter ce qui est obscur, complexe ou énigmatique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analystes politiques s'efforcent de <w>déchiffrer</w> les conséquences de ce vote inattendu."
                        },
                        {
                            "text": "Personne ne parvient à <w>déchiffrer</w> le mystère qui entoure cette disparition soudaine."
                        }
                    ],
                    "synonyms": [
                        "élucider",
                        "percer",
                        "éclaircir"
                    ],
                    "antonyms": [
                        "obscurcir"
                    ],
                    "common_phrases": [
                        "déchiffrer une énigme",
                        "déchiffrer la situation"
                    ]
                },
                {
                    "sense_id": "eefa0467-5b6a-3638-8074-a09fc9ea9737",
                    "sense_definition": "Lire et exécuter une partition musicale à première vue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pianiste virtuose est capable de <w>déchiffrer</w> un morceau sans aucune hésitation."
                        },
                        {
                            "text": "Pendant son cours de solfège, elle apprend à <w>déchiffrer</w> de nouvelles partitions."
                        }
                    ],
                    "common_phrases": [
                        "déchiffrer une partition",
                        "déchiffrer un morceau",
                        "déchiffrer à vue"
                    ]
                },
                {
                    "sense_id": "9db7f9da-a0f6-3566-907c-ba36b4b6c486",
                    "sense_definition": "Découvrir ou deviner les pensées, les sentiments ou les intentions secrètes de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle fixait son interlocuteur pour tenter de <w>déchiffrer</w> ses véritables intentions."
                        },
                        {
                            "text": "Il est tellement impassible qu'il est impossible de <w>déchiffrer</w> la moindre émotion."
                        }
                    ],
                    "synonyms": [
                        "percer à jour",
                        "sonder",
                        "deviner"
                    ],
                    "common_phrases": [
                        "déchiffrer un regard",
                        "déchiffrer les intentions"
                    ]
                }
            ]
        }
    ]
