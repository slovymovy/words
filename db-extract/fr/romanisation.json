                "senses": [
                    {
                        "sense_id": "42251d42-6668-31bf-a977-c0f4ffa9c7dc",
                        "entry_id": "c0ae04f1-e8c4-394a-8ada-703e1cc60950",
                        "glosses": [
                            "Fait de romaniser, de rendre romain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee29750a-b9b6-4c73-8906-b3753c3db193",
                                "sense_id": "42251d42-6668-31bf-a977-c0f4ffa9c7dc",
                                "text": "Même si, dans l’Empire romain, la romanisation avait, en Afrique du Nord, été plus tardive qu’en Gaule ou en Espagne, elle semblait bien ancrée dans les villes et dans les élites sociales, en particulier dans le tiers oriental du Maghreb (Africa et Numidie)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a45079e-1c63-324f-b46d-8f718e474d37",
                        "entry_id": "c0ae04f1-e8c4-394a-8ada-703e1cc60950",
                        "glosses": [
                            "Translittération en caractères romains, c’est-à-dire en utilisant l’alphabet latin."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73ed372d-e102-4712-ac67-22064fb5ccec",
                        "source_entry_id": "c0ae04f1-e8c4-394a-8ada-703e1cc60950",
                        "source_sense_description": "Linguistique",
                        "target_lang_word": "Romanisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romanisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85254a0c-ab05-3c01-9dad-2ff5cff7b7da",
                                        "entry_id": "0ac3db95-8755-3488-bcc4-30284ba503e5",
                                        "glosses": [
                                            "der Vorgang, bei dem die Bewohner der von Rom eroberten Gebiete die Lebensweise und Bräuche der Römer immer erfolgreicher in ihre eigenen Lebensgewohnheiten umwandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e3987ed-5361-442d-9d1c-7342ad91ee28",
                                                "sense_id": "85254a0c-ab05-3c01-9dad-2ff5cff7b7da",
                                                "text": "Die Romanisierung Galliens schritt nach seiner Eroberung schnell voran."
                                            },
                                            {
                                                "example_id": "d8eb6978-ef49-4380-8137-96b5893200c7",
                                                "sense_id": "85254a0c-ab05-3c01-9dad-2ff5cff7b7da",
                                                "text": "„Eine Zunahme der Handelsbeziehungen zwischen Britannien und Nordgallien ist im Anschluss an die Romanisierung Südgalliens nach der Einrichtung der Provinz Gallia Narbonensis gegen Ende des 2. Jahrhunderts v. Chr. zu verzeichnen.“"
                                            },
                                            {
                                                "example_id": "2286ad99-ab6b-4dbf-b3ab-254831343269",
                                                "sense_id": "85254a0c-ab05-3c01-9dad-2ff5cff7b7da",
                                                "text": "„Das Territorium war zwar noch nicht erobert, aber die Romanisierung konnte ja schon mal beginnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "252b67a2-d956-336f-ae14-baf30fd92585",
                                        "entry_id": "0ac3db95-8755-3488-bcc4-30284ba503e5",
                                        "glosses": [
                                            "die Umschrift eines Textes in das lateinische Alphabet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4606edc6-c39b-47d9-ace1-35cba70b3b19",
                                                "sense_id": "252b67a2-d956-336f-ae14-baf30fd92585",
                                                "text": "Insbesondere bei der Wiedergabe ostasiatischer Sprachen mit den Zeichen des lateinischen Alphabets und diakritischen Zeichen spricht man auch von Romanisierungen (siehe unten)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
