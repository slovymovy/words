                                "target_senses": [
                                    {
                                        "sense_id": "13833b80-b4c1-33f7-b872-0d714a31660e",
                                        "entry_id": "eef62af8-3088-3eb5-8609-d63de6d60792",
                                        "glosses": [
                                            "The retention of juvenile characteristics in the adult."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "271c7c70-231f-45be-b8e3-7f69b8c65e6c",
                                                "sense_id": "13833b80-b4c1-33f7-b872-0d714a31660e",
                                                "text": "Most amphibians are aquatic only while young, but some amphibians with neoteny remain aquatic even as adults."
                                            },
                                            {
                                                "example_id": "62247dca-3983-4475-a5bc-5cd72ca65b22",
                                                "sense_id": "13833b80-b4c1-33f7-b872-0d714a31660e",
                                                "text": "Richard Wrangham has noted that the domestication of animals usually tames them by slowing down components of the developmental timetable to retain juvenile traits into adulthood, a process called pedomorphy or neoteny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6195c557-ee86-3925-bc72-4dc30763b4c4",
                                        "entry_id": "eef62af8-3088-3eb5-8609-d63de6d60792",
                                        "glosses": [
                                            "The sexual maturity of an organism still in its larval stage."
                                        ],
