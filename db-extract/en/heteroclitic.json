                    {
                        "sense_id": "58667228-4330-39fa-b924-362c9b108357",
                        "entry_id": "2072f876-89f8-32b5-8068-9899efe0e42c",
                        "glosses": [
                            "Signifying a nominal stem which alternates between more than one form when declined for grammatical case, particularly in the suffix, most often between *-r- in the strong stem and *-n- in the weak stem(s). Examples of heteroclitic noun stems in Proto-Indo-European include *wod-r/n- (“water”) (nominoaccusative *wódr̥; genitive *udnés; locative *udén) and *yékʷ-r/n- (“liver”) (nominoaccusative *yékʷr̥, genitive *ikʷnés)."
                        ],
                        "tags": [
                            "Indo-European-studies"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c875f924-09ad-3174-bce4-f50d55f7c135",
                        "entry_id": "2072f876-89f8-32b5-8068-9899efe0e42c",
                        "glosses": [
                            "Pertaining to antibodies that react to a wide variety of antigens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1060137-5996-4652-92b8-2d6ac84af34b",
                                "sense_id": "c875f924-09ad-3174-bce4-f50d55f7c135",
                                "text": "[…] a heteroclitic response was never observed after the immunization with the deamidated peptide […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e87498bf-df21-4b41-b338-06f934094f0c",
                        "source_entry_id": "2072f876-89f8-32b5-8068-9899efe0e42c",
                        "source_sense_description": "irregular in inflection",
                        "target_lang_word": "hétéroclite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hétéroclite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2944c2aa-eb0a-3f02-8597-e837beb02ab7",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Qui mélange les déclinaisons."
                                        ],
                                        "tags": [
                                            "Sens étymologique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19adf7fa-0f7f-4325-8836-5d556abdcaeb",
                                                "sense_id": "2944c2aa-eb0a-3f02-8597-e837beb02ab7",
                                                "text": "Les noms neutres proto-indo-européens sont caractérisés par une déclinaison hétéroclite dans la mesure où ils reçoivent un suffixe différent au nominatif et au cas oblique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "075aacd9-0a7e-37d5-8afc-2f8dbb1816e1",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Qui s’écarte des règles ordinaires, composite, mélangé, divers, panaché, hétérogène."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fb0227-8e97-47c8-9fea-3deb9649e776",
                                                "sense_id": "075aacd9-0a7e-37d5-8afc-2f8dbb1816e1",
                                                "text": "Bâtiment hétéroclite, mot composé hétéroclite."
                                            },
                                            {
                                                "example_id": "551a7ffd-b2b7-4d03-9520-e1c210c5ea64",
                                                "sense_id": "075aacd9-0a7e-37d5-8afc-2f8dbb1816e1",
                                                "text": "Amalgame hétéroclite, mélange de composants très différents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Mélangé d’éléments disparates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b6175f-f96f-4853-9972-7108c0b0bfa1",
                                                "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                                "text": "Elle se dirigea vers un marchand d'arlequins. Triste endroit pour souper ! On y servait, réuni sur une seule assiette, un mélange hétéroclite (d'où son nom) de reliefs plus ou moins avariés, collectés dans les restaurants voisins."
                                            },
                                            {
                                                "example_id": "19270715-0ee3-47dd-b8f2-5010970f7c18",
                                                "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                                "text": "Vers la fin du souper, comme dans un film, l'une des premières manifestations nocturnes passe devant le restaurant, long ruban hétéroclite et bruyant dans la pénombre …."
                                            },
                                            {
                                                "example_id": "8296c686-2e9e-4c29-8555-7e95b33cd3a4",
                                                "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                                "text": "Selon la vieille loi de la prédiction créatrice, ce procès fait advenir l’adversaire qu’il combat. Il transforme une nébuleuse hétéroclite de courants de pensées et de travaux disparates en complot plus ou moins organisé contre la science et contre la République."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5a097a-86d8-3ed4-ad71-d530cb5b4ef6",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Se dit d’une œuvre dont les différentes parties appartiennent à des styles et des mouvements artistiques différents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd00ac8d-a899-4461-96bf-27da85ffb179",
                                                "sense_id": "4f5a097a-86d8-3ed4-ad71-d530cb5b4ef6",
                                                "text": "Une pièce de théâtre, un roman hétéroclite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "En parlant des personnes et des choses, qui a une apparence ridicule, étrange, bizarre, singulière."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2084efe-648b-4126-ab29-1de67c60a436",
                                                "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                                "text": "Manières hétéroclites."
                                            },
                                            {
                                                "example_id": "a6fc2a28-f0be-419b-a9df-b3bd5ba73c18",
                                                "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                                "text": "Personnage hétéroclite."
                                            },
                                            {
                                                "example_id": "66cd733b-c5cd-4429-bdea-5e38dbad1605",
                                                "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                                "text": "Il est à la Bourse des recoins ignorés où grouille tout une population héteroclite.’’ — (Émile Gaboriau, L’Argent des autres , 1874)"
                                            }
                                        ]
                                    }
                                ]
                            }
