    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0129f08-3cc7-3896-a88a-e59512b873f3",
                    "sense_definition": "Einen Gegenstand, der am Boden liegt, mit den Händen fassen und nach oben bringen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hochheben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kannst du mir bitte den Stift <w>aufheben</w>, der unter den Tisch gefallen ist?"
                        },
                        {
                            "text": "Sie bückte sich schnell und <w>hob</w> das Geldstück <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "aufsammeln",
                        "auflesen",
                        "hochheben",
                        "aufnehmen"
                    ],
                    "common_phrases": [
                        "vom Boden aufheben"
                    ]
                },
                {
                    "sense_id": "66071ec0-5a47-39ee-b933-29933a43073b",
                    "sense_definition": "Etwas für eine spätere Verwendung verwahren und nicht wegwerfen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aufbewahren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diesen Beleg solltest du dir unbedingt für eventuelle Reklamationen <w>aufheben</w>."
                        },
                        {
                            "text": "Ein Brötchen habe ich schon gegessen und das andere <w>hebe</w> ich mir für den Abend <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "aufbewahren"
                    ],
                    "common_phrases": [
                        "für später aufheben"
                    ]
                },
                {
                    "sense_id": "222fac6f-2cf3-3bec-b430-06bd5735187c",
                    "sense_definition": "Ein Verbot, eine Beschränkung oder eine gesetzliche Regelung offiziell für ungültig erklären.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abschaffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Regierung hat das strenge Verbot nach langen Debatten wieder <w>aufgehoben</w>."
                        },
                        {
                            "text": "Wegen der verbesserten Wetterlage wurde der Ausnahmezustand am frühen Morgen <w>aufgehoben</w>."
                        }
                    ],
                    "synonyms": [
                        "abschaffen"
                    ],
                    "common_phrases": [
                        "ein Verbot aufheben",
                        "die Sanktionen aufheben"
                    ]
                },
                {
                    "sense_id": "269fbb1d-6ab1-388e-82d4-f716219aa433",
                    "sense_definition": "In der Philosophie: einen Begriff oder Zustand beenden, zugleich in seinem Wert bewahren und auf eine höhere Stufe heben.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dialektik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In seiner Theorie versuchte der Philosoph, den bestehenden Widerspruch dialektisch <w>aufzuheben</w>."
                        },
                        {
                            "text": "Der ursprüngliche Begriff wird nicht einfach vernichtet, sondern in der Synthese sinnvoll <w>aufgehoben</w>."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12f037d6-6cb1-3a5e-b17b-9de7401c06dd",
                    "sense_definition": "Substantivierung von <w>aufheben</w>, gebraucht im Sinne von übertriebenem Wirbel, Aufwand oder Umständen um etwas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "umstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Man sollte um diesen kleinen Fehler wirklich nicht so viel <w>Aufheben</w> machen."
                        },
                        {
                            "text": "Ganz ohne großes <w>Aufhebens</w> packte sie ihre Koffer und verließ den Raum."
                        }
                    ],
                    "common_phrases": [
                        "viel Aufhebens machen"
                    ]
                }
            ]
        }
    ]
}