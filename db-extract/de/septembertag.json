                ],
                "senses": [
                    {
                        "sense_id": "18a7860a-aecd-3a88-8f8a-b0dbe85c6225",
                        "entry_id": "12c7fa05-0410-33ea-bda4-acc963f9aa49",
                        "glosses": [
                            "Tag im September"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff037380-df83-4e2a-978a-42b75791f9c4",
                                "sense_id": "18a7860a-aecd-3a88-8f8a-b0dbe85c6225",
                                "text": "Milena kam an einem Septembertag."
                            },
                            {
                                "example_id": "49bc6a63-4935-4fd2-8fba-ea03e470e4fb",
                                "sense_id": "18a7860a-aecd-3a88-8f8a-b0dbe85c6225",
                                "text": "„So verbrachte ich erholsame Septembertage in der wunderschönen Stadt und ließ die exotisch ukrainische Mentalität auf mich wirken.“"
                            },
                            {
                                "example_id": "f3a10e74-8db1-4560-89af-2e86a568fc53",
                                "sense_id": "18a7860a-aecd-3a88-8f8a-b0dbe85c6225",
                                "text": "„Mit Bedacht übrigens haben wir Claudia an diesem Septembertag getauft und ihr denselben Spruch mitgegeben.“"
                            },
                            {
                                "example_id": "658c22aa-eb8b-47e7-87cc-173b06a4c0b3",
                                "sense_id": "18a7860a-aecd-3a88-8f8a-b0dbe85c6225",
                                "text": "„Im Hauptquartier angekommen, befahl er, ohne sich mit seinen Marschällen zu beraten, den Angriff auf die Schewardino-Schanze, nicht morgen, nicht übermorgen, sondern auf der Stelle in der Abenddämmerung eines trüben Septembertages.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
