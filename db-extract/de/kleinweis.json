                            {
                                "example_id": "9bdd1760-b222-4104-9d7e-e9b7fa551c16",
                                "sense_id": "d31a955e-4e34-377e-8814-6483512473f5",
                                "text": "Wenn die Butter mit den Eiern schaumig verquirlt ist, rührt sie kleinweis das Mehl unter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ede9f1c5-5c27-4f21-9c4f-03257ed9ccab",
                        "source_entry_id": "6e417c69-4e5b-3a17-87f6-790403b2df6a",
                        "source_sense_id": "d31a955e-4e34-377e-8814-6483512473f5",
                        "source_sense_description": "bairisch, umgangssprachlich: in kleinen Schritten, Stufen, Mengen und Ähnlichem",
                        "target_lang_word": "little by little",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "little by little",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                        "entry_id": "e26f6f72-a2d5-3d57-8be2-0da540b66c9d",
                                        "glosses": [
                                            "A small amount at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf96de4-5e0e-4d44-84f8-218a580455b2",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "\"[…]Everything else has gone from me, little by little, but I have kept this.[…]\""
                                            },
                                            {
                                                "example_id": "e5efcccc-ac06-432b-a08f-fb8d2d846ea8",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Little by little his head cleared, and he began once more to take a personal interest in the battle."
                                            },
                                            {
                                                "example_id": "7b7dcc75-b754-4bad-97d0-4179f46a50b7",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Cos little by little / We gave you everything / You ever dreamed of. / Little by little / The wheels of your life / Have slowly fallen off."
                                            },
                                            {
                                                "example_id": "9d0f0796-1320-498e-b021-11c36c91b5c0",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Iraq's government has been removing blast walls little by little since late 2008, trying to restore a semblance of normalcy to this bunker city."
                                            },
                                            {
                                                "example_id": "d908bc45-7a7b-4565-b66f-9f296830913d",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "What came instead over the following years were many of the same projects delivered individually to little-by-little add capacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e47188a0-2a8a-4fb8-9783-92833f3c493c",
                        "source_entry_id": "6e417c69-4e5b-3a17-87f6-790403b2df6a",
                        "source_sense_id": "d31a955e-4e34-377e-8814-6483512473f5",
                        "source_sense_description": "bairisch, umgangssprachlich: in kleinen Schritten, Stufen, Mengen und Ähnlichem",
                        "target_lang_word": "petit à petit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit à petit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                        "entry_id": "9dfb7417-5f54-3ec1-afbe-3257e8440318",
                                        "glosses": [
                                            "En avançant lentement par petites étapes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b5f6e0-4e1c-4f91-ab19-369fca2c84e6",
                                                "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                                "text": "Leurs familles très nombreuses leur permirent, petit à petit, d'augmenter leur nombre, de telle sorte, que […], ils forment aujourd'hui, 200 ans après leur séparation de la mère patrie, un bloc de six millions de Français groupés principalement dans la province de Québec. Étonnante résurrection d'une nation qui a gagné la guerre des berceaux […]."
                                            },
                                            {
                                                "example_id": "211f5276-6e97-4299-9405-a17bba613461",
                                                "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                                "text": "[…], et, petit à petit, sans bien sûr interrompre leur feu qui cependant faiblissait, les fascistes ont pris la poudre d’escampette, et les derniers assez vite pour que l’envie de courir après ne nous prît pas."
                                            },
                                            {
                                                "example_id": "fe65b370-1607-4cfe-9375-a6a29148a756",
                                                "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                                "text": "La deuxième chaîne, inaugurée trois ans auparavant, ouvre le bal, elle est la première à abandonner le noir et blanc. Petit à petit, les Français vont s'équiper des téléviseurs ad hoc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
