                        "form_id": "0f93c8df-2f4e-4075-b93a-be2932713636",
                        "entry_id": "b267da8a-27f5-3a24-8df4-6816a62b692b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Leitungswasser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                        "entry_id": "b267da8a-27f5-3a24-8df4-6816a62b692b",
                        "glosses": [
                            "Wasser, das aus der Leitung kommt beziehungsweise dorthin eingeleitet wird und sich darin befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dfb5652-2efc-4517-956f-2a68836d9a79",
                                "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                                "text": "Sind die Leitungsrohre schlecht saniert, so kann man nicht nur mit einem Verlust von rund 30 Prozent an Leitungswasser rechnen, sondern auch mit dessen Verschmutzung durch das Eindringen von Bodensubstanzen in die Rohre."
                            },
                            {
                                "example_id": "e90cb5b5-fd66-4574-8eda-553b3d84e088",
                                "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                                "text": "„Bei akuten Verbrennungen ist das wichtigste Gegenmittel kaltes Leitungswasser.“"
                            },
                            {
                                "example_id": "9aebe32c-8e31-4201-a38a-35baff4b231c",
                                "sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                                "text": "„Im Harz ist das Leitungswasser eher weich, im Teutoburger Wald eher hart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fe709ee-ad0c-483e-81f0-e13ad7d5967d",
                        "source_entry_id": "b267da8a-27f5-3a24-8df4-6816a62b692b",
                        "source_sense_id": "53ed3b16-b45d-3ba5-9967-1ec702dd2402",
                        "source_sense_description": "Wasser aus/in der Leitung",
                        "target_lang_word": "tap water",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tap water",
