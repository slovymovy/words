                        ],
                        "form": "den Zulauf"
                    },
                    {
                        "form_id": "cf1babb1-93d9-4c52-a413-8798ddb9febe",
                        "entry_id": "549815e0-a37a-3961-bb72-523f193965d6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zuläufe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae9facc3-9aa3-38a6-a063-95fccb8d844f",
                        "entry_id": "549815e0-a37a-3961-bb72-523f193965d6",
                        "glosses": [
                            "Teilnahme von Personen aufgrund des (gemeinsamen) Interesses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eebcfbab-afef-4690-b34a-07a2407a212c",
                                "sense_id": "ae9facc3-9aa3-38a6-a063-95fccb8d844f",
                                "text": "„Der Zulauf vom Gymnasium beträgt etwa 20 Prozent - aus ganz unterschiedlichen Motiven.“"
                            },
                            {
                                "example_id": "c80591ea-559e-4ce2-b3e7-9ad3bd66dc84",
                                "sense_id": "ae9facc3-9aa3-38a6-a063-95fccb8d844f",
                                "text": "„Dort veranstaltete [Kleopha Lechner] Konzerte, welche wohl starken Zulauf hatten, da ergebnislose Beschwerden von Konkurrierenden [sic!] Kaffeehausbesitzern über ihre Lizenz belegt sind.“"
                            },
                            {
                                "example_id": "c8860bd7-3e33-407e-b58f-9867b6181717",
                                "sense_id": "ae9facc3-9aa3-38a6-a063-95fccb8d844f",
                                "text": "„Der Aufstand verbreitete sich wie ein Lauffeuer und erhielt nicht nur Zulauf von immer weiteren Einheiten der Armee, sondern auch von unzufriedenen Bauern und Grundherren Nordindiens, die unter einer besonders strengen Grundsteuerveranlagung litten.“"
                            },
                            {
                                "example_id": "36220c60-8df2-4352-ad66-f8074035bb14",
                                "sense_id": "ae9facc3-9aa3-38a6-a063-95fccb8d844f",
                                "text": "„Strauss hatte als eine Art Wanderprediger in den Tiroler Bergbaugebieten begonnen und dort so viel Zulauf gehabt, dass er ausgewiesen worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e523b84d-e6ad-38e0-affe-b90cabfac538",
                        "entry_id": "549815e0-a37a-3961-bb72-523f193965d6",
                        "glosses": [
                            "hinzugefügte oder -geflossene Flüssigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9fef272-561d-4d5a-b79e-83bea7a957d9",
                                "sense_id": "e523b84d-e6ad-38e0-affe-b90cabfac538",
                                "text": "„Wenn also am Heizkörper ein Verdunstungsröhrchen angebracht ist oder wenn beim Zulauf und Ablauf zur Wohnung der Volumenstrom (die Heizwassermenge) mit den Wassertemperaturen erfasst werden kann (sofern die Geräte richtig eingebaut wurden.“"
                            },
                            {
                                "example_id": "5402e4a4-7795-4f64-a095-64280a94f234",
                                "sense_id": "e523b84d-e6ad-38e0-affe-b90cabfac538",
                                "text": "„Allerdings dauert es 21 Jahre, bis das Wasser umgewälzt ist, denn der Starnberger See hat außer Schmelz- und Regenwasser keinen nennenswerten Zulauf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8bdd1eb1-31f3-365f-8259-6e77bd4d857e",
                        "entry_id": "549815e0-a37a-3961-bb72-523f193965d6",
                        "glosses": [
                            "Stelle der Zuführung oder des Zuflusses von Flüssigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347051e4-2884-4a9e-8208-070370cc5681",
                                "sense_id": "8bdd1eb1-31f3-365f-8259-6e77bd4d857e",
                                "text": "„Probenahmehähne für Wasserproben sind an folgenden Stellen der Wasseraufbereitungsanlage anzubringen: […] im Zulauf zum Reaktionsbehälter […]“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
