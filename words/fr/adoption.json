                {
                    "sense_id": "13cc45ce-9415-3ffa-a96b-b5899fca1710",
                    "sense_definition": "Action de choisir, d'admettre ou d'intégrer une habitude, une idée, une méthode ou un comportement nouveau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choix_pratique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>adoption</w> de nouvelles technologies a considérablement amélioré la productivité de l'entreprise."
