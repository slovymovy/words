                ],
                "senses": [
                    {
                        "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                        "entry_id": "6a5e5de1-d3d1-3920-9617-f93672644e18",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2676feb3-3f46-4e9f-b0a7-fd5d7e4658f1",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "Frau Knud ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "30e04eef-c73d-4d09-b537-10455a76b35e",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "Herr Knud wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "90401101-7b31-4745-8486-2e4e901fedc5",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "Die Knuds kommen heute vom Neusiedler See."
                            },
                            {
                                "example_id": "a1febe48-5212-4a19-bee3-fcdc8375c8a9",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "Der Knud trägt nie die Schals, die die Knud ihm strickt."
                            },
                            {
                                "example_id": "55734c8c-0c08-4b68-a2f0-24d542aa0293",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knud kommt, geht der Herr Knud.“"
                            },
                            {
                                "example_id": "98b2423e-fee3-4712-8fc5-ebc9253e679d",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "Knud kommt und geht."
                            },
                            {
                                "example_id": "52fe3f2c-868b-4c23-a000-68ed0f4f952c",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "Knuds kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d77a637f-87ee-4b87-9254-c443973aafa5",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "An verregneten Herbsttagen ist Familie Knuds liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "e2c6bb30-805a-4e56-b2e9-67f03259574a",
                                "sense_id": "49a16940-5366-3102-9eed-e92889c006dd",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Knud das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
