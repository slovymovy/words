                "senses": [
                    {
                        "sense_id": "f7626802-ca49-3075-8155-7f6961e49d07",
                        "entry_id": "91509eb3-12ef-3b2a-bbf3-cea505a8ece5",
                        "glosses": [
                            "bis zu 70 cm langer Karpfenfisch, der in Seen und sehr langsam fließenden Flüssen in Europa und Teilen Asiens lebt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "4f414df3-03e7-483a-b486-81e387034c48",
                                "sense_id": "f7626802-ca49-3075-8155-7f6961e49d07",
                                "text": "„Der Brachsen oder Blei hat einen hohen, seitlich stark zusammengepreßten Rumpf mit besonders vor der Rückenflosse stark gewölbtem Rückenprofil. Der Mund ist nahezu endständig, d. h. halb unterständig und wird nur wenig von der stumpfen Nase überragt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
