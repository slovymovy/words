                "senses": [
                    {
                        "sense_id": "8f1fc02f-3dec-3e41-8509-64d9b7bf1640",
                        "entry_id": "f96fb901-409c-3fca-a141-6b9d53223973",
                        "glosses": [
                            "Susceptible d’être attaqué physiquement."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "41e46656-8d4c-4faf-8e07-6e076ab3222f",
                                "sense_id": "8f1fc02f-3dec-3e41-8509-64d9b7bf1640",
                                "text": "Le dessus estoit couvert de peau de veau, ou de chevreul, ou d’autre telle façon de beste : tout le tour avoit un cercle de fer pour estre moins offensable."
                            },
                            {
                                "example_id": "e1fbd0ef-041f-4331-a76e-bbc6e2aa3669",
                                "sense_id": "8f1fc02f-3dec-3e41-8509-64d9b7bf1640",
                                "text": "… mais l’estomach en a deux [taies] pour trois utilités: à fin que son action soit meilleure & plus affectueuse, à fin qu’il soit moins offensable & à fin qu’il soit plus dense, & espois."
                            }
                        ]
                    },
                    {
                        "sense_id": "efe7e846-3272-3ee3-8888-4b0c71300344",
                        "entry_id": "f96fb901-409c-3fca-a141-6b9d53223973",
                        "glosses": [
                            "Susceptible d’être offensé moralement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41003843-1aba-4fd2-a795-5c224e147f24",
                                "sense_id": "efe7e846-3272-3ee3-8888-4b0c71300344",
                                "text": "Quant à votre deuxième argument, au sujet de la dualité du mal et du bien, qui règne sur terre, vous devez sentir que l’homme n’est nullement responsable devant Dieu, ce qui serait supposer Dieu offensable et susceptible de vengeance."
                            },
                            {
                                "example_id": "f34419b6-4caf-4ed7-b13d-0077ee24047c",
                                "sense_id": "efe7e846-3272-3ee3-8888-4b0c71300344",
                                "text": "Il s’agit de mon fils, et c’est dans mon fils que je me sens atteint. Quant à moi, je ne suis pas offensé, ni offensable."
                            },
                            {
                                "example_id": "22ae10a0-3a96-4374-af8e-192f02a9b4b5",
                                "sense_id": "efe7e846-3272-3ee3-8888-4b0c71300344",
                                "text": "J’ai vu un chat — l’amour-propre du chat est très offensable et très sensible au rire humain —, j’ai vu un chat être objet de rire parce qu’il avait manqué une mouche sur laquelle il sautait à la vitre."
                            }
                        ]
                    }
