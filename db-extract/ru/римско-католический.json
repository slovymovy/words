                        "translation_id": "80f99658-d30c-44c0-9120-638661be0801",
                        "source_entry_id": "c0199917-a1ac-3ecf-a9e3-1f4c5b6349b5",
                        "source_sense_id": "b26b6763-4c84-34e8-adde-3e1291c71ddc",
                        "target_lang_word": "römisch-katholisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "römisch-katholisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7026c32-e06e-3f38-bdeb-8f2d9e6b5aed",
                                        "entry_id": "ceb9ecdb-9f6a-3c49-98ff-46d7b629e0b6",
                                        "glosses": [
                                            "katholisch im Sinne der größten Kirche des Christentums; die römisch-katholische Kirche betreffend oder ihr angehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "263b6fe5-13ac-45c9-b198-e55715be2541",
                                                "sense_id": "d7026c32-e06e-3f38-bdeb-8f2d9e6b5aed",
                                                "text": "„Das sehe man auch daran, dass Vizepräsident Joe Biden und Vize-Präsidentschaftskandidat Paul Ryan römisch-katholisch wären.“"
                                            },
                                            {
                                                "example_id": "a9787a66-8ce2-49aa-9d0e-113bfeaa5723",
                                                "sense_id": "d7026c32-e06e-3f38-bdeb-8f2d9e6b5aed",
                                                "text": "„Beispiel: Der Ehemann ist römisch-katholisch, seine Ehefrau evangelischen Glaubens.“"
                                            },
                                            {
                                                "example_id": "973ad13d-f919-4f28-91da-ed1c487eaf08",
                                                "sense_id": "d7026c32-e06e-3f38-bdeb-8f2d9e6b5aed",
                                                "text": "„Bereits im Dreißigjährigen Krieg wurde die Familie Sickingen wieder römisch-katholisch.“"
                                            },
                                            {
                                                "example_id": "e6ca059b-31ca-442d-8bef-7de8e3fcc8da",
                                                "sense_id": "d7026c32-e06e-3f38-bdeb-8f2d9e6b5aed",
                                                "text": "„›Die lutherische Kirche‹, sagt Röder, ›ist ja auch katholisch – im Sinne von weltumspannend, aber nicht römisch-katholisch.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
