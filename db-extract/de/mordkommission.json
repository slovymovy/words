                ],
                "senses": [
                    {
                        "sense_id": "d80b429a-de60-3441-b034-ef5b24f406d7",
                        "entry_id": "e7e27343-9035-3875-8f0d-9c41965a526b",
                        "glosses": [
                            "Einheit der Kriminalpolizei, die sich mit der Aufklärung von Mordfällen befasst"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c6cea7a6-d576-4ca4-9a85-601875cd75db",
                                "sense_id": "d80b429a-de60-3441-b034-ef5b24f406d7",
                                "text": "Die Mordkommission gibt am Freitag eine Pressekonferenz zum aktuellen Fall."
                            },
                            {
                                "example_id": "a7682a09-4a29-4e00-9666-7f5bdf29f0d1",
                                "sense_id": "d80b429a-de60-3441-b034-ef5b24f406d7",
                                "text": "„Die Kriminalpolizei wurde alarmiert, die Mordkommission entsandte Beamte an die Unglücksstelle.“"
                            },
                            {
                                "example_id": "a4fe447f-a6db-4f7d-a6df-1d9a7eb60577",
                                "sense_id": "d80b429a-de60-3441-b034-ef5b24f406d7",
                                "text": "„Der Leichenwäscher, der nach den Herren der Mordkommission antrat, seines Amtes zu walten, ahnte nicht, daß er einen Kunden versorgte, der ans Ziel seiner kindlichen Sehnsüchte gelangt war; ausgedehnt hatten sich die kurzen Minuten des Glücks auf eine ganze unendliche Ewigkeit.“"
                            },
                            {
                                "example_id": "0c9acead-65f1-4950-979f-9db57ce0d055",
                                "sense_id": "d80b429a-de60-3441-b034-ef5b24f406d7",
                                "text": "„Nach dem Fund eines toten 57-Jährigen in einer Autowerkstatt in Breckerfeld ermittelt eine Mordkommission.“"
                            },
                            {
                                "example_id": "0f47154f-3819-4149-b2ac-83fb07172cbe",
                                "sense_id": "d80b429a-de60-3441-b034-ef5b24f406d7",
                                "text": "„In den folgenden Tagen überprüften die Ermittler der Itzehoer Mordkommission die Angaben und stießen auf diverse Ungereimtheiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
