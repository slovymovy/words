                "senses": [
                    {
                        "sense_id": "f8c47f01-862f-3630-a0d2-94a9079a6fdf",
                        "entry_id": "b4b65469-f495-33df-bf1e-1de21d8b87f8",
                        "glosses": [
                            "Bettdecke, die mit Daunen gefüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44cb8a9c-51d3-4805-bacd-4980520b3b5b",
                                "sense_id": "f8c47f01-862f-3630-a0d2-94a9079a6fdf",
                                "text": "„Erst nach Mitternacht findet sie erschöpft ins Daunenbett.“"
                            },
                            {
                                "example_id": "6ee9a86d-5c7e-4329-a2f3-be6bd03961da",
                                "sense_id": "f8c47f01-862f-3630-a0d2-94a9079a6fdf",
                                "text": "„Eine der Familien gab ihr vor dem Winteranbruch Daunenbetten, »leihweise natürlich«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
