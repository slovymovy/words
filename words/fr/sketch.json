            "senses": [
                {
                    "sense_id": "b19b0391-b025-3c38-92b6-3660c9e551b4",
                    "sense_definition": "Petite pièce comique de courte durée, généralement interprétée au théâtre, au cabaret ou à la télévision.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les comédiens ont présenté un nouveau <w>sketch</w> hilarant lors de l'émission télévisée d'hier soir."
                        },
                        {
                            "text": "Pour la fête de l'école, les élèves ont répété un petit <w>sketch</w> humoristique très réussi."
                        }
                    ],
                    "synonyms": [
                        "saynète",
                        "numéro"
                    ],
                    "common_phrases": [
                        "jouer un sketch",
                        "écrire un sketch"
                    ]
                },
                {
                    "sense_id": "3d0344ea-a979-3e91-9065-3e4d469bd6de",
                    "sense_definition": "Situation absurde, ridicule ou chaotique qui prête à rire ou à l'exaspération.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train a été annulé trois fois de suite sans explication, c'était un véritable <w>sketch</w>."
                        },
                        {
                            "text": "Leur dispute pour une simple place de stationnement a vite tourné au <w>sketch</w> devant les passants."
                        }
                    ],
                    "common_phrases": [
                        "c'est un sketch"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "a28380dc-2e98-3d31-9fff-36271233a5b3",
                    "sense_definition": "Personne ridicule, extravagante ou qui ne cesse de provoquer des situations grotesques.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de te donner en spectacle devant tout le monde, tu es vraiment un <w>sketch</w>."
                        },
                        {
                            "text": "Avec ses histoires improbables et ses maladresses continuelles, ce collègue est un vrai <w>sketch</w> ambulant."
                        }
                    ],
                    "common_phrases": [
                        "être un sketch"
                    ],
                    "traits": [
