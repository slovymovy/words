                    "frequency": "Middle",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire evening <w>brooding</w> over the mistakes he made at work."
                        },
                        {
                            "text": "It is not healthy to <w>brood</w> on past failures instead of looking toward the future."
