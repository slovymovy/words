                "senses": [
                    {
                        "sense_id": "6c9b0111-72e4-3ff5-9d3d-c8173b180812",
                        "entry_id": "d7338596-bf05-37a6-a455-cd330f0fd368",
                        "glosses": [
                            "Feier, die zu Ehren derjenigen stattfindet, die ihre Schulzeit erfolgreich beendet haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e42c46-bc78-4d8d-a731-295e4f7cfa55",
                                "sense_id": "6c9b0111-72e4-3ff5-9d3d-c8173b180812",
                                "text": "„In ihren neuen Schuhen, extra für die Schulabschlussfeier gekauft, wusste sie, dass sich ihr Leben grundlegend ändern würde.“"
                            },
                            {
                                "example_id": "2876eba7-dc20-41b2-87e1-f2d8e43c9288",
                                "sense_id": "6c9b0111-72e4-3ff5-9d3d-c8173b180812",
                                "text": "„Ich konnte mich nicht erinnern, dass Mama die Tasche benutzt hatte, wenn sie zu Hause war, nicht bei Schulabschlussfeiern oder bei Elternabenden, nicht im Gesundheitszentrum oder beim Einkaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
