                "senses": [
                    {
                        "sense_id": "c261e134-3f3f-3ace-a1f0-9387af444373",
                        "entry_id": "d4aae642-41ad-3b05-8cf0-f9ff296dc6b0",
                        "glosses": [
                            "besonders kräftiger und alkoholreicher Wein, bei dessen Genuss Männer mit einem schwachen Herzen bei übermäßigem Genuss einen Schlaganfall zu befürchten haben und der deshalb die Frauen der Männer zu Witwen macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0074e121-bdde-4281-89cb-49d7a6706d70",
                                "sense_id": "c261e134-3f3f-3ace-a1f0-9387af444373",
                                "text": "„In Deutschland wurde der besonders kräftige und süße Wein als „Witwenwein“ oder „Witwenmacher“ bezeichnet, weil Männer mit schwachem Herzen bei übermäßigem Genuss einen Schlaganfall zu befürchten hatten und ihre Frauen zu Witwen machten.“"
                            },
                            {
                                "example_id": "1eb76ba4-7ba6-44e9-b0b4-2d596948e457",
                                "sense_id": "c261e134-3f3f-3ace-a1f0-9387af444373",
                                "text": "„Witwenwein heisst in der Schweiz ein starker Wein, weil er die Männer umbringt, die Frauen zu Witwen macht. Jeder Wein ist aber mehr oder minder Witwenwein.“"
                            },
                            {
                                "example_id": "55d3bb35-576e-4e14-abcd-a1f083d02857",
                                "sense_id": "c261e134-3f3f-3ace-a1f0-9387af444373",
                                "text": "„Das Gedicht liefert ein Paradox, indem die Brüder aufgerufen werden ihre Hände in Unschuld zu waschen und sich dann mit dem Witwenwein zu betrinken: Wascht das Blut von euren Händen in der Mondzisterne, füllt den Helm und hebt ihn.“"
                            },
                            {
                                "example_id": "31582fcd-7a3a-4599-8fd5-a3edcce15468",
                                "sense_id": "c261e134-3f3f-3ace-a1f0-9387af444373",
                                "text": "Dieser Kerner mit 13 Prozent Alkohol ist ein richtiger Witwenwein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
