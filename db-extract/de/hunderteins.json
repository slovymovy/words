                "senses": [
                    {
                        "sense_id": "bfa6c2c7-3e52-31a9-adf9-5d7927011c6a",
                        "entry_id": "9f9f2b96-202e-3896-92ce-29d59f98bc96",
                        "glosses": [
                            "die Kardinalzahl zwischen 100 und 102; hundert und eins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49bef433-e855-42b2-a537-50b2a3f18e5f",
                                "sense_id": "bfa6c2c7-3e52-31a9-adf9-5d7927011c6a",
                                "text": "„1863 waren zum Beispiel von hunderteins Adelsgütern im vergangenen Jahrhundert nur einundzwanzig in das Eigentum einer anderen adligen Familie übergewechselt.“"
                            },
                            {
                                "example_id": "0ecd36e6-aba9-45ff-853f-b24bca056642",
                                "sense_id": "bfa6c2c7-3e52-31a9-adf9-5d7927011c6a",
                                "text": "„Widersprüchlich beurteilt wurde die Tänzerin, Schauspielerin, Regisseurin und Fotografin Leni Riefenstahl […], geboren 1902 in Berlin, gestorben 2003 in der bayrischen Gemeinde Pöcking am Starnberger See im Alter von hunderteins Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
