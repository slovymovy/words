                            {
                                "example_id": "7b5a9784-cc25-4bd3-9f5f-5e41014dd419",
                                "sense_id": "dcab2a27-0a8b-3677-83b8-8a51afb5594d",
                                "text": "Hij was soms wel een beetje te assertief bij het agressieve af."
                            },
                            {
                                "example_id": "3dc2e508-9f8e-4b1e-acd9-7e78818fed11",
                                "sense_id": "dcab2a27-0a8b-3677-83b8-8a51afb5594d",
                                "text": "De Chantal die zij enkele maanden geleden had ontmoet, zou nooit zo assertief hebben gereageerd."
                            }
                        ]
                    }
                ],
                "translations": [
