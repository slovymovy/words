                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c97054-c9a0-41fa-a715-16862d305f4b",
                                "sense_id": "4375458e-0a23-3d0f-90f4-3d70732464d4",
                                "text": "Een keurmeester stelt vast of een openbare ruimte goed bereikbaar is voor mensen met een handicap. Zo wordt gekeken of er een invalidentoilet is, een rolstoel door de entree kan en of er een lift beschikbaar is."
                            },
                            {
                                "example_id": "9c44e8af-114b-4b5a-a69d-394503e5613a",
                                "sense_id": "4375458e-0a23-3d0f-90f4-3d70732464d4",
                                "text": "Een van hen probeerde nog te vluchten, maar kon uiteindelijk van het invalidentoilet worden geplukt."
                            }
                        ]
                    }
