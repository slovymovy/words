                    {
                        "sense_id": "a1b46d5e-aec1-31dd-b451-289aada55b17",
                        "entry_id": "2ba376da-d052-3ebb-b3ef-810a6712f2ae",
                        "glosses": [
                            "więzień pełniący funkcję dozorcy w nazistowskich obozach koncentracyjnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c11c2fa4-0675-445e-a081-816c572323e7",
                                "sense_id": "a1b46d5e-aec1-31dd-b451-289aada55b17",
                                "text": "W Sachsenhausen zostałem po raz pierwszy pobity przez kapo, który był Francuzem"
                            },
                            {
                                "example_id": "0b87c85c-ac81-4899-a3e8-f371d4ec6b0e",
                                "sense_id": "a1b46d5e-aec1-31dd-b451-289aada55b17",
                                "text": "Poganiani przez esesmanów z psami i gorliwie pomagających im kapów, głodni i wycieńczeni ustawali w marszu odbywającym się przy 20-stopniowym mrozie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
