        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d2b565c7-9f8b-3636-8ff9-534edde3da4c",
                "word": "conjugal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f6e2b4e-a7e3-3d70-afc6-fbadb4c79314",
                        "entry_id": "d2b565c7-9f8b-3636-8ff9-534edde3da4c",
                        "glosses": [
                            "Of or relating to marriage, or the relationship of spouses; connubial."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c70aa2cf-4dfd-4cc0-b701-d9424b1aa85a",
                                "sense_id": "6f6e2b4e-a7e3-3d70-afc6-fbadb4c79314",
                                "text": "\"Lawgivers were never more mistaken,\" said Lady Mary, \"than when they ordained that the conjugal tie should last through life for better and worse; the last injunction being strictly complied with. There should be septennial marriages, as well as septennial parliaments!\""
                            }
                        ]
                    }
                ],
