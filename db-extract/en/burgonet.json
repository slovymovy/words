                        "entry_id": "81fd6f48-0f04-36bd-87ba-36af6c21e66c",
                        "glosses": [
                            "A light helmet worn by infantrymen, bearing a crest and hinged cheekpieces, but typically without a visor."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "15112ad6-530e-4ee1-8f50-0ae743e9ac7e",
                                "sense_id": "52fab49a-e65a-3825-9b68-d9d826fd9737",
                                "text": "He stroke so hugely with his borrowd blade, / That it empierst the Pagans burganet, / And cleauing the hard steele, did deepe inuade / Into his head […]"
                            }
                        ]
                    }
                ],
