                                        "sense_id": "5292faa0-0fda-3979-bd32-3e756f94454a",
                                        "entry_id": "42a3ba8d-a891-31f5-8128-a7d1e095d9bb",
                                        "glosses": [
                                            "gesetzlich geschützter Begriff für Produkte aus biologischer Landwirtschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ce92d4-5523-4575-826e-4b114cff57cb",
                                                "sense_id": "5292faa0-0fda-3979-bd32-3e756f94454a",
                                                "text": "In Europa sind die Begriffe öko/Öko/öko-/Öko- und bio/Bio/bio-/Bio- gesetzlich geschützt. Wer mit den Begriffen Werbung betreibt, muss sich an Auflagen halten."
                                            },
                                            {
                                                "example_id": "d1648cab-1955-45f1-bea2-c3163ca153d1",
                                                "sense_id": "5292faa0-0fda-3979-bd32-3e756f94454a",
                                                "text": "Produkte aus biologischer Landwirtschaft erhalten das Prädikat Bio."
                                            },
                                            {
                                                "example_id": "71ecd5ba-a476-4e95-a054-8dec2cdea65b",
                                                "sense_id": "5292faa0-0fda-3979-bd32-3e756f94454a",
                                                "text": "Natürlich kaufe ich Bio."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddad80cc-0cb3-3196-a879-6fd413110d67",
                                        "entry_id": "42a3ba8d-a891-31f5-8128-a7d1e095d9bb",
                                        "glosses": [
                                            "Biologie"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb3d0422-5895-41f1-b2a9-8a6c2b346a43",
                                                "sense_id": "ddad80cc-0cb3-3196-a879-6fd413110d67",
                                                "text": "Bio wird den Naturwissenschaften zugeordnet."
                                            },
                                            {
                                                "example_id": "4c528f20-ee18-49a5-a7c6-982e5c693c69",
                                                "sense_id": "ddad80cc-0cb3-3196-a879-6fd413110d67",
                                                "text": "Ich hab die Hausaufgaben für Bio vergessen, kann ich mal gucken, was du geschrieben hast?"
                                            },
                                            {
                                                "example_id": "8f9987f0-8cc5-43eb-9411-822473ed4ef7",
                                                "sense_id": "ddad80cc-0cb3-3196-a879-6fd413110d67",
                                                "text": "„Der Mathematiklehrer, ein Deutscher, erklärte uns den Stundenplan: zwei Stunden Bio, zwei Stunden Englisch, zwei Stunden Geschichte, zwei Stunden Französisch und zum Abschluss eine Stunde Mathe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a497a1e4-004a-3aa1-8f0c-6383d9d3cf4a",
                                        "entry_id": "42a3ba8d-a891-31f5-8128-a7d1e095d9bb",
                                        "glosses": [
                                            "Biografie"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d4eed44-2cd6-4530-96a3-c27e155a277b",
                                                "sense_id": "a497a1e4-004a-3aa1-8f0c-6383d9d3cf4a",
                                                "text": "Die Details kannst du alle in seiner Bio nachlesen."
                                            },
                                            {
                                                "example_id": "1f39a031-293c-4705-a77b-0109ba696083",
                                                "sense_id": "a497a1e4-004a-3aa1-8f0c-6383d9d3cf4a",
                                                "text": "Noch so jemand, der seine Bio zu Lebzeiten selber schreibt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
