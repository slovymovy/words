                        "examples": [
                            {
                                "example_id": "fe616af1-3e5c-4469-8796-6676ad129a2d",
                                "sense_id": "c3f99215-4804-394a-988e-05ca9893a98f",
                                "text": "De avond van tevoren stippelde een van de vaders een route uit, die vaak niet over een vast bergpad, maar dwars over de bergen naar onze volgende bestemming, liep."
                            },
                            {
                                "example_id": "2dc7a00f-5901-445e-92b9-203367451222",
                                "sense_id": "c3f99215-4804-394a-988e-05ca9893a98f",
                                "text": "Het doet me denken aan de periode vóór hij er was, toen mijn dochter zijn leeftijd had en ik op doordeweekse ochtenden met haar naar de bibliotheek ging, of naar de dierentuin, of op de koffie bij andere moeders en vaders met kleine kinderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "25a3e92d-ca29-342e-8792-4e1c9d11c795",
                        "entry_id": "65da8a1b-a5d4-3152-8db8-1ce3461e04af",
