                    {
                        "sense_id": "18d1a6e0-e395-3aa5-820e-08764d40c4b4",
                        "entry_id": "cdeb1f71-5489-33c9-ba69-1860ff0a47ab",
                        "glosses": [
                            "A tool for clipping something."
                        ],
                        "tags": [
                            "plural",
