                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d16093-fbb4-41db-8186-62df558eb571",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Chruschtschow kommt und geht."
                                            },
                                            {
                                                "example_id": "46dbb994-13be-493e-8221-22cf09c2090c",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Chruschtschows kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "8d1ae699-d8e3-479a-927f-cbfc77a62624",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Nikita Sergejewitsch Chruschtschow war von 1953 bis 1964 Parteichef der KPdSU."
                                            },
                                            {
                                                "example_id": "0e483013-2ffd-4c97-aa46-ae12590bfb28",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Frau Chruschtschow ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "16908b99-9ba4-476b-a9ab-fcb3afefb947",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Herr Chruschtschow wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "cb5d6806-ba5b-4766-a615-ebdf274a2e57",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Die Chruschtschows fliegen heute nach New York."
                                            },
                                            {
                                                "example_id": "a0fd1f30-2fa2-44e5-8ddf-81b4ebdb9cb1",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Der Chruschtschow trägt nie die Pullover, die die Chruschtschow ihm strickt."
                                            },
                                            {
                                                "example_id": "6d09d0fe-6297-47cc-aeb7-42f026410d69",
                                                "sense_id": "85111838-f7da-31e3-abee-926cc0b967d3",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Chruschtschow kommt, geht der Herr Chruschtschow.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
