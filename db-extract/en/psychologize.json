                ],
                "senses": [
                    {
                        "sense_id": "05bb8a90-5cdb-3a0f-a109-87b8cc6fa048",
                        "entry_id": "9db31683-bccb-3eca-8ddc-05b7897733df",
                        "glosses": [
                            "To interpret or analyze in psychological terms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3452d0e-c9d7-4367-bb32-f2b4265bc241",
                                "sense_id": "05bb8a90-5cdb-3a0f-a109-87b8cc6fa048",
                                "text": "The absence of psychologizing, as in Jon Jost's thematically similar and equally haunting Last Chants for a Slow Dance (1977), liberates the imagination in relation to Benning's beautifully composed images, and this respect for the viewer's intelligence pays off in highly charged dividends."
                            },
                            {
                                "example_id": "2c379ad2-0d7c-4258-a167-c737ca4f87f4",
                                "sense_id": "05bb8a90-5cdb-3a0f-a109-87b8cc6fa048",
                                "text": "Let it be clear, however, that we are not psychologizing here; rather we are presenting at most a characteriology of thought."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "797345e9-c7b2-4ffe-859b-639ef8f6fc73",
                        "source_entry_id": "9db31683-bccb-3eca-8ddc-05b7897733df",
                        "source_sense_id": "05bb8a90-5cdb-3a0f-a109-87b8cc6fa048",
                        "source_sense_description": "interpret or analyze in psychological terms",
                        "target_lang_word": "psychologiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "978d2d55-0a5d-3532-bf17-b2b330c92a81",
                                        "entry_id": "040dca0a-ba43-3359-87d4-8e1c9b41551c",
                                        "glosses": [
                                            "Considérer d’un point de vue purement psychologique."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6400ff8-aba4-4d3e-9b22-4758d2557c31",
                                                "sense_id": "978d2d55-0a5d-3532-bf17-b2b330c92a81",
                                                "text": "On se sent toujours coupable de ne pas en faire assez, on individualise les tensions et on psychologise les problèmes et les conflits."
                                            },
                                            {
                                                "example_id": "fc858eb7-d89d-4a9e-9940-daf91af37005",
                                                "sense_id": "978d2d55-0a5d-3532-bf17-b2b330c92a81",
                                                "text": "Outre ces critiques émanant des milieux psychanalytiques et scientifiques, Jung doit faire face à des attaques tout aussi virulentes de la part de croyants et de théologiens qui, choqués par ses thèses sur la religion, l'accusent de la réduire en la « psychologisant »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5119201d-5e97-3c3a-9e3f-4bfe8ea0b4d6",
                                        "entry_id": "040dca0a-ba43-3359-87d4-8e1c9b41551c",
                                        "glosses": [
                                            "S'adonner à une réflexion psychologique."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4c58f2-ed13-407e-9aaf-8bc12de4a5cb",
                                                "sense_id": "5119201d-5e97-3c3a-9e3f-4bfe8ea0b4d6",
                                                "text": "Nous [les poètes] avons psychologisé comme les fous, qui augmentent leur folie en s’efforçant de la comprendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
