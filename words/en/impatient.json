{
    "word_family": [
        "patience",
        "patient",
        "impatiently",
        "impatience"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed0c8182-51ff-3430-9314-694ec9901c66",
                    "sense_definition": "Restless, short of temper, and intolerant of delays.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>impatient</w> driver started honking his horn as soon as the light turned green.",
                            "target_lang_translations": {
                                "ru": "<w>Нетерпеливый</w> водитель начал сигналить, как только загорелся зеленый свет."
                            }
                        },
                        {
                            "text": "She becomes <w>impatient</w> with people who do not follow instructions correctly.",
                            "target_lang_translations": {
                                "ru": "Она становится <w>нетерпеливой</w> по отношению к людям, которые неправильно следуют инструкциям."
                            }
                        }
                    ],
                    "synonyms": [
                        "restless",
                        "irritable",
                        "fidgety"
                    ],
                    "antonyms": [
                        "patient",
                        "calm",
                        "tolerant"
                    ],
                    "common_phrases": [
                        "grow impatient",
                        "impatient driver",
                        "impatient with delays"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспокойный, вспыльчивый и не терпящий задержек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нетерпеливый",
                                "target_lang_sense_clarification": "о человеке, не любящем ждать"
                            },
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "легко выходящий из себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5487c45e-0ceb-353e-acea-970fbbd0a3e3",
                    "sense_definition": "Anxious and eager, especially to begin or have something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eagerness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were <w>impatient</w> to open their presents on Christmas morning.",
                            "target_lang_translations": {
                                "ru": "Детям <w>не терпелось</w> открыть подарки рождественским утром."
                            }
                        },
                        {
                            "text": "He was <w>impatient</w> for the meeting to start so he could share his ideas.",
                            "target_lang_translations": {
                                "ru": "Он <w>с нетерпением ждал</w> начала встречи, чтобы поделиться своими идеями."
                            }
                        }
                    ],
                    "synonyms": [
                        "eager",
                        "anxious",
                        "keen"
                    ],
                    "antonyms": [
                        "indifferent",
                        "unenthusiastic"
                    ],
                    "common_phrases": [
                        "impatient to start",
                        "impatient for news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тревожный и страстно желающий чего-либо, особенно начать что-то или получить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нетерпеливый",
                                "target_lang_sense_clarification": "сгорающий от желания"
                            },
                            {
                                "target_lang_word": "жаждущий",
                                "target_lang_sense_clarification": "сильно желающий чего-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36ec5db0-7d7c-35c5-9660-0de1e232acd8",
                    "sense_definition": "Prompted by, or exhibiting, impatience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavioral_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave an <w>impatient</w> gesture to indicate that the meeting should move faster.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>нетерпеливый</w> жест, показывая, что собрание должно идти быстрее."
                            }
                        },
                        {
                            "text": "She gave several <w>impatient</w> answers to the reporter's repetitive questions.",
                            "target_lang_translations": {
                                "ru": "Она дала несколько <w>резких</w> ответов на повторяющиеся вопросы репортера."
                            }
                        }
                    ],
                    "synonyms": [
                        "abrupt",
                        "curt",
                        "hasty"
                    ],
                    "common_phrases": [
                        "impatient gesture",
                        "impatient answers",
                        "impatient sigh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызванный нетерпением или выражающий его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нетерпеливый",
                                "target_lang_sense_clarification": "о жесте, вздохе или ответе"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о манере поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "670a36f2-95a1-3db0-b6fa-583ee6b781ff",
                    "sense_definition": "Not to be borne; unendurable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unbearable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was <w>impatient</w> of the pain caused by his deep wounds.",
                            "target_lang_translations": {
                                "ru": "Рыцарь <w>не мог выносить</w> боли от своих глубоких ран."
                            }
                        },
                        {
                            "text": "He found the heat of the desert <w>impatient</w> and sought shade immediately.",
                            "target_lang_translations": {
                                "ru": "Жара в пустыне показалась ему <w>невыносимой</w>, и он немедленно поискал тень."
                            }
                        }
                    ],
                    "synonyms": [
                        "unbearable",
                        "intolerable",
                        "unendurable"
                    ],
                    "antonyms": [
                        "bearable",
                        "tolerable"
                    ],
                    "common_phrases": [
                        "impatient of pain"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Невыносимый; такой, который невозможно терпеть (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невыносимый",
                                "target_lang_sense_clarification": "о боли или условиях"
                            },
                            {
                                "target_lang_word": "нестерпимый",
                                "target_lang_sense_clarification": "очень сильный, не поддающийся терпению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}