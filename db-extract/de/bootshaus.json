                ],
                "senses": [
                    {
                        "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                        "entry_id": "8474a4d4-6b2c-3311-a24b-ec2184efcfdc",
                        "glosses": [
                            "für die Lagerung von Wasserfahrzeugen bestimmtes Gebäude auf dem Land"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "ce31c4f5-eef3-4ca7-b36b-7b7e156a50a2",
                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                "text": "Die Kanus lagern im Bootshaus."
                            },
                            {
                                "example_id": "a62bb88b-ed16-4e49-a494-cea352eafe27",
                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                "text": "„Sie hörte lautes Gerede von ein paar Fischern drüben bei den Bootshäusern, und als sie stehen blieb, hörte sie auch, wie die Enten und Eiderenten an der Mündung des Flüsschens erwachten.“"
                            },
                            {
                                "example_id": "3a55f88c-b0e3-44e8-a88b-e8ad80ab0b6a",
                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                "text": "„Wir deuten auf einige flache, nahezu zehn Meter lange Boote, die seitlich des Bootshauses befestigt sind.“"
                            },
                            {
                                "example_id": "8bb6e43b-cca4-4bde-8231-b6446d0b0f5f",
                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                "text": "„Ich saß da, die Einkaufstüten zwischen den Beinen, und lehnte den Kopf ans Fenster, schaute hinaus auf den Fjord und die Bootshäuser am Straßenrand, alte Häuser, in denen niemand mehr wohnte, Flüsse, die aus den umliegenden Tälern kamen.“"
                            },
                            {
                                "example_id": "094a314f-b56d-441f-acdd-f8b5842803e6",
                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                "text": "„Das Himmelsgewölbe wusste von der Helligkeit und dem Gesang der Heidevögel, als die drei fjordauswärts zu dem Bootshaus fuhren, bei dem die Bauern von Oddi jahrhundertelang ihre Boote zu Wasser gelassen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                        "entry_id": "8474a4d4-6b2c-3311-a24b-ec2184efcfdc",
                        "glosses": [
                            "Clubhaus der Wassersportvereine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb650c6e-0ff4-401d-8bc7-45e1253bef68",
                                "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                                "text": "Im Bootshaus des Wassersportverein werden alle Versammlungen, Vereinsfeste und Treffen vorgenommen."
                            },
                            {
                                "example_id": "3f487327-a80f-499d-973e-556e6873f8ab",
                                "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                                "text": "„Das Bootshaus in Bad Honnef liegt direkt am Rhein und wird durch dieses Ambiente ganz wesentlich geprägt.“"
                            },
                            {
                                "example_id": "bc0e710a-8205-4bfe-ab93-ef9dc5a79960",
                                "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                                "text": "„Das Sportinstitut der TU Clausthal besitzt ein idyllisch gelegenes Bootshaus an der Okertalsperre (ca.12 km von Clausthal entfernt) mit zahlreichen Land- und Wasserliegeplätzen für Segelboote und Surfbretter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
