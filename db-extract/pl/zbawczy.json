                                                "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                                                "text": "The collapse of Enron wiped out the life savings of many people, leaving them poor in their retirement."
                                            },
                                            {
                                                "example_id": "e5d63d74-95fb-4790-a111-b2df715ccc5e",
                                                "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                                                "text": "“Rather than writing off both jets as a loss … teams made a bold decision in 2022 to remove the nose from AF-27 and put it onto AF-211 to maximize savings and add back an operational aircraft to the fleet,” a report from the F-35 JPO said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae1ba96-eeaa-33e9-bb09-9999977d66b4",
                                        "entry_id": "f9243693-6b1f-35d3-bbe3-c70447a90a00",
                                        "glosses": [
                                            "The action of the verb to save."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f225fe16-8b53-3ea2-b21a-aa15c75cf21c",
                                        "entry_id": "f9243693-6b1f-35d3-bbe3-c70447a90a00",
                                        "glosses": [
                                            "Exception; reservation."
                                        ],
                                        "tags": [
