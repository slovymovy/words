                ],
                "senses": [
                    {
                        "sense_id": "ad5086d2-d05b-3285-aafd-0a247e355572",
                        "entry_id": "d1d26cab-d9b2-3098-9f9a-951a3b292477",
                        "glosses": [
                            "A dense, yellowish fog, often mixed with smoke; a pea-soup fog, a smog."
                        ],
                        "tags": [
                            "British",
                            "Canada",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2b0e01ed-1b6b-48cf-a90b-308e5386c0ae",
                                "sense_id": "ad5086d2-d05b-3285-aafd-0a247e355572",
                                "text": "A man bumped into a lamp post during a pea-souper; he immediately apologised to it, not realising what it was."
                            },
                            {
                                "example_id": "5502c39a-bfe7-4112-a311-940ba3cb934e",
                                "sense_id": "ad5086d2-d05b-3285-aafd-0a247e355572",
                                "text": "I can hear the bell on the buoy, but I can’t see anything in this pea-souper."
                            },
                            {
                                "example_id": "f445e731-6af1-4799-9b41-f94f23ceb912",
                                "sense_id": "ad5086d2-d05b-3285-aafd-0a247e355572",
                                "text": "The dust surrounded us like a London pea-souper."
                            }
                        ]
                    },
                    {
                        "sense_id": "71f71638-b7bc-3e56-a380-7ab49efd01ee",
                        "entry_id": "d1d26cab-d9b2-3098-9f9a-951a3b292477",
                        "glosses": [
                            "A French-Canadian person, especially a Francophone from the province of Québec."
                        ],
                        "tags": [
                            "Canada",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f6039ecb-be59-4337-a9f0-82b44a5608d1",
                                "sense_id": "71f71638-b7bc-3e56-a380-7ab49efd01ee",
                                "text": "Those pea-soupers are the worst drivers on the road!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "779d5a25-0320-4d6e-beeb-bfe0a0ad538c",
                        "source_entry_id": "d1d26cab-d9b2-3098-9f9a-951a3b292477",
                        "source_sense_description": "dense, yellowish fog",
                        "target_lang_word": "purée de pois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purée de pois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69b76873-6bc1-3d13-bcfb-da2ab7aec650",
                                        "entry_id": "ec467ed9-07b3-3306-b9af-da22343bcb8e",
                                        "glosses": [
                                            "Brouillard dense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1e6854-9be1-4527-81ca-4d68bd359888",
                                                "sense_id": "69b76873-6bc1-3d13-bcfb-da2ab7aec650",
                                                "text": "Nous étions immobilisés dans une purée de pois, sur une mer assez dure, cassante, et toutes les trois minutes la sirène du bord meuglait lamentablement dans le brouillard, et d’autres sirènes, plus ou moins proches et de plus en plus nombreuses au fur et à mesure que l’après-midi s’écoulait, lui répondaient sur des tons allant du grave à l’aigu et avec des voix toutes également désorientantes, trompeuses."
                                            },
                                            {
                                                "example_id": "8cae04d3-dc19-4c74-a241-af64167010e8",
                                                "sense_id": "69b76873-6bc1-3d13-bcfb-da2ab7aec650",
                                                "text": "alors si les conditions atmosphériques nous gratifient un de ces jours d’une « purée de pois à couper au couteau » qui surviendrait en fin d’après-midi et régnerait des dizaines d’heures sur une grande partie de l’agglomération parisienne ?"
                                            },
                                            {
                                                "example_id": "b1aad208-c341-4c45-ae32-0b10f6f37ac4",
                                                "sense_id": "69b76873-6bc1-3d13-bcfb-da2ab7aec650",
                                                "text": "— Mais c’était quoi, cette purée de pois??\n— ’pas de la purée de pois… du cabillaud à l’ananas…"
                                            },
                                            {
                                                "example_id": "4fd9fbad-49f2-4583-992f-8e157d6eaf11",
                                                "sense_id": "69b76873-6bc1-3d13-bcfb-da2ab7aec650",
                                                "text": "En 1956 et 1962 furent votées des lois antipollution (Clean Air Acts) limitant la combustion du charbon et dissipant à jamais la légendaire purée de pois londonienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
