                                                "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                                                "text": "„Einer seiner Fluchtpunkte jener Jahre war Wismar.“"
                                            },
                                            {
                                                "example_id": "139d6024-f9ce-4764-9947-cd5bfd53981d",
                                                "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                                                "text": "„Bleibt als Fluchtpunkt die Auslandsexpansion, die vor allem Aldi und Lidl seit langem mit wechselndem Erfolg betreiben.“"
                                            },
                                            {
                                                "example_id": "89292767-3dce-42c0-bf69-fba6a3cd81e8",
                                                "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                                                "text": "Das ach so steuerehrliche Deutschland aber sei, so der Bericht, zum beliebten Fluchtpunkt von Schweizer Steuerbetrügern aufgestiegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
