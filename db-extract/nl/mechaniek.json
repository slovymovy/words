                    {
                        "sense_id": "59615d00-73ec-364c-b008-921bd222657d",
                        "entry_id": "0d96e2ef-d978-34a4-88f5-01ac7d502d6c",
                        "glosses": [
                            "mechanisme, samenstel van de delen waardoor iets in werking kan worden gebracht"
                        ],
                        "tags": [],
