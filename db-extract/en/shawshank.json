    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "489bad69-46bb-3f45-beb2-6ac1660c147f",
                "word": "Shawshank",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9e848a17-b1cc-4cd7-8ad2-b7c2c53cd04e",
                        "entry_id": "489bad69-46bb-3f45-beb2-6ac1660c147f",
                        "tags": [
                            "plural"
                        ],
                        "form": "Shawshanks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78766b30-bb47-3f9f-8bb1-f54da61ba1ea",
                        "entry_id": "489bad69-46bb-3f45-beb2-6ac1660c147f",
                        "glosses": [
                            "A literal or figurative prison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c6188f2-77e9-4726-bead-8fb9a88ea34e",
                                "sense_id": "78766b30-bb47-3f9f-8bb1-f54da61ba1ea",
                                "text": "Therefore, cat strollers are designed as rolling mini Shawshanks, keeping your kitty locked in, while you get the benefits of a walk."
                            },
                            {
                                "example_id": "6a597c5d-a3db-4d32-873d-cb265b5bc5fa",
                                "sense_id": "78766b30-bb47-3f9f-8bb1-f54da61ba1ea",
                                "text": "[…] the various walls men elect to live behind inside their own self-constructed Shawshanks, laboring under the debilitating belief that they have no other choice than to mirror the quiet desperation of their own experience (or their father's) by living in isolation."
                            },
                            {
                                "example_id": "c5dd5a66-ec51-439a-b113-b1289add5c2f",
                                "sense_id": "78766b30-bb47-3f9f-8bb1-f54da61ba1ea",
                                "text": "We all have our Shawshanks. Some of us have broken free."
                            },
                            {
                                "example_id": "dfe4aa97-09bb-4aaf-bacd-70001e8c6034",
                                "sense_id": "78766b30-bb47-3f9f-8bb1-f54da61ba1ea",
                                "text": "We are Harry Potter and William Wallace, the Na’vi and Han Solo. We’re escaping from Shawshank and blowing up the Death Star. We are fighting with the Harkonnens and challenging Thanos. Ukraine is hosting one of the great epics of this century."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                "word": "Shawshank",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b55a54e-2bd0-4ca9-8111-905844bd29ee",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "Shawshanks"
                    },
                    {
                        "form_id": "a56b5542-a52d-49ca-bbea-443299d20e15",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "Shawshanking"
                    },
                    {
                        "form_id": "32f321b8-f455-40c3-81da-134d5c6321f9",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "Shawshanked"
                    },
                    {
                        "form_id": "fbec9a6b-a548-48d7-b860-3c20d724a698",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "tags": [
                            "past"
                        ],
                        "form": "Shawshanked"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cd88224-b934-377f-8c11-a2d6d2311169",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "glosses": [
                            "To escape, especially by tunneling out or without warning."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9fda522-44cd-4e3d-82dc-ecedced62b3a",
                                "sense_id": "5cd88224-b934-377f-8c11-a2d6d2311169",
                                "text": "After endless Shawshanking through the ducts, I came to a grate that offered my first break from the horror show."
                            },
                            {
                                "example_id": "9520a996-76c8-4f47-9c7b-cc695e63a361",
                                "sense_id": "5cd88224-b934-377f-8c11-a2d6d2311169",
                                "text": "Kid up and disappears, Shawshanks like a fart in the wind."
                            },
                            {
                                "example_id": "a0fd78e4-de73-4407-987a-9b5ce7ab1197",
                                "sense_id": "5cd88224-b934-377f-8c11-a2d6d2311169",
                                "text": "It was like everything in him had been set free. Like the secret part of himself—the one he kept hidden and didn't let out so he could remain safe and intact—had Shawshanked itself and wasn't going to let it be captured again."
                            },
                            {
                                "example_id": "39cac2c9-f801-41d3-9f6c-c1caf135d730",
                                "sense_id": "5cd88224-b934-377f-8c11-a2d6d2311169",
                                "text": "'So your mind's made up?' Elaine said. 'You're Shawshanking out on us?'"
                            },
                            {
                                "example_id": "e9d0e5d2-d309-4746-8b25-c886159eb89f",
                                "sense_id": "5cd88224-b934-377f-8c11-a2d6d2311169",
                                "text": "And nothing to scrape with, so we're not Shawshanking our way out."
                            }
                        ]
                    },
                    {
                        "sense_id": "3df5209c-9bb1-39a8-bb9b-836ae63e82b9",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "glosses": [
                            "To punish (someone) for something that they did not do."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "409ed159-1e4b-4132-942e-37a4c0877dc5",
                                "sense_id": "3df5209c-9bb1-39a8-bb9b-836ae63e82b9",
                                "text": "Jim hadn't, but he did agree to give us more time before he Shawshanked me."
                            },
                            {
                                "example_id": "94d2c479-0c41-46e1-832c-db5d1bbe05f8",
                                "sense_id": "3df5209c-9bb1-39a8-bb9b-836ae63e82b9",
                                "text": "Sorry you got Shawshanked, but it doesn't change anything."
                            },
                            {
                                "example_id": "a39419dc-75bf-4dba-9689-4f58d85c0242",
                                "sense_id": "3df5209c-9bb1-39a8-bb9b-836ae63e82b9",
                                "text": "I could have been honest, said it was all a mistake and that I'd been shawshanked, but that hadn't won me any favors so far."
                            },
                            {
                                "example_id": "3fa93e68-6400-4c38-b55b-cf599be09e68",
                                "sense_id": "3df5209c-9bb1-39a8-bb9b-836ae63e82b9",
                                "text": "It's like going to prison with an innocent conscience: he Shawshanked me real hard; and it was up to me to dig my way out to freedom."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a2eb81c-ce75-32d7-a101-404c9a736d6c",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "glosses": [
                            "To accomplish something by doing a little bit at a time over a long period of time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb834b3-5512-45ea-bc40-01e642156187",
                                "sense_id": "7a2eb81c-ce75-32d7-a101-404c9a736d6c",
                                "text": "I had just given notice at work that I was taking a leave and I wanted to start \"Shawshanking\" things home"
                            },
                            {
                                "example_id": "e9e572ef-7d0e-49cd-b922-adf9d13bb43b",
                                "sense_id": "7a2eb81c-ce75-32d7-a101-404c9a736d6c",
                                "text": "Easy, I shawshaked you."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ae0ab51-2130-3b25-bcf1-8f65ed294a6e",
                        "entry_id": "cfffdfc7-9f4d-34cc-88fe-7231e23093b3",
                        "glosses": [
                            "To rape (a man, by a man) as an act of dominance and bullying."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6e4949-e053-4693-88ac-ee7ff37c2a91",
                                "sense_id": "6ae0ab51-2130-3b25-bcf1-8f65ed294a6e",
                                "text": "This isn't an act of love; he's basically getting Shawshanked by a long-necked bully."
                            }
                        ]
                    }
                ],
