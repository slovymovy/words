                                        "examples": [
                                            {
                                                "example_id": "07d8a57d-3119-4144-8e37-b8ed44f0971b",
                                                "sense_id": "e1c228f1-2f13-33d9-8403-e88bf6973c7f",
                                                "text": "Un front construit – les yeux veloutés de sa race – de trop grosses joues – et puis ce qui me dégoûte dans les garçons de cet âge : des boutons, les signes du sang en mouvement ; tout ce qui suppure ; surtout ces paumes moites qu'il essuyait avec un mouchoir, avant de vous serrer la main."
                                            },
                                            {
                                                "example_id": "3d6f051b-ee68-411e-b002-2a7d52f39a88",
                                                "sense_id": "e1c228f1-2f13-33d9-8403-e88bf6973c7f",
                                                "text": "Mais la déchirure avait déjà été effectuée, j’avais une moitié du cœur qui béait et l’autre en lambeaux : chaque élan vers le petit ne faisait que raviver les élancements de cette plaie qui suppurait encore."
                                            }
                                        ]
                                    }
