                "senses": [
                    {
                        "sense_id": "e1d33ea6-75f0-3eb7-a517-9407ed422c0d",
                        "entry_id": "15bd5ddf-d3fd-3292-8d46-3fc414c75d0b",
                        "glosses": [
                            "Embaucher moins que ce qui serait nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a591b54a-c887-47d2-921d-4ce2d7e8489b",
                                "sense_id": "e1d33ea6-75f0-3eb7-a517-9407ed422c0d",
                                "text": "Dans ces conditions, on comprend que les employeurs aient tendance à sous-embaucher."
                            },
                            {
                                "example_id": "dc8f561a-439e-4978-b02b-7b091566cd4c",
                                "sense_id": "e1d33ea6-75f0-3eb7-a517-9407ed422c0d",
                                "text": "Les commerçants sous-embauchent car nous sommes des sociétés de service qui n'existons que par la main d'oeuvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "f246255a-19c8-3255-a180-241f508a19b6",
                        "entry_id": "15bd5ddf-d3fd-3292-8d46-3fc414c75d0b",
                        "glosses": [
                            "Embaucher à un poste moins élevé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c9e4b8-9c32-47e0-b0ca-cd522236038e",
                                "sense_id": "f246255a-19c8-3255-a180-241f508a19b6",
                                "text": "Ils n'ont pas le droit de te sous-embaucher au retour d'un arrêt de travail, tu dois retrouver ton poste ou un poste équivalent et franchement le courrier, je doute que ce soit équivalent..."
                            }
                        ]
                    }
