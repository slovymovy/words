        "fr-extract.jsonl": [
            {
                "entry_id": "d187ed41-b7a0-3763-a142-a237388a1f23",
                "word": "shoplifting",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "13eb56a6-6b6e-3aeb-a6ca-e6a64d67beff",
                        "entry_id": "d187ed41-b7a0-3763-a142-a237388a1f23",
                        "glosses": [
                            "Vol dans un magasin durant ses heures d’ouverture, vol à l’étalage."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7a2ca329-133a-4dc3-886c-5495a0efc35e",
                                "sense_id": "13eb56a6-6b6e-3aeb-a6ca-e6a64d67beff",
                                "text": "Shoplifting is a crime.",
                                "translation": "Le vol à l’étalage est un délit."
                            },
                            {
                                "example_id": "5ede851d-d431-45c3-9647-3557e8ef1c42",
                                "sense_id": "13eb56a6-6b6e-3aeb-a6ca-e6a64d67beff",
                                "text": "Most shoplifters cannot succeed unless they get some privacy. This is why one of the best ways to stop shoplifting is to greet customers as soon as they walk in, then be attentive to them the rest of the time.",
                                "translation": "La plupart des voleurs à l’étalage ne peuvent réussir sans un peu d’intimité. C’est pourquoi l’un des meilleurs moyens d’enrayer le vol à l’étalage est de saluer les clients aussitôt qu’ils rentrent, et ensuite d’être attentif à eux le reste du temps."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
