                "senses": [
                    {
                        "sense_id": "fea462d9-b748-3c2f-8489-aee3a239b856",
                        "entry_id": "7920b9ae-c23d-3652-b7a4-3be09688d1c2",
                        "glosses": [
                            "operative Entfernung des Wurmfortsatzes des Blinddarms (appendix vormiformis) zur Behandlung der Appendizitis (umgangssprachlich Blinddarmentzündung); umgangssprachlich meist fälschlicherweise als Blinddarmentfernung bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a2169ef-ff5c-471b-bd0a-317ae4fec3cf",
                                "sense_id": "fea462d9-b748-3c2f-8489-aee3a239b856",
                                "text": "Nach wie vor ist die Appendektomie einer der häufigsten chirurgischen Eingriffe in Krankenhäusern jeglicher Versorgungsstufe."
                            },
                            {
                                "example_id": "e5e86bd0-9d79-4f60-9fd0-7e5022706d4c",
                                "sense_id": "fea462d9-b748-3c2f-8489-aee3a239b856",
                                "text": "Die laparoskopische Appendektomie wurde durch den deutschen Gynäkologen K. Semm zu Beginn der 1980er Jahre in die chirurgische Praxis eingeführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
