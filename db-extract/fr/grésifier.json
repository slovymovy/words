                "senses": [
                    {
                        "sense_id": "984bba29-4cfa-3fe8-91cd-a670ccf96fcf",
                        "entry_id": "5277e820-a921-318e-a67c-e2cc61be5f85",
                        "glosses": [
                            "Devenir du grès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01831b6e-67fc-475a-8b12-7e2fd35c131d",
                                "sense_id": "984bba29-4cfa-3fe8-91cd-a670ccf96fcf",
                                "text": "Elles n’existent donc que dans les zones climatiques où existent de pareils cycles, c’est-à-dire dans les mêmes régions où les sables dunaires et marins se grésifient."
                            },
                            {
                                "example_id": "8ad179a5-395d-4d9c-ade7-86d48af33e2b",
                                "sense_id": "984bba29-4cfa-3fe8-91cd-a670ccf96fcf",
                                "text": "Cette séquence n’existe pas dans tous les pays du globe ; par définition, cette suite de dépôts ne peut être mise en place que dans les zones climatiques où existent des cycles humidification/dessication permettant aux sables de se grésifier (29)."
                            }
                        ]
                    }
