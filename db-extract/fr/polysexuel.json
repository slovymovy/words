                "senses": [
                    {
                        "sense_id": "ba3975d9-5b91-3980-ab76-6aace03016ea",
                        "entry_id": "2144ac22-a4e5-3e34-a950-c01ec59c4d20",
                        "glosses": [
                            "Se dit d’une personne attirée sexuellement par des personnes de plusieurs genres."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66532e48-e574-4e96-9037-8180e4939706",
                        "source_entry_id": "2144ac22-a4e5-3e34-a950-c01ec59c4d20",
                        "source_sense_id": "ba3975d9-5b91-3980-ab76-6aace03016ea",
                        "target_lang_word": "polysexuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polysexuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb6b48e-8002-3a2c-9cb9-4a11a2a81220",
                                        "entry_id": "e43b26c9-0871-3207-b282-0c2039bd59b1",
                                        "glosses": [
                                            "eine sexuelle Orientierung auf Menschen verschiedener, aber nicht aller Geschlechter aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f3d9ae-2b94-4f7b-8a04-bcaba9f5f945",
                                                "sense_id": "fcb6b48e-8002-3a2c-9cb9-4a11a2a81220",
                                                "text": "„Polysexuelle Menschen hingegen fühlen sich zu mehreren, aber nicht allen, Geschlechtern hingezogen. Welche Geschlechter dies konkret sind, unterscheidet sich individuell.“"
                                            },
                                            {
                                                "example_id": "283908d4-42b6-4aed-b6ae-c50aabadb572",
                                                "sense_id": "fcb6b48e-8002-3a2c-9cb9-4a11a2a81220",
                                                "text": "„Polysexuelle Menschen wollen ihre emotionalen oder sexuellen Beziehungen nicht durch die eigene Geschlechtszuordnung und die der Partnerinnen oder Partner definieren.“"
                                            },
                                            {
                                                "example_id": "7d3d827f-b2f1-4f77-9ac2-a446854881d4",
                                                "sense_id": "fcb6b48e-8002-3a2c-9cb9-4a11a2a81220",
                                                "text": "„Gerade aufgrund der Überschneidungen zwischen dem Bild der ‚Neuen Frau‘ und den negativ besetzten Konstrukten des ‚Anderen‘ – im Spannungsfeld zwischen ‚Mannweib‘ und ‚polysexueller Nymphomanin‘ – sehen sich die Autorinnen fortwährend gezwungen, ihre Heldinnen dem unausgesprochenen Vorwurf der queerness zu entheben.“"
                                            },
                                            {
                                                "example_id": "66608a30-d468-4d56-8c82-36bdc7469964",
                                                "sense_id": "fcb6b48e-8002-3a2c-9cb9-4a11a2a81220",
                                                "text": "„Drag Kings, Drag Queens, Cross-Dressers, Tunten, intersexuelle, multisexuelle, polysexuelle, polyamoröse, transsexuelle und transgender Menschen fungieren als die Figuren der geschlechtlich sexuellen Uneindeutigkeit.“"
                                            },
                                            {
                                                "example_id": "73fd37d0-07f4-400c-8172-0ac40f86c1be",
                                                "sense_id": "fcb6b48e-8002-3a2c-9cb9-4a11a2a81220",
                                                "text": "„›In dem würde ich dich zu gern sehen!‹, sagte die polysexuelle Nana zu Moshe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68c9be70-6262-3c21-87a0-de97bc14374d",
                                        "entry_id": "e43b26c9-0871-3207-b282-0c2039bd59b1",
                                        "glosses": [
                                            "mehrere Sexualpartner habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d2f95d-91c7-4268-a1cf-8184a09bd560",
                                                "sense_id": "68c9be70-6262-3c21-87a0-de97bc14374d",
                                                "text": "„Entsprechend der Grundformen (zwischen-)menschlicher Beziehungen (s.o.) können einstellige sexuelle Beziehungen autosexuell, zweistellige sexuelle Beziehung monosexuell und mehrstellige sexuelle Beziehungen polysexuell genannt werden.“"
                                            },
                                            {
                                                "example_id": "1681a5ce-f092-4e10-a14f-1cfbc064e96c",
                                                "sense_id": "68c9be70-6262-3c21-87a0-de97bc14374d",
                                                "text": "„Das waren ihre Vorwürfe, meist mit allerlei Fachwissen aus ihrem Heidelberger Psychologiestudium im sechzehnten Semester angereichert; das wenigste davon verstand er. Schon gar nicht dieses Blabla der Generation Y von polysexuellen Partnerschaften und dem angeblich notwendigen Ausleben von Bedürfnissen, weil sie sich sonst zu sehr eingeengt fühle.“"
                                            },
                                            {
                                                "example_id": "6198cbe1-5b77-4019-b528-8af5ee0e6655",
                                                "sense_id": "68c9be70-6262-3c21-87a0-de97bc14374d",
                                                "text": "„Das neue moduläre, polysexuelle Verhalten ist da freilich keineswegs gegen Repression und Regression gefeit.“"
                                            },
                                            {
                                                "example_id": "19cb3575-20f2-4bf2-b11a-797ec65acaec",
                                                "sense_id": "68c9be70-6262-3c21-87a0-de97bc14374d",
                                                "text": "„Die Erzählungen unterschiedlichster Menschen in der psycho- oder sexualtherapeutischen Praxis belegen, dass es keineswegs weniger anstrengend wird Sexualität und/oder Beziehung mit nicht nur einem, sondern mehreren Menschen zu verhandeln. Seien es offene, polyamouröse oder polysexuelle Beziehungen.“"
                                            },
                                            {
                                                "example_id": "ec4a5f32-ab1b-4c08-bddf-cba5c0124940",
                                                "sense_id": "68c9be70-6262-3c21-87a0-de97bc14374d",
                                                "text": "„Schou (sic) seine moralische Charakteristik der ‚genialen‘, also polysexuellen Künstlerin hat eine breite Lücke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
