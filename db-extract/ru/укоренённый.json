                        "examples": [
                            {
                                "example_id": "85eca859-2241-4655-9437-77d8c68b932a",
                                "sense_id": "bb20a359-16b5-3bbe-91e0-be5af1aea744",
                                "text": "Пы́тка в старину́ так была́ укоренена́ в обы́чаях судопроизво́дства, что благоде́тельный ука́з, уничто́живший о́ную, до́лго остава́лся бе́зо вся́кого де́йствия.",
                                "translation": "The system of torture was so deeply rooted in the administration of justice in the olden time, that the humane ukase which abolished it, remained disregarded for a considerable time.",
                                "english": "The system of torture was so deeply rooted in the administration of justice in the olden time, that the humane ukase which abolished it, remained disregarded for a considerable time."
                            }
                        ]
