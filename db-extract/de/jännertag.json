                ],
                "senses": [
                    {
                        "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                        "entry_id": "cfe8ee68-6172-38f7-a509-fe0be6b1e559",
                        "glosses": [
                            "Tag im Jänner/Januar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eeb9725-56f3-4a2a-8515-fb7088e09efa",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„An einem Jännertag saß ich vor der Falkenhütte, als ein riesiger Heißluftballon über der Lalidererspitze auftauchte.“"
                            },
                            {
                                "example_id": "70c61a5e-0708-4cd6-b854-c851d5d281a1",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Es war ein ungewöhnlich warmer Jännertag und sie hatte nicht einmal einen dicken Mantel an.“"
                            },
                            {
                                "example_id": "6d70ddd7-7cfa-4bf7-a153-4374469f6ae5",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Wer heiratete denn bitte an einem Jännertag, der in Wien erwartungsgemäß bitterkalt war, wenn nicht ein besonderer Grund zur Eile mahnte?“"
                            },
                            {
                                "example_id": "c6115a53-f040-411a-ba7d-c4152dcf7c41",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Der Glaube, immer alles unter Kontrolle zu haben, wurde an diesem kalten Jännertag ad absurdum geführt.“"
                            },
                            {
                                "example_id": "fa98febf-5ea5-40af-bbf6-b9067a4c8d5a",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Ich wandere zu Fuß an einem kalten Jännertag von Spital am Pyhrn nach Windischgarsten.“"
                            },
                            {
                                "example_id": "5f5f4ad4-1ff7-494b-a650-ac14d3775227",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Wir waren Cowboys gewesen, an einem klirrend kalten, schneelosen Jännertag im Heuboden, gestern.“"
                            },
                            {
                                "example_id": "983b6916-60d3-47f8-ad60-cf3e2d547747",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Mit einem Fremdenführer durch das romantische Wien und aufs Standesamt Nichts wirkt romantisch an diesem Jännertag in der Stadt.“"
                            },
                            {
                                "example_id": "c73fa6ef-2b0b-4dc3-9730-01b05ea336dd",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Es war ein heller, klarer Jännertag, als sie durch schöne Felder, dann zwischen weißen Zäunen, glitzernden Bäumen durch der Glunggen zufuhren.“"
                            },
                            {
                                "example_id": "a67cd4b4-bbe4-4d3e-863a-8d6ee9feebcc",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Kalte, frostklirrende Jännertage, Raureif und Pulverschnee, und es waren Weihnachtsferien.“"
                            },
                            {
                                "example_id": "415020ee-d9cc-40ce-b9b7-b4d99480a353",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Was Otto während dieser Jännertage mit Heinrich verhandelte, ist niemals bekannt worden.“"
                            },
                            {
                                "example_id": "6f4305eb-649c-4517-ba72-e7778436071a",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„Es war zugleich einer der schönsten mildesten Jännertage, die Luft so rein, dass ich ohne Bewaffnung des Auges die Zahl von 14 Pyramiden zugleich erblickte.“"
                            },
                            {
                                "example_id": "7b221f91-547f-400f-b644-6528ea0e1682",
                                "sense_id": "69d49ec7-00f4-3fae-82ff-6d6d25be596b",
                                "text": "„An einem stürmischen Jännertage des Jahres 1363 überstiegen fünf Männer den Krimlertauern, um aus dem Salzburgischen nach Tirol zu gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
