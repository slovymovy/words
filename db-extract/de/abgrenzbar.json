                                        "glosses": [
                                            "Worthy of esteem; admirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "405a923f-8981-4134-b539-5be2b28e4a7e",
                                                "sense_id": "a0a18b0f-9e29-328f-b350-570c737bdc84",
                                                "text": "Mr. March told […]how devoted Brooke had been, and how he was altogether a most estimable and upright young man."
                                            },
                                            {
                                                "example_id": "c2f4eff4-e4c0-46d4-91a6-26c4d620234c",
                                                "sense_id": "a0a18b0f-9e29-328f-b350-570c737bdc84",
                                                "text": "Near-synonyms: esteemed, revered"
                                            },
                                            {
                                                "example_id": "8fc1ae8e-3a76-4d6e-8c6d-b718d4d56ea7",
                                                "sense_id": "a0a18b0f-9e29-328f-b350-570c737bdc84",
                                                "text": "[Homer] allows their characters such estimable qualities as could consist, and in truth generally do, with tender frailties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1eebb38-665e-3080-bebd-c06482ab5806",
                                        "entry_id": "006469b9-f865-3f4e-af5b-e1458dfeffda",
                                        "glosses": [
                                            "Valuable."
                                        ],
