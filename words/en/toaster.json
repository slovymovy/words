{
    "word_family": [
        "toast",
        "toasty",
        "toasted",
        "toasting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32780278-dce3-3b56-8172-437d7e43682c",
                    "sense_definition": "An electrical device for toasting food, typically sliced bread.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kitchen appliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I put two slices of bread into the <w>toaster</w> for breakfast.",
                            "target_lang_translations": {
                                "ru": "Я положил два ломтика хлеба в <w>тостер</w> на завтрак."
                            }
                        },
                        {
                            "text": "Be careful not to use a metal fork to get bread out of the <w>electric</w> <w>toaster</w>.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны и не используйте металлическую вилку, чтобы достать хлеб из <w>электрического</w> <w>тостера</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric toaster",
                        "pop-up toaster",
                        "toaster oven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрический прибор для поджаривания ломтиков хлеба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тостер",
                                "target_lang_sense_clarification": "кухонный прибор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b120f9a2-39e3-31c1-92b4-f5ef7bc6d264",
                    "sense_definition": "A disc jockey who accompanies reggae music with improvised rhythmic speech.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>toaster</w> energized the crowd with his rhythmic chanting over the heavy bass line.",
                            "target_lang_translations": {
                                "ru": "<w>Тостер</w> завел толпу своим ритмичным речитативом под мощный бас."
                            }
                        },
                        {
                            "text": "Many early dancehall records featured a talented <w>toaster</w> alongside the singer.",
                            "target_lang_translations": {
                                "ru": "На многих ранних записях в стиле дэнсхолл вместе с певцом выступал талантливый <w>тостер</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "deejay"
                    ],
                    "common_phrases": [
                        "reggae toaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Диджей в регги-музыке, сопровождающий ритм импровизированной речью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тостер",
                                "target_lang_sense_clarification": "исполнитель в стиле регги"
                            },
                            {
                                "target_lang_word": "диджей",
                                "target_lang_sense_clarification": "в контексте регги-культуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0ec4b76-1e3c-3b81-88e8-ad24ffb347b4",
                    "sense_definition": "One who toasts (engages in salute while drinking alcohol).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the primary <w>toaster</w> at the wedding, he raised his glass to the happy couple.",
                            "target_lang_translations": {
                                "ru": "Как главный <w>тостующий</w> на свадьбе, он поднял бокал за счастливую пару."
                            }
                        },
                        {
                            "text": "The host acted as the <w>toaster</w>, leading the guests in a series of celebratory drinks.",
                            "target_lang_translations": {
                                "ru": "Хозяин дома выступал в роли <w>провозглашающего тосты</w>, предлагая гостям выпить за праздник."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который произносит тост во время застолья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тостующий",
                                "target_lang_sense_clarification": "человек, произносящий тост"
                            },
                            {
                                "target_lang_word": "провозглашающий тост",
                                "target_lang_sense_clarification": "официальное или описательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf5d9390-deea-3462-b010-de7f26dbc5a9",
                    "sense_definition": "A low-end or outdated personal computer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot run this modern software on my old <w>toaster</w> of a computer.",
                            "target_lang_translations": {
                                "ru": "Я не могу запустить эту современную программу на своем старом компьютере-<w>тостере</w>."
                            }
                        },
                        {
                            "text": "He finally decided to upgrade after using that <w>slow</w> <w>toaster</w> for nearly a decade.",
                            "target_lang_translations": {
                                "ru": "Он наконец решил обновиться после того, как почти десять лет пользовался этим <w>медленным</w> <w>ведром</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "potato"
                    ],
                    "common_phrases": [
                        "slow toaster"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used to describe poor performance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, медленный или устаревший компьютер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тостер",
                                "target_lang_sense_clarification": "сленг: слабый компьютер"
                            },
                            {
                                "target_lang_word": "калькулятор",
                                "target_lang_sense_clarification": "сленг: очень медленный ПК"
                            },
                            {
                                "target_lang_word": "ведро",
                                "target_lang_sense_clarification": "сленг: старое железо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "490aaad6-6ca5-3b3b-b21a-642e6011b013",
                    "sense_definition": "A firearm, especially a pistol.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lyrics described a dangerous neighborhood where people carry a <w>toaster</w> for protection.",
                            "target_lang_translations": {
                                "ru": "В тексте песни описывался опасный район, где люди носят с собой <w>пушку</w> для защиты."
                            }
                        },
                        {
                            "text": "He was caught with a <w>toaster</w> tucked into his waistband during the police search.",
                            "target_lang_translations": {
                                "ru": "Во время полицейского обыска его поймали со <w>стволом</w>, заткнутым за пояс."
                            }
                        }
                    ],
                    "synonyms": [
                        "pistol",
                        "piece",
                        "heater"
                    ],
                    "common_phrases": [
                        "pop toasters"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in hip-hop culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огнестрельное оружие, обычно пистолет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушка",
                                "target_lang_sense_clarification": "сленг: пистолет"
                            },
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "сленг: оружие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}