                        "entry_id": "5c248e33-ba65-313f-a65f-fbcb5b236366",
                        "glosses": [
                            "rote italienische Rebsorte, die genetisch als identisch mit der Rebsorte Zinfandel in den USA bestimmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c37516-6534-42e6-bc18-a4a7c3cd503b",
                                "sense_id": "58967a80-f88d-330c-a07c-13553db3f3b6",
                                "text": "„Eine weitere heimische Traube ist der rote Primitivo in Süditalien, von dem man annimmt, daß er mit dem Zinfandel, der Rotweinsorte von Kalifornien, identisch sein soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "db87ca5c-2379-36e4-b021-3602a2bddede",
                        "entry_id": "5c248e33-ba65-313f-a65f-fbcb5b236366",
                        "glosses": [
                            "Wein aus der unter [1] genannten Rebsorte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d4cfc40-2e0c-4008-8db8-d2fb0b759cd9",
                                "sense_id": "db87ca5c-2379-36e4-b021-3602a2bddede",
                                "text": "Die neue italienische Pizzeria hat einen tollen Primitivo auf der Karte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
