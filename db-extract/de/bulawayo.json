                "senses": [
                    {
                        "sense_id": "6d58e79f-e705-3d6a-9bf6-ee2339038c34",
                        "entry_id": "4bb93fe2-411d-34e3-bd1d-655f1efd4db7",
                        "glosses": [
                            "Stadt im Südwesten von Simbabwe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d697b9f7-64f6-4548-907d-c12fc4a29df6",
                                "sense_id": "6d58e79f-e705-3d6a-9bf6-ee2339038c34",
                                "text": "„Die Mehrzahl der Weißen lebte in den Städten, von denen lange Zeit Bulawayo als Eisenbahnknotenpunkt und Industriestadt die größte war, ehe sie während des Zweiten Weltkriegs von der Hauptstadt Salisbury überflügelt wurde.“"
                            },
                            {
                                "example_id": "8afa0b7c-5ddd-47bf-bc8a-f166779e9145",
                                "sense_id": "6d58e79f-e705-3d6a-9bf6-ee2339038c34",
                                "text": "„»Eins besuchte ich Bulawayo«, so Somabulana.“"
                            },
                            {
                                "example_id": "9e7eae5f-529c-4f82-8b83-6a1214985ea7",
                                "sense_id": "6d58e79f-e705-3d6a-9bf6-ee2339038c34",
                                "text": "„Lobengula floh aus Bulawayo und beging im Januar 1894 Selbstmord.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
