                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e19482-a987-46b2-b028-76a1108821fe",
                                                "sense_id": "4a82b68a-c0f3-3f07-8673-295a75f8e5ba",
                                                "text": "The conquest took 16 years and ended in 1885 in a battle with the Afghans on the banks of the Murghab. During this period, the Turkmens offered the Russians stubborn resistance […]"
                                            },
                                            {
                                                "example_id": "9d47b1fe-902a-471b-a1a4-cb1d07909204",
                                                "sense_id": "4a82b68a-c0f3-3f07-8673-295a75f8e5ba",
                                                "text": "Keimir-Ker, a Turkmen from the Tekke clan, led a rebellion against the Persians […]"
                                            }
                                        ]
                                    }
