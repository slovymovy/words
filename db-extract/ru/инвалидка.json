                        "target_lang_word": "invalid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invalid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0cc8548-e684-3acc-87d1-e34a2168c93a",
                                        "entry_id": "e3a6fe2a-761d-3435-85b5-762a214d09cf",
                                        "glosses": [
                                            "Not valid; not true, correct, acceptable or appropriate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c415a7aa-1682-47a8-a3a4-344804fe082d",
                                                "sense_id": "b0cc8548-e684-3acc-87d1-e34a2168c93a",
                                                "text": "Your argument is invalid because it uses circular reasoning."
                                            },
                                            {
                                                "example_id": "f99d29bc-f2d7-400a-a953-009c8cf4bbe0",
                                                "sense_id": "b0cc8548-e684-3acc-87d1-e34a2168c93a",
                                                "text": "This invalid contract cannot be legally enforced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "invalid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f3b71c9-4944-32ae-adcb-232a7059baef",
                                        "entry_id": "9b0f9e34-6c55-3bb1-97ed-ea9349788209",
                                        "glosses": [
                                            "Any person with a disability or illness."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f218b0f-05b4-38eb-a7ef-92d3773c1d5b",
                                        "entry_id": "9b0f9e34-6c55-3bb1-97ed-ea9349788209",
                                        "glosses": [
                                            "A person who is confined to home or bed because of illness, disability or injury; one who is too sick or weak to care for themselves."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecb7b4c6-05c0-3c81-ad06-f1ff675e0257",
                                        "entry_id": "9b0f9e34-6c55-3bb1-97ed-ea9349788209",
                                        "glosses": [
                                            "A disabled member of the armed forces; one unfit for active duty due to injury."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "invalid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "102c9d35-9d62-3f95-8e9d-6caf03fdcef3",
                                        "entry_id": "c91d013e-1673-3af4-84a7-3bbc35a47892",
                                        "glosses": [
                                            "Suffering from disability or illness."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e791d64c-ca28-4c21-b59a-3fbad63acdb6",
                                                "sense_id": "102c9d35-9d62-3f95-8e9d-6caf03fdcef3",
                                                "text": "Invalidism therefore referred to a lack of power as well as a tendency toward illness. It is for this reason that I choose to discuss the invalid woman rather than just the ill one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e492e53a-1fb3-36e7-8e53-9365e323aaa7",
                                        "entry_id": "c91d013e-1673-3af4-84a7-3bbc35a47892",
                                        "glosses": [
                                            "Intended for use by an invalid."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "invalid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e95203-34d2-3bb2-b832-522ffd7fdc8c",
                                        "entry_id": "fa813a13-800b-3ae4-95f8-12ca91e87758",
                                        "glosses": [
                                            "To exempt from (often military) duty because of injury or ill health."
                                        ],
                                        "tags": [
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e2e650f-4f02-4cfd-b807-caf163b36a45",
                                                "sense_id": "e5e95203-34d2-3bb2-b832-522ffd7fdc8c",
                                                "text": "He was invalided home after the car crash."
                                            },
                                            {
                                                "example_id": "c4473f34-d46b-4b7d-bf82-6a77cebac9f5",
                                                "sense_id": "e5e95203-34d2-3bb2-b832-522ffd7fdc8c",
                                                "text": "Blackadder: Right, Baldrick, this is an old trick I picked up in the Sudan. We tell HQ that I’ve gone insane, and I’ll be invalided back to Blighty before you can say \"wibble\" — a poor, gormless idiot."
                                            },
                                            {
                                                "example_id": "91296006-1125-4a65-bf3c-e1f1c695238f",
                                                "sense_id": "e5e95203-34d2-3bb2-b832-522ffd7fdc8c",
                                                "text": "The Japanese armored cruiser Nisshin has been hit badly. Shells have sheared off several main guns and virtually disarmed the vessel. In the middle of all this, one Ensign Isoroku Yamamoto loses two fingers to the remains of an explosion. If he'd lost a third, he would've been invalided out of military service. Thus, by the retention of a single digit would there be rather large consequences a few decades later on down the line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a45c8b65-590f-3ed0-bbfd-55b26b510f3e",
                                        "entry_id": "fa813a13-800b-3ae4-95f8-12ca91e87758",
                                        "glosses": [
                                            "To make invalid or affect with disease."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
