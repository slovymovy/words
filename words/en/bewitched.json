                    "sense_id": "54c5e711-9488-32dc-98bc-819cbfd91ad6",
                    "sense_definition": "Simple past and past participle of <w>bewitch</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewitch_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wicked sorceress <w>bewitched</w> the prince and turned him into a frog.",
                            "target_lang_translations": {
                                "fr": "La méchante sorcière <w>ensorcela</w> le prince et le transforma en grenouille.",
                                "zh": "邪恶的女巫对王子<w>施了魔法</w>，把他变成了一只青蛙。"
                            }
                        },
                        {
                            "text": "Her breathtaking performance completely <w>bewitched</w> the entire audience last night.",
                            "target_lang_translations": {
                                "fr": "Sa performance à couper le souffle a totalement <w>envoûté</w> tout le public hier soir.",
                                "zh": "她昨晚那令人惊叹的表演彻底<w>迷住</w>了全场观众。"
                            }
                        }
