                "senses": [
                    {
                        "sense_id": "2ba8da0f-0b75-304f-96c5-17559262be97",
                        "entry_id": "cb64485f-af10-32bd-8f25-b7eb7b85f617",
                        "glosses": [
                            "Veranstaltungen organisierender Ausschuss aus elf Personen"
                        ],
                        "tags": [
                            "Karneval",
