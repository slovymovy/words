                            {
                                "example_id": "eced9221-e4ca-4f76-b5f2-2927fe77535c",
                                "sense_id": "3e1cb840-6e07-35c1-a67b-f06c5f03705a",
                                "text": "Begin 2016 verschijnt een opmerkelijk bericht op de website van Excelsior. Vleugelverdediger Daan Bovenberg besluit als 27-jarige profvoetballer te stoppen. Niet vanwege een blessure, gebrek aan speeltijd of een trainer die hem niet ziet zitten, maar puur uit vrije wil."
                            },
                            {
                                "example_id": "22013d48-7ccd-425f-9889-605a17a8ab48",
                                "sense_id": "3e1cb840-6e07-35c1-a67b-f06c5f03705a",
                                "text": "In een afscheidsbrief had het stel geschreven dat de kinderen waren meegenomen om te voorkomen dat zij zouden worden ingeënt tegen het coronavirus. Een van de ontvoerders is Andreas Egler, een voormalige profvoetballer. Hij staat bekend als antivaxxer en complotdenker."
                            }
                        ]
                    }
