                ],
                "translations": [
                    {
                        "translation_id": "8e9c358a-2ede-443c-a795-c50ee959a016",
                        "source_entry_id": "3135a52c-babb-3452-93f2-e3f971edce42",
                        "source_sense_description": "намотать",
                        "target_lang_word": "enrouler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enrouler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                        "entry_id": "9e697e88-9d31-3ca1-aee2-625e2d0e25ec",
                                        "glosses": [
                                            "Rouler plusieurs fois une chose autour d’une autre, ou sur elle-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06cbb3fa-c221-4e70-9d7d-cdeb41a8f6eb",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Un singe enroule sa queue autour d’une branche pour s’y suspendre."
                                            },
                                            {
                                                "example_id": "f63a44df-36bc-47b5-a31c-365dd6d9f5f1",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Les vrilles de cette plante s’enroulent autour des corps voisins."
                                            },
                                            {
                                                "example_id": "a50f035f-a097-4b91-8361-b0e21b4c6de6",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Evans prend possession de l'unique lit et s'y fourre entre deux édredons, tandis que je monte mon lit de voyage et m’y enroule dans mon plaid."
                                            },
                                            {
                                                "example_id": "5335b3f5-9d9e-4f24-843d-23b7823f9468",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Enrouler une pièce d’étoffe sur le cylindre."
                                            },
                                            {
                                                "example_id": "488373d6-87d3-4195-b0f8-e351235113f0",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Enrouler du fil pour en former un peloton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bcc9cb7-d59a-345a-a5c2-9801a562709b",
                                        "entry_id": "9e697e88-9d31-3ca1-aee2-625e2d0e25ec",
                                        "glosses": [
                                            "Frapper le ballon avec un effet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd028df-42f9-485a-b065-0448a04a5fe5",
                                                "sense_id": "5bcc9cb7-d59a-345a-a5c2-9801a562709b",
                                                "text": "Il enroule parfaitement son coup-franc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cba4724-bfab-405f-8457-f51c34355eb5",
                        "source_entry_id": "3135a52c-babb-3452-93f2-e3f971edce42",
                        "source_sense_description": "отмотать",
                        "target_lang_word": "dérouler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dérouler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c55f0557-a604-398f-899c-693ecba875ae",
                                        "entry_id": "c25bfd80-f9c8-36d2-95a7-cca6a42624ce",
                                        "glosses": [
                                            "Étendre ce qui était roulé et le mettre de son long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4003031-1190-4ee6-8be7-feacee281a87",
                                                "sense_id": "c55f0557-a604-398f-899c-693ecba875ae",
                                                "text": "Tavannes remit la pie sur son bâton, et s’amusa à rouler et à dérouler les oreilles d’un lévrier."
                                            },
                                            {
                                                "example_id": "a09f795d-ef9a-427d-8d6c-ec5e05a22237",
                                                "sense_id": "c55f0557-a604-398f-899c-693ecba875ae",
                                                "text": "Les hommes travaillaient en tandem, chacun conscient de sa tâche grâce aux séances d'entraînement mensuelles. Certains déroulaient leurs tuyaux d’incendie à travers la pelouse et les rattachaient aux citernes tandis que d'autres actionnaient la prise d'eau de la borne d'incendie reliée à l'un des bassins souterrains du village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a52939e6-312b-354d-9f49-1d8166fe49d5",
                                        "entry_id": "c25bfd80-f9c8-36d2-95a7-cca6a42624ce",
                                        "glosses": [
                                            "Se montrer successivement soit aux yeux, soit à l’esprit, en parlant des différentes parties d’un tout."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a31c9a3e-ab91-4f4e-a303-c33d3ef835e9",
                                                "sense_id": "a52939e6-312b-354d-9f49-1d8166fe49d5",
                                                "text": "De tous les côtés, le désert déroulait ses immenses plaines de sable."
                                            },
                                            {
                                                "example_id": "69506ff7-46bc-4ddb-9b2c-bfc0c02eaa61",
                                                "sense_id": "a52939e6-312b-354d-9f49-1d8166fe49d5",
                                                "text": "On préfère construire un roman, qu’on déroule à sa guise, au rythme que l’on choisit, on l’illustre d’images d’Épinal aux coloriages grossiers, aux violentes couleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1201f0-d6a6-3947-9d0a-f1d1eb7e4fb1",
                                        "entry_id": "c25bfd80-f9c8-36d2-95a7-cca6a42624ce",
                                        "glosses": [
                                            "Avoir lieu."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc388fc8-e2f4-4445-a3b9-b0f7b03ba38c",
                                                "sense_id": "ff1201f0-d6a6-3947-9d0a-f1d1eb7e4fb1",
                                                "text": "Leur procession par les rues se déroule avec la lenteur habituelle."
                                            },
                                            {
                                                "example_id": "b7641a90-5ac4-4a38-9833-0a82b13caf84",
                                                "sense_id": "ff1201f0-d6a6-3947-9d0a-f1d1eb7e4fb1",
                                                "text": "Face à la recrudescence du coronavirus dans le pays, la ministre japonaise des Jeux olympiques a confirmé, hier, que les JO de Tokyo se dérouleront à huis clos, et qu’un état d’urgence sanitaire sera réinstauré pendant toute la durée de la compétition (23 juillet-8 août)."
                                            },
                                            {
                                                "example_id": "1ffc72ea-499e-4e86-8314-08515609d05c",
                                                "sense_id": "ff1201f0-d6a6-3947-9d0a-f1d1eb7e4fb1",
                                                "text": "C’est autour de la côte de Domancy, en Haute-Savoie, celle qui avait sacré Bernard Hinault en 1980, que devraient se dérouler les épreuves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "701e49ab-b5f8-31f9-9753-8b62a475f86a",
                                        "entry_id": "c25bfd80-f9c8-36d2-95a7-cca6a42624ce",
                                        "glosses": [
                                            "Rouler de haut en bas, débarouler."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b31a5e3-e07e-493a-b7c0-f1c03d3e824a",
                                                "sense_id": "701e49ab-b5f8-31f9-9753-8b62a475f86a",
                                                "text": "Les cailloux chassés devant nous déroulaient vite et allaient se perdre dans les bouquets de broussailles, qui couvraient les bords du chemin"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ee52f70-1beb-4fa9-97ef-0b1682e4300b",
                        "source_entry_id": "3135a52c-babb-3452-93f2-e3f971edce42",
                        "source_sense_description": "отмотать",
