                    {
                        "translation_id": "2015395c-638b-4a32-8aa3-a69b2a58f92a",
                        "source_entry_id": "b40c9248-8dfa-3657-bdd8-618ac132bbf3",
                        "source_sense_id": "e73d0d15-2720-3a7e-9e08-5dabc5422561",
                        "target_lang_word": "ravisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03e9f14f-2409-36c7-a750-8c50b07fbf4a",
                                        "entry_id": "8a2706c1-a265-3f4a-ba94-82124190b815",
                                        "glosses": [
                                            "Celui qui ravit, qui enlève avec violence."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "074d39f4-cade-4929-b4f1-2c0e41c82d4b",
                                                "sense_id": "03e9f14f-2409-36c7-a750-8c50b07fbf4a",
                                                "text": "Les ravisseurs du bien d’autrui. - Un injuste ravisseur l’a privé de son bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d684f6-a727-353e-9b86-aea5c81a1cb7",
                                        "entry_id": "8a2706c1-a265-3f4a-ba94-82124190b815",
                                        "glosses": [
                                            "Celui qui ravit une femme ou une jeune fille."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f89abc2-1864-45a8-9a8c-6838f523a97b",
                                                "sense_id": "b4d684f6-a727-353e-9b86-aea5c81a1cb7",
                                                "text": "En ce moment le général rencontra l'œil fauve du ravisseur de sa fille. Le père et le gendre se reconnurent tout à coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84339cee-3cf8-331c-874f-569fd53473e4",
                                        "entry_id": "8a2706c1-a265-3f4a-ba94-82124190b815",
                                        "glosses": [
                                            "Celui qui enlève une ou des personnes pour en faire des otages ou des victimes sexuelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ebf1e4-33b4-4b17-8337-1fb713ed7e38",
                                                "sense_id": "84339cee-3cf8-331c-874f-569fd53473e4",
                                                "text": "Arnaud, le fils de l’opérateur en bois de rose de Toamasina a été retrouvé, hier, en fin d’après-midi à Andranomadio. Un des ravisseurs a été arrêté lors de l’accrochage avec la police."
                                            },
                                            {
                                                "example_id": "d2653383-5d38-4bd9-a271-a6a08b776c24",
                                                "sense_id": "84339cee-3cf8-331c-874f-569fd53473e4",
                                                "text": "C'est le cas de La Trêve, polar belge corrosif, ou encore de Thirteen, drame sur une jeune fille captive pendant treize ans qui échappe à son ravisseur."
                                            },
                                            {
                                                "example_id": "fe5a72c8-4414-4417-ba7a-d3e51ed25b70",
                                                "sense_id": "84339cee-3cf8-331c-874f-569fd53473e4",
                                                "text": "S'engage un long bras de fer avec les autorités. Les ravisseurs demandent la libération d'un chef anti-balaka, Andilo, alias Rodrigue Ngaïbona, arrêté quelques jours plus tôt par la Minusca."
                                            },
                                            {
                                                "example_id": "40fa1432-6185-473b-9555-9f16d3b04446",
                                                "sense_id": "84339cee-3cf8-331c-874f-569fd53473e4",
                                                "text": "En songeant aux différents aspects du drame, j'éprouvai une curiosité grandissante pour les conditions dans lesquelles les otages et leurs ravisseurs avaient vécu ensemble durant six jours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3add288f-f0d1-4186-905c-24593d8bb486",
                        "source_entry_id": "b40c9248-8dfa-3657-bdd8-618ac132bbf3",
