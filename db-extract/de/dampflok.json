                "senses": [
                    {
                        "sense_id": "e3eb59d6-3f42-3951-a144-fc449bc7a8b7",
                        "entry_id": "fe1c6eb7-983d-396e-8b5c-3082240b589c",
                        "glosses": [
                            "Abkürzung von Dampflokomotive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8372fb-8c00-4d4c-a43e-fb23ff874558",
                                "sense_id": "e3eb59d6-3f42-3951-a144-fc449bc7a8b7",
                                "text": "Die Dampflok braucht u. a. Wasser und Kohle zum Betrieb."
                            },
                            {
                                "example_id": "8e0d9b6c-3bbe-4475-b35c-0774a553150f",
                                "sense_id": "e3eb59d6-3f42-3951-a144-fc449bc7a8b7",
                                "text": "„Eine alte Dampflok zieht etwa fünf Minuten vor Abfahrt die Waggons langsam in die Bahnhofshalle, speit Rauch und Wasserdampf in die Kuppel des Bahnhofs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
