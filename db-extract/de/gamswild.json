                    {
                        "sense_id": "1b438ffb-424f-317d-a073-3a802454a86f",
                        "entry_id": "5958e8ff-ca04-31fd-8ddc-9f378ff2ef65",
                        "glosses": [
                            "Gesamtheit freilebender, jagdbarer Gämsen/Gamsen"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "e37388e9-2108-4120-bae7-eb93b6423ec1",
                                "sense_id": "1b438ffb-424f-317d-a073-3a802454a86f",
                                "text": "„Bei seiner Jagd auf Gamswild treibe der Wolf deren Rudel auseinander und zerstöre damit deren Lebensstrukturen.“"
                            },
                            {
                                "example_id": "d132063b-d3ad-4169-b4a6-dd16cb1d5d97",
                                "sense_id": "1b438ffb-424f-317d-a073-3a802454a86f",
                                "text": "„Der Steinbock flieht bei Gefahr nicht Hals über Kopf wie das Gamswild oder Rotwild; er flüchtet immer nur ein paar Meter weit, bleibt stehen und sucht Sichtkontakt zu seinem Feind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
