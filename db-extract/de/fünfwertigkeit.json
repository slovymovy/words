                ],
                "senses": [
                    {
                        "sense_id": "d870452e-2b5a-3ca9-b868-208ae1752dfa",
                        "entry_id": "c553284c-0cf0-30dd-9df6-392a5b83014e",
                        "glosses": [
                            "Eigenschaft, mit fünf anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4a66a2f5-fd0e-41e4-b872-5cfddeb5aa90",
                                "sense_id": "d870452e-2b5a-3ca9-b868-208ae1752dfa",
                                "text": "„Diese Fünfwertigkeit zeigt sich auch in anderen möglichen Elektronenkonfigurationen der Phosphorsäuren.“"
                            },
                            {
                                "example_id": "85d66103-6279-4e75-bdf8-48c8c1bbcf0d",
                                "sense_id": "d870452e-2b5a-3ca9-b868-208ae1752dfa",
                                "text": "„Im ganzen zeigen diese Elemente ansteigende Wertigkeiten von der Dreiwertigkeit des Ac über die Vierwertigkeit des Th, Drei- und Fünfwertigkeit des Pa bis zur Vier- und Sechswertigkeit des Urans.“"
                            },
                            {
                                "example_id": "22b35320-1094-439a-989f-5e548763e2cb",
                                "sense_id": "d870452e-2b5a-3ca9-b868-208ae1752dfa",
                                "text": "„Es findet sich in den Salzen des Diazobenzols mit Mineralsäuren, in welchen die Fünfwertigkeit des a-Stickstoffatoms durch die Negativität des mit ihm verbundenen Säureradikales bedingt ist, gerade so wie im Salmiak dieselbe Eigenschaft des Stickstoffes auf der Anwesenheit des negativen Chloratoms beruht: […]“"
                            },
                            {
                                "example_id": "80ba1eec-db65-415f-b857-778f78ac1f2b",
                                "sense_id": "d870452e-2b5a-3ca9-b868-208ae1752dfa",
                                "text": "„Ein wichtiges Moment für das Bestehen der Fünfwertigkeit liegt in der Temperatur.“"
                            },
                            {
                                "example_id": "b0973d44-1f2b-4df6-8913-0e4a0eca31d2",
                                "sense_id": "d870452e-2b5a-3ca9-b868-208ae1752dfa",
                                "text": "„Ebensowenig ergibt sich aus dem Schema die Möglichkeit der Fünfwertigkeit des Phosphors und Stickstoffs, die doch eine Tatsache ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
