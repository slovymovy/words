                "senses": [
                    {
                        "sense_id": "99605978-1b33-3afc-9fcb-c57f8d65655d",
                        "entry_id": "41729b9c-4060-3991-910b-a50ae2f4d3a6",
                        "glosses": [
                            "Menge relativ feinkörniger, beweglicher Steinstückchen auf einer Fahrbahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9f73671-1e9f-4a17-9596-58f38fbcc858",
                                "sense_id": "99605978-1b33-3afc-9fcb-c57f8d65655d",
                                "text": "Bei Straßenverunreinigung durch Schottersteine, man sagt auch Rollsplitt dazu, ist es vor allem für zweirädrige Fahrzeuge gefährlich."
                            },
                            {
                                "example_id": "1c27d315-b56f-4c24-9b93-1033abf9258d",
                                "sense_id": "99605978-1b33-3afc-9fcb-c57f8d65655d",
                                "text": "„Rollsplitt spritzte hoch, wenn man drüberfuhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a369fe7-de8c-45af-977e-db1fae2d6b8b",
                        "source_entry_id": "41729b9c-4060-3991-910b-a50ae2f4d3a6",
                        "source_sense_id": "99605978-1b33-3afc-9fcb-c57f8d65655d",
                        "source_sense_description": "Menge relativ feinkörniger, beweglicher Steinstückchen auf einer Fahrbahn",
                        "target_lang_word": "gravillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                                        "entry_id": "ebb3ac27-9ce9-3a5f-8540-ff79d831cc3b",
                                        "glosses": [
                                            "Fin gravier rond ou concassé dont la granularité varie de quatre à vingt millimètres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cfb9d5-3d91-4a22-9fcb-2886e151866d",
                                                "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                                                "text": "Par exemple, un gravillon d’appellation 4/16 comporte moins de 15 % de grains de diamètre inférieur à 4 mm et moins de 10 % de grains de diamètre supérieur à 16 mm."
                                            },
                                            {
                                                "example_id": "6fc28d6f-ab77-460e-9036-f358ba37f1e2",
                                                "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                                                "text": "Theodor Adorno raconte méchamment que des gamins jetaient des gravillons dans le parapluie de Nietzsche, qui retombaient en averse sur sa tête dès qu'il l'ouvrait."
                                            },
                                            {
                                                "example_id": "7467f73a-26ca-4093-a664-b6d0086effa7",
                                                "sense_id": "136182bd-2471-30d3-bcb8-16a5bda2edda",
                                                "text": "D’après les premières constatations, la chute est survenue dans un virage avec des gravillons après une descente importante. Les deux jeunes filles étaient sur la trottinette, non casquées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
