                "senses": [
                    {
                        "sense_id": "38dbfc5a-e318-3ea5-9e46-f16135a7fba1",
                        "entry_id": "e0a7b198-0205-3392-88d1-54263e5f32f9",
                        "glosses": [
                            "Donner un caractère ethnologique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "812bfcd1-c2dd-4ca5-988e-6fe1704b3778",
                                "sense_id": "38dbfc5a-e318-3ea5-9e46-f16135a7fba1",
                                "text": "Dans ce cas, le littéralisme est fondé ; mais la conséquence en est qu’on aura des traductions savantes, qui vont tendre à « philologiser » la langue-cible et à « ethnologiser » le texte traduit."
                            },
                            {
                                "example_id": "c5b7c8c4-5252-43bf-9045-e3ee8919a9b7",
                                "sense_id": "38dbfc5a-e318-3ea5-9e46-f16135a7fba1",
                                "text": "Les premiers tendraient à \"ethnologiser\" les textes et à nous donner des traductions \"savantes\", accessibles seulement à un public restreint."
                            }
                        ]
                    }
                ],
