{
    "word_family": [
        "central",
        "centralize",
        "centrality",
        "centrally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "594c5ede-a931-3d8b-9c64-62fb9b29d74b",
                    "sense_definition": "A center or central point.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "center",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city <w>centrum</w> was bustling with activity during the festival.",
                            "target_lang_translations": {
                                "tr": "Festival sırasında <w>şehir merkezi</w> hareketliydi."
                            }
                        },
                        {
                            "text": "They met at the <w>centrum</w> of the town to discuss the new plans.",
                            "target_lang_translations": {
                                "tr": "Yeni planları görüşmek için kasabanın <w>merkezinde</w> buluştular."
                            }
                        }
                    ],
                    "synonyms": [
                        "center",
                        "hub"
                    ],
                    "common_phrases": [
                        "city centrum"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin merkezi veya orta noktası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "merkez",
                                "target_lang_sense_clarification": "Bir yerin orta noktası veya ana bölgesi."
                            },
                            {
                                "target_lang_word": "şehir merkezi",
                                "target_lang_sense_clarification": "Bir şehrin en işlek veya ana bölgesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8aca8d3-d931-3f2b-8408-933167d9fc94",
                    "sense_definition": "The point of origin of an earthquake.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "center",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists identified the <w>centrum</w> of the earthquake deep beneath the ocean floor.",
                            "target_lang_translations": {
                                "tr": "Bilim insanları depremin <w>odak noktasını</w> okyanus tabanının derinliklerinde tespit ettiler."
                            }
                        },
                        {
                            "text": "The seismic waves radiated outward from the <w>centrum</w> of the tremor.",
                            "target_lang_translations": {
                                "tr": "Sismik dalgalar sarsıntının <w>odak noktasından</w> dışarıya doğru yayıldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "hypocenter",
                        "focus"
                    ],
                    "target_lang_definitions": {
                        "tr": "Depremin başladığı odak noktası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "odak noktası",
                                "target_lang_sense_clarification": "Depremin yerin altında başladığı nokta."
                            },
                            {
                                "target_lang_word": "iç merkez",
                                "target_lang_sense_clarification": "Sismolojide depremin merkez üssü."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa7546f5-983d-382c-aed9-f5c6de4c2f30",
                    "sense_definition": "The main solid body of a vertebra.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>centrum</w> provides structural support to the spinal column.",
                            "target_lang_translations": {
                                "tr": "<w>Omur gövdesi</w> omurgaya yapısal destek sağlar."
                            }
                        },
                        {
                            "text": "Damage to the <w>centrum</w> can significantly affect the stability of the vertebrae.",
                            "target_lang_translations": {
                                "tr": "<w>Omur gövdesindeki</w> hasar, omurların stabilitesini önemli ölçüde etkileyebilir."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Omurganın ana gövde kısmı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "omur gövdesi",
                                "target_lang_sense_clarification": "Anatomide omurun ana, silindirik kısmı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c337241a-aa3d-3f94-b417-3ccd209b9eb5",
                    "sense_definition": "The fundamental part of a cranial segment in the skull.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>centrum</w> of the cranial segment serves as a base for surrounding bone structures.",
                            "target_lang_translations": {
                                "tr": "Kafatasının <w>merkezi</w>, çevresindeki kemik yapıları için bir temel görevi görür."
                            }
                        },
                        {
                            "text": "Comparative anatomy studies the development of the cranial <w>centrum</w> in various species.",
                            "target_lang_translations": {
                                "tr": "Karşılaştırmalı anatomi, çeşitli türlerdeki kafatası <w>merkezinin</w> gelişimini inceler."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kafatası segmentinin temel parçası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kafatası merkezi",
                                "target_lang_sense_clarification": "Kafatası yapısının temelini oluşturan anatomik bölge."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}