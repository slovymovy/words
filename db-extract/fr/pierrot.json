                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Peterle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                        "entry_id": "45998187-4c7f-315c-b29f-c3c2c1e19375",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca737ded-8e34-489a-9b7d-9f1b47bc7924",
                                                "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                                "text": "Frau Peterle ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a07ddafb-e5d2-4d1d-9960-e0bc1184dd8f",
                                                "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                                "text": "Herr Peterle wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6ae24436-afba-4f78-89da-ed4358bc34b5",
                                                "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                                "text": "Die Peterles fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "170f1bd4-034c-4aa0-be7f-97efd24858cd",
                                                "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                                "text": "Der Peterle trägt nie die Schals, die die Peterle ihm strickt."
                                            },
                                            {
                                                "example_id": "a5449baf-08f9-45d4-9460-5ac9f4d8a51e",
                                                "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Peterle kommt, geht der Herr Peterle.“"
                                            },
                                            {
                                                "example_id": "37d21bb5-5e85-4fb5-b08c-5b5be1f2e314",
                                                "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                                "text": "Peterle kommt und geht."
                                            },
                                            {
                                                "example_id": "d9ade6ee-e7d3-4498-b2ff-780773057494",
                                                "sense_id": "208ca745-0944-3381-a051-8a3cf9a3db33",
                                                "text": "Peterles kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
