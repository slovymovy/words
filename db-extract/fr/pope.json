                "entry_id": "bdbdc231-f3eb-3c94-8382-f0ab0180f53a",
                "word": "Pope",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1e198f4-0465-3da3-bcbd-d8cd9ea54ca7",
                        "entry_id": "bdbdc231-f3eb-3c94-8382-f0ab0180f53a",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d49daf6-174a-4e1e-a20f-4c8be9b2ecbe",
                                "sense_id": "e1e198f4-0465-3da3-bcbd-d8cd9ea54ca7",
                                "text": "Le gardien des Magpies, Nick Pope, tentera d’élever une muraille devant Erling Haaland, l’attaquant vedette des Citizens déjà crédité d’un doublé."
                            },
                            {
                                "example_id": "807449be-b4b8-465e-bbc1-7a86f8474e86",
                                "sense_id": "e1e198f4-0465-3da3-bcbd-d8cd9ea54ca7",
                                "text": "Aujourd’hui, ce serait un rêve pour certains : Owen et Dolly Pope, un couple d’Américains, ont vécu quinze ans à Disneyland, raconte Allociné."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8ba040a9-a1df-3bea-b485-b187660bd373",
                "word": "pope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2997100d-e3d9-43cf-94ac-1e5c4711df18",
                        "entry_id": "8ba040a9-a1df-3bea-b485-b187660bd373",
                        "tags": [
                            "plural"
