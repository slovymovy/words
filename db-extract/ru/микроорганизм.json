                                            {
                                                "example_id": "753c7f82-c798-4ee2-b85a-f8d48f3ac571",
                                                "sense_id": "71adb610-e719-3fba-bf03-70f897868d8b",
                                                "text": "W ludzkim organizmie występuje mnóstwo drobnoustrojów – niektóre mają działanie pozytywne, inne negatywne."
