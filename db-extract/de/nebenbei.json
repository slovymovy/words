                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e220be2-4b4c-4485-8350-e412111250d9",
                                "sense_id": "3213600b-3ecb-395c-b76a-28e02bb0d247",
                                "text": "Der alte Schotte ließ das Geheimnis des Erfolgs ganz nebenbei fallen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a8ccdbc-7661-3b25-bc9f-6ae05099376f",
                        "entry_id": "69430a39-1a5e-36ff-a0ee-be5a88ad272a",
                        "glosses": [
                            "En plus du reste, en outre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8e41b169-8ce0-3c50-a689-687d153a90c2",
                        "entry_id": "69430a39-1a5e-36ff-a0ee-be5a88ad272a",
                        "glosses": [
                            "En parallèle, en même temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7409538a-2589-400b-8900-92a4710c281e",
                                "sense_id": "8e41b169-8ce0-3c50-a689-687d153a90c2",
                                "text": "Er studierte nebenbei Sprachwissenschaft.",
                                "translation": "Il a étudié la linguistique en parallèle."
                            },
                            {
                                "example_id": "f36ecf0e-74d4-496d-89d6-0f154670fe10",
                                "sense_id": "8e41b169-8ce0-3c50-a689-687d153a90c2",
                                "text": "Es ist verboten, am Steuer eines Autos zu sitzen und nebenbei mit dem Handy zu hantieren.",
                                "translation": "Il est interdit d'être au volant d'une voiture et de manipuler le téléphone portable en même temps."
                            }
                        ]
                    }
