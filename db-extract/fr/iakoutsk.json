            {
                "entry_id": "b7baea9f-d65f-3ec2-9f66-66035e628f3a",
                "word": "Iakoutsk",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4073d606-992b-41a7-9ffb-fdda9c47995f",
                        "entry_id": "b7baea9f-d65f-3ec2-9f66-66035e628f3a",
                        "tags": [],
                        "form": "Yakoutsk"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4c4b130-ab67-366b-8d99-aab129e70634",
                        "entry_id": "b7baea9f-d65f-3ec2-9f66-66035e628f3a",
                        "glosses": [
                            "Grande ville de Iakoutie en Sibérie, sur le fleuve Léna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454302ec-b39a-4048-ae35-5501ea4a3e43",
                                "sense_id": "a4c4b130-ab67-366b-8d99-aab129e70634",
                                "text": "Pour ces voyages, on employa, en 1735, un sloop double construit à Iakoutsk, et, en 1739, deux bateaux construits à Nischni Kolymsk."
                            },
                            {
                                "example_id": "73f51f37-a1dd-4517-9466-1c5b9b30b332",
                                "sense_id": "a4c4b130-ab67-366b-8d99-aab129e70634",
                                "text": "Dans le nord de la Sibérie orientale, Iakoutsk, capitale de la Iakoutie, connaît des températures hivernales inférieures à -50 °C."
                            },
                            {
                                "example_id": "4c4e747d-dc2d-4a96-9746-4ef84cc31f4f",
                                "sense_id": "a4c4b130-ab67-366b-8d99-aab129e70634",
                                "text": "Je restai six mois en prison et fus ensuite déporté dans la région d’Iakoutsk, pour cinq ans."
                            },
                            {
                                "example_id": "b9aa7928-2093-4b52-8e98-422b00d825d3",
                                "sense_id": "a4c4b130-ab67-366b-8d99-aab129e70634",
                                "text": "On ignorait jusqu’à présent l’épaisseur des couches gelées dans le sol de la Sibérie : un marchang, nommé Cherguine, commissionnaire de la Compagnie russo-américaine à Iakoutsk, a fait creuser à ses frais un puits où, à la profondeur de 11 sajènes 77 pieds anglais), il a trouvé encore la température à 5° et demi R. au dessous de 0 ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e34a97a-42cf-40dd-8034-3fccb09a5ad6",
                        "source_entry_id": "b7baea9f-d65f-3ec2-9f66-66035e628f3a",
                        "source_sense_id": "a4c4b130-ab67-366b-8d99-aab129e70634",
                        "target_lang_word": "Jakutsk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jakutsk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff9f15a-7f7c-3000-9f45-aec6c69c5622",
                                        "entry_id": "0acddbb4-2923-3dbd-b076-9f8e14b3dce4",
                                        "glosses": [
                                            "am Strom Lena gelegene Stadt im Osten Russlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2063c7-dd00-4b5c-842f-0dfa39eac6c2",
                                                "sense_id": "0ff9f15a-7f7c-3000-9f45-aec6c69c5622",
                                                "text": "„Jakutsk gilt als kälteste Großstadt der Welt. Sie ist auf Permafrostboden gebaut, der niemals auftaut. Der Winter dauert von Oktober bis Mai.“"
                                            },
                                            {
                                                "example_id": "8b016bdb-7133-4f20-9238-c6d5ad74f02f",
                                                "sense_id": "0ff9f15a-7f7c-3000-9f45-aec6c69c5622",
                                                "text": "„Wer als Ausländer in Jakutsk ankommt, muss eine jakutische Aufenthaltserlaubnis beantragen, auch wenn er ein russisches Visum hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
