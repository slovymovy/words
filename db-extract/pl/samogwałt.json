                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc2ccb3c-5526-4ca0-9e99-c2a314d97d27",
                        "source_entry_id": "d09bc64a-0fe6-3db7-ade2-3792889666bb",
                        "source_sense_id": "23873bcc-5571-3235-86f2-731f46999406",
                        "target_lang_word": "Selbstbefriedigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbefriedigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4856a3b0-8c5a-3910-b290-99528b414d60",
                                        "entry_id": "741fdb57-e016-3719-88f1-e8c4538b0feb",
                                        "glosses": [
                                            "manuelle Stimulation der Geschlechtsorgane bis zum Orgasmus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c1de1c-6bba-408f-ab57-f61f9f7a4cf7",
                                                "sense_id": "4856a3b0-8c5a-3910-b290-99528b414d60",
                                                "text": "„Komisch, dass gerade in Ägypten die Selbstbefriedigung so verpönt ist, wo alles im Lande der Pharaonen eigentlich mit dem Onanieren Gottes begann.“"
                                            },
                                            {
                                                "example_id": "5d92bd1d-8e54-4af4-9b27-28f450bacbc0",
                                                "sense_id": "4856a3b0-8c5a-3910-b290-99528b414d60",
                                                "text": "„Ich fiel ihr um den Hals und sagte, sie habe nicht gelegener kommen können, um eine Selbstbefriedigung nach Schülerart zu verhindern, auf die ich nach allem, was ich seit einer Stunde gesehen hatte, unweigerlich verfallen wäre.“"
                                            },
                                            {
                                                "example_id": "01905ef0-a6e7-4de8-adcb-c52651c74c80",
                                                "sense_id": "4856a3b0-8c5a-3910-b290-99528b414d60",
                                                "text": "„Die Freiheit, über Selbstbefriedigung zu schreiben, wurde auch durch andere Manifestationen des Zeitgeists, dem er ausgesetzt war, ermöglicht, etwa durch die provokatorische Rockgruppe The Fugs oder das Off-Broadway-Stück ‚MacBird!‘, in dem Johnson aufs Korn genommen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
