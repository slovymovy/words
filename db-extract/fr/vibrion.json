                        "entry_id": "e50e37a1-f920-33d6-af94-67815ef914e5",
                        "glosses": [
                            "Bactérie sans spore, petit bacille, souvent incurvé, « en virgule », extrêmement mobile."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "70253e27-703b-380b-8073-be90ceb6635d",
                        "entry_id": "e50e37a1-f920-33d6-af94-67815ef914e5",
                        "glosses": [
                            "Être microscopique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "32a5f25f-59c4-4efa-909e-d7bb6de5cd13",
                                "sense_id": "70253e27-703b-380b-8073-be90ceb6635d",
                                "text": "On voit que le lapin de l’expérience précédente (X) a subi trois injections sous-cutanées de sang de chien, en voie de putréfaction, rempli de vibrions et de granulations vibrionnaires : […]."
                            },
                            {
                                "example_id": "44afe3d1-4404-44e8-a7c9-3011389383c8",
                                "sense_id": "70253e27-703b-380b-8073-be90ceb6635d",
                                "text": "Quelques fumigations opportunément et soigneusement faites, et tout vibrion est anéanti."
                            },
                            {
                                "example_id": "58fce1c1-0f5b-47ad-a75b-706a6cae9913",
                                "sense_id": "70253e27-703b-380b-8073-be90ceb6635d",
                                "text": "Il ne faisait pas très clair et ça sentait la cire des Indes et le vibrion bleu."
                            }
                        ]
                    },
                    {
                        "sense_id": "7640af70-ea8f-35e1-817b-72ce2b72e674",
                        "entry_id": "e50e37a1-f920-33d6-af94-67815ef914e5",
                        "glosses": [
                            "Personne très agitée, et souvent inopérante."
                        ],
