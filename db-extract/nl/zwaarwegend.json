                                            {
                                                "example_id": "e6402fe7-e3b3-4fef-8296-20543448d71c",
                                                "sense_id": "a01c7b36-c149-326b-a2f0-c8c8260c79dd",
                                                "text": "Die Wettbewerbe bestehen aus Skilanglauftouren, die mit Orientierungshilfen (Kompass) und mit unterschiedlich gewichtigen Rucksäcken zu absolvieren sind."
                                            }
                                        ],
