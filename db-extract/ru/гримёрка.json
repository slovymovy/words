                    },
                    {
                        "translation_id": "74f97bf7-bf0a-45bd-b254-065abb2b1d08",
                        "source_entry_id": "80922a34-b7b9-366e-b7d9-e4faaeb956be",
                        "source_sense_id": "4c7e5735-f243-3fd7-8330-ebd1bd92ed82",
                        "target_lang_word": "camerino di truccatore",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
