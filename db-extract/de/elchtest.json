                ],
                "senses": [
                    {
                        "sense_id": "6d011082-9ccd-3b3d-b19a-5ca9f8bab1b3",
                        "entry_id": "d352af2d-55e9-37f1-b5bb-905bf02ce8bf",
                        "glosses": [
                            "Test von Fahrzeugen daraufhin, ob sie bei plötzlichen Ausweichmanövern für den Fahrer beherrschbar bleiben"
                        ],
                        "tags": [
                            "Fahrzeuge"
                        ],
                        "examples": [
                            {
                                "example_id": "74fcab97-1c56-42a2-a8bf-2adfe341d47b",
                                "sense_id": "6d011082-9ccd-3b3d-b19a-5ca9f8bab1b3",
                                "text": "„Schrempps Ziel war eine Umsatzrendite von zwölf Prozent. Tatsächlich lief das Geschäft aufgrund einer beachtlichen Modelloffensive in den Folgejahren recht gut, sieht man mal von der zunächst misslungenen Einführung der A-Klasse mit dem berühmt-berüchtigten Elchtest ab.“"
                            },
                            {
                                "example_id": "d44b8c59-1322-4464-8d5a-1e3cecdf87c9",
                                "sense_id": "6d011082-9ccd-3b3d-b19a-5ca9f8bab1b3",
                                "text": "„[Es reichte] bereits, dass […] am 21. Oktober 1997 die Mercedes A-Klasse beim Elchtest in Schweden umgekippt war […]“"
                            },
                            {
                                "example_id": "5dcb8f1c-f21a-45b3-a16e-50d9e7219913",
                                "sense_id": "6d011082-9ccd-3b3d-b19a-5ca9f8bab1b3",
                                "text": "[Michael Specht, Testfahrer und im Jahr 1997 Redakteur bei \"Auto Bild\":] „Der Elchtest gehörte bis dato nicht zu unserem Testrepertoire.“"
                            },
                            {
                                "example_id": "5600e999-0794-4204-a144-8829bfab4a83",
                                "sense_id": "6d011082-9ccd-3b3d-b19a-5ca9f8bab1b3",
                                "text": "„Ukki überholt einen Traktor, als wollte er mit unserem Fiat den Elchtest bestehen.“"
                            },
                            {
                                "example_id": "0ccb47c5-c283-42a0-b92e-664470632355",
                                "sense_id": "6d011082-9ccd-3b3d-b19a-5ca9f8bab1b3",
                                "text": "„[…] der Chrysler-Jeep Liberty [soll] inzwischen dementierten Medienberichten zufolge den so genannten Elchtest für schnellen Spurwechsel nicht bestanden haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
