                                            {
                                                "example_id": "0989ffd1-dac6-4086-b1c0-e79920cd2bd0",
                                                "sense_id": "d25b69a3-6d9d-3c80-a4f8-fb6d685fc3e5",
                                                "text": "Routine dress for Tuesday will be bra and panties with high-heel satin mules."
                                            },
                                            {
                                                "example_id": "4857d656-d3a8-4433-9766-afa74c985204",
                                                "sense_id": "d25b69a3-6d9d-3c80-a4f8-fb6d685fc3e5",
                                                "text": "Her housecoat had fallen open. She was wearing only panties and bra, which did nothing to make her scrawny, wrinkled body appealing."
                                            }
                                        ]
                                    }
                                ]
