                        "source_sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                        "source_sense_description": "aus dem Stegreif: ohne Vorbereitung, improvisiert",
                        "target_lang_word": "au pied levé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au pied levé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                        "entry_id": "a4fed66b-889a-3158-b06b-78e7b8b2a046",
                                        "glosses": [
                                            "À l’improviste, sans préparation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d989316-822a-48d6-ad9a-e68381f649ed",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "Reprendre une organisation au pied levé."
                                            },
                                            {
                                                "example_id": "026e5564-429e-4c91-a8c9-a96067c7729d",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "Vous me posez une question difficile : vous me prenez au pied levé."
                                            },
                                            {
                                                "example_id": "5faba271-e5e4-4090-90b1-a8619f74cdec",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "Doubler un rôle au pied levé."
                                            },
                                            {
                                                "example_id": "277a5bce-732a-40c0-87b6-a8ea752a9aba",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "Il m’a fallu faire cette conférence au pied levé."
                                            },
                                            {
                                                "example_id": "8837e33b-3800-4d52-9361-641cb0172943",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "La Carlotta n’avait point pardonné à Christine le triomphe que celle-ci avait remporté en la remplaçant au pied levé."
                                            },
                                            {
                                                "example_id": "a043bbea-aba2-4204-85ac-bc22ecf2e8a7",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "Elle était devenue la secrétaire particulière du grand patron. Cet avènement s’était fait comme la carrière d’une petite actrice qui remplace au pied levé la vedette et remporte un triomphe."
                                            },
                                            {
                                                "example_id": "83517dfa-1ca4-4df2-a560-dad4d0d1a0ba",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "– Vous voyez bien, dit-elle, vous mettez d’excellentes personnes dans l’embarras. Vous les prenez au pied levé et vous leur demandez du courage, de la générosité, de l’enthousiasme ou qui sait quoi dont elles ne sont capables qu’après mûres réflexions et beaucoup d’échauffement."
                                            },
                                            {
                                                "example_id": "c6382e38-a09d-4d00-9976-8237d073b6eb",
                                                "sense_id": "4c31c3df-978c-3efe-b1e7-85debd58e9e8",
                                                "text": "On lui propose de remplacer au pied levé Gene Vincent, victime d’une extinction de voix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
