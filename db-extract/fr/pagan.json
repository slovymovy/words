                "senses": [
                    {
                        "sense_id": "11a7b139-de21-33e1-b267-591fc6284867",
                        "entry_id": "78c7486a-e958-352f-b732-12b113b2d23f",
                        "glosses": [
                            "Nom d’un jeu de cartes qui oppose une sorcière et un chasseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b31334-8f55-43ef-b44a-34d7ff5aa107",
                                "sense_id": "11a7b139-de21-33e1-b267-591fc6284867",
                                "text": "Malgré le thème plutôt sombre de Pagan (il y a même un avertissement dans le livret de règles pour demander aux joueurs de ne pas tout prendre au pied de la lettre), notre partie est plutôt bon enfant."
                            },
                            {
                                "example_id": "91b843d2-da0a-41f9-9dce-ef50c9b35cde",
                                "sense_id": "11a7b139-de21-33e1-b267-591fc6284867",
                                "text": "Pagan est un jeu qui joue sur l’asymétrie des personnages."
                            },
                            {
                                "example_id": "94ea2b67-fdf1-498a-92ac-c674f7d3c153",
                                "sense_id": "11a7b139-de21-33e1-b267-591fc6284867",
                                "text": "Pagan Le destin de Roanoke est un jeu de cartes, asymétrique, de gestion de main, de déduction, où une Sorcière et un Chasseur s’affrontent."
                            }
                        ]
                    }
                ],
