                "senses": [
                    {
                        "sense_id": "3f4b04f5-f8b6-39c1-9373-e3df36cf9107",
                        "entry_id": "bb6ac55e-b816-31af-b90e-8945e0b4ad59",
                        "glosses": [
                            "To best an opponent by thinking."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "eb98dd25-ec8a-4de7-9002-88ea8f74b94c",
                                "sense_id": "3f4b04f5-f8b6-39c1-9373-e3df36cf9107",
                                "text": "Kasparov might be the world best chess-player, but Deep Blue clearly outthought him in this match."
                            },
                            {
                                "example_id": "432098b2-b8d2-4f32-b4b1-11dad9c6feca",
                                "sense_id": "3f4b04f5-f8b6-39c1-9373-e3df36cf9107",
                                "text": "Microsoft has carefully cultivated an image of being an outfit that outthinks and outinnovates rivals."
                            },
                            {
                                "example_id": "6a40ea20-da16-4329-b1b8-c6b5323eb4c5",
                                "sense_id": "3f4b04f5-f8b6-39c1-9373-e3df36cf9107",
                                "text": "Its “Dell model” became synonymous with efficiency, outsourcing and tight inventories, and was taught at the Harvard Business School and other top-notch management schools as a paragon of business smarts and outthinking the competition."
                            },
                            {
                                "example_id": "fb723515-4d0d-44b2-bf44-6e10bc7a6003",
                                "sense_id": "3f4b04f5-f8b6-39c1-9373-e3df36cf9107",
                                "text": "Argentina outfought and outthought France on a traumatic opening night for the host, winning more completely than the 17-12 scoreline suggested."
                            },
                            {
                                "example_id": "fabab3ca-d864-4c5e-ad60-3c915713daa1",
                                "sense_id": "3f4b04f5-f8b6-39c1-9373-e3df36cf9107",
                                "text": "It is an example of what real entrepreneurship can do on the railway, but sadly there are not many other examples. Most of the private sector businesses in rail are simply 'gaming' the system, trying to outdo or outthink the regulator and the Government in order to generate profit."
                            }
                        ]
                    }
