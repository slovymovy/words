                "senses": [
                    {
                        "sense_id": "71d544b9-da1e-33af-94ff-254c99976735",
                        "entry_id": "0d747f1b-1a86-3df3-a447-b0353a78f212",
                        "glosses": [
                            "Mandat utilisé pour transférer des espèces d’un émetteur à un bénéficiaire par le biais d’un service postal."
                        ],
                        "tags": [
                            "Poste"
                        ],
                        "examples": [
                            {
                                "example_id": "91b084f2-79fc-423d-8181-216b9258d921",
                                "sense_id": "71d544b9-da1e-33af-94ff-254c99976735",
                                "text": "Il touchait sa solde, envoyait un mandat-poste à sa mère"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39dd3f38-1566-4d5e-849a-020d8dbb7b4b",
