                "senses": [
                    {
                        "sense_id": "c3b31e0f-3545-3905-b6d8-695bfdc4f626",
                        "entry_id": "220b4da7-721c-3e1a-92b4-3fc33481bf2a",
                        "glosses": [
                            "Fläche, auf der Rohstoffe abgebaut werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9686377-c0d0-4143-b5ed-e5d663e9dd45",
                                "sense_id": "c3b31e0f-3545-3905-b6d8-695bfdc4f626",
                                "text": "„Jüngst hat die Behörde große Flächen in der Vulkaneifel zu Vorranggebieten für den Gesteinsabbau erklärt. Fänden die Pläne Eingang in das neue Landesentwicklungsprogramm, würde sich die Abbaufläche auf 2000 Hektar verfünffachen.“"
                            },
                            {
                                "example_id": "d6c3f512-8b87-4dae-8612-1141c7d52776",
                                "sense_id": "c3b31e0f-3545-3905-b6d8-695bfdc4f626",
                                "text": "„Es ist eine Kettenreaktion: Der Anstieg der Malariafälle, der Unterernährung und der Todesfälle durch vermeidbare Krankheiten ist auf die Ausweitung der illegalen Abbauflächen zurückzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
