            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fec6b528-144a-3b6f-93c3-557df1cab337",
                    "sense_definition": "een angstig of benauwd gevoel hebbend, vaak gepaard gaand met een gevoel van druk op de borst",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij voelde zich <w>beklemd</w> in de kleine, donkere kamer zonder ramen.",
                            "target_lang_translations": {
                                "en": "He felt <w>oppressed</w> in the small, dark room without windows."
                            }
                        },
                        {
                            "text": "Met een <w>beklemd</w> hart wachtte zij op de uitslag van het belangrijke onderzoek.",
                            "target_lang_translations": {
                                "en": "With an <w>anxious</w> heart, she waited for the results of the important examination."
                            }
                        }
                    ],
                    "synonyms": [
                        "beangst",
                        "benauwd",
                        "angstig"
                    ],
                    "antonyms": [
                        "onbeklemd"
                    ],
                    "common_phrases": [
                        "beklemd hart",
                        "beklemd gevoel"
                    ],
                    "target_lang_definitions": {
                        "en": "having an anxious or uneasy feeling, often accompanied by a sense of pressure on the chest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oppressed",
                                "target_lang_sense_clarification": "feeling weighed down by anxiety or fear"
                            },
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "feeling uneasy or worried"
                            },
                            {
                                "target_lang_word": "uneasy",
                                "target_lang_sense_clarification": "feeling uncomfortable or apprehensive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ada82fa-ddb2-3518-89d2-15ec5f0bcdeb",
                    "sense_definition": "van verschillende kanten vastgeklemd of in de knel zittend",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vinger zat <w>beklemd</w> tussen de zware deur en de post.",
                            "target_lang_translations": {
                                "en": "The finger was <w>trapped</w> between the heavy door and the frame."
                            }
                        },
                        {
                            "text": "Na het ongeluk zat de bestuurder <w>beklemd</w> in het wrak van de auto.",
                            "target_lang_translations": {
                                "en": "After the accident, the driver was <w>pinned</w> in the wreckage of the car."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastgeklemd",
                        "klem"
                    ],
                    "common_phrases": [
                        "beklemd zitten"
                    ],
                    "target_lang_definitions": {
                        "en": "clamped or stuck from different sides; trapped"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trapped",
                                "target_lang_sense_clarification": "unable to move or escape"
                            },
                            {
                                "target_lang_word": "pinned",
                                "target_lang_sense_clarification": "held down or stuck between objects"
                            },
                            {
                                "target_lang_word": "jammed",
                                "target_lang_sense_clarification": "stuck tightly between surfaces"
                            }
                        ]
                    }
                }
            ]
        },
