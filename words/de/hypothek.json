                {
                    "sense_id": "722ccf69-c6a9-3f81-89bd-a79e92e674ce",
                    "sense_definition": "Kredit oder Darlehen zum Erwerb einer Immobilie, der durch ein Pfandrecht an dieser gesichert ist",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finanzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Um das Haus finanzieren zu können, musste die Familie eine hohe <w>Hypothek</w> bei der Bank aufnehmen."
                        },
                        {
                            "text": "Nach mehr als zwanzig Jahren konnte das Ehepaar die <w>Hypothek</w> endlich vollständig abbezahlen."
                        }
                    ],
                    "common_phrases": [
                        "eine Hypothek aufnehmen",
                        "eine Hypothek abbezahlen"
                    ]
                },
                {
                    "sense_id": "f750cb93-646f-3de2-a518-f3be200ba9c6",
                    "sense_definition": "im Grundbuch eingetragenes Pfandrecht an einem Grundstück oder einer Immobilie zur Sicherung einer Geldforderung",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finanzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zur Absicherung der Forderung ließ das Kreditinstitut eine <w>Hypothek</w> auf das Firmengrundstück eintragen."
                        },
                        {
                            "text": "Erst nach der vollständigen Begleichung der Schulden kann die <w>Hypothek</w> aus dem Grundbuch gelöscht werden."
                        }
                    ],
                    "synonyms": [
                        "Grundpfandrecht"
                    ],
                    "common_phrases": [
                        "eine Hypothek eintragen lassen",
                        "eine Hypothek tilgen"
                    ]
                },
                {
                    "sense_id": "813439d2-5c49-3b08-8668-83b7d9b318a6",
                    "sense_definition": "eine schwere Belastung oder ein nachteiliger Umstand aus der Vergangenheit, der die weitere Entwicklung hemmt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die enorme Staatsverschuldung stellte eine schwere <w>Hypothek</w> für die neugewählte Regierung dar."
                        },
                        {
                            "text": "Das ungelöste Problem erwies sich schon bald als belastende <w>Hypothek</w> für alle weiteren Verhandlungen."
                        }
                    ],
                    "synonyms": [
                        "Bürde",
                        "Belastung"
                    ],
                    "common_phrases": [
                        "schwere Hypothek",
                        "Hypothek für die Zukunft"
                    ]
                }
            ]
        }
