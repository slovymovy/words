                    {
                        "sense_id": "5754ac6e-b253-3383-82a6-3cbc1d12a03c",
                        "entry_id": "8111e6a6-6aa1-39c3-8906-9fa1bab6114c",
                        "glosses": [
                            "Soda à l’orange ou au citron de marque Fanta."
