                "senses": [
                    {
                        "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                        "entry_id": "b8feaac2-e3b4-33eb-9abb-98a5b05edda6",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d59cede8-507b-4c86-9f76-57280fe641e5",
                                "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                                "text": "Frau Fabian ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4fa495d5-e5da-4fcd-9ab5-d6e94e8b3a06",
                                "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                                "text": "Herr Fabian wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9e71cef8-e7af-4c51-993f-9be90a36cbac",
                                "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                                "text": "Die Fabians fahren heute nach Linz."
                            },
                            {
                                "example_id": "6a604d4f-1a45-475a-b379-a244e4278267",
                                "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                                "text": "Der Fabian trägt nie die Pullover, die die Fabian ihm strickt."
                            },
                            {
                                "example_id": "03e085a6-4a42-4d31-88f8-7ff57aa815d6",
                                "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fabian kommt, geht der Herr Fabian.“"
                            },
                            {
                                "example_id": "5c5cd484-a2d3-46a5-844a-c7dc144508c5",
                                "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                                "text": "Fabian kommt und geht."
                            },
                            {
                                "example_id": "4694cc84-7c0e-4d35-b9cf-c5ef19a970a3",
                                "sense_id": "af54598a-c4ee-3c73-993b-cdaeb5c9fbb4",
                                "text": "Fabians kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
