                        "cross_references": [
                            {
                                "target_word": "swim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c4a29f3-cf04-3108-98bb-26fd67c8c738",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To move through the water, without touching the bottom; to propel oneself in water by natural means."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c88cd3-7925-4dfa-ad20-ad78780e70ca",
                                                "sense_id": "1c4a29f3-cf04-3108-98bb-26fd67c8c738",
                                                "text": "We were now all upon a Level, as to our travelling; being unshipp’d, for our Bark would swim no farther, and she was too heavy to carry on our Backs […]"
                                            },
                                            {
                                                "example_id": "2376f345-ce38-42a0-b0f0-7690c86c1237",
                                                "sense_id": "1c4a29f3-cf04-3108-98bb-26fd67c8c738",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            },
                                            {
                                                "example_id": "df91bde4-52aa-4c91-adda-1e4f8555fffe",
                                                "sense_id": "1c4a29f3-cf04-3108-98bb-26fd67c8c738",
                                                "text": "Meanwhile, NR faced an unexpected challenge when a night watchman spotted several Koi Carp swimming in floodwater close to the railway, after they had escaped from a nearby private residence. Wilson says the owner was eventually traced, and the fish were safely returned \"after enjoying swimming around in a 3,000-acre lake\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90da632-e27d-361d-ab92-14b043c5976b",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To become immersed in, or as if in, or flooded with, or as if with, a liquid"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecf518e-dd12-40bd-af6f-796437678d67",
                                                "sense_id": "c90da632-e27d-361d-ab92-14b043c5976b",
                                                "text": "swimming in self-pity"
                                            },
                                            {
                                                "example_id": "3e232179-20a4-41e5-9fd2-89513ad145d0",
                                                "sense_id": "c90da632-e27d-361d-ab92-14b043c5976b",
                                                "text": "a bare few bits of meat swimming in watery sauce"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d9a4fcf-6b40-3215-8766-d711ab9dc536",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To move around freely because of excess space."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f74049fb-5a5a-4847-80c8-4de03935ce31",
                                                "sense_id": "2d9a4fcf-6b40-3215-8766-d711ab9dc536",
                                                "text": "A fam'd Sur-tout he wears, which once was blue, / And his foot swims in a capacious shoe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b1adae-89ea-38aa-837d-3f3e4240a3fa",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To traverse (a specific body of water, or a specific distance) by swimming; or, to use a specific swimming stroke; or, to compete in a specific swimming event."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58e89eb9-555d-4d35-ac64-2c0ffb1e6ffa",
                                                "sense_id": "a1b1adae-89ea-38aa-837d-3f3e4240a3fa",
                                                "text": "For exercise, we like to swim laps around the pool."
                                            },
                                            {
                                                "example_id": "31a61850-16fd-4fbf-a0e0-e458dfcee8bc",
                                                "sense_id": "a1b1adae-89ea-38aa-837d-3f3e4240a3fa",
                                                "text": "I want to swim the 200-yard breaststroke in the finals."
                                            },
                                            {
                                                "example_id": "776e3643-e59e-498a-b1a5-847697247063",
                                                "sense_id": "a1b1adae-89ea-38aa-837d-3f3e4240a3fa",
                                                "text": "Sometimes he thought to swim the stormy main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f67d7b6-1fc9-3c7e-895b-077d4279b7c4",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To cause to swim."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ebe01b3-2ba8-46d6-849a-efd745b98969",
                                                "sense_id": "3f67d7b6-1fc9-3c7e-895b-077d4279b7c4",
                                                "text": "to swim a horse across a river"
                                            },
                                            {
                                                "example_id": "48815b47-71bf-4217-9428-3c06259c9b9e",
                                                "sense_id": "3f67d7b6-1fc9-3c7e-895b-077d4279b7c4",
                                                "text": "Half of the guinea pigs were swum daily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c945ae-c166-3243-8dca-0a7634078f1c",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To float."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce3e716-a147-43c5-8ccd-ff26b0b5fd61",
                                                "sense_id": "b3c945ae-c166-3243-8dca-0a7634078f1c",
                                                "text": "sink or swim"
                                            },
                                            {
                                                "example_id": "3bde39c1-6bd7-4e71-a4b5-7179de207bd3",
                                                "sense_id": "b3c945ae-c166-3243-8dca-0a7634078f1c",
                                                "text": "There's oil swimming on the water."
                                            },
                                            {
                                                "example_id": "2e79c4fc-00db-4e59-8234-94dc89448a57",
                                                "sense_id": "b3c945ae-c166-3243-8dca-0a7634078f1c",
                                                "text": "Why, now, blow wind, swell billow, and swim bark!\nThe storm is up and all is on the hazard."
                                            },
                                            {
                                                "example_id": "67e698ba-57f1-45c9-aaec-678f2e24dede",
                                                "sense_id": "b3c945ae-c166-3243-8dca-0a7634078f1c",
                                                "text": "And he cut down a stick, and cast it in thither; and the iron did swim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17c1476-2d15-35fe-a857-cec5bd67e427",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To be overflowed or drenched."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "615c3ce5-1b9a-4620-879c-86a4a732da64",
                                                "sense_id": "c17c1476-2d15-35fe-a857-cec5bd67e427",
                                                "text": "I am weary with my groaning; all the night make I my bed to swim; I water my couch with my tears."
                                            },
                                            {
                                                "example_id": "1ef3cdae-3d5c-41f4-9fdb-5aeeab1135c3",
                                                "sense_id": "c17c1476-2d15-35fe-a857-cec5bd67e427",
                                                "text": "Sudden, the ditches ſwell; the meadows ſwim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89b1aab-b5ab-3181-bf8d-ff7c178381d4",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To immerse in water to make the lighter parts float."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e418bf3d-06e0-45f6-9371-b08928566402",
                                                "sense_id": "e89b1aab-b5ab-3181-bf8d-ff7c178381d4",
                                                "text": "to swim wheat in order to select seed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7316415-bcf0-3730-9c84-e55a9443c215",
                                        "entry_id": "b4885697-61f5-3eb0-9025-50deaff0dcb2",
                                        "glosses": [
                                            "To test (a suspected witch) by throwing into a river; those who floated rather than sinking were deemed to be witches."
                                        ],
