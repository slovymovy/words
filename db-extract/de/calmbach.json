                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8578e9-c574-4bbb-bab9-84ff7089e270",
                                "sense_id": "ce18808a-53c2-31cb-a279-8fd1be84d9a3",
                                "text": "Frau Calmbach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "59206efd-0440-4148-8389-70843999dc16",
                                "sense_id": "ce18808a-53c2-31cb-a279-8fd1be84d9a3",
                                "text": "Herr Calmbach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d7d51619-0601-49f0-aef4-daaac841504f",
                                "sense_id": "ce18808a-53c2-31cb-a279-8fd1be84d9a3",
                                "text": "Die Calmbachs kommen heute aus dem Weserbergland."
                            },
                            {
                                "example_id": "4d81f37e-1e03-41e8-870d-bda102513171",
                                "sense_id": "ce18808a-53c2-31cb-a279-8fd1be84d9a3",
                                "text": "Der Calmbach trägt nie die Schals, die die Calmbach ihm strickt."
                            },
                            {
                                "example_id": "ba811f6f-10e1-411e-9e86-6f3d5f4a3ecb",
                                "sense_id": "ce18808a-53c2-31cb-a279-8fd1be84d9a3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Calmbach kommt, geht der Herr Calmbach.“"
                            },
                            {
                                "example_id": "b9e21ef6-ca74-414f-9247-0d6ffdea300e",
                                "sense_id": "ce18808a-53c2-31cb-a279-8fd1be84d9a3",
                                "text": "Calmbach kommt und geht."
                            },
                            {
                                "example_id": "eb43c574-be36-4adc-b157-661c048dccfc",
                                "sense_id": "ce18808a-53c2-31cb-a279-8fd1be84d9a3",
                                "text": "Calmbachs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
