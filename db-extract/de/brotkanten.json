                        "glosses": [
                            "äußere, oft braungebackene Krustenschicht eines Brotlaibs, die härter als das Innere ist und sich am Anfang oder Ende befindet"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
