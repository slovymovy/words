                    {
                        "sense_id": "0d46259e-36ff-3feb-9b70-0382900fd6c9",
                        "entry_id": "9dc860b2-fedf-3714-ab26-f4161885edc4",
                        "glosses": [
                            "czekoladka z nadzieniem"
                        ],
                        "tags": [
                            "cuk."
                        ],
                        "examples": [
                            {
                                "example_id": "1ca218b5-19df-41b3-8851-2f1e0aadd1fc",
                                "sense_id": "0d46259e-36ff-3feb-9b70-0382900fd6c9",
                                "text": "Kup jej pudełko pralin i jakiś kosmetyk."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2330f18d-cf13-428c-b638-5234b9ad1861",
                        "source_entry_id": "9dc860b2-fedf-3714-ab26-f4161885edc4",
                        "source_sense_id": "0d46259e-36ff-3feb-9b70-0382900fd6c9",
                        "target_lang_word": "praline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "praline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d92da90f-5be3-36ac-8638-f6a83bcfa1c1",
                                        "entry_id": "867fcd23-293c-31e5-b8d6-e4b3455b204e",
                                        "glosses": [
                                            "A confection made from almonds and other nuts, caramelized sugar, and sometimes milk or cream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e6d9994-805e-423d-8fb6-a9dd32ec9729",
                                                "sense_id": "d92da90f-5be3-36ac-8638-f6a83bcfa1c1",
                                                "text": "A typical praline is roundish, about three inches in diameter and a half-inch thick. The taste is faintly regressive, reminiscent of the pleasure to be found in a peanut butter and jelly sandwich when one is ravenously hungry."
                                            },
                                            {
                                                "example_id": "672c2c5e-e7ea-4ea1-b2b9-326452afb8ce",
                                                "sense_id": "d92da90f-5be3-36ac-8638-f6a83bcfa1c1",
                                                "text": "And so it is with praline, that crunchy, sweet, nut brittle that marries so irresistibly with chocolate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb42b390-870d-45fd-9cdc-9db80a99e977",
                        "source_entry_id": "9dc860b2-fedf-3714-ab26-f4161885edc4",
                        "source_sense_id": "0d46259e-36ff-3feb-9b70-0382900fd6c9",
                        "target_lang_word": "praline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "praline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aac90423-5db1-348d-8434-0852c60a020a",
                                        "entry_id": "72528acf-e7b7-3074-8a58-7f8623256946",
                                        "glosses": [
                                            "Confiserie obtenue en rissolant une amande dans du sucre (appelé chouchou en Belgique)."
                                        ],
                                        "tags": [
                                            "Confiserie",
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f6a14a2-0f2e-434b-8894-c93a585052b5",
                                                "sense_id": "aac90423-5db1-348d-8434-0852c60a020a",
                                                "text": "Pralines grises, pralines rouges."
                                            },
                                            {
                                                "example_id": "276187d5-af7e-4637-a333-ffc7a200aa4a",
                                                "sense_id": "aac90423-5db1-348d-8434-0852c60a020a",
                                                "text": "Et puis une des attractions du lieu était l’ours aux pralines : j’entrais souvent rien que pour lui rendre visite. Il était en porcelaine et habitait un coin de la cheminée, assis sur son arrière-train."
                                            },
                                            {
                                                "example_id": "f041f588-517b-403c-8c39-12687da0b5c0",
                                                "sense_id": "aac90423-5db1-348d-8434-0852c60a020a",
                                                "text": "Quel pavage désagréable ! je le recommande aux gens qui ont les pieds sensibles ! on dirait des dragées et des pralines posées sur un champ… Aïe !"
                                            },
                                            {
                                                "example_id": "3b1be0f9-a2e7-4f74-aa1e-d02de090665f",
                                                "sense_id": "aac90423-5db1-348d-8434-0852c60a020a",
                                                "text": "Ils optent pour le saucisson brioché, la quenelle de Lyon et la tarte tatin aux pralines. Le tout accompagné de « Beaujolais village »"
                                            },
                                            {
                                                "example_id": "2e5807db-d5c6-409b-8106-1fa1a150f649",
                                                "sense_id": "aac90423-5db1-348d-8434-0852c60a020a",
                                                "text": "La cochenille E 120 est responsable du rose éclatant des pralines lyonnaises, du rouge givré du sucre enrobant des fameuses petites guimauves en forme de fraise, et même du carmin pourpre du salami industriel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bac07e14-33ba-3e4a-8402-7debcff2f198",
                                        "entry_id": "72528acf-e7b7-3074-8a58-7f8623256946",
                                        "glosses": [
                                            "Petite friandise au chocolat fourré vendue dans des ballotins, prisées en Belgique."
                                        ],
                                        "tags": [
                                            "Confiserie",
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1d0ab9-f016-4a5e-9ad5-5d2512599d80",
                                                "sense_id": "bac07e14-33ba-3e4a-8402-7debcff2f198",
                                                "text": "Il m’apporte des bonbons, des pralines ! Oh ! que c’est bon, le chocolat praliné !..."
                                            },
                                            {
                                                "example_id": "49f69800-be2b-4fb5-b4dd-c84b0c9b2c6d",
                                                "sense_id": "bac07e14-33ba-3e4a-8402-7debcff2f198",
                                                "text": "Le ballotin, petit contenant en carton dans lequel les pralines peuvent voyager sans s’écraser, inventé en 1915 par Jean Neuhaus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9b15ac0-fedf-347c-a501-7cb5a9dda1e7",
                                        "entry_id": "72528acf-e7b7-3074-8a58-7f8623256946",
                                        "glosses": [
                                            "Coup de poing."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7f749fd-1866-44e7-ac44-9e02c53b7a7d",
                                                "sense_id": "d9b15ac0-fedf-347c-a501-7cb5a9dda1e7",
                                                "text": "Dzing ! une praline en pleine tronche, schplaf ! les éclats d’un manche à gigot dans les guibolles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac4e631d-2c62-3fdf-a810-c1653d8b1586",
                                        "entry_id": "72528acf-e7b7-3074-8a58-7f8623256946",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1b9df84-311d-4069-8938-8788d34d1090",
                                                "sense_id": "ac4e631d-2c62-3fdf-a810-c1653d8b1586",
                                                "text": "Pour la photo, on préférera la praline glissée de Schär dans les arrêts de jeu, droit dans la lucarne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "praline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9fb1b31-0e3f-301f-963a-9266bc6f5764",
                                        "entry_id": "37e1f3e3-95bd-3975-8b1b-13c19a400e1d",
