                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb677dfe-665d-32c7-bb23-e4cd617a71d7",
                                        "entry_id": "4a8831de-a755-31ff-a65d-db076d0a5c7a",
                                        "glosses": [
                                            "Geschlechtsakt zwischen verschiedengeschlechtlichen Individuen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5e6573-e370-49d3-a487-198ddb73bc82",
                                                "sense_id": "cb677dfe-665d-32c7-bb23-e4cd617a71d7",
                                                "text": "„Nicht einmal die Art der Kopulation mancher Walarten sei bekannt.“"
                                            },
                                            {
                                                "example_id": "d903f3e0-842c-4cac-a6a9-13b32a613619",
                                                "sense_id": "cb677dfe-665d-32c7-bb23-e4cd617a71d7",
                                                "text": "„Als Kind eines Bauern mit den Begattungsakten der Hof-Tiere gut vertraut, war Ursula auf sexuellem Gebiet weder verklemmt noch gehemmt; weshalb am Anfang ihrer Ehe das Sexleben mit Piontek auch temperamentvoll und keineswegs phantasielos war; wobei sie, lustverwirrt, Pionteks Art der Kopulation akzeptiert hat, ihre Kinder mit erdzugewandtem Gesicht zu empfangen; was sie, ihm nicht nur sexuell verfallen, nicht als demütigend empfunden hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
