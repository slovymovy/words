                "translations": [
                    {
                        "translation_id": "56ca289c-3f44-4d38-bf88-78d11b9b5d5c",
                        "source_entry_id": "48436cf5-cb67-3ecf-9ce0-57690793fe01",
                        "source_sense_id": "e44acfad-5df6-378e-9094-14ab207d880c",
