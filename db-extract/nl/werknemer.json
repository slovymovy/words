                    {
                        "sense_id": "1980ba88-d1da-3fdd-9aa0-51f201ee7bcc",
                        "entry_id": "7f249f00-4687-376c-bd5b-ef5c1f101321",
                        "glosses": [
                            "iemand die voor een ander werkt en daarvoor betaald wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "757c33b5-e9a0-48fc-b2d8-5f4c2848053d",
                                "sense_id": "1980ba88-d1da-3fdd-9aa0-51f201ee7bcc",
                                "text": "Hij is aangesloten bij een vereniging van werknemers."
                            },
                            {
                                "example_id": "7aa727b2-c019-4256-9ab3-dffa614f16a9",
                                "sense_id": "1980ba88-d1da-3fdd-9aa0-51f201ee7bcc",
                                "text": "Burn-outs zijn tegenwoordig beroepsziekte nummer 1.Het NRC meldt dat meer dan 14 procent van de werknemers jaarlijks burn-outklachten ondervindt."
                            },
                            {
                                "example_id": "76d772dc-af06-4d80-895c-bd3633afcdf1",
                                "sense_id": "1980ba88-d1da-3fdd-9aa0-51f201ee7bcc",
                                "text": "Volgens Depla, het Bredase college en de gemeenteraad is de dj ook op economisch vlak belangrijk voor de stad. Bij het platenlabel van Hardwell is de helft van de werknemers uit Breda afkomstig. Daarnaast helpt hij jonge talenten om zich verder te ontwikkelen en geeft hij Bredase dj's en producers een kans om door te breken door ze in zijn voorprogramma te laten optreden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec686af6-ef69-47e3-934b-8fc8c83e7652",
                        "source_entry_id": "7f249f00-4687-376c-bd5b-ef5c1f101321",
                        "source_sense_id": "1980ba88-d1da-3fdd-9aa0-51f201ee7bcc",
