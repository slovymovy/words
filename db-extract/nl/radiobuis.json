                        "source_sense_id": "8a553d9e-a06d-3b9c-83d6-cb8fb7c283c0",
                        "target_lang_word": "tube",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tube",
