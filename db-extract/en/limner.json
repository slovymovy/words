                        "glosses": [
                            "Someone who limns or portrays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6fbc0f-9396-4f9a-b98e-97fe7396c264",
                                "sense_id": "4293d7d6-158d-3f5a-a298-02ea79878d77",
                                "text": "Whether the skies be bright or cloudy,—whether the earth be clothed with flowers, or deformed with tempests,—the art of the limner has surrounded you with ‘a new heaven and a new earth;’ and you may bask in suns that never set, while the heavens are dark to other eyes,—and luxuriate amid landscapes and flowers, while half your fellow-creatures are perishing amid snows and tempests!"
                            },
                            {
                                "example_id": "693b2629-1f14-4d1f-bba1-c461be0271ac",
                                "sense_id": "4293d7d6-158d-3f5a-a298-02ea79878d77",
                                "text": "In Sir Henry Meredith's appearance there was nothing that won upon the sight, though the limner had done his best for him. The countenance had no character. But his consort was indeed lovely, like, and yet not like, the daughter who now watched her."
                            }
                        ]
                    }
