                "senses": [
                    {
                        "sense_id": "6bab69d8-cdcd-3702-ae75-15a8d55b55c4",
                        "entry_id": "55653063-7fac-360e-a9c4-e68bd69e5b77",
                        "glosses": [
                            "A non-Hawaiian, usually specifically a white."
                        ],
                        "tags": [
                            "Hawaii",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "02b633e3-19dd-4036-98e5-020f4c6a402b",
                                "sense_id": "6bab69d8-cdcd-3702-ae75-15a8d55b55c4",
                                "text": "I had never known any haoles except Elmer and Marks and they were ice cold affairs. Everyone was always glad when their twice-a-month visit was pau. The very island seemed to sigh with relief […]"
                            },
                            {
                                "example_id": "557221ce-1f57-4790-a0da-3f95d9857b4b",
                                "sense_id": "6bab69d8-cdcd-3702-ae75-15a8d55b55c4",
                                "text": "And the white guy who ate Rice-A-Roni with butter was the haole who didn’t speak pidgin or eat real rice."
                            },
                            {
                                "example_id": "2e7adf80-78f9-4bd9-858f-46dbbb26d78b",
                                "sense_id": "6bab69d8-cdcd-3702-ae75-15a8d55b55c4",
                                "text": "Commerce was flourishing in the kingdom and the rising merchant class was made up largely of haole rather than Hawaiians."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
