                "senses": [
                    {
                        "sense_id": "e3559f85-21ab-3f92-8938-1d651995f41b",
                        "entry_id": "839ab6c6-1c1f-346f-8668-1068dcc425a6",
                        "glosses": [
                            "sehr großes Schiff, das im Überseeverkehr verkehrt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dc24598c-0e12-4be7-8f8e-85e50f3f58c7",
                                "sense_id": "e3559f85-21ab-3f92-8938-1d651995f41b",
                                "text": "Vom Strand aus sahen sie zwei Ozeanriesen."
                            },
                            {
                                "example_id": "f3082f91-9ac1-4fee-ae07-2bba959a7812",
                                "sense_id": "e3559f85-21ab-3f92-8938-1d651995f41b",
                                "text": "„Die Reeder hätten sich zum Bau neuer Ozeanriesen aufgestachelt.“"
                            },
                            {
                                "example_id": "d3a3233e-9faa-47a1-ae43-2f32cc085b90",
                                "sense_id": "e3559f85-21ab-3f92-8938-1d651995f41b",
                                "text": "„Wer es sich leisten konnte, war an Bord des ausgebuchten Ozeanriesen, als dieser am 16. Juli 1929 unter Kapitän Leopold Ziegenbein in Bremerhaven ablegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
