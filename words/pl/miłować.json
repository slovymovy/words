    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2901ad48-64fc-3484-b666-aa97e088f581",
                    "sense_definition": "darzyć kogoś głębokim uczuciem miłości",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uczucie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kaziu, czy ty naprawdę mnie <w>miłujesz</w> tak mocno jak dawniej?",
                            "target_lang_translations": {
                                "en": "Kaziu, do you really <w>love</w> me as deeply as you used to?"
                            }
                        },
                        {
                            "text": "Przecież obiecywaliście wiernie <w>miłować</w> go z całego serca i ze wszystkich swoich sił.",
                            "target_lang_translations": {
                                "en": "After all, you promised to faithfully <w>love</w> him with all your heart and with all your strength."
                            }
                        }
                    ],
                    "synonyms": [
                        "kochać"
                    ],
                    "common_phrases": [
                        "miłować z całego serca",
                        "miłować bliźniego"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "często w kontekście podniosłym lub religijnym"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to have a deep feeling of love for someone, often in an elevated, solemn, or religious sense"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "love",
                                "target_lang_sense_clarification": "to have deep, profound affection for someone"
                            },
                            {
                                "target_lang_word": "cherish",
                                "target_lang_sense_clarification": "to hold dear and treat with affectionate care"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8ec429b-cf1b-3585-84ad-0eb75ed5997e",
                    "sense_definition": "darzyć się wzajemną miłością, kochać siebie nawzajem",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uczucie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To jest najważniejsze przykazanie, abyście wzajemnie się <w>miłowali</w> w każdej chwili.",
                            "target_lang_translations": {
                                "en": "This is the greatest commandment: that you <w>love one another</w> at all times."
                            }
                        },
                        {
                            "text": "Młodzi małżonkowie przysięgali przed ołtarzem, że będą się <w>miłować</w> aż po kres życia.",
                            "target_lang_translations": {
                                "en": "The young newlyweds swore before the altar that they would <w>love each other</w> until the end of their lives."
                            }
                        }
                    ],
                    "synonyms": [
                        "kochać się"
                    ],
                    "common_phrases": [
                        "wzajemnie się miłować",
                        "miłować się nawzajem"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "styl książkowy lub biblijny"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to love one another; to share mutual love"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "love one another",
                                "target_lang_sense_clarification": "reciprocal love between people"
                            },
                            {
                                "target_lang_word": "love each other",
                                "target_lang_sense_clarification": "mutual affection"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13c916e0-7308-3b63-bffb-1b97d9ca23fb",
                    "sense_definition": "odczuwać wielkie zamiłowanie do czegoś, uwielbiać coś robić",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zamiłowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Celestyna od dziecka <w>miłowała</w> wędrowanie połoninami, często uciekając samotnie w dzikie Bieszczady.",
                            "target_lang_translations": {
                                "en": "Ever since childhood, Celestyna <w>loved</w> hiking along mountain meadows, often escaping alone into the wild Bieszczady Mountains."
                            }
                        },
                        {
                            "text": "Stary poeta ponad wszystko <w>miłował</w> spokój wiejskiego poranka oraz zapach kwitnących łąk.",
                            "target_lang_translations": {
                                "en": "Above all else, the old poet <w>cherished</w> the tranquility of a countryside morning and the scent of blooming meadows."
                            }
                        }
                    ],
                    "synonyms": [
                        "kochać"
                    ],
                    "common_phrases": [
                        "miłować wolność",
                        "miłować spokój"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "użycie literackie i przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to hold a great fondness or passion for something; to treasure or delight in an activity or state"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "love",
                                "target_lang_sense_clarification": "to be strongly fond of or delight in something"
                            },
                            {
                                "target_lang_word": "cherish",
                                "target_lang_sense_clarification": "to hold something dear, such as peace or freedom"
                            },
                            {
                                "target_lang_word": "treasure",
                                "target_lang_sense_clarification": "to value greatly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
