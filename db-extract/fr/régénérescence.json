                            {
                                "example_id": "0a55aae4-6892-4e31-bf64-c6c7a36a8802",
                                "sense_id": "0a14b689-24d1-3c2e-b82e-72a6edf89bd7",
                                "text": "La régénérescence des tissus."
                            },
                            {
                                "example_id": "7bf86a12-e3e7-46b7-b70d-a756c3ff5f41",
                                "sense_id": "0a14b689-24d1-3c2e-b82e-72a6edf89bd7",
                                "text": "Il est donc souvent nécessaire d’apporter une nourriture riche au départ pour favoriser une bonne régénérescence des tissus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
