                                "target_senses": [
                                    {
                                        "sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                                        "entry_id": "e91344dc-3300-30f0-876a-4105f47f4dcc",
                                        "glosses": [
                                            "Zustand, in dem etwas vorhanden, existent ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0cf91b-c89a-45c2-9d39-4900cff93c3b",
                                                "sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                                                "text": "Der Vermieter bestreitet das Vorhandensein von Schimmel in der Wohnung."
                                            },
                                            {
                                                "example_id": "a2886bdc-3f05-48ca-b050-ac2d6c4bf14c",
                                                "sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                                                "text": "Das Vorhandensein von Katzen lässt sich schwer leugnen."
                                            }
