                ],
                "senses": [
                    {
                        "sense_id": "9483180a-7845-3866-b5d3-4abbd3883829",
                        "entry_id": "888b9196-ab2f-38d6-a898-86f419da87a9",
                        "glosses": [
                            "Allgemeinbildende Höhere Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d65d08-b620-4001-8885-bb06be81afb2",
                                "sense_id": "9483180a-7845-3866-b5d3-4abbd3883829",
                                "text": "„Wer in die AHS übertritt, realisiert die von der Volksschule zertifizierte Eignung für den Besuch einer AHS und hat damit, wenn den Anforderungen zumindest im Wesentlichen entsprochen wird, die Aussicht auf eine garantierte, durchgehende Schullaufbahn von acht Jahren.“"
                            },
                            {
                                "example_id": "fa443997-3c69-4f2b-a788-ecf56a1472d2",
                                "sense_id": "9483180a-7845-3866-b5d3-4abbd3883829",
                                "text": "„Sowohl in den BHS als auch den AHS machen die Mädchen unter den Lese-Spitzenschüler/innen deutliche Mehrheiten aus: …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00cd0118-5c94-35d3-a333-a2caad2140ba",
                        "entry_id": "888b9196-ab2f-38d6-a898-86f419da87a9",
                        "glosses": [
                            "historisch: Adolf-Hitler-Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0181d959-f75d-4522-aea3-c8fbdefb0950",
                                "sense_id": "00cd0118-5c94-35d3-a333-a2caad2140ba",
                                "text": "„Die offizielle Einweihung der ersten AHS erfolgte durch Ley und von Schirach zum 20.04.1937 auf der Ordensburg Crössinsee.“"
                            },
                            {
                                "example_id": "b89613de-184d-4f60-b781-a05543b3838a",
                                "sense_id": "00cd0118-5c94-35d3-a333-a2caad2140ba",
                                "text": "„Das Angebot der Sportmöglichkeiten an den AHS war nicht so vielfältig, wie das der Napolas.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
