                "senses": [
                    {
                        "sense_id": "47570c21-a15f-3489-9177-874b17024562",
                        "entry_id": "46cdb152-db3f-3b0f-94e2-8e74ca7d59b7",
                        "glosses": [
                            "Verser préalablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf9573e-62c6-4e7b-b26f-905bdfdd53be",
                                "sense_id": "47570c21-a15f-3489-9177-874b17024562",
                                "text": "SI ce n'est pas le cas, vous pourrez user de cet argument pour récupérer la somme pré-versée."
                            },
                            {
                                "example_id": "78654f49-3c29-4b5f-aacd-bee37265a46f",
                                "sense_id": "47570c21-a15f-3489-9177-874b17024562",
                                "text": "Si toutefois la réservation a été validée, le coût de l'annulation avant la date d'engagement s'élèvera à 20% du montant total de la durée d'engagement annoncé dans le contrat de location et sera retiré sur la franchise pré-versée."
                            },
                            {
                                "example_id": "97a30be3-e013-4469-8e5d-b76ac1e31dab",
                                "sense_id": "47570c21-a15f-3489-9177-874b17024562",
                                "text": "Si vous êtes intéressé par son projet, vous pouvez vous engager à pré-verser une contribution en échange d’une rétribution (une place de concert, une revue, un album, etc.)."
                            }
                        ]
