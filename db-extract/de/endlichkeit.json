                "senses": [
                    {
                        "sense_id": "cd8b3425-fc13-3321-9393-0d8e34b221cc",
                        "entry_id": "9d6c409f-c361-3777-9f5b-d7f38eeb6ed3",
                        "glosses": [
                            "begrenzter Zustand; räumliches oder zeitliches Ausmaß, dessen Grenzen absehbar sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e010ee6-3921-4a84-9fb6-7c3e43f190b3",
                                "sense_id": "cd8b3425-fc13-3321-9393-0d8e34b221cc",
                                "text": "„Damit kommt die Endlichkeit ins Spiel.“"
                            },
                            {
                                "example_id": "d4aae1f9-d9dd-4628-8467-c738fdbdbb65",
                                "sense_id": "cd8b3425-fc13-3321-9393-0d8e34b221cc",
                                "text": "„In seiner ersten Jenaer Publikation, der Differenz des Fichteschen und Schellingschen Systems der Philosophie von 1801, bezeichnet es Hegel als die Aufgabe der Philosophie, die Endlichkeiten des Bewusstseins zu überwinden und das Absolute im Bewusstsein zu konstruieren.“"
                            },
                            {
                                "example_id": "236655d5-b09b-478c-8937-97b6a629bfea",
                                "sense_id": "cd8b3425-fc13-3321-9393-0d8e34b221cc",
                                "text": "„Die Endlichkeit der Einbildungskraft meint nämlich in unserem Kontext nichts anderes, als dass es einen wissenschaftstheoretischen Ort gibt, der nicht mehr von der Einbildungskraft eingenommen werden kann.“"
                            },
                            {
                                "example_id": "c9ab1273-be93-429d-b2c4-51fd52d01fb2",
                                "sense_id": "cd8b3425-fc13-3321-9393-0d8e34b221cc",
                                "text": "„Ein bekanntes Beispiel einer gelungenen sozialen Praxis des Umgangs mit der Endlichkeit einer natürlichen Ressource stellt die nachhaltige Waldbewirtschaftung in einigen Gegenden Mitteleuropas dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
