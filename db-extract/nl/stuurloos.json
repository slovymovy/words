                        ]
                    },
                    {
                        "translation_id": "665a0ac1-f275-4962-bf61-fa806cb4bb67",
                        "source_entry_id": "fa655e6a-9281-3d99-bafc-dff78eeede76",
                        "source_sense_id": "41696c2e-fffd-3719-8c0a-ee2b1961e021",
                        "source_sense_description": "zonder sturing in sociaal opzicht",
                        "target_lang_word": "adrift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adrift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8531fc-722a-3a2e-b4ca-d9bcf55b76cd",
                                        "entry_id": "d55653e8-d0fe-383c-9f31-b2cf03a6716e",
                                        "glosses": [
                                            "Floating at random."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49cfcd0b-fe71-40e0-9449-6fb2a95f8b00",
                                                "sense_id": "5b8531fc-722a-3a2e-b4ca-d9bcf55b76cd",
                                                "text": "So on the sea she shall be set adrift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcbbb004-fd52-3b41-9f7b-7243e299c38d",
                                        "entry_id": "d55653e8-d0fe-383c-9f31-b2cf03a6716e",
                                        "glosses": [
                                            "Absent from his watch."
                                        ],
                                        "tags": [
                                            "of a seaman"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bc6d1d0-8762-38ad-a521-5db6e5c6b1a2",
                                        "entry_id": "d55653e8-d0fe-383c-9f31-b2cf03a6716e",
                                        "glosses": [
                                            "Behind one's opponents, or below a required threshold in terms of score, number or position."
                                        ],
                                        "tags": [
                                            "UK",
                                            "often",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03cc3062-b013-4506-83fa-2dac9589388c",
                                                "sense_id": "6bc6d1d0-8762-38ad-a521-5db6e5c6b1a2",
                                                "text": "The team were six points adrift of their rivals."
                                            },
                                            {
                                                "example_id": "f7758bf8-3008-495e-b8a9-7b9834629a61",
                                                "sense_id": "6bc6d1d0-8762-38ad-a521-5db6e5c6b1a2",
                                                "text": "The Czech Republic in 1994-95, with a pegged nominal exchange rate and nominal deposit rates of 7 percent, was several percentage points adrift of the interest parity condition."
                                            },
                                            {
                                                "example_id": "51dfcceb-345c-4429-b0d6-2b4fd08afc96",
                                                "sense_id": "6bc6d1d0-8762-38ad-a521-5db6e5c6b1a2",
                                                "text": "He did well, coming second, but Toyota and Mitsubishi were now neck-and-neck, with the Subaru team 38 points adrift of the leaders."
                                            },
                                            {
                                                "example_id": "131db05b-9fba-44c7-a06f-d173a83c260e",
                                                "sense_id": "6bc6d1d0-8762-38ad-a521-5db6e5c6b1a2",
                                                "text": "Boro were left needing snookers after a toothless goalless draw with Dead Men Walking Doncaster left them well adrift and fading in the chase for a Championship play-off place."
                                            },
                                            {
                                                "example_id": "574e780f-40d8-42f8-bf01-463183b8da3a",
                                                "sense_id": "6bc6d1d0-8762-38ad-a521-5db6e5c6b1a2",
                                                "text": "Brendan Rodgers's team moved into the top 10 in the Premier League table, but they are nine points adrift of West Ham in fourth place, while Arsenal are sixth."
                                            },
                                            {
                                                "example_id": "355400ba-6d93-4070-9bd8-3e2f15093099",
                                                "sense_id": "6bc6d1d0-8762-38ad-a521-5db6e5c6b1a2",
                                                "text": "Treasury could also ask why High Speed 2's finances are so adrift from what was promised. The answers will make for difficult DfT reading, because it can't escape the fact that it has been the government department overseeing rail spending for the past 20 years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adrift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd83169-f047-35a6-adc9-b661b9a5cd54",
                                        "entry_id": "694f950e-c275-3061-bdd0-381ecd1f518f",
                                        "glosses": [
                                            "In a drifting condition; at the mercy of wind and waves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "669f4e94-8afa-46cd-80d1-857e1a86cb0d",
                                                "sense_id": "ddd83169-f047-35a6-adc9-b661b9a5cd54",
                                                "text": "things wore on till eight or nine o'clock, every thing getting adrift and being smashed, and every one on board jamming themselves up in corners or holding on to beams to prevent their going adrift likewise"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
