                        "pl": [
                            {
                                "target_lang_word": "minimum",
                                "target_lang_sense_clarification": "najmniejsza ilość"
                            },
                            {
                                "target_lang_word": "ograniczenie do minimum",
                                "target_lang_sense_clarification": "zredukowanie czegoś do najmniejszego stopnia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ad33922-b487-3915-bc1b-d5d44fac1066",
                    "sense_definition": "A lower bound of a set or the lowest value of a mathematical function.",
