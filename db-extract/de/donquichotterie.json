                "senses": [
                    {
                        "sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                        "entry_id": "636e4314-7b3d-33d6-b68f-e065577b324f",
                        "glosses": [
                            "lächerliches Vorhaben, das von vornherein zum Scheitern verurteilt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df00c600-a166-4918-b4d8-737bb42af1b2",
                                "sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                                "text": "„Die Resolution fordert die Beendigung der militärischen Kämpfe – vor allem von der Hisbollah –, eine von der UNO gesicherte ‚Pufferzone‘ allein auf libanesischem Gebiet, den Rückzug Israels, die gegenseitige Respektierung der Grenze sowie die Entwaffnung der Milizen im Libanon und das Verbot von Waffenlieferungen an diese. Hierin spiegelt sich die Donquichotterie des ‚Krieges gegen den Terror‘ wider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08e908e0-9e18-4f71-a280-a9e6bad6cc86",
                        "source_entry_id": "636e4314-7b3d-33d6-b68f-e065577b324f",
                        "source_sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                        "source_sense_description": "lächerliches Vorhaben, das von vornherein zum Scheitern verurteilt ist",
                        "target_lang_word": "quixotic project",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6b128b22-fc5a-40dd-aa0b-c11fbaf01086",
                        "source_entry_id": "636e4314-7b3d-33d6-b68f-e065577b324f",
                        "source_sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                        "source_sense_description": "lächerliches Vorhaben, das von vornherein zum Scheitern verurteilt ist",
                        "target_lang_word": "quixotism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quixotism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4209859-e582-3292-bb29-8881ffea02d3",
                                        "entry_id": "e4622505-4cf1-3ea4-b19c-ed03954ab3dc",
                                        "glosses": [
                                            "A form of idealism and delusion which leads to extravagant and absurd undertakings or sacrifices in obedience to a morbidly romantic ideal of duty or honor, as illustrated by the exploits of Don Quixote in knight-errantry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "938c8514-83c2-4766-b190-5011458a5c6d",
                                                "sense_id": "c4209859-e582-3292-bb29-8881ffea02d3",
                                                "text": "M. Georges Berry, the Paris municipal councilor, has broken many a lance in tilting against old, and in some cases, time honored, abuses, and for his pains has not infrequently heard it suggested that there was a dash of Quixotism in his composition."
                                            },
                                            {
                                                "example_id": "4791036e-a8d4-4e12-8f06-056694e55269",
                                                "sense_id": "c4209859-e582-3292-bb29-8881ffea02d3",
                                                "text": "For the rest of his life, [Miguel de] Unamuno urged his fellow Spaniards to practice quixotism, which meant adopting the moral courage necessary to fight for lost causes without caring what the world thinks."
                                            },
                                            {
                                                "example_id": "d4bdedc6-1e4d-49bd-af7e-b336ef749721",
                                                "sense_id": "c4209859-e582-3292-bb29-8881ffea02d3",
                                                "text": "Berners-Lee, too, remembers the quixotism of the era. “The spirit there was very decentralized. The individual was incredibly empowered. It was all based on there being no central authority that you had to go to to ask permission,” he said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5b3fc0-ad90-4c9d-9150-6651c5b09c49",
                        "source_entry_id": "636e4314-7b3d-33d6-b68f-e065577b324f",
                        "source_sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                        "source_sense_description": "lächerliches Vorhaben, das von vornherein zum Scheitern verurteilt ist",
                        "target_lang_word": "quixotry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quixotry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd484618-bb95-36c6-85f8-3b35191e3691",
                                        "entry_id": "7d3d28fc-239d-3884-ab1a-a059cc5a9e74",
                                        "glosses": [
                                            "A wild, visionary idea, an eccentric notion or act; a quixotism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8806a4-605e-4f26-aef2-cf8dd017ec38",
                                                "sense_id": "dd484618-bb95-36c6-85f8-3b35191e3691",
                                                "text": "She knew that her brother was capable of any quixotry, any excess."
                                            },
                                            {
                                                "example_id": "7d9becd8-46a6-4124-add8-4d65558c53ac",
                                                "sense_id": "dd484618-bb95-36c6-85f8-3b35191e3691",
                                                "text": "His quixotry might exasperate, but could not affront, them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2d9045e-903c-4d50-a844-8ca25a1f93eb",
                        "source_entry_id": "636e4314-7b3d-33d6-b68f-e065577b324f",
                        "source_sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                        "source_sense_description": "lächerliches Vorhaben, das von vornherein zum Scheitern verurteilt ist",
                        "target_lang_word": "knight errantry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "49496df7-fb16-4eb4-a198-5d19b26fff34",
                        "source_entry_id": "636e4314-7b3d-33d6-b68f-e065577b324f",
                        "source_sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                        "source_sense_description": "lächerliches Vorhaben, das von vornherein zum Scheitern verurteilt ist",
                        "target_lang_word": "donquichottisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donquichottisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "065a40bf-c9d9-3cd8-8bea-7abfdcd8338a",
                                        "entry_id": "4d9b54d9-29ec-3283-af49-2f92335e59df",
                                        "glosses": [
                                            "Attitude militante déterminée mais peu réaliste, voire délirante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92439520-c020-4e55-bdb1-1565c7261117",
                                                "sense_id": "065a40bf-c9d9-3cd8-8bea-7abfdcd8338a",
                                                "text": "A la tranquille certitude dont le romancier naturaliste ou réaliste fait preuve à cet égard, le donquichottisme oppose un doute qu’il ne peut mieux exprimer qu’en y conformant sa manière d’écrire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
