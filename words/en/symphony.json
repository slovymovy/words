{
    "word_family": [
        "symphonic",
        "symphonist",
        "symphonize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "965dff26-0725-3fef-9592-110256120fac",
                    "sense_definition": "An extended piece of music of sophisticated structure, usually for an orchestra.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "musical_composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra performed Beethoven’s Fifth <w>symphony</w>.",
                            "target_lang_translations": {
                                "ru": "Оркестр исполнил Пятую <w>симфонию</w> Бетховена.",
                                "zh": "管弦乐团演奏了贝多芬的第五<w>交响曲</w>。",
                                "es": "La orquesta interpretó la Quinta <w>sinfonía</w> de Beethoven.",
                                "tr": "Orkestra, Beethoven'ın Beşinci <w>senfonisini</w> icra etti.",
                                "de": "Das Orchester spielte Beethovens fünfte <w>Sinfonie</w>."
                            }
                        },
                        {
                            "text": "He spent many years trying to compose a perfect <w>symphony</w>.",
                            "target_lang_translations": {
                                "ru": "Он потратил много лет, пытаясь сочинить идеальную <w>симфонию</w>.",
                                "zh": "他花了多年时间试图创作一部完美的<w>交响曲</w>。",
                                "es": "Pasó muchos años intentando componer una <w>sinfonía</w> perfecta.",
                                "tr": "Mükemmel bir <w>senfoni</w> bestelemek için yıllarını harcadı.",
                                "de": "Er verbrachte viele Jahre damit, eine perfekte <w>Sinfonie</w> zu komponieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "composition",
                        "opus",
                        "piece"
                    ],
                    "common_phrases": [
                        "classical symphony",
                        "compose a symphony",
                        "fifth symphony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое музыкальное произведение сложной структуры, обычно для оркестра",
                        "zh": "一种结构复杂的大型管弦乐作品。",
                        "es": "Una obra musical extensa de estructura compleja, generalmente compuesta para una orquesta.",
                        "tr": "Genellikle orkestra için yazılmış, karmaşık bir yapıya sahip uzun müzik eseri.",
                        "de": "Ein umfangreiches Musikstück komplexer Struktur, meist für ein Orchester geschrieben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симфония",
                                "target_lang_sense_clarification": "музыкальное произведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交响曲",
                                "target_lang_sense_clarification": "音乐作品"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sinfonía",
                                "target_lang_sense_clarification": "obra musical para orquesta"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "senfoni",
                                "target_lang_sense_clarification": "müzik eseri"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sinfonie",
                                "target_lang_sense_clarification": "musikalisches Werk für Orchester"
                            },
                            {
                                "target_lang_word": "Symphonie",
                                "target_lang_sense_clarification": "alternative Schreibweise für ein Orchesterwerk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71a59431-fe3f-3f6b-b2cb-7e204521247a",
                    "sense_definition": "A symphony orchestra.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "musical_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She plays the violin in the local <w>symphony</w>.",
                            "target_lang_translations": {
                                "ru": "Она играет на скрипке в местном <w>симфоническом оркестре</w>.",
                                "zh": "她在当地的<w>交响乐团</w>里拉小提琴。",
                                "es": "Ella toca el violín en la <w>orquesta sinfónica</w> local.",
                                "tr": "Yerel <w>senfoni</w> orkestrasında keman çalıyor.",
                                "de": "Sie spielt Geige im örtlichen <w>Sinfonieorchester</w>."
                            }
                        },
                        {
                            "text": "We bought tickets to see the <w>symphony</w> perform last night.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты, чтобы посмотреть выступление <w>симфонического оркестра</w> вчера вечером.",
                                "zh": "我们昨晚买了票去观看<w>交响乐团</w>的演出。",
                                "es": "Compramos entradas para ver actuar a la <w>orquesta sinfónica</w> anoche.",
                                "tr": "Dün gece <w>senfoni</w> orkestrasının performansını izlemek için bilet aldık.",
                                "de": "Wir haben gestern Abend Karten für das <w>Sinfonieorchester</w> gekauft."
                            }
                        }
                    ],
                    "synonyms": [
                        "orchestra",
                        "philharmonic"
                    ],
                    "common_phrases": [
                        "play in the symphony",
                        "national symphony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Симфонический оркестр",
                        "zh": "指代交响乐团。",
                        "es": "Una orquesta sinfónica.",
                        "tr": "Senfoni orkestrası.",
                        "de": "Ein Sinfonieorchester."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симфонический оркестр",
                                "target_lang_sense_clarification": "музыкальный коллектив"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交响乐团",
                                "target_lang_sense_clarification": "音乐团体"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "orquesta sinfónica",
                                "target_lang_sense_clarification": "conjunto musical"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "senfoni orkestrası",
                                "target_lang_sense_clarification": "müzik topluluğu"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sinfonieorchester",
                                "target_lang_sense_clarification": "großes Orchester"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dead0cc-9ecc-388b-a409-5e6c254ba982",
                    "sense_definition": "A harmonious combination of elements, such as sounds or colors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_harmony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She described the city at night as a <w>symphony</w> of lights and sounds.",
                            "target_lang_translations": {
                                "ru": "Она описала ночной город как <w>симфонию</w> огней и звуков.",
                                "zh": "她形容夜晚的城市是一场光影与声音的<w>交响</w>。",
                                "es": "Describió la ciudad de noche como una <w>sinfonía</w> de luces y sonidos.",
                                "tr": "Gece şehri, ışıkların ve seslerin bir <w>senfonisi</w> olarak tanımladı.",
                                "de": "Sie beschrieb die Stadt bei Nacht als eine <w>Symphonie</w> aus Lichtern und Klängen."
                            }
                        },
                        {
                            "text": "The garden in spring was a <w>symphony</w> of bright colors.",
                            "target_lang_translations": {
                                "ru": "Весенний сад был <w>симфонией</w> ярких красок.",
                                "zh": "春天的花园是一场色彩斑斓的<w>交响</w>。",
                                "es": "El jardín en primavera era una <w>sinfonía</w> de colores brillantes.",
                                "tr": "Baharın gelişiyle bahçe, parlak renklerin bir <w>senfonisiydi</w>.",
                                "de": "Der Garten im Frühling war eine <w>Symphonie</w> aus leuchtenden Farben."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmony",
                        "blend"
                    ],
                    "antonyms": [
                        "cacophony",
                        "discord"
                    ],
                    "common_phrases": [
                        "symphony of lights",
                        "symphony of flavors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гармоничное сочетание элементов, таких как звуки или цвета",
                        "zh": "指多种元素（如声音或色彩）的和谐组合。",
                        "es": "Una combinación armoniosa de elementos, como sonidos o colores.",
                        "tr": "Sesler veya renkler gibi unsurların uyumlu birleşimi.",
                        "de": "Ein harmonisches Zusammenspiel verschiedener Elemente, wie etwa Klänge oder Farben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симфония",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "гармония",
                                "target_lang_sense_clarification": "сочетание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交响",
                                "target_lang_sense_clarification": "比喻义，和谐的组合"
                            },
                            {
                                "target_lang_word": "和谐",
                                "target_lang_sense_clarification": "协调一致"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sinfonía",
                                "target_lang_sense_clarification": "uso figurado para una combinación armoniosa"
                            },
                            {
                                "target_lang_word": "armonía",
                                "target_lang_sense_clarification": "combinación equilibrada de elementos"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "senfoni",
                                "target_lang_sense_clarification": "mecazi anlamda uyum"
                            },
                            {
                                "target_lang_word": "uyum",
                                "target_lang_sense_clarification": "ahenk"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Symphonie",
                                "target_lang_sense_clarification": "übertragene Bedeutung für ein harmonisches Zusammenspiel"
                            },
                            {
                                "target_lang_word": "Harmonie",
                                "target_lang_sense_clarification": "stimmiges Zusammenwirken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "848aef89-a0eb-3e5a-8a18-b1f07e99c6e3",
                    "sense_definition": "An instrumental introduction or termination to a vocal composition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musical_composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opera began with a short instrumental <w>symphony</w>.",
                            "target_lang_translations": {
                                "ru": "Опера началась с короткой инструментальной <w>увертюры</w>.",
                                "zh": "歌剧以一段简短的器乐<w>序曲</w>开始。",
                                "es": "La ópera comenzó con una breve <w>obertura</w> instrumental.",
                                "tr": "Opera, kısa bir enstrümantal <w>senfoni</w> ile başladı.",
                                "de": "Die Oper begann mit einer kurzen instrumentalen <w>Ouvertüre</w>."
                            }
                        },
                        {
                            "text": "The choir waited for the organ <w>symphony</w> to finish before singing.",
                            "target_lang_translations": {
                                "ru": "Хор ждал, пока закончится органная <w>симфония</w>, прежде чем начать петь.",
                                "zh": "合唱团等管风琴的<w>前奏</w>结束后才开始演唱。",
                                "es": "El coro esperó a que terminara la <w>sinfonía</w> de órgano antes de cantar.",
                                "tr": "Koro, şarkı söylemeye başlamadan önce org <w>senfonisinin</w> bitmesini bekledi.",
                                "de": "Der Chor wartete, bis das Orgel-<w>Vorspiel</w> beendet war, bevor er zu singen begann."
                            }
                        }
                    ],
                    "synonyms": [
                        "prelude",
                        "overture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструментальное вступление или заключение к вокальному произведению",
                        "zh": "声乐作品的器乐前奏或尾声。",
                        "es": "Introducción o conclusión instrumental de una composición vocal.",
                        "tr": "Vokal bir esere yapılan enstrümantal giriş veya kapanış.",
                        "de": "Ein instrumentales Einleitungs- oder Abschlussstück zu einer Vokalkomposition."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увертюра",
                                "target_lang_sense_clarification": "вступление"
                            },
                            {
                                "target_lang_word": "вступление",
                                "target_lang_sense_clarification": "инструментальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "序曲",
                                "target_lang_sense_clarification": "音乐前奏"
                            },
                            {
                                "target_lang_word": "前奏",
                                "target_lang_sense_clarification": "器乐部分"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "obertura",
                                "target_lang_sense_clarification": "pieza instrumental de introducción"
                            },
                            {
                                "target_lang_word": "preludio",
                                "target_lang_sense_clarification": "pieza introductoria"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uvertür",
                                "target_lang_sense_clarification": "giriş bölümü"
                            },
                            {
                                "target_lang_word": "giriş",
                                "target_lang_sense_clarification": "enstrümantal başlangıç"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ouvertüre",
                                "target_lang_sense_clarification": "instrumentales Eröffnungsstück"
                            },
                            {
                                "target_lang_word": "Vorspiel",
                                "target_lang_sense_clarification": "musikalisches Einleitungsstück"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}