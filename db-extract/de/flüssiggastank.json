                "senses": [
                    {
                        "sense_id": "7564e2d8-a522-3433-89b4-95547b51aa3a",
                        "entry_id": "baf658bc-cd53-3abc-b81d-25d477ad1a9c",
                        "glosses": [
                            "Behälter zur Lagerung von verflüssigtem Gas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7832875c-e97d-4154-8721-f3ce5213fbec",
                                "sense_id": "7564e2d8-a522-3433-89b4-95547b51aa3a",
                                "text": "Der Flüssiggastank der Heizung wurde vor Beginn der Heizperiode wieder befüllt."
                            },
                            {
                                "example_id": "b89e77d7-e29f-4f13-9dd3-a923e73da2a0",
                                "sense_id": "7564e2d8-a522-3433-89b4-95547b51aa3a",
                                "text": "„Da es mit dem Flüssiggastank in der Vergangenheit Probleme gegeben habe, sei der Monteur einer Firma zur Reparatur erschienen.“"
                            },
                            {
                                "example_id": "f01044a7-90d7-4b4c-8bcd-71ccbf645377",
                                "sense_id": "7564e2d8-a522-3433-89b4-95547b51aa3a",
                                "text": "„Der 43-jährige Mann hatte kurz vor der Explosion am 22. September 2006 einen Flüssiggastank im Ortszentrum repariert und dabei das falsche Werkzeug verwendet, teilte die Staatsanwaltschaft am Freitag mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
