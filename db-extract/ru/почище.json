                        "examples": [
                            {
                                "example_id": "62b651f4-5e0e-4a4b-b9a0-58bdd02e0e6c",
                                "sense_id": "c497bb1f-8d2b-3718-983b-481d11134602",
                                "text": "Ну, почище, поприличней, но так же бедно, убого в смысле убранства и мебели, и стол, на котором пишет Печенегин, застлан старой, в пятнах скатертью― он же и письменный, и обеденный, старый круглый стол…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f1615ee2-bfc8-35e8-84a7-05627e3c4063",
                        "entry_id": "356136d1-8385-318c-9de7-bf54b09c3ea7",
                        "glosses": [
                            "посильнее, получше"
                        ],
                        "tags": [],
