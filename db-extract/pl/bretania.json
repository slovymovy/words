                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a3cd067-84e3-4e5b-b2e7-1f73f5d2bee7",
                        "source_entry_id": "b3c9ad56-6f87-3126-8d03-328eea3e835a",
                        "source_sense_id": "cf3a0b29-c780-3a5c-a599-ef200d85a67f",
                        "target_lang_word": "Brittany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brittany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f7439c-80aa-35c1-b8b9-e2ea39c66c6d",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "A cultural region, historical province, and peninsula in northwest France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5424db-d032-4b29-84a4-a8ae471fcddf",
                                                "sense_id": "c5f7439c-80aa-35c1-b8b9-e2ea39c66c6d",
                                                "text": "First, will I see the Coronation, / And then to Britanny Ile crosse the Sea, / To effect this marriage, so it please my Lord."
                                            },
                                            {
                                                "example_id": "f3dbd663-1efe-45b9-9db9-620cb59f889f",
                                                "sense_id": "c5f7439c-80aa-35c1-b8b9-e2ea39c66c6d",
                                                "text": "So Aurelius Ambrosius and Uther Pendragon fled away to that part of France called Brittany, where they remained in saftey for many years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "918595d2-61a5-3e5c-953e-be673eb97f61",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "An administrative region of northwest France, including most of the historic region of Brittany."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c29a67bc-779a-3c0e-a53d-074eee1202b8",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "The British Isles."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3fbe70e-f7c3-4028-b6ae-354d9983c836",
                                                "sense_id": "c29a67bc-779a-3c0e-a53d-074eee1202b8",
                                                "text": "The noble Thamis […] seem'd to stoupe afore / With bowed backe, by reason of the lode / And auncient heavy burden which he bore / Of that faire City, wherein make abode / So many learned impes, that shoote abrode, / And with their braunches spred all Britany […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "A female given name transferred from the place name, of 1980s and 1990s American usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b604d047-0f2d-499c-933b-f032f9c2a5ac",
                                                "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                                "text": "- - - No one has family names. These girls with rooster hair I see on the streets. They pick the names. They're the mothers.\" \"I have a granddaughter named Brittany,\" Hazel said. \" And I have heard of a little girl called Cappuccino.\" \"Cappuccino! Is that true? Why don't they call one Cassaulet? Fettuccini? Alsace-Lorraine?\""
                                            },
                                            {
                                                "example_id": "306e6866-ae54-4837-a9e8-2fab6050b4da",
                                                "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                                "text": "Names of the times. Borrowed from soap opera characters of prominence fifteen years ago, who have since been replaced by spiffy new models: the social-climbing Brittany now an unscrupulous Burke, the generous Pamela a refitted, urbanized Parker."
                                            },
                                            {
                                                "example_id": "e3e30a72-212f-490e-b08a-e8baeb01f435",
                                                "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                                "text": "The leading voices of the womanosphere are using a similar strategy. As Brittany Hugoboom put it in an op–ed for the rightwing outlet Quillette: “Conservatives will never win if they imagine themselves as combatants atop defensive battlements, hurling abuse on the mass media. We need to involve ourselves in the creation of pop culture.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Brittany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4be003e3-f65a-3103-aa29-f51cce5f050c",
                                        "entry_id": "dd3c8326-423e-3f2b-abc0-fffe330ceb53",
                                        "glosses": [
                                            "A coward."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33629b4c-bdfa-3e9b-8829-169156e24f41",
                                        "entry_id": "dd3c8326-423e-3f2b-abc0-fffe330ceb53",
                                        "glosses": [
                                            "A gun dog of a particular breed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b794b64b-e8a0-4b90-a8a3-2b6dd7b714b5",
                                                "sense_id": "33629b4c-bdfa-3e9b-8829-169156e24f41",
                                                "text": "A dish face is not desirable in the Brittany. A dished or upturned muzzle is considered a fault in the Redbone Coonhound."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
