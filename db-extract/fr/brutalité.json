        "fr-extract.jsonl": [
            {
                "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                "word": "brutalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6cad3715-cf5e-4005-bfe4-b011e0863220",
                        "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                        "tags": [
                            "plural"
                        ],
                        "form": "brutalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                        "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                        "glosses": [
                            "Caractère de celui qui est brutal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7ed428-2dc9-4b5f-8630-654b7b271ec1",
                                "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                                "text": "La brise fraîchissante du soir avait séché et soulevé ses cheveux, donnait à son visage un désordre à travers lequel apparaissait de la brutalité."
                            },
                            {
                                "example_id": "e46c9a02-ac84-4bcd-bfbc-66cf3ec85ad8",
                                "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                                "text": "Sa brutalité lui a fait beaucoup d’ennemis."
                            },
                            {
                                "example_id": "342868f4-bf12-4401-a7a0-fcf6bf11490b",
                                "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                                "text": "Parler, répondre avec brutalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "368b4146-066e-36c7-b841-bad2521d2c87",
                        "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                        "glosses": [
                            "Passion brutale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bde9a9c-7fba-491f-b2f6-c8bc04bc70ae",
                                "sense_id": "368b4146-066e-36c7-b841-bad2521d2c87",
                                "text": "Assouvir sa brutalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2be4e5b-d797-37fe-8c77-591727d564df",
                        "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                        "glosses": [
                            "Manière d’agir ou de parler brutale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5276757f-bc91-4c7d-94d8-8d7111cd54c4",
                                "sense_id": "e2be4e5b-d797-37fe-8c77-591727d564df",
                                "text": "On recommanda bien à cette femme, une fois de plus, de quitter son compagnon, qui en dehors de son alcoolisme et de sa brutalité, n'était de toutes façons qu'un bon à rien, incapable de garder un travail fixe bien longtemps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6346dd1-ee2f-492f-b8f1-cf6a2951b20b",
                        "source_entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                        "source_sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                        "source_sense_description": "Caractère de celui qui est brutal.",
                        "target_lang_word": "Brutalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brutalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f59c684e-1607-3cf8-8757-c13842e1c071",
                                        "entry_id": "d370c146-5bb4-315f-a450-436481c66dcb",
                                        "glosses": [
                                            "brutales Verhalten, gewalttätige Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e86450b-d447-4610-bc9a-1f3b0a669df5",
                                                "sense_id": "f59c684e-1607-3cf8-8757-c13842e1c071",
                                                "text": "Die Brutalität im Umgang mit seiner Frau war erschreckend."
                                            },
                                            {
                                                "example_id": "8b2b8434-714d-4d4c-b225-53290323efaf",
                                                "sense_id": "f59c684e-1607-3cf8-8757-c13842e1c071",
                                                "text": "Kinder sollten sich keine Filme anschauen, in denen Brutalitäten dargestellt werden."
                                            },
                                            {
                                                "example_id": "5a04c5a2-16a9-4532-8010-09de9e40097e",
                                                "sense_id": "f59c684e-1607-3cf8-8757-c13842e1c071",
                                                "text": "„Am Abend begann dann jene Woche antisemitischer und antideutscher Brutalitäten.“"
                                            },
                                            {
                                                "example_id": "8ea6dfe4-93d8-443f-9837-e8c87a13b50f",
                                                "sense_id": "f59c684e-1607-3cf8-8757-c13842e1c071",
                                                "text": "„Es wird sofort deutlich, mit welcher Brutalität diese Macht ausgeübt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ea0d467-1705-37da-92e9-99a9fb99da84",
                                        "entry_id": "d370c146-5bb4-315f-a450-436481c66dcb",
                                        "glosses": [
                                            "die Eigenschaft, brutal zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a631db3-7ff9-4508-9966-6ab58ef88ffa",
                                                "sense_id": "6ea0d467-1705-37da-92e9-99a9fb99da84",
                                                "text": "„Die anschließende Aussöhnung zwischen Briten und Buren legte den Grundstein für das spätere Apartheidregime, von dessen Brutalität De Beers Jahrzehnte lang profitierte.“"
                                            },
                                            {
                                                "example_id": "b36a9aa1-e4ca-4c1c-a3db-b2119596b84d",
                                                "sense_id": "6ea0d467-1705-37da-92e9-99a9fb99da84",
                                                "text": "„Seiner Ansicht nach war bei seiner Familie in Sumba in vieler Hinsicht eine krankhafte Brutalität festzustellen.“"
                                            },
                                            {
                                                "example_id": "d9db032a-12f5-4a77-8fed-01bb91470a70",
                                                "sense_id": "6ea0d467-1705-37da-92e9-99a9fb99da84",
                                                "text": "„Immerhin: hätte es sich bei de Sade nicht um einen Marquis aus altem Geschlecht gehandelt, würde er die ganze Brutalität des damaligen Polizeiwesens erfahren und sein Leben vielleicht weit früher beendet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e14a043e-613b-4081-89e8-9ab3b4162dbc",
                        "source_entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                        "source_sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
