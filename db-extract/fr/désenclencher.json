                        "glosses": [
                            "Cesser d’enclencher quelque chose qui était enclenché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a37e2338-3eb7-441a-b364-7afc9b674e4b",
                                "sense_id": "43702153-38d2-3b54-9254-9b3ea960586b",
                                "text": "Il irait désenclencher la serrure."
                            },
                            {
                                "example_id": "5a2a5a47-bd2f-44d8-9aa5-a87f00dedfb8",
                                "sense_id": "43702153-38d2-3b54-9254-9b3ea960586b",
                                "text": "L’agent du poste commandé manœuvre alors le commutateur c, qui, à son tour, a pour effets simultanés de désenclencher les serrures électriques de son groupe d'aiguilles, et d’enclencher le commutateur C du poste commandeur."
                            }
                        ]
