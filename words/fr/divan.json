                    "frequency": "High",
                    "semantic_group_id": "mobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est confortablement allongé sur le <w>divan</w> pour faire une petite sieste après le déjeuner."
                        },
                        {
                            "text": "Nous avons acheté un grand <w>divan</w> en cuir pour meubler notre nouveau salon."
                        }
                    ],
                    "synonyms": [
