                                        "sense_id": "c237b172-5d55-3ad7-8d1d-c8bfbc8abc37",
                                        "entry_id": "b4956981-e6b8-34e7-800b-78072ee27ba6",
                                        "glosses": [
                                            "zufällige Beobachtung von etwas ursprünglich nicht Gesuchtem, das sich als neue und überraschende Entdeckung erweist"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "787ad9d3-0678-44e3-b069-b2df4a8b29b9",
                                                "sense_id": "c237b172-5d55-3ad7-8d1d-c8bfbc8abc37",
                                                "text": "„»Serendipität« (serendipity) – d. h. die Kunst, wichtige Punkte zu entdecken und auszunutzen, welche man zufällig bei der Suche nach anderen Dingen entdeckt – ist in der Statistik ebenso wertvoll wie in anderen Wissenschaften.“"
                                            },
                                            {
                                                "example_id": "3456a2a2-fd5d-46b8-967d-6a34e7c7d280",
                                                "sense_id": "c237b172-5d55-3ad7-8d1d-c8bfbc8abc37",
                                                "text": "„Verwandt, aber nicht identisch ist der weiter gefasste Begriff glücklicher Zufall; Serendipität betont eine darüber hinaus gehende Untersuchung, eine intelligente Schlussfolgerung oder Findigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
