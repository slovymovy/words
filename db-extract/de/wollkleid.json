                ],
                "senses": [
                    {
                        "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                        "entry_id": "c35269e0-1a52-31bf-8844-762b5ed176b7",
                        "glosses": [
                            "Kleid, das aus Wollstoff gefertigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f956826b-cab8-49be-b550-2f6a557505d8",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "Du siehst einfach klasse aus in diesem Wollkleid!"
                            },
                            {
                                "example_id": "efb52d07-6fa3-4221-b62f-449974466727",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "Dieses Wollkleid passt ihnen wie angegossen."
                            },
                            {
                                "example_id": "53639543-3135-4fc7-b9eb-6b96903d6c32",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "In Italien ist es im Sommer viel zu warm für Wollkleider."
                            },
                            {
                                "example_id": "0739fca5-6f28-4aa1-bfa2-90f5a3480cd4",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "„Donath hat ein graues Wollkleid an.“"
                            },
                            {
                                "example_id": "30a7cc79-4f06-43a0-88eb-ea08fd6970e6",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "„Immer, wenn sie ihr Museum präsentiert, trägt sie im Winter ein und dasselbe schlichte rote Wollkleid mit Rüschen.“"
                            },
                            {
                                "example_id": "f65d9c2c-fb17-4157-9578-6dd5b0dd7edb",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "„Es war ein Skandal, als die fromme Landgräfin Elisabeth von Thüringen im 13. Jahrhundert der Farbenpracht entsagte und ein simples graues Wollkleid anzog!“"
                            },
                            {
                                "example_id": "c1ae00a3-aa6d-42ac-b368-e27918dcc701",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "[Klara von Assisi, 1212:] „Chiara vertauschte ihr kostbares Gewand mit einem einfachen Wollkleid, Francesco schnitt ihr die schönen Haare ab - Zeichen für ein gottgeweihtes Leben -, und die Flucht ging weiter zu den Benediktinerinnen von San Paolo delle Abbadesse.“"
                            },
                            {
                                "example_id": "ca5b88f2-b8b2-49f7-9737-aeca709c9e18",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "„Waltraud Schwienbacher ist eine stattliche Frau: Die grauen langen Haare straff zum Dutt gebunden, ein langes, naturfarbenes Wollkleid, das sie trotz Hitze trägt.“"
                            },
                            {
                                "example_id": "6646910f-49c3-4310-b99b-a569257be2cf",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "„Saida Bekkari, eine zierliche Frau im grauen Wollkleid und mit rosa Kopftuch, hat mit ihrer Familie zwei Frauen bis zu deren Tod versorgt: […].“"
                            },
                            {
                                "example_id": "d034cd37-97e3-42f2-be4a-9505d94b34a7",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "„Zwei Damen, in dicke Wollkleider, Wollstrümpfe und mittelalterliche Hauben gekleidet, bereiten den Besuchern Rindergulasch zu.“"
                            },
                            {
                                "example_id": "ae7c069d-706d-43ea-97d4-7a45d5d4325e",
                                "sense_id": "bf195df2-7039-36d9-9597-d3b781133911",
                                "text": "„Zum Schluss ist ihr adrettes Wollkleid vollgeschmiert mit weißer Kreide […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "587d2ed7-3cec-3ffa-b059-b759bc7f6351",
                        "entry_id": "c35269e0-1a52-31bf-8844-762b5ed176b7",
                        "glosses": [
                            "Fell von Schafen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "aa3376fb-971c-442c-8631-4d962f48693d",
                                "sense_id": "587d2ed7-3cec-3ffa-b059-b759bc7f6351",
                                "text": "„Merinoschafe verlieren ihr Wollkleid nicht von selbst und müssen daher etwa einmal im Jahr geschoren werden.“"
                            },
                            {
                                "example_id": "c5cf83af-2c8f-4397-b581-828c3271c958",
                                "sense_id": "587d2ed7-3cec-3ffa-b059-b759bc7f6351",
                                "text": "„Während das ursprüngliche, wilde Schaf noch Haare hatte und sich nur im Winter zusätzlich feine, lockige und zugleich wärmende Haare ausbildeten, die es dann im Frühjahr auch wieder verlor, wurden die zahmen Vertreter durch Zucht mit einem dauerhaften Wollkleid ausgestattet, das nun so lange weiter wuchs, bis es irgendwann von Menschenhand geschoren wurde.“"
                            },
                            {
                                "example_id": "fd0c7644-cf1a-44b0-9626-3585a5330866",
                                "sense_id": "587d2ed7-3cec-3ffa-b059-b759bc7f6351",
                                "text": "„Hannelore Raulf hält eine Herde Schafe, hornlose Heidschnucken, eine vom Aussterben bedrohte Rasse. \"Zu wenig Fleisch dran, deshalb werden sie kaum noch gehalten\", erklärt Hannelore Raulf. Sie aber mag die robusten Tiere, die jetzt im Winter ein langes, dichtes Wollkleid tragen.“"
                            },
                            {
                                "example_id": "a0cf5a26-b3b4-4dad-8f5a-78f6704680bb",
                                "sense_id": "587d2ed7-3cec-3ffa-b059-b759bc7f6351",
                                "text": "[Insekten:] „Im oder auf dem Wollkleid der Schafe sind häufig „blinde Passagiere“ unterwegs. Heuschrecken zum Beispiel, wie das bis zu vier Zentimeter große „Grüne Heupferd“, das mitunter auf den Schafen hockend zu beobachten ist.“"
                            },
                            {
                                "example_id": "25a818f6-2ccf-40bd-a8bd-2ce14c01c85b",
                                "sense_id": "587d2ed7-3cec-3ffa-b059-b759bc7f6351",
                                "text": "„Auf Marcos Heimatinsel Rügen lebt das Pommernschaf und dessen Wollkleid hat sich seit tausenden von Jahren perfekt an die klimatischen Bedingungen angepasst.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
