                            "target_lang_translations": {
                                "fr": "Nous avons commandé une autre boisson au <w>comptoir</w> du café."
                            }
                        },
                        {
                            "text": "De barman maakte het werkblad achter de <w>toog</w> grondig schoon.",
                            "target_lang_translations": {
                                "fr": "Le barman a nettoyé à fond le plan de travail derrière le <w>comptoir</w>."
                            }
                        }
                    ],
                    "synonyms": [
