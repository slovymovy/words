                    "frequency": "Middle",
                    "semantic_group_id": "nastreven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is bewonderenswaardig dat zij eindelijk haar grote droom <w>achterna</w> gaat.",
                            "target_lang_translations": {
                                "en": "It is admirable that she is finally going <w>after</w> her big dream."
