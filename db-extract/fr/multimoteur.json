                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "multimoteurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb4b1c8f-fe36-3529-bc8f-c92242cd138b",
                        "entry_id": "3a78b25f-17bf-3b57-a9c7-b1447b88a0a8",
                        "glosses": [
                            "Qui est doté de plusieurs moteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48bd562a-23de-4938-9a41-f380558e965c",
                                "sense_id": "fb4b1c8f-fe36-3529-bc8f-c92242cd138b",
                                "text": "Toutefois, l’avion multimoteur, le trimoteur plus particulièrement, sera certainement l’appareil de demain."
                            },
                            {
                                "example_id": "33d66c03-74b5-4919-8cd8-54422e1f66b7",
                                "sense_id": "fb4b1c8f-fe36-3529-bc8f-c92242cd138b",
                                "text": "Une extension de cette licence au transport de la poste et des marchandises sur appareils multimoteurs pourra être accordée dès que le candidat pourra justifier de l’accomplissement, comme pilote, d’au moins 25 heures de vol comportant dix atterrissages, sur appareils multimoteurs."
                            },
                            {
                                "example_id": "8c6bc535-faa1-462a-b256-670b938737d5",
                                "sense_id": "fb4b1c8f-fe36-3529-bc8f-c92242cd138b",
                                "text": "Les privilèges d’un FE-CPLH permettent de conduire (FCL.1005.FE b)) : … des examens pratiques et des contrôles de compétences pour des qualifications de type d’hélicoptères monopilotes multimoteurs intégrés à une PPL(H) ou une CPL(H), pour autant que l’examinateur ait satisfait aux exigences du point précédent, et soit titulaire d’une CPL(H) ou d’une ATPL(H) et, le cas échéant, une IR(H)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8753fdd3-9bca-475f-bf4b-fadcc1bad9d7",
                        "source_entry_id": "3a78b25f-17bf-3b57-a9c7-b1447b88a0a8",
                        "source_sense_id": "fb4b1c8f-fe36-3529-bc8f-c92242cd138b",
                        "target_lang_word": "multiengine",
