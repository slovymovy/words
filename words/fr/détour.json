{
    "word_family": [
        "détourner",
        "détournement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9ef3a45-e348-360e-ad1d-5aecc7477be2",
                    "sense_definition": "Action de s'écarter du chemin le plus direct ; trajet plus long emprunté pour contourner un obstacle ou visiter un lieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chemin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons dû faire un grand <w>détour</w> en voiture à cause des travaux sur l'autoroute."
                        },
                        {
                            "text": "Ce petit <w>détour</w> par la côte valait vraiment la peine pour admirer le paysage."
                        }
                    ],
                    "synonyms": [
                        "déviation"
                    ],
                    "common_phrases": [
                        "faire un détour",
                        "prendre un détour"
                    ]
                },
                {
                    "sense_id": "d54fb9aa-dfcb-32b6-95a7-46125b4415c5",
                    "sense_definition": "Endroit où un chemin ou un cours d'eau change brusquement de direction ; coude, sinuosité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au prochain <w>détour</w> du sentier, vous apercevrez une magnifique vue sur toute la vallée."
                        },
                        {
                            "text": "Le promeneur suivait avec attention les nombreux <w>détours</w> de la rivière à travers la forêt."
                        }
                    ],
                    "synonyms": [
                        "virage",
                        "méandre",
                        "sinuosité"
                    ],
                    "common_phrases": [
                        "au détour du chemin",
                        "au détour d'une rue"
                    ]
                },
                {
                    "sense_id": "11e1888e-8367-3428-9abf-0bee350690fa",
                    "sense_definition": "Façon indirecte de s'exprimer pour ne pas aborder franchement un sujet délicat ou embarrassant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dis-moi la vérité sans <w>détour</w>, je préfère savoir exactement ce qui s'est passé."
                        },
                        {
                            "text": "Il a pris beaucoup de <w>détours</w> avant d'annoncer la mauvaise nouvelle à ses collègues."
                        }
                    ],
                    "synonyms": [
                        "tergiversation",
                        "circonlocution"
                    ],
                    "antonyms": [
                        "franchise"
                    ],
                    "common_phrases": [
                        "sans détour",
                        "parler sans détour"
                    ]
                },
                {
                    "sense_id": "3883928d-a9ef-38b4-b3db-340657e89328",
                    "sense_definition": "Manière rusée ou subtile employée pour contourner une règle, éluder une difficulté ou tromper quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il connaît tous les tours et les <w>détours</w> de la loi pour échapper aux sanctions."
                        },
                        {
                            "text": "L'avocat a usé d'habiles <w>détours</w> afin de déstabiliser le témoin pendant l'audience."
                        }
                    ],
                    "synonyms": [
                        "faux-fuyant",
                        "ruse",
                        "artifice"
                    ],
                    "common_phrases": [
                        "tours et détours",
                        "user de détours"
                    ]
                }
            ]
        }
    ]
}