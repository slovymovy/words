                ],
                "senses": [
                    {
                        "sense_id": "5eba79eb-6c4a-3ed8-86a0-2eb8e1117b29",
                        "entry_id": "ed8c8a27-dd4a-307f-a9cf-8656a5f46f17",
                        "glosses": [
                            "Faire perdre sa finalité à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78cd1cb5-680a-4437-9a58-a1d20e765777",
                                "sense_id": "5eba79eb-6c4a-3ed8-86a0-2eb8e1117b29",
                                "text": "Le sens du travail, c'est de lui accorder une finalité. Or, nos sociétés sont définalisées."
                            },
                            {
                                "example_id": "dc81a126-98e2-40d7-a8ed-3d5a94001b79",
                                "sense_id": "5eba79eb-6c4a-3ed8-86a0-2eb8e1117b29",
                                "text": "Le sens reste souvent opaque, l'innovation trop souvent « définalisée »."
                            },
                            {
                                "example_id": "8424e415-48b1-40e4-9dd5-de527cce8525",
                                "sense_id": "5eba79eb-6c4a-3ed8-86a0-2eb8e1117b29",
                                "text": "Aujourd'hui, tout est définalisé : on travaille pour travailler, on innove pour innover."
                            }
                        ]
                    },
                    {
                        "sense_id": "cba9f09d-3599-39b6-a465-179fdbc64f94",
                        "entry_id": "ed8c8a27-dd4a-307f-a9cf-8656a5f46f17",
                        "glosses": [
                            "Faire revenir en arrière sur la finalisation de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca7edb19-8dad-460c-ae5f-2f438e80cd2f",
                                "sense_id": "cba9f09d-3599-39b6-a465-179fdbc64f94",
                                "text": "Bonjour, je cherche comment définaliser une vente car il y a une erreur sur les frais de port ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "662246eb-8bf9-38be-8942-e2f3dfc90bf4",
                        "entry_id": "ed8c8a27-dd4a-307f-a9cf-8656a5f46f17",
                        "glosses": [
                            "Annuler la finalisation d’un disque optique pour pouvoir à nouveau changer son contenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271e7953-c84a-4b2a-ba51-e9896beba7eb",
                                "sense_id": "662246eb-8bf9-38be-8942-e2f3dfc90bf4",
                                "text": "Finaliser/Définaliser un disque : si vous voulez afficher votre disque DVD-RW avec un profil –VR sur un lecteur, vous devez d’abord finaliser le disque. Vous pouvez également utiliser la fonction pour définaliser le disque pour permettre une édition ultérieure."
                            },
                            {
                                "example_id": "f4ad37fb-190e-41e3-837d-157978604b5f",
                                "sense_id": "662246eb-8bf9-38be-8942-e2f3dfc90bf4",
                                "text": "Comment faire pour définaliser le DVD-RW?"
                            }
                        ]
                    }
                ],
