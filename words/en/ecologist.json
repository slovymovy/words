{
    "word_family": [
        "ecology",
        "ecological"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c087ddf1-039d-31ea-a0de-4ccd6feb8653",
                    "sense_definition": "A scientist who studies the relationships between living organisms and their environment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scientist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ecologist</w> spent years studying how climate change affects local bird populations.",
                            "target_lang_translations": {
                                "zh": "这位<w>生态学家</w>花了多年时间研究气候变化如何影响当地的鸟类种群。"
                            }
                        },
                        {
                            "text": "Many <w>ecologists</w> warn that the loss of biodiversity will have serious consequences for our planet.",
                            "target_lang_translations": {
                                "zh": "许多<w>生态学家</w>警告说，生物多样性的丧失将对我们的星球产生严重后果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "biologist"
                    ],
                    "common_phrases": [
                        "field ecologist",
                        "research ecologist"
                    ],
                    "target_lang_definitions": {
                        "zh": "研究生物与其环境之间关系的科学家。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "生态学家",
                                "target_lang_sense_clarification": "指从事生态学研究的专业科学工作者。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d9fb922-0576-3b45-ab52-8dcc07e8b1d3",
                    "sense_definition": "A person who actively supports or advocates for the protection and preservation of the natural environment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local <w>ecologists</w> organized a protest to stop the construction of the new highway through the forest.",
                            "target_lang_translations": {
                                "zh": "当地的<w>环保人士</w>组织了一场抗议活动，以阻止穿过森林的新高速公路建设。"
                            }
                        },
                        {
                            "text": "The <w>ecologist</w> spoke at the town hall meeting about the importance of reducing plastic waste.",
                            "target_lang_translations": {
                                "zh": "这位<w>环保人士</w>在市政厅会议上谈到了减少塑料垃圾的重要性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "environmentalist",
                        "conservationist"
                    ],
                    "common_phrases": [
                        "radical ecologist"
                    ],
                    "target_lang_definitions": {
                        "zh": "积极支持或倡导保护自然环境的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "环保人士",
                                "target_lang_sense_clarification": "指致力于环境保护运动或倡导生态保护的社会活动家。"
                            },
                            {
                                "target_lang_word": "生态保护主义者",
                                "target_lang_sense_clarification": "指主张保护生态平衡和自然资源的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}