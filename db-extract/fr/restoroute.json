                                                "example_id": "0f9aab36-f938-4778-a32a-fbbc5b39fa6b",
                                                "sense_id": "be2cd508-98ae-3848-809f-89b344adcd79",
                                                "text": "Laß uns doch an der nächsten Raststätte rausfahren, ich möchte mir die Beine vertreten."
                                            },
                                            {
                                                "example_id": "33517aa1-5b32-415f-b26d-b1533b7c30a9",
                                                "sense_id": "be2cd508-98ae-3848-809f-89b344adcd79",
                                                "text": "„An einer Raststätte in Südtirol wollte er einen Schokoriegel kaufen und heiratete im Jahr darauf die Tochter der Tankwartin.“"
                                            }
