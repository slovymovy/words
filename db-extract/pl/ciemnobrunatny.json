                ],
                "senses": [
                    {
                        "sense_id": "291a1032-9f81-32df-81cf-25e4ab53e08b",
                        "entry_id": "9ceeaa8a-963b-3f7b-9023-1e753b04e694",
                        "glosses": [
                            "brunatny o ciemnym odcieniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e4cca7a-dc0c-4b94-ae9c-faaabfdd1d7b",
                                "sense_id": "291a1032-9f81-32df-81cf-25e4ab53e08b",
                                "text": "Ma barwę jasnobrunatną do ciemnobrunatnej, jest gładki lub wypukły"
                            },
                            {
                                "example_id": "9a7be07c-1927-40fa-9fca-ee11e550bc69",
                                "sense_id": "291a1032-9f81-32df-81cf-25e4ab53e08b",
                                "text": "Upierzenie gęgawej jest ciemnobrunatne, z białymi paseczkami w poprzek pokryw skrzydeł"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41b3488d-59fc-434d-9f50-ba6c5a062ff0",
                        "source_entry_id": "9ceeaa8a-963b-3f7b-9023-1e753b04e694",
                        "source_sense_id": "291a1032-9f81-32df-81cf-25e4ab53e08b",
                        "target_lang_word": "тёмно-бурый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тёмно-бурый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a797af1b-4f04-3f7a-b2c4-203fd2b172db",
                                        "entry_id": "d142040b-3aa7-3508-b9a5-5ed81c170087",
                                        "glosses": [
                                            "имеющий бурый цвет с тёмным оттенком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d544077-fbb7-4c59-848a-20de5cdd06e5",
                                                "sense_id": "a797af1b-4f04-3f7a-b2c4-203fd2b172db",
                                                "text": "На крыльце я остановился и оглянулся: по серому небу тяжко ползли длинные тучи; тёмно-бурый кустарник крутился на ветре и жалобно шумел; жёлтая трава бессильно и печально пригибалась к земле; стаи дроздов перелётывали по рябинам, осыпанным ярко-пунцовыми гроздьями .."
                                            },
                                            {
                                                "example_id": "58e92712-4d44-481e-a796-cd8c863ef62e",
                                                "sense_id": "a797af1b-4f04-3f7a-b2c4-203fd2b172db",
                                                "text": "Сердцевина дерева была тёмно-бурого цвета и окаймлялась почти белым наружным слоем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
