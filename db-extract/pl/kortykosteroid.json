                                        "sense_id": "562d6f21-6e29-3d26-a139-4eafeafd1e35",
                                        "entry_id": "d87f21f4-bc1b-326c-9cb1-741d2a0dd7b4",
                                        "glosses": [
                                            "Any of a group of steroid hormones, secreted by the adrenal cortex, that are involved in a large range of physiological systems."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90211ea4-b7a5-3125-9309-7733cdeb3874",
                                        "entry_id": "d87f21f4-bc1b-326c-9cb1-741d2a0dd7b4",
                                        "glosses": [
                                            "Any of several synthetic hormones of related structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc233607-ee70-4e46-aab7-d1c9ce92584f",
                                                "sense_id": "90211ea4-b7a5-3125-9309-7733cdeb3874",
                                                "text": "Wúràọlá’s first patient was a man who had not noticed any significant improvement after a regimen of corticosteroids had been prescribed for his spondylosis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f36fda80-3987-4be9-96a4-fafd9ef80001",
