{
    "word_family": [
        "wretched",
        "wretchedly",
        "wretchedness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe4d245d-ff05-3d68-85e5-ec15c54877fb",
                    "sense_definition": "An unhappy, unfortunate, or deeply miserable person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poor <w>wretch</w> sat alone in the cold rain, shivering and begging for food.",
                            "target_lang_translations": {
                                "de": "Der arme <w>Tropf</w> saß allein im kalten Regen, zitterte und bettelte um Essen."
                            }
                        },
                        {
                            "text": "After losing his home and job in the same week, he felt like the most miserable <w>wretch</w> alive.",
                            "target_lang_translations": {
                                "de": "Nachdem er in derselben Woche sein Zuhause und seine Arbeit verloren hatte, fühlte er sich wie der elendeste <w>Teufel</w> auf Erden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poor wretch",
                        "miserable wretch"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine unglückliche, bemitleidenswerte oder elende Person."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "armer Tropf",
                                "target_lang_sense_clarification": "bemitleidenswerter Mensch"
                            },
                            {
                                "target_lang_word": "armer Teufel",
                                "target_lang_sense_clarification": "bedauernswerte, verarmte oder unglückliche Person"
                            },
                            {
                                "target_lang_word": "armes Schwein",
                                "target_lang_sense_clarification": "umgangssprachlich für jemanden in einer elenden Lage"
                            },
                            {
                                "target_lang_word": "armer Schlucker",
                                "target_lang_sense_clarification": "mittellose oder unglückselige Person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fb2f663-cf0b-3be6-a933-b87f38441b9f",
                    "sense_definition": "An unpleasant, despicable, or villainous person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heartless <w>wretch</w> abandoned his faithful dog on the side of the highway.",
                            "target_lang_translations": {
                                "de": "Der herzlose <w>Schurke</w> setzte seinen treuen Hund am Rand der Autobahn aus."
                            }
                        },
                        {
                            "text": "She refused to speak with the treacherous <w>wretch</w> who had betrayed their family.",
                            "target_lang_translations": {
                                "de": "Sie weigerte sich, mit dem verräterischen <w>Wicht</w> zu sprechen, der ihre Familie verraten hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoundrel",
                        "villain"
                    ],
                    "common_phrases": [
                        "vile wretch",
                        "selfish wretch"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine niederträchtige, verabscheuungswürdige oder bösartige Person."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schurke",
                                "target_lang_sense_clarification": "gemeiner, böser Mensch"
                            },
                            {
                                "target_lang_word": "elender Wicht",
                                "target_lang_sense_clarification": "verachtenswerter, charakterloser Mensch"
                            },
                            {
                                "target_lang_word": "Elender",
                                "target_lang_sense_clarification": "abwertend für eine verachtenswerte Person"
                            },
                            {
                                "target_lang_word": "Lump",
                                "target_lang_sense_clarification": "ehrloser, gemeiner Kerl"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8549f5d0-e796-32c9-9552-9f79e8f83cf1",
                    "sense_definition": "A banished person or exile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Driven from his homeland by the king, the lonely <w>wretch</w> wandered across distant kingdoms.",
                            "target_lang_translations": {
                                "de": "Vom König aus seiner Heimat vertrieben, wanderte der einsame <w>Verbannte</w> durch ferne Königreiche."
                            }
                        },
                        {
                            "text": "The ancient decree condemned every political <w>wretch</w> to live far beyond the borders.",
                            "target_lang_translations": {
                                "de": "Der uralte Erlass verdammte jeden politischen <w>Ausgestoßenen</w> dazu, weit jenseits der Grenzen zu leben."
                            }
                        }
                    ],
                    "synonyms": [
                        "exile",
                        "outcast"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical meaning of exile"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine verbannte, heimatlose oder ausgestoßene Person (historisch/gehoben)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verbannter",
                                "target_lang_sense_clarification": "aus der Heimat Verstoßener"
                            },
                            {
                                "target_lang_word": "Ausgestoßener",
                                "target_lang_sense_clarification": "von der Gemeinschaft Verstoßener"
                            },
                            {
                                "target_lang_word": "Heimatloser",
                                "target_lang_sense_clarification": "ohne Vaterland oder Zuflucht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}