            "senses": [
                {
                    "sense_id": "1ed1489a-5a65-3229-a445-f4a9e3b7874d",
                    "sense_definition": "Action de diriger les yeux vers quelqu'un ou quelque chose pour voir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a tourné la tête et a croisé son <w>regard</w> au milieu de la foule."
                        },
                        {
                            "text": "Il a jeté un <w>regard</w> rapide sur sa montre avant de partir."
                        }
                    ],
                    "common_phrases": [
                        "jeter un regard",
                        "suivre du regard",
                        "croiser le regard"
                    ]
                },
                {
                    "sense_id": "61e3947b-6965-3ffd-bbbd-a7328f03c0b3",
                    "sense_definition": "Expression des yeux qui manifeste un sentiment ou un état d'esprit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>regard</w> chaleureux a immédiatement rassuré tous les enfants présents."
                        },
                        {
                            "text": "Face à ces reproches injustifiés, elle a préféré baisser le <w>regard</w>."
                        }
                    ],
                    "common_phrases": [
                        "baisser le regard",
                        "regard noir",
                        "regard bienveillant"
                    ]
                },
                {
                    "sense_id": "e8663d92-49fb-3538-808d-01a7b4b00132",
                    "sense_definition": "Façon de considérer, d'examiner ou d'évaluer quelque chose par la pensée.",
