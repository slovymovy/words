                ],
                "senses": [
                    {
                        "sense_id": "ffb6b971-9b00-31b2-9938-08ced9725494",
                        "entry_id": "708d7272-da70-3f34-bf38-4d8de1ef4e4b",
                        "glosses": [
                            "Süßungsmittel aus dem Saft des Zuckerahorns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd2bf663-8aa9-4f3b-90ac-f192006d5303",
                                "sense_id": "ffb6b971-9b00-31b2-9938-08ced9725494",
                                "text": "Meine amerikanische Freundin isst gerne Pfannkuchen mit Ahornsirup zum Frühstück."
                            },
                            {
                                "example_id": "865c9af2-7289-4860-8828-aaaeeb06826c",
                                "sense_id": "ffb6b971-9b00-31b2-9938-08ced9725494",
                                "text": "„Ahornsirup wird vor allem im nördlichen Amerika hergestellt, drei Viertel der Welternte werden in Quebec eingefahren.“"
                            },
                            {
                                "example_id": "3cd8f9ed-3106-466b-b8a2-e9e5214818da",
                                "sense_id": "ffb6b971-9b00-31b2-9938-08ced9725494",
                                "text": "„Von aussen riecht der Ahornsirup nach Caramel, nach einem hellen Milchkaffee mit Zucker und nach Zigarettentabak.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44a3ac80-e4d3-4c1b-9c37-0d04fedefc06",
                        "source_entry_id": "708d7272-da70-3f34-bf38-4d8de1ef4e4b",
                        "source_sense_id": "ffb6b971-9b00-31b2-9938-08ced9725494",
                        "source_sense_description": "Süßungsmittel aus dem Saft des Zuckerahorns",
