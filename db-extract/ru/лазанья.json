                    },
                    {
                        "translation_id": "c93300f7-069c-4e8e-a7af-ed9d773c94e4",
                        "source_entry_id": "ae301d46-b92f-36a3-84b1-e29c783eab43",
                        "target_lang_word": "Lasagne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lasagne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                        "entry_id": "81c1e8af-cbb1-3637-a7aa-a6768c1e56bd",
                                        "glosses": [
                                            "im Ofen überbackenes, italienisches Nudelgericht, das aus Schichten von Teigplatten und Füllung (zum Beispiel Hackfleisch oder Gemüse) besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd3dec8-6025-4ded-a6f9-dbf7c210228e",
                                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                                "text": "Heute koche ich eine Lasagne mit Spinat und Lachs."
                                            },
                                            {
                                                "example_id": "df3112a6-7ca4-4749-b204-d79f4afd5991",
                                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                                "text": "Zur Auswahl standen verschiedene Lasagnen, gefüllt mit Hackfleisch, Gemüse oder Fisch."
                                            },
                                            {
                                                "example_id": "96c4ba31-e496-4423-9a80-7f79acf0ec5e",
                                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                                "text": "„Ich hätte jetzt nicht einmal die Lasagne hinuntergebracht, von der ich gelegentlich träumte.“"
                                            },
                                            {
