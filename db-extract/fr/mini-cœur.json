                        "glosses": [
                            "Tout petit cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1a7c19c-7064-4a3b-9814-d342d8193eda",
                                "sense_id": "ce9c7203-3e4a-36cd-9a6e-172768fb961a",
                                "text": "Vos parents feront moins la gueule si vous arrivez avec un mini-cœur sur la cheville au lieu d’un crâne à faire peur, d’une pin-up ou d’un serpent aux prises avec un aigle."
                            },
                            {
                                "example_id": "d9b4af1f-8ad2-406b-8553-ef58075f811f",
                                "sense_id": "ce9c7203-3e4a-36cd-9a6e-172768fb961a",
                                "text": "D’autres mini-cœurs nougatine ornaient de part et d’autre la pièce montée, sur l’un écrit à la crème blanche royale, les prénoms des mariés Lydia et Nabil et sur l’autre la date de leur union : le 29.09.1994."
                            },
                            {
                                "example_id": "dcfc0fc0-274e-4413-9dc0-047333b391bc",
                                "sense_id": "ce9c7203-3e4a-36cd-9a6e-172768fb961a",
                                "text": "La réflexologie plantaire permet de travailler en local et de stimuler un de nos « mini-cœurs », l’organe cœur ayant besoin de renforts pour pomper plus de 8 000 litres de sang par jour !"
                            }
                        ]
                    }
