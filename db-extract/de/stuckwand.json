                                "example_id": "63812a28-7e5c-4747-b50b-9ecefe0d4312",
                                "sense_id": "e2c0fb31-2260-3f87-8d77-632fdacc3097",
                                "text": "„Courts erster Schuss landete tief und explodierte ein paar Meter vor der Stuckwand.“"
                            },
                            {
