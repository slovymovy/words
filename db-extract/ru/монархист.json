                                                "example_id": "e32e671d-03c0-4bbf-89de-ae19957fabdf",
                                                "sense_id": "5dc79ba4-d018-36f3-9244-ca3ee14fb383",
                                                "text": "Un peuple monarchiste veut étendre au-delà des mers, la gloire & l'empire de son maître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb362fa-c90b-3ed8-b4c1-b0bfdca46ede",
                                        "entry_id": "b2c8a333-16dd-36ac-91f6-8435a0fb101c",
                                        "glosses": [
                                            "Partisan d'une monarchie constitutionnelle lors de la Révolution française. Antonyme : absolutiste ou républicain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe126505-5094-4591-baf3-e5b4da5463e8",
                                                "sense_id": "2cb362fa-c90b-3ed8-b4c1-b0bfdca46ede",
                                                "text": "Le parti monarchiste était encore puissant."
                                            }
