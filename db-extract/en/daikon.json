                    {
                        "translation_id": "f278613d-cfb0-4495-a101-b40955a6823d",
                        "source_entry_id": "882340a8-6475-34ab-8891-b6c421e81595",
                        "source_sense_description": "large white radish",
                        "target_lang_word": "radis blanc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radis blanc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75d0bdb0-9330-3402-8221-aa5ba350e5fa",
                                        "entry_id": "1f5c5e43-601e-35ff-9cb6-70fc0b4074ac",
                                        "glosses": [
                                            "Variété de radis, de nom scientifique Raphanus raphanistrum subsp. sativus, de la famille des Brassicaceae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f188e4ee-03f2-4625-8356-9d420a5aeaa2",
                                                "sense_id": "75d0bdb0-9330-3402-8221-aa5ba350e5fa",
                                                "text": "Sous le rire approbateur de la vendeuse, tu chipes un radis blanc et mords dedans à pleines dents."
                                            },
                                            {
                                                "example_id": "9620a393-9a7c-45fe-915a-84d7ca761fae",
                                                "sense_id": "75d0bdb0-9330-3402-8221-aa5ba350e5fa",
                                                "text": "Mais les grands gagnants sont le radis blanc (tsai-tao), car se prononçant comme « bonne chance », et l’ananas (ong-lai) comme « la prospérité arrive »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a34588f0-2146-4f9a-8303-7aabd2faa27d",
                        "source_entry_id": "882340a8-6475-34ab-8891-b6c421e81595",
                        "source_sense_description": "large white radish",
                        "target_lang_word": "radis d'hiver",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8c7bf572-62ee-4377-a620-fa8c194ff023",
                        "source_entry_id": "882340a8-6475-34ab-8891-b6c421e81595",
