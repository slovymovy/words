                    {
                        "translation_id": "b3fd81ba-4737-49a1-b44d-500ed49082e6",
                        "source_entry_id": "21bcf7dd-3017-3952-a446-626b89e97f65",
                        "source_sense_id": "2a131900-aad0-37e4-9951-b7ead06bfa27",
                        "source_sense_description": "lease or rent",
                        "target_lang_word": "onderverhuren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderverhuren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1d73cbb0-ff12-3b91-bffe-e100d3ff7654",
                                        "entry_id": "e1993475-3073-3aa8-a681-05385b710b06",
                                        "glosses": [
                                            "iets dat al gehuurd is, verhuren aan iemand anders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba2e48d-dcbb-4760-8ea6-23f312f05e66",
                                                "sense_id": "1d73cbb0-ff12-3b91-bffe-e100d3ff7654",
                                                "text": "Een huurder van woonruimte mag, zonder toestemming van de verhuurder, deze woonruimte niet onderverhuren."
                                            },
                                            {
                                                "example_id": "6877e3d2-a874-4f07-a3d5-a3e781c65412",
                                                "sense_id": "1d73cbb0-ff12-3b91-bffe-e100d3ff7654",
                                                "text": "Je krijgt minder huurtoeslag, als je een deel van de woning onderverhuurt."
                                            },
                                            {
                                                "example_id": "023451c0-a9ba-45fb-a161-4fb1742f52cc",
                                                "sense_id": "1d73cbb0-ff12-3b91-bffe-e100d3ff7654",
                                                "text": "Omdat ik twee maanden van huis zou zijn en meneer Padmanadan toch zijn huur wilde ontvangen, leek het me verstandig mijn kamer onder te verhuren. In de zomermaanden wordt bijna heel Parijs onderverhuurd, maar of het ook zo makkelijk zou zijn in november wist ik niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d3af316-be53-4855-8a42-dee2dc1966b9",
                        "source_entry_id": "21bcf7dd-3017-3952-a446-626b89e97f65",
                        "source_sense_id": "2a131900-aad0-37e4-9951-b7ead06bfa27",
                        "source_sense_description": "lease or rent",
                        "target_lang_word": "sous-louer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-louer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba65676-a9eb-3903-bcba-cee4195f0ded",
                                        "entry_id": "a2a3854f-b395-377e-8dc0-b7f77e92f13d",
                                        "glosses": [
                                            "Donner en location un appartement, une maison ou partie de maison ou une terre dont on est locataire ou fermier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "426c4687-aaa9-4bc6-a938-d14aab8c22eb",
                                                "sense_id": "5ba65676-a9eb-3903-bcba-cee4195f0ded",
                                                "text": "Lorsque Lisbeth vint tenir la maison, elle voulut aussitôt sous-louer le premier étage qui, disait-elle, payerait toute la location, le comte serait alors logé pour presque rien ; mais le vieux soldat s’y refusa."
                                            },
                                            {
                                                "example_id": "880d0ff0-8adf-4080-8abc-50461464d170",
                                                "sense_id": "5ba65676-a9eb-3903-bcba-cee4195f0ded",
                                                "text": "Le penn-ty est un journalier à qui un propriétaire loue, ou bien à qui un fermier sous-loue une petite maison et quelques terres."
                                            },
                                            {
                                                "example_id": "5aaa6905-4182-4098-ba01-35c4299c44e3",
                                                "sense_id": "5ba65676-a9eb-3903-bcba-cee4195f0ded",
                                                "text": "Elle sera ravie de te sous-louer sa chambre pour trois semaines. C’est exactement la même que la mienne. Sauf qu’il n’y pas l’eau courante."
                                            },
                                            {
                                                "example_id": "55219434-dba0-49f0-b7ef-8a585b873588",
                                                "sense_id": "5ba65676-a9eb-3903-bcba-cee4195f0ded",
                                                "text": "Alors pour s’en sortir, elle sous-loue deux chambres dans son appartement romain, à l’insu de sa propriétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d494adf-728b-38e8-9cb4-1e14f9e5f8ba",
                                        "entry_id": "a2a3854f-b395-377e-8dc0-b7f77e92f13d",
                                        "glosses": [
                                            "Prendre en location non pas du propriétaire, mais du locataire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7631c1-e8f4-48d9-985b-f0e1c9d89401",
                                                "sense_id": "9d494adf-728b-38e8-9cb4-1e14f9e5f8ba",
                                                "text": "À cause de sa femme, il m’a demandé de garder ma cambuse, de la lui sous-louer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7446ec0b-bdbd-460a-b9cb-a987d8ed9735",
                        "source_entry_id": "21bcf7dd-3017-3952-a446-626b89e97f65",
                        "source_sense_id": "2a131900-aad0-37e4-9951-b7ead06bfa27",
                        "source_sense_description": "lease or rent",
                        "target_lang_word": "untervermieten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untervermieten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5ceff77-6d38-3d4e-93f5-cd7fb7617695",
                                        "entry_id": "4c94d164-e5c6-3832-95c8-a63b3958d6a8",
                                        "glosses": [
                                            "Teile eines Mietobjektes an andere Personen vermieten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928b5c3e-9de3-47ea-9867-5a4db23b43fb",
                                                "sense_id": "f5ceff77-6d38-3d4e-93f5-cd7fb7617695",
                                                "text": "Weil Menschen wie Demir auf dem freien Wohnungsmarkt so gut wie keine Chance haben, springen überall im Land gemeinnützige Vereine als eine Art Puffer ein: Nicht die Bewohner schließen den Mietvertrag mit dem Eigentümer, sondern die Vereine, die die Wohnung dann untervermieten."
                                            },
                                            {
                                                "example_id": "ce72f9ce-7a2b-4dc0-9dfe-865a6b3b423f",
                                                "sense_id": "f5ceff77-6d38-3d4e-93f5-cd7fb7617695",
                                                "text": "Nur nach ausdrücklicher Erlaubnis des Vermieters dürfen Mieter ihre Wohnung an Touristen untervermieten."
                                            },
                                            {
                                                "example_id": "1f95adab-4ac7-4211-b1cd-304077c4c028",
                                                "sense_id": "f5ceff77-6d38-3d4e-93f5-cd7fb7617695",
                                                "text": "Das Paar wollte die Wohnung für die Dauer eines mehrjährigen beruflich bedingten Aufenthalts in Kanada teilweise untervermieten und danach wieder übernehmen."
                                            },
                                            {
                                                "example_id": "55ac4a1f-1ab2-4cde-a74c-7c158c6c1c8e",
                                                "sense_id": "f5ceff77-6d38-3d4e-93f5-cd7fb7617695",
                                                "text": "Nur wenn die Vermieterin/der Vermieter der gänzlichen Untervermietung zugestimmt hat oder diese im Mietvertrag gestattet ist, darf auch eine Wohnung, die teilweise oder voll dem Anwendungsbereich des Mietrechtsgesetzes unterliegt, zur Gänze untervermietet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
