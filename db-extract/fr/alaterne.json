                "senses": [
                    {
                        "sense_id": "ca193069-c30a-313c-a300-fb60bcccd63e",
                        "entry_id": "4d7b5080-09b7-335a-a60b-d9546fea2a81",
                        "glosses": [
                            "Arbrisseau, espèce de nerprun, dont les feuilles sont rangées alternativement le long des tiges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ea0078-8088-47d2-928f-5720b9480e2c",
                                "sense_id": "ca193069-c30a-313c-a300-fb60bcccd63e",
                                "text": "L’alaterne s’élève facilement de ses baies ou graines noires, comme aussi par marcottes."
                            },
                            {
                                "example_id": "11ca0b85-c974-44e8-b5a4-1c7e8d7fd374",
                                "sense_id": "ca193069-c30a-313c-a300-fb60bcccd63e",
                                "text": "Ses bords sont plantés de baguenaudiers, de pins en parasol au tronc rougeâtre, de peupliers à feuilles satinées, d’arbousiers, d’alaternes vernissés."
                            },
                            {
                                "example_id": "290daca5-6c4c-47e3-a47a-f52ab18874a7",
                                "sense_id": "ca193069-c30a-313c-a300-fb60bcccd63e",
                                "text": "Le Chêne-vert remonte jusqu’à Vienne, l’Alaterne va au Lyonnais et au Graisivaudan."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
