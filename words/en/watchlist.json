{
    "word_family": [
        "watch",
        "watcher",
        "watchful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4aed0c3-2f18-3ff8-9624-892a9c3b9741",
                    "sense_definition": "A list of people or things that are assigned to receive special attention or monitoring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "monitoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police have hundreds of citizens on their <w>watchlists</w>.",
                            "target_lang_translations": {
                                "zh": "警方有数百名公民在他们的<w>观察名单</w>上。"
                            }
                        },
                        {
                            "text": "Security officials added the suspicious individual to the <w>watchlist</w> for further investigation.",
                            "target_lang_translations": {
                                "zh": "安全官员将这名可疑人员加入<w>监控名单</w>以作进一步调查。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blacklist",
                        "dossier"
                    ],
                    "common_phrases": [
                        "official watchlist",
                        "security watchlist"
                    ],
                    "target_lang_definitions": {
                        "zh": "指需要特别关注或监控的人员或事物的名单。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "观察名单",
                                "target_lang_sense_clarification": "指为了监控或评估而列出的名单。"
                            },
                            {
                                "target_lang_word": "监控名单",
                                "target_lang_sense_clarification": "指处于安全或执法部门监视下的名单。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da0d529d-8b7c-3110-b9a3-4bab96405b5b",
                    "sense_definition": "To add to a watchlist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monitoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency decided to <w>watchlist</w> the company due to ongoing financial irregularities.",
                            "target_lang_translations": {
                                "zh": "由于持续的财务违规，该机构决定将这家公司<w>列入观察名单</w>。"
                            }
                        },
                        {
                            "text": "They were <w>watchlisted</w> after the security breach was discovered.",
                            "target_lang_translations": {
                                "zh": "安全漏洞被发现后，他们被<w>列入观察名单</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flag"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某人或某物列入观察名单。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "列入观察名单",
                                "target_lang_sense_clarification": "指将对象加入监控范围的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}