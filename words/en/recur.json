{
    "word_family": [
        "recurrence",
        "recurrent",
        "recurring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c514bfde-dd52-3a3a-8e9b-ae7fe724058f",
                    "sense_definition": "To happen or appear again, especially repeatedly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The same technical problems <w>recur</w> every time we update the software.",
                            "target_lang_translations": {
                                "pl": "Te same problemy techniczne <w>powtarzają się</w> za każdym razem, gdy aktualizujemy oprogramowanie."
                            }
                        },
                        {
                            "text": "The theme of betrayal <w>recurs</w> throughout the author's novels.",
                            "target_lang_translations": {
                                "pl": "Motyw zdrady <w>powraca</w> w powieściach tego autora."
                            }
                        }
                    ],
                    "synonyms": [
                        "reoccur",
                        "repeat",
                        "rehappen"
                    ],
                    "common_phrases": [
                        "problems recur",
                        "themes recur"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wydarzać się lub pojawiać ponownie, zwłaszcza wielokrotnie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powtarzać się",
                                "target_lang_sense_clarification": "najbardziej ogólne określenie powracających zdarzeń"
                            },
                            {
                                "target_lang_word": "pojawiać się ponownie",
                                "target_lang_sense_clarification": "w kontekście zjawisk lub problemów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c969984-e2bc-3773-9630-5663d300b78d",
                    "sense_definition": "Of a disease or symptom, to return after a period of improvement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor warned that the infection might <w>recur</w> if the patient stops the medication.",
                            "target_lang_translations": {
                                "pl": "Lekarz ostrzegł, że infekcja może <w>nawrócić</w>, jeśli pacjent przerwie przyjmowanie leków."
                            }
                        },
                        {
                            "text": "After years of remission, the symptoms began to <w>recur</w> suddenly.",
                            "target_lang_translations": {
                                "pl": "Po latach remisji objawy zaczęły nagle <w>powracać</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "recrudesce"
                    ],
                    "common_phrases": [
                        "symptoms recur"
                    ],
                    "target_lang_definitions": {
                        "pl": "W odniesieniu do choroby lub objawów, powrót po okresie poprawy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nawracać",
                                "target_lang_sense_clarification": "w kontekście medycznym, o chorobie"
                            },
                            {
                                "target_lang_word": "powracać",
                                "target_lang_sense_clarification": "o objawach chorobowych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dddab904-6bb0-36f9-bbe8-2d5a70756608",
                    "sense_definition": "To come back to one's mind or memory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The memory of that day <w>recurred</w> to him whenever he visited the old house.",
                            "target_lang_translations": {
                                "pl": "Wspomnienie tamtego dnia <w>powracało</w> do niego za każdym razem, gdy odwiedzał stary dom."
                            }
                        },
                        {
                            "text": "The disturbing thought <w>recurred</w> to her throughout the long meeting.",
                            "target_lang_translations": {
                                "pl": "Niepokojąca myśl <w>powracała</w> do niej przez całe długie spotkanie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Powracać do czyjegoś umysłu lub pamięci."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powracać",
                                "target_lang_sense_clarification": "o myślach lub wspomnieniach"
                            },
                            {
                                "target_lang_word": "stawać przed oczami",
                                "target_lang_sense_clarification": "o wspomnieniach, które wracają"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76182fc4-34ca-391f-850a-abf92ea3a1fb",
                    "sense_definition": "To return to a previous subject or topic in speech or writing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let us <w>recur</w> to the main point of our discussion before we run out of time.",
                            "target_lang_translations": {
                                "pl": "Wróćmy do głównego punktu naszej dyskusji, zanim skończy nam się czas."
                            }
                        },
                        {
                            "text": "The speaker had to <w>recur</w> to the initial evidence to support his argument.",
                            "target_lang_translations": {
                                "pl": "Mówca musiał <w>powrócić</w> do początkowych dowodów, aby poprzeć swój argument."
                            }
                        }
                    ],
                    "antonyms": [
                        "digress"
                    ],
                    "common_phrases": [
                        "recur to topic"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powracać do poprzedniego tematu w mowie lub piśmie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powracać",
                                "target_lang_sense_clarification": "do tematu dyskusji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f73c01f-ee07-30ae-9bd5-2da51c3bb0bb",
                    "sense_definition": "To turn to someone or something for help or support.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "resort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In times of crisis, the government had to <w>recur</w> to emergency funding measures.",
                            "target_lang_translations": {
                                "pl": "W czasach kryzysu rząd musiał <w>uciec się</w> do nadzwyczajnych środków finansowych."
                            }
                        },
                        {
                            "text": "They were forced to <w>recur</w> to legal action when negotiations failed.",
                            "target_lang_translations": {
                                "pl": "Byli zmuszeni <w>uciec się</w> do kroków prawnych, gdy negocjacje zawiodły."
                            }
                        }
                    ],
                    "synonyms": [
                        "recourse"
                    ],
                    "common_phrases": [
                        "recur to help"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zwracać się do kogoś lub czegoś po pomoc lub wsparcie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "uciekać się",
                                "target_lang_sense_clarification": "w kontekście szukania pomocy lub środków zaradczych"
                            },
                            {
                                "target_lang_word": "sięgać",
                                "target_lang_sense_clarification": "po rozwiązanie lub pomoc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4738a0cc-94e3-3a6c-9cf1-32353fd4e686",
                    "sense_definition": "Of digits in a decimal fraction, to repeat indefinitely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The number one-third is represented as a <w>recurring</w> decimal.",
                            "target_lang_translations": {
                                "pl": "Liczba jedna trzecia jest przedstawiana jako ułamek dziesiętny <w>okresowy</w>."
                            }
                        },
                        {
                            "text": "The digits in the sequence <w>recur</w> every three places.",
                            "target_lang_translations": {
                                "pl": "Cyfry w tym ciągu <w>powtarzają się</w> co trzy miejsca."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recurring decimal"
                    ],
                    "target_lang_definitions": {
                        "pl": "W odniesieniu do cyfr w ułamku dziesiętnym, powtarzać się w nieskończoność."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powtarzać się",
                                "target_lang_sense_clarification": "w kontekście matematycznym"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}