                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae9b13ae-db4d-3815-929d-4e6d2f37cc5e",
                                        "entry_id": "fd21ded6-2cdd-3654-92f2-c866e7db241a",
                                        "glosses": [
                                            "With appeal to; by; often used to introduce oaths"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f4f95b-da4b-4563-9c4a-03156457738b",
                                                "sense_id": "ae9b13ae-db4d-3815-929d-4e6d2f37cc5e",
                                                "text": "In the name of all things sacred, please stop that screaming!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ddfb81-76dd-3c47-82aa-4bec5738ecc2",
                                        "entry_id": "fd21ded6-2cdd-3654-92f2-c866e7db241a",
                                        "glosses": [
                                            "By the authority of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb59829e-4236-423f-8c24-bb9227c42510",
                                                "sense_id": "d4ddfb81-76dd-3c47-82aa-4bec5738ecc2",
                                                "text": "In the name of the law, come out with your hands up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8a733d1-36fc-35d4-b89f-6847870c43ec",
                                        "entry_id": "fd21ded6-2cdd-3654-92f2-c866e7db241a",
                                        "glosses": [
                                            "Under the name or possession of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d384cdf-99f0-4aaf-8da3-d18c83886ef7",
                                                "sense_id": "b8a733d1-36fc-35d4-b89f-6847870c43ec",
                                                "text": "He put the house in the name of his children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e74acbce-6575-3441-aef9-417fcb130798",
                                        "entry_id": "fd21ded6-2cdd-3654-92f2-c866e7db241a",
                                        "glosses": [
                                            "Under the designation or excuse of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e28645-1fef-401c-90b5-6192e7da2251",
                                                "sense_id": "e74acbce-6575-3441-aef9-417fcb130798",
                                                "text": "These additional checks at airports are justified in the name of security."
                                            },
                                            {
                                                "example_id": "32182f1c-b2e7-447e-b9c8-82c422a1606c",
                                                "sense_id": "e74acbce-6575-3441-aef9-417fcb130798",
                                                "text": "Prime Minister Prayuth Chan-ocha, who led the 2014 coup against Yingluck's government in the name of ending political turmoil, has promised that an election will be held next year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "948f73ec-20b3-4ac5-a3e3-b8cd749aa73c",
                        "source_entry_id": "89dc0682-b65d-3f5f-9913-8ebbab48dc24",
                        "source_sense_id": "21b920e0-1af0-3907-b951-adfd633d34cf",
                        "target_lang_word": "au nom de",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au nom de",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e042a0-8b6d-3d00-8175-72dcd42e4c47",
                                        "entry_id": "eb231597-d7c2-3d24-89fd-da9bb0d16a36",
                                        "glosses": [
                                            "De la part de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c37f42-bb99-4145-9f5c-a4212d9cf7f3",
                                                "sense_id": "d5e042a0-8b6d-3d00-8175-72dcd42e4c47",
                                                "text": "Quant aux citoyens de Tours, ils accueillirent pacifiquement le général gallo-romain, qui prit possession de la place au nom du roi Sighebert."
                                            },
                                            {
                                                "example_id": "d681699d-4ad6-4809-8358-e1cdc642dbf0",
                                                "sense_id": "d5e042a0-8b6d-3d00-8175-72dcd42e4c47",
                                                "text": "Au son de la cloche de la tour du palais, à Toulouse comme à Paris, le parlement se rendait en corps et en grand costume à la messe du Saint-Esprit, dite aussi la messe Rouge, pontificalement célébrée, avec orgue et musique, par un des évêques du ressort, officiellement invité par le premier président au nom du parlement."
                                            },
                                            {
                                                "example_id": "6d46f070-7c2f-4123-8c20-b9ab072e42f2",
                                                "sense_id": "d5e042a0-8b6d-3d00-8175-72dcd42e4c47",
                                                "text": "En mai 1785, il sollicite, au nom des habitants d’Orfeuil — mais à leur insu — un secours de 12.000 livres, sur les revenus de la province, pour la construction de l’église ou de la chapelle projetée, et pour le logement du desservant."
                                            },
                                            {
                                                "example_id": "cbdca816-5beb-49d5-8dca-a33b1300a3e0",
                                                "sense_id": "d5e042a0-8b6d-3d00-8175-72dcd42e4c47",
                                                "text": "Monsieur Yacha Heifetz, au nom du Président de la République et en vertu des pouvoirs qui nous sont conférés, nous vous faisons Grand-Croix de la Légion d'Honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc8fa701-e795-372d-a850-8648331c4797",
                                        "entry_id": "eb231597-d7c2-3d24-89fd-da9bb0d16a36",
                                        "glosses": [
                                            "En considération de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ed6e17-81bc-4143-9fef-90096d3483d5",
                                                "sense_id": "bc8fa701-e795-372d-a850-8648331c4797",
                                                "text": "Je vous demande cela au nom de notre ancienne amitié, au nom de tout ce que vous avez de plus cher."
                                            },
                                            {
                                                "example_id": "e87b88ea-209f-4888-a559-c4c090828988",
                                                "sense_id": "bc8fa701-e795-372d-a850-8648331c4797",
                                                "text": "Je vous en conjure au nom de Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
