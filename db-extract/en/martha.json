                    {
                        "translation_id": "01c32e73-067b-46a9-9bbd-5031af113b65",
                        "source_entry_id": "d70666c2-bf16-328e-9fde-da25b47c4321",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Marthe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marthe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06fa8f08-8e26-326a-a5b2-65fd85247bb8",
                                        "entry_id": "59ea4735-32f6-34c8-b97d-cc6fb781a457",
                                        "glosses": [
                                            "Sainte mentionnée dans le Nouveau Testament, sœur de Lazare et de Marie de Béthanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b82c49-24a2-42f4-8489-21a577ff98f7",
                                                "sense_id": "06fa8f08-8e26-326a-a5b2-65fd85247bb8",
                                                "text": "Pendant qu’ils étaient en chemin, il entra dans un certain bourg, et une femme, nommée Marthe, le reçut dans sa maison.\nElle avait une sœur, appelée Marie, qui, s’étant même assise aux pieds du Seigneur, écoutait sa parole.\nMarthe, qui était occupée par maint service, se présenta, disant : « Seigneur, vous n’avez cure que ma sœur me laissait seule faire le service ? Dites-lui donc de m’aider. »\nLe Seigneur lui répondit : « Marthe, Marthe, vous vous inquiétez et vous agitez pour beaucoup de choses !\nOr il n’est besoin que de peu de choses ou d’une seule. Marie en effet a choisi la bonne part, qui ne lui sera point ôtée. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91d61cb0-e219-3ca5-9d43-e4f625698552",
                                        "entry_id": "59ea4735-32f6-34c8-b97d-cc6fb781a457",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9801db9-90c1-49d6-b9bf-b5a6e2407a53",
                                                "sense_id": "91d61cb0-e219-3ca5-9d43-e4f625698552",
                                                "text": "La brune, Marthe Thiriet, fille du garde forestier, se dérobait aux interrogations, gardait son grand sérieux de personne réfléchie, qui ne confie pas ses secrets à la légère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
