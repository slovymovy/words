                                "sense_id": "18fee622-f792-3d0f-ac65-ca264b84aaa3",
                                "text": "L’éclimètre sert à mesurer les différences de niveau entre deux points."
                            },
                            {
                                "example_id": "c8d87e86-5eb3-4330-bd77-8e1a830547f3",
                                "sense_id": "18fee622-f792-3d0f-ac65-ca264b84aaa3",
                                "text": "L’éclimètre devient donc ainsi un véritable instrument olométrique (qui mesure tout), pour nous servir de l’expression de M. Porro."
                            }
                        ]
                    }
