                                    {
                                        "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                        "entry_id": "9803a1c3-0f89-3225-a1f7-ea58c35841a9",
                                        "glosses": [
                                            "Ableitung eines Ergebnisses aus gegebenen Voraussetzungen und Ergebnis dieser Ableitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e288d1f-766b-4f8f-b0cb-21f5c0001d20",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Paul presste die Lippen zusammen, schaute für einen Moment frustriert seitlich nach unten und konnte nicht glauben, was Lindsay da an Schlussfolgerungen bereithielt.“"
                                            },
                                            {
                                                "example_id": "e6973fc0-f056-42bc-a4f3-1fc8bfa02280",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Diese Schlussfolgerung ist fragwürdig.“"
                                            },
                                            {
                                                "example_id": "dc3fa6f2-7d86-454a-8641-3aca371745e9",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            },
                                            {
                                                "example_id": "222e6208-15ab-4c3b-b21f-7a0e1b90b3bc",
                                                "sense_id": "1b97f763-f03d-3841-b9a4-c2d22551a594",
                                                "text": "„Seine Schlussfolgerungen waren gedrängt, einfach und klar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
