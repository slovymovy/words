                "senses": [
                    {
                        "sense_id": "2bda102d-f5c8-350e-9352-0f937cf8bf8e",
                        "entry_id": "e7c5f2b0-2bc1-3ae2-ac73-802628dc277d",
                        "glosses": [
                            "groep mensen die is aangesteld om iets te onderhouden en te exploiteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58b25b52-5b5c-4e9c-bc3a-0f0e6b34a15d",
                                "sense_id": "2bda102d-f5c8-350e-9352-0f937cf8bf8e",
                                "text": "Het hoofddoekendebat zorgt ook in de Brusselse regering voor verdeeldheid. Ecolo, PS en Groen vormden daar een meerderheid in het beheerscomité van vervoersmaatschappij Mivb om niet in beroep te gaan tegen een veroordeling voor het weigeren van een sollicitante met hoofddoek. Daardoor staat de deur open om de hoofddoek toe te laten bij de MIVB, wat botst met het neutraliteitsprincipe in de beheersovereenkomst. Regeringscommissaris Vincent Riga – van Open VLD-signatuur – tekende ondertussen verzet aan tegen de beslissing."
                            },
                            {
                                "example_id": "88a803b5-8569-4801-bbc4-14824adacdf3",
                                "sense_id": "2bda102d-f5c8-350e-9352-0f937cf8bf8e",
                                "text": "De Brusselse regering moet zich buigen over de beslissing van het beheerscomité van de MIVB om geen beroep aan te tekenen tegen een veroordeling wegens discriminatie. De partijvoorzitter van Défi, François De Smet, dreigt ermee de Brusselse regering te verlaten."
                            },
                            {
                                "example_id": "241121dd-41e2-44f8-8779-f4aecc0837f3",
                                "sense_id": "2bda102d-f5c8-350e-9352-0f937cf8bf8e",
                                "text": "De Europese Commissie lanceerde in juni vorig jaar een inbreukprocedure tegen België over de onafhankelijkheid van de Gegevensbeschermingsautoriteit (GBA). Ze beschouwt sommige leden niet als ‘vrij van invloed van buitenaf’, omdat ze ‘ofwel verslag moeten uitbrengen bij een beheerscomité dat afhankelijk is van de Belgische regering, ofwel hebben deelgenomen aan overheidsprojecten voor de opsporing van covid-19-contacten, ofwel lid zijn van het Comité voor Informatieveiligheid’. Vooral Robben zou geviseerd worden, bleek toen uit een lek."
                            }
                        ]
                    }
