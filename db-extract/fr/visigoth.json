                        "examples": [
                            {
                                "example_id": "0dead149-9ca9-444e-9999-1ecf9b2a3f79",
                                "sense_id": "05ad66da-246f-3758-8e20-5e0de2d73ac5",
                                "text": "On trouve en effet au Code visigoth des articles qui ne portent ni le titre d’antiqua ni le nom du prince qui les a ajoutés."
                            },
                            {
                                "example_id": "dd0a1dbf-4310-4a01-bbe0-7ff8117e4474",
                                "sense_id": "05ad66da-246f-3758-8e20-5e0de2d73ac5",
                                "text": "C'est un recueil des lois en vigueur, des résolutions des Cortès, des coutumes nationales, des règles extraites des statuts particuliers, ainsi que d'autres sources juridiques, c'est-à-dire du droit romain, du droit visigoth et du droit canonique."
                            }
                        ]
                    }
