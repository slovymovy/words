                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b4f19e29-be6d-40be-b695-7c2a751aac1e",
                        "source_entry_id": "9e185eb7-a6c6-32d2-b3aa-c7676dd64c4d",
                        "source_sense_id": "2771f33f-fd13-3dd6-8698-980a0d18afc6",
                        "source_sense_description": "Einkünfte, die nicht versteuert sind",
                        "target_lang_word": "zwart geld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwart geld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2dcda005-0a73-348a-8136-614c48256db8",
                                        "entry_id": "89b543be-1d37-3174-a2bf-958148c8b83c",
                                        "glosses": [
                                            "betaalmiddelen die afkomstig zijn uit belastingontduiking of onwettige handel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28b2301-31e5-43d2-90f4-8f7f8d6e7e81",
                                                "sense_id": "2dcda005-0a73-348a-8136-614c48256db8",
                                                "text": "Als de Belastingdienst mensen met zwart geld op het spoor komt, betalen de spaarders niet alleen achterstallige belasting plus heffingsrente, maar ook een boete van minstens 50 procent van het belastingbedrag."
                                            },
                                            {
                                                "example_id": "352adf4a-b87f-4dff-bb54-2b7d8b67a206",
                                                "sense_id": "2dcda005-0a73-348a-8136-614c48256db8",
                                                "text": "⧖ Deze winsten hebben een teekenenden naam gekregen: Zwart geld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a739f32b-1164-3b83-9cba-9df2e1d6e48d",
                                        "entry_id": "89b543be-1d37-3174-a2bf-958148c8b83c",
                                        "glosses": [
                                            "muntstukken uit een legering van zilver en koper die door oxidatie een doffe, donkere kleur krijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e9d2b12-017d-44a7-acba-c8d24799071a",
                                                "sense_id": "a739f32b-1164-3b83-9cba-9df2e1d6e48d",
                                                "text": "⧖ Zoo heeft men dan ook in Teheran en in andere steden van Perzië met garnizoenen de treurige gelegenheid, den Perzischen soldaat in uniform in de bazars als ambachtsman en daglooner bezig te zien , of aan de hoeken der levendigste straten te zien zitten meestal in de nabijheid van zijn wachtpost, en het bekende pül-e-sia, „zwart geld!\" dat is: „Wie wil kopergeld wisselen?\" luid te hooren schreeuwen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
