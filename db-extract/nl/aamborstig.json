                                        "entry_id": "32f9b7c1-5539-3ab6-9ae6-e53c59c087d3",
                                        "glosses": [
                                            "unter Anstrengungen und mit kurzen Atemzügen atmend, unter chronischer Atemnot leidend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a57c71-b86b-4bdf-a01f-3df949f82a8e",
                                                "sense_id": "c014b79e-d54b-374d-a0ac-9709ac825a8a",
                                                "text": "„Hosiah war zusehends häufiger müde und kurzatmig, und das mit anzusehen tat Darko weh.“"
                                            }
