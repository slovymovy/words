        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                    "sense_definition": "Not one nor the other of two people or things.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "binary_negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the end, <w>neither</w> side won the game.",
                            "target_lang_translations": {
                                "ru": "В конце концов, <w>ни одна</w> из сторон не выиграла игру.",
                                "tr": "Sonunda <w>hiçbir</w> taraf oyunu kazanamadı.",
                                "zh": "最终，<w>两</w>方<w>都</w>没赢得比赛。",
                                "nl": "Uiteindelijk won <w>geen van beide</w> partijen de wedstrijd.",
                                "pl": "Ostatecznie <w>żadna</w> ze stron nie wygrała gry.",
                                "de": "Am Ende hat <w>keine</w> Seite das Spiel gewonnen.",
                                "fr": "Finalement, <w>aucun des deux</w> camps n'a gagné la partie.",
                                "it": "Alla fine, <w>nessuna delle due</w> parti ha vinto la partita.",
                                "cs": "Nakonec <w>žádná</w> ze stran hru nevyhrála.",
                                "es": "Al final, <w>ningún</w> bando ganó el partido."
                            }
                        },
                        {
                            "text": "<w>Neither</w> answer seems to be correct.",
                            "target_lang_translations": {
                                "ru": "<w>Ни один</w> ответ не кажется правильным.",
                                "tr": "İki cevaptan <w>hiçbiri</w> doğru görünmüyor.",
                                "zh": "<w>两</w>个答案<w>都</w>不正确。",
                                "nl": "<w>Geen van beide</w> antwoorden lijkt correct te zijn.",
                                "pl": "<w>Żadna</w> odpowiedź nie wydaje się poprawna.",
                                "de": "<w>Keine</w> der Antworten scheint richtig zu sein.",
                                "fr": "<w>Aucune des deux</w> réponses ne semble correcte.",
                                "it": "<w>Nessuna delle due</w> risposte sembra essere corretta.",
                                "cs": "<w>Žádná</w> odpověď se nezdá být správná.",
                                "es": "<w>Ninguna</w> respuesta parece ser correcta."
                            }
                        }
                    ],
                    "antonyms": [
                        "both"
                    ],
                    "common_phrases": [
                        "neither one",
                        "neither side",
                        "neither way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни один и ни другой из двух людей или предметов.",
                        "tr": "İki kişi veya şeyden ne biri ne de diğeri.",
                        "zh": "指两者都不。",
                        "nl": "Niet de een en niet de ander van twee personen of dingen.",
                        "pl": "Żaden z dwóch ludzi lub przedmiotów.",
                        "de": "Keiner von zwei Personen oder Dingen.",
                        "fr": "Ni l'un ni l'autre de deux personnes ou choses.",
                        "it": "Nessuno dei due; non l'uno né l'altro di due persone o cose.",
                        "cs": "Ani jeden z dvou lidí nebo věcí.",
                        "es": "Ni uno ni otro de dos personas o cosas."
                    },
