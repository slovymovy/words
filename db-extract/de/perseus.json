                                        "sense_id": "52a1a43d-acd2-3829-aa35-e836915723bf",
                                        "entry_id": "5870bbd5-8f9c-3551-ac7f-943a3fe11081",
                                        "glosses": [
                                            "An autumn constellation of the northern sky, said to resemble the mythical hero. It includes the stars Algenib, Algol, and Mirfak."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2016109a-086e-3977-985e-0d4b68e0fe41",
