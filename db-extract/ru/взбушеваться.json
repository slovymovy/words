                        "examples": [
                            {
                                "example_id": "cbd29856-adb9-4b3d-b96f-ef9d10404b9a",
                                "sense_id": "7fe363e8-1aca-3d10-8ddb-142208cf18cf",
                                "text": "То капля надежды блеснёт, то взбушуется море отчаяния, и всё боль, всё боль, всё тоска и всё одно и то же."
                            },
                            {
                                "example_id": "ebb46200-84a6-4618-9580-99dd0d501cfe",
                                "sense_id": "7fe363e8-1aca-3d10-8ddb-142208cf18cf",
                                "text": "Если бы арестовали мою жену, я бы взбушевался."
                            }
                        ]
                    }
