                        "examples": [
                            {
                                "example_id": "ab752f8e-c508-4bf2-b43d-a47a4a703363",
                                "sense_id": "1be1658c-57cb-3bab-8048-b9fae4a07dba",
                                "text": "... ze had een broer in San Francisco en zelf had ze een jaar op de filmacademie gezeten in haar geboorteplaats voor ze naar New York was verhuisd..."
                            },
                            {
                                "example_id": "8deee527-d85e-459a-8fad-02b5d1c7bbac",
                                "sense_id": "1be1658c-57cb-3bab-8048-b9fae4a07dba",
                                "text": "Het echtpaar Peter Lataster en Petra Lataster-Cszich maakt al decennia prijswinnende documentaires. Ze leerden elkaar kennen in Potsdam, waar ze beiden een opleiding volgden aan de Filmacademie. Hun meest recente bekende film is De kinderen van juf Kiet uit 2016. Daarin volgden zij een jaar lang een Brabantse juf en haar klas met leerlingen, van wie er veel van niet-Nederlandse komaf zijn. Sommigen komen uit oorlogsgebieden."
                            }
                        ]
