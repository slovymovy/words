                                                "example_id": "b58f05fd-5846-44cf-ab32-833c0a4510f0",
                                                "sense_id": "509c7b15-525b-3775-91b7-21895754371c",
                                                "text": "1987, Kai Hansen, \"Halloween\", Helloween, Keeper Of The Seven Keys: Part 1.\nBlack is the night full of fright / You'll be missing the day / What will be here very soon / Changing your way / A knock at your door / It is real or is it a dream / On trembling legs you open the door / And you scream... on Halloween"
                                            }
                                        ]
