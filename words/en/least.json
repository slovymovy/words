                                "target_lang_sense_clarification": "常用于否定句，表示极小的程度"
                            },
                            {
                                "target_lang_word": "最小",
                                "target_lang_sense_clarification": "指程度或重要性"
                            }
                        ]
                    }
                }
            ]
        },
        {
