                "senses": [
                    {
                        "sense_id": "41a446ee-f423-3a50-8a2f-1272d4e62f8a",
                        "entry_id": "ee5f7e90-e549-3bf9-a0d5-1941fec17ea2",
                        "glosses": [
                            "lijkend op zwavel, met de eigenschappen van zwavel of zwavelverbindingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7819b373-a684-4037-a1a9-daa9ce4dcf67",
                                "sense_id": "41a446ee-f423-3a50-8a2f-1272d4e62f8a",
                                "text": "Cornelis loopt het atelier in en controleert de paletten. De leerjongens zijn op de wrijfstenen met karmozijn, Keulse aarde, rauwe sienna en Turkse omber in de weer geweest. Ook wordt zijn neus geprikkeld door de karakteristieke stank van orpiment, een zwavelachtig mineraal waarmee gele verf wordt gemaakt."
                            },
                            {
                                "example_id": "41dfd208-ba87-442c-a6a9-593789bde234",
                                "sense_id": "41a446ee-f423-3a50-8a2f-1272d4e62f8a",
                                "text": "Een deel van het UMCG in Groningen is ontruimd omdat er in de buurt een gaslucht is geroken. De \"zwavelachtige geur\" komt volgens de brandweer uit een laboratorium. Er is geen gaslek."
                            }
                        ]
                    }
