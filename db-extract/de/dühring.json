                ],
                "senses": [
                    {
                        "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                        "entry_id": "d8e61aae-6e71-3e32-8602-532e9e8ef6e7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f177655c-93ac-4e09-aec2-2ea43af1dd2f",
                                "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                                "text": "Frau Dühring ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "893d22ea-afbd-4829-a240-ebb74e7f1d70",
                                "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                                "text": "Herr Dühring wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4e5ae070-4779-461a-81f2-9c90e24208b7",
                                "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                                "text": "Die Dührings fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "d07f4319-b214-4ebd-bc9d-0d6f103d0eb6",
                                "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                                "text": "Der Dühring trägt nie die Pullover, die die Dühring ihm strickt."
                            },
                            {
                                "example_id": "11501846-2d26-4432-ba41-0dca4b8f866d",
                                "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dühring kommt, geht der Herr Dühring.“"
                            },
                            {
                                "example_id": "20c36811-5108-4229-bbe9-fccf7e12686e",
                                "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                                "text": "Dühring kommt und geht."
                            },
                            {
                                "example_id": "4575bef0-95dd-4cb8-b6ea-fecf5cebcfa8",
                                "sense_id": "730cfc02-dcc4-3076-8752-132ef0e4db5c",
                                "text": "Dührings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
