                    {
                        "translation_id": "93a173d5-e8ac-4c2a-b7e6-b0879a1a1c53",
                        "source_entry_id": "64f07798-628a-3724-8afd-db0ac344fe32",
                        "source_sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                        "target_lang_word": "brood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7bf0d4e-15d8-376c-9086-3e7de622ec57",
                                        "entry_id": "66c2ffa3-ff24-3e61-a3c1-005592ab659a",
                                        "glosses": [
                                            "To keep an egg warm to make it hatch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "282bd2e5-bb7c-484b-a5ff-e0eeb9561494",
                                                "sense_id": "d7bf0d4e-15d8-376c-9086-3e7de622ec57",
                                                "text": "In some species of birds, both the mother and father brood the eggs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d11900d-e0f0-3489-b500-1487f420e7e8",
                                        "entry_id": "66c2ffa3-ff24-3e61-a3c1-005592ab659a",
                                        "glosses": [
                                            "To protect (something that is gradually maturing); to foster."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "825ee1e4-7672-486c-9323-7d09383a53fc",
                                                "sense_id": "4d11900d-e0f0-3489-b500-1487f420e7e8",
                                                "text": "Under the rock was a midshipman fish, brooding a mass of eggs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ddb325-a07c-3afd-a11d-0a08f3444f19",
                                        "entry_id": "66c2ffa3-ff24-3e61-a3c1-005592ab659a",
                                        "glosses": [
                                            "(typically with over, on or about) To dwell upon moodily and at length, mainly alone."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d7d044-041a-429a-a635-06b8bfbbf5e1",
                                                "sense_id": "90ddb325-a07c-3afd-a11d-0a08f3444f19",
                                                "text": "He sat brooding about the upcoming battle, fearing the outcome."
                                            },
                                            {
                                                "example_id": "257de611-671f-426b-82ec-a26c52ef00de",
                                                "sense_id": "90ddb325-a07c-3afd-a11d-0a08f3444f19",
                                                "text": "As when with downcast eyes we muse and brood"
                                            },
                                            {
                                                "example_id": "c68a86f6-b74a-4bb8-8bdc-83d68cee123a",
                                                "sense_id": "90ddb325-a07c-3afd-a11d-0a08f3444f19",
                                                "text": "Brooding over all these matters, the mother felt like one who has evoked a spirit."
                                            },
                                            {
                                                "example_id": "3943c316-6753-4a74-ac62-c2526e807ca3",
                                                "sense_id": "90ddb325-a07c-3afd-a11d-0a08f3444f19",
                                                "text": "But Claggart's was no vulgar form of the passion. Nor, as directed toward Billy Budd, did it partake of that streak of apprehensive jealousy that marred Saul's visage perturbedly brooding on the comely young David. Claggart's envy struck deeper."
                                            },
                                            {
                                                "example_id": "2fd779bf-7b32-4e52-96ff-b766a26ec912",
                                                "sense_id": "90ddb325-a07c-3afd-a11d-0a08f3444f19",
                                                "text": "And as I sat there brooding on the old, unknown world, I thought of Gatsby's wonder when he first picked out the green light at the end of Daisy's dock. He had come a long way to this blue lawn, and his dream must have seemed so close that he could hardly fail to grasp it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff76bb2-4eaf-306b-a4c1-43cfd4aa1eb3",
                                        "entry_id": "66c2ffa3-ff24-3e61-a3c1-005592ab659a",
                                        "glosses": [
                                            "To be bred."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96f4a5c5-68e1-3c7b-b47d-3695a3064762",
                                        "entry_id": "e27b4561-5b45-34ab-af53-18fc49237737",
                                        "glosses": [
                                            "The young of certain animals, especially a group of young birds or fowl hatched at one time by the same mother."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b05b77d-eeba-4b5b-8cb9-793f4aa365d2",
                                                "sense_id": "96f4a5c5-68e1-3c7b-b47d-3695a3064762",
                                                "text": "As a hen doth gather her brood under her wings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5ab797b-998e-31c0-a107-3e4b59fdd39d",
                                        "entry_id": "e27b4561-5b45-34ab-af53-18fc49237737",
                                        "glosses": [
                                            "The young of any egg-laying creature, especially if produced at the same time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df3f1f04-e6c5-37fe-8e98-2903943d4135",
                                        "entry_id": "e27b4561-5b45-34ab-af53-18fc49237737",
                                        "glosses": [
                                            "The eggs and larvae of social insects such as bees, ants and some wasps, especially when gathered together in special brood chambers or combs within the colony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a86123cd-4efe-394a-8e4f-1bed8bbe90c1",
                                        "entry_id": "e27b4561-5b45-34ab-af53-18fc49237737",
                                        "glosses": [
                                            "The children in one family; offspring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0391e5bb-7bdf-4f02-a5dc-1e4a1ba17335",
                                                "sense_id": "a86123cd-4efe-394a-8e4f-1bed8bbe90c1",
                                                "text": "Ay, lord, she will become thy bed, I warrant, / And bring thee forth brave brood."
                                            },
                                            {
                                                "example_id": "ec49b909-39da-4c15-b0f9-e152130ddda6",
                                                "sense_id": "a86123cd-4efe-394a-8e4f-1bed8bbe90c1",
                                                "text": "Garland Green, the tenth in a brood of eleven, was born on June 24, 1942, in Dunleath, Mississippi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4dbc76b-d42f-3df6-b8f9-cbeecd4fd8a4",
                                        "entry_id": "e27b4561-5b45-34ab-af53-18fc49237737",
                                        "glosses": [
                                            "That which is bred or produced; breed; species."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976fb365-4289-4ec7-a668-441e34fe4f78",
                                                "sense_id": "e4dbc76b-d42f-3df6-b8f9-cbeecd4fd8a4",
                                                "text": "[…] flocks of the airy brood,\nCranes, geese or long-neck'd swans, here, there, proud of their pinions fly […]"
                                            },
                                            {
                                                "example_id": "2354a25b-d3ce-42f5-ac91-165774424969",
                                                "sense_id": "e4dbc76b-d42f-3df6-b8f9-cbeecd4fd8a4",
                                                "text": "Devouring Time, blunt thou the lion's paws,\nAnd make the earth devour her own sweet brood […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e15aeb96-b87a-3754-a8ae-819f6254f63a",
                                        "entry_id": "e27b4561-5b45-34ab-af53-18fc49237737",
                                        "glosses": [
                                            "Parentage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
