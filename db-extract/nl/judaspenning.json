                    },
                    {
                        "translation_id": "c66afd01-1b0c-43f2-80e0-bb9b3d6deea5",
                        "source_entry_id": "9c3e6558-10a5-39c4-8f18-0bb91785e442",
                        "source_sense_id": "566e55fb-2df0-3aef-a78e-3fdcee6bf569",
                        "source_sense_description": "naam voor planten uit het geslacht Lunaria",
                        "target_lang_word": "Judaspfennig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7b188ee6-654b-4488-a231-6bddf0091f36",
                        "source_entry_id": "9c3e6558-10a5-39c4-8f18-0bb91785e442",
                        "source_sense_id": "566e55fb-2df0-3aef-a78e-3fdcee6bf569",
                        "source_sense_description": "naam voor planten uit het geslacht Lunaria",
                        "target_lang_word": "honesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "The act, quality, or condition of being honest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4624d23-fd06-4138-a1ed-2b4235cd29bd",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "academic / artistic / emotional / intellectual honesty"
                                            },
                                            {
                                                "example_id": "28a4c0d2-e815-4417-98bd-d99cd49c90a1",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "brutal / devastating / searing honesty"
                                            },
                                            {
                                                "example_id": "da12768b-a5e1-49c3-9a8f-780441a2eae0",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "There’s no trust, / No faith, no honesty in men; all perjured, / All forsworn, all naught, all dissemblers."
                                            },
                                            {
                                                "example_id": "3e75e1cb-2086-4789-baa9-c802ae305533",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "1787, George Colman, Junior, Inkle and Yarico, London: G.G.J. & J. Robinson, Act 2, p. 45,\nO give me your plain dealing Fellows\nWho never from honesty shrink;\nNot thinking on all they shou’d tell us,\nBut telling us all that they think."
                                            },
                                            {
                                                "example_id": "92a4bd1c-8abf-4ced-b7f9-f27347896b62",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "[…] Are you honest, boy? / Then be not spendthrift of your honesty, / But keep it to yourself; in Padua / Men think that honesty is ostentatious, so / It is not of the fashion."
                                            },
                                            {
                                                "example_id": "2aa4285a-cb24-4c72-a4c8-3f74a6d24289",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "To those who knew her and to the greatly enlarged circle who were electrified by her last poems and sudden death, she had come to signify the specific honesties and risks of the poet’s condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Honor; decency, propriety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02012f49-789c-40fc-ba29-63f2420e14ec",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "Have ye no wit, manners, nor honesty, but to gabble like tinkers at this time of night?"
                                            },
                                            {
                                                "example_id": "dc6092e2-0f95-4858-8843-ff0301c35d90",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "Fellovves in armes faithfull and valiant, / I thanke you for your paines and honeſties, […]"
                                            },
                                            {
                                                "example_id": "49ba45f2-5759-45ea-9e80-dbb5c1a7444a",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "[…] that we may lead a quiet and peaceable life in all godliness and honesty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Chastity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8045188-c6bf-4549-935e-2749d4b8e2f7",
                                                "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                                "text": "[…] spend all I have; only give me so much of your time in exchange of it, as to lay an amiable siege to the honesty of this Ford’s wife […]"
                                            },
                                            {
                                                "example_id": "29be6351-5bf4-470c-8105-a647778c1529",
                                                "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                                "text": "c. 1625, John Fletcher, The Fair Maid of the Inn, Act V, Scene 1, in Alexander Dyce (editor), The Works of Beaumont and Fletcher, New York: Appleton, 1890, Volume 2, p. 669,\n[…] Oh, these vild women,\nThat are so ill preservers of men’s honours,\nThey cannot govern their own honesties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Any of various crucifers in the genus Lunaria, several of which are grown as ornamentals, particularly annual honesty (Lunaria annua)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89822d94-5d5a-4824-8f57-123216c31c54",
                                                "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                                "text": "Various measures were taken to avoid it, most popular being the suspension of certain herbs and tree branches over the doorways of dwellings and stables. Commonly used greenery were tansy, honesty, garlic, St. John's Wort, mountain ash, roadside verbena."
                                            },
                                            {
                                                "example_id": "d135cff8-2a6f-438a-aa8b-ed5f8ab09c62",
                                                "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                                "text": "She thought a minute, then stepped nimbly back into her cottage; and what she came out with at last was, a sprig of dry leaves, round as shillings, white as paper, quivering on a few thin stalks that looked ready to snap. / It was honesty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b94f0941-15df-4703-b93e-1b51d255e64f",
                        "source_entry_id": "9c3e6558-10a5-39c4-8f18-0bb91785e442",
                        "source_sense_id": "566e55fb-2df0-3aef-a78e-3fdcee6bf569",
                        "source_sense_description": "naam voor planten uit het geslacht Lunaria",
                        "target_lang_word": "lunaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lunaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17bf4435-0c73-3820-a4ad-c815080aeaeb",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Relatif à la Lune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c58849ae-255e-4fb6-9cab-54c9cda2bf31",
                                                "sense_id": "17bf4435-0c73-3820-a4ad-c815080aeaeb",
                                                "text": "Ses cheveux, d'un blond argent – platine –, fins et soyeux, évoquaient plus les rayons lunaires que ceux du soleil."
                                            },
                                            {
                                                "example_id": "c050f6a9-a4f3-4ad9-83da-04f28248a769",
                                                "sense_id": "17bf4435-0c73-3820-a4ad-c815080aeaeb",
                                                "text": "Les résultats de ces calculs montrent donc que la contribution des comètes n’a pu vraisemblablement pas excéder 20 % de la masse totale de l’eau interne lunaire."
                                            },
                                            {
                                                "example_id": "9e20d59f-7fe2-4866-8171-711449e52c53",
                                                "sense_id": "17bf4435-0c73-3820-a4ad-c815080aeaeb",
                                                "text": "Sur le même fragment, Rehm découvrit aussi les chiffres 76, soit quatre fois 19, donc un raffinement grec du cycle de dix-neuf ans, ainsi que le chiffre 223 correspondant au nombre de lunaisons contenues du « saros », la période de 223 lunaisons (environ dix-huit ans) que les Babyloniens employaient pour prédire les éclipses lunaires et solaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e100c0d-9789-3c28-89c4-1ac764d88074",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Qualifie un calendrier dont les mois sont déterminés par des lunaisons."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d2c5186-9378-401a-a494-59a55b0dca7a",
                                                "sense_id": "4e100c0d-9789-3c28-89c4-1ac764d88074",
                                                "text": "Depuis le 24 janvier nous sommes en ramadan, neuvième mois de l’année lunaire mahométane, pendant lequel tout bon musulman s’abstient de manger, de boire, de fumer, bref, de toute jouissance charnelle, depuis l’aube jusqu'au coucher du soleil."
                                            },
                                            {
                                                "example_id": "3e5ec2f7-3a8b-4f1e-aefd-fb3d085dfe88",
                                                "sense_id": "4e100c0d-9789-3c28-89c4-1ac764d88074",
                                                "text": "Cette fête, appelée Khánh Ha, se déroule du 12e au 14e jour du 4e mois lunaire (qui tombe généralement au mois de mai solaire)."
                                            },
                                            {
                                                "example_id": "df750b35-12ba-4163-95cd-17f005372f5f",
                                                "sense_id": "4e100c0d-9789-3c28-89c4-1ac764d88074",
                                                "text": "En revanche, l’intitulé de la réception ne cesse d’évoluer au fil du temps : on trouve « Nouvel An chinois » en 2010, puis « Nouvel An chinois et vietnamien » en 2012, devenu « Nouvel An lunaire », à partir de 2013 et enfin « Nouvel An du calendrier lunaire »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6853a0ba-4b16-3732-8a84-18f1c3204cf0",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Qualifie une date déterminée par la Lune."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92caf48c-11f0-4890-83c5-e1b1b0fe013e",
                                                "sense_id": "6853a0ba-4b16-3732-8a84-18f1c3204cf0",
                                                "text": "La fête d’Amon commençant au début du premier mois de la saison Shémou (Tepy Shémou) est généralement comprise comme une date lunaire et un grand nombre d’événements relatifs à la vie des temples (initiations sacerdotales, nominations) sont datés de ce jour et donc potentiellement datés astronomiquement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5caabce-73ca-376b-a9c4-c698aded8313",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Semblable à la Lune."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9ac4e5-2b0c-40d1-93bc-9deed406b53e",
                                                "sense_id": "e5caabce-73ca-376b-a9c4-c698aded8313",
                                                "text": "Là-dessus notre équipe eut mission d’aller à Souain […]. Une demi-heure après nous étions sur le terrain volcanique et comme lunaire tant de fois décrit, et réellement indes­criptible. Des coups de pouce d’un sculpteur gigantesque dans la glaise séchée, ou bien cet aspect des nids de guêpes, gris et feuilletés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d484fcc7-35a8-3269-841d-ad2eaae2ac6d",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Relatif aux menstrues."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e524580b-4b0e-48fc-8800-b42cf113ff47",
                                                "sense_id": "d484fcc7-35a8-3269-841d-ad2eaae2ac6d",
                                                "text": "Les nonnes fertiles lui offrent, aux périodes lunaires, une goutte symbolique de leur dégoulinure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc8a213-e7aa-3f40-adb9-bcd791869f9a",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Rêveur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880445b1-0bf7-4882-96de-2fb250053e1f",
                                                "sense_id": "bcc8a213-e7aa-3f40-adb9-bcd791869f9a",
                                                "text": "Il me témoignait cette sorte de bienveillance que les gens d’une certaine assiette réservent à des individus estimables, mais un peu lunaires ou déclassés et qu’ils se gardent de prendre trop au sérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a30eb263-f34e-33f1-a087-57fa6ae9e7ea",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Incroyable."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfcc7ba2-1f8a-4d7c-86b7-2b8fd7883d0b",
                                                "sense_id": "a30eb263-f34e-33f1-a087-57fa6ae9e7ea",
                                                "text": "C’est totalement lunaire, il y a plein de dossiers de fond qui ne peuvent pas avancer s’il n’y a pas de décision politique."
                                            },
                                            {
                                                "example_id": "79eeb910-cbb3-4cd3-843f-699ed3800913",
                                                "sense_id": "a30eb263-f34e-33f1-a087-57fa6ae9e7ea",
                                                "text": "La saison de l’autre locomotive bleue, Émilien Jacquelin, n’est pas plus brillante, symbolisée par un 64ᵉ place lunaire en Slovénie."
                                            },
                                            {
                                                "example_id": "28f72792-1e0b-4674-9452-cf975180a578",
                                                "sense_id": "a30eb263-f34e-33f1-a087-57fa6ae9e7ea",
                                                "text": "La déclaration lunaire de Wilander: « Ils sont en train de suivre les traces du « Big 3 » en termes de niveau de jeu. J’espère que Roger Federer, Rafael Nadal et Novak Djokovic n’écoutent pas, mais en termes de niveau, lorsque Sinner et Alcaraz sont au top de leur forme, il n’y a aucun moyen que quelqu’un ait joué un meilleur tennis, que la balle de tennis ait fait plus de choses différentes, compliquées et difficiles que celle entre Sinner et Alcaraz. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4240c80f-da84-3611-b308-a6e0a0e8d9e9",
                                        "entry_id": "43472b35-7d6a-35ef-a9ea-bf894e83249f",
                                        "glosses": [
                                            "Qualifie les quatorze consonnes non coronales de l'arabe (ʾ, b, ǧ, ḥ, ẖ, ʿ, ġ, f, q, k, m, h, w, y) qui ne provoquent pas l'assimilation du l de l’article al avec l'initiale du mot suivant, comme avec la lune القمر \\\"al-qamar\\\". Ceci contrairement aux consonnes dites solaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lunaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc196cf-de06-3f3d-b3aa-cb5a688f5495",
                                        "entry_id": "fc6761bf-9901-3293-85d8-2e18713a9eee",
                                        "glosses": [
                                            "Plante de la famille des Brassicaceae (ou Cruciferae), du genre Lunaria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea650c6-58fe-449d-ae28-82706a49f850",
                                                "sense_id": "4fc196cf-de06-3f3d-b3aa-cb5a688f5495",
                                                "text": "On mange en salade la racine de la lunaire."
                                            },
                                            {
                                                "example_id": "ecd8ef47-d0f1-43c5-8113-c406511d7119",
                                                "sense_id": "4fc196cf-de06-3f3d-b3aa-cb5a688f5495",
                                                "text": "La lunaire, bien connue sous le nom de « monnaie du pape », est une plante ornementale souvent employée pour agrémenter les corbeilles et les plates bandes de nos jardins."
                                            }
                                        ]
                                    }
                                ]
