{
    "word_family": [
        "szum",
        "szumieć"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6220efaa-01eb-3a5d-888c-6c894c569b80",
                    "sense_definition": "Piana lub osad zbierający się na powierzchni gotowanych płynów.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kulinaria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W trakcie gotowania rosołu należy regularnie usuwać pojawiającą się <w>szumowinę</w>.",
                            "target_lang_translations": {
                                "ru": "Во время варки бульона нужно регулярно снимать появляющуюся <w>накипь</w>."
                            }
                        },
                        {
                            "text": "Dzięki dokładnemu zbieraniu <w>szumowin</w> wywar staje się klarowny i przejrzysty.",
                            "target_lang_translations": {
                                "ru": "Благодаря тщательному снятию <w>накипи</w> бульон становится прозрачным и чистым."
                            }
                        }
                    ],
                    "synonyms": [
                        "piana"
                    ],
                    "common_phrases": [
                        "zbierać szumowiny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пена или осадок, образующиеся на поверхности кипящих жидкостей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накипь",
                                "target_lang_sense_clarification": "пена, образующаяся при варке супа или бульона"
                            },
                            {
                                "target_lang_word": "пена",
                                "target_lang_sense_clarification": "общий термин для пены, собирающейся при варке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83cd352d-4989-3146-9324-6a8d7f6d5916",
                    "sense_definition": "Osoba o bardzo podłym charakterze lub grupa takich osób.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ludzie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W parku w centrum miasteczka zbierały się najgorsze <w>szumowiny</w>.",
                            "target_lang_translations": {
                                "ru": "В парке в центре городка собирались самые последние <w>подонки</w>."
                            }
                        },
                        {
                            "text": "Policja w końcu aresztowała te <w>szumowiny</w>, które okradały starszych ludzi.",
                            "target_lang_translations": {
                                "ru": "Полиция наконец арестовала этих <w>подонков</w>, которые обворовывали пожилых людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwyrodnialec",
                        "hołota",
                        "męt"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "określenie pejoratywne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Презрительное обозначение людей с низкими моральными качествами, подонки общества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подонки",
                                "target_lang_sense_clarification": "презрительное название людей, опустившихся на дно общества"
                            },
                            {
                                "target_lang_word": "накипь",
                                "target_lang_sense_clarification": "переносное значение, обозначающее вредные элементы в обществе"
                            },
                            {
                                "target_lang_word": "отбросы",
                                "target_lang_sense_clarification": "крайне пренебрежительное обозначение людей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}