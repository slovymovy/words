                "senses": [
                    {
                        "sense_id": "6951a324-32b3-352c-be2a-11045723f6ee",
                        "entry_id": "b9acf7ce-e968-3de7-9338-de04b71faa04",
                        "glosses": [
                            "unerwartete Ansteckung, nachdem eigentlich ein Schutz vorliegen sollte, zum Beispiel, weil zuvor eine Impfung oder Behandlung erfolgte"
                        ],
                        "tags": [
                            "Infektiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7f2ff8a8-29ad-4cad-ab87-3df89cd65966",
                                "sense_id": "6951a324-32b3-352c-be2a-11045723f6ee",
                                "text": "„Eine Durchbruchinfektion (IA) ist definiert als Infektion, die während oder kurz nach einer antimykotischen Therapie mit Anti-Aspergillus-Aktivität auftritt, unabhängig von der Art dieser Therapie (prophylaktisch, empirisch, präemptiv oder Kultur- +/- Histologie-basiert).“"
                            },
                            {
                                "example_id": "24b2f934-4d26-4c86-8114-7e98f5ad9d8c",
                                "sense_id": "6951a324-32b3-352c-be2a-11045723f6ee",
                                "text": "„Diese Prävention könne bereits unter der Akuttherapie begonnen werden und sollte bei einer Durchbruchinfektion nicht unterbrochen werden, heißt es in der Leitlinie.“"
                            },
                            {
                                "example_id": "1b3d8439-dbaa-4cbf-af57-0f1aecaf7630",
                                "sense_id": "6951a324-32b3-352c-be2a-11045723f6ee",
                                "text": "„Wenige Wochen nach abgeschlossener SARS-CoV-2-Impfung kann es durch Virusvarianten zu Durchbruchinfektionen kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
