                                    {
                                        "sense_id": "e96cc02e-7c51-3239-bea9-5ee739e5b19a",
                                        "entry_id": "52213c28-cedc-3672-99b4-914f054da631",
                                        "glosses": [
                                            "aktiv einer Sache eine neue Form verleihen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d42cef2-93dd-4870-ac9f-3061b84152dd",
                                                "sense_id": "e96cc02e-7c51-3239-bea9-5ee739e5b19a",
                                                "text": "Der österreichische Kanzler war gezwungen, sein Kabinett umzubilden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b81e98e-3ac1-387c-9773-7212ec679c40",
                                        "entry_id": "52213c28-cedc-3672-99b4-914f054da631",
                                        "glosses": [
                                            "sich (von selbst) in einen anderen Zustand verwandeln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74fa0a90-c808-4f17-b1b4-15301086489a",
                                                "sense_id": "7b81e98e-3ac1-387c-9773-7212ec679c40",
                                                "text": "„Auch haben sie in der nämlichen Frucht zugleich eine Substanz entdeckt, welche die merkwürdige Eigenschaft besitzt, unter Mitwirkung von Sauerstoff und Feuchtigkeit sich in Benzöesäure umzubilden.“ (1830)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bae94ca6-5d4d-451e-86de-6037b81b36ff",
                        "source_entry_id": "bd38c129-da5a-3106-8953-f914d157e09c",
                        "source_sense_id": "fccb7871-3395-34d5-85dc-0ef5724f24aa",
                        "source_sense_description": "to change appearance of",
                        "target_lang_word": "umgestalten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umgestalten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe327ecf-a9df-39af-9cdd-28f74504a71f",
                                        "entry_id": "d2e5aea4-358d-3ddc-a00e-b7f452c8a362",
                                        "glosses": [
                                            "das Erscheinungsbild verändern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9d91027-a9f0-4b42-b78b-a6517ea2531c",
                                                "sense_id": "fe327ecf-a9df-39af-9cdd-28f74504a71f",
                                                "text": "Ich habe meine Wohnungseinrichtung umgestaltet."
                                            },
                                            {
                                                "example_id": "45af9288-b7c4-4849-b8cd-beeb1b649d41",
                                                "sense_id": "fe327ecf-a9df-39af-9cdd-28f74504a71f",
                                                "text": "„Manchmal inspiriert eine undurchsichtige Zusammensetzung einen sprachsensiblen und kreativen Menschen dazu, das Wort zu verändern, umzugestalten, es volksetymologisch zu verballhornen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68d71a22-b1d7-3b6e-833d-2dbef9ed6b9d",
                                        "entry_id": "d2e5aea4-358d-3ddc-a00e-b7f452c8a362",
                                        "glosses": [
                                            "etwas reformieren, neu konzipieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b955e8-709b-45c6-bc5f-7baa95e3fa4c",
                                                "sense_id": "68d71a22-b1d7-3b6e-833d-2dbef9ed6b9d",
                                                "text": "„Um also mehr Zugangsgerechtigkeit und Chancengleichheit, um bessere Leistungen für alle zu erreichen, aber auch aus ökonomischen und demografischen Gründen, müssen wir unser Bildungssystem umfassend umgestalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
