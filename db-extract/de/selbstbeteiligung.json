                "senses": [
                    {
                        "sense_id": "502b1f03-abd2-320d-be1a-f3b6871d1a2f",
                        "entry_id": "c3c20026-40a4-3590-82a5-8f1d2e1c61a4",
                        "glosses": [
                            "finanzieller, vorher in der Höhe bestimmter Beitrag, den der Versicherungsnehmer zu einem versicherten Schadenfall zuzahlen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d25bc6d-e813-4add-b3ed-482e90241c9c",
                                "sense_id": "502b1f03-abd2-320d-be1a-f3b6871d1a2f",
                                "text": "Je höher die Selbstbeteiligung, desto geringer ist in der Regel die Versicherungsprämie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3853c6ee-a0a3-4e15-afe2-d1f97f9ccbf9",
