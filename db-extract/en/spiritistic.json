                "senses": [
                    {
                        "sense_id": "6c4b6689-1674-33ca-a915-4a373b0e9cf2",
                        "entry_id": "f6c7d9ce-2262-38cc-a24d-97a46994712a",
                        "glosses": [
                            "Of or pertaining to, or associated, dealing, concerned, or connected with, spiritism (a.k.a. modern spiritualism); spiritualistic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa8cd9df-9c8e-4236-baf3-c0c2b9213177",
                                "sense_id": "6c4b6689-1674-33ca-a915-4a373b0e9cf2",
                                "text": "That spiritistic ‘literature’ which has led astray…so many weak and impressionable minds."
                            },
                            {
                                "example_id": "a795188e-3504-4722-ac7d-7b3433d94cf9",
                                "sense_id": "6c4b6689-1674-33ca-a915-4a373b0e9cf2",
                                "text": "The only perfectly ascertained fact of spiritistic science is the rap."
                            },
                            {
                                "example_id": "42bc5d0f-ed68-4e37-b868-2ac9ae4805ef",
                                "sense_id": "6c4b6689-1674-33ca-a915-4a373b0e9cf2",
                                "text": "New support for unfounded spiritualistic and spiritistic chimeras."
                            },
                            {
                                "example_id": "3149bf3c-d0c1-4004-bdc8-184ec547ef84",
                                "sense_id": "6c4b6689-1674-33ca-a915-4a373b0e9cf2",
                                "text": "No living person can enter the perception of his fellow save as a body. This holds in the most spiritistic of systems. Even the bodyless dead must have a living body for a medium of their manifestation; nor can any event of heaven or hell make sense except by way of bodily reference."
                            },
                            {
                                "example_id": "90cb7009-04a8-4e57-9af6-d8aaab0f92bb",
                                "sense_id": "6c4b6689-1674-33ca-a915-4a373b0e9cf2",
                                "text": "All conventional philosophies assume the existence of a real world — a reality apart from knowers and their knowing — although not all indulge themselves in speculations concerning ontological matters. I make this claim even of the most spiritistic forms of idealism, in that to speak about the universe at all implies someone speaking and something spoken about — these two constituting the existent reality."
                            }
                        ]
                    }
                ],
