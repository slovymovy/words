                                "target_senses": [
                                    {
                                        "sense_id": "805aefd8-e674-3fa1-bf4b-04e84c4d0847",
                                        "entry_id": "6495f694-958a-304f-81dc-7bdba6262923",
                                        "glosses": [
                                            "die ursprüngliche Farbe ändern, meist weil ein neuer Farbton dazukommt, das Ergebnis wird eher negativ gesehen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b48686e4-88a5-4912-a1ba-37bdaa68afd9",
                                                "sense_id": "805aefd8-e674-3fa1-bf4b-04e84c4d0847",
                                                "text": "Vom Rauchen verfärben die Finger und Zähne."
                                            },
                                            {
                                                "example_id": "46843cb4-ac5e-4f75-99a3-07e0cba197cd",
                                                "sense_id": "805aefd8-e674-3fa1-bf4b-04e84c4d0847",
                                                "text": "Ein vom Tee verfärbter Becher sieht nicht mehr frisch und sauber aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52d2e722-a8ba-3ee5-b105-91d6439f3f3b",
                                        "entry_id": "6495f694-958a-304f-81dc-7bdba6262923",
                                        "glosses": [
                                            "die Farbe verlieren/wechseln/ändern, ohne dass dies ein absichtliches Tun ist"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50080ad3-38a5-4d04-8041-f695d514ef32",
                                                "sense_id": "52d2e722-a8ba-3ee5-b105-91d6439f3f3b",
                                                "text": "„Die Bestürzung des Knaben brachte die Mutter wieder in das recht Geleise. ‚Du verfärbst Dich? Du stockst?‘“ (1852)"
                                            },
                                            {
                                                "example_id": "f2b370aa-8605-4bb0-afee-dad399cacc1c",
                                                "sense_id": "52d2e722-a8ba-3ee5-b105-91d6439f3f3b",
                                                "text": "Im Herbst verfärbte sich das Laub."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b9551224-f5e1-3379-826d-525a14c0f133",
                                        "entry_id": "6495f694-958a-304f-81dc-7bdba6262923",
                                        "glosses": [
                                            "jahreszeitenbedingt das Haarkleid/Fell wechseln"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c6fd221-7b4e-4b31-bef7-16386c5f0f92",
                                                "sense_id": "b9551224-f5e1-3379-826d-525a14c0f133",
                                                "text": "Der jüngere Hirsch verfärbt sich früher als der ältere."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
