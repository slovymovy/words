                                "target_senses": [
                                    {
                                        "sense_id": "3709ef13-0895-3e14-be69-ebd52c3f9cc3",
                                        "entry_id": "7bc62b64-ee5e-3456-9072-b8697188b4e3",
                                        "glosses": [
                                            "een netwerk van stalen stangen dat zorgt voor de treksterkte van een betonnen constructie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc67a31a-2d89-410a-8d75-fe605db5810e",
                                                "sense_id": "3709ef13-0895-3e14-be69-ebd52c3f9cc3",
                                                "text": "Heeft het bedrijf van Erik Smit geconstateerd dat een brug dringend onderhoud nodig heeft, verdwijnt het rapport van Batec Betonrenovatie in een la. ,,Dat een wapening roest, is niet interessant. Totdat het mis gaat, natuurlijk. In het algemeen wordt onderhoud niet zo belangrijk gevonden."
                                            },
                                            {
                                                "example_id": "06c9fe45-89b8-46ce-a242-0b9e30dce05f",
                                                "sense_id": "3709ef13-0895-3e14-be69-ebd52c3f9cc3",
                                                "text": "In de week van 23 juli is gestart met wapening van de fundatiebalken en dan gaan geleidelijk de zwarte emmers weer uit beeld’, legt Leuninge uit."
                                            },
                                            {
                                                "example_id": "0e624147-f539-4b0f-a530-4121c68bfa86",
                                                "sense_id": "3709ef13-0895-3e14-be69-ebd52c3f9cc3",
                                                "text": "De Van Rechteren Limpurgsingel blijft langer afgesloten dan gepland. De slechte staat van de stalen wapening onder de toplaag van de brug brengt onvoorziene werkzaamheden met zich mee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49ce668c-2f08-42a4-8042-10632a44048f",
                        "source_entry_id": "c801d6a2-a688-33cc-82d1-786c20ba9971",
