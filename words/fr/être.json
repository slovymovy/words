                    ]
                },
                {
                    "sense_id": "31a2f2d9-e4c9-35d0-82fc-57cbeece3e68",
                    "sense_definition": "Fait d'exister au sens abstrait ou philosophique ; réalité fondamentale.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence_nom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La métaphysique s'interroge sur la nature profonde de l'<w>être</w> en soi."
                        },
                        {
                            "text": "Ces penseurs distinguent clairement l'<w>être</w> de l'apparence sensible."
                        }
                    ],
                    "synonyms": [
                        "existence"
                    ],
                    "antonyms": [
