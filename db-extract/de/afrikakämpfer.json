                "senses": [
                    {
                        "sense_id": "20ad9888-9fcc-3c8f-9c0b-6a54f969d52f",
                        "entry_id": "a017ed34-5954-394f-b347-4862bde34f6f",
                        "glosses": [
                            "deutscher oder italienischer Soldat, der während des Zweiten Weltkrieges in Afrika gekämpft hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6861adc-37e1-44ee-80ae-41a93cd480fc",
                                "sense_id": "20ad9888-9fcc-3c8f-9c0b-6a54f969d52f",
                                "text": "„Die Afrikakämpfer Deutschlands und Italiens haben trotzdem die ihnen gestellten Aufgaben erfüllt.“"
                            },
                            {
                                "example_id": "5618f0f8-5557-4a2a-91cc-d04ff7fe7e6a",
                                "sense_id": "20ad9888-9fcc-3c8f-9c0b-6a54f969d52f",
                                "text": "„Kein Zeichen von üppiger Lebensweise, gekleidet mit graugrünen Hosen und einer entsprechenden Joppe, verarbeitet aus Uniformteilen des deutschen Heeres und einer Mütze, die lebhaft an die Kopfbedeckung eines Afrikakämpfers erinnert, macht er einen äußerst bescheidenen Eindruck.“"
                            },
                            {
                                "example_id": "fe40ca97-b322-48ac-af51-fdba305296dd",
                                "sense_id": "20ad9888-9fcc-3c8f-9c0b-6a54f969d52f",
                                "text": "„Er war ein langgedienter Mitarbeiter der AO und ehemaliger, mit dem Deutschen Kreuz in Gold ausgezeichneter Afrikakämpfer, der nach dem Krieg in leitender Funktion bei der Commerzbank tätig wurde.“"
                            },
                            {
                                "example_id": "01b99a92-79cc-442a-a7c8-7ff918456662",
                                "sense_id": "20ad9888-9fcc-3c8f-9c0b-6a54f969d52f",
                                "text": "„Zu den Kameradschaftstreffen der Afrikakämpfer unter Rommel kamen auch die letzten Überlebenden der ehemaligen Schutztruppe in Deutsch-Ostafrika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
