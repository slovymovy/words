                "senses": [
                    {
                        "sense_id": "8430b1ca-ac2d-3ad7-86dd-4cacf4fba6ab",
                        "entry_id": "23dd7894-b1f0-365f-93ce-9fe7b83bb64c",
                        "glosses": [
                            "nauczyciel domowy, wychowawca dzieci w zamożnych rodzinach"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2029faaa-0c5a-4ab4-bdfc-cd5cccee720d",
                                "sense_id": "8430b1ca-ac2d-3ad7-86dd-4cacf4fba6ab",
                                "text": "Zaimprowizował im opowieść, a potem uśpił wszystkich łącznie z guwernerem kołysanką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38e4e41b-b977-42a6-b7bc-a61d83a82c39",
                        "source_entry_id": "23dd7894-b1f0-365f-93ce-9fe7b83bb64c",
                        "source_sense_id": "8430b1ca-ac2d-3ad7-86dd-4cacf4fba6ab",
                        "target_lang_word": "governor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "governor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "The chief executive officer of a first-level administrative division of a country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34a36f9-8980-4397-bdda-4f85634bc13a",
                                                "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                                "text": "Younger voters are more libertarian in political philosophy than older voters and are credited with the success of libertarian governor Jesse Ventura of Minnesota."
                                            },
                                            {
                                                "example_id": "fee4a3d3-5c79-4884-bcc1-2d95e698df74",
                                                "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                                "text": "Top aides and people close to Kamala Harris have divided over whether she should head home to run for California governor in 2026 — and it all comes down to whether they believe she could win the Democratic nomination for president in an expected competitive primary in 2028."
                                            },
                                            {
                                                "example_id": "ce4e11aa-5e59-4c64-907a-21a73a11b876",
                                                "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                                "text": "But gender is a factor both candidates will navigate in a country that has elected just 51 female state governors in its history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00fa6075-f930-3214-8d8a-065a9cf4a628",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "A device which regulates or controls some action of a machine through automatic feedback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04affa7e-fe96-4722-adbd-2f0b7fe1b213",
                                                "sense_id": "00fa6075-f930-3214-8d8a-065a9cf4a628",
                                                "text": "Generator excitation is obtained by a combination of the separately-excited and self-excited fields, and the output is controlled by a resistance in the separate field circuit adjusted by the load regulator under the control of the engine governor."
                                            },
                                            {
                                                "example_id": "4b866fff-8cc1-4dd3-a370-6cd0d5bef059",
                                                "sense_id": "00fa6075-f930-3214-8d8a-065a9cf4a628",
                                                "text": "The turning point came in 1923, says Norton, when 42,000 Cincinnati residents signed a petition for a ballot initiative that would require all cars to have a governor limiting them to 25 miles per hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb7bc73-3b66-3eb2-973c-f93c8f79746e",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "A member of a decision-making body (such as a committee) for a larger organization or entity (including some public agencies), similar to or equivalent to a board of directors (used especially for banks); a member of the board of governors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c925c049-cfa5-4885-a5c6-73663ea53d1a",
                                                "sense_id": "0bb7bc73-3b66-3eb2-973c-f93c8f79746e",
                                                "text": "The seven members of the Board of Governors of the Federal Reserve System are nominated by the President and confirmed by the Senate."
                                            },
                                            {
                                                "example_id": "f25ae21c-b9d9-4672-bd91-90ecf9d04e54",
                                                "sense_id": "0bb7bc73-3b66-3eb2-973c-f93c8f79746e",
                                                "text": "Pan Gongsheng, governor of the People’s Bank of China (PBOC) and head of the country’s foreign exchange regulator, chaired a symposium with representatives from foreign companies, including JP Morgan, Tesla (TSLA), HSBC (HSBC), Deutsche Bank (DB), BNP Paribas, Japan’s MUFG Bank, German chemical producer BASF, commodities trader Trafigura and Schneider Electric, according to a statement posted on the websites of the PBOC and the State Administration of Foreign Exchange (SAFE)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "408f6091-1d69-35fa-9c18-a1ab2f422bcb",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "Father."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aea504b5-cbee-4e51-a361-63d4d3187a25",
                                                "sense_id": "408f6091-1d69-35fa-9c18-a1ab2f422bcb",
                                                "text": "\"Say 'father.' We never called him papa; and if one of my brothers had addressed him as 'governor,' as boys do now, I really think he'd have him cut off with a shilling.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c118cc21-83f1-38ce-a28c-434a0cddf7ab",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "Boss; employer; gaffer."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "347259e4-c70a-3721-a1ae-34640bed7df9",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "Term of address to a man; guv'nor."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "307d0ee0-dc00-3b71-b076-b83ba5a78b3a",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "A constituent of a phrase that governs another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbeef936-5396-3ea5-96be-1cde9bfcf3b3",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "One who has the care or guardianship of a young man; a tutor; a guardian."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57748167-f28c-35bd-8219-676c4d2892c8",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "A pilot; a steersman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "439893fc-ed8e-4416-8781-fdfab69631c8",
                        "source_entry_id": "23dd7894-b1f0-365f-93ce-9fe7b83bb64c",
                        "source_sense_id": "8430b1ca-ac2d-3ad7-86dd-4cacf4fba6ab",
                        "target_lang_word": "gouverneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gouverneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "002bf79d-ccc2-32b2-ba81-fe39d9b95f96",
                                        "entry_id": "b2afcc74-def5-3ba7-aead-5aca302159ae",
                                        "glosses": [
                                            "Celui qui est chargé de la direction d’une subdivision administrative de premier niveau, comme une province ou un État, d’une colonie ou d’un grand établissement financier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87aae6a-0544-4a3b-a29d-68816f492e01",
                                                "sense_id": "002bf79d-ccc2-32b2-ba81-fe39d9b95f96",
                                                "text": "La rue de la République, à Nouméa, partait d’une jetée de bois sur la mer et gagnait, après le palais blanc du gouverneur, une autre rue, que des maisons, […], flanquaient à droite."
                                            },
                                            {
                                                "example_id": "a4ea1c3b-7a74-447b-8c0b-c9dba2227a44",
                                                "sense_id": "002bf79d-ccc2-32b2-ba81-fe39d9b95f96",
                                                "text": "Je ne pense jamais au Siam sans évoquer le déjeuner que fit au Palais Royal le gouverneur de l’Indochine d’alors, M. Violette, accompagné de sa très digne épouse."
                                            },
                                            {
                                                "example_id": "bc98afb1-bf04-47e2-9820-17545623f8ac",
                                                "sense_id": "002bf79d-ccc2-32b2-ba81-fe39d9b95f96",
                                                "text": "Le gouverneur éhontément corrompu de Saxe, Martin Mutschmann, avait ignoré les appels des officiels de la ville à la construction d’abris solides, même s’il avait fait construire par les SS des bunkers de béton armé sous son bureau et dans le jardin de son domicile."
                                            },
                                            {
                                                "example_id": "97c8119b-825b-4be0-8752-af2d49bff244",
                                                "sense_id": "002bf79d-ccc2-32b2-ba81-fe39d9b95f96",
                                                "text": "Gouverneur de la Banque de France, du Crédit Foncier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1436cc36-80e5-3711-995d-ecb0501cf956",
                                        "entry_id": "b2afcc74-def5-3ba7-aead-5aca302159ae",
                                        "glosses": [
                                            "Celui qui gouverne une province, une ville, une place forte."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "290503d8-0b6c-4756-bc89-4d21df9382c8",
                                                "sense_id": "1436cc36-80e5-3711-995d-ecb0501cf956",
                                                "text": "Le gouverneur de la forteresse avait fait ses préparatifs de défense. Des monceaux de pavés garnissaient le haut des tours, entourant les canons, pour lesquels on avait élargit les meurtrières."
                                            },
                                            {
                                                "example_id": "22193ee0-6b5a-44ac-bc45-df7f3967be2f",
                                                "sense_id": "1436cc36-80e5-3711-995d-ecb0501cf956",
                                                "text": "La faiblesse du califat permit aux gouverneurs de provinces et autres satrapes d’usurper le pouvoir et de fonder ainsi, à leur gré, des dynasties de courte ou de longue durée."
                                            },
                                            {
                                                "example_id": "ef5079f2-12a4-41f4-b999-080860bb8a9c",
                                                "sense_id": "1436cc36-80e5-3711-995d-ecb0501cf956",
                                                "text": "Le gouverneur militaire de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc819bb2-aa47-3326-b791-82c7794744d5",
                                        "entry_id": "b2afcc74-def5-3ba7-aead-5aca302159ae",
                                        "glosses": [
                                            "Celui qui est commis à l’éducation et à l’instruction d’un jeune prince, d’un jeune homme de grande famille. Dans ce sens, il a pour féminin gouvernante"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bb98e9c-3a68-4bc5-bfde-1316186123b2",
                                                "sense_id": "dc819bb2-aa47-3326-b791-82c7794744d5",
                                                "text": "Gouverneur du Dauphin. Gouverneur des Enfants de France."
                                            },
                                            {
                                                "example_id": "e7db6618-9fdb-4bcf-8069-679b7b8dff16",
                                                "sense_id": "dc819bb2-aa47-3326-b791-82c7794744d5",
                                                "text": "Alcée, son gouverneur, qui était auprès de lui, le soutint comme il allait tomber, et n’eut le temps que de le mener entre les bras de son père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
