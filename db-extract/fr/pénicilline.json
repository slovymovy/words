                                        "sense_id": "5a8c2022-c52c-3e49-8ec7-0eb78da6ae7b",
                                        "entry_id": "954e36e3-c7a8-3235-b984-6b32db313fe4",
                                        "glosses": [
                                            "eines der ältesten Antibiotika, hergestellt auf der Basis eines Schimmelpilzes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d8e886-e2f8-45c9-9d76-4eb128cbadce",
                                                "sense_id": "5a8c2022-c52c-3e49-8ec7-0eb78da6ae7b",
                                                "text": "„Den keimtötenden Wirkstoff nannte er nach dem Pilz Penicillium notatum schlicht Penizillin. “"
                                            },
                                            {
                                                "example_id": "0b1678cc-d993-4356-b94a-dc3ad24a1a4e",
                                                "sense_id": "5a8c2022-c52c-3e49-8ec7-0eb78da6ae7b",
                                                "text": "„In Zeiten der Syphilis hat man andere Ängste als in Zeiten des Penizillins.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
