                        "sense_id": "a5ecd9ba-30b6-3e7a-a9a6-168677b727d5",
                        "entry_id": "59bb674a-38ae-308d-a603-c72cd42c00b2",
                        "glosses": [
                            "iets dat geen mens is maar wel de uiterlijke vorm van een mens heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19cd161c-bb47-40d9-9272-e22bd63223d2",
                                "sense_id": "a5ecd9ba-30b6-3e7a-a9a6-168677b727d5",
                                "text": "Hij noemt terreurverdachte Breivik verder een „monster in mensengedaante” die zijn daad goed zou hebben voorbereid met onder meer een manifest."
                            },
                            {
                                "example_id": "be27743d-e8e8-45b5-b442-77b22a9d9ebb",
                                "sense_id": "a5ecd9ba-30b6-3e7a-a9a6-168677b727d5",
                                "text": "De andere uitleg stelt dat de zonen Gods engelen of geesten zijn die in mensengedaante op aarde verschijnen en huwen met aardse vrouwen."
                            },
                            {
                                "example_id": "01d8b7c1-b3ec-4610-9f7e-134e453c7e85",
                                "sense_id": "a5ecd9ba-30b6-3e7a-a9a6-168677b727d5",
                                "text": "Was Harald ronduit slecht, een duivel in mensengedaante die je zijn eigen ondergang tegemoet moest laten gaan? Een gruwelijke gedachte, maar als je je gedachten de vrije loop liet kon er van alles bovenkomen."
                            }
                        ]
                    }
