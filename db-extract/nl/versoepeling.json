                "senses": [
                    {
                        "sense_id": "c60e5cf0-96ce-3482-b2cf-bc8b7bc10622",
                        "entry_id": "a2ba73d6-c541-3a0f-b21c-c576b4452127",
                        "glosses": [
                            "een keer dat er iets wordt versoepeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93aed6b-7841-4679-a85e-362a9ce3438e",
                                "sense_id": "c60e5cf0-96ce-3482-b2cf-bc8b7bc10622",
                                "text": "De ouders en hun drie kinderen hebben tot op het laatste moment geprobeerd te voorkomen dat zij naar Armenië terug moesten. Hun laatste hoop was het coalitieoverleg in politiek Den Haag maandag over een mogelijke versoepeling van het kinderpardon. Maar dat leidde niet tot een opschorting van de uitzettingen, bleek uit uitspraken van VVD-fractieleider Klaas Dijkhoff rond 13.30 uur."
                            },
                            {
                                "example_id": "7141cf7f-be1c-49aa-a986-9234ea333c36",
                                "sense_id": "c60e5cf0-96ce-3482-b2cf-bc8b7bc10622",
                                "text": "‘Vanwege de versoepeling van de lockdown hoeven de Fransen niet meer gedwongen thuis te zitten."
                            },
                            {
                                "example_id": "97377112-e67b-4957-8ac8-a97342f5abb6",
                                "sense_id": "c60e5cf0-96ce-3482-b2cf-bc8b7bc10622",
                                "text": "De ziekenhuizen van Ziekenhuisgroep Twente (ZGT) in Hengelo en Almelo kunnen zich geen versoepelingen van de coronamaatregelen veroorloven vanwege het hoge aantal besmettingen. Ziekte-uitval is hoog en het aantal patiënten met covid loopt op."
                            }
                        ]
                    }
                ],
