                "senses": [
                    {
                        "sense_id": "b63fa36e-c03d-3f2b-9680-19c8356b0940",
                        "entry_id": "cc6a8434-f19a-3c45-815a-31a3fb8dcda1",
                        "glosses": [
                            "Hinweis, Ratschlag zur Vermeidung von Kontamination, Verunreinigung, Ansteckung"
                        ],
                        "tags": [
                            "selten im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "4bd99b43-9f66-4b63-8d87-df929006f195",
                                "sense_id": "b63fa36e-c03d-3f2b-9680-19c8356b0940",
                                "text": "„Nicht nur in Zeiten von Corona sollte man sie kennen: Hygienetipps. Sie schützen uns und unsere Mitmenschen vor Krankheiten.“"
                            },
                            {
                                "example_id": "e362a165-f6b9-4339-b952-2feaac87f017",
                                "sense_id": "b63fa36e-c03d-3f2b-9680-19c8356b0940",
                                "text": "„Das Bundesamt für Bevölkerungsschutz und Katastrophenhilfe hat zwei hilfreiche Ratgeber veröffentlicht, die jenseits der üblichen Hygienetipps helfen können, mit der ungewohnten Situation umzugehen.“"
                            },
                            {
                                "example_id": "1bb0b223-ec10-4e4f-bc02-58edb981cb98",
                                "sense_id": "b63fa36e-c03d-3f2b-9680-19c8356b0940",
                                "text": "„Einige Hygienetipps sollten jedoch im Umgang mit dem kleinen trichterförmigen Auffangbehälter beachtet werden.“"
                            },
                            {
                                "example_id": "5ee35e3f-b471-44b5-abfe-f87da7efc716",
                                "sense_id": "b63fa36e-c03d-3f2b-9680-19c8356b0940",
                                "text": "„Zu den allgemeinen Hygienetipps von öffentlichen Stellen zählt: Trocknen Sie Ihre Hände nach dem Waschen sorgfältig ab, auch in den Fingerzwischenräumen.“"
                            },
                            {
                                "example_id": "fc42ef79-4ccd-4cbb-89d7-96e1aad5bbc9",
                                "sense_id": "b63fa36e-c03d-3f2b-9680-19c8356b0940",
                                "text": "„Ein wichtiger Hygienetipp: Damit frische Lebensmittel im Kühlschrank lange haltbar sind, darf dieser nicht mit Bakterien oder Schimmelsporen belastet sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
