                        "révéler des faiblesses"
                    ]
                },
                {
                    "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                    "sense_definition": "Manque d'énergie morale, de volonté ou de fermeté face à une tentation ou envers quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par <w>faiblesse</w>, ce père cède à tous les caprices de son fils."
                        },
                        {
                            "text": "Dans un moment de <w>faiblesse</w>, elle a accepté de lui prêter tout son argent."
