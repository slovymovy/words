                ],
                "senses": [
                    {
                        "sense_id": "ebd5f9bf-d13b-37fc-8d58-9692e1653ca7",
                        "entry_id": "2110d35d-5177-3368-a77d-30cbe742bf68",
                        "glosses": [
                            "Tag im Januar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffed11d0-2970-417b-b31e-89029a3d9bb1",
                                "sense_id": "ebd5f9bf-d13b-37fc-8d58-9692e1653ca7",
                                "text": "Milena kam an einem Januartag."
                            },
                            {
                                "example_id": "f6a92a04-ae66-4685-aa35-2dd492080913",
                                "sense_id": "ebd5f9bf-d13b-37fc-8d58-9692e1653ca7",
                                "text": "„In den ersten Januartagen 1912 wurde es dann ungemütlich.“"
                            },
                            {
                                "example_id": "b0141d78-270e-4b7e-a9c7-c5f978372207",
                                "sense_id": "ebd5f9bf-d13b-37fc-8d58-9692e1653ca7",
                                "text": "„Gegen Mittag jedoch fing ein starker Südwind an vom Strome heraufzuwehen, und die Kraft der Sonne, die selbst Januartage in diesem Lande zu so herrlich milden Erscheinungen macht, hatte allmählich die Atmosphäre in eine zitternd-elastische Bewegung versetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
