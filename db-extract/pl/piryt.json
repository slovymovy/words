                    {
                        "sense_id": "16eddfef-98f8-3fa1-aed8-6e8a874ca9b3",
                        "entry_id": "eda0a961-5978-353e-a64e-78077bc8c1d0",
                        "glosses": [
                            "minerał, polimorficzna odmiana siarczku żelaza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9af7802a-47d6-464c-b69a-138b9b5f4e07",
                                "sense_id": "16eddfef-98f8-3fa1-aed8-6e8a874ca9b3",
                                "text": "Piryt tworzy zwykle kryształy sześcienne o mosiężnożółtej barwie i metalicznym połysku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b19b260-e9c6-4944-a3cb-f55ab5f954ca",
                        "source_entry_id": "eda0a961-5978-353e-a64e-78077bc8c1d0",
                        "source_sense_id": "16eddfef-98f8-3fa1-aed8-6e8a874ca9b3",
                        "target_lang_word": "pyrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9c8a08-99e7-3aaf-9019-3f1a8aed4a17",
                                        "entry_id": "9321d760-7860-3880-aff6-2f1fee41aada",
                                        "glosses": [
                                            "The common mineral iron disulfide (FeS₂), of a pale brass-yellow color and brilliant metallic luster, crystallizing in the isometric system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42506f4-06c0-4ad4-b9ba-cef8a56da70c",
                                                "sense_id": "5d9c8a08-99e7-3aaf-9019-3f1a8aed4a17",
                                                "text": "The pyrite output in 1961 was 1.2 million tons, derived mainly from the Hsiang Shan mine in Anhwei and the Ying-te mine in Kwangtung."
                                            },
                                            {
                                                "example_id": "ebbae260-25a1-4c23-8114-d8d232237ffc",
                                                "sense_id": "5d9c8a08-99e7-3aaf-9019-3f1a8aed4a17",
                                                "text": "China's 13 large foreign fertilizer plants ordered a few years ago are all scheduled to be in operation in a year or two.[…]China's biggest pyrite mine (openpit), being built in Yunfu, Kwangtung Province, was near completion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f97eb2-5835-32d4-b2bd-29eb70f94846",
                                        "entry_id": "9321d760-7860-3880-aff6-2f1fee41aada",
                                        "glosses": [
                                            "Any metallic-looking sulphide, such as the above, which is the most common."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c683f4f-af33-3e0d-9b20-107c12330cc3",
                                        "entry_id": "9321d760-7860-3880-aff6-2f1fee41aada",
                                        "glosses": [
                                            "(usually as a plural: pyrites) Any metal dichalcogenide that is isostructural to the common mineral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776f77f0-4f78-4972-95bb-7e0d434704e4",
                                                "sense_id": "7c683f4f-af33-3e0d-9b20-107c12330cc3",
                                                "text": "Copper diselenide can occur both as a marcasite and a pyrite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff255e24-5e46-40ee-9e2f-a10ed3298dc7",
                        "source_entry_id": "eda0a961-5978-353e-a64e-78077bc8c1d0",
                        "source_sense_id": "16eddfef-98f8-3fa1-aed8-6e8a874ca9b3",
