                ],
                "senses": [
                    {
                        "sense_id": "54339e77-6daa-3029-87f2-8b89a988b182",
                        "entry_id": "1ed03888-1abf-32ab-8195-35a3d40715d1",
                        "glosses": [
                            "die Streitkräfte der Republik Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25028314-becf-4e23-b4b5-d4e29956b958",
                                "sense_id": "54339e77-6daa-3029-87f2-8b89a988b182",
                                "text": "Primäre Aufgabe des österreichischen Bundesheeres ist die militärische Landesverteidigung."
                            },
                            {
                                "example_id": "fc0f25f0-72fb-4a59-b259-6f43b233c848",
                                "sense_id": "54339e77-6daa-3029-87f2-8b89a988b182",
                                "text": "„Das Bundesheer als die bewaffnete Macht der Republik Österreich ist nach den Grundsätzen eines Milizsystems einzurichten.“"
                            },
                            {
                                "example_id": "8fbd8f8d-958a-470a-86ff-b3b1d6d6060f",
                                "sense_id": "54339e77-6daa-3029-87f2-8b89a988b182",
                                "text": "„Gleich darauf brachte Rosa Jochmann den ersten Radiobericht: Die Innere Stadt sei vom Bundesheer abgeriegelt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
