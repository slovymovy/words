                                        "examples": [
                                            {
                                                "example_id": "385f2ec7-6387-47af-87fb-7b3e6f8f8758",
                                                "sense_id": "096f3e19-b0ff-3ee8-a1cf-4e1fb84fe950",
                                                "text": "Usuwanie resztek komórkowych to jedno z zadań fagocytów."
                                            },
                                            {
                                                "example_id": "7e18ea84-53cc-4054-86be-040552afe743",
                                                "sense_id": "096f3e19-b0ff-3ee8-a1cf-4e1fb84fe950",
                                                "text": "Proces, w którym fagocyt pochłania i trawi bakterie, nazywany jest fagocytozą i jest kluczowy dla układu odpornościowego."
                                            },
                                            {
