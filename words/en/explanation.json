                {
                    "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                    "sense_definition": "The act or process of explaining.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher gave a brief <w>explanation</w> of the new rules.",
