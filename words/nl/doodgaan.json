                },
                {
                    "sense_id": "7e119db9-8fa9-391c-a3a6-8e8e161eed0e",
                    "sense_definition": "geen succes hebben bij een publiek en geen lachsalvo's uitlokken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "falen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De cabaretier zag de zaal stilvallen en wist dat hij op het podium aan het <w>doodgaan</w> was.",
                            "target_lang_translations": {
                                "en": "The comedian saw the room go quiet and knew he was <w>dying</w> on stage."
                            }
                        },
                        {
                            "text": "Het is pijnlijk om een komiek op het toneel te zien <w>doodgaan</w> voor een zwijgend publiek.",
                            "target_lang_translations": {
                                "en": "It is painful to see a comedian <w>die</w> on stage in front of a silent audience."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op het podium doodgaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gebruikt in de context van podiumkunsten en comedy"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To fail to evoke laughter or success from an audience, especially in comedy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "die",
                                "target_lang_sense_clarification": "to fail to get a laugh from an audience"
                            },
                            {
                                "target_lang_word": "bomb",
                                "target_lang_sense_clarification": "to fail miserably on stage"
                            },
                            {
                                "target_lang_word": "flop",
                                "target_lang_sense_clarification": "to be completely unsuccessful"
                            }
                        ]
