                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panikattacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40611c6b-e159-323e-afb4-2b4fe51f0f4e",
                                        "entry_id": "2ff00e81-4dfb-3d65-8a78-124b8dc2a7ec",
                                        "glosses": [
                                            "plötzliches Auftreten extremer Angst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e11078-b0f6-43ca-8a2f-02572e07379b",
                                                "sense_id": "40611c6b-e159-323e-afb4-2b4fe51f0f4e",
                                                "text": "„Müller litt unter Existenzängsten, Panikattacken und Schmerzen.“"
                                            },
                                            {
                                                "example_id": "2542048a-9775-4cca-899f-a1ddbf5e4b6b",
                                                "sense_id": "40611c6b-e159-323e-afb4-2b4fe51f0f4e",
                                                "text": "„So wie ich es mir seit Tagen ausgemalt hatte, blieb die Panikattacke aus und ich wusste: Hier werde ich schlafen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
