                "senses": [
                    {
                        "sense_id": "f2c7f00f-c9ed-3006-a856-12b4eb2a7807",
                        "entry_id": "81a0ab52-306b-3ef0-a2fd-622cbf4f7c72",
                        "glosses": [
                            "Material, das ein Zahnarzt bei einer Behandlung in ein Loch in einen Zahn füllt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3e8ffc-3418-4f2e-b905-1feb696bea9a",
                                "sense_id": "f2c7f00f-c9ed-3006-a856-12b4eb2a7807",
                                "text": "„Nebenbei bemerkt ist der im Kiefer gegenüberliegende Weisheitszahn schon seit Jahrzehnten mit einer Zahnfüllung versehen ohne je zu Sorgen Anlass zu geben.“"
                            },
                            {
                                "example_id": "bccf6267-f299-4156-83a4-2e5df089fd43",
                                "sense_id": "f2c7f00f-c9ed-3006-a856-12b4eb2a7807",
                                "text": "„Slowenien Bienenwachs wird als Zahnfüllung eingesetzt, um Schmerzen zu lindern und die Zerstörung des Zahns einzudämmen.“"
                            },
                            {
                                "example_id": "ef4557ed-f775-411e-8945-8a442dfe4be1",
                                "sense_id": "f2c7f00f-c9ed-3006-a856-12b4eb2a7807",
                                "text": "„Geringe Mengen Quecksilber können freigesetzt werden, wenn so eine Zahnfüllung nicht mehr ganz dicht schließt, was man tatsächlich schmecken kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
