                "senses": [
                    {
                        "sense_id": "74cf81d0-3c05-354d-ace4-dc220e30383a",
                        "entry_id": "7cbdc183-75ac-3cf2-8e09-d42a7acfac2c",
                        "glosses": [
                            "großer Raum in Burgen und Schlössern, selten auch anderen Gebäuden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92dd9202-23ba-4a1e-b2c9-108a34f5d6b1",
                                "sense_id": "74cf81d0-3c05-354d-ace4-dc220e30383a",
                                "text": "Das Adventskonzert des Orchesters fand im Rittersaal der Burg statt."
                            },
                            {
                                "example_id": "874c305c-1511-4b72-8203-7ffb36565b80",
                                "sense_id": "74cf81d0-3c05-354d-ace4-dc220e30383a",
                                "text": "„Über der Tür des Rittersaales prangt eine Schweigerose, die jeden, der diesen Saal betrat, daran erinnern sollte, dass alles, was in diesem Saal gesprochen wurde, geheim bleiben müsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b5689bb-fa62-4764-ae82-4816b01a56df",
                        "source_entry_id": "7cbdc183-75ac-3cf2-8e09-d42a7acfac2c",
                        "source_sense_id": "74cf81d0-3c05-354d-ace4-dc220e30383a",
                        "source_sense_description": "großer Raum in Burgen und Schlössern, selten auch anderen Gebäuden",
                        "target_lang_word": "great hall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "great hall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61b87cc1-c0e4-355d-8191-934b94dc10c0",
                                        "entry_id": "6d770116-f017-3343-93cb-2e20b5f18d56",
                                        "glosses": [
                                            "The main room of a palace, castle or large manor house in the Middle Ages, or in a country house of the 16th and early 17th centuries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81aba00-2cfc-43d0-9ff7-b1951d6b0e05",
                                                "sense_id": "61b87cc1-c0e4-355d-8191-934b94dc10c0",
                                                "text": "Even in castles and manor houses space was limited, and rooms including the great hall were used for other functions beyond dining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffb70eec-4507-35af-8dc0-7e9493cc6dbd",
                                        "entry_id": "6d770116-f017-3343-93cb-2e20b5f18d56",
                                        "glosses": [
                                            "The principal building of a manor or castle compound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c35d81-dbea-4df3-8890-7ca3850749c2",
                                                "sense_id": "ffb70eec-4507-35af-8dc0-7e9493cc6dbd",
                                                "text": "\"Now this\" — he indicated the great building facing them, with a handsome flight of steps up to the open door — \"this is the great hall.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
