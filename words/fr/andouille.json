            "senses": [
                {
                    "sense_id": "6778facb-2008-3b25-a985-484cd0a140da",
                    "sense_definition": "Personne sotte, maladroite ou naïve.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de faire l'<w>andouille</w> et concentre-toi enfin sur ton travail.",
                            "target_lang_translations": {
                                "en": "Stop acting the <w>fool</w> and finally focus on your work.",
                                "ru": "Хватит <w>дурачиться</w> и наконец сосредоточься на работе.",
                                "de": "Hör auf, den <w>Dummkopf</w> zu spielen, und konzentriere dich endlich auf deine Arbeit.",
                                "es": "Deja de hacer el <w>tonto</w> y concéntrate de una vez en tu trabajo.",
                                "zh": "别再当<w>傻瓜</w>了，赶紧专心做你的工作吧。"
                            }
                        },
                        {
                            "text": "J'ai oublié mes clés à l'intérieur de la maison comme une vraie <w>andouille</w>.",
                            "target_lang_translations": {
                                "en": "I forgot my keys inside the house, like a real <w>idiot</w>.",
                                "ru": "Я забыл ключи внутри дома, как последний <w>дурак</w>.",
                                "de": "Ich habe meine Schlüssel im Haus vergessen, wie ein richtiger <w>Trottel</w>.",
                                "es": "Me dejé las llaves dentro de casa, como un verdadero <w>tonto</w>.",
                                "zh": "我把钥匙落在屋里了，真是个十足的<w>笨蛋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imbécile",
                        "idiot",
                        "nigaud"
                    ],
                    "common_phrases": [
                        "faire l'andouille"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A foolish, clumsy or naive person.",
                        "ru": "Глупый, неловкий или наивный человек.",
                        "de": "Dummer, ungeschickter oder naiver Mensch.",
                        "es": "Persona tonta, torpe o ingenua.",
                        "zh": "指愚蠢、笨拙或天真的人。"
                    },
