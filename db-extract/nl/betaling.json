                                        "glosses": [
                                            "meist Singular:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fea5fb35-c1f8-339b-b1e6-ad6e7e929053",
                                        "entry_id": "3f257459-9793-34be-9c6a-1ebf6715301a",
                                        "glosses": [
                                            "Dinge von Wert (meist Geld), die man für eine Leistung bekommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1708da46-259b-4161-a86c-dbbcc0b7e54a",
                                                "sense_id": "fea5fb35-c1f8-339b-b1e6-ad6e7e929053",
                                                "text": "Gute Bezahlung ist einer meiner Ansprüche, die ich an den Job stelle."
                                            },
                                            {
                                                "example_id": "5e62b60a-0200-46c8-84b2-04884896dab1",
                                                "sense_id": "fea5fb35-c1f8-339b-b1e6-ad6e7e929053",
                                                "text": "„Zafi erzählt uns, dass er gegen Bezahlung auf Hochzeiten und Beerdigungen fiedele und singe.“"
                                            },
                                            {
                                                "example_id": "72400ac6-3e5a-485a-9c07-cbd7850191c6",
                                                "sense_id": "fea5fb35-c1f8-339b-b1e6-ad6e7e929053",
                                                "text": "„Die Bezahlung war lausig, aber mit (heimlich) Taxifahren kam ich über die Runden.“"
                                            },
                                            {
                                                "example_id": "3df9a444-aadc-4c2f-97de-f105127732e9",
                                                "sense_id": "fea5fb35-c1f8-339b-b1e6-ad6e7e929053",
                                                "text": "Die Gründe [für das Fehlen von Erzeiherinnen/Erziehern in Kindergärten] sind schlechte Bezahlung, mangelnde Anerkennung und Dauerstress."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b29a09fa-c987-3f52-9789-99b1915b4535",
                                        "entry_id": "3f257459-9793-34be-9c6a-1ebf6715301a",
                                        "glosses": [
                                            "die Handlung, etwas zu bezahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e17c42-f1cc-46af-a095-5c503ecde58d",
                                                "sense_id": "b29a09fa-c987-3f52-9789-99b1915b4535",
                                                "text": "Nach der Bezahlung gehört die Uhr Ihnen."
                                            },
                                            {
                                                "example_id": "63a18fde-cf86-4d04-9286-dafd9349b672",
                                                "sense_id": "b29a09fa-c987-3f52-9789-99b1915b4535",
                                                "text": "„Menschen in anderen Landesteilen, sogar in anderen Erdteilen schneiden sich gegen Bezahlung je ihr Stück ab, um sich darein zu kleiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13d46381-8e4b-4d8f-8c98-1ba84cd8c82f",
                        "source_entry_id": "3ccb6247-fa31-3c56-ae1c-98d59b5df1a5",
