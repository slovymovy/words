                                "target_senses": [
                                    {
                                        "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                        "entry_id": "62e66e0e-00c3-31b0-9d21-81f3c3aaf8fc",
                                        "glosses": [
