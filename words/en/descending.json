    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b94a7c67-3365-3ea6-bdb3-01eda537171f",
                    "sense_definition": "present participle and gerund of <w>descend</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airplane is slowly <w>descending</w> through the clouds toward the runway.",
                            "target_lang_translations": {
                                "ru": "Самолет медленно <w>снижается</w> сквозь облака к взлетно-посадочной полосе."
                            }
                        },
                        {
                            "text": "He injured his knee while <w>descending</w> the steep mountain trail.",
                            "target_lang_translations": {
                                "ru": "Он повредил колено, когда <w>спускался</w> по крутой горной тропе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "descending the stairs",
                        "descending from the sky"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола descend (спускаться, снижаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускающийся",
                                "target_lang_sense_clarification": "причастие от «спускаться»"
                            },
                            {
                                "target_lang_word": "снижающийся",
                                "target_lang_sense_clarification": "о высоте, полете"
                            },
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "герундий, процесс движения вниз"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "69d14630-c317-33cc-b1f1-8bae3ab4d375",
                    "sense_definition": "Arranged from highest to lowest or greatest to least in value, size, or importance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please sort the test scores in <w>descending</w> order.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отсортируйте результаты тестов в <w>убывающем</w> порядке."
                            }
                        },
                        {
                            "text": "The files are listed in <w>descending</w> order by date of creation.",
                            "target_lang_translations": {
                                "ru": "Файлы перечислены по дате создания в <w>нисходящем</w> порядке."
                            }
                        }
                    ],
                    "synonyms": [
                        "decreasing"
                    ],
                    "antonyms": [
                        "ascending"
                    ],
                    "common_phrases": [
                        "in descending order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный в порядке от большего к меньшему, от высшего к низшему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убывающий",
                                "target_lang_sense_clarification": "о порядке сортировки"
                            },
                            {
                                "target_lang_word": "нисходящий",
                                "target_lang_sense_clarification": "о порядке следования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76d2d908-3a36-3093-ab4c-a0368895975b",
                    "sense_definition": "Moving, leading, or sloping downwards.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "downward_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked down a <w>descending</w> path that led directly to the river.",
                            "target_lang_translations": {
                                "ru": "Они пошли по <w>спускающейся</w> тропинке, которая вела прямо к реке."
                            }
                        },
                        {
                            "text": "Be careful when walking on the steeply <w>descending</w> slope.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны при ходьбе по круто <w>уходящему вниз</w> склону."
                            }
                        }
                    ],
                    "synonyms": [
                        "downward",
                        "sloping"
                    ],
                    "antonyms": [
                        "ascending"
                    ],
                    "common_phrases": [
                        "descending path",
                        "descending slope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся, ведущий или идущий под уклон вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нисходящий",
                                "target_lang_sense_clarification": "направленный вниз"
                            },
                            {
                                "target_lang_word": "спускающийся",
                                "target_lang_sense_clarification": "о тропе, дороге"
                            },
                            {
                                "target_lang_word": "пологий",
                                "target_lang_sense_clarification": "идущий под уклон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef622db6-89bb-3b24-978f-9884e8363a3b",
                    "sense_definition": "Causing an arranged series to go from the highest to the lowest value.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We applied a <w>descending</w> sort to display the most recent transactions first.",
                            "target_lang_translations": {
                                "ru": "Мы применили сортировку <w>по убыванию</w>, чтобы первыми отображались самые последние транзакции."
                            }
                        },
                        {
                            "text": "Clicking the column header toggles between an ascending and a <w>descending</w> sort.",
                            "target_lang_translations": {
                                "ru": "Нажатие на заголовок столбца переключает сортировку по возрастанию и <w>по убыванию</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "ascending"
                    ],
                    "common_phrases": [
                        "descending sort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводящий последовательность к порядку от наибольшего значения к наименьшему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по убыванию",
                                "target_lang_sense_clarification": "о сортировке"
                            },
                            {
                                "target_lang_word": "нисходящий",
                                "target_lang_sense_clarification": "о сортировке, порядке данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0ef93d4-42fd-3cd4-a791-6076f63b9b11",
                    "sense_definition": "Moving gradually to a lower musical pitch.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "downward_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer practiced a <w>descending</w> scale during the warm-up session.",
                            "target_lang_translations": {
                                "ru": "Певица тренировала <w>нисходящую</w> гамму во время распевки."
                            }
                        },
                        {
                            "text": "The melody ends with a beautiful <w>descending</w> sequence of notes.",
                            "target_lang_translations": {
                                "ru": "Мелодия заканчивается красивой <w>нисходящей</w> последовательностью нот."
                            }
                        }
                    ],
                    "antonyms": [
                        "ascending"
                    ],
                    "common_phrases": [
                        "descending scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся от более высоких музыкальных тонов к более низким."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нисходящий",
                                "target_lang_sense_clarification": "о гамме, звукоряде, мелодии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4096c939-853a-350a-a677-54ac04575bea",
                    "sense_definition": "An act or instance of moving downwards; a descent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain path was marked by continual ascendings and <w>descendings</w>.",
                            "target_lang_translations": {
                                "ru": "Горная тропа отличалась постоянными подъемами и <w>спусками</w>."
                            }
                        },
                        {
                            "text": "His rapid <w>descending</w> surprised the hikers who were resting below.",
                            "target_lang_translations": {
                                "ru": "Его быстрый <w>спуск</w> удивил туристов, отдыхавших внизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "descent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или случай движения вниз; спуск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "движение вниз"
                            },
                            {
                                "target_lang_word": "снижение",
                                "target_lang_sense_clarification": "уменьшение высоты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}