{
    "word_family": [
        "contrarily",
        "contrariness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1cce07c8-41e3-3562-b131-0bda49aa3fb5",
                    "sense_definition": "Completely different; opposed to or inconsistent with something else.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The result was completely <w>contrary</w> to our initial expectations.",
                            "target_lang_translations": {
                                "ru": "Результат оказался прямо <w>противоположным</w> нашим первоначальным ожиданиям.",
                                "nl": "Het resultaat was volledig <w>tegengesteld</w> aan onze aanvankelijke verwachtingen.",
                                "zh": "结果与我们最初的预期完全<w>相反</w>。"
                            }
                        },
                        {
                            "text": "Acting <w>contrary</w> to the rules will result in immediate disqualification.",
                            "target_lang_translations": {
                                "ru": "Действия, <w>противоречащие</w> правилам, повлекут за собой немедленную дисквалификацию.",
                                "nl": "Handelen <w>in strijd met</w> de regels zal leiden tot onmiddellijke disqualificatie.",
                                "zh": "<w>违反</w>规则将被立即取消资格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contradictory",
                        "opposed",
                        "opposing",
                        "counter"
                    ],
                    "antonyms": [
                        "unopposed"
                    ],
                    "common_phrases": [
                        "contrary to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью отличающийся; противоположный или несовместимый с чем-либо другим.",
                        "nl": "Volledig anders; tegengesteld aan of strijdig met iets anders.",
                        "zh": "完全不同的；与另一事物相对立或不一致的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "находящийся напротив или полностью отличающийся"
                            },
                            {
                                "target_lang_word": "противоречащий",
                                "target_lang_sense_clarification": "несовместимый с чем-либо"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tegengesteld",
                                "target_lang_sense_clarification": "volledig anders"
                            },
                            {
                                "target_lang_word": "tegenovergesteld",
                                "target_lang_sense_clarification": "precies andersom"
                            },
                            {
                                "target_lang_word": "strijdig",
                                "target_lang_sense_clarification": "niet in overeenstemming met"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相反的",
                                "target_lang_sense_clarification": "与某事完全不同、对立"
                            },
                            {
                                "target_lang_word": "违反的",
                                "target_lang_sense_clarification": "不一致，不符合"
                            },
                            {
                                "target_lang_word": "与……相悖的",
                                "target_lang_sense_clarification": "与规则、事实等相冲突"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "525fa2af-0153-3893-a3d5-64baf4202da3",
                    "sense_definition": "Moving or facing in an opposite or adverse direction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship struggled to make progress against the <w>contrary</w> winds.",
                            "target_lang_translations": {
                                "ru": "Корабль с трудом продвигался вперед против <w>встречного</w> ветра.",
                                "nl": "Het schip had moeite om vooruit te komen tegen de <w>tegenwind</w>.",
                                "zh": "那艘船顶着<w>逆</w>风艰难前行。"
                            }
                        },
                        {
                            "text": "They decided to walk in a <w>contrary</w> direction to the main crowd.",
                            "target_lang_translations": {
                                "ru": "Они решили пойти в <w>противоположном</w> направлении от основной толпы.",
                                "nl": "Ze besloten in een <w>tegengestelde</w> richting van de grote menigte te lopen.",
                                "zh": "他们决定朝着与大部队<w>相反</w>的方向走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opposing",
                        "counter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся или направленный в противоположную или неблагоприятную сторону.",
                        "nl": "Bewegend of gericht in een tegenovergestelde of ongunstige richting.",
                        "zh": "朝着相反方向移动、吹来，或面向不利方向的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встречный",
                                "target_lang_sense_clarification": "о ветре или течении"
                            },
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "о направлении движения"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tegen-",
                                "target_lang_sense_clarification": "bijvoorbeeld tegenwind"
                            },
                            {
                                "target_lang_word": "tegengesteld",
                                "target_lang_sense_clarification": "in de andere richting"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逆的",
                                "target_lang_sense_clarification": "指风、潮流等朝着相反方向"
                            },
                            {
                                "target_lang_word": "相反的",
                                "target_lang_sense_clarification": "指方向与另一方向相反"
                            },
                            {
                                "target_lang_word": "不利的",
                                "target_lang_sense_clarification": "指情况不利、阻碍前进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b99c5b2e-5220-338e-9ed6-69da1a4ea16d",
                    "sense_definition": "Stubbornly unwilling to obey, behave, or agree; perverse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>contrary</w> child refused to eat his dinner despite his hunger.",
                            "target_lang_translations": {
                                "ru": "<w>Упрямый</w> ребенок отказывался ужинать, несмотря на голод.",
                                "nl": "Het <w>dwarse</w> kind weigerde zijn avondeten op te eten ondanks zijn honger.",
                                "zh": "那个<w>倔强的</w>孩子明明饿了，却还是不肯吃晚饭。"
                            }
                        },
                        {
                            "text": "She is in a <w>contrary</w> mood and disagrees with everything I say.",
                            "target_lang_translations": {
                                "ru": "Она в <w>своенравном</w> настроении и не соглашается ни с чем, что я говорю.",
                                "nl": "Ze is in een <w>tegendraadse</w> bui en is het oneens met alles wat ik zeg.",
                                "zh": "她现在闹别扭，表现得很<w>别扭</w>，我说什么她都不同意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disagreeable",
                        "refractory",
                        "cross"
                    ],
                    "antonyms": [
                        "cooperative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упрямо не желающий подчиняться или соглашаться; своенравный.",
                        "nl": "Koppig onwillig om te gehoorzamen, zich te gedragen of in te stemmen; dwars.",
                        "zh": "固执地不愿服从、表现得得体或同意别人；性情乖张的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрямый",
                                "target_lang_sense_clarification": "не желающий уступать"
                            },
                            {
                                "target_lang_word": "своенравный",
                                "target_lang_sense_clarification": "капризный, делающий по-своему"
                            },
                            {
                                "target_lang_word": "несговорчивый",
                                "target_lang_sense_clarification": "трудный в общении"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dwars",
                                "target_lang_sense_clarification": "tegendraads en koppig"
                            },
                            {
                                "target_lang_word": "tegendraads",
                                "target_lang_sense_clarification": "altijd het tegenovergestelde doend"
                            },
                            {
                                "target_lang_word": "eigenwijs",
                                "target_lang_sense_clarification": "koppig, niet willen luisteren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倔强的",
                                "target_lang_sense_clarification": "固执，不肯听从"
                            },
                            {
                                "target_lang_word": "别扭的",
                                "target_lang_sense_clarification": "故意唱反调、不顺从"
                            },
                            {
                                "target_lang_word": "执拗的",
                                "target_lang_sense_clarification": "性格执拗，喜欢反着来"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02a4ade8-c23c-3c21-927e-13df3fa393d5",
                    "sense_definition": "The exact opposite of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not hate the plan; on the <w>contrary</w>, I think it is brilliant.",
                            "target_lang_translations": {
                                "ru": "Я не ненавижу этот план; <w>наоборот</w>, я считаю его гениальным.",
                                "nl": "Ik haat het plan niet; in het <w>tegendeel</w>, ik vind het briljant.",
                                "zh": "我并不讨厌这个计划；恰恰<w>相反</w>，我觉得它很精彩。"
                            }
                        },
                        {
                            "text": "Unless there is evidence to the <w>contrary</w>, we will assume he is innocent.",
                            "target_lang_translations": {
                                "ru": "Пока нет доказательств <w>обратного</w>, мы будем считать его невиновным.",
                                "nl": "Tenzij er bewijs van het <w>tegendeel</w> is, gaan we ervan uit dat hij onschuldig is.",
                                "zh": "除非有证明<w>相反情况</w>的证据，否则我们会假定他是无辜的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the contrary",
                        "to the contrary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точная противоположность чему-либо.",
                        "nl": "Het precieze tegendeel van iets.",
                        "zh": "某事物的完全相反面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположность",
                                "target_lang_sense_clarification": "нечто совершенно иное"
                            },
                            {
                                "target_lang_word": "обратное",
                                "target_lang_sense_clarification": "противоположное утверждение или факт"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tegendeel",
                                "target_lang_sense_clarification": "het precieze tegenovergestelde"
                            },
                            {
                                "target_lang_word": "tegenovergestelde",
                                "target_lang_sense_clarification": "dat wat precies andersom is"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相反",
                                "target_lang_sense_clarification": "某事物的完全反面"
                            },
                            {
                                "target_lang_word": "相反情况",
                                "target_lang_sense_clarification": "与前述情况完全不同的事物或事实"
                            },
                            {
                                "target_lang_word": "反面",
                                "target_lang_sense_clarification": "强调与原说法正好相反"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9e36548-977f-3143-9b7b-fa9aafc17c2f",
                    "sense_definition": "One of a pair of propositions that cannot both be true at the same time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In logic, two statements are <w>contraries</w> if they cannot both be true.",
                            "target_lang_translations": {
                                "ru": "В логике два утверждения являются <w>противоположностями</w>, если они не могут быть истинными одновременно.",
                                "nl": "In de logica zijn twee beweringen <w>tegengesteld</w> als ze niet beide waar kunnen zijn.",
                                "zh": "在逻辑学中，如果两个命题不能同时为真，它们就是一对<w>反对命题</w>。"
                            }
                        },
                        {
                            "text": "The professor explained how <w>contraries</w> differ from contradictories in the lecture.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил на лекции, чем <w>противоположные суждения</w> отличаются от противоречащих.",
                                "nl": "De hoogleraar legde tijdens het hoorcollege uit hoe <w>tegengestelde beweringen</w> verschillen van tegenstrijdige.",
                                "zh": "教授在课上讲解了<w>反对命题</w>和矛盾命题有什么区别。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно из двух суждений, которые не могут быть истинными одновременно.",
                        "nl": "Eén van een paar beweringen die niet beide tegelijk waar kunnen zijn.",
                        "zh": "逻辑学中，一对不能同时为真的命题之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположность",
                                "target_lang_sense_clarification": "логический термин"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tegenstrijdigheid",
                                "target_lang_sense_clarification": "logische term"
                            },
                            {
                                "target_lang_word": "tegengestelde",
                                "target_lang_sense_clarification": "logische propositie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反对命题",
                                "target_lang_sense_clarification": "逻辑学中不能同真的一对命题之一"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "00179265-4e04-349a-be86-7c97b5c36fbe",
                    "sense_definition": "In an opposite or conflicting manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to act <w>contrary</w> to the instructions given by his boss.",
                            "target_lang_translations": {
                                "ru": "Он решил действовать <w>вопреки</w> инструкциям, данным его начальником.",
                                "nl": "Hij besloot te handelen <w>in strijd met</w> de instructies van zijn baas.",
                                "zh": "他决定<w>违背</w>老板给他的指示行事。"
                            }
                        },
                        {
                            "text": "Everything happened <w>contrary</w> to our carefully laid plans.",
                            "target_lang_translations": {
                                "ru": "Все произошло <w>вопреки</w> нашим тщательно продуманным планам.",
                                "nl": "Alles gebeurde <w>in strijd met</w> onze zorgvuldig gemaakte plannen.",
                                "zh": "一切的发展都<w>违背</w>了我们精心制定的计划。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "act contrary to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противоположным или противоречивым образом.",
                        "nl": "Op een tegenovergestelde of strijdige manier.",
                        "zh": "以相反或相冲突的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопреки",
                                "target_lang_sense_clarification": "наперекор чему-либо"
                            },
                            {
                                "target_lang_word": "против",
                                "target_lang_sense_clarification": "в разрез с чем-либо"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "in strijd met",
                                "target_lang_sense_clarification": "haaks op"
                            },
                            {
                                "target_lang_word": "tegen",
                                "target_lang_sense_clarification": "in tegenspraak met"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "违背",
                                "target_lang_sense_clarification": "与指示、计划等相冲突地"
                            },
                            {
                                "target_lang_word": "相反地",
                                "target_lang_sense_clarification": "采取相反或不一致的方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d548b12-7396-3517-b489-b8116dfce41f",
                    "sense_definition": "To oppose, contradict, or act against someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight did not dare to <w>contrary</w> the king's direct orders.",
                            "target_lang_translations": {
                                "ru": "Рыцарь не смел <w>перечить</w> прямым приказам короля.",
                                "nl": "De ridder durfde de directe bevelen van de koning niet te <w>tegenspreken</w>.",
                                "zh": "那名骑士不敢<w>违抗</w>国王的直接命令。"
                            }
                        },
                        {
                            "text": "She would never <w>contrary</w> her parents in public.",
                            "target_lang_translations": {
                                "ru": "Она бы никогда не стала <w>возражать</w> своим родителям на людях.",
                                "nl": "Zij zou haar ouders in het openbaar nooit <w>tegenspreken</w>.",
                                "zh": "她绝不会在公开场合<w>顶撞</w>父母。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Противостоять, противоречить или действовать против кого-либо.",
                        "nl": "Iemand of iets tegenwerken, tegenspreken of tegenin gaan.",
                        "zh": "反对、驳斥，或与某人、某事对着干。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перечить",
                                "target_lang_sense_clarification": "возражать, обычно старшим или главным"
                            },
                            {
                                "target_lang_word": "возражать",
                                "target_lang_sense_clarification": "высказывать несогласие"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tegenspreken",
                                "target_lang_sense_clarification": "dwarsbomen of tegenin gaan"
                            },
                            {
                                "target_lang_word": "dwarsbomen",
                                "target_lang_sense_clarification": "tegenwerken"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "违抗",
                                "target_lang_sense_clarification": "不服从命令、权威或要求"
                            },
                            {
                                "target_lang_word": "顶撞",
                                "target_lang_sense_clarification": "公开反驳、顶嘴"
                            },
                            {
                                "target_lang_word": "反驳",
                                "target_lang_sense_clarification": "表示反对或不赞同"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}