                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a40633a-d7bc-390c-ad6a-df84f9b7a87f",
                                        "entry_id": "3b8f0368-f1e3-3c9b-9e48-4c800b0473bc",
                                        "glosses": [
                                            "relating to concessions or franchises"
                                        ],
