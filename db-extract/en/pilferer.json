                    {
                        "translation_id": "c213c84b-da77-4321-886d-c7cce0941152",
                        "source_entry_id": "fbe5887e-2bf3-33eb-b10f-0517dfe3eb97",
                        "source_sense_id": "9f04cd85-868c-3172-bc53-1ff48727785e",
                        "source_sense_description": "one who pilfers",
                        "target_lang_word": "Langfinger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langfinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                        "entry_id": "6c4db122-a1e6-3ff8-b5c4-96b63e062614",
                                        "glosses": [
                                            "jemand, der lange Finger macht, das heißt: sich unrechtmäßig Dinge verschafft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c02ed4ba-38c4-4b43-9e58-5acdde4328c2",
                                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                                "text": "Zum dritten Mal in diesem Monat verschafften sich dreiste Langfinger Zutritt zum Warenlager des Ersatzteilhändlers."
                                            },
                                            {
                                                "example_id": "ac4dc001-adac-4d7a-9c49-4a44ec682e3c",
                                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                                "text": "„[… es] gibt Möglichkeiten die Langfinger abzuschrecken.“"
                                            },
                                            {
                                                "example_id": "a63e6ec4-8f6e-493f-b59a-77c4f7e783d7",
                                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                                "text": "„Die Hausherrin des achtzehnten Jahrhunderts trug ständig einen riesigen Schlüsselbund um die Taille, die mehr dem Schutz vor Langfingern im eigenen Haus als dem vor Einbrechern diente.“"
                                            },
                                            {
                                                "example_id": "0213fea5-3691-4efe-bf99-466bda5b0007",
                                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                                "text": "„Die neugegründete Soko „Castle“ hat sich zudem auf Einbrecher spezialisiert. Und dabei Erstaunliches über die Vorlieben einiger Langfinger herausgefunden.“"
                                            },
                                            {
                                                "example_id": "2033a867-2c2a-455d-b59d-05ba9ad7159c",
                                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                                "text": "„Gerade in der dunklen Jahreszeit versuchen Diebe unbemerkt in die Häuser einzudringen. Einfache Fenster und Türen sind keine großen Hindernisse für die Langfinger.“"
                                            },
                                            {
                                                "example_id": "864be959-0460-47bc-aa92-7e7483fcaa11",
                                                "sense_id": "4e585db9-305e-3897-a87d-2a11e57c40c3",
                                                "text": "„[Smartphones gehören zu den] begehrten Objekten für Langfinger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38e5f876-042d-4e16-ab9d-08cf5fa143e2",
                        "source_entry_id": "fbe5887e-2bf3-33eb-b10f-0517dfe3eb97",
                        "source_sense_id": "9f04cd85-868c-3172-bc53-1ff48727785e",
                        "source_sense_description": "one who pilfers",
                        "target_lang_word": "Dieb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dieb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a17252b-8bd1-3784-a17e-3370e180c290",
                                        "entry_id": "51ce93a4-8233-3bd9-b160-dfca52667d46",
                                        "glosses": [
                                            "jemand, der stiehlt, der eines anderen Eigentum wegnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b05b9bc5-246f-4fa1-9cdc-016c6a8b5373",
                                                "sense_id": "2a17252b-8bd1-3784-a17e-3370e180c290",
                                                "text": "Die Diebe stiegen über den Gartenzaun und dann durch das offene Fenster in das Haus ein."
                                            },
                                            {
                                                "example_id": "e999153b-92ce-4a66-96ef-48e0d8428731",
                                                "sense_id": "2a17252b-8bd1-3784-a17e-3370e180c290",
                                                "text": "Hier waren Diebe am Werk und haben alles mitgenommen und weggeschleppt."
                                            },
                                            {
                                                "example_id": "e1af9f61-36f0-4a11-8b53-a934abf38ab4",
                                                "sense_id": "2a17252b-8bd1-3784-a17e-3370e180c290",
                                                "text": "„Ähnlich grotesk wie diese Welt Kiens erscheint vom zweiten Teil an die Welt von Hausierern, Gaunern, Dieben und Zuhältern, in der der Jude Fischerle, ein zwergenhafter Buckliger, als besonderer Führer agiert und besessen die beiden Ziele verfolgt, auf allen legalen und vor allem illegalen Wegen Geld für eine Operation zu horten, um seinen Buckel loszuwerden.“"
                                            },
                                            {
                                                "example_id": "0e3e8ec1-b246-4eaf-ac15-212324fa56ed",
                                                "sense_id": "2a17252b-8bd1-3784-a17e-3370e180c290",
                                                "text": "„Seitdem blieben sogar die Diebe aus dem Stadtteil weg, in dem ich nun die einzige lebende Seele war.“"
                                            },
                                            {
                                                "example_id": "0a7c0030-a2ee-4f59-9946-324a045211af",
                                                "sense_id": "2a17252b-8bd1-3784-a17e-3370e180c290",
                                                "text": "„Einbrüche kamen in Akranes schon mal vor, wobei er bezweifelte, dass Diebe um diese Tageszeit zuschlagen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ccffe57-ecf2-33f6-a2cf-29451c063314",
                                        "entry_id": "51ce93a4-8233-3bd9-b160-dfca52667d46",
                                        "glosses": [
                                            "Schelm, Kind"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b5b482-be49-4b89-8e38-b7e6e20b8900",
                                                "sense_id": "3ccffe57-ecf2-33f6-a2cf-29451c063314",
                                                "text": "„Manchmal erbettelt sich der kleine Dieb selbst die Erlaubniß von ihm, mein Schlafkamerade zu sein“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
