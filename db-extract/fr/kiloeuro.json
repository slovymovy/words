                                                "sense_id": "1a7ee0af-730f-314d-ad4e-b6ec7c5681c2",
                                                "text": "Ein Kilometer sind tausend Meter."
                                            },
                                            {
                                                "example_id": "5e053f4f-b7a5-4a13-9074-56e4c4a8462a",
                                                "sense_id": "1a7ee0af-730f-314d-ad4e-b6ec7c5681c2",
                                                "text": "„Rund tausend Kunden einer kleinen, feinen Bank in Zürich müssen nun fürchten, wegen Steuerhinterziehung belangt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
