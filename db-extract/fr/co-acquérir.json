                ],
                "senses": [
                    {
                        "sense_id": "09ab7bee-3488-3342-9542-e337a845f37d",
                        "entry_id": "f3360ed0-ebca-3979-8337-d643ed9479cb",
                        "glosses": [
                            "Acquérir en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47813634-4339-4faa-bb08-6fbd03301cb7",
                                "sense_id": "09ab7bee-3488-3342-9542-e337a845f37d",
                                "text": "Si vous êtes mariés, les conditions dans lesquelles vous pouvez co-acquérir dépendent de votre régime matrimonial."
                            },
                            {
                                "example_id": "273a8a5b-0524-4182-b90f-dce0251ff34c",
                                "sense_id": "09ab7bee-3488-3342-9542-e337a845f37d",
                                "text": "Après des heures de recherches, j'ai donc décidé de co-acquérir une sonde de calibration."
                            },
                            {
                                "example_id": "6423a741-e85e-4a5d-8e52-2684c78c2c5f",
                                "sense_id": "09ab7bee-3488-3342-9542-e337a845f37d",
                                "text": "En d'autres mots, elle est donnée à Dieu pour co-obtenir, pour co-acquérir, pour co-acheter dans le Christ le salut d'autrui."
                            }
                        ]
                    }
