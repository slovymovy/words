                                        "glosses": [
                                            "aus einem Text, Bild, Film oder Tondokument tatsächlich (zum Beispiel: Zeitung, Foto, Film, Tonband) oder im übertragenen Sinne (Textdatei, Digitalfoto, Video, mp3-Datei) ausgeschnittener Teil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47668596-c1dd-4ffe-a4c0-c006d50fae6c",
                                                "sense_id": "7c375532-6c33-3593-93d2-f237c5ff75a9",
                                                "text": "Hier sehen Sie einen Ausschnitt aus Alfred E. Neumanns neuem Film."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f4ce0da-b2fc-3bb9-ac50-2bd05bfc254d",
                                        "entry_id": "8056acbc-aaf7-33c9-8aec-d4ea7a15176a",
                                        "glosses": [
                                            "von einer Kamera oder einem Bild erfasster Bereich der Umgebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0bdace-b1da-48a4-af15-3fdcdbd57a2e",
                                                "sense_id": "4f4ce0da-b2fc-3bb9-ac50-2bd05bfc254d",
                                                "text": "Bei Tieraufnahmen wählt man den Ausschnitt so, dass das Tier Format füllend dargestellt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34e88588-cb3e-34f0-a764-b24f707645b2",
                                        "entry_id": "8056acbc-aaf7-33c9-8aec-d4ea7a15176a",
                                        "glosses": [
                                            "beim Schneidern eines Kleidungsstücks ausgeschnittenes Loch, durch das man Kopf, Arm oder Bein steckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4e1be4-1808-492d-ac1a-7fb236f222fb",
                                                "sense_id": "34e88588-cb3e-34f0-a764-b24f707645b2",
                                                "text": "Die Ausschnitte für Arme und Beine sind etwas groß geraten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1477e9c3-3009-3d0b-adcb-ec180d6f0c1a",
                                        "entry_id": "8056acbc-aaf7-33c9-8aec-d4ea7a15176a",
                                        "glosses": [
                                            "speziell der Halsausschnitt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a82c386-4d06-4b06-8208-17c8904d27a0",
                                                "sense_id": "1477e9c3-3009-3d0b-adcb-ec180d6f0c1a",
                                                "text": "Er blicke ihr tief in den Ausschnitt."
                                            },
                                            {
                                                "example_id": "e5ce9862-18de-4ca6-9865-1477e5078e17",
                                                "sense_id": "1477e9c3-3009-3d0b-adcb-ec180d6f0c1a",
                                                "text": "„Sie setzte sich wieder und zog am Ausschnitt ihrer Bluse.“"
                                            },
                                            {
                                                "example_id": "020a1942-4372-4413-94f7-ee1a676ab7d0",
                                                "sense_id": "1477e9c3-3009-3d0b-adcb-ec180d6f0c1a",
                                                "text": "„Sie probierte ein rotes Kleid mit eckigem Ausschnitt und weit schwingendem, knielangem Rock.“"
                                            },
                                            {
                                                "example_id": "eb9ac435-7abc-480f-bf87-6ad4eeb2ac64",
                                                "sense_id": "1477e9c3-3009-3d0b-adcb-ec180d6f0c1a",
                                                "text": "„Der schwarze Einteiler betonte die Figur, und kaum jemand konnte es lassen, ihr tief in den Ausschnitt zu gucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
