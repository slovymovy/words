                "senses": [
                    {
                        "sense_id": "2f68d724-2b03-3414-9d41-4eb5533c5eed",
                        "entry_id": "a9f18186-7d58-3a0d-847b-68d129456644",
                        "glosses": [
                            "Person, die sich berufsmäßig mit Rechtsthemen befasst, beispielsweise ein Rechtsanwalt"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "35c07c8e-7e41-4cca-9fa5-2778581cd805",
                                "sense_id": "2f68d724-2b03-3414-9d41-4eb5533c5eed",
                                "text": "„Er ist zwar nie mit dem Gesetz in Konflikt gekommen, trotzdem hat er etwas gegen Richter und Anwälte. Paragraphenhengste nennt er sie, und es trifft ihn hart, daß ausgerechnet sein Sohn ein solcher Paragraphenhengst werden will.“"
                            },
                            {
                                "example_id": "6db9efe4-e136-4dc2-ad69-62a113afb785",
                                "sense_id": "2f68d724-2b03-3414-9d41-4eb5533c5eed",
                                "text": "„[…] Merciers Tonfall wird schärfer und somit unberrschter. Justizminister Guérin ist also in seinen Augen ein Paragrafenhengst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0868ed11-d313-39b6-b9de-aaa7cf11ffd0",
                        "entry_id": "a9f18186-7d58-3a0d-847b-68d129456644",
                        "glosses": [
                            "Person, der vorgeworfen wird, in kleinlicher Weise auf der Einhaltung von Vorschriften und Gesetzen zu bestehen, beispielsweise ein Mitarbeiter einer Behörde"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "8e697531-ece9-4b16-999f-efd91b5aa489",
                                "sense_id": "0868ed11-d313-39b6-b9de-aaa7cf11ffd0",
                                "text": "„Dieser sture Paragraphenhengst ließ sich auf nichts ein.“"
                            },
                            {
                                "example_id": "20a7afa4-4d1b-4d99-bddd-cfb8d2b67374",
                                "sense_id": "0868ed11-d313-39b6-b9de-aaa7cf11ffd0",
                                "text": "„»Catherine meinte in der Tat, Sie erkannt zu haben: als den neuen Inspekteur der Sozialbehörden, ein scharfer Hund wie ihr die Nachbarn hinterbracht hatten, ein rechter Paragraphenhengst. […]«“"
                            },
                            {
                                "example_id": "10dc8ec8-6d01-436a-b67b-51fd280c7df6",
                                "sense_id": "0868ed11-d313-39b6-b9de-aaa7cf11ffd0",
                                "text": "»Ach der Kerl!« Ihr Lachen bebte ein wenig. »Er ist nur ein Paragraphenhengst. Wir alle brauchen in unserer großen Republik unsere Paragraphenhengste.«"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
