                            {
                                "example_id": "c3f3c491-04ec-458b-a6a2-96817859b4ba",
                                "sense_id": "35960010-f677-3862-817b-0cd8b635193f",
                                "text": "Einen Gott ‘Ogmios’ hat es im damaligen Gallien demnach offenbar tatsächlich gegeben. […] Auch eine Verbindung von Ogmios und Merkur, die in älterer Forschungsliteratur noch diskutiert wird, lehnt man heute ab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d64d010b-cb9d-3d9d-a2cd-da0fa87e2ab3",
                        "entry_id": "05f1716e-f283-3f7c-868a-9f2083f25303",
                        "glosses": [
                            "eine antike keltische Gottheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83d112bf-abdc-43a8-b958-589a23e957a1",
                                "sense_id": "d64d010b-cb9d-3d9d-a2cd-da0fa87e2ab3",
                                "text": "Als sein Halbbruder galt Ogma, der keltische Gott Ogmios, den die Iren als Erfinder ihrer nach ihm benannten Ogam-Schrift ansahen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
