                                                "example_id": "0d71b748-1153-41c5-b151-9d15a5bd5c8c",
                                                "sense_id": "1f8bd6d8-111a-3907-a13f-c9139ddc5d4c",
                                                "text": "His frequent quips mark him as particularly witty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "484dbd3b-6bdb-38d5-95e4-9d68216ccf3a",
                                        "entry_id": "b979d36a-ef26-35c9-a06c-27dd5d501438",
                                        "glosses": [
                                            "Quick of mind; insightful; in possession of wits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387d8deb-c617-4158-9c73-be2c05a64a0b",
                                                "sense_id": "484dbd3b-6bdb-38d5-95e4-9d68216ccf3a",
                                                "text": "She may have grown older, but she has grown no less witty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fd1ff65-37a0-3557-9e55-26f2c8a12064",
                                        "entry_id": "b979d36a-ef26-35c9-a06c-27dd5d501438",
                                        "glosses": [
                                            "Wise, having good judgement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6d1f559-b6be-398c-8e9a-e7cc7d36977b",
                                        "entry_id": "b979d36a-ef26-35c9-a06c-27dd5d501438",
                                        "glosses": [
                                            "Possessing a strong intellect or intellectual capacity; intelligent, skilful, ingenious."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a0ef2ee-b667-4116-b200-2410e7893cf6",
                                                "sense_id": "d6d1f559-b6be-398c-8e9a-e7cc7d36977b",
                                                "text": "It hath beene a witty invention[…]to establish and ordaine certaine vaine and worthles markes, therewith to honor and recompence vertue[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a0f0380-8c55-44f5-a0bf-ff5d710d0d78",
                        "source_entry_id": "473b22c6-ee4b-3499-99d5-613677293723",
                        "source_sense_id": "1be2c833-8a12-3142-9e6d-48c3dcb2acde",
                        "source_sense_description": "scherpzinnig",
                        "target_lang_word": "остроумный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "остроумный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ae224124-25bd-3a18-8c39-7d2a79827f08",
                                        "entry_id": "783ecbe1-1def-3f66-8305-e98b561db4aa",
                                        "glosses": [
                                            "обладающий, отличающийся остроумием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60cf77f0-4d1a-44ac-9e55-711ff15122c7",
                                                "sense_id": "ae224124-25bd-3a18-8c39-7d2a79827f08",
                                                "text": "Человек остроумный, бесспорно, и глубокоученый; но правильный ли это ум?"
                                            },
                                            {
                                                "example_id": "0616029c-9549-4644-9f2e-03922754b7ef",
                                                "sense_id": "ae224124-25bd-3a18-8c39-7d2a79827f08",
                                                "text": "Степану Трофимовичу, как и всякому остроумному человеку, необходим был слушатель, и, кроме того, необходимо было сознание о том, что он исполняет высший долг пропаганды идей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfa5d35f-89d9-333b-9573-a128d3426ddc",
                                        "entry_id": "783ecbe1-1def-3f66-8305-e98b561db4aa",
                                        "glosses": [
                                            "отличающийся остроумием (о высказывании, шутке и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6775c5ad-ed90-4566-a6ad-86e15b70ae21",
                                                "sense_id": "bfa5d35f-89d9-333b-9573-a128d3426ddc",
                                                "text": "Ничего не было дурного или неуместного в том, что они говорили, всё было остроумно и могло бы быть смешно; но чего-то, того самого, что составляет соль веселья, не только не было, но они и не знали, что оно бывает."
                                            },
                                            {
                                                "example_id": "b1e87f0a-d073-4e03-b908-38dda58da2d6",
                                                "sense_id": "bfa5d35f-89d9-333b-9573-a128d3426ddc",
                                                "text": "В обществе, где она жила, такие слова производили действие самой остроумной шутки."
                                            },
                                            {
                                                "example_id": "38504eb1-170a-4fb5-8e97-230ac9bf0b12",
                                                "sense_id": "bfa5d35f-89d9-333b-9573-a128d3426ddc",
                                                "text": "Выждал я время и раз в большом обществе удалось мне вдруг «соперника» моего оскорбить будто бы из-за самой посторонней причины, подсмеяться над одним мнением его об одном важном тогда событии ― в двадцать шестом году дело было ― и подсмеяться, говорили люди, удалось остроумно и ловко."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52a5a49c-1057-451d-a1d1-81ab78d07648",
                        "source_entry_id": "473b22c6-ee4b-3499-99d5-613677293723",
                        "source_sense_id": "7f527951-49fc-31a7-a1f2-395c551c5b8f",
                        "source_sense_description": "bedriegelijk",
                        "target_lang_word": "disingenuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disingenuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b3e304-62d1-3ac9-8608-17d5e95855f5",
                                        "entry_id": "5c532b2b-5535-359d-80a4-118490e5b542",
                                        "glosses": [
                                            "Not honourable; unworthy of honour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "086d9f96-9a72-3047-90c7-0d60d384b718",
                                        "entry_id": "5c532b2b-5535-359d-80a4-118490e5b542",
                                        "glosses": [
                                            "Not ingenuous; not frank or open."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cedafaf-ba37-4d83-bed3-c3ecda70dc62",
                                                "sense_id": "086d9f96-9a72-3047-90c7-0d60d384b718",
                                                "text": "I am not so vain as to think these Remarks free from faults, nor so disingenuous as not to confess them:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cc0fcfc-cec1-35c2-a7b1-49576e573f8a",
                                        "entry_id": "5c532b2b-5535-359d-80a4-118490e5b542",
                                        "glosses": [
                                            "Assuming a pose of naïveté to make a point or for deception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f8fb0a-0cf8-4c12-ba8c-a58275824f32",
                                                "sense_id": "7cc0fcfc-cec1-35c2-a7b1-49576e573f8a",
                                                "text": "But was it responsible governance to pass the Longitude Act without other efforts to protect British seamen? Or might it have been subterfuge—a disingenuous attempt to shift attention away from the realities of their life at sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b93c1b20-c644-4578-ae23-11b3f37f2b97",
                        "source_entry_id": "473b22c6-ee4b-3499-99d5-613677293723",
                        "source_sense_id": "7f527951-49fc-31a7-a1f2-395c551c5b8f",
                        "source_sense_description": "bedriegelijk",
                        "target_lang_word": "deceitful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deceitful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86b1a9a0-24d7-39e0-843e-7281704a0ab0",
                                        "entry_id": "ec7b213b-90f0-3a0e-a60e-b6687d50c881",
                                        "glosses": [
                                            "Deliberately misleading or cheating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ad4bc9-c2ef-4df4-85e9-a29112d5fb68",
                                                "sense_id": "86b1a9a0-24d7-39e0-843e-7281704a0ab0",
                                                "text": "All theſe are ſeruants to deceitfull men."
                                            },
                                            {
                                                "example_id": "3dee10a3-a41a-43c8-9dc6-b5e31e83169b",
                                                "sense_id": "86b1a9a0-24d7-39e0-843e-7281704a0ab0",
                                                "text": "Faithfull are the woundes of a friend : but the kiſſes of an enemy are deceitfull."
                                            },
                                            {
                                                "example_id": "99240a0b-8e84-4035-9f35-864c02bd9f10",
                                                "sense_id": "86b1a9a0-24d7-39e0-843e-7281704a0ab0",
                                                "text": "This world is all a fleeting show, / For man’s illusion given ; / The smiles of Joy, the tears of Woe, / Deceitful shine, deceitful flow — / There’s nothing true but Heaven !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1f39a93-5a7c-31f7-af78-4425a7f72cd3",
                                        "entry_id": "ec7b213b-90f0-3a0e-a60e-b6687d50c881",
                                        "glosses": [
                                            "Deceptive, two-faced."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac226164-3b7b-4ac9-9906-3c4b7a7b95c1",
                        "source_entry_id": "473b22c6-ee4b-3499-99d5-613677293723",
                        "source_sense_id": "7f527951-49fc-31a7-a1f2-395c551c5b8f",
                        "source_sense_description": "bedriegelijk",
                        "target_lang_word": "лукавый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лукавый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "775f126a-2675-3f1a-b7b2-6fcd7e6426f3",
                                        "entry_id": "71b82b82-fa3d-35c1-a42f-f62f1f88e22f",
                                        "glosses": [
                                            "лживый, обманный, подлый, хитрый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d6c4b6f-f352-4aae-9f9d-45d9319f44cc",
                                                "sense_id": "775f126a-2675-3f1a-b7b2-6fcd7e6426f3",
                                                "text": "Он подумает, что перед ним лукавый, двоедушный человек, который из какой-то корысти стремился произвести на Ивана Васильевича хорошее впечатление."
                                            },
                                            {
                                                "example_id": "3bf9d58d-543e-40ca-bfdf-5dd43430babe",
                                                "sense_id": "775f126a-2675-3f1a-b7b2-6fcd7e6426f3",
                                                "text": "Чтобы снискать расположение России, Баттенберг решил сделать лукавый ход."
                                            },
                                            {
                                                "example_id": "05909abf-5745-4fa2-a35d-c6fb0e18042d",
                                                "sense_id": "775f126a-2675-3f1a-b7b2-6fcd7e6426f3",
                                                "text": "Они видят мою простоту и неопытность, что-де попался к ним на удочку, они с лукавой улыбкой так и рассыпались, уверяя с клятвой, что естли соединюсь с ними торговать, то ближе года так разбогатею, что на тройке рысистых лошадей покатывать буду."
                                            },
                                            {
                                                "example_id": "eecb6695-6662-48a1-9176-9c337acbba39",
                                                "sense_id": "775f126a-2675-3f1a-b7b2-6fcd7e6426f3",
                                                "text": "Однажды хулиганистый старый, весь потрескавшийся слон, его проводили по кругу арены, чтобы он здоровался со зрителями, вылил, лукавый, ведро воды из хобота на ни в чём не повинную бабушку, сидевшую в первом ряду, привёдшую внучку в цирк."
                                            },
                                            {
                                                "example_id": "7b8a4566-491d-45f2-92e7-5c49f9b0cd9d",
                                                "sense_id": "775f126a-2675-3f1a-b7b2-6fcd7e6426f3",
                                                "text": "― Как молодой повеса ждёт свиданья с какой-нибудь развратницей лукавой…"
                                            },
                                            {
                                                "example_id": "63cc8a73-d8ce-4edd-a460-5b688d410555",
                                                "sense_id": "775f126a-2675-3f1a-b7b2-6fcd7e6426f3",
                                                "text": "Жадный и лукавый — это лиса; алчный и хищный — волк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c606e851-7d4e-34e5-97ad-28ea94ea29ce",
                                        "entry_id": "71b82b82-fa3d-35c1-a42f-f62f1f88e22f",
                                        "glosses": [
                                            "перен. добродушно-хитроватый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f196f0e4-23f3-4d68-9c5e-c8c87f897492",
                                                "sense_id": "c606e851-7d4e-34e5-97ad-28ea94ea29ce",
                                                "text": "Шухов — обобщённый характер русского простого человека: жизнестойкий, «злоупорный», выносливый, мастер на все руки, лукавый — и добрый."
                                            },
                                            {
                                                "example_id": "a0a19646-de75-4b6d-ae02-ca001557960a",
                                                "sense_id": "c606e851-7d4e-34e5-97ad-28ea94ea29ce",
                                                "text": "Лицо старика по-прежнему было серьёзно, когда он говорил свою ироническую тираду, только бескровные, тонкие губы его чуть-чуть перекосились да в серых глазах играла едва заметная лукавая улыбка."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "лукавый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ad2df740-7487-3cfa-aded-121a97d83167",
                                        "entry_id": "1ed76e92-8aee-3b81-bb03-9aaea2ad475e",
                                        "glosses": [
                                            "субстантивир., эвф. то же, что дьявол"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880f0734-1734-4e54-b3c6-2a3e93b40262",
                                                "sense_id": "ad2df740-7487-3cfa-aded-121a97d83167",
                                                "text": "Языком лепечу слова, а на уме совсем не то: точно мне лукавый в уши шепчет, да всё про такие дела нехорошие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
