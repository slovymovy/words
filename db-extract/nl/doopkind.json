                    },
                    {
                        "sense_id": "986d239e-7ad5-369d-8488-6dd7f75b4552",
                        "entry_id": "09b9c867-0a3e-3571-acae-7ab3de0c55ed",
                        "glosses": [
                            "kind dat gedoopt gaat worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d3c49c-abfe-4f1c-bf0b-1a1d7d1cc39a",
                                "sense_id": "986d239e-7ad5-369d-8488-6dd7f75b4552",
                                "text": "Na een koude natte mei heeft juni prachtig ingezet, de dag schijnt zelfs warmer te worden dan hij met zijn galakleren en zijn zwaarlijvigheid wenselijk vindt, maar voor Betje en het tedere doopkind levert de kerkgang bij dit warme weer tenminste geen gevaren."
                            },
                            {
                                "example_id": "017dbb38-c092-4b40-98f8-833499015683",
                                "sense_id": "986d239e-7ad5-369d-8488-6dd7f75b4552",
                                "text": "Truitje en Minetje zullen met haarzelf, mamsell en de min met het doopkind in de koets rijden, Gijsbert en Hein gaan te voet met de gouverneur, en Dirk, omdat hij de oudste is, met zijn vader."
                            }
                        ]
                    }
