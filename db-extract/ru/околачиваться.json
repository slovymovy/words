                ],
                "senses": [
                    {
                        "sense_id": "afb85348-ebc2-3acc-97c3-874c6adaa29c",
                        "entry_id": "de52d3ad-ca84-3325-b9ab-34ab53f94d26",
                        "glosses": [
                            "прост. ходить, находиться где-либо, обычно без дела, понапрасну, зря"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2441c5d2-214b-4dd1-8fc9-fc3f3baa2bfe",
                                "sense_id": "afb85348-ebc2-3acc-97c3-874c6adaa29c",
                                "text": "Уж февраль, а генерал всё ещё в городе околачивался, всё боялся приехать домой."
                            },
                            {
                                "example_id": "1651b4a5-4783-43ed-a720-137d55b406a5",
                                "sense_id": "afb85348-ebc2-3acc-97c3-874c6adaa29c",
                                "text": "На пристани околачивалось очень много таких же, как он, бездомных бродяг."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a89a888-3055-4f79-984b-2ed56b9b035c",
                        "source_entry_id": "de52d3ad-ca84-3325-b9ab-34ab53f94d26",
                        "source_sense_id": "afb85348-ebc2-3acc-97c3-874c6adaa29c",
                        "target_lang_word": "herumtreiben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herumtreiben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1a5ec0-2202-3d2e-b452-9b8a12a489c3",
                                        "entry_id": "e9a0fbfe-cb5a-35ca-a161-174484c21501",
                                        "glosses": [
                                            "sich ziellos bewegen, sich an keinem bestimmten Ort aufhalten"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5822ef2-7754-4fe0-b232-3f24663efa07",
                                                "sense_id": "0f1a5ec0-2202-3d2e-b452-9b8a12a489c3",
                                                "text": "Der Landstreicher treibt sich in den Straßen herum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aced90fe-3b90-36e5-af00-b8bf334a3d3b",
                                        "entry_id": "e9a0fbfe-cb5a-35ca-a161-174484c21501",
                                        "glosses": [
                                            "jemanden oder etwas im Kreise bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a6c20ef-91e5-4d7a-b870-2433b40b6bc8",
                                                "sense_id": "aced90fe-3b90-36e5-af00-b8bf334a3d3b",
                                                "text": "Der Wallach scheint Spass daran zu haben, die anderen Pferde auf der Koppel herumzutreiben.",
                                                "translation": "„In meiner Jugend trieb ich mich häufiger auf Imageboards herum.“"
                                            }
                                        ],
