                {
                    "sense_id": "55cfaa7f-d0f7-3e97-9b0d-9b20c5c2eb8d",
                    "sense_definition": "A member of a Native American tribe from the Southeastern United States, also known as the Muscogee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tribe_noun",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Creek</w> have a rich history in the southeastern region.",
                            "target_lang_translations": {
                                "ru": "У <w>криков</w> богатая история в юго-восточном регионе.",
                                "zh": "<w>克里克人</w>在东南部地区有着丰富的历史。",
                                "es": "Los <w>creek</w> tienen una rica historia en la región sureste.",
                                "tr": "<w>Kriklerin</w> güneydoğu bölgesinde zengin bir tarihi vardır.",
                                "de": "Die <w>Krik-Indianer</w> haben eine reiche Geschichte in der südöstlichen Region."
                            }
                        },
                        {
                            "text": "He is studying the traditions of the <w>Creek</w> people.",
                            "target_lang_translations": {
                                "ru": "Он изучает традиции народа <w>крик</w>.",
                                "zh": "他正在研究<w>克里克人</w>的传统。",
                                "es": "Él está estudiando las tradiciones del pueblo <w>creek</w>.",
                                "tr": "<w>Krik</w> halkının geleneklerini inceliyor.",
                                "de": "Er studiert die Traditionen des Volkes der <w>Muscogee</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель индейского племени с юго-востока США, также известного как маскоги.",
                        "zh": "美国东南部的一个美洲原住民部落成员，也称为马斯科吉人。",
                        "es": "Miembro de una tribu nativa americana del sureste de los Estados Unidos, también conocidos como muscogui.",
                        "tr": "Amerika Birleşik Devletleri'nin güneydoğusunda yaşayan, Muscogee olarak da bilinen bir Kızılderili kabilesinin üyesi.",
                        "de": "Angehöriger eines indigenen Volkes aus dem Südosten der USA, auch bekannt als Muscogee."
                    },
