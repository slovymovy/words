                        "examples": [
                            {
                                "example_id": "0b0d4a51-2207-4d49-9295-5326c851b205",
                                "sense_id": "29347daf-7da2-3087-8602-9867fc57d010",
                                "text": "If you're really hungry, be sure to try the wood-fired jojos (potato wedges).",
                                "translation": "如果你真的很餓，一定要嚐嚐柴火烤的 jojo（馬鈴薯塊）。"
                            },
                            {
                                "example_id": "9d531320-1d33-4bc9-a295-0cb328af4d5b",
                                "sense_id": "29347daf-7da2-3087-8602-9867fc57d010",
                                "text": "The cheesy jojos threaten to colonize every inch of my appetite but I hold back by only eating them once I am nearly full.",
                                "translation": "起司味濃郁的 jojo 薯塊險些佔據我胃裡的每一個角落，但我克制住了，只有在快吃飽時才吃它們。"
                            },
                            {
                                "example_id": "e9097710-2765-49a4-acb5-b28937576ae1",
                                "sense_id": "29347daf-7da2-3087-8602-9867fc57d010",
                                "text": "或許 George 酒吧最（不）為人知的秘密就是它的炸雞和 jojo 薯塊，這足以讓 Reel M Inn 感到威脅。"
                            }
                        ]
