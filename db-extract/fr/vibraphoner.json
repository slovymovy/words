                "senses": [
                    {
                        "sense_id": "f8cb5dc5-997f-318b-a246-c9dd33d0f2f7",
                        "entry_id": "0d365029-03fd-3637-904b-ff17360a2e3b",
                        "glosses": [
                            "Faire un bruit de vibraphone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0951b490-a2d3-45a1-a0a1-70a7c503cd33",
                                "sense_id": "f8cb5dc5-997f-318b-a246-c9dd33d0f2f7",
                                "text": "Le choléra vibraphonait la cadence des pilons, berçait la mollesse des peaux des bébés, rythmait le lavage des linges, rôdait au milieu des marchandes du marché, caracolait dans les jeux d’enfants, se promenait lors des fêtes traditionnelles et servait de musique d'ambiance dans les parties de jambes en l’air."
                            },
                            {
                                "example_id": "73518df4-4282-4ebe-a32f-2b79527996cf",
                                "sense_id": "f8cb5dc5-997f-318b-a246-c9dd33d0f2f7",
                                "text": "Chaque soir, il donne la réplique au groupe présent, faisant vibraphoner le carillon à l'unisson."
                            },
                            {
                                "example_id": "325dd812-6873-4a6a-a00f-e8a8fad3a781",
                                "sense_id": "f8cb5dc5-997f-318b-a246-c9dd33d0f2f7",
                                "text": "si au moins t'étais un petit violon je pourrais faire vibraphoner ta cordelette de sensiblerie"
                            }
                        ]
                    }
                ],
