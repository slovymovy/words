                                        "examples": [
                                            {
                                                "example_id": "9a79d6f9-34c1-4c96-aea1-ab9c99329ba2",
                                                "sense_id": "ee069862-74d3-3df6-a10d-8adb4619846f",
                                                "text": "The tax assessor put them in fourteen valuation groups ranging from one two-story brick house and two one-and-a-half-story houses to the largest groups of eighteen two-story houses and twenty-four one-story bungalows."
                                            },
                                            {
                                                "example_id": "2851c8dd-670e-4611-acdf-8c0d844363f1",
                                                "sense_id": "ee069862-74d3-3df6-a10d-8adb4619846f",
                                                "text": "Reddit's (RDDT.N) initial public offering is currently between four and five times oversubscribed, people familiar with the matter said on Sunday, making it more likely the social media platform will attain the $6.5 billion valuation it seeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df9fa86-a3a6-3c86-b43e-40b1ea044e8c",
                                        "entry_id": "42304543-c35b-3da7-971c-b43b70fd0a9c",
                                        "glosses": [
                                            "An assignment of truth values to propositional variables, with a corresponding assignment of truth values to all propositional formulas with those variables (obtained through the recursive application of truth-valued functions corresponding to the logical connectives making up those formulas)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
