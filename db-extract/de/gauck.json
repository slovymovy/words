                "senses": [
                    {
                        "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                        "entry_id": "f97a8486-2165-3609-8992-52d69ef3d76e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9df40bf-d107-4517-8501-7a0a4f5a6c49",
                                "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gauck kommt, geht der Herr Gauck.“"
                            },
                            {
                                "example_id": "4073c126-5b9b-4d54-abf1-02f6ef85af69",
                                "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                                "text": "Gauck kommt und geht."
                            },
                            {
                                "example_id": "85c3884b-15b0-4e8d-96f9-8c081d531c17",
                                "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                                "text": "Gaucks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "2f9606c7-5266-427e-9d7a-36677d7b0b25",
                                "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                                "text": "Der Gauck trägt nie die Pullover, die die Gauck ihm strickt."
                            },
                            {
                                "example_id": "444ca03d-8013-4f56-b256-1d0ecce827ad",
                                "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                                "text": "Frau Gauck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8ce70a76-b690-4e9d-813a-ab5a96c25be7",
                                "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                                "text": "Herr Gauck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5bd832ba-11fc-47b8-a7c2-28309ba9b397",
                                "sense_id": "b9a5ee64-351c-3dc0-a54e-5a781e915047",
                                "text": "Die Gaucks fliegen heute nach Sri Lanka."
                            }
                        ],
                        "sense_index_json": "\"1\""
