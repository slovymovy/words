    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "adc2f9bd-95b2-3789-9e1c-775b998eddc9",
                    "sense_definition": "Hörbar und tief ein- oder ausatmen als Ausdruck von Kummer, Erleichterung, Erschöpfung oder Resignation",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als sie nach dem langen Arbeitstag endlich nach Hause kam, <w>seufzte</w> sie tief vor Erleichterung."
                        },
                        {
                            "text": "Er ließ die Schultern hängen und <w>seufzte</w> leise vor sich hin."
                        }
                    ],
                    "common_phrases": [
                        "tief seufzen",
                        "erleichtert seufzen"
                    ]
                },
                {
                    "sense_id": "68a22f6e-fa9e-37ae-8bc7-1b5490fa4762",
                    "sense_definition": "Etwas mit Bedauern, Resignation oder Kummer in der Stimme äußern",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "„Ich fürchte, wir haben den letzten Zug verpasst“, <w>seufzte</w> er enttäuscht."
                        },
                        {
                            "text": "„Es gibt noch so viel zu tun“, <w>seufzte</w> die Kollegin mit Blick auf den Schreibtisch."
                        }
                    ],
                    "common_phrases": [
                        "leise seufzen",
                        "verzweifelt seufzen"
                    ]
                },
                {
                    "sense_id": "37968a9e-1305-320f-8de1-398fce4f8e75",
                    "sense_definition": "Schwer unter einer drückenden Last, Not oder Unterdrückung leiden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Bevölkerung des Landes <w>seufzte</w> jahrelang unter der drückenden Last der hohen Steuern."
                        },
                        {
                            "text": "Das marode Gesundheitssystem <w>seufzt</w> unter dem ständigen Mangel an qualifiziertem Personal."
                        }
                    ],
                    "synonyms": [
                        "leiden"
                    ],
                    "common_phrases": [
                        "unter der Last seufzen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46032df6-5b89-3ab0-8d5b-cab19f943aca",
                    "sense_definition": "Substantivierung des Verbs <w>seufzen</w>: das vernehmliche Ausstoßen der Atemluft als Gefühlsausdruck",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit einem tiefen <w>Seufzen</w> legte der Richter die Akten beiseite und schloss kurz die Augen."
                        },
                        {
                            "text": "Aus dem Nebenzimmer war plötzlich ein leises <w>Seufzen</w> zu hören."
                        }
                    ],
                    "common_phrases": [
                        "ein tiefes Seufzen",
                        "mit schwerem Seufzen"
                    ]
                }
            ]
        }
    ]
