                    {
                        "translation_id": "35cc0fa7-09a3-4078-a6d8-7787ecd0f3b0",
                        "source_entry_id": "f3e072ee-4a89-3b60-851f-0710d5291c23",
                        "source_sense_id": "6608c81a-2f55-3619-823f-c3195fa0a26f",
                        "target_lang_word": "gangster",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gangster",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83c14b2f-9eb2-3ee1-99ea-713d78218e9f",
                                        "entry_id": "90c1316e-8358-3a86-b0a2-d6455c8f2a56",
                                        "glosses": [
                                            "Malfaiteur de carrière, membre d’une organisation criminelle."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c2a045e-38dc-45dd-801f-9a458298ed1b",
                                                "sense_id": "83c14b2f-9eb2-3ee1-99ea-713d78218e9f",
                                                "text": "Al Capone est l’un des gangsters les plus connus."
                                            },
                                            {
                                                "example_id": "d9eb4134-94a6-4a68-bfc7-8ae5b8b79d13",
                                                "sense_id": "83c14b2f-9eb2-3ee1-99ea-713d78218e9f",
                                                "text": "Et puis, parce qu’ils formaient ce que les Américains nomment « a gang », une bande, M. Sabahu les avait réunis sous l’appellation générale de gangsters. Il prononçait ganguestères, de sorte que toute l’école croyait qu’il avait trouvé ce joli nom-là dans le système métrique."
                                            },
                                            {
                                                "example_id": "3ed9e6cd-5f2f-4f28-9427-8ac35424d178",
                                                "sense_id": "83c14b2f-9eb2-3ee1-99ea-713d78218e9f",
                                                "text": "Ils ont déjà du mal à retrouver les gangsters qui fauchent des millions de bijoux ou de billets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
