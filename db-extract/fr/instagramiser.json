                ],
                "senses": [
                    {
                        "sense_id": "bc2ea1e9-3e1b-3f27-a649-8a45dbd9471d",
                        "entry_id": "7d08025e-46a4-3161-b073-93287b7de979",
                        "glosses": [
                            "Préparer et poster (une photo, par exemple) sur Instagram."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4bd062-4e3f-4171-b753-a77c77bc6e32",
                                "sense_id": "bc2ea1e9-3e1b-3f27-a649-8a45dbd9471d",
                                "text": "Des restaurateurs, au fait de ce phénomène, s’évertuent à « instagramiser » leurs plats pour être diffusés dans leur plus bel aspect."
                            },
                            {
                                "example_id": "2583aa74-3d31-4d96-964c-6ccd0a205b56",
                                "sense_id": "bc2ea1e9-3e1b-3f27-a649-8a45dbd9471d",
                                "text": "Ces jeunes sont une caricature des nouveaux touristes américain un peu cool et condescendants qui en regardant ces autochtones et leurs rites, semblent être dans le besoin de comprendre, de photographier, étudier, instagramiser et s’offusquer de certaines traditions plutôt que de vivre pleinement cet évènement."
                            },
                            {
                                "example_id": "318d6b24-b588-4e5a-8759-06efe3339ae8",
                                "sense_id": "bc2ea1e9-3e1b-3f27-a649-8a45dbd9471d",
                                "text": "Ne dit-on pas “instagramiser” ses photos ? Alors à vos smartphones, shootez et… post-traitez ! instagramisez vos photos !"
                            }
                        ]
                    },
                    {
                        "sense_id": "64ac92c6-fcc0-3ca8-babc-2dae86476d58",
                        "entry_id": "7d08025e-46a4-3161-b073-93287b7de979",
                        "glosses": [
                            "Donner un caractère rappelant Instagram à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58120d15-b01d-4460-9c9e-9cdd1e5115a4",
                                "sense_id": "64ac92c6-fcc0-3ca8-babc-2dae86476d58",
                                "text": "Pour plaire au plus grand nombre, Snapchat a donc décidé de s’instagramiser et de se facebookiser."
                            },
                            {
                                "example_id": "f44eca4e-ba4d-4e45-a23a-c9d7217e704c",
                                "sense_id": "64ac92c6-fcc0-3ca8-babc-2dae86476d58",
                                "text": "Il semblerait que Twitter, en mal de reconnaissance ces derniers temps, soit en train de s’« instagramiser »."
                            }
                        ]
                    }
                ],
