                    {
                        "sense_id": "b3577a45-b17d-362e-8a69-453dc1ff1109",
                        "entry_id": "59e96d0c-b0d5-3ac8-b219-e36857088352",
                        "glosses": [
                            "een mes dat dient om dieren te doden voor het vlees of als offer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d42f4d09-97b1-4458-98c3-ec1e89525666",
                                "sense_id": "b3577a45-b17d-362e-8a69-453dc1ff1109",
                                "text": "Capcom vond deze stunt echter niet mee zo gepast omdat op woensdag een militair in het zuiden van de Britse hoofdstad Londen bruut werd vermoord door twee terroristen. Hierbij gebruikten zij slachtmessen, wat een bloederig tafereel opleverde."
                            },
                            {
                                "example_id": "8d348bea-9ded-4106-bcee-c4569534357c",
                                "sense_id": "b3577a45-b17d-362e-8a69-453dc1ff1109",
                                "text": "De 36-jarige J. B. uit Haaksbergen wordt niet verder vervolgd door justitie. De man was gedaagd omdat hij 17 juni 2009 in het huis van zijn ouders aan de Mozartstraat zijn broer met een slachtmes te lijf was gegaan. Dat er gevochten was, gaf de man toe. Maar hij zou daarbij geen mes aangeraakt hebben."
                            }
                        ]
                    }
