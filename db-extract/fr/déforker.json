                ],
                "senses": [
                    {
                        "sense_id": "d6ece2f4-ad22-31cc-9347-e0a8cbaee8f2",
                        "entry_id": "e59a53ce-83dc-3542-b6ca-a08913347238",
                        "glosses": [
                            "Réunir deux projets qui avait été auparavant forkés, séparés en deux."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "eaebb295-d223-4591-aff6-6e1e2a83fd0c",
                                "sense_id": "d6ece2f4-ad22-31cc-9347-e0a8cbaee8f2",
                                "text": "Bien sûr on peut baser nos mises à jour sur une analyse de la base plutôt que sur un numéro de version. Ca permettrait de forker/déforker plus librement."
                            },
                            {
                                "example_id": "ff8a6767-6319-4e51-af99-aa9573cd9bee",
                                "sense_id": "d6ece2f4-ad22-31cc-9347-e0a8cbaee8f2",
                                "text": "Ou rejoindre Fedora (déforker de RedHat donc ! si l'on accepte ce néologisme puisque Mandrake était au départ un Fork de RedHat intégrant KDE ) et proposer l'utilisation du CCM qui est libre et plus convivial que les outils de Fedora (un CCF !)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48bb597f-20d3-4c4e-adf6-a9a8ef0a1d91",
                        "source_entry_id": "e59a53ce-83dc-3542-b6ca-a08913347238",
                        "source_sense_id": "d6ece2f4-ad22-31cc-9347-e0a8cbaee8f2",
                        "target_lang_word": "unfork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec921d20-66ed-3a32-b237-10a67dc5a24c",
                                        "entry_id": "b1132c1d-8570-3ad1-aae1-ee951cda6567",
                                        "glosses": [
                                            "To dismount from (a ridden animal)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f72ad6f-e2d3-48e2-a186-bb5a74120e75",
                                                "sense_id": "ec921d20-66ed-3a32-b237-10a67dc5a24c",
                                                "text": "[…] unfork my horse and get my ass unsprung and just lie around and eat and sleep and let the sun shine on me."
                                            },
                                            {
                                                "example_id": "25e8d11b-3554-437f-bcf7-9b18d129c7ca",
                                                "sense_id": "ec921d20-66ed-3a32-b237-10a67dc5a24c",
                                                "text": "\"I wouldn't unfork that horse yet, pilgrim. I want a good look at ya first.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
