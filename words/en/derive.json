{
    "word_family": [
        "derivation",
        "derivative",
        "derivable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b2274cf-c98e-31f0-b830-15afe40895fd",
                    "sense_definition": "To obtain or receive something, such as a benefit or quality, from a specific source.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "obtaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>derive</w> great pleasure from gardening during the spring months.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>получают</w> огромное удовольствие от садоводства в весенние месяцы."
                            }
                        },
                        {
                            "text": "It is possible to <w>derive</w> satisfaction from a job well done even if it was difficult.",
                            "target_lang_translations": {
                                "ru": "Можно <w>извлечь</w> удовлетворение от хорошо выполненной работы, даже если она была трудной."
                            }
                        }
                    ],
                    "synonyms": [
                        "get",
                        "obtain",
                        "acquire",
                        "gain"
                    ],
                    "common_phrases": [
                        "derive pleasure from",
                        "derive satisfaction from",
                        "derive benefit from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать или извлекать что-либо (например, выгоду или качество) из определенного источника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "удовольствие, выгоду"
                            },
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "пользу, удовлетворение"
                            },
                            {
                                "target_lang_word": "черпать",
                                "target_lang_sense_clarification": "вдохновение, силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4cbc501-5ddb-3263-954c-ec2433f89ddf",
                    "sense_definition": "To have a specified thing as a starting point or source; to originate from.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The English word 'clue' <w>derives</w> from the word 'clew', meaning a ball of thread.",
                            "target_lang_translations": {
                                "ru": "Английское слово «clue» <w>происходит</w> от слова «clew», означающего клубок ниток."
                            }
                        },
                        {
                            "text": "Her excellent organizational skills <w>derive</w> from her time working as a secretary in the army.",
                            "target_lang_translations": {
                                "ru": "Ее отличные организаторские способности <w>берут начало</w> со времен ее работы секретарем в армии."
                            }
                        }
                    ],
                    "synonyms": [
                        "originate",
                        "stem",
                        "spring",
                        "arise"
                    ],
                    "common_phrases": [
                        "derive from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь что-либо в качестве отправной точки или источника; происходить от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "от какого-либо слова или источника"
                            },
                            {
                                "target_lang_word": "берет начало",
                                "target_lang_sense_clarification": "о происхождении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f9d1313-e580-3f6d-a1e2-24875d872293",
                    "sense_definition": "To reach a conclusion or find a result by using logic or reasoning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists were able to <w>derive</w> a new theory based on the data they collected.",
                            "target_lang_translations": {
                                "ru": "Ученые смогли <w>вывести</w> новую теорию на основе собранных ими данных."
                            }
                        },
                        {
                            "text": "From these basic principles, we can <w>derive</w> a conclusion about the behavior of the system.",
                            "target_lang_translations": {
                                "ru": "Из этих основных принципов мы можем <w>сделать</w> вывод о поведении системы."
                            }
                        }
                    ],
                    "synonyms": [
                        "deduce",
                        "infer",
                        "reason"
                    ],
                    "common_phrases": [
                        "derive a conclusion",
                        "derive a formula"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прийти к выводу или получить результат с помощью логики или рассуждений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "формулу, заключение"
                            },
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "логический результат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f600a578-94c3-300e-86f9-a1b6789069d1",
                    "sense_definition": "To trace the linguistic history and development of a word or phrase.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Etymologists try to <w>derive</w> the history of obscure slang terms used in the city.",
                            "target_lang_translations": {
                                "ru": "Этимологи пытаются <w>проследить</w> историю малоизвестных сленговых терминов, используемых в городе."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>derive</w> words that have been borrowed across multiple languages.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>установить происхождение</w> слов, которые были заимствованы несколькими языками."
                            }
                        }
                    ],
                    "synonyms": [
                        "trace"
                    ],
                    "common_phrases": [
                        "derive the etymology"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical linguistic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прослеживать лингвистическую историю и развитие слова или фразы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прослеживать этимологию",
                                "target_lang_sense_clarification": "историю слова"
                            },
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "происхождение слова"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7c4e141-e905-381e-9760-6f2e8a0dd3bd",
                    "sense_definition": "To calculate the derivative of a mathematical function.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In calculus class, students learn how to <w>derive</w> functions to find the rate of change.",
                            "target_lang_translations": {
                                "ru": "На уроках математического анализа студенты учатся <w>дифференцировать</w> функции, чтобы найти скорость изменения."
                            }
                        },
                        {
                            "text": "If you <w>derive</w> the position function with respect to time, you get the velocity.",
                            "target_lang_translations": {
                                "ru": "Если <w>взять производную</w> от функции положения по времени, получится скорость."
                            }
                        }
                    ],
                    "synonyms": [
                        "differentiate"
                    ],
                    "antonyms": [
                        "integrate"
                    ],
                    "common_phrases": [
                        "derive a function"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычислять производную математической функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дифференцировать",
                                "target_lang_sense_clarification": "находить производную"
                            },
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "производную функции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b31aed45-758d-3015-b12b-45dadb1e0b0d",
                    "sense_definition": "To produce a chemical substance from another substance through a chemical reaction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chemists can <w>derive</w> various plastics from petroleum through complex industrial processes.",
                            "target_lang_translations": {
                                "ru": "Химики могут <w>получать</w> различные виды пластика из нефти с помощью сложных промышленных процессов."
                            }
                        },
                        {
                            "text": "The laboratory succeeded in <w>deriving</w> a new compound from the base elements.",
                            "target_lang_translations": {
                                "ru": "Лаборатории удалось <w>синтезировать</w> новое соединение из базовых элементов."
                            }
                        }
                    ],
                    "synonyms": [
                        "extract",
                        "synthesize"
                    ],
                    "common_phrases": [
                        "derive a compound"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать химическое вещество из другого вещества в результате химической реакции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "вещество из сырья"
                            },
                            {
                                "target_lang_word": "вырабатывать",
                                "target_lang_sense_clarification": "путем химического процесса"
                            },
                            {
                                "target_lang_word": "экстрагировать",
                                "target_lang_sense_clarification": "извлекать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5691b8da-9eaa-36b5-b315-68d79b9dfbdc",
                    "sense_definition": "To divert the flow of water or a liquid into a different channel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "diversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient engineers built canals to <w>derive</w> water from the river to the fields.",
                            "target_lang_translations": {
                                "ru": "Древние инженеры строили каналы, чтобы <w>отводить</w> воду из реки на поля."
                            }
                        },
                        {
                            "text": "They had to <w>derive</w> the stream through a pipe to prevent the construction site from flooding.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>направить</w> поток через трубу, чтобы предотвратить затопление строительной площадки."
                            }
                        }
                    ],
                    "synonyms": [
                        "divert",
                        "channel",
                        "redirect"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English for physical liquids"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отводить поток воды или жидкости в другое русло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "поток воды"
                            },
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "жидкость в канал"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}