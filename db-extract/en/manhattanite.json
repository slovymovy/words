                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a202d0eb-f785-4d10-a3b5-50a2c307d23f",
                                "sense_id": "dcf2740b-7d9f-38b6-a8fb-5a7a4b56ed2e",
                                "text": "Walter Gaskell was a tall, silver-haired Manhattanite with a narrow waist and broad shoulders, and his blue eyes had the luminous, emptied-out look of a reformed alcoholic's."
                            },
                            {
                                "example_id": "c86816b8-3019-4d9d-a786-739d8cba4eb9",
                                "sense_id": "dcf2740b-7d9f-38b6-a8fb-5a7a4b56ed2e",
                                "text": "The most likely explanation is that Cage imagined Peter as a fop of the first order, the type of ivory-tower Manhattanite whose exalted sense of privilege naturally leads to a hilariously affected manner of speech."
                            }
                        ]
                    }
                ],
