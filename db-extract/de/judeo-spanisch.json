                                        "sense_id": "c510e104-027e-3ae8-bcbd-ebc2fa1c125d",
                                        "entry_id": "2916c046-f38a-3fee-8184-3d99cc4da283",
                                        "glosses": [
                                            "A Romance language, based on Old Spanish, and spoken almost exclusively by Sephardic Jews in Greece and Turkey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cec4310d-0b3a-4ac0-a09d-f376d2a0365d",
                                                "sense_id": "c510e104-027e-3ae8-bcbd-ebc2fa1c125d",
                                                "text": "Although like most American-born children of immigrants they had failed to develop a fluent use of the mother tongue, both had heard Judaeo-Spanish all their lives and had entirely native habits of pronouncing it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
