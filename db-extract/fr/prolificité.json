                ],
                "senses": [
                    {
                        "sense_id": "8e4d3411-dc17-3696-a2a1-9819389428ee",
                        "entry_id": "371d73fd-1997-3b07-841c-6e14fd30676a",
                        "glosses": [
                            "Fécondité d'une espèce animale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "409e3c09-d527-434d-8b6f-a2d66a1a1ffc",
                                "sense_id": "8e4d3411-dc17-3696-a2a1-9819389428ee",
                                "text": "Du point de vue de la dynamique de population, l’accroissement des populations de sangliers a été de plus démultiplié par l’exceptionnelle prolificité de l’espèce (en moyenne 4 à 5 marcassins par portée, souvent plus), et par sa capacité d’adaptation à tous les types de milieux, lui permettant d’envahir toutes les régions françaises potentiellement colonisables, des zones périurbaines à la haute montagne."
                            },
                            {
                                "example_id": "03df0e68-4da4-4c01-850d-331367736d54",
                                "sense_id": "8e4d3411-dc17-3696-a2a1-9819389428ee",
                                "text": "Elle essaime peu naturellement, mais sa très grande prolificité permet aux apiculteurs spécialisés de produire des paquets d’abeilles par essaimage artificiel."
                            }
                        ]
                    },
                    {
                        "sense_id": "13796840-08b5-39bc-9a97-e8851d0ead66",
                        "entry_id": "371d73fd-1997-3b07-841c-6e14fd30676a",
                        "glosses": [
                            "En technique d'élevage, le taux de prolificité est le rapport du nombre de petits nés au nombre de mises bas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e96ab21-0947-461b-ae70-9b19f0946463",
                                "sense_id": "13796840-08b5-39bc-9a97-e8851d0ead66",
                                "text": "Le taux de prolificité des ovins du Lubéron est de 119%"
                            }
                        ]
                    }
                ],
