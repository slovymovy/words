                "senses": [
                    {
                        "sense_id": "b2cdb01e-d03d-32c9-a873-f3225ede7e68",
                        "entry_id": "541791ae-ecc2-3419-9c33-d136460f8d06",
                        "glosses": [
                            "schlauer Mensch"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4e1cd1b4-b41e-4be2-8187-092159e175ef",
                                "sense_id": "b2cdb01e-d03d-32c9-a873-f3225ede7e68",
                                "text": "„Erik konnte nicht streng sein, aber er war ein Pfiffikus.“"
                            },
                            {
                                "example_id": "2c257774-23db-4c68-b70a-de8abaf7136b",
                                "sense_id": "b2cdb01e-d03d-32c9-a873-f3225ede7e68",
                                "text": "Wenn es etwas gibt, das ein Pfiffikus gut kann, dann ist es, schlau und listig zu sein."
                            },
                            {
                                "example_id": "7ec0dea1-1e33-406a-9adf-967f760975f1",
                                "sense_id": "b2cdb01e-d03d-32c9-a873-f3225ede7e68",
                                "text": "Hier wie dort, bei Grass wie bei Bauerdick, trägt ein junger Pfiffikus die Romanhandlung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
