                        "cross_references": [
                            {
                                "target_word": "burst",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db8bb1bf-fb36-32e3-ba46-068d34b1bcf9",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To break from internal pressure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51905ed5-734b-4409-9d60-3abd7d2e98f8",
                                                "sense_id": "db8bb1bf-fb36-32e3-ba46-068d34b1bcf9",
                                                "text": "I blew the balloon up too much, and it burst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5807d835-f226-3bcf-bf92-a16cf99e3bea",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To cause to break from internal pressure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "503cff1c-c9e1-4ab4-8115-f38b471394fd",
                                                "sense_id": "5807d835-f226-3bcf-bf92-a16cf99e3bea",
                                                "text": "I burst the balloon when I blew it up too much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e3e64a-1c39-38e1-aed3-f4eb5da26000",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To cause to break by any means."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c179824-e5e4-49f7-89dc-e85f8c3689ac",
                                                "sense_id": "52e3e64a-1c39-38e1-aed3-f4eb5da26000",
                                                "text": "You will not pay for the glasses you have burst?"
                                            },
                                            {
                                                "example_id": "757bb6e3-1b1b-4677-9f6f-83b389d787d7",
                                                "sense_id": "52e3e64a-1c39-38e1-aed3-f4eb5da26000",
                                                "text": "He burst his lance against the sand below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f0073d-d104-313a-80b9-d1f934893928",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To separate (printer paper) at perforation lines."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "320c3406-dd49-49d2-a3ef-2283cd2d40bd",
                                                "sense_id": "f2f0073d-d104-313a-80b9-d1f934893928",
                                                "text": "I printed the report on form-feed paper, then burst the sheets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f22895-4d9c-3ca2-b849-d11163f217a6",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To enter or exit hurriedly and unexpectedly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d66e87-fc66-4ed6-a8f3-4c0c95fec0c2",
                                                "sense_id": "54f22895-4d9c-3ca2-b849-d11163f217a6",
                                                "text": "1913, Mariano Azuela, The Underdogs, translated by E. MunguÍa, Jr.\nLike hungry dogs who have sniffed their meat, the mob bursts in, trampling down the women who sought to bar the entrance with their bodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89e9495-30fe-35c4-b8a7-f0dd5650be97",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To erupt; to change state suddenly as if bursting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba3132c-eea7-4b3b-9700-b90c4c98d7ca",
                                                "sense_id": "e89e9495-30fe-35c4-b8a7-f0dd5650be97",
                                                "text": "The flowers burst into bloom on the first day of spring."
                                            },
                                            {
                                                "example_id": "50b22213-f16b-4e59-a378-efb9bcb6e7be",
                                                "sense_id": "e89e9495-30fe-35c4-b8a7-f0dd5650be97",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”. […]’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51d7969-56af-39b7-b25e-3ab845aa58ef",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To produce as an effect of bursting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9532b64-6c0b-432c-ba9c-9e4a9ceed2a0",
                                                "sense_id": "d51d7969-56af-39b7-b25e-3ab845aa58ef",
                                                "text": "to burst a hole through the wall"
                                            },
                                            {
                                                "example_id": "5796ddf3-148e-49e4-975c-c51a92053741",
                                                "sense_id": "d51d7969-56af-39b7-b25e-3ab845aa58ef",
                                                "text": "1856, Eleanor Marx-Aveling (translator), Gustave Flaubert, Madame Bovary, Part III Chapter X\nHe entered Maromme shouting for the people of the inn, burst open the door with a thrust of his shoulder, made for a sack of oats, emptied a bottle of sweet cider into the manger, and again mounted his nag, whose feet struck fire as it dashed along."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d753be4b-eb4e-3bd8-b7d2-f7aa3e298396",
                                        "entry_id": "5c0d2ade-4764-3678-a1fd-56a753c71c56",
                                        "glosses": [
                                            "To interrupt suddenly in a violent or explosive manner; to shatter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d553e226-f164-477d-a830-80f159d03715",
                                                "sense_id": "d753be4b-eb4e-3bd8-b7d2-f7aa3e298396",
                                                "text": "The sharp report of a gun burst the silence, and a moment later the gate swung open."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burst",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab31fab7-69c9-35a8-adc5-16b87e809af0",
                                        "entry_id": "4770d0b7-98b6-3955-9236-26771c253b49",
                                        "glosses": [
                                            "An act or instance of bursting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8853bb3-a8d1-44a7-b979-35bcfa3d7a61",
                                                "sense_id": "ab31fab7-69c9-35a8-adc5-16b87e809af0",
                                                "text": "The bursts of the bombs could be heard miles away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8e495c-30cb-3225-aeda-fedbcabce527",
                                        "entry_id": "4770d0b7-98b6-3955-9236-26771c253b49",
                                        "glosses": [
                                            "A sudden, often intense, expression, manifestation or display."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac27e3c3-4985-4778-abd0-aa2dd33ba465",
                                                "sense_id": "1b8e495c-30cb-3225-aeda-fedbcabce527",
                                                "text": "I read it in two bursts."
                                            },
                                            {
                                                "example_id": "94e41b3a-a538-4dd3-9871-6e0ac3d5bbcd",
                                                "sense_id": "1b8e495c-30cb-3225-aeda-fedbcabce527",
                                                "text": "\"It's my wedding-day,\" cried Biddy, in a burst of happiness, \"and I am married to Joe!\""
                                            },
                                            {
                                                "example_id": "4d30072f-b915-42b3-aa47-36dc6df4e51e",
                                                "sense_id": "1b8e495c-30cb-3225-aeda-fedbcabce527",
                                                "text": "[…] and only at Barnet did Tappin give Empire of India a burst to bring us up to the 60 m.p.h. speed ceiling of the London area."
                                            },
                                            {
                                                "example_id": "4b45257b-0fdd-4f34-9aa2-8d5f79dddaeb",
                                                "sense_id": "1b8e495c-30cb-3225-aeda-fedbcabce527",
                                                "text": "It was tragic, all right, but George and Hazel couldn't think about it very hard. Hazel had a perfectly average intelligence, which meant she couldn't think about anything except in short bursts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8b47f4-e990-3b6f-b321-178489dee2b6",
                                        "entry_id": "4770d0b7-98b6-3955-9236-26771c253b49",
                                        "glosses": [
                                            "A series of shots fired from an automatic firearm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6510422c-22c0-3615-a724-015d0a6e00bb",
                                        "entry_id": "4770d0b7-98b6-3955-9236-26771c253b49",
                                        "glosses": [
                                            "The explosion of a bomb or missile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
