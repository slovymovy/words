                                        "examples": [
                                            {
                                                "example_id": "83f76460-c679-47fb-b1e6-2da307ea04fd",
                                                "sense_id": "e9bb763e-cc46-3289-9583-e1c9c2053424",
                                                "text": "John Allen Paulos and others have asked our society to consider numeracy and innumeracy in a way closer to how we view literacy and illiteracy."
                                            },
                                            {
                                                "example_id": "96842cdc-4420-4e2a-8f8d-f8c6777c9725",
                                                "sense_id": "e9bb763e-cc46-3289-9583-e1c9c2053424",
                                                "text": "The man suffered from innumeracy stemming from a brain injury, and depended on his wife for all financial matters, no matter how trivial."
                                            }
