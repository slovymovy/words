                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3c886abc-1715-48e4-b073-970b01ddf120",
                        "entry_id": "546469e1-a380-30a0-9a74-e5874c6d78ed",
                        "tags": [
                            "plural"
