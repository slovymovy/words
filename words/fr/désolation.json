    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "907cf4d9-6d61-3644-b0d6-001fb95d9e1a",
                    "sense_definition": "État d'un lieu ruiné, dévasté ou rendu stérile par un fléau, une guerre ou une catastrophe naturelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ravage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le passage de l'ouragan, les habitants ont découvert une effroyable scène de <w>désolation</w>."
                        },
                        {
                            "text": "Ce violent tremblement de terre a laissé derrière lui un paysage de <w>désolation</w> et de ruines."
                        }
                    ],
                    "synonyms": [
                        "dévastation",
                        "ruine",
                        "ravage"
                    ],
                    "antonyms": [
                        "prospérité"
                    ],
                    "common_phrases": [
                        "paysage de désolation",
                        "scène de désolation"
                    ]
                },
                {
                    "sense_id": "37f5f905-9773-3454-8a4a-96d0893ea924",
                    "sense_definition": "Sentiment de profond abattement, de grande détresse morale ou de douleur immense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La disparition soudaine de son ami d'enfance l'a plongé dans une profonde <w>désolation</w>."
                        },
                        {
                            "text": "Elle a appris la mauvaise nouvelle avec une indicible <w>désolation</w> qui a ému tout le monde."
                        }
                    ],
                    "synonyms": [
                        "affliction",
                        "détresse",
                        "abattement"
                    ],
                    "antonyms": [
                        "joie",
                        "consolation"
                    ],
                    "common_phrases": [
                        "profonde désolation",
                        "grande désolation"
                    ]
                },
                {
                    "sense_id": "4f6f723f-91c4-3988-9ae0-4b5a8ee6d2d8",
                    "sense_definition": "Motif de vive contrariété, d'ennui ou de désagrément persistant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce mauvais temps continuel fait la <w>désolation</w> des commerçants de la station balnéaire."
                        },
                        {
                            "text": "Le retard régulier des trains était la <w>désolation</w> quotidienne de tous les usagers de la ligne."
                        }
                    ],
                    "synonyms": [
                        "contrariété",
                        "ennui"
                    ],
                    "antonyms": [
                        "satisfaction"
                    ],
                    "common_phrases": [
                        "faire la désolation"
                    ]
                }
            ]
        }
    ]
