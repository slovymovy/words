                ],
                "senses": [
                    {
                        "sense_id": "4073f070-1030-3b9d-8dc4-85fb9b0c2942",
                        "entry_id": "fe266276-c1e4-37d1-b0d9-ab7fe4ddaac0",
                        "glosses": [
                            "Faire perdre son caractère affûté à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4525140f-6254-494e-9ce8-fe15ea7c424e",
                                "sense_id": "4073f070-1030-3b9d-8dc4-85fb9b0c2942",
                                "text": "Désaffuter le talon et la spatule, c'est pas plutôt pour avoir un ski plus tolérant en virages dérapés ?"
                            },
                            {
                                "example_id": "c30010ef-aa01-4f5c-9f21-6ee8443142fc",
                                "sense_id": "4073f070-1030-3b9d-8dc4-85fb9b0c2942",
                                "text": "J'ai commencé avec un Bokken, et là pour les fêtes, je me suis acheté un Iaito, ou plutot un Katana que j'ai fait désaffuter."
                            },
                            {
                                "example_id": "5cea5823-496e-498e-ae10-3e0e90496148",
                                "sense_id": "4073f070-1030-3b9d-8dc4-85fb9b0c2942",
                                "text": "N'hésite pas à désaffuter largement les spatules pour le rendre maîtrisable."
                            }
                        ]
                    }
