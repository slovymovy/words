                                        "sense_id": "321970a9-558d-36dc-ba01-c9214ec699a9",
                                        "entry_id": "38937784-cf40-33c5-b691-bad8bd8c1cde",
                                        "glosses": [
                                            "The slaying of a human being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244ad803-4c5d-4c6f-abae-603ddda892c2",
                                                "sense_id": "321970a9-558d-36dc-ba01-c9214ec699a9",
                                                "text": "For that cause We decreed for the Children of Israel that whosoever killeth a human being for other than manslaughter or corruption in the earth, it shall be as if he had killed all mankind, and whoso saveth the life of one, it shall be as if he had saved the life of all mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c9be59-f1da-3c4b-90c7-880293d525dc",
                                        "entry_id": "38937784-cf40-33c5-b691-bad8bd8c1cde",
                                        "glosses": [
                                            "The unlawful killing of a human, either in negligence or incidentally to the commission of some unlawful act, but without specific malice, or upon a sudden excitement of anger; considered less culpable than murder, but more culpable than justifiable homicide."
                                        ],
                                        "tags": [
                                            "countable",
