                "senses": [
                    {
                        "sense_id": "2adfa202-1f44-36fc-b040-0a3bc139bdb0",
                        "entry_id": "7f3ccfb9-5ccd-3297-b5cb-b4b6b71f20d0",
                        "glosses": [
                            "Extrêmement conservateur, qui est très conservateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce04575-2b32-44cb-a1ca-e6888c265053",
                                "sense_id": "2adfa202-1f44-36fc-b040-0a3bc139bdb0",
                                "text": "Ce Conseil a été créé à la suite d’une réforme des modalités de succession introduite en 2006 pour assurer une transition pacifique du pouvoir dans cette monarchie ultraconservatrice du Golfe."
                            },
                            {
                                "example_id": "77d937f4-22fa-41ce-a4c2-b2b4672ffb64",
                                "sense_id": "2adfa202-1f44-36fc-b040-0a3bc139bdb0",
                                "text": "Antonfrancesco Vivarelli Colonna, maire de Grosseto, en Italie, soutenu par la coalition ultraconservatrice au pouvoir va donner à deux rues de sa commune le nom d’un responsable fasciste et celui d’un dirigeant communiste au nom de la « pacification nationale »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73196925-eee8-49fa-9e86-24e7fae779d5",
                        "source_entry_id": "7f3ccfb9-5ccd-3297-b5cb-b4b6b71f20d0",
                        "source_sense_id": "2adfa202-1f44-36fc-b040-0a3bc139bdb0",
                        "target_lang_word": "ultraconservative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraconservative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3a59940-d9db-3242-9553-87521ff9cc25",
                                        "entry_id": "d7e0fa4a-e590-3e61-92c5-70754e35cccb",
                                        "glosses": [
                                            "Extremely conservative, especially in politics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f0db8db-f13a-48f7-83f8-0048394e9b56",
                                                "sense_id": "e3a59940-d9db-3242-9553-87521ff9cc25",
                                                "text": "The John Birch Society is an ultraconservative political group in the USA."
                                            },
                                            {
                                                "example_id": "2fe09023-2fa5-4509-8b77-560730941463",
                                                "sense_id": "e3a59940-d9db-3242-9553-87521ff9cc25",
                                                "text": "Since his reelection in November, Trump has successfully talked ultraconservative House Republicans into backing a number of difficult votes on spending."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ultraconservative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aad76c0-f2e8-3304-8c27-57e04d331207",
                                        "entry_id": "28b6f976-acdc-36a6-830d-b7ae7c6b752f",
                                        "glosses": [
                                            "A person or group with extremely conservative views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2dadfd-555e-4173-8a5e-51041941e497",
                                                "sense_id": "2aad76c0-f2e8-3304-8c27-57e04d331207",
                                                "text": "For example, as pope, Francis challenges the ultraconservatives in the Church to be ultrainclusive of people whom other popes never bothered to embrace: […]"
                                            },
                                            {
                                                "example_id": "358b1ebb-225e-42c3-8577-acf3e916bd6e",
                                                "sense_id": "2aad76c0-f2e8-3304-8c27-57e04d331207",
                                                "text": "House GOP leaders believe the plan is on track to pass the chamber, arguing that Trump’s backing will help them win robust support among House Republicans on the floor this week, even as many ultraconservatives typically loathe such stopgap measures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
