{
    "word_family": [
        "bulletproof"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a1fc07b-7e6c-32f3-859d-e1ef0b6403eb",
                    "sense_definition": "A small metal projectile shot from a gun at high speed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer found a <w>bullet</w> lodged in the wall.",
                            "target_lang_translations": {
                                "ru": "Полицейский обнаружил <w>пулю</w>, застрявшую в стене.",
                                "zh": "警察发现墙里嵌着一颗<w>子弹</w>。"
                            }
                        },
                        {
                            "text": "He was lucky to survive after being hit by a stray <w>bullet</w>.",
                            "target_lang_translations": {
                                "ru": "Ему повезло выжить после попадания шальной <w>пули</w>.",
                                "zh": "他很幸运，被流弹击中后幸存了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slug"
                    ],
                    "common_phrases": [
                        "stray bullet",
                        "rubber bullet",
                        "silver bullet",
                        "bite the bullet",
                        "dodge a bullet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой металлический снаряд, выпускаемый из огнестрельного оружия с высокой скоростью.",
                        "zh": "从枪支中高速射出的小型金属弹丸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуля",
                                "target_lang_sense_clarification": "снаряд стрелкового оружия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "子弹",
                                "target_lang_sense_clarification": "枪支射出的弹丸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1422d3a7-9be6-3961-b92d-6bb34e432563",
                    "sense_definition": "A printed symbol, usually a solid circle, used to mark items in a list.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a <w>bullet</w> for each new item on the agenda.",
                            "target_lang_translations": {
                                "ru": "Используйте <w>маркер</w> для каждого нового пункта повестки дня.",
                                "zh": "议程中的每一项新内容都要用<w>项目符号</w>标记。"
                            }
                        },
                        {
                            "text": "The presentation slide was full of text instead of concise <w>bullets</w>.",
                            "target_lang_translations": {
                                "ru": "Слайд презентации был полон текста вместо кратких <w>пунктов</w>.",
                                "zh": "演示文稿的幻灯片上全是文字，而不是简洁的<w>项目符号</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bullet point",
                        "dot",
                        "marker"
                    ],
                    "common_phrases": [
                        "bullet list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Печатный символ, обычно жирная точка, используемый для выделения пунктов в списке.",
                        "zh": "一种印刷符号，通常为实心圆点，用于标记列表中的项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркер списка",
                                "target_lang_sense_clarification": "типографский знак"
                            },
                            {
                                "target_lang_word": "буллит",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "项目符号",
                                "target_lang_sense_clarification": "排版中的标记符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7caf3b07-cbd9-377d-bc62-5502679b8e2a",
                    "sense_definition": "Used attributively to describe something that moves at extremely high speed, especially a train.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took the <w>bullet</w> train from Tokyo to Kyoto.",
                            "target_lang_translations": {
                                "ru": "Мы сели на <w>скоростной</w> поезд из Токио в Киото.",
                                "zh": "我们乘坐<w>高速</w>列车从东京前往京都。"
                            }
                        },
                        {
                            "text": "The new <w>bullet</w> service cuts travel time in half.",
                            "target_lang_translations": {
                                "ru": "Новый <w>сверхскоростной</w> маршрут сокращает время в пути вдвое.",
                                "zh": "这项新的<w>高速</w>服务将旅行时间缩短了一半。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bullet train"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как определение для описания чего-либо, движущегося с чрезвычайно высокой скоростью, особенно поезда.",
                        "zh": "用作定语，形容移动速度极快的事物，尤指火车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скоростной",
                                "target_lang_sense_clarification": "о транспорте"
                            },
                            {
                                "target_lang_word": "сверхскоростной",
                                "target_lang_sense_clarification": "очень быстрый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高速",
                                "target_lang_sense_clarification": "形容交通工具速度快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adb0718f-02f2-3128-b3e6-eefb09f22e9c",
                    "sense_definition": "A complete unit of ammunition consisting of a casing, primer, powder, and projectile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loaded a single <w>bullet</w> into the chamber of the rifle.",
                            "target_lang_translations": {
                                "ru": "Он зарядил один <w>патрон</w> в патронник винтовки.",
                                "zh": "他往步枪弹膛里装了一发<w>子弹</w>。"
                            }
                        },
                        {
                            "text": "The soldier checked his magazine to ensure he had enough <w>bullets</w>.",
                            "target_lang_translations": {
                                "ru": "Солдат проверил магазин, чтобы убедиться, что у него достаточно <w>патронов</w>.",
                                "zh": "士兵检查了弹匣，确保有足够的<w>子弹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "live bullet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица боеприпасов, состоящая из гильзы, капсюля, пороха и снаряда.",
                        "zh": "由弹壳、底火、火药和弹头组成的完整弹药单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патрон",
                                "target_lang_sense_clarification": "боеприпас в сборе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "子弹",
                                "target_lang_sense_clarification": "完整的弹药单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15ee7fef-e8bb-3012-b775-ec1f3b0b5543",
                    "sense_definition": "To mark items in a text with a bullet symbol to create a list.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>bulleted</w> the key objectives to make them stand out.",
                            "target_lang_translations": {
                                "ru": "Она <w>отметила маркерами</w> ключевые цели, чтобы выделить их.",
                                "zh": "她为关键目标<w>加了项目符号</w>，使其更加突出。"
                            }
                        },
                        {
                            "text": "The report was easier to read because the author had <w>bulleted</w> the main points.",
                            "target_lang_translations": {
                                "ru": "Отчет было легче читать, потому что автор <w>промаркировал</w> основные пункты.",
                                "zh": "这份报告更容易阅读，因为作者为要点<w>加了项目符号</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bulleted list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отмечать пункты в тексте символом-маркером для создания списка.",
                        "zh": "在文本中用项目符号标记项目以创建列表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркировать",
                                "target_lang_sense_clarification": "создавать список"
                            },
                            {
                                "target_lang_word": "выделять маркерами",
                                "target_lang_sense_clarification": "оформление текста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加项目符号",
                                "target_lang_sense_clarification": "排版动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87a03863-7e79-3616-ad18-896e5d6165d0",
                    "sense_definition": "To move or travel at great speed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>bulleted</w> down the highway, weaving through traffic.",
                            "target_lang_translations": {
                                "ru": "Машина <w>пулей неслась</w> по шоссе, лавируя в потоке.",
                                "zh": "汽车在公路上<w>飞驰</w>，在车流中穿梭。"
                            }
                        },
                        {
                            "text": "He <w>bulleted</w> a pass to his teammate near the goal.",
                            "target_lang_translations": {
                                "ru": "Он <w>пулей послал</w> пас своему товарищу по команде у ворот.",
                                "zh": "他<w>疾驰</w>着将球传给了球门附近的队友。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или перемещаться с огромной скоростью.",
                        "zh": "以极高的速度移动或行进。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "быстро двигаться"
                            },
                            {
                                "target_lang_word": "проноситься",
                                "target_lang_sense_clarification": "быстро проезжать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飞驰",
                                "target_lang_sense_clarification": "形容速度极快"
                            },
                            {
                                "target_lang_word": "疾驰",
                                "target_lang_sense_clarification": "形容快速移动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}