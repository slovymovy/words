{
    "word_family": [
        "knuckled",
        "knuckling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e7fa7ab-db47-323b-b997-07f9701cb270",
                    "sense_definition": "Any of the joints between the bones of the fingers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She cracked her <w>knuckles</w> before starting to type.",
                            "target_lang_translations": {
                                "zh": "她在开始打字前先<w>掰</w>了掰指关节。"
                            }
                        },
                        {
                            "text": "He hit the table with his <w>knuckles</w> to get everyone's attention.",
                            "target_lang_translations": {
                                "zh": "他用<w>指关节</w>敲了敲桌子以引起大家的注意。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cracked knuckles",
                        "white knuckles"
                    ],
                    "target_lang_definitions": {
                        "zh": "手指骨之间的关节。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "指关节",
                                "target_lang_sense_clarification": "指手指的关节部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "375817d8-4e6c-3849-8077-3d3008ca8927",
                    "sense_definition": "A cut of meat from the knee joint of an animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef slow-cooked the pork <w>knuckle</w> for several hours.",
                            "target_lang_translations": {
                                "zh": "厨师将<w>蹄髈</w>慢炖了几个小时。"
                            }
                        },
                        {
                            "text": "A traditional dish often features a roasted <w>knuckle</w> served with cabbage.",
                            "target_lang_translations": {
                                "zh": "一道传统菜肴通常以烤<w>肘子</w>配卷心菜为特色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pork knuckle",
                        "beef knuckle"
                    ],
                    "target_lang_definitions": {
                        "zh": "动物膝关节部位的肉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蹄髈",
                                "target_lang_sense_clarification": "指猪等动物的腿部关节肉"
                            },
                            {
                                "target_lang_word": "肘子",
                                "target_lang_sense_clarification": "指猪腿部的肉，常用于烹饪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2d9b3bc-5e75-3759-8bda-9b69c3d3a1a7",
                    "sense_definition": "A metal device worn over the fingers to increase the force of a punch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found a pair of brass <w>knuckles</w> in his jacket pocket.",
                            "target_lang_translations": {
                                "zh": "警察在他的夹克口袋里发现了一副<w>指节铜套</w>。"
                            }
                        },
                        {
                            "text": "Carrying <w>knuckles</w> is illegal in many jurisdictions due to their potential for harm.",
                            "target_lang_translations": {
                                "zh": "由于具有潜在的伤害性，在许多司法管辖区携带<w>指节铜套</w>是违法的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brass knuckles"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种戴在手指上以增加拳头打击力的金属武器。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "指节铜套",
                                "target_lang_sense_clarification": "一种金属制的格斗武器"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ddae966-b8f8-39dc-9d15-4e017f4f73ef",
                    "sense_definition": "To give in or submit to authority or pressure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They refused to <w>knuckle</w> under to the unfair demands of the management.",
                            "target_lang_translations": {
                                "zh": "他们拒绝向管理层的不公平要求<w>屈服</w>。"
                            }
                        },
                        {
                            "text": "Eventually, the opposition had to <w>knuckle</w> under and accept the new terms.",
                            "target_lang_translations": {
                                "zh": "最终，反对派不得不<w>低头</w>并接受了新条款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knuckle under"
                    ],
                    "common_phrases": [
                        "knuckle under"
                    ],
                    "target_lang_definitions": {
                        "zh": "屈服或顺从权威或压力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屈服",
                                "target_lang_sense_clarification": "指在压力下妥协"
                            },
                            {
                                "target_lang_word": "低头",
                                "target_lang_sense_clarification": "比喻顺从或妥协"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f2560c4-7e6e-32ad-80bc-97f12c4391ff",
                    "sense_definition": "To rub or press something using one's knuckles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>knuckled</w> his eyes to clear away the sleepiness.",
                            "target_lang_translations": {
                                "zh": "他<w>揉</w>了揉眼睛以驱散睡意。"
                            }
                        },
                        {
                            "text": "She <w>knuckled</w> the sore spot on her shoulder to relieve the tension.",
                            "target_lang_translations": {
                                "zh": "她<w>揉</w>了揉肩膀上的酸痛处以缓解紧张感。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用指关节揉搓或按压某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "揉",
                                "target_lang_sense_clarification": "用指关节按压或摩擦"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}