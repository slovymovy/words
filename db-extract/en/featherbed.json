                "senses": [
                    {
                        "sense_id": "dc0d81a2-65dc-3b48-bce1-f14fa27537a8",
                        "entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                        "glosses": [
                            "A mattress stuffed with feathers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                        "entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                        "glosses": [
                            "An area of bog where a layer of moss covers a pool of water or mud, presenting a hazard to walkers who may fall through it. (Also in UK and Irish placenames.)"
                        ],
                        "tags": [
                            "UK",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5c4db97f-b3ff-4f9d-859a-2f0b3b9735ab",
                                "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                                "text": "There are mires, bogs, and 'featherbeds' or quaking bogs. With the first two, look for the tussocks of heavy grass or rushes around the edges, which offer a relatively firm footing, but if you see a stretch of bright green sphagnum moss, for God's sake stay away from it. The moss is a mat covering a pit of wet ooze; […]"
                            },
                            {
                                "example_id": "fb08ec2a-19c5-4b47-9502-48c410155187",
                                "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                                "text": "[…] bog. The writers and the old fellows you meet in pubs will tell you to look out for grass or 'bright green areas', and to fear the land that looks the easiest; but bogs - 'featherbeds', the locals call them - might be marked[…]"
                            },
                            {
                                "example_id": "3ee930ba-bf05-43ad-9a1c-3a6413c8535d",
                                "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                                "text": "[...] a featherbed bog of moss and cotton grasses. Much of their effort has just burned away to nothing — the peat giving[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7ecf8132-3c4b-3beb-8002-3892d98ad642",
                        "entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                        "glosses": [
                            "A soft, slow pitch of predictable bounce."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1139243-979b-4f6d-95f8-4b489b6596f9",
                        "source_entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                        "source_sense_description": "a mattress stuffed with feathers",
                        "target_lang_word": "Federbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Federbett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37f0743b-da56-3ac1-8671-9ade34c592a8",
                                        "entry_id": "0937ca85-14c4-3b29-94d5-a294b1b53421",
                                        "glosses": [
                                            "Bettdecke, die mit Federn gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7cc854f-03cc-4040-b5d5-359e470f4e49",
                                                "sense_id": "37f0743b-da56-3ac1-8671-9ade34c592a8",
                                                "text": "„Menschen, die auf Milben allergisch reagieren, sollten sich im Schlafbereich für ein Federbett für Allergiker entscheiden, um damit ruhige Nächte zu haben.“"
                                            },
                                            {
                                                "example_id": "b730f627-50d2-48a6-a980-65dff3c794b4",
                                                "sense_id": "37f0743b-da56-3ac1-8671-9ade34c592a8",
                                                "text": "„Die Bäuerin bringt uns sogar Federbetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e196d16f-10c4-4901-a11c-3d2e015165b4",
                        "source_entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                        "source_sense_description": "a mattress stuffed with feathers",
                        "target_lang_word": "materac wypełniony pierzem",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "907b3aa3-a149-42a9-a498-846a14b7b962",
                        "source_entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                        "source_sense_description": "a mattress stuffed with feathers",
                        "target_lang_word": "пери́на",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пери́на",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fae91b74-d31d-332f-9251-bdad36624d5d",
                                        "entry_id": "0ab8a617-14af-3d79-b646-2a90d70a7f18",
                                        "glosses": [
                                            "набитый пухом или пером продолговатый мешок, который кладётся на кровать в качестве мягкой подстилки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d21030e0-cd76-4fa2-995e-7463e401b9bf",
                                                "sense_id": "fae91b74-d31d-332f-9251-bdad36624d5d",
                                                "text": "Она побелела, пополнела; руки у ней под кисейными рукавами стали «крупичатые», как у купчихи; самовар не сходил со стола; кроме шелку да бархату, она ничего носить не хотела, спала на пуховых перинах."
                                            },
                                            {
                                                "example_id": "66f6644d-4e8c-4a4e-9e56-b6c90f46c4a6",
                                                "sense_id": "fae91b74-d31d-332f-9251-bdad36624d5d",
                                                "text": "На полу разостлан белый холст, а стены гладко выструганы; горница разделена перегородкой, за которой виднелась кровать с целою горой перин и подушек и по временам слышался шорох."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b968e595-c371-48f8-81cb-9ab3b71b316b",
                        "source_entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                        "source_sense_description": "a mattress stuffed with feathers",
                        "target_lang_word": "пухови́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пухови́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                                        "entry_id": "f351552b-e617-3191-b353-80acf86286c9",
                                        "glosses": [
                                            "подстилка для лежания в виде продолговатого мешка, набитого пухом или пером"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf68fc2-9054-4f94-b769-904f1ad63f0b",
                                                "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                                                "text": "— « .. на чём вы охотнее спите: на тюфяках или на пуховике?» — «На пуховиках», — сказал, вздохнувши, калиф."
                                            },
                                            {
                                                "example_id": "7a3e029f-8275-44ee-ad17-54b7477cad51",
                                                "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                                                "text": "Хозяйка уже изъявила было готовность послать за пуховиками и подушками, но хозяин сказал: «Ничего, мы отдохнём в креслах» .."
                                            },
                                            {
                                                "example_id": "945ce6e7-a895-498c-b748-c39605c1be18",
                                                "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                                                "text": ".. после обеда .. мне захотелось спать, и я пошёл в комнату Натальи Савишны, рассчитывая поместиться на её постели, на мягком пуховике, под тёплым стёганым одеялом."
                                            },
                                            {
                                                "example_id": "e5e04fd3-f6fa-4852-94e3-c08aec32868a",
                                                "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                                                "text": "После обеда ляжет купец с женой на пуховики и спит вплоть до вечера."
                                            },
                                            {
                                                "example_id": "b270d1d5-a795-4dba-aa62-09c923864f7a",
                                                "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                                                "text": "На кровати .. было постлано два пышно взбитых пуховика, накрытых чистым бельём."
                                            },
                                            {
                                                "example_id": "2342ab93-31db-48fb-b0cb-c39012720b95",
                                                "sense_id": "b11f0062-2fa9-3fba-b9df-ef024c42158e",
                                                "text": ".. в глубине комнаты стояла роскошная двухспальная кровать, на пуховиках которой лежала Настасья Фёдоровна в богатом персидском капоте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "435c020a-2e0d-32d7-b7b3-939eb794e2e1",
                                        "entry_id": "f351552b-e617-3191-b353-80acf86286c9",
                                        "glosses": [
                                            "разг. куртка или пальто на пуховой прокладке"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
