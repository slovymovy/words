                "senses": [
                    {
                        "sense_id": "668701d5-e45c-3d00-a00b-570786822f71",
                        "entry_id": "a1ab60bf-7354-3934-8847-60b20b950d99",
                        "glosses": [
                            "Donner un caractère de succursale à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12357e58-8205-4841-a07d-208b6c5a6e7b",
                                "sense_id": "668701d5-e45c-3d00-a00b-570786822f71",
                                "text": "La loi du 8 juin 2008 modifiant le Code des sociétés pour y introduire la règlementation sur les fusions transfrontalières avait ainsi entre autres offert de nouvelles possibilités permettant aisément de « succursaliser » une filiale située à l’étranger, moyennant une procédure simplifiée pour une fusion entre société mère et sa filiale à 100%."
                            },
                            {
                                "example_id": "a5ee3a7c-1496-4493-9b9e-24a8e6b75e53",
                                "sense_id": "668701d5-e45c-3d00-a00b-570786822f71",
                                "text": "Ils n’ont pas démissionné: ils ont renié et ne se font plus désormais Québécois que pour mieux nous encanadianiser, succursaliser notre gouvernement et réduire notre culture."
                            }
                        ]
                    }
