                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b747c7f-8d3a-4458-af2c-b7c33efcdc9e",
                        "source_entry_id": "057ef396-ef6f-320e-8746-f544105c43a0",
                        "source_sense_id": "9c3ce6cd-048f-3c6d-ab6b-10b34e1ecb65",
                        "target_lang_word": "bibliomanie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliomanie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ccd57bf-2111-3475-b85f-e4e4f1b4a365",
                                        "entry_id": "80bd0950-0f1c-38f2-ac82-a46dec63d8b6",
                                        "glosses": [
                                            "een overdreven, ziekelijke hartstocht naar het in bezit hebben van veel boeken, echter zonder dat men ze echt leest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288ce882-d279-49c2-b5ba-b6b0f4dbc426",
                                                "sense_id": "8ccd57bf-2111-3475-b85f-e4e4f1b4a365",
                                                "text": "Bibliomanie, die ziekte, heb je of je hebt ze niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "870a7e9f-e578-4105-8e42-f2f73cdf2311",
                        "source_entry_id": "057ef396-ef6f-320e-8746-f544105c43a0",
                        "source_sense_id": "9c3ce6cd-048f-3c6d-ab6b-10b34e1ecb65",
                        "target_lang_word": "Bibliomanie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bibliomanie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e28b8588-8a8f-33cf-8201-a239800e4d64",
                                        "entry_id": "8aacc112-3f2e-361f-bd73-fd96facc5368",
                                        "glosses": [
                                            "stark übertriebene Liebe zu Büchern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6420009e-74d1-4899-8f6b-ee700dc238c1",
                                                "sense_id": "e28b8588-8a8f-33cf-8201-a239800e4d64",
                                                "text": "Seine Bibliomanie geht uns schon zu weit."
                                            },
                                            {
                                                "example_id": "e16e2737-4042-46a7-97db-0cb4dd4b7438",
                                                "sense_id": "e28b8588-8a8f-33cf-8201-a239800e4d64",
                                                "text": "„Und er erklärt Formen und Abarten der Bibliophilie wie die Bibliomanie und Bibliokleptomanie, aber auch den Biblioklasmus, die Bücherzerstörung: ihres Inhalts wegen, wie bei der Bücherverbrennung der Nazis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
