                        "examples": [
                            {
                                "example_id": "550668df-3906-4e62-9d4c-8d9c2720d93b",
                                "sense_id": "c630877f-3036-3b21-83e7-c03aeee868a6",
                                "text": "„Siegrid kam sich nackt vor, sie sah an sich herab, fühlte den Wind in ihrem Ypsilonwald und wußte nichts zu erwidern auf die Frage, was sie vom Krieg der Amerikaner in Vietnam halte.“"
                            },
                            {
                                "example_id": "10501a46-832b-4926-9f1b-be7d7238d1a2",
                                "sense_id": "c630877f-3036-3b21-83e7-c03aeee868a6",
                                "text": "„Und auf einmal reißen die rassigen Weiber ihre Röck hoch bis über die Köpf und haben allesamt nichts drunter als einen blutigen Ypsilonwald.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
