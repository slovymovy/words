                    },
                    {
                        "translation_id": "2815c949-0945-47fc-9f77-c09b0242cd5c",
                        "source_entry_id": "4338750a-85b4-3760-a3e1-9c44031edb7b",
                        "source_sense_description": "second saddle on a motorcycle",
                        "target_lang_word": "siège passager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siège passager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8182e819-9ed4-3f10-91ff-5a97d858c5c4",
                                        "entry_id": "8548cc13-f6b9-3639-b047-d2e69f77efd1",
                                        "glosses": [
                                            "Siège avant situé à côté de celui du conducteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03846f9b-ea10-413e-aa3d-a77738b26743",
                                                "sense_id": "8182e819-9ed4-3f10-91ff-5a97d858c5c4",
                                                "text": "J’avais dû être ultra-convaincant, car finalement le chauffeur migra sur le siège passager tout en me lorgnant de travers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f21ff07a-1953-4c1e-9937-9db9b0c680f6",
                        "source_entry_id": "4338750a-85b4-3760-a3e1-9c44031edb7b",
                        "source_sense_description": "second saddle on a motorcycle",
                        "target_lang_word": "Sozius",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozius",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7562996-2a84-3421-8090-9c7916e56eee",
                                        "entry_id": "6f6a6fc5-2d7b-32bb-8abf-c89e04e6ade7",
                                        "glosses": [
                                            "Teilhaber oder Mitgesellschafter (insbesondere einer Sozietät)"
                                        ],
                                        "tags": [
                                            "Plural 1",
                                            "seltener Plural 2",
                                            "mit veralteten Singularformen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a187f54-149b-41a1-9032-73526c87d208",
                                                "sense_id": "a7562996-2a84-3421-8090-9c7916e56eee",
                                                "text": "„ So haben, wenn dieser ausfindig gemacht ist, die Gläubiger der Masse vollends Recht, ihn als einen wirklichen Sozium anzugreifen.“"
                                            },
                                            {
                                                "example_id": "694ee521-2288-4428-bde4-7209bbc72499",
                                                "sense_id": "a7562996-2a84-3421-8090-9c7916e56eee",
                                                "text": "„Der Versicherungsfall auch nur eines Sozius gilt als Versicherungsfall aller Sozien.“"
                                            },
                                            {
                                                "example_id": "d8345744-cd89-4124-9e9a-d9366afcee64",
                                                "sense_id": "a7562996-2a84-3421-8090-9c7916e56eee",
                                                "text": "„Es leidet auch nicht das mindeste Bedenken, daß die Ausschließung eines Sozii von der Liquidation gerechtfertigt werden kann durch ein begründetes Mißtrauen der anderen Sozii gegen denselben, und daß ein solches in dem stattgefundenen Mißbrauch der Firmen seine Begründung findet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6708b44-f98b-35ac-92c0-4f34a16708ab",
                                        "entry_id": "6f6a6fc5-2d7b-32bb-8abf-c89e04e6ade7",
                                        "glosses": [
                                            "Beifahrersitz eines Motorrades"
                                        ],
                                        "tags": [
                                            "Plural 3"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fdc211b-bf7c-4def-9498-ec959c5f6d1d",
                                                "sense_id": "b6708b44-f98b-35ac-92c0-4f34a16708ab",
                                                "text": "„Mit ihm verbinde ich glückliche Stunden: Wenn er mich im Auto oder auf dem Sozius seines Motorrads mitnahm und wenn ich ihm mittags ins Geschäft Essen bringen durfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0fa47fb9-b113-3122-aaf3-fda0667077c1",
                                        "entry_id": "6f6a6fc5-2d7b-32bb-8abf-c89e04e6ade7",
                                        "glosses": [
                                            "ein Beifahrer auf einem Motorrad, Motorroller oder Ähnlichem"
                                        ],
                                        "tags": [
                                            "Plural 3"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b2ce59d-fd4a-4f91-b5b2-3d8185188e12",
                                                "sense_id": "0fa47fb9-b113-3122-aaf3-fda0667077c1",
                                                "text": "„Der Halter (66-jähriger Opa) fuhr als Sozius mit und gestatte [sic!] die Fahrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "363184bb-b884-3729-b97c-d1cb7a26d09e",
                                        "entry_id": "6f6a6fc5-2d7b-32bb-8abf-c89e04e6ade7",
                                        "glosses": [
                                            "Plural 3, Kumpel, Kumpan, Genosse"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2149b9a-20c2-4ad3-a60f-c3c6be3c04a6",
                                                "sense_id": "363184bb-b884-3729-b97c-d1cb7a26d09e",
                                                "text": "Wo sind denn deine Soziusse? Sonst kommt ihr doch immer zu sechst hierher."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "06a490f0-92c8-37e8-b2f3-ade3fb8294dc",
                                        "entry_id": "6f6a6fc5-2d7b-32bb-8abf-c89e04e6ade7",
