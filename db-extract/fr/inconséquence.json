        "fr-extract.jsonl": [
            {
                "entry_id": "29650a5f-8bab-3447-9d87-4093a6107dbf",
                "word": "inconséquence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8ff336ca-e460-4c21-9628-f5cb1441b218",
                        "entry_id": "29650a5f-8bab-3447-9d87-4093a6107dbf",
                        "tags": [
                            "plural"
                        ],
                        "form": "inconséquences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f13d365f-6604-3fc7-af33-3c9a7dd48c56",
                        "entry_id": "29650a5f-8bab-3447-9d87-4093a6107dbf",
                        "glosses": [
                            "Défaut de conséquence dans les idées, dans les discours, dans les actions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b5bbf0-59d6-4a6a-bbfe-66c8c0c1b4da",
                                "sense_id": "f13d365f-6604-3fc7-af33-3c9a7dd48c56",
                                "text": "Si j'ai tant insisté sur les inconséquences de la politique américaine en Irak depuis 1990, c'est qu'elles ont créé les conditions d'une guerre de religion entre chiites et sunnites, dont nous ne pouvons aujourd'hui prévoir l'issue, sinon qu'elle aura d'immenses répercutions […]."
                            },
                            {
                                "example_id": "14b966d4-55b8-49d8-bdf7-fe926489e8dd",
                                "sense_id": "f13d365f-6604-3fc7-af33-3c9a7dd48c56",
                                "text": "Il y a de l’inconséquence dans ses paroles, dans ses procédés."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e6e0869-2fd6-30ca-a706-8da6c43e359f",
                        "entry_id": "29650a5f-8bab-3447-9d87-4093a6107dbf",
                        "glosses": [
                            "Choses que l’on fait, que l’on dit d’une manière irréfléchie."
                        ],
                        "tags": [
                            "Surtout au pluriel"
                        ],
                        "examples": [
                            {
                                "example_id": "bb731907-2958-48bb-a5c8-f02cd92e3344",
                                "sense_id": "7e6e0869-2fd6-30ca-a706-8da6c43e359f",
                                "text": "Il est nécessaire de ne pas perdre de vue ces inconséquences du caractère de Jean, pour que le lecteur comprenne sa conduite durant la présente soirée."
                            },
                            {
                                "example_id": "6dd906eb-eead-4bc3-b41f-6455321d2b6e",
                                "sense_id": "7e6e0869-2fd6-30ca-a706-8da6c43e359f",
                                "text": "Je serais un bien triste diplomate si je n’avais pas deviné que vos premières coquetteries, vos inconséquences calculées ont eu pour but d’étudier nos caractères."
                            },
                            {
                                "example_id": "8e2782a4-317c-4fd8-be9f-55dec645d37b",
                                "sense_id": "7e6e0869-2fd6-30ca-a706-8da6c43e359f",
                                "text": "Expliquez ces inconséquences ; voici un Parisien qui aime si peu sa cité qu’il choisit, pour y habiter, le coin le moins bruyant, le plus obscur, celui qui ressemble le plus à un quartier de province."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f5eabb9-b8cb-4f2c-8be8-f4ab346f30c0",
                        "source_entry_id": "29650a5f-8bab-3447-9d87-4093a6107dbf",
                        "target_lang_word": "inconsequence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsequence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca9fb764-48fd-3308-ae88-4edd03be670f",
                                        "entry_id": "63943090-a594-3317-8ab5-cdb686249a3d",
                                        "glosses": [
                                            "The state or quality of being inconsequent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a86e114f-3ace-46dd-bc43-5e155e832fe3",
                                                "sense_id": "ca9fb764-48fd-3308-ae88-4edd03be670f",
                                                "text": "Quit pondering the inconsequence of being in a universe governed by chaos and just play some football."
                                            },
                                            {
                                                "example_id": "7406a36d-1194-41ed-88e3-af7cb10e6225",
                                                "sense_id": "ca9fb764-48fd-3308-ae88-4edd03be670f",
                                                "text": "There, through the door and out of her life, it all went—the Lieutenant, his Laundry, his inconsequence, his habit of drinking too much, his failings, his niceness, his kissings in the dark, her little “romance” and renewed interest in life because of him, all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a795b7d3-3be3-3ff9-abe3-4cfc040c7014",
                                        "entry_id": "63943090-a594-3317-8ab5-cdb686249a3d",
                                        "glosses": [
                                            "An inconsequent thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc69b84f-3bc7-4767-860c-ecef0eebac47",
                                                "sense_id": "a795b7d3-3be3-3ff9-abe3-4cfc040c7014",
                                                "text": "His voice was monotonous and jerky, but his sermons were sane, and after the bald inconsequences of Howley even eloquent."
                                            },
                                            {
                                                "example_id": "382e9c7b-0d4f-456d-a236-37bf501532f8",
                                                "sense_id": "a795b7d3-3be3-3ff9-abe3-4cfc040c7014",
                                                "text": "Only those who would view the Terror either as the last word on revolution or as an inconsequence, as more of the same, deny it any providentiality […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b141a592-6a23-4fab-9fc4-50033f5364ae",
                        "source_entry_id": "29650a5f-8bab-3447-9d87-4093a6107dbf",
