                "translations": [
                    {
                        "translation_id": "066fd14b-e70c-4b25-a060-f9310a5620a1",
                        "source_entry_id": "6ea3ff31-f7b4-3f64-88c2-f7f9f889e40e",
                        "source_sense_description": "proclamation, announcement or preaching",
                        "target_lang_word": "Ankündigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ankündigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                        "entry_id": "ddfe11a5-aa50-32f9-a54a-8f6155b987d7",
                                        "glosses": [
                                            "das Ankündigen; Bekanntgabe, die im Voraus getätigt wird; vorherige Benachrichtigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964ffc7c-de59-4fb1-90ce-4b1281af6212",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "Durch die Ankündigung der Geschäftseröffnung werden mehr Kunden erwartet."
                                            },
                                            {
                                                "example_id": "d6e3c157-fdb2-4cc9-b37a-70a5fec2aa64",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "„Ihre großspurigen Ankündigungen zerplatzten wie Seifenblasen.“"
                                            },
                                            {
                                                "example_id": "a85344cb-06b1-47f0-a477-2623e7b205f7",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "„Ohne Ankündigung stellte der ORF am Dienstag ein lang geplantes Projekt online: Sendungen von Ö1, Ö3, FM4 und den neun ORF-Regionalradios findet man nun auf einem Portal.“"
                                            },
                                            {
                                                "example_id": "97c493b1-eda1-4dbb-9dc5-49db3bd5112d",
                                                "sense_id": "c9566b36-6c54-34c4-9b61-ed963f04f689",
                                                "text": "„Sie liebte Schnäppchen, gepresste Blumen und vergessene Schätze, mich und Milena, und sie liebte es, Ankündigungen von Haushaltsauflösungen in der Zeitung zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ad87214-9440-4e39-b7ac-dbc8a9d57256",
                        "source_entry_id": "6ea3ff31-f7b4-3f64-88c2-f7f9f889e40e",
                        "source_sense_description": "proclamation, announcement or preaching",
                        "target_lang_word": "Vorhersage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorhersage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                        "entry_id": "1dc11eea-8c8f-336f-b669-532daa9fd22f",
                                        "glosses": [
                                            "eine Aussage über etwas, das in Zukunft sein wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdbd09da-bd73-4a9b-9dca-f008123d0127",
                                                "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                                "text": "Eine Vorhersage darüber, wie sich die Verhältnisse langfristig entwickeln werden, erscheint sehr gewagt."
                                            },
                                            {
                                                "example_id": "576c2493-ff44-4e56-a922-28dbc8817c98",
                                                "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                                "text": "„Zu glauben, die Lehren der Vergangenheit zur Vorhersage der Zukunft nutzen zu können, ist genauso falsch, wie zu glauben, sie nicht zur Vorsorge nutzen zu müssen.“"
                                            },
                                            {
                                                "example_id": "f5d868cf-56ad-4748-be35-e13085bd7b69",
                                                "sense_id": "252459ae-cb84-3b5c-80e4-ce6367602eac",
                                                "text": "„Von den Vorhersagen der Energieexperten, die bereits in wenigen Jahren mit einem Absinken der Ölnachfrage rechnen, zeigen sich die US-Konzerne dagegen unbeeindruckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ead075b1-1e16-462d-aaf8-f865f05b465f",
                        "source_entry_id": "6ea3ff31-f7b4-3f64-88c2-f7f9f889e40e",
                        "source_sense_description": "assertion or affirmation",
                        "target_lang_word": "Aussage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aussage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cec9bb3-041c-3763-a60d-3835fdd93950",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "Erklärung, Bekundung, Feststellung; etwas Gesagtes, das die eigene Meinung beziehungsweise das eigene Wissen widerspiegelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fbb8d05-09d8-4519-8c9e-cbd9fd88cd02",
                                                "sense_id": "4cec9bb3-041c-3763-a60d-3835fdd93950",
                                                "text": "„Sie hat einen Gesprächsstil perfektioniert, der den Interviewer sicher mit einem guten Gefühl, aber mit so gut wie keiner klaren Aussage zurücklässt.“"
                                            },
                                            {
                                                "example_id": "47841b45-82db-4080-9922-790e8e1152b6",
                                                "sense_id": "4cec9bb3-041c-3763-a60d-3835fdd93950",
                                                "text": "„Symptomatisch für diese gipfelbezogene Erlebnisweise des Höhenbergsteigens ist die Motivationskurve, die sich in zahlreichen, von mir geführten Interviews sinngleich wie in den folgenden Aussagen offenbart: Wenn ich einen Gipfel erreicht habe, sinkt meine Motivation rapide ab […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee4917c8-0e6d-3bcd-8af6-404b7757426e",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "Erklärung vor Gericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aaecef3-6759-4c82-9beb-d84aba815128",
                                                "sense_id": "ee4917c8-0e6d-3bcd-8af6-404b7757426e",
                                                "text": "Er widerrief seine Aussage."
                                            },
                                            {
                                                "example_id": "446d28ff-7aac-4635-b349-2e9f1755f9e8",
                                                "sense_id": "ee4917c8-0e6d-3bcd-8af6-404b7757426e",
                                                "text": "„Die Aussage von dem Fried und anschließend wahrscheinlich die Schlussplädoyers von Dr. Grüner und dem Staatsanwalt – das würde sich bestimmt bis in den Nachmittag ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "86e30653-8deb-3baf-9070-d55201065984",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "inhaltliche Nachricht, zum Beispiel eines künstlerischen Werks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e9227a-c696-4403-a6e6-af65e11b7a37",
                                                "sense_id": "86e30653-8deb-3baf-9070-d55201065984",
                                                "text": "Ich weiß nicht, welche Aussage dieses Gemälde hat."
                                            },
                                            {
                                                "example_id": "c7314116-de72-4b43-b528-7eb93378fc00",
                                                "sense_id": "86e30653-8deb-3baf-9070-d55201065984",
                                                "text": "Mit seinen Ölfässern auf dem Wasser hat Christo auch eine politische Aussage gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e5067169-278a-3b40-86b8-2daff96874db",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "Zeichenreihe, die einen Sachverhalt widerspiegelt und entweder wahr oder falsch ist"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2831227-acff-4cce-8197-efbaef367a25",
                                                "sense_id": "e5067169-278a-3b40-86b8-2daff96874db",
                                                "text": "„Aussageformen werden durch bestimmte Einsetzungen für die Variablen zu wahren oder falschen Aussagen.“"
                                            },
                                            {
                                                "example_id": "5bbad9f6-93da-4dfd-a09c-7b37ecaafc3a",
                                                "sense_id": "e5067169-278a-3b40-86b8-2daff96874db",
                                                "text": "„Untersuchen wir eine Eigenschaft eines mathematischen Objektes oder einen Zusammenhang zwischen mathematischen Objekten, so betrachten wir einen mathematischen Sachverhalt, den wir gegebenenfalls als eine wahre Aussage formulieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f7ab1b1-f34d-4fea-a9fb-30c18003b3d7",
