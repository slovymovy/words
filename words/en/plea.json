{
    "word_family": [
        "plead",
        "pleader",
        "pleading"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93700425-9bb1-3e5e-9494-719f9c6cd2d5",
                    "sense_definition": "An urgent or emotional request for help or something to be done.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity made a desperate <w>plea</w> for donations to help the earthquake victims.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация выступила с отчаянным <w>призывом</w> о пожертвованиях для помощи пострадавшим от землетрясения."
                            }
                        },
                        {
                            "text": "The prisoner's <w>plea</w> for mercy was ignored by the judge during the sentencing.",
                            "target_lang_translations": {
                                "ru": "Судья проигнорировал <w>мольбу</w> заключенного о помиловании во время вынесения приговора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plea for mercy",
                        "desperate plea",
                        "urgent plea",
                        "make a plea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настойчивая или эмоциональная просьба о помощи или о совершении какого-либо действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призыв",
                                "target_lang_sense_clarification": "обращение с просьбой о действии"
                            },
                            {
                                "target_lang_word": "мольба",
                                "target_lang_sense_clarification": "горячая, страстная просьба"
                            },
                            {
                                "target_lang_word": "просьба",
                                "target_lang_sense_clarification": "обращение к кому-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d3530eb-2d46-392b-861c-518bdc2f8a3c",
                    "sense_definition": "A formal statement by or on behalf of a defendant or prisoner, stating guilt or innocence in response to a charge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant entered a <w>plea</w> of not guilty to all charges brought against him.",
                            "target_lang_translations": {
                                "ru": "Подсудимый сделал <w>заявление</w> о своей невиновности по всем предъявленным ему обвинениям."
                            }
                        },
                        {
                            "text": "After the negotiations, the lawyer advised his client to enter a guilty <w>plea</w>.",
                            "target_lang_translations": {
                                "ru": "После переговоров адвокат посоветовал своему клиенту признать <w>вину</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter a plea",
                        "guilty plea",
                        "plea bargain"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление подсудимого о признании или непризнании своей вины в ответ на предъявленное обвинение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление о признании вины",
                                "target_lang_sense_clarification": "официальный ответ на обвинение"
                            },
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "официальное высказывание в суде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74a2eaba-5433-31ef-882b-0758086347b5",
                    "sense_definition": "A reason given in justification of a fault; an excuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used his lack of experience as a <w>plea</w> for his poor performance on the project.",
                            "target_lang_translations": {
                                "ru": "Он использовал отсутствие опыта в <w>оправдание</w> своей плохой работы над проектом."
                            }
                        },
                        {
                            "text": "The tyrant's only <w>plea</w> for his actions was the necessity of maintaining order.",
                            "target_lang_translations": {
                                "ru": "Единственным <w>предлогом</w> тирана для его действий была необходимость поддержания порядка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the plea of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причина, приводимая в оправдание ошибки или проступка; отговорка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдание",
                                "target_lang_sense_clarification": "обоснование справедливости действий"
                            },
                            {
                                "target_lang_word": "предлог",
                                "target_lang_sense_clarification": "повод, используемый для обоснования"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67ff7251-9e62-320d-9323-235a396ef995",
                    "sense_definition": "To <w>plead</w> or to argue a case.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had <w>pleaed</w> for the property in his dreams before finally acquiring it.",
                            "target_lang_translations": {
                                "ru": "Он <w>молил</w> об этой собственности в своих мечтах, прежде чем наконец приобрел ее."
                            }
                        },
                        {
                            "text": "The lawyer <w>pleas</w> the case with great passion despite the lack of evidence.",
                            "target_lang_translations": {
                                "ru": "Адвокат <w>ведет</w> дело с большой страстью, несмотря на отсутствие доказательств."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать в суде или аргументировать дело (архаичная форма глагола)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести тяжбу",
                                "target_lang_sense_clarification": "участвовать в судебном процессе"
                            },
                            {
                                "target_lang_word": "ходатайствовать",
                                "target_lang_sense_clarification": "выступать с просьбой в суде"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}