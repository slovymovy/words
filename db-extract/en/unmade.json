                            {
                                "example_id": "a8b624d3-4249-49a7-b7e8-33d8b56ae851",
                                "sense_id": "0ae096a9-b4c7-30f1-b43c-47145e20c2a8",
                                "text": "On the most unmade bed imaginable sat two older Jewish men, both with black coats folded across their knees, bent close to each other […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5d24d78-82db-3015-8b20-9bb1e45739bd",
