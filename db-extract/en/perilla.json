                        "glosses": [
                            "An East Asian herb with flavorful leaves used in cooking and as a garnish, Perilla frutescens. Also grown for the seeds, which contain an edible and industrially-useful oil."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
