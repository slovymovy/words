                    {
                        "sense_id": "28a735dc-8cd1-34b3-bc86-377bb25c1f4f",
                        "entry_id": "9748d4ef-df87-36e4-a672-c070ac1bcc14",
                        "glosses": [
                            "trifle (unimportant thing, especially a small, unpretentious book or story)"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3726245c-3f65-4485-a710-9ae499519ca8",
                                "sense_id": "28a735dc-8cd1-34b3-bc86-377bb25c1f4f",
                                "text": "Mais gardez vos réflexions pour vous et écoutez-moi car mon petit doigt me dit que cette histoire va vous amuser. Vous adorez les petites bluettes.",
                                "translation": "But keep your thoughts to yourself and listen to me, because something tells me you're going to enjoy this. You love frivolous little stories.",
                                "english": "But keep your thoughts to yourself and listen to me, because something tells me you're going to enjoy this. You love frivolous little stories."
                            }
                        ]
                    }
