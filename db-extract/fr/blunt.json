                                        "sense_id": "310a23a6-fdf6-3439-86b3-4dab2362624d",
                                        "entry_id": "5a0b3e84-129b-3e59-8d5d-888aad3a7167",
                                        "glosses": [
                                            "Slow or deficient in feeling: insensitive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
