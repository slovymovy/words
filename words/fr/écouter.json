{
    "word_family": [
        "écoute",
        "écouteur",
        "réécouter",
        "écoutable",
        "inécoutable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "564188a8-d465-3164-9cf7-b9da9a5cdaa7",
                    "sense_definition": "Prêter l'oreille pour entendre un son, une voix ou de la musique.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception_auditive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>écoute</w> de la musique classique pour me détendre chaque soir après le travail."
                        },
                        {
                            "text": "Dans la classe, tous les élèves <w>écoutent</w> attentivement l'histoire lue par le professeur."
                        }
                    ],
                    "synonyms": [
                        "entendre",
                        "ouïr"
                    ],
                    "common_phrases": [
                        "écouter de la musique",
                        "écouter la radio",
                        "écouter attentivement"
                    ]
                },
                {
                    "sense_id": "36a9c528-d5b1-3d67-81e7-61da4512fc7d",
                    "sense_definition": "Tenir compte de ce que dit une personne, lui obéir ou suivre ses conseils.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obeissance_attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet adolescent rebelle n'<w>écoute</w> personne et refuse d'accepter l'aide de ses proches."
                        },
                        {
                            "text": "Tu devrais vraiment <w>écouter</w> les conseils de ton médecin si tu veux guérir."
                        }
                    ],
                    "synonyms": [
                        "obéir",
                        "suivre"
                    ],
                    "antonyms": [
                        "désobéir",
                        "ignorer"
                    ],
                    "common_phrases": [
                        "écouter les conseils",
                        "écouter la raison"
                    ]
                },
                {
                    "sense_id": "11c09dae-7a62-38ec-a153-bc5a452c0984",
                    "sense_definition": "Accueillir favorablement une proposition ou une demande pour y donner suite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consentement_reception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a finalement accepté d'<w>écouter</w> les revendications des employés de l'usine."
                        },
                        {
                            "text": "Le ministre refusa d'<w>écouter</w> la proposition formulée par les représentants syndicaux."
                        }
                    ],
                    "synonyms": [
                        "agréer",
                        "accueillir"
                    ],
                    "antonyms": [
                        "rejeter",
                        "refuser"
                    ],
                    "common_phrases": [
                        "écouter une proposition",
                        "écouter les revendications"
                    ]
                },
                {
                    "sense_id": "3fd2e623-6dae-327b-9a2d-b9cc1233b1a0",
                    "sense_definition": "Se laisser guider ou dominer par un sentiment, une impulsion ou une passion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment_impulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face au danger imminent, le passant n'<w>écouta</w> que son courage pour sauver l'enfant."
                        },
                        {
                            "text": "Sous le coup de la déception, elle n'<w>écouta</w> que sa colère et démissionna."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "suivre"
                    ],
                    "antonyms": [
                        "réprimer"
                    ],
                    "common_phrases": [
                        "n'écouter que son courage",
                        "n'écouter que sa colère"
                    ]
                },
                {
                    "sense_id": "599f8c6c-6b25-318b-870a-8420ffc67478",
                    "sense_definition": "Regarder une émission, un film ou la télévision.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vision_television",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soir après le souper, toute la famille s'installe pour <w>écouter</w> la télévision."
                        },
                        {
                            "text": "Mes cousins québécois préfèrent <w>écouter</w> un film comique plutôt que de sortir."
                        }
                    ],
                    "synonyms": [
                        "regarder",
                        "visionner"
                    ],
                    "common_phrases": [
                        "écouter la télévision",
                        "écouter un film"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Québec"
                        }
                    ]
                },
                {
                    "sense_id": "fd9852f8-ee6a-349f-af5d-e107aa7d2c9e",
                    "sense_definition": "Se préoccuper excessivement de sa santé, de sa fatigue ou de ses moindres malaises.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "preoccupation_sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré sa grande fatigue, cet artisan consciencieux refuse de s'<w>écouter</w> et poursuit sa tâche."
                        },
                        {
                            "text": "Si tu t'<w>écoutes</w> sans cesse, tu ne sortiras jamais de chez toi."
                        }
                    ],
                    "synonyms": [
                        "se choyer",
                        "se ménager"
                    ],
                    "common_phrases": [
                        "ne pas s'écouter",
                        "trop s'écouter"
                    ]
                },
                {
                    "sense_id": "6642cbc1-eaef-3d38-aab4-fd77874a0700",
                    "sense_definition": "Parler avec une complaisance visible en admirant ses propres propos.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complaisance_orale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce politicien prétentieux s'<w>écoute</w> parler sans jamais tenir compte de l'avis des électeurs."
                        },
                        {
                            "text": "Pendant la réunion, plusieurs collègues trouvaient insupportable qu'il s'<w>écoute</w> ainsi parler."
                        }
                    ],
                    "common_phrases": [
                        "s'écouter parler"
                    ]
                }
            ]
        }
    ]
}