{
    "word_family": [
        "передний",
        "передок",
        "спереди",
        "вперёд",
        "опередить",
        "передовой",
        "передовик"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "5442b375-0a81-3a28-a929-be202445272b",
                    "sense_definition": "В пространстве напротив кого-либо или чего-либо; с лицевой стороны объекта.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы договорились встретиться <перед> входом в театр ровно в семь часов.",
                            "target_lang_translations": {
                                "en": "We agreed to meet <in front of> the theater entrance at exactly seven o'clock.",
                                "zh": "我们约定七点整在剧院入口<w>前面</w>见面。"
                            }
                        },
                        {
                            "text": "Огромная толпа собралась <перед> сценой, ожидая выхода любимой группы.",
                            "target_lang_translations": {
                                "en": "A huge crowd gathered <in front of> the stage, waiting for their favorite band to come out.",
                                "zh": "一大群人聚集在舞台<w>前面</w>，等待他们喜爱的乐队出场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "напротив"
                    ],
                    "antonyms": [
                        "за"
                    ],
                    "common_phrases": [
                        "прямо перед глазами",
                        "стоять перед дверью",
                        "перед зеркалом"
                    ],
                    "target_lang_definitions": {
                        "en": "In the space directly opposite or facing someone or something.",
                        "zh": "在某人或某物的前方，或指物体的正面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in front of",
                                "target_lang_sense_clarification": "most common spatial translation"
                            },
                            {
                                "target_lang_word": "before",
                                "target_lang_sense_clarification": "formal or literary spatial context"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……前面",
                                "target_lang_sense_clarification": "最常用的空间方位表达"
                            },
                            {
                                "target_lang_word": "在……之前",
                                "target_lang_sense_clarification": "较正式或文学化的空间表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e35ac81-19fe-3fc4-9a15-fa39531c4ce8",
                    "sense_definition": "Указывает на время, непосредственно предшествующее какому-либо событию или действию.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Обязательно вымой руки с мылом <перед> едой.",
                            "target_lang_translations": {
                                "en": "Be sure to wash your hands with soap <before> eating.",
                                "zh": "吃饭<w>之前</w>一定要用肥皂洗手。"
                            }
                        },
                        {
                            "text": "<Перед> самым отъездом он вспомнил, что забыл выключить свет в квартире.",
                            "target_lang_translations": {
                                "en": "Just <before> leaving, he remembered that he had forgotten to turn off the lights in the apartment.",
                                "zh": "就在出发<w>之前</w>，他想起忘了关公寓里的灯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "до"
                    ],
                    "antonyms": [
                        "после"
                    ],
                    "common_phrases": [
                        "перед сном",
                        "перед началом",
                        "перед праздниками"
                    ],
                    "target_lang_definitions": {
                        "en": "At a time earlier than a particular event or action.",
                        "zh": "指在某个事件或动作发生之前的时间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "before",
                                "target_lang_sense_clarification": "temporal"
                            },
                            {
                                "target_lang_word": "prior to",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……之前",
                                "target_lang_sense_clarification": "时间上的先后顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e09b695d-6910-373b-b808-0a4cfc75d4de",
                    "sense_definition": "По отношению к кому-либо или чему-либо (обычно при выражении ответственности, вины, долга или страха).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он чувствовал огромную ответственность <перед> своей семьёй за принятое решение.",
                            "target_lang_translations": {
                                "en": "He felt a huge responsibility <to> his family for the decision made.",
                                "zh": "他为自己所做的决定感到<w>对</w>家人负有巨大的责任。"
                            }
                        },
                        {
                            "text": "Мне очень стыдно <перед> учителем за невыполненное домашнее задание.",
                            "target_lang_translations": {
                                "en": "I feel very ashamed <in front of> the teacher for the unfinished homework.",
                                "zh": "因为没完成作业，我在老师<w>面前</w>感到非常惭愧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пред"
                    ],
                    "common_phrases": [
                        "ответственность перед законом",
                        "долг перед родиной",
                        "виноват перед тобой",
                        "страх перед неизвестностью"
                    ],
                    "target_lang_definitions": {
                        "en": "In the presence of someone, or in relation to someone regarding duty, guilt, or judgment.",
                        "zh": "指在某人面前，或在责任、义务、愧疚或判断等关系中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "before",
                                "target_lang_sense_clarification": "formal, often used with law, God, or conscience"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "used with responsibility or duty"
                            },
                            {
                                "target_lang_word": "in front of",
                                "target_lang_sense_clarification": "in the physical presence of someone"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "用于表达责任或义务的对象"
                            },
                            {
                                "target_lang_word": "在……面前",
                                "target_lang_sense_clarification": "指在某人的物理存在下或面对某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e16bf27-dcfd-3b53-b691-e7501042d1f5",
                    "sense_definition": "В сравнении с кем-либо или чем-либо (обычно для подчеркивания преимущества или незначительности).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все его прошлые достижения меркнут <перед> этим великим открытием.",
                            "target_lang_translations": {
                                "en": "All his past achievements pale <before> this great discovery.",
                                "zh": "他过去所有的成就与这项伟大的发现<w>相比</w>都显得黯然失色。"
                            }
                        },
                        {
                            "text": "Твои мелкие проблемы — это сущий пустяк <перед> тем, что пришлось пережить ей.",
                            "target_lang_translations": {
                                "en": "Your petty problems are a mere trifle <compared to> what she had to go through.",
                                "zh": "与她所经历的一切<w>相比</w>，你那些小问题根本不算什么。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ничто перед вечностью"
                    ],
                    "target_lang_definitions": {
                        "en": "In comparison with someone or something, often implying inferiority.",
                        "zh": "与某人或某物进行比较，通常暗示后者更为重要或前者显得微不足道。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "compared to",
                                "target_lang_sense_clarification": "general comparison"
                            },
                            {
                                "target_lang_word": "before",
                                "target_lang_sense_clarification": "literary, often used with 'pale' or 'fade'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "与……相比",
                                "target_lang_sense_clarification": "一般性的比较"
                            },
                            {
                                "target_lang_word": "在……面前",
                                "target_lang_sense_clarification": "文学用法，常用于对比显得逊色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc471a87-e861-3f6f-9363-435e24dddcfa",
                    "sense_definition": "Лицевая, передняя часть предмета или одежды.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Портной аккуратно пришил красивые пуговицы на <перед> нового пиджака.",
                            "target_lang_translations": {
                                "en": "The tailor neatly sewed beautiful buttons onto the <front> of the new jacket.",
                                "zh": "裁缝在新西装的<w>前面</w>仔细地缝上了漂亮的扣子。"
                            }
                        },
                        {
                            "text": "Сказочная избушка медленно повернулась к лесу задом, а к Ивану <передом>.",
                            "target_lang_translations": {
                                "en": "The fairy-tale hut slowly turned its back to the forest and its <front> to Ivan.",
                                "zh": "童话里的小木屋慢慢转动，背对着森林，把<w>前面</w>对着伊万。"
                            }
                        }
                    ],
                    "synonyms": [
                        "передок"
                    ],
                    "antonyms": [
                        "зад"
                    ],
                    "common_phrases": [
                        "перед рубашки",
                        "самый перед"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in simple speech or specific idioms"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The forward part or face of an object or garment.",
                        "zh": "物体或衣服的前部或正面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "front",
                                "target_lang_sense_clarification": "noun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前面",
                                "target_lang_sense_clarification": "名词，指物体的正面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}