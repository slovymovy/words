                                    {
                                        "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                        "entry_id": "b2bd8e80-1494-30d9-9654-17132e79c82e",
                                        "glosses": [
                                            "Alternative form of bypass."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a32589a9-d9fb-4dd3-9f17-f5a1883f2bcb",
                                                "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                                "text": "the Colnbrook By-Pass on the A4"
                                            },
                                            {
                                                "example_id": "55ddbe6b-4c53-4b5b-a835-5117ea2934b5",
                                                "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                                "text": "The railway was in fact shifted in 1937 a little to the west, over a distance of a quarter-mile, to make room for the by-pass at this point, but complete abandonment was firmly vetoed because of the proved strategic value of the line."
                                            },
                                            {
                                                "example_id": "1fee4ccd-15de-4973-b6e5-3ad7552b2d34",
                                                "sense_id": "c7a32a99-ca85-393d-af2b-984edbca9917",
                                                "text": "In The Bus We Loved (2005) Travis Elborough describes the New Road [now named Euston Road and Marylebone Road] as 'London's first by-pass ... a kind of perimeter fence, a here be yokels boundary line between the burgeoning town and the country'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
