                "word": "péremption",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "376a2251-7ac9-40eb-b469-5bdac5937295",
                        "entry_id": "c31d5e80-e6a8-32b6-9220-b6d796f72275",
                        "tags": [
                            "plural"
                        ],
                        "form": "péremptions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e752f7a-3346-34b7-ba8b-9ad0ccd72d29",
                        "entry_id": "c31d5e80-e6a8-32b6-9220-b6d796f72275",
                        "glosses": [
                            "Sorte de prescription qui détruit et annule une procédure civile, lorsqu’il y a eu discontinuité de poursuites pendant un certain temps limité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7a9d31f-e322-4ec2-bdd8-28ca32cf04b0",
                                "sense_id": "9e752f7a-3346-34b7-ba8b-9ad0ccd72d29",
                                "text": "Une affaire radiée peut être rétablie au rôle par simple courrier au greffe dans un délai de deux ans. Au delà, il y a péremption de l'instance, votre saisine est caduque, il faut recommencer à zéro."
                            },
                            {
                                "example_id": "c5a7536a-f720-4d73-a9aa-4a9e0a3aeae4",
                                "sense_id": "9e752f7a-3346-34b7-ba8b-9ad0ccd72d29",
                                "text": "La péremption est encourue, est acquise."
                            },
                            {
                                "example_id": "e43f8440-d117-41db-a0b2-9f4079370bfb",
                                "sense_id": "9e752f7a-3346-34b7-ba8b-9ad0ccd72d29",
                                "text": "Empêcher, couvrir la péremption."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b9827c3-46b0-3729-be99-77e9eaa74228",
                        "entry_id": "c31d5e80-e6a8-32b6-9220-b6d796f72275",
                        "glosses": [
                            "Caractère de ce qui est périmé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5529be3d-7b07-4ef3-8507-383f994c207c",
                                "sense_id": "0b9827c3-46b0-3729-be99-77e9eaa74228",
                                "text": "Cet aliment a atteint sa date de péremption."
                            },
                            {
                                "example_id": "ac8be3c9-fa1c-4a52-8717-6d8df304a7ff",
                                "sense_id": "0b9827c3-46b0-3729-be99-77e9eaa74228",
                                "text": "« Pourriez-vous m’indiquer ma date de péremption, docteur ? »\nLe médecin a refusé.\nPar délicatesse ?\nComme l’humidité qui monte du sol et ronge d’abord le bas des murs, la péremption, chez l’homme, atteint d’abord les bas morceaux."
                            }
                        ]
                    }
