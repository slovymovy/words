                "senses": [
                    {
                        "sense_id": "3f6c5194-38bb-3585-b481-98a232a13b98",
                        "entry_id": "19cf3fab-eba1-33dc-92cb-8b80e165d7ee",
                        "glosses": [
                            "Versicherung für den Fall, dass jemand durch Krankheit oder einen Unfall nicht mehr in der Lage ist, einen Beruf auszuüben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722483a6-e94b-4db5-bac5-5263fe3639c9",
                                "sense_id": "3f6c5194-38bb-3585-b481-98a232a13b98",
                                "text": "„In Verbindung mit einer Kapitallebensversicherung ist eine Berufsunfähigkeitsversicherung recht teuer und daher auch nicht zu empfehlen.“"
                            },
                            {
                                "example_id": "2250d672-d2cf-4ef4-98a9-ba282422aafb",
                                "sense_id": "3f6c5194-38bb-3585-b481-98a232a13b98",
                                "text": "„Zweck der Berufsunfähigkeitsversicherung ist es, einen sozialen Abstieg des Versicherten im Arbeitsleben und in der Gesellschaft, das heißt im sozialen Umfeld, zu verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
