        "ru-extract.jsonl": [
            {
                "entry_id": "86a215fa-20fe-3d76-b9d7-8037218c7bb2",
                "word": "априори",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "88357b3c-ffe4-3d2f-803f-c72954b66664",
                        "entry_id": "86a215fa-20fe-3d76-b9d7-8037218c7bb2",
                        "glosses": [
                            "филос. независимо от опыта, до опыта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2854c0-5f86-4c5b-8914-4c420603567a",
                                "sense_id": "88357b3c-ffe4-3d2f-803f-c72954b66664",
                                "text": "В концертные залы вдруг повалили люди, до этого ни разу там не бывавшие, которые априори считали, что Баха, Шостаковича, Моцарта слу́шать скучно."
                            }
                        ]
                    },
                    {
                        "sense_id": "e15f0d04-32b7-3e01-a423-ef5f131533ec",
                        "entry_id": "86a215fa-20fe-3d76-b9d7-8037218c7bb2",
                        "glosses": [
                            "перен. заранее, предварительно, не опираясь на знание фактов, не проверяя, бездоказательно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dac62a74-876a-4948-af3b-ba762d4f21b6",
                                "sense_id": "e15f0d04-32b7-3e01-a423-ef5f131533ec",
                                "text": "[Елена.] Еще я знаю, что существует каузальная связь, априори и апостериори, но кто они такие, — забыла! И если я от всех этих премудростей не стану лысой, так буду умной! А самое интересное и премудрое во всей философии вот что: зачем вы, Терентий Хрисанфович, говорите мне о философии?"
                            },
                            {
                                "example_id": "9d17f72d-a875-4f45-8acc-015fe5ee42df",
                                "sense_id": "e15f0d04-32b7-3e01-a423-ef5f131533ec",
                                "text": "Почему вы априори считаете его преступником?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88caa55b-a6c4-409a-8a1f-e02d6774ded6",
                        "source_entry_id": "86a215fa-20fe-3d76-b9d7-8037218c7bb2",
                        "target_lang_word": "a priori",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
