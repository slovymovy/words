                "entry_id": "8fa0eed7-4d11-332f-878b-3e96b9551b69",
                "word": "Paphos",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bde4a018-d345-33db-8cb1-d7171a27bae2",
                        "entry_id": "8fa0eed7-4d11-332f-878b-3e96b9551b69",
                        "glosses": [
                            "Ville de Chypre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f011ac-47f9-4f4b-ad37-ee13ad612579",
                                "sense_id": "bde4a018-d345-33db-8cb1-d7171a27bae2",
                                "text": "PAPHOS, (Géog. anc.) ville de l’île de Cypre, à l’extrémité occidentale. Ptolomée & Pline connoissent deux villes de ce nom, savoir paloea Paphos, & nea Paphos, la vieille Paphos, & la nouvelle Paphos. […] C’est dans cette derniere que saint Paul convertit à la religion chrétienne le proconsul Sergius Paulus. L’on dit que la prison de cet apôtre était aux environs de cette ville, qui porte aujourd’hui le nom de Baffo, ou de Baffa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b88a80d-e2f4-47c5-8c85-38f71fc784b6",
                        "source_entry_id": "8fa0eed7-4d11-332f-878b-3e96b9551b69",
                        "source_sense_id": "bde4a018-d345-33db-8cb1-d7171a27bae2",
                        "target_lang_word": "Paphos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paphos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b44af4c-0710-3878-abb2-34674bc63c70",
                                        "entry_id": "0fcc6107-7a52-3038-9a1d-295daa4d2c8d",
                                        "glosses": [
                                            "Hafenstadt auf der Insel Zypern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90842083-47e1-40ac-bda1-17964919030d",
                                                "sense_id": "5b44af4c-0710-3878-abb2-34674bc63c70",
                                                "text": "„Seit dem 6. Mai 2004 dürfen Urlauber aus allen EU-Staaten, die in Larnaca oder Paphos (griechischer Teil von Zypern) gelandet sind, die ganze Insel ohne Einschränkungen bereisen.“"
                                            },
                                            {
                                                "example_id": "0965a849-8f3d-42c8-9417-b73962f74a6e",
                                                "sense_id": "5b44af4c-0710-3878-abb2-34674bc63c70",
                                                "text": "„Die Stadt Paphos besteht eigentlich aus drei weit auseinanderliegenden Orten: Neu-Paphos, dem Hafen; Alt-Paphos oder Kouklia mit dem Aphrodite-Heiligtum und dem am Bergeshang gelegenen Ktima, wo man heute wohnt und herrliche Sonnenuntergänge erleben kann.“"
                                            },
                                            {
                                                "example_id": "1f628408-8ba4-4ec1-a62e-7fd742bf5c30",
                                                "sense_id": "5b44af4c-0710-3878-abb2-34674bc63c70",
                                                "text": "„Aphrodite, die Göttin der Liebe, Schönheit und Verführung, soll vor der Südwestküste Zyperns dem Schaum des Meeres entstiegen und bei Paphos an Land gegangen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
