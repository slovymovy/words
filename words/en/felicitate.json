    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6c99201-4f17-3960-9696-e047702b17ac",
                    "sense_definition": "To express congratulations to someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "congratulate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director stood up to <w>felicitate</w> the team on their remarkable success in the competition.",
                            "target_lang_translations": {
                                "fr": "Le directeur s'est levé pour <w>féliciter</w> l'équipe pour son remarquable succès dans la compétition."
                            }
                        },
                        {
                            "text": "We would like to <w>felicitate</w> the winners for their hard work and dedication throughout the year.",
                            "target_lang_translations": {
                                "fr": "Nous aimerions <w>féliciter</w> les lauréats pour leur travail acharné et leur dévouement tout au long de l'année."
                            }
                        }
                    ],
                    "synonyms": [
                        "congratulate"
                    ],
                    "target_lang_definitions": {
                        "fr": "Adresser des félicitations à quelqu'un."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "féliciter",
                                "target_lang_sense_clarification": "adresser des compliments ou des félicitations à quelqu'un"
                            },
                            {
                                "target_lang_word": "congratuler",
                                "target_lang_sense_clarification": "soutenu ou vieilli, féliciter chaleureusement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7213af78-4079-388f-bff2-e70c1ab43ac6",
                    "sense_definition": "Feeling or being made very happy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "happy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet felt truly <w>felicitate</w> while walking through the quiet, sunlit garden.",
                            "target_lang_translations": {
                                "fr": "Le poète se sentait véritablement <w>bienheureux</w> en se promenant dans le jardin paisible et baigné de soleil."
                            }
                        },
                        {
                            "text": "She remained <w>felicitate</w> in the knowledge that her family was safe and sound.",
                            "target_lang_translations": {
                                "fr": "Elle demeurait <w>heureuse</w> en sachant sa famille saine et sauve."
                            }
                        }
                    ],
                    "synonyms": [
                        "happy",
                        "joyful"
                    ],
                    "antonyms": [
                        "miserable",
                        "unhappy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui éprouve ou manifeste un grand bonheur (archaïque)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "heureux",
                                "target_lang_sense_clarification": "comblé de joie, dans un état de félicité"
                            },
                            {
                                "target_lang_word": "bienheureux",
                                "target_lang_sense_clarification": "qui jouit d'une félicité parfaite"
                            }
                        ]
                    }
                }
            ]
        }
    ]
