                "senses": [
                    {
                        "sense_id": "51f6e302-392f-368d-aa4b-39e055cebd99",
                        "entry_id": "c2005e7f-9dc8-3034-9d17-2bd7b4093451",
                        "glosses": [
                            "Long cordage qu’on laisse traîner sur le sol depuis la nacelle d’un ballon pour freiner, horizontalement et verticalement, le ballon lors de sa descente ou pour lui permettre de conserver une altitude relativement constante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b007e6-b30e-48a8-ac6e-16f3eb1c35c6",
                                "sense_id": "51f6e302-392f-368d-aa4b-39e055cebd99",
                                "text": "Son guiderope traîna de nouveau sur le sol et il envisagea la possibilité de tenter un atterrissage."
                            },
                            {
                                "example_id": "0f8fdf9e-d765-4ade-af26-7c9ff16fd0a6",
                                "sense_id": "51f6e302-392f-368d-aa4b-39e055cebd99",
                                "text": "Le guiderope descendit à toute vitesse, entraînant le ballon une centaine de mètres plus bas, avant d’effectuer un mouvement de pendule."
                            }
                        ]
                    }
                ],
