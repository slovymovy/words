                                                "example_id": "76cc9e6b-86a0-4b77-b29d-db8d433d506b",
                                                "sense_id": "8c337cf1-47df-3ad1-9a91-2c226cbbedf8",
                                                "text": "Nothing hangs on the walls, though a stained-glass Hebrew chai leans against the window."
                                            },
                                            {
                                                "example_id": "32d06b56-0c61-4d65-a484-5de0968a6af8",
                                                "sense_id": "8c337cf1-47df-3ad1-9a91-2c226cbbedf8",
                                                "text": "Today, he [Drake] wears a diamond-studded Chai, a symbol of the Jewish word for life, and has his mother pressuring him to marry \"a nice Jewish girl,\" according to Heeb magazine."
                                            },
                                            {
                                                "example_id": "e34cf7a1-84b6-4722-8a35-03f171d57ab8",
                                                "sense_id": "8c337cf1-47df-3ad1-9a91-2c226cbbedf8",
                                                "text": "Here in France, anti-Semitism is on the rise, and many Jews are hiding their identity in public so as not to be harmed. From what I hear and read, men and women are hiding their jewelry such as the Star of David or Chai, they do not speak about Israel loudly in the street, or men hide their kippah with a hat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ecf6705-c0a9-36a0-8371-b9051deb0271",
                                        "entry_id": "fd5cffed-5f6a-35de-b180-3acab12d49f9",
                                        "glosses": [
                                            "A place above ground for storing wine casks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5da9312-ffdd-4b1e-8b5b-45586b0b4a56",
                                                "sense_id": "0ecf6705-c0a9-36a0-8371-b9051deb0271",
                                                "text": "The Kanon era lasted a mere 10 years, yet he had the château constructed, invested substantially in the vineyard and chais, and established the wine as one of the leading labels in the area."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
