                "senses": [
                    {
                        "sense_id": "bf99ef61-ceef-3a3f-b573-50e3dd66677c",
                        "entry_id": "3001d972-74d9-3980-9da8-7115fb5e8b88",
                        "glosses": [
                            "Ornery, fractious, belligerent, or obstreperous, and hence difficult to deal with."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6a24dc44-f893-46da-941b-36130b7be33d",
                                "sense_id": "bf99ef61-ceef-3a3f-b573-50e3dd66677c",
                                "text": "In this case, the application of the famous method was a little shaky. To be fair, the director was dealing with a pretty stroppy cast."
                            },
                            {
                                "example_id": "49145d03-eed1-4da2-a2b3-b3a593878add",
                                "sense_id": "bf99ef61-ceef-3a3f-b573-50e3dd66677c",
                                "text": "Her shape and posture shadowed her daughter′s, though Kerry carried herself with more attitude, a stroppier jutting of the hips than her mother."
                            },
                            {
                                "example_id": "7d316475-bf0f-4fee-b407-4597d8e3fe60",
                                "sense_id": "bf99ef61-ceef-3a3f-b573-50e3dd66677c",
                                "text": "Even today, women who show signs of anger and who express themselves in some assertive way may be labelled stroppy for doing so."
                            },
                            {
                                "example_id": "da9b5f40-9e43-47d4-951a-aa6f99a137b4",
                                "sense_id": "bf99ef61-ceef-3a3f-b573-50e3dd66677c",
                                "text": "The people who actually produced the paper, mainly the printers, were a stroppier lot, with a more aggressive union."
                            },
                            {
                                "example_id": "1c6a5c41-a533-4c42-9238-ea993b4c5fae",
                                "sense_id": "bf99ef61-ceef-3a3f-b573-50e3dd66677c",
                                "text": "Davina told me earlier that Luke was the stroppiest patient she'd ever had and that he'd given her a lecture on how inefficient and time-wasting her medical was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f839c50-4b31-4a89-afd1-2f4c5751dace",
                        "source_entry_id": "3001d972-74d9-3980-9da8-7115fb5e8b88",
                        "source_sense_id": "bf99ef61-ceef-3a3f-b573-50e3dd66677c",
                        "source_sense_description": "obstreperous",
                        "target_lang_word": "borné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "borné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "503ea0aa-ef4c-3279-9386-ebdcabf4b14d",
                                        "entry_id": "4bd87ddf-2600-322b-b407-7ff25e182f1a",
                                        "glosses": [
                                            "Qui a des bornes, qui est limité par des obstacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d35caed-3557-44b6-a8fa-5906a3ef44ea",
                                                "sense_id": "503ea0aa-ef4c-3279-9386-ebdcabf4b14d",
                                                "text": "Horizon borné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c795d893-f8d0-37e9-9966-e895a4d8ce55",
                                        "entry_id": "4bd87ddf-2600-322b-b407-7ff25e182f1a",
                                        "glosses": [
                                            "Qui se tient dans certaines limites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba6f6cd-358d-46fb-92b5-3cc4f06ac845",
                                                "sense_id": "c795d893-f8d0-37e9-9966-e895a4d8ce55",
                                                "text": "Jeanne passait aux champs pour une fille très-bornée, parce qu’elle était chaste et qu’elle avait, à se produire, une répugnance presque sauvage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e34e7448-eaea-3710-b882-4c91282b45a8",
                                        "entry_id": "4bd87ddf-2600-322b-b407-7ff25e182f1a",
                                        "glosses": [
                                            "Qui est peu intelligent ; qui est intellectuellement médiocre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d968bbd-7181-4323-8663-89aece7eaf02",
                                                "sense_id": "e34e7448-eaea-3710-b882-4c91282b45a8",
                                                "text": "Non seulement il y a beaucoup d’esprits bornés, mais même leurs bornes sont mal posées."
                                            },
                                            {
                                                "example_id": "6b7463db-a599-4d56-b5dd-ee8fd1b9bf0c",
                                                "sense_id": "e34e7448-eaea-3710-b882-4c91282b45a8",
                                                "text": "[…]; comme Combes avait parlé de l’enseignement superficiel et borné de nos écoles primaires, F. Buisson crut devoir protester, en sa qualité de grand pédagogue de la troisième République : […]."
                                            },
                                            {
                                                "example_id": "e1509abf-5b28-451e-846f-1e6f2467a3c6",
                                                "sense_id": "e34e7448-eaea-3710-b882-4c91282b45a8",
                                                "text": "Il parlait de sa mère dont les idées étaient bornées comme deux sous de poivre et quatre sous de café, il en parlait ainsi parce qu’il avait les idées ouvertes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f365aa-c367-30e6-bbf7-41d4dfafbcd1",
                                        "entry_id": "4bd87ddf-2600-322b-b407-7ff25e182f1a",
                                        "glosses": [
                                            "Qui admet une borne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ee4b12-c8c8-4b71-909d-0991f65b1aa3",
                                                "sense_id": "f7f365aa-c367-30e6-bbf7-41d4dfafbcd1",
                                                "text": "Suite bornée inférieurement, supérieurement."
                                            }
                                        ]
                                    }
                                ]
