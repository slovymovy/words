    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5ef9c936-86b2-32ed-8bf0-d117293d31f3",
                "word": "cliffhanger",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "782e8aff-30d0-4d3b-99e8-dedc8884a5c4",
                        "entry_id": "5ef9c936-86b2-32ed-8bf0-d117293d31f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "cliffhangers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00e850f5-f79a-30ee-bd21-35fc5f6ed089",
                        "entry_id": "5ef9c936-86b2-32ed-8bf0-d117293d31f3",
                        "glosses": [
                            "An ending or stopping point calculated to leave a story unresolved, in order to create suspense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e05d034-6c84-4802-9522-68417301bbd1",
                                "sense_id": "00e850f5-f79a-30ee-bd21-35fc5f6ed089",
                                "text": "Back in the early 80s, the hit series Dallas kept the nation guessing with its season-ending cliffhanger \"Who Shot J.R.?\""
                            }
                        ]
                    },
                    {
                        "sense_id": "9ca2fa99-5c1a-3d35-9631-8b2955d68fa7",
                        "entry_id": "5ef9c936-86b2-32ed-8bf0-d117293d31f3",
                        "glosses": [
                            "An outcome which is awaited with keen anticipation, especially one which is delayed for a period of time or which is not known until the last minute."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd29077-84c8-4fb2-9a30-7fd4931bf2aa",
                                "sense_id": "9ca2fa99-5c1a-3d35-9631-8b2955d68fa7",
                                "text": "This presidential election is such a cliffhanger. Will it be the rising star Dmitry \"Obamovich\" Medvedev? Or the veteran Gennady \"McCainovich\" Zyuganov?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc61586f-ab36-4f8c-b11c-937530e1f802",
                        "source_entry_id": "5ef9c936-86b2-32ed-8bf0-d117293d31f3",
                        "source_sense_description": "(narratology) an ending or stopping point",
                        "target_lang_word": "cliffhanger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cliffhanger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67c3f418-b889-3ff5-a917-89b15f7b15e3",
                                        "entry_id": "2aba9224-8ef5-32e4-aea9-d66641e904d8",
                                        "glosses": [
                                            "Procédé narratif employé en littérature, en BD, au cinéma, à la télévision, où l’on crée une situation de suspense afin de tenir en haleine le lecteur, le spectateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c96d939e-baed-42b7-8ea0-e410067ea090",
                                                "sense_id": "67c3f418-b889-3ff5-a917-89b15f7b15e3",
                                                "text": "Trois mois ! C’est pas possible, ça, je vais pas tenir trois mois ! Comment vous faites, vous, quand une saison se termine comme ça … — Par un cliffhanger ?"
                                            },
                                            {
                                                "example_id": "63c2df5f-ca84-413d-96a3-c5c251282465",
                                                "sense_id": "67c3f418-b889-3ff5-a917-89b15f7b15e3",
                                                "text": "Vingt-cinq ans après une deuxième saison qui se concluait par un cliffhanger, le réalisateur de Dancer in the Dark se réinstalle aux commandes de sa série, à l’instar de David Lynch et Mark Frost qui avaient pu donner une suite à 'Twin Peaks en 2017, après un quart de siècle de pause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
