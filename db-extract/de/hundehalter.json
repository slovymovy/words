                        "form": "die Hundehalter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71bfae1d-7b4b-3d75-a5e8-813b37fec831",
                        "entry_id": "4798e547-1005-325e-b61e-43befb8e8d78",
                        "glosses": [
                            "(männliche) Person, die einen Hund zur Haustierhaltung besitzt, die sich einen Hund hält"
                        ],
                        "tags": [
                            "especially",
                            "officialese"
                        ],
                        "examples": [
                            {
                                "example_id": "42b05e7e-5ff1-4914-98f0-94e5e263a41a",
                                "sense_id": "71bfae1d-7b4b-3d75-a5e8-813b37fec831",
                                "text": "„Am allerwenigsten verstehe ich Hundehalter.“"
                            },
                            {
                                "example_id": "4320d3eb-1d3b-49ac-9a0b-cd4b66cd19f4",
                                "sense_id": "71bfae1d-7b4b-3d75-a5e8-813b37fec831",
                                "text": "„Bei neueren Umfragen bestätigen immerhin ein Viertel der Hundehalter, den Hund ins Bett zu lassen bzw. ihn dorthin auch des Nachts mitzunehmen.“"
                            },
                            {
                                "example_id": "0bf0bb6c-7fcf-4ce3-ba3a-367b2a7f889d",
                                "sense_id": "71bfae1d-7b4b-3d75-a5e8-813b37fec831",
                                "text": "„Die Vier Pfoten plädieren daher für einen verpflichtenden Hundeführschein für alle Hundehalter, nicht nur für die Halter von Listenhunden. In Einzelfällen könne ja immer eine Beißkorbpflicht verordnet werden.“"
                            },
                            {
                                "example_id": "54c98921-c5d8-4d42-8b68-99480a6d8d7b",
                                "sense_id": "71bfae1d-7b4b-3d75-a5e8-813b37fec831",
                                "text": "„Diese immer wieder zu betrachtende Verhalten einiger Hundehalter ist verboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
