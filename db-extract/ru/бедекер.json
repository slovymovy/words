                "senses": [
                    {
                        "sense_id": "a4e2259a-158b-3800-956b-69a76540d6dd",
                        "entry_id": "13fab142-90b5-380f-8388-efdcea1d9783",
                        "glosses": [
                            "путеводитель; справочное издание для путешественников с описанием местности, маршрутов, достопримечательностей и т. п."
                        ],
                        "tags": [
                            "устаревающее"
                        ],
                        "examples": [
                            {
                                "example_id": "d4f96bca-6b24-448c-8f00-45d2afc5e520",
                                "sense_id": "a4e2259a-158b-3800-956b-69a76540d6dd",
                                "text": "Незнакомка вздрогнула почему-то и выронила из рук бедекер."
                            },
                            {
                                "example_id": "f8d218f8-793e-43ff-9c59-cd60e4073c6d",
                                "sense_id": "a4e2259a-158b-3800-956b-69a76540d6dd",
                                "text": "Не потому ль картинки с выставки, лучшие русские стихи всегда напоминали мне бедекер ― с тайными тропами маршрутов и одухотворёнными портретами далей, с картинами лучшего, идеального бытия…"
                            }
                        ]
                    }
