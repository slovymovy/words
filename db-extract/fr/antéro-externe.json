                    {
                        "sense_id": "d48109a9-48af-3d20-86aa-d32e064adfd4",
                        "entry_id": "3dce9ecd-298d-3e78-88ea-ffae3ebdd5fe",
                        "glosses": [
                            "Situé dans la partie avant du corps, côté extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eff8d1b-11c0-4a07-a114-c72d40d7c405",
                                "sense_id": "d48109a9-48af-3d20-86aa-d32e064adfd4",
                                "text": "Outre la maladie de Steinert, au moins trois autres formes de myopathies débutent par un déficit des loges antéro-externes de jambe (steppage, pieds tombants)."
                            },
                            {
                                "example_id": "a8c4d096-d943-4603-9e54-db7bb61a4093",
                                "sense_id": "d48109a9-48af-3d20-86aa-d32e064adfd4",
                                "text": "En dehors le péroné est recouvert par les muscles antéro-externes, externes et postéro-externes de la jambe ; à sa partie supérieure et à sa partie inférieure il est facilement accessible au doigt."
                            },
                            {
                                "example_id": "f6425cb0-774f-40f7-a0dc-0b1819d54560",
                                "sense_id": "d48109a9-48af-3d20-86aa-d32e064adfd4",
                                "text": "Quant au procédé transmastoïdien total, préconisé par M. Mignon, il ouvre une voie d’accès sur les abcès antéro-externes et antéro-internes, mais non sur les abcès postéro-internes."
                            }
                        ]
                    }
