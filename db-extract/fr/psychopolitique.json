                        "entry_id": "9e589eaf-d8aa-3ee3-a401-8697bd75064d",
                        "glosses": [
                            "Art et science d'affirmer et de maintenir la domination sur les pensées et les sentiments de loyauté des individus, dirigeants, bureaux et masses, ainsi que la réalisation de la conquête des nations ennemies par la « guérison mentale »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbde73b-5a67-4909-89af-84a8fe55e27b",
                                "sense_id": "bfca0f80-9fce-344a-8ebc-0bda5d41efa5",
                                "text": "Et où la psychopolitique entre-t-elle en jeu, docteur ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e616272f-c6d8-470e-b9c4-0dd4ac392153",
                        "source_entry_id": "9e589eaf-d8aa-3ee3-a401-8697bd75064d",
                        "source_sense_id": "bfca0f80-9fce-344a-8ebc-0bda5d41efa5",
                        "target_lang_word": "Psychopolitik",
