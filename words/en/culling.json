{
    "word_family": [
        "cull"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f8a08dc-77f4-3926-9dc6-0416ee030004",
                    "sense_definition": "The process of selecting and removing items or individuals from a group, often to improve the overall quality or reduce numbers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager oversaw the <w>culling</w> of several underperforming players from the team roster.",
                            "target_lang_translations": {
                                "tr": "Yönetici, takım kadrosundan düşük performans gösteren birkaç oyuncunun <w>ayıklanmasını</w> denetledi."
                            }
                        },
                        {
                            "text": "Wildlife experts recommended a controlled <w>culling</w> of the deer population to prevent overgrazing.",
                            "target_lang_translations": {
                                "tr": "Vahşi yaşam uzmanları, aşırı otlamayı önlemek için geyik popülasyonunun kontrollü bir şekilde <w>ayıklanmasını</w> önerdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduction",
                        "removal",
                        "selection"
                    ],
                    "common_phrases": [
                        "population culling",
                        "brutal culling"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir gruptan belirli öğeleri veya bireyleri, genellikle genel kaliteyi artırmak veya sayıları azaltmak amacıyla seçme ve ayıklama süreci."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayıklama",
                                "target_lang_sense_clarification": "İstenmeyenleri gruptan çıkarma işlemi."
                            },
                            {
                                "target_lang_word": "seçerek azaltma",
                                "target_lang_sense_clarification": "Özellikle popülasyon kontrolü bağlamında."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96f7fdb2-27c2-3707-aed0-e2b621a4eb5d",
                    "sense_definition": "Items or individuals that have been separated or selected from a larger group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer inspected the <w>culling</w> to ensure only the healthiest animals remained in the herd.",
                            "target_lang_translations": {
                                "tr": "Çiftçi, sürüde sadece en sağlıklı hayvanların kaldığından emin olmak için <w>ayıklananları</w> inceledi."
                            }
                        },
                        {
                            "text": "These rejected items are merely the <w>culling</w> from the main production line.",
                            "target_lang_translations": {
                                "tr": "Bu reddedilen ürünler, ana üretim hattından çıkan <w>ayıklanmış</w> parçalardan ibarettir."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejects",
                        "selection"
                    ],
                    "target_lang_definitions": {
                        "tr": "Daha büyük bir gruptan ayrılmış veya seçilmiş olan öğeler veya bireyler."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayıklananlar",
                                "target_lang_sense_clarification": "Gruptan çıkarılmış olan nesneler veya canlılar."
                            },
                            {
                                "target_lang_word": "seçilenler",
                                "target_lang_sense_clarification": "Geriye kalanlardan ayrılmış olan kısım."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27df0093-23d8-3073-8b41-4aed127aac0d",
                    "sense_definition": "Present participle and gerund of <w>cull</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon <w>culling</w> the dead leaves from his rose bushes.",
                            "target_lang_translations": {
                                "tr": "Tüm öğleden sonrasını gül çalılarındaki ölü yaprakları <w>ayıklayarak</w> geçirdi."
                            }
                        },
                        {
                            "text": "The company is currently <w>culling</w> its list of suppliers to focus on more reliable partners.",
                            "target_lang_translations": {
                                "tr": "Şirket şu anda daha güvenilir ortaklara odaklanmak için tedarikçi listesini <w>ayıklıyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "selecting",
                        "removing",
                        "weeding"
                    ],
                    "common_phrases": [
                        "culling the herd"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir gruptan istenmeyenleri seçip çıkarma veya temizleme eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayıklamak",
                                "target_lang_sense_clarification": "İstenmeyenleri seçip ayırmak."
                            },
                            {
                                "target_lang_word": "seçip çıkarmak",
                                "target_lang_sense_clarification": "Belirli kriterlere göre eleme yapmak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}