                                "target_senses": [
                                    {
                                        "sense_id": "45fb5f62-3fe9-3cb4-8ce4-c2cd8fa46a9c",
                                        "entry_id": "77bfab0a-575a-30d4-9da4-2d5c2f542a78",
                                        "glosses": [
                                            "A person from South Africa or of South African descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd460648-0a75-4d8c-b3ae-dde481617c89",
                                                "sense_id": "45fb5f62-3fe9-3cb4-8ce4-c2cd8fa46a9c",
                                                "text": "If dialogue is ever to have a chance, South Africans must find a way to turn away from violence in all its forms — the brutal violence of the sjambok"
                                            },
                                            {
                                                "example_id": "25baa83a-c415-47d7-a379-99e46fca513b",
                                                "sense_id": "45fb5f62-3fe9-3cb4-8ce4-c2cd8fa46a9c",
                                                "text": "During the meeting, Trump brandished printouts of what he said were reports about White South Africans being killed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "South African",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "388d0be5-23d9-3729-93d2-38ba66bf9b83",
                                        "entry_id": "ebfb63e9-e0aa-32e1-a0c1-d4ab73852153",
                                        "glosses": [
                                            "Of, from, or pertaining to South Africa, or the South African people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e283247d-a512-4eaf-8130-96a386eb4cf0",
                                                "sense_id": "388d0be5-23d9-3729-93d2-38ba66bf9b83",
                                                "text": "Thus far, virtually every cinematic attempt to convey the outrages of South African life under apartheid has been diminished by its own good intentions and by a grim sameness that eradicates any element of surprise."
                                            },
                                            {
                                                "example_id": "befb6c69-6f12-44d6-ab53-4bdf8cb21762",
                                                "sense_id": "388d0be5-23d9-3729-93d2-38ba66bf9b83",
                                                "text": "He also had Ramaphosa sit through a video montage that included a clip of a demonstration featuring white crosses symbolizing South African farmers who were killed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
