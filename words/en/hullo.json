    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e394b245-0b55-30f6-ba5a-9b56b0cdc127",
                    "sense_definition": "An alternative form of <w>hello</w> used as a greeting.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked into the room and shouted <w>hullo</w> to everyone sitting at the table.",
                            "target_lang_translations": {
                                "ru": "Он вошел в комнату и крикнул «<w>привет</w>» всем, кто сидел за столом."
                            }
                        },
                        {
                            "text": "I heard a friendly <w>hullo</w> from across the street as I walked to work.",
                            "target_lang_translations": {
                                "ru": "Я услышал дружелюбное «<w>привет</w>» с другой стороны улицы, когда шел на работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "hello",
                        "hi",
                        "hey"
                    ],
                    "common_phrases": [
                        "say hullo"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often perceived as old-fashioned or British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая или британская форма приветствия, аналогичная «привет» или «здравствуйте»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привет",
                                "target_lang_sense_clarification": "неформальное приветствие"
                            },
                            {
                                "target_lang_word": "здравствуйте",
                                "target_lang_sense_clarification": "формальное приветствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2e23383-cad0-30d6-b0d9-cce0e5bdc980",
                    "sense_definition": "An alternative form of <w>hello</w> used to express surprise, puzzlement, or discovery.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hullo</w>, I did not expect to see you here at this time of day.",
                            "target_lang_translations": {
                                "ru": "<w>О</w>, я не ожидал увидеть тебя здесь в это время дня."
                            }
                        },
                        {
                            "text": "<w>Hullo</w>, what is this strange object doing on my desk?",
                            "target_lang_translations": {
                                "ru": "<w>Ого</w>, что этот странный предмет делает на моем столе?"
                            }
                        }
                    ],
                    "synonyms": [
                        "hello",
                        "well"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often perceived as old-fashioned or British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее удивление, озадаченность или внезапное обнаружение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "выражение удивления"
                            },
                            {
                                "target_lang_word": "ого",
                                "target_lang_sense_clarification": "выражение внезапного интереса или удивления"
                            }
                        ]
                    }
                }
            ]
        },
        {
