                "senses": [
                    {
                        "sense_id": "859cd1e9-cd8d-3c56-9f9e-fe27e908d0b8",
                        "entry_id": "ec50b229-e063-3949-b94d-e08a94f68d53",
                        "glosses": [
                            "giftige Spinne mit grauem bis gelbbraunem Hinterkörper und sechs lichtreflektierende Augen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e4cf42-9730-4399-aa14-70e3698a454e",
                                "sense_id": "859cd1e9-cd8d-3c56-9f9e-fe27e908d0b8",
                                "text": "„Die Violinspinne gehört dabei zu den wenigen Spinnenarten, deren Gift komplexe Krankheitsbilder verursachen könne.“"
                            },
                            {
                                "example_id": "a41af277-23b4-40ca-86ef-9e1fc48815dd",
                                "sense_id": "859cd1e9-cd8d-3c56-9f9e-fe27e908d0b8",
                                "text": "„Es ist relativ typisch für Violinspinnen, zuzubeißen, ohne dass ihr Opfer es bemerkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
