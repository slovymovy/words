                ],
                "senses": [
                    {
                        "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                        "entry_id": "85322d7d-36c0-3c35-ae74-b34034a0ad7c",
                        "glosses": [
                            "Relatif à la vieillesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02a8d88-d35a-4b71-9b53-3f3fed141459",
                                "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                                "text": "Débilité sénile, faiblesse qui tient à la vieillesse."
                            },
                            {
                                "example_id": "32bb11f2-84e2-468e-a340-0a5b4e687eec",
                                "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                                "text": "Démence sénile, ensemble de troubles mentaux spécifiques de la vieillesse."
                            },
                            {
                                "example_id": "edfb50a4-77c7-4358-9c55-9fab7b404636",
                                "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                                "text": "Gangrène sénile, gangrène liée à l'âge."
                            }
                        ]
                    },
                    {
                        "sense_id": "be705af0-540f-39e7-b4ad-b033eebb0d36",
                        "entry_id": "85322d7d-36c0-3c35-ae74-b34034a0ad7c",
                        "glosses": [
                            "Qui rappelle le comportement d'un vieillard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b29fd0-bc67-4dcc-b1ba-979ed74b099b",
                                "sense_id": "be705af0-540f-39e7-b4ad-b033eebb0d36",
                                "text": "Raisonnement sénile."
                            },
                            {
                                "example_id": "ef034d0f-5a4e-4214-92e8-f3cf0198351e",
                                "sense_id": "be705af0-540f-39e7-b4ad-b033eebb0d36",
                                "text": "— Il faut vous dire qu’à l’âge de dix-huit ans, j’ai été toute une saison chargé de veiller sur ma grand-mère, devenue peu à peu sénile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "077ee15f-3777-4816-9ea3-27861a9a6d7e",
                        "source_entry_id": "85322d7d-36c0-3c35-ae74-b34034a0ad7c",
                        "target_lang_word": "senile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4657d63-26d2-3ff9-aecc-6335b47230a1",
                                        "entry_id": "06069db5-7993-3978-b2e3-8c33ea6e9358",
                                        "glosses": [
                                            "Of, or relating to old age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867ae83c-411e-44ae-a795-b21cb6015d4d",
                                                "sense_id": "b4657d63-26d2-3ff9-aecc-6335b47230a1",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems— […]. Such a slow-release device containing angiogenic factors could be placed on the pia mater covering the cerebral cortex and tested in persons with senile dementia in long term studies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0142ac-f005-31a5-9943-a9a4aa8c2698",
                                        "entry_id": "06069db5-7993-3978-b2e3-8c33ea6e9358",
                                        "glosses": [
                                            "Exhibiting the deterioration in mind and body often accompanying old age; doddering."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3be3767-48eb-4178-a399-f515863a6477",
                                                "sense_id": "ab0142ac-f005-31a5-9943-a9a4aa8c2698",
                                                "text": "Her mother was senile, but they called it dementia now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "senile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac4ecb6-f409-3b05-b16a-5316871e6f1f",
                                        "entry_id": "8d81832b-470a-3130-a501-b0cfa302d85d",
                                        "glosses": [
                                            "A person who is senile."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ff17be-b770-4c1c-86d2-35fbfdb4b62c",
                                                "sense_id": "6ac4ecb6-f409-3b05-b16a-5316871e6f1f",
                                                "text": "Seniles differ markedly in their early adult intelligence level, and in their social, vocational, and educational histories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce07f688-69b4-4dd4-bb83-fdb6d93269a6",
