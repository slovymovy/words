                                "example_id": "53ed5b9f-994f-4449-9d83-af815bc92260",
                                "sense_id": "dd709beb-c102-30c8-8660-c29913ce71b8",
                                "text": "Op 2 februari begint Strassburgers tweede programma in Carré, dat, in verband met de schrikkelmaand, een dag langer zal duren dan gewoonlijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "63e296f5-0f7a-3fed-a5f7-ad00831592ab",
                        "entry_id": "ea61b294-8113-3af9-bae5-57619398353e",
                        "glosses": [
                            "extra maand die in sommige tijdrekeningen aan bepaalde jaren wordt toegevoegd, zodat de seizoenen ongeveer in dezelfde maanden blijven vallen"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "53925308-0e1c-4fa4-9a64-ed5d6c9402fc",
                                "sense_id": "63e296f5-0f7a-3fed-a5f7-ad00831592ab",
                                "text": "De hoogste priester (pontifex maximus) kon naar eigen goeddunken de kalender rechttrekken door invoeging van de schrikkelmaand intercalaris ná 23 februari, waar bij dan de rest van februari verviel."
                            },
                            {
                                "example_id": "0db3d029-1d6f-4779-99bf-a6a9e3ddb335",
                                "sense_id": "63e296f5-0f7a-3fed-a5f7-ad00831592ab",
                                "text": "Om de maankalender gelijk te laten lopen met de seizoenen moest ongeveer iedere drie jaar een schrikkelmaand worden ingevoegd."
                            }
                        ]
                    }
