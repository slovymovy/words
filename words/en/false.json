                {
                    "sense_id": "8527bef4-224a-304f-86ec-c1baa4a3c747",
                    "sense_definition": "Relating to a logic state that represents a negative or zero result.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function returns <w>false</w> if the user is not logged into the system.",
