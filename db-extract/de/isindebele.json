                "senses": [
                    {
                        "sense_id": "5c46dd45-0160-3400-a4cb-4125edbd20c4",
                        "entry_id": "f4a9c725-f010-3a9b-97ed-d3870a6c6c93",
                        "glosses": [
                            "in Simbabwe (dort Amtssprache), Botsuana und Namibia gesprochene Nguni-Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "533aca51-94f0-4331-9a79-25721b61ebac",
                                "sense_id": "5c46dd45-0160-3400-a4cb-4125edbd20c4",
                                "text": "Etwa 4 Millionen Menschen sprechen isiNdebele."
                            },
                            {
                                "example_id": "cdacf8e2-03a0-43b4-a815-426ab198a91a",
                                "sense_id": "5c46dd45-0160-3400-a4cb-4125edbd20c4",
                                "text": "„Die meisten afrikanischen Sprachen kennen entweder R oder L; isiNdebele ist eine Sprache mit L.“"
                            },
                            {
                                "example_id": "56289eef-7dfa-46c9-8cdf-137ff40a9c86",
                                "sense_id": "5c46dd45-0160-3400-a4cb-4125edbd20c4",
                                "text": "„Auch das Ndebele (isiNdebele), die Sprache der nächstgrößeren ethnischen Einheit (18% der afrikanischen Bevölkerung), gilt als nationale Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "649a5805-b977-316d-9f05-310e910db577",
                        "entry_id": "f4a9c725-f010-3a9b-97ed-d3870a6c6c93",
                        "glosses": [
                            "in den südafrikanischen Provinzen Gauteng, Mpumalanga und Limpopo gesprochene Sotho-Tswana-Sprache"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "21bc144b-077a-4ad9-aecf-71ad608b06dd",
                                "sense_id": "649a5805-b977-316d-9f05-310e910db577",
                                "text": "„Ein bekannter Aktivist für die Anerkennung von Nord-Ndebele als zwölfte offizielle Sprache Südafrikas rechtfertigt diese problematische Forderung […], indem er auf geringfügige lexikalische Unterschiede zwischen dieser Sprache und Süd-Ndebele hinweist (was unter dem Namen isiNdebele als eine der elf offiziellen Sprachen des Landes anerkannt ist).“"
                            },
                            {
                                "example_id": "2459fa0b-c6c4-46ef-bb6a-d1552e059deb",
                                "sense_id": "649a5805-b977-316d-9f05-310e910db577",
                                "text": "„Landessprachen: Alle 11 Landessprachen sind offizielle Sprachen: isi Zulu (23,8%), isi Xhosa (17,6%), Afrikaans (13,3%), sePedi (9,4%), English (8,2%), seTswana (8,2%), seSotho (7,9%), xiTsonga (4,4%), siSwati (2,7%), tshiVenda (2,3%), isiNdebele (1,6%), andere Sprachen (0,6%).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
