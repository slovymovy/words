                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88495181-bb03-3086-bba4-053e93bb1382",
                    "sense_definition": "To decisively put a stop to, terminate, or squash.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stop_end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee chose to <w>kibosh</w> the proposal before it could reach a general vote.",
                            "target_lang_translations": {
                                "cs": "Výbor se rozhodl návrh <w>smetnout ze stolu</w> dříve, než mohl postoupit do všeobecného hlasování."
                            }
                        },
                        {
                            "text": "Legal challenges quickly <w>kiboshed</w> any hope of finishing the project on time.",
                            "target_lang_translations": {
                                "cs": "Právní spory rychle <w>zmařily</w> jakoukoli naději na dokončení projektu včas."
                            }
                        }
                    ],
                    "synonyms": [
                        "nix",
                        "quash"
                    ],
                    "antonyms": [
                        "promote",
                        "advance"
                    ],
                    "common_phrases": [
                        "kibosh the deal",
                        "kibosh the plan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rázně ukončit, zarazit, zmařit nebo zatrhnout (plán, aktivitu)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zatrhnout",
