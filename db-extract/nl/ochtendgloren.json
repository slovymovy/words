        "nl-extract.jsonl": [
            {
                "entry_id": "2309e230-8653-3377-b53f-53ca3f61f794",
                "word": "ochtendgloren",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b118a9c7-9b1d-39e9-ac50-dcde4f755971",
                        "entry_id": "2309e230-8653-3377-b53f-53ca3f61f794",
                        "glosses": [
                            "het eerste licht van de dag voordat de zon opgaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22472935-36ee-4435-97ea-6ef0994adf3c",
                                "sense_id": "b118a9c7-9b1d-39e9-ac50-dcde4f755971",
                                "text": "Als je vroeg opstaat kun je het ochtendgloren zien."
                            },
                            {
                                "example_id": "c4dc47c7-f26f-4d44-9dfe-e63cb56a7306",
                                "sense_id": "b118a9c7-9b1d-39e9-ac50-dcde4f755971",
                                "text": "Daalder (56), oud-Amerikaans ambassadeur bij de NAVO en onder Bill Clinton lid van de Nationale Veiligheidsraad, heeft slecht geslapen. Er is tijdens het eerste ochtendgloren in het Trump-tijdperk nog veel onzeker, maar van het wereldbeeld van de nieuwe president wordt Daalder, nu directeur van de Chicago Council on Global Affairs, onrustig. Het zeventig jaar oude internationale stelsel verandert van gedaante, taxeert hij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee867cc4-4c08-4734-b2be-7e14eefffbf1",
                        "source_entry_id": "2309e230-8653-3377-b53f-53ca3f61f794",
                        "source_sense_id": "b118a9c7-9b1d-39e9-ac50-dcde4f755971",
                        "target_lang_word": "dawn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "433cf67d-0cce-39d8-a270-44c93df8b157",
                                        "entry_id": "4f000209-4f6c-33bf-bab6-c115875f06ed",
                                        "glosses": [
                                            "To begin to brighten with daylight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "525d770d-2d40-4a07-a5e5-13b80b09343c",
                                                "sense_id": "433cf67d-0cce-39d8-a270-44c93df8b157",
                                                "text": "A new day dawns."
                                            },
                                            {
                                                "example_id": "a80618f7-3053-47ad-8330-541627db54e9",
                                                "sense_id": "433cf67d-0cce-39d8-a270-44c93df8b157",
                                                "text": "In the end of the Sabbath, as it began to dawn toward the first day of the week, came Mary Magdalene[…]to see the sepulchre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c960e470-27d4-3029-ae37-1c6f2c3ada35",
                                        "entry_id": "4f000209-4f6c-33bf-bab6-c115875f06ed",
                                        "glosses": [
                                            "To start to appear or become obvious."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0860a732-8707-4483-977c-6f7825cf8c14",
                                                "sense_id": "c960e470-27d4-3029-ae37-1c6f2c3ada35",
                                                "text": "I don’t want to be there when the truth dawns on him."
                                            },
                                            {
                                                "example_id": "8b5aff9b-74a5-4192-a5a8-739eb220d107",
                                                "sense_id": "c960e470-27d4-3029-ae37-1c6f2c3ada35",
                                                "text": "The realization dawned on him that few would pass that final exam."
                                            },
                                            {
                                                "example_id": "774fb426-830c-4224-9310-e6fce5fe08bb",
                                                "sense_id": "c960e470-27d4-3029-ae37-1c6f2c3ada35",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaed0127-42c6-3dc2-88df-f3d168a2debc",
                                        "entry_id": "4f000209-4f6c-33bf-bab6-c115875f06ed",
                                        "glosses": [
                                            "To begin to give promise; to begin to appear or to expand."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fe80185-bbe8-4597-82bb-2d7bf230019e",
                                                "sense_id": "eaed0127-42c6-3dc2-88df-f3d168a2debc",
                                                "text": "when life awakes, and dawns at every line"
                                            },
                                            {
                                                "example_id": "0c68712d-a5d2-4a82-8b93-dfabaf52c2d6",
                                                "sense_id": "eaed0127-42c6-3dc2-88df-f3d168a2debc",
                                                "text": "in dawning youth"
                                            },
                                            {
                                                "example_id": "0e9199f4-90e8-4364-9b1d-3c3abdcc5727",
                                                "sense_id": "eaed0127-42c6-3dc2-88df-f3d168a2debc",
                                                "text": "Leave the time of war behind and let a time of peace dawn!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8151050-695b-344c-bddd-cd3a3de83bd1",
                                        "entry_id": "34bced4c-7f31-378e-9c5f-92de88306027",
                                        "glosses": [
                                            "The morning twilight period immediately before sunrise."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25a1c109-0f40-3139-8363-11ee4128788c",
                                        "entry_id": "34bced4c-7f31-378e-9c5f-92de88306027",
                                        "glosses": [
                                            "The rising of the sun."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bfb66ef-5f02-4086-8d3c-d62c7644c509",
                                                "sense_id": "25a1c109-0f40-3139-8363-11ee4128788c",
                                                "text": "Every act of a Roman, from birth to death, from dawn to night, was controlled and supervised by some presiding deity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9496646f-514e-3b87-b5cc-378971fa4b63",
                                        "entry_id": "34bced4c-7f31-378e-9c5f-92de88306027",
                                        "glosses": [
                                            "The time when the sun rises."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f782f3-1372-4ec5-b9f3-7a09e9717c12",
                                                "sense_id": "9496646f-514e-3b87-b5cc-378971fa4b63",
                                                "text": "She rose before dawn to meet the train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c492c4a9-1f2c-3f2f-9a8f-619e990b2214",
                                        "entry_id": "34bced4c-7f31-378e-9c5f-92de88306027",
                                        "glosses": [
                                            "The earliest phase of something."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ffb8908-53ca-4990-9a4a-d9609da2dea6",
                                                "sense_id": "c492c4a9-1f2c-3f2f-9a8f-619e990b2214",
                                                "text": "The dawn of civilization didn't imply twilight of barbarity."
                                            },
                                            {
                                                "example_id": "4e33f9d4-9f4a-4562-acde-b0dcdd7c3cbc",
                                                "sense_id": "c492c4a9-1f2c-3f2f-9a8f-619e990b2214",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania. The first barrels of crude fetched $18 (around $450 at today’s prices)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ed29e5b-446a-44c2-9515-f0249ab9cf50",
                        "source_entry_id": "2309e230-8653-3377-b53f-53ca3f61f794",
