                                                "sense_id": "2b4bb95a-4c55-36ae-9a0f-3a5139054348",
                                                "text": "All happineſſe bechance to thee in Millaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1987f377-90c3-3303-aa80-4b3ab504c6b2",
                                        "entry_id": "f31acbc7-73da-3cb5-824d-1cf884091b7b",
                                        "glosses": [
                                            "Fortuitous elegance; unstudied grace, used especially of language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83cadec7-5ae6-4b5b-8dd9-6ed5385221f6",
                                                "sense_id": "1987f377-90c3-3303-aa80-4b3ab504c6b2",
                                                "text": "Some Beauties yet, no Precepts can declare, / For there's a Happineſs as well as Care."
                                            }
                                        ]
