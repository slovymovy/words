            "senses": [
                {
                    "sense_id": "4900dbe6-9f14-3306-a1a5-49e11a433c4f",
                    "sense_definition": "Agacer profondément, énerver ou lasser quelqu'un par des paroles ou une attitude pénible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses plaintes continuelles finissent par <w>saouler</w> tout le monde au bureau.",
                            "target_lang_translations": {
                                "en": "His constant complaints end up <w>annoying</w> everyone at the office.",
                                "ru": "Постоянные жалобы в конце концов <w>надоедают</w> всем в офисе.",
                                "de": "Seine ständigen Klagen <w>nerven</w> am Ende alle im Büro.",
                                "es": "Sus quejas continuas acaban por <w>fastidiar</w> a todo el mundo en la oficina.",
                                "zh": "他的不断抱怨最后把办公室里的每个人都<w>烦</w>透了。"
                            }
                        },
                        {
                            "text": "Arrête de me répéter la même chose depuis ce matin, tu me <w>saoules</w>.",
                            "target_lang_translations": {
                                "en": "You've been telling me the same thing since this morning, so stop it, you're <w>annoying</w> me.",
                                "ru": "Перестань повторять мне одно и то же с самого утра, ты меня <w>достаёшь</w>.",
                                "de": "Hör auf, mir seit heute Morgen ständig dasselbe zu wiederholen, du <w>nervst</w> mich.",
                                "es": "Deja de repetirme lo mismo desde esta mañana, me <w>fastidias</w>.",
                                "zh": "别再跟我说同样的话了，你从今天早上起就一直在<w>烦</w>我。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "énerver",
                        "lasser"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To deeply annoy, irritate or wear someone out with tiresome words or behaviour.",
                        "ru": "Сильно раздражать или утомлять кого-либо тягостными словами или поведением.",
                        "de": "Jemanden durch lästige Worte oder unangenehmes Verhalten stark reizen und ermüden.",
                        "es": "Fastidiar a alguien con palabras o actitudes pesadas hasta agotarle la paciencia.",
                        "zh": "深深惹恼、激怒某人，或用令人厌烦的言语和举动使其疲惫不堪。"
                    },
                    "translations": {
