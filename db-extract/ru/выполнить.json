                    }
                ],
                "senses": [
                    {
                        "sense_id": "acfdfac2-a389-330f-adc3-e9d47c73b406",
                        "entry_id": "2555a68e-8d32-3432-bbb8-cd4a3682d225",
                        "glosses": [
                            "осуществить, провести в жизнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72f8673e-cf04-4ecb-96a1-364eaa47394c",
                                "sense_id": "acfdfac2-a389-330f-adc3-e9d47c73b406",
                                "text": "Например, аксель докрученный, но низкий и выполнен на маленькой скорости – могут снять сколько-то баллов от базовой стоимости прыжка."
                            }
                        ]
                    },
                    {
                        "sense_id": "89e5ee8b-378d-3639-9245-8493bbd85542",
                        "entry_id": "2555a68e-8d32-3432-bbb8-cd4a3682d225",
                        "glosses": [
                            "создать, изготовить"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbe3dc1a-6d60-4910-9078-8b1b974f30ba",
                        "source_entry_id": "2555a68e-8d32-3432-bbb8-cd4a3682d225",
                        "target_lang_word": "carry out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carry out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9e7682b-3ebd-360d-9a0a-7245aa8c6277",
                                        "entry_id": "823c9e40-9efc-364d-8245-1e0f8facafd7",
                                        "glosses": [
                                            "To hold while moving it out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e45c9549-8667-4696-9921-39b709a9d319",
                                                "sense_id": "e9e7682b-3ebd-360d-9a0a-7245aa8c6277",
                                                "text": "We’ll have to carry the piano out of the shop."
                                            },
                                            {
                                                "example_id": "00ee0c1a-11d8-42e2-b60b-e039a794d833",
                                                "sense_id": "e9e7682b-3ebd-360d-9a0a-7245aa8c6277",
                                                "text": "And so the little Rabbit was put into a sack with the old picture-books and a lot of rubbish, and carried out to the end of the garden behind the fowl-house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "629048aa-2406-369d-be3a-7f5aad62c04b",
                                        "entry_id": "823c9e40-9efc-364d-8245-1e0f8facafd7",
                                        "glosses": [
                                            "To fulfill."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c954cdcc-0c39-4ba7-9770-354af0673ba7",
                                                "sense_id": "629048aa-2406-369d-be3a-7f5aad62c04b",
                                                "text": "She finally carried out her lifelong ambition when she appeared in a Hollywood blockbuster."
                                            },
                                            {
                                                "example_id": "5fe0c8c8-778a-46db-a778-42ceec5a91eb",
                                                "sense_id": "629048aa-2406-369d-be3a-7f5aad62c04b",
                                                "text": "The Boy was going to the seaside to-morrow. Everything was arranged, and now it only remained to carry out the doctor's orders."
                                            },
                                            {
                                                "example_id": "80193e3b-5998-42d0-8cf1-7afe90bd9c4d",
                                                "sense_id": "629048aa-2406-369d-be3a-7f5aad62c04b",
                                                "text": "Capello warned his players that caution was not an option as they went in search of the result that would take England to Euro 2012. And his message was carried out to the letter in the opening exchanges as England played with a tempo and threat Montenegro struggled to subdue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa7c82e-a326-3f32-8974-051c4a5a54b4",
                                        "entry_id": "823c9e40-9efc-364d-8245-1e0f8facafd7",
                                        "glosses": [
                                            "To execute or perform; to put into operation; to do."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "469385ef-743f-4e6e-a4cf-48dd0ac8da43",
                                                "sense_id": "5fa7c82e-a326-3f32-8974-051c4a5a54b4",
                                                "text": "For the entire last summer they were carrying out their plan to renovate the living room."
                                            },
                                            {
                                                "example_id": "7736eae7-7629-4883-939e-a2464c530f24",
                                                "sense_id": "5fa7c82e-a326-3f32-8974-051c4a5a54b4",
                                                "text": "Among the most modern of all the Pacific stock in Great Britain is the stud of \"Merchant Navy\" and \"West Country\" Pacifics on the Southern Region, and the rebuilding which is now being carried out, preserving all the best features of the Bulleid designs—such as the free-steaming boiler—and jettisoning the features that have given trouble, in particular the chain-driven valve-motion, should give the Southern a supply of highly-competent machines able to last out the remaining life of steam on the S.R."
                                            },
                                            {
                                                "example_id": "833c2439-f7ea-40df-87c0-a5946fb6f773",
                                                "sense_id": "5fa7c82e-a326-3f32-8974-051c4a5a54b4",
                                                "text": "The body design has been carried out to the requirements of the B.T.C. Design Panel in association with the Design Research Unit and its lines are described as \"intentionally unelaborate\"."
                                            },
                                            {
                                                "example_id": "8e06798f-dd57-497e-9990-948f4c14d996",
