                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7eddd6e-f91b-4c14-b51e-cfc1e9b7596f",
                                "sense_id": "46636376-e9ff-35c7-bb5f-954c2f555cec",
                                "text": "Wilson zainicjował także ważną reformę amerykańskiego systemu bankowego i monetarnego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "773b72bf-cf31-40d5-8f60-92a37e0a80e2",
                        "source_entry_id": "73963d29-e52d-30d5-a98d-98af79feec37",
                        "source_sense_id": "46636376-e9ff-35c7-bb5f-954c2f555cec",
                        "target_lang_word": "monetary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monetary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89500b7b-cf95-33b4-98a2-e406d7f5ea33",
                                        "entry_id": "79705386-8a3d-3c2d-b18d-b10515f521cf",
                                        "glosses": [
                                            "Of, pertaining to, or consisting of money."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6afa3186-9fcb-4a71-93a9-33c695f462dd",
                                                "sense_id": "89500b7b-cf95-33b4-98a2-e406d7f5ea33",
                                                "text": "Although of little monetary value, Rosie treasured her late grandfather's old hunting gear."
                                            },
                                            {
                                                "example_id": "31cbac56-b50c-473f-9ef4-7b91c39fa331",
                                                "sense_id": "89500b7b-cf95-33b4-98a2-e406d7f5ea33",
                                                "text": "So what’s the Fed to do? It must manage interest rates without a working monetary policy compass."
                                            },
                                            {
                                                "example_id": "84f9a397-7344-4410-9a57-3e9e762fab5c",
                                                "sense_id": "89500b7b-cf95-33b4-98a2-e406d7f5ea33",
                                                "text": "Wondering how else he passed his time, Winifred surveyed the room again, this time without regard for the monetary value of the things she saw. A box of lutestrings. Five songbooks. But no lute."
                                            },
                                            {
                                                "example_id": "e4fbd24a-5ff6-4edb-8de4-f71be510149a",
                                                "sense_id": "89500b7b-cf95-33b4-98a2-e406d7f5ea33",
                                                "text": "The song is set in a \"red room,\" a likely fiction, urban legend space of torture and death. Being urban legend, details can differ, but consistent within the mythos of the “red room” is its existence on the “deep web” and crowd involvement—likely with a monetary cost—to decide how the person will be tortured and killed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eec3520-1c5f-4316-b01f-1edc01a05d5e",
                        "source_entry_id": "73963d29-e52d-30d5-a98d-98af79feec37",
                        "source_sense_id": "46636376-e9ff-35c7-bb5f-954c2f555cec",
