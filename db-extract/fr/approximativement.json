        "fr-extract.jsonl": [
            {
                "entry_id": "2df453ff-f4a5-34f3-86db-50221c3248fc",
                "word": "approximativement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "79ae221c-030e-34ce-a670-cc28d96ea153",
                        "entry_id": "2df453ff-f4a5-34f3-86db-50221c3248fc",
                        "glosses": [
                            "D’une manière approximative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1edb036-f58c-4cac-b7ec-dc4b6c4fe1c2",
                                "sense_id": "79ae221c-030e-34ce-a670-cc28d96ea153",
                                "text": "Le Groenland, […], est, après l’Australie, la plus grande île du monde ; son étendue correspond approximativement au quart de celle de l’Europe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8d8c862-4f52-4203-99be-c3d02f076be3",
                        "source_entry_id": "2df453ff-f4a5-34f3-86db-50221c3248fc",
                        "source_sense_id": "79ae221c-030e-34ce-a670-cc28d96ea153",
                        "target_lang_word": "approximately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approximately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                        "entry_id": "c6dff810-1820-39ba-b23c-0a46281c6c42",
                                        "glosses": [
                                            "Imprecise but close to in quantity or amount."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5341b476-6ca4-40bf-b0da-076c367f0ea0",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "approximately 60 beats per minute"
                                            },
                                            {
                                                "example_id": "fa575429-4024-4e94-ab8c-5afef641dc7b",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "In every box of matches there are approximately 40 matchsticks."
                                            },
                                            {
                                                "example_id": "6fe7bf28-6dca-48f2-8d21-ef1fa2274a35",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "Per 100 g of chocolate there is approximately 11.6 g of saturated fat."
                                            },
                                            {
                                                "example_id": "54a62ec8-c059-4ff7-836e-2963bdb39751",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "Returning to our own epistemic situation, we do not know the sense in which quantum mechanics and relativity will be taken to be approximately true after their descriptive infelicities are addressed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd4d180b-a4b8-432f-a34a-b51a552059d2",
                        "source_entry_id": "2df453ff-f4a5-34f3-86db-50221c3248fc",
                        "source_sense_id": "79ae221c-030e-34ce-a670-cc28d96ea153",
                        "target_lang_word": "roughly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roughly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f71c3c5-476c-3046-a762-140d6acfac7d",
                                        "entry_id": "33294cf3-e327-3188-ad64-042787b1c7fe",
                                        "glosses": [
                                            "In a rough manner; without kindness, softness, or gentleness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d2db1b8-e915-4f8a-be54-15f214ff51b9",
                                                "sense_id": "9f71c3c5-476c-3046-a762-140d6acfac7d",
                                                "text": "They treated the prisoners roughly [...] slashing pitilessly with their whips to drive them as wretched animals before them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bec66e0-f6aa-3a06-a6e4-b7b957dd422f",
                                        "entry_id": "33294cf3-e327-3188-ad64-042787b1c7fe",
                                        "glosses": [
                                            "Unevenly or irregularly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23fa476f-7c73-39f6-948e-a410002b604b",
                                        "entry_id": "33294cf3-e327-3188-ad64-042787b1c7fe",
                                        "glosses": [
                                            "Without precision or exactness; imprecisely but close to in quantity or amount; approximately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612262c7-61c2-40c8-9ec3-466be498042e",
                                                "sense_id": "23fa476f-7c73-39f6-948e-a410002b604b",
                                                "text": "Satanism can be divided, roughly, into two branches: the Luciferians and the Palladists."
                                            },
                                            {
                                                "example_id": "6af7cb51-cef4-4b15-9d92-7edaeebcffd6",
                                                "sense_id": "23fa476f-7c73-39f6-948e-a410002b604b",
                                                "text": "Of the roughly 400 emerging infectious diseases that have been identified since 1940, more than 60% are zoonotic: ie they came from animals. Throughout history this has been common."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39d69cea-cbcb-4709-95c6-8a4135b653a3",
                        "source_entry_id": "2df453ff-f4a5-34f3-86db-50221c3248fc",
                        "source_sense_id": "79ae221c-030e-34ce-a670-cc28d96ea153",
                        "target_lang_word": "or so",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "or so",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec2bbae-1407-3b7f-a201-4a6dd9210184",
                                        "entry_id": "aef0fd0f-6b01-307c-abfd-dee96e7319fe",
                                        "glosses": [
                                            "Roughly, approximately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02161ab-2465-4b86-a7c9-3ac1d76acb69",
                                                "sense_id": "6ec2bbae-1407-3b7f-a201-4a6dd9210184",
                                                "text": "How many people came to the party? – Thirty or so."
                                            },
                                            {
                                                "example_id": "124d45be-e070-409a-846c-d38e63c60a62",
                                                "sense_id": "6ec2bbae-1407-3b7f-a201-4a6dd9210184",
                                                "text": "It was about half full or so."
                                            },
                                            {
                                                "example_id": "e56e13f5-1bd0-46b1-81d0-065abc27a236",
                                                "sense_id": "6ec2bbae-1407-3b7f-a201-4a6dd9210184",
                                                "text": "In the first twenty or so years."
                                            },
                                            {
                                                "example_id": "14ecaeea-7943-4848-9cd2-9778cf3b255a",
                                                "sense_id": "6ec2bbae-1407-3b7f-a201-4a6dd9210184",
                                                "text": "A VVeek or ſo vvill probably reconcile us."
                                            },
                                            {
                                                "example_id": "e0b10117-470d-4786-9182-364cc87abc2d",
                                                "sense_id": "6ec2bbae-1407-3b7f-a201-4a6dd9210184",
                                                "text": "When everyone had finished off with a drink from the well and an apple or so, the Dwarf produced a pipe about the size of his own arm, filled it, lit it, blew a great cloud of fragrant smoke and said, \"Now.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57779ba1-5559-4072-ac8e-5269b37e3d1e",
                        "source_entry_id": "2df453ff-f4a5-34f3-86db-50221c3248fc",
                        "source_sense_id": "79ae221c-030e-34ce-a670-cc28d96ea153",
