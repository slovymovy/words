                        ],
                        "form": "kakofonietjes"
                    },
                    {
                        "form_id": "4b0dd12e-010a-4309-819b-f546fe43fb2f",
                        "entry_id": "4007aedc-a54e-3b5d-abb5-078229b49be0",
                        "tags": [],
                        "form": "cacophonie",
                        "note": "officiële spelling tot 1955"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af1a4a68-8b13-3dab-b835-da92906231c5",
                        "entry_id": "4007aedc-a54e-3b5d-abb5-078229b49be0",
                        "glosses": [
                            "rommelig geheel van vele klanken door elkaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a565c181-f8cd-44ac-8a95-ce6c0dee6a89",
                                "sense_id": "af1a4a68-8b13-3dab-b835-da92906231c5",
                                "text": "In een kakofonie van getoeter zet de stoet zich om kwart over negen in beweging."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8ff9487-0170-3015-b301-9d8f7353002d",
                        "entry_id": "4007aedc-a54e-3b5d-abb5-078229b49be0",
                        "glosses": [
                            "opvallend gebrek aan overeenstemming"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9b0ee5f9-5040-4f07-8356-10310c0dc26f",
                                "sense_id": "b8ff9487-0170-3015-b301-9d8f7353002d",
                                "text": "Men kan weinig anders doen dan de ogen dicht knijpen bij een dergelijke kakofonie van kleuren, een eerste reflex die al meteen duidelijk maakt wat er fundamenteel mis is met dit werk, en, in het bijzonder, met de inrichting van deze tentoonstelling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ea55ddb-d9f3-4331-b88d-e0a6116575b5",
                        "source_entry_id": "4007aedc-a54e-3b5d-abb5-078229b49be0",
                        "source_sense_id": "af1a4a68-8b13-3dab-b835-da92906231c5",
                        "source_sense_description": "rommelig geheel van vele klanken door elkaar",
                        "target_lang_word": "Kakophonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kakophonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "720ef9c8-ccdf-35f9-acf4-ebf133d7f9e7",
                                        "entry_id": "d6628df5-b7c5-3109-876b-6a60d6c622f6",
                                        "glosses": [
                                            "Laute und Lautverbindungen, die besonders hart, unangenehm oder unästhetisch klingen"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a586052a-2ced-4298-8aee-5cd9911610e7",
                                                "sense_id": "720ef9c8-ccdf-35f9-acf4-ebf133d7f9e7",
                                                "text": "„Die »schönsten« Gedichte einer Sprache können für jemanden, der diese Sprache nicht kennt, als reinste Kakophonie klingen.“"
                                            },
                                            {
                                                "example_id": "08277d4e-8b7c-4f4c-bdfd-eb01ccc93cc0",
                                                "sense_id": "720ef9c8-ccdf-35f9-acf4-ebf133d7f9e7",
                                                "text": "„Ihn rief ich an, weil er Dolmetscher bei der Europäischen Union in Brüssel ist und tagtäglich in den Genuss einer aufregenden Kakophonie von multinationalem Genörgel kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a8032ae-d3b2-3b1f-aa2c-b0c14cd78a06",
                                        "entry_id": "d6628df5-b7c5-3109-876b-6a60d6c622f6",
                                        "glosses": [
                                            "Töne/Klänge, die als besonders unangenehm empfunden werden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77d3e7b5-8bea-4c59-bab7-7dcd9342f472",
                                                "sense_id": "4a8032ae-d3b2-3b1f-aa2c-b0c14cd78a06",
                                                "text": "„Die Choreographie ist lächerlich, die Musik reine Kakophonie. Er gibt einiges an Originalität, auch ein gewisses Maß an Talent.“"
                                            },
                                            {
                                                "example_id": "914c9588-d9cd-405d-9c30-818fb1f5f731",
                                                "sense_id": "4a8032ae-d3b2-3b1f-aa2c-b0c14cd78a06",
                                                "text": "„Westlichen Ohren tut diese Kakophonie zugegebenermaßen weh; ich konnte es den Deutschen am Gesicht ansehen.“"
                                            },
                                            {
                                                "example_id": "57bb402d-a7c4-4378-90b5-af400e7928d7",
                                                "sense_id": "4a8032ae-d3b2-3b1f-aa2c-b0c14cd78a06",
                                                "text": "„Er kann nicht ganz mithalten, ist verantwortlich für eine leise Kakophonie, findet das Tempo übertrieben – dabei zeugt die Musik nur von neuer Lebenslust – und argwöhnt, die zwei wollten ihn anhängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cca523ad-16bc-3b9d-b8da-aadafbd5ec5f",
                                        "entry_id": "d6628df5-b7c5-3109-876b-6a60d6c622f6",
                                        "glosses": [
                                            "generelle Uneinigkeit oder Disharmonie in einer bestimmten Frage"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9348d18-97e2-4262-a9db-ed1bf161d7ab",
                                                "sense_id": "cca523ad-16bc-3b9d-b8da-aadafbd5ec5f",
                                                "text": "„Das Mittelalter war wie die Moderne gekennzeichnet durch eine Kakophonie von Diskursen.“"
                                            },
                                            {
                                                "example_id": "b126198b-3545-4c35-a61b-dc255da30a2f",
                                                "sense_id": "cca523ad-16bc-3b9d-b8da-aadafbd5ec5f",
                                                "text": "„Eine Kakophonie von Stimmen und Rufen erfüllt den Platz, und das Bretonisch und Gälisch der Bauern, beides Sprachen, die ihren Ursprung auf den Britischen Inseln haben und auf dem Land um Vannes gebräuchlich sind, übertönt oft das Französisch der Städter.“"
                                            },
                                            {
                                                "example_id": "0f19d94f-c242-4a63-9cda-d1583109ccfb",
                                                "sense_id": "cca523ad-16bc-3b9d-b8da-aadafbd5ec5f",
                                                "text": "„›Ich würde es nicht wagen‹, sagt seine Geliebte, als er sie auffordert, im zu widersprechen. ›Jeder, der ihm widerspricht, ist dumm‹, erläuterte Lee – eine Provokation, auf die Roth ins seinem nächsten Buch antwortete, einer Kakophonie aus Widersprüchen von allen Seiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4700669f-501a-4c70-b233-6e7cae4c6e68",
                        "source_entry_id": "4007aedc-a54e-3b5d-abb5-078229b49be0",
                        "source_sense_id": "af1a4a68-8b13-3dab-b835-da92906231c5",
                        "source_sense_description": "rommelig geheel van vele klanken door elkaar",
                        "target_lang_word": "cacophony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacophony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                        "entry_id": "1675cda0-6e52-3048-8672-3412b8411d08",
                                        "glosses": [
                                            "A mix of discordant sounds; dissonance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42447518-36d3-4784-a13f-2a82a3556fe9",
                                                "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                                "text": "1921-1922, H. P. Lovecraft, Herbert West: Reanimator,\nNot more unutterable could have been the chaos of hellish sound if the pit itself had opened to release the agony of the damned, for in one inconceivable cacophony was centered all the supernal terror and unnatural despair of animate nature."
                                            },
                                            {
                                                "example_id": "d7723af7-4811-42b9-8ec8-caa720c0c8b7",
                                                "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                                "text": "The Japanese got their attack in first. About ten minutes after passing the U.S. aircraft, they spotted Hornet (local weather patterns temporarily concealing Enterprise). Things had improved a little bit compared to the Eastern Solomons, and three dozen F4F Wildcats on combat air patrol were vectored onto the oncoming hostiles, but once that initial task was accomplished, things began to collapse back into the cacophony and chaos that was all too familiar to those aboard the Enterprise, meaning that the end result was round about the same[…]"
                                            },
                                            {
                                                "example_id": "ab262b14-724f-48c3-9921-75929e5eafaf",
                                                "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                                "text": "A blistering start from the Scots served to steady the ship amid a cacophony that defied the quarter-full national stadium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6aad375-0464-48d5-98c5-0cb947fd5058",
                        "source_entry_id": "4007aedc-a54e-3b5d-abb5-078229b49be0",
                        "source_sense_id": "af1a4a68-8b13-3dab-b835-da92906231c5",
                        "source_sense_description": "rommelig geheel van vele klanken door elkaar",
                        "target_lang_word": "cacophonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacophonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de773e5f-cab2-3da6-83a3-5f1cb2329f5e",
                                        "entry_id": "bee78355-f044-31a3-9613-fe1863fd7e93",
                                        "glosses": [
                                            "Rencontre de syllabes ou de mots sonnant désagréablement à l’oreille."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdb111d8-4172-307b-8184-bb7976c80adc",
                                        "entry_id": "bee78355-f044-31a3-9613-fe1863fd7e93",
                                        "glosses": [
                                            "Désigne des voix et des instruments de musique qui chantent et qui jouent sans être accordés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a87f6e8f-8f81-48d4-99ad-0bb84a9ed445",
                                                "sense_id": "cdb111d8-4172-307b-8184-bb7976c80adc",
                                                "text": "On entend tout : le roulement de la mer, les cris des enfants par-dessus, la cacophonie des mouettes."
                                            },
                                            {
                                                "example_id": "046a6a1a-c358-4408-b1c0-b90409fad905",
                                                "sense_id": "cdb111d8-4172-307b-8184-bb7976c80adc",
                                                "text": "Jamais on n’entendit pareille cacophonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44eaaa9-663f-3082-a910-d05035d97f69",
                                        "entry_id": "bee78355-f044-31a3-9613-fe1863fd7e93",
                                        "glosses": [
                                            "Désigne des situations où les intervenants prennent des positions ou émettent des jugements sans être complétement en accord."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da281bd1-1379-4508-ab6f-ac56a043ad7d",
                                                "sense_id": "c44eaaa9-663f-3082-a910-d05035d97f69",
                                                "text": "Une cacophonie soigneusement entretenue par les géants du secteur, qui, depuis quarante ans, ont transformé nos assiettes et tout fait pour embrouiller les esprits afin de minimiser les dommages de la malbouffe sur la santé."
                                            },
                                            {
                                                "example_id": "fd9f32c1-b4c8-4453-b80c-1583bbc68bf4",
                                                "sense_id": "c44eaaa9-663f-3082-a910-d05035d97f69",
                                                "text": "Des tribunaux ont aussi cassé les restrictions d'hébergement et de déplacement des vacanciers pendant les congés d'automne, ajoutant à la cacophonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bffce1c6-a251-42cb-9851-f03ad37828a7",
                        "source_entry_id": "4007aedc-a54e-3b5d-abb5-078229b49be0",
                        "source_sense_id": "af1a4a68-8b13-3dab-b835-da92906231c5",
                        "source_sense_description": "rommelig geheel van vele klanken door elkaar",
                        "target_lang_word": "cacofonía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacofonía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7b486cac-2754-3783-b4b3-5f2db88748bc",
                                        "entry_id": "547872c2-4de6-3dc7-8b9b-57eb9f7974e5",
                                        "glosses": [
                                            "Vicio del lenguaje que consiste en el encuentro o repetición frecuente de unas mismas letras o sílabas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ef9726-2313-470d-abde-eb91360b9d26",
                                                "sense_id": "7b486cac-2754-3783-b4b3-5f2db88748bc",
                                                "text": "«El que una misma derivación pueda hacerse de varios modos es muy favorable para evitar la cacofonía; y por este respeto se adelanta a las más de las lenguas la lengua castellana, como se verá en su exposición»."
                                            },
                                            {
                                                "example_id": "2cdd747f-50ed-4c05-8d5a-4201b7915d96",
                                                "sense_id": "7b486cac-2754-3783-b4b3-5f2db88748bc",
                                                "text": "«Después de leer estos nuevos libros del veracruzano Jorge López Páez, queda claro el carácter a la vez singular y excesivo de este escritor: por un lado es un inspirado narrador, que pasa por encima del desaseo estilístico que se le ha vuelto una marca de fábrica (si un corrector no hace su trabajo y evita las faltas de concordancia, las cacofonías y el enrevesado ritmo de la frase, es porque el autor así lo pide), y también supera cierta monotonía anecdótica, para después proyectarse a relatos de sorprendente intensidad, pasándose por el arco del triunfo cualquier manual del buen cuentista»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7880c52-a856-365f-8ed3-8dee913e0bd3",
                                        "entry_id": "547872c2-4de6-3dc7-8b9b-57eb9f7974e5",
                                        "glosses": [
                                            "Efecto sonoro desagradable producido por la cercanía de sonidos o sílabas que poseen igual pronunciación. Se emplea a veces como recurso literario (cacografía)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
