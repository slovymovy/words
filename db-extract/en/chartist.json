            {
                "entry_id": "78ac7f96-44b4-3b5f-88e9-6a0cd00de92c",
                "word": "Chartist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ae299e6a-1a1e-483c-9da7-6bee19447300",
                        "entry_id": "78ac7f96-44b4-3b5f-88e9-6a0cd00de92c",
                        "tags": [
                            "plural"
                        ],
                        "form": "Chartists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1565473c-2c6a-3e4c-a719-7e24249f147a",
                        "entry_id": "78ac7f96-44b4-3b5f-88e9-6a0cd00de92c",
                        "glosses": [
                            "A supporter of the Chartism reform movement in the United Kingdom."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "47065a7e-9547-4759-b8a6-18b6180c20b4",
                                "sense_id": "1565473c-2c6a-3e4c-a719-7e24249f147a",
                                "text": "There to be a real blessing, raising new corn for us, purchasing new webs and hatchets from us; leaving us at least in peace; instead of staying here to be a physical-force Chartist, unblessed and no blessing!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6db5f739-ad2e-4cf2-85f1-bd84bc215bb4",
                        "source_entry_id": "78ac7f96-44b4-3b5f-88e9-6a0cd00de92c",
