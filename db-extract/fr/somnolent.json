                                        "glosses": [
                                            "Inclined to drowse; heavy with sleepiness"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d4e759-2bb1-4214-82d8-26431fb886f8",
                                                "sense_id": "8664948e-13cb-3edd-8bb8-669e02ed040f",
                                                "text": "I was feeling drowsy and so decided to make a cup of coffee to try to wake myself up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b70f612-3e61-333c-b386-bc8eb9e61aa0",
                                        "entry_id": "6333c586-0690-3c9e-8c1f-0558cd4d3b6a",
                                        "glosses": [
                                            "Causing someone to fall sleep or feel sleepy; lulling; soporific."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "888856a5-8a9e-4ff9-b45e-58f4a946ca0b",
                                                "sense_id": "9b70f612-3e61-333c-b386-bc8eb9e61aa0",
                                                "text": "It was a warm, drowsy summer afternoon."
