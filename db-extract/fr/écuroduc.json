                    }
                ],
                "senses": [
                    {
                        "sense_id": "5775bd21-2903-3a5c-959e-151c231221ec",
                        "entry_id": "0e6ae1c4-d6b0-3f9d-9c24-51894154c978",
                        "glosses": [
                            "Corde tendue expressément au dessus d’un obstacle (route, canal,…) ou passage aérien pour permettre aux écureuils ou à d'autres petits animaux arboricoles de le franchir facilement et sans risque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b130b50a-781c-4d3d-a93c-1ce67bf56f73",
                                "sense_id": "5775bd21-2903-3a5c-959e-151c231221ec",
                                "text": "Pour préserver ces petits rongeurs, la Ligue de protection des oiseaux (LPO), qui travaille sur la faune sauvage, a décidé d’installer sur deux routes du département des écuroducs."
                            },
                            {
                                "example_id": "e72eff55-5836-43e7-b1d9-6e41be676e06",
                                "sense_id": "5775bd21-2903-3a5c-959e-151c231221ec",
                                "text": "L’écuroduc est un corridor biologique artificiel mis en place au-dessus d’un obstacle, principalement une route, qui permet le passage aérien en toute sécurité des écureuils."
                            },
                            {
                                "example_id": "40cf3bd8-cd41-4b9c-8e2a-0346080f0aba",
                                "sense_id": "5775bd21-2903-3a5c-959e-151c231221ec",
                                "text": "Espèce en voie de disparition, l’écureuil roux dispose à présent d'un écuroduc dans le quartier des Terriers."
                            },
                            {
                                "example_id": "bc06c792-939c-446c-8bb5-1f79f4a26b86",
                                "sense_id": "5775bd21-2903-3a5c-959e-151c231221ec",
                                "text": "Deux types d’écuroduc peuvent être envisagés en fonction de la distance à franchir et ainsi de la longueur de la corde, les écuroducs à simple poulie et les écuroducs à palan."
                            }
                        ]
                    }
                ],
