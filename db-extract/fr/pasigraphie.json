                                "target_senses": [
                                    {
                                        "sense_id": "e096c4e3-3841-389b-992b-05786bf95548",
                                        "entry_id": "eb7449eb-d6f6-3d36-a1de-8921378b80bb",
                                        "glosses": [
                                            "A writing system where concepts are written instead of words. The system is not phonetic and uses ideograms, such as mathematical symbols. It is intended to be universally understood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc498ad-aaac-4b33-be7d-bd624ed6a831",
                                                "sense_id": "e096c4e3-3841-389b-992b-05786bf95548",
                                                "text": "He spent his spare time on the weekend perfecting his very own pasigraphy."
                                            },
                                            {
                                                "example_id": "573833c2-e72c-4efc-9f4b-ee329028930e",
                                                "sense_id": "e096c4e3-3841-389b-992b-05786bf95548",
                                                "text": "M. Alexander Kis, of Pest in Hungary, has recently invented an universal alphabet, or species of pasigraphy applicable to all languages."
                                            },
                                            {
                                                "example_id": "202cbd9c-9ae3-41ed-991a-f899ca4d2648",
                                                "sense_id": "e096c4e3-3841-389b-992b-05786bf95548",
                                                "text": "People call any written universal language a \"pasigraphy\" ; thus the international code of maritime signals is a \"pasigraphy.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
