                "senses": [
                    {
                        "sense_id": "bbc34c7f-99c1-30d7-a475-b8abb6428a47",
                        "entry_id": "8247f7dc-6e8f-37a3-9580-904a276bc60b",
                        "glosses": [
                            "Figur, die in einer Sage vorkommt und von einem Dichter erschaffen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966c5eab-375d-4a1d-95d6-107c7b6f1f3b",
                                "sense_id": "bbc34c7f-99c1-30d7-a475-b8abb6428a47",
                                "text": "„Über diese Sagengestalt ist sehr viel geschrieben worden, allerdings waren sich die Forscher lange uneins darüber, ob je eine alte Loreleysage existiert hat oder ob sie auf den Dichter Clemens von Brentano zurückgeht, der im Jahre 1802 seine berühmte Ballade „Die Lore Lay“ schrieb.“"
                            },
                            {
                                "example_id": "a0568e1e-b16f-473c-a6e5-a65ac4f38e72",
                                "sense_id": "bbc34c7f-99c1-30d7-a475-b8abb6428a47",
                                "text": "Der Welthund ist eine Sagengestalt aus dem deutschen Sprachraum und wird als ein Hund beschrieben, welcher ein Auge “mitten auf dem Kopf” trägt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
