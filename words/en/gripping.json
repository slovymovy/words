{
    "word_family": [
        "grip",
        "gripper",
        "grippy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "985647da-a789-369a-bc97-90657327345c",
                    "sense_definition": "Holding the attention or interest strongly; extremely exciting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel was so <w>gripping</w> that I stayed up all night to finish the last chapter.",
                            "target_lang_translations": {
                                "ru": "Роман был настолько <w>захватывающим</w>, что я не спал всю ночь, чтобы дочитать последнюю главу."
                            }
                        },
                        {
                            "text": "The director created a <w>gripping</w> action film that kept the audience on the edge of their seats.",
                            "target_lang_translations": {
                                "ru": "Режиссер создал <w>держащий в напряжении</w> боевик, который заставлял зрителей сидеть как на иголках."
                            }
                        }
                    ],
                    "synonyms": [
                        "interesting",
                        "absorbing",
                        "fascinating"
                    ],
                    "antonyms": [
                        "boring",
                        "dull",
                        "uninteresting"
                    ],
                    "common_phrases": [
                        "gripping action film",
                        "gripping novel",
                        "gripping story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживающий внимание или интерес; чрезвычайно захватывающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывающий",
                                "target_lang_sense_clarification": "о сюжете, фильме или книге"
                            },
                            {
                                "target_lang_word": "увлекательный",
                                "target_lang_sense_clarification": "вызывающий большой интерес"
                            },
                            {
                                "target_lang_word": "держащий в напряжении",
                                "target_lang_sense_clarification": "остросюжетный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f74bed7-038a-343e-b805-e0ed00f54fbf",
                    "sense_definition": "Present participle and gerund of <w>grip</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>gripping</w> the steering wheel tightly as he drove through the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Он крепко <w>сжимал</w> руль, проезжая сквозь сильный ливень."
                            }
                        },
                        {
                            "text": "The climber was <w>gripping</w> the rock face with all his strength to avoid falling.",
                            "target_lang_translations": {
                                "ru": "Альпинист изо всех сил <w>цеплялся</w> за скалу, чтобы не упасть."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «grip» (сжимать, крепко держать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимающий",
                                "target_lang_sense_clarification": "крепко держащий рукой"
                            },
                            {
                                "target_lang_word": "удерживающий",
                                "target_lang_sense_clarification": "сохраняющий хватку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "538baaf7-06ef-333a-99c2-f913f15468c0",
                    "sense_definition": "The act of forming or applying a grip.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>grippings</w> of his hand showed how nervous he was during the interview.",
                            "target_lang_translations": {
                                "ru": "То, как он внезапно <w>сжимал</w> руки, выдавало его сильное волнение во время интервью."
                            }
                        },
                        {
                            "text": "The machine's mechanical <w>grippings</w> were precise enough to handle delicate glassware.",
                            "target_lang_translations": {
                                "ru": "Механические <w>захваты</w> машины были достаточно точными, чтобы работать с хрупкой стеклянной посудой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт формирования или применения захвата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "действие по сжиманию или удержанию"
                            },
                            {
                                "target_lang_word": "сжимание",
                                "target_lang_sense_clarification": "процесс крепкого обхвата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ccc84d0-7ff9-3e1d-9315-1085e53d1038",
                    "sense_definition": "Obsolete form of <w>griping</w>, referring to sharp pains in the bowels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old medical text described severe <w>grippings</w> in the stomach caused by the infection.",
                            "target_lang_translations": {
                                "ru": "В старом медицинском тексте описывались сильные <w>рези</w> в животе, вызванные инфекцией."
                            }
                        },
                        {
                            "text": "He took a herbal remedy to soothe the <w>grippings</w> that had troubled him all night.",
                            "target_lang_translations": {
                                "ru": "Он принял травяное средство, чтобы унять <w>колики</w>, которые мучили его всю ночь."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "obsolete spelling and usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова «griping», означающая резкие боли в кишечнике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рези",
                                "target_lang_sense_clarification": "острые боли в животе"
                            },
                            {
                                "target_lang_word": "колики",
                                "target_lang_sense_clarification": "спазмы в кишечнике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}