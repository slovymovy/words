    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70658334-0530-3211-8787-305bd74e387b",
                    "sense_definition": "To make a long, narrow cut or opening in something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>slit</w> the envelope open with a small pocket knife.",
                            "target_lang_translations": {
                                "cs": "Obálku <w>prořízl</w> malým kapesním nožem."
                            }
                        },
                        {
                            "text": "He <w>slit</w> the bag open and the rice began pouring out onto the clean floor.",
                            "target_lang_translations": {
                                "cs": "Pytel <w>rozřízl</w> a rýže se začala sypat na čistou podlahu."
                            }
                        }
                    ],
                    "synonyms": [
                        "slash",
                        "cut"
                    ],
                    "common_phrases": [
                        "slit open"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvořit dlouhý, úzký řez nebo otvor v něčem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "proříznout",
                                "target_lang_sense_clarification": "vytvořit řez skrz něco"
                            },
                            {
                                "target_lang_word": "rozříznout",
                                "target_lang_sense_clarification": "otevřít řezem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26d25635-1c16-34a4-af49-fc20f221eaa7",
                    "sense_definition": "To cut something lengthwise into long strips.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker <w>slit</w> the sheet of plastic into long thin strips for recycling.",
                            "target_lang_translations": {
                                "cs": "Pracovník <w>rozřezal</w> plastovou fólii na dlouhé tenké pruhy pro recyklaci."
                            }
                        },
                        {
                            "text": "She <w>slit</w> the sheet into thin strips to use for tying the plants in the garden.",
                            "target_lang_translations": {
                                "cs": "Plachtu <w>nařezala</w> na tenké proužky, aby je použila k uvázání rostlin na zahradě."
                            }
                        }
                    ],
                    "synonyms": [
                        "strip",
                        "slice"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozřezat něco podélně na dlouhé pruhy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozřezat",
                                "target_lang_sense_clarification": "rozdělit na více kusů"
                            },
                            {
                                "target_lang_word": "nařezat",
                                "target_lang_sense_clarification": "vytvořit zářezy nebo pruhy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af9c27c-f82a-3e1a-8e5f-c15066068502",
                    "sense_definition": "To cut, sever, or divide something completely or deeply.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assassin attempted to <w>slit</w> his victim's throat in the dark alley.",
                            "target_lang_translations": {
                                "cs": "Vrah se v temné uličce pokusil oběti <w>podříznout</w> hrdlo."
                            }
                        },
                        {
                            "text": "The villain tried to <w>slit</w> the rope holding the bridge together, but the hero stopped him.",
                            "target_lang_translations": {
                                "cs": "Padouch se pokusil <w>přeříznout</w> lano držící most pohromadě, ale hrdina ho zastavil."
                            }
                        }
                    ],
                    "synonyms": [
                        "sever",
                        "cut",
                        "cleave"
                    ],
                    "target_lang_definitions": {
                        "cs": "Úplně nebo hluboce něco přeříznout či oddělit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podříznout",
                                "target_lang_sense_clarification": "přeříznout hrdlo"
                            },
                            {
                                "target_lang_word": "přeříznout",
                                "target_lang_sense_clarification": "přetnout v celém průřezu"
                            }
                        ]
                    }
                }
            ]
        },
        {
