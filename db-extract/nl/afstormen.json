                ],
                "senses": [
                    {
                        "sense_id": "59530cca-7497-3117-a016-2df8044f3bce",
                        "entry_id": "99aaf481-7f28-3698-b9e2-61d708078530",
                        "glosses": [
                            "to rush, to run at"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24b2476-fadc-4840-bd90-7e57ff90e920",
                                "sense_id": "59530cca-7497-3117-a016-2df8044f3bce",
                                "text": "Plots zag ze vier koeien op haar afstormen, waarna ze snel de berm inreed.",
                                "translation": "Suddenly she saw four cows rushing towards her, after which she quickly drove into the verge.",
                                "english": "Suddenly she saw four cows rushing towards her, after which she quickly drove into the verge."
                            }
                        ]
                    }
