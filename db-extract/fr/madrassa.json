                        "glosses": [
                            "Variante de médersa."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "aec20167-7bcf-4ab0-9b61-7fe40c4e12cc",
                                "sense_id": "3ff1b6ab-121f-3912-a349-d65f66fab8f5",
                                "text": "Les madrassas assurent l’éducation des enfants des milieux pauvres au Pakistan, elles sont d’autant plus attractives que les élèves y sont logés et nourris gratuitement."
                            },
                            {
                                "example_id": "b8ccb065-dcb2-45d1-9311-611f736fd7ce",
                                "sense_id": "3ff1b6ab-121f-3912-a349-d65f66fab8f5",
                                "text": "Orphelin, il a été formé dès l’âge de 11 ans à la madrassa de la Da’Wa, avec une cinquantaine d’enfants, à raison de dix heures par jour."
                            },
                            {
                                "example_id": "3be0325e-b10d-4f3c-a6be-e2cd5e77cb10",
                                "sense_id": "3ff1b6ab-121f-3912-a349-d65f66fab8f5",
                                "text": "En 1958, les soldats français investissent le village et s’installent dans les trois grandes salles de la madrassa, l’école coranique que les habitants, réunis en association, étaient parvenus à ouvrir en 1932."
                            }
                        ]
                    }
