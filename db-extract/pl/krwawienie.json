                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleeding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f41508e-723c-3d8b-b6e8-27e89da8e974",
                                        "entry_id": "a57aea42-a3b3-368e-859b-e27f27b1f168",
                                        "glosses": [
                                            "present participle and gerund of bleed"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
