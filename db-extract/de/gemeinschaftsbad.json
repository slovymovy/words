                        "examples": [
                            {
                                "example_id": "a753d449-c421-4a0a-ad53-b8286ae51dde",
                                "sense_id": "919a8657-91c4-333e-8720-56542dac2302",
                                "text": "„Ein kleines, spartanisch eingerichtetes Zimmer, aber erheblich sauberer als seine Bude in Mongkok. Zwar ohne eigenes Bad, aber am Ende eines gut ausgeleuchteten Hausflurs stand ihm ein Gemeinschaftsbad mit vier Toiletten zur Verfügung, jede Kabine mit einem großen Außenfenster zur Belüftung, was bei der schwülwarmen Luft und dem Autoverkehr draußen allerdings wenig brachte, eher im Gegenteil.“"
                            }
                        ],
