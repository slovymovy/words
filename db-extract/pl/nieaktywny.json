                                                "sense_id": "97075b02-2636-3534-8d3b-71bcabe7e377",
                                                "text": "Admiral Jones is now on the inactive list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f999dc2e-9918-3f54-8418-77afe42d50e5",
                                        "entry_id": "66822b41-0320-3930-b577-d72ad513313b",
                                        "glosses": [
                                            "Relatively inert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5cb817-c0ce-4ae8-9354-502c4e6d8a20",
                                                "sense_id": "f999dc2e-9918-3f54-8418-77afe42d50e5",
                                                "text": "Aluminium is inactive towards water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e094f210-8d03-3e5a-8355-f0b1a6fae3c0",
                                        "entry_id": "66822b41-0320-3930-b577-d72ad513313b",
                                        "glosses": [
                                            "Showing no optical activity in polarized light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f93f3f-116b-439a-981a-d2888e1db58b",
                                                "sense_id": "e094f210-8d03-3e5a-8355-f0b1a6fae3c0",
                                                "text": "Synthetic glycine is optically inactive as it contains equal amounts of the d- and l- form."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inactive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11fe87c3-7b71-320f-a599-0ac8ca00c062",
                                        "entry_id": "cddf8b46-00ed-3b01-a7e2-a27489890aa6",
                                        "glosses": [
                                            "A person who does not take action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a8491f-a540-4e5a-b81a-0c66b24fc702",
                                                "sense_id": "11fe87c3-7b71-320f-a599-0ac8ca00c062",
                                                "text": "Typically inactives are poorly educated older women. Their lack of education is overwhelmingly the key factor in assigning the inactives to a life devoid of political activity of any sort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cae720f-0dac-4ba2-8346-c8b2faf99509",
                        "source_entry_id": "bfc89488-9d04-382c-ae13-4f6faede6eb8",
                        "source_sense_id": "40ca8044-15dc-35b4-ad8c-551718af0935",
