                "senses": [
                    {
                        "sense_id": "f639bde6-3047-3c3d-a8c3-4136a84a9947",
                        "entry_id": "65b51add-6811-369d-995e-920b050ee299",
                        "glosses": [
                            "Faire la guerre à la façon des chouans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d3cc23-1d12-40b9-99b3-a21631e04c15",
                                "sense_id": "f639bde6-3047-3c3d-a8c3-4136a84a9947",
                                "text": "Il n'y avait rien d'indigne à chouanner dans les bois de la Bretagne ou dans les marais et les bruyères de la Vendée."
                            },
                            {
                                "example_id": "44b98439-163d-42fd-9bdb-3a6966fdc7e1",
                                "sense_id": "f639bde6-3047-3c3d-a8c3-4136a84a9947",
                                "text": "On chouannait ensemble."
                            },
                            {
                                "example_id": "b96a5219-fc2c-470b-9f7b-e4485ffe0970",
                                "sense_id": "f639bde6-3047-3c3d-a8c3-4136a84a9947",
                                "text": "Tu chouannes encore, tu cours par les chemins comme une bête enragée qui cherche à mordre."
                            }
                        ]
                    }
                ],
