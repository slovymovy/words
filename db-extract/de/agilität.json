                "senses": [
                    {
                        "sense_id": "c09ac70b-9039-35ab-ad3d-fe2b1691bdb8",
                        "entry_id": "611d24ce-2706-3cdb-9a4a-c52902d3e527",
                        "glosses": [
                            "jene Eigenschaft, agil zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549e26b2-40d1-425d-96ff-5b99ab4a3e6c",
                                "sense_id": "c09ac70b-9039-35ab-ad3d-fe2b1691bdb8",
                                "text": "„Er erwies sich sogar als eine Persönlichkeit, die dem Dr. Schäufele in Beharrlichkeit und Agilität überlegen war.“"
                            },
                            {
                                "example_id": "2b52e865-0683-44c5-b52c-f7c79eb516d2",
                                "sense_id": "c09ac70b-9039-35ab-ad3d-fe2b1691bdb8",
                                "text": "Orthopädische Endoprothesen sorgen für Agilität im Alter."
                            },
                            {
                                "example_id": "99bade26-9a02-43eb-a701-4a21369c294a",
                                "sense_id": "c09ac70b-9039-35ab-ad3d-fe2b1691bdb8",
                                "text": "Jeder neue Panzer sollte die ursprüngliche Agilität des Kampfpanzers Leopards aufweisen."
                            },
                            {
                                "example_id": "6e81d30f-d272-4baf-a686-e5798b55115b",
                                "sense_id": "c09ac70b-9039-35ab-ad3d-fe2b1691bdb8",
                                "text": "Neben Empathie und Intuition ist auch Agilität im modernen Geschäftsleben unverzichtbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55a495ab-084d-4e08-b7f9-39f3df3d0803",
                        "source_entry_id": "611d24ce-2706-3cdb-9a4a-c52902d3e527",
                        "source_sense_id": "c09ac70b-9039-35ab-ad3d-fe2b1691bdb8",
