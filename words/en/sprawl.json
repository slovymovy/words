                            {
                                "target_lang_word": "простираться",
                                "target_lang_sense_clarification": "распространяться по поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d66e51dc-993f-391d-b623-6d435e46a23e",
                    "sense_definition": "To move the legs backward quickly to avoid a takedown in combat sports.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wrestler managed to <w>sprawl</w> just in time to stop the opponent's attack.",
                            "target_lang_translations": {
                                "ru": "Борцу удалось вовремя <w>отбросить ноги</w>, чтобы остановить атаку противника."
                            }
                        },
                        {
                            "text": "You must learn how to <w>sprawl</w> effectively to defend against a double-leg takedown.",
                            "target_lang_translations": {
                                "ru": "Нужно научиться эффективно <w>делать спрол</w> для защиты от прохода в обе ноги."
                            }
