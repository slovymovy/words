                "entry_id": "8ae5ff95-398c-3f01-aa15-67de496f4269",
                "word": "fretless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "040e8ee4-9407-3dcc-8b83-f5a3e7d68a89",
                        "entry_id": "8ae5ff95-398c-3f01-aa15-67de496f4269",
                        "glosses": [
                            "Of a stringed instrument, not having frets on the fingerboard."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d61e6355-99a5-326a-89c0-cbadf373ae4d",
                        "entry_id": "8ae5ff95-398c-3f01-aa15-67de496f4269",
                        "glosses": [
                            "Without worries."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7294d83e-5ccd-418b-bcf2-0420d0d6e254",
                                "sense_id": "d61e6355-99a5-326a-89c0-cbadf373ae4d",
                                "text": "You would live longer and happier if you would only be quiet and fretless."
                            },
                            {
                                "example_id": "2f6e31d4-97ae-4a16-a826-ac3e80b50d59",
                                "sense_id": "d61e6355-99a5-326a-89c0-cbadf373ae4d",
                                "text": "Will the fretless world be happy or will restless nature shout / For some old-time fret or worry just to rave and kick about?"
                            },
                            {
                                "example_id": "72241267-5c02-4aa4-a682-93c94a587e10",
                                "sense_id": "d61e6355-99a5-326a-89c0-cbadf373ae4d",
                                "text": "Is it not worth while to try and approximate, if we cannot hope to attain, the ideal of fretless, fussless, and unworrying poise?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "704f2539-0d38-423e-8298-54098b59ff64",
                        "source_entry_id": "8ae5ff95-398c-3f01-aa15-67de496f4269",
                        "source_sense_description": "(of an instrument) having no frets",
                        "target_lang_word": "безладовый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "безладовый",
