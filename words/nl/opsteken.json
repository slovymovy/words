{
    "word_family": [
        "steken",
        "opsteker",
        "afsteken",
        "insteken",
        "uitsteken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6131c981-6b93-3e8a-aa47-57209aaeff77",
                    "sense_definition": "iets nieuws leren of kennis vergaren uit een ervaring of situatie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "leren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb veel van die interessante cursus <w>opgestoken</w>.",
                            "target_lang_translations": {
                                "en": "I <w>learned</w> a lot from that interesting course."
                            }
                        },
                        {
                            "text": "Hij stak niets op van de lessen op school omdat hij niet oplette.",
                            "target_lang_translations": {
                                "en": "He didn't <w>pick up</w> anything from the lessons at school because he wasn't paying attention."
                            }
                        }
                    ],
                    "synonyms": [
                        "leren",
                        "oppikken",
                        "meekrijgen"
                    ],
                    "common_phrases": [
                        "veel opsteken van",
                        "iets opsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To learn something new or gain knowledge from an experience or situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to learn",
                                "target_lang_sense_clarification": "to acquire knowledge"
                            },
                            {
                                "target_lang_word": "to pick up",
                                "target_lang_sense_clarification": "to gain information or skills informally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb0b7819-3711-35ce-95b3-3ddabc5e4fbf",
                    "sense_definition": "iets aansteken om het te laten branden, meestal een sigaret, sigaar of kaars",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "branden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks zijn benauwdheid <w>stak</w> hij toch weer een sigaret <w>op</w>.",
                            "target_lang_translations": {
                                "en": "Despite his shortness of breath, he <w>lit up</w> a cigarette again anyway."
                            }
                        },
                        {
                            "text": "Zal ik de kaarsen in de woonkamer even <w>opsteken</w>?",
                            "target_lang_translations": {
                                "en": "Shall I <w>light</w> the candles in the living room?"
                            }
                        }
                    ],
                    "synonyms": [
                        "aansteken",
                        "ontsteken"
                    ],
                    "antonyms": [
                        "doven",
                        "uitmaken"
                    ],
                    "common_phrases": [
                        "een sigaret opsteken",
                        "een kaars opsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To light something so that it burns, usually a cigarette, cigar, or candle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to light",
                                "target_lang_sense_clarification": "to ignite a cigarette or candle"
                            },
                            {
                                "target_lang_word": "to light up",
                                "target_lang_sense_clarification": "to start smoking a cigarette"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cc8db65-74c8-3708-aab3-4e57681202f9",
                    "sense_definition": "iets omhoog brengen of vastzetten, zoals haar of een hand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "omhoog brengen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De chirurg stak haar haren op zodat die onder de operatiemuts pasten.",
                            "target_lang_translations": {
                                "en": "The surgeon <w>put up</w> her hair so that it fit under the surgical cap."
                            }
                        },
                        {
                            "text": "Je moet je hand <w>opsteken</w> als je een vraag wilt stellen.",
                            "target_lang_translations": {
                                "en": "You have to <w>raise</w> your hand if you want to ask a question."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhoogsteken"
                    ],
                    "antonyms": [
                        "laten hangen"
                    ],
                    "common_phrases": [
                        "haar opsteken",
                        "je hand opsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To raise something or fix it in an upward position, such as hair or a hand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to put up",
                                "target_lang_sense_clarification": "to style hair upwards"
                            },
                            {
                                "target_lang_word": "to raise",
                                "target_lang_sense_clarification": "to lift one's hand"
                            },
                            {
                                "target_lang_word": "to put up",
                                "target_lang_sense_clarification": "to raise one's hand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9ed20c8-cad8-3351-862f-911816b32e02",
                    "sense_definition": "het plotseling beginnen te waaien van de wind of het ontstaan van een storm",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de loop van de dag <w>stak</w> de storm <w>op</w> en begon het ook te regenen.",
                            "target_lang_translations": {
                                "en": "During the course of the day, the storm <w>picked up</w> and it also started to rain."
                            }
                        },
                        {
                            "text": "De zeilers waren bang dat er plotseling een harde wind zou <w>opsteken</w>.",
                            "target_lang_translations": {
                                "en": "The sailors were afraid that a strong wind would suddenly <w>rise</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opkomen",
                        "beginnen"
                    ],
                    "antonyms": [
                        "gaan liggen"
                    ],
                    "common_phrases": [
                        "de wind steekt op",
                        "een storm steekt op"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden starting of the wind or the emergence of a storm."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pick up",
                                "target_lang_sense_clarification": "of wind or storm, to increase in strength"
                            },
                            {
                                "target_lang_word": "to rise",
                                "target_lang_sense_clarification": "of wind, to start blowing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "758aff86-1cca-3059-853e-0915014ab944",
                    "sense_definition": "het zich plotseling voordoen of zichtbaar worden van iets, vaak negatiefs",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontstaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>staken</w> de nodige spanningen de kop <w>op</w> binnen de politieke partij.",
                            "target_lang_translations": {
                                "en": "Considerable tensions <w>reared their head</w> within the political party."
                            }
                        },
                        {
                            "text": "Zodra het kouder wordt, <w>steken</w> oude ziektes vaak weer de kop <w>op</w>.",
                            "target_lang_translations": {
                                "en": "As soon as it gets colder, old diseases often <w>crop up</w> again."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschijnen",
                        "ontstaan"
                    ],
                    "antonyms": [
                        "verdwijnen"
                    ],
                    "common_phrases": [
                        "de kop opsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden occurrence or becoming visible of something, often something negative."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to rear its head",
                                "target_lang_sense_clarification": "of problems or diseases, to appear"
                            },
                            {
                                "target_lang_word": "to crop up",
                                "target_lang_sense_clarification": "to appear unexpectedly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}