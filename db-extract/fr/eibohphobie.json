                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a220d28-370b-3d52-8bdc-23a75ddd9de1",
                                        "entry_id": "44b3f8cc-82fc-3e0e-9303-51270418340b",
                                        "glosses": [
                                            "An irrational fear of palindromes."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "nonce-word",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37ab87fc-e629-4d0c-bd8b-8a78bffc6275",
                                                "sense_id": "6a220d28-370b-3d52-8bdc-23a75ddd9de1",
                                                "text": "The article was a disservice to those of us who are unfortunate enough to be afflicted with aibohphobia."
                                            },
                                            {
                                                "example_id": "30ba1fc7-cc6c-417a-a35e-e67b3c15ae44",
                                                "sense_id": "6a220d28-370b-3d52-8bdc-23a75ddd9de1",
                                                "text": "We trust that we've relieved any Aibohphobia, any fear of palindromes that you might have harbored."
                                            },
                                            {
                                                "example_id": "728e34fc-259b-45b8-af60-5682f4e45456",
                                                "sense_id": "6a220d28-370b-3d52-8bdc-23a75ddd9de1",
                                                "text": "If you suffer from aibohphobia (fear of palindromes) you should skip a few pages while the rest of us go in search of[…]"
                                            },
                                            {
                                                "example_id": "4d2a4d05-07eb-47b5-ab69-f33e8fe89357",
                                                "sense_id": "6a220d28-370b-3d52-8bdc-23a75ddd9de1",
                                                "text": "We hope, however, that in passing this on we don't provoke any attacks of aibohphobia among our readers. This pallindrome, as Alan Lane discovered, means \"an abnormal and persistent fear of pallindromes\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
