                        },
                        {
                            "text": "Учитель был <w>приятно</w> удивлён нашими знаниями.",
                            "target_lang_translations": {
                                "en": "The teacher was <w>pleasantly</w> surprised by our knowledge.",
                                "zh": "老师对我们的知识水平感到<w>欣然</w>惊讶。",
                                "nl": "De leraar was <w>aangenaam</w> verrast door onze kennis.",
                                "pl": "Nauczyciel był <w>przyjemnie</w> zaskoczony naszą wiedzą.",
                                "de": "Der Lehrer war <w>angenehm</w> überrascht von unserem Wissen.",
                                "fr": "Le professeur a été <w>agréablement</w> surpris par nos connaissances.",
                                "it": "L'insegnante è rimasto <w>piacevolmente</w> sorpreso dalle nostre conoscenze.",
                                "cs": "Učitel byl <w>příjemně</w> překvapen našimi znalostmi.",
                                "tr": "Öğretmen, bilgilerimiz karşısında <w>hoş</w> bir şaşkınlık yaşadı.",
                                "es": "El profesor quedó <w>agradablemente</w> sorprendido por nuestros conocimientos."
                            }
