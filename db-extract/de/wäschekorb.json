                ],
                "senses": [
                    {
                        "sense_id": "2f99bca9-ccb2-3d4b-9bda-3c0deb8dca99",
                        "entry_id": "51d1082d-987e-382a-bda4-03615b1dcca3",
                        "glosses": [
                            "Behältnis für Kleidung, welche gereinigt werden soll oder bereits wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b76def0-903c-47b2-8de5-726913f9b073",
                                "sense_id": "2f99bca9-ccb2-3d4b-9bda-3c0deb8dca99",
                                "text": "\"Woanders habe ich sie nie gesehen. Einen Wäschekorb habe ich dann mal auf Borneo gekauft, eher lustlos und aus purer Sentimentalität. Er war bei weitem nicht so schön.\""
                            },
                            {
                                "example_id": "45945234-5d3e-4c38-81aa-8eaf0d3dd378",
                                "sense_id": "2f99bca9-ccb2-3d4b-9bda-3c0deb8dca99",
                                "text": "„Es gibt beim Plündern eine einzige Schranke, und sie allerdings wird zuverlässig eingehalten: Kein russischer Soldat hat meinen Wäschekorb mit Windeln und Babykleidung jemals angerührt; keiner hat ihn auch nur nach Konterbande der Erwachsenen durchwühlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb62da99-cd03-454f-8e4b-abe7015d7581",
                        "source_entry_id": "51d1082d-987e-382a-bda4-03615b1dcca3",
                        "source_sense_id": "2f99bca9-ccb2-3d4b-9bda-3c0deb8dca99",
                        "source_sense_description": "Behältnis für Kleidung, welche gereinigt werden soll oder bereits wurde",
                        "target_lang_word": "laundry basket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laundry basket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65102648-c6b4-3746-b8a4-a950ffc701bf",
                                        "entry_id": "d7e7eb72-8cb5-3a6d-b5b5-fdcd6fec297a",
                                        "glosses": [
                                            "A container, often made of plastic, for holding and transporting clothing and household textiles, especially before and after being laundered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e26614f-3e2e-4f57-ac8d-6d373d25e0ac",
                                                "sense_id": "65102648-c6b4-3746-b8a4-a950ffc701bf",
                                                "text": "Fortunately, Frank had devised a cool way of getting down the seemingly endless staircase. He’d found an old laundry basket, and with felt-tip pens had painted it with the colours of Queenie – red, white and blue. All he had to do was sit at the top of the staircase, and then let gravity take its course."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07dba095-071a-46a5-974a-b34b0ec7da96",
                        "source_entry_id": "51d1082d-987e-382a-bda4-03615b1dcca3",
                        "source_sense_id": "2f99bca9-ccb2-3d4b-9bda-3c0deb8dca99",
                        "source_sense_description": "Behältnis für Kleidung, welche gereinigt werden soll oder bereits wurde",
                        "target_lang_word": "panier à linge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panier à linge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a45cbccf-1762-3eed-b5f5-d186db639e90",
                                        "entry_id": "b0ed8e9a-15b6-36bc-953d-76edb885f0a0",
                                        "glosses": [
                                            "Panier utilisé pour la manipulation du linge qui va subir ou a déjà subi un lavage ou un séchage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bcfbdb-1f03-4883-93a7-734ef6ade634",
                                                "sense_id": "a45cbccf-1762-3eed-b5f5-d186db639e90",
                                                "text": "Il parcourut tout l’appartement pour faire l’inventaire. Il ne restait même pas son linge sale, ni le panier à linge sale. Les restes des pots de fleurs sur le parquet et la terre répandue, les racines mortes et les tiges archisèches des géraniums, la garniture de mousse synthétique d’un coussin crevé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
