                        "examples": [
                            {
                                "example_id": "2b153056-1774-4e98-a230-c3d021df25d4",
                                "sense_id": "82a3bcf7-d963-34f5-bbc1-cf2768ae179d",
                                "text": "In der Savanne wandern die Tiere immer dorthin, wo sie genügend frisches Gras finden.",
                                "translation": "Dans la savane, les animaux migrent toujours là où ils trouvent suffisamment d’herbe fraîche."
                            },
                            {
                                "example_id": "250ceaa3-e271-4167-bc51-619f6c535bff",
                                "sense_id": "82a3bcf7-d963-34f5-bbc1-cf2768ae179d",
                                "text": "Die Tierwelt der afrikanischen Savannen ist beeindruckend.",
                                "translation": "La faune de la savane africaine est impressionnante."
                            }
                        ]
