        "ru-extract.jsonl": [
            {
                "entry_id": "d0ff225b-5f6b-337f-8361-44c4fc43b477",
                "word": "Моргун",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cff55e80-9938-36da-8334-71a91379a025",
                        "entry_id": "d0ff225b-5f6b-337f-8361-44c4fc43b477",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bcd7b11-fc41-44b6-a0c7-452744715ee2",
                                "sense_id": "cff55e80-9938-36da-8334-71a91379a025",
                                "text": "Лётом влетает в круг Григорий Моргун, самый удалой молодец изо всех якимовских."
                            },
                            {
                                "example_id": "0139b841-382e-4da9-bc97-eef8ef9ae17f",
                                "sense_id": "cff55e80-9938-36da-8334-71a91379a025",
                                "text": "Пришли из ДОПРа Савелий Чепига, Моргун Савелий и Золотарь Павел. ❬…❭ Днём ходили прикреплённые к участкам по дворам и говорили[,] чтобы везли хлеб[;] по 2-му участку ходил Мачула Филип Алекс. и Моргун Николай Ив."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
