        "de-extract.jsonl": [
            {
                "entry_id": "d2ce32d7-183b-3371-9b58-4694641c530d",
                "word": "Durchsetzung",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "1530f1f9-bacf-47f6-ab93-11cc564cc0bd",
                        "entry_id": "d2ce32d7-183b-3371-9b58-4694641c530d",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "die Durchsetzung"
                    },
                    {
                        "form_id": "c5d78b56-ac00-47ef-9136-42a1e2eae3dd",
                        "entry_id": "d2ce32d7-183b-3371-9b58-4694641c530d",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Durchsetzung"
                    },
                    {
                        "form_id": "9ef9e9ee-43c3-4f44-88a1-91f7f76bd196",
                        "entry_id": "d2ce32d7-183b-3371-9b58-4694641c530d",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Durchsetzung"
                    },
                    {
                        "form_id": "c00283e6-cc04-4bcd-961e-d31af34bd3d2",
                        "entry_id": "d2ce32d7-183b-3371-9b58-4694641c530d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Durchsetzung"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8bf2c193-bdae-377d-9a9d-f69accd1394a",
                        "entry_id": "d2ce32d7-183b-3371-9b58-4694641c530d",
                        "glosses": [
                            "Verwirklichung von etwas, das man anstrebt, trotz eventueller Hindernisse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b4db3f-1b0c-4fec-b2e6-1c8d6229f135",
                                "sense_id": "8bf2c193-bdae-377d-9a9d-f69accd1394a",
                                "text": "Ihm war die Durchsetzung seiner persönlichen Ziele sehr wichtig."
                            },
                            {
                                "example_id": "c6b573b5-9a93-4612-befe-61e6fac7b5e5",
                                "sense_id": "8bf2c193-bdae-377d-9a9d-f69accd1394a",
                                "text": "„Thronfolger Karl VI. war der Sohn von Kaiser Leopold I., der ihn während des Spanischen Erbfolgekriegs zur Durchsetzung seiner Machtansprüche nach Spanien sandte.“"
                            },
                            {
                                "example_id": "8f4a0ff6-5346-40f1-a8ff-495f24d37df0",
                                "sense_id": "8bf2c193-bdae-377d-9a9d-f69accd1394a",
                                "text": "„Gegen den entschiedenen Widerspruch der Justizministerien wie der Großen Strafrechtskommission besaß das BKA nie eine reale Chance auf Durchsetzung seiner Vorstellungen.“"
                            },
                            {
                                "example_id": "85489790-de94-4fc1-a67c-9c737f6ad36f",
                                "sense_id": "8bf2c193-bdae-377d-9a9d-f69accd1394a",
                                "text": "„In ihrer Aufgabe, die Vernunft praktisch werden zu lassen, beruht die Politik für Leibniz nicht auf einem Interessenausgleich, sondern ihr Ziel ist die Durchsetzung einer als richtig und wahr erkannten Ordnung durch den Staat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3c228edc-8180-389f-9a2e-a8d581ee1bd9",
                        "entry_id": "d2ce32d7-183b-3371-9b58-4694641c530d",
                        "glosses": [
                            "Verbreitung von etwas (einer Sache, Methode, Meinung), sodass es mit der Zeit an Akzeptanz, Gültigkeit erlangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "808ecf55-aea4-4834-b9f3-a3a8b6884f7f",
                                "sense_id": "3c228edc-8180-389f-9a2e-a8d581ee1bd9",
                                "text": "„Die Herausbildung und Durchsetzung dieser Ideologie im 16. Jahrhundert nun vollzieht sich in einem Zweifrontenkrieg: gegen das alte Denken des Mittelalters, wie es in Katholizismus und Scholastik, volkstümlichen Glaubensformen und starrer sozialer Schichtung fixiert war […].“"
                            },
                            {
                                "example_id": "cb69dbc6-3b56-4c60-81c1-121db1483ddd",
                                "sense_id": "3c228edc-8180-389f-9a2e-a8d581ee1bd9",
                                "text": "„Seine Untersuchungen und entsprechende, von ihm angeregte Arbeiten spielten zweifellos die größte Rolle bei der Durchsetzung dieser Methode.“"
                            },
                            {
                                "example_id": "1334370a-3651-4e7d-a9e9-22cafcded5c3",
                                "sense_id": "3c228edc-8180-389f-9a2e-a8d581ee1bd9",
                                "text": "„Kernpunkt des Bekenntnisses ist die völlige Unterordnung der Muslime unter die Gesetze des Korans sowie die Verpflichtung eines jeden Einzelnen, die Durchsetzung dieser Gesetze in aller Welt mit allen Mitteln voranzutreiben.“"
                            },
                            {
                                "example_id": "f3e7235a-4468-490d-9f34-6ba8275502fa",
                                "sense_id": "3c228edc-8180-389f-9a2e-a8d581ee1bd9",
                                "text": "„Entscheidend war in Preußen nicht die Frage, ob eine staatliche Behörde die Kompetenz zur Durchsetzung der Regelungen hatte, sondern ob und wie diese Kompetenz überhaupt eingesetzt werden sollte.“"
                            },
                            {
                                "example_id": "c295bcff-ef23-4df5-bccb-e92f2824ba73",
                                "sense_id": "3c228edc-8180-389f-9a2e-a8d581ee1bd9",
                                "text": "„Ob und wie jene Zentren, in denen sich der für die Durchsetzung der neuen Produktionsweise entscheidende qualitative Sprung vollzieht, auch die politisch, d. h. im internationalen Kräfteverhältnis dominierenden Größen darstellen, ist allerdings nicht schematisch bestimmbar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
