    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6293a09b-5ee5-33b2-901e-69c08a4399c7",
                    "sense_definition": "rijdend een bepaalde ruimte of plaats binnengaan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "binnengaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is al bijna donker wanneer we de <w>stad</w> <w>inrijden</w>.",
                            "target_lang_translations": {
                                "en": "It is already almost dark when we <w>drive</w> <w>into</w> the <w>city</w>."
                            }
                        },
                        {
                            "text": "Veel automobilisten remmen plotseling af wanneer ze een donkere <w>tunnel</w> <w>inrijden</w>.",
                            "target_lang_translations": {
                                "en": "Many motorists brake suddenly when they <w>drive</w> <w>into</w> a dark <w>tunnel</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnenrijden"
                    ],
                    "antonyms": [
                        "uitrijden"
                    ],
                    "common_phrases": [
                        "een tunnel inrijden",
                        "de garage inrijden",
                        "de stad inrijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To enter a certain space or place while driving"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drive into",
                                "target_lang_sense_clarification": "entering a place by vehicle"
                            },
                            {
                                "target_lang_word": "to enter",
                                "target_lang_sense_clarification": "driving into a city or tunnel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0b92873-c776-3c24-ae34-0f50c7cb4fb7",
                    "sense_definition": "een nieuw voertuig of nieuwe motor voorzichtig gebruiken om deze geschikt te maken voor langdurig gebruik",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebruiksklaar maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet een nieuwe <w>auto</w> altijd voorzichtig <w>inrijden</w> tijdens de eerste duizend kilometer.",
                            "target_lang_translations": {
                                "en": "You should always <w>break</w> <w>in</w> a new <w>car</w> carefully during the first thousand kilometers."
                            }
                        },
                        {
                            "text": "De importeur <w>rijdt</w> de nieuwe <w>motoren</w> eerst <w>in</w> voordat ze verkocht worden.",
                            "target_lang_translations": {
                                "en": "The importer <w>runs</w> <w>in</w> the new <w>engines</w> first before they are sold."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een auto inrijden",
                        "een motor inrijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To use a new vehicle or engine carefully to make it suitable for long-term use"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to break in",
                                "target_lang_sense_clarification": "a new car or engine"
                            },
                            {
                                "target_lang_word": "to run in",
                                "target_lang_sense_clarification": "carefully using a new motor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e10daae-6f2e-3489-9c5f-aef633fc5b6c",
                    "sense_definition": "met een voertuig op iemand of iets afrijden, vaak met de bedoeling een botsing te veroorzaken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verwarde bestuurder <w>reed</w> met hoge snelheid <w>in</w> op de menigte.",
                            "target_lang_translations": {
                                "en": "The confused driver <w>drove</w> <w>into</w> the crowd at high speed."
                            }
                        },
                        {
                            "text": "De ridder <w>reed</w> tijdens het toernooi met zijn paard <w>in</w> op zijn tegenstander.",
                            "target_lang_translations": {
                                "en": "During the tournament, the knight <w>charged</w> <w>at</w> his opponent with his horse."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanrijden"
                    ],
                    "common_phrases": [
                        "inrijden op iemand",
                        "op de menigte inrijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To drive towards someone or something with a vehicle, often with the intention of causing a collision"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drive into",
                                "target_lang_sense_clarification": "crashing into a crowd or object"
                            },
                            {
                                "target_lang_word": "to ram",
                                "target_lang_sense_clarification": "intentionally hitting something with a vehicle"
                            },
                            {
                                "target_lang_word": "to charge at",
                                "target_lang_sense_clarification": "driving or riding towards an opponent"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}