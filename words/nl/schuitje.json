                    "sense_id": "3e70a01f-f4c7-3eae-ab3e-6ca9964fa04e",
                    "sense_definition": "Verkleinwoord van <w>schuit</w>; een kleine boot.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "boot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We voeren in een klein <w>schuitje</w> door de smalle grachten van de stad.",
                            "target_lang_translations": {
                                "en": "We sailed in a small <w>boat</w> through the narrow canals of the city."
                            }
                        },
                        {
                            "text": "Het houten <w>schuitje</w> lag rustig te dobberen aan de steiger.",
                            "target_lang_translations": {
                                "en": "The wooden <w>little boat</w> was floating quietly by the jetty."
                            }
                        }
                    ],
                    "synonyms": [
                        "bootje",
                        "scheepje"
                    ],
                    "common_phrases": [
                        "houten schuitje",
                        "klein schuitje"
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of 'schuit'; a small boat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "small boat",
                                "target_lang_sense_clarification": "a tiny watercraft"
                            },
                            {
                                "target_lang_word": "little boat",
                                "target_lang_sense_clarification": "a small vessel"
                            },
                            {
                                "target_lang_word": "skiff",
                                "target_lang_sense_clarification": "a light open boat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "624441da-dcea-3b5f-a997-4daa8c3ca4c8",
                    "sense_definition": "Houdertje voor de schietspoel in een weef- of naaimachine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "machineonderdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plaats de spoelhouder voorzichtig terug in het <w>schuitje</w> van de naaimachine.",
                            "target_lang_translations": {
                                "en": "Carefully place the bobbin case back into the <w>shuttle</w> of the sewing machine."
                            }
                        },
                        {
                            "text": "Bij oude weefgetouwen moet het <w>schuitje</w> handmatig worden gecontroleerd.",
                            "target_lang_translations": {
                                "en": "With old looms, the <w>shuttle</w> must be checked manually."
                            }
                        }
                    ],
                    "synonyms": [
