                    },
                    {
                        "translation_id": "b6dead80-511e-4503-97bb-4f5d83c2f4d9",
                        "source_entry_id": "e3698c34-e266-3839-88d9-dd337a18fcb3",
                        "source_sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                        "source_sense_description": "feeling or showing no shame, embarrassment or remorse",
                        "target_lang_word": "schamlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schamlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                        "entry_id": "f60c6356-4d27-3867-b037-fa8552696e3e",
                                        "glosses": [
                                            "ohne Schamgefühl, die sittlichen Grenzen, die Regeln des Anstands verletzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8cbce5-1c66-486b-bdb3-66997c89cacc",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Diesmal wird sogar schamlos geflirtet."
                                            },
                                            {
                                                "example_id": "9e1bf7ce-0826-4ac1-9ca5-c350730760b4",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Durch die schamlose Performance scheint das Flair von Homosexualität, Perversität im Hochglanz, öffentlich zur Schau gestellter Nacktheit, Erotik und Befriedigung, … als Normalität und wird als Fest der Toleranz, Freiheit und Liebe gepriesen."
                                            },
                                            {
                                                "example_id": "8f98d42f-5d7e-47d2-919a-141785ebcacb",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Wer seid Ihr, daß Ihr eine züchtige Frau, die, weiß Gott, nicht ihr freier Wille mit Euch zusammenführte, in Eure Arme zu fassen, ihr Ohr mit den schamlosen Anträgen roher Sinnlichkeit zu entweihen wagt?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                        "entry_id": "f60c6356-4d27-3867-b037-fa8552696e3e",
                                        "glosses": [
                                            "in der Handlungsweise die Rechte oder Gefühle anderer Menschen bewusst ignorierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dede07c-888a-4d20-a8cf-38bd8b760917",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Mit „Antikorruptionskampagnen“ versuchen sie jene Kader in den Griff zu bekommen, die sich schamlos bereichert haben – auch am Olympia-Projekt."
                                            },
                                            {
                                                "example_id": "be9803b6-fcf6-48ec-b74b-b220164bbe9a",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Die Farce erreichte ihren Gipfel, als Sudans Justizminister Reparationen für die Sklaverei forderte, während in seinem Land weiterhin schamlos Menschen versklavt werden."
                                            },
                                            {
                                                "example_id": "a992b06c-1b53-443a-a001-2b3922fefab8",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Der reiche Ausländer nutzt die Notsituation von Frauen und Kindern, die in Krisengebieten ums Überleben kämpfen, schamlos aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ffe5b11-ec0d-477e-bd65-ccadf2cca791",
                        "source_entry_id": "e3698c34-e266-3839-88d9-dd337a18fcb3",
                        "source_sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                        "source_sense_description": "feeling or showing no shame, embarrassment or remorse",
                        "target_lang_word": "unverhohlen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverhohlen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                        "entry_id": "79ce1ff6-7c7b-3e40-b9d5-f8647cd7f3b1",
                                        "glosses": [
                                            "sehr offen, klar und eindeutig"
                                        ],
                                        "tags": [
                                            "Kommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e581d0-46b4-48c8-9dcf-b66afb8ebfa5",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„All das ist ungeheuerlich - und es ist unverhohlener Rassismus.“"
                                            },
                                            {
                                                "example_id": "60b05682-ce15-4e35-abdb-8c047057c57e",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Ist es Ihnen manchmal mulmig zumute, wenn Sie sehen, wie unverhohlen antisemitisch die AfD in Deutschland auftritt?“"
                                            },
                                            {
                                                "example_id": "957c92b6-db82-42c9-a7a4-474156a2e100",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "[Neonazis:] „Häufig attackiert werden die Juden. In solchen Liedern finden sich teilweise unverhohlene Anspielungen auf den Massenmord in deutschen Konzentrationslagern während der Zeit des Nationalsozialismus.“"
                                            },
                                            {
                                                "example_id": "d211c3e5-9c58-4f9b-9114-c52a11a7908e",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Russlands Angriffskrieg geht weiter. Und Putin droht unverhohlen dem Westen.“"
                                            },
                                            {
                                                "example_id": "27ace281-7e37-40c7-ac24-348cc4ad57f3",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Peking betrachtet den demokratisch geführten Inselstaat als abtrünnige Provinz und droht immer unverhohlener mit einem militärischen Einmarsch.“"
                                            },
                                            {
                                                "example_id": "69eaa964-5009-434d-b6d1-d51e3e0e537b",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Das unverhohlen verkündete Ziel des Mullah-Regimes ist die Vernichtung Israels.“"
                                            },
                                            {
                                                "example_id": "5825a224-1ba5-4452-9b41-30eeedfcf1ea",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Beim offenen Narzissmus – dem klassischen, arroganten Narzissmus – wird die hohe Selbsteinschätzung ganz unverhohlen zur Schau gestellt.“"
                                            },
                                            {
                                                "example_id": "482a9a86-5465-4d59-a2f2-3a2bcdf34ae7",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "[Über Ex-Bundeskanzler G. Schröder:] „Immer mehr einfache SPD-Mitglieder fordern seit Tagen unverhohlen einen Parteiausschluss, einige Ortsverbände haben bereits entsprechende Anträge gestellt.“"
                                            },
                                            {
                                                "example_id": "18307e39-89ea-4af4-b69a-8e83bfc23e6e",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "[Über Jean-Luc Mélenchon:] „Die antidemokratischen Tendenzen zeigen sich auch in seiner unverhohlenen Bewunderung für Diktatoren wie Hugo Chávez oder in seiner Verteidigung der Krim-Annexion durch Putin im März 2014;“ […]."
                                            },
                                            {
                                                "example_id": "769fddea-f6a9-44f0-b2c6-7797a2922e42",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Kaum ein halbes Jahr ertrugen die nobiles in Rom ununterbrochen Caesars immer unverhohlenere monarchische Attitüde, bis sie ihn endlich töteten.“"
                                            },
                                            {
                                                "example_id": "f6238211-3675-4c2e-aadc-69b33ac7c418",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Mit seiner unverhohlen sexuellen Symbolik galt der Black Bottom als provokant und anstößig. Er hat sich als Modetanz nur kurze Zeit gehalten.“"
                                            },
                                            {
                                                "example_id": "85e52f20-18b8-4d7e-be77-47aaaff5458b",
                                                "sense_id": "0a697499-4e33-39e1-88de-29407ee50619",
                                                "text": "„Die Menschen traten zwischen Brettern und Vorhängen hervor und sahen ihnen mit unverhohlener Neugierde nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01c73e81-50a2-482c-ab03-93facc24b4e8",
                        "source_entry_id": "e3698c34-e266-3839-88d9-dd337a18fcb3",
                        "source_sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                        "source_sense_description": "feeling or showing no shame, embarrassment or remorse",
                        "target_lang_word": "ungeniert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungeniert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0b12eb1-3f2d-3033-92a5-ea1341b0a722",
                                        "entry_id": "6087e760-96e5-38b7-84fe-299e1af82d27",
                                        "glosses": [
                                            "ohne Zurückhaltung, ohne Scham"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc479a24-a4a8-4f17-a225-4fa18f6286e5",
                                                "sense_id": "c0b12eb1-3f2d-3033-92a5-ea1341b0a722",
                                                "text": "Er plauderte völlig ungeniert über die privatesten Dinge."
                                            },
                                            {
                                                "example_id": "9c991d62-66db-4fc4-b21e-b9b114841194",
                                                "sense_id": "c0b12eb1-3f2d-3033-92a5-ea1341b0a722",
                                                "text": "„Ist der Ruf erst ruiniert, managt’s sich ganz ungeniert.“"
                                            },
                                            {
                                                "example_id": "15efa6a1-6117-43bc-9f9b-750fd5963e9a",
                                                "sense_id": "c0b12eb1-3f2d-3033-92a5-ea1341b0a722",
                                                "text": "„Nun stand Serge im Badezimmer und musterte sie ungeniert.“"
                                            },
                                            {
                                                "example_id": "9cfaab92-ed3d-40aa-96e3-c30b6adeeb3c",
                                                "sense_id": "c0b12eb1-3f2d-3033-92a5-ea1341b0a722",
                                                "text": "„Es tat weh, aus Therons Mund zu hören, wie ungeniert Isabella mit ihm geflirtet hatte.“"
                                            },
                                            {
                                                "example_id": "6c36ffe6-abcb-4a60-ad99-6ce15d3fbea6",
                                                "sense_id": "c0b12eb1-3f2d-3033-92a5-ea1341b0a722",
                                                "text": "„Scheinbar ungeniert zog sie zum Beispiel über ihren Exmann her, über Wilhelm, der dem Wodka verfallen war und »fremde Weibchen geliebt« habe.“"
                                            },
                                            {
                                                "example_id": "5b806a36-0636-404a-99bc-1e8fbf950234",
                                                "sense_id": "c0b12eb1-3f2d-3033-92a5-ea1341b0a722",
                                                "text": "„Die Rentner starrten ungeniert auf Katharinas Beine, als sie aufstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
