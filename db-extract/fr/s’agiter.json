                                                "example_id": "20818e78-2bff-44c8-a882-44df52999b74",
                                                "sense_id": "a57b15a0-12dc-342f-83af-4d1e7b9e8791",
                                                "text": "Нам хотелось бы, подобно Иисусу Навину, сказать: стой, солнце, не движься!"
                                            }
                                        ]
                                    },
                                    {
