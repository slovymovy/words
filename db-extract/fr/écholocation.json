                                    {
                                        "sense_id": "5028a6e0-eed5-3d21-8e96-f8241030fca2",
                                        "entry_id": "1ff0988e-076f-3e12-ad18-0942ea5f8ed3",
                                        "glosses": [
                                            "metoda stosowana przez niektóre zwierzęta polegająca na określaniu położenia przeszkód lub poszukiwanych obiektów w otoczeniu z użyciem zjawiska echa akustycznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e77ea3b-4bf2-47fe-965b-5175594a7e6a",
                                                "sense_id": "5028a6e0-eed5-3d21-8e96-f8241030fca2",
                                                "text": "Niektóre nietoperze mają o wiele większą kontrolę nad echolokacją niż wcześniej sądzono."
                                            },
                                            {
                                                "example_id": "492c6779-d2d9-47f4-b8e5-acde53bb3f4b",
                                                "sense_id": "5028a6e0-eed5-3d21-8e96-f8241030fca2",
                                                "text": "W drugiej połowie XX wieku echolokacja została wykorzystana do czegoś więcej niż wykrywanie łodzi podwodnych i gór lodowych."
                                            }
                                        ],
