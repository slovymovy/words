                                "target_senses": [
                                    {
                                        "sense_id": "96b1d082-21f7-33a1-b182-171f4997c48e",
                                        "entry_id": "b5765816-ff6d-339b-9b0e-9906a6cdc79b",
                                        "glosses": [
                                            "ohne jede Bewegung, absolut ruhig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92cb4137-d367-4eaa-949b-509d3bbd48aa",
                                                "sense_id": "96b1d082-21f7-33a1-b182-171f4997c48e",
                                                "text": "Regungslos wartet der Jäger auf seinem Hochsitz, um nur ja kein Geräusch zu machen."
                                            },
                                            {
                                                "example_id": "1bfe0b83-f7e8-4353-a9f3-432278a1db40",
                                                "sense_id": "96b1d082-21f7-33a1-b182-171f4997c48e",
                                                "text": "Der israelische Schriftsteller [Etgar Keret] sitzt in einem Bostoner Café im blauen Freizeithemd und ausgewaschenen Jeans völlig regungslos auf einem Hocker, trinkt gemächlich seinen Tee und schaut ins Leere […]"
                                            },
                                            {
                                                "example_id": "1c8252b9-a45f-40a0-a64b-2e79a3b25b67",
                                                "sense_id": "96b1d082-21f7-33a1-b182-171f4997c48e",
                                                "text": "Bei der Verlesung der Anklage am Mittwoch war [Ratko] Mladić abwechselnd regungslos oder lächelte spöttisch."
                                            },
                                            {
                                                "example_id": "d35ba592-15c8-46a3-9e70-51049ce0b961",
                                                "sense_id": "96b1d082-21f7-33a1-b182-171f4997c48e",
                                                "text": "Wir drängten uns durch die Menge, um die Situation selber in Augenschein zu nehmen. In der Mitte lagen drei Leute regungslos, mit tiefen Schnittwunden am ganzen Körper."
                                            },
                                            {
                                                "example_id": "a6767dae-4fe2-4e4a-83a0-7440ddc4528c",
                                                "sense_id": "96b1d082-21f7-33a1-b182-171f4997c48e",
                                                "text": "Myanmar war auf der Konferenz durch seinen Ministerpräsidenten Thein Sein vertreten, der Beobachtern der Konferenz zufolge regungslos an der Zeremonie zur Unterzeichnung der Charta im Luxushotel Shangri La teilnahm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
