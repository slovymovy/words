                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a69373ed-19f3-35a7-a5cb-7448e0942ba2",
                                        "entry_id": "41b3a5f5-230f-3581-a480-9809403b7b77",
                                        "glosses": [
                                            "in starken Ausmaße negativ oder Entsetzen, Furcht hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa624fe-2317-4ccb-a3b5-363e2771fd91",
                                                "sense_id": "a69373ed-19f3-35a7-a5cb-7448e0942ba2",
                                                "text": "Das ist ja furchtbar."
                                            },
                                            {
                                                "example_id": "2d60eace-3d73-407d-8e00-1991b7fa6de6",
                                                "sense_id": "a69373ed-19f3-35a7-a5cb-7448e0942ba2",
                                                "text": "„Vor neun Jahrzehnten erlitt das bevölkerungsreichste, technisch fortgeschrittenste und fleißigste Land Kontinentaleuropas einen furchtbaren Rückschlag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
