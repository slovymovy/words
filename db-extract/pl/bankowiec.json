                                    {
                                        "sense_id": "5b028dbd-08e4-3db7-903b-3d7ed6c066c0",
                                        "entry_id": "6f2b3cd3-8ab0-3f9b-8368-ee439a35c377",
                                        "glosses": [
                                            "A vessel employed in the cod fishery on the banks of Newfoundland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a399fb2-3022-4eb5-90ca-06322fc896c8",
                                                "sense_id": "5b028dbd-08e4-3db7-903b-3d7ed6c066c0",
                                                "text": "May 20 1815, John Quincy Adams, letter to a merchant\nI think the 584 Bankers may be put down 36,540 tons, navigated by 4,627 men and boys"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c048aac0-ade1-322d-9383-ad7b67ff5c15",
                                        "entry_id": "6f2b3cd3-8ab0-3f9b-8368-ee439a35c377",
                                        "glosses": [
                                            "A ditcher; a drain digger."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6eb5bc1-7731-4036-af39-1aade836a185",
                                                "sense_id": "c048aac0-ade1-322d-9383-ad7b67ff5c15",
                                                "text": "But this was no storm, the bankers could have told him. It was break of the year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c03671f6-94c1-3b78-9941-3b3c426b9a31",
                                        "entry_id": "6f2b3cd3-8ab0-3f9b-8368-ee439a35c377",
