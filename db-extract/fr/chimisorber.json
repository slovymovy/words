                        "sense_id": "ea2e322b-bec8-3edc-a8f2-b22ac5d8af5e",
                        "entry_id": "fa485783-b37c-3b1f-921b-dd9d9ac9f060",
                        "glosses": [
                            "Absorber par réaction chimique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c663d3fb-7f32-44b2-907e-be2690b5510c",
                                "sense_id": "ea2e322b-bec8-3edc-a8f2-b22ac5d8af5e",
                                "text": "Pour qu'une molécule puisse se chimisorber, elle doit frapper un site vierge possédant un voisin libre."
                            },
                            {
                                "example_id": "e9b001f8-637c-46e4-aa30-acfa3dd1728a",
                                "sense_id": "ea2e322b-bec8-3edc-a8f2-b22ac5d8af5e",
                                "text": "Rappelons tout d'abord qu'un solide ne peut catalyser une réaction donnée que s'il est capable de chimisorber les réactifs;"
                            }
                        ]
                    }
