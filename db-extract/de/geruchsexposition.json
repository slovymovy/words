                "senses": [
                    {
                        "sense_id": "3175c9f1-6a6e-339f-9439-ab22ce5d0cf2",
                        "entry_id": "410e521f-db4f-3581-b587-b86af09eed05",
                        "glosses": [
                            "veränderte Geruchswahrnehmung oberhalb der eigentlichen Geruchsschwelle und die dann damit verbundenen Beschwerden; Überempfindlichkeit / Unterempfindlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98eff900-1316-4a2d-8347-28ddb4f41894",
                                "sense_id": "3175c9f1-6a6e-339f-9439-ab22ce5d0cf2",
                                "text": "„Bei Geruchsexposition kann es z.B. bei Patienten mit Bronchialasthma zur Verschlechterung oder triggerung des Zustandbildes kommen (Shusterman 2001; Haider et al.1994)“"
                            },
                            {
                                "example_id": "96d9415c-b247-435e-b129-aabab0119fc8",
                                "sense_id": "3175c9f1-6a6e-339f-9439-ab22ce5d0cf2",
                                "text": "„In der ersten Untersuchung sollte geklärt werden, ob das Konzept der „Geruchsstunde“ als Belastungsmaß geeignet ist, die Geruchsexposition unter Feldbedingungen repräsentativ zu erfassen.“"
                            },
                            {
                                "example_id": "3db6edc7-217a-4336-94d6-43ded44e51e7",
                                "sense_id": "3175c9f1-6a6e-339f-9439-ab22ce5d0cf2",
                                "text": "„So konnte gezeigt werden, daß vermehrte Geruchsexposition(odor enrichment), Pheromon-exposition und Schwangerschaft die OB Neurogenese stimulieren und das Geruchsgedächtnis, Paarungsverhalten, sowie die Brutpflege beeinflussen (Rochefort et al., 2002; Shingo et al., 2003; Mak et al., 2007).Entsprechend führt eine verminderte Geruchsexposition (olfactory deprivation) zu einer verminderten Zahl neu gebildeter Interneurone im OB (Corotto et al., 1994).“"
                            },
                            {
                                "example_id": "456e2b85-1a9b-419e-9805-43e7f2e0c0b6",
                                "sense_id": "3175c9f1-6a6e-339f-9439-ab22ce5d0cf2",
                                "text": "„Die dortige Geruchsexposition stamme aus dem Baumaterial: „Der Ofra-Bau selbst ist das Problem“, womit Rachle indirekt eine Sanierung ausschloss.“"
                            },
                            {
                                "example_id": "f56b5dae-83fb-4ccf-b41e-355713b4e3f4",
                                "sense_id": "3175c9f1-6a6e-339f-9439-ab22ce5d0cf2",
                                "text": "„Bei andauernder Geruchsexposition kommt es zu einer Sensibilitätsveränderung oder Adaptation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
