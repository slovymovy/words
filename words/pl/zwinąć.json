                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zwijanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kotek <w>zwinął</w> się w kłębuszek i zasnął na kanapie.",
                            "target_lang_translations": {
                                "ru": "Котенок <w>свернулся</w> клубочком и уснул на диване."
                            }
