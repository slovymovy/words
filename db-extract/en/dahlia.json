        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1e3d5e95-4ae4-35bc-8a78-c0e3c32a5078",
                "word": "Dahlia",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0922a371-6b39-37c6-b478-726d38874bc0",
                        "entry_id": "1e3d5e95-4ae4-35bc-8a78-c0e3c32a5078",
                        "glosses": [
                            "A female given name from English."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970ac927-f7d7-4ce3-958b-26eee2dcf4a7",
                                "sense_id": "0922a371-6b39-37c6-b478-726d38874bc0",
                                "text": "The girls' names were April, Corinne, Gloria, Susannah, and Dahlia. I thought these names fanciful and lovely and would have liked the daughters' looks to match them, as if they were the beautiful children of an ogre in a fairy tale."
                            },
                            {
                                "example_id": "73d59b19-4b91-4460-b023-6e7dda9e6f3f",
                                "sense_id": "0922a371-6b39-37c6-b478-726d38874bc0",
                                "text": "He was afraid that Delia or Della might mention a cousin named Dahlia, and he would laugh. Sweet Jesus, do not let me laugh inappropriately."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
