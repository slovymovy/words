                "senses": [
                    {
                        "sense_id": "c15bc7a6-c3c5-338d-ac1b-8f47d23c856a",
                        "entry_id": "3621974e-58ee-3e7e-9e92-1719a7cb7823",
                        "glosses": [
                            "noch nicht erwachsener Influencer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dca5df-bad5-45b9-a3a2-632027e8f95f",
                                "sense_id": "c15bc7a6-c3c5-338d-ac1b-8f47d23c856a",
                                "text": "„Wie bei erwachsenen Influencern kann auch bei Kidfluencern das gesamte Leben auf YouTube verfolgt werden.“"
                            },
                            {
                                "example_id": "ca062812-01fb-4938-95b1-1f1730f9296f",
                                "sense_id": "c15bc7a6-c3c5-338d-ac1b-8f47d23c856a",
                                "text": "„Bunt, fröhlich und oft ziemlich ungesund sind die unter Kindern sehr beliebten Inhalte sogenannter „Kidfluencer“ auf YouTube.“"
                            },
                            {
                                "example_id": "d71e34ea-bbc2-4014-89c4-5eeea0b24f87",
                                "sense_id": "c15bc7a6-c3c5-338d-ac1b-8f47d23c856a",
                                "text": "„Kidfluencer nennt man diese Trendsetter im Kindesalter, die in der Werbebranche als der nächste heiße Schrei gelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01bfb2bc-0c2e-4a86-a1f9-cf3d875221ae",
                        "source_entry_id": "3621974e-58ee-3e7e-9e92-1719a7cb7823",
                        "source_sense_id": "c15bc7a6-c3c5-338d-ac1b-8f47d23c856a",
                        "source_sense_description": "noch nicht erwachsener Influencer",
                        "target_lang_word": "kidfluencer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kidfluencer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ddf5747-d63c-3a93-acd0-782a5be92c69",
                                        "entry_id": "5338533d-0061-377c-a6a0-81bef45f344b",
                                        "glosses": [
                                            "A child who is an influencer."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df70c76f-7784-4928-b516-1dad09093e6b",
                                                "sense_id": "1ddf5747-d63c-3a93-acd0-782a5be92c69",
                                                "text": "In December, a 9-year-old kidfluencer known as Txunamy shared a photo on Instagram and asked her more than two million followers to comment on it and share their ages."
                                            },
                                            {
                                                "example_id": "54732fb5-5f1d-418b-b5dc-5fb5c9376b5e",
                                                "sense_id": "1ddf5747-d63c-3a93-acd0-782a5be92c69",
                                                "text": "Putting aside the obvious questions regarding infant privacy, just who exactly are these kidfluencers supposed to be kidfluencing?"
                                            },
                                            {
                                                "example_id": "f506a072-ae7b-4918-84a4-7242c8cff883",
                                                "sense_id": "1ddf5747-d63c-3a93-acd0-782a5be92c69",
                                                "text": "As a result, most “Kidfluencers” parents manage their accounts in order to sustain their online presence."
                                            },
                                            {
                                                "example_id": "7aef9749-a5f0-4e50-bc45-7f25eac6a2ee",
                                                "sense_id": "1ddf5747-d63c-3a93-acd0-782a5be92c69",
                                                "text": "Even though only a small number of kidfluencers are this successful, the prospect of earning a steady income has attracted many families to participate in the trend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
