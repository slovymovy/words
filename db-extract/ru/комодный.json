                ],
                "senses": [
                    {
                        "sense_id": "e815892b-cbca-3b2e-bf13-c51760e6524c",
                        "entry_id": "2398f146-42e5-3ee8-bc89-47d3885250f1",
                        "glosses": [
                            "принадлежащий комоду, свойственный комоду, либо имеющий к комоду иное непосредственное отношение. Пит развалился в кресле-качалке, водрузив ноги на выдвинутый комодный ящик."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cdf8ab4-2072-4ed0-a5f6-06cb625b38c8",
                        "source_entry_id": "2398f146-42e5-3ee8-bc89-47d3885250f1",
                        "source_sense_id": "e815892b-cbca-3b2e-bf13-c51760e6524c",
                        "target_lang_word": "bureau",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bureau",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f52c0e3-e376-31bd-9289-da9044eec695",
                                        "entry_id": "2eaebd23-9065-37f7-8cdd-502cd26d5127",
                                        "glosses": [
                                            "An administrative unit of government; office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be57b4b-e376-464f-b6a6-0355deaf1344",
                                                "sense_id": "4f52c0e3-e376-31bd-9289-da9044eec695",
                                                "text": "Ashley Johnson is an energy, trade and economics expert at the National Bureau of Asian Research, based in the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "877f4b10-fe25-30d7-ac3d-9f9e518c10b2",
                                        "entry_id": "2eaebd23-9065-37f7-8cdd-502cd26d5127",
                                        "glosses": [
                                            "An organization or office for collecting or providing information or news."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97dc4b9c-3178-4c78-ac28-247e5ec40ce8",
                                                "sense_id": "877f4b10-fe25-30d7-ac3d-9f9e518c10b2",
                                                "text": "a news bureau; a travel bureau; a service bureau; an employment bureau; the Citizens Advice Bureau"
                                            },
                                            {
                                                "example_id": "a8d573a6-09fa-4e89-8dda-fc0e3d578913",
                                                "sense_id": "877f4b10-fe25-30d7-ac3d-9f9e518c10b2",
                                                "text": "Newt Gingrich gives powerful testimony to the appeal of “the last word in content providership” — speakers’ bureaus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "befe2408-21c2-352c-83f2-c66975c2cb00",
                                        "entry_id": "2eaebd23-9065-37f7-8cdd-502cd26d5127",
                                        "glosses": [
                                            "An office (room where clerical or professional duties are performed)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841c68c6-af31-432a-a14e-b698790c98a7",
                                                "sense_id": "befe2408-21c2-352c-83f2-c66975c2cb00",
                                                "text": "There was an eerie silence in the dorm [... in] the factory. [...] The lamp glowed in his bureau, warm and reassuring and, through the window, I could see his papers strewn across the desk. [...] I called his name again. A movement from his bureau. [...] I banged on his door until it opened a crack[. ...] He pushed me out onto the staircase. \"Get out,\" he screamed. The door to his bureau slammed in my face."
                                            },
                                            {
                                                "example_id": "90a8390d-1a98-4c97-8eb6-3640010137a5",
                                                "sense_id": "befe2408-21c2-352c-83f2-c66975c2cb00",
                                                "text": "Both my ability to comprehend what is being said [in French] and my ability to fake comprehension have improved expeditiously. Monsieur holds the door open for me as we step inside his bureau. No one looks up as we enter. He offers me a seat, and when I fail to take it he returns to my side of the desk [...]."
                                            },
                                            {
                                                "example_id": "1b1884eb-92f9-405a-b250-04154cb455bb",
                                                "sense_id": "befe2408-21c2-352c-83f2-c66975c2cb00",
                                                "text": "Nick opened the bureau door and told Joan he was going to find Susan. He walked to the cafeteria, but it was empty. He went back to the bureau, and asked Joan to check the restrooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01256fe3-e919-3f71-adc1-5d4223bb7d29",
                                        "entry_id": "2eaebd23-9065-37f7-8cdd-502cd26d5127",
                                        "glosses": [
                                            "A desk, usually with a cover and compartments that are located above the level of the writing surface rather than underneath, and often used for storing papers."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0aeeeca9-2ae4-3eea-9e48-8440bc550d75",
                                        "entry_id": "2eaebd23-9065-37f7-8cdd-502cd26d5127",
                                        "glosses": [
                                            "A chest of drawers for clothes."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
