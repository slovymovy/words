                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c313be-9c26-409b-9c19-8aa1b1428a84",
                                "sense_id": "799249f6-eba7-381d-ac4f-ff56113f668a",
                                "text": "Vijf van de gedichten uit het schriftje verschenen in de debuutbundel van Reve, Terugkeer uit 1940, vier andere in Archief Reve (1981). Eén van de gedichten, Stad aan de Zuiderzee, is nooit gepubliceerd."
                            },
                            {
                                "example_id": "bb422e87-50dd-413d-9163-3bdd6b01c0be",
                                "sense_id": "799249f6-eba7-381d-ac4f-ff56113f668a",
                                "text": "J. Bernlef Schrijver J. Bernlef was een van de eersten die de debuutbundel 'Muizepoot' recenseerde."
                            },
                            {
                                "example_id": "0a6ca156-045d-4cf6-a009-2ab3c85d11b1",
                                "sense_id": "799249f6-eba7-381d-ac4f-ff56113f668a",
                                "text": "Heaney verloor op jonge leeftijd zijn beide ouders en groeide op bij een oom en tante. Hij werd leraar Engels in Belfast en begon een paar jaar later na een poëzieworkshop te schrijven. Zijn debuutbundel, 'Death of a Naturalist', met veel gedichten over zijn jeugd, werd meteen bekroond met vier prijzen."
                            }
                        ]
                    }
