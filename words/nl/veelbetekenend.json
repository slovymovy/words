                    "common_phrases": [
                        "veelbetekenende blik",
                        "veelbetekenende stilte",
                        "veelbetekenende glimlach"
                    ],
                    "target_lang_definitions": {
                        "en": "Rich in content but sparse in words, often conveying a hidden or deeper message."
                    },
                    "translations": {
