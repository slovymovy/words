                        "glosses": [
                            "een herinnering waard zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a58bd8f9-31fa-458b-bf1a-02e58ba9d54e",
                                "sense_id": "c767063a-bf43-39cb-bb5f-d2b51af45da6",
                                "text": "\"Gedenkwaardig, in de geschiedenis van de nederlandsche hervormde kerk, is dat jaar 1790.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d34e781d-9584-4de5-846e-ad6be408994d",
                        "source_entry_id": "9239b6da-c76c-3f69-8df1-b6db8b3e8fe7",
                        "source_sense_id": "c767063a-bf43-39cb-bb5f-d2b51af45da6",
                        "source_sense_description": "een herinnering waard zijn",
                        "target_lang_word": "memorable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "memorable",
