                "senses": [
                    {
                        "sense_id": "7281e223-dd0f-3047-a0dd-537146f1f046",
                        "entry_id": "457b6c90-f02c-3cc6-bf5a-8e1846b98419",
                        "glosses": [
                            "voortgaan met rijden; niet stoppen"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "9c413628-7982-4a41-9277-efa36ad9b989",
                                "sense_id": "7281e223-dd0f-3047-a0dd-537146f1f046",
                                "text": "De automobilist was na de aanrijding doorgereden, maar werd door de politie achterhaald."
                            },
                            {
                                "example_id": "c805e07a-d6c9-4f82-aba4-ea5555753fa5",
                                "sense_id": "7281e223-dd0f-3047-a0dd-537146f1f046",
                                "text": "Verkeer werd omgeleid via de A13 en A20. Rond 08.45 werd de tunnel in beide richtingen weer vrijgegeven. Na afloop stonden er nog flinke files van Rotterdam tot Rijswijk en van Spijkenisse tot Ridderkerk, maar inmiddels kan het meeste verkeer weer doorrijden."
                            }
                        ]
                    },
                    {
                        "sense_id": "631d9d09-aa74-3554-b25d-2d9e14c4bfe9",
                        "entry_id": "457b6c90-f02c-3cc6-bf5a-8e1846b98419",
                        "glosses": [
                            "sneller rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed17d203-32ab-4186-a317-8edbd8b7b672",
                                "sense_id": "631d9d09-aa74-3554-b25d-2d9e14c4bfe9",
                                "text": "Jan, rijd alsjeblieft een beetje door"
                            }
                        ]
                    },
                    {
