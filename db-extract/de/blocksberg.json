                "senses": [
                    {
                        "sense_id": "5aba857b-1176-36a6-b029-65161a9ce2e6",
                        "entry_id": "3357897a-579b-36cf-b701-697bc29425c9",
                        "glosses": [
                            "andere Bezeichnung für den Brocken, den höchsten Berg im Harz (meist im Zusammenhang mit dem Hexenwesen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f7613b6-8eee-41c4-ae99-0460e9fc2682",
                                "sense_id": "5aba857b-1176-36a6-b029-65161a9ce2e6",
                                "text": "„In unseren Breiten war das der Brocken oder Blocksberg.“"
                            },
                            {
                                "example_id": "77c5da48-745e-422c-aeaf-acc9e1cb62b9",
                                "sense_id": "5aba857b-1176-36a6-b029-65161a9ce2e6",
                                "text": "„MEPHISTOPHELES. Wenn ich euch auf dem Blocksberg finde,",
                                "translation": "Das find' ich gut; denn da gehört ihr hin.“"
                            },
                            {
                                "example_id": "652d94de-e91f-461e-b560-0fa2ea63e7e7",
                                "sense_id": "5aba857b-1176-36a6-b029-65161a9ce2e6",
                                "text": "„Natürlich hatten die Hexen aus allen deutschen Landen zum Sabbat auf den Blocksberg zu fahren.“"
                            },
                            {
                                "example_id": "767b929e-824e-4a0b-a8ec-87dbd9cf4d03",
                                "sense_id": "5aba857b-1176-36a6-b029-65161a9ce2e6",
                                "text": "„Die Nachtfahrt der Hexen auf den Blocksberg/Brockensberg exakt in die Walpurgisnacht zu legen, dokumentierte sich erst sehr spät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
