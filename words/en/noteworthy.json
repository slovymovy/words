{
    "word_family": [
        "note",
        "noteworthy",
        "noteworthiness",
        "worthy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc414d89-d8d5-36f0-a087-8c8b42265cc3",
                    "sense_definition": "Deserving attention or notice because of being important or interesting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist made a <w>noteworthy</w> discovery that could change how we treat the disease.",
                            "target_lang_translations": {
                                "ru": "Ученый сделал <w>заслуживающее внимания</w> открытие, которое может изменить способ лечения этой болезни."
                            }
                        },
                        {
                            "text": "There are several <w>noteworthy</w> features in this new software that users will find very helpful.",
                            "target_lang_translations": {
                                "ru": "В этом новом программном обеспечении есть несколько <w>примечательных</w> функций, которые пользователи сочтут очень полезными."
                            }
                        }
                    ],
                    "synonyms": [
                        "notable",
                        "eminent"
                    ],
                    "antonyms": [
                        "insignificant",
                        "unremarkable"
                    ],
                    "common_phrases": [
                        "noteworthy achievement",
                        "noteworthy feature",
                        "noteworthy example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий внимания или замечания в силу своей важности или интереса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заслуживающий внимания",
                                "target_lang_sense_clarification": "достойный того, чтобы его заметили"
                            },
                            {
                                "target_lang_word": "примечательный",
                                "target_lang_sense_clarification": "выделяющийся среди других"
                            },
                            {
                                "target_lang_word": "значительный",
                                "target_lang_sense_clarification": "важный по значению"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a6915c0-7e56-3648-b25b-df2db0b223fa",
                    "sense_definition": "A person who is famous, important, or prominent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gala was attended by local <w>noteworthies</w> and several international celebrities.",
                            "target_lang_translations": {
                                "ru": "На торжественном вечере присутствовали местные <w>высокопоставленные лица</w> и несколько мировых знаменитостей."
                            }
                        },
                        {
                            "text": "A collection of local <w>noteworthies</w> gathered at the town hall to discuss the new development project.",
                            "target_lang_translations": {
                                "ru": "Группа местных <w>видных деятелей</w> собралась в ратуше, чтобы обсудить новый проект развития."
                            }
                        }
                    ],
                    "synonyms": [
                        "notable",
                        "notable",
                        "eminent"
                    ],
                    "antonyms": [
                        "nobody"
                    ],
                    "common_phrases": [
                        "local noteworthies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который является знаменитым, важным или выдающимся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокопоставленное лицо",
                                "target_lang_sense_clarification": "человек, занимающий важное положение"
                            },
                            {
                                "target_lang_word": "знаменитость",
                                "target_lang_sense_clarification": "известный человек"
                            },
                            {
                                "target_lang_word": "видный деятель",
                                "target_lang_sense_clarification": "выдающийся представитель какой-либо сферы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}