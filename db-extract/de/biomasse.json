                    {
                        "sense_id": "fc1f1d8f-83ad-3377-86b0-3408ed326010",
                        "entry_id": "a6f97990-5075-3a1d-9568-04bda1d9723f",
                        "glosses": [
                            "gesamte organische Masse lebender oder toter Organismen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a4ebaa9-4b7f-44c0-b225-cce64ded01ba",
                                "sense_id": "fc1f1d8f-83ad-3377-86b0-3408ed326010",
                                "text": "Steppengräser bilden den Großteil ihrer Biomasse unter der Erde."
                            },
                            {
                                "example_id": "d73e44c0-d3a5-405f-aebb-86729f279e9d",
                                "sense_id": "fc1f1d8f-83ad-3377-86b0-3408ed326010",
                                "text": "Die Energiegewinnung aus Biomasse boomt."
                            },
                            {
                                "example_id": "855198ba-7797-4f36-a8fb-096f9bf937f5",
                                "sense_id": "fc1f1d8f-83ad-3377-86b0-3408ed326010",
                                "text": "„Pilze sind“ […] „heterotroph, das heißt, sie nutzen ebenso wie Tiere fremde Biomasse als Nahrungsquelle."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f1cc824-240e-4e99-aec1-63ff4a1351d1",
                        "source_entry_id": "a6f97990-5075-3a1d-9568-04bda1d9723f",
                        "source_sense_id": "fc1f1d8f-83ad-3377-86b0-3408ed326010",
                        "source_sense_description": "gesamte organische Masse lebender oder toter Organismen",
                        "target_lang_word": "生物质",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4cecb88a-188d-45fa-a178-844f967131da",
                        "source_entry_id": "a6f97990-5075-3a1d-9568-04bda1d9723f",
                        "source_sense_id": "fc1f1d8f-83ad-3377-86b0-3408ed326010",
                        "source_sense_description": "gesamte organische Masse lebender oder toter Organismen",
                        "target_lang_word": "biomass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biomass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b431a89-b8ae-392f-b1f9-3e8895ae58e5",
                                        "entry_id": "b63799a7-e067-332c-8f2b-a5c6e5798f1c",
                                        "glosses": [
                                            "The total mass of a living thing or a part thereof (such as a cell)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a6f34a-85f4-46c2-9842-57bc30b375e6",
                                                "sense_id": "8b431a89-b8ae-392f-b1f9-3e8895ae58e5",
                                                "text": "Since protein constitutes the majority of the biomass of a cell, building new protein is a major way that cells increase their size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2b4ad1d-84c1-35d6-84d1-544728311dfd",
                                        "entry_id": "b63799a7-e067-332c-8f2b-a5c6e5798f1c",
                                        "glosses": [
                                            "The total mass of all, or a specified category of, living things within a specific area, habitat, etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcf63673-132f-4d99-915e-467bd0439efa",
                                                "sense_id": "e2b4ad1d-84c1-35d6-84d1-544728311dfd",
                                                "text": "In the untouched Shangri-la-like Kingman Reef in the Line Islands in the central Pacific, sharks make up 75 per cent of the fish biomass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3dd8206-fc92-3518-83fc-d23b8aa09ce3",
                                        "entry_id": "b63799a7-e067-332c-8f2b-a5c6e5798f1c",
                                        "glosses": [
                                            "Organic matter from living things which were recently alive (especially vegetation) used as a fuel or source of energy, especially if cultivated for that purpose; also, fuel produced from such organic matter; biofuel."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1391569-104b-4b32-9872-3feb7c82a6fb",
                                                "sense_id": "b3dd8206-fc92-3518-83fc-d23b8aa09ce3",
                                                "text": "Advanced technologies such as gasifier/gas turbine systems for electric power generation and fuel cells for transportation make it possible for biomass to provide a substantial share of world energy in the decades ahead, at competitive costs."
                                            },
                                            {
                                                "example_id": "65f9316e-07a9-4e1c-9216-7e1b5402ef1d",
                                                "sense_id": "b3dd8206-fc92-3518-83fc-d23b8aa09ce3",
                                                "text": "Among the key contracts she works on is the supply of coal and biomass to Drax power station and extensive rail operations for British Steel."
                                            },
                                            {
                                                "example_id": "eac16dca-c597-4483-8237-7eab2f69a34e",
                                                "sense_id": "b3dd8206-fc92-3518-83fc-d23b8aa09ce3",
                                                "text": "All vegetation and tree stumps were sent to a local recycling facility to be turned into biomass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06fa620a-4b4a-4019-a2e3-a8c8e7c1e8bd",
                        "source_entry_id": "a6f97990-5075-3a1d-9568-04bda1d9723f",
                        "source_sense_id": "fc1f1d8f-83ad-3377-86b0-3408ed326010",
                        "source_sense_description": "gesamte organische Masse lebender oder toter Organismen",
                        "target_lang_word": "biomasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biomasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9707b8f0-9065-38d8-847a-7c0106253250",
                                        "entry_id": "077a917f-0a02-3a9d-a0f9-f40de9d5feb0",
                                        "glosses": [
                                            "Masse totale (quantité de matière) de toutes les espèces vivantes présentes en un milieu naturel donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2af08fa-d2e8-4c12-9901-283ad35cd4eb",
                                                "sense_id": "9707b8f0-9065-38d8-847a-7c0106253250",
                                                "text": "Au cours du 20ᵉ siècle, alors que la Baltique s’eutrophisait, la biomasse et les débarquements de trois espèces de poissons (la morue (Gadus morhua), le hareng et le sprat (Sprattus sprattus)) ont augmenté et la biomasse des mammifères marins (phoques (Halichoerus grypus, Phoca hispida), marsouins communs (Phocoena phocoena)) a diminué."
                                            },
                                            {
                                                "example_id": "24fc8b0a-453e-48fd-b11f-e243f6c9c5d4",
                                                "sense_id": "9707b8f0-9065-38d8-847a-7c0106253250",
                                                "text": "Lorsque l’irradiance relative augmente, le nombre d'espèces végétales augmente très rapidement. La plupart de celles susceptibles de se développer sur un site apparaissent pour une irradiance relative inférieure à 6 % (Guitton & Ruchaud, 1994). Pour une irradiance relative plus importante, le nombre d'espèces végétales augmente peu, mais c'est la biomasse végétale du sous-bois qui s'accroît."
                                            },
                                            {
                                                "example_id": "d1fcb7ba-eb6e-4c49-8fd1-c79e47d83a92",
                                                "sense_id": "9707b8f0-9065-38d8-847a-7c0106253250",
                                                "text": "« Depuis cette année 2003, il n’y a pas eu d’incendie catastrophique et on a perdu une certaine culture du feu », estime Mme Ganteaume. « Depuis vingt ans, on a perdu des surfaces agricoles et la forêt est plus dense, résultat, il y a plus de biomasse végétale disponible », ajoute-t-elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac2f13f4-cd42-3792-83a7-98442ac07f4a",
                                        "entry_id": "077a917f-0a02-3a9d-a0f9-f40de9d5feb0",
                                        "glosses": [
                                            "Ensemble de la matière organique pouvant fournir de l’énergie par dégradation."
                                        ],
                                        "tags": [
                                            "Énergie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a034d6a-ac62-4f17-81ca-17edf76dd4b7",
                                                "sense_id": "ac2f13f4-cd42-3792-83a7-98442ac07f4a",
                                                "text": "On parle alors de faciès sapropélique, terme provenant du grec sapros voulant dire « pourriture ». Même si la biomasse initiale a été fortement retravaillée par les bactéries, cette matière organique présente un bon potentiel pétrolier."
                                            },
                                            {
                                                "example_id": "23de3b9d-bb58-41d0-9685-3e86f532671f",
                                                "sense_id": "ac2f13f4-cd42-3792-83a7-98442ac07f4a",
                                                "text": "Pour que des combustibles ou matières soient considérés comme biomasse pure et soient soumis aux dispositions de surveillance et de déclaration simplifiées prévues au IV. de l’article 9, la fraction de la biomasse telle que définie ci-dessus doit être supérieure à 97%."
                                            },
                                            {
                                                "example_id": "8919008f-9b1a-439b-9356-ae5fcb2375e6",
                                                "sense_id": "ac2f13f4-cd42-3792-83a7-98442ac07f4a",
                                                "text": "Dans une étude publiée fin 2020 dans la revue Nature, des chercheurs de l’Institut Paul Scherrer (Suisse) tirent la sonnette d’alarme : les particules issues de la combustion de la biomasse, par leur potentiel oxydant, c’est-à-dire leur capacité à attaquer les cellules, seraient même plus toxiques que celles issues des gaz d’échappement des vieux véhicules diesel et essence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1b3293d-0240-4776-8979-1e043c41268e",
                        "source_entry_id": "a6f97990-5075-3a1d-9568-04bda1d9723f",
