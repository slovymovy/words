                        "translation_id": "d02ba9d1-6ce3-4c1f-a18b-35601e2f2234",
                        "source_entry_id": "2b8f7d97-e9e6-3d1b-9ce3-5182a8ab5c9d",
                        "source_sense_id": "380b73bd-c795-3ac4-ab7d-57d7fedaf1f8",
