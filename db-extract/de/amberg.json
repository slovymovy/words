                ],
                "senses": [
                    {
                        "sense_id": "4060c3ea-280e-395b-9b5f-63f529b3babe",
                        "entry_id": "fe200285-84f0-3c18-8d17-c0add14f296f",
                        "glosses": [
                            "deutscher Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c905bc-99e7-4d93-b25e-36eef014eef4",
                                "sense_id": "4060c3ea-280e-395b-9b5f-63f529b3babe",
                                "text": "Bei den Ambergs ist heute Richtfest."
                            },
                            {
                                "example_id": "9fa3946f-0c5a-4483-98dd-9a7749da3a10",
                                "sense_id": "4060c3ea-280e-395b-9b5f-63f529b3babe",
                                "text": "Ich traf Herrn Amberg mit seiner Freundin am Hafen."
                            },
                            {
                                "example_id": "ccaded80-1502-48a4-86c2-7a7168d7ecca",
                                "sense_id": "4060c3ea-280e-395b-9b5f-63f529b3babe",
                                "text": "Der junge Amberg soll in die Fußstapfen seiner Mutter treten und den Landmaschinenhandel übernehmen."
                            },
                            {
                                "example_id": "ed295424-d7df-4275-96a8-f7dda65244bb",
                                "sense_id": "4060c3ea-280e-395b-9b5f-63f529b3babe",
                                "text": "Die Kollegin Amberg hat leider in ihrem Elternhaus keine Manieren gelernt."
                            },
                            {
                                "example_id": "8e3f2753-9ba1-46c5-a2bd-41c64466d2ab",
                                "sense_id": "4060c3ea-280e-395b-9b5f-63f529b3babe",
                                "text": "Frau Amberg senior lebt nun im Seniorenstift."
                            },
                            {
                                "example_id": "d1481099-8c2e-4d1d-8288-e157141c21d7",
                                "sense_id": "4060c3ea-280e-395b-9b5f-63f529b3babe",
                                "text": "Herrn Ambergs Grab ist sehr verwildert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
