                        "translation_id": "196e7bbd-8845-4f3e-9d75-d29e24f4b520",
                        "source_entry_id": "333501b4-b2fe-3d9c-8a03-a8a07cac5d0b",
                        "source_sense_id": "55fd726a-5d9a-3979-9f76-1fa6f6f9d763",
                        "target_lang_word": "Zuckerbäckerin",
                        "target_lang_code": "de",
