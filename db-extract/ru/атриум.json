                                        "sense_id": "1bafac04-c9d5-303e-8cc0-5fe36a3e4398",
                                        "entry_id": "511cceb2-3557-3c1f-ba3c-850b10752a72",
                                        "glosses": [
                                            "A central room or space in ancient Roman homes, open to the sky in the middle; a similar space in other buildings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76ac22f2-0ef4-3526-9fab-d617796cf3f0",
                                        "entry_id": "511cceb2-3557-3c1f-ba3c-850b10752a72",
                                        "glosses": [
                                            "A square hall lit by daylight from above, into which rooms open at one or more levels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b821bf4-f684-3746-a687-dbfb071e9025",
                                        "entry_id": "511cceb2-3557-3c1f-ba3c-850b10752a72",
                                        "glosses": [
                                            "A cavity, entrance, or passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f87621f-b475-4e36-a9db-47508178308d",
                                                "sense_id": "9b821bf4-f684-3746-a687-dbfb071e9025",
                                                "text": "an atrium of the infundibula of the lungs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c78334-7c95-34a6-ae00-d5be259c7a4d",
                                        "entry_id": "511cceb2-3557-3c1f-ba3c-850b10752a72",
                                        "glosses": [
                                            "Any enclosed body cavity or chamber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b3fc3fc-8788-32ad-b344-e3d3d7e277d3",
                                        "entry_id": "511cceb2-3557-3c1f-ba3c-850b10752a72",
                                        "glosses": [
                                            "An upper chamber of the heart that receives blood from the veins and forces it into a ventricle. In higher vertebrates, the right atrium receives blood from the superior vena cava and inferior vena cava, and the left atrium receives blood from the left and right pulmonary veins."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29e9db2b-3ca4-3b74-bc5b-87999a3440b1",
                                        "entry_id": "511cceb2-3557-3c1f-ba3c-850b10752a72",
                                        "glosses": [
                                            "A microscopic air sac within a pulmonary alveolus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "232c1065-3b39-3e28-9466-4357e236a087",
                                        "entry_id": "511cceb2-3557-3c1f-ba3c-850b10752a72",
                                        "glosses": [
                                            "A cavity inside a porate aperture of a pollen grain formed by the separation of the sexine and nexine layers, widening toward the interior of the grain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adda2092-fc10-4ca2-a4f1-39f65c0d1188",
                                                "sense_id": "232c1065-3b39-3e28-9466-4357e236a087",
                                                "text": "Nexine 0.5μ thick, separating from the sexine about 5μ from the pore and forming a deep, well-defined atrium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
