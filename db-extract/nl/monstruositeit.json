                "senses": [
                    {
                        "sense_id": "a8e5ff08-e496-3316-822a-eb6d5b71c47c",
                        "entry_id": "2621670b-5a6c-3d6e-bd27-5ecfa6faf555",
                        "glosses": [
                            "iets dat gruwelijk lelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5f1dd03-27b0-4337-88d6-a4189f17cbeb",
                                "sense_id": "a8e5ff08-e496-3316-822a-eb6d5b71c47c",
                                "text": "Zelf heb ik thuis letterlijk een hele kast vol. Mijn man verzamelde jarenlang bij voorkeur de meest gruwelijke exemplaren. Hawaii-danseresjes, een plastic gondel en een mini-bergbaantje uit Oostenrijk, in combinatie met nog 387 andere monstruositeiten vormen ze toch een boeiend schouwspel."
                            },
                            {
                                "example_id": "80e3c712-212c-4372-b155-2bd7ee32a2f5",
                                "sense_id": "a8e5ff08-e496-3316-822a-eb6d5b71c47c",
                                "text": "De goede-smaakpolitie had het er weer druk mee de afgelopen week, met de cowboylaarssandaal. Een monstruositeit, het summum van slechte smaak, ‘het matje onder de schoenen’ zijn maar een paar van de bekeuringen die werden uitgedeeld aan dit hybride schoeisel. Is het dan werkelijk zo erg?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0bf78b2-90d5-4199-a4be-6c227bd66fc0",
                        "source_entry_id": "2621670b-5a6c-3d6e-bd27-5ecfa6faf555",
                        "source_sense_id": "a8e5ff08-e496-3316-822a-eb6d5b71c47c",
                        "source_sense_description": "iets dat gruwelijk lelijk is",
                        "target_lang_word": "monstrosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monstrosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3499d20d-f263-39bd-b1ba-c089cedc921b",
                                        "entry_id": "eb7f5d8c-5b67-3622-ac6a-8322df53d8b5",
                                        "glosses": [
                                            "An organism showing abnormal development or deformity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5acc2de2-3630-4077-9be5-72fc76ea5077",
                                                "sense_id": "3499d20d-f263-39bd-b1ba-c089cedc921b",
                                                "text": "Geoffroy St. Hilaire's experiments show that unnatural treatment of the embryo causes monstrosities; and monstrosities cannot be separated by any clear line of distinction from mere variations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30a3719c-4235-3faa-b872-299c6988da00",
                                        "entry_id": "eb7f5d8c-5b67-3622-ac6a-8322df53d8b5",
                                        "glosses": [
                                            "A monstrous person, thing, or act."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a77fcdd-47ff-4706-b1fa-af2a613396aa",
                                                "sense_id": "30a3719c-4235-3faa-b872-299c6988da00",
                                                "text": "St Enoch Centre (1989) - a glass-domed monstrosity of a shopping centre - stands on the site of the station today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd848810-ea76-33e9-a47b-88144234e15d",
                                        "entry_id": "eb7f5d8c-5b67-3622-ac6a-8322df53d8b5",
                                        "glosses": [
                                            "The state of being monstrous."
                                        ],
