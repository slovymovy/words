                        "glosses": [
                            "ruimte die speciaal is ingericht voor het maken en bewerken van geluidsopnames"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11a3ecfc-be44-4aa9-b49e-e86fe2ba2e06",
                                "sense_id": "85068264-ccd7-3494-853c-d0082fd6a9a7",
                                "text": "Martin Garrix (20) heeft geluidsstudio FC Walvisch in Amsterdam overgenomen. Dat heeft zijn management vandaag bekendgemaakt. De studio gaat straks verder onder de naam STMPD recording studios, vernoemd naar de platenmaatschappij van de wereldberoemde dj."
                            },
                            {
                                "example_id": "9bc1a21d-0acf-4060-9223-1a6d55db46a8",
                                "sense_id": "85068264-ccd7-3494-853c-d0082fd6a9a7",
                                "text": "Afgelopen zaterdag doken de dames de Needse geluidsstudio in om het koorwerk op te nemen. En zaterdagmiddag wordt vanaf 16.30 uur buiten bij de Hof van Eckberge in Eibergen de videoclip opgenomen."
                            },
                            {
                                "example_id": "a8ea04eb-c4da-47b4-b70e-ae57293bc5ed",
                                "sense_id": "85068264-ccd7-3494-853c-d0082fd6a9a7",
                                "text": "Vervolgens bepaalt de onderneming in deze variant op The Voice of Holland wie de grappigste, origineelste of opvallendste verkeersstem mag opnemen in een professionele geluidsstudio. \"We zoeken mensen met allerlei dialecten, accenten en identiteiten\", aldus TomTom-zegsman Lars Guns. De winnaar wordt 3 juli bekendgemaakt."
                            }
                        ]
                    }
