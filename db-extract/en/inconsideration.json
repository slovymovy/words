                        ],
                        "examples": [
                            {
                                "example_id": "258bba37-8b42-4ef9-91db-0ce45034a0bd",
                                "sense_id": "618b0c4b-1d42-3c68-96af-88dadde5df01",
                                "text": "new trained Souldiers, and such as are but novices in the trade, doe often headlong, and hand over head cast themselves into dangers, with more inconsideration, than afterward when they have seene and endured the first shocke, and are better trained in the schoole of perils."
                            },
                            {
                                "example_id": "9855b2fb-1a59-4648-b67c-da93a09bfd6a",
                                "sense_id": "618b0c4b-1d42-3c68-96af-88dadde5df01",
                                "text": "He had no leisure to explain himself further, nor Oriana, prepossessed as she was in favour of Philimore, to weigh the subject with that maturity it demanded:—fatal inconsideration, unbecoming Oriana! Her lover anxiously waiting her reply, she expressed her full consent, when her mother and sister joined her."
                            }
                        ]
                    }
