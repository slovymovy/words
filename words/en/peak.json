                                "target_lang_sense_clarification": "extrémité acérée"
                            },
                            {
                                "target_lang_word": "bout",
                                "target_lang_sense_clarification": "extrémité d'un objet"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尖端",
                                "target_lang_sense_clarification": "物体尖锐的末端"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84ffa842-14e7-3de6-a72d-3f057cfc7616",
                    "sense_definition": "The flat curved part at the front of a cap that sticks out to protect the eyes from the sun.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cap_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled the <w>peak</w> of his cap down to shield his eyes.",
                            "target_lang_translations": {
                                "ru": "Он натянул <w>козырёк</w> кепки, чтобы защитить глаза.",
                                "fr": "Il a abaissé la <w>visière</w> de sa casquette pour se protéger les yeux.",
                                "zh": "他拉下<w>帽檐</w>以遮挡阳光。"
                            }
                        },
                        {
                            "text": "The baseball cap has a stiff <w>peak</w>.",
                            "target_lang_translations": {
                                "ru": "У бейсболки жёсткий <w>козырёк</w>.",
                                "fr": "La casquette de baseball a une <w>visière</w> rigide.",
                                "zh": "这顶棒球帽有一个硬挺的<w>帽檐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "visor",
                        "bill"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская изогнутая часть спереди кепки, выступающая для защиты глаз от солнца.",
                        "fr": "La partie plate et incurvée à l'avant d'une casquette qui dépasse pour protéger les yeux du soleil.",
                        "zh": "帽子前部突出的扁平弯曲部分，用于遮挡阳光。"
                    },
                    "translations": {
                        "ru": [
