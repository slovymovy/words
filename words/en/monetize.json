{
    "word_family": [
        "money",
        "monetary",
        "monetization"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd82558c-5105-3b7c-a252-0303941580d9",
                    "sense_definition": "To make an activity or asset generate profit, especially online content or services.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many content creators look for ways to <w>monetize</w> their popular social media channels."
                        },
                        {
                            "text": "The company decided to <w>monetize</w> the website by displaying advertisements to all visitors."
                        }
                    ],
                    "synonyms": [
                        "commercialize"
                    ],
                    "antonyms": [
                        "demonetize"
                    ],
                    "common_phrases": [
                        "monetize content",
                        "monetize traffic"
                    ]
                },
                {
                    "sense_id": "df392fb9-59b0-33ab-8e7c-4a240c708426",
                    "sense_definition": "To convert an asset or security into legal currency.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government sought to <w>monetize</w> its debt by issuing new bonds to the central bank."
                        },
                        {
                            "text": "It is often difficult to <w>monetize</w> illiquid assets during a sudden financial crisis."
                        }
                    ]
                },
                {
                    "sense_id": "ffe884c9-fc9f-3a3e-8295-2652ec726441",
                    "sense_definition": "To officially establish a specific currency as legal tender.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new administration moved quickly to <w>monetize</w> the gold reserves to stabilize the economy."
                        },
                        {
                            "text": "The central bank had to <w>monetize</w> the new currency to ensure it was accepted for all public debts."
                        }
                    ]
                },
                {
                    "sense_id": "d873f8b6-9950-3c3e-9ba4-d9c106d54b33",
                    "sense_definition": "To produce or mint physical money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The state was granted the exclusive right to <w>monetize</w> precious metals into coins."
                        },
                        {
                            "text": "Historically, only the sovereign had the authority to <w>monetize</w> bullion."
                        }
                    ],
                    "synonyms": [
                        "mint"
                    ]
                }
            ]
        }
    ]
