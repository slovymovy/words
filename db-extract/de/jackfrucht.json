                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40031091-12e3-4735-9888-d9bfe28edd1a",
                                "sense_id": "39b9bac0-6466-3bf9-91fb-72e01d18cd08",
                                "text": "„Er mariniert rohen Fisch zu köstlichen Salaten, schnipselt die süße Kartoffel der Insel, zaubert würzige Garnelencurrys und preist die süße Jackfrucht.“"
                            }
                        ],
