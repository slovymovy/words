                        "entry_id": "d2432222-f497-30ce-bceb-d02f5792a924",
                        "glosses": [
                            "A small brick, typically made of charcoal and used for fuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da7064ea-16fd-43e2-b775-e8d40ed8c1f3",
                                "sense_id": "aaf6ef7c-dc99-323d-923d-47754e8571ec",
                                "text": "[…] an eggette or briquette manufacturing contract, where, by the compression of tar with these fine particles of culm, there are made pieces of coal about the size of an egg […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6c5f347-95e0-328c-8c26-d8034795256e",
                        "entry_id": "d2432222-f497-30ce-bceb-d02f5792a924",
                        "glosses": [
                            "A block of artificial stone in the form of a brick, used for paving."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "be2940e3-30d6-36a5-bd45-3ace89e1ecc4",
                        "entry_id": "d2432222-f497-30ce-bceb-d02f5792a924",
                        "glosses": [
                            "A molded sample of solidified cement or mortar for use as a test piece for showing the strength of the material."
