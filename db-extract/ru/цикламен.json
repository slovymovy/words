                        "source_sense_id": "16b2bdc5-91c8-3492-bc97-ae1dac1e263d",
                        "target_lang_word": "Alpenveilchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alpenveilchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9eefb181-9cba-34e3-a0f1-4f4414709522",
                                        "entry_id": "d298417f-f660-3702-a837-b78c0f5fa282",
                                        "glosses": [
                                            "Pflanzengattung aus der Unterfamilie der Myrsinengewächse (Myrsinaceae) innerhalb der Familie der Primelgewächse (Primulaceae) mit etwa zwanzig, vom Mittelmeer bis Zentralasien vorkommenden Arten"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a70502e6-367b-49e0-8fbf-84fbe60030be",
                                                "sense_id": "9eefb181-9cba-34e3-a0f1-4f4414709522",
                                                "text": "Alpenveilchen blühen rosarot bis violett und teilweise auch weiß."
                                            },
                                            {
                                                "example_id": "c08a0ab2-5df6-49df-8146-f91808318288",
                                                "sense_id": "9eefb181-9cba-34e3-a0f1-4f4414709522",
                                                "text": "Alpenveilchen gehören zu den beliebtesten Zimmerpflanzen in Europa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3d6c3b3-6d0a-37a8-9b7a-ad74361a7f4a",
                                        "entry_id": "d298417f-f660-3702-a837-b78c0f5fa282",
                                        "glosses": [
                                            "Zierpflanze als Vertreter der unter [1] beschriebenen Gattung (Cyclamen), mit großen, ründlichen bis herzförmigen Blättern und leuchtenden roten, rosa oder weißen Blüten, die an einzelnen langen, fleischigen Stängeln sitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c332ff89-1a0b-42e2-be46-db9410341ca5",
                                                "sense_id": "c3d6c3b3-6d0a-37a8-9b7a-ad74361a7f4a",
                                                "text": "Unsere Nachbarin hat uns ein großes Alpenveilchen geschenkt."
                                            },
                                            {
                                                "example_id": "be5fbed1-5aa5-433a-b7c1-3327864be335",
                                                "sense_id": "c3d6c3b3-6d0a-37a8-9b7a-ad74361a7f4a",
                                                "text": "„Warten Sie, ich bringe Ihnen ein paar Alpenveilchen.“"
                                            },
                                            {
                                                "example_id": "41ef8f37-14f9-44e6-9d33-0cf4ee4df43c",
                                                "sense_id": "c3d6c3b3-6d0a-37a8-9b7a-ad74361a7f4a",
                                                "text": "„Das Geburtstagstischchen wird abgeräumt: Alpenveilchen und Azaleen müssen verschwinden, und die Geburtstagsgeschenke werden aufs Vertiko gepackt, wo sie sich, wie wir wissen, in den Spiegeln verdreifachen.“"
                                            },
                                            {
                                                "example_id": "0ea83a07-1d57-40e6-acf6-482d6d7c2e11",
                                                "sense_id": "c3d6c3b3-6d0a-37a8-9b7a-ad74361a7f4a",
                                                "text": "„Jörg hatte an der Hand des Bürgermeisters gezappelt und kaum die Zähne auseinanderbekommen, um sich für das monströse Alpenveilchen zu bedanken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
