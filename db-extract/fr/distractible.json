                        "examples": [
                            {
                                "example_id": "a0d35e52-c64b-465f-9295-2e9a09044e48",
                                "sense_id": "bf1a53fd-49ef-3246-832b-833d2104633d",
                                "text": "Chez lui, la débilité mentale est évidente; il est en outre instable, distractible, irritable, vindicatif, sujet à des colères pathologiques."
                            },
                            {
                                "example_id": "4eec95ee-5f72-45e6-87f0-c662052a2bcd",
                                "sense_id": "bf1a53fd-49ef-3246-832b-833d2104633d",
                                "text": "Avec cette association attention-hyperactivité, l'enfant agité et l’adulte distractible sont susceptibles, à certaines conditions bien sûr, d'entrer dans le cadre du TDAH."
                            },
                            {
                                "example_id": "8f160b91-7f9c-490c-9753-3c38426eeb59",
                                "sense_id": "bf1a53fd-49ef-3246-832b-833d2104633d",
                                "text": "Les parents de ces enfants évaluent que leur tempérament est difficile, qu'ils s'adaptent lentement, qu'ils sont inconstants, qu'ils sont distractibles et qu'au total ils témoignent de peu de stratégies adaptatives en réponse à la frustration."
                            }
                        ]
