                    {
                        "translation_id": "86b8eff9-f108-4326-802f-6004075fd861",
                        "source_entry_id": "2fda26c6-f6b1-36cd-ad20-3ac2ac48e152",
                        "source_sense_id": "16448b23-d079-3cb7-a12c-74e379434bee",
                        "source_sense_description": "difficult to understand or explain; enigmatic or confusing; perplexing",
                        "target_lang_word": "rätselhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rätselhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                        "entry_id": "8817ece3-b5e4-3989-91b3-d9931ffcd7af",
                                        "glosses": [
                                            "so, dass etwas nicht verstanden wird: nicht durchschaubar, unverständlich, mit einem Rätsel behaftet; geheimnisvoll"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc296d22-2314-4805-91ba-8dce74c9d445",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "Ihr Charakter erschien mir damals schon rätselhaft."
                                            },
                                            {
                                                "example_id": "4a27a162-1766-4dda-9dbe-652d605e3687",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Getreu dem Spruch, Männer seien vom Mars und Frauen von der Venus, kommt uns das Verhalten des anderen Geschlechts tatsächlich oft rätselhaft vor.“"
                                            },
                                            {
                                                "example_id": "0da5496e-fa69-46f4-94f8-c93572284d94",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Australien – Wieder massenhaft Wale in Tasmanien gestrandet“ […] „Experten suchen nach einer Erklärung für das rätselhafte Phänomen.“"
                                            },
                                            {
                                                "example_id": "f2f887a7-5fdf-4dd6-857c-e9112f8c5613",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Seit Jahrzehnten suchen Sonnenforscher nach der Erklärung für ein rätselhaftes Phänomen: Wie kommt es, dass die Atmosphäre der Sonne bis zu fünfhundert Mal heißer ist als ihre Oberfläche?“"
                                            },
                                            {
                                                "example_id": "c3d00b05-5575-4f4a-9b37-0b87087634fe",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "[Coronapandemie 2022:] „Das Risiko der Wiederansteckungsgefahr bleibt noch an vielen Stellen rätselhaft. Fest steht aber: BA.2 verbreitet sich schnell.“"
                                            },
                                            {
                                                "example_id": "b66c024e-b42d-47fb-9969-a8c9d90a1f64",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Hepatitis bei Kindern - Woher kommen die rätselhaften Leberschäden?“"
                                            },
                                            {
                                                "example_id": "fa1aee8d-347b-47bb-b5ae-33ad4ce43147",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Schizophrenie ist eine ebenso furchteinflößende wie rätselhafte Krankheit.“"
                                            },
                                            {
                                                "example_id": "31d86a9c-5f7a-40c0-b15f-cd92fbcf856c",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Der Tod eines 14-jährigen Mädchens in Dietfurt (Lkr. Neumarkt) bleibt weiter rätselhaft.“"
                                            },
                                            {
                                                "example_id": "cbefd70b-e627-47e4-ad34-d4987bee2d40",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Die rumänische Luftwaffe hat gestern gleich zwei rätselhafte Unfälle nahe der ukrainischen Grenze hinnehmen müssen.“"
                                            },
                                            {
                                                "example_id": "5df99e47-3936-4cec-bedf-cdeac3cda95a",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„China macht verschwundenem Milliardär Xiao Jianhua den Prozess“ […] „Der vormals einflussreiche Geschäftsmann war Anfang 2017 unter rätselhaften Umständen aus Hongkongs Nobelhotel \"Four Seasons\" verschwunden,“ […]."
                                            },
                                            {
                                                "example_id": "fd28ae91-d1c2-4cfb-bdcd-087bc3050527",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Die böse Geschichte mit dem abgeschnittenen Ohr ist rätselhaft. Warum hat Van Gogh zum Rasiermesser gegriffen und sich selbst verstümmelt? Doch noch rätselhafter ist die Frage, warum er sich später auch noch eine Kugel in den Leib geschossen hat - am 27. Juli 1890.“"
                                            },
                                            {
                                                "example_id": "c594f3d0-b3f5-4f70-bbff-811c8fa566f6",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„Es war ein rätselhafter Einbruch: In der Nacht auf Weihnachten wurde aus einem Tierheim in Schöftland ein Kampfhund gestohlen.“"
                                            },
                                            {
                                                "example_id": "931574f5-bb5c-4f2a-856b-ed5b8241206d",
                                                "sense_id": "e869e7c1-a666-3cdf-b960-e14e36b3da28",
                                                "text": "„So sitzt er nun“ […] „in seinem stinkigen Büro und wartet auf einen Auftrag. Schon bald taucht dort eine Dame auf, rätselhaft und wunderschön.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
