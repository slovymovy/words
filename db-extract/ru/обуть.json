                "senses": [
                    {
                        "sense_id": "a4945bd7-1f4a-3eca-9d10-5c7f0efcbc19",
                        "entry_id": "8a737fbf-7b55-3a77-89a3-72ff46490586",
                        "glosses": [
                            "надеть на кого-либо обувь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b5525d-2c35-4045-a8ec-a94d4bad5e41",
                                "sense_id": "a4945bd7-1f4a-3eca-9d10-5c7f0efcbc19",
                                "text": "Сегодня холодно, надо обуть детей потеплее."
                            }
                        ]
                    },
                    {
                        "sense_id": "42aa5061-48f3-3e44-8ad1-c78a8b463908",
                        "entry_id": "8a737fbf-7b55-3a77-89a3-72ff46490586",
                        "glosses": [
                            "прост. надеть (об обуви)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4677e4e1-2d8e-4444-847a-0390083ce6a8",
                                "sense_id": "42aa5061-48f3-3e44-8ad1-c78a8b463908",
                                "text": "Лена переоделась в старое пальтишко, обула валенки и повязала голову платком."
                            }
                        ]
                    },
                    {
                        "sense_id": "c28c122a-b247-3c12-a42d-2cb35def88d4",
                        "entry_id": "8a737fbf-7b55-3a77-89a3-72ff46490586",
                        "glosses": [
                            "перен. купить, предоставить кому-либо обувь, обеспечить, снабдить кого-либо обувью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b4b51c-0120-4881-8e19-edcc7300a8ea",
                                "sense_id": "c28c122a-b247-3c12-a42d-2cb35def88d4",
                                "text": "Мы обуем всю страну (рекламный слоган)"
                            }
                        ]
                    },
                    {
                        "sense_id": "18bc26ec-4487-3246-90cc-666b5da6b6dd",
                        "entry_id": "8a737fbf-7b55-3a77-89a3-72ff46490586",
                        "glosses": [
                            "перен., жарг. обмануть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13d68ee7-1a49-4908-b216-08d09b553d3e",
                                "sense_id": "18bc26ec-4487-3246-90cc-666b5da6b6dd",
                                "text": "― Это значит, ― сообщил он Насте, ― что нас обули, как последних идиотов."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b3517b1-3cb4-36a2-beac-579027dbe78e",
                        "entry_id": "8a737fbf-7b55-3a77-89a3-72ff46490586",
                        "glosses": [
                            "перен., жарг., автомоб. установить на автомобиле покрышки"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
