                                    {
                                        "sense_id": "23365d4e-5469-3ab6-9d91-b8ae75ca47b0",
                                        "entry_id": "893800a1-d6e8-3a10-a40e-0641dca49b15",
                                        "glosses": [
                                            "ongeschreven recht: gewoonte recht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38257e35-c718-44b9-b148-abddee0e0974",
                                                "sense_id": "23365d4e-5469-3ab6-9d91-b8ae75ca47b0",
                                                "text": "Een dokter moet nuchter zijn werk doen, zonder sporen van drank of drugs in het lijf. Dat lijkt de normaalste zaak van de wereld, maar gold tot op heden slechts als ongeschreven regel. De artsenfederatie KNMG vond het nu toch wel eens tijd om dit uitgangspunt formeel op te nemen in de eigengedragsregels."
                                            },
                                            {
                                                "example_id": "1a4e32ce-83d0-45ae-90cf-9d6a9fab1a1b",
                                                "sense_id": "23365d4e-5469-3ab6-9d91-b8ae75ca47b0",
                                                "text": "Ik vond het ook heel benauwend, al die ongeschreven regels waaraan je je moet houden terwijl niemand weet waarom eigenlijk. Veel van mijn vrienden zijn allemaal eigenzinnige persoonlijkheden, mensen die echt zichzelf durven te zijn, met heel afwijkende meningen."
                                            },
                                            {
                                                "example_id": "8b579a02-7006-40e9-b90f-1ab1cb2e849e",
                                                "sense_id": "23365d4e-5469-3ab6-9d91-b8ae75ca47b0",
                                                "text": "Bij grote rampspoed geldt in Nederland het ongeschreven staatsnoodrecht. Dan komen ambtenaren van Defensie, de NCTV en andere ministeries voor crisisberaad bijeen."
                                            }
                                        ]
                                    }
                                ]
                            }
