                        "examples": [
                            {
                                "example_id": "698e42e7-e12f-4db6-8225-a6a88fffbff0",
                                "sense_id": "d810800f-59ed-39ff-9b4f-d2e7c5efc914",
                                "text": "Knowing the stubbornness and adamancy of born-again Christians, they're more likely to write off Borhek off as \"fallen,\" and accuse her of succumbing to the arguments of Satan."
                            },
                            {
                                "example_id": "8a0c2db6-850e-4311-a327-bf6507531f33",
                                "sense_id": "d810800f-59ed-39ff-9b4f-d2e7c5efc914",
                                "text": "I stuck my nose in the air, realizing too late that it was a borrowed gesture – one I’d been using for years in moments of pride or adamancy – and that it properly belonged to the woman sitting opposite me."
                            }
                        ]
