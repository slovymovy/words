                                "target_senses": [
                                    {
                                        "sense_id": "1377b3f7-a430-3a5e-a26c-5986702df4ce",
                                        "entry_id": "af74e27a-9bdd-3efe-ae5f-226f792dc34f",
                                        "glosses": [
                                            "land in het westen van Europa, grenzend aan Duitsland en België, belangrijkste deel van het Koninkrijk der Nederlanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cef3f0-abd4-4e23-b218-5b5a2856825a",
                                                "sense_id": "1377b3f7-a430-3a5e-a26c-5986702df4ce",
                                                "text": "Nederland is wereldberoemd om zijn windmolens en klompen."
                                            },
                                            {
                                                "example_id": "bcc62fdb-d7b6-4658-97a1-69010301ad29",
                                                "sense_id": "1377b3f7-a430-3a5e-a26c-5986702df4ce",
                                                "text": "Nederland was in de jaren vijftig een verzuild land."
                                            },
                                            {
                                                "example_id": "0aaefef4-c469-4eaf-9ec1-39e0d2f3aa1e",
                                                "sense_id": "1377b3f7-a430-3a5e-a26c-5986702df4ce",
                                                "text": "\"Wat hij heeft bereikt, heeft niemand in Nederland bereikt. Heel gastronomisch Nederland keek tegen hem op\", zegt Laurent Smallegange van restaurant Spetters."
                                            },
                                            {
                                                "example_id": "7a55ed31-d0f3-4ed6-97c5-4c0f4ca3e6e7",
                                                "sense_id": "1377b3f7-a430-3a5e-a26c-5986702df4ce",
                                                "text": "In de lucht cirkelde een helikopter. Het leek wel een scène uit een film. Wat een land, zo anders dan mijn veilige, kleine Nederland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
