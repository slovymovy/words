                "senses": [
                    {
                        "sense_id": "e51c34eb-752b-3a28-afd1-c15f3b5e628b",
                        "entry_id": "ca49b25f-9a3b-3d79-88b0-37c01ce8d92e",
                        "glosses": [
                            "хим. химический элемент с атомным номером 66, обозначается химическим символом Dy, редкоземельный металл"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73653df2-9282-4de0-9415-ae7282fda6b7",
                                "sense_id": "e51c34eb-752b-3a28-afd1-c15f3b5e628b",
                                "text": "Постоянные магниты на основе неодима и диспрозия являются более мощными, чем все предыдущие, и их производство требует меньших затрат."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38115410-8ace-4a90-ad8e-c4d86d3b9e36",
                        "source_entry_id": "ca49b25f-9a3b-3d79-88b0-37c01ce8d92e",
                        "source_sense_id": "e51c34eb-752b-3a28-afd1-c15f3b5e628b",
                        "target_lang_word": "dysprosium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysprosium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f97fe51-f724-3430-9219-803d30f7a997",
                                        "entry_id": "e152602a-ae89-33dc-b3ce-4cc8451d2ada",
                                        "glosses": [
                                            "A metallic chemical element (symbol Dy) with atomic number 66: a rare earth element with a metallic silver lustre. Applications in human affairs include magnets with high performance, which are important in various machines with electric motors."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "939fc33d-83fa-4679-8e58-1b1e609502bd",
                                                "sense_id": "8f97fe51-f724-3430-9219-803d30f7a997",
                                                "text": "Caught in the middle of the U.S.-China trade war is a Chiclet-size magnet that is vital to every new electric vehicle on the road. The magnet is made with dysprosium. Atomic number 66. A rare-earth mineral with a silver metallic luster. More than 90% of refined dysprosium comes from China, and it is used in magnets that power everything from medical equipment to EV motors. In its retaliation against U.S. tariffs, China slowed exports of several rare-earth minerals and magnets this month, setting off a panic among U.S. automakers. “You cannot build the motor without the magnet,” said a senior automotive executive. “If we want electric-vehicle production to continue to happen in the United States, this has to be solved.”"
                                            },
                                            {
                                                "example_id": "26ee181b-29a9-48cc-8aef-64fbb2ff3298",
                                                "sense_id": "8f97fe51-f724-3430-9219-803d30f7a997",
                                                "text": "Myanmar is the world's third-largest source of rare earths after China and the US, and last year it accounted for almost half of the global mining of two especially important elements: dysprosium and terbium, which are essential for electric vehicles, wind turbines and certain military gear. […] The most important application of dysprosium and terbium, which belong to a subgroup known as the heavy rare earths, is in devices called neodymium boron magnets, or neo magnets for short. In small quantities, dysprosium and terbium allow neo magnets to operate at far higher temperatures than they otherwise could. Thus improved, they're key components in the drivetrains of EVs; the stronger the magnets, the more efficient an electric motor can be. They can also enhance the rotation of wind turbines and are used in the precision targeting systems of missiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
