                "senses": [
                    {
                        "sense_id": "2059be7f-a0b8-3403-b1b5-0ec77587ebc0",
                        "entry_id": "f14d77a7-f1a9-39a3-a0bc-fade9d610d5b",
                        "glosses": [
                            "in Kristallen die gesetzmäßige Anordnung von Atomen, Ionen oder Molekülen zu einem dreidimensionalen Aufbau"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "25a69930-7519-4f92-b406-67370f5ff885",
                                "sense_id": "2059be7f-a0b8-3403-b1b5-0ec77587ebc0",
                                "text": "„Unter der Systematik der Minerale versteht man eine nach chemischer Zusammensetzung und Kristallstruktur sortierte Liste aller bekannten Mineralarten.“"
                            },
                            {
                                "example_id": "cc2300b6-8ba5-4758-b0e4-d271e396fc9d",
                                "sense_id": "2059be7f-a0b8-3403-b1b5-0ec77587ebc0",
                                "text": "„Mit den bis dahin bekannten Hochtemperatur-Supraleitern auf Kupferbasis hat die neue Materialklasse vieles gemeinsam: Die Kristallstruktur ist in Schichten aufgebaut, in denen der Strom fließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
