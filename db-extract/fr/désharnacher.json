                "senses": [
                    {
                        "sense_id": "dad205d3-4699-33c6-a35a-f3a298a80c7a",
                        "entry_id": "54f348ba-f01f-3055-8f77-accedaf4fca5",
                        "glosses": [
                            "Variante de déharnacher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba903fb-f40e-4b16-aeb9-19bbbe5e29d8",
                                "sense_id": "dad205d3-4699-33c6-a35a-f3a298a80c7a",
                                "text": "Il y eut du bruit dans l'étable où le paysan désharnacha son cheval, en lui parlant haut, et lui donna son avoine ; mais le petit Amadou resta plongé dans le sommeil."
                            },
                            {
                                "example_id": "a236e577-7267-4dfa-90b3-35d47ea88e7a",
                                "sense_id": "dad205d3-4699-33c6-a35a-f3a298a80c7a",
                                "text": "Son amour-propre, toujours si sensible frémit à la lecture du conseil qui lui est donné de désharnacher les éléphants d’Hannibal."
                            },
                            {
                                "example_id": "97001e27-a260-4a66-bed7-dbe7d2087472",
                                "sense_id": "dad205d3-4699-33c6-a35a-f3a298a80c7a",
                                "text": "Semer dans les sillons délétères ou désharnacher son cheval ?"
                            }
                        ]
                    }
