                                        "sense_id": "174d044a-ea20-3705-a794-bbe81b92f78a",
                                        "entry_id": "6e68f843-e0a5-3755-9176-7e4dad6029c9",
                                        "glosses": [
                                            "Distinguishing a particular sense of word."
                                        ],
                                        "tags": [
                                            "of sounds"
