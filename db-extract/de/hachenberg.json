                ],
                "senses": [
                    {
                        "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                        "entry_id": "d18a9a09-ae4a-3a5b-9150-9724146ed8a0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf538ad-792e-4c1b-8abc-a92289f467d4",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "Frau Hachenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b8f5b6fe-3f8c-4011-9b83-cf97a76eee92",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "Herr Hachenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ec0b462d-e6e6-4055-87e9-836afe7e51ab",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "Die Hachenbergs kommen heute aus Speyer."
                            },
                            {
                                "example_id": "a48d365c-2101-4f56-b298-ffa8d3ceac55",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "Der Hachenberg trägt nie die Schals, die die Hachenberg ihm strickt."
                            },
                            {
                                "example_id": "f731ba6f-f068-462e-9ed8-ebd9b568ecfb",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hachenberg kommt, geht der Herr Hachenberg.“"
                            },
                            {
                                "example_id": "4f01f326-0ce9-4895-bddc-34fda00bb63b",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "Hachenberg kommt und geht."
                            },
                            {
                                "example_id": "8e445283-66fe-46fb-8ebe-1ab95ba6e02c",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "Hachenbergs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e5b9bc0d-b263-4868-9514-072c5865b02b",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "An verregneten Herbsttagen ist Familie Hachenbergs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "b4d1c982-b09a-45cb-b18c-178285313d14",
                                "sense_id": "94fc28cb-6927-36c7-9f04-cf570f6319d3",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hachenberg das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
