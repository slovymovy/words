                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd3065da-362b-42cc-84aa-69496345eeaa",
                                "sense_id": "f16eb8cb-6b7c-372f-a647-41817877408a",
                                "text": "Anette V. arbeitet seit zwei Jahren als Kranführerin auf der Großbaustelle am neuen Flughafen in Berlin."
                            },
                            {
                                "example_id": "5a4d2d50-0541-41b6-9e4f-f3384ae8fafe",
                                "sense_id": "f16eb8cb-6b7c-372f-a647-41817877408a",
                                "text": "„Erika W. ist eine Frau und der Kran ist ihr Arbeitsplatz. Kranführerin war sie nicht immer.“"
                            },
                            {
                                "example_id": "92fcdc6f-a8c3-4392-8083-1bf25efdd53e",
                                "sense_id": "f16eb8cb-6b7c-372f-a647-41817877408a",
                                "text": "„Übernahmen Firmen aus dem Westen Betriebe aus dem Osten, so kam es den neuen Chefs gar nicht in den Sinn, eine Frau als Kranführerin anzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
