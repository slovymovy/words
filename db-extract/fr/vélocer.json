                ],
                "senses": [
                    {
                        "sense_id": "affc9709-e212-323a-8a4e-45b5a0e6916b",
                        "entry_id": "dd6821f3-8061-32e0-ab21-05bea9fd6245",
                        "glosses": [
                            "Faire du vélo."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "79c1bca6-2e99-4516-a9de-6a819942c49c",
                                "sense_id": "affc9709-e212-323a-8a4e-45b5a0e6916b",
                                "text": "Plus on véloce plus on se sent à l’aise et plus on veut vélocer."
                            },
                            {
                                "example_id": "6128307b-edc5-4790-8fbc-8bac94e2e221",
                                "sense_id": "affc9709-e212-323a-8a4e-45b5a0e6916b",
                                "text": "La bonne humeur et l’appétit ne vélocent-ils pas de conserve avec les cyclistes ?"
                            },
                            {
                                "example_id": "ac7c9f32-a831-4b6b-b171-dce58fc3f789",
                                "sense_id": "affc9709-e212-323a-8a4e-45b5a0e6916b",
                                "text": "Une chose à remarquer, c’est que plus on a vélocé et plus modérément on marche."
                            },
                            {
                                "example_id": "e39d82a7-4d37-4c49-958c-41ffcbd91017",
                                "sense_id": "affc9709-e212-323a-8a4e-45b5a0e6916b",
                                "text": "La dame bicyclette, avec laquelle ils avaient simplement l’intention de caqueter, vit leur conquête définitive et, l’exemple de ces novateurs étant suivi, on véloça avec passion, avec enthousiasme."
                            },
                            {
                                "example_id": "eae194b7-ead7-4be2-a9a1-5f04765ac5fa",
                                "sense_id": "affc9709-e212-323a-8a4e-45b5a0e6916b",
                                "text": "Dèux vélocipédistes ne peuvent vélocer de front, ni aller à une allure autre que modérée en croisant des attelages ; ils doivent enfin avertir les passants qu’ils vont atteindre et dépasser. Tout contrevenant à ce règlement est passible d’une amende de 75 francs ou quinze jours de prison."
                            },
                            {
                                "example_id": "4d4c8242-6c53-409e-bc98-5348688fb4be",
                                "sense_id": "affc9709-e212-323a-8a4e-45b5a0e6916b",
                                "text": "On avait vélocé sur l’eau et sur la glace : on voulut vélocer dans l'air ; mais la difficulté était autrement redoutable !"
                            }
                        ]
                    }
                ],
