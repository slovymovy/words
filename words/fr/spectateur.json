{
    "word_family": [
        "spectacle",
        "spectaculaire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72ab14cf-0948-3387-821e-5b5031395ed0",
                    "sense_definition": "Personne qui assiste à une représentation, un spectacle ou un événement sportif.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>spectateurs</w> applaudissent chaleureusement les artistes à la fin de la pièce."
                        },
                        {
                            "text": "Ce match de football a attiré plus de cinquante mille <w>spectateurs</w> dans le stade."
                        }
                    ],
                    "common_phrases": [
                        "spectateur attentif",
                        "milliers de spectateurs",
                        "spectateurs enthousiastes"
                    ]
                },
                {
                    "sense_id": "3ba6d33b-32f1-368f-9ad1-f3068953e000",
                    "sense_definition": "Personne qui est témoin d'une scène ou d'un événement sans y prendre part directement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "témoin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté un simple <w>spectateur</w> de l'accident et a ensuite témoigné auprès des policiers."
                        },
                        {
                            "text": "Elle n'a pas voulu intervenir et s'est contentée d'être <w>spectatrice</w> de la dispute."
                        }
                    ],
                    "common_phrases": [
                        "simple spectateur"
                    ]
                },
                {
                    "sense_id": "75444c0d-7f07-3dc0-a658-a6dbdfb21d40",
                    "sense_definition": "Personne qui reste passive face à une situation au lieu d'agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passivité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous ne pouvons pas rester de simples <w>spectateurs</w> face à cette grave crise sociale."
                        },
                        {
                            "text": "Au lieu de prendre des initiatives, il est resté <w>spectateur</w> de sa propre vie."
                        }
                    ],
                    "common_phrases": [
                        "rester spectateur",
                        "spectateur passif"
                    ]
                }
            ]
        }
    ]
}