                ],
                "senses": [
                    {
                        "sense_id": "6ae81544-46a2-3832-a0b3-09ba83e91d76",
                        "entry_id": "48272bf5-a5f3-38f5-addc-29794a764162",
                        "glosses": [
                            "Action de célébrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "556e95bb-861a-4fff-b4f0-1ffaaf38c637",
                                "sense_id": "6ae81544-46a2-3832-a0b3-09ba83e91d76",
                                "text": "La célébration du mouloud, de la nativité du Prophète, à laquelle je viens d'assister, fut un beau spectacle surtout en raison du temps superbe dont il a été favorisé."
                            },
                            {
                                "example_id": "ea2cbbf8-0e60-4ddd-b067-423097a90af2",
                                "sense_id": "6ae81544-46a2-3832-a0b3-09ba83e91d76",
                                "text": "La cité mosane prospère tant et si bien qu'en 1905, elle réussit à chiper à Bruxelles la célébration du 75ᵉ anniversaire de l’indépendance, tout en affirmant sa différence, sa « wallonitude »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df0d97b4-0953-453c-9357-5ac1a751507e",
                        "source_entry_id": "48272bf5-a5f3-38f5-addc-29794a764162",
                        "source_sense_id": "6ae81544-46a2-3832-a0b3-09ba83e91d76",
                        "target_lang_word": "Feier",
