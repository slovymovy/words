                "senses": [
                    {
                        "sense_id": "2dde7835-e3a8-31bb-8159-5685380f6a72",
                        "entry_id": "8270833c-3542-3493-af4e-c41f36acaf53",
                        "glosses": [
                            "Schutz gegen den Funkenbogen, der bei Trennung unter Last entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb415fd1-9aa8-4913-9da4-4c65db20da93",
                                "sense_id": "2dde7835-e3a8-31bb-8159-5685380f6a72",
                                "text": "„Im Unterschied zum Ölschalter mit Löschkammer und ölarmen Strömungsschalter, die sich ihre Blaswirkung zur Löschung des Lichtbogens mit Löschkammern selbst schaffen, erfolgte bei den \"Preßluftschaltern\" dies durch Fremdbeblasung mit Druckluft, welche auch für den Antrieb des Schalters verwendet wurde.“"
                            },
                            {
                                "example_id": "9c5217fe-08fb-4465-9742-002a3c55f187",
                                "sense_id": "2dde7835-e3a8-31bb-8159-5685380f6a72",
                                "text": "„Durch die Schlitze oberhalb der Löschkammer treten die heissen Gase und die Ionisierte Luft aus um ein zerbersten des LS zu verhindern“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3fff8ef0-daa1-3ab0-ab9c-8caf776acb8c",
                        "entry_id": "8270833c-3542-3493-af4e-c41f36acaf53",
                        "glosses": [
                            "Behälter zum Auffangen von Löschwasser"
                        ],
                        "tags": [
                            "Brandschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "89452163-17f5-44a9-a11b-9eda692b7785",
                                "sense_id": "3fff8ef0-daa1-3ab0-ab9c-8caf776acb8c",
                                "text": "„Mit dem Inhalt der Löschfahrzeuge, der Erstversorgung aus der lediglich etwa 10 000 Liter fassenden Löschkammer auf dem Aussiedlerhof und dem Versorgungsnetz konnte erste Löschhilfe geleistet werden“"
                            },
                            {
                                "example_id": "023f3426-cd3c-47fb-8ab3-fdd9f0c2e18a",
                                "sense_id": "3fff8ef0-daa1-3ab0-ab9c-8caf776acb8c",
                                "text": "„Darunter verborgen sind zwei betonierte Löschkammern mit einem Fassungsvermögen von 80 und 100 Kubikmetern Wasser (180 000 Liter).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
