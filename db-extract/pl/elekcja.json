                ],
                "senses": [
                    {
                        "sense_id": "518a4ebb-ac37-3e12-a465-2a5ccbb08f5c",
                        "entry_id": "34baef19-df40-327b-bfa3-839126a08876",
                        "glosses": [
                            "proces wyboru na stanowisko lub urząd państwowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3d0347-f0e5-4ee7-a3ac-527689f0ba9c",
                                "sense_id": "518a4ebb-ac37-3e12-a465-2a5ccbb08f5c",
                                "text": "Wiele osób jest bardzo niezadowolonych z tegorocznej elekcji marszałka na prezydenta."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38d76243-88bb-4b2d-801a-861d545d170f",
                        "source_entry_id": "34baef19-df40-327b-bfa3-839126a08876",
                        "source_sense_id": "518a4ebb-ac37-3e12-a465-2a5ccbb08f5c",
                        "target_lang_word": "election",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "election",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "A process of choosing a leader, members of parliament, councillors, or other representatives by popular vote."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d74a606-a414-4cca-a89c-955340734e3c",
                                                "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                                "text": "The parliamentary election(s) will be held in March."
                                            },
                                            {
                                                "example_id": "12cd990e-2869-472d-84ad-dbd5ee12ba06",
                                                "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                                "text": "How did you vote in (UK also: at) the last election?"
                                            },
                                            {
                                                "example_id": "b3fc637f-d7b7-4282-872f-e6633e7f6f09",
                                                "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                                "text": "That brief moment after the election four years ago, when many Americans thought Mr. Obama’s election would presage a new, less fractious political era, now seems very much a thing of the past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d158aa3-4794-3285-a9bd-2adabc1e0544",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "The choice of a leader or representative by popular vote."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42707749-2e58-4045-9301-262e3e16ad7a",
                                                "sense_id": "7d158aa3-4794-3285-a9bd-2adabc1e0544",
                                                "text": "The election of John Smith was due to his broad appeal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "532d3537-3f18-3f62-ba46-a15c77297298",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "An option that is selected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddbdef5b-27ca-4e1c-a661-4ab60ae26f12",
                                                "sense_id": "532d3537-3f18-3f62-ba46-a15c77297298",
                                                "text": "W-4 election"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "Any conscious choice."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50de653d-f5c6-424b-88dc-60b8be5f495e",
                                                "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                                "text": "Whosoever searcheth all the circumstances and embraceth all the consequences thereof hindereth his election."
                                            },
                                            {
                                                "example_id": "199b5f30-188e-46df-9651-5c371e720176",
                                                "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                                "text": "To use men with much difference and election is good."
                                            },
                                            {
                                                "example_id": "39612e8e-b19a-4951-b5ce-6e14e658be1a",
                                                "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                                "text": "The predestinative force of a free agent's own will in certain absolute acts, determinations, or elections, and in respect of which acts it is one either with the divine or the devilish will; and if the former, the conclusions to be drawn from God's goodness, faithfulness, and spiritual presence; these supply grounds of argument of a very different character […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af903de8-5e13-348f-8724-1a0ed6c2d09d",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "In Calvinism, God's predestination of saints including all of the elect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4505c11-a094-4a7d-a9d9-589162c5bb72",
                                                "sense_id": "af903de8-5e13-348f-8724-1a0ed6c2d09d",
                                                "text": "[H]e [Paul] laboureth to comfort Timothy vvith the remembrance of the ſtedfaſtneſs of Gods eternal decree of Election, becauſe grounded on his foreknowledge; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0749586-20e3-31fe-b751-904ad0b71cfd",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "Those who are elected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b78fc8a0-48e7-4e94-84c4-09675879eda2",
                                                "sense_id": "e0749586-20e3-31fe-b751-904ad0b71cfd",
                                                "text": "The election hath obtained it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1caf242-8b9e-43cb-ad21-5bfd88fb2104",
                        "source_entry_id": "34baef19-df40-327b-bfa3-839126a08876",
                        "source_sense_id": "518a4ebb-ac37-3e12-a465-2a5ccbb08f5c",
                        "target_lang_word": "élection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "724a5771-519c-3bf4-ab9a-cd446351842e",
                                        "entry_id": "de45fbb4-f0bc-328d-bde2-4e0f44bfe705",
                                        "glosses": [
                                            "Action d’élire, choix fait par la voie des suffrages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b924725-11e5-4398-9dc7-700a2ccfb03d",
                                                "sense_id": "724a5771-519c-3bf4-ab9a-cd446351842e",
                                                "text": "Il faut que vous payiez une grosse rançon, sire prieur, ou bien votre couvent devra faire une nouvelle élection, car on ne vous y reverra plus."
                                            },
                                            {
                                                "example_id": "1e49014a-af35-46ed-ae31-cdc23f01a1a0",
                                                "sense_id": "724a5771-519c-3bf4-ab9a-cd446351842e",
                                                "text": "L’élection est une espèce de sacre et rien de plus ; les anciens rois avaient la coutume de se faire sacrer à Reims, mais ils n’en étaient pas moins rois sans cette cérémonie."
                                            },
                                            {
                                                "example_id": "5fc56f9e-46c3-4009-8a22-5c054b502c57",
                                                "sense_id": "724a5771-519c-3bf4-ab9a-cd446351842e",
                                                "text": "Les pouvoirs de l’Assemblée nationale expirent le troisième mardi de juin de la cinquième année qui suit son élection."
                                            },
                                            {
                                                "example_id": "a2f87ccf-29cc-4ba2-a223-8a2a4929f6e9",
                                                "sense_id": "724a5771-519c-3bf4-ab9a-cd446351842e",
                                                "text": "Quand la Semaine de l’industrie sera passée et l’élection présidentielle derrière nous, il faudra donc agir. Au delà du buzz, c'est-à-dire du retour en grâce médiatique du made in France, il faudra dessiner un projet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5e4ddab-0e62-3d41-998d-a9489107cd0b",
                                        "entry_id": "de45fbb4-f0bc-328d-bde2-4e0f44bfe705",
                                        "glosses": [
                                            "Nomination des élus du peuple."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7916fd8a-0abc-4cf1-b2f5-d33262ffb594",
                                                "sense_id": "a5e4ddab-0e62-3d41-998d-a9489107cd0b",
                                                "text": "Or, cette année-là, comme les élections étaient fixées au 1ᵉʳ mai, il y eut dès le 1ᵉʳ avril, une propagande active et des menées sourdes de part et d’autre pour conquérir les douteux."
                                            },
                                            {
                                                "example_id": "38fd94aa-412d-423d-81b5-3e6c30faed52",
                                                "sense_id": "a5e4ddab-0e62-3d41-998d-a9489107cd0b",
                                                "text": "Aux élections générales de 1837, Cobden se porta candidat à Stockport. Il lui manqua une centaine de voix pour être élu."
                                            },
                                            {
                                                "example_id": "9f93f8a6-9fe1-40dc-ad5e-17dc70ecac56",
                                                "sense_id": "a5e4ddab-0e62-3d41-998d-a9489107cd0b",
                                                "text": "Commencée le 14 octobre 1877, la deuxième législature prend constitutionnellement fin le 13 octobre 1881. On n'envisage donc pas les élections générales avant l’automne."
                                            },
                                            {
                                                "example_id": "20d4e87c-e104-410f-993d-7311637f705b",
                                                "sense_id": "a5e4ddab-0e62-3d41-998d-a9489107cd0b",
                                                "text": "La nouvelle ligne coûte cher au parti communiste français. Aux élections législatives de 1928, s'il perd treize sièges (quatorze élus au lieu de vingt-trois), il gagne 180 000 voix. Quatre ans plus tard, aux élections de 1932, il perd encore des sièges (seulement dix élus) et cette fois, il perd aussi 250 000 voix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f619536e-c81d-35ca-9efe-406817cda195",
                                        "entry_id": "de45fbb4-f0bc-328d-bde2-4e0f44bfe705",
                                        "glosses": [
                                            "Choix ; préférence."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d1663c8-7bda-46a0-8a57-7f83d49ebaf8",
                                                "sense_id": "f619536e-c81d-35ca-9efe-406817cda195",
                                                "text": "Bettina fut sa préférence, comme Modeste était celle de Charles. Il y avait quelque chose de touchant dans ces deux élections."
                                            },
                                            {
                                                "example_id": "f48bf560-74cd-41b5-b4c3-09f580717930",
                                                "sense_id": "f619536e-c81d-35ca-9efe-406817cda195",
                                                "text": "La fièvre aphteuse (cocotte), grave chez les bovidés, peut être transmise à l'espèce humaine. Elle donne lieu alors à une stomatite caractérisée par la fièvre et une éruption de grosses vésicules qui ont pour siège d’élection la face dorsale de la langue."
                                            },
                                            {
                                                "example_id": "ab2ff6d3-9e6e-48e6-84c8-ddf1f26eb662",
                                                "sense_id": "f619536e-c81d-35ca-9efe-406817cda195",
                                                "text": "Le bon plaisir d’Agnès tient beaucoup plus à l’excommunication qui est constante qu’à l’élection qui est passagère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92457bd5-d460-336f-934d-a021cd66b148",
                                        "entry_id": "de45fbb4-f0bc-328d-bde2-4e0f44bfe705",
                                        "glosses": [
                                            "Territoire qui, sous l'ancien régime, relevait de la compétence juridictionnelle d'un intendant, et où il y avait une généralité et des élections établies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda36adb-2609-4a15-939c-1822a219eb30",
                                                "sense_id": "92457bd5-d460-336f-934d-a021cd66b148",
                                                "text": "Avant 1789, Merville appartenait au pays de Guyenne et faisait partie de l’élection de Rivière-Verdun, du diocèse et de la sénéchaussée de Toulouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
