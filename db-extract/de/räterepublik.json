                ],
                "senses": [
                    {
                        "sense_id": "79e41c8c-c9a9-39d1-9d45-54ac3486f588",
                        "entry_id": "3d7416e3-4913-398b-9470-b12a794f13ce",
                        "glosses": [
                            "Republik, bei der die Macht in der Hand sogenannter Räte liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55d6fd8d-e24a-4165-8f86-bb58aae06673",
                                "sense_id": "79e41c8c-c9a9-39d1-9d45-54ac3486f588",
                                "text": "„Noch ehe der Landtag sein Werk beginnen kann, schickt die Augsburger Arbeiterschaft, müde der revolutionären Resolutionen, Delegierte zum Ministerium nach München, sie sollen die Proklamation der Räterepublik fordern.“"
                            },
                            {
                                "example_id": "103d012c-8d0b-42fd-98bf-96eb5af0f322",
                                "sense_id": "79e41c8c-c9a9-39d1-9d45-54ac3486f588",
                                "text": "„Im Chaos nach der russischen Revolution wurde Tannu-Tuwa 1921 zunächst als Räterepublik unabhängig.“"
                            },
                            {
                                "example_id": "ecf55c33-e11f-440a-bfab-f8f374d69f3e",
                                "sense_id": "79e41c8c-c9a9-39d1-9d45-54ac3486f588",
                                "text": "„Die Räterepublik ist aus einer unblutigen Revolution hervorgegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
