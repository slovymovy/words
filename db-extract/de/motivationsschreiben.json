                "senses": [
                    {
                        "sense_id": "87d0c92c-1088-3b53-b8f0-1f6d5a5ec77f",
                        "entry_id": "06672d67-c583-3566-837e-4fa2d8a18580",
                        "glosses": [
                            "Schreiben im Kontext einer Bewerbung, das besondere Aspekte des Lebenslaufs hervorhebt, die im Bewerbungsschreiben nur unbefriedigend dargelegt werden konnten."
                        ],
                        "tags": [
                            "Bewerbung"
                        ],
                        "examples": [
                            {
                                "example_id": "60433215-b637-455b-9e8d-b3484f77042b",
                                "sense_id": "87d0c92c-1088-3b53-b8f0-1f6d5a5ec77f",
                                "text": "Heute wird auch von Studenten in verschiedenen Studienprogrammen bei der Bewerbung verlangt, die Motivation für ein Studium in einem sogenannten Motivationsschreiben darzustellen."
                            },
                            {
                                "example_id": "e196883f-577a-4ee5-8e22-86e9d9eb432f",
                                "sense_id": "87d0c92c-1088-3b53-b8f0-1f6d5a5ec77f",
                                "text": "Im Grunde genommen können Sie in Ihrem Motivationsschreiben weitere relevante Aspekte bezüglich Ihrer Person einbringen, die in Ihrem Bewerbungsschreiben keinen Platz gefunden haben. Achten Sie jedoch darauf, sich nicht einfach zu wiederholen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
