                ],
                "senses": [
                    {
                        "sense_id": "e1b49219-4a50-36ea-ad33-28c87183b36a",
                        "entry_id": "73841bea-1911-333c-8299-81d57b50108c",
                        "glosses": [
                            "luftgefederter Reifen (kurz für Pneumatik)"
                        ],
                        "tags": [
                            "besonders schweizerisch"
                        ],
                        "examples": [
                            {
                                "example_id": "400f938b-96d2-449d-9cca-6410da6821d8",
                                "sense_id": "e1b49219-4a50-36ea-ad33-28c87183b36a",
                                "text": "Bei meinem Velo müsste ich erst noch den vorderen Pneu flicken."
                            },
                            {
                                "example_id": "15c28b88-8ef1-465e-a40e-634d176b41b4",
                                "sense_id": "e1b49219-4a50-36ea-ad33-28c87183b36a",
                                "text": "„Bevor wir auf rauen Pisten ins Simien-Gebirge aufbrechen, müssen die vier Pneus am Auto und die beiden Ersatzreifen im Kofferraum und an der Heckklappe dicht sein.“"
                            },
                            {
                                "example_id": "cd81dfd9-8219-4094-804a-f944aa063ef0",
                                "sense_id": "e1b49219-4a50-36ea-ad33-28c87183b36a",
                                "text": "„Erst jetzt realisierte Paul die blaue Wolke vor sich, die von den Pneus der drei vorausfahrenden PKWs stammte, die allesamt eine Vollbremsung vollführt hatten.“"
                            },
                            {
                                "example_id": "0d7a13e8-d64c-40e5-b7cf-d2ef87826623",
                                "sense_id": "e1b49219-4a50-36ea-ad33-28c87183b36a",
                                "text": "„Auf kreischenden Pneus hielt der Wehrmachts-Mercedes vor dem Haus Avenue de Wagram 3.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08d4839a-3f39-3c1b-b059-c190a733b891",
                        "entry_id": "73841bea-1911-333c-8299-81d57b50108c",
                        "glosses": [
                            "aus einer aufgeblasenen, elastischen, luftdichten Hülle bestehende Halle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "579a6be3-53d1-449e-8e7d-b306de5e4696",
                                "sense_id": "08d4839a-3f39-3c1b-b059-c190a733b891",
                                "text": "Anstatt einer massiven Halle wurde aus Kostengründen nur ein Pneu errichtet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5afa52d3-8302-3488-aaaf-2db181fdaf77",
                        "entry_id": "73841bea-1911-333c-8299-81d57b50108c",
                        "glosses": [
                            "kurz für Pneumothorax"
                        ],
                        "tags": [
                            "Medizinjargon"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40c9dd62-706e-48bd-aa2e-f4befe5aa799",
                        "source_entry_id": "73841bea-1911-333c-8299-81d57b50108c",
                        "source_sense_id": "e1b49219-4a50-36ea-ad33-28c87183b36a",
                        "source_sense_description": "besonders schweizerisch: luftgefederter Reifen (kurz für Pneumatik)",
                        "target_lang_word": "pneu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pneu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81601be8-e11e-369e-bacf-f54e6d5149d5",
                                        "entry_id": "aa6d9df4-6ec4-3175-8178-ba5ce725c2ea",
                                        "glosses": [
                                            "Enveloppe souple remplie d’air qui entoure une roue et assure son contact avec le sol, inventée en 1888."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb2b470-5324-42ed-a6be-c018b8d36aeb",
                                                "sense_id": "81601be8-e11e-369e-bacf-f54e6d5149d5",
                                                "text": "Les roues sans pneus des fiacres, et des carrioles de transport qui s’en allaient au pas, en longues files, de véritables caravanes, faisaient un formidable bruit métallique. Il n’y avait que les voitures de maître et les fiacres de luxe qui avaient des pneus."
                                            },
                                            {
                                                "example_id": "7dba37aa-c199-4672-93b3-b0193f11b5f3",
                                                "sense_id": "81601be8-e11e-369e-bacf-f54e6d5149d5",
                                                "text": "Le motard découvrit ce qu’il cherchait dans l’une des poches pratiquées dans le capitonnage des portières et, sans se donner la peine de procéder à une vérification, il dégonfla les pneus de la traction de quatre coups de poinçon, ramassa le couteau, réenfourcha sa machine et fila."
                                            },
                                            {
                                                "example_id": "645c7c4b-899b-4863-bd8b-24b2d713de58",
                                                "sense_id": "81601be8-e11e-369e-bacf-f54e6d5149d5",
                                                "text": "Scène surréaliste durant le GP des Pays-Bas : il manque un pneu pour équiper la voiture de Carlos Sainz."
                                            },
                                            {
                                                "example_id": "3498d7d8-5de9-442a-b315-abe938d17e30",
                                                "sense_id": "81601be8-e11e-369e-bacf-f54e6d5149d5",
                                                "text": "Fendt et Trelleborg ont développé conjointement les pneus TM1 Eco Power spécialement conçus pour la gamme électrique. 60 % des composants de ces pneus proviennent de sources renouvelables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21533cba-5f69-3e29-97bd-cee9eff6abcf",
                                        "entry_id": "aa6d9df4-6ec4-3175-8178-ba5ce725c2ea",
                                        "glosses": [
                                            "Message envoyé par un système de canalisations à air comprimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af72785-53da-4273-ae3b-751ac588e6ce",
                                                "sense_id": "21533cba-5f69-3e29-97bd-cee9eff6abcf",
                                                "text": "Le lendemain matin, à huit heures, on apportait à Hélène un pneu, écrit à la machine :\n— Que nul ne s’inquiète ! J’ai recueilli Antoinne ^([sic]). Il est parfaitement heureux et entouré de toutes sortes de commodités."
                                            },
                                            {
                                                "example_id": "02e38585-d84b-4dcc-bedf-432ec9fa875c",
                                                "sense_id": "21533cba-5f69-3e29-97bd-cee9eff6abcf",
                                                "text": "— Monsieur, un pneu…\nJe l’ouvre sans hâte. Mais dès les premières lignes j’ai dû verdir. […] Je lui tends le papier bleu où elle peut lire : […]"
                                            },
                                            {
                                                "example_id": "a2abe64b-d6ad-453f-87dc-f428f9dfc995",
                                                "sense_id": "21533cba-5f69-3e29-97bd-cee9eff6abcf",
                                                "text": "Je reçois trois pneus de femmes par jour, toujours pour ne rien dire, bien entendu."
                                            },
                                            {
                                                "example_id": "c8c9f580-c5f6-4ccc-8d4b-b65d7b2a5888",
                                                "sense_id": "21533cba-5f69-3e29-97bd-cee9eff6abcf",
                                                "text": "Nous avions projeté une seconde partie de canotage ; l’avant-veille, je reçus un pneu de Zaza."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
