                                "target_senses": [
                                    {
                                        "sense_id": "d37c17eb-280f-3458-af22-35ce37f3eeb6",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "A long, thin, sharp implement usually for piercing as in sewing, embroidery, acupuncture, tattooing, body piercing, medical injections, sutures, etc; or a blunt but otherwise similar implement used for forming loops or knots in crafts such as darning, knitting, tatting, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14b225a8-a4ae-4b8a-8930-546b0a2391be",
                                                "sense_id": "d37c17eb-280f-3458-af22-35ce37f3eeb6",
                                                "text": "The seamstress threaded the needle to sew on a button."
                                            },
                                            {
                                                "example_id": "b159f4dd-8486-4f8d-bb92-26ab80cace24",
                                                "sense_id": "d37c17eb-280f-3458-af22-35ce37f3eeb6",
                                                "text": "reusable needles"
                                            },
                                            {
                                                "example_id": "d224763b-c47b-43cf-86bb-0b1bff77e327",
                                                "sense_id": "d37c17eb-280f-3458-af22-35ce37f3eeb6",
                                                "text": "single-use needles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9241f40e-fd5e-3265-ba4e-fda12e97183f",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "Any slender, pointed object resembling a needle, such as a pointed crystal, a sharp pinnacle of rock, an obelisk, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4c9ec87-3907-340e-92e4-de9276184c3e",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "A fine measurement indicator on a dial or graph."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a41d455d-f5e9-4e73-8406-d292a7057bff",
                                                "sense_id": "a4c9ec87-3907-340e-92e4-de9276184c3e",
                                                "text": "a compass needle"
                                            },
                                            {
                                                "example_id": "f8c68736-bf97-4354-98b7-788a8c29710c",
                                                "sense_id": "a4c9ec87-3907-340e-92e4-de9276184c3e",
                                                "text": "The needle on the fuel gauge pointed to empty."
                                            },
                                            {
                                                "example_id": "8f521e6d-89e6-4dbd-94eb-8aead679ebce",
                                                "sense_id": "a4c9ec87-3907-340e-92e4-de9276184c3e",
                                                "text": "\"[…] On the 18th of October, 1841, a very intense magnetic disturbance was recorded, and amongst other curious facts mentioned is that of the detention of the 10:05pm express train at Exeter for 16 minutes, as from the magnetic disturbance affecting the needles so powerfully, it was impossible to ascertain if the line was clear at Starcross. The superintendent at Exeter reported the next morning that someone was playing tricks with the instruments, and would not let them work.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f845b5f7-79f2-341b-b6b6-5d362163f07f",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "A sensor for playing phonograph records, a phonograph stylus."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7ca9f1f-6356-4eb2-82e3-7057bd290328",
                                                "sense_id": "f845b5f7-79f2-341b-b6b6-5d362163f07f",
                                                "text": "Ziggy bought some diamond needles for his hi-fi phonograph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e821f8a-05f3-353f-8433-03d6172945d3",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "A needle-like leaf found on some conifers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32145169-4b3d-4a67-a39e-fbbd9830c25e",
                                                "sense_id": "6e821f8a-05f3-353f-8433-03d6172945d3",
                                                "text": "At the very moment he cried out, David realised that what he had run into was only the Christmas tree. Disgusted with himself at such cowardice, he spat a needle from his mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cdef570-aea4-3547-858f-0e3b504c91d9",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "A strong beam resting on props, used as a temporary support during building repairs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a8664fd-a12d-3e5c-b42f-5d058a360d6e",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "The death penalty carried out by lethal injection."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4b691b4-2f35-3d4b-bfe7-842bae7414f0",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "A text string that is searched for within another string. (see: needle in a haystack)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142c8277-e72c-4197-97bf-9ee77967c57a",
                                                "sense_id": "f4b691b4-2f35-3d4b-bfe7-842bae7414f0",
                                                "text": "Both of these functions will look through the haystack for the specified needle and, if they find it, will return the portion of the string from the beginning of the needle to the end of the haystack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "668abfe2-d920-3d0f-a47e-8609b832c98d",
                                        "entry_id": "95b605f8-ca39-3543-9ab4-2847fd118f73",
                                        "glosses": [
                                            "Any of various species of damselfly of the genus Synlestes, endemic to Australia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34987a9e-da34-3149-a358-9ed18c3c908e",
