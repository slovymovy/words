                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8fd851-7214-389a-ade4-5233e523f50e",
                                        "entry_id": "f3bc31f1-ce98-338b-a1de-054df0f95929",
                                        "glosses": [
                                            "elektrische bromfiets waarvan de motor pas werkt als de bestuurder met pedalen meetrapt, een voertuig gebouwd zoals een elektrische fiets maar met hogere snelheid, tot ongeveer 45 km/u"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86aeada2-1a61-4527-b44f-90431317328c",
                                                "sense_id": "6f8fd851-7214-389a-ade4-5233e523f50e",
                                                "text": "Halverwege dit jaar telde Nederland ruim 21.000 zogeheten speedpedelecs, een e-bike die tot 45 kilometer per uur rijdt."
                                            },
                                            {
                                                "example_id": "fa9b35a6-cf01-492f-8d44-e85be351129f",
                                                "sense_id": "6f8fd851-7214-389a-ade4-5233e523f50e",
                                                "text": "Maar de laatste jaren hebben ook forenzen de elektrische fiets ontdekt, en de speedpedelec, een elektrische fiets waarvan de trapondersteuning niet bij 25 kilometer per uur maar pas bij 45 kilometer per uur stopt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
