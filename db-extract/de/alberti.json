                ],
                "senses": [
                    {
                        "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                        "entry_id": "967fe04d-1eb9-345b-bcbf-ac6ff66a617f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca32e9ad-45dc-49eb-bc9d-0f5316862239",
                                "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                                "text": "Frau Alberti ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f17e2d56-c3c9-471b-8d09-8704e44b1362",
                                "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                                "text": "Herr Alberti wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8c4b3ae4-16c6-464a-a1f9-76353f8bfa40",
                                "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                                "text": "Die Albertis fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "c5b0e50f-148b-4f40-88a8-c46bcb3dbae0",
                                "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                                "text": "Der Alberti trägt nie die Pullover, die die Alberti ihm strickt."
                            },
                            {
                                "example_id": "70827155-4dfe-4820-9e4a-5e03edc2f375",
                                "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Alberti kommt, geht der Herr Alberti.“"
                            },
                            {
                                "example_id": "2a76eb3c-60b5-408e-b7da-97d7bedb3cc1",
                                "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                                "text": "Alberti kommt und geht."
                            },
                            {
                                "example_id": "3eed20b3-e78b-437e-b2fc-83d977dccc31",
                                "sense_id": "ee89477b-0df7-3ce8-be2c-60a9366c1543",
                                "text": "Albertis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
