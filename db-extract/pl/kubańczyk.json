                            {
                                "example_id": "0b95a28c-bb67-41dc-a33a-99bcad8c0168",
                                "sense_id": "a6496bf9-a482-39c4-9f91-deccb3ef7d71",
                                "text": "Czy Kubańczycy na Kubie mówią po kubańsku? Nie, mówią po hiszpańsku."
