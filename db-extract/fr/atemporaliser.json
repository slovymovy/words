                ],
                "senses": [
                    {
                        "sense_id": "380e9197-1d73-3678-b6f1-a8087503f1dd",
                        "entry_id": "38cfe41b-97e3-318a-988d-89eac6260708",
                        "glosses": [
                            "Donner un caractère atemporel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45c7bcc-152e-4667-9f09-9c8a4cfcbe08",
                                "sense_id": "380e9197-1d73-3678-b6f1-a8087503f1dd",
                                "text": "Et pour éviter le naufrage lors de la traversée de la page, il faut nécessairement dépeupler le mot, le despatialiser, l’atemporaliser."
                            },
                            {
                                "example_id": "e6c8bdd1-9859-4e77-bbaf-bd2ebcbea154",
                                "sense_id": "380e9197-1d73-3678-b6f1-a8087503f1dd",
                                "text": "C'est d'ailleurs pourquoi je travaille souvent en noir et blanc, cela me semble justement « atemporaliser » les images."
                            },
                            {
                                "example_id": "8771d149-005a-451c-a9e1-542cb51a52a1",
                                "sense_id": "380e9197-1d73-3678-b6f1-a8087503f1dd",
                                "text": "Et la perspective phénoménologique va jusqu'à atemporaliser l'histoire."
                            }
                        ]
                    }
                ],
