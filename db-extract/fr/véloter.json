                                "example_id": "7a517548-a88c-4586-90cf-313a9d85f55b",
                                "sense_id": "a57f1089-12c1-3a45-8dca-ea16c624d082",
                                "text": "Donc Maryvonne, c'est le nom de ma cousine, et moi, nous occupions nos journées à véloter, à ramasser dans les champs des fruits au nez et à la barbe des paysans pour faire des confitures."
                            },
                            {
                                "example_id": "30ae655b-dd96-4392-a7b9-2b6d989d787f",
                                "sense_id": "a57f1089-12c1-3a45-8dca-ea16c624d082",
                                "text": "Tous vélotent. Péniblement."
                            }
                        ]
