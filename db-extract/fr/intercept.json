                                            {
                                                "example_id": "fd559a25-1aec-47b8-86bd-b198fc07eb10",
                                                "sense_id": "38c2d1ea-5c1e-3425-a5f0-ea072c9cb4d2",
                                                "text": "The police intercepted the package of stolen goods while it was in transit."
                                            },
                                            {
                                                "example_id": "52fb9ce6-8003-431a-975c-ccd5e5e0eee7",
                                                "sense_id": "38c2d1ea-5c1e-3425-a5f0-ea072c9cb4d2",
                                                "text": "[T]he emotion grew ſo violent that it almost intercepted my reſpiration.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "0663b0df-1548-437a-81af-536e0db47c8e",
                                                "sense_id": "38c2d1ea-5c1e-3425-a5f0-ea072c9cb4d2",
                                                "text": "The rights of men in ſociety, are neither deviſeable, nor transferable, nor annihilable, but are deſcendable only; and it is not in the power of any generation to intercept finally, and cut off the deſcent."
                                            },
                                            {
                                                "example_id": "e29e82bc-e034-4285-ae63-479050daa143",
                                                "sense_id": "38c2d1ea-5c1e-3425-a5f0-ea072c9cb4d2",
                                                "text": "I must admit to being genuinely shocked when I saw those letters in my file. I always suspected that mail was monitored, but it never occurred to me that mail would be intercepted and opened."
                                            }
