                                        "glosses": [
                                            "past participle of forge. To force forward against opposition."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6615c092-7327-4343-80c3-3236588d135b",
                                                "sense_id": "4417672b-c023-3883-95ea-43e7b0411a43",
                                                "text": "He forged forward against the current, even as it tried to sweep him down river."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forged",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4035bc95-3f90-3244-9b40-4220117c35db",
                                        "entry_id": "bacb7424-1a15-39db-a049-2859ef150963",
                                        "glosses": [
                                            "Fake (as documents); falsified."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18295422-136b-45e3-81d1-9c6156319a99",
                                                "sense_id": "4035bc95-3f90-3244-9b40-4220117c35db",
                                                "text": "Forged identification documents were used to enter the building."
                                            },
                                            {
                                                "example_id": "fbbd815d-8248-438d-a089-3709fa4d8fed",
                                                "sense_id": "4035bc95-3f90-3244-9b40-4220117c35db",
                                                "text": "Toward the end of the war, Benoit was sent off on his own with forged papers; he wound up working as a horse groom at a chalet in the Loire valley. Mandelbrot describes this harrowing youth with great sangfroid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1159e63c-eb94-396c-a806-138e26e7ea1d",
                                        "entry_id": "bacb7424-1a15-39db-a049-2859ef150963",
                                        "glosses": [
                                            "Fabricated by forging or at a forge, by working hot metal"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "581de70e-e0f4-4e01-8c6c-706052ea72eb",
                                                "sense_id": "1159e63c-eb94-396c-a806-138e26e7ea1d",
                                                "text": "The blacksmith made an expertly forged horseshoe by beating the red hot metal with his hammer."
                                            }
                                        ]
                                    }
                                ]
