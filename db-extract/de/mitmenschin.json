                "senses": [
                    {
                        "sense_id": "898181aa-5965-395d-b2b9-4c9c2db8e6f8",
                        "entry_id": "6959b6f7-4151-39c6-97f4-b8ef4e780aa1",
                        "glosses": [
                            "weiblicher Mensch an sich, der mit anderen in der Gesellschaft lebt und mit ihnen den Lebensraum teilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45dd99d2-527d-43e7-98aa-3791fce874b2",
                                "sense_id": "898181aa-5965-395d-b2b9-4c9c2db8e6f8",
                                "text": "„Beim plötzlichen Bremsen landete man dann auf dem Schoß einer lieben Mitmenschin, was durchaus erotisch sein konnte.“"
                            },
                            {
                                "example_id": "2c5c7eaa-224f-46d3-89e4-e22160beba88",
                                "sense_id": "898181aa-5965-395d-b2b9-4c9c2db8e6f8",
                                "text": "„Er hätte die rasche Wagenfahrt durch linden mondhellen Sommerabend, zur Seite einer jungen blonden Mitmenschin, vollauf genießen können.“"
                            },
                            {
                                "example_id": "72d60bc5-5494-4309-a7d6-048732f83b12",
                                "sense_id": "898181aa-5965-395d-b2b9-4c9c2db8e6f8",
                                "text": "„Ein Bubetäter; weil er gegen eine Mitmenschin gefehlt.“ (1917)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
