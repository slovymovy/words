            {
                "entry_id": "d0a1fbc1-61b4-3c92-a992-d947d6aab69d",
                "word": "salutiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "22c9d618-acc7-4c01-b81f-63da0377d772",
                        "entry_id": "d0a1fbc1-61b4-3c92-a992-d947d6aab69d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "salutistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47bcefe9-21ba-33db-942d-6a25542d2a35",
                        "entry_id": "d0a1fbc1-61b4-3c92-a992-d947d6aab69d",
                        "glosses": [
                            "Membre de l’Armée du salut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d70c8a-2b9b-4be4-8a26-8799c27eb976",
                                "sense_id": "47bcefe9-21ba-33db-942d-6a25542d2a35",
                                "text": "Qu'est-ce que ça veut dire, une salutiste dans les bureaux du Prolétaire ? Qui vous a permis d'entrer ?"
                            },
                            {
                                "example_id": "68194997-5e57-4214-9964-1276438dcf94",
                                "sense_id": "47bcefe9-21ba-33db-942d-6a25542d2a35",
                                "text": "Ils croyaient lasser la vieille demoiselle qui les harcelait comme une salutiste excitée."
                            },
                            {
                                "example_id": "50d31fc9-21bf-45fe-862c-78ac08d9ac56",
                                "sense_id": "47bcefe9-21ba-33db-942d-6a25542d2a35",
                                "text": "Le plus audacieux des « mousquetaires » du scepticisme se permet de faire une remarque au brave salutiste qui, de temps en temps, lorgne sur les belles assiettes garnies de ces personnages nantis."
                            },
                            {
                                "example_id": "4a9c79ba-4f4b-47d7-9f97-84949cbab6cf",
                                "sense_id": "47bcefe9-21ba-33db-942d-6a25542d2a35",
                                "text": "Repris de justice ou ex-alcooliques, les salutistes s’en prenaient aux femmes qui se vendaient, aux tenanciers, à tout homme soupçonné d’écouler des plaisirs."
                            }
                        ]
                    }
                ],
