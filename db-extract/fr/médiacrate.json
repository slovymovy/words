                "senses": [
                    {
                        "sense_id": "b5e6f68f-28a2-3d49-b405-b8c8c6ece2c1",
                        "entry_id": "36a437d3-3337-3104-9daf-8e5873282b40",
                        "glosses": [
                            "Personne — journaliste, chroniqueur ou personnalité publique — exerçant une forte influence sur l'opinion par sa présence dans les médias."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b725c54e-a3d0-4cdf-986e-0504a8bb2fe1",
                                "sense_id": "b5e6f68f-28a2-3d49-b405-b8c8c6ece2c1",
                                "text": "Journaliste, écrivain, éditeur, membre de plusieurs jurys, un médiacrate connu que Choutov traitait de « mafioso littéraire » et à qui il devait maintenant sourire."
                            },
                            {
                                "example_id": "ec4b6bb0-e320-4d90-8d4c-b9a83c8088dd",
                                "sense_id": "b5e6f68f-28a2-3d49-b405-b8c8c6ece2c1",
                                "text": "Et de définir les médiacrates comme ceux qui « acquièrent un pouvoir qu'ils n'auraient pas sans les médias » (« Michel Noir, Le Pen »)."
                            },
                            {
                                "example_id": "5c37d5e8-7870-4cf2-9072-471546de05fd",
                                "sense_id": "b5e6f68f-28a2-3d49-b405-b8c8c6ece2c1",
                                "text": "Séjour dans les hôtels de luxe ou les palais royaux, villégiature dans leurs résidences secondaires : stars du show-biz, médiacrates, personnalités politiques et hommes d’affaires ont fait de Marrakech l’un des hauts lieux de l’oligarchie française."
                            },
                            {
                                "example_id": "17400b81-6090-4e62-9c97-54c739b28a81",
                                "sense_id": "b5e6f68f-28a2-3d49-b405-b8c8c6ece2c1",
                                "text": "Devant une cinquantaine de personnes, M. Mélenchon s'en est également pris aux « médiacrates », qu'il accuse de « caricaturer les jeunes » et d'écorner l'image de la banlieue parisienne."
                            },
                            {
                                "example_id": "dc53e19c-0453-4dde-a3ee-c1373c47e676",
                                "sense_id": "b5e6f68f-28a2-3d49-b405-b8c8c6ece2c1",
                                "text": "Elle se bâtit pour cela son propre microcosme, espace ouvert aux vérités les plus secrètes, sur la toile d’internet, loin des ciseaux d’Anastasie, des monitions du PAF, du corps des médiacrates qui distribuent l’imprimatur."
                            }
                        ]
                    }
