    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78173358-3ea3-3050-b55e-c5b348b5f1c7",
                    "sense_definition": "Имеющий возраст в двадцать лет (о человеке или животном).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "возраст",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В университет поступил <w>двадцатилетний</w> юноша из провинциального городка.",
                            "target_lang_translations": {
                                "pl": "Na uniwersytet dostał się <w>dwudziestoletni</w> młodzieniec z prowincjonalnego miasteczka."
                            }
                        },
                        {
                            "text": "Эта <w>двадцатилетняя</w> девушка уже руководит собственным успешным проектом.",
                            "target_lang_translations": {
                                "pl": "Ta <w>dwudziestoletnia</w> dziewczyna kieruje już własnym udanym projektem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "двадцатилетний юноша",
                        "двадцатилетняя девушка",
                        "двадцатилетний парень"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający dwadzieścia lat (o osobie lub zwierzęciu)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dwudziestoletni",
                                "target_lang_sense_clarification": "mający dwadzieścia lat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59c6e2d5-2cc0-368e-8e0d-359859a028ff",
                    "sense_definition": "Продолжающийся, длящийся в течение двадцати лет или рассчитанный на такой срок.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "продолжительность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгих переговоров страны завершили <w>двадцатилетний</w> конфликт и подписали мир.",
                            "target_lang_translations": {
                                "pl": "Po długich negocjacjach kraje zakończyły <w>dwudziestoletni</w> konflikt i podpisały pokój."
                            }
                        },
                        {
                            "text": "Он взял <w>двадцатилетний</w> кредит на покупку просторной квартиры в центре.",
                            "target_lang_translations": {
                                "pl": "Wziął <w>dwudziestoletni</w> kredyt na zakup przestronnego mieszkania w centrum."
                            }
                        }
                    ],
                    "common_phrases": [
                        "двадцатилетний юбилей",
                        "двадцатилетний опыт",
                        "двадцатилетний срок"
                    ],
                    "target_lang_definitions": {
                        "pl": "Trwający przez okres dwudziestu lat lub przewidziany na taki czas."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dwudziestoletni",
                                "target_lang_sense_clarification": "trwający dwadzieścia lat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
