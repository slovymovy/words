                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "2ed6bb93-4a0b-4570-8398-1fc0a76e465d",
                                "sense_id": "b5bbcae6-e464-3f37-8aa8-53e499ce6773",
                                "text": "There were greeters handing out programmes in the entryway to the museum."
                            },
                            {
                                "example_id": "3033ab56-2826-41bc-bf06-96e8ecbbf6cc",
                                "sense_id": "b5bbcae6-e464-3f37-8aa8-53e499ce6773",
                                "text": "In those days the North Pass was the only entryway to the valley that was passable by cart or wagon traffic."
                            }
                        ]
