                        "entry_id": "84abc4c3-d2aa-3cd9-9aa1-d817b85c1249",
                        "glosses": [
                            "To lie quiet and snug; to nestle, to snuggle."
                        ],
                        "tags": [
                            "dialectal",
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b78b61cb-b2b2-4e58-97ba-a04b335d0dff",
                                "sense_id": "35626421-67dd-3ee2-b91d-375b3fb9eb1c",
                                "text": "to snudge over a fire"
                            },
                            {
                                "example_id": "57c937af-1cb6-42d6-b0ac-33441f38b8d3",
                                "sense_id": "35626421-67dd-3ee2-b91d-375b3fb9eb1c",
                                "text": "Novv he vvill fight it out, and to the vvarres; / Novv eat his bread in peace, / And ſnudge in quiet: novv he ſcorns increaſe; / Novv all day ſpares."
                            }
                        ]
                    }
