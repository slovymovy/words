                    },
                    {
                        "translation_id": "5de1bc9c-5ad1-4278-be71-b961e3433828",
                        "source_entry_id": "b8216a96-e0bb-3c41-b062-954e9cde7c4b",
                        "source_sense_description": "Person who does menial work",
                        "target_lang_word": "larbin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "larbin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d47be0-49c5-3fc3-9cf3-fe56f27b0948",
                                        "entry_id": "94fd29d3-c548-3fe9-8ff9-a91996a015ee",
                                        "glosses": [
                                            "Domestique, serviteur."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63dc8228-caea-4307-8451-c64405f57c2b",
                                                "sense_id": "a0d47be0-49c5-3fc3-9cf3-fe56f27b0948",
                                                "text": "Au premier, un larbin à gileton rayé répond à mon coup de sonnette."
                                            },
                                            {
                                                "example_id": "f9f2a9b3-afce-4818-857f-76c132c75648",
                                                "sense_id": "a0d47be0-49c5-3fc3-9cf3-fe56f27b0948",
                                                "text": "Paraît aussi qu’il a un château, des larbins, des aïeux, un nom à cinq ou six rallonges, mais ça ne se voit pas sur lui…"
                                            },
                                            {
                                                "example_id": "e971b97f-abe3-4612-8a5f-4d23129b05b5",
                                                "sense_id": "a0d47be0-49c5-3fc3-9cf3-fe56f27b0948",
                                                "text": "Une rumeur de bataille déferlait, par l’escalier de marbre blanc, jusqu’aux larbins imperturbables et galonnés qui tenaient le vestiaire."
                                            },
                                            {
                                                "example_id": "76d53bf4-242b-4be5-9b1c-1bf3d664b9ce",
                                                "sense_id": "a0d47be0-49c5-3fc3-9cf3-fe56f27b0948",
                                                "text": "— Moi je servirai.\n— Être larbin, voilà ton idéal.\n— Plus tard on aura du personnel. Marie-Jeanne tiendra la caisse. Moi, je dirigerai.\n— Exploiter l’homme, voilà toute ton ambition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cca9461-c8c9-391e-adf4-4ab9931da120",
                                        "entry_id": "94fd29d3-c548-3fe9-8ff9-a91996a015ee",
                                        "glosses": [
                                            "Personnage servile."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad95f6df-5214-41e9-8961-0b68783e1e2a",
                                                "sense_id": "1cca9461-c8c9-391e-adf4-4ab9931da120",
                                                "text": "Trop de gonzesses, et où est mon « entourage », en français dans le texte, je me sens à poil sans ma bande de larbins au complet, sans compter que je portais ce sacré t-shirt."
                                            },
                                            {
                                                "example_id": "15bf4dba-eb74-4ddb-b286-4f06bf699281",
                                                "sense_id": "1cca9461-c8c9-391e-adf4-4ab9931da120",
                                                "text": "— Quoi ? Tu m’prends en plus pour ton larbin, Kaffir ? Et puis d’abord t’es pieds nus, tu risques pas d’user quoi que ce soit à part ta corne de sauvage…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba249dcd-29ef-4aea-bccd-7b7ee9aa5320",
                        "source_entry_id": "b8216a96-e0bb-3c41-b062-954e9cde7c4b",
                        "source_sense_description": "Person who does menial work",
                        "target_lang_word": "petite main",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petite main",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f804d143-4eef-346a-8ee7-ed653acfa9d5",
                                        "entry_id": "e4239c40-8ccd-3e20-b191-3bb4713e0301",
                                        "glosses": [
                                            "Jeune ouvrière en couture qui débute dans le métier."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a04ef9-8d65-492a-b499-4cd4b5a52c35",
                                                "sense_id": "f804d143-4eef-346a-8ee7-ed653acfa9d5",
                                                "text": "Pour saisir la fortune, il suffit d’une « petite main »."
                                            },
                                            {
                                                "example_id": "59a46fc2-1480-4f6d-9f19-d50de23c1d19",
                                                "sense_id": "f804d143-4eef-346a-8ee7-ed653acfa9d5",
                                                "text": "L’atelier d’couture est en fête […]\nCar c’est aujourd’hui qu’Marinette\nVient juste d’avoir ses vingt ans.\nTrottins, petites mains et premières\nOnt toutes apporté des gâteaux…"
                                            },
                                            {
                                                "example_id": "13ac3928-17dc-4093-b21f-867478106104",
                                                "sense_id": "f804d143-4eef-346a-8ee7-ed653acfa9d5",
                                                "text": "Les Buses se sont vite aperçues que Gabrielle, qui est jeune et jolie, et qui mime à merveille les manières d’une petite main dans la débine, réussit mieux qu’elles auprès des dames, et parfois des messieurs qui décident des achats de celles-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e347a9e-e265-3237-9954-e9bdc30daea5",
                                        "entry_id": "e4239c40-8ccd-3e20-b191-3bb4713e0301",
                                        "glosses": [
                                            "Personne employée à de menues tâches fastidieuses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1150d527-e721-432e-94b6-b6632aacf6c9",
                                                "sense_id": "4e347a9e-e265-3237-9954-e9bdc30daea5",
                                                "text": "Or, nous sommes certainement à peu près tous et toutes dedans, et tous et toutes affectés, mais il faut pouvoir dire que nous ne sommes pas tous et toutes des petites mains."
                                            },
                                            {
                                                "example_id": "d55cba07-7724-4d9f-bf88-2d7d32712efe",
                                                "sense_id": "4e347a9e-e265-3237-9954-e9bdc30daea5",
                                                "text": "… une entreprise chargée de modérer des contenus pour Facebook. Dans la banlieue de Manille, à 11 000 kilomètres de la Californie, pour environ 300 dollars par mois, des petites mains jouent les aiguilleurs du ciel dans des cubicules anonymes et climatisés."
                                            },
                                            {
                                                "example_id": "c14d4459-48df-4444-a34c-86f683845cc2",
                                                "sense_id": "4e347a9e-e265-3237-9954-e9bdc30daea5",
                                                "text": "Collomb a mis en cause, devant la commission d’enquête de l’Assemblée, l’un des conseillers de l’Élysée, Vincent Caure, petite main âgée de 23 ans, qui travaille au pôle « relations avec les élus »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b11156f-19c4-3aaf-8f9a-c1ab9a5ee8bc",
                                        "entry_id": "e4239c40-8ccd-3e20-b191-3bb4713e0301",
                                        "glosses": [
                                            "Personne qui effectue les basses besognes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de447eb-5d7b-4b80-bb94-e124238313a0",
                                                "sense_id": "4b11156f-19c4-3aaf-8f9a-c1ab9a5ee8bc",
                                                "text": "Après les piliers de la bande, dont la plupart sont en cavale, après les relais financiers sur le continent et à l’étranger, la justice s’intéresse aux petites mains du groupe criminel ajaccien connu sous le nom du « Petit Bar », souvenir de leur ancien quartier général."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbc6c3c7-2884-4202-bffd-008311ceb0f0",
                        "source_entry_id": "b8216a96-e0bb-3c41-b062-954e9cde7c4b",
                        "source_sense_description": "Person who does menial work",
                        "target_lang_word": "Handlanger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handlanger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad61cdf-1e38-3873-b0ea-fd1872134297",
                                        "entry_id": "17a6ea31-49d6-38b0-831a-ec567459685c",
                                        "glosses": [
                                            "ungelernte Hilfskraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87b7058-8e02-40aa-a453-53c2ae548cdd",
                                                "sense_id": "5ad61cdf-1e38-3873-b0ea-fd1872134297",
                                                "text": "\"Was/wer steckt dahinter? Investmentbankster Goldman-Sachs, im Einklang mit IWF, EZB und deren ausführenden Handlanger der Politik. Interessant zu wissen: Frühere EU- Politiker wie Papademos, Samaras, Simitis aber auch Monti und Prodi (Italien) und Draghi (EZB) standen (stehen auch noch heute?) in Lohn und Brot von Goldman-Sachs. Ein Schelm, der Böses denkt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                        "entry_id": "17a6ea31-49d6-38b0-831a-ec567459685c",
                                        "glosses": [
                                            "\\\"die Absichten oder Aufträge eines Anderen ausführende und erfüllende Person\\"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbcd5e93-27e3-4cb5-bc7a-975a55afc688",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "\"Polier kommt von Polieren und welcher Maurer oder Handlanger hätte seinem Polier nicht gerne schon einmal die Fresse poliert.\""
                                            },
                                            {
                                                "example_id": "4afc4b16-87f1-42b5-af52-1e113e76efcd",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Dann wieder: Die Polen hätten bloß als Handlanger der Russen gehandelt, das Ziel sei Sibirien.“"
                                            },
                                            {
                                                "example_id": "8dbbd451-90d0-45c5-888c-7281b704e27e",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Es bildet sich eine Gruppe als Handlanger der nie erscheinenden Befehlsgeber.“"
                                            },
                                            {
                                                "example_id": "de637129-af77-4158-bbd4-ab1c6b07af52",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Deshalb wurden die ehemaligen Produzenten von Massenvernichtungswaffen zu Handlangern der Massenunterhaltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "451110da-5cfc-419e-8a6f-75d803f5067e",
                        "source_entry_id": "b8216a96-e0bb-3c41-b062-954e9cde7c4b",
                        "source_sense_description": "Person who does menial work",
                        "target_lang_word": "Diener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "abhängig Arbeitender, der für seinen Herren bestimmte häusliche Pflichten erfüllt, Hausangestellter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50e2859-faf4-4db0-a8ef-7d9d31f754b2",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "Ein Diener lernt auf einer speziellen Schule, wie er sich gegenüber dem Herren verhalten muss."
                                            },
                                            {
                                                "example_id": "7170e4bf-1d7d-44cd-815e-e67536cf21b6",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Es nützte nichts, weder der Priester noch sonst jemand vermochte ihn davon abzubringen, daß ich nicht sein Diener, sondern sein Sklave sei…“"
                                            },
                                            {
                                                "example_id": "23226876-6de2-4650-a8d3-e81ee59ea5c7",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Die Einzigen von ihnen, die jemals ihren Fuß in die Stadt setzten, waren die schwarzen Diener und Dienerinnen, welche die Plantagenbesitzer von den karibischen Inseln mitbrachten, wenn sie Frankreich einen Besuch abstatteten.“"
                                            },
                                            {
                                                "example_id": "cbf1718a-5aa3-4572-a9e9-0fc6958b3852",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Mit dem »ganz ollen Vietzke« ist unser alter Diener gemeint; sein Sohn ist der Brennermeister.“"
                                            },
                                            {
                                                "example_id": "5b171a48-7db5-44ff-9377-04ffdca2ad20",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Ich befürchtete, dass der Diener mich nicht hereinlassen würde, wenn ich im Gewand eines einfachen Seemanns anklopfte, also öffnete ich die Eingangstür ohne Umschweife und ging direkt durch zum Salon, bevor man mich aufhalten konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b64ee6ab-206d-3451-8b91-533bb4b9e646",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "Person, die sich sehr für etwas einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1c9437-4fa5-4a89-bc92-89e530085dbe",
                                                "sense_id": "b64ee6ab-206d-3451-8b91-533bb4b9e646",
                                                "text": "Er war ein mächtiger Diener der Wissenschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b6fc4f0d-6847-34c5-bab3-ee1c978f9f3c",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "Verbeugung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affab34a-15eb-4dcc-b24b-053d4374d691",
                                                "sense_id": "b6fc4f0d-6847-34c5-bab3-ee1c978f9f3c",
                                                "text": "Als Kinder mussten wir zur Begrüßung einen Diener machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28f1394d-4fa1-410f-baaf-0d4279fe9674",
                        "source_entry_id": "b8216a96-e0bb-3c41-b062-954e9cde7c4b",
                        "source_sense_description": "Person who does menial work",
                        "target_lang_word": "Scherge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scherge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                        "entry_id": "32def5fb-6c50-3dcd-b127-759b95d31cda",
                                        "glosses": [
                                            "Person, die Aufträge einer Macht auch gewaltsam ausführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31cfde93-81ac-4078-840b-9c1b96f6158f",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Und oft standen sie Hitlers Schergen an Grausamkeit in Nichts nach.“"
                                            },
                                            {
                                                "example_id": "af5e4958-7f60-45c3-b671-3aa461d7ac5f",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Währenddessen setzt meine Monatsblutung ein, doch ich traue mich nicht, bei einem der Schergen um Binden zu bitten.“"
                                            },
                                            {
                                                "example_id": "24bd829e-26e4-4131-9170-a13fd88b8885",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Die einzelnen Bautrupps taten sich nun zusammen, um nicht kurz vor der Befreiung noch von den SS-Bewachern ins Unglück geführt zu werden, und bald waren auch ihre Schergen vorsichtig geworden.“"
                                            },
                                            {
                                                "example_id": "52830a0f-cbfc-46ea-abdf-298b03cc8e96",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Damit rief er den rechts und links stehenden Schergen zu, Folter und Prügel zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
