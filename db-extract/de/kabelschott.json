                "senses": [
                    {
                        "sense_id": "8e10aa14-9ea9-356a-b867-644c941ef0b8",
                        "entry_id": "d3ab2a63-dde9-32bc-8d70-0a58a5a49e1b",
                        "glosses": [
                            "die spezielle Abdichtung von Kabeldurchdringungen in einer Wand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f0baf28-2cbd-44c0-8be6-8e1558f80604",
                                "sense_id": "8e10aa14-9ea9-356a-b867-644c941ef0b8",
                                "text": "„Ein ordnungsgemäßes Kabelschott muß vielmehr einen ganzen Katalog von Anforderungen erfüllen.“"
                            },
                            {
                                "example_id": "d4083da9-b3c9-471a-82b8-132556104cd4",
                                "sense_id": "8e10aa14-9ea9-356a-b867-644c941ef0b8",
                                "text": "„ Im übrigen ist die Bauart der raumabschließenden Bauteile, in die ein Kabelschott eingebaut werden darf, zu beachten.“"
                            },
                            {
                                "example_id": "6866eac9-b98d-433e-84de-a9224f8d4827",
                                "sense_id": "8e10aa14-9ea9-356a-b867-644c941ef0b8",
                                "text": "„An der Übergabestelle Energieschacht ins Geschoß ist ein Kabelschott eingebaut.“"
                            },
                            {
                                "example_id": "f6640546-9977-414b-b477-7cb5b6ad8340",
                                "sense_id": "8e10aa14-9ea9-356a-b867-644c941ef0b8",
                                "text": "„Die Zulassung des Kabelschotts muss in Kopie auf der Baustelle vorhanden sein.“"
                            },
                            {
                                "example_id": "970c2351-dc01-4e5e-aed6-7120c9a8fa18",
                                "sense_id": "8e10aa14-9ea9-356a-b867-644c941ef0b8",
                                "text": "„Das Kabelschott ist ein vielseitig einsetzbares Abschottungs-System aus Mineralwolle der Baustoffklasse A 1 und einem intumeszierenden Beschichtung für Kabel und Leitungen aller Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
