                                "sense_id": "c5c04928-c7c3-33d0-99fe-6d6c75520c89",
                                "text": "Sie waren teilweise mit Eisenstangen bewaffnet. Es flogen Steine."
                            },
                            {
                                "example_id": "6c10ed6c-0c26-4c2e-a348-d1c192697c81",
                                "sense_id": "c5c04928-c7c3-33d0-99fe-6d6c75520c89",
                                "text": "Sie transportieren Eisenstangen, Pflastersteine und Kies zur Baustelle."
                            }
                        ]
                    }
