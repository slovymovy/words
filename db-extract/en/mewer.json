                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4206273-7aa8-473d-8e05-2af1ca579066",
                                "sense_id": "06fbfdb5-4fb9-3856-928a-b64d25d8c28d",
                                "text": "They heard a noise of mournful mewing, and looked down at the cats in the river below. A small black one, the probable mewer, was gazing up at them with such a sorrowful expression in its green eyes that my lady was wrung with pity."
                            },
                            {
                                "example_id": "831fb1cf-cc85-42be-9b73-9db75166d7db",
                                "sense_id": "06fbfdb5-4fb9-3856-928a-b64d25d8c28d",
                                "text": "This supposedly demonstrates 'uncertainty' because one doesn't know if the cat is dead or alive until you peek inside. However, our version is more deterministic. There is no isotope-clock, no hydrocyanic acid. We drop a mewer in one of these reusable modules, close it tight, add just a limited supply of oxygen […]"
                            }
                        ]
