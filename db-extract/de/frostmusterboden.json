                        "entry_id": "e459b0b7-26b6-3576-bc61-c609692ceeab",
                        "glosses": [
                            "ein durch kreisförmig bis sechseckig angeordnete Steine, die sich wabenähnlich über den Boden erstrecken, gekennzeichneter Strukturboden in den Polargebieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "499caf8a-c735-4c73-9c7e-99fcf066ec6b",
                                "sense_id": "6ef93bdf-a19d-3023-9301-a3e711456578",
                                "text": "„Blockgletscher, Solifluktion und Frostmusterböden sind klassische periglaziale Erscheinungen subpolarer Gebiete und Hochgebirgsregionen.“"
                            },
                            {
                                "example_id": "79391aa0-2f38-4449-86bf-3bb3cee56f9d",
                                "sense_id": "6ef93bdf-a19d-3023-9301-a3e711456578",
                                "text": "„Der Frostmusterboden ist ein Strukturboden, der durch kreisförmig bis sechseckig angeordnete Steine, die sich wabenähnlich über den Boden erstrecken, gekennzeichnet ist.“"
                            }
                        ],
