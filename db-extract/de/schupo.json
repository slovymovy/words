                        "form": "der Schupo"
                    },
                    {
                        "form_id": "a25a82f7-0989-4e1e-96fa-4c1542ff65c8",
                        "entry_id": "45920486-051c-306b-98ab-eb8a59f38f60",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Schupo"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                        "entry_id": "45920486-051c-306b-98ab-eb8a59f38f60",
                        "glosses": [
                            "in der Bundesrepublik Schutzpolizei"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "70add811-8e65-421f-b199-6f348ef043f4",
                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                "text": "„Während der Fahrt nach Osten wurden die Transporte von Angehörigen der Schutzpolizei (Schupo) bewacht.“"
                            },
                            {
                                "example_id": "f08f17df-ee56-4ec3-8735-b5fb02d6e5bd",
                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                "text": "„Wo auch die Schupo vorstößt, ihn zu fassen meint, schon mit den Händen zu halten glaubt… Zehn Meter weiter wandert er, blinkt er, spottet er, droht er.“"
                            },
                            {
                                "example_id": "b2fa5584-d025-4df9-a469-65d9403291ab",
                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                "text": "„Die Schupo arbeitete glänzend.“"
                            },
                            {
                                "example_id": "d08f1d49-18ad-4abe-bd6c-81384f768e7b",
                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                "text": "„Die Kladnoer Schupo erschoss alle Männer, lieferte die Frauen in Konzentrationslager, verteilte die Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b85170c0-fd3a-4f87-8da1-ee8eeed55805",
                        "source_entry_id": "45920486-051c-306b-98ab-eb8a59f38f60",
                        "source_sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                        "source_sense_description": "in der Bundesrepublik kurz für: Schutzpolizei",
                        "target_lang_word": "uniformed police",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "522ef984-44cb-47ae-b3c4-4fcdee8805f0",
                        "source_entry_id": "45920486-051c-306b-98ab-eb8a59f38f60",
                        "source_sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                        "source_sense_description": "in der Bundesrepublik kurz für: Schutzpolizei",
                        "target_lang_word": "policier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "policier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6da8e552-d48d-3227-a13b-eecf6138ac05",
                                        "entry_id": "3cb235e1-ed04-36be-a691-5f3fdf470683",
                                        "glosses": [
                                            "Fonctionnaire employé dans la police."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d646eccc-8945-4460-a9ee-7b9d471ae98b",
                                                "sense_id": "6da8e552-d48d-3227-a13b-eecf6138ac05",
                                                "text": "Aussi rien n’est-il plus naturel que de voir des policiers […] prendre, pour ne pas effaroucher leur proie, l’apparence des gars qu’ils ont la mission d’appréhender."
                                            },
                                            {
                                                "example_id": "80fdfc7e-aa14-4117-8919-a6f44efb9001",
                                                "sense_id": "6da8e552-d48d-3227-a13b-eecf6138ac05",
                                                "text": "Les policiers angoumoisins sont appelés par un riverain du centre-ville d’Angoulême qui signale que deux individus s’amusent à dégrader les rétroviseurs de voitures."
                                            },
                                            {
                                                "example_id": "cbfc4665-dfcb-4a6b-b06c-f474f3e0b31c",
                                                "sense_id": "6da8e552-d48d-3227-a13b-eecf6138ac05",
                                                "text": "Certes, Jean-Luc en tira l’avantage essentiel en utilisant ses talents de conteur qui transformaient en acte de bravoure sa fuite devant les policiers. Mais il eut le bon goût de m’associer dans le récit de son épopée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae50c7e0-6d26-3747-bc8d-d899d3e62a95",
                                        "entry_id": "3cb235e1-ed04-36be-a691-5f3fdf470683",
                                        "glosses": [
                                            "Roman policier."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f9b3b8-fc9f-4efd-a17e-ae99fbd9c489",
                                                "sense_id": "ae50c7e0-6d26-3747-bc8d-d899d3e62a95",
                                                "text": "Je détestais qu’on appelât les romans policiers des policiers. Cette abréviation témoignait d’une veulerie de langage."
                                            },
                                            {
                                                "example_id": "49eeebd0-fd12-4da1-b7cc-934b13a21ed7",
                                                "sense_id": "ae50c7e0-6d26-3747-bc8d-d899d3e62a95",
                                                "text": "Un matin, elle assista à une scène qui la bouleversa. Un patient attendait son tour afin de passer une radio. Assis sur un chariot, il lisait un policier de la collection le Masque."
                                            },
                                            {
                                                "example_id": "a80b2ffe-0371-4575-9935-f72b741a5e78",
                                                "sense_id": "ae50c7e0-6d26-3747-bc8d-d899d3e62a95",
                                                "text": "Première constatation, l'auteur de polar doit avoir du souffle. […]. L'éditeur de policiers préférera toujours un auteur productif à un auteur de qualité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "policier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b81b4034-15ed-3fe5-ab2c-139e10c8a4b7",
                                        "entry_id": "f0de86a4-925b-306b-969e-c67b405dfc46",
                                        "glosses": [
                                            "Qui est relatif à la police."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ba0311-d9a8-44fc-b661-4c9fcffd81c9",
                                                "sense_id": "b81b4034-15ed-3fe5-ab2c-139e10c8a4b7",
                                                "text": "A. Comte avait fabriqué une caricature du catholicisme, dans laquelle il n’avait conservé que la défroque administrative, policière et hiérarchique de cette Église ; […]."
                                            },
                                            {
                                                "example_id": "f9edaf07-1390-423c-818b-05b4b189868d",
                                                "sense_id": "b81b4034-15ed-3fe5-ab2c-139e10c8a4b7",
                                                "text": "Afin de démonopoliser, de désexpertiser le droit, l’enseignement doit être donné par les éducateurs réguliers et non pas par des policiers ou des juristes comme l’on tend à le pratiquer car, en premier lieu ceux-ci ne possèdent aucune formation pédagogique et d’autre part l’entraînement du policier est basé avant tout sur la répression : les échecs répétés dans la mise en application de l’enseignement juridique par les policiers sont dus avant tout au besoin inné d’inquisition de la personnalité policière."
                                            },
                                            {
                                                "example_id": "97b083dd-34bf-42b5-a696-490af07e4dc1",
                                                "sense_id": "b81b4034-15ed-3fe5-ab2c-139e10c8a4b7",
                                                "text": "Agrégé d'histoire du droit et de droit romain, autoritaire et un rien coléreux, il est fasciné par les méthodes policières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50649eb2-f4e9-36d8-85c2-f168b73b7016",
                                        "entry_id": "f0de86a4-925b-306b-969e-c67b405dfc46",
                                        "glosses": [
                                            "Qualifie une histoire fictive dans laquelle on représente des policiers ou des détectives privés en action."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
