                                "target_senses": [
                                    {
                                        "sense_id": "749feb8e-7861-354c-aaec-de9e11bd4313",
                                        "entry_id": "ee9346a5-385c-3d2b-a3b0-1af01f9ed6ed",
                                        "glosses": [
                                            "die Kasse Führender"
                                        ],
                                        "tags": [],
