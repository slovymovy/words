                                "target_senses": [
                                    {
                                        "sense_id": "e5453163-0d11-3785-9876-572ab260ac4a",
                                        "entry_id": "36b6ac74-8773-32a3-8339-dc4adeb63dcf",
                                        "glosses": [
                                            "Enveloppe de cuir, tôle, mica, aluminium, etc., servant à protéger un engrenage ou un moteur d’automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b4e7140-faed-4fb2-8496-d1d5b53717b9",
                                                "sense_id": "e5453163-0d11-3785-9876-572ab260ac4a",
                                                "text": "Hoo Lagaffe! Tu dois avoir un joint de pété… ou alors c’est ton carter qui est fendu: viens voir l’huile que tu perds…"
                                            },
                                            {
                                                "example_id": "a10b9df1-aa53-4f4d-81f5-0d5e4527fe98",
                                                "sense_id": "e5453163-0d11-3785-9876-572ab260ac4a",
                                                "text": "La roue arrière de la bicyclette des femmes était protégée d’un filet et la chaîne d’un carter pour que la jupe ne soit pas prise dans les rayons ou dans la chaîne, ce qui aurait entraîné des chutes."
                                            },
                                            {
                                                "example_id": "b58caac5-b698-484b-89be-e9fefe9e2f15",
                                                "sense_id": "e5453163-0d11-3785-9876-572ab260ac4a",
                                                "text": "Le débit de gaz entre la chambre de combustion et le carter augmente, le débit d’huile consommée également."
                                            },
                                            {
                                                "example_id": "8019e8ed-9930-41df-a830-11849c090668",
                                                "sense_id": "e5453163-0d11-3785-9876-572ab260ac4a",
                                                "text": "Le carter s'était encore rompu sous les assauts de chocs impitoyables, et l’huile pissait de plus belle, marquant le sable de pustules noirâtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c989a099-efc5-3e98-8788-28a8b399b87e",
                                        "entry_id": "36b6ac74-8773-32a3-8339-dc4adeb63dcf",
                                        "glosses": [
                                            "Enveloppe isolant les parties dangereuses d’un engin, d’une machine ou tout autre élément présentant un danger pour la sécurité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "carter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "221e5d5e-6beb-3ca1-ac8d-52cdeb699e34",
                                        "entry_id": "a5e17298-d3a1-3aa1-a08d-5890ec45b6c9",
                                        "glosses": [
                                            "Présenter quelque chose sur ou autour d'une carte en vue de sa vente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a64f7df-4230-4775-a25b-fbebe8313b80",
                                                "sense_id": "221e5d5e-6beb-3ca1-ac8d-52cdeb699e34",
                                                "text": "Carter des boutons, des fils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e482a6d0-2009-3407-af54-bb15e54149ca",
                                        "entry_id": "a5e17298-d3a1-3aa1-a08d-5890ec45b6c9",
                                        "glosses": [
                                            "S’assurer de l’âge légal d’une personne, par exemple pour la distribution d’un produit règlementé ou l’accès à un établissement, par l’examen de la carte d’identité de cet individu."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a7723b1-f52d-4d65-b79a-5381ece9f555",
                                                "sense_id": "e482a6d0-2009-3407-af54-bb15e54149ca",
                                                "text": "Hier soir, les policiers sont entrés dans le bar et ils ont carté tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
