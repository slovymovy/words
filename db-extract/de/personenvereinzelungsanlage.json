                ],
                "senses": [
                    {
                        "sense_id": "4d10b399-7b68-3bae-9d0f-46c08049000e",
                        "entry_id": "0b2cacad-1f11-3f48-a2f8-114083836b73",
                        "glosses": [
                            "Vorrichtung, die es möglich macht, dass Personen einzeln etwas betreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b3adaf-1f43-44f2-bd40-7ac77a0dc955",
                                "sense_id": "4d10b399-7b68-3bae-9d0f-46c08049000e",
                                "text": "„Am ersten Zutrittskontrollpunkt wird nur dieses Identifikationsmerkmal gecheckt und danach der Zutritt durch eine Personenvereinzelungsanlage freigegeben.“"
                            },
                            {
                                "example_id": "a911020b-9936-4588-aede-4821a14fd5de",
                                "sense_id": "4d10b399-7b68-3bae-9d0f-46c08049000e",
                                "text": "„Die vorliegende Erfindung betrifft eine Personenvereinzelungsanlage mit einem mittels wenigstens eines Sperrelements versperrbaren Durchgang, welcher mithilfe von Leitelementen beidseitig begrenzt ist.“"
                            },
                            {
                                "example_id": "ee8cdda2-447b-45a8-be6b-c268f518495f",
                                "sense_id": "4d10b399-7b68-3bae-9d0f-46c08049000e",
                                "text": "„Alle Zugänge und Zufahrten in das Gebäude müssen durch die Pförtner mit Personenvereinzelungsanlagen und Codekarten-System kontrolliert und gesichert werden.“"
                            },
                            {
                                "example_id": "94e64aa3-cf2d-4507-aa50-f0cd8609bebf",
                                "sense_id": "4d10b399-7b68-3bae-9d0f-46c08049000e",
                                "text": "„Die Ausführungen derartiger Personenvereinzelungsanlagen reichen von Schleusen, z. B. Rund- und Schiebetürschleusen, bis hin zu Vereinzelungs-Drehtüren.“"
                            },
                            {
                                "example_id": "2c25118d-ddfc-40e9-bcbb-8170700f5880",
                                "sense_id": "4d10b399-7b68-3bae-9d0f-46c08049000e",
                                "text": "„Gerade bei den oben bereits erwähnten Personenvereinzelungsanlagen sind auch zusätzliche Identifikationsmerkmale, etwa Gewicht, Größe, Metalldetektoren oder Bildvergleich durch anwesendes Personal, denkbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
