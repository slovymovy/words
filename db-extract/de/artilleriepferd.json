                "senses": [
                    {
                        "sense_id": "c686c3f4-34b0-3033-86b2-053590de8c4f",
                        "entry_id": "f8cf485c-7e54-385f-a779-2f27db96093b",
                        "glosses": [
                            "von der Artillerie verwendetes Pferd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede4a137-5a05-4a3c-af16-1cdb03345c97",
                                "sense_id": "c686c3f4-34b0-3033-86b2-053590de8c4f",
                                "text": "„König Friedrich II. behauptete stets, sein Architekt Georg Wenzeslaus von Knobelsdorff sei ‚faul wie ein Artilleriepferd‘ und führe nicht aus, was man ihm befehle.“"
                            },
                            {
                                "example_id": "2b4fe4be-6a25-43a4-8431-6cf04836e40d",
                                "sense_id": "c686c3f4-34b0-3033-86b2-053590de8c4f",
                                "text": "„Ich hatte zu verschiedenenmalen über den Mist von 2-300 in Buchsweiler cantonnirenden Artilleriepferden zu verfügen, welchen ich in eine Miststätte mit zwei Abtheilungen von 400 Quadratmetern Flächenraum brachte und 3-4 Meter hoch aufhäufte.“"
                            },
                            {
                                "example_id": "2d1fdb87-e3e0-44f0-80a2-707757036561",
                                "sense_id": "c686c3f4-34b0-3033-86b2-053590de8c4f",
                                "text": "„‚Seiner Tage kommt er nicht von der Stelle!‘ und ‚faul ist er wie ein Artilleriepferd‘ – das waren allerhöchste Marginalien auf offiziellen Kabinettsorders, aus denen sich der ‚ziemliche Kaltsinn Seiner Majestät‘ dem Surintendanten gegenüber erklärt, von dem einer der Baubeamten zu berichten weiß.“"
                            },
                            {
                                "example_id": "327edc31-4847-4086-a1dd-7cabe504d0d2",
                                "sense_id": "c686c3f4-34b0-3033-86b2-053590de8c4f",
                                "text": "„Seit 8 Tagen ist man hier unaufhörlich mit Kriegsrüstungen und Patronenmachen beschäfftigt, auch ist allenthalben bekannt gemacht, daß alle, welche Lust hätten, Artilleriepferde zum Dienst der Armee zu liefern, sich gehörigen Orts melden könnten.“"
                            },
                            {
                                "example_id": "b916f86d-4149-4ba6-806a-0487ca695c18",
                                "sense_id": "c686c3f4-34b0-3033-86b2-053590de8c4f",
                                "text": "„Da erinnerte er sich der Artilleriepferde, die sie abseits in einem Wäldchen zurückgelassen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
