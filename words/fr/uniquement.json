                    "frequency": "VeryLow",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet hôte généreux s'était montré <w>uniquement</w> bienveillant envers ses invités fatigués."
