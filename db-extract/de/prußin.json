                ],
                "senses": [
                    {
                        "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                        "entry_id": "96c3ed66-0d32-33ac-a3e8-cf1411943066",
                        "glosses": [
                            "Angehörige eines untergegangenen baltischen Volkes in Prußen, dem späteren Ost- und Westpreußen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8367825e-b097-42ab-a58d-cf65967d36b9",
                                "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                                "text": "Er war Kure, seine Frau Prußin."
                            },
                            {
                                "example_id": "b20e2d66-7cf7-469c-a4f7-d4acdf7cc63f",
                                "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                                "text": "„Bretke beherrschte in einer einzigartigen Kombination die drei in Ostpreußen gesprochenen baltischen Sprachen, neben dem Litauischen die Sprache seiner Mutter, einer Prußin, und das Kurische, einen an der ostpreußischen Küste gesprochenen lettischen Dialekt.“"
                            },
                            {
                                "example_id": "65aac01e-7ba0-47bf-8034-f89c00aece8c",
                                "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                                "text": "„Eine Ausnahme sei Jonas Bretkūnas (Johann Bretke, 1536-1602), dessen Mutter eine Prußin war.“"
                            },
                            {
                                "example_id": "6e94c7c8-0b5d-439b-8711-50e7746b2f55",
                                "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                                "text": "„Eine Prußin hatte ihm den Auszug fast der gesamten Besatzung gemeldet.“"
                            },
                            {
                                "example_id": "0421fb9b-28a7-471c-bd1d-9d0f1823f776",
                                "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                                "text": "„Die Malerei kann ich nur von Großmutter haben. Und die starke Verbundenheit mit der Natur habe ich auch von ihr. Sie malt Sargporträts. Sie ist eine Prußin, und Esther steht bloß eingedeutscht Aster, ein uraltes Prußengeschlecht, denke ich.“"
                            },
                            {
                                "example_id": "1e50db0d-6965-4de9-804b-94ec86a0cd04",
                                "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                                "text": "„Die von ihnen zu Witwen gemachten Prußinnen mussten zudem den gewaltsamen Beischlaf der Ordensritter erdulden […].“"
                            },
                            {
                                "example_id": "af5a89dc-6b3f-4ac8-9353-18b8f728e9cc",
                                "sense_id": "3be282d6-5703-30ce-9c25-f31d34b64bcd",
                                "text": "„Die Erzählung spielt zur Zeit der Reformation , und ‚undeutsche Frauen‘ sind Litauerinnen oder Prußinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
