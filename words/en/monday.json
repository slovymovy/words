                            "comment": "Common in American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В день недели, называемый понедельником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в понедельник",
