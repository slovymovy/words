                ],
                "senses": [
                    {
                        "sense_id": "8a1d3b40-7d33-3090-9cf9-7c02d3f49e48",
                        "entry_id": "109494d2-f1f2-391c-85af-554b31c0ee11",
                        "glosses": [
                            "A figure-eight curve that results when the Sun's position in the sky is plotted out over the year at the same hour of mean solar time every day."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ac1d66c-2a1a-41bf-b106-f549b7bbdc17",
                                "sense_id": "8a1d3b40-7d33-3090-9cf9-7c02d3f49e48",
                                "text": "People commonly encounter the equation of time in a strangely distorted figure 8, the analemma (Figure 6.5), frequently seen on terrestrial globes. The analemma is the equation of time plotted against the Sun's declination."
                            },
                            {
                                "example_id": "e2349924-574f-4a9a-b366-ed91c9cbcc59",
                                "sense_id": "8a1d3b40-7d33-3090-9cf9-7c02d3f49e48",
                                "text": "The analemma also records the difference between local solar time and local mean time for each day of the year."
                            },
                            {
                                "example_id": "a2791160-3d37-4785-b1b5-ba563b4a8062",
                                "sense_id": "8a1d3b40-7d33-3090-9cf9-7c02d3f49e48",
                                "text": "The analemma's shape varies by location, but is seldom perfectly balanced.[…]\nThe ends of the analemma represent summer and winter, but if we expect the solstices to be exactly at the ends and the equinoxes to be at the crossing point, we'd be wrong."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0269b2da-b37f-4999-b286-cdb7828a320e",
                        "source_entry_id": "109494d2-f1f2-391c-85af-554b31c0ee11",
                        "source_sense_id": "8a1d3b40-7d33-3090-9cf9-7c02d3f49e48",
                        "source_sense_description": "curve of the Sun's position in the sky throughout the year",
                        "target_lang_word": "analemma",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analemma",
