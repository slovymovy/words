                "senses": [
                    {
                        "sense_id": "ad6be29c-f402-35e9-a3f4-432cb2fda531",
                        "entry_id": "3fafd7d5-6aa5-398e-9427-25578e8cf3e2",
                        "glosses": [
                            "Autre orthographe de tebé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a7b6c6-2285-411f-994b-054ffc1a4d0c",
                                "sense_id": "ad6be29c-f402-35e9-a3f4-432cb2fda531",
                                "text": "T’es trop teubé, t’as mis ton cerveau en dépôt-vente ou quoi ?!"
                            },
                            {
                                "example_id": "4daf57ad-82d4-47b2-8de2-7fc2995fd5f1",
                                "sense_id": "ad6be29c-f402-35e9-a3f4-432cb2fda531",
                                "text": "À la toute base, la marque Play-Doh avait commercialisé sa pâte à modeler pour enlever les tâches sur les papiers peints, donc rien à voir avec une quelconque utilité pour en faire des sculptures rigolotes et être mangé par des enfants un peu teubés."
                            },
                            {
                                "example_id": "ba65e724-f464-4e11-89b6-c8fe9e8a07ab",
                                "sense_id": "ad6be29c-f402-35e9-a3f4-432cb2fda531",
                                "text": "– On te propose d’aller dans un pays que tu ne connais pas, et puis pas n’importe lequel, celui de ta mère, de tes origines, pour rencontrer ta famille et toi... tu préfères rester glandouiller à Versailles Rive-Droite tout l’été comme un gros galérien ! T’es teubé ou tu le fais exprès ?"
                            }
                        ]
                    }
                ],
