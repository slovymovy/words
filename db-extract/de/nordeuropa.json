                "senses": [
                    {
                        "sense_id": "2ea0d949-c05f-397a-accb-464163d0fab8",
                        "entry_id": "e1abc68f-9971-34e1-83eb-823fef4d5b0c",
                        "glosses": [
                            "das nördliche Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd927aa-6bde-457b-a881-e2eefefeb8c9",
                                "sense_id": "2ea0d949-c05f-397a-accb-464163d0fab8",
                                "text": "Umgangssprachlich sind in Deutschland mit dem Begriff „Nordeuropa“ meistens die Nordischen Länder gemeint."
                            },
                            {
                                "example_id": "94bd7145-6d93-4bb2-bba3-e30cc35e13d6",
                                "sense_id": "2ea0d949-c05f-397a-accb-464163d0fab8",
                                "text": "„Bald kennen die Steuermänner die Strömungen und Gefahren auf der Fahrt zwischen Nordeuropa und Island besser, ist die Route weniger risikoreich als zuvor.“"
                            },
                            {
                                "example_id": "57645c16-584b-4c6a-8b4e-c9be85a2d311",
                                "sense_id": "2ea0d949-c05f-397a-accb-464163d0fab8",
                                "text": "„Neben die Gebirgsbildungen tritt ein weiteres wichtiges geologisches Ereignis, das Eiszeitalter, in dem Nordeuropa mehrfach von einer mächtigen Inlandeisdecke überdeckt war, die sich bis nach England, nach Mitteleuropa und in das Osteuropäische Flachland hinein erstreckte.“"
                            },
                            {
                                "example_id": "3487a298-6969-4cb4-90ef-cd5d935ecf0b",
                                "sense_id": "2ea0d949-c05f-397a-accb-464163d0fab8",
                                "text": "„Während der großen Kaltphase, dem glazialen Maximum, war der größte Teil Nord- und Mitteleuropas vereist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
