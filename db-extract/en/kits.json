    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "59169c94-e9ef-3202-bf04-d1bb4c67ccf1",
                "word": "Kits",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "80369ff7-1a45-3b27-82d4-49648e8bbab9",
                        "entry_id": "59169c94-e9ef-3202-bf04-d1bb4c67ccf1",
                        "glosses": [
                            "The Kitsilano neighbourhood of Vancouver."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ddfb0d99-88f8-4707-b601-bb3c5361b3aa",
                                "sense_id": "80369ff7-1a45-3b27-82d4-49648e8bbab9",
                                "text": "Vegetarians will think they've died and gone to heaven, especially in Kits, the former center of hippiedom."
                            },
                            {
                                "example_id": "b164f820-6008-45d8-bced-c19a8bf1ca6b",
                                "sense_id": "80369ff7-1a45-3b27-82d4-49648e8bbab9",
                                "text": "So often, as they'd stroll down the pathways and sidewalks in Kits, they'd remark on the essence of the neighbourhood, sighing, “only here”."
                            },
                            {
                                "example_id": "91a64f59-2fd4-453d-b2c3-57d51a06dca1",
                                "sense_id": "80369ff7-1a45-3b27-82d4-49648e8bbab9",
                                "text": "She'd walked from Kits to Granville Island, intending to take the water-bus across False Creek and walk down Burrard Street to West Georgia."
                            }
                        ]
                    }
                ],
