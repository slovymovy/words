                "senses": [
                    {
                        "sense_id": "51348a5b-7a7a-3dab-9f81-a4a1f1e69418",
                        "entry_id": "343d04f8-bea4-3ad5-80d9-066bef925ad9",
                        "glosses": [
                            "Bezeichnung verschiedener Verwaltungsbezirke in Frankreich, Belgien, Kanada und anderen Ländern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "872cab5a-e62c-4ce6-b580-12bc61005ab6",
                                "sense_id": "51348a5b-7a7a-3dab-9f81-a4a1f1e69418",
                                "text": "Belgien ist in 43 Arrondissements eingeteilt."
                            },
                            {
                                "example_id": "7fefc542-a3f3-48ed-a92d-1b8eb1fb64d6",
                                "sense_id": "51348a5b-7a7a-3dab-9f81-a4a1f1e69418",
                                "text": "„Am folgenden Sonntag standen sie und Adrienne mit einer schwitzenden Flasche weißem Bordeaux im 16. Arrondissement und warteten darauf, dass André Spire oder seine Frau ihnen die Tür öffnete.“"
                            },
                            {
                                "example_id": "7966f161-2c6b-4b97-bb98-073e340f6daf",
                                "sense_id": "51348a5b-7a7a-3dab-9f81-a4a1f1e69418",
                                "text": "„Das hatte fünf Sterne und lag im sechsten Arrondissement, so versteckt, dass sogar der Chauffeur den Weg nur mit Mühe fand.“"
                            },
                            {
                                "example_id": "beaa06f7-796d-431a-a7bf-726d75a8801a",
                                "sense_id": "51348a5b-7a7a-3dab-9f81-a4a1f1e69418",
                                "text": "„Was den Alligator anbelangt, so habe man ihn im November des Jahres 1825 unter den Klippen von Les Hachettes zu Saint-Honorine bei Port-en-Bessin im Arrondissement Bayeux entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
