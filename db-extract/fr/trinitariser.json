                ],
                "senses": [
                    {
                        "sense_id": "f9a5a993-d567-312c-ad46-6eb5894a1dff",
                        "entry_id": "7c3643b2-b6e0-31a2-8216-39857605bc3e",
                        "glosses": [
                            "Donner un caractère trinitaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bdb571a-8e84-4453-81ab-f0bece8da117",
                                "sense_id": "f9a5a993-d567-312c-ad46-6eb5894a1dff",
                                "text": "En étendant l’homoousie à la troisième hypostase, l’intelligence chrétienne se trouvera dès lors conduite, si l’on peut dire, à « trinitariser » l’acte créateur lui-même."
                            },
                            {
                                "example_id": "7a35f4da-7e10-42c8-a83f-719682955d75",
                                "sense_id": "f9a5a993-d567-312c-ad46-6eb5894a1dff",
                                "text": "On peut l’affirmer en toute confiance : Le Dieu-homme est la toute-vertu. C’est pourquoi la sainte mission assignée à la vie de tout chrétien est de se porter acquéreur de toute vertu, de se christifier, de se divino-humaniser, de se trinitariser — Oui, de se trinitariser, car là où est le Fils, là est aussi le Père, et là aussi est l’Esprit saint, la Trinité tri-hypostatique et indivisible tout entière."
                            }
                        ]
                    }
