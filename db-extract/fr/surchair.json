                        "entry_id": "3d29dce0-8b59-39ae-8dce-0aee4af80046",
                        "glosses": [
                            "Gants fabriqués dans la région du Dauphiné, avec ce type de cuir."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d07af8-9cc4-4364-b794-88db7da5096d",
                                "sense_id": "208b9518-3ff1-3211-b4fc-0f2bd59da98e",
                                "text": "Ceux dit surchair [valent] un peu moins. Ce genre ne se fait qu’à Grenoble."
                            },
                            {
