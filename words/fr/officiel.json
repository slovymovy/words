                    "frequency": "High",
                    "semantic_group_id": "autorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le français est la langue <w>officielle</w> de plusieurs organisations internationales à travers le monde."
                        },
                        {
                            "text": "Le ministre a fait une visite <w>officielle</w> pour inaugurer le nouveau musée de la ville."
                        }
                    ],
                    "synonyms": [
