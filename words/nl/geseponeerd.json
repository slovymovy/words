    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45fd931c-df00-3f6c-8659-82d8f71255b7",
                    "sense_definition": "Niet verder vervolgd of terzijde gelegd door justitie",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "juridisch_sepot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De strafzaak tegen de verdachte werd uiteindelijk <w>geseponeerd</w> wegens gebrek aan bewijs.",
                            "target_lang_translations": {
                                "en": "The criminal case against the suspect was ultimately <w>dismissed</w> due to a lack of evidence."
                            }
                        },
                        {
                            "text": "Een <w>geseponeerde</w> zaak kan onder bepaalde voorwaarden toch weer worden geopend.",
                            "target_lang_translations": {
                                "en": "A <w>dismissed</w> case can still be reopened under certain conditions."
                            }
                        }
                    ],
                    "synonyms": [
                        "afgedaan",
                        "terzijde gelegd"
                    ],
                    "antonyms": [
                        "vervolgd"
                    ],
                    "common_phrases": [
                        "geseponeerde zaak",
                        "strafzaak geseponeerd"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridisch jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Not prosecuted further or set aside by the public prosecution service"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismissed",
                                "target_lang_sense_clarification": "of a legal case, dropped or not prosecuted"
                            },
                            {
                                "target_lang_word": "dropped",
                                "target_lang_sense_clarification": "of charges or a case, discontinued"
                            },
                            {
                                "target_lang_word": "shelved",
                                "target_lang_sense_clarification": "put aside or not proceeded with"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09c92153-db1b-3c04-b025-9ede717f12c9",
                    "sense_definition": "voltooid deelwoord van <w>seponeren</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De officier van justitie heeft de klacht gisteren officieel <w>geseponeerd</w>.",
                            "target_lang_translations": {
                                "en": "The public prosecutor officially <w>dismissed</w> the complaint yesterday."
                            }
                        },
                        {
                            "text": "Nadat de politie het dossier had onderzocht, werd de zaak direct <w>geseponeerd</w>.",
                            "target_lang_translations": {
                                "en": "After the police investigated the file, the case was immediately <w>dropped</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of seponeren (to dismiss, drop, or shelve a legal case)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismissed",
                                "target_lang_sense_clarification": "past participle of dismissing a case"
                            },
                            {
                                "target_lang_word": "dropped",
                                "target_lang_sense_clarification": "past participle of dropping charges"
                            }
                        ]
                    }
                }
            ]
        }
    ]
