                ],
                "senses": [
                    {
                        "sense_id": "39c46ea6-94de-31ac-a6f6-1303cd25043b",
                        "entry_id": "81404744-4ad1-32b5-8587-434c204e568f",
                        "glosses": [
                            "Mesure du taux de plomb présent dans le sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1fa8c28-6201-4761-a81c-ab1367dc613a",
                                "sense_id": "39c46ea6-94de-31ac-a6f6-1303cd25043b",
                                "text": "Pour une suspicion de saturnisme, le médecin va effectuer une plombémie."
                            },
                            {
                                "example_id": "b4e7e0ed-e4ca-48fe-b3a3-d3630532aab7",
                                "sense_id": "39c46ea6-94de-31ac-a6f6-1303cd25043b",
                                "text": "Le système national de surveillance des plombémies de l’enfant mineur prévoit l’enregistrement d’informations nominatives pour toute plombémie (dosage du plomb sanguin) réalisée chez un enfant en France, quel qu’en soit le résultat."
                            }
                        ]
                    },
                    {
                        "sense_id": "801ca38e-9027-3d28-95c3-02991ebbd90b",
                        "entry_id": "81404744-4ad1-32b5-8587-434c204e568f",
                        "glosses": [
                            "Taux de plomb présent dans le sang."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "04dbda55-659e-4f74-9d02-942f3f7b485e",
                                "sense_id": "801ca38e-9027-3d28-95c3-02991ebbd90b",
                                "text": "C’est pourquoi, suivant les recommandations du Haut Conseil de la santé publique, les autorités sanitaires ont décidé par arrêté en date du 8 juin 2015 d’abaisser de 100 à 50 microgrammes par litre la concentration en plomb dans le sang (plombémie) définisaant le saturnisme chez l’enfant."
                            }
                        ]
                    }
                ],
