                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On peut admirer toute la ville <w>depuis</w> le balcon de cet appartement."
                        },
                        {
                            "text": "Le journaliste commente l'actualité en direct <w>depuis</w> la place centrale."
                        }
                    ],
                    "common_phrases": [
