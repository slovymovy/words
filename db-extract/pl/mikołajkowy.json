                        "sense_id": "cba67a82-f4bc-3094-8679-2e1350a849dc",
                        "entry_id": "1786c20a-ea41-3a7f-b35f-ad61a0fda908",
                        "glosses": [
                            "związany z mikołajkami, dotyczący mikołajek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e3a966-46d3-4ac3-82b5-8be84f435942",
                                "sense_id": "cba67a82-f4bc-3094-8679-2e1350a849dc",
                                "text": "Znalazł mikołajkowy prezent – babcia Honorata zrobiła mu na drutach szalik, czapkę i rękawice."
                            },
                            {
                                "example_id": "4b135e0a-e981-4181-8fb0-40320e672309",
                                "sense_id": "cba67a82-f4bc-3094-8679-2e1350a849dc",
                                "text": "Dzieci, możecie wymienić jakieś mikołajkowe zwyczaje?"
                            },
                            {
                                "example_id": "c73fff12-bc5d-444d-9e68-343b0281f3c2",
                                "sense_id": "cba67a82-f4bc-3094-8679-2e1350a849dc",
                                "text": "Rysio był świętym Mikołajem na przedszkolnym przyjęciu mikołajkowym."
                            }
                        ],
