                                "example_id": "ab094175-8faa-41a8-b86f-ce034b5edf92",
                                "sense_id": "182dbad6-31cb-30cc-9566-1b145a77eb17",
                                "text": "En revanche, un microtatouage se fait habituellement avec une aiguille individuelle ultrafine."
                            },
