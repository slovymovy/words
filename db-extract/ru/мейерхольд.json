                "senses": [
                    {
                        "sense_id": "368ee590-e227-3e64-8eac-d9e7d64e450e",
                        "entry_id": "fb63dc2e-f43a-386c-b47a-dd6f707263a8",
                        "glosses": [
                            "немецкая фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c944d3-646a-4633-a517-54ec25e19a11",
                                "sense_id": "368ee590-e227-3e64-8eac-d9e7d64e450e",
                                "text": "В области искусств для нас существовало только два авторитета: Командор и Мейерхольд."
                            },
                            {
                                "example_id": "ab45bfda-6c20-4632-a5b7-0db0bf73bfec",
                                "sense_id": "368ee590-e227-3e64-8eac-d9e7d64e450e",
                                "text": "Я видел положительные рецензии на его спектакли. Видел я и отрицательные рецензии на спектакли Мейерхольда."
                            },
                            {
                                "example_id": "16e349fb-5349-46f4-8880-a6c589104659",
                                "sense_id": "368ee590-e227-3e64-8eac-d9e7d64e450e",
                                "text": "Всеволод Эмильевич Мейерхольд оставил невероятной силы документ — письмо к Молотову."
                            }
                        ]
                    }
