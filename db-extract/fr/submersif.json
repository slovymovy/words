                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c74c0778-302c-43ec-a990-626e95d40e8b",
                                "sense_id": "3d9ca4b8-7ed3-3c60-96a1-1dbd0981e4e0",
                                "text": "Vagues submersives : alerte dans le Pas-de-Calais et la Somme"
                            },
                            {
                                "example_id": "cb026443-e91e-44dd-ac96-c09f438b0b2a",
                                "sense_id": "3d9ca4b8-7ed3-3c60-96a1-1dbd0981e4e0",
                                "text": "Les vagues-submersion, ou les vagues submersives, associées le plus souvent à des vents violents en surface, sont des vagues océaniques qui, poussées par le vent, vont submerger le littoral terrestre avec une inondation consécutive."
                            }
                        ]
                    },
