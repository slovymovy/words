                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73dc2b0e-2754-4014-b421-6b1ee80706e1",
                                                "sense_id": "6e5615b0-56a4-3d59-92f1-f20bece4c9b0",
                                                "text": "The child's mother was tearful as he boarded the bus for his first day of primary school."
                                            },
                                            {
                                                "example_id": "fd2140e7-f3d8-4e19-ab85-b1be602959c9",
                                                "sense_id": "6e5615b0-56a4-3d59-92f1-f20bece4c9b0",
                                                "text": "My primary school is a good place to study."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "248a7eed-5763-4d49-8129-748eea3c003b",
                        "source_entry_id": "6e618950-cda9-3b47-832e-d93ba1a3940b",
                        "source_sense_id": "87a0701b-3eb5-3a21-9236-789b659872e2",
                        "source_sense_description": "een school voor lager onderwijs",
                        "target_lang_word": "école primaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "école primaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01750c71-7ca9-31eb-ab90-63cd9f80c508",
                                        "entry_id": "f896649d-b8be-3b32-a3e0-3bf710b92636",
                                        "glosses": [
                                            "Partie de la scolarité regroupant l’école maternelle et l’école élémentaire, et précédant le collège."
                                        ],
                                        "tags": [
                                            "France",
                                            "Signification officielle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78dec4a7-977d-497c-bbd0-1c4dfa2f22b0",
                                                "sense_id": "01750c71-7ca9-31eb-ab90-63cd9f80c508",
                                                "text": "Louis Pasteur alla d'abord à l’école primaire qui occupait une des salles-annexes du collège d'Arbois. L'enseignement mutuel était alors de mode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3dd3cb-7ee3-33c9-859c-426e1c86d6c9",
                                        "entry_id": "f896649d-b8be-3b32-a3e0-3bf710b92636",
                                        "glosses": [
                                            "École élémentaire (partie de la scolarité située entre l’école maternelle et le collège)."
                                        ],
                                        "tags": [
                                            "France",
                                            "Signification la plus usuelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e669a8-7e6b-4cf5-abbd-b69617c01a98",
                                                "sense_id": "4e3dd3cb-7ee3-33c9-859c-426e1c86d6c9",
                                                "text": "[…] ; comme Combes avait parlé de l’enseignement superficiel et borné de nos écoles primaires, F. Buisson crut devoir protester, en sa qualité de grand pédagogue de la troisième République : […]."
                                            },
                                            {
                                                "example_id": "25d663ef-1873-4495-a78c-423ba4340bf4",
                                                "sense_id": "4e3dd3cb-7ee3-33c9-859c-426e1c86d6c9",
                                                "text": "Il est équitable de faire remarquer, en passant, que l’école primaire, tant décriée, et le certificat d’études, si dénigré, ont été en réalité des moyens de francisation d’une efficacité souveraines."
                                            },
                                            {
                                                "example_id": "82c94706-89a6-4a6b-b819-8d71fb9d9465",
                                                "sense_id": "4e3dd3cb-7ee3-33c9-859c-426e1c86d6c9",
                                                "text": "Les écoles primaires regorgeaient cependant d’enfants et celles dites de perfectionnement, d’adultes."
                                            },
                                            {
                                                "example_id": "c18e389a-f043-48d5-b3c8-0cf0f27619f4",
                                                "sense_id": "4e3dd3cb-7ee3-33c9-859c-426e1c86d6c9",
                                                "text": "Le prolongement naturel de l’école primaire était pour les meilleurs élèves, l’école primaire supérieure. Ce qui marquait la différence avec le lycée, c’est qu’on ne faisait pas latin."
                                            },
                                            {
                                                "example_id": "32cc9b8d-a7a1-4431-88ad-776764dc9e47",
                                                "sense_id": "4e3dd3cb-7ee3-33c9-859c-426e1c86d6c9",
                                                "text": "Mon père fait beaucoup d’éloges de la façon dont dans les écoles primaires, à en juger par la mienne, sont traités et instruits les enfants… c’est un modèle d’éducation, ces écoles de France… Un pays pour lequel il voudrait lui faire partager sa passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa8bbcb-49c0-3852-becb-ba41f167c158",
                                        "entry_id": "f896649d-b8be-3b32-a3e0-3bf710b92636",
                                        "glosses": [
                                            "Bâtiment dans laquelle se déroule cette scolarité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2e83134-8bd7-431b-bdce-d0e1a076ddcc",
                                                "sense_id": "daa8bbcb-49c0-3852-becb-ba41f167c158",
                                                "text": "À l’échelon du bourg-centre, le secteur public maintient des équipements banaux (école primaire, bureau de poste, etc.) et d'autres plus singuliers (Trésor Public, gendarmerie, etc.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
