                "senses": [
                    {
                        "sense_id": "1fcc64ae-7069-3858-8e62-b9c9ea8899a2",
                        "entry_id": "af58653d-1e82-35fc-a3ab-f388c5d4dcae",
                        "glosses": [
                            "Kürzung oder Aufhebung von Finanzmitteln oder Arbeitsstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f57902-0691-4e58-94e6-e21c2a06848b",
                                "sense_id": "1fcc64ae-7069-3858-8e62-b9c9ea8899a2",
                                "text": "„Auf die Streichungen geht kaum ein Kritiker ein.“"
                            },
                            {
                                "example_id": "73e2691d-5830-4bf1-9395-fa3626bfdd19",
                                "sense_id": "1fcc64ae-7069-3858-8e62-b9c9ea8899a2",
                                "text": "„Im Gegensatz zum hastigen und expressiven Original handelt es sich bei dem gedruckten Endprodukt um ein geglättetes Ding ohne jene Gedankenstriche, großgeschriebenen Wörter und Streichungen, die ein zwar unregelmäßiges, aber aufregendes visuelles Leseerlebnis vermitteln.“"
                            }
                        ],
