                        "sense_id": "0ece4ede-6d6c-308e-9655-7cc6ad874987",
                        "entry_id": "019e2f11-a517-32aa-9228-d922dad88f8a",
                        "glosses": [
                            "Cellule qui provient de l’hybridation entre des cellules lymphoïdes normales de mammifères et des cellules myélomateuses de tumeurs malignes du système immunitaire."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "24630511-3566-4158-b4b7-2fb494cceeee",
                                "sense_id": "0ece4ede-6d6c-308e-9655-7cc6ad874987",
                                "text": "Le principe général repose sur la fusion d’un lymphocyte B ou d’un plasmocyte avec des cellules de myélome conférant à l’hybridome ainsi formé une capacité proliférative illimitée."
                            }
                        ]
                    }
                ],
