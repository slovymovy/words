                        "glosses": [
                            "Relateur nominal : terminaison qui relie un nom à son déterminant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c685ddb1-54ce-47c4-88c8-fe8dfee9365a",
                                "sense_id": "9460c278-1081-30e1-a25e-191291c360da",
                                "text": "Dans l’expression mala Mesûd, « la maison de Massoud », a est l’ézafé qui relie mal « maison » à Mesûd, « Massoud »."
                            },
                            {
                                "example_id": "f23ffa59-f7b5-4a4b-824a-5e222ce90992",
                                "sense_id": "9460c278-1081-30e1-a25e-191291c360da",
                                "text": "De ce fait l’ézafé est nécessaire pour éviter une ambiguïté de lecture."
                            },
                            {
                                "example_id": "069b44a1-16d6-448b-a02c-77875c39260b",
                                "sense_id": "9460c278-1081-30e1-a25e-191291c360da",
                                "text": "Après le mot yei « un », le nom ainsi que l’adjectif prend, au lieu de l’ézafé, (...)"
                            }
                        ]
                    }
