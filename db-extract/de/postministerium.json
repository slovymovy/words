                ],
                "senses": [
                    {
                        "sense_id": "9c7d32e2-b506-382c-8d49-98a7864a275e",
                        "entry_id": "c921ce84-1d6f-31d9-8ffd-9c7bbb444843",
                        "glosses": [
                            "für die Post zuständiges Ministerium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3103b47c-b0e2-4bbb-bbb3-870991a83fc7",
                                "sense_id": "9c7d32e2-b506-382c-8d49-98a7864a275e",
                                "text": "„Autorisierte Absender sind unter anderem Postministerien, Oberpostdirektionen, Fernmeldeämter, Postsparkassenämter und Postämter genauso wie Sozialeinrichtungen der Post.“"
                            },
                            {
                                "example_id": "562f11af-1db7-4cd1-806b-48716164e7d0",
                                "sense_id": "9c7d32e2-b506-382c-8d49-98a7864a275e",
                                "text": "„Die erste gemeinschaftliche Serie des neuen Postministeriums konnte mit Inkrafttreten des Gesetzes zur Postregulierung ab 1. April 1868 herausgegeben werden.“"
                            },
                            {
                                "example_id": "70c45bd5-a540-4b4e-94ee-a29aeb698015",
                                "sense_id": "9c7d32e2-b506-382c-8d49-98a7864a275e",
                                "text": "„Beide Male spielte das Postministerium bzw. der seit 1954 für die Gestaltung von Briefmarken zuständige Kunstbeirat der Deutschen Bundespost eine wichtige Rolle.“"
                            },
                            {
                                "example_id": "a4834958-95c1-4e06-aa74-0817880874dd",
                                "sense_id": "9c7d32e2-b506-382c-8d49-98a7864a275e",
                                "text": "„Natürlich kannte sie einen Staatssekretär im Postministerium, bei dem sie sich sofort über den ›geldgierigen, impertinenten Menschen‹ beschwerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
