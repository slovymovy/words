                ],
                "senses": [
                    {
                        "sense_id": "8e86d2ec-56ce-3730-bd58-bcb86ae6787c",
                        "entry_id": "1d2f0b55-1c86-309a-8949-f21f5c174b55",
                        "glosses": [
                            "Qui est situé au voisinage immédiat de ; qui est accolé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "391e49bf-a147-42da-bc0f-10964ee4db2c",
                                "sense_id": "8e86d2ec-56ce-3730-bd58-bcb86ae6787c",
                                "text": "Au moment où j’entrais dans le salon du prince, j’avais vu s’ouvrir et se refermer mystérieusement la porte d’un appartement contigu au sien : c’était celui de sa mère, la princesse Lioubitza, femme de Milosch."
                            },
                            {
                                "example_id": "c3b45de3-8bcd-4724-a76d-720b050448fa",
                                "sense_id": "8e86d2ec-56ce-3730-bd58-bcb86ae6787c",
                                "text": "Sur deux sièges contigus sont assis Fulk Ephrinell et miss Horatia Bluett. Ils causent en crayonnant des chiffres."
                            }
                        ]
                    },
                    {
                        "sense_id": "3af2204a-2936-324a-b48a-a4c3c3da6a2d",
                        "entry_id": "1d2f0b55-1c86-309a-8949-f21f5c174b55",
                        "glosses": [
                            "Qui sont voisins sans adhérer l’un à l’autre."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "85b6ba56-79da-4030-af49-fd2557393af5",
                                "sense_id": "3af2204a-2936-324a-b48a-a4c3c3da6a2d",
                                "text": "Cotylédons, sépales contigus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a6819c4-0a6c-4513-932c-aeb82804ff31",
                        "source_entry_id": "1d2f0b55-1c86-309a-8949-f21f5c174b55",
                        "source_sense_id": "8e86d2ec-56ce-3730-bd58-bcb86ae6787c",
