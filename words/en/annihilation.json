{
    "word_family": [
        "annihilate",
        "annihilator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b674e5f-0886-304a-8847-bd45df93080a",
                    "sense_definition": "The act of destroying something completely so that it no longer exists.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>annihilation</w> of the ancient city was caused by a massive volcanic eruption.",
                            "target_lang_translations": {
                                "tr": "Antik kentin <w>yok olması</w>, devasa bir volkanik patlamadan kaynaklandı."
                            }
                        },
                        {
                            "text": "Nuclear weapons threaten the total <w>annihilation</w> of human civilization.",
                            "target_lang_translations": {
                                "tr": "Nükleer silahlar, insan uygarlığının tamamen <w>yok olma</w> tehlikesini doğuruyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "extinction",
                        "eradication"
                    ],
                    "antonyms": [
                        "creation",
                        "generation"
                    ],
                    "common_phrases": [
                        "total annihilation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi artık var olmayacak şekilde tamamen yok etme eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yok etme",
                                "target_lang_sense_clarification": "tamamen ortadan kaldırma"
                            },
                            {
                                "target_lang_word": "imha",
                                "target_lang_sense_clarification": "tahrip ederek yok etme"
                            },
                            {
                                "target_lang_word": "kökünü kurutma",
                                "target_lang_sense_clarification": "tamamen temizleme, ortadan kaldırma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a620426-f51a-30d7-8cd5-2e6794c5984b",
                    "sense_definition": "The state of being completely destroyed or reduced to nothingness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared into the void, contemplating the absolute <w>annihilation</w> of his own identity.",
                            "target_lang_translations": {
                                "tr": "Kendi kimliğinin mutlak <w>yok oluşunu</w> düşünerek boşluğa baktı."
                            }
                        },
                        {
                            "text": "The philosophy explores the fear of <w>annihilation</w> and the search for meaning in life.",
                            "target_lang_translations": {
                                "tr": "Felsefe, <w>yok olma</w> korkusunu ve hayatta anlam arayışını inceler."
                            }
                        }
                    ],
                    "synonyms": [
                        "extinction"
                    ],
                    "antonyms": [
                        "generation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tamamen yok edilmiş veya hiçliğe indirgenmiş olma durumu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yok oluş",
                                "target_lang_sense_clarification": "varlığın sona ermesi, hiçlik"
                            },
                            {
                                "target_lang_word": "imha olma",
                                "target_lang_sense_clarification": "tahrip edilmiş olma hali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f04818dc-9364-3f4b-99be-7a5f8a8f40ac",
                    "sense_definition": "The act of dismantling an organization or structure so that it ceases to function as it once did.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hostile takeover led to the <w>annihilation</w> of the corporation as an independent entity.",
                            "target_lang_translations": {
                                "tr": "Düşmanca devralma, şirketin bağımsız bir kuruluş olarak <w>ortadan kalkmasına</w> yol açtı."
                            }
                        },
                        {
                            "text": "The sudden policy change resulted in the <w>annihilation</w> of the department's original structure.",
                            "target_lang_translations": {
                                "tr": "Ani politika değişikliği, departmanın orijinal yapısının <w>yok olmasıyla</w> sonuçlandı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir organizasyonun veya yapının eski işlevini tamamen yitirecek şekilde dağıtılması ya da ortadan kaldırılması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "feshedilme",
                                "target_lang_sense_clarification": "kurum veya yapının dağıtılması"
                            },
                            {
                                "target_lang_word": "ortadan kalkma",
                                "target_lang_sense_clarification": "varlığının sona ermesi"
                            },
                            {
                                "target_lang_word": "dağılma",
                                "target_lang_sense_clarification": "bütünlüğünü yitirme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0130ff04-0f7c-327d-ae77-0a0fca0ef33a",
                    "sense_definition": "A physical process where a particle and its antiparticle collide and convert into energy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Matter-antimatter <w>annihilation</w> releases a tremendous amount of energy in the form of photons.",
                            "target_lang_translations": {
                                "tr": "Madde-karşıt madde <w>yok oluşu</w>, fotonlar biçiminde muazzam miktarda enerji açığa çıkarır."
                            }
                        },
                        {
                            "text": "Scientists study electron-positron <w>annihilation</w> to understand the fundamental forces of the universe.",
                            "target_lang_translations": {
                                "tr": "Bilim insanları evrenin temel kuvvetlerini anlamak için elektron-pozitron <w>anihilasyonunu</w> inceliyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "particle annihilation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir parçacık ile onun karşıt parçacığının çarpışarak enerjiye dönüştüğü fiziksel süreç."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yok olma",
                                "target_lang_sense_clarification": "fizikte parçacık ve karşıt parçacık çarpışması"
                            },
                            {
                                "target_lang_word": "anihilasyon",
                                "target_lang_sense_clarification": "fizikte terim anlamı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}