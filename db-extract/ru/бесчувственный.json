                            "plural",
                            "short-form"
                        ],
                        "form": "бесчу́вственны"
                    },
                    {
                        "form_id": "18e94bac-79cd-4378-96f3-b008adfe4e69",
                        "entry_id": "81c643a8-0d1f-3433-b032-6d8c116cdef9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "бесчу́вственнее"
                    },
                    {
                        "form_id": "df03f042-3aed-4215-ae94-e7928e79529e",
                        "entry_id": "81c643a8-0d1f-3433-b032-6d8c116cdef9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "бесчу́вственней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3c4ffa6-69fe-32c6-9cb5-a85366040e78",
                        "entry_id": "81c643a8-0d1f-3433-b032-6d8c116cdef9",
                        "glosses": [
                            "лишённый (или лишившийся) способности чувствовать, ощущать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "097bd08f-ece2-4d9b-93f4-cbe61e7d0e06",
                                "sense_id": "d3c4ffa6-69fe-32c6-9cb5-a85366040e78",
                                "text": "Члены её все ослабели, и она упала бесчувственна в мои объятия."
                            }
                        ]
                    },
                    {
                        "sense_id": "2da6f7e8-1755-3b61-a45d-fa4091f6f716",
                        "entry_id": "81c643a8-0d1f-3433-b032-6d8c116cdef9",
                        "glosses": [
                            "перен. не проявляющий никаких чувств, неспособный к их проявлению; безучастный, равнодушный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e882b866-6ab3-4877-810b-f041436feaf9",
                                "sense_id": "2da6f7e8-1755-3b61-a45d-fa4091f6f716",
                                "text": "Он сидел наверху и курил, лицо у него было утомлённое, усталое и такое же серое и бесчувственное, как у тех каменных баб, что мы стащили со всех степей и заперли в этом подвале."
                            }
                        ]
                    },
                    {
                        "sense_id": "58782109-6a70-3bc3-a120-1ef1705269a5",
                        "entry_id": "81c643a8-0d1f-3433-b032-6d8c116cdef9",
                        "glosses": [
                            "перен. безжалостный, жестокий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da834930-dbea-4148-807b-70a89d20a768",
                                "sense_id": "58782109-6a70-3bc3-a120-1ef1705269a5",
                                "text": "Ах! если б они пылали бешенством, то несчастный мог бы ещё надеяться, — и тигр имеет минуты милосердия; но этот бесчувственный, неумолимый взор, выражающий одно мёртвое равнодушие, не обещал никакой пощады."
                            }
                        ]
                    }
                ],
