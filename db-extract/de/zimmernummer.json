                        "sense_id": "6c586e99-b5fa-3ae4-b9c1-33b3d1a312ae",
                        "entry_id": "4fbf7a4e-cfe8-3814-93d0-39bf779d1aa1",
                        "glosses": [
                            "Zahlen- und/oder Zeichenkombination, die genau ein Zimmer aus einer Reihe von Zimmern bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d5d258-6047-45b9-bfa0-0e03b31bcf59",
                                "sense_id": "6c586e99-b5fa-3ae4-b9c1-33b3d1a312ae",
                                "text": "Sagen Sie mir jetzt bitte noch meine Zimmernummer?"
                            },
                            {
                                "example_id": "8a95dec2-45a0-4a30-b8fd-f2a86dd18b92",
                                "sense_id": "6c586e99-b5fa-3ae4-b9c1-33b3d1a312ae",
                                "text": "„Der Wirt tritt von einem Bein aufs andre vorm Schlüsselbrett und malt mit Kreide Kreuze hinter die Zimmernummern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
