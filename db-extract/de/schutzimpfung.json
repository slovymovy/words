                "senses": [
                    {
                        "sense_id": "b7c36411-f30e-3646-90e3-c06dfa76dbba",
                        "entry_id": "197640e1-24cb-3599-b128-74d7cf2a96b8",
                        "glosses": [
                            "Impfung, die vor einer Infektion mit einer bestimmten Krankheit schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a15bd3-e4fd-463a-8a0b-eaa7af863b65",
                                "sense_id": "b7c36411-f30e-3646-90e3-c06dfa76dbba",
                                "text": "„Eine Schutzimpfung für die Schweinegrippe existiert noch nicht.“"
                            },
                            {
                                "example_id": "cc3a46e6-628f-4cca-87f2-4982729b6a07",
                                "sense_id": "b7c36411-f30e-3646-90e3-c06dfa76dbba",
                                "text": "„Vor der Einführung der Schutzimpfung führte die Diphtherie oft zum Tod durch Ersticken.“"
                            },
                            {
                                "example_id": "b5d7e02a-1140-4895-838c-ba07de78b592",
                                "sense_id": "b7c36411-f30e-3646-90e3-c06dfa76dbba",
                                "text": "„Eine Schutzimpfung gegen Masern wird empfohlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
