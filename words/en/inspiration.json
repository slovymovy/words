{
    "word_family": [
        "inspire",
        "inspirational",
        "inspirer",
        "uninspired"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                    "sense_definition": "The process of being mentally stimulated to do or feel something, especially to do something creative.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creative_stimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nature is often a great source of <w>inspiration</w> for artists and writers.",
                            "target_lang_translations": {
                                "ru": "Природа часто служит отличным источником <w>вдохновения</w> для художников и писателей.",
                                "tr": "Doğa, sanatçılar ve yazarlar için sıkça büyük bir <w>ilham</w> kaynağıdır."
                            }
                        },
                        {
                            "text": "She looked for <w>inspiration</w> in the works of the old masters.",
                            "target_lang_translations": {
                                "ru": "Она искала <w>вдохновение</w> в работах старых мастеров.",
                                "tr": "Eski ustaların eserlerinde <w>ilham</w> aradı."
                            }
                        }
                    ],
                    "synonyms": [
                        "motivation",
                        "spark",
                        "influence",
                        "stimulus"
                    ],
                    "common_phrases": [
                        "source of inspiration",
                        "find inspiration",
                        "look for inspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс душевного подъема, побуждающий к творчеству или действиям.",
                        "tr": "Özellikle yaratıcı bir şey yapmak veya hissetmek için zihinsel olarak harekete geçme süreci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдохновение",
                                "target_lang_sense_clarification": "состояние творческого подъёма"
                            },
                            {
                                "target_lang_word": "воодушевление",
                                "target_lang_sense_clarification": "сильная увлечённость, душевный подъём"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilham",
                                "target_lang_sense_clarification": "yaratıcı düşünce veya zihinsel teşvik"
                            },
                            {
                                "target_lang_word": "esin",
                                "target_lang_sense_clarification": "yaratıcılık veren güç veya duygu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "417201bc-ff21-3920-b0be-247bdcb2eedb",
                    "sense_definition": "A person, object, or situation that motivates someone to create something or to be better.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "creative_stimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His courage and determination are an <w>inspiration</w> to us all.",
                            "target_lang_translations": {
                                "ru": "Его мужество и решимость служат <w>вдохновением</w> для всех нас.",
                                "tr": "Ona ait cesaret ve kararlılık hepimiz için bir <w>ilham kaynağıdır</w>."
                            }
                        },
                        {
                            "text": "The beautiful landscape was the main <w>inspiration</w> for this painting.",
                            "target_lang_translations": {
                                "ru": "Этот красивый пейзаж стал главным <w>вдохновением</w> для этой картины.",
                                "tr": "Bu güzel manzara, bu tablo için temel <w>esin kaynağı</w> oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "motivation"
                    ],
                    "common_phrases": [
                        "an inspiration to",
                        "be an inspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предмет или ситуация, которые побуждают кого-то творить или становиться лучше.",
                        "tr": "Birini yaratmaya veya daha iyi olmaya teşvik eden kişi, nesne veya durum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдохновитель",
                                "target_lang_sense_clarification": "человек или объект, дающий вдохновение"
                            },
                            {
                                "target_lang_word": "источник вдохновения",
                                "target_lang_sense_clarification": "то, откуда черпается вдохновение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilham kaynağı",
                                "target_lang_sense_clarification": "teşvik eden kişi veya durum"
                            },
                            {
                                "target_lang_word": "esin kaynağı",
                                "target_lang_sense_clarification": "örnek alınan veya motive eden şey"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23d77321-b3da-356e-aaf1-55791ecc22d2",
                    "sense_definition": "A sudden good idea, especially one that solves a problem or is creative.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "creative_stimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suddenly had an <w>inspiration</w> about how to fix the broken engine.",
                            "target_lang_translations": {
                                "ru": "На него внезапно снизошло <w>озарение</w> о том, как починить сломанный двигатель.",
                                "tr": "Bozuk motoru nasıl tamir edeceğine dair aklına aniden bir <w>ilham</w> geldi."
                            }
                        },
                        {
                            "text": "The solution came to her in a sudden flash of <w>inspiration</w>.",
                            "target_lang_translations": {
                                "ru": "Решение пришло к ней в виде внезапной вспышки <w>озарения</w>.",
                                "tr": "Çözüm, aklına ani bir <w>ilham</w> parıltısıyla geldi."
                            }
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "eureka"
                    ],
                    "common_phrases": [
                        "sudden inspiration",
                        "have an inspiration",
                        "flash of inspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная хорошая идея, особенно та, которая решает проблему или является творческой.",
                        "tr": "Özellikle bir sorunu çözen veya yaratıcı olan aniden gelen iyi bir fikir."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озарение",
                                "target_lang_sense_clarification": "внезапная догадка, прояснение сознания"
                            },
                            {
                                "target_lang_word": "блестящая мысль",
                                "target_lang_sense_clarification": "неожиданная удачная идея"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ani fikir",
                                "target_lang_sense_clarification": "aniden gelen parlak düşünce"
                            },
                            {
                                "target_lang_word": "ilham",
                                "target_lang_sense_clarification": "aniden gelen yaratıcı düşünce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58b45bb4-19ef-3cd3-9af0-03c727e4fd8b",
                    "sense_definition": "The act of drawing air into the lungs; the opposite of expiration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor monitored the patient's rate of <w>inspiration</w> and expiration.",
                            "target_lang_translations": {
                                "ru": "Врач следил за частотой <w>вдоха</w> и выдоха пациента.",
                                "tr": "Doktor, hastanın <w>nefes alma</w> ve verme oranını izledi."
                            }
                        },
                        {
                            "text": "During <w>inspiration</w>, the diaphragm contracts and moves downward to allow air in.",
                            "target_lang_translations": {
                                "ru": "Во время <w>вдоха</w> диафрагма сокращается и опускается, впуская воздух.",
                                "tr": "<w>Nefes alma</w> sırasında diyafram kasılır ve havanın girmesini sağlamak için aşağı doğru hareket eder."
                            }
                        }
                    ],
                    "synonyms": [
                        "inhalation"
                    ],
                    "antonyms": [
                        "expiration",
                        "exhalation"
                    ],
                    "common_phrases": [
                        "deep inspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт втягивания воздуха в легкие; противоположность выдоху.",
                        "tr": "Havanın akciğerlere çekilmesi işlemi; nefes vermenin karşıtı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдох",
                                "target_lang_sense_clarification": "однократное дыхательное движение"
                            },
                            {
                                "target_lang_word": "вдыхание",
                                "target_lang_sense_clarification": "процесс поступления воздуха в легкие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nefes alma",
                                "target_lang_sense_clarification": "içe nefes çekme eylemi"
                            },
                            {
                                "target_lang_word": "soluk alma",
                                "target_lang_sense_clarification": "akciğerlere hava çekme süreci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa06e0d7-9959-371d-927d-3dca17bb836a",
                    "sense_definition": "A divine influence believed to be given by God to prophets, apostles, or sacred writers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "divine_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many believers accept the text as written under divine <w>inspiration</w>.",
                            "target_lang_translations": {
                                "ru": "Многие верующие признают, что этот текст был написан под божественным <w>вдохновением</w>.",
                                "tr": "Birçok inanan, metnin ilahi <w>ilham</w> altında yazıldığını kabul eder."
                            }
                        },
                        {
                            "text": "The prophet claimed to speak with the authority of divine <w>inspiration</w>.",
                            "target_lang_translations": {
                                "ru": "Пророк утверждал, что говорит, движимый божественным <w>вдохновением</w>.",
                                "tr": "Peygamber, ilahi <w>ilhamın</w> yetkisiyle konuştuğunu iddia etti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "divine inspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Божественное влияние, ниспосланное пророкам, апостолам или авторам священных текстов.",
                        "tr": "Tanrı tarafından peygamberlere, elçilere veya kutsal yazarlara verildiğine inanılan ilahi etki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдохновение",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            },
                            {
                                "target_lang_word": "наитие",
                                "target_lang_sense_clarification": "внезапное внушение, интуитивное озарение свыше"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilham",
                                "target_lang_sense_clarification": "tanrısal etkilenme veya içe doğma"
                            },
                            {
                                "target_lang_word": "vahiy",
                                "target_lang_sense_clarification": "dini bağlamda ilahi bildirim"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}