                        "examples": [
                            {
                                "example_id": "1cbe6c3e-edc3-4e66-a745-a0acf6d10fc7",
                                "sense_id": "0426c8b5-03db-3c22-a148-a1250aae2f89",
                                "text": "„Auf diese Weise verjüngen sich z. B. die alten Horste der Gräser und Halbgräser; die Wiesen, welche aus ihnen bestehen, dauern Jahrhunderte, und da sie immer gemäht werden, so ist hier eine Erhaltung der Pflanzen durch Besamung ausgeschlossen. Mit dem Schilfbestande an den Ränden unserer Seen hat es die gleiche Bewandtniss.“"
                            }
