                "senses": [
                    {
                        "sense_id": "0b41f5ab-2c48-33ad-914a-390fbc41fc7c",
                        "entry_id": "f18ef0ad-eef5-3012-89b9-086b2d2dd747",
                        "glosses": [
                            "nördlicher Teil, nördlich gelegener Stadtteil, Stadtbezirk, Stadtviertel, Ortsteil, Wohnquartier einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b04f9bc-b133-4f75-a0a2-0be67955bcd3",
                                "sense_id": "0b41f5ab-2c48-33ad-914a-390fbc41fc7c",
                                "text": "„Ich kannte die Nordstadt.“"
                            },
                            {
                                "example_id": "9f2be400-e058-4d65-a26f-4d88113d9ed7",
                                "sense_id": "0b41f5ab-2c48-33ad-914a-390fbc41fc7c",
                                "text": "Das Amt befindet sich in der Nordstadt."
                            },
                            {
                                "example_id": "a2a68908-d3e4-403f-9fd7-5212f749891e",
                                "sense_id": "0b41f5ab-2c48-33ad-914a-390fbc41fc7c",
                                "text": "Wenn sie durch die Nordstadt kommen, grüßen sie Frau Meyer von mir."
                            },
                            {
                                "example_id": "bb73714f-2d03-4578-a6ab-2879c02a5d10",
                                "sense_id": "0b41f5ab-2c48-33ad-914a-390fbc41fc7c",
                                "text": "Ihre Kindheit und Jugend verbrachten die Kinder in der Nordstadt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2da99d1a-ccb6-363e-aef4-53c634fa41fa",
                        "entry_id": "f18ef0ad-eef5-3012-89b9-086b2d2dd747",
                        "glosses": [
                            "Namensbestandteil und Kurzform von Stadtteilen, Stadtbezirken, Stadtvierteln, Ortsteilen, Wohnquartieren in folgenden Städten: Bonn, Braunschweig, Dortmund, Euskirchen, Flensburg, Göttingen, Hannover, Heilbronn, Herford, Hildesheim, Karlsruhe, Kassel, Limburg, Minden, Neuss, Nürnberg, Pforzheim, Solingen, Wolfsburg, Wuppertal"
                        ],
