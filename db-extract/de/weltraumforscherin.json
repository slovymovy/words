                "senses": [
                    {
                        "sense_id": "373e8151-ab6f-3114-8f7a-af750ccea612",
                        "entry_id": "e45b79b4-36bb-3207-ade4-68de83d50087",
                        "glosses": [
                            "Forscherin, die sich mit der Erforschung des Weltraums beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6858842a-be20-49bc-998a-babe2dd34aa1",
                                "sense_id": "373e8151-ab6f-3114-8f7a-af750ccea612",
                                "text": "„Dass bislang noch niemandem ein Stück Weltraummüll auf den Kopf gefallen ist, sei reines Glück, sagt die Weltraumforscherin Susanne Peters.“"
                            },
                            {
                                "example_id": "f7575149-e318-473a-b378-85bd13704757",
                                "sense_id": "373e8151-ab6f-3114-8f7a-af750ccea612",
                                "text": "„Als Vortragende haben sich unter anderem Wikipedia-Mitgründer Larry Sanger, die NASA-Weltraumforscherin Kerry McGuire und der österreichische Genetiker Markus Hengstschläger sowie die ehemalige nigerianische Bildungsministerin und Gründerin von Transparency International, Obiageli Ezekwesili, angekündigt.“"
                            },
                            {
                                "example_id": "a30e6f76-5ea8-4d06-8b11-c1a689c6668f",
                                "sense_id": "373e8151-ab6f-3114-8f7a-af750ccea612",
                                "text": "„Der verschobene Start sorgt für Enttäuschung bei den Kölner Weltraumforscherinnen und -forschern.“"
                            },
                            {
                                "example_id": "a7568853-d035-4307-a2c5-2a7a52fba6ef",
                                "sense_id": "373e8151-ab6f-3114-8f7a-af750ccea612",
                                "text": "„Für Weltraumforscherinnen und Weltraumforscher sind sie [Asteroiden] faszinierend, denn sie tragen die Geschichte vom Anfang unseres Sonnensystems in sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
