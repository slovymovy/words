                        "glosses": [
                            "Donner un caractère provisoire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a40951f3-a8d6-4f56-9927-b8851a46fde0",
                                "sense_id": "a0ed66e8-4320-3afb-a813-33ea3907de62",
                                "text": "Le geste imprévu désordonne l’organisation préétablie, il « provisoirise » au lieu de pérenniser."
                            },
                            {
                                "example_id": "c647517d-e61c-4f81-a560-fa93ee81e6d0",
                                "sense_id": "a0ed66e8-4320-3afb-a813-33ea3907de62",
                                "text": "Actes d’écriture • Reprendre • Lancer la phrase. • Résonner avec tous les voisinages. • Harmoniser les groupes et les ensembles. • Corriger. • Attaquer • Provisoiriser. • Relire."
                            }
                        ]
                    },
                    {
                        "sense_id": "00d32ea6-4944-3043-b680-a6a7530ebcd3",
                        "entry_id": "5014b900-7186-322c-9b0b-51c5a7bdfb18",
                        "glosses": [
                            "Équiper d’une protection provisoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09acdede-aaf9-46f4-9de4-61bf7bf65693",
                                "sense_id": "00d32ea6-4944-3043-b680-a6a7530ebcd3",
                                "text": "Si les piliers ne sont pas immédiatement provisoirisés et s'il est nécessaire de les protéger pendant leur permanence dans la cavité orale, ils peuvent être couverts avec la coiffe de protection en titane."
