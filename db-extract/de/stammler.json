                ],
                "senses": [
                    {
                        "sense_id": "c631e7f4-3722-3f6c-b2a2-6922e150115c",
                        "entry_id": "d9d15c42-de29-332d-b6fa-6deecafc2750",
                        "glosses": [
                            "Person, die stammelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030bf0a6-2b82-4917-9959-307f284a44aa",
                                "sense_id": "c631e7f4-3722-3f6c-b2a2-6922e150115c",
                                "text": "„Als beeinflussende Variable hinsichtlich der Intelligenz erwies sich die soziale Schichtzugehörigkeit; die herabgesetzten Durchschnittswerte waren durch Stammler aus der Unterschicht hervorgerufen worden.“"
                            },
                            {
                                "example_id": "20fcf792-de3b-40b4-b866-8bc0e9575b7a",
                                "sense_id": "c631e7f4-3722-3f6c-b2a2-6922e150115c",
                                "text": "„Jeder Logopäde wird darüberhinaus aus der Beobachtung einzelner Stammler angeben können, mit welcher Häufigkeit einzelne Konsonanten ersetzt werden und welche insbesondere als Ersatzkonsonanten dienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95107922-699f-4153-8a3b-a40515c945bc",
                        "source_entry_id": "d9d15c42-de29-332d-b6fa-6deecafc2750",
                        "source_sense_id": "c631e7f4-3722-3f6c-b2a2-6922e150115c",
                        "source_sense_description": "Person, die stammelt",
                        "target_lang_word": "stammerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stammerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "122ec1d9-3650-3ecc-baa1-bd16657c8bf4",
                                        "entry_id": "18523066-30eb-32f2-803b-c9f22ba0f9a5",
                                        "glosses": [
                                            "One who stammers; a stutterer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75685239-cf65-4355-b21e-5e0cac1b04d5",
                                                "sense_id": "122ec1d9-3650-3ecc-baa1-bd16657c8bf4",
                                                "text": "Marry—as the friendly vapour ascended, how his prattle would curl up sometimes with it! the ligaments, which tongue-tied him, were loosened, and the stammerer proceeded a statist!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
