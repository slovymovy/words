        "de-extract.jsonl": [
            {
                "entry_id": "67be67be-c308-3347-a401-1c2037df95fd",
                "word": "BENELUX",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                        "entry_id": "67be67be-c308-3347-a401-1c2037df95fd",
                        "glosses": [
                            "Abkürzung für Belgien, Niederlande und Luxemburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fa577cd-7318-454b-9046-cdc5bdb547c8",
                                "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                                "text": "Die BENELUX-Staaten hielten schon vor der EU wirtschaftlich zusammen."
                            },
                            {
                                "example_id": "8569abba-40ab-4c8d-a668-78c3b8aa35d9",
                                "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                                "text": "„Die kleinste, aber älteste und noch auf die Zeit vor Kriegsende zurückgehende Gemeinschaft ist BENELUX. Sie besteht aus den drei mikrotopen Staaten Belgien, Niederlande, Luxemburg […].“"
                            },
                            {
                                "example_id": "9d8d26d7-e4cf-4a6c-ad50-63237c258757",
                                "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                                "text": "„Die Weltwirtschaftsgroßmacht BENELUX ist zwar zu über 80 % niederländischsprachig, doch kommen ihre Haupthandelssprachen zum nicht geringen Teil anderen Sprachnationen zugute.“"
                            },
                            {
                                "example_id": "296d1a31-4b6b-48e9-a64a-92c517abc95a",
                                "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                                "text": "„BENELUX ist trilateral, die EG regional und die OECD westlich-global organisiert.“"
                            },
                            {
                                "example_id": "51653ad5-2bac-4686-8a7f-c5d0131e85c2",
                                "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                                "text": "„Die BENELUX war eine Vorstufe für den Vertrag von Rom, in dem Sinne, daß sie den Weg für die Integration abgesteckt hat […].“"
                            },
                            {
                                "example_id": "bd40da0e-ab66-40a9-b2b0-c17ae677ca82",
                                "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                                "text": "„Nach dem Krieg hatte der Ost-West-Konflikt die Rahmenbedingungen geändert und BENELUX wurde von neuen Organisationen wie OEEC , NATO und EGKS überschattet.“"
                            },
                            {
                                "example_id": "ddfaddb0-9de6-4328-9443-93e5dd4ca967",
                                "sense_id": "204beceb-8e59-340a-a1fe-c5fe9af9485d",
                                "text": "„Diese sog. BENELUX stellt eine industrielle und landwirtschaftliche Einheit von rund 17 Millionen Einwohnern dar; sie ist Mitglied der EWG.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c6877022-97e3-3e9d-a70c-4e2feaf70677",
