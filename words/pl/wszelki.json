                    "sense_id": "0c3a9175-5239-3a24-b2ed-0c1a534ab4c6",
                    "sense_definition": "Każdy możliwy, bez względu na okoliczności; odnoszący się do wszystkich elementów danej grupy bez wyjątku.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "totality_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W razie <w>wszelkich</w> pytań proszę dzwonić do naszego biura.",
                            "target_lang_translations": {
                                "ru": "По <w>любым</w> вопросам, пожалуйста, звоните в наш офис.",
                                "en": "In case of <w>any</w> questions, please call our office."
                            }
                        },
                        {
                            "text": "To, że wygraliśmy ten mecz, jest ponad <w>wszelką</w> wątpliwość.",
                            "target_lang_translations": {
                                "ru": "То, что мы выиграли этот матч, — вне <w>всякого</w> сомнения.",
                                "en": "The fact that we won this match is beyond <w>all</w> doubt."
                            }
