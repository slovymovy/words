                                        "sense_id": "7b842426-31ff-3a08-baae-15fbdb60dfd4",
                                        "entry_id": "9ed49ac4-d19f-3556-96c7-5b1b905998bf",
                                        "glosses": [
                                            "A Japanese car manufacturer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d5a111-df3d-4e09-8582-c4f30da089e3",
                                                "sense_id": "7b842426-31ff-3a08-baae-15fbdb60dfd4",
                                                "text": "The Bluebird dispute is being watched closely in Europe and overseas because the 2,000-employee Nissan plant at Sunderland, England, near Newcastle, represents the largest direct investment by the Japanese in Europe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Nissan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53eaee2c-aec2-31b8-b5e1-362c424b17b4",
                                        "entry_id": "f478204d-4902-397a-876c-afffe05101d0",
                                        "glosses": [
                                            "A car of the Japanese Nissan brand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed05d6c4-4c8f-4f9d-b433-a52f193a6ba3",
                                                "sense_id": "53eaee2c-aec2-31b8-b5e1-362c424b17b4",
                                                "text": "Angry Japanese and British officials say foreign investors will be scared away from Europe unless France and Italy ease tough regulations that treat English-made Nissans as Japanese cars, subjecting them to strict import quotas."
                                            },
                                            {
                                                "example_id": "8732e83b-9b56-46d5-9102-3df11ad3c0fd",
                                                "sense_id": "53eaee2c-aec2-31b8-b5e1-362c424b17b4",
                                                "text": "A Jaguar and two Nissans battled into the early morning hours in the closely contested Daytona 24 Hours, with a group of Porsches still within reach of the leaders."
                                            },
                                            {
                                                "example_id": "fcaf406d-20d0-411d-a9e8-f35091108f98",
                                                "sense_id": "53eaee2c-aec2-31b8-b5e1-362c424b17b4",
                                                "text": "Like other Nissans, the Ariya gets the excellent ProPilot system for cruise control and part-autonomous driving – far less fiddly than the set-up of some of its competitors."
                                            }
                                        ]
                                    }
                                ]
