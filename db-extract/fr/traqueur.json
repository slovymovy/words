                        "sense_id": "a8bd1ab3-ff7b-39c8-8cd8-f51d1117b870",
                        "entry_id": "fee0a548-0fca-3587-b927-a9ae153b6a5e",
                        "glosses": [
                            "Celui qui a le trac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f220e68-15a6-4641-b50b-a58cd464c6cd",
                                "sense_id": "a8bd1ab3-ff7b-39c8-8cd8-f51d1117b870",
                                "text": "Plus chevronné, Jean-Pierre Marielle, traqueur lui aussi, jamais apaisé, est terrorisé au moment de jouer une scène dans le fleuve Sénégal."
                            },
                            {
                                "example_id": "d02d7476-ea03-40fa-8ecb-65b007f7ba38",
                                "sense_id": "a8bd1ab3-ff7b-39c8-8cd8-f51d1117b870",
                                "text": "J’ai joué quantité de pièces avec chacun d’eux et, moi qui suis si « traqueuse », je me sentais en confiance."
                            }
                        ]
                    }
