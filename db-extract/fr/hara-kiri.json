                                    },
                                    {
                                        "sense_id": "a79e8eef-95eb-3e81-be7d-4348ea71a93d",
                                        "entry_id": "75078788-439e-34e9-8caf-351defd412ca",
                                        "glosses": [
                                            "übertragen von [1], „gesellschaftlicher Selbstmord“, eine Blamage, die das Ende der Karriere bedeutet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f615a420-bd03-47bb-a235-9ba2d640b19e",
                                                "sense_id": "a79e8eef-95eb-3e81-be7d-4348ea71a93d",
                                                "text": "Millionen Fernsehzuschauer sahen dem Harakiri des bislang so beliebten Moderators genüsslich zu."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e954ab91-0a22-31f0-8f41-309e61640e4d",
                                        "entry_id": "75078788-439e-34e9-8caf-351defd412ca",
                                        "glosses": [
                                            "übertragen von [1], bewusstes Herbeiführen einer Niederlage (die ebenfalls meist das Ende der Karriere bedeutet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0ad3468-b888-4a11-8c50-0e6adf96d947",
                                                "sense_id": "e954ab91-0a22-31f0-8f41-309e61640e4d",
                                                "text": "Sich nur auf die Champions League zu verlassen, wäre Harakiri. - (Die Welt, zitiert nach Wortschatz-Lexikon)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "046d9fd4-694a-4fcb-a1c6-075c572946e1",
                        "source_entry_id": "fc7bd1ba-d424-3560-b259-4a079afd0505",
                        "target_lang_word": "hara-kiri",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hara-kiri",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbd01c2b-4bd5-3156-8b00-de69dd0fbe6a",
                                        "entry_id": "3a7f4364-eebb-3b92-8bd4-7e0b715cb02a",
                                        "glosses": [
                                            "Ceremonial suicide by disembowelment, as by slicing open the abdomen with a dagger or knife: formerly practised in Japan by the samurai when disgraced or sentenced to death."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f158eb61-6a37-4d56-9117-32c4aa3a0696",
                                                "sense_id": "bbd01c2b-4bd5-3156-8b00-de69dd0fbe6a",
                                                "text": "On the downfall of his power in 1867 he was urged by one of his Council to save the honour of his family by a voluntary suicide. He flatly refused to do so and left the room, whereupon his faithful adviser retired to another part of the castle and solemnly performed the hara-kiri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4160ee4-1966-3491-9f9d-f0c42498caa8",
                                        "entry_id": "3a7f4364-eebb-3b92-8bd4-7e0b715cb02a",
                                        "glosses": [
                                            "Suicide or any suicidal action."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38ea5c11-fc85-4188-af75-44cb88fe50ad",
                                                "sense_id": "f4160ee4-1966-3491-9f9d-f0c42498caa8",
                                                "text": "...the report that was issued at the time officially blamed a disgruntled crewman who had been accused of theft and may have decided to do the ultimate hara-kiri, but quite how you prove that I don't know..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc4befd-e304-3b8b-baa3-fa922e3d1e95",
                                        "entry_id": "3a7f4364-eebb-3b92-8bd4-7e0b715cb02a",
                                        "glosses": [
                                            "An act against one's own interests."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d69e648-e4a9-4d54-8497-48f4a8b7fe43",
                                                "sense_id": "8dc4befd-e304-3b8b-baa3-fa922e3d1e95",
                                                "text": "Regarded logically, therefore, Japan’s decision to go to war made no sense. It was hara-kiri."
                                            },
                                            {
                                                "example_id": "d19feb46-2438-4972-8d32-d39019aa0da6",
                                                "sense_id": "8dc4befd-e304-3b8b-baa3-fa922e3d1e95",
                                                "text": "They are haunted by the spectre of the 1984 election, when Mr Walter Mondale committed hara-kiri by acknowledging the need to raise taxes if America were to get its economy straight."
                                            },
                                            {
                                                "example_id": "43965c07-07f9-4c7b-8b2d-d18b28b6bf99",
                                                "sense_id": "8dc4befd-e304-3b8b-baa3-fa922e3d1e95",
                                                "text": "But with GSM players lobbying hard for more spectrum, taking MVNOs on board now would be hara-kiri."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9ed42ad-445c-45cb-8a8a-272da4ec5e5a",
                        "source_entry_id": "fc7bd1ba-d424-3560-b259-4a079afd0505",
