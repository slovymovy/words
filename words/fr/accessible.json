    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34854867-49cf-3150-8f2e-d445c75e680c",
                    "sense_definition": "Où l'on peut parvenir, entrer ou pénétrer facilement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce village de montagne est facilement <w>accessible</w> en train ou en voiture toute l'année."
                        },
                        {
                            "text": "L'entrée principale du musée reste <w>accessible</w> aux visiteurs pendant la durée des travaux."
                        }
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "facilement accessible",
                        "accessible en voiture"
                    ]
                },
                {
                    "sense_id": "492ce988-4641-35eb-b9bd-52941c8249f4",
                    "sense_definition": "Dont le prix est modéré et à la portée des moyens financiers du plus grand nombre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce petit restaurant de quartier propose des menus de qualité à un prix <w>accessible</w>."
                        },
                        {
                            "text": "Ces logements étudiants restent <w>accessibles</w> aux jeunes qui ont des ressources limitées."
                        }
                    ],
                    "synonyms": [
                        "abordable"
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "prix accessible",
                        "accessible à toutes les bourses"
                    ]
                },
                {
                    "sense_id": "61ae495f-29ab-399b-98f5-9a2d30304d0c",
                    "sense_definition": "Facile à comprendre, à assimiler ou à maîtriser sans connaissances préalables approfondies.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur explique des notions scientifiques complexes d'une manière très claire et <w>accessible</w>."
                        },
                        {
                            "text": "Cet ouvrage de vulgarisation rend l'histoire médiévale enfin <w>accessible</w> au grand public."
                        }
                    ],
                    "synonyms": [
                        "compréhensible"
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "accessible à tous",
                        "rendre accessible"
                    ]
                },
                {
                    "sense_id": "f3142e07-ff3d-37e9-98ec-7c7a7afcf997",
                    "sense_definition": "Spécialement aménagé pour permettre l'accès et l'usage aux personnes en situation de handicap.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle station de métro est entièrement <w>accessible</w> aux personnes en fauteuil roulant."
                        },
                        {
                            "text": "Les bâtiments administratifs doivent être aménagés pour devenir <w>accessibles</w> à tous les usagers."
                        }
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "accessible aux personnes handicapées",
                        "accessible aux personnes à mobilité réduite"
                    ]
                },
                {
                    "sense_id": "a1e17be4-edcb-3e47-ad55-e9ca21cd969c",
                    "sense_definition": "Qui est d'un abord facile, avec qui l'on peut aisément entrer en contact ou communiquer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré sa grande renommée, ce scientifique renommé est resté très modeste et <w>accessible</w>."
                        },
                        {
                            "text": "La directrice de l'école est toujours <w>accessible</w> pour discuter des difficultés des élèves."
                        }
                    ],
                    "synonyms": [
                        "abordable"
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "très accessible"
                    ]
                }
            ]
        }
    ]
}