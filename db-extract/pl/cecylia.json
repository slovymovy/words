                                "target_senses": [
                                    {
                                        "sense_id": "b58151a3-fa0a-38e4-9344-751c392de529",
                                        "entry_id": "6a75e738-91c1-335d-9223-8980640a241f",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5f46f1-9d5e-412a-b00b-e8b13c776810",
                                                "sense_id": "b58151a3-fa0a-38e4-9344-751c392de529",
                                                "text": "Oh ! il aura beau le papelarder, répondit Pigoult qui saisit la pensée cachée dans le calembour du substitut, la main de Cécile ne dépend ni du père ni de la mère."
                                            },
                                            {
                                                "example_id": "9c8b353f-8ee7-4ac7-a435-329846b924f9",
                                                "sense_id": "b58151a3-fa0a-38e4-9344-751c392de529",
                                                "text": "Comment Cécile acceptait-elle cette quasi-indifférence ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
