                                                "sense_id": "ea702432-3210-3449-b853-d802478b2de5",
                                                "text": "My mother gave me maybe 150 to 200 letters, […] all rubber banded together month by month and in dates."
                                            },
                                            {
                                                "example_id": "bf5ec820-14b6-4da5-8874-81ed115762a4",
                                                "sense_id": "ea702432-3210-3449-b853-d802478b2de5",
                                                "text": "Prompt them to pick up ten sticks, rubber band them together, and quickly move them to the tens office."
                                            },
                                            {
                                                "example_id": "b024b187-d3d0-46f5-8210-826cfb271c1f",
                                                "sense_id": "ea702432-3210-3449-b853-d802478b2de5",
                                                "text": "There were yellowed pages of base layouts and plans, a duty roster, and a rubber banded package of papers."
                                            }
