                            {
                                "target_lang_word": "пе́рвый",
                                "target_lang_sense_clarification": "порядковое числительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开头的",
                                "target_lang_sense_clarification": "处于第一位置的"
                            },
                            {
                                "target_lang_word": "首位的",
                                "target_lang_sense_clarification": "位于最前面的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a91fcae9-a710-3750-af35-7f4f312f3b3e",
                    "sense_definition": "The first letter of a name, often used in plural to represent a person's full name.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_letter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your <w>initials</w> clearly at the bottom of the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, разборчиво напишите свои <w>инициалы</w> внизу формы.",
                                "zh": "请在表格底部清晰地写下您的<w>姓名首字母</w>。"
                            }
                        },
                        {
                            "text": "He carved his <w>initials</w> into the bark of the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Он вырезал свои <w>инициалы</w> на коре старого дуба.",
                                "zh": "他在老橡树的树皮上刻下了自己的<w>姓名首字母</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "write your initials",
                        "carved initials"
