                        "sense_id": "8ed2b01e-6abd-36aa-802c-03e3c1768e9e",
                        "entry_id": "ee223556-b35b-3b63-b4fb-421e20f581d0",
                        "glosses": [
                            "Person, die in einem geburtenstarken Jahrgang in der Nachkriegszeit geboren ist; Babyboomer"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "36b6ec8c-43a6-4a28-b8b7-e775d4f4e479",
                                "sense_id": "8ed2b01e-6abd-36aa-802c-03e3c1768e9e",
                                "text": "Nach den Boomern kam die Gen X und danach die Gen Y."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20bf4596-48c0-33f8-8ead-f1c28f9550e1",
                        "entry_id": "ee223556-b35b-3b63-b4fb-421e20f581d0",
                        "glosses": [
                            "Person mit unzeitgemäßen, meist sehr konservativen Ansichten und Meinungen"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "0b05d2e0-d238-4164-8b3a-0b7465bc059d",
                                "sense_id": "20bf4596-48c0-33f8-8ead-f1c28f9550e1",
                                "text": "„Ein »richtiges Alter«, um Boomer zu sein, gibt es nicht – das scheint die einzige Gewissheit in dieser Debatte zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee493775-2499-40f7-99d2-1f7e06ea06de",
                        "source_entry_id": "ee223556-b35b-3b63-b4fb-421e20f581d0",
                        "source_sense_id": "8ed2b01e-6abd-36aa-802c-03e3c1768e9e",
                        "source_sense_description": "Person, die in einem geburtenstarken Jahrgang in der Nachkriegszeit geboren ist",
                        "target_lang_word": "boomer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae375e60-90f0-364b-946c-0c1a3f7b4064",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "Something that makes a booming sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97f359c-a5bc-4c11-bd9e-d3a2f371044d",
                                                "sense_id": "ae375e60-90f0-364b-946c-0c1a3f7b4064",
                                                "text": "That's when the Rev let loose one of those great big boomers of a laugh. It was so loud in the closed space, the effect was what Wes imagined it felt like to hear a bullet fired in a car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dccababe-85d0-3467-a8ea-d0e2dfa0f12d",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "A transient worker who would move from boom town to boom town in search of temporary work."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b32eb701-926b-3a6a-b673-a73223d1742d",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "A device used to bind or tighten chain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "491f9f61-b7e6-3edf-abfc-beefb14fc41a",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "A nuclear ballistic missile submarine, SSBN."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9ed2e3-ebe0-49a8-a3b6-d03318c8a1dd",
                                                "sense_id": "491f9f61-b7e6-3edf-abfc-beefb14fc41a",
                                                "text": "Distant contact, probably submerged. It's a wild guess, but I'd say we hit a boomer coming out of the barn. Could be a missile boat out of Polijarny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a454b42a-bbaf-34c8-8ed1-3f34a6e92d5a",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "A Eurasian bittern (subfamily Botaurinae)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f90bf7bd-8b00-38d5-8672-6ad2ce5d1ccf",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "An adult male kangaroo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68c34e3b-50ed-3a5a-8c7f-03ecea4b82ec",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "A red squirrel (Tamiasciurus hudsonicus)."
                                        ],
                                        "tags": [
                                            "Appalachia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e76b3fa2-5144-3ba7-8fa9-f876264ac23f",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "A mountain beaver (Aplodontia rufa)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "041c65c8-c4d2-3056-a7df-bf5e6b164ad2",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "A player who prioritises economic development and securing resources (and therefore future production) over offence or defence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0024aaa9-0a4d-49c3-9108-e99a6b17a485",
                                                "sense_id": "041c65c8-c4d2-3056-a7df-bf5e6b164ad2",
                                                "text": "you and i both know that there are some boomers out there who'll consistently hit bronze @ 16ish and assuming they have protected themselves correctly, are some tough players."
                                            },
                                            {
                                                "example_id": "43de277c-eb1f-4f3b-9b37-27acacb52b4c",
                                                "sense_id": "041c65c8-c4d2-3056-a7df-bf5e6b164ad2",
                                                "text": "Economically speaking, the attacker loses every time. So it's a war of the boomers."
                                            },
                                            {
                                                "example_id": "ae37f8cc-5098-4e8d-90fb-1fcee6853737",
                                                "sense_id": "041c65c8-c4d2-3056-a7df-bf5e6b164ad2",
                                                "text": "2008 June 12, Kresten Toftgaard Andersen, Anders Buch, Dennis Dahl Christensen & Dung Tran, \"Reinforcement Learning in RTS games\" (master thesis), page 51.\nThe strategy of the rusher is to build a small army very fast in order to destroy the enemy early in the game, whereas the aggressive/boomer builds a larger army, which is not necessarily an advanced army, to attack the enemy."
                                            },
                                            {
                                                "example_id": "9891ca45-3373-4225-975c-1267a6e21513",
                                                "sense_id": "041c65c8-c4d2-3056-a7df-bf5e6b164ad2",
                                                "text": "2008 July 13-15, Jin Park, Du Zhang & Meiliu Lu, \"An intelligent agent for the game of Age of Mythology: the Titans\", 2008 IEEE International Conference on Information Reuse and Integration, page 93.\nOnce the Heroic Age is reached, the boomer is able to generate a superior army at an explosive rate due to the advanced economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdcccb4e-8103-3745-ab67-a722ab4cbd6a",
                                        "entry_id": "60d8c8f1-bd83-3f8a-a4b8-dfc9ea4ba921",
                                        "glosses": [
                                            "Alternative letter-case form of Boomer (“Oklahoma settler”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "boomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e09fc030-1dad-3785-b704-5df26690948f",
                                        "entry_id": "848508e2-6511-3798-a55d-ae30a1eb49e4",
                                        "glosses": [
                                            "Ellipsis of baby boomer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805c8132-2792-4a3f-956e-adc7dbc24a24",
                                                "sense_id": "e09fc030-1dad-3785-b704-5df26690948f",
                                                "text": "Boomers came of age in the era of the Beatles and Led Zeppelin."
                                            },
                                            {
                                                "example_id": "fa625cbd-703e-4537-98bd-9dab7e093a53",
                                                "sense_id": "e09fc030-1dad-3785-b704-5df26690948f",
                                                "text": "To the many Boomers who sensed that something had gone awry in Greatest Generation America, Mad was a glimmer of truth, a benign but trenchant voice against hypocrisy and pretense, a way to laugh at parents who fretted over status symbols and authorities who talked one way but acted another."
                                            },
                                            {
                                                "example_id": "ca61009e-fc16-462b-8053-242f2be5465f",
                                                "sense_id": "e09fc030-1dad-3785-b704-5df26690948f",
                                                "text": "These fears have been exacerbated by the recession, which forced many boomers to turn to Social Security earlier than anticipated because of long-term unemployment and financial crises (Johnson and Wilson, 2010a, b)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09db68aa-f976-39aa-82c7-c159251a2967",
                                        "entry_id": "848508e2-6511-3798-a55d-ae30a1eb49e4",
                                        "glosses": [
                                            "An elderly person, regardless of generation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6804fe0a-78e3-4ac3-988d-45c40506c3f3",
                                                "sense_id": "09db68aa-f976-39aa-82c7-c159251a2967",
                                                "text": "I'm going to be a boomer by the time this thing is over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aea553f2-babe-3c0a-8af3-4d40a4f130fb",
                                        "entry_id": "848508e2-6511-3798-a55d-ae30a1eb49e4",
                                        "glosses": [
                                            "A person who is too old to be familiar with the use of recent technology."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5578a3e-e55b-49ee-a2b6-c88aec4ba89e",
                                                "sense_id": "aea553f2-babe-3c0a-8af3-4d40a4f130fb",
                                                "text": "I'm such a boomer; I have no idea how to use this phone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
