                "translations": [
                    {
                        "translation_id": "9c77e587-83e0-4f4d-a78b-affcb8c68a36",
                        "source_entry_id": "363b9c88-15c0-387f-80ee-b9c4b1d326d7",
                        "source_sense_id": "0fb26d7b-9261-3443-9ad7-4c55d574ae0c",
                        "target_lang_word": "Schlaflied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlaflied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8593d45f-2fe4-3052-8f34-a93b69797b71",
                                        "entry_id": "72762dbf-c253-301c-aaa2-b17424ddb38f",
                                        "glosses": [
                                            "Lied, das einem Kind vorgesungen wird, damit es einschläft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f229ce6a-e85f-460f-844f-96e4735d1267",
                                                "sense_id": "8593d45f-2fe4-3052-8f34-a93b69797b71",
                                                "text": "Meine Großmutter sang mir immer ein Schlaflied vor."
                                            },
                                            {
                                                "example_id": "cbb0ad27-4f03-422a-ba3a-9816e47cc980",
                                                "sense_id": "8593d45f-2fe4-3052-8f34-a93b69797b71",
                                                "text": "„Ich denke, daß alles seinen Sinn bekommt wegen der und für die Kinder. Und singe ihnen ein Schlaflied …“"
                                            },
                                            {
                                                "example_id": "4396a345-9741-41cb-a0e3-f2cda856dbb0",
                                                "sense_id": "8593d45f-2fe4-3052-8f34-a93b69797b71",
                                                "text": "„Zum ersten Mal seit langer Zeit stimmen die Eltern gemeinsam ein Schlaflied an, dessen Strophen sie auswendig gelernt haben, als Mila geboren wurde, und das sie ihr als Baby immer im Duett vorgesungen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19cae329-6f7c-45fb-944e-f9a4b682807b",
                        "source_entry_id": "363b9c88-15c0-387f-80ee-b9c4b1d326d7",
                        "source_sense_id": "0fb26d7b-9261-3443-9ad7-4c55d574ae0c",
                        "target_lang_word": "Wiegenlied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiegenlied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                        "entry_id": "19c18863-a50c-31b0-9f91-8ba69c5f5c51",
                                        "glosses": [
                                            "Lied, das einem Kind (in der Wiege) vorgesungen wird, damit es einschläft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82485c50-5f81-430a-b864-74e6a0a4c618",
                                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                                "text": "Meine Großmutter sang mir immer ein Wiegenlied vor."
                                            },
                                            {
                                                "example_id": "b4a526d5-2334-4922-bd77-e4c831ada152",
                                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                                "text": "„Was lullt mir Frau Amme mein Wiegenlied gar?“"
                                            },
                                            {
                                                "example_id": "19cfa1a2-f47f-4c37-b42e-bfc5da538fe5",
                                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                                "text": "„Sie ſaßen dann oben in der luftigen, großen Stube, Roswitha wiegte das Kind und ſang in einem thüringiſchen Platt allerlei Wiegenlieder, die niemand recht verſtand, vielleicht ſie ſelber nicht; […].“"
                                            },
                                            {
                                                "example_id": "fc4996d6-e451-41f4-87ab-61f804551941",
                                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                                "text": "„Hast sogar Wiegenlieder gesummt, während sie schlief, in einer Phantasiesprache, die wie das reinste Isländisch klang, vielleicht hörte sie im Traum Trolle und Elfen.“"
                                            },
                                            {
                                                "example_id": "805060ed-dc1c-4784-9d28-a331624bd2fd",
                                                "sense_id": "00aed32c-747d-358c-9f34-1c2ac5adc267",
                                                "text": "„Er stand in seinem weißen Unterzeug wie ein müdes, freundliches Gespenst im halbdunklen Zimmer und sprach die Verse des Wiegenliedes langsam, mit montoner Stimme vor sich hin, die erloschenen Augen in die Nacht vor dem Fenster gerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
