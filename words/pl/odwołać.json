{
    "word_family": [
        "odwoływać",
        "odwołanie",
        "odwoławczy",
        "odwołalny",
        "nieodwołalny",
        "odwoływalny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49421559-2141-3595-a6b9-b15d8247474c",
                    "sense_definition": "zdecydować, że zaplanowane wydarzenie, spotkanie lub podróż się nie odbędzie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anulowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz pociąg został nagle <w>odwołany</w> z powodu gęstej mgły.",
                            "target_lang_translations": {
                                "fr": "Notre train a été soudainement <w>annulé</w> à cause du brouillard épais."
                            }
                        },
                        {
                            "text": "Muszę niestety <w>odwołać</w> naszą jutrzejszą wizytę u lekarza.",
                            "target_lang_translations": {
                                "fr": "Je dois malheureusement <w>annuler</w> notre rendez-vous de demain chez le médecin."
                            }
                        }
                    ],
                    "synonyms": [
                        "anulować",
                        "skasować"
                    ],
                    "common_phrases": [
                        "odwołać spotkanie",
                        "odwołać lot",
                        "odwołać wizytę"
                    ],
                    "target_lang_definitions": {
                        "fr": "décider qu'un événement, un rendez-vous ou un voyage prévu n'aura pas lieu"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "annuler",
                                "target_lang_sense_clarification": "un événement, un voyage, un rendez-vous"
                            },
                            {
                                "target_lang_word": "décommander",
                                "target_lang_sense_clarification": "un rendez-vous, une invitation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69981a45-2709-313a-a9e6-5a195cd7bea9",
                    "sense_definition": "oświadczyć, że to, co się wcześniej powiedziało, napisało lub uzgodniło, jest nieważne lub nieprawdziwe",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anulowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Powiedziałeś coś bardzo przykrego i powinieneś natychmiast to <w>odwołać</w>.",
                            "target_lang_translations": {
                                "fr": "Tu as dit quelque chose de très blessant et tu devrais immédiatement le <w>retirer</w>."
                            }
                        },
                        {
                            "text": "Świadek postanowił <w>odwołać</w> swoje wcześniejsze zeznania przed sądem.",
                            "target_lang_translations": {
                                "fr": "Le témoin a décidé de <w>rétracter</w> ses déclarations précédentes devant le tribunal."
                            }
                        }
                    ],
                    "synonyms": [
                        "cofnąć",
                        "wycofać"
                    ],
                    "antonyms": [
                        "podtrzymać"
                    ],
                    "common_phrases": [
                        "odwołać zeznania",
                        "odwołać słowa"
                    ],
                    "target_lang_definitions": {
                        "fr": "déclarer comme non avenu ou faux ce qu'on avait dit, écrit ou convenu auparavant"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "retirer",
                                "target_lang_sense_clarification": "ses paroles, ses propos"
                            },
                            {
                                "target_lang_word": "rétracter",
                                "target_lang_sense_clarification": "une déclaration, un aveu, un témoignage"
                            },
                            {
                                "target_lang_word": "révoquer",
                                "target_lang_sense_clarification": "un accord, une décision"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b34539d7-7679-3712-9bdf-a82b51f7e2e0",
                    "sense_definition": "pozbawić kogoś pełnionego stanowiska, funkcji lub misji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "funkcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rada nadzorcza postanowiła niespodziewanie <w>odwołać</w> prezesa ze stanowiska.",
                            "target_lang_translations": {
                                "fr": "Le conseil de surveillance a décidé de manière inattendue de <w>révoquer</w> le président de ses fonctions."
                            }
                        },
                        {
                            "text": "Prezydent postanowił <w>odwołać</w> ambasadora z placówki dyplomatycznej.",
                            "target_lang_translations": {
                                "fr": "Le président a décidé de <w>rappeler</w> l'ambassadeur de son poste diplomatique."
                            }
                        }
                    ],
                    "synonyms": [
                        "zdjąć",
                        "zdymisjonować"
                    ],
                    "antonyms": [
                        "mianować",
                        "powołać"
                    ],
                    "common_phrases": [
                        "odwołać ze stanowiska",
                        "odwołać z funkcji"
                    ],
                    "target_lang_definitions": {
                        "fr": "démis quelqu'un de son poste, de ses fonctions ou d'une mission"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "révoquer",
                                "target_lang_sense_clarification": "un dirigeant, un fonctionnaire"
                            },
                            {
                                "target_lang_word": "rappeler",
                                "target_lang_sense_clarification": "un ambassadeur, un diplomate"
                            },
                            {
                                "target_lang_word": "destituer",
                                "target_lang_sense_clarification": "retirer une fonction officielle"
                            },
                            {
                                "target_lang_word": "limoger",
                                "target_lang_sense_clarification": "écarter de ses fonctions, congédier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e77c683-a2a3-32bd-a2e6-74942f74745c",
                    "sense_definition": "w formie zwrotnej odwołać się: zaskarżyć niekorzystną decyzję lub wyrok do organu wyższej instancji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeśli nie zgadzasz się z tą decyzją, możesz <w>odwołać</w> się do sądu.",
                            "target_lang_translations": {
                                "fr": "Si tu n'es pas d'accord avec cette décision, tu peux <w>faire appel</w> devant le tribunal."
                            }
                        },
                        {
                            "text": "Student postanowił <w>odwołać</w> się od negatywnego wyniku egzaminu.",
                            "target_lang_translations": {
                                "fr": "L'étudiant a décidé de <w>faire appel</w> de la note négative obtenue à l'examen."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaapelować",
                        "zaskarżyć"
                    ],
                    "common_phrases": [
                        "odwołać się od decyzji",
                        "odwołać się do sądu"
                    ],
                    "target_lang_definitions": {
                        "fr": "contester une décision défavorable ou un jugement devant une instance supérieure"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "faire appel",
                                "target_lang_sense_clarification": "en justice, contre un jugement ou une décision"
                            },
                            {
                                "target_lang_word": "recourir",
                                "target_lang_sense_clarification": "former un recours"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04092c92-8f3a-3ff9-937d-880b5b6d977b",
                    "sense_definition": "w formie zwrotnej odwołać się: nawiązać do kogoś, czegoś lub powołać się na jakiś fakt, autorytet bądź źródło",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W swoim eseju autor postanowił <w>odwołać</w> się do klasycznej literatury.",
                            "target_lang_translations": {
                                "fr": "Dans son essai, l'auteur a décidé de <w>se référer</w> à la littérature classique."
                            }
                        },
                        {
                            "text": "W dyskusji warto <w>odwołać</w> się do sprawdzonych faktów naukowych.",
                            "target_lang_translations": {
                                "fr": "Dans une discussion, il vaut la peine de <w>s'appuyer</w> sur des faits scientifiques vérifiés."
                            }
                        }
                    ],
                    "synonyms": [
                        "nawiązać",
                        "powołać"
                    ],
                    "common_phrases": [
                        "odwołać się do tradycji",
                        "odwołać się do faktów"
                    ],
                    "target_lang_definitions": {
                        "fr": "faire référence à quelqu'un ou quelque chose, invoquer une autorité, un fait ou une source"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se référer",
                                "target_lang_sense_clarification": "renvoyer à une source, un texte, des faits"
                            },
                            {
                                "target_lang_word": "faire référence",
                                "target_lang_sense_clarification": "évoquer un exemple, une tradition"
                            },
                            {
                                "target_lang_word": "invoquer",
                                "target_lang_sense_clarification": "faire valoir un fait, un principe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}