                        "sense_id": "2c44d6f8-41e1-3be1-9060-aa1b9b1c4d71",
                        "entry_id": "0ece528c-4ce9-3ba4-a0fc-ff83baaf1293",
                        "glosses": [
                            "Papillon du genre Orgyia, de la famille des Lymantriidae."
                        ],
                        "tags": [],
