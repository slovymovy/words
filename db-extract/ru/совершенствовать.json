                    },
                    {
                        "translation_id": "d3c11833-1d47-49f5-9b28-74943ad283c2",
                        "source_entry_id": "c2932ae9-ba85-3547-ab22-71f300a15aac",
                        "source_sense_id": "fdbef782-ec58-3abf-a868-1b32853ae08b",
                        "target_lang_word": "perfectionner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfectionner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0474f921-797d-3255-8785-11a8fb34603d",
                                        "entry_id": "cbbe7cce-ed69-308d-b835-95949d37a69c",
                                        "glosses": [
                                            "Rendre meilleur ; corriger les défauts ; faire progresser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115f1055-d2a0-4f37-bb15-69cd9e6b750e",
                                                "sense_id": "0474f921-797d-3255-8785-11a8fb34603d",
                                                "text": "Perfectionner les procédés d’un art, la méthode d’une science."
                                            },
                                            {
                                                "example_id": "2008b730-7da6-49dd-af49-91e1f27b8a33",
                                                "sense_id": "0474f921-797d-3255-8785-11a8fb34603d",
                                                "text": "Perfectionner son goût, son style par l’étude, par le travail, par la lecture."
                                            },
                                            {
                                                "example_id": "a219eeb5-ee31-4ce6-9cb4-0cfd1fea98bd",
                                                "sense_id": "0474f921-797d-3255-8785-11a8fb34603d",
                                                "text": "La génération actuelle, en effet, ne se contente pas d'utiliser tels quels les procédés légués par le devanciers ; elle les perfectionne."
                                            },
                                            {
                                                "example_id": "30bede97-d9c8-4bda-be6e-19d23cb3c6ea",
                                                "sense_id": "0474f921-797d-3255-8785-11a8fb34603d",
                                                "text": "J’ai signalé déjà l’esprit inventif de cet excellent garçon et l’espèce de génie qu’il apportait à rendre inutilisables les objets les plus simples sous le fallacieux prétexte de les perfectionner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cba20267-7ab5-3e5b-b20a-86334b09585f",
                                        "entry_id": "cbbe7cce-ed69-308d-b835-95949d37a69c",
                                        "glosses": [
                                            "S’améliorer, faire des progrès."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde811f7-90e3-4d54-9aaf-5882d4394cf9",
                                                "sense_id": "cba20267-7ab5-3e5b-b20a-86334b09585f",
                                                "text": "Cet ouvrier s’est perfectionné dans son art."
                                            },
                                            {
                                                "example_id": "c24ccec4-de3b-42c6-a92e-cd5454c23038",
                                                "sense_id": "cba20267-7ab5-3e5b-b20a-86334b09585f",
                                                "text": "Ce jeune homme s’est bien perfectionné par la fréquentation de la bonne société."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28360cb0-8afb-4d5e-b89b-3b20dc101799",
                        "source_entry_id": "c2932ae9-ba85-3547-ab22-71f300a15aac",
                        "source_sense_id": "fdbef782-ec58-3abf-a868-1b32853ae08b",
                        "target_lang_word": "améliorer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "améliorer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ad7e6de-54a0-3b06-a291-e4376ae71fb8",
                                        "entry_id": "eb7f26e9-c174-39c4-b9bd-776fcce838e0",
                                        "glosses": [
                                            "Rendre meilleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49fbc595-898f-486f-afee-a5e02317bdb3",
                                                "sense_id": "0ad7e6de-54a0-3b06-a291-e4376ae71fb8",
                                                "text": "Les catholiques sociaux […] veulent améliorer le sort des pauvres, non seulement par la charité, mais par une foule d’institutions propres à atténuer les douleurs causées par l’économie capitaliste."
                                            },
                                            {
                                                "example_id": "30107588-3b96-4734-926a-3efa1a1565cc",
                                                "sense_id": "0ad7e6de-54a0-3b06-a291-e4376ae71fb8",
                                                "text": "L’inspection ante-mortem peut améliorer l’efficacité de l’opération en éliminant un certain nombre d’animaux qui seraient impropres à la consommation."
                                            },
                                            {
                                                "example_id": "a6d29b00-e1d0-4787-8589-010c18cfed6a",
                                                "sense_id": "0ad7e6de-54a0-3b06-a291-e4376ae71fb8",
                                                "text": "J'imagine que Fly n’a pas été impressionné. […]. De toute façon, je ne vois pas comment je pourrais améliorer ma réputation aux yeux d'un sapiosexuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "655870b7-24af-3f33-8df2-6e365a18cd5d",
                                        "entry_id": "eb7f26e9-c174-39c4-b9bd-776fcce838e0",
                                        "glosses": [
                                            "Donner plus de valeur, en parlant des réparations qu’on fait à un bâtiment, des augmentations de revenu d’un fonds de terre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a5b444-ad97-433d-9f78-0463aca0d90d",
                                                "sense_id": "655870b7-24af-3f33-8df2-6e365a18cd5d",
                                                "text": "L'argille convient pour améliorer les terres sablonneuses , graveleuses ou pierreuses ; on s'en sert beaucoup dans la Province de Stafford. Soixante-quinze charges suffiront à un arpent, & fertiliseront la terre quarante ans : […]."
                                            },
                                            {
                                                "example_id": "63095dfd-6dab-4e7a-8aa8-2d19b19df4b9",
                                                "sense_id": "655870b7-24af-3f33-8df2-6e365a18cd5d",
                                                "text": "Ajoutons que la plupart de nos prairies humides pourraient être singulièrement améliorées par des travaux d’assainissement collectif que réaliseraient les associations syndicales agricoles […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7903fd14-d380-3ce2-a2c2-7ee56a3e03c1",
                                        "entry_id": "eb7f26e9-c174-39c4-b9bd-776fcce838e0",
                                        "glosses": [
                                            "Augmenter les performances."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81c7467c-efe5-35cd-a3c0-fa3627448be1",
                                        "entry_id": "eb7f26e9-c174-39c4-b9bd-776fcce838e0",
                                        "glosses": [
                                            "Devenir meilleur."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6f71df-0c94-4016-b71a-94b47069b4b5",
                                                "sense_id": "81c7467c-efe5-35cd-a3c0-fa3627448be1",
                                                "text": "La condition sociale s’est progressivement améliorée et le métier s’est francisé (pour partie en accordant la nationalité française à des immigrés). L’éboueur n’est plus véritablement un manœuvre de force, même si le métier reste difficile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
