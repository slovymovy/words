                ],
                "senses": [
                    {
                        "sense_id": "7ce16ab5-04cb-30a7-81a0-971f0dbd514b",
                        "entry_id": "76f8a6a9-f5c1-3bda-89f8-4b1dce084fe8",
                        "glosses": [
                            "Fonctionnalité informatique permettant à l’utilisateur, avant de valider une action (en particulier une modification sur un document), d’apprécier les répercussions qu’elle aura."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f351139-2fbf-4552-88d4-ffddcb8e72ce",
                                "sense_id": "7ce16ab5-04cb-30a7-81a0-971f0dbd514b",
                                "text": "Dans le champ de recherche de Firefox, les suggestions sont de la partie avec en plus une prévisualisation des résultats."
                            },
                            {
                                "example_id": "5089fe7c-4d54-4354-b948-62d5863e5ca7",
                                "sense_id": "7ce16ab5-04cb-30a7-81a0-971f0dbd514b",
                                "text": "Dans la fenêtre d’InDesign, le menu qui permettait de passer du mode de prévisualisation au mode visualisation s’est logiquement enrichi de la prévisualisation avec ou sans débord, avec ou sans lignes-blocs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "098b7848-9ab2-4db2-9452-fe88e386bd38",
                        "source_entry_id": "76f8a6a9-f5c1-3bda-89f8-4b1dce084fe8",
                        "source_sense_id": "7ce16ab5-04cb-30a7-81a0-971f0dbd514b",
                        "target_lang_word": "preview",
