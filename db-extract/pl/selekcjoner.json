                    },
                    {
                        "sense_id": "de137671-825a-3a68-8e98-7c1441e1ac3a",
                        "entry_id": "aa3b454f-cb6b-388a-8e07-69d34b01bb39",
                        "glosses": [
                            "trener który ustala skład drużyny którą zarządza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0470e9-559f-48e2-ae42-9465bc4e16e5",
                                "sense_id": "de137671-825a-3a68-8e98-7c1441e1ac3a",
                                "text": "Wiele ludzi krytykowało selekcjonera reprezentacji Polski za decyzję jaką powziął."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "c510aaad-0fd8-3227-bb8f-7be415dd9f6f",
