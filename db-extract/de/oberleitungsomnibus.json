                "senses": [
                    {
                        "sense_id": "2dfdb46c-008c-3335-8199-4322fd8974d8",
                        "entry_id": "c5bb6ea1-bb02-3a2f-837a-402e33aeb61d",
                        "glosses": [
                            "Omnibus, der von einem Elektromotor angetrieben wird, welcher über eine Oberleitung mit Energie versorgt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ee784f-5e41-4650-b64b-c0ed1c67ef41",
                                "sense_id": "2dfdb46c-008c-3335-8199-4322fd8974d8",
                                "text": "Am Bahnhof stieg Claudia in den Oberleitungsomnibus und fuhr zu ihrer Stiefmutter."
                            },
                            {
                                "example_id": "ede21c61-63c5-4563-a26e-f9fca281cd4d",
                                "sense_id": "2dfdb46c-008c-3335-8199-4322fd8974d8",
                                "text": "Der Oberleitungsomnibus hält direkt vor unserem Haus."
                            },
                            {
                                "example_id": "8e14c8c7-0e9f-4034-a3b5-e51e9f2b98fb",
                                "sense_id": "2dfdb46c-008c-3335-8199-4322fd8974d8",
                                "text": "Zu unserem Museum kommen Sie am einfachsten, wenn Sie mit dem Oberleitungsomnibus fahren."
                            },
                            {
                                "example_id": "853ab431-5c3c-4724-b9be-24edfd9132c1",
                                "sense_id": "2dfdb46c-008c-3335-8199-4322fd8974d8",
                                "text": "Die Oberleitungsomnibusse prägen das Stadtbild."
                            },
                            {
                                "example_id": "49c77594-c64a-4c0e-8839-c301d7264896",
                                "sense_id": "2dfdb46c-008c-3335-8199-4322fd8974d8",
                                "text": "Gernot hat mal wieder den Oberleitungsomnibus verpasst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
