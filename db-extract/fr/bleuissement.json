                        "entry_id": "6bc7f4cc-79d7-33ef-a43f-1d4d2f002ae5",
                        "glosses": [
                            "Coloration bleuâtre de certains bois par des champignons attaquant la cellulose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dafe6afe-22cc-4ae2-8846-be4d70eb0c66",
                                "sense_id": "aff819f7-a5af-3f9a-99f2-fcf8790f2837",
                                "text": "Ces champignons sont essentiellement des Ophiostomatoïdes […] bien connus des forestiers et des exploitants par le « bleuissement » de l’aubier qu’ils provoquent en progressant dans le système vasculaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "65ba5b97-24f0-3f90-815b-b191a38a4904",
                        "entry_id": "6bc7f4cc-79d7-33ef-a43f-1d4d2f002ae5",
                        "glosses": [
                            "Prise de coloration bleue par quelqu'un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb559610-c3f7-4c92-aa4d-e6a824d8d459",
                                "sense_id": "65ba5b97-24f0-3f90-815b-b191a38a4904",
                                "text": "Le bleuissement de la peau provoqué par une cyanose."
                            },
                            {
                                "example_id": "4a8d8e47-412f-4d41-9a07-ebc0476b21ba",
                                "sense_id": "65ba5b97-24f0-3f90-815b-b191a38a4904",
                                "text": "Elle entra doucement dans l’eau son bras nu, un bras un peu maigre, dont la peau de soie montrait le bleuissement tendre des veines."
                            },
                            {
                                "example_id": "ac2bc4cf-3a7c-443a-803a-d5eabc07dfd2",
                                "sense_id": "65ba5b97-24f0-3f90-815b-b191a38a4904",
                                "text": "Il faisait nuit. Au ciel, les étoiles luisaient dans un bleuissement de velours."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddce19e3-1382-31d4-8479-5154fc59ee26",
                        "entry_id": "6bc7f4cc-79d7-33ef-a43f-1d4d2f002ae5",
                        "glosses": [
                            "Sensibilisation des Canadiens au respect des océans."
