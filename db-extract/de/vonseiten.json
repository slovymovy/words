                "senses": [
                    {
                        "sense_id": "3e4b02c1-0b15-3d8b-bcb8-363d59fac4d6",
                        "entry_id": "dd50cb10-ae33-33ec-ac59-9b3e2fdea621",
                        "glosses": [
                            "von jemandes (Person, Institution et cetera) Seite"
                        ],
                        "tags": [
                            "gehoben,",
                            "mit Genitiv"
                        ],
                        "examples": [
                            {
                                "example_id": "d7b4ecc9-b940-4a6b-af13-cecc0eaded0f",
                                "sense_id": "3e4b02c1-0b15-3d8b-bcb8-363d59fac4d6",
                                "text": "„Das Tier mache einen gesunden und ruhigen Eindruck, hieß es vonseiten des Landratsamtes und Gut Aiderbichl.“"
                            },
                            {
                                "example_id": "e95f68be-1615-4e93-9d04-2f3959794f49",
                                "sense_id": "3e4b02c1-0b15-3d8b-bcb8-363d59fac4d6",
                                "text": "Vonseiten der Behörden kannst du dir keine Hilfe erhoffen."
                            },
                            {
                                "example_id": "d3c87a28-af42-4c6e-8d96-47ae44dcf2e9",
                                "sense_id": "3e4b02c1-0b15-3d8b-bcb8-363d59fac4d6",
                                "text": "Die Kritik an Walthers Arbeitsweise kam überwiegend vonseiten seiner Kollegen."
                            },
                            {
                                "example_id": "df77c6a5-4922-40f8-a63f-3d1332ef780d",
                                "sense_id": "3e4b02c1-0b15-3d8b-bcb8-363d59fac4d6",
                                "text": "Deinem Kuraufenthalt in Bayern steht vonseiten der Ärzte nun nichts mehr entgegen."
                            },
                            {
                                "example_id": "679360b2-57cd-400e-8a60-bc471a5cd25a",
                                "sense_id": "3e4b02c1-0b15-3d8b-bcb8-363d59fac4d6",
                                "text": "Sämtliche Bedenken, die vonseiten der Statiker geäußert wurden, konnten im Rahmen der Nachbesserungen an den Entwürfen zerstreut werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
