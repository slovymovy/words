                "translations": [
                    {
                        "translation_id": "2a4fa5e1-1801-4b30-9646-0ea593b4dcf7",
                        "source_entry_id": "1ba26331-2a00-34da-ac57-dcaafe66c44f",
                        "target_lang_word": "infantile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infantile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cef4d299-39fb-3711-9210-4474f050a0e6",
                                        "entry_id": "1ac1782b-3848-375f-b66f-025801b07ef2",
                                        "glosses": [
                                            "Pertaining to infants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a8f6d61-c9c5-4e72-b486-cdd861daf235",
                                                "sense_id": "cef4d299-39fb-3711-9210-4474f050a0e6",
                                                "text": "infantile paralysis"
                                            },
                                            {
                                                "example_id": "18c438b4-0e52-4aeb-9370-e95c160e49e4",
                                                "sense_id": "cef4d299-39fb-3711-9210-4474f050a0e6",
                                                "text": "They and the old North London tanks at Richmond long ago were the first engines on which my infantile eyes rested, be it said with an admiration that the years have never dimmed."
                                            },
                                            {
                                                "example_id": "45bb54d0-51e7-4730-985f-4bd15ab7d882",
                                                "sense_id": "cef4d299-39fb-3711-9210-4474f050a0e6",
                                                "text": "Eustace gaped at him in amazement. When his urbanity dropped away from him, as now, he had an innocence of expression which was almost infantile. It was as if the world had never touched him at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fde48d1-8527-3808-842e-f168a6dda130",
                                        "entry_id": "1ac1782b-3848-375f-b66f-025801b07ef2",
                                        "glosses": [
                                            "Childish; immature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef12e15b-e855-45b0-b1ee-395a23824ff5",
                        "source_entry_id": "1ba26331-2a00-34da-ac57-dcaafe66c44f",
                        "target_lang_word": "childish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "childish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "608b5e49-1f02-39b3-81a4-22a49d9e1190",
                                        "entry_id": "88da9a64-8ae3-35ca-813a-28d80ccacb1c",
                                        "glosses": [
                                            "Immature in thought or behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca4da54-61a5-4964-92f1-cb0bf88439ae",
                                                "sense_id": "608b5e49-1f02-39b3-81a4-22a49d9e1190",
                                                "text": "Your childish temper tantrums are not going to change my decision on this matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                        "entry_id": "88da9a64-8ae3-35ca-813a-28d80ccacb1c",
                                        "glosses": [
                                            "Suitable for or expected of a child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eab1c81a-f3c6-455b-bfea-1415295d2920",
                                                "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                                "text": "This game is very childish."
                                            },
                                            {
                                                "example_id": "bc258e84-226a-4eb4-ad81-ccb085a977a7",
                                                "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                                "text": "She remembered, too, when, after a long childish illness, her father had carried her in his arms to the garden, […]"
                                            },
                                            {
                                                "example_id": "d1f4b3f1-908a-400a-b562-f6856742b936",
                                                "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                                "text": "As I walked to and fro daily between Southwark and Blackfriars, and lounged about at meal-times in obscure streets, the stones of which may, for anything I know, be worn at this moment by my childish feet, I wonder how many of these people were wanting in the crowd that used to come filing before me in review again, to the echo of Captain Hopkins’s voice!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
