                        "entry_id": "0bf3358c-54fc-3bce-a547-f06a0eee3b22",
                        "glosses": [
                            "die Haltung eines alten nicht mehr leistungsfähigen Pferdes"
                        ],
                        "tags": [
                            "meist \\\"Gnadenbrot erteilen\\"
                        ],
                        "examples": [
                            {
                                "example_id": "2ec8409c-c1db-49f4-9118-51e987a86bb6",
                                "sense_id": "1fa320e2-291b-32a7-b97f-788d0d38d821",
                                "text": "Das Tier erhält bei uns sein Gnadenbrot."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e97be007-56a6-3c2e-a980-9a466584dd86",
                        "entry_id": "0bf3358c-54fc-3bce-a547-f06a0eee3b22",
                        "glosses": [
                            "Unterstützung eines nicht mehr arbeitsfähigen Menschen durch Almosen oder milde Gabe wegen Mitleids und auch aufgrund von früheren Leistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1a3c190-04c8-4bee-b701-8f3e790fc5ac",
                                "sense_id": "e97be007-56a6-3c2e-a980-9a466584dd86",
                                "text": "Der alte Knecht durfte auf dem Hof bleiben und erhielt sein Gnadenbrot."
                            },
                            {
                                "example_id": "709a9399-f121-4176-a6d4-9e287dc42868",
                                "sense_id": "e97be007-56a6-3c2e-a980-9a466584dd86",
                                "text": "Es sei eine Schande für mich und ich müsse mich schämen, mich von Ihnen ernähren zu lassen und auf Ihre Kosten zu leben … Sie sagt, ich hätte das Gnadenbrot, das sie uns gegeben, vergessen – hätte vergessen, daß sie meine Mutter und mich vor dem Hungertode bewahrt, daß sie uns ernährt und gepflegt und fast zweieinhalb Jahre lang nur Unkosten durch uns gehabt, und daß sie uns außerdem eine alte Schuld geschenkt habe."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "255697d1-ec9e-448d-90fe-d3119fca05c5",
                        "source_entry_id": "0bf3358c-54fc-3bce-a547-f06a0eee3b22",
                        "source_sense_id": "1fa320e2-291b-32a7-b97f-788d0d38d821",
                        "target_lang_word": "charity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "An organization, the objective of which is to carry out a charitable purpose."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c5ccefa-a475-470c-b7b5-8dd67ca42b9d",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”.[…]’."
                                            },
                                            {
                                                "example_id": "aeda157c-09b7-4541-9cea-77597fc9f0d7",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "The event raised money for local charities."
                                            },
                                            {
                                                "example_id": "50803e8c-aaf0-4468-8310-8a4d2930a2d0",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "He donated half his earnings to charity."
                                            },
                                            {
                                                "example_id": "c8d9f69c-b9df-4e85-904d-5976c7a225aa",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "give to charity"
                                            },
                                            {
                                                "example_id": "bf1fa6d2-8964-4bc7-b6ea-83b430aeab71",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "registered charity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8709b991-44cd-32c3-b8a5-d3a7ea856996",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "The goods or money given to those in need."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9829f82-a540-3bb9-b183-134ba78bc40d",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "Benevolence to others less fortunate than ourselves; the providing of goods or money to those in need."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf5942e-6beb-4ed5-b760-cf7396d67b1b",
                                                "sense_id": "f9829f82-a540-3bb9-b183-134ba78bc40d",
                                                "text": "act of charity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc036e7-69d7-35f7-9497-9f376a1828c1",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "In general, an attitude of kindness and understanding towards others, now especially suggesting generosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8816b4-70e7-43a8-9beb-0b75b2e187e1",
                                                "sense_id": "9dc036e7-69d7-35f7-9497-9f376a1828c1",
                                                "text": "July 20, 1677, John Mitchell Mason, letter to a friend\nJudge thyself with the judgment of sincerity, and thou witl judge others with the judgment of charity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e07ab4b-3777-3e48-af6f-a56f4ca6a231",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "Christian love; representing God's love of man, man's love of God, or man's love of his fellow-men."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "144e0bd8-87d7-4c72-bc89-02b4fe30b991",
                                                "sense_id": "2e07ab4b-3777-3e48-af6f-a56f4ca6a231",
                                                "text": "Charity suffereth long, and is kind; charity envieth not; charity vaunteth not itself, is not puffed up, Doth not behave itself unseemly, seeketh not her own, is not easily provoked, thinketh no evil."
                                            }
                                        ]
                                    },
