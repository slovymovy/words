{
    "word_family": [
        "breakable",
        "breakage",
        "breaker",
        "breakdown",
        "breakout",
        "breakthrough",
        "breakneck",
        "breakwater",
        "daybreak",
        "heartbreak",
        "outbreak",
        "unbreakable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9d3d828-deb4-3670-bc47-625435439c29",
                    "sense_definition": "To separate into two or more pieces, to fracture or crack, by a process that cannot easily be reversed for reassembly.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the glass vase falls to the floor, it might <w>break</w> into many tiny pieces.",
                            "target_lang_translations": {
                                "ru": "Если стеклянная ваза упадет на пол, она может <w>разбиться</w> на множество мелких осколков."
                            }
                        },
                        {
                            "text": "Be careful not to <w>break</w> the window while you are playing with the ball outside.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>разбей</w> окно, когда играешь с мячом на улице."
                            }
                        }
                    ],
                    "synonyms": [
                        "shatter",
                        "smash",
                        "fracture",
                        "crack"
                    ],
                    "antonyms": [
                        "fix",
                        "mend",
                        "repair",
                        "join"
                    ],
                    "common_phrases": [
                        "break into pieces",
                        "break easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять на две или более части, ломать или разбивать в результате процесса, который трудно обратить вспять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ломать",
                                "target_lang_sense_clarification": "разделять на части, нарушать целостность"
                            },
                            {
                                "target_lang_word": "разбивать",
                                "target_lang_sense_clarification": "разрушать ударом или падением на куски"
                            },
                            {
                                "target_lang_word": "сломать",
                                "target_lang_sense_clarification": "совершенный вид: нарушить целостность"
                            },
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "совершенный вид: расколоть на части"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9cbed8b-c2d0-35cd-abb1-0543ca40d7b6",
                    "sense_definition": "To violate or fail to adhere to a rule, law, or promise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should never <w>break</w> the law, even if you think the rule is unfair.",
                            "target_lang_translations": {
                                "ru": "Никогда не следует <w>нарушать</w> закон, даже если ты считаешь правило несправедливым."
                            }
                        },
                        {
                            "text": "He promised to help me move, but he had to <w>break</w> his word at the last minute.",
                            "target_lang_translations": {
                                "ru": "Он обещал помочь мне с переездом, но в последнюю минуту ему пришлось <w>нарушить</w> свое слово."
                            }
                        }
                    ],
                    "synonyms": [
                        "violate",
                        "contravene",
                        "disobey"
                    ],
                    "antonyms": [
                        "hold"
                    ],
                    "common_phrases": [
                        "break the law",
                        "break a promise",
                        "break your word"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушать или не соблюдать правило, закон или обещание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "не соблюдать закон или правила"
                            },
                            {
                                "target_lang_word": "нарушить",
                                "target_lang_sense_clarification": "совершенный вид: преступить закон или обещание"
                            },
                            {
                                "target_lang_word": "сдержать",
                                "target_lang_sense_clarification": "в контексте обещания (антоним)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eed172a5-1348-35a7-8a67-9cfe6b2bb2b4",
                    "sense_definition": "To stop, or to cause to stop, functioning properly or altogether.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "malfunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My old computer started to <w>break</w> down after I installed the new software.",
                            "target_lang_translations": {
                                "ru": "Мой старый компьютер начал <w>ломаться</w> после того, как я установил новое программное обеспечение."
                            }
                        },
                        {
                            "text": "On the hottest day of the year, the refrigerator <w>broke</w> and all the food spoiled.",
                            "target_lang_translations": {
                                "ru": "В самый жаркий день года холодильник <w>сломался</w>, и вся еда испортилась."
                            }
                        }
                    ],
                    "synonyms": [
                        "fail",
                        "malfunction"
                    ],
                    "antonyms": [
                        "fix",
                        "repair"
                    ],
                    "common_phrases": [
                        "break down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать или заставить что-либо перестать функционировать должным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ломаться",
                                "target_lang_sense_clarification": "приходить в негодность, терять работоспособность"
                            },
                            {
                                "target_lang_word": "сломаться",
                                "target_lang_sense_clarification": "совершенный вид: выйти из строя"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "делать негодным, ухудшать состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b62b32d-709b-3bac-b48e-1ffb72568b97",
                    "sense_definition": "To interrupt or cease one's work or occupation temporarily; to go on break.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's <w>break</w> for lunch now and finish the meeting later this afternoon.",
                            "target_lang_translations": {
                                "ru": "Давайте сейчас <w>прервемся</w> на обед и закончим встречу сегодня попозже."
                            }
                        },
                        {
                            "text": "The workers usually <w>break</w> for ten minutes every two hours to rest.",
                            "target_lang_translations": {
                                "ru": "Рабочие обычно <w>делают перерыв</w> на десять минут каждые два часа, чтобы отдохнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "halt"
                    ],
                    "common_phrases": [
                        "break for lunch",
                        "break for tea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно прервать или прекратить работу или занятие; сделать перерыв."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать перерыв",
                                "target_lang_sense_clarification": "временно прекращать деятельность"
                            },
                            {
                                "target_lang_word": "прерываться",
                                "target_lang_sense_clarification": "делать паузу в работе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fde5618f-7caf-3d90-a631-777fb6766416",
                    "sense_definition": "To divide something, often money, into smaller units.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you <w>break</w> a twenty-dollar bill into smaller change for the bus?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>разменять</w> двадцатидолларовую купюру на мелочь для автобуса?"
                            }
                        },
                        {
                            "text": "The company decided to <w>break</w> the large project into several smaller tasks.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>разбить</w> крупный проект на несколько более мелких задач."
                            }
                        }
                    ],
                    "synonyms": [
                        "divide",
                        "split"
                    ],
                    "antonyms": [
                        "join",
                        "assemble"
                    ],
                    "common_phrases": [
                        "break a bill",
                        "break into units"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять что-либо, часто деньги, на более мелкие единицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разменять",
                                "target_lang_sense_clarification": "обменять крупную купюру на мелкие"
                            },
                            {
                                "target_lang_word": "разбивать",
                                "target_lang_sense_clarification": "разделять проект или сумму на части"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ba0ae26-6d69-3155-b1ee-2badbed0a30c",
                    "sense_definition": "To surpass or do better than a specific number or a record.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete managed to <w>break</w> the world record during the final race.",
                            "target_lang_translations": {
                                "ru": "Атлету удалось <w>побить</w> мировой рекорд во время финального забега."
                            }
                        },
                        {
                            "text": "The movie is expected to <w>break</w> all previous box office records this weekend.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что в эти выходные фильм <w>побьет</w> все предыдущие кассовые рекорды."
                            }
                        }
                    ],
                    "synonyms": [
                        "surpass",
                        "exceed",
                        "beat"
                    ],
                    "common_phrases": [
                        "break a record",
                        "break the record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превзойти или улучшить определенное число или рекорд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побить",
                                "target_lang_sense_clarification": "превзойти существующий рекорд"
                            },
                            {
                                "target_lang_word": "превзойти",
                                "target_lang_sense_clarification": "оказаться выше какого-либо показателя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0a4325-7d8b-353a-bdfb-366b54e02d81",
                    "sense_definition": "To disclose or make known an item of news or information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist wanted to <w>break</w> the story before any other news agency.",
                            "target_lang_translations": {
                                "ru": "Журналист хотел <w>опубликовать</w> эту историю раньше любого другого агентства новостей."
                            }
                        },
                        {
                            "text": "I do not know how to <w>break</w> the bad news to my family.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, как <w>сообщить</w> плохие новости своей семье."
                            }
                        }
                    ],
                    "synonyms": [
                        "disclose",
                        "reveal",
                        "divulge"
                    ],
                    "common_phrases": [
                        "break the news",
                        "break a story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрыть или сообщить новость или информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщить",
                                "target_lang_sense_clarification": "сделать известным известие"
                            },
                            {
                                "target_lang_word": "раскрыть",
                                "target_lang_sense_clarification": "сделать явным скрытую информацию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffdcb95f-335f-3507-981c-58d0a02ed141",
                    "sense_definition": "A rest or pause, usually from work or an activity.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have been working for three hours, so let's take a short <w>break</w>.",
                            "target_lang_translations": {
                                "ru": "Мы работаем уже три часа, так что давайте сделаем небольшой <w>перерыв</w>."
                            }
                        },
                        {
                            "text": "I usually go for a walk during my lunch <w>break</w> to get some fresh air.",
                            "target_lang_translations": {
                                "ru": "Обычно я хожу на прогулку во время обеденного <w>перерыва</w>, чтобы подышать свежим воздухом."
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "rest",
                        "respite",
                        "recess",
                        "time-out"
                    ],
                    "common_phrases": [
                        "take a break",
                        "lunch break",
                        "coffee break"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдых или пауза, обычно в работе или деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерыв",
                                "target_lang_sense_clarification": "временная приостановка деятельности"
                            },
                            {
                                "target_lang_word": "пауза",
                                "target_lang_sense_clarification": "кратковременная остановка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "331d0982-c575-3263-9259-5dede802a701",
                    "sense_definition": "An instance of breaking something into two or more pieces.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor said the bone has a clean <w>break</w> and will heal quickly.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что у кости чистый <w>перелом</w> и он быстро заживет."
                            }
                        },
                        {
                            "text": "You can see the <w>break</w> in the wood where the branch snapped off.",
                            "target_lang_translations": {
                                "ru": "Вы можете увидеть <w>разлом</w> в древесине там, где отломилась ветка."
                            }
                        }
                    ],
                    "synonyms": [
                        "fracture",
                        "crack",
                        "split"
                    ],
                    "common_phrases": [
                        "clean break"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай разделения чего-либо на две или более части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перелом",
                                "target_lang_sense_clarification": "о костях или твердых предметах"
                            },
                            {
                                "target_lang_word": "разлом",
                                "target_lang_sense_clarification": "место, где произошло разрушение"
                            },
                            {
                                "target_lang_word": "трещина",
                                "target_lang_sense_clarification": "неполный разрыв материала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e252f6f8-7270-351e-92fc-9f66e50f8d5f",
                    "sense_definition": "A scheduled interval of days or weeks between periods of school instruction; a holiday.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "holiday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am planning to visit my grandparents during the upcoming spring <w>break</w>.",
                            "target_lang_translations": {
                                "ru": "Я планирую навестить бабушку с дедушкой во время предстоящих весенних <w>каникул</w>."
                            }
                        },
                        {
                            "text": "The students are all very excited because winter <w>break</w> starts next Friday.",
                            "target_lang_translations": {
                                "ru": "Все студенты очень взволнованы, потому что зимние <w>каникулы</w> начинаются в следующую пятницу."
                            }
                        }
                    ],
                    "synonyms": [
                        "holiday",
                        "vacation",
                        "recess"
                    ],
                    "common_phrases": [
                        "spring break",
                        "winter break",
                        "summer break"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланированный интервал в несколько дней или недель между периодами обучения в школе; каникулы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каникулы",
                                "target_lang_sense_clarification": "перерыв в учебе"
                            },
                            {
                                "target_lang_word": "отпуск",
                                "target_lang_sense_clarification": "перерыв в работе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acbb28c8-e196-32ca-bfc9-89eace437bb0",
                    "sense_definition": "A physical space that opens up in something or between two things.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun finally came out through a small <w>break</w> in the clouds.",
                            "target_lang_translations": {
                                "ru": "Солнце наконец выглянуло через небольшой <w>просвет</w> в облаках."
                            }
                        },
                        {
                            "text": "He waited for a <w>break</w> in the traffic before trying to cross the street.",
                            "target_lang_translations": {
                                "ru": "Он подождал <w>просвета</w> в движении, прежде чем пытаться перейти улицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "gap",
                        "opening",
                        "space",
                        "hole"
                    ],
                    "common_phrases": [
                        "break in the clouds",
                        "break in traffic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое пространство, которое открывается в чем-то или между двумя вещами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просвет",
                                "target_lang_sense_clarification": "пространство между облаками или деревьями"
                            },
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "промежуток в движении или ряду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86443a16-102b-391b-ade9-26c5708c25c7",
                    "sense_definition": "A significant change in circumstance, often a lucky opportunity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opportunity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young actor finally got his big <w>break</w> when he was cast in a movie.",
                            "target_lang_translations": {
                                "ru": "Молодой актер наконец-то получил свой большой <w>шанс</w>, когда его утвердили на роль в кино."
                            }
                        },
                        {
                            "text": "Finding that lost wallet with the owner's ID was a lucky <w>break</w> for him.",
                            "target_lang_translations": {
                                "ru": "То, что он нашел потерянный кошелек с удостоверением владельца, стало для него счастливым <w>случаем</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opportunity",
                        "chance"
                    ],
                    "common_phrases": [
                        "big break",
                        "lucky break",
                        "bad break"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in phrases like 'lucky break' or 'big break'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительное изменение обстоятельств, часто счастливая возможность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шанс",
                                "target_lang_sense_clarification": "удачная возможность"
                            },
                            {
                                "target_lang_word": "поворот",
                                "target_lang_sense_clarification": "резкое изменение в судьбе или карьере"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}