                    },
                    {
                        "sense_id": "ffa02a82-de75-368a-bd5d-8bd8311a93f8",
                        "entry_id": "42223263-0fd5-303f-bcd5-15d4fff6c877",
                        "glosses": [
                            "Einzelfrucht in einer Sammelnussfrucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5d8970-128e-4aba-8db3-7630dc2a3ef8",
                                "sense_id": "ffa02a82-de75-368a-bd5d-8bd8311a93f8",
                                "text": "Die gelben Punkte auf den Erdbeeren sind die Nüsschen, also die eigentlichen Früchte."
