{
    "word_family": [
        "tumble",
        "tumbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ddff3367-60f4-3191-b3b5-d8f63802b71f",
                    "sense_definition": "present participle and gerund of <w>tumble</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rocks were <w>tumbling</w> down the mountain during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время бури камни <w>кубарем катились</w> с горы.",
                                "it": "Le rocce stavano <w>rotolando</w> giù dalla montagna durante la tempesta."
                            }
                        },
                        {
                            "text": "Stock prices have been <w>tumbling</w> rapidly all morning.",
                            "target_lang_translations": {
                                "ru": "Цены на акции всё утро стремительно <w>падали</w>.",
                                "it": "I prezzi delle azioni sono stati in rapido <w>crollo</w> per tutta la mattina."
                            }
                        }
                    ],
                    "synonyms": [
                        "falling",
                        "dropping"
                    ],
                    "antonyms": [
                        "rising",
                        "soaring"
                    ],
                    "common_phrases": [
                        "tumbling down",
                        "tumbling over"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола tumble: кувыркающийся, катящийся кувырком, стремительно падающий или рушащийся.",
                        "it": "Participio presente e gerundio di tumble: il cadere rotolando, precipitare o crollare bruscamente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падающий",
                                "target_lang_sense_clarification": "о резком или кувыркающемся падении"
                            },
                            {
                                "target_lang_word": "катящийся",
                                "target_lang_sense_clarification": "кувырком или кубарем"
                            },
                            {
                                "target_lang_word": "рушащийся",
                                "target_lang_sense_clarification": "об обвале, резком спаде цен"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "cadere",
                                "target_lang_sense_clarification": "cadere rotolando o all'improvviso"
                            },
                            {
                                "target_lang_word": "rotolare",
                                "target_lang_sense_clarification": "muoversi rotolando verso il basso"
                            },
                            {
                                "target_lang_word": "crollare",
                                "target_lang_sense_clarification": "di prezzi o valori che calano bruscamente"
                            },
                            {
                                "target_lang_word": "precipitare",
                                "target_lang_sense_clarification": "cadere rapidamente dall'alto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "888cfb93-506b-37c2-acfa-c11a86d08b49",
                    "sense_definition": "The act of falling, rolling, or performing acrobatic flips and rolls.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She practiced her gymnastics <w>tumbling</w> on the padded floor.",
                            "target_lang_translations": {
                                "ru": "Она отрабатывала гимнастические <w>акробатические прыжки</w> на мягком покрытии.",
                                "it": "Si è esercitata nelle sue <w>acrobazie</w> ginniche sul pavimento imbottito."
                            }
                        },
                        {
                            "text": "The steep descent caused several clumsy falls and <w>tumblings</w> among the hikers.",
                            "target_lang_translations": {
                                "ru": "Крутой спуск стал причиной нескольких неловких падений и <w>кувырканий</w> среди туристов.",
                                "it": "La ripida discesa ha causato diverse cadute goffe e <w>capitomboli</w> tra gli escursionisti."
                            }
                        }
                    ],
                    "synonyms": [
                        "acrobatics",
                        "somersaulting"
                    ],
                    "common_phrases": [
                        "gymnastic tumbling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акробатические прыжки, перевороты и кувырки; также падение кувырком.",
                        "it": "L'atto di cadere, rotolare, o l'esecuzione di capriole e salti acrobatici."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акробатические прыжки",
                                "target_lang_sense_clarification": "в спортивной гимнастике и акробатике"
                            },
                            {
                                "target_lang_word": "кувыркание",
                                "target_lang_sense_clarification": "действие кувыркающегося"
                            },
                            {
                                "target_lang_word": "кувырки",
                                "target_lang_sense_clarification": "перевороты через голову"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "acrobazia",
                                "target_lang_sense_clarification": "nella ginnastica, salti e capriole acrobatiche"
                            },
                            {
                                "target_lang_word": "capriola",
                                "target_lang_sense_clarification": "rotolamento o salto sul pavimento"
                            },
                            {
                                "target_lang_word": "ruzzolone",
                                "target_lang_sense_clarification": "caduta disordinata o serie di capitomboli"
                            },
                            {
                                "target_lang_word": "capitombolo",
                                "target_lang_sense_clarification": "caduta con capriola involontaria"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}