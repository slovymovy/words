                "senses": [
                    {
                        "sense_id": "b560f0e5-fa15-3122-afa0-b4c1e69632a7",
                        "entry_id": "eb2a6bf9-ab33-3377-bc81-d50c4221ac8a",
                        "glosses": [
                            "Bereich einer Stadt, in dem viele Geschäfte angesiedelt sind; der viele Einkaufsmöglichkeiten bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e0eb33-fe54-417a-9640-a6d013d418df",
                                "sense_id": "b560f0e5-fa15-3122-afa0-b4c1e69632a7",
                                "text": "„Der als Drahtzieher der Anschläge von Paris geltende Islamist Abdelhamid Abaaoud wollte sich womöglich im Geschäftsviertel La Defense in die Luft jagen.“"
                            },
                            {
                                "example_id": "09775568-3374-45ba-bdcd-70d5a44d4854",
                                "sense_id": "b560f0e5-fa15-3122-afa0-b4c1e69632a7",
                                "text": "„Und bald ziehn die jungen Menschen weiter, nach dem Geschäftsviertel; sie singen; und die Leute auf dem Bürgersteige verschwinden nach und nach, und die Fenster in der Nachbarschaft schließen sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b02f0795-4ac8-42d7-be8e-e80d4bad6556",
                        "source_entry_id": "eb2a6bf9-ab33-3377-bc81-d50c4221ac8a",
                        "source_sense_id": "b560f0e5-fa15-3122-afa0-b4c1e69632a7",
