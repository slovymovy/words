                "senses": [
                    {
                        "sense_id": "342f1044-837f-354b-8edc-da2eb7bb734d",
                        "entry_id": "8ef1fb5a-20e4-345f-aabf-c354e66e4925",
                        "glosses": [
                            "to drive up (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5778aa0c-03e3-4126-af2f-ded49be9e0fb",
                                "sense_id": "342f1044-837f-354b-8edc-da2eb7bb734d",
                                "text": "Он подъе́хал к подъе́зду.",
                                "translation": "He drove up to the entrance",
                                "english": "He drove up to the entrance"
                            },
                            {
                                "example_id": "f03c638c-73aa-48cf-9179-f47ffb8d2dbc",
                                "sense_id": "342f1044-837f-354b-8edc-da2eb7bb734d",
                                "text": "Мо́жно ли подъе́хать сюда́ на автомоби́ле?",
                                "translation": "Can one drive a car here?",
                                "english": "Can one drive a car here?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a333fc19-d233-353a-9bac-8f89d7c19fb7",
                        "entry_id": "8ef1fb5a-20e4-345f-aabf-c354e66e4925",
                        "glosses": [
                            "to drop in, to pay a short visit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4e7484ff-cff3-3555-a9d9-4fcf9c563155",
                        "entry_id": "8ef1fb5a-20e4-345f-aabf-c354e66e4925",
                        "glosses": [
                            "to get (round), to start a pick up line, to get on the right side (of)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6ff4958c-0284-4eca-bc36-b319be3d656c",
                                "sense_id": "4e7484ff-cff3-3555-a9d9-4fcf9c563155",
                                "text": "Ло́вко он к ней подъе́хал.",
                                "translation": "He got round her very nicely; he got on the right side of her",
                                "english": "He got round her very nicely; he got on the right side of her"
                            }
                        ]
                    }
