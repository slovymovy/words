                ],
                "senses": [
                    {
                        "sense_id": "dc9ada45-99a2-3595-aadb-da88fc76c0bc",
                        "entry_id": "60d6fb03-044a-349b-8ad3-9852fd72f040",
                        "glosses": [
                            "Forme pronominale de acagnarder, paresser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69d7067d-217a-4061-b91e-8a26a5c57e01",
                                "sense_id": "dc9ada45-99a2-3595-aadb-da88fc76c0bc",
                                "text": "Lattes et bardeaux paraissaient avoir été enlevés par les habitants eux-mêmes, estimant à juste titre qu’en temps de pluie, pareille chaumine ne saurait leur servir d’abri et que, par beau temps, il n’y a pas lieu de craindre la pluie ; à quoi bon, d’ailleurs, s’acagnarder au logis, quand on a ses coudées franches au cabaret, sur la grande route, où bon vous semble ?"
                            },
                            {
                                "example_id": "eecfcf63-be58-4a57-a95d-9456b6de196b",
                                "sense_id": "dc9ada45-99a2-3595-aadb-da88fc76c0bc",
                                "text": "D’autres vols de corneilles et de corbeaux s’étaient de ce temps levés des endroits où ils s’acagnardaient, et s’approchaient en haillonnant."
                            },
                            {
                                "example_id": "8a45d855-6644-4b89-aa86-994f2fe7ac5c",
                                "sense_id": "dc9ada45-99a2-3595-aadb-da88fc76c0bc",
                                "text": "Je m’acagnarde dans le lit et rêve de meules de foin."
                            },
                            {
                                "example_id": "654f9716-adfb-4e97-802e-ec9574e88471",
                                "sense_id": "dc9ada45-99a2-3595-aadb-da88fc76c0bc",
                                "text": "Que la chaleur d'un chant\nFasse fondre la neige\nContre quoi il ne sert à rien\nNi de s’emmitoufler\nNi de s’acagnarder !\""
                            }
                        ]
                    }
