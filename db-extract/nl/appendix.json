                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8aac8d-fef6-4992-a13b-510c13280e4d",
                                "sense_id": "aeb4dbd2-6080-3a8b-8db2-c6f2dea51b89",
                                "text": "Bij klassieke standbeelden zijn de vele fijne appendices vaak afgebroken."
                            }
                        ]
                    },
                    {
                        "sense_id": "5217f63c-1e95-3dfc-a5e6-84b732dada2d",
                        "entry_id": "d65c58b4-874c-38da-91a3-485d66c9597a",
                        "glosses": [
                            "wormvormig aanhangsel van de blindedarm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a819f9-17c8-4d64-a850-50ad353b0a6f",
                                "sense_id": "5217f63c-1e95-3dfc-a5e6-84b732dada2d",
                                "text": "Een blindedarm wordt ook wel oneigenlijk appendix genoemd."
                            }
                        ]
                    },
                    {
                        "sense_id": "12309cf8-e7c4-35a2-9227-09af241b6722",
                        "entry_id": "d65c58b4-874c-38da-91a3-485d66c9597a",
                        "glosses": [
                            "driehoekig uitgroeisel aan de lip van orchideeën van het geslacht spiegelorchis (Ophrys)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23cde552-3876-4cea-9576-54261f4e30bf",
                                "sense_id": "12309cf8-e7c4-35a2-9227-09af241b6722",
                                "text": "Waarschijnsel speelt de appendix een rol bij het aantrekken van bestuivers."
                            }
                        ]
                    },
                    {
                        "sense_id": "312cd4c4-5e15-3bc9-88ad-317fed163a5d",
                        "entry_id": "d65c58b4-874c-38da-91a3-485d66c9597a",
                        "glosses": [
                            "bijlage, document dat aan een ander schriftstuk toevoegd wordt (bv. een rekening)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebd98fd0-c3da-49e8-b903-7f40f8736a6b",
                                "sense_id": "312cd4c4-5e15-3bc9-88ad-317fed163a5d",
                                "text": "Ik heb verscheidene facturen als appendix bij mijn belastingaangifte gevoegd."
                            }
                        ]
                    },
                    {
                        "sense_id": "47a50ecc-1d26-3c26-aa88-ba7ff509ce3a",
                        "entry_id": "d65c58b4-874c-38da-91a3-485d66c9597a",
                        "glosses": [
                            "aanvullende informatie die achteraan een document toegevoegd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2d2c08-9149-45ed-ab1d-f932fdb4319e",
                                "sense_id": "47a50ecc-1d26-3c26-aa88-ba7ff509ce3a",
                                "text": "Dit artikel heeft drie appendices."
                            }
                        ]
                    }
                ],
