                    },
                    {
                        "translation_id": "5175f450-23b5-46f3-9dc4-9ffe75169d11",
                        "source_entry_id": "033811d3-4679-3825-8064-d2aef69379ff",
                        "source_sense_description": "to settle comfortably",
                        "target_lang_word": "bequem machen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1614c8af-c45d-483c-b5c1-794e3cb3c01f",
                        "source_entry_id": "033811d3-4679-3825-8064-d2aef69379ff",
                        "source_sense_description": "to settle comfortably",
                        "target_lang_word": "niederlassen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niederlassen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f520c51-973b-33a1-8616-2497f04b7150",
                                        "entry_id": "75c29cb2-016d-33c0-b4d7-c0785959116d",
                                        "glosses": [
                                            "einen Gegenstand senken/auf den Boden legen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e1dc69-4208-4a7b-8844-ed83024f92cc",
                                                "sense_id": "3f520c51-973b-33a1-8616-2497f04b7150",
                                                "text": "„Ist der Krahn an Bord geschwungen, so werden die Körbe auf das Kommando ‚Hier‘ niedergelassen, ausgeschüttet und durch große eiserne Trichter in die Kohlenbunker geschaufelt, wo die Heizer über sie herfallen.“ [Anmerkung: ‚Krahn‘ ist veraltete deutsche Rechtschreibung]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb2edf9a-14fa-3601-b3c5-24d9d62bf250",
                                        "entry_id": "75c29cb2-016d-33c0-b4d7-c0785959116d",
                                        "glosses": [
                                            "sich setzen (beispielsweise auf einen Stuhl, den Boden); die Knie auf den Boden beugen"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbee5025-400e-4f8c-bfed-6927e636206e",
                                                "sense_id": "fb2edf9a-14fa-3601-b3c5-24d9d62bf250",
                                                "text": "„Sie haben einen Baum unter dem es einfach nur gemütlich ist, aber können sich dort nicht bequem niederlassen? Dann bauen Sie doch einfach eine Baumbank!“"
                                            },
                                            {
                                                "example_id": "232ebe16-b3c2-4c47-b5ae-108a190e9bcc",
                                                "sense_id": "fb2edf9a-14fa-3601-b3c5-24d9d62bf250",
                                                "text": "„Er mußte sich zwischen den beiden ältesten [Töchtern] niederlassen: sie schenkten ihm Wein ein, legten ihm die besten Bissen vor und meinten sie hätten keinen schönern Mann auf der Welt gesehen.“ [Anmerkung: ‚mußte‘ ist veraltete deutsche Rechtschreibung]"
                                            },
                                            {
                                                "example_id": "79c3a8ac-99ad-4cad-b309-464bdf3ab343",
                                                "sense_id": "fb2edf9a-14fa-3601-b3c5-24d9d62bf250",
                                                "text": "„Der Gotte kamen die andern Weiber nach, und eine nach der andern ließ sich nieder ins Gras, vorsichtig die schönen Kittel in Sicherheit bringend, […]“"
                                            },
                                            {
                                                "example_id": "69631d74-1fd9-4a5a-bfe6-802a4d0f2b9b",
                                                "sense_id": "fb2edf9a-14fa-3601-b3c5-24d9d62bf250",
                                                "text": "„Ein Taubenschwarm, der bisher den Glockenturm umflogen hatte, ließ sich jetzt vor dem Hause nieder.“"
                                            },
                                            {
                                                "example_id": "5005ba1b-0e04-47de-8a13-beeb8cd0f460",
                                                "sense_id": "fb2edf9a-14fa-3601-b3c5-24d9d62bf250",
                                                "text": "„Gemeinsam kehrten Johnny, Lucy und Jules ins Wohnzimmer zurück und ließen sich um den großen Teetisch nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                        "entry_id": "75c29cb2-016d-33c0-b4d7-c0785959116d",
                                        "glosses": [
                                            "sich an einem Ort ansiedeln; an einem Ort ein Geschäft eröffnen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65366d57-d619-4a56-9919-feb60a814a11",
                                                "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                                "text": "„1849 kehrte er […] in seine Vaterstadt zurück und ließ sich als Musiklehrer nieder […]“"
                                            },
                                            {
                                                "example_id": "3c652b7f-0405-4b63-8ce1-449e0082f158",
                                                "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                                "text": "Ärzte können sich in Deutschland nicht einfach an einem Ort niederlassen."
                                            },
                                            {
                                                "example_id": "3e6f597c-c578-44a3-9923-74a8b4a78d16",
                                                "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                                "text": "In den ländlichen Regionen finden sich nicht genügend Ärzte, die sich mit einer Praxis niederlassen wollen."
                                            },
                                            {
                                                "example_id": "af8deed3-917a-4bc9-9d1b-badc909d9bf0",
                                                "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                                "text": "Die Pilgrim fathers ließen sich zuerst an der amerikanischen Ostküste nieder."
                                            },
                                            {
                                                "example_id": "5a43104d-9a13-4635-9515-87e910a45317",
                                                "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                                "text": "Viele Wikinger ließen sich in den eroberten Gebieten nieder und lebten dort friedlich als Bauern oder Handwerker."
                                            },
                                            {
                                                "example_id": "c901fa92-4453-429d-9f78-2485c2627aac",
                                                "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                                "text": "Während der großen Fluthen, in der ersten Hälfte des 17 . Jahrhunderts (1634) zogen viele Friesen von den Halligen nach Föhr, und ließen sich in Wyk und dem Dorfe Rieblum nieder, […] [Anmerkung: ‚Fluthen‘ ist veraltete deutsche Rechtschreibung]"
                                            },
                                            {
                                                "example_id": "f3e846e8-c9c7-476c-8d52-76dd93b0b056",
                                                "sense_id": "6f3e6cf8-1391-3e94-a99f-1bc5c61ba1c9",
                                                "text": "„Ein Uhu-Paar hat sich in einem Storchenhorst im Elb-Havel-Winkel niedergelassen. Es zieht bereits Junge auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
