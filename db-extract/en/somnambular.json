                        "examples": [
                            {
                                "example_id": "3217f43c-8154-42ed-a905-a46d8f180141",
                                "sense_id": "d545fe66-5963-312c-8b13-73ca2355b71e",
                                "text": "And while the palpitating peaks break out\nEcstatic from somnambular repose\nWith answers to the presence and the shout,\nWe, poets of the people, who take part\nWith elemental justice, natural right,\nJoin in our echoes also, nor refrain."
