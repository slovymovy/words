                        "entry_id": "608ff61b-54a9-3d3e-8b90-cd6ed9b564a6",
                        "glosses": [
                            "Étude de la vie extraterrestre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57400b86-8102-4cfe-8a6a-fc67a86bba46",
                                "sense_id": "743e68e0-6e8a-31d9-a08c-0614930ca05b",
                                "text": "Que de termes nouveaux : pulsar, quasar, radiosources, bioastronomie, \"Big Bang\" !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9478f25-fb27-4b8c-9b36-8e662f016dd5",
                        "source_entry_id": "608ff61b-54a9-3d3e-8b90-cd6ed9b564a6",
                        "source_sense_id": "743e68e0-6e8a-31d9-a08c-0614930ca05b",
                        "target_lang_word": "Exobiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exobiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                        "entry_id": "ed3562d0-accf-37d4-8873-11388bdc3bd1",
                                        "glosses": [
                                            "Wissenschaftszweig, der sich mit der Entstehung des Lebens im Universum beschäftigt"
                                        ],
                                        "tags": [
                                            "Astrophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f14afbb-2ab2-4390-9493-c26000cdc93c",
                                                "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                                "text": "„Ein wirkliches Hauptproblem der Exobiologie ist allerdings, dass es keine allgemein anerkannte Definition von Leben gibt.“"
                                            },
                                            {
                                                "example_id": "3b768f0f-39ad-4d82-84ba-a7d26077a826",
                                                "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                                "text": "„Mit der von mir gefundenen Prä-RNA erklärt die Exobiologie die vorvorletzte Stufe vor der Urzelle. Was ist komplexer als Prä-RNA und simpler als Bakterien, verfügt aber über elementare Lebensqualität?“"
                                            },
                                            {
                                                "example_id": "72d08cdf-0b89-4c75-b925-b7e40144287d",
                                                "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                                "text": "„In den Biowissenschaften steht neben der Grundlagenforschung auf den Gebieten der Strahlen-, Gravitations- und Exobiologie die Aufklärung der wissenschaftlichen Voraussetzungen und die Entwicklung und Erprobung von Methoden und Technologien für Langzeitaufenthalte vom Menschen im Weltraum im Brennpunkt des Interesses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
