                    },
                    {
                        "translation_id": "305acfc7-ca47-4091-8e41-b24e76ab933e",
                        "source_entry_id": "5f995b59-d843-37f1-9714-51fcdc319171",
                        "source_sense_id": "13d4b26d-d304-35aa-bf1c-b65f8d046160",
                        "target_lang_word": "virus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fbdf9b2-686a-3b25-a779-5b1fdcc330aa",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "A submicroscopic, non-cellular structure that consists of a core of DNA or RNA surrounded by a protein coat, that requires a living host cell to replicate, and that sometimes causes disease in the host organism (such agents are often classed as nonliving infectious particles and less often as microorganisms)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c99fdfc5-5aa8-4705-96ac-4676294770f7",
                                                "sense_id": "2fbdf9b2-686a-3b25-a779-5b1fdcc330aa",
                                                "text": "Viruses are the smallest and most simplified forms of life."
                                            },
                                            {
                                                "example_id": "0889ba05-f5ff-4e50-99a2-0642b9eea9d4",
                                                "sense_id": "2fbdf9b2-686a-3b25-a779-5b1fdcc330aa",
                                                "text": "Bats host many high-profile viruses that can infect humans, including severe acute respiratory syndrome and Ebola."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1b2f972-7b04-3fab-b6ab-8b16015f7c57",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "A submicroscopic, non-cellular structure that consists of a core of DNA or RNA surrounded by a protein coat, that requires a living host cell to replicate, and that sometimes causes disease in the host organism (such agents are often classed as nonliving infectious particles and less often as microorganisms).",
                                            "A species thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa2ddbfc-6b83-459d-a157-fa38697ef8b5",
                                                "sense_id": "c1b2f972-7b04-3fab-b6ab-8b16015f7c57",
                                                "text": "Meronym: virion (individual particle)"
                                            },
                                            {
                                                "example_id": "8ca944e7-197b-49aa-b6ca-8cb63e1444b8",
                                                "sense_id": "c1b2f972-7b04-3fab-b6ab-8b16015f7c57",
                                                "text": "Some viruses, such as norovirus, cause sporadic outbreaks of gastroenteritis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61eb54dd-ac97-3ea0-ad83-073095af53a6",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "A submicroscopic, non-cellular structure that consists of a core of DNA or RNA surrounded by a protein coat, that requires a living host cell to replicate, and that sometimes causes disease in the host organism (such agents are often classed as nonliving infectious particles and less often as microorganisms).",
                                            "An individual particle thereof: synonym of virion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68af525-c61a-486c-800b-8e71bbe7f4df",
                                                "sense_id": "61eb54dd-ac97-3ea0-ad83-073095af53a6",
                                                "text": "Under electron microscopy, a few viruses were seen floating near the cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7337eecf-ba6c-36bc-9548-c93e6a6b272c",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "A quantity of such infectious agents, considered en masse."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab9ac7b-1355-4993-a505-ecfe72e264ac",
                                                "sense_id": "7337eecf-ba6c-36bc-9548-c93e6a6b272c",
                                                "text": "Not much virus was detectable on a nucleic acid test; the viral load was very low."
                                            },
                                            {
                                                "example_id": "4e63936f-90cd-48d1-86be-9554e8be5f54",
                                                "sense_id": "7337eecf-ba6c-36bc-9548-c93e6a6b272c",
                                                "text": "Unless professionally inspected, they [plants] may also carry along unseen pests and diseases (particularly small insects and microbes such as virus or bacteria) whose populations might explode catastrophically in new locations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a7d495-ba7f-3650-8055-46742b2e9c0b",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "A disease caused by such an infectious agent; a viral illness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "830ff5bc-4ed9-41b5-b911-145f3507fff3",
                                                "sense_id": "b6a7d495-ba7f-3650-8055-46742b2e9c0b",
                                                "text": "He's got a virus and had to stay home from school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd0baa9e-fb17-31a3-a738-0367c109647c",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "Venom, as produced by a poisonous animal etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d2d854c-5eb0-4130-b3ec-d46b1a319a82",
                                                "sense_id": "dd0baa9e-fb17-31a3-a738-0367c109647c",
                                                "text": "Brazil, that inferno where every budding flower and every buzzing bluebottle fly bears a lascivious virus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fbce515-4731-3df8-a2df-a8e85c8aaf25",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "A type of malware which can covertly transmit itself between computers via networks (especially the Internet) or removable storage such as disks, often causing damage to systems and data; also computer virus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e70db84-9d04-4b4b-aedd-a19a71b8991f",
                                                "sense_id": "8fbce515-4731-3df8-a2df-a8e85c8aaf25",
                                                "text": "Wait a minute! Is this one of those virus emails?!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f4dd8ab-299e-3264-bd6c-b49987b61318",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "Any type of malware."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bbce255-9767-31b8-aa3b-e25332f485e3",
                                        "entry_id": "1da24380-2d1d-3bb0-bc3b-850c7d22c7c6",
                                        "glosses": [
                                            "Any malicious or dangerous entity that spreads from one place or person to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d19e89d-8f4f-4451-91e4-c2afb05aa2cb",
                                                "sense_id": "3bbce255-9767-31b8-aa3b-e25332f485e3",
                                                "text": "I am tired of the mind viruses that are crippling people living in the western world — especially in my own nation. Sadly, Australia is becoming known as a nation of whingers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "virus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c7fdb3-58ff-369c-b4c1-e11be073ca56",
                                        "entry_id": "c617f9b3-a427-3401-970b-9f294a3e64d0",
                                        "glosses": [
                                            "To send or infect an electronic device with a computer virus."
