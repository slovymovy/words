                        "examples": [
                            {
                                "example_id": "4da5e175-6fcb-4630-959a-3a7d63abc06e",
                                "sense_id": "983c3100-96d6-3434-a815-5c54e0083d50",
                                "text": "У рабочих заметна какая-то непоседливость, страсть бродяжить."
                            },
                            {
                                "example_id": "d765620b-0a18-4067-b578-b4f2c0b2ad5c",
                                "sense_id": "983c3100-96d6-3434-a815-5c54e0083d50",
                                "text": "Вот за глаза-то да за буйную непоседливость и любит Мишку отец"
                            },
                            {
                                "example_id": "b76c08ca-d1c8-4aea-af50-f5b674fb2b6a",
                                "sense_id": "983c3100-96d6-3434-a815-5c54e0083d50",
                                "text": "Моя непоседливость и тут доставила много хлопот: на меня опрокинулся чайник с кипятком."
                            }
                        ]
                    }
