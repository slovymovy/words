                                            {
                                                "example_id": "a6c21fce-6654-4c80-a423-e536bde849f1",
                                                "sense_id": "e0d1dd68-01d1-35fe-bb9e-e76ad62114a7",
                                                "text": "– J’ai bien réfléchi. Tout sera consigné par écrit, ainsi il aura confiance en moi. Et de toute manière, la transaction se fera juste dans la foulée."
                                            },
                                            {
                                                "example_id": "99b0ec0b-73fb-424e-8adb-4aa5e004ec02",
                                                "sense_id": "e0d1dd68-01d1-35fe-bb9e-e76ad62114a7",
                                                "text": "La demande doit être formulée par écrit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
