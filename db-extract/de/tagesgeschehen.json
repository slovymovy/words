                        "entry_id": "249f0836-40f5-3cdc-ac19-1962bf8f07c6",
                        "glosses": [
                            "Gesamtheit der Ereignisse der letzten 24 Stunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3754db97-c0b1-4b77-b51e-64b3150a194e",
                                "sense_id": "b13b7a9d-8c11-30c3-b91c-ba4a9c3bcb8d",
                                "text": "„Zum Pastiche zählt etwa das Sampling in der Musik oder die Verwendung von Bildern aus der Popkultur, um das politische Tagesgeschehen zu kommentieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
