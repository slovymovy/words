                "senses": [
                    {
                        "sense_id": "8a10c409-7d1c-3ea5-8b2e-4d83e546539d",
                        "entry_id": "9139c714-3a3a-3598-8ee6-71b64b8cb0a0",
                        "glosses": [
                            "een handeling waarmee je probeert een liefdesrelatie met iemand op te bouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550824e6-0311-4055-ac3a-fc5694c893f6",
                                "sense_id": "8a10c409-7d1c-3ea5-8b2e-4d83e546539d",
                                "text": "Grohl (43), ooit drummer van Nirvana, reageert daarmee op een twitterbericht van Love waarin hij door de zangeres en actrice werd beschuldigd een versierpoging te hebben gedaan bij de 19-jarige dochter."
                            },
                            {
                                "example_id": "a8f9b19e-cb2e-40d1-bf1d-3dbd74879046",
                                "sense_id": "8a10c409-7d1c-3ea5-8b2e-4d83e546539d",
                                "text": ",,Hij gaf me een Tic Tac en boog zich naar voren.\" Overvallen door zijn versierpoging, kon de vrouw zijn zoen niet op tijd ontwijken. Daarna nam hij haar mee naar zijn kantoor waar hij haar vertelde hoe bijzonder ze was en gaf haar zijn telefoonnummer."
                            },
                            {
                                "example_id": "5e51f081-d392-4c4b-bc33-683f6e1758de",
                                "sense_id": "8a10c409-7d1c-3ea5-8b2e-4d83e546539d",
                                "text": "Intussen vindt hij het vreselijk dat uitgerekend de zwakkere partij nergens terechtkan. Ponté: ,,Je zit met een flinterdunne lijn tussen wat wel en niet kan. Wanneer is het een uit de hand gelopen versierpoging en wanneer meer? Maar het moet altijd het slachtoffer zijn dat de grens bepaalt."
                            }
                        ]
                    }
