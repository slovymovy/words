                        "examples": [
                            {
                                "example_id": "7fb71517-dfda-4f34-be06-668ad3e0acac",
                                "sense_id": "898b96f6-eb0b-310f-9fa8-87bed37edefe",
                                "text": "Сереже не хотелось прикармливаться у чужих, чтобы не срамить отца, и он отказался."
                            },
                            {
                                "example_id": "de1e2f6a-93f9-4809-9a7c-a49ce3d01b78",
                                "sense_id": "898b96f6-eb0b-310f-9fa8-87bed37edefe",
                                "text": "За это нам уважение, защита и дозволение от службы прикармливаться – с совестью, конечно, стыд не теряя."
                            }
                        ]
                    }
