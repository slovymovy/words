                "senses": [
                    {
                        "sense_id": "6bc74669-dfde-37ab-9d30-c280756201ff",
                        "entry_id": "a0a83e54-61e5-3dba-89f7-213e9a1716e2",
                        "glosses": [
                            "durch Arrangement von Hochzeiten geformte Allianz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f554efb-f404-4b88-bc98-3d051093efc5",
                                "sense_id": "6bc74669-dfde-37ab-9d30-c280756201ff",
                                "text": "„Ihre mächtigsten Rivalen waren die Vakatakas, die in Zentralindien herrschten. Mit ihnen gingen sie eine Heiratsallianz ein.“"
                            },
                            {
                                "example_id": "e662776e-9640-49ee-92b6-500044168f29",
                                "sense_id": "6bc74669-dfde-37ab-9d30-c280756201ff",
                                "text": "„Der Pir pflegte enge Beziehungen zu allen politischen Lagern - ob Militär, PPP oder PML -, die er über geschickte Bündniswechsel und Heiratsallianzen von Familienangehörigen absicherte.“"
                            },
                            {
                                "example_id": "51a7c5ab-e1cf-4bd8-a3e4-63a060ee84ad",
                                "sense_id": "6bc74669-dfde-37ab-9d30-c280756201ff",
                                "text": "„Seine Macht sicherte er wie für afghanische Verhältnisse typisch über Heiratsallianzen: So hatte er im Laufe seiner Regentschaft sechzehn Frauen aus den führenden Familien geheiratet.“"
                            },
                            {
                                "example_id": "c71a7bfd-88cc-4417-ae93-ac9d828a74e6",
                                "sense_id": "6bc74669-dfde-37ab-9d30-c280756201ff",
                                "text": "„Zum ersten Mal in der Geschichte der Menschheit würden die Machtlinien nicht auf Blutsverwandtschaft und Heiratsallianzen basieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
