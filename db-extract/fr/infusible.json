                "senses": [
                    {
                        "sense_id": "334adaa3-4ee1-36b8-ac8e-b3da36d9d742",
                        "entry_id": "38845d30-df60-311e-9796-e0dffcadc01c",
                        "glosses": [
                            "Qu’on ne peut fondre ; qui n’est pas susceptible de fusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9378f3-9c83-4922-8f0b-f91889f4aee7",
                                "sense_id": "334adaa3-4ee1-36b8-ac8e-b3da36d9d742",
                                "text": "L'amiante est incombustible et infusible; ce qui fait qu'on en fait des étoffes permettant d'être utilisées contre le feu, […]."
                            },
                            {
                                "example_id": "7c1ec9c2-18ea-47da-8722-aa48189b5458",
                                "sense_id": "334adaa3-4ee1-36b8-ac8e-b3da36d9d742",
                                "text": "La porcelaine, cette matière céramique la plus parfaite, résulte de la liaison à une température très élevée, de l’infusible kaolin et du fusible feldspath, en une masse homogène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdcdbd8a-2e54-47ae-b7b8-aa78b0ef3e7c",
                        "source_entry_id": "38845d30-df60-311e-9796-e0dffcadc01c",
                        "source_sense_id": "334adaa3-4ee1-36b8-ac8e-b3da36d9d742",
