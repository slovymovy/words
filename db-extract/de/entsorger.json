                        "examples": [
                            {
                                "example_id": "cdd256f1-e008-419a-80cf-6f30a0ad08ba",
                                "sense_id": "5a3acbd4-632c-3c84-8860-c2fa2849894e",
                                "text": "„Abfälle, um die sich private Entsorger kümmern, tauchten in der kommunalen Statistik überhaupt nicht auf.“"
                            },
                            {
                                "example_id": "af79b245-6001-432b-a963-a4a90564edec",
                                "sense_id": "5a3acbd4-632c-3c84-8860-c2fa2849894e",
                                "text": "„Saprophytisch lebende Großpilze sind, zusammen mit bestimmten Bakterien, die größten Entsorger und Abfallbeseitiger in der Natur, hauptsächlich in den Wäldern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
