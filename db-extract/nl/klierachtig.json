                                            {
                                                "example_id": "841cc526-d7d6-43d5-b0a7-4ac3252fb3fd",
                                                "sense_id": "bfb9bcbc-f965-3886-987f-42947f0dc0b0",
                                                "text": "[…]the almost glandular Russian instinct for adventure and romance."
                                            }
