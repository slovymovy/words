        "ru-extract.jsonl": [
            {
                "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                "word": "хуле",
                "pos": "conj",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "16490664-4f43-4faf-a529-b9a7d9f7bda8",
                        "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                        "tags": [
                            "stressed"
                        ],
                        "form": "ху́ле"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6be39d8d-cf90-3fe1-a91b-5e6f5bd283a0",
                        "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                        "glosses": [
                            "обсц. что, чего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c738efb-0c2f-45ed-96d5-5c0b51d9623f",
                                "sense_id": "6be39d8d-cf90-3fe1-a91b-5e6f5bd283a0",
                                "text": "Как на Киевском вокзале // Пассажира повязали! // Разорался: «Витя, хуле, // Ты приёбся к бедной Юле!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "029384f7-408a-31b7-9a3e-8a8ddf1ed693",
                        "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                        "glosses": [
                            "обсц. что; чего; почему; зачем; с какой целью; какой смысл"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c302608-e55a-4c09-85cc-035094038d97",
                                "sense_id": "029384f7-408a-31b7-9a3e-8a8ddf1ed693",
                                "text": "Злоебуча пиздорванка, — // Хуле блещешь ты умом! // Голова твоя, как срака // Вся наполнена говном!"
                            },
                            {
                                "example_id": "814cdddb-9b86-430c-81a7-c0a826ae438d",
                                "sense_id": "029384f7-408a-31b7-9a3e-8a8ddf1ed693",
                                "text": "Пентам предъявляют то, что они тупо сработали… в нарушение и норм гражданского кодекса и своих внутренних норм и правил… та[к] хуле с [от] них ждать…"
                            }
                        ]
                    },
                    {
                        "sense_id": "18d14fca-34de-313e-a937-0e90ad96b962",
                        "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                        "glosses": [
                            "обсц. что, что толку, нечего"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "252ddf88-974e-38f9-a895-37c2c2a6eac5",
                        "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                        "glosses": [
                            "обсц. а ты как думал, а вы как хотели, а вот так!, ну и что!"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b37aa38b-57a0-4e03-8f1e-c3d6b2678636",
                                "sense_id": "252ddf88-974e-38f9-a895-37c2c2a6eac5",
                                "text": "Я не знаю, как у вас, // А у нас в Стамбуле // Пидор влез на минарет // И кричит: «Ну, хуле!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "ce0bf3e4-e1e6-3ce8-9342-b4a6ce62cd61",
                        "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                        "glosses": [
                            "обсц. что, чего, какого чёрта"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e851f27f-05c2-332d-beae-ebce9591e367",
                        "entry_id": "dea49b93-8387-3c23-9d3f-95060a2a1ac1",
                        "glosses": [
                            "обсц., : ещё бы, что тут скажешь, иначе и быть не может, сам посуди и т. п."
                        ],
                        "tags": [
                            "употребляется в качестве вводного слова"
                        ],
                        "examples": [
                            {
                                "example_id": "d5a00783-c417-42dc-b02f-6cc947c47cb8",
                                "sense_id": "e851f27f-05c2-332d-beae-ebce9591e367",
                                "text": "Лузеры, хуле, не смогли на французскую помойку переехать!"
                            }
                        ]
                    }
                ],
                "translations": [],
