                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49c34fce-4020-308e-b7bd-e0b607cbf880",
                                        "entry_id": "15ce3169-f118-38b5-a051-e91ba8e2cb57",
                                        "glosses": [
                                            "To fasten or bind with a strap."
                                        ],
