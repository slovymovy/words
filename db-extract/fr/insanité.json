                "forms": [
                    {
                        "form_id": "4e6bcc66-eace-4f37-9b21-a304f6ef63a4",
                        "entry_id": "73448ee0-2d28-3fb1-91b0-2d841ee1d536",
                        "tags": [
                            "plural"
                        ],
                        "form": "insanités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "554e36dc-677f-37fa-add0-869fbd6e0530",
                        "entry_id": "73448ee0-2d28-3fb1-91b0-2d841ee1d536",
                        "glosses": [
                            "Action ou parole qui dénote un manque de jugement, de bon sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588e3689-9648-4d18-a05a-132cb899903d",
                                "sense_id": "554e36dc-677f-37fa-add0-869fbd6e0530",
                                "text": "Té! Boudiou! s'écrie notre insupportable voisin qui n’a cessé de dire des insanités et de faire des calembours (et quels calembours, grands dieux!)."
                            },
                            {
                                "example_id": "63f13de0-f660-4ff5-890a-ced5ca5e4638",
                                "sense_id": "554e36dc-677f-37fa-add0-869fbd6e0530",
                                "text": "Une pareille entreprise est une insanité ; aussi aboutit-elle à des équivoques, quand elle n'oblige pas les députés à des attitudes d'une déplorable hypocrisie."
                            },
                            {
                                "example_id": "a011a1dd-eb55-4382-ba15-d8c63f9907db",
                                "sense_id": "554e36dc-677f-37fa-add0-869fbd6e0530",
                                "text": "Ces hypocrites lucides parfaitement conscients de leur duplicité ne soutiennent pas Trump parce qu’ils acceptent ses insanités. Ils le suivent parce qu’ils estiment qu’il sert leurs ambitions et leurs intérêts."
                            }
                        ]
                    },
                    {
                        "sense_id": "89967a00-4335-30b2-b3d6-df07f3d5e495",
                        "entry_id": "73448ee0-2d28-3fb1-91b0-2d841ee1d536",
                        "glosses": [
                            "État d'une personne proche de la folie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04761f89-3d6d-4b77-8b5a-067590cc6e16",
                                "sense_id": "89967a00-4335-30b2-b3d6-df07f3d5e495",
                                "text": "Un fou est pris d’un accès de fureur; il commet des violences graves qui menacent la sécurité publique, la vie de ses proches, ou la sienne. Chacun reconnaît son insanité et la nécessité de l’isolement dans un asile. Le préfet, le maire ou le commissaire de police font alors constater son état mental par un médecin, et le placement d’office, malgré les résistances parfois de la famille, a lieu immédiatement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cf735ff-a368-4737-9ee5-5ad5f75f4782",
                        "source_entry_id": "73448ee0-2d28-3fb1-91b0-2d841ee1d536",
                        "target_lang_word": "Blödelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blödelei",
