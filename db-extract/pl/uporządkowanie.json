                                "example_id": "6d8af841-7896-4a54-85e4-d479390024ac",
                                "sense_id": "ad576e6d-af1b-3ba3-9f19-53abd89f36f9",
                                "text": "Ile zajęło wam uporządkowanie piwnicy i strychu?"
