{
    "word_family": [
        "coil",
        "uncoil"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b7ef9a86-531f-33e0-95d7-f5a144b64495",
                    "sense_definition": "Not in a coiled or wound state; straightened out.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake lay <w>uncoiled</w> on the warm rock in the sun.",
                            "target_lang_translations": {
                                "pl": "Wąż leżał <w>rozwinięty</w> na ciepłej skale w słońcu."
                            }
                        },
                        {
                            "text": "She found the <w>uncoiled</w> rope lying across the garage floor.",
                            "target_lang_translations": {
                                "pl": "Znalazła <w>rozwiniętą</w> linę leżącą na podłodze garażu."
                            }
                        }
                    ],
                    "synonyms": [
                        "straight",
                        "unwound"
                    ],
                    "antonyms": [
                        "coiled",
                        "wound"
                    ],
                    "common_phrases": [
                        "lay uncoiled"
                    ],
                    "target_lang_definitions": {
                        "pl": "Będący w stanie wyprostowanym, niezwinięty w kłębek lub spiralę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwinięty",
                                "target_lang_sense_clarification": "odnosi się do czegoś, co nie jest już zwinięte"
                            },
                            {
                                "target_lang_word": "wyprostowany",
                                "target_lang_sense_clarification": "odnosi się do kształtu, który nie jest już skręcony"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e89117b-83b0-398e-9aab-68770077bc7d",
                    "sense_definition": "Simple past and past participle of <w>uncoil</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spring <w>uncoiled</w> suddenly when the latch was released.",
                            "target_lang_translations": {
                                "pl": "Sprężyna nagle się <w>rozwinęła</w>, gdy zwolniono zatrzask."
                            }
                        },
                        {
                            "text": "He <w>uncoiled</w> the garden hose to water the dry plants.",
                            "target_lang_translations": {
                                "pl": "On <w>rozwinął</w> wąż ogrodowy, aby podlać suche rośliny."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'rozwijać' (coś, co było zwinięte)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwinął",
                                "target_lang_sense_clarification": "forma czasu przeszłego dla rodzaju męskiego"
                            },
                            {
                                "target_lang_word": "rozwinęło",
                                "target_lang_sense_clarification": "forma czasu przeszłego dla rodzaju nijakiego"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}