                    "frequency": "Low",
                    "semantic_group_id": "défaut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son argumentation repose sur un raisonnement <w>défectueux</w> qui fausse ses conclusions."
                        },
                        {
