                "senses": [
                    {
                        "sense_id": "42032229-e35a-3e16-86a2-329bb9191c6f",
                        "entry_id": "1a9014e1-c63c-3328-b321-3fcc39f35776",
                        "glosses": [
                            "Material zur Dämmung/Isolierung aus einem Gefüge von verfilzten Glasfasern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e98d0da-73c8-4369-9422-e8aefd49cfb7",
                                "sense_id": "42032229-e35a-3e16-86a2-329bb9191c6f",
                                "text": "„Das aufgeschliffene Röhrchen wird mit fein gekörntem Calciumchlorid gefüllt, das durch Glaswolle am Herausfallen verhindert wird; das Calciumchlorid ist nach etwa acht Verbrennungen zu erneuern.“"
                            },
                            {
                                "example_id": "d4877b81-cd42-400c-899f-4ab4c02a5625",
                                "sense_id": "42032229-e35a-3e16-86a2-329bb9191c6f",
                                "text": "„Die sich bei Gegenwart von Quecksilber schwarz färbende Glaswolle schiebt man in die Mitte des Glasrohres zusammen und zieht die beiden Röhrenden aus.“"
                            },
                            {
                                "example_id": "7c6540d9-9391-43b5-9dea-36f706a0f37b",
                                "sense_id": "42032229-e35a-3e16-86a2-329bb9191c6f",
                                "text": "„Die Glaswolle wird in eine saure Lösung von Kaliumpermanganat von bekannter Konzentration gebracht und unmittelbar darauf mittels Pipette ein aliquoter Teil entnommen und titriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
