{
    "word_family": [
        "ferocity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8980a1be-27b2-33f7-8d8b-6349314f3e92",
                    "sense_definition": "Marked by extreme and violent energy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ferocious</w> storm destroyed many houses in the small coastal village.",
                            "target_lang_translations": {
                                "pl": "<w>Gwałtowna</w> burza zniszczyła wiele domów w małej nadmorskiej wiosce."
                            }
                        },
                        {
                            "text": "The team played with <w>ferocious</w> energy to win the championship game.",
                            "target_lang_translations": {
                                "pl": "Drużyna grała z <w>nieposkromioną</w> energią, aby wygrać mecz o mistrzostwo."
                            }
                        }
                    ],
                    "synonyms": [
                        "fierce"
                    ],
                    "common_phrases": [
                        "ferocious attack",
                        "ferocious storm"
                    ],
                    "target_lang_definitions": {
                        "pl": "Cechujący się skrajną, gwałtowną i dziką siłą lub energią."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gwałtowny",
                                "target_lang_sense_clarification": "o żywiołach, energii lub ataku"
                            },
                            {
                                "target_lang_word": "wściekły",
                                "target_lang_sense_clarification": "pełen furii, nieposkromiony"
                            },
                            {
                                "target_lang_word": "dziki",
                                "target_lang_sense_clarification": "nieokiełznany, groźny"
                            },
                            {
                                "target_lang_word": "brutalny",
                                "target_lang_sense_clarification": "działający z niszczycielską siłą"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98436307-9f7a-360b-9a17-e11e985d549c",
                    "sense_definition": "Extreme or intense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was <w>ferocious</w> competition for the few available jobs in the city.",
                            "target_lang_translations": {
                                "pl": "O te nieliczne dostępne miejsca pracy w mieście toczyła się <w>zaciekła</w> konkurencja."
                            }
                        },
                        {
                            "text": "The athlete faced <w>ferocious</w> criticism after losing the final match.",
                            "target_lang_translations": {
                                "pl": "Sportowiec spotkał się z <w>miażdżącą</w> krytyką po przegraniu meczu finałowego."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ferocious competition",
                        "ferocious heat"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niezwykle intensywny, zacięty lub skrajny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zaciekły",
                                "target_lang_sense_clarification": "o rywalizacji, walce, sporze"
                            },
                            {
                                "target_lang_word": "zażarty",
                                "target_lang_sense_clarification": "o konkurencji, dyskusji"
                            },
                            {
                                "target_lang_word": "miażdżący",
                                "target_lang_sense_clarification": "o krytyce"
                            },
                            {
                                "target_lang_word": "piekielny",
                                "target_lang_sense_clarification": "o upale, bólu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
