{
    "word_family": [
        "attrape",
        "attrapeur",
        "rattrapage",
        "rattraper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9889cbaa-2039-3a20-a29a-5bbd6dcbf3c4",
                    "sense_definition": "Saisir un objet au vol, au passage ou le prendre rapidement avec la main.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "capture_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a couru très vite pour <w>attraper</w> la balle avant qu'elle ne tombe."
                        },
                        {
                            "text": "Il a tendu le bras pour <w>attraper</w> au vol les clés de la maison."
                        }
                    ],
                    "synonyms": [
                        "prendre",
                        "saisir"
                    ],
                    "common_phrases": [
                        "attraper la balle",
                        "attraper au vol"
                    ]
                },
                {
                    "sense_id": "bf5f8faa-b9e9-3b7c-b93e-d7bcd5d2d50d",
                    "sense_definition": "Contracter une maladie ou être atteint par une infection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maladie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mets ton manteau chaud si tu ne veux pas <w>attraper</w> un rhume dehors."
                        },
                        {
                            "text": "Plusieurs élèves de cette classe ont fini par <w>attraper</w> la grippe cet hiver."
                        }
                    ],
                    "synonyms": [
                        "contracter"
                    ],
                    "common_phrases": [
                        "attraper froid",
                        "attraper un rhume"
                    ]
                },
                {
                    "sense_id": "0f37d3a0-b8be-3346-84ba-6d8093bf8b68",
                    "sense_definition": "Prendre un animal à l'aide d'un piège ou d'un engin prévu à cet effet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "capture_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier a posé une boîte grillagée afin d'<w>attraper</w> une souris dans la grange."
                        },
                        {
                            "text": "Le renard rusé ne s'est pas laissé <w>attraper</w> au piège tendu par le chasseur."
                        }
                    ],
                    "synonyms": [
                        "piéger"
                    ],
                    "common_phrases": [
                        "attraper au piège",
                        "attraper une souris"
                    ]
                },
                {
                    "sense_id": "2cc5726f-1e15-30d5-b3ae-8d43fd887993",
                    "sense_definition": "Surprendre une personne sur le fait dans une action coupable ou cachée.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "surprendre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur l'a <w>attrapé</w> en train de regarder ses notes pendant le contrôle."
                        },
                        {
                            "text": "Que je ne vous y <w>attrape</w> plus à fouiller dans mes tiroirs sans autorisation !"
                        }
                    ],
                    "common_phrases": [
                        "attraper sur le fait"
                    ]
                },
                {
                    "sense_id": "8ac885c7-f69f-328e-afcf-5d35e8aa3297",
                    "sense_definition": "Tromper ou duper quelqu'un par ruse, malice ou artifice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tromper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce faux démarcheur a réussi à <w>attraper</w> plusieurs personnes âgées dans le quartier."
                        },
                        {
                            "text": "Fais bien attention avec ce contrat douteux pour ne pas te faire <w>attraper</w>."
                        }
                    ],
                    "common_phrases": [
                        "se faire attraper"
                    ]
                },
                {
                    "sense_id": "971cb3a4-ac8f-36cf-aa56-bfb44727f0ef",
                    "sense_definition": "Réprimander ou gourmander sévèrement quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reprimande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme s'est fait sévèrement <w>attraper</w> par ses parents pour son comportement."
                        },
                        {
                            "text": "Le directeur va t'<w>attraper</w> si tu oublies encore d'éteindre les ordinateurs le soir."
                        }
                    ],
                    "common_phrases": [
                        "se faire attraper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        }
    ]
}