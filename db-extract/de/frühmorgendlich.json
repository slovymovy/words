                ],
                "senses": [
                    {
                        "sense_id": "28e87634-c532-3f34-8eb6-c39a4fb36044",
                        "entry_id": "0918d1b5-9400-361d-a17d-90dbc14cd65e",
                        "glosses": [
                            "in die Zeit am frühen Morgen fallend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f650f95c-3f6f-4e6f-9410-7b9dc662629a",
                                "sense_id": "28e87634-c532-3f34-8eb6-c39a4fb36044",
                                "text": "„Dann gingen sie durch. Rannten aus dem Stand mit Höchstgeschwindigkeit hinaus auf den Barrial, während der langgezogene Knall des Büchsenschusses in der frühmorgendlichen Einsamkeit hinter ihnen herrollte, von den Felsen hin- und hergeworfen wurde und über das offene Land zurückhallte.“"
                            },
                            {
                                "example_id": "5e46c096-fc3a-4188-b70d-3baf46612ab3",
                                "sense_id": "28e87634-c532-3f34-8eb6-c39a4fb36044",
                                "text": "„Wann immer er erfuhr, dass ein Altepetl in der Umgebung Abgesandte aus Tenochtitlan empfangen hatte, versammelte er seine Reiter zu einem seiner berüchtigten frühmorgendlichen Überfälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
