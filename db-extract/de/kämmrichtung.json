                "senses": [
                    {
                        "sense_id": "8d15de7c-3c55-3ad3-95d5-f15b214e2e28",
                        "entry_id": "9443ab48-33b4-3f22-a78f-3995211a9934",
                        "glosses": [
                            "diejenige Richtung, die sich besonders gut für das Durchführen eines Kamms/einer Bürste durch Haar(e) eignet, weil der Wuchs der einzelnen Haare dies leicht macht oder diese Richtung über lange Zeit bevorzugt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83e6180f-5a3d-4f40-bd7f-c920db3b4157",
                                "sense_id": "8d15de7c-3c55-3ad3-95d5-f15b214e2e28",
                                "text": "„Die Kämmrichtung beginnt, anders als beim Kleinkind, an der von der Kopfhaut entferntesten Stelle.“"
                            },
                            {
                                "example_id": "adb79d8e-2a82-4c79-8ac4-2d751462e471",
                                "sense_id": "8d15de7c-3c55-3ad3-95d5-f15b214e2e28",
                                "text": "„Artig ändert Clara ihre Kämmrichtung.“"
                            },
                            {
                                "example_id": "650d8b2e-d7a6-4d55-bb60-01ac0c0a47b9",
                                "sense_id": "8d15de7c-3c55-3ad3-95d5-f15b214e2e28",
                                "text": "„An den Seiten und im Nacken wird das Haar in liegenden Papilloten eingelegt (Kämmrichtung beachten!), am Oberkopf verwendet man entweder stehende Papillotenmit hochgeführtem Ansatz oder Flachwellwickler.“"
                            },
                            {
                                "example_id": "37d8d10f-04e1-4e9f-9d11-0a06e9736449",
                                "sense_id": "8d15de7c-3c55-3ad3-95d5-f15b214e2e28",
                                "text": "„Sein Haar ist durch feine, silbergrau gezeichnete Linien betont, welche die Kämmrichtung andeuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
