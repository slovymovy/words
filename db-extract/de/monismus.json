                    },
                    {
                        "translation_id": "fc3b4c20-116a-417f-bdee-7a6a26e58b59",
                        "source_entry_id": "f616aebb-b8f3-3869-b46b-0fad1e28b3ab",
                        "source_sense_id": "f362b7bb-761e-3bc0-98d9-bdb3c4f1b293",
                        "target_lang_word": "monism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfeea0cb-e4df-382b-a2e5-79d85acf368c",
                                        "entry_id": "f4bb75d6-28ec-3ca2-8af2-e125e323c631",
                                        "glosses": [
                                            "The doctrine of the oneness and unity of reality, despite the appearance of diversity in the world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cb5e25c-7da8-365d-8d7c-2b2bfdb0bfef",
                                        "entry_id": "f4bb75d6-28ec-3ca2-8af2-e125e323c631",
                                        "glosses": [
                                            "The doctrine that there is a single source of political authority, especially that the church is subordinate to the state or vice versa."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b271ee-08aa-429d-8e91-f08e6afc4bbb",
                                                "sense_id": "2cb5e25c-7da8-365d-8d7c-2b2bfdb0bfef",
                                                "text": "The same conflict between the monism of temporal theorists and the dualism of ecclesiastical thinkers—the same opposition of organic to symbiotic union—occurred in the ninth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3ea4e9a-e57a-3689-b9a0-510ae2977ee6",
                                        "entry_id": "f4bb75d6-28ec-3ca2-8af2-e125e323c631",
                                        "glosses": [
                                            "The legal doctrine that international law forms part of domestic law automatically after ratification or accession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcb98714-a007-475c-b89d-ebc87f5fa7cd",
                        "source_entry_id": "f616aebb-b8f3-3869-b46b-0fad1e28b3ab",
                        "source_sense_id": "f362b7bb-761e-3bc0-98d9-bdb3c4f1b293",
                        "target_lang_word": "monisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                                        "entry_id": "718475ad-40f2-3592-be64-5028234423df",
                                        "glosses": [
                                            "Doctrine qui explique tout l’univers, choses et êtres, par les transformations d’un élément unique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691ebac7-63b9-4bab-8a34-a552e14240c4",
                                                "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                                                "text": "Non seulement on n'a jamais fourni aucune explication mécanique valable des phénomènes vitaux, mais le problème de l'origine des êtres vivants, que le monisme prétend avoir résolu, reste aussi impénétrable qu'auparavant."
                                            },
                                            {
                                                "example_id": "3123e44e-8eeb-45a6-82a5-eaad8643da54",
                                                "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                                                "text": "Toute la métaphysique d'Aristote est conditionnée par la nécessité d'échapper au monisme du Père des Métaphysiciens, de Parménide."
                                            },
                                            {
                                                "example_id": "66f30429-3b44-4cdd-9b01-4be1b4ebfb45",
                                                "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                                                "text": "Le monisme vitaliste s'est forgé dans un contexte de proximité où l'être humain se découvre dans une relation étroite à lui-même et à son environnement. Dans cet univers restreint, la vie paraît être le principe fondamental et la condition naturelle et primitive de toute chose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
