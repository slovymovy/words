                    "frequency": "High",
                    "semantic_group_id": "nadruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <w>werkelijk</w> geen idee waar mijn sleutels zijn gebleven.",
                            "target_lang_translations": {
