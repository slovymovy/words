                        "entry_id": "3548505f-5270-3b23-ba6f-4e453e98adfe",
                        "glosses": [
                            "A humorous play on words; such plays on words collectively."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb3787bc-b25e-4b26-ba6b-816377a7bd43",
                                "sense_id": "c31606de-0634-3c41-a280-89c5595536b7",
                                "text": "Even this modest wordplay was an outlier: Sagers counted only three backronyms across the ’70s and ’80s."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0c0672b-6ff6-3de6-90f9-14c93effc5a0",
                        "entry_id": "3548505f-5270-3b23-ba6f-4e453e98adfe",
                        "glosses": [
                            "A witty verbal exchange; such exchanges collectively."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "138cddec-4b50-31ed-b12e-7b3f27452b1e",
                        "entry_id": "3548505f-5270-3b23-ba6f-4e453e98adfe",
                        "glosses": [
                            "The part of a cryptic clue that indicates but does not define the solution."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c038303-ed1d-4543-bcae-a4c4609c5c4d",
                                "sense_id": "138cddec-4b50-31ed-b12e-7b3f27452b1e",
                                "text": "delete the T from another part in the wordplay"
                            },
                            {
                                "example_id": "f2b3d8b5-4eac-49ef-b1fb-2c16719f5286",
                                "sense_id": "138cddec-4b50-31ed-b12e-7b3f27452b1e",
                                "text": "However, some clues include words that do not form part of the wordplay or the definition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e7a2a37-b31e-4e4d-a8e8-d30523ced730",
                        "source_entry_id": "3548505f-5270-3b23-ba6f-4e453e98adfe",
                        "source_sense_description": "humorous play on words",
                        "target_lang_word": "jeu de mots",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeu de mots",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21dcb3f2-25d0-3d6e-b39f-d91f8eb9343a",
                                        "entry_id": "be185ab3-df2f-3c06-adb6-0059d6b4f26b",
                                        "glosses": [
                                            "Manipulation plaisante des mots fondée sur la ressemblance des mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2676f5b-9553-4ee9-8de0-f699ca46e859",
                                                "sense_id": "21dcb3f2-25d0-3d6e-b39f-d91f8eb9343a",
                                                "text": "Lorsque la finesse d’une saillie ne consiste pas dans une équivoque, mais dans une idée ingénieuse, exprimée avec précision, ce n’est plus un jeu de mots ; c’est véritablement un bon mot."
                                            },
                                            {
                                                "example_id": "4951aba0-b5d1-4a4f-9a10-1ac2f44c2c4e",
                                                "sense_id": "21dcb3f2-25d0-3d6e-b39f-d91f8eb9343a",
                                                "text": "Il y est question de mes oraisons, de mes répétitions, de mes contradictions, de ma prose, de mes jeux de mots, du malheur de ceux qui sont contraints de m’entendre, de mes insinuations, de mes attaques contre les lithotriteurs, etc., mais des objections que je lui ai faites, pas un mot."
                                            },
                                            {
                                                "example_id": "ba87b079-8ed2-4450-bc7e-92d36f62af13",
                                                "sense_id": "21dcb3f2-25d0-3d6e-b39f-d91f8eb9343a",
                                                "text": "Les savoureux jeux de mots sont déclinés en cartes postales, tee-shirts et casquettes : « Rodin des Bois », « Complètement Miró », « Le Titien à sa mémère », « À Bruxelles, il ne pleut jamais mais qu’est-ce qu'il drache », « Oui, mais non » à dégoter au BOZAR SHOP."
                                            },
                                            {
                                                "example_id": "e5892df2-4718-4df7-a521-9b6b48a0fe44",
                                                "sense_id": "21dcb3f2-25d0-3d6e-b39f-d91f8eb9343a",
                                                "text": "[…] un jour il se vexa horriblement parce que je partis d’un irrépressible éclat de rire devant son air sérieux tandis qu’il me racontait les prouesses de certains maréchaux de Napoléon et me décrivait, sans prendre garde à l’involontaire jeu de mots qu’il faisait, comment, dans l’église du Vatican et sans hésiter, Lannes était entré à cheval."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17740872-b5cb-4af8-9d2c-a5ae2f7a85e0",
                        "source_entry_id": "3548505f-5270-3b23-ba6f-4e453e98adfe",
                        "source_sense_description": "humorous play on words",
                        "target_lang_word": "Wortspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                        "entry_id": "5e74d537-8cd5-3fcf-8e8c-7d9ff37403c5",
                                        "glosses": [
                                            "witziges Spiel mit Worten, z. B. mit deren Mehrdeutigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dceafc35-e6dd-4a0c-a7dd-9ad5f9ea770a",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "Wortspiele sind selten in andere Sprachen übersetzbar."
                                            },
                                            {
                                                "example_id": "82d9accb-2c25-4a4b-b630-f9cacaa52e5f",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Womöglich erklärt sich die Beliebtheit des Wortspiels in diesem Fall schon durch seine auffallende Schlichtheit, die jedem Grundschulkind erlauben dürfte, es mühelos zu verstehen.“"
                                            },
                                            {
                                                "example_id": "72e72d28-f379-4fa7-abba-bf4dc824b50a",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Man hat in angelsächsischen Ländern einen besonderen Sinn für Wortspiele, sogenannte ‚puns‘, und macht sich seit jeher einen Spaß daraus, immer neue Abkürzungen zu erfinden…“"
                                            },
                                            {
                                                "example_id": "f33fdc48-cb6f-438e-b20e-c778881306df",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Auch ein wortspielender Satz wirkt kläglich, wenn er nur des Wortspiels wegen geschrieben wurde.“"
                                            },
                                            {
                                                "example_id": "dbc8ee82-f9ff-4b18-b771-36822acc2eb9",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Um die Gründung Warschaus rankt sich eine Legende, die auf einem Wortspiel beruht.“"
                                            },
                                            {
                                                "example_id": "68c809f2-7593-4a75-8d79-d58619e06a4d",
                                                "sense_id": "ab1310fc-5d7e-3594-819b-02dee4e26b83",
                                                "text": "„Allerdings gehen die Kalenberger Späße und Possen keineswegs auf ›calembours‹ oder Wortspiele hinaus, und so ist diese Etymologie auch wieder bestritten worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
