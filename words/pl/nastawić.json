{
    "word_family": [
        "stawiać",
        "nastawiać",
        "nastawienie",
        "nastawnia",
        "nastawnik"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "deb3a981-932b-30a9-abda-31a6d073e5b4",
                    "sense_definition": "postawić naczynie z płynem lub potrawą na ogniu lub włączyć urządzenie w celu gotowania",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gotowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę, <w>nastaw</w> wodę na herbatę, zanim przyjdą nasi goście.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>поставь</w> воду для чая, пока не пришли наши гости."
                            }
                        },
                        {
                            "text": "Mama <w>nastawiła</w> zupę na małym ogniu i poszła do ogrodu.",
                            "target_lang_translations": {
                                "ru": "Мама <w>поставила</w> суп на медленный огонь и пошла в сад."
                            }
                        }
                    ],
                    "antonyms": [
                        "zdjąć"
                    ],
                    "common_phrases": [
                        "nastawić wodę na herbatę",
                        "nastawić pranie"
                    ],
                    "target_lang_definitions": {
                        "ru": "поставить посуду с жидкостью или едой на огонь или включить прибор для готовки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставить",
                                "target_lang_sense_clarification": "чайник, кастрюлю на огонь или плиту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a7f149d-4207-3694-8863-faa7d77b3330",
                    "sense_definition": "wyregulować urządzenie, wybierając odpowiednie parametry lub czas działania",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "urządzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>nastawić</w> budzik na siódmą rano, żeby nie spóźnić się do pracy.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>завести</w> будильник на семь утра, чтобы не опоздать на работу."
                            }
                        },
                        {
                            "text": "Wieczorem <w>nastawiłem</w> piekarnik na sto osiemdziesiąt stopni, aby upiec ciasto.",
                            "target_lang_translations": {
                                "ru": "Вечером я <w>установил</w> духовку на сто восемьдесят градусов, чтобы испечь пирог."
                            }
                        }
                    ],
                    "synonyms": [
                        "ustawić"
                    ],
                    "common_phrases": [
                        "nastawić budzik",
                        "nastawić radio"
                    ],
                    "target_lang_definitions": {
                        "ru": "отрегулировать прибор, выбрав нужные параметры или время работы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завести",
                                "target_lang_sense_clarification": "будильник"
                            },
                            {
                                "target_lang_word": "поставить",
                                "target_lang_sense_clarification": "будильник, таймер"
                            },
                            {
                                "target_lang_word": "настроить",
                                "target_lang_sense_clarification": "радио, прибор на определенный режим"
                            },
                            {
                                "target_lang_word": "установить",
                                "target_lang_sense_clarification": "температуру, параметры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4321213b-6f2d-3fb0-9df0-535dc0baa782",
                    "sense_definition": "uruchomić urządzenie elektryczne lub odtworzyć nagranie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "urządzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiad <w>nastawił</w> głośną muzykę i nie pozwala nikomu zasnąć.",
                            "target_lang_translations": {
                                "ru": "Сосед <w>включил</w> громкую музыку и не даёт никому уснуть."
                            }
                        },
                        {
                            "text": "Po powrocie z pracy od razu <w>nastawiła</w> pralkę pełną ubrań.",
                            "target_lang_translations": {
                                "ru": "Вернувшись с работы, она сразу же <w>запустила</w> полную белья стиральную машину."
                            }
                        }
                    ],
                    "antonyms": [
                        "wyłączyć"
                    ],
                    "common_phrases": [
                        "nastawić płytę",
                        "nastawić pralkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "запустить электроприбор или включить воспроизведение записи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включить",
                                "target_lang_sense_clarification": "музыку, прибор"
                            },
                            {
                                "target_lang_word": "поставить",
                                "target_lang_sense_clarification": "пластинку, музыку"
                            },
                            {
                                "target_lang_word": "запустить",
                                "target_lang_sense_clarification": "стиральную машину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "558b5799-8b78-368c-b787-53bd18d10af8",
                    "sense_definition": "wywołać u kogoś określony stosunek emocjonalny lub przygotować psychicznie na coś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fałszywe plotki <w>nastawiły</w> go wrogo do nowych kolegów z klasy.",
                            "target_lang_translations": {
                                "ru": "Ложные сплетни <w>настроили</w> его враждебно по отношению к новым одноклассникам."
                            }
                        },
                        {
                            "text": "Trener pozytywnie <w>nastawił</w> zawodników przed decydującym meczem turnieju.",
                            "target_lang_translations": {
                                "ru": "Тренер позитивно <w>настроил</w> игроков перед решающим матчем турнира."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nastawić kogoś wrogo",
                        "nastawić kogoś pozytywnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызвать у кого-либо определенное эмоциональное отношение или подготовить психологически к чему-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настроить",
                                "target_lang_sense_clarification": "психологически, к кому-то или чему-то"
                            },
                            {
                                "target_lang_word": "расположить",
                                "target_lang_sense_clarification": "к себе или к другим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80cbbf6b-ec27-3d21-a239-b784917f6f11",
                    "sense_definition": "przywrócić złamaną lub zwichniętą kość do właściwego położenia anatomicznego",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doświadczony lekarz szybko <w>nastawił</w> zwichnięty bark poszkodowanego narciarza.",
                            "target_lang_translations": {
                                "ru": "Опытный врач быстро <w>вправил</w> вывихнутое плечо пострадавшего лыжника."
                            }
                        },
                        {
                            "text": "W szpitalu chirurg <w>nastawił</w> kość i założył pacjentowi gips na sześć tygodni.",
                            "target_lang_translations": {
                                "ru": "В больнице хирург <w>вправил</w> кость и наложил пациенту гипс на шесть недель."
                            }
                        }
                    ],
                    "synonyms": [
                        "zestawić"
                    ],
                    "common_phrases": [
                        "nastawić zwichnięty bark",
                        "nastawić złamaną kość"
                    ],
                    "target_lang_definitions": {
                        "ru": "вернуть сломанную или вывихнутую кость в правильное анатомическое положение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вправить",
                                "target_lang_sense_clarification": "кость, вывих"
                            },
                            {
                                "target_lang_word": "сопоставить",
                                "target_lang_sense_clarification": "отломки кости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdff2e18-ef53-3375-a3b3-c9bd32de1269",
                    "sense_definition": "skierować lub obrócić część ciała, antenę lub przedmiot w określonym kierunku",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kierunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pies nagle zaszczekał i czujnie <w>nastawił</w> uszy na dźwięk kroków za drzwiami.",
                            "target_lang_translations": {
                                "ru": "Собака вдруг залаяла и настороженно <w>навострила</w> уши при звуке шагов за дверью."
                            }
                        },
                        {
                            "text": "Turysta <w>nastawił</w> twarz ku ciepłym promieniom wiosennego słońca.",
                            "target_lang_translations": {
                                "ru": "Турист <w>подставил</w> лицо теплым лучам весеннего солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwrócić w jakimś kierunku"
                    ],
                    "common_phrases": [
                        "nastawić uszu",
                        "nastawić ucha"
                    ],
                    "target_lang_definitions": {
                        "ru": "направить или повернуть часть тела, антенну или предмет в определенном направлении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насторожить",
                                "target_lang_sense_clarification": "уши"
                            },
                            {
                                "target_lang_word": "навострить",
                                "target_lang_sense_clarification": "уши"
                            },
                            {
                                "target_lang_word": "подставить",
                                "target_lang_sense_clarification": "лицо, ладонь навстречу чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}