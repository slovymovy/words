{
    "word_family": [
        "perplex",
        "perplexity",
        "perplexingly",
        "perplexedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ef4220d-8fd4-3723-a918-c356584db851",
                    "sense_definition": "Completely baffling or difficult to understand; causing confusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "causing_confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective faced a <w>perplexing</w> mystery that had no clear clues.",
                            "target_lang_translations": {
                                "es": "El detective se enfrentó a un misterio <w>desconcertante</w> que no tenía pistas claras."
                            }
                        },
                        {
                            "text": "She found the computer's error message utterly <w>perplexing</w>.",
                            "target_lang_translations": {
                                "es": "El mensaje de error del ordenador le pareció totalmente <w>desconcertante</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "baffling",
                        "bewildering",
                        "confusing",
                        "puzzling"
                    ],
                    "common_phrases": [
                        "perplexing problem",
                        "perplexing question",
                        "utterly perplexing"
                    ],
                    "target_lang_definitions": {
                        "es": "Completamente desconcertante o difícil de entender; que causa confusión o perplejidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desconcertante",
                                "target_lang_sense_clarification": "que confunde o desorienta"
                            },
                            {
                                "target_lang_word": "perplejo",
                                "target_lang_sense_clarification": "usado en ocasiones como adjetivo para situaciones confusas"
                            },
                            {
                                "target_lang_word": "enigmático",
                                "target_lang_sense_clarification": "difícil de comprender o explicar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "381b9438-33d0-37d7-8839-ea2915a3a940",
                    "sense_definition": "present participle and gerund of <w>perplex</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "causing_confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden change of plans is <w>perplexing</w> everyone in the office.",
                            "target_lang_translations": {
                                "es": "Su repentino cambio de planes está <w>desconcertando</w> a todos en la oficina."
                            }
                        },
                        {
                            "text": "The scientist kept <w>perplexing</w> the audience by using overly technical terms.",
                            "target_lang_translations": {
                                "es": "El científico siguió <w>confundiendo</w> a la audiencia al usar términos excesivamente técnicos."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma en gerundio o participio presente de 'perplex'; desconcertando, confundiendo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desconcertando",
                                "target_lang_sense_clarification": "gerundio del verbo desconcertar"
                            },
                            {
                                "target_lang_word": "confundiendo",
                                "target_lang_sense_clarification": "gerundio del verbo confundir"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}