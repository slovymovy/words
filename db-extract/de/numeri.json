                                    {
                                        "sense_id": "a274e347-e499-3915-8122-8f433b562f63",
                                        "entry_id": "5e634a45-a0be-3144-9e5d-edb9a4ca349a",
                                        "glosses": [
                                            "The Book of Numbers, the fourth of the Books of Moses in the Old Testament of the Bible, the fourth book in the Torah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f5a4fa-82c5-4e5f-ab56-1b873e948b44",
                                                "sense_id": "a274e347-e499-3915-8122-8f433b562f63",
                                                "text": "For in the book of Numbers is it writ,\nWhen the man dies, let the inheritance\nDescend unto the daughter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbad333d-a667-45f0-8b2d-6237456c70e0",
                        "source_entry_id": "80be8b40-8c1a-3be3-b866-d9cc2e56d6d4",
                        "source_sense_id": "2437b07e-9f4f-3627-8956-cc1bbe5ffc7e",
