                "senses": [
                    {
                        "sense_id": "0797a460-329d-3b6f-af6e-bd9970bcd052",
                        "entry_id": "63815cf0-1d50-3dc3-9bb6-5ef14cc32c43",
                        "glosses": [
                            "speciale kruk voor het in zittende houding baren van een kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b20f7d-d38f-42d5-a3a0-914ec798881a",
                                "sense_id": "0797a460-329d-3b6f-af6e-bd9970bcd052",
                                "text": "Op een baarkruk bevallen is voor vrouwen die echt last hebben van schaamte misschien ook een fijn idee: zo lig je niet met je benen wijd te kijk."
                            },
                            {
                                "example_id": "3b6e2a55-b6cb-439e-9ed7-1713f57dcc88",
                                "sense_id": "0797a460-329d-3b6f-af6e-bd9970bcd052",
                                "text": ",,Laat je een vrouw vrij bewegen tijdens de bevalling, dan zal zij instinctief vaak op haar handen en knieën, op de baarkruk of gehurkt bevallen. Zo is het bekken meer open en helpt de zwaartekracht een handje mee. Als je het echter fijn vindt om op je rug of op je zij te bevallen in bed: daar is ook niks mis mee, zolang het maar voor jou goed voelt.”"
                            }
                        ]
                    }
