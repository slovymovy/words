                                "sense_id": "81ac151e-80f0-3629-91ec-abff15e6742d",
                                "text": "On the journey southwards over the flat, fertile plains, paddy fields stretched away on each side of the line, and the landscape was broken only by wooden villages and stately pagodas."
                            },
                            {
                                "example_id": "1c4b318d-1fd4-418a-bd25-3eafea1be296",
                                "sense_id": "81ac151e-80f0-3629-91ec-abff15e6742d",
                                "text": "Although [John] Peel's grave is the main attraction, Caldbeck is a captivating little village in its own right, with fine views southwards to the Lake District's serried peaks."
                            }
                        ]
                    }
