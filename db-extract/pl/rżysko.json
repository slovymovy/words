                "senses": [
                    {
                        "sense_id": "ea7ee193-be28-364d-b275-2f8d5f8b0a0c",
                        "entry_id": "7ca5f447-8708-39f7-88d2-1ab4b93a16c0",
                        "glosses": [
                            "pole po skoszeniu rosnącego na nim zboża"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "426ae80e-6aa2-44e5-85a5-bf49e12e97f2",
                        "source_entry_id": "7ca5f447-8708-39f7-88d2-1ab4b93a16c0",
                        "source_sense_id": "ea7ee193-be28-364d-b275-2f8d5f8b0a0c",
                        "target_lang_word": "Stoppelfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoppelfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                        "entry_id": "b037cbc8-dfc0-3947-a52d-1370ac96deb2",
                                        "glosses": [
                                            "abgeerntetes Getreidefeld, auf dem noch die kurzen Strünke der Pflanzen stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34647dd-77d5-4cb9-9e3c-83b78fb353e5",
                                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                                "text": "„Ein Mann, klein, kräftig, in einer braunen Jacke, läuft über ein Stoppelfeld.“"
                                            },
                                            {
                                                "example_id": "40fa8a50-22da-43e4-99bd-7d1f54fc2575",
                                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                                "text": "„In Jorate gingen die Sensen durchs Korn, die weißen Tücher der Binderinnen hoben und senkten sich, auf den Stoppelfeldern sammelten sich die Störche.“"
                                            },
                                            {
                                                "example_id": "d74d17b3-77dd-4332-a803-2d4bcb359c28",
                                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                                "text": "„In dem Augenblick, in welchem sie nach der allgemeinen Erwartung den Hasen packen musste, schlug er wieder einen Haken und sprang auf den Grenzrain zwischen der Wintersaat und dem Stoppelfelde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb33a2c3-003a-4158-963e-fe16f36f9717",
                        "source_entry_id": "7ca5f447-8708-39f7-88d2-1ab4b93a16c0",
                        "source_sense_id": "ea7ee193-be28-364d-b275-2f8d5f8b0a0c",
                        "target_lang_word": "стерня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стерня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "21293ea9-491e-3d3c-bc13-5de3f70415bc",
                                        "entry_id": "3feb0634-eb12-3182-81c9-fab3fb5667e3",
                                        "glosses": [
                                            "остатки (нижняя часть) стеблей злаков (зерновых культур) после уборки урожая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afc0d9eb-309e-401c-b726-c0793d7e4350",
                                                "sense_id": "21293ea9-491e-3d3c-bc13-5de3f70415bc",
                                                "text": "Я бежал, стерня шелестела под ногами, мне казалось, что все змеи собрались, шипят, гонятся за мной и вот-вот догонят."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ab22205-4b0b-40de-b9d2-8fe283af3825",
                        "source_entry_id": "7ca5f447-8708-39f7-88d2-1ab4b93a16c0",
                        "source_sense_id": "ea7ee193-be28-364d-b275-2f8d5f8b0a0c",
                        "target_lang_word": "жнивьё",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жнивьё",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "370ed42b-6fb3-3379-b815-40f7c7465f61",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "поле, на котором сжата рожь, пшеница или другие зерновые"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5f0dcf6-8fc8-4e26-acc7-bb6d2e27a97f",
                                                "sense_id": "370ed42b-6fb3-3379-b815-40f7c7465f61",
                                                "text": "Налево от шоссе тянулось потемневшее жнивьё, и только на бугристом и близком горизонте одинокими купами поднимались невысокие разрозненные деревья и кусты."
                                            },
                                            {
                                                "example_id": "dc5dad4d-acfd-4721-847b-21442efcb380",
                                                "sense_id": "370ed42b-6fb3-3379-b815-40f7c7465f61",
                                                "text": "Туча окинула взглядом низкие запёкшиеся жнивья. Они стлались до самого горизонта. Туча легко вскинулась на дыбы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73306d6d-0ec5-347a-8b25-f649f76ca873",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "рег. солома, оставшаяся на корню после жатвы; стерня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0b2273-44cd-43d9-a6fe-7bd4f78446d6",
                                                "sense_id": "73306d6d-0ec5-347a-8b25-f649f76ca873",
                                                "text": "У Прокудинского загона Степанова жена сошла и понесла свои кувшины; а за нею по колкому жнивью, подхватывая ножонки, побежал мальчик, догладывая свою пышку."
                                            },
                                            {
                                                "example_id": "40089e68-5d9e-4e1d-9e19-a333fbe6ae3c",
                                                "sense_id": "73306d6d-0ec5-347a-8b25-f649f76ca873",
                                                "text": "Порой казалось, что вернулась зима, белая, очень белая метель заносила в полях щетину рыжих жнивий и большие свинцовые лужи, где плавали дикие утки ⟨…⟩"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "808ba41d-8a3a-3c11-aff4-0a94f32310ee",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "рег. уборка хлебов; жатва"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "320d039f-9ae8-3f1c-9f32-214e15468c92",
                                        "entry_id": "50c40884-0a01-3ad6-a56c-5c702e418b7f",
                                        "glosses": [
                                            "рег. время такой уборки"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
