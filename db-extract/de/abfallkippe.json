                "senses": [
                    {
                        "sense_id": "fe7658cb-c129-39a4-9615-465f5456d75c",
                        "entry_id": "7503d785-739c-30d1-8c75-eea07b3e4750",
                        "glosses": [
                            "Ort, an dem Abfall abgeladen und aufgeschüttet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3041c082-3133-4857-bafd-86ce939586ec",
                                "sense_id": "fe7658cb-c129-39a4-9615-465f5456d75c",
                                "text": "„Die Weltmeere sind zur Abfallkippe verkommen.“"
                            },
                            {
                                "example_id": "15fb1483-3c5f-4025-a7df-1331ae4cda44",
                                "sense_id": "fe7658cb-c129-39a4-9615-465f5456d75c",
                                "text": "„Meere sind noch immer eine Abfallkippe für Plastikmüll.“"
                            },
                            {
                                "example_id": "386eee51-b268-42eb-bc5c-62a08b01069d",
                                "sense_id": "fe7658cb-c129-39a4-9615-465f5456d75c",
                                "text": "„Abfallkippen, insbesondere illegale Deponien, können gefährliche Chemikalien und Schadstoffe freisetzen, die das Grundwasser kontaminieren und die lokale Flora und Fauna schädigen.“"
                            }
                        ],
