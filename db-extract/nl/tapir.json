                        "entry_id": "cba99b9e-9c12-3885-8ce5-14b29e19af8e",
                        "glosses": [
                            "hoefdier, zo groot als een ezel en met een kleine beweeglijke slurf dat voorkomt in Zuid-Amerika en Zuidoost-Azië; naam voor soorten uit de familie Tapiridae"
                        ],
                        "tags": [
                            "onevenhoevigen"
                        ],
                        "examples": [
                            {
                                "example_id": "5215b743-c8c8-4c81-8329-1b62463dc852",
                                "sense_id": "ada3dcf4-0c9a-387c-aec2-124cd3bbe088",
                                "text": "Met hun slurf kunnen tapirs twijgen van bomen en struiken rissen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9116fc1e-aa8b-48ca-9ae0-b9e28369596c",
