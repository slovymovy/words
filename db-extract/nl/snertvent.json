                "senses": [
                    {
                        "sense_id": "2333f815-ce5e-3533-b1ad-f031c60472cc",
                        "entry_id": "725e0961-932b-3119-8f33-b37ae9a0e950",
                        "glosses": [
                            "heel vervelende man"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "385838ac-f2a4-4533-824d-ec9492b8fb66",
                                "sense_id": "2333f815-ce5e-3533-b1ad-f031c60472cc",
                                "text": "Voor de slachtoffers maakt het bovendien weinig uit of het gaat om instrumentele dreigementen („Wij willen dat jij, bestuurder, dit besluit neemt”) of om expressieve dreigementen („Jij, politicus, bent gewoon een snertvent”). In alle gevallen hebben de dreigementen grote impact op het leven van een ambtsdrager, ook op zijn privéleven, en ondermijnen ze het functioneren van de rechtsstaat."
                            },
                            {
                                "example_id": "9175c229-a51e-4296-9f9b-7d696b6ab1b5",
                                "sense_id": "2333f815-ce5e-3533-b1ad-f031c60472cc",
                                "text": "De apotheose van de film is Moores onaangekondigde bezoek aan de filmlegende Charlton Heston. Ben Hur is tegenwoordig voorzitter van de National Rifle Association en hij gedroeg zich als een tactloze snertvent na het drama in Littleton en soortgelijke incidenten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc80b608-e206-4294-93bd-49d667e9cc4a",
                        "source_entry_id": "725e0961-932b-3119-8f33-b37ae9a0e950",
                        "source_sense_id": "2333f815-ce5e-3533-b1ad-f031c60472cc",
                        "target_lang_word": "scoundrel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scoundrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e64e2e3b-3d36-3402-9722-deb59bbe2eab",
                                        "entry_id": "34d9ae45-77f7-33a0-8fae-f45e53bc777c",
                                        "glosses": [
                                            "A mean, worthless fellow; a rascal; a villain; a person without honor or virtue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb77ead4-1e1b-4373-948b-f21dc5a29d40",
                                                "sense_id": "e64e2e3b-3d36-3402-9722-deb59bbe2eab",
                                                "text": "Go! if your ancient but ignoble blood / Has crept thro' Scoundrels ever ſince the Flood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a24e60bc-4aa4-47c2-a4b6-69705f3a1606",
