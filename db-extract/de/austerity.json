                        "source_entry_id": "9ab5a742-abff-30d6-aef8-9eeaf68352f6",
                        "source_sense_id": "49402b0e-fb27-3cef-92ca-d07d9e878c2f",
                        "source_sense_description": "Politik: wirtschaftliche Sparsamkeit mit dem Ziel, die Volkswirtschaft und Finanzen zu sanieren",
                        "target_lang_word": "austerity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
