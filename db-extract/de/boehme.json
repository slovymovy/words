                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                        "entry_id": "ff737e3a-19dd-3b9d-8520-845e55debaef",
                        "glosses": [
                            "Familienname, die seltenere Schreibweise von Böhme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd69c526-7af3-403b-acdf-344f8d45eec0",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "Frau Boehme ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "905d637c-d995-4c3a-9709-212c06c3b472",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "Herr Boehme wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "39ad96f1-3c10-4e50-9ab5-e6067a0635b7",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "Die Boehmes kommen heute aus Rüsselsheim."
                            },
                            {
                                "example_id": "d61b5176-a9d2-44b6-8b2e-d5b73d83ba9b",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "Der Boehme trägt nie die Schals, die die Boehme ihm strickt."
                            },
                            {
                                "example_id": "6b96b1d7-f6e8-4249-b3f1-e03f057fc5c1",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Boehme kommt, geht der Herr Boehme.“"
                            },
                            {
                                "example_id": "4adaba71-d18c-4fef-97a2-79c736840186",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "Boehme kommt und geht."
                            },
                            {
                                "example_id": "35003573-dc67-449d-8dd2-0e792fdcc616",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "Boehmes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "0cb76262-9a49-4779-b32e-fd473287bde7",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "An verregneten Herbsttagen ist Familie Boehmes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "fb72892f-3ecf-4429-a2ec-8111732202ff",
                                "sense_id": "f1d35b42-8471-3248-b8c1-85624de6d803",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Boehme das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
