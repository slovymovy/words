                        "glosses": [
                            "Tenue vestimentaire incluant un veston et une cravate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b50fad17-699d-491e-b061-acd4b89ec592",
                                "sense_id": "863d805a-3a89-37ad-b393-675ce82a0aed",
                                "text": "Lui, grand, brun et athlétique, très élégant avec un veston-cravate et un pantalon pattes d’éléphant."
                            },
                            {
                                "example_id": "61f1f14b-93a9-4399-867c-f41e37e7205d",
                                "sense_id": "863d805a-3a89-37ad-b393-675ce82a0aed",
                                "text": "Maxime entre rapidement et remarque que son hôte est vêtu d’un veston-cravate."
                            },
                            {
                                "example_id": "57cc5ad3-9078-40e0-8296-71721f852f73",
                                "sense_id": "863d805a-3a89-37ad-b393-675ce82a0aed",
                                "text": "Cheveux coupés courts, toujours en veston-cravate, le président de Norbourg cultive son image et se montre plutôt habile dans les relations publiques. Il sait qui inviter à sa table et à ses réunions d'affaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ea8f44c-0ed5-32b8-ab20-dca568461d77",
                        "entry_id": "fda05958-db63-326e-84bb-ba8a3ef3852b",
                        "glosses": [
                            "Personne portant cette tenue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1517656b-fdd2-45d0-bef1-cb427dcbd57a",
                                "sense_id": "3ea8f44c-0ed5-32b8-ab20-dca568461d77",
                                "text": "En ouvrant la porte du sauna, je tombe sur deux vestons-cravates frisant la cinquantaine qui se frenchkissent sans retenue."
                            },
                            {
                                "example_id": "a5457ddc-1228-4156-8b27-4a67393e979c",
                                "sense_id": "3ea8f44c-0ed5-32b8-ab20-dca568461d77",
                                "text": "Mission : pré-sélectionner un roman de langue française dans le cadre d'un prestigieux concours littéraire international. Entourés de vestons-cravates, Girard et moi détonnions dans nos vestes de denim fatiguées, arborées comme par défi à la barbe de cet obscur aréopage de diplomates culturels à la solennité empesée."
                            }
                        ]
                    }
