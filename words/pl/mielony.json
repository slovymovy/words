                            }
                        },
                        {
                            "text": "W szkolnej stołówce dzisiaj podają tradycyjnego <w>mielonego</w> z surówką z marchwi.",
                            "target_lang_translations": {
                                "ru": "В школьной столовой сегодня подают традиционную <w>котлету</w> с салатом из моркови."
