                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collectionnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69e937a3-d443-3ff8-9443-3407374b2f54",
                                        "entry_id": "e3bf500e-86e6-310a-9d72-cf3ca09954a9",
                                        "glosses": [
                                            "Action de collectionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a92a878-bc2e-4efc-b66d-5315157c690b",
                                                "sense_id": "69e937a3-d443-3ff8-9443-3407374b2f54",
                                                "text": "Il [le format du Journal Officiel] est extrêmement commode, facile pour la lecture, facile pour le transport et le collectionnement."
                                            },
                                            {
                                                "example_id": "64ac7e1a-5d35-4c63-85e3-6e5a5d74704d",
                                                "sense_id": "69e937a3-d443-3ff8-9443-3407374b2f54",
                                                "text": "Nous offrirons un nouveau collectionnement, en microfilm de 35mm, des 3,000 \"Romans Dimes\" Américains qui fut publiés entre les années 1840 et 1900."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
