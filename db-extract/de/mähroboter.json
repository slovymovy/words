                ],
                "senses": [
                    {
                        "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                        "entry_id": "a0d586ac-ccd7-3530-aaf6-5ac752f90c52",
                        "glosses": [
                            "Maschine, welche automatisch den Rasen kürzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ab40a5-6408-457e-84f3-a59821470bbe",
                                "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                                "text": "Alltäglich sind Haushaltsroboter wie Saug- und Mähroboter, unüblich noch Pflege- und Therapieroboter."
                            },
                            {
                                "example_id": "15ad210a-84d0-4cd9-901e-4d47bdca6725",
                                "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                                "text": "Wir haben heute einen Mähroboter gekauft."
                            },
                            {
                                "example_id": "dd7841e0-9ac0-40af-8a70-0046b0406189",
                                "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                                "text": "„Da geht man durch eine Gartensiedlung, sieht keinen Menschen, weil sich die Bewohner einen schönen Nachmittag im Gewerbepark machen, während im Garten der Mähroboter spazierenfährt.“"
                            },
                            {
                                "example_id": "c53602f8-19df-46c2-af12-d9eee02554c8",
                                "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                                "text": "„Mähroboter kosten mehrere tausend Franken und erfordern die Installation eines Begrenzungsdrahtes, damit das Gefährt sein Revier nicht verlässt.“"
                            },
                            {
                                "example_id": "a3aa019f-e8b8-4a90-a2be-670b9a16dbcb",
                                "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                                "text": "„Parallel zu den steigenden Verkäufen von Mährobotern in Deutschland würden immer mehr verletzte Tiere bei Igelstationen abgegeben.“"
                            },
                            {
                                "example_id": "a9989d97-2663-46d7-b8ad-20b368f051ec",
                                "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                                "text": "„Mähroboter können Igeln und anderen Kleintieren im Garten gefährlich werden.“"
                            },
                            {
                                "example_id": "56be1b96-b652-4990-bd9a-8efa0bfc6663",
                                "sense_id": "799487e1-41eb-3663-b857-c414dcf49ef7",
                                "text": "„Jährlich verletzten sich mehrere Kinder bei Unfällen im Garten - auch bei den Mährobotern ist Vorsicht geboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
