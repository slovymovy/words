                "senses": [
                    {
                        "sense_id": "28c99b07-6c2f-3378-a25e-5118250a0765",
                        "entry_id": "af9f47ae-1c5a-36d9-a0b9-be1f19434d11",
                        "glosses": [
                            "Flugzeug, das gegnerischen Streitkräften angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27941a0f-e8fe-4990-9c69-f5f0166d2760",
                                "sense_id": "28c99b07-6c2f-3378-a25e-5118250a0765",
                                "text": "„Die Israelis benötigten diese Maschine, um ihre Piloten, die damals französische Mirages flogen, im Luftkampf gegen das schnellere Feindflugzeug zu trainieren.“"
                            },
                            {
                                "example_id": "f87af098-ad49-4ff8-a6e1-225588970ea4",
                                "sense_id": "28c99b07-6c2f-3378-a25e-5118250a0765",
                                "text": "„So konnte Israel seine Luftwaffe, die damals mit französischen Mirages ausgerüstet war, an dem Feindflugzeug ausbilden.“"
                            },
                            {
                                "example_id": "adcadb85-accb-4606-b2c3-45239689a6e1",
                                "sense_id": "28c99b07-6c2f-3378-a25e-5118250a0765",
                                "text": "„Seine Maschine war über einem Moor in Belgien von einem Feindflugzeug abgeschossen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
