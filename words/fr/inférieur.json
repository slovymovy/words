                {
                    "sense_id": "890a344e-cbfe-3732-aa8e-2c9b5101a534",
                    "sense_definition": "Qui est plus petit ou égal par rapport à une valeur numérique donnée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nombre choisi par le joueur doit être strictement <w>inférieur</w> à cent.",
                            "target_lang_translations": {
                                "en": "The number chosen by the player must be strictly <w>lower</w> than one hundred.",
                                "ru": "Число, выбранное игроком, должно быть строго <w>меньше</w> ста.",
                                "de": "Die vom Spieler gewählte Zahl muss echt <w>kleiner</w> als hundert sein.",
                                "es": "El número elegido por el jugador debe ser estrictamente <w>menor</w> que cien.",
                                "zh": "玩家选择的数字必须严格<w>小于</w>一百。"
                            }
                        },
                        {
                            "text": "Le poids du bagage en cabine doit être <w>inférieur</w> ou égal à huit kilos.",
                            "target_lang_translations": {
                                "en": "The weight of carry-on baggage must be <w>lower</w> than or equal to eight kilos.",
                                "ru": "Вес ручной клади должен быть <w>меньше</w> или равен восьми килограммам.",
                                "de": "Das Gewicht des Handgepäcks muss <w>kleiner</w> oder gleich acht Kilogramm sein.",
                                "es": "El peso del equipaje de mano debe ser <w>menor</w> o igual a ocho kilos.",
                                "zh": "随身行李的重量必须<w>小于</w>或等于八公斤。"
                            }
                        }
                    ],
                    "antonyms": [
                        "supérieur",
                        "strictement supérieur"
                    ],
                    "common_phrases": [
                        "inférieur ou égal"
                    ],
                    "target_lang_definitions": {
