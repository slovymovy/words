                "translations": [
                    {
                        "translation_id": "74d609d0-a2b5-47fb-ada4-a1ea406c55c1",
                        "source_entry_id": "c0c1a35b-65a6-3c67-8e1e-3881587bdca6",
                        "source_sense_description": "оказываясь сильнее кого-либо, чего-либо, побеждать",
                        "target_lang_word": "overpower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overpower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d889694-c373-3adf-9c35-cfbe810063f3",
                                        "entry_id": "c412b001-4de6-3b22-881f-23a778d49722",
                                        "glosses": [
                                            "To subdue someone by superior force."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a525d17-c506-42ec-bcba-5e7e4f5ca87c",
                                                "sense_id": "6d889694-c373-3adf-9c35-cfbe810063f3",
                                                "text": "We overpowered the opposing army within a couple of hours."
                                            },
                                            {
                                                "example_id": "6324b75b-7e1a-420c-a7fd-b661122bc6a4",
                                                "sense_id": "6d889694-c373-3adf-9c35-cfbe810063f3",
                                                "text": "Amidst all the chaos, Großer Kurfürst slows up and strikes her colors, her crew having had enough, and have^([sic]) overpowered the officers - willing to fight, but not willing to commit suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81dddce9-74fc-35dd-ac4e-19f9e0aca05d",
                                        "entry_id": "c412b001-4de6-3b22-881f-23a778d49722",
                                        "glosses": [
                                            "To excel or exceed in power; to cause to yield; to subdue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a6c987-e61b-4a99-b584-8569fa965ca8",
                                                "sense_id": "81dddce9-74fc-35dd-ac4e-19f9e0aca05d",
                                                "text": "Bright light overpowers the eyes."
                                            },
                                            {
                                                "example_id": "6100ef1e-5c3b-43f0-ace4-1699ca356cff",
                                                "sense_id": "81dddce9-74fc-35dd-ac4e-19f9e0aca05d",
                                                "text": "But the shrill wild cry of the heron overpowered the cries of all the other birds, whom it seemed to terrify; they were silent the moment they heard it, and a silence followed which made the interruption doubly unpleasant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87004f8c-8f20-3068-b44f-ad82b5f21b78",
                                        "entry_id": "c412b001-4de6-3b22-881f-23a778d49722",
                                        "glosses": [
                                            "To render imperceptible by means of greater strength, intensity, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d218a258-acd3-4011-82ce-59aab2fc21c0",
                                                "sense_id": "87004f8c-8f20-3068-b44f-ad82b5f21b78",
                                                "text": "The dish was OK, but the garlic slightly overpowered the herbs."
                                            },
                                            {
                                                "example_id": "7afb749d-53e1-443f-91ce-60e9098bb5d7",
                                                "sense_id": "87004f8c-8f20-3068-b44f-ad82b5f21b78",
                                                "text": "Breadcrumbs seem to be the most popular choice, but Rose Elliot's recipe, in Vegetarian Christmas (as recommended by one of the three nice people who did tweet back, India Knight), doesn't quite convince as the centrepiece of the festive feast. It consists of two layers of ground cashew nuts, mixed with breadcrumbs, onions, nutmeg and vegetable stock, and separated by a vibrant green herb stuffing, the main ingredient of which is also bread. Although surprisingly moist, thanks to the stock (indeed, the contrast between the crisp exterior and the squidgy middle is horribly moreish), the combination of parsley, garlic and breadcrumbs reminds me of a very fancy loaf of garlic bread – and all but overpowers the sweet flavour of the cashews."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "084e5d9b-ded0-34ff-9d0f-2b40f2f16f4f",
                                        "entry_id": "c412b001-4de6-3b22-881f-23a778d49722",
                                        "glosses": [
                                            "To make excessively powerful."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abdc7ec0-6f34-4d4b-a2b5-2e7723c951d7",
                                                "sense_id": "084e5d9b-ded0-34ff-9d0f-2b40f2f16f4f",
                                                "text": "Rather than overpowering the characters or giving them some kind of slow-mo adrenalin abilities, Bloody Days does the most unexpected thing: it introduces a genuinely smart tactical system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
