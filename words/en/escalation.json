                    "frequency": "Low",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The support agent initiated an <w>escalation</w> because the technical problem was too complex for the standard help desk."
                        },
                        {
                            "text": "Our company policy requires an <w>escalation</w> to management if a customer complaint remains unresolved for three days."
