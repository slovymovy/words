                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef0d923-f3ae-42c0-9d99-952c799755bb",
                                "sense_id": "53d5f673-c679-3f0b-ba43-451ba8388792",
                                "text": "De ronde bergen in de verten kleurden pastelblauw en lila en vormden een mooi contrast met de warme aardse kleuren om mij heen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95902835-07b9-44c2-bf9b-ea72f6463a14",
                        "source_entry_id": "a2334291-ef36-3333-932d-9fd71b4b5221",
                        "source_sense_id": "53d5f673-c679-3f0b-ba43-451ba8388792",
                        "source_sense_description": "lichte tint van paars",
                        "target_lang_word": "lila",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lila",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67768789-55bb-3c16-b564-680d0f17d19d",
                                        "entry_id": "cf826bb3-33f9-3283-886a-25f084835025",
                                        "glosses": [
                                            "farblich von hellem Violett seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3c9e99-10e1-40f2-9ee4-d3f44590efda",
                                                "sense_id": "67768789-55bb-3c16-b564-680d0f17d19d",
                                                "text": "Meine Buntstifte sind alle lila."
                                            },
                                            {
                                                "example_id": "00a6d36c-bc51-4ad6-9f37-229718646ae1",
                                                "sense_id": "67768789-55bb-3c16-b564-680d0f17d19d",
                                                "text": "„Die Frau, die uns am nächsten saß, eine schlanke Gestalt in einem lila Wickelkleid, nahm eine lila Plastikschale zur Hand, wusch ihre Zehen, trocknete sie an der Sonne und lackierte sie sorgfältig mit lila Nagellack.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d70779bc-7fd7-42c8-b892-38117c3bd264",
                        "source_entry_id": "a2334291-ef36-3333-932d-9fd71b4b5221",
                        "source_sense_id": "53d5f673-c679-3f0b-ba43-451ba8388792",
                        "source_sense_description": "lichte tint van paars",
                        "target_lang_word": "lilac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lilac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbfdeebd-4c54-3c35-8e6b-08604842dc1a",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A large shrub of the genus Syringa, especially Syringa vulgaris, bearing white, pale-pink, or purple flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129e9219-75a3-4df4-8a78-6b0089b6fa66",
                                                "sense_id": "fbfdeebd-4c54-3c35-8e6b-08604842dc1a",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341999fd-4eff-3e50-a505-a48ff3cf66a2",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A flower of the lilac shrub."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fced0e6-1221-4050-8ae9-0643ec0aac6f",
                                                "sense_id": "341999fd-4eff-3e50-a505-a48ff3cf66a2",
                                                "text": "[…] O death, I cover you over with roses and early lilies, / But mostly and now the lilac that blooms the first, / Copious I break, I break the sprigs from the bushes, / With loaded arms I come, pouring for you, / For you and the coffins all of you O death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68dc6f2-ceaf-3d27-8fe1-d6ee9145cdd5",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A pale purple color, the color of some lilac flowers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2980c96-7335-3947-a1aa-41a27edc7a0f",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A cat having a lilac-colored (pale brown) coat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
