            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ae6042f-31e1-38aa-b348-8b2456a0996b",
                    "sense_definition": "Having a firm, dry, and brittle texture that breaks easily when bitten or pressed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef fried the bacon until it was perfectly <w>crispy</w> and golden brown.",
                            "target_lang_translations": {
                                "ru": "Повар обжарил бекон до идеального <w>хрустящего</w> состояния и золотисто-коричневого цвета."
                            }
                        },
                        {
                            "text": "I love eating <w>crispy</w> fried chicken with a side of fresh salad.",
                            "target_lang_translations": {
                                "ru": "Я обожаю есть <w>хрустящую</w> жареную курицу с гарниром из свежего салата."
                            }
                        }
                    ],
                    "synonyms": [
                        "crunchy",
                        "brittle",
                        "crisp"
                    ],
                    "antonyms": [
                        "soggy",
                        "soft"
                    ],
                    "common_phrases": [
                        "crispy fried chicken",
                        "crispy bacon",
                        "crispy skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий твердую, сухую и хрупкую текстуру, которая легко ломается при надкусывании или нажатии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрустящий",
                                "target_lang_sense_clarification": "о еде с твердой корочкой"
                            },
                            {
                                "target_lang_word": "поджаристый",
                                "target_lang_sense_clarification": "хорошо прожаренный до хруста"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf47b453-c54d-3231-a495-5eb9be74e986",
                    "sense_definition": "The well-baked, crunchy fat or skin on the surface of a piece of roasted meat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children always fought over the delicious <w>crispies</w> left in the roasting pan.",
                            "target_lang_translations": {
                                "ru": "Дети всегда спорили из-за вкусных <w>шкварок</w>, оставшихся в жаровне."
                            }
                        },
                        {
                            "text": "Make sure to save the <w>crispies</w> from the roast pork to add flavor to the gravy.",
                            "target_lang_translations": {
                                "ru": "Обязательно сохрани <w>хрустящие кусочки</w> от жареной свинины, чтобы добавить вкуса подливке."
                            }
                        }
                    ],
                    "synonyms": [
                        "crackling"
                    ],
                    "common_phrases": [
                        "roast meat crispies"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in certain British dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо пропеченный, хрустящий жир или кожа на поверхности куска жареного мяса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкварки",
