                            {
                                "example_id": "de0ac2ed-aa96-44a7-aaee-311d033d64b4",
                                "sense_id": "06caa35e-18a2-3fbe-a0f5-f28ef1ff7bc3",
                                "text": "Проплясал с шиком, с кандибобером."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f1c6b24-975e-3d85-a32c-01b7d1d9ce14",
                        "entry_id": "a51ab88b-4353-388c-9c72-4cfe0538b103",
                        "glosses": [
                            "разг., неол. высокий женский головной убор или причёска"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d8e18e-cb37-4b39-9ca3-8ceffd8bb643",
                                "sense_id": "5f1c6b24-975e-3d85-a32c-01b7d1d9ce14",
                                "text": "Во-о-от, развалили страну демократы, — поправив кандибобер на голове, завела песню одна."
                            },
                            {
                                "example_id": "92795ffd-1d0f-4458-96c7-65548d7a99b2",
                                "sense_id": "5f1c6b24-975e-3d85-a32c-01b7d1d9ce14",
                                "text": "Через остановку вышла женщина в кандибобере, а ещё через пару о происшествии почти забыли."
                            }
                        ]
                    }
