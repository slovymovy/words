                        "examples": [
                            {
                                "example_id": "10eef9e2-d257-4648-b460-19c89765015a",
                                "sense_id": "f0e3c0be-64c6-3784-85ea-48899dad14b4",
                                "text": "For here the true Cicada is not bred, but certain it is, that out of this, some kind of Locuſt doth proceed, for herein may be diſcovered a little inſect of a feſtucine or pale green, reſembling in all parts a Locuſt, or what we call a Graſhopper."
                            },
                            {
                                "example_id": "8a535a01-db6c-45f2-99ad-61069b3bc9b4",
                                "sense_id": "f0e3c0be-64c6-3784-85ea-48899dad14b4",
                                "text": "[…]; and during the controversy and distracted attention, a beautiful young lady, habited in a black silk pelisse, a festucine dress, and an envious little straw bonnet, stepped out of the opposite side of the coach."
                            },
                            {
                                "example_id": "4c927a5a-93e4-4d63-8d19-e3aa0c724bb2",
                                "sense_id": "f0e3c0be-64c6-3784-85ea-48899dad14b4",
                                "text": "[…] laid\nUpon thy pouting lips the drench of wine!\nAbove thy brow they massed the festucine\nTresses and bound them with a mitra's braid;"
                            }
                        ]
                    }
