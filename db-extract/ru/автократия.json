                    },
                    {
                        "translation_id": "e7e315ef-7088-47d4-986d-18410d7cebfe",
                        "source_entry_id": "fc200775-e429-3cc4-bed1-b6d32a9e584d",
                        "source_sense_id": "53346818-b229-3d0f-a243-e1459adc840a",
                        "target_lang_word": "Autokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                        "entry_id": "5d00164e-21ae-3e77-8369-f58f8285346c",
                                        "glosses": [
                                            "Staatsform, in der die absolute Herrschaft von einer Person oder Gruppe ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43de086-b923-480e-acee-a2fe783cd124",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "Nach jahrzehntelangem Leben in einer Autokratie müssen sich die Menschen erst an den Gedanken einer neugewonnenen Freiheit und Selbstbestimmung gewöhnen."
                                            },
                                            {
                                                "example_id": "155ceeee-0f97-417d-851c-83d9c2a54725",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "„Parlamentarische Demokratien im heutigen Sinne gab es noch nicht. Wohl aber existierten parlamentarisch verfaßte Oligarchien (Großbritannien) neben relativ offenen parlamentarischen Systemen (Frankreich=, stark eingeschränkt parlamentarischen, halb-autoritären Strukturen (Deutsches Reich und Österreich-Ungarn) und beinahe unbegrenzte Autokratien (Rußland).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19ad857d-744a-4024-be94-a5b04954f0bf",
                        "source_entry_id": "fc200775-e429-3cc4-bed1-b6d32a9e584d",
                        "source_sense_id": "53346818-b229-3d0f-a243-e1459adc840a",
                        "target_lang_word": "autocratie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocratie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                        "entry_id": "9c68c819-38ec-37b7-a44a-ea7ffa8d0ea5",
                                        "glosses": [
                                            "een regeringsvorm waarbij de macht wordt uitgeoefend door één man of vrouw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1dc39f-95ea-4726-9e93-dfab564113c3",
                                                "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                                "text": "Rusland is eeuwenlang een autocratie geweest."
                                            },
                                            {
                                                "example_id": "8bf56f0d-2a1d-46e1-9a4d-e478a70fa687",
                                                "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                                "text": "\"Turkije is hard op weg naar een autocratie\""
                                            },
                                            {
                                                "example_id": "f3788bed-3cea-4b94-8ac0-77296695cb69",
                                                "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                                "text": "De Republikeinen, die volledig meegingen in Trumps retoriek van verheerlijking van autocratie, misogynie en verdeeldheid, hebben bovendien hun greep op het Huis van Afgevaardigden behouden en de meerderheid in de Senaat gekregen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
