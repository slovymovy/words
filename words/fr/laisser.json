{
    "word_family": [
        "délaisser",
        "délaissement",
        "laisse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4ea2761-efcc-3cbe-a18e-89f71b6b6eaf",
                    "sense_definition": "Permettre ou ne pas empêcher l'accomplissement d'une action, généralement suivi d'un infinitif.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes parents me <w>laissent</w> sortir avec mes amis le samedi soir."
                        },
                        {
                            "text": "Il faut <w>laisser</w> refroidir le gâteau avant de le couper."
                        }
                    ],
                    "synonyms": [
                        "permettre",
                        "autoriser"
                    ],
                    "antonyms": [
                        "interdire",
                        "empêcher"
                    ],
                    "common_phrases": [
                        "laisser faire",
                        "laisser passer",
                        "laisser tomber"
                    ]
                },
                {
                    "sense_id": "a7462b57-1b80-37a2-b7e9-7a27cb7f0aea",
                    "sense_definition": "Déposer ou garder une chose ou une personne à un endroit sans l'emporter avec soi.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "depot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>laisser</w> ton manteau sur la chaise dans l'entrée."
                        },
                        {
                            "text": "Nous avons <w>laissé</w> les enfants chez leurs grands-parents pour le week-end."
                        }
                    ],
                    "synonyms": [
                        "poser",
                        "déposer"
                    ],
                    "antonyms": [
                        "prendre",
                        "emporter"
                    ],
                    "common_phrases": [
                        "laisser les clés",
                        "laisser un pourboire"
                    ]
                },
                {
                    "sense_id": "2e7803b3-9928-3356-a033-0cd944ff3732",
                    "sense_definition": "Oublier involontairement de prendre un objet avec soi.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "oubli",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai encore <w>laissé</w> mon parapluie dans le train ce matin."
                        },
                        {
                            "text": "Elle s'aperçoit qu'elle a <w>laissé</w> ses clés sur le meuble du salon."
                        }
                    ],
                    "synonyms": [
                        "oublier"
                    ],
                    "antonyms": [
                        "emporter",
                        "récupérer"
                    ],
                    "common_phrases": [
                        "laisser ses clés",
                        "laisser son portefeuille"
                    ]
                },
                {
                    "sense_id": "51153b42-7b2c-3ef1-8ed7-954dbb01678c",
                    "sense_definition": "Cesser d'importuner, de déranger ou de tourmenter quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "paix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "S'il vous plaît, <w>laissez</w>-moi tranquille pendant que je travaille sur ce dossier."
                        },
                        {
                            "text": "Il a demandé fermement à ses collègues de le <w>laisser</w> en paix."
                        }
                    ],
                    "antonyms": [
                        "déranger",
                        "harceler"
                    ],
                    "common_phrases": [
                        "laisser tranquille",
                        "laisser en paix"
                    ]
                },
                {
                    "sense_id": "fe5e2ed8-795e-3f11-b352-555a442bd5ca",
                    "sense_definition": "Accorder ou concéder une opportunité, un délai ou une marge d'action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous <w>laisse</w> deux jours de plus pour terminer le devoir."
                        },
                        {
                            "text": "Cette proposition intéressante vous <w>laisse</w> le choix de décider plus tard."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "octroyer"
                    ],
                    "antonyms": [
                        "refuser",
                        "imposer"
                    ],
                    "common_phrases": [
                        "laisser le temps",
                        "laisser le choix",
                        "laisser une chance"
                    ]
                },
                {
                    "sense_id": "fc08793e-2678-350d-a7ed-161ca5ba9084",
                    "sense_definition": "Se séparer d'une personne ou s'éloigner d'un endroit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "depart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois vous <w>laisser</w> maintenant car mon train part dans dix minutes."
                        },
                        {
                            "text": "Le voyageur <w>laisse</w> sa ville natale pour commencer une vie nouvelle ailleurs."
                        }
                    ],
                    "synonyms": [
                        "quitter",
                        "abandonner"
                    ],
                    "antonyms": [
                        "rejoindre",
                        "retrouver"
                    ],
                    "common_phrases": [
                        "laisser derrière soi"
                    ]
                },
                {
                    "sense_id": "0a6c66be-ad47-3dd1-b252-10c8c8012c66",
                    "sense_definition": "Provoquer ou maintenir une impression, une séquelle ou une trace durable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet été en Italie nous a <w>laissé</w> des souvenirs tout à fait merveilleux."
                        },
                        {
                            "text": "La violente tempête a <w>laissé</w> de nombreuses traces visibles dans toute la région."
                        }
                    ],
                    "synonyms": [
                        "marquer"
                    ],
                    "common_phrases": [
                        "laisser des traces",
                        "laisser un souvenir",
                        "laisser une impression"
                    ]
                },
                {
                    "sense_id": "65121fb9-070d-3391-9861-7489e8134f62",
                    "sense_definition": "Transmettre ou céder des biens matériels ou moraux à ses héritiers après sa mort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand-père a <w>laissé</w> sa maison de campagne à ses deux petits-enfants."
                        },
                        {
                            "text": "Il n'a rien <w>laissé</w> à sa famille en dehors de ses nombreux livres."
                        }
                    ],
                    "synonyms": [
                        "léguer",
                        "transmettre"
                    ],
                    "common_phrases": [
                        "laisser un héritage",
                        "laisser par testament"
                    ]
                }
            ]
        }
    ]
}