{
    "word_family": [
        "cap"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48ea92d5-9c12-348f-affb-aeaf7b97fdfd",
                    "sense_definition": "A stone that forms the top layer of a wall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason carefully placed the final <w>capstone</w> on the garden wall.",
                            "target_lang_translations": {
                                "ru": "Каменщик аккуратно установил <w>завершающий камень</w> на садовую стену."
                            }
                        },
                        {
                            "text": "Water seeped through the wall because the <w>capstone</w> was loose.",
                            "target_lang_translations": {
                                "ru": "Вода просачивалась сквозь стену, потому что <w>завершающий камень</w> расшатался."
                            }
                        }
                    ],
                    "synonyms": [
                        "copestone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Камень, завершающий верхний ряд кладки стены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершающий камень",
                                "target_lang_sense_clarification": "буквальное значение в строительстве"
                            },
                            {
                                "target_lang_word": "карнизный камень",
                                "target_lang_sense_clarification": "архитектурный элемент, венчающий стену"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d249641-b8a9-3eb1-ada6-d747cc532c3e",
                    "sense_definition": "A final, crowning achievement or finishing touch.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the championship was the <w>capstone</w> of her long career.",
                            "target_lang_translations": {
                                "ru": "Победа в чемпионате стала <w>венцом</w> её долгой карьеры."
                            }
                        },
                        {
                            "text": "This discovery serves as the <w>capstone</w> to years of scientific research.",
                            "target_lang_translations": {
                                "ru": "Это открытие служит <w>венцом</w> многолетних научных исследований."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Финальное, венчающее достижение или завершающий штрих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "венец",
                                "target_lang_sense_clarification": "переносное значение: высшее достижение или успешное завершение"
                            },
                            {
                                "target_lang_word": "завершающий штрих",
                                "target_lang_sense_clarification": "финальный этап работы или процесса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba2e062b-2b0b-34c1-8069-8093e14892fd",
                    "sense_definition": "To finish or complete something as a crowning achievement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>capstoned</w> her academic career by publishing a groundbreaking book.",
                            "target_lang_translations": {
                                "ru": "Она <w>увенчала</w> свою академическую карьеру публикацией новаторской книги."
                            }
                        },
                        {
                            "text": "The team <w>capstoned</w> their successful season with a victory in the finals.",
                            "target_lang_translations": {
                                "ru": "Команда <w>увенчала</w> свой успешный сезон победой в финале."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершить что-либо как венчающее достижение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увенчать",
                                "target_lang_sense_clarification": "завершить что-либо значимым успехом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52fc261c-6c03-35b0-b0ec-855936cbe439",
                    "sense_definition": "To undergo training in a specific military leadership program.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officers were <w>capstoned</w> before being deployed to the new base.",
                            "target_lang_translations": {
                                "ru": "Офицеры <w>прошли итоговую подготовку</w> перед отправкой на новую базу."
                            }
                        },
                        {
                            "text": "They <w>capstoned</w> the unit to ensure readiness for complex operations.",
                            "target_lang_translations": {
                                "ru": "Они <w>провели итоговую подготовку</w> подразделения, чтобы обеспечить готовность к сложным операциям."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить обучение по специальной программе подготовки военных руководителей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пройти итоговую подготовку",
                                "target_lang_sense_clarification": "военный контекст завершающего обучения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}