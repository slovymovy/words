                    },
                    {
                        "form_id": "dcb7d655-5ccc-4427-aa17-c3a575fed322",
                        "entry_id": "5264b5ad-e90b-309a-9f05-67f624891d53",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fabelwesen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72b6c9c1-d401-3fb6-bd64-209e84383977",
                        "entry_id": "5264b5ad-e90b-309a-9f05-67f624891d53",
                        "glosses": [
                            "Wesen, das in einer Fabel agiert. Die Fabel ist eine Erzählart, in der Tiere etwas für das Menschenleben Lehrreiches verständlich machen. Fabelwesen haben einen eigenen Charakter und Namen (beispielsweise Hase = Meister Lampe) und können sprechen. Berühmte Fabeldichter waren Äsop, La Fontaine und Gellert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd4e5f4-622d-42d1-a12a-cd260abce80f",
                                "sense_id": "72b6c9c1-d401-3fb6-bd64-209e84383977",
                                "text": "Ein bekanntes Fabelwesen ist das Einhorn."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5e61bfd4-5060-320c-91d0-27e2a3b73962",
                        "entry_id": "5264b5ad-e90b-309a-9f05-67f624891d53",
                        "glosses": [
                            "Wesen, die nur in der Fantasie vorkommen, also erfunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c465d6b8-0e1c-4d1a-ac5e-9ab1394f0032",
                                "sense_id": "5e61bfd4-5060-320c-91d0-27e2a3b73962",
                                "text": "Ein bekanntes Fabelwesen ist das Einhorn."
                            },
                            {
                                "example_id": "0170f671-c730-44ba-8e40-a5d29c521760",
                                "sense_id": "5e61bfd4-5060-320c-91d0-27e2a3b73962",
                                "text": "Moderne Beispiele für Fabelwesen sind das Nasobem und die Steinlaus."
                            },
                            {
                                "example_id": "b41e3ba5-c635-41d4-8ce7-4234193188ef",
                                "sense_id": "5e61bfd4-5060-320c-91d0-27e2a3b73962",
                                "text": "„Man zeigte uns Stücke von einem Drachen; das beweise, wie der Besitzer mir sagte, daß der Drache kein Fabelwesen sei.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
