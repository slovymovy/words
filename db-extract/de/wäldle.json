                ],
                "senses": [
                    {
                        "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                        "entry_id": "c351753b-0f17-3d0c-829c-7ee8b106637b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8796c261-1072-4c48-917a-db7516dac897",
                                "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                                "text": "Frau Wäldle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5450b551-237e-48e9-8056-f920bb19a8e6",
                                "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                                "text": "Herr Wäldle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9a25a41b-e832-4dda-8484-352805f24c9b",
                                "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                                "text": "Die Wäldles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "d02e3f64-b3a4-4b8c-b443-70c123740eea",
                                "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                                "text": "Der Wäldle trägt nie die Pullover, die die Wäldle ihm strickt."
                            },
                            {
                                "example_id": "649e3135-d6c1-4b37-aa28-dcf2a78b0bfd",
                                "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wäldle kommt, geht der Herr Wäldle.“"
                            },
                            {
                                "example_id": "42385eb8-12bc-4796-94e7-814f79db7ca6",
                                "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                                "text": "Wäldle kommt und geht."
                            },
                            {
                                "example_id": "815cb1e0-0a9e-4ee5-8426-badc40005b40",
                                "sense_id": "c04f7a31-32cd-3225-91ef-f94a2b6cc5d0",
                                "text": "Wäldles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
