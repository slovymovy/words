                                "target_senses": [
                                    {
                                        "sense_id": "ea48aba3-471d-39f2-833e-c05966b1faa1",
                                        "entry_id": "007c09f6-e969-31fb-899b-4d8747c4912e",
                                        "glosses": [
                                            "A quick, intense course of learning, especially one which is informal or hurried."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ce8a133-c3c2-446c-a04d-d99a7c1cacc4",
                                                "sense_id": "ea48aba3-471d-39f2-833e-c05966b1faa1",
                                                "text": "He got a crash course in babysitting when his sister dropped off his nephew for the afternoon."
                                            },
                                            {
                                                "example_id": "0f0b90c2-95c4-409c-ae1f-e0e5e3aae05f",
                                                "sense_id": "ea48aba3-471d-39f2-833e-c05966b1faa1",
                                                "text": "Students were essentially given a ‘crash course’ in how to be a lexicographer over a number of tutorial classes, beginning with lexicographical data collection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
