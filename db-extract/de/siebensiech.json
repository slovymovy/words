                "senses": [
                    {
                        "sense_id": "5b5fc262-e8ab-3241-9ff0-8033fd47d817",
                        "entry_id": "8f34e305-6ecd-3649-b2d5-1ec6b7a25704",
                        "glosses": [
                            "vielseitig begabter Mensch, ein Multitalent, Alleskönner; oft mit leicht kritischer Note"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7018e0ef-dccb-4634-b4a0-8b1120daee9b",
                                "sense_id": "5b5fc262-e8ab-3241-9ff0-8033fd47d817",
                                "text": "„Keine Frage, der britische Regisseur und Filmproduzent Matthew Vaughn ist der anarchischste Siebensiech der Filmbranche schlechthin.“"
                            },
                            {
                                "example_id": "e225cd64-9db0-4bf1-b707-b1ae22077b51",
                                "sense_id": "5b5fc262-e8ab-3241-9ff0-8033fd47d817",
                                "text": "„Zum Beispiel im «Schellen-Ursli». […] Der geht hoch auf die Alp, weil er eine zu kleine Glocke hat, und am Schluss hat er die grösste Glocke und ist der Siebensiech.“"
                            },
                            {
                                "example_id": "7267dc90-c491-4040-bf46-362a7965326f",
                                "sense_id": "5b5fc262-e8ab-3241-9ff0-8033fd47d817",
                                "text": "„In unserer Gesellschaft muss man immer der Siebensiech sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
