                                "sense_id": "5cd8e125-73ea-330d-9067-e0d31b8381e5",
                                "text": "Hands binnen de zestien: dat moet een strafschop zijn!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e10314c2-c8ff-3094-9e3a-3ad5344a0442",
                        "entry_id": "f432d21b-0e7d-32ba-9c4f-8caff3e8dea6",
