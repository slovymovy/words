                                                "sense_id": "e0595c17-468a-3685-b2a6-f3dbbec31987",
                                                "text": "Er viel een dun strookje papier uit dat op de grond dwarrelde."
                                            },
                                            {
                                                "example_id": "4d4abeb0-5ff0-4cac-b41e-cfb6f6abf687",
                                                "sense_id": "e0595c17-468a-3685-b2a6-f3dbbec31987",
                                                "text": "Het was een ijskoude nacht en ik werd meerdere malen bibberend wakker. Verbaasd zag ik de volgende ochtend dat er een dun laagje ijs op mijn tent lag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "677a5a0b-75d2-3284-8e38-a8644897b992",
                                        "entry_id": "9f631170-d9ad-37bd-8a3c-ee17acd8fc76",
                                        "glosses": [
                                            "vloeibaarder dan zou moeten"
