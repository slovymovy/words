{
    "word_family": [
        "zjarać",
        "zjarus"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "66f01ac6-b55b-3895-abe2-b6a122064326",
                    "sense_definition": "osoba o bardzo ciemnej skórze wskutek długiego przebywania na słońcu lub korzystania z solarium",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wygląd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Widzisz tę <w>zjarana</w> dziewczynę? Pewnie chodzi na solarium.",
                            "target_lang_translations": {
                                "ru": "Видишь эту <w>загоревшую</w> девушку? Наверное, ходит в солярий."
                            }
                        },
                        {
                            "text": "Po wakacjach w Egipcie wrócił tak <w>zjarany</w>, że ledwo go poznałem.",
                            "target_lang_translations": {
                                "ru": "После отпуска в Египте он вернулся таким <w>загорелым</w>, что я его едва узнал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mocno zjarany"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie mocnej opalenizny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек с очень темной кожей в результате длительного пребывания на солнце или посещения солярия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загорелый",
                                "target_lang_sense_clarification": "общеупотребительное слово для обозначения загара"
                            },
                            {
                                "target_lang_word": "пережаренный",
                                "target_lang_sense_clarification": "разговорное, подчеркивающее чрезмерный загар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb440234-67a9-35a2-9cee-a28490564e44",
                    "sense_definition": "będący pod wpływem marihuany",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chłopak był tak <w>zjarany</w>, że nie potrafił sklecić prostego zdania.",
                            "target_lang_translations": {
                                "ru": "Парень был настолько <w>обкуренным</w>, что не мог связать и двух слов."
                            }
                        },
                        {
                            "text": "Wszyscy <w>zjarani</w> koledzy śmiali się z każdego żartu.",
                            "target_lang_translations": {
                                "ru": "Все <w>обкуренные</w> приятели смеялись над каждой шуткой."
                            }
                        }
                    ],
                    "synonyms": [
                        "ujarany",
                        "upalony"
                    ],
                    "common_phrases": [
                        "całkiem zjarany"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "określenie stanu odurzenia narkotykowego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "находящийся под воздействием марихуаны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обкуренный",
                                "target_lang_sense_clarification": "сленговое обозначение состояния наркотического опьянения"
                            },
                            {
                                "target_lang_word": "под кайфом",
                                "target_lang_sense_clarification": "разговорное выражение для любого наркотического опьянения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9bc9a680-d862-3c24-95eb-8956ffa76322",
                    "sense_definition": "imiesłów przymiotnikowy bierny od czasownika <w>zjarać</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To <w>zjarane</w> mięso nie nadaje się już do jedzenia.",
                            "target_lang_translations": {
                                "ru": "Это <w>подгоревшее</w> мясо уже не годится в пищу."
                            }
                        },
                        {
                            "text": "Wyrzuciłem <w>zjarany</w> bezpiecznik do kosza.",
                            "target_lang_translations": {
                                "ru": "Я выбросил <w>сгоревший</w> предохранитель в мусорное ведро."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma gramatyczna czasownika"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие от глагола «сжечь» или «поджарить», означающее что-то испорченное огнем или высокой температурой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгоревший",
                                "target_lang_sense_clarification": "о еде, которая пригорела при готовке"
                            },
                            {
                                "target_lang_word": "сгоревший",
                                "target_lang_sense_clarification": "о предмете, который полностью или частично уничтожен огнем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}