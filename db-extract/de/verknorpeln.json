                                "example_id": "e3f95d9d-35f0-4b51-ae55-d5e021dc11fb",
                                "sense_id": "231fefa4-659b-3e25-95e7-0b838d5d0021",
                                "text": "„Gelegentlich sind die Verwachsungen auch verknorpelt oder auch durch Metastasen induriert.“"
                            }
