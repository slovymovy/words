                "translations": [
                    {
                        "translation_id": "b6385855-c48a-4581-95b7-5abec5058e8f",
                        "source_entry_id": "1803d225-0a6e-316d-a7ca-184ca08f0f3a",
                        "source_sense_id": "2c8d4174-52af-3c1a-84d4-5efceb6ec53f",
                        "source_sense_description": "Grammatik, nun selten: Apposition",
                        "target_lang_word": "Apposition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apposition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                        "entry_id": "1707bcaf-1b76-364c-afe8-e0a4be7be0c4",
                                        "glosses": [
                                            "(weglassbare) Beistellung im (nominalen, …) Satzglied, die meistens im gleichen Kasus wie das Bezugsnomen steht und auf den gleichen Sachverhalt, die gleiche Person oder Ähnliches verweist. Sie kann auch abweichend vom Bezugsnomen im Nominativ stehen. (Viele Linguisten betrachten Appositionen als eine Sonderform des Attributs; sie verhalten sich aber syntaktisch anders.)"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11694cf-2513-4272-8ac1-8ac24cd9d2d3",
                                                "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                                "text": "„Herr Meier“, „Professor Meier“ sind Beispiele für enge Appositionen."
                                            },
                                            {
                                                "example_id": "ec8ba54a-a00e-400f-9000-508ef82c85f6",
                                                "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                                "text": "„Karl der Große“, „Peter, mein Freund“ sind Beispiele für weite Appositionen."
                                            },
                                            {
                                                "example_id": "e95f807a-d81b-4b01-bc0c-c84440567007",
                                                "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                                "text": "„Ilse, die neue Schülerin in der Klasse“ ist ein weiteres Beispiel für eine weite Apposition."
                                            },
                                            {
                                                "example_id": "713899b4-ddf6-4475-9962-ec651432e6ab",
                                                "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                                "text": "„Es rieselte vom Himmel herunter, und die Esel, der Führer und ich, dies ist keine Apposition, waren schon naß, als wir aus dem Dorf herauskamen.“ (Tucholsky: Von Barèges bis Arreau, GW Bd. 5, S. 103.)"
                                            },
                                            {
                                                "example_id": "5ecf68f4-4fac-4ecf-aae6-c7a448ee1434",
                                                "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                                "text": "„Ich mische unartikulierte Töne ein, ziehe die Verbindungswörter in die Länge, gebrauche auch wohl eine Apposition, wo sie nicht nötig wäre, und bediene mich anderer, die Rede ausdehnender, Kunstgriffe, zur Fabrikation meiner Idee auf der Werkstätte der Vernunft, die gehörige Zeit zu gewinnen.“ (Heinrich von Kleist: Über die allmähliche Verfertigung der Gedanken beim Reden.)"
                                            },
                                            {
                                                "example_id": "929537ee-d4f5-4b09-85af-9df620b8944d",
                                                "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                                "text": "„Apposition: Beisatz, Erklärungszusatz, Nebensatz“"
                                            },
                                            {
                                                "example_id": "4dc06f5d-8c3b-43e6-849e-f5cbdcd4d63e",
                                                "sense_id": "6926e7c4-af3b-3653-92f0-c1078ba08d48",
                                                "text": "„Synchron hat man die Verbindung RN + FN ebenfalls als Apposition gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "726718df-250f-3ec2-ba19-18bc6034b7c9",
                                        "entry_id": "1707bcaf-1b76-364c-afe8-e0a4be7be0c4",
                                        "glosses": [
                                            "„Anlagerung von Substanzen (zum Beispiel Dickenwachstum pflanzlicher Zellwände oder Anlagerung von Knochensubstanz beim Aufbau der Knochen)“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f09946-65d7-4256-943e-c1b5728023f1",
                                                "sense_id": "726718df-250f-3ec2-ba19-18bc6034b7c9",
                                                "text": "„Die aus Protopectin bestehende Mittellamelle, die benachbarte Zellen als Interzellularsubstanz miteinander verbindet, bildet sich bei der Zellteilung aus der Zellplatte. Die Primärwand wird von den Tochterzellen zu beiden Seiten der Mittellamelle angelagert (Apposition), noch ehe die Zellplatte ganz fertig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
