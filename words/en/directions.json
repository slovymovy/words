                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd scattered in all <w>directions</w> when the rain started.",
                            "target_lang_translations": {
                                "ru": "Толпа разбежалась во всех <w>направлениях</w>, когда начался дождь.",
                                "zh": "雨开始下的时候，人群向四面<w>方向</w>散开了。"
                            }
                        },
                        {
                            "text": "We drove in opposite <w>directions</w> to cover more ground.",
                            "target_lang_translations": {
                                "ru": "Мы поехали в противоположных <w>направлениях</w>, чтобы охватить большую территорию.",
