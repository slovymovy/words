                        "glosses": [
                            "Uhr mit Repetierwerk, das die Uhrzeit akustisch anzeigt/anzeigen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c643c8e-92f1-4f5f-a1b3-97e11e083008",
                                "sense_id": "36960fb0-b606-3654-b289-0ae3749be18b",
                                "text": "„Sie zeigte mir eine Repetieruhr, die sie als Gewinn einer Lotterie mit Losen zu je zwölf Francs ausgesetzt hatte; sie bot mir eines an und sagte, sie habe noch zehn.“"
                            },
                            {
                                "example_id": "4bf41e6c-d6d1-4871-9621-52538fdd3004",
                                "sense_id": "36960fb0-b606-3654-b289-0ae3749be18b",
                                "text": "„Thomas Lieven lächelte verträumt und holte eine goldene Repetieruhr hervor.“"
                            }
                        ],
