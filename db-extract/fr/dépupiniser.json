                        "glosses": [
                            "Enlever les bobines Pupin qui avaient servi à pupiniser une ligne téléphonique"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ccf025d-fddd-45cf-97c1-844ff6554b9b",
                                "sense_id": "5f2b2a61-9b08-3b38-a44e-f1a91d33b2db",
                                "text": "Si l'on veut augmenter le débit, il faut dépupiniser pour bénéficier de toute la BP de la ligne téléphonique (sur quelques km < 3km)."
                            },
                            {
                                "example_id": "2814f752-15ce-4b47-8de1-11538c9dd6a6",
                                "sense_id": "5f2b2a61-9b08-3b38-a44e-f1a91d33b2db",
                                "text": "Pour permettre des transmissions à plus de 4800 bits par seconde, il a été nécessaire de dépupiniser les lignes téléphoniques concernées."
                            }
                        ]
