                                            {
                                                "example_id": "b71c4ccd-de05-4e86-9b46-c458d4d40be0",
                                                "sense_id": "5ba848f4-ea89-3494-9a80-a5e77f7ed069",
                                                "text": "Her attitude is summarizable as \"don't do anything you don't have to\"."
                                            },
                                            {
                                                "example_id": "6f4291aa-d6fe-49d7-ae73-264038f740a5",
                                                "sense_id": "5ba848f4-ea89-3494-9a80-a5e77f7ed069",
                                                "text": "But whether the bill passes in its present shape or not, it is satisfactory to note that the Bulgarian popular mind has been wrought to that condition of dissatisfaction (not unfamiliar to the British one) which is summarizable in the words that “something must be done.\""
                                            }
                                        ]
