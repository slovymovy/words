                                    },
                                    {
                                        "sense_id": "35eecf0e-bad3-30ad-9e74-b6d40c51989d",
                                        "entry_id": "5e5dc4e6-7795-3812-9110-5cbcecbdd3c4",
                                        "glosses": [
                                            "A person who by means of travel (notably an expedition) searches out new information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39aeedff-e949-4029-b0cb-4c7df7f1360a",
                                                "sense_id": "35eecf0e-bad3-30ad-9e74-b6d40c51989d",
                                                "text": "Though now extinct, the rachni once threatened every species in Citadel space. Over 2000 years ago, explorers foolishly opened a mass relay to a previously-unknown system and encountered something never seen before or since: a species of spacefaring insects guided by a hive-mind intelligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab82156-6d45-3d43-917c-7d710b49bf07",
                                        "entry_id": "5e5dc4e6-7795-3812-9110-5cbcecbdd3c4",
                                        "glosses": [
                                            "Any of various hand tools, with sharp points, used in dentistry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aed57575-f2c3-36f0-8753-afa2ae509f03",
                                        "entry_id": "5e5dc4e6-7795-3812-9110-5cbcecbdd3c4",
                                        "glosses": [
                                            "A visual representation of a file system etc. through which the user can navigate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07120736-76d0-4f36-9e37-600851f32616",
                                                "sense_id": "aed57575-f2c3-36f0-8753-afa2ae509f03",
                                                "text": "For example, Vista includes a document explorer that shows just the documents in a location without considering all of the other files that might appear there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
