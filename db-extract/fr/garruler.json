                        "glosses": [
                            "Crier comme un geai"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e871bb-4897-4056-9e17-f843bfb0a5ec",
                                "sense_id": "0dbcf18c-3baf-3729-9f90-c0288124b8e4",
                                "text": "Ce matin j'ai entendu un geai garruler."
                            },
                            {
                                "example_id": "1a98fcd5-4a87-43ab-93f7-d5b014c6ebe8",
                                "sense_id": "0dbcf18c-3baf-3729-9f90-c0288124b8e4",
                                "text": "Pour le jeune homme le merle siffle, le geai garrule, la pie glapit, le corbeau croasse, le pigeon roucoule, la poule glousse; pour le vieillard, les oiseaux parlent."
                            }
                        ]
                    }
