{
    "word_family": [
        "indication",
        "indicateur",
        "indicatif",
        "indice",
        "contre-indiquer",
        "contre-indication"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fedb30c-8ea2-3eaf-b68b-a19e1a4ed14e",
                    "sense_definition": "Donner une information, guider ou faire connaître un lieu, un chemin ou une démarche utile à quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "renseigner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous m'<w>indiquer</w> le chemin pour aller à la gare centrale ?"
                        },
                        {
                            "text": "L'agent d'accueil nous a gentiment <w>indiqué</w> un bon restaurant dans le quartier."
                        }
                    ],
                    "synonyms": [
                        "renseigner",
                        "signaler",
                        "orienter"
                    ],
                    "common_phrases": [
                        "indiquer le chemin",
                        "indiquer la direction"
                    ]
                },
                {
                    "sense_id": "89bff5f7-e4d9-3483-ae7d-35e1692be55f",
                    "sense_definition": "Montrer ou désigner un élément ou une mesure au moyen d'un geste, d'un signe ou d'un appareil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "montrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grande aiguille de la pendule <w>indique</w> midi pile."
                        },
                        {
                            "text": "Le guide touristique <w>indique</w> le sommet de la cathédrale du bout du doigt."
                        }
                    ],
                    "synonyms": [
                        "montrer",
                        "désigner"
                    ],
                    "common_phrases": [
                        "indiquer l'heure"
                    ]
                },
                {
                    "sense_id": "9f6943a9-aab7-3ba0-b888-7176f5d88cf4",
                    "sense_definition": "Préciser, consigner ou énoncer expressément des faits, des choix ou des consignes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "préciser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez <w>indiquer</w> clairement votre nom et votre adresse sur le formulaire officiel."
                        },
                        {
                            "text": "Le professeur a <w>indiqué</w> toutes les consignes nécessaires avant le début de l'examen."
                        }
                    ],
                    "synonyms": [
                        "préciser",
                        "spécifier",
                        "mentionner"
                    ],
                    "common_phrases": [
                        "indiquer la date",
                        "indiquer clairement"
                    ]
                },
                {
                    "sense_id": "43b09f0c-d6b1-398f-a41f-8104941864b2",
                    "sense_definition": "Être le signe, l'indice ou la manifestation évidente de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces empreintes fraîches dans la boue <w>indiquent</w> le passage récent d'un animal."
                        },
                        {
                            "text": "La baisse soudaine de la pression <w>indique</w> l'arrivée imminente d'un violent orage."
                        }
                    ],
                    "synonyms": [
                        "révéler",
                        "manifester",
                        "témoigner"
                    ],
                    "common_phrases": [
                        "indiquer une tendance"
                    ]
                },
                {
                    "sense_id": "82c86392-111b-39de-998e-edc1d5c4640b",
                    "sense_definition": "Recommander ou prescrire un traitement, un remède ou un comportement adapté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prescrire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament est particulièrement <w>indiqué</w> pour calmer les fortes douleurs musculaires."
                        },
                        {
                            "text": "Le médecin a <w>indiqué</w> un repos complet pendant deux semaines consécutives."
                        }
                    ],
                    "synonyms": [
                        "prescrire",
                        "préconiser",
                        "recommander"
                    ],
                    "antonyms": [
                        "contre-indiquer"
                    ],
                    "common_phrases": [
                        "traitement indiqué"
                    ]
                },
                {
                    "sense_id": "4b55baef-4d6e-33fd-8aef-858b6bc18b28",
                    "sense_definition": "Ébaucher ou représenter une forme sans s'attacher aux détails.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ébaucher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a simplement <w>indiqué</w> la silhouette de l'arbre par deux coups de pinceau."
                        },
                        {
                            "text": "Dans son roman, l'écrivain <w>indique</w> à peine l'origine mystérieuse de son personnage principal."
                        }
                    ],
                    "synonyms": [
                        "esquisser",
                        "ébaucher"
                    ]
                }
            ]
        }
    ]
}