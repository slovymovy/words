                                        "entry_id": "53b6a406-5c03-3e75-a3fb-408329628322",
                                        "glosses": [
                                            "A person from Malawi or of Malawian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b95f0d73-e41b-43e5-8713-54bf4d2df57b",
                                                "sense_id": "4801eb80-0d54-3417-b75d-571a44eebb84",
                                                "text": "The average Malawian earns about US$250 monthly."
                                            },
                                            {
                                                "example_id": "007d233a-3541-48cf-b0b4-5c330b063af3",
                                                "sense_id": "4801eb80-0d54-3417-b75d-571a44eebb84",
                                                "text": "The departure of hundreds of Malawians to Israel to work as farm labourers has sparked a debate within the Southern African country, which is looking to raise much-needed foreign currency amid a cash crunch."
                                            }
                                        ]
                                    }
                                ]
                            },
