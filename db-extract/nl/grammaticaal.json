                                        "entry_id": "8485391b-0a66-3623-9f85-5b564f1489de",
                                        "glosses": [
                                            "Not breaching any constraints of the grammar, or morpho-syntax, of the relevant language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cda714a6-80b2-4b08-b344-a5091a0bd8b2",
                                                "sense_id": "29e583a5-3f4d-3ccf-add0-b61b05ab54d3",
                                                "text": "Your writing in English is not grammatical enough for publication, so we will hire an editor to fix it where necessary while preserving the intended meaning."
                                            },
                                            {
                                                "example_id": "f4c2e651-76db-4126-9759-2a6dd9cd5ca5",
                                                "sense_id": "29e583a5-3f4d-3ccf-add0-b61b05ab54d3",
                                                "text": "These unidiomatic utterances are easily comprehensible but are not grammatical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac392102-1980-3875-bd6a-95866a1d2cad",
                                        "entry_id": "8485391b-0a66-3623-9f85-5b564f1489de",
                                        "glosses": [
                                            "Of or pertaining to grammar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b19458-72c4-494a-be06-6f44f688cdfd",
                                                "sense_id": "ac392102-1980-3875-bd6a-95866a1d2cad",
                                                "text": "The writing was measured for both grammatical complexity and accuracy factors."
                                            }
                                        ]
