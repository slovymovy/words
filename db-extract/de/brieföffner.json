                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "370b1da2-bea7-3439-8311-2c81fa01d710",
                                        "entry_id": "b0faf617-f80d-3b09-8eff-10f867d6357e",
                                        "glosses": [
                                            "Instrument en bois, en métal ou en toute autre matière, qui sert à couper le papier et spécialement les enveloppes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77b12cfe-01b1-4169-ab36-0f129f0bc1f6",
                                                "sense_id": "370b1da2-bea7-3439-8311-2c81fa01d710",
                                                "text": "Il a été poignardé, vraisemblablement dans la journée d’hier ou au début de la nuit, selon les premières constatations médicales, à l’aide d’un ouvre-lettres lui appartenant."
                                            },
                                            {
                                                "example_id": "9ae8a9e3-8321-404f-9db9-c2ffb3d965bc",
                                                "sense_id": "370b1da2-bea7-3439-8311-2c81fa01d710",
                                                "text": "Xavier Yaris (X Y pour ses amis de plus en plus rares) saisit son ouvre-lettres, petite épée de style castillan, pommeau finement ciselé et lame effilée."
                                            }
                                        ]
                                    }
                                ]
