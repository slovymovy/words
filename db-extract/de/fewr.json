                        "examples": [
                            {
                                "example_id": "e059f0ac-2b2e-4258-90fe-7deba377afe4",
                                "sense_id": "f0e7daeb-b82d-3ea6-b11a-3ef9985933bb",
                                "text": "„Zwey grosse fewr sye zundten an / die knaben sie her brachten. Es nam groß wunder yderman / das sye solch peyn verachten.“"
                            },
                            {
                                "example_id": "831a30f5-57c6-4692-b662-ad2d84189c6e",
                                "sense_id": "f0e7daeb-b82d-3ea6-b11a-3ef9985933bb",
                                "text": "„Erstlich hat mann sie mit glüenden Zangen gerissen / folgendts geratbrecht / vnd letstlich in das fewr geworffen / mit denen gleichfals ein Kuhe / zu vier stücken gehawen / vnd auch verbrandt worden.“"
                            },
                            {
                                "example_id": "7c2f6167-3674-4fe2-8854-0c50541a07fe",
                                "sense_id": "f0e7daeb-b82d-3ea6-b11a-3ef9985933bb",
                                "text": "„Fewr thet vom Himmel fallen / jederman stundt in leyd / da hört man grosses Brüllen vnd fallen von schönem Gebew / ein Edelman hat es verbrennt / sein gantzes Schloß vnd Wohnung ist von dem Fewr anzint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
