                "senses": [
                    {
                        "sense_id": "2d7333ed-4707-3fc5-b883-5ed2009b5141",
                        "entry_id": "52675f6b-7b90-3c6a-88cf-9597c93e92ae",
                        "glosses": [
                            "Arrêter de cohabiter (avec ses parents ou ses enfants, en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21cd8660-ba09-44d3-8f00-d25c75a8cfef",
                                "sense_id": "2d7333ed-4707-3fc5-b883-5ed2009b5141",
                                "text": "Il s’agit de les convaincre et de les aider à « décohabiter », afin de permettre une vie plus décente pour elles et leurs enfants, mais aussi la régularisation de leur situation administrative."
                            },
                            {
                                "example_id": "60fdd562-e9b5-4e41-863c-ebb1ef82776d",
                                "sense_id": "2d7333ed-4707-3fc5-b883-5ed2009b5141",
                                "text": "La probabilité de décohabiter ne commence à augmenter qu’à partir de 23 ans ; au-dessus de 25 ans, elle est six fois plus forte qu’à 20 ans (cinq fois plus, indice 475, si l’on retranche les étudiants de plus de 30 ans)."
                            },
                            {
                                "example_id": "5b11375f-39c9-44ea-9375-6e4fcaaa7a5c",
                                "sense_id": "2d7333ed-4707-3fc5-b883-5ed2009b5141",
                                "text": "Leur première fille Andrée naquit en décembre 1926, puis ils ne s’entendirent plus avec la grand-mère & décohabitèrent."
                            }
                        ]
                    }
                ],
