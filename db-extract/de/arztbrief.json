                        "form": "den Arztbrief"
                    },
                    {
                        "form_id": "af14d693-441b-4f76-9819-88c06c2e6f33",
                        "entry_id": "87ee305e-7419-394b-b2c7-f9853012a573",
                        "tags": [
                            "accusative",
                            "plural"
