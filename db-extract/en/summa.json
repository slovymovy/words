                        "examples": [
                            {
                                "example_id": "c52f2287-2d57-459d-b003-4d573042b8a0",
                                "sense_id": "efd51bd9-f24c-3735-b3fd-536331bb5f21",
                                "text": "In size, scope, and graphic ambition [the map] is a summa of the mapping art of the day, represented in paint by Vermeer."
                            },
                            {
                                "example_id": "e2c873a1-46ad-470c-ac78-b67d503179ec",
                                "sense_id": "efd51bd9-f24c-3735-b3fd-536331bb5f21",
                                "text": "The painting is a “summa” of the various trends that intertwined and developed during those crucial years of the early sixteenth century in Florence."
                            },
                            {
                                "example_id": "7c007f0b-3d46-4362-9551-05ea936144d6",
                                "sense_id": "efd51bd9-f24c-3735-b3fd-536331bb5f21",
                                "text": "Rockefeller Center is at once a summa of the Art Deco style, and a look ahead to the Internationalist style that dominated after World War II."
                            }
                        ]
                    }
