                        "glosses": [
                            "Qui concerne les lémurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1890856a-4a12-42ad-a152-438e7f217011",
                                "sense_id": "d3445f24-8317-3b97-8635-e51d91a0c368",
                                "text": "Une espèce lémurienne paraît faire exception à cette règle, mais cette exception est beaucoup plus apparente que réelle."
