                                "target_senses": [
                                    {
                                        "sense_id": "a3a13cd9-9b23-349a-bce9-74ba791f77cf",
                                        "entry_id": "8aca99af-91eb-374d-8de6-20ebfafc8e3c",
                                        "glosses": [
                                            "growth; increase"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78baee8f-0432-44d9-9427-5e3bd2d68a2a",
                                                "sense_id": "a3a13cd9-9b23-349a-bce9-74ba791f77cf",
                                                "text": "Some of these unhappy emigrants felt a general sinking of all their mental and bodily energies, without, however, experiencing the growings of hunger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77e3b3d-05e3-37ea-9f6e-ee1e0d1e55fc",
                                        "entry_id": "8aca99af-91eb-374d-8de6-20ebfafc8e3c",
                                        "glosses": [
                                            "The raising of plants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a60d05-d037-477d-95cb-11c1c998d571",
                                                "sense_id": "a77e3b3d-05e3-37ea-9f6e-ee1e0d1e55fc",
                                                "text": "The growing season here begins in March."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
