    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "811e61f4-f74d-34c2-b217-e8a897ab6f92",
                    "sense_definition": "Оценка ситуации, действия или явления как опасных, наносящих ущерб здоровью или благополучию.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causing_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вам категорически <w>вредно</w> пить крепкий кофе на ночь.",
                            "target_lang_translations": {
                                "en": "It is absolutely <w>bad</w> for you to drink strong coffee at night.",
                                "de": "Es ist für Sie absolut <w>schädlich</w>, abends starken Kaffee zu trinken."
                            }
                        },
                        {
                            "text": "Долго сидеть за компьютером без перерыва <w>вредно</w> для глаз.",
                            "target_lang_translations": {
                                "en": "Sitting at the computer for a long time without a break is <w>harmful</w> to the eyes.",
                                "de": "Langes Sitzen am Computer ohne Pause ist <w>ungesund</w> für die Augen."
                            }
                        }
                    ],
                    "synonyms": [
                        "опасно",
                        "пагубно"
                    ],
                    "antonyms": [
                        "полезно"
                    ],
                    "common_phrases": [
                        "вредно для здоровья",
                        "курить вредно",
                        "вредно волноваться"
                    ],
                    "target_lang_definitions": {
                        "en": "Harmful or bad for one's health or well-being.",
                        "de": "Gesundheitsschädlich oder nachteilig für das Wohlbefinden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harmful",
                                "target_lang_sense_clarification": "causing damage or injury"
                            },
                            {
                                "target_lang_word": "bad",
                                "target_lang_sense_clarification": "detrimental to health (common usage)"
                            },
                            {
                                "target_lang_word": "unhealthy",
                                "target_lang_sense_clarification": "not conducive to good health"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schädlich",
                                "target_lang_sense_clarification": "allgemein schädlich für Gesundheit oder Umwelt"
                            },
                            {
                                "target_lang_word": "ungesund",
                                "target_lang_sense_clarification": "nicht förderlich für die Gesundheit"
                            },
                            {
                                "target_lang_word": "schlecht",
                                "target_lang_sense_clarification": "umgangssprachlich für gesundheitsschädlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bd9e6fb-1d91-3a5d-9b64-b3185fe08470",
                    "sense_definition": "Недоброжелательно, с ехидством, злостью или желанием досадить.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "malevolent_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старуха <w>вредно</w> прищурилась и отказалась отвечать на наш вопрос.",
                            "target_lang_translations": {
                                "en": "The old woman squinted <w>spitefully</w> and refused to answer our question.",
                                "de": "Die alte Frau blinzelte <w>boshaft</w> und weigerte sich, unsere Frage zu beantworten."
                            }
                        },
                        {
                            "text": "Он <w>вредно</w> усмехнулся, заметив нашу растерянность.",
                            "target_lang_translations": {
                                "en": "He grinned <w>maliciously</w>, noticing our confusion.",
                                "de": "Er grinste <w>hämisch</w>, als er unsere Verwirrung bemerkte."
                            }
                        }
                    ],
                    "synonyms": [
                        "ехидно",
                        "зло",
                        "недоброжелательно"
                    ],
                    "common_phrases": [
                        "вредно улыбнуться",
                        "вредно хихикать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe spiteful or mischievous behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In a spiteful, malicious, or nasty manner; with intent to annoy.",
                        "de": "Auf eine boshafte, hämische oder unangenehme Weise."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spitefully",
                                "target_lang_sense_clarification": "showing a desire to annoy or hurt"
                            },
                            {
                                "target_lang_word": "maliciously",
                                "target_lang_sense_clarification": "with intent to do harm or cause distress"
                            },
                            {
                                "target_lang_word": "nastily",
                                "target_lang_sense_clarification": "in an unpleasant or unkind way"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "boshaft",
                                "target_lang_sense_clarification": "mit der Absicht, jemandem zu schaden oder zu ärgern"
                            },
                            {
                                "target_lang_word": "hämisch",
                                "target_lang_sense_clarification": "mit schadenfroher oder gehässiger Art"
                            },
                            {
                                "target_lang_word": "bösartig",
                                "target_lang_sense_clarification": "von böser Absicht geleitet"
                            }
                        ]
                    }
                }
            ]
        },
