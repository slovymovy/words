    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9cba4cb2-ffc3-3a67-b636-87b650f6f405",
                    "sense_definition": "A building or place with a stage where plays and shows are performed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "entertainment_venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We dressed up to go to the <w>theatre</w> on Saturday night.",
                            "target_lang_translations": {
                                "ru": "Мы нарядились, чтобы пойти в <w>театр</w> в субботу вечером.",
                                "zh": "周六晚上我们盛装打扮去看了<w>剧院</w>演出。"
                            }
                        },
                        {
                            "text": "The actors met at the <w>theatre</w> for a final rehearsal.",
                            "target_lang_translations": {
                                "ru": "Актеры встретились в <w>театре</w> для генеральной репетиции.",
                                "zh": "演员们在<w>剧院</w>集合进行最后一次排练。"
                            }
                        }
                    ],
                    "synonyms": [
                        "playhouse",
                        "auditorium"
                    ],
                    "common_phrases": [
                        "go to the theatre",
                        "national theatre",
                        "street theatre",
                        "open-air theatre"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British and Commonwealth English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание или место со сценой, где проходят спектакли и представления.",
                        "zh": "用于表演戏剧和演出的建筑物或场所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "театр",
                                "target_lang_sense_clarification": "здание для спектаклей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剧院",
                                "target_lang_sense_clarification": "用于表演戏剧的建筑物"
                            },
                            {
                                "target_lang_word": "戏院",
                                "target_lang_sense_clarification": "用于表演戏剧的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2032f1fa-9de2-3a2d-9f7b-0b746c836f43",
                    "sense_definition": "A building where movies are shown to the public.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment_venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie <w>theatre</w> was packed for the premiere.",
                            "target_lang_translations": {
                                "ru": "<w>Кинотеатр</w> был переполнен на премьере.",
                                "zh": "<w>电影院</w>在首映式时座无虚席。"
                            }
                        },
                        {
                            "text": "They bought popcorn before entering the <w>theatre</w>.",
                            "target_lang_translations": {
                                "ru": "Они купили попкорн перед входом в <w>кинотеатр</w>.",
                                "zh": "他们进<w>电影院</w>之前买了爆米花。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cinema",
                        "movie theater"
                    ],
                    "common_phrases": [
                        "movie theatre"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly North American usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, в котором показывают фильмы для публики.",
                        "zh": "向公众放映电影的建筑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кинотеатр",
                                "target_lang_sense_clarification": "место для просмотра фильмов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电影院",
                                "target_lang_sense_clarification": "放映电影的场所"
                            }
                        ]
                    }
                }
            ]
        }
    ]
