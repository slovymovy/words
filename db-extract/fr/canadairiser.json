                "senses": [
                    {
                        "sense_id": "9849a5f3-1e9b-3595-82fb-74dec72ca163",
                        "entry_id": "915e7d81-0282-3be6-8f44-57e6efaa8255",
                        "glosses": [
                            "Arroser avec un Canadair, avec un bombardier d’eau, pour éteindre un incendie."
                        ],
                        "tags": [
                            "Lutte contre l’incendie"
                        ],
                        "examples": [
                            {
                                "example_id": "3e703727-baa0-49ac-a2d3-df0c3543b23b",
                                "sense_id": "9849a5f3-1e9b-3595-82fb-74dec72ca163",
                                "text": "Rien, répond un pompier qui arrache la capsule d'une bouteille de bière d'un air dégoûté. Rien, sinon continuer. Arroser. Canadairiser. Recommencer."
                            }
                        ]
                    },
                    {
                        "sense_id": "40c4aa5a-6a81-31b4-8c59-8f4eb779b2f5",
                        "entry_id": "915e7d81-0282-3be6-8f44-57e6efaa8255",
                        "glosses": [
                            "Tenter d’éteindre quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca3b72c-feaa-4638-88ee-8c00a3c4179f",
                                "sense_id": "40c4aa5a-6a81-31b4-8c59-8f4eb779b2f5",
                                "text": "Et bien non, ce n'est pas parce que certains ont cherché à karcheriser, que dis-je, à canadairiser le débat sur l'identité nationale, que celui-ci va se laisser éteindre."
                            }
                        ]
                    }
                ],
