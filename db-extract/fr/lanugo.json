                "senses": [
                    {
                        "sense_id": "a0cbb86f-e526-3eb7-a919-a10870a0fe47",
                        "entry_id": "c24ba6e4-4ddc-3d29-b42e-8ce386210ba3",
                        "glosses": [
                            "Duvet qui couvre les zones pileuses du fœtus à partir de la 18^(ème) semaine de gestation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae5e687-95fc-4fbc-b052-245444c25288",
                                "sense_id": "a0cbb86f-e526-3eb7-a919-a10870a0fe47",
                                "text": "Les Xanthodermes et les Amérindiens ont d'ordinaire un corps presque sans poils, de même que beaucoup de Nègres ; mais les Négrilles présentent souvent une persistance du lanugo (ou duvet)."
                            },
                            {
                                "example_id": "ab373555-0217-473a-b597-2653b0a8b9fe",
                                "sense_id": "a0cbb86f-e526-3eb7-a919-a10870a0fe47",
                                "text": "… crevassé de sécheresse, parmi la confusion des hormones et les mots exotiques tels aménorrhée ou lanugo."
                            },
                            {
                                "example_id": "c9111c66-a958-4b57-872f-6ecb66e3b481",
                                "sense_id": "a0cbb86f-e526-3eb7-a919-a10870a0fe47",
                                "text": "Ce duvet – le lanugo – recouvre la peau du fœtus qui le perd, le plus souvent, alors qu'il est encore dans l'utérus. Parfois, il est encore présent à la naissance et il disparaît en quelques jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4d54ef3-c2cd-48a8-b116-ec40ab0cc334",
                        "source_entry_id": "c24ba6e4-4ddc-3d29-b42e-8ce386210ba3",
