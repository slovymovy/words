                        "examples": [
                            {
                                "example_id": "a4d61b79-f2f5-465e-9c4d-998a3b73435a",
                                "sense_id": "7c8984b7-dfb0-3fb7-8711-2f3d19578041",
                                "text": "Kort na het horen van zes schoten werd het nog warme kadaver van de aanstaande moedergans in de vroege meiavond door een buurtbewoner aangetroffen in het weiland, vlak naast haar verlaten nest. „Ze was niet meteen dood na het eerste schot”, weet een getuige."
                            },
                            {
                                "example_id": "cd031f6b-6d66-4577-82b9-81b99809a83c",
                                "sense_id": "7c8984b7-dfb0-3fb7-8711-2f3d19578041",
                                "text": "Hij begon te drinken, ging failliet en werd tot zijn dood onderhouden door zijn familie. Toen hij op een meiavond weer eens dronken thuis kwam, vond hij zijn puberzoon Mattie achter de krant."
                            }
                        ]
