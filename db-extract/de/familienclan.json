                        "examples": [
                            {
                                "example_id": "69a68f50-2b0d-42ec-8cb9-6548ada02200",
                                "sense_id": "3d693aae-b8d0-3b9b-841e-7607be33d1aa",
                                "text": "„Eher kann man sich die kleinen Gemeinschaften der Eisenzeit als Stämme oder Familienclans vorstellen oder als Bewohner verschiedener Siedlungszentren.“"
                            },
                            {
                                "example_id": "ec1b30b4-9d50-4c3b-8623-b6d371aed97f",
                                "sense_id": "3d693aae-b8d0-3b9b-841e-7607be33d1aa",
                                "text": "„Zum Beispiel gehören berühmte Familienclans wie die Legharis, Pitafis, Gurmanis oder Jatoi zur übergeordneten Baloch biraderi.“"
                            }
                        ],
