{
    "word_family": [
        "designate",
        "designator",
        "designative",
        "redesignation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afe74c34-2e18-37be-ae61-fb7e7ce34eb3",
                    "sense_definition": "A name, label, or title used to identify or classify someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The area received a formal <w>designation</w> as a national park last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году эта территория получила официальный <w>статус</w> национального парка."
                            }
                        },
                        {
                            "text": "He preferred the official <w>designation</w> of director rather than manager.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал официальное <w>наименование</w> «директор», а не «менеджер»."
                            }
                        }
                    ],
                    "synonyms": [
                        "indication"
                    ],
                    "common_phrases": [
                        "official designation",
                        "formal designation",
                        "numerical designation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя, ярлык или название, используемое для идентификации или классификации кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обозначение",
                                "target_lang_sense_clarification": "символ или название для идентификации"
                            },
                            {
                                "target_lang_word": "наименование",
                                "target_lang_sense_clarification": "официальное название или титул"
                            },
                            {
                                "target_lang_word": "статус",
                                "target_lang_sense_clarification": "официальная категория или роль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d180cf3-894a-347a-9bbc-2fd7c2f4bdfa",
                    "sense_definition": "The act of choosing or appointing someone for a particular role, office, or purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "appointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>designation</w> as chief justice was controversial among the committee members.",
                            "target_lang_translations": {
                                "ru": "Его <w>назначение</w> на должность верховного судьи вызвало споры среди членов комитета."
                            }
                        },
                        {
                            "text": "The <w>designation</w> of funds by the governor will allow the project to continue.",
                            "target_lang_translations": {
                                "ru": "<w>Выделение</w> средств губернатором позволит продолжить проект."
                            }
                        }
                    ],
                    "common_phrases": [
                        "designation of funds",
                        "designation as leader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт выбора или назначения кого-либо на определенную роль, должность или для определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначение",
                                "target_lang_sense_clarification": "на должность или роль"
                            },
                            {
                                "target_lang_word": "выдвижение",
                                "target_lang_sense_clarification": "предложение кандидатуры"
                            },
                            {
                                "target_lang_word": "распределение",
                                "target_lang_sense_clarification": "выделение ресурсов или средств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b4b10a1-a779-3e29-844c-b61bd0b69a6c",
                    "sense_definition": "The specific meaning or signification of a word, phrase, or symbol.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictionary entry specifies the precise <w>designation</w> of the term in a legal context.",
                            "target_lang_translations": {
                                "ru": "Словарная статья уточняет точное <w>значение</w> термина в юридическом контексте."
                            }
                        },
                        {
                            "text": "Linguists often distinguish between the connotation and the literal <w>designation</w> of a word.",
                            "target_lang_translations": {
                                "ru": "Лингвисты часто проводят различие между коннотацией и буквальным <w>значением</w> слова."
                            }
                        }
                    ],
                    "common_phrases": [
                        "literal designation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical use in linguistics or logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное значение или смысл слова, фразы или символа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "денотат",
                                "target_lang_sense_clarification": "прямое значение в лингвистике"
                            },
                            {
                                "target_lang_word": "обозначение",
                                "target_lang_sense_clarification": "смысловое содержание термина"
                            },
                            {
                                "target_lang_word": "значение",
                                "target_lang_sense_clarification": "буквальный смысл"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}