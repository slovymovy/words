                                        "entry_id": "45c3556d-1815-3dc6-9bd8-7980dcb1c9c1",
                                        "glosses": [
                                            "Commendation; favourable representation in words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ed8718-f299-47e3-b739-772f5c49890f",
                                                "sense_id": "43e35a22-0ce0-3be7-a0df-857e8d91b60c",
                                                "text": "You deserve praise for the hard work you've done recently."
                                            },
                                            {
                                                "example_id": "0f546eca-f11f-43bf-b314-f4d5d88ef8d9",
                                                "sense_id": "43e35a22-0ce0-3be7-a0df-857e8d91b60c",
                                                "text": "She gave them some faint praise for their assignments, despite not being totally convinced by the quality."
                                            },
                                            {
                                                "example_id": "fcc2e709-54b1-4c08-8c10-132dcb750890",
                                                "sense_id": "43e35a22-0ce0-3be7-a0df-857e8d91b60c",
                                                "text": "dim praise"
                                            },
                                            {
                                                "example_id": "da1203f2-d67d-47ca-8a70-8a80a4db636c",
                                                "sense_id": "43e35a22-0ce0-3be7-a0df-857e8d91b60c",
                                                "text": "The writer's latest novel received great praise in the media."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44f364ff-697d-380c-9adb-5cd8b17d65e7",
                                        "entry_id": "45c3556d-1815-3dc6-9bd8-7980dcb1c9c1",
                                        "glosses": [
                                            "worship, glorification, adoration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67565caf-c42b-4648-9c28-ebbf2621e259",
                                                "sense_id": "44f364ff-697d-380c-9adb-5cd8b17d65e7",
                                                "text": "praise of God"
                                            },
                                            {
                                                "example_id": "7b478705-2b45-4ca2-b5a2-75c96c709bc2",
                                                "sense_id": "44f364ff-697d-380c-9adb-5cd8b17d65e7",
                                                "text": "Let every thing that hath breath praise the Lord."
                                            }
                                        ]
                                    }
                                ]
                            },
