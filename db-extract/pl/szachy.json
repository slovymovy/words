                                        "entry_id": "624ee862-aa38-327f-bf85-c8a9ac9ddd65",
                                        "glosses": [
                                            "strategisches Brettspiel für zwei Spieler, Kurzwort für Schachspiel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dcb0b3a-a79f-4023-8cd7-8f4401549447",
                                                "sense_id": "86bc2f91-ea1f-3d4d-94d0-c7d6e8dc4228",
                                                "text": "„Wir begannen unsere Partie Schach aufs Neue.“"
                                            },
                                            {
                                                "example_id": "cb4c3f99-ae10-4005-9c83-c09bf6552eff",
                                                "sense_id": "86bc2f91-ea1f-3d4d-94d0-c7d6e8dc4228",
                                                "text": "Setzten sich dann der Bürgermeister und der Doktor in ihrem Zorn, den sie nicht laut werden lassen durften, zu einer Partie Schach, so rückte der Neffe hinzu, schaute dem Bürgermeister mit seiner großen Brille über die Schulter herein und tadelte diesen oder jenen Zug, sagte dem Doktor, so und so müsse er ziehen, so daß beide Männer heimlich ganz grimmig wurden."
                                            },
                                            {
                                                "example_id": "38f7f17f-0e81-4d64-9537-67cda1cc06a4",
                                                "sense_id": "86bc2f91-ea1f-3d4d-94d0-c7d6e8dc4228",
                                                "text": "„Nun spielten die drei Frauen drei Partien Schach.“"
                                            },
                                            {
                                                "example_id": "8681b95f-8ad6-459f-bf9e-075d0dfbf5e1",
                                                "sense_id": "86bc2f91-ea1f-3d4d-94d0-c7d6e8dc4228",
                                                "text": "„Die hellen Sonnenschirme davor warfen ihre Schatten auf die voll besetzten Tische, an denen zwei ältere Herren Schach spielten und ein paar Frauen ihren Kaffee tranken und in ihrr melodischen Sprache miteinander plauderten .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3063d93-3ae8-3706-8a48-71d1961ac43f",
                                        "entry_id": "624ee862-aa38-327f-bf85-c8a9ac9ddd65",
                                        "glosses": [
                                            "eine Situation im Schachspiel, in welcher ein König direkt bedroht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07975290-35e3-49a5-b62c-5ffd44254537",
                                                "sense_id": "c3063d93-3ae8-3706-8a48-71d1961ac43f",
                                                "text": "Während er mit der Dame Schach bot, sagte er so nebenbei: Der Weg für eine Heirat Lucrezias mit dem Prinzen Este von Ferrara ist frei."
                                            },
                                            {
                                                "example_id": "34772647-ad5c-46c3-82ac-d87c74a8ae99",
                                                "sense_id": "c3063d93-3ae8-3706-8a48-71d1961ac43f",
                                                "text": "„Er mochte diesen Film, weil er zeigte, wie eine Handvoll Briten einen ganzen Kontinent in Schach hielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61bd05f0-7a3d-338a-a2ef-1e068b211f63",
                                        "entry_id": "624ee862-aa38-327f-bf85-c8a9ac9ddd65",
                                        "glosses": [
                                            "nach den Spielregeln nicht mehr vorgeschriebener Ausruf, Ansage von [2]"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51d71054-88a5-3e24-ab91-eb36e238e552",
                                        "entry_id": "03c9e164-976a-32af-a232-1417d9414824",
                                        "glosses": [
                                            "ein deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad1e800a-4814-4f36-b910-31c4cbea515d",
                                                "sense_id": "51d71054-88a5-3e24-ab91-eb36e238e552",
                                                "text": "Ein eintretender Diener meldete den Rittmeister von Schach, und ein Schimmer freudiger Überraschung überflog beide Damen, als der Angemeldete gleich darnach eintrat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
