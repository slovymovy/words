                    {
                        "form_id": "04f36230-b3af-461f-879e-c906d224f94c",
                        "entry_id": "4da93884-bbe7-3fe7-917c-01ae85c57f43",
                        "tags": [
                            "past",
                            "participle"
                        ],
                        "form": "doxed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78d74434-09d6-3c23-91f6-7ed3379ad83c",
                        "entry_id": "4da93884-bbe7-3fe7-917c-01ae85c57f43",
                        "glosses": [
                            "(üblicherweise mit bösartigen, rachsüchtigen Absichten) jemandes personenbezogene Daten zusammentragen und, ohne Zustimmung des Betroffenen, unerlaubterweise im Internet veröffentlichen"
                        ],
                        "tags": [
                            "colloquial",
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7ffef710-b904-4cf7-b010-3a907a5be64a",
                                "sense_id": "78d74434-09d6-3c23-91f6-7ed3379ad83c",
                                "text": "“The posting doxes Moore’s personal information, including date of birth, address, phone number, parents’ names, social networking details, OK Cupid profile, IP addresses, a list of pending lawsuits, and more.”",
                                "translation": "„Das Posting doxt Moores private Daten, darunter Geburtsdatum, Adresse, Telefonnummer, die Namen der Eltern, Details seiner sozialen Vernetzung, [sein] OK Cupid-Profil, IP-Adressen, eine Liste anhängiger Gerichtsverfahren, und mehr.“"
                            },
                            {
                                "example_id": "03584a42-d94e-42cf-b697-d1a3ad83984f",
                                "sense_id": "78d74434-09d6-3c23-91f6-7ed3379ad83c",
                                "text": "“He received death threats, says someone tried to dox him (publish his private information), and he got an email from someone who had his parents’ and brother’s addresses.”",
                                "translation": "„Er erhielt Morddrohungen, sagt, jemand habe versucht, ihn zu doxen (seine privaten Daten zu veröffentlichen), und jemand habe ihm eine E-Mail mit den Adressen seiner Eltern und seines Bruders zugeschickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1338b474-dc04-4b95-99dd-28c5c3e01198",
                        "source_entry_id": "4da93884-bbe7-3fe7-917c-01ae85c57f43",
                        "source_sense_id": "78d74434-09d6-3c23-91f6-7ed3379ad83c",
                        "source_sense_description": "jemandes personenbezogene Daten zusammentragen und, ohne Zustimmung des Betroffenen",
                        "target_lang_word": "doxen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doxen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                        "entry_id": "dba6497b-d97d-30d0-9aea-66b02f7d093e",
                                        "glosses": [
                                            "(üblicherweise mit bösartigen, rachsüchtigen Absichten) jemandes personenbezogene Daten zusammentragen und, ohne Zustimmung des Betroffenen, unerlaubterweise im Internet veröffentlichen"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8496b09-c0d1-41ec-84e2-ceaf4fad1953",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Im Netz heißt es: ‚Wenn Ihr nicht aufhört mit der Scheiße, werden wir Euch doxen, doxen, doxen‘, also immer mehr Daten veröffentlichen.“"
                                            },
                                            {
                                                "example_id": "0ac4f2c3-28e3-4ab6-8834-4e2f283023d9",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Am Ende aber drohen der oder die Autoren: ‚Das war Teil 1. Wenn ihr nicht mit diesem Scheiß aufhört, werden wir weiter doxen.‘ Als ‚doxen‘ wird im Netz das Mobbing durch die Veröffentlichung persönlicher Daten bezeichnet.“"
                                            },
                                            {
                                                "example_id": "4aef110d-388b-4853-bedf-289bbd160406",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Alle Zeitungen haben es veröffentlicht, aber offen gestanden, mich hat keiner gedoxt; andere Autoren, die auch auf der Liste standen, und die ich gefragt habe, wurden auch nicht gedoxt.“"
                                            },
                                            {
                                                "example_id": "a5627e1e-2a8f-44ea-92eb-3935bd048c8f",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Das hielt Leute, die im Namen von Anonymous agieren, nicht davon ab, weitere Personen zu ‚doxen‘, wie sie das Enttarnen nennen.“"
                                            },
                                            {
                                                "example_id": "af9b9554-4933-41c8-ade6-53d16eab775b",
                                                "sense_id": "89806056-f90d-3f04-9486-4d411328e933",
                                                "text": "„Nicht zuletzt haben wir unser Vokabular erweitert: Vor einem Jahr wussten wir weder, was ‚Social Justice Warriors‘ sein könnten, noch was es bedeutet, wenn jemand ‚gedoxt‘ wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
