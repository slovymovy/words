                    },
                    {
                        "translation_id": "5ed63f0f-de93-44e4-be4d-13272d68402a",
                        "source_entry_id": "03feb57e-ca4f-3075-9a78-2852b2cb3012",
                        "source_sense_id": "dd6e7625-28fa-3236-a07b-9b064ef0172f",
                        "target_lang_word": "moulin à prières",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moulin à prières",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "374694be-4b6d-3370-a406-38e29e339e05",
                                        "entry_id": "ebe531df-d60f-39d4-8b13-3162822d57e6",
                                        "glosses": [
                                            "Cylindre, en usage au Tibet, qui renferme des bandes de papier ou d’étoffe recouvertes de prières et qu’on fait tourner pour acquérir le mérite de ces prières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba1b2bbd-ceb1-4b4e-aec4-c2b4e533f837",
                                                "sense_id": "374694be-4b6d-3370-a406-38e29e339e05",
                                                "text": "Nous avons tous entendu parler de l’omniprésent moulin à prière au Tibet. Il suffit de le faire tourner en récitant le mantra (une prière) approprié pour attirer la bienveillance de divinités sur soi, purifier son karma (ses actions) et accumuler du mérite pour une future réincarnation heureuse."
                                            },
                                            {
                                                "example_id": "3233c011-a542-4e48-8367-9352fe503b3d",
                                                "sense_id": "374694be-4b6d-3370-a406-38e29e339e05",
                                                "text": "Le Père Huc a raconté qu'un Mongol ingénieux avait installé un moulin à prières sur une petite chute d'eau, en sorte qu'il gagnait les faveurs du ciel tout en allant à ses petites affaires, et sans perte de temps."
                                            },
                                            {
                                                "example_id": "f6041968-3889-4d4d-a756-b1730816d92c",
                                                "sense_id": "374694be-4b6d-3370-a406-38e29e339e05",
                                                "text": "Elle regarda Tavel lui montrer un moulin à prières rapporté d'une temple japonais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
