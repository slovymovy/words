                                                "sense_id": "2cb571ca-e0be-3b0b-b43e-600ebf0b2fba",
                                                "text": "He plays bingo with his family on Saturdays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfef570e-5759-3982-8f7d-4507a00bea67",
                                        "entry_id": "36c49728-7b9e-3aff-8f5f-601b16ce4f85",
