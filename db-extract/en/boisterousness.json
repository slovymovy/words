                        "target_lang_word": "Ungestümheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "17b9510a-b117-4dc9-9d05-c7caafe69c11",
                        "source_entry_id": "e2200794-0643-33da-b9e3-7cdddbc20ec4",
                        "source_sense_id": "36222a14-f224-3b59-8d62-1528248135f0",
                        "source_sense_description": "characteristic of being boisterous",
                        "target_lang_word": "Ungestüm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungestüm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9834e0-3599-31e5-a89c-f48442d605c2",
                                        "entry_id": "34a32704-291b-3327-98b3-eac9330ffcaa",
                                        "glosses": [
                                            "überraschende, nicht logisch erklärbare Wildheit"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7be3079e-a2d1-4e89-b174-5f19f141b9be",
                                                "sense_id": "7e9834e0-3599-31e5-a89c-f48442d605c2",
                                                "text": "„Biathlet Christoph Stephan trägt mit 23 Jahren schon deutsche WM-Hoffnungen - er muss nur lernen, sein Ungestüm zu bändigen.“"
                                            },
                                            {
                                                "example_id": "6363c1c4-2060-4810-a30e-14c580e17049",
                                                "sense_id": "7e9834e0-3599-31e5-a89c-f48442d605c2",
                                                "text": "„Meine gierigen Hände versuchten nun, sich den Weg überallhin zu bahnen, doch sie entzog sich mir sofort und bat mich so sanft, den Anstand zu wahren, daß ich es für meine Pflicht hielt, nicht nur mein Ungestüm zu zügeln, sondern sie sogar um Verzeihung zu bitten.“"
                                            },
                                            {
                                                "example_id": "424af845-25ad-415d-9ed1-f3d1bf468a12",
                                                "sense_id": "7e9834e0-3599-31e5-a89c-f48442d605c2",
                                                "text": "„Er griff nach der Brille, die durch Annas Ungestüm wegzurutschen drohte.“"
                                            },
                                            {
                                                "example_id": "971ab703-d282-40d1-b259-89f23143ef72",
                                                "sense_id": "7e9834e0-3599-31e5-a89c-f48442d605c2",
                                                "text": "„Er müsse jenseits allen Ungestüms beweisen, dass er wahrhaft liebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
