                "senses": [
                    {
                        "sense_id": "24519d84-1f9c-3021-90da-77a7c95a9fd7",
                        "entry_id": "3a90af7b-50d8-3327-897d-9c6b38c7d0c5",
                        "glosses": [
                            "Flüchtling, der kriegsbedingt seine Heimat Palästina verlassen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e127aceb-bd95-4fe0-a3f9-45ad4004a441",
                                "sense_id": "24519d84-1f9c-3021-90da-77a7c95a9fd7",
                                "text": "„Sie wurde zweien von ihnen vor dem Bundesverfassungsgericht zuteil, freilich mit einer über ihren Fall weit hinaus reichenden Präjudizwirkung. Der Medizinstudent Yacoub M. ist Palästinaflüchtling mit syrischer Staatsangehörigkeit. Er lebte seit 1961 in der Bundesrepublik und arbeitete hier an seiner – inzwischen fertiggestellten – Doktorarbeit, als am 4. September 1972 ein palästinensisches Terrorkommando die israelische Olympiamannschaft in München überfiel.“"
                            },
                            {
                                "example_id": "d33829e0-ca7c-4cd9-b789-3526549f7797",
                                "sense_id": "24519d84-1f9c-3021-90da-77a7c95a9fd7",
                                "text": "„Nach dem Ersten Arabisch-Israelischen Krieg musste der Libanon zahlreiche muslimische Palästinaflüchtlinge aufnehmen. Die muslimische Bevölkerung (Sunniten, Schiiten) und die der Drusen nahm stärker zu als die christliche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
