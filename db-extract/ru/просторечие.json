                "senses": [
                    {
                        "sense_id": "2428fb45-9ff6-39f2-a675-46290a3b1eb5",
                        "entry_id": "0463ad88-1e3c-364a-81f9-1062ade359ab",
                        "glosses": [
                            "An informally spoken idiom that is considered to be non-standard, and associated with the colloquial speech of uneducated urban dwellers. Should not be confused with dialects (говоры), which in Russian are more associated with rural areas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64312daf-005b-4fbf-b2e6-12eea2e8360b",
                                "sense_id": "2428fb45-9ff6-39f2-a675-46290a3b1eb5",
                                "text": "Повели́тельные фо́рмы глаго́ла «е́хать» - е́хай, е́хайте, едь и е́дьте. Они́ прису́щи просторе́чию.",
                                "translation": "The imperative forms of the verb е́хать are е́хай, е́хайте, едь, and е́дьте. They are inherently vernacular.",
                                "english": "The imperative forms of the verb е́хать are е́хай, е́хайте, едь, and е́дьте. They are inherently vernacular."
                            }
                        ]
                    }
                ],
