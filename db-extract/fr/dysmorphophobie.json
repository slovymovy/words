                                        "entry_id": "96d76297-9024-3593-99b4-37e88b822573",
                                        "glosses": [
                                            "krankhafte Angst vor körperlichen Fehlbildungen (Dysmorphien) oder durch reale oder eingebildete körperliche Fehlbildungen aufzufallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519e31a3-75f3-4dfb-8172-ffdf2e196af2",
                                                "sense_id": "8de34b13-0f1c-34f9-92d4-a9ec1c2fcbc4",
                                                "text": "„Woran es liegt, dass das Körperschema im Kopf gestört wird, ist bis heute unklar, obwohl der italienische Neurologe Enrico Morselli schon 1886 Fälle von Dysmorphophobie beschrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
