                "senses": [
                    {
                        "sense_id": "326acfa3-8e67-3354-b1d7-f2a388abfd6d",
                        "entry_id": "87bc1fc3-2ddb-37e7-bdcd-959898181630",
                        "glosses": [
                            "A traditional article of clothing worn in Afghanistan, Bangladesh, India, Pakistan, and Sri Lanka, consisting of a loose, collarless, long-sleeved, knee-length shirt worn by both men and women."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a8be34-328c-4f70-8030-afcaad5d1956",
                                "sense_id": "326acfa3-8e67-3354-b1d7-f2a388abfd6d",
                                "text": "Now her fingers began to unbutton the ivory studs that ran slantwise across the chest of his kurta."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3899668-7340-4c83-8a91-055a9c2f6913",
                        "source_entry_id": "87bc1fc3-2ddb-37e7-bdcd-959898181630",
