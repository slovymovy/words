                    },
                    {
                        "translation_id": "e01c6b0a-5417-4af1-afcf-1593ec373274",
                        "source_entry_id": "a61e0be9-e55d-3a6e-b11c-28384ecddfa2",
                        "target_lang_word": "semáforo",
