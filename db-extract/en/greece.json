                                "target_senses": [
                                    {
                                        "sense_id": "0fa06462-2816-39af-a6b9-14580833bf46",
                                        "entry_id": "27eec08f-fc60-357f-8e0d-9cedaac00d3d",
                                        "glosses": [
                                            "Staat in Südosteuropa, im Süden der Balkanhalbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2725b374-41df-457a-9310-03ddf003e5f8",
                                                "sense_id": "0fa06462-2816-39af-a6b9-14580833bf46",
                                                "text": "Griechenland besteht aus über 9840 Inseln."
                                            },
                                            {
                                                "example_id": "495f1c55-733a-46d5-95db-0aa6dac0621f",
                                                "sense_id": "0fa06462-2816-39af-a6b9-14580833bf46",
                                                "text": "Athen ist die Hauptstadt von Griechenland."
                                            },
                                            {
                                                "example_id": "f2bc0337-c2ed-4d44-af03-5785c57f395d",
                                                "sense_id": "0fa06462-2816-39af-a6b9-14580833bf46",
                                                "text": "„Die Beziehungen Griechenlands zu den Ländern Südosteuropas können heute weitgehend als ausgeglichen betrachtet werden.“"
                                            },
                                            {
                                                "example_id": "bb4bdcf1-fa39-4b3d-946d-054a899f438e",
                                                "sense_id": "0fa06462-2816-39af-a6b9-14580833bf46",
                                                "text": "„Auch unternahm er eine Bildungsreise nach Griechenland und Kleinasien.“"
                                            },
                                            {
                                                "example_id": "f7580272-d761-4d31-b9ad-4e129d35d2fa",
                                                "sense_id": "0fa06462-2816-39af-a6b9-14580833bf46",
                                                "text": "„Nur im Urlaub in Volos habe ich es trotzdem getan, weil der Vergleich mit dem deutschen Mistwetter die Reise nach Griechenland normalerweise zu einem ganz besonderen Erlebnis macht.“"
                                            },
                                            {
                                                "example_id": "085fc75e-4402-48bc-8476-6f66c8dc7d91",
                                                "sense_id": "0fa06462-2816-39af-a6b9-14580833bf46",
                                                "text": "„Das Griechenland der beginnenden Eisenzeit war viel dünner besiedelt als das der mykenischen Palastzeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
