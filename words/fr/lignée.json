                    "frequency": "Middle",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est le dernier descendant d'une longue <w>lignée</w> d'artisans menuisiers."
                        },
                        {
                            "text": "Ce jeune souverain souhaite perpétuer la <w>lignée</w> de ses ancêtres sur le trône."
                        }
                    ],
                    "synonyms": [
