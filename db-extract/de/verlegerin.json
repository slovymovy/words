                "senses": [
                    {
                        "sense_id": "5f832fc4-4953-32a5-8071-540e2ec8cc23",
                        "entry_id": "d57506a4-acd1-337a-ac14-335255f5ccd2",
                        "glosses": [
                            "weibliche Person, die einen Verlag betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86e8447a-5478-4990-b404-0931ebbdbd57",
                                "sense_id": "5f832fc4-4953-32a5-8071-540e2ec8cc23",
                                "text": "Nachdem sie als Verlegerin keinen Erfolg hatte, wurde sie Börsenmaklerin."
                            },
                            {
                                "example_id": "b1d21cb2-cc49-4ed3-95db-dda67c3be6da",
                                "sense_id": "5f832fc4-4953-32a5-8071-540e2ec8cc23",
                                "text": "„Und obgleich mein Buch 1936 endet, knapp zwanzig Jahre nach seinem Beginn, weil ich fand, dass es Sylvias Geschichte als Buchhändlerin und Verlegerin auf sehr befriedigende Weise schildert, lebte sie noch viele Jahre in Paris, bis sie 1962 mit fünfundsiebzig starb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9164beb-3333-4682-9a67-1f3f6207aa5c",
                        "source_entry_id": "d57506a4-acd1-337a-ac14-335255f5ccd2",
                        "source_sense_id": "5f832fc4-4953-32a5-8071-540e2ec8cc23",
                        "source_sense_description": "weibliche Person, die einen Verlag betreibt",
                        "target_lang_word": "éditrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éditrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1582184-9fdd-3bda-a474-5f45c323cc64",
                                        "entry_id": "1eec1166-2165-3064-86a7-af25e96790a1",
                                        "glosses": [
                                            "Femme ou organisation, industrielle ou artisanale, qui imprime et diffuse des livres, des journaux, etc., ou qui édite des logiciels."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "330bc93c-4150-479c-8974-5dbaf605b655",
                                                "sense_id": "f1582184-9fdd-3bda-a474-5f45c323cc64",
                                                "text": "« La commune d’Uccle, c’est le bien-vivre ensemble, l’intégration par le bon exemple », explique Véronique de Montfort, éditrice, habitante et native de cette sorte de grand arrondissement situé au sud de Bruxelles où vivent 8 000 Français, soit 10 % de la population totale."
                                            },
                                            {
                                                "example_id": "92de433c-251e-462c-af26-ba694bd23437",
                                                "sense_id": "f1582184-9fdd-3bda-a474-5f45c323cc64",
                                                "text": "Mercredi 2 décembre, la requête en référé déposée par les opposants au permis de construire accordé à l’agriculteur yvelinois, dont fait partie l’éditrice Odile Jacob, sera examinée au tribunal administratif de Versailles."
                                            },
                                            {
                                                "example_id": "77b570df-f873-4044-a17b-19caa4540bcb",
                                                "sense_id": "f1582184-9fdd-3bda-a474-5f45c323cc64",
                                                "text": "Dans un texte publié dans Le Monde jeudi, plus de 400 écrivaines, éditrices et enseignantes-chercheuses, dont Annie Ernaux, prix Nobel de littérature 2022, Vanessa Springora et Camille Kouchner, alertent sur « la persistance des agressions sexuelles et des viols dans le monde littéraire et les études de lettres »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816ea8d2-bb0f-318f-811b-853d3d7d1576",
                                        "entry_id": "1eec1166-2165-3064-86a7-af25e96790a1",
                                        "glosses": [
                                            "Celle qui établit le texte d’une œuvre donnée (dont elle n’est pas l’autrice, et qui souvent est ancienne), sur la base de manuscrits ou tapuscrits originaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
