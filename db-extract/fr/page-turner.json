                        "entry_id": "c7c861ac-be47-3db9-b015-b628baacb2d7",
                        "glosses": [
                            "Livre captivant, passionnant."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "961fcfc4-179b-467c-9b8a-a54dbc7f305c",
                                "sense_id": "f838a506-e078-39a1-8be4-97406514f249",
                                "text": "Ce page-turner vous accaparera dès que vous l’aurez commencé."
                            },
                            {
                                "example_id": "a523b603-5e83-4148-b8d2-d23ac319f1ab",
                                "sense_id": "f838a506-e078-39a1-8be4-97406514f249",
                                "text": "Aujourd’hui, je vous propose de vous éclairer un peu sur une expression anglophone que l’on commence à utiliser en France : le page-turner. Littéralement « tourneur de pages », le page-turner est une expression qui sert à qualifier un livre particulièrement haletant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5525388-6940-4417-a61e-544a77f0d948",
                        "source_entry_id": "c7c861ac-be47-3db9-b015-b628baacb2d7",
                        "source_sense_id": "f838a506-e078-39a1-8be4-97406514f249",
                        "source_sense_description": "Livre captivant",
                        "target_lang_word": "page-turner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "page-turner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "123b103d-d5cf-32a2-be47-2a7807988acb",
                                        "entry_id": "c5201f01-f09f-3ea4-b2b7-ec6e7e543530",
                                        "glosses": [
                                            "A highly interesting or suspenseful written work that one is compelled to read very rapidly."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edd6006b-ec0e-467f-b54d-1983edcd69fd",
                                                "sense_id": "123b103d-d5cf-32a2-be47-2a7807988acb",
                                                "text": "Her debut novel is such a page-turner that it's one of those books that you can't put down."
                                            },
                                            {
                                                "example_id": "62f2f684-dbf0-49ac-b39d-0d322fc0a57d",
                                                "sense_id": "123b103d-d5cf-32a2-be47-2a7807988acb",
                                                "text": "This is a very fat novel. The first thing you want to do with it is send it to a hospital for one of those crisis diets. Cut out 300 pages and maybe you've got a page-turner that could stand off \"The Firm.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f71beae8-75c9-3de3-9e36-107edd6dd0e7",
                                        "entry_id": "c5201f01-f09f-3ea4-b2b7-ec6e7e543530",
                                        "glosses": [
                                            "A person who is responsible for turning the pages of another musician’s (especially a pianist or organist’s) sheet music during a performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c782459-2082-4be4-9a26-2b00a0c72652",
                                                "sense_id": "f71beae8-75c9-3de3-9e36-107edd6dd0e7",
                                                "text": "She's a famous soloist today, but she did her time as a page-turner, just as many others have done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf1a413b-daa5-3be8-b9f4-1db4edc1fcce",
                                        "entry_id": "c5201f01-f09f-3ea4-b2b7-ec6e7e543530",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see page, turner."
                                        ],
                                        "tags": [],
