                                            {
                                                "example_id": "52ad5af8-f589-4bc2-a57a-4bf22c3073d9",
                                                "sense_id": "b1f04706-a4bb-3a71-91a0-4885f8ca9c4c",
                                                "text": "Durch seine wuchtige Schlagkraft erzielte er bereits in der zweiten Runde einen K.-o.."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad33835d-45b9-316d-922b-eb8f3ed6802a",
