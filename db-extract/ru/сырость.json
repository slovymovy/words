                        ],
                        "form": "сы́рости"
                    },
                    {
                        "form_id": "7e3324ac-65a8-4238-aa7c-aad9a3b42538",
                        "entry_id": "f6f8b625-6a9f-37c9-a000-09981b5d7c21",
                        "tags": [
