                "senses": [
                    {
                        "sense_id": "f1d6890c-1148-3ca0-83d4-be64fc63eace",
                        "entry_id": "b7b714d7-3414-331f-bc72-5d26ee80bfc9",
                        "glosses": [
                            "Déterminer la position géographique où se trouve (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aabfb26e-c3c6-4c3b-bf78-c6bf8a7d5455",
                                "sense_id": "f1d6890c-1148-3ca0-83d4-be64fc63eace",
                                "text": "Le framework Android dispose d’un ensemble de classes et de services permettant de géo-localiser le terminal."
                            },
                            {
                                "example_id": "a6bfc317-6c3b-47f2-b7a8-80de1eef5b4e",
                                "sense_id": "f1d6890c-1148-3ca0-83d4-be64fc63eace",
                                "text": "Quels que soient les motifs, de nouvelles habitudes s’installent aidées en cela par les moyens technologiques qui permettent de se géo-localiser."
                            },
                            {
                                "example_id": "63f0abe6-368c-40e4-93a9-c0025ad163e0",
                                "sense_id": "f1d6890c-1148-3ca0-83d4-be64fc63eace",
                                "text": "Astrosat-A se synchronise et se géo-localise automatiquement à la première mise en service."
                            }
                        ]
                    }
