                    },
                    {
                        "translation_id": "f69c2651-dcb8-45cd-9f0b-c3d9faa7072b",
                        "source_entry_id": "8755117d-511d-30d3-8314-49cd6ec71827",
                        "source_sense_description": "isomeric aliphatic hydrocarbons",
                        "target_lang_word": "octane",
                        "target_lang_code": "fr",
