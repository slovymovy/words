                            "comment": "Used historically or in literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Sürekli kusur bulan ve başkalarını öfkeyle azarlayan kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dırdırcı kimse",
