                "senses": [
                    {
                        "sense_id": "784b907f-1699-3784-924d-9b4368cb6ed8",
                        "entry_id": "e6759148-2f60-38db-a942-07686b625c21",
                        "glosses": [
                            "обращение или форма вежливого упоминания по отношению к девушке или к молодой незамужней женщине, обычно присоединяемое к фамилии или имени"
                        ],
                        "tags": [
                            "в англоязычных странах"
                        ],
                        "examples": [
                            {
                                "example_id": "ea5a54bd-99c4-4aac-9772-b21cfcb5ce41",
                                "sense_id": "784b907f-1699-3784-924d-9b4368cb6ed8",
                                "text": "— Не знаю, — сказала она. — Она не велела учиться, а велела итти гулять с мисс Гуль к бабушке."
                            }
                        ]
                    },
                    {
                        "sense_id": "b81e0dff-0f73-3e14-8061-c16d2b9eb0ff",
                        "entry_id": "e6759148-2f60-38db-a942-07686b625c21",
                        "glosses": [
                            "англичанка-воспитательница, гувернантка"
                        ],
                        "tags": [
                            "в буржуазно-дворянском быту дореволюционной России"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "26bff19b-a465-301e-aa22-0a102b29914f",
