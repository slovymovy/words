                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5fe0287-95b5-4d5a-8bf2-72edeb25ed43",
                        "source_entry_id": "bf76bb2a-4c62-3d6c-8c15-36796761e4c8",
                        "source_sense_description": "act of perpetrating",
                        "target_lang_word": "Begehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                        "entry_id": "5e63ecd8-0db5-3ee4-834e-f83d1308b7b8",
                                        "glosses": [
                                            "das Betreten/Begehen (und Besichtigen) einer Fläche oder auch eines Raumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e2c7802-b59e-437c-8cba-6402b6531322",
                                                "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                                "text": "Die Begehung der Freiflächen um das Klärwerk, also die Geruchsbegehung, erfolgte vom TüV genau in der Windschneise Richtung Neubaugebiet, aus der die Klagen zur Geruchsbelästigung stammen."
                                            },
                                            {
                                                "example_id": "4592281c-30ed-41e7-b6c4-8220bc817d94",
                                                "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                                "text": "Bei der Begehung der Räume stellte sich heraus, dass die Fenster der Räume zu wenig Sonnenlicht einlassen und viel zu dunkel sind."
                                            },
                                            {
                                                "example_id": "fbcb2cf4-9f67-4d3c-8aca-239017d6c128",
                                                "sense_id": "dbbae6cf-f982-3728-8693-1c4a6491d12b",
                                                "text": "„Alex Honnold, der wohl beste Freikletterer der aktuellen Kletterer-Generation hat sich im Sommer 2017 geistig und körperlich auf die Begehung der 975 Meter hohen Route ‚Freerider’ am El Capitan allein und ohne jegliche Hilfsmittel vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76e7200b-c3f7-3d1f-824a-c3b844a37d81",
                                        "entry_id": "5e63ecd8-0db5-3ee4-834e-f83d1308b7b8",
                                        "glosses": [
                                            "Durchführung eines Festaktes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05f1db8-b697-48fc-8d9c-099313f3631b",
                                                "sense_id": "76e7200b-c3f7-3d1f-824a-c3b844a37d81",
                                                "text": "Es fand eine öffentliche Feier zur Begehung des Todestages statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9db1c8ab-3ac5-33fc-a4a6-a4e6a58df788",
                                        "entry_id": "5e63ecd8-0db5-3ee4-834e-f83d1308b7b8",
                                        "glosses": [
                                            "Realisierung einer verbotenen Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2530d64c-353d-4c6b-b1d1-86a45637124f",
                                                "sense_id": "9db1c8ab-3ac5-33fc-a4a6-a4e6a58df788",
                                                "text": "Die Begehung der Tat geschah unter Drogeneinfluss."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaafd980-4d9f-4779-bf92-6cbde884b504",
                        "source_entry_id": "bf76bb2a-4c62-3d6c-8c15-36796761e4c8",
                        "source_sense_description": "act of perpetrating",
                        "target_lang_word": "Verübung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb1f4d7d-610f-4873-8f93-e2a430ec93ee",
                        "source_entry_id": "bf76bb2a-4c62-3d6c-8c15-36796761e4c8",
                        "source_sense_description": "act of perpetrating",
                        "target_lang_word": "Täterschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Täterschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "953b05ec-23aa-37a7-be61-c34516d01b78",
                                        "entry_id": "813928b7-2672-3e57-ad13-5099d7c37f25",
                                        "glosses": [
                                            "Tatsache, dass jemand eine vorwerfbare Tat begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f94716-bbe2-40d7-9a83-39a424f3b833",
                                                "sense_id": "953b05ec-23aa-37a7-be61-c34516d01b78",
                                                "text": "„Fragen von Täterschaft, Schuld und Mitläufertum sind in diesem Buch bislang wenig thematisiert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee6c32cb-d9c1-436c-8760-2f3fbb7b0c9e",
                        "source_entry_id": "bf76bb2a-4c62-3d6c-8c15-36796761e4c8",
                        "source_sense_description": "something that is perpetrated",
                        "target_lang_word": "Vergehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcadf59a-f718-3b2f-ae86-cc6f171c4123",
                                        "entry_id": "2af1369e-09c6-3d53-bde6-b011797cca2c",
                                        "glosses": [
                                            "eine Handlung, die gegen die Moral oder gegen das Gesetz verstößt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec22f99f-331f-4437-85a7-15fbf335484e",
                                                "sense_id": "bcadf59a-f718-3b2f-ae86-cc6f171c4123",
                                                "text": "»Er kann sie nicht ansprechen, dachte ich, das ist hier nicht üblich, das ist nirgendwo üblich, aber hier ist es ein unverzeihliches Vergehen«."
                                            },
                                            {
                                                "example_id": "a7723242-7c79-4d7b-a7d9-daf6f42e6876",
                                                "sense_id": "bcadf59a-f718-3b2f-ae86-cc6f171c4123",
                                                "text": "„Er wußte zwar noch nicht, wessen man den Methodisten beschuldigte, aber dessen rätselhaftes Betragen verriet zu deutlich, wie er sich irgendeines Vergehens bewußt sein mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7860af36-42ce-3658-b8b0-72e966a8d469",
                                        "entry_id": "2af1369e-09c6-3d53-bde6-b011797cca2c",
                                        "glosses": [
                                            "Straftat, die im Mindestmaß mit Geldstrafe oder Freiheitsstrafe von unter einem Jahr bedroht ist (§ 12 II StGB)"
                                        ],
                                        "tags": [
                                            "deutsches Strafrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3819427f-da76-46fd-8594-5a49c862cd3d",
                                                "sense_id": "7860af36-42ce-3658-b8b0-72e966a8d469",
                                                "text": "Die gefährliche Körperverletzung gemäß § 224 StGB ist ein Vergehen."
                                            },
                                            {
                                                "example_id": "6d1181bf-f71b-4e9f-a026-136d6c82b6bd",
                                                "sense_id": "7860af36-42ce-3658-b8b0-72e966a8d469",
                                                "text": "„Der Versuch eines Verbrechens ist stets strafbar, der Versuch eines Vergehens nur dann, wenn das Gesetz es ausdrücklich bestimmt.“"
                                            },
                                            {
                                                "example_id": "41add50b-a12c-4d1e-984c-5534da94b082",
                                                "sense_id": "7860af36-42ce-3658-b8b0-72e966a8d469",
                                                "text": "„Von all diesen Dingen wäre, glaube ich, heute nur noch das Vergehen als Tierquälerei zu ahnden.“"
                                            },
                                            {
                                                "example_id": "4fadacd7-6c99-4460-834c-e7e04cf101f3",
                                                "sense_id": "7860af36-42ce-3658-b8b0-72e966a8d469",
                                                "text": "„Gegen die Hundehalterin wurde ein Strafverfahren wegen eines Vergehens nach dem Tierschutzgesetz eingeleitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
