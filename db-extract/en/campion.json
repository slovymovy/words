                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4d6c1d-d084-4309-8f54-4959fd93286b",
                                                "sense_id": "3c954d59-2db9-3799-880b-351e631af8cc",
                                                "text": "V podrostu se ukrývali dva bažantí kohoutci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac2dc52-45a9-3076-810e-ee1e9d1316fa",
                                        "entry_id": "b07cec47-a7c3-3099-ac55-948692db88a0",
                                        "glosses": [
                                            "druh účesu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef71b494-6f5a-4536-b302-abe62599df04",
                                                "sense_id": "3ac2dc52-45a9-3076-810e-ee1e9d1316fa",
                                                "text": "Petruška nosila vlasy učesané na kohoutka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
