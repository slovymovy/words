                        ],
                        "form": "apsides"
                    },
                    {
                        "form_id": "698b6afc-3b41-4e0a-9efb-046873ccfeb5",
                        "entry_id": "1e971080-ee8d-36de-9e30-fc26be99f222",
                        "tags": [
                            "plural"
                        ],
                        "form": "apses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2efbf46a-f6b6-3683-a6e2-0ed671b47b92",
                        "entry_id": "1e971080-ee8d-36de-9e30-fc26be99f222",
                        "glosses": [
                            "A recess or projection, with a dome or vault, at the east end of a church; an apse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7a87e4-6e49-4461-ae20-194e2c923308",
                                "sense_id": "2efbf46a-f6b6-3683-a6e2-0ed671b47b92",
                                "text": "Like Henry's collegiate church […] the cathedral is a cruciform basilica of the double bay system with four square bays in the central nave, western transoms, a quadrum for the choir, an apsis, and a transept with auxiliary apses."
                            }
                        ]
                    },
                    {
                        "sense_id": "9881e2a9-42d3-34a5-9489-801f02e27d2f",
                        "entry_id": "1e971080-ee8d-36de-9e30-fc26be99f222",
                        "glosses": [
                            "Either of the points in the elliptical orbit of a planet, comet, or moon where it is closest or furthest from the body it orbits; examples are perihelion, aphelion, perigee, and apogee"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e020133-d1b4-4b78-a571-44c364630fa7",
                        "source_entry_id": "1e971080-ee8d-36de-9e30-fc26be99f222",
                        "source_sense_description": "architecture: apse",
                        "target_lang_word": "abside",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abside",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90909f08-6804-3859-b97a-d45d9a99e575",
                                        "entry_id": "4dd4f10e-c05b-3cec-9b51-5a3bca5c1fec",
                                        "glosses": [
                                            "Tribune ou grande niche surmontée d’une voûte qui terminait les basiliques antiques, décrite par les premiers écrivains chrétiens."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6688697a-650c-35b9-a985-2e8181b0e7ca",
                                        "entry_id": "4dd4f10e-c05b-3cec-9b51-5a3bca5c1fec",
                                        "glosses": [
                                            "Extrémité d’une église, derrière le chœur, de forme arrondie en hémicycle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fb175ba-1f4b-4ecb-acbc-228eb4a88475",
                                                "sense_id": "6688697a-650c-35b9-a985-2e8181b0e7ca",
                                                "text": "En traversant le bourg de Garchy, on s'arrête pour jeter un coup-d’œil sur l’abside à pans coupés de son église, et pour considérer l’entablement garni de têtes de clous et soutenu par des modillons ornés de feuilles de fantaisie et de figures bizarres d'animaux."
                                            },
                                            {
                                                "example_id": "a48c0cf0-24c5-4234-853d-8cc1ef9ea4b2",
                                                "sense_id": "6688697a-650c-35b9-a985-2e8181b0e7ca",
                                                "text": "Mon espace à moi, c’était celui qui s’étendait du portail à l’abside; ma liberté, c’était de rêver, pendant deux heures, à genoux sur une tombe ou accoudé à une colonne."
                                            },
                                            {
                                                "example_id": "4ba8e518-8e2f-4eeb-b4b6-dd22e8ffd33a",
                                                "sense_id": "6688697a-650c-35b9-a985-2e8181b0e7ca",
                                                "text": "On entendait Jean qui sanglotait hystériquement dans l’abside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b572e3a3-bcc8-3b29-9e74-468db1a4e0ca",
                                        "entry_id": "4dd4f10e-c05b-3cec-9b51-5a3bca5c1fec",
                                        "glosses": [
                                            "Voûte, partie semi-circulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb648153-ca9c-4765-b34e-3299a075b800",
                                                "sense_id": "b572e3a3-bcc8-3b29-9e74-468db1a4e0ca",
                                                "text": "Cette église se compose d’une nef […], et d’un transept avec abside et chapelles, datant du commencement du XIVᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c83018a-4bca-4ee5-9ec9-f1d75fcb78ca",
                        "source_entry_id": "1e971080-ee8d-36de-9e30-fc26be99f222",
                        "source_sense_description": "architecture: apse",
                        "target_lang_word": "Apsis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apsis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                        "entry_id": "fe3e94ef-b741-3c04-b00e-590fd9c9f836",
                                        "glosses": [
                                            "halbrunde oder polygonale Altarnische in einem Tempel beziehungsweise einer Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b00fa5-75a4-4f86-939f-ac1eb3d57977",
                                                "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                                "text": "Bei christlichen Kirchen zeigt die Apsis meist gen Osten."
                                            },
                                            {
                                                "example_id": "c99ca262-809e-4fa3-91e0-b46d631cc4f3",
                                                "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                                "text": "„Sie habe, so hieß es, die Apsis mit merkwürdigen Tönen erfüllt.“"
                                            },
                                            {
                                                "example_id": "3e8925b7-9ad6-4e87-932a-6e7093cd1526",
                                                "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                                "text": "„Robert, der langsam in Richtung auf die Apsis durch die Leere des Längsraums geschritten war, sah sich unvermutet an der Stelle, wo ein breit ausladendes Querschiff die Raumanlage kreuzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e29be94-0da1-3116-bafd-2212576cd43a",
                                        "entry_id": "fe3e94ef-b741-3c04-b00e-590fd9c9f836",
                                        "glosses": [
                                            "in einem Zelt eine halbrunde Einbuchtung, Vertiefung in einer Wand, in der Gepäck verstaut werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de48ace4-4570-32f6-8911-1a6cde686725",
                                        "entry_id": "fe3e94ef-b741-3c04-b00e-590fd9c9f836",
                                        "glosses": [
                                            "Scheitelpunkt einer (elliptischen) Umlaufbahn eines Himmelskörpers"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2240830e-6bb3-4107-b73c-14505e6f3719",
                                                "sense_id": "de48ace4-4570-32f6-8911-1a6cde686725",
                                                "text": "Die Apsiden der Planetenbahnen nennt man Perihel und Aphel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
