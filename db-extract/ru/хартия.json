                                        "glosses": [
                                            "A special privilege, immunity, or exemption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e35d9e1-edf3-4d36-ba44-03f8e119e187",
                                                "sense_id": "ee033f74-1d2e-3cf9-8716-d035b4dcadfe",
                                                "text": "My mother, / Who has a charter to extol her blood, / When she does praise me, grieves me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b12216-a8c2-313c-a970-2800eaa4b68f",
                                        "entry_id": "c2268e59-5e13-35d6-bf4b-b604086f7cb8",
                                        "glosses": [
                                            "a provision whose unintended consequence would be to encourage an undesirable activity"
                                        ],
                                        "tags": [
                                            "UK",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc981512-57c6-4563-b35b-876c8f1e7024",
                                                "sense_id": "28b12216-a8c2-313c-a970-2800eaa4b68f",
                                                "text": "In what Derbyshire police say amounts to a \"thieves' charter,\" three judges ruled that because the car's identity had been changed it was impossible to trace the legal owner and therefore the person found in possession of it was entitled to keep it."
                                            }
