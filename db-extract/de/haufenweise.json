                        "target_lang_word": "en veux-tu en voilà",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en veux-tu en voilà",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67f181f4-0716-35c8-b654-7f303da347bb",
                                        "entry_id": "893475fd-5a68-334b-8747-e7856c2b46b5",
                                        "glosses": [
                                            "Autant que l’on veut, en grande quantité, à profusion."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79fbd0a5-6f82-4d32-88fb-dddd674b03d5",
                                                "sense_id": "67f181f4-0716-35c8-b654-7f303da347bb",
                                                "text": "M. Poiret qui avoit prévu cette défection avoit amené avec lui des prêtres en veux-tu, en voilà."
                                            },
                                            {
                                                "example_id": "c0920b82-0f3c-4086-9643-3ede6f51b4d3",
                                                "sense_id": "67f181f4-0716-35c8-b654-7f303da347bb",
                                                "text": "On brûla de la poudre, on déchargea des pétarades en veux-tu ? eh ! en voilà ! Nul n’en souffrit, que les moineaux."
                                            },
                                            {
                                                "example_id": "07dfb10e-4d5c-4280-8ecf-2d222fe0981c",
                                                "sense_id": "67f181f4-0716-35c8-b654-7f303da347bb",
                                                "text": "De loin en loin des arcs de triomphe s’élevaient, en veux-tu ? en voilà ! avec le nom, le monogramme ou l’emblème de Saint Jean inscrits dans une auréole ou dans une étoile."
                                            },
                                            {
                                                "example_id": "832f2a8d-f7bc-4222-a98a-341804fd116b",
                                                "sense_id": "67f181f4-0716-35c8-b654-7f303da347bb",
                                                "text": "– J’ai soigné plus de vingt cholériques, j’ai lavé des cadavres en veux-tu en voilà. Je suis encore sur mes deux pattes."
                                            },
                                            {
                                                "example_id": "36d3368c-6772-4bbb-b73f-2a8caeb88aa0",
                                                "sense_id": "67f181f4-0716-35c8-b654-7f303da347bb",
                                                "text": "Nous avons bouffé du kilomètre en veux-tu en voilà jusqu’à l’écœurement."
                                            },
                                            {
                                                "example_id": "f5de0621-bfee-4752-abcc-76bc5451640c",
                                                "sense_id": "67f181f4-0716-35c8-b654-7f303da347bb",
                                                "text": "Il ne se rendait pas compte qu’il agaçait notre tante avec ses « sublimes » donnés en veux-tu en voilà."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
