                                        "entry_id": "1f5e1d62-aaa5-3a5a-93ca-324a59b4720a",
                                        "glosses": [
                                            "Alternative form of ichthyosaur."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d04eee5f-68d2-4b03-90f7-342a056b0beb",
                                                "sense_id": "8332f7f8-91ef-3a97-8653-a2d053540c29",
                                                "text": "A deadened burst of mighty splashes and snorts reached us from afar, as though an ichthyosaurus had been taking a bath of glitter in the great river."
                                            }
                                        ]
                                    },
