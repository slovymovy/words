                    "sense_definition": "gebiedende wijs van <w>komen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kom</w> hier en help me even met deze zware tassen.",
