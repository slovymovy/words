                    {
                        "translation_id": "1b8cb31f-a227-4357-802e-446f5863b927",
                        "source_entry_id": "34c7820f-e111-3dd4-98f8-29dd253dd708",
                        "source_sense_id": "5c251c71-1cdb-365f-9917-1b305c246fd1",
                        "target_lang_word": "Zither",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zither",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                        "entry_id": "d0e0b02f-f3e6-3644-b3f3-e830d47b3c2f",
                                        "glosses": [
                                            "Saiteninstrument, dessen Saiten mit beiden Händen gezupft werden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c50f298-ef18-4698-b9aa-9e751ed64515",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "In der alpenländischen Volksmusik wird oft die Zither gespielt."
                                            },
                                            {
                                                "example_id": "dec7a981-6130-4004-b379-398949becddb",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„Meine Mutter wachte über das Wohlergehen der Zither strenger als über das Wohlergehen ihrer Nähmaschine.“"
                                            },
                                            {
                                                "example_id": "96c0fdd0-4e40-452e-be33-dd5a0159d6cd",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„Als die Truppe abgetreten war, spielten und sangen die beiden Musiker Li Ming und Wu Hwe, der eine zur Zither, der andere zur Laute.“"
                                            },
                                            {
                                                "example_id": "ecb0ac50-fd31-45aa-8f57-c2544584047a",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„Ein Mädchen spielte Zither darauf, und ein Jäger beugte sich über sie.“"
                                            },
                                            {
                                                "example_id": "3e8d6689-91a9-4d5c-b126-0e04d3670009",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„In einem kleinen Café, in dem eine alte Frau Zither spielte, bestellten wir Wein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
