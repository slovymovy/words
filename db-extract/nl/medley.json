                "senses": [
                    {
                        "sense_id": "4085eef5-28f2-31cf-8ac2-cf11cb9fff72",
                        "entry_id": "a9335c9c-d884-3054-9e22-845909b92990",
                        "glosses": [
                            "een muziekstuk waarin delen van veel verschillende liedjes verwerkt zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058ef9bb-7207-4c00-8f9e-ddae9b82ddc3",
                                "sense_id": "4085eef5-28f2-31cf-8ac2-cf11cb9fff72",
                                "text": "Belle Perez won de Zomerhit al vijf keer: in 2002, 2003, 2004, 2005 en 2006. Ze is de artieste die het vaakst de titel kreeg. Daarom opende zij de show met een medley van haar vijf winnende nummers."
                            },
                            {
                                "example_id": "645d5bd1-1676-4e72-b3e2-bacf668c5e5c",
                                "sense_id": "4085eef5-28f2-31cf-8ac2-cf11cb9fff72",
                                "text": "Het is niet de eerste keer dat Ann een creatieve compositie van meerdere melodieën in elkaar sleutelt. De afgelopen weken uploadde hij medleys van onder meer DJ Snake, Adele, Skrillex en Justin Bieber. In dit filmpje is te zien hoe Ann in drie minuten stukken speelt uit zes nummers van boyband One Direction."
                            }
                        ]
                    }
