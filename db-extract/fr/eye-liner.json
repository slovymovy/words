                "senses": [
                    {
                        "sense_id": "b156aea3-262c-3c54-8e6d-d7d6154b25ae",
                        "entry_id": "51c13d6b-f667-3ac3-822e-8ba262cd6994",
                        "glosses": [
                            "Maquillage sombre (de khôl noir, le plus souvent) pour souligner le contour des yeux."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "1098280b-43ff-43ca-8581-e96a7ee78977",
                                "sense_id": "b156aea3-262c-3c54-8e6d-d7d6154b25ae",
                                "text": "Des yeux fardés d'un eye-liner noir."
                            },
                            {
                                "example_id": "345ba679-992f-463a-a2ea-5fcfdc7a3adb",
                                "sense_id": "b156aea3-262c-3c54-8e6d-d7d6154b25ae",
                                "text": "Le sillon gris, sous une paupière, provenait de la débâcle de l'« eye-liner »."
                            },
                            {
                                "example_id": "c3848a95-0123-4df2-82e7-0238be2bd61f",
                                "sense_id": "b156aea3-262c-3c54-8e6d-d7d6154b25ae",
                                "text": "Je n’avais oublié ni ses longs cheveux de jais ni ses grands yeux soulignés d’un épais trait d’eye-liner noir."
                            },
                            {
                                "example_id": "f51d967b-b3da-4cd8-ac5c-ee7036700ed7",
                                "sense_id": "b156aea3-262c-3c54-8e6d-d7d6154b25ae",
                                "text": "L'Eye-liner fait fureur"
                            },
                            {
                                "example_id": "1031b5ec-7ccd-45e0-a1f5-5af2a9f52a79",
                                "sense_id": "b156aea3-262c-3c54-8e6d-d7d6154b25ae",
                                "text": "Rouge à lèvres franc. Sourcils hauts et courts. Paupières ourlées par deux tons dégradés d’Eye-Liner. Cils très chargés de Mascara."
                            }
                        ]
                    }
                ],
