                "senses": [
                    {
                        "sense_id": "16f8f7e7-20f8-38d4-b209-bbb83b64eb51",
                        "entry_id": "5f0e781d-e961-3110-899c-0c0c6ed45e2b",
                        "glosses": [
                            "doktryna polityczna i ideologia państwowa III Rzeszy niemieckiej, charakteryzująca się m.in. nacjonalizmem, rasizmem, antykomunizmem, antyparlamentaryzmem, korporacjonizmem i kultem wodza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1fbb9f-583f-4f96-baa7-6e49077c6260",
                                "sense_id": "16f8f7e7-20f8-38d4-b209-bbb83b64eb51",
                                "text": "Mimo że nazizm był skrajnie antykomunistyczny, Niemcy zawarły pakt o nieagresji ze Związkiem Radzieckim."
                            },
                            {
                                "example_id": "9ffab4a4-64d8-42ba-b0f7-7b3a39c389c2",
                                "sense_id": "16f8f7e7-20f8-38d4-b209-bbb83b64eb51",
                                "text": "W 1942 roku ekspatryda Tomasz Mann tłumaczył Amerykanom, że źródeł nazizmu należy szukać w oszalałej inflacji po I wojnie światowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2400655b-5414-45fc-9b48-115f614cc38d",
                        "source_entry_id": "5f0e781d-e961-3110-899c-0c0c6ed45e2b",
                        "source_sense_id": "16f8f7e7-20f8-38d4-b209-bbb83b64eb51",
