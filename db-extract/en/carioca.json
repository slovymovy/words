                ],
                "senses": [
                    {
                        "sense_id": "0e1826c3-8336-32cd-a3d9-63a391726120",
                        "entry_id": "88e0e872-96a8-3643-90af-4cb4868d00a8",
                        "glosses": [
                            "A native or inhabitant of the city of Rio de Janeiro, Rio de Janeiro state, Brazil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e25bd5-21ef-44b2-8569-5d1218fdaed7",
                                "sense_id": "0e1826c3-8336-32cd-a3d9-63a391726120",
                                "text": "Needless to say, a true Carioca never makes mistakes when dealing with money."
                            },
                            {
                                "example_id": "f4b85a7c-c7d9-43f7-9b75-01a658c31c2d",
                                "sense_id": "0e1826c3-8336-32cd-a3d9-63a391726120",
                                "text": "I was impassioned about this because my Portuguese professor at Johns Hopkins was a Carioca, or native of Rio de Janeiro, and the first thing she told us in class was that she was going to make us all Cariocas."
                            },
                            {
                                "example_id": "af592a8e-1ef2-40cc-bcd6-495a04ae97c3",
                                "sense_id": "0e1826c3-8336-32cd-a3d9-63a391726120",
                                "text": "Cariocas – as inhabitants of Rio are called – panicked, and the newspapers reported the deteriorating situation in the city."
                            }
                        ]
                    }
                ],
