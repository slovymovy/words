                "senses": [
                    {
                        "sense_id": "5b5a9534-e553-3747-9de6-01bde88ffc67",
                        "entry_id": "11283609-548b-38b8-8dac-3f0b0e5228da",
                        "glosses": [
                            "Entfernung, die das Licht in einer Woche im Vakuum zurücklegt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "96c6d9ea-ed55-4da7-bc41-bc54ebf1d845",
                                "sense_id": "5b5a9534-e553-3747-9de6-01bde88ffc67",
                                "text": "Der neu entdeckte Himmelskörper steht etwa eine Lichtwoche vom Zentrum der Milchstraße entfernt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa8e2160-bd20-314b-9ff2-1caf0f7434d1",
                        "entry_id": "11283609-548b-38b8-8dac-3f0b0e5228da",
                        "glosses": [
                            "7 Tage unter dem Motto Licht, in denen zum Beispiel Lichtinstallationen gezeigt werden"
                        ],
                        "tags": [
                            "Event"
                        ],
                        "examples": [
                            {
                                "example_id": "26e1ee81-1199-4db2-a0e7-9b1de4d60a92",
                                "sense_id": "aa8e2160-bd20-314b-9ff2-1caf0f7434d1",
                                "text": "„In der kommenden Woche, vom 1. bis 6. November, findet wieder die Lichtwoche der Rostocker Stadtwerke statt. Unter dem Motto „Ein Farbenmeer für Rostock“ erstrahlt die Innenstadt vom Steintor über das Rathaus, die Marienkirche und den Universitätsplatz bis hin zum Klostergarten und dem Kröpeliner Tor täglich zwischen 16 und 21 Uhr in einem Lichtermeer aus farbenfrohen Pani-Projektionen und Farbspielen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3759b11e-b14d-4d21-8a48-b15193265630",
                        "source_entry_id": "11283609-548b-38b8-8dac-3f0b0e5228da",
                        "source_sense_id": "5b5a9534-e553-3747-9de6-01bde88ffc67",
