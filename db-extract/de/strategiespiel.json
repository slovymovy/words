                ],
                "senses": [
                    {
                        "sense_id": "2d2dcc94-ebc6-347b-befb-e499b9e79b7c",
                        "entry_id": "ffacefb7-f01b-3382-9217-72744d690275",
                        "glosses": [
                            "Spiel, bei dem es auf eine langfristige Planung ankommt und Zufall/Glück keine oder nur eine untergeordnete Rolle spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53fccc0d-c32e-411b-abeb-2912543fe2c3",
                                "sense_id": "2d2dcc94-ebc6-347b-befb-e499b9e79b7c",
                                "text": "„Die Amtsleiter im Rathaus schenkten dem Chef ein Strategiespiel, mit dem er am PC Stadtentwicklung üben kann.“"
                            },
                            {
                                "example_id": "0979491c-d126-44ba-a7f2-bd165cfaaea4",
                                "sense_id": "2d2dcc94-ebc6-347b-befb-e499b9e79b7c",
                                "text": "„Zahlreiche besonders bekannte Spielformen, Strategiespiele wie Fußball, sind aus diesem Blickwinkel Grenzfälle kommunikativen Handelns.“"
                            },
                            {
                                "example_id": "838cd0d4-4ccf-4868-8d2f-8da575b37ba9",
                                "sense_id": "2d2dcc94-ebc6-347b-befb-e499b9e79b7c",
                                "text": "\"Wagen Sie sich an die Spezial-Hände …, und Sie werden schnell erkennen, daß Sie es mit einem Denk- und Strategiespiel zu tun haben.\""
                            },
                            {
                                "example_id": "e03b2b87-58db-417f-99e7-9c028c6c2c69",
                                "sense_id": "2d2dcc94-ebc6-347b-befb-e499b9e79b7c",
                                "text": "„Nicht dem Würfelspiel habe er gefrönt, sondern Schach gespielt, verteidigte er sich, wohl darauf hoffend, daß der Papst den Unterschied gebührend würdige und das intelligente Strategiespiel der höheren Stände nicht mit einem Hazardspiel einfacher Glücksritter gleichsetze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
