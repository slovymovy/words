                "word": "conclusively",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0946d98d-81ec-4e19-b409-d25561f6401d",
                        "entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more conclusively"
                    },
                    {
                        "form_id": "48f395b5-1930-4137-a30c-95782a0e6921",
                        "entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most conclusively"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                        "entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
                        "glosses": [
                            "In a conclusive manner; with finality."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38df3bc9-681f-4ebe-ab29-4e8b9a340390",
                                "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                                "text": "Once the final experiment had been performed, the theory was conclusively proved."
                            },
                            {
                                "example_id": "acdb1a1d-5018-402d-bdd7-216a68bca6bc",
                                "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                                "text": "I need not extend the subject any farther; enough has been said , and much more might be, if necessary, to prove clearly and conclusively that the odontotechny of the Greeks and Romans was advanced to a considerable degree of perfection: […]"
                            },
                            {
                                "example_id": "c06a546c-e792-45bb-9e71-fcaba33e0525",
                                "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                                "text": "[…] which conclusively prove the enormous superiority of the Sumerian over the Egyptian weaponsmithy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b00aeb62-ea2e-42bf-96a3-b29a1caadc00",
                        "source_entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
                        "source_sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                        "source_sense_description": "in a conclusive manner",
                        "target_lang_word": "afdoend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afdoend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f4600ce1-0dac-3b86-99df-66c13e029e1a",
                                        "entry_id": "ce8c22ca-2a48-3721-9da6-083e55d90a5d",
                                        "glosses": [
                                            "onvoltooid deelwoord van áfdoen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b82457ab-2c8a-4f23-9f52-c596dd9f1f6e",
                                                "sense_id": "f4600ce1-0dac-3b86-99df-66c13e029e1a",
                                                "text": "Zijn hoed afdoend liep hij de kerk binnen."
                                            },
                                            {
                                                "example_id": "d0e2bfe7-a4c6-4387-b0e7-ec4934c2c8b0",
                                                "sense_id": "f4600ce1-0dac-3b86-99df-66c13e029e1a",
                                                "text": "De ontvangen aanvragen afdoend, zag zij dat veel aanvragers in dezelfde plaats woonden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afdoend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "691653bc-ea66-3646-89de-47a25452065e",
                                        "entry_id": "a1e0e3ef-5d80-364a-a8fc-941cfa66b2e5",
                                        "glosses": [
                                            "toereikend om het probleem op te lossen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20978f0-6704-4439-be73-610954ce3c20",
                                                "sense_id": "691653bc-ea66-3646-89de-47a25452065e",
                                                "text": "Er is geen afdoend middel tegen het verschijnsel."
                                            },
                                            {
                                                "example_id": "b2691668-a0c6-4af6-ba3b-b30f5ef102ec",
                                                "sense_id": "691653bc-ea66-3646-89de-47a25452065e",
                                                "text": "Op 22 februari meldde het OM niet tot vervolging van tabaksproducenten over te gaan. Roken is weliswaar dodelijk, en het ontwerp van de sigaret draagt daaraan bij, stelde het OM in een verklaring, maar de producenten blijven binnen de strikte regels die gelden voor het produceren van sigaretten. Het is de eigen verantwoordelijkheid van de roker, de verplichte waarschuwingen op de verpakkingen („roken is dodelijk”) zijn daarvoor afdoende. Daarom maakt een strafzaak weinig kans."
                                            },
                                            {
                                                "example_id": "8ddeea38-413b-480a-ba2b-e6e876175e3c",
                                                "sense_id": "691653bc-ea66-3646-89de-47a25452065e",
                                                "text": "Uiteindelijk kwam die klap toen men er van doordrongen raakte dat alle interne reorganisaties niet afdoende waren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68d17dc3-62a1-4518-81b9-20a342bbec4d",
                        "source_entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
                        "source_sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                        "source_sense_description": "in a conclusive manner",
                        "target_lang_word": "beslissend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beslissend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "51fc21db-a580-37bf-9c48-d680fb8cf5c3",
                                        "entry_id": "564d3769-591b-3f57-b560-1d9ce72c3863",
                                        "glosses": [
                                            "onvoltooid deelwoord van beslissen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beslissend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8b08e96e-48cb-3bab-8b39-bf3a79779655",
                                        "entry_id": "6f67fdc6-d48e-3f5c-8ffd-5e56d08f17d3",
                                        "glosses": [
                                            "doorslaggevend in maken van een keuze, het verschil makend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ff365f-19f1-4a4a-ac7a-c2ff3f6e708a",
                                                "sense_id": "8b08e96e-48cb-3bab-8b39-bf3a79779655",
                                                "text": "Hoewel er veel aanwijzingen waren in de strafzaak vond de rechter dat het beslissende bewijs niet aanwezig was en daarom is de verdachte dus vrijgesproken."
                                            },
                                            {
                                                "example_id": "1ee0fc17-0cf2-4dee-86a9-a37a2970ec31",
                                                "sense_id": "8b08e96e-48cb-3bab-8b39-bf3a79779655",
                                                "text": "Concentreer je. Loop jezelf niet zo op te naaien! Op de beslissende momenten sta jij er gewoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42b9e60a-21cb-3bd0-a306-16c540765fd2",
                                        "entry_id": "6f67fdc6-d48e-3f5c-8ffd-5e56d08f17d3",
                                        "glosses": [
                                            "van groot belang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef31a989-dbc3-4d5f-91bb-cacbe58ab8b4",
                                                "sense_id": "42b9e60a-21cb-3bd0-a306-16c540765fd2",
                                                "text": "De uitslag van het examen is van beslissend belang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20ad86ef-7c26-4634-a4f3-e07433659d3b",
                        "source_entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
                        "source_sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                        "source_sense_description": "in a conclusive manner",
                        "target_lang_word": "doorslaggevend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doorslaggevend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                                        "entry_id": "4110abd2-137a-3b04-b79a-20987bb77eae",
                                        "glosses": [
                                            "de uitslag bepalend, beslissend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c94b63-607c-4c7b-a095-7e9f46fecae3",
                                                "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                                                "text": "- Deze voorverkiezing bleek van doorslaggevender belang dan oorspronkelijk gedacht."
                                            },
                                            {
                                                "example_id": "d85353e0-72b8-4481-9f18-76601b352c5a",
                                                "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                                                "text": "- Het eerste argument bleek al van doorslaggevende betekenis te zijn."
                                            },
                                            {
                                                "example_id": "c358f727-a177-414f-88ff-8c57d0a3065d",
                                                "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                                                "text": "Maar als je één ding kunt leren van Poetins oorlogen in Tsjetsjenië, Georgië, Oekraïne, Syrië of Noord-Afrika, is het wel dat economische redenen niet doorslaggevend zijn bij zijn keus voor grof geweld. Oorlog is irrationeel, en dat is iets wat velen in Europa helaas zijn vergeten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deaf3a8c-c8b9-461a-b089-9f4ea217d0ab",
                        "source_entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
