                "senses": [
                    {
                        "sense_id": "d0bdfeff-eec4-3dad-b255-ff4f4aadeb41",
                        "entry_id": "414d2770-9377-3508-9a26-a92483f23f6e",
                        "glosses": [
                            "vermogen om prestaties te leveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee559d8-0269-4515-a4b5-0f9b613afb2a",
                                "sense_id": "d0bdfeff-eec4-3dad-b255-ff4f4aadeb41",
                                "text": "De performantie van een onderneming meet - in algemene zin - de efficiëntie en slagkracht waarmee ze actief is en vormt daarmee een belangrijke indicator voor de overlevingskans van een onderneming."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0c5c109-500f-356f-8ec9-e0212afee4ce",
                        "entry_id": "414d2770-9377-3508-9a26-a92483f23f6e",
                        "glosses": [
                            "feitelijk taalgebruik in concrete situaties in tegenstelling tot het geheel van abstracte taalregels dat een mens door zijn aangeboren taalvermogen ontwikkelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b3679f-24d3-4ea9-a003-edeca53b3a26",
                                "sense_id": "d0c5c109-500f-356f-8ec9-e0212afee4ce",
                                "text": "Voor de chomskyaanse taalkunde is de performantie van secundair belang, omdat zij afhankelijk is van de competentie en verder bepaald wordt door allerlei niet-linguïstische factoren als communicatiesituatie, sociale context, concentratievermogen, geheugen e.d."
                            }
                        ]
                    },
                    {
                        "sense_id": "806cff6c-cfd7-3c94-8a56-0392a9fcdb2d",
                        "entry_id": "414d2770-9377-3508-9a26-a92483f23f6e",
                        "glosses": [
                            "vaardigheid om tekst te maken die in een bepaalde literaire traditie of omgeving past"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0d9f65-ee82-4d57-88c6-b152a92c0ae5",
                                "sense_id": "806cff6c-cfd7-3c94-8a56-0392a9fcdb2d",
                                "text": "Ook een literaire tekst moet leven ‘te midden van de mensen’. Welnu, dergelijke registers bespeelt iemand als Hugo Claus meesterlijk. Zo geletterde mensen ‘de lat lager leggen’, zoals de slogan van de poëzie-avonden in schouwburg of café of dancing luidt, dan kan Claus daaraan meedoen als virtuoos van de attractie en de performantie."
                            }
                        ]
                    }
