                    {
                        "sense_id": "46f7360e-1f29-34fb-915f-da284a3fe89f",
                        "entry_id": "ecb10e67-a590-32a4-85b2-e8a1a1cf0c1b",
                        "glosses": [
                            "Celui qui bricole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4156e0d0-646b-480e-ab04-cc1a34d0cc63",
                                "sense_id": "46f7360e-1f29-34fb-915f-da284a3fe89f",
                                "text": "Ils cherchent aussi à contacter un certain technicien, un bricoleur aux doigts de fée, qui a effectué un travail pour eux et qui a disparu de son domicile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be075247-6b9b-4f86-9ae6-93c7f1ee284d",
                        "source_entry_id": "ecb10e67-a590-32a4-85b2-e8a1a1cf0c1b",
                        "source_sense_id": "46f7360e-1f29-34fb-915f-da284a3fe89f",
                        "target_lang_word": "Bastler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bastler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35319610-3e0c-3332-b2de-4add0880aea8",
                                        "entry_id": "f5b9731d-babb-3b6a-8d56-9e13e81862c8",
                                        "glosses": [
                                            "Person, die sich gerne und regelmäßig mit kleineren handwerklichen oder technischen Arbeiten aus Liebhaberei beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6b5d966-cd08-4140-8c9a-25f06a736860",
                                                "sense_id": "35319610-3e0c-3332-b2de-4add0880aea8",
                                                "text": "Der alte Bastler kann vieles selbst reparieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f693477-32da-4714-bdfd-83036ecc51a6",
                        "source_entry_id": "ecb10e67-a590-32a4-85b2-e8a1a1cf0c1b",
                        "source_sense_id": "46f7360e-1f29-34fb-915f-da284a3fe89f",
                        "target_lang_word": "Heimwerker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heimwerker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32a171de-8a22-3c76-abce-65770c66eebf",
                                        "entry_id": "941559d7-5d4f-3f4a-bcf0-ad679b6c8a9a",
                                        "glosses": [
                                            "Person, die bei sich daheim handwerkliche Arbeiten durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0438d88b-fbb0-4824-82f0-82cd8b332149",
                                                "sense_id": "32a171de-8a22-3c76-abce-65770c66eebf",
                                                "text": "Als Heimwerker weiß er, wie man das Bad fliest."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6713b56-7abd-4fd5-bdbb-112d8c5cd92d",
                        "source_entry_id": "ecb10e67-a590-32a4-85b2-e8a1a1cf0c1b",
                        "source_sense_id": "46f7360e-1f29-34fb-915f-da284a3fe89f",
                        "target_lang_word": "tinkerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tinkerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff1b3f49-0114-3d6d-8b1d-682efe4247e2",
                                        "entry_id": "d6289778-c5e1-31b5-bf54-c977a9f5eb9a",
                                        "glosses": [
                                            "Agent noun of tinker; one who tinkers with things."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcfe417f-c004-45a9-bd98-9a488f0bb9c7",
                                                "sense_id": "ff1b3f49-0114-3d6d-8b1d-682efe4247e2",
                                                "text": "Part of why both books dragged on so long is that Mr. Talese, who once worked for The New York Times, is a perfectionist, an obsessive tinkerer and rewriter, and also a famously meticulous reporter and researcher who spurns devices like composite characters and faked identities."
                                            },
                                            {
                                                "example_id": "72533f70-1a41-4b1c-bae1-32bec9ee5316",
                                                "sense_id": "ff1b3f49-0114-3d6d-8b1d-682efe4247e2",
                                                "text": "Make magazine, which celebrates “your right to tweak, hack and bend any technology to your own will,” has joined with the New York Hall of Science to gather more than 500 of the craftiest inventors, artists, technology enthusiasts, tinkerers and hobbyists to share their expertise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b9900cb-862d-3ddd-8e33-7ef5c6e9397b",
                                        "entry_id": "d6289778-c5e1-31b5-bf54-c977a9f5eb9a",
                                        "glosses": [
                                            "A meddler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a1ddf94-83fc-4929-bd82-d39862147b94",
                        "source_entry_id": "ecb10e67-a590-32a4-85b2-e8a1a1cf0c1b",
                        "source_sense_id": "46f7360e-1f29-34fb-915f-da284a3fe89f",
                        "target_lang_word": "do-it-yourselfer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "do-it-yourselfer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a719b8fb-777c-3c14-9c4e-f87c6e12cac2",
                                        "entry_id": "5d0910d0-e701-3d72-b8d5-3a2f5f88fe70",
                                        "glosses": [
                                            "A practitioner of do it yourself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7b52c60-9fc8-417c-b1a7-dd000c4b9003",
                                                "sense_id": "a719b8fb-777c-3c14-9c4e-f87c6e12cac2",
                                                "text": "Since the store's opening last November, do-it-yourselfers in the Washington area have been coming to Brookstone for tools and gadgets they have not been able to find anywhere else."
                                            },
                                            {
                                                "example_id": "08548884-8822-4637-87d2-4aafc632d7a4",
                                                "sense_id": "a719b8fb-777c-3c14-9c4e-f87c6e12cac2",
                                                "text": "During the past year or so, numerous new books have been published which can be helpful to do‐it‐yourselfers and home craftsmen, as well as to those readers on the lookout for new ideas and money‐saving suggestions on how to improve and maintain their homes and apartments."
                                            },
                                            {
                                                "example_id": "925c22fb-c03c-431e-9770-0ff560af8d22",
                                                "sense_id": "a719b8fb-777c-3c14-9c4e-f87c6e12cac2",
                                                "text": "And it does seem that everything at the company is moving faster these days. Mr. Nardelli, who calls himself the \"consummate do-it-yourselfer,\" has spent the last seven months installing management systems that Home Depot had never before imagined, and pressing the fast-forward button on ones it had just begun to consider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1419f6dc-cb89-4c5c-aa21-ce982a7ec0b3",
