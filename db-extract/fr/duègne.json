                                        "sense_id": "b509acb2-fd38-3bef-bd03-301f0b650167",
                                        "entry_id": "3d13ae77-b08b-3c98-9cae-3c54724f61c9",
                                        "glosses": [
                                            "een vrouw die voor de opvoeding en scholing van de kinderen van anderen zorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf55fd6a-2e73-46c3-b42b-cd70b33bf75d",
                                                "sense_id": "b509acb2-fd38-3bef-bd03-301f0b650167",
                                                "text": "In de Sound of Music trouwt de gouvernante met de vader van de kinderen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d63a4c8-21c4-4ec8-9ff6-03266834735c",
                        "source_entry_id": "f22c4afa-7361-3cfb-b16e-8299743afd42",
                        "source_sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                        "target_lang_word": "kindermeid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindermeid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5462b993-2b59-3a8f-89f0-c5960aedb1da",
                                        "entry_id": "1192b77d-d5b6-3618-b130-144c6935721a",
                                        "glosses": [
                                            "vrouwelijk persoon anders dan de moeder, die als beroep voor de kinderen zorg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a09e86-2eb2-4412-924a-3d6ca6a30963",
                                                "sense_id": "5462b993-2b59-3a8f-89f0-c5960aedb1da",
                                                "text": "Het is grappig en tragisch tegelijk, de omgang van het twaalfjarige meisje met de ruim negentigjarige vroegere kindermeid van haar moeder. Ploon heeft haar hele leven lang voor anderen gezorgd en op een dag heeft ze zich bij haar voormalige pupillen gemeld met de mededeling 'wel, nu kunt ge eens voor míj gaan zorgen. Nu is 't mijn toer!'. Dat viel niet in goede aarde. Roeliens ouders hebben Ploon naar het bejaardenhuis gebracht, na een logeerpartij van een paar maanden. Roelien heeft Ploon teruggesmokkeld in huis, op een zolderkamer waar haar ouders nooit komen, zodat Ploon haar kan vertellen over vroeger, over toen Ploon zelf een meisje was. Want Roelien is de enige, in al die jaren dat Ploon bij anderen in huis werkt, die ooit gevraagd heeft: 'Toen jij een klein meisje was (-) waar was jij toen?' Daarom zijn Ploons verhalen van haar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
