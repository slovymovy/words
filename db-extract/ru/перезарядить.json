                                                "example_id": "b6100ed6-ce28-4559-b618-3cf61906fea0",
                                                "sense_id": "ac94fcc9-4e7b-3279-8272-fde9fed2d1e8",
                                                "text": "My body is a little bit sore from all of the practicing and playing and training, and your mind gets a little tired of it, too. It's nice to be able to recharge and come back fresh for the remainder of the year."
                                            }
                                        ]
                                    },
