                                "target_lang_word": "подслащивать",
                                "target_lang_sense_clarification": "блюда, напитки, соусы"
                            },
                            {
                                "target_lang_word": "сглаживать",
                                "target_lang_sense_clarification": "горечь кофе или вина"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "süßen",
                                "target_lang_sense_clarification": "Soßen, Speisen, Getränke"
                            },
                            {
                                "target_lang_word": "mildern",
                                "target_lang_sense_clarification": "Bitterkeit und Säure in Getränken"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "endulzar",
                                "target_lang_sense_clarification": "comidas, bebidas o salsas"
                            },
                            {
                                "target_lang_word": "suavizar",
