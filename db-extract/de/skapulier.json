                ],
                "senses": [
                    {
                        "sense_id": "b429813a-d8bd-389c-9dea-b8630e356a31",
                        "entry_id": "bbc80328-daf5-3f68-b45e-699607f11bed",
                        "glosses": [
                            "ein über die Brust und über den Rücken bis zu den Füßen herabfallender Tuchstreifen in der Ordenstracht der benediktinischen und dominikanischen Mönche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da6d94f6-4c2b-488b-b1fe-620774c64e9d",
                                "sense_id": "b429813a-d8bd-389c-9dea-b8630e356a31",
                                "text": "„Er bestand aus der Kukulle, einem mantelähnlichen Obergewand, dem Skapulier, einem Überwurf über Brust und Rücken sowie dem Cingulum, einem Gürtel, der um die Hüften gebunden wird.“"
                            },
                            {
                                "example_id": "74a1d6b0-4ac5-44e9-bbbc-ee8f2634fc10",
                                "sense_id": "b429813a-d8bd-389c-9dea-b8630e356a31",
                                "text": "„Er war sehr fromm, richtig kirchlich, gehörte dem Dritten Orden an und trug sein Skapulier immer vorne auf seiner enormen Boxerbrust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93692438-8d2b-4592-bc9e-c9ada7f617de",
                        "source_entry_id": "bbc80328-daf5-3f68-b45e-699607f11bed",
                        "source_sense_id": "b429813a-d8bd-389c-9dea-b8630e356a31",
                        "target_lang_word": "scapular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scapular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c60484e-7427-333d-9bba-7b0dbb7e8c21",
                                        "entry_id": "8064d992-2d84-3703-85e1-3d1995992203",
                                        "glosses": [
                                            "A short cloak worn around the shoulders, adopted as part of the uniform of various religious orders, later often with an embroidered image of a saint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31968a2e-bca9-4596-a0bf-6fb0a593df02",
                                                "sense_id": "3c60484e-7427-333d-9bba-7b0dbb7e8c21",
                                                "text": "A scapular, or friar's coat, for example, was a coveted object to be worn as a preservative against pestilence or the ague […]"
                                            },
                                            {
                                                "example_id": "c2bae0ce-c6a4-48ff-a4a8-6ddaac9a0676",
                                                "sense_id": "3c60484e-7427-333d-9bba-7b0dbb7e8c21",
                                                "text": "She granted the Whitefriars identical powers to the Blackfriars, to bless a part of their friar's habit which draped over their shoulders and was known as the scapular; now laity could wear it and derive spiritual privileges from it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d30a9753-a72e-31ca-a5d5-c92db9d7cd7a",
                                        "entry_id": "8064d992-2d84-3703-85e1-3d1995992203",
                                        "glosses": [
                                            "One of a special group of feathers which arise from each of the scapular regions and lie along the sides of the back."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5773bf22-7ad9-3c3b-98fe-cd928892a160",
                                        "entry_id": "8064d992-2d84-3703-85e1-3d1995992203",
                                        "glosses": [
                                            "A bandage passing over the shoulder to support it, or to retain another bandage in place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eae5b1a6-be7e-3f78-8a56-80c7bd3eb793",
                                        "entry_id": "8064d992-2d84-3703-85e1-3d1995992203",
                                        "glosses": [
                                            "A devotional object, typically consisting of two rectangular pieces of cloth (often with an embroidered image or text) joined with cloth bands and worn with one piece over the chest and one in the back."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scapular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a59c82c-ad37-3068-9c13-ca059546cd41",
                                        "entry_id": "67f6601b-d2db-3690-bb99-1e9138f31a64",
                                        "glosses": [
                                            "Of or pertaining to the scapula."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a09d75c-dedf-4cae-ab78-77eb1eea813f",
                        "source_entry_id": "bbc80328-daf5-3f68-b45e-699607f11bed",
                        "source_sense_id": "b429813a-d8bd-389c-9dea-b8630e356a31",
                        "target_lang_word": "scapulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scapulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48d29541-073c-3a21-8c62-3826a4e4381d",
                                        "entry_id": "f59ae6a4-2b63-34ed-826a-5250cf9ddfaf",
                                        "glosses": [
                                            "Relatif à l’épaule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63aa582-f878-457b-a357-c40f2e8f4211",
                                                "sense_id": "48d29541-073c-3a21-8c62-3826a4e4381d",
                                                "text": "Elles sont orientées principalement sur les régions abdominales, au niveau du plexus solaire, puis cervicodorsales, scapulaires et lombaires."
                                            },
                                            {
                                                "example_id": "a6ca4d40-d9ab-4c8f-a332-23458caf95ea",
                                                "sense_id": "48d29541-073c-3a21-8c62-3826a4e4381d",
                                                "text": "La tête, dont la base est protégée par un renflement scapulaire, est toute ronde et rayée de bandes sensorielles aussi sombres que sa carapace."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scapulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f62e7b39-de35-3eb3-949f-ccbfab31ea7c",
                                        "entry_id": "4611cd53-04f5-3e0e-be12-c9c36d068560",
                                        "glosses": [
                                            "Vêtement, porté dans certains ordres religieux, fait de deux pans d’étoffe tombant jusqu’aux pieds par devant et derrière, associé parfois à un capuchon pour les hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ab6dd5-7e7a-4bbb-9989-61c1f20ec47a",
                                                "sense_id": "f62e7b39-de35-3eb3-949f-ccbfab31ea7c",
                                                "text": "Les moniales arborent un voyant costume, une robe blanche serrée par une ceinture de cuir écarlate à la taille, un manteau rouge et un scapulaire couleur de sang portant, brodé en soie bleue."
                                            },
                                            {
                                                "example_id": "3387bf44-2b92-472b-b32c-c0c1b4d9cf66",
                                                "sense_id": "f62e7b39-de35-3eb3-949f-ccbfab31ea7c",
                                                "text": "Les autres arrivaient ensuite : les « pots de fleurs », simples figurants en robe rouge et surplis blanc qui se croisaient les bras, le thuriféraire et le naviculaire avec l’encensoir, les deux acolytes en soutane blanche, le cérémoniaire, le plus beau de tous avec une robe violette, un surplis de dentelle et un scapulaire bordé d’hermine."
                                            },
                                            {
                                                "example_id": "da6b1faf-d24c-4195-a910-98d5937340d3",
                                                "sense_id": "f62e7b39-de35-3eb3-949f-ccbfab31ea7c",
                                                "text": "Dans l’angle inférieur gauche, la petite bergère est agenouillée près de la source, étalant dans l’herbe ses jupes misérables, la tête couverte d’un scapulaire, un chapelet emprisonné dans ses mains jointes."
                                            },
                                            {
                                                "example_id": "18a03f81-7fe7-4699-966f-d804302ee82a",
                                                "sense_id": "f62e7b39-de35-3eb3-949f-ccbfab31ea7c",
                                                "text": "Novicio se repentit aussitôt de son invective, qui aurait été plus appropriée dans une réunion du Katipunan que dans le bahay familial, dont les parois étaient couvertes d’images pieuses, de crucifix et de scapulaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f20b4f7-bb69-3852-8183-1b697933ab51",
                                        "entry_id": "4611cd53-04f5-3e0e-be12-c9c36d068560",
                                        "glosses": [
                                            "Petit morceau d’étoffe qu’on porte au cou, sous les vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc1d1e9-48fb-4876-b781-8a0880ba5b9d",
                                                "sense_id": "7f20b4f7-bb69-3852-8183-1b697933ab51",
                                                "text": "Cette blouse, ouverte par-devant, laissait voir sa poitrine brunie, sur laquelle pendait un scapulaire de velours noir, retenu par une mince chaîne d’acier."
                                            },
                                            {
                                                "example_id": "75e30553-5896-4673-a8b0-6fe31529ac5f",
                                                "sense_id": "7f20b4f7-bb69-3852-8183-1b697933ab51",
                                                "text": "Et Lapoulle écarquillait les yeux, mettait un doigt devant son nez, pendant que Pache, tâtant le scapulaire qu’il portait, l’aurait voulu étendre, pour s’en faire une cuirasse sur toute la poitrine."
                                            },
                                            {
                                                "example_id": "8b0d18a6-64f8-475d-9c2f-cd1ade9e57cc",
                                                "sense_id": "7f20b4f7-bb69-3852-8183-1b697933ab51",
                                                "text": "Il écrivit sur un bout de papier une prière. Il faudrait enfermer ce bout de papier dans un scapulaire. Pendant huit jours, Théophile le porterait par-devant lui, sur la poitrine […]."
                                            },
                                            {
                                                "example_id": "929da3ea-cb2d-44ad-92c7-9a231def195e",
                                                "sense_id": "7f20b4f7-bb69-3852-8183-1b697933ab51",
                                                "text": "C’est un cordon… Je vous jure… Oui, un cordon de scapulaire. Pourtant, elle n’était pas bigote."
                                            },
                                            {
                                                "example_id": "b1f07a33-8515-4568-af57-8d0a1c4f5551",
                                                "sense_id": "7f20b4f7-bb69-3852-8183-1b697933ab51",
                                                "text": "J’entrai dans une confrérie enfantine, « Les anges de la Passion », ce qui me donna le droit de porter un scapulaire, et le devoir de méditer sur les sept douleurs de la Vierge."
                                            },
                                            {
                                                "example_id": "0ad75880-f80b-4b01-9a2e-ec17a3c9c222",
                                                "sense_id": "7f20b4f7-bb69-3852-8183-1b697933ab51",
                                                "text": "Sa main plongea dans les profondeurs moites de son corsage, en retira un étrange scapulaire attaché à un fil noir : sa bourse, cette bourse d’étoffe, cousue à gros points, dont elle entreprit le pénible inventaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb2497c7-f46f-3792-b8bd-212398687eb8",
                                        "entry_id": "4611cd53-04f5-3e0e-be12-c9c36d068560",
                                        "glosses": [
                                            "Bande qui s’appuie sur les épaules et dont les extrémités sont fixées à un bandage appliqué sur le corps, de manière à l’empêcher de descendre, de glisser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4a681e6-2811-3169-bff6-8f9875aa76e2",
                                        "entry_id": "4611cd53-04f5-3e0e-be12-c9c36d068560",
                                        "glosses": [
                                            "Plume tectrice des épaules chez les oiseaux, recouvrant le pli à la base de l’aile."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cacacbd-0a52-4c67-8a34-b3f4a2ef64b3",
                                                "sense_id": "a4a681e6-2811-3169-bff6-8f9875aa76e2",
                                                "text": "L’air était déchiré par le piaillement des corneilles à scapulaire rose et des perroquets jacasseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea3675c9-9237-3aba-8cfc-5b5d4e3461b9",
                                        "entry_id": "4611cd53-04f5-3e0e-be12-c9c36d068560",
                                        "glosses": [
                                            "Forme en V apposée sur les maillots des équipes de rugby à VIII, puis par extension sur celles des Girondins de Bordeaux et du FC Valenciennes référence nécessaire (résoudre le problème)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11d61c3b-2634-438c-992b-a3d466d86504",
                        "source_entry_id": "bbc80328-daf5-3f68-b45e-699607f11bed",
                        "source_sense_id": "b429813a-d8bd-389c-9dea-b8630e356a31",
                        "target_lang_word": "szkaplerz",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "szkaplerz",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d65e5baa-c999-3e7d-afe2-074af71090d4",
                                        "entry_id": "d128d6a0-e576-3230-89bd-70d11164fa27",
                                        "glosses": [
                                            "część stroju zakonnego, prostokątny płat sukna z otworem, nakładany przez głowę na habit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e0bce4-2bdf-4264-97cf-680611ece835",
                                                "sense_id": "d65e5baa-c999-3e7d-afe2-074af71090d4",
                                                "text": "(…) zastaję jednego z ojców franciszkanów, który mi daje swój szkaplerz do pocałowania"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b443ac9e-8f4e-3327-86ea-88ecde18045e",
                                        "entry_id": "d128d6a0-e576-3230-89bd-70d11164fa27",
                                        "glosses": [
                                            "dwa małe kawałki sukna z wyszytym imieniem Matki Boskiej lub Chrystusa, połączone tasiemkami, noszone na piersiach, pod ubraniem, przez członków bractw religijnych lub osoby świeckie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570d0084-602a-4453-bd9c-b430ed6ed32a",
                                                "sense_id": "b443ac9e-8f4e-3327-86ea-88ecde18045e",
                                                "text": "Widocznie kaduk mnie opętał i nosił. Ale z duszą chrześcijańską nie tak to łatwo; odpiąłem ja kurtkę, sięgam pod koszulę, a szkaplerz na wierzch wykładam i z dobrą miną znowu ku drodze zawracam"
                                            },
                                            {
                                                "example_id": "8cf4b940-da7e-42bb-9f3f-686c3b9dc0c9",
                                                "sense_id": "b443ac9e-8f4e-3327-86ea-88ecde18045e",
                                                "text": "Oto mam na sobie szkaplerz, w którym zaszyte są relikwie świętego Wojciecha"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "0e41b732-66d6-353d-a81a-8de266f6b438",
                                        "entry_id": "d128d6a0-e576-3230-89bd-70d11164fa27",
                                        "glosses": [
                                            "medalik z wizerunkiem Matki Boskiej"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
