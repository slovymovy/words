{
    "word_family": [
        "organize",
        "organizer",
        "organizational",
        "disorganization",
        "reorganization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50264c26-8500-305a-920a-f0b8b692ca98",
                    "sense_definition": "A group of people or legal entities with a specific purpose, such as a business or club.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She works for a non-profit <w>organization</w> that helps children in need.",
                            "target_lang_translations": {
                                "ru": "Она работает в некоммерческой <w>организации</w>, которая помогает нуждающимся детям.",
                                "zh": "她在一家帮助贫困儿童的非营利<w>组织</w>工作。"
                            }
                        },
                        {
                            "text": "Every international <w>organization</w> must follow these specific safety rules.",
                            "target_lang_translations": {
                                "ru": "Каждая международная <w>организация</w> должна соблюдать эти специфические правила безопасности.",
                                "zh": "每个国际<w>组织</w>都必须遵守这些具体的安全规则。"
                            }
                        }
                    ],
                    "synonyms": [
                        "organization/organisation"
                    ],
                    "common_phrases": [
                        "international organization",
                        "non-profit organization",
                        "charitable organization"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей или юридических лиц с определенной целью, например, бизнес или клуб.",
                        "zh": "由一群人或法律实体组成的具有特定目的的团体，例如企业或俱乐部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организация",
                                "target_lang_sense_clarification": "общественное объединение или учреждение"
                            },
                            {
                                "target_lang_word": "учреждение",
                                "target_lang_sense_clarification": "государственная или официальная структура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "组织",
                                "target_lang_sense_clarification": "社会团体或机构"
                            },
                            {
                                "target_lang_word": "机构",
                                "target_lang_sense_clarification": "官方或专门的办事处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40f31498-edc3-38b7-aaf8-58e5f6307af4",
                    "sense_definition": "The way in which something is arranged or structured.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>organization</w> of the book makes it very easy to find information.",
                            "target_lang_translations": {
                                "ru": "<w>Организация</w> книги позволяет очень легко находить информацию.",
                                "zh": "这本书的<w>组织</w>方式使得查找信息非常容易。"
                            }
                        },
                        {
                            "text": "We need to improve the logical <w>organization</w> of this report before we send it.",
                            "target_lang_translations": {
                                "ru": "Нам нужно улучшить логическую <w>структуру</w> этого отчета перед отправкой.",
                                "zh": "在发送这份报告之前，我们需要改进其逻辑<w>结构</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "organization/organisation"
                    ],
                    "antonyms": [
                        "disorganization"
                    ],
                    "common_phrases": [
                        "logical organization",
                        "social organization",
                        "organization of data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым что-либо устроено или структурировано.",
                        "zh": "事物安排或构建的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организация",
                                "target_lang_sense_clarification": "структура или устройство чего-либо"
                            },
                            {
                                "target_lang_word": "структура",
                                "target_lang_sense_clarification": "взаимное расположение частей"
                            },
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "способ расположения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "组织",
                                "target_lang_sense_clarification": "事物内部的安排方式"
                            },
                            {
                                "target_lang_word": "结构",
                                "target_lang_sense_clarification": "各部分的组成和排列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9d7b4ab-71f2-3b85-a768-3eeb28301f1a",
                    "sense_definition": "The quality or act of being efficient and orderly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His desk shows a complete lack of <w>organization</w> with papers everywhere.",
                            "target_lang_translations": {
                                "ru": "Его рабочий стол демонстрирует полное отсутствие <w>организованности</w>: повсюду разбросаны бумаги.",
                                "zh": "他的桌子上到处都是纸，完全没有<w>条理性</w>。"
                            }
                        },
                        {
                            "text": "Good <w>organization</w> skills are essential for this management position.",
                            "target_lang_translations": {
                                "ru": "Хорошие навыки <w>организации</w> необходимы для этой руководящей должности.",
                                "zh": "良好的<w>组织能力</w>对于这个管理职位至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "organization/organisation"
                    ],
                    "antonyms": [
                        "chaos",
                        "disorder"
                    ],
                    "common_phrases": [
                        "lack of organization",
                        "skills in organization"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или действие, характеризующееся эффективностью и порядком.",
                        "zh": "高效且有序的品质或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организованность",
                                "target_lang_sense_clarification": "личная дисциплина и порядок"
                            },
                            {
                                "target_lang_word": "организация",
                                "target_lang_sense_clarification": "слаженность и дисциплинированность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "条理性",
                                "target_lang_sense_clarification": "做事有秩序的品质"
                            },
                            {
                                "target_lang_word": "组织能力",
                                "target_lang_sense_clarification": "安排和管理事务的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6297d581-d15a-32b1-a0ce-1ebcad9097ea",
                    "sense_definition": "A professional sports club and all its associated minor league or farm teams.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young pitcher has been in the Dodgers' <w>organization</w> for three years.",
                            "target_lang_translations": {
                                "ru": "Молодой питчер находится в <w>системе</w> «Доджерс» уже три года.",
                                "zh": "这位年轻的投手已经在道奇队的<w>体系</w>中待了三年。"
                            }
                        },
                        {
                            "text": "He is considered the best scout in the entire baseball <w>organization</w>.",
                            "target_lang_translations": {
                                "ru": "Он считается лучшим скаутом во всей бейсбольной <w>организации</w>.",
                                "zh": "他被认为是整个棒球<w>组织</w>中最优秀的球探。"
                            }
                        }
                    ],
                    "synonyms": [
                        "organization/organisation"
                    ],
                    "common_phrases": [
                        "baseball organization",
                        "sports organization"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональный спортивный клуб вместе со всеми связанными с ним командами младших лиг.",
                        "zh": "职业体育俱乐部及其所有附属的下属球队或农场球队。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организация",
                                "target_lang_sense_clarification": "спортивный клуб и его филиалы"
                            },
                            {
                                "target_lang_word": "система",
                                "target_lang_sense_clarification": "совокупность команд одного клуба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体系",
                                "target_lang_sense_clarification": "俱乐部及其下属梯队"
                            },
                            {
                                "target_lang_word": "组织",
                                "target_lang_sense_clarification": "体育俱乐部及其相关机构"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}