    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "32cab0b7-3a63-3a32-9fec-a7865216fa1f",
                "word": "cotyledon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "37adfb5b-000f-4983-bc04-b280b516788c",
                        "entry_id": "32cab0b7-3a63-3a32-9fec-a7865216fa1f",
                        "tags": [
                            "plural"
                        ],
                        "form": "cotyledons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b5fd23a-f1fb-342a-8617-51a46734a6ff",
                        "entry_id": "32cab0b7-3a63-3a32-9fec-a7865216fa1f",
                        "glosses": [
                            "Each of the patches of villi on the foetal chorion in the placenta of ruminants and some other mammals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b19c06c-4148-4ae1-aed7-befcf3f93688",
                                "sense_id": "6b5fd23a-f1fb-342a-8617-51a46734a6ff",
                                "text": "Forced to apply animal findings to humans, his human womb also had cotyledons like a dog's."
                            }
                        ]
                    },
                    {
                        "sense_id": "18a2be09-7223-3f08-b1fa-9a2bf8047f38",
                        "entry_id": "32cab0b7-3a63-3a32-9fec-a7865216fa1f",
                        "glosses": [
                            "The leaf of the embryo of a seed-bearing plant; after germination it becomes the first leaves of the seedling."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b3d81e1-93e2-4887-a454-69b06c2d04d3",
                        "source_entry_id": "32cab0b7-3a63-3a32-9fec-a7865216fa1f",
                        "source_sense_description": "leaf of the embryo of a seed-bearing plant",
                        "target_lang_word": "zaadlob",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zaadlob",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "03d2a424-5405-3984-8a66-5e1cfa27b56d",
                                        "entry_id": "608c534a-8666-35b2-99ed-102483bf877c",
                                        "glosses": [
                                            "het eerste bladachtige deel van een plantenkiem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631a5d36-0dd0-4eb4-85b1-beb0efffb72b",
                                                "sense_id": "03d2a424-5405-3984-8a66-5e1cfa27b56d",
                                                "text": "Een zaadlob kan afhankelijk van de soort al na enkele dagen na de kieming afvallen of meer dan een jaar aan de plant blijven zitten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64dd1f82-4853-4bd5-aba0-fab8e75226c9",
                        "source_entry_id": "32cab0b7-3a63-3a32-9fec-a7865216fa1f",
                        "source_sense_description": "leaf of the embryo of a seed-bearing plant",
                        "target_lang_word": "cotylédon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cotylédon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6a24d4-40ac-316a-a119-09a8dccf1578",
                                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                                        "glosses": [
                                            "Chacun des deux lobes qui forment le placenta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                                        "glosses": [
                                            "Feuille insérée sur le premier nœud de l’embryon végétal né de graine."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ace404a-6454-4020-8251-9e69fd651827",
                                                "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                                                "text": "Les deux cotylédons d’une fève, d’un haricot, etc."
                                            },
                                            {
                                                "example_id": "d7a4ae4e-9f13-41b5-8dff-84e6ffc6e986",
                                                "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                                                "text": "Comme un cotylédon qui cherche à crever la terre, l’incisive exiguë cherche à paraître à travers la chair sensible et rose qui résiste."
                                            },
                                            {
                                                "example_id": "929c966c-36fc-499a-98d5-27e910d1a0b5",
                                                "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                                                "text": "J’allais donc, grattant à la dérobée le jardin d’essai, surprendre la griffe ascendante du cotylédon, le viril surgeon que le printemps chassait de sa gaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e15d3235-cfc2-3afe-9acc-612b48a4bf07",
                                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                                        "glosses": [
                                            "Synonyme de nombril de Vénus (espèce de plantes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f77b1259-5abd-3c14-9547-b3afa2701ab4",
                                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2832f856-4e8a-4c0d-81b1-f91d6532a4bf",
                                                "sense_id": "f77b1259-5abd-3c14-9547-b3afa2701ab4",
                                                "text": "J’avais un costume de lord écossais : une petite veste de velours noir en forme de cotylédon de fève, une chemise de linon fermée au cou par un cordonnet de soie, de petites culottes bouffantes en satin vert, de beaux bas de fil et des souliers à boucles."
                                            },
                                            {
                                                "example_id": "911bfae2-5cfa-4c9a-9659-2b72180ac1ff",
                                                "sense_id": "f77b1259-5abd-3c14-9547-b3afa2701ab4",
                                                "text": "Ce qui m’aida aussi, ce fut ce squelette sous parchemin : ces deux cotylédons d’os iliaques, ces cavités pelviennes dans lesquelles la peau s’enfonçait et dont il fallait que je nettoie le fond avec de petites houppes de coton, ce pubis rocheux, ce sexe ruiné sous des herbes blanches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
