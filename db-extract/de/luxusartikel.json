                "senses": [
                    {
                        "sense_id": "9a783802-9434-3b6c-8f9d-d8645b8a8a8b",
                        "entry_id": "2bd6f369-7248-35f3-b8c8-a163b8bd1594",
                        "glosses": [
                            "Artikel, der nicht zum alltäglichen Bedarf gehört und stattdessen der Freude der Person, die ihn besitzt, dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a0ba6a8-0251-4927-965c-0adfabcbd7c9",
                                "sense_id": "9a783802-9434-3b6c-8f9d-d8645b8a8a8b",
                                "text": "„Die Indianer versorgten ihre Gäste mit auf Handmühlen geriebenem Maismehl, Wildbret, Buffalofleisch und Geflügel, wofür die Seeräuber ihnen Feuergewehre, Kleidungsstücke und selbst Luxusartikel brachten.“"
                            },
                            {
                                "example_id": "8963b985-5cd8-4de2-a1eb-50e35a4b7c38",
                                "sense_id": "9a783802-9434-3b6c-8f9d-d8645b8a8a8b",
                                "text": "„Auf der Rückfahrt brachten sie römische Luxusartikel und römischen Wein nach Manching – ein berauschendes Geschäft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
