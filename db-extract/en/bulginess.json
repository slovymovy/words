                        "glosses": [
                            "The state of being bulgy"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "beb1f4ef-2281-4118-9657-ee2164746c2a",
                                "sense_id": "f2fdc8e3-7afd-32af-87a4-b2cf4f02721a",
                                "text": "He was only partially dressed; his face had the peculiar bulginess of the hard drinker; his eyes were watery and shifty, and several days' growth of beard, with patchy grey and black spots, gave a stucco effect to his countenance."
                            },
                            {
                                "example_id": "03aa4484-07d7-4cfe-9ded-d9fc49edc178",
                                "sense_id": "f2fdc8e3-7afd-32af-87a4-b2cf4f02721a",
                                "text": "There is nothing in Grown-up Land that equals the thrill the delicious bulginess of the stocking, gripped in the darkness, gave one."
                            },
                            {
                                "example_id": "04ad9eba-c66a-464e-bb58-1e31d1943405",
                                "sense_id": "f2fdc8e3-7afd-32af-87a4-b2cf4f02721a",
                                "text": "For if that huge and hideous machine Should thrust its bilious bulginess between A blameless couple, such as we have been, My SERAPHINE, I will not condescend to make a \"scene,\" But--if you needs must have your crinoline-- Good-bye!"
                            }
                        ]
                    }
