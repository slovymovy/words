                "senses": [
                    {
                        "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                        "entry_id": "ac742c2c-a281-37a7-91f4-7af4ee098a63",
                        "glosses": [
                            "Geschäftszweig, der sich mit dem Finanzwesen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea60c0a4-03d1-42c1-adf4-a20e04827860",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„‚Seit mehr als 150 Jahren ist die Deutsche Bank ein Pionier der Bankenbranche, und sie kann auf eine starke Innovationstradition im Bereich Finanzdienstleistungen verweisen‘, sagte Sundar Pichai, Vorstandsvorsitzender von Google und Alphabet.“"
                            },
                            {
                                "example_id": "7aa6c428-3640-4435-b9e2-b3dc920fddf0",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Die Bankenbranche hat die Finanzkrise glimpflich überstanden.“"
                            },
                            {
                                "example_id": "e15fc34a-8749-4846-b99d-3ffa24a829b9",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Die Bankenbranche steht ohnehin schon unter Druck durch die seit Jahren niedrigen Zinsen und den harten Wettbewerb.“"
                            },
                            {
                                "example_id": "6bc68626-a5c3-4a9a-b3f4-7a96d048e493",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Offenbar schafft es also auch in Frankreich die Bankenbranche, die Nebenwirkungen der Geldpolitik durchaus ins Bewusstsein der Notenbank zu bringen.“"
                            },
                            {
                                "example_id": "73a097d3-3585-4659-b2e9-8fe390cbdb04",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Die Bankenbranche steht hinter den Plänen für einen europäischen Finanzmarkt.“"
                            },
                            {
                                "example_id": "45a62021-2620-48da-bb57-40babeba73d9",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Aufgrund der massiven Veränderungen in der Bankenbranche werden selbst gute Kandidaten vielfach keine Möglichkeiten in vergleichbarer Funktion bei Mitbewerbern finden.“"
                            },
                            {
                                "example_id": "29fdcf81-4b27-409d-a5b2-ee7d945ae33c",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Stark zeigte sich auch die Chemie-, Rohstoff- und Bankenbranchen mit Anstiegen um bis zu 2,2 Prozent bei ihren Teilindizes.“"
                            },
                            {
                                "example_id": "ab148e19-bdf4-457f-be5c-1fd7168bab7e",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Die nationalen Aufseher unterziehen ihre Bankenbranchen zudem regelmässig Stresstests, um deren Fitness zu testen.“"
                            },
                            {
                                "example_id": "cf08105e-ae10-47a4-9995-776090316df7",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Als grösste Risiken sehen die Befragten die Cyberkriminalität (86%) und den Verlust von Arbeitsplätzen durch die Automatisierung in der Bankenbranchen (39%).“"
                            },
                            {
                                "example_id": "034de25e-00ef-4b2b-95a5-1bce43ad41f3",
                                "sense_id": "03ddf416-749b-3e6e-a83c-7c0d5aad78c0",
                                "text": "„Gemessen an der Bilanzsumme haben Deutschland und Frankreich die mit Abstand größte Bankenbranchen im Euroraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
