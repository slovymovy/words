                                        ]
                                    },
                                    {
                                        "sense_id": "e4ebdf4b-b771-372e-bb3c-930a5e2264fc",
                                        "entry_id": "f4c952c4-80fe-3593-a47f-8aa3334bdabb",
                                        "glosses": [
                                            "Qui empêche une chose ; qui a un gros défaut et qui, à cause de cela, est inacceptable."
                                        ],
