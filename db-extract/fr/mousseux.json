                "senses": [
                    {
                        "sense_id": "11f0da11-f3f8-3fb9-9985-1bab24d79508",
                        "entry_id": "694de960-9cbf-39db-a7f1-a20a3e7dc400",
                        "glosses": [
                            "Qui ressemble à de la mousse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c55b17-b5bf-4ceb-87f9-197044c2d637",
                                "sense_id": "11f0da11-f3f8-3fb9-9985-1bab24d79508",
                                "text": "Un tapis mousseux."
                            },
                            {
                                "example_id": "dfaa4253-c4fd-44c6-bec5-d45d9496b080",
                                "sense_id": "11f0da11-f3f8-3fb9-9985-1bab24d79508",
                                "text": "Schwann, quand je le connus, devait être âgé de soixante ans ; il était petit, mince, fluet, léger comme une danseuse ; ses cheveux mousseux, crépelés, complètement blancs, d'un blanc de lune et de lait, s'envolaient autour de son front."
                            }
                        ]
                    },
                    {
                        "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                        "entry_id": "694de960-9cbf-39db-a7f1-a20a3e7dc400",
                        "glosses": [
                            "Qui mousse, qui fait beaucoup de mousse ou qui pétille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b5e043d-d96c-4b9c-986a-91f12f8540fd",
                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                "text": "Cidre mousseux."
                            },
                            {
                                "example_id": "ff92b60a-9395-4210-99a0-da2b13f62326",
                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                "text": "Bière mousseuse."
                            },
                            {
                                "example_id": "0dc2fce0-c880-4053-9ad0-027856dc8982",
                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                "text": "Vin mousseux."
                            },
                            {
                                "example_id": "05edbc93-ce74-4f67-a563-f4623c8322d9",
                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                "text": "Rose mousseuse (se dit parfois pour rose moussue.)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a405675e-c771-4b9e-8c42-61023f0139ef",
                        "source_entry_id": "694de960-9cbf-39db-a7f1-a20a3e7dc400",
                        "source_sense_id": "11f0da11-f3f8-3fb9-9985-1bab24d79508",
                        "source_sense_description": "Comme de la mousse",
                        "target_lang_word": "foamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "734d81a0-549b-3304-9221-e9a0626d6068",
                                        "entry_id": "a19f10dd-695f-3cba-9ab9-60d06a3c09c9",
                                        "glosses": [
                                            "Full of foam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05f4f906-2fa6-4efe-ac2f-a821859d8563",
                                                "sense_id": "734d81a0-549b-3304-9221-e9a0626d6068",
                                                "text": "He jumped overboard into the foamy waters of the Atlantic Ocean."
                                            },
                                            {
                                                "example_id": "8a4c3426-27ab-4666-bcbe-44b1fc748578",
                                                "sense_id": "734d81a0-549b-3304-9221-e9a0626d6068",
                                                "text": "Tlepolemus, the sun of Hercules, / Led nine swift vessels through the foamy seas"
                                            },
                                            {
                                                "example_id": "728d2132-3b3b-40fd-bfa1-cdcd810c4e80",
                                                "sense_id": "734d81a0-549b-3304-9221-e9a0626d6068",
                                                "text": "For busy thoughts the Stream flowed on / In foamy agitation"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "foamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2514f1b0-e872-3c28-a6da-2e8738e67404",
                                        "entry_id": "bebb789b-e99a-31f3-9f22-0c607a777462",
