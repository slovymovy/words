    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                    "sense_definition": "Contraindre ou obliger quelqu'un à accomplir une action contre sa volonté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contrainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses parents ne veulent pas le <w>forcer</w> à choisir un métier qu'il n'aime pas."
                        },
                        {
                            "text": "Face aux vives contestations, le directeur a été <w>forcé</w> de revenir sur sa décision."
                        }
                    ],
                    "synonyms": [
                        "contraindre",
                        "obliger"
                    ],
                    "common_phrases": [
                        "forcer la main",
                        "se faire forcer"
                    ]
                },
                {
                    "sense_id": "d394510a-6269-3473-a5ed-bafa10553a85",
                    "sense_definition": "Ouvrir, briser ou débloquer un accès fermé en usant de violence physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "effraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cambrioleur a tenté de <w>forcer</w> la porte d'entrée avec un tournevis."
                        },
                        {
                            "text": "Les pompiers ont rapidement <w>forcé</w> la fenêtre pour évacuer les résidents."
                        }
                    ],
                    "synonyms": [
                        "enfoncer",
                        "fracturer"
                    ],
                    "common_phrases": [
                        "forcer un coffre",
                        "forcer une porte",
                        "forcer une serrure"
                    ]
                },
                {
                    "sense_id": "1bd616c9-a19e-3817-a3f2-cc56836f1ad9",
                    "sense_definition": "Fournir un gros effort physique, solliciter son corps de façon intense.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a conseillé de marcher un peu chaque jour sans trop <w>forcer</w>."
                        },
                        {
                            "text": "Ce coureur a largement dominé la course sans <w>forcer</w> sur la fin."
                        }
                    ],
                    "common_phrases": [
                        "ne pas forcer",
                        "sans forcer"
                    ]
                },
                {
                    "sense_id": "4e38a904-f9e4-3b86-ba55-284a398d304c",
                    "sense_definition": "Se contraindre, faire un effort pénible sur soi-même pour faire quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contrainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même s'il était épuisé, il s'est <w>forcé</w> à terminer son rapport professionnel."
                        },
                        {
                            "text": "L'enfant n'aime pas la soupe mais se <w>force</w> pour faire plaisir à sa grand-mère."
                        }
                    ],
                    "synonyms": [
                        "se contraindre",
                        "s'obliger"
                    ],
                    "common_phrases": [
                        "se forcer à"
                    ]
                },
                {
                    "sense_id": "84083a22-46d9-3d29-b374-074e88fbe1fb",
                    "sense_definition": "Pousser un organe, une capacité ou un rythme au-delà de ses limites normales.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche du violent orage, les randonneurs ont commencé à <w>forcer</w> le pas."
                        },
                        {
                            "text": "Le chanteur s'est abîmé les cordes vocales en <w>forçant</w> sa voix pendant le concert."
                        }
                    ],
                    "synonyms": [
                        "accentuer",
                        "presser"
                    ],
                    "common_phrases": [
                        "forcer l'allure",
                        "forcer le pas",
                        "forcer sa voix"
                    ]
                },
                {
                    "sense_id": "23dc3601-610c-3b97-96a3-2f39f14413e2",
                    "sense_definition": "Consommer ou employer quelque chose avec excès, en mettre une quantité exagérée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier a un peu trop <w>forcé</w> sur le piment dans ce plat traditionnel."
                        },
                        {
                            "text": "Il ne devrait pas conduire car il a visiblement <w>forcé</w> sur la boisson ce soir."
                        }
                    ],
                    "synonyms": [
                        "abuser",
                        "exagérer"
                    ],
                    "common_phrases": [
                        "forcer sur la dose",
                        "forcer sur le sel"
                    ]
                },
                {
                    "sense_id": "e9641534-3e62-386c-a13f-4edf9491ec94",
                    "sense_definition": "Franchir ou emporter un obstacle ou un périmètre de défense par la force.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "effraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'automobiliste a refusé de s'arrêter et a osé <w>forcer</w> le barrage de police."
                        },
                        {
                            "text": "Les soldats ont finalement réussi à <w>forcer</w> les lignes défensives de l'ennemi."
                        }
                    ],
                    "synonyms": [
                        "franchir",
                        "percer"
                    ],
                    "common_phrases": [
                        "forcer un barrage",
                        "forcer un passage"
                    ]
                },
                {
                    "sense_id": "75eea2e0-b171-351b-b862-c72cbf534bef",
                    "sense_definition": "Détériorer, déformer ou fausser un mécanisme ou une articulation sous l'effet d'une pression excessive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "effraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En insistant avec la mauvaise clé, tu vas finir par <w>forcer</w> la serrure fragile."
                        },
                        {
                            "text": "Le gymnaste s'est <w>forcé</w> le poignet lors d'une mauvaise réception au sol."
                        }
                    ],
                    "synonyms": [
                        "déformer",
                        "fausser"
                    ],
                    "common_phrases": [
                        "forcer un muscle"
                    ]
                },
                {
                    "sense_id": "48b02707-e765-35b2-b52e-0f6673d06f04",
