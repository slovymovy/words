        "ru-extract.jsonl": [
            {
                "entry_id": "7c7ce74a-83d5-364f-87f6-254f18f817cb",
                "word": "йоу",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5ce76a3-8c86-3343-864c-edff24cf3889",
                        "entry_id": "7c7ce74a-83d5-364f-87f6-254f18f817cb",
                        "glosses": [
                            "жарг. используется в качестве приветствия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a213574-eec3-42f7-8ace-df4a186a687a",
                                "sense_id": "a5ce76a3-8c86-3343-864c-edff24cf3889",
                                "text": "Ну, он давно у меня жил, в приюте, не могла же я его там оставить, вот и протащила втайне на звездолет, ты же не разрешил бы. Йоу, еще бы я разрешил! Сюрприз на сюрпризе, чего еще ждать от дитятки природы, цветка нашего будущего?"
                            },
                            {
                                "example_id": "3b9f4401-1865-4b72-8f39-1f4a5d283e94",
                                "sense_id": "a5ce76a3-8c86-3343-864c-edff24cf3889",
                                "text": "Когда слышишь его рассуждения о том, что Россия – большая страна, так и ждешь, что сейчас он заорет «Йоу, Конди!»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ca799cf-5602-46b9-b369-28bd46ae74d7",
                        "source_entry_id": "7c7ce74a-83d5-364f-87f6-254f18f817cb",
                        "source_sense_id": "a5ce76a3-8c86-3343-864c-edff24cf3889",
                        "target_lang_word": "yo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65fd762a-6c60-3a02-9504-6b602dd55249",
                                        "entry_id": "eca24286-e994-32e9-8307-4ed4c420abfd",
                                        "glosses": [
                                            "A greeting similar to hi."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72ee3f6-354d-4b69-85af-9e637b8c7a1e",
                                                "sense_id": "65fd762a-6c60-3a02-9504-6b602dd55249",
                                                "text": "Yo Paulie! How's it going?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a42cbb15-9a2d-3ce2-b629-744b09f73f14",
                                        "entry_id": "eca24286-e994-32e9-8307-4ed4c420abfd",
                                        "glosses": [
                                            "An interjection similar to hey."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d85a03b-7c85-483d-85e4-23a76564de6a",
                                                "sense_id": "a42cbb15-9a2d-3ce2-b629-744b09f73f14",
                                                "text": "Yo, check this out!"
                                            },
                                            {
                                                "example_id": "64bec4a9-42e1-4c9f-818e-84885680ece0",
                                                "sense_id": "a42cbb15-9a2d-3ce2-b629-744b09f73f14",
                                                "text": "Check this out, yo!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e3b2736-543a-3742-a386-91c6c3b65121",
                                        "entry_id": "eca24286-e994-32e9-8307-4ed4c420abfd",
                                        "glosses": [
                                            "An expression of surprise or excitement."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06fe32ec-6058-4f01-a3a6-0cf491167614",
                                                "sense_id": "3e3b2736-543a-3742-a386-91c6c3b65121",
                                                "text": "Yo, that's crazy, but I don't remember asking."
                                            },
                                            {
                                                "example_id": "7c7a342d-5b85-4a6f-bedb-7636adc8c04c",
                                                "sense_id": "3e3b2736-543a-3742-a386-91c6c3b65121",
                                                "text": "I have quickly acclimated myself to the standard form of greeting on campus: \"Oh hey what’s your name? … Yeah, nice to meet you, what're you studying? … Yo that’s sick!\" A script to recite, nearly verbatim, 10 times a day or more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596d8b8d-da32-39e2-9dcd-c54a405fe8bf",
                                        "entry_id": "eca24286-e994-32e9-8307-4ed4c420abfd",
                                        "glosses": [
                                            "Present! Here!"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da9c1415-f3cd-459c-82c1-bafaa95e6220",
                                                "sense_id": "596d8b8d-da32-39e2-9dcd-c54a405fe8bf",
                                                "text": "Sergeant: Smith?\nPrivate Smith: Yo!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793e768f-a990-3815-9d80-1a368ba3bed5",
                                        "entry_id": "eca24286-e994-32e9-8307-4ed4c420abfd",
                                        "glosses": [
                                            "Emphatic conclusion to a statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4b51bc5-f54a-404f-bd9c-b1bbd74e11ef",
                                                "sense_id": "793e768f-a990-3815-9d80-1a368ba3bed5",
                                                "text": "JESSE: That is messed up, yo."
                                            }
                                        ]
                                    }
                                ]
                            },
