                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08359bdb-80ea-4e3c-a57d-78a3a073739e",
                                "sense_id": "b7027b24-99ea-3495-a618-b1020269384c",
                                "text": "„Er sah dem Panzerspähwagen gestrafft entgegen, nicht beklommen, sondern nur gestrafft.“"
                            },
                            {
                                "example_id": "7778dc54-3658-4e41-8ba0-9642a1025031",
                                "sense_id": "b7027b24-99ea-3495-a618-b1020269384c",
                                "text": "„Über die unbedeutende Seitenstraße bewegte sich eine lange Kolonne von deutschen Panzerspähwagen mit aufgemalten Balkenkreuzen auf sie zu.“"
                            }
                        ],
