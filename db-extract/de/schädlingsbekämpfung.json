                        "sense_id": "99a1090d-b830-305c-bace-15307106207f",
                        "entry_id": "defc5a43-c1af-362f-b429-1105f4ce3446",
                        "glosses": [
                            "das Ergreifen von Maßnahmen gegen Tiere, Pflanzen und Mikroorganismen, die direkt oder indirekt dem Menschen Schaden zufügen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e52eca-de59-42c3-a67a-9a0bf2c1e895",
                                "sense_id": "99a1090d-b830-305c-bace-15307106207f",
                                "text": "Netze sind ein effektives Mittel der Schädlingsbekämpfung gegen Mücken, die Krankheiten übertragen können."
                            },
                            {
                                "example_id": "ace53a69-45ba-48e2-a0df-4da5c0be1ac4",
                                "sense_id": "99a1090d-b830-305c-bace-15307106207f",
                                "text": "Bauern setzten früher gerne Katzen als Maßnahme der Schädlingsbekämpfung gegen Ratten und Mäuse ein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
