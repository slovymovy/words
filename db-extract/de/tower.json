                                                "example_id": "fca5f512-f473-48fc-bbbd-424625d0aa95",
                                                "sense_id": "53575690-2af4-3972-8f8d-d1b4c974d3fd",
                                                "text": "Lay trains of amorous intrigues / In towers, and curls, and periwigs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f0bd50f-d84f-3983-8108-e42a243dcea2",
                                        "entry_id": "ad5ed156-0db0-323f-894a-04fe81e68a2e",
