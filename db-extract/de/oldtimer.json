                                        "entry_id": "de6e5c7a-eb5c-34d3-a727-046c8ad92f31",
                                        "glosses": [
                                            "A motor car that is of an older make and model, especially one that was built between the years 1919 and 1930."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc81087-1ae8-4309-b37b-9937ebe9667c",
                                                "sense_id": "1748e5e4-243e-3a78-ab67-2e05c31c89ad",
                                                "text": "The identity of a vintage car was to be ascertained by the normal customs of the vintage car trade, and, on the evidence of both experts, the car did correspond with its description as a '1930 Bentley Speed Six'."
                                            },
                                            {
                                                "example_id": "e630a13a-4bd8-4c19-894f-934a624acda7",
                                                "sense_id": "1748e5e4-243e-3a78-ab67-2e05c31c89ad",
                                                "text": "\"Pebble\" as this event is commonly called, is the grand daddy of the vintage car collector world."
                                            },
                                            {
                                                "example_id": "ccbad238-5751-4f93-b344-b4aea90c1496",
                                                "sense_id": "1748e5e4-243e-3a78-ab67-2e05c31c89ad",
                                                "text": "An aging body is like owning a vintage car. A vintage car is exotic and beautiful, and it requires more maintenance."
                                            }
                                        ]
                                    }
