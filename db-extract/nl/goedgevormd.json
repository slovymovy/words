                        "sense_id": "b4c83900-0487-38e9-b51f-fa9126905aec",
                        "entry_id": "c6c31689-2519-33f2-be3f-481c9a085a60",
                        "glosses": [
                            "een mooi uiterlijk hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae278bf-ad29-4823-bbcc-c168a75972ac",
                                "sense_id": "b4c83900-0487-38e9-b51f-fa9126905aec",
                                "text": "Haar neus was klein en goedgevormd, maar ze had niet de katachtige blik die me bij Lavinia was opgevallen toen ik haar voor het eerst zag; ze kon toen nauwelijks ouder zijn geweest dan Louise nu was."
                            },
                            {
                                "example_id": "2ade84e6-2c88-4130-aee6-d02dca5560bd",
                                "sense_id": "b4c83900-0487-38e9-b51f-fa9126905aec",
                                "text": "Haar trekken waren Grieks en klassiek, haar donkere haar golfde losjes om haar goedgevormde hoofd, haar diepliggende grijze ogen hadden zwarte wimpers."
                            },
                            {
                                "example_id": "c26d5c23-16c3-439e-9190-a657ff4b386d",
                                "sense_id": "b4c83900-0487-38e9-b51f-fa9126905aec",
                                "text": "Het goedgevormde lijf van hoofdrolspeler Jamie Dornan kan de goedkeuring van de meeste vrouwen wel wegdragen: elke keer als de acteur zijn shirt uittrekt, gaat er een goedkeurend gemompel door de zaal."
                            }
                        ]
                    }
