                "senses": [
                    {
                        "sense_id": "1755e385-a90e-34c8-8f75-9df5d150b8e9",
                        "entry_id": "85603473-2e91-3bec-ba4b-557c5c8fb550",
                        "glosses": [
                            "spätantikes Glaubensbekenntnis; wichtigstes Glaubensbekenntnis des Christentums"
                        ],
                        "tags": [
                            "Christentum/Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "bc431570-d678-4dfb-8a03-8742e31fe853",
                                "sense_id": "1755e385-a90e-34c8-8f75-9df5d150b8e9",
                                "text": "„Das grosse Glaubensbekenntnis entstand aus dem Glaubensbekenntnis, welches auf den Konzil von Nicäa (jetzt Iznik in der Türkei) im Jahre 325 n. Chr beschlossen wurde. Die endgültige Form erhielt es auf dem Konzil von Konstantinopel (jetzt Istanbul) im Jahr 381. Aus diesem Grunde wird es auch als das Nicäno-Konstantinopolitanum bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "005927ef-f25a-479b-aca6-e7d1f4a15d74",
                        "source_entry_id": "85603473-2e91-3bec-ba4b-557c5c8fb550",
                        "source_sense_id": "1755e385-a90e-34c8-8f75-9df5d150b8e9",
                        "source_sense_description": "Christentum/Theologie: spätantikes Glaubensbekenntnis; wichtigstes Glaubensbekenntnis des Christentums",
                        "target_lang_word": "Niceno-Constantinopolitan Creed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niceno-Constantinopolitan Creed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "309f246f-2d22-3628-a27d-ad49d09f22c8",
                                        "entry_id": "b249a2b2-c323-3372-9213-848692ebbb27",
                                        "glosses": [
                                            "Alternative form of Nicene-Constantinopolitan Creed."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1a2f6d-db05-430a-a38e-513926ac4037",
                                                "sense_id": "309f246f-2d22-3628-a27d-ad49d09f22c8",
                                                "text": "The Council of Ephesus, rated as the third Ecumenical Council, after a due recital of the Niceno-Constantinopolitan Creed which defines the procession of the Holy Ghost simply from the Father, determined: that it was unlawful to introduce any other additional point of faith into that already solemnly recognised Symbol."
                                            },
                                            {
                                                "example_id": "a979e760-b39f-440e-a759-50a8a6b714a8",
                                                "sense_id": "309f246f-2d22-3628-a27d-ad49d09f22c8",
                                                "text": "The addition [et filio] to the Niceno-Constantinopolitan Creed, which first appeared in Spain, was continually more and more generally received, in the Latin churches, notwithstanding Pope Leo III. refused it his sanction."
                                            },
                                            {
                                                "example_id": "b88a9d4c-f9c4-44c8-925e-ca6f1b3e1295",
                                                "sense_id": "309f246f-2d22-3628-a27d-ad49d09f22c8",
                                                "text": "Is it not enough, they [Anglican bishops] ask, that Anglicans who participate in a Roman Catholic Eucharist are able to recite the Niceno-Constantinopolitan Creed and make the various responses, including the grand “Amen” at the end of the Eucharistic Prayer?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
