{
    "word_family": [
        "trouncing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c82c2408-9c71-35d8-96ca-d650f4e6deda",
                    "sense_definition": "To beat or overcome thoroughly, to defeat heavily; especially in games or sports, to win against someone by a wide margin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local team managed to <w>trounce</w> their rivals by five goals in the final match.",
                            "target_lang_translations": {
                                "ru": "Местной команде удалось <w>разгромить</w> своих соперников со счетом пять-ноль в финальном матче."
                            }
                        },
                        {
                            "text": "Many analysts predicted they would <w>trounce</w> the opposition in the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Многие аналитики предсказывали, что они <w>разобьют наголову</w> оппозицию на предстоящих выборах."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrash",
                        "vanquish",
                        "overcome",
                        "subdue"
                    ],
                    "common_phrases": [
                        "trounce the opposition",
                        "trounce the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанести сокрушительное поражение, разгромить соперника (особенно в игре, спорте или на выборах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "нанести сокрушительное поражение"
                            },
                            {
                                "target_lang_word": "разбить наголову",
                                "target_lang_sense_clarification": "одержать полную победу"
                            },
                            {
                                "target_lang_word": "одержать убедительную победу над",
                                "target_lang_sense_clarification": "выиграть с большим преимуществом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79ec5b2-54bc-3d5b-ad4d-18d06fbd7d71",
                    "sense_definition": "To beat severely; to thrash physically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_beating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry bully threatened to <w>trounce</w> anyone who dared to stand in his way.",
                            "target_lang_translations": {
                                "ru": "Разгневанный хулиган угрожал <w>поколотить</w> любого, кто посмеет встать у него на пути."
                            }
                        },
                        {
                            "text": "He imagined how he would <w>trounce</w> his opponent if they ever met in a fair fight.",
                            "target_lang_translations": {
                                "ru": "Он представлял, как <w>отлупит</w> своего противника, если они когда-нибудь сойдутся в честном бою."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrash",
                        "flog",
                        "beat",
                        "spank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестоко избить, поколотить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избить",
                                "target_lang_sense_clarification": "нанести телесные повреждения"
                            },
                            {
                                "target_lang_word": "поколотить",
                                "target_lang_sense_clarification": "сильно побить"
                            },
                            {
                                "target_lang_word": "отлупить",
                                "target_lang_sense_clarification": "разг., жестоко побить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31f2a94d-e684-313a-b212-2822d93ce8d7",
                    "sense_definition": "To chastise or punish physically or verbally; to scold with harsh or abusive language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "punish_scold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor would regularly <w>trounce</w> writers who submitted sloppy work.",
                            "target_lang_translations": {
                                "ru": "Редактор регулярно <w>разносил</w> авторов, присылавших небрежно выполненную работу."
                            }
                        },
                        {
                            "text": "She feared her parents would <w>trounce</w> her verbally for coming home so late.",
                            "target_lang_translations": {
                                "ru": "Она боялась, что родители устроят ей <w>нагоняй</w> за то, что она пришла домой так поздно."
                            }
                        }
                    ],
                    "synonyms": [
                        "censure",
                        "rebuke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сурово наказать или отчитать; подвергнуть резкой критике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнести",
                                "target_lang_sense_clarification": "разг., подвергнуть жесткой критике"
                            },
                            {
                                "target_lang_word": "выпороть",
                                "target_lang_sense_clarification": "наказать физически или образно отчитать"
                            },
                            {
                                "target_lang_word": "отругать",
                                "target_lang_sense_clarification": "сделать строгий выговор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06a06348-a5c0-342a-9663-ec691064aeb4",
                    "sense_definition": "To punish by bringing a lawsuit against; to sue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He threatened that he would <w>trounce</w> them in court for breach of contract.",
                            "target_lang_translations": {
                                "ru": "Он угрожал, что <w>засудит</w> их в суде за нарушение контракта."
                            }
                        },
                        {
                            "text": "The lawyer promised they would <w>trounce</w> the fraudulent company with a massive lawsuit.",
                            "target_lang_translations": {
                                "ru": "Юрист пообещал, что они <w>привлекут к суду</w> мошенническую компанию, подав масштабный иск."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to mean punishing via legal action"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказать посредством судебного иска; засудить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засудить",
                                "target_lang_sense_clarification": "выиграть суд против кого-либо"
                            },
                            {
                                "target_lang_word": "привлечь к суду",
                                "target_lang_sense_clarification": "наказать через судебный иск"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63bf06a6-3846-3f2c-9c83-20bb00279d40",
                    "sense_definition": "An act of trouncing: a severe beating, a thrashing, or a thorough defeat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The election results were a complete <w>trounce</w> for the ruling political party.",
                            "target_lang_translations": {
                                "ru": "Результаты выборов стали полным <w>разгромом</w> для правящей политической партии."
                            }
                        },
                        {
                            "text": "After receiving a heavy <w>trounce</w> on the field, the team went back to training.",
                            "target_lang_translations": {
                                "ru": "Получив тяжелую <w>трепку</w> на поле, команда вернулась к тренировкам."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт разгрома: сокрушительное поражение или сильная трепка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгром",
                                "target_lang_sense_clarification": "полное поражение"
                            },
                            {
                                "target_lang_word": "трепка",
                                "target_lang_sense_clarification": "разг., сильное избиение или поражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79c3ca12-ada1-3c04-901d-5da01d8bc97c",
                    "sense_definition": "A walk involving some difficulty or effort; a trek, a tramp, or a trudge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "difficult_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a long <w>trounce</w> through the muddy fields before we finally reached the cottage.",
                            "target_lang_translations": {
                                "ru": "Это был долгий и <w>тяжелый путь</w> по грязным полям, прежде чем мы наконец добрались до коттеджа."
                            }
                        },
                        {
                            "text": "After a tiring <w>trounce</w> over the hills, they sat down to rest their aching feet.",
                            "target_lang_translations": {
                                "ru": "После утомительного <w>перехода</w> по холмам они присели отдохнуть, чтобы дать покой гудящим ногам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly dialectal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный, утомительный путь пешком; тяжелый переход."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжелый переход",
                                "target_lang_sense_clarification": "утомительный путь пешком"
                            },
                            {
                                "target_lang_word": "изнурительная ходьба",
                                "target_lang_sense_clarification": "путь, требующий больших усилий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cd2e170-6705-3942-9806-59d851348861",
                    "sense_definition": "A journey involving quick travel, or one that is dangerous or laborious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "difficult_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had a difficult <w>trounce</w> across the mountain pass during the winter storm.",
                            "target_lang_translations": {
                                "ru": "Им предстоял трудный и <w>опасный переход</w> через горный перевал во время зимней бури."
                            }
                        },
                        {
                            "text": "What a dangerous <w>trounce</w> it was to cross the flooded valley in the dark.",
                            "target_lang_translations": {
                                "ru": "Каким же опасным <w>путешествием</w> было пересечение затопленной долины в темноте."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly dialectal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое, но опасное или трудное путешествие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опасный переход",
                                "target_lang_sense_clarification": "трудный путь через опасную местность"
                            },
                            {
                                "target_lang_word": "тяжелое путешествие",
                                "target_lang_sense_clarification": "изнурительная поездка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}