                                                "sense_id": "d1ff5a94-d9a9-3851-99be-16602bf32217",
                                                "text": "Tommy the Tyke is the mascot of Barnsley FC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85022bc9-5644-36de-93d1-d240208791ea",
                                        "entry_id": "a60e174e-c13a-3be6-abed-9aae0e98f69d",
                                        "glosses": [
                                            "A person engaged by an organization to portray its mascot in costume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f57e257-b55a-4d0e-950b-62a3b4bbd581",
