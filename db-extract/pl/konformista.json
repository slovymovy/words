                        "entry_id": "da22b0bc-4011-3d4e-b69d-047380ddfee5",
                        "glosses": [
                            "człowiek, który bezkrytycznie podporządkowuje się normom, wartościom i poglądom uznanym za obowiązujące w danej grupie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65722c2e-1789-4d04-a4a5-779ef0f09530",
                                "sense_id": "04f42974-c5f8-3ce3-b9e2-7c74c4489f33",
                                "text": "Czy nasi śląscy twórcy to ci, którzy uparcie potrafią iść pod prąd (buntownicy?), a może to konformiści, podążający pokornie za aktualnie obowiązującym nurtem?"
                            }
                        ],
