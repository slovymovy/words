                                        "entry_id": "3f1e80ad-17d5-3832-b15c-2f8b880a7b61",
                                        "glosses": [
                                            "The state of not experiencing primary sexual attraction (based on sight or smell or other instantly available information), but only secondary sexual attraction (after the development of an emotional bond)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c22d404-9ff4-421e-93df-4c0564d120ef",
                                                "sense_id": "2feecaf4-a238-3111-902d-4e8cb72c3a8e",
                                                "text": "Asexuality with the ability to experience romantic attraction should not be confused with demisexuality, which is somewhat similar."
                                            },
                                            {
                                                "example_id": "63dd797d-793f-41fe-ae3c-40b230f73424",
                                                "sense_id": "2feecaf4-a238-3111-902d-4e8cb72c3a8e",
                                                "text": "This workshop aims to be a comprehensive coverage of the basics about sexual orientation, gender identity, and LGBT topics with a special focus on asexuality and demisexuality."
                                            },
                                            {
                                                "example_id": "4d239e2d-7a99-477c-aef9-9c7c3ae842a4",
                                                "sense_id": "2feecaf4-a238-3111-902d-4e8cb72c3a8e",
                                                "text": "Demisexuality further complicates my orientation. Or, at the very least, demisexuality imposes more difficulty in describing my particular brand of queerness."
                                            }
