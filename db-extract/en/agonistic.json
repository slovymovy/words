                                    {
                                        "sense_id": "7209181b-8104-38c9-b973-caa386e37abb",
                                        "entry_id": "da528b9b-1f69-387c-8436-20f8b777428c",
                                        "glosses": [
                                            "Qui se rapporte à la lutte ou à la compétition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7e4291-ca70-43ec-90fc-7b7cd685f1aa",
                                                "sense_id": "7209181b-8104-38c9-b973-caa386e37abb",
                                                "text": "C’est un espace public numérique par défaut très agonistique, ne serait-ce que par les contraintes langagières, observe Laurence Allard, sociologue des usages numériques."
                                            },
                                            {
                                                "example_id": "36fba3bd-b4c3-4583-9417-b0a6cb9710b7",
                                                "sense_id": "7209181b-8104-38c9-b973-caa386e37abb",
                                                "text": "Les souverains alliés estiment alors protéger la popularité du roi en France, tout en réservant pour l’avenir et le jeu des apparences diplomatiques une restitution gracieuse de certains chefs-d’œuvre restés en « réserve » et non exposés dans les galeries du « plus beau musée du monde », sous forme de prestations agonistiques et dynastiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agonistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afb1121b-6404-3d30-92f4-d6dd5bca732f",
                                        "entry_id": "7a393815-6b65-3c9d-a8e4-ef25f1f98fdc",
                                        "glosses": [
                                            "Partie de la gymnastique qui avait rapport aux combats et où les athlètes luttaient tous armés."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "912fa7fd-43c5-4555-9048-b3048a7dc6f4",
                                                "sense_id": "afb1121b-6404-3d30-92f4-d6dd5bca732f",
                                                "text": "La gymnastique et l’agonistique y tenaient, en somme, très peu de place. On était loin de l’époque héroïque de Romulus et des premières années de la République."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
