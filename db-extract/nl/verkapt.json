                                    {
                                        "sense_id": "4596eca0-3bf2-3e08-9605-a55ba7a2f2e5",
                                        "entry_id": "1e8d27c4-5671-34c4-9636-f1953c0ee4ce",
                                        "glosses": [
                                            "(möglichst) unauffällig, ohne Aufsehen zu erregen, (möglichst) geräuschlos"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b57009d5-59be-4665-8bff-5659d9d075bc",
                                                "sense_id": "4596eca0-3bf2-3e08-9605-a55ba7a2f2e5",
                                                "text": "Fast zwei Jahre lang hatte das FBI verdeckt gegen die beiden New Yorkerinnen ermittelt. Jetzt müssen sie sich wegen eines angeblich gepanten Anschlags vor Gericht verantworten."
                                            },
                                            {
                                                "example_id": "2b36df7d-8788-49c6-a577-70ff61f0a6c7",
                                                "sense_id": "4596eca0-3bf2-3e08-9605-a55ba7a2f2e5",
                                                "text": "Der stellvertretende albanische Regierungschef Ilir Meta hat sein Amt niedergelegt. Ein verdeckt gedrehtes Video enthüllt, wie er versucht hat, eine öffentliche Ausschreibung zu manipulieren."
                                            },
                                            {
                                                "example_id": "ec969eb3-ca0b-4d6e-becd-a028b71ebc77",
                                                "sense_id": "4596eca0-3bf2-3e08-9605-a55ba7a2f2e5",
                                                "text": "Die meisten Informationen bekommt der Verfassungsschutz aus öffentlichen Quellen wie Zeitungen oder dem Internet. Aber er arbeitet auch mit verdeckten Ermittlern und V-Männern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b540e739-9008-32e1-9560-62b41c4db794",
                                        "entry_id": "1e8d27c4-5671-34c4-9636-f1953c0ee4ce",
                                        "glosses": [
                                            "vor Blicken verborgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3d70a6-787a-4107-9a29-eefca02eb823",
                                                "sense_id": "b540e739-9008-32e1-9560-62b41c4db794",
                                                "text": "Wetterbericht: „Die vormittags von Wolken verdeckte Sonne wird nachmittags häufiger zu sehen sein.“"
                                            },
                                            {
                                                "example_id": "04ac916c-0948-4775-b95d-c5a714f4235e",
                                                "sense_id": "b540e739-9008-32e1-9560-62b41c4db794",
                                                "text": "Die von seinen Haaren verdeckte Stirn gibt normalerweise nicht den Blick auf Harry Potters Narbe frei."
                                            },
                                            {
                                                "example_id": "f1e55859-ac0c-4207-9c96-7f0b07c74074",
                                                "sense_id": "b540e739-9008-32e1-9560-62b41c4db794",
                                                "text": "§67 (2) StVZO - Lichttechnische Einrichtungen an Fahrrädern: Lichttechnische Einrichtungen dürfen nicht verdeckt sein.(=vor dem Frontscheinwerfer und dem Rücklicht darf nichts, z.B. kein Korb, kein Schutzblech, den Lichtstrahl verhindern.)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
