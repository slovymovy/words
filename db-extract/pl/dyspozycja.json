                "translations": [
                    {
                        "translation_id": "1d2273ed-564b-4118-8e98-f3210723ec64",
                        "source_entry_id": "aa8ad5ec-9cf4-307e-a9b3-7c68d6eaf293",
                        "source_sense_id": "f741104a-5c1e-378e-b997-8a91fb7781a7",
                        "target_lang_word": "disposition",
