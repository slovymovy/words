                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bacdbc0-fb8c-38fe-835c-2908a67b0030",
                                        "entry_id": "394d7667-cdeb-3178-a6c9-1fec6422f25a",
                                        "glosses": [
                                            "Fahrzeug von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630e767f-7d7a-46b0-a166-79f72a7c527d",
                                                "sense_id": "7bacdbc0-fb8c-38fe-835c-2908a67b0030",
                                                "text": "„Er ging zu seinem Renault und stieg ein.“"
                                            },
                                            {
                                                "example_id": "af9778b5-4eab-4413-8da7-b7ec2f3c8c11",
                                                "sense_id": "7bacdbc0-fb8c-38fe-835c-2908a67b0030",
                                                "text": "„Bramble händigte dem Kerl auf dem Schrottplatz das restliche Geld aus, woraufhin ihm der heruntergekommene Trottel die Schlüssel für den versprochene Renault in die Hand drückte.“"
                                            },
                                            {
                                                "example_id": "1c1c408b-616d-4458-875d-a3163e8e2d78",
                                                "sense_id": "7bacdbc0-fb8c-38fe-835c-2908a67b0030",
                                                "text": "„Er schob sich an einem Renault vorbei und blieb Neal auf den Fersen.“"
                                            },
                                            {
                                                "example_id": "5670b5da-cba9-428b-95de-ed9667207925",
                                                "sense_id": "7bacdbc0-fb8c-38fe-835c-2908a67b0030",
                                                "text": "„Seine Nummernschilder hatte er auf dem Parkplatz einer Tankstelle von einem Renault geklaut und sie dann an einem danebenstehenden alten Volvo angebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
