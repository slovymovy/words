                "senses": [
                    {
                        "sense_id": "34ed42ce-e4b8-31bb-bf3f-84ba93194941",
                        "entry_id": "cd5f3138-c061-3ddf-b61a-ce465d3bdad8",
                        "glosses": [
                            "Freund aus der frühen Kindheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad3dff06-244a-4864-aa14-201092f7d716",
                                "sense_id": "34ed42ce-e4b8-31bb-bf3f-84ba93194941",
                                "text": "[Schlagzeile:] „Biathlonstar Neuner heiratet ihren Sandkastenfreund“"
                            },
                            {
                                "example_id": "0a8e89f9-e158-422b-aa5a-f5a10df68cae",
                                "sense_id": "34ed42ce-e4b8-31bb-bf3f-84ba93194941",
                                "text": "„Sein Sandkastenfreund arbeitet in der Auslieferung einer Druckerei, viele andere Haupt- oder Realschüler, die er in der Grundschule und bei den Pfadfindern kennengelernt hat, hätten später Erstaunliches aus sich gemacht.“"
                            },
                            {
                                "example_id": "43c6859a-50bf-4579-99cb-63681f239ef1",
                                "sense_id": "34ed42ce-e4b8-31bb-bf3f-84ba93194941",
                                "text": "„Die kollektiv betriebene Kneipe in Schwabing […] war der erste Schritt zu einer bleibenden Spur, die Wolfgang Ettlich im Münchner Kulturleben hinterließ: 1974 eröffneten er und sein Neuköllner Sandkastenfreund Henry \"Henny“ Heppel noch eine Kleinkunstbühne dazu, die bis heute bekannt ist als das \"Heppel und Ettlich“.“"
                            },
                            {
                                "example_id": "40bd1b30-3626-4a4b-a105-398fecfa9182",
                                "sense_id": "34ed42ce-e4b8-31bb-bf3f-84ba93194941",
                                "text": "„Der zwölfjährige Benny Jansen ist Mias Sandkastenfreund und mit Abstand der begnadetste Computerspezialist der Schule.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
