        "fr-extract.jsonl": [
            {
                "entry_id": "af6eec68-e28d-331d-b0e6-54b525bcc697",
                "word": "incurable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0033289f-7730-4185-bcfc-d3f0cfeab993",
                        "entry_id": "af6eec68-e28d-331d-b0e6-54b525bcc697",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "incurables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12d02f4c-9460-3d17-94bf-c7ecf1cce322",
                        "entry_id": "af6eec68-e28d-331d-b0e6-54b525bcc697",
                        "glosses": [
                            "Qui ne peut être guéri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bab6e9c-8a30-42b6-80e4-34a8a8a622be",
                                "sense_id": "12d02f4c-9460-3d17-94bf-c7ecf1cce322",
                                "text": "Si c'eût été l’œil droit, dit-il, je l'aurais guéri ; mais les plaies de l’œil gauche sont incurables."
                            },
                            {
                                "example_id": "224c3aca-72db-4ba5-b376-eee5beb5f182",
                                "sense_id": "12d02f4c-9460-3d17-94bf-c7ecf1cce322",
                                "text": "Ma chère madame Cibot, répondit le docteur, il meurt de la maladie des portiers… son étiolement général annonce une incurable viciation du sang."
                            },
                            {
                                "example_id": "2e09e59c-7e18-4fe4-8321-8f6bb403c2c1",
                                "sense_id": "12d02f4c-9460-3d17-94bf-c7ecf1cce322",
                                "text": "Sortons de Paris, allons à Thevet-Saint-Julien, bourg du département de l'Indre; nous y trouverons une femme de cinquante-cinq ans, qui en avait vingt-deux lorsque sa mère, devenue percluse de tous ses membres, fut déclarée incurable."
                            },
                            {
                                "example_id": "df5c7851-f867-4d71-bb7e-41a8008e0e29",
                                "sense_id": "12d02f4c-9460-3d17-94bf-c7ecf1cce322",
                                "text": "Lorsque le célèbre professeur prononce la brochette de mots « maladie orpheline, incurable, pour l'instant, et pas mortelle », j'ai l'impression qu'il fait un exposé à ses étudiants sans penser à l'impact de ses paroles sur l'être humain qui lui fait face."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b676ff6-84df-33a7-ba7d-f1d32e1185fa",
                        "entry_id": "af6eec68-e28d-331d-b0e6-54b525bcc697",
                        "glosses": [
                            "Incorrigible ; indécrottable."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "44774cb2-0ce3-413f-b6ef-f7fee3090776",
                                "sense_id": "1b676ff6-84df-33a7-ba7d-f1d32e1185fa",
                                "text": "Le dogme de l’incurable méchanceté de l'homme a, d'ailleurs, chez certains de ses adeptes, une autre racine : un plaisir romantique à évoquer la race humaine murée dans une misère fatale et éternelle."
                            },
                            {
                                "example_id": "eabe0d53-3806-4e8b-9d80-28d27079baeb",
                                "sense_id": "1b676ff6-84df-33a7-ba7d-f1d32e1185fa",
                                "text": "Du côté des températures, une nette baisse s’annonce, ce qui ne devrait gêner que les incurables ronchons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed232061-3921-40db-8f5b-36a7a373f2ce",
                        "source_entry_id": "af6eec68-e28d-331d-b0e6-54b525bcc697",
                        "target_lang_word": "unheilbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unheilbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                        "entry_id": "1f096d4a-10c8-3f50-bc76-e1565364d0d4",
                                        "glosses": [
                                            "ohne Aussicht auf oder Möglichkeit von Heilung; nicht heilbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b358b1f-2c0d-40c4-b700-b6ca35ce07f8",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Er ist unheilbar an Krebs erkrankt."
                                            },
                                            {
                                                "example_id": "3233d87d-0321-4069-9ed5-7dcd6701ff7c",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "„Wenn Darmkrebs entdeckt wird, ist er sehr häufig in einem späten Stadium und damit unheilbar.“"
                                            },
                                            {
                                                "example_id": "6bc212f8-f398-48ae-9b02-49dbea24c533",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Antikörper können aktive Krebszellen reduzieren oder sogar ausschalten. Das zeigt eine Reihe von Experimenten an sieben als unheilbar krank eingestuften Krebspatienten an der Universität Tübingen."
                                            },
                                            {
                                                "example_id": "a75f5f9e-4aa9-4b37-bd61-47642faf450e",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Im Gegensatz zum Hospital, auch Krankenhaus genannt, sind Hospize nur für unheilbar kranke Menschen, die bald sterben werden, vorgesehen."
                                            },
                                            {
                                                "example_id": "3c7c6130-4577-4868-bbeb-6c52845a2409",
                                                "sense_id": "a470a42d-1f5c-3aa0-bc92-e6f1917ab2b8",
                                                "text": "Wenn ein unheilbar krankes Kind den Wunsch hat zu sterben, können belgische Ärzte künftig ganz legal seinen Tod herbeiführen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9355a99-72b4-4f19-8fd3-bea0998456bf",
                        "source_entry_id": "af6eec68-e28d-331d-b0e6-54b525bcc697",
                        "target_lang_word": "unverbesserlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverbesserlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8c345bf-60e8-30cf-bba7-578f116b9dba",
                                        "entry_id": "0b8d762d-08fd-3228-b608-4df28bdf1f3a",
                                        "glosses": [
                                            "durch nichts von seiner Haltung/Meinung abbringbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f757b2d-addb-42e9-9c01-292466b97ad5",
                                                "sense_id": "c8c345bf-60e8-30cf-bba7-578f116b9dba",
                                                "text": "„Nur ein unverbesserlicher Egoist kann den Fesseln entgehen, die ihm durch einen ungleichen Partner auferlegt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17256525-4bc0-376f-879a-b30c4d688ca8",
                                        "entry_id": "0b8d762d-08fd-3228-b608-4df28bdf1f3a",
                                        "glosses": [
                                            "keine Aussicht auf Besserung/Heilung gewährend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dcb5c07-75b9-4072-ba34-25715c4e66c9",
                                                "sense_id": "17256525-4bc0-376f-879a-b30c4d688ca8",
                                                "text": "„Den Aufklärern indes und den Philanthropen war - in ihrem Glauben an die Möglichkeit für jeden Menschen, sein Leben vernünftig zu führen - die Unvernunft des Irren und sein Wahnsinn ein ideologisches Ärgernis und sein bis dahin unverbesserlicher Zustand eine praktische Herausforderung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b19fee2-fe47-438e-b45f-971786f1ade0",
                        "source_entry_id": "af6eec68-e28d-331d-b0e6-54b525bcc697",
                        "target_lang_word": "incurable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incurable",
