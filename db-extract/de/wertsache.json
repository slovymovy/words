                ],
                "senses": [
                    {
                        "sense_id": "4a78b8a1-78c5-30ee-b527-3957ad4e1a8e",
                        "entry_id": "a9303740-6bd3-3989-85a0-b2ae8335ef1b",
                        "glosses": [
                            "ein wertvoller, teurer Gegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b9babf-6893-4b89-80b8-a1a526484e22",
                                "sense_id": "4a78b8a1-78c5-30ee-b527-3957ad4e1a8e",
                                "text": "Die Wertsachen werden im Tresor aufbewahrt."
                            },
                            {
                                "example_id": "73c37ea7-a7de-4540-8def-9513f0db900a",
                                "sense_id": "4a78b8a1-78c5-30ee-b527-3957ad4e1a8e",
                                "text": "Die Urlauber sollten ihre Wertsachen im gemieteten Schließfach auf dem Zimmer aufbewahren und nicht im Koffer lassen."
                            },
                            {
                                "example_id": "258c1cef-39d5-4f3a-95c7-ae1544b3e193",
                                "sense_id": "4a78b8a1-78c5-30ee-b527-3957ad4e1a8e",
                                "text": "Unter den gestohlenen Wertsachen war auch der Goldschmuck der Urgroßmutter."
                            },
                            {
                                "example_id": "ce60725a-7ca6-49c5-80e1-7e0cb9e0c7dd",
                                "sense_id": "4a78b8a1-78c5-30ee-b527-3957ad4e1a8e",
                                "text": "„Dem Lehmann musste ich seine Wertsachen abnehmen.“"
                            },
                            {
                                "example_id": "d0d5d7ea-f3d4-4ae3-a0d5-a3baf586234c",
                                "sense_id": "4a78b8a1-78c5-30ee-b527-3957ad4e1a8e",
                                "text": "„Dort mussten sie den Nationalgardisten allen Schmuck, ihre Uhren, Wertsachen, Pelze und alles Bargeld aushändigen; nur den Ehering durften sie behalten.“"
                            },
                            {
                                "example_id": "35297bea-6145-43b0-bca6-856c6981d6d7",
                                "sense_id": "4a78b8a1-78c5-30ee-b527-3957ad4e1a8e",
                                "text": "„Aber selbst wirkliche Wertsachen, Perlen, Diamanten, seltene Antiquitäten, die sicherlich nicht immer auf ehrliche Weise erworben wurden, fließen durch diesen Markt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
