{
    "word_family": [
        "heerser",
        "heerschappij",
        "heersen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd599ce4-3a01-3083-b454-b13bd9042dbc",
                    "sense_definition": "Die de macht heeft of de leiding geeft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "macht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>heersende</w> klasse bepaalde in die tijd de wetten van het land.",
                            "target_lang_translations": {
                                "en": "The <w>ruling</w> class determined the laws of the country at that time."
                            }
                        },
                        {
                            "text": "Er was veel onvrede over de <w>heersende</w> elite in de hoofdstad.",
                            "target_lang_translations": {
                                "en": "There was much dissatisfaction with the <w>ruling</w> elite in the capital."
                            }
                        }
                    ],
                    "synonyms": [
                        "dominant",
                        "machthebbend"
                    ],
                    "common_phrases": [
                        "heersende klasse"
                    ],
                    "target_lang_definitions": {
                        "en": "Having power or authority; in control."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ruling",
                                "target_lang_sense_clarification": "referring to those who hold political or social power"
                            },
                            {
                                "target_lang_word": "dominant",
                                "target_lang_sense_clarification": "referring to someone or something that has more influence or control than others"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51e6b3a7-9cfe-3c5c-befd-d85d3ff2ae95",
                    "sense_definition": "Wat op een bepaald moment algemeen of wijdverspreid is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voorkomen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de <w>heersende</w> griepgolf bleven veel leerlingen thuis van school.",
                            "target_lang_translations": {
                                "en": "Due to the <w>prevailing</w> flu epidemic, many students stayed home from school."
                            }
                        },
                        {
                            "text": "Er heerst een <w>heersende</w> onzekerheid over de economische toekomst van het bedrijf.",
                            "target_lang_translations": {
                                "en": "There is a <w>prevailing</w> uncertainty about the economic future of the company."
                            }
                        }
                    ],
                    "synonyms": [
                        "algemeen",
                        "gangbaar"
                    ],
                    "common_phrases": [
                        "heersende mening"
                    ],
                    "target_lang_definitions": {
                        "en": "Commonly occurring or widespread at a particular time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prevailing",
                                "target_lang_sense_clarification": "existing or most common at a particular time"
                            },
                            {
                                "target_lang_word": "widespread",
                                "target_lang_sense_clarification": "found or distributed over a large area or number of people"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "275b0f4d-20ac-31ac-b48e-4f1284ca1134",
                    "sense_definition": "Het onvoltooid deelwoord van <w>heersen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning was <w>heersend</w> over zijn uitgestrekte koninkrijk.",
                            "target_lang_translations": {
                                "en": "The king was <w>ruling</w> over his vast kingdom."
                            }
                        },
                        {
                            "text": "Het was een <w>heersend</w> gevoel dat de verandering noodzakelijk was.",
                            "target_lang_translations": {
                                "en": "It was a <w>prevailing</w> sentiment that the change was necessary."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The present participle of the verb 'to rule' or 'to prevail'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ruling",
                                "target_lang_sense_clarification": "exercising authority or control"
                            },
                            {
                                "target_lang_word": "prevailing",
                                "target_lang_sense_clarification": "being the most common or influential state of affairs"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}