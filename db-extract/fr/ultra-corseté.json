                        "sense_id": "c958e759-b8ed-39ef-9b6f-b5ed2a7a56d0",
                        "entry_id": "9c16612b-16dd-30b4-9507-1562bc8a412a",
                        "glosses": [
                            "Extrêmement corseté, rigide dans ses façons de faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcd92c5-90dd-4632-8d75-61f9fd63b296",
                                "sense_id": "c958e759-b8ed-39ef-9b6f-b5ed2a7a56d0",
                                "text": "Là encore, elle découvre un monde ultra-corseté avec des horaires et des règles très rigides."
                            },
                            {
                                "example_id": "2daef653-fd35-4e76-aedd-0931dbaad44d",
                                "sense_id": "c958e759-b8ed-39ef-9b6f-b5ed2a7a56d0",
                                "text": "Cette dernière a suivi grâce aux réseaux sociaux les révolutions arabes et rêve de changement dans des sociétés ultra-corsetées."
                            },
                            {
                                "example_id": "3399bbe4-3ef7-4bd5-9263-9e67560bb22c",
                                "sense_id": "c958e759-b8ed-39ef-9b6f-b5ed2a7a56d0",
                                "text": "Si, à l’époque féodale, le pèlerinage servait d’échappatoire à une société ultra-corsetée, il semble à les lire plutôt répondre aujourd’hui, à l’inverse, à une recherche de règles et d’usages hors de la vie courante."
                            }
                        ]
                    }
