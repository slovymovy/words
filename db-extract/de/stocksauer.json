                ],
                "senses": [
                    {
                        "sense_id": "e630be9b-db4c-3997-ad5d-a5d0e93cb993",
                        "entry_id": "cf616fdb-51d6-360d-a03b-269f236ce0a3",
                        "glosses": [
                            "sehr wütend, große Wut empfindend"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1498434c-22ad-4897-8a31-bd2444629409",
                                "sense_id": "e630be9b-db4c-3997-ad5d-a5d0e93cb993",
                                "text": "„Ich war stocksauer und trotzdem blieb mir nichts anderes übrig, als Rede und Antwort zu stehen.“"
                            },
                            {
                                "example_id": "5d1e9bfc-0213-445e-ae37-691ee9dab198",
                                "sense_id": "e630be9b-db4c-3997-ad5d-a5d0e93cb993",
                                "text": "„Die Schwiegereltern waren natürlich stocksauer auf mich, weil ich ihre Tochter zu einer Wanderung mitnahm und sie ihre Tochter nicht unter Kontrolle hatten.“"
                            },
                            {
                                "example_id": "470b7f4e-0f03-4505-a945-15b9ffc0d1ac",
                                "sense_id": "e630be9b-db4c-3997-ad5d-a5d0e93cb993",
                                "text": "„Ich war stocksauer, und ich wollte es mir nicht verkneifen, stocksauer zu sein, um nicht zu platzen, um nicht vor Gram zu versauern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
