                                            {
                                                "example_id": "5d8ba83e-aa72-4886-be47-dcdb22aedc18",
                                                "sense_id": "9ed61bb0-03c9-34fe-ab03-7d18ab8cf2ad",
                                                "text": "Many were the finings, and excommunications, and the obligings to do penances, that took place at this time."
