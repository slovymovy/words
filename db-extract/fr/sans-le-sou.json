                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe38007-6e51-416c-a314-28d9f05a7205",
                                                "sense_id": "74da569f-b048-341b-aae9-96321cc93b17",
                                                "text": "έφαγα όλα τα λεφτά μου και έχω μείνει απένταρος"
                                            },
                                            {
                                                "example_id": "3e692b4f-b979-436f-8577-617175f24b30",
                                                "sense_id": "74da569f-b048-341b-aae9-96321cc93b17",
                                                "text": "※ Κι ένας απένταρος μπεκρής έξω απ’ το ταβερνάκι / συλλογισμένος κάθεται στο χαμηλό πορτάκι.",
                                                "translation": "Τραγούδι σε στίχους και μουσική τού Γιώργου Μητσάκη"
                                            }
