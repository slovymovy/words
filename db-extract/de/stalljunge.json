                            {
                                "example_id": "e961cf85-f2e3-4fe9-a091-d277e8810065",
                                "sense_id": "d7c13d91-4d33-38e9-ba42-3e243e3b61d6",
                                "text": "„Ein Stalljunge in einer drabfarbenen Velvetjacke hielt zwei von den Pferden, während ein Groom in Zylinder und weißer Lederhose das dritte Pferd, das mit dem Damensattel, andächtig bewachte.“"
                            }
                        ],
