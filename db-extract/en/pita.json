                                        "glosses": [
                                            "Galette de pain, traditionnelle dans le monde méditerranéen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285d12e7-cc7b-481c-a3f4-b1c1b64d2b43",
                                                "sense_id": "7e416202-941e-3b57-93c8-d5d2c01194fc",
                                                "text": "Ce nectar est évidemment au cœur de la recette du muhammara syrien, un dip de poivrons rouges grillés au four puis mixés avec cerneaux de noix, ail, chapelure, huile d’olive, jus de citron, sel, cumin et flocons de piment d’Alep, à déguster sur du pain pita : un kif levantin !"
                                            },
                                            {
                                                "example_id": "298daffb-3c26-437e-84ee-7ed5beb00f26",
                                                "sense_id": "7e416202-941e-3b57-93c8-d5d2c01194fc",
                                                "text": "On apporta ensuite des saladiers de chou râpé, de poivrons rouges grillés et de cornichons, ainsi qu’une grande assiette sur laquelle fumait une pita au fromage."
                                            },
                                            {
                                                "example_id": "1e43e62f-f5b8-46bd-a572-4360b9a12514",
                                                "sense_id": "7e416202-941e-3b57-93c8-d5d2c01194fc",
                                                "text": "Je vous sers votre kebab dans de la pita ou dans du pain français ?"
                                            }
                                        ]
                                    }
