                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3ccdd48-bda8-42ab-83f9-e7c501dbfe28",
                                "sense_id": "88d05aa3-2d4d-392e-bf6b-8fda7085f9aa",
                                "text": "Poza nędznymi opłotkami niespodziewanie pyszniły się okazałe słoneczniki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9af735ec-7553-3de9-b041-dc9b10d6faa4",
                        "entry_id": "498317bf-3145-3d18-9d4d-f14091d49ac7",
                        "glosses": [
                            "wąskie przejście między sąsiednimi płotami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89dcad2-f08d-4a63-ac50-2c717781e3f0",
                                "sense_id": "9af735ec-7553-3de9-b041-dc9b10d6faa4",
                                "text": "Dotarłszy do wsi, starając się zbytnio nie rzucać w oczy, nieznacznie przemykał się opłotkami."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f33d966e-47ed-3b40-b88f-fc0938cc778b",
                        "entry_id": "498317bf-3145-3d18-9d4d-f14091d49ac7",
                        "glosses": [
                            "miejsce ogrodzone płotem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a88cb1-f707-4e6c-b35c-389a11e33821",
                                "sense_id": "f33d966e-47ed-3b40-b88f-fc0938cc778b",
                                "text": "Tylko usychające w ogrodach konopie wychylały zza opłotków swe rozczochrane głowy albo kura głośno zagdakała"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "1acbdaaf-b517-344e-91f6-d7d8e259e335",
                        "entry_id": "498317bf-3145-3d18-9d4d-f14091d49ac7",
                        "glosses": [
                            "ograniczony zakres czegoś"
                        ],
                        "tags": [
