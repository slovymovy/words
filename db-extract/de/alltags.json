        "de-extract.jsonl": [
            {
                "entry_id": "c4b53ffc-3801-3b7f-98f1-9bd46d0851c7",
                "word": "alltags",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08cc2f55-ee5e-34de-a0e5-dd41717e8649",
                        "entry_id": "c4b53ffc-3801-3b7f-98f1-9bd46d0851c7",
                        "glosses": [
                            "an allen (gewöhnlichen) Werktagen/Arbeitstagen, im Alltag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57638c12-2ba2-4d0a-b4ca-c9befba149b2",
                                "sense_id": "08cc2f55-ee5e-34de-a0e5-dd41717e8649",
                                "text": "Alltags sind die Straßen wieder voll."
                            },
                            {
                                "example_id": "0b1eb174-409f-4529-b83c-67542149d70e",
                                "sense_id": "08cc2f55-ee5e-34de-a0e5-dd41717e8649",
                                "text": "Alltags am Abend noch etwas zu unternehmen, geht über die Kräfte vieler Menschen."
                            },
                            {
                                "example_id": "d0194042-467f-4c18-b172-4357ad6642e8",
                                "sense_id": "08cc2f55-ee5e-34de-a0e5-dd41717e8649",
                                "text": "„Alltags war er, so Winter wie Sommer, in ein Leinwandhabit gekleidet, und nur wenn es zu Tisch ging, trug er eine richtige Livree von sandfarbenem Tuch mit großen Knöpfen dran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
