                                        "sense_id": "751f53e1-5553-3e7a-96a6-f819f609d0ba",
                                        "entry_id": "8d8db271-868b-3f77-8cb0-b7c73347d7f2",
                                        "glosses": [
                                            "een computer met een buitengewoon grote bewerkingscapaciteit of rekenvermogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10bd8dbd-4c07-4ca2-879e-8f488ea2fba0",
                                                "sense_id": "751f53e1-5553-3e7a-96a6-f819f609d0ba",
                                                "text": "Kan een supercomputer grote wereldgebeurtenissen voorspellen?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f9fd3ab-9d47-4b10-923b-0484b16c63db",
