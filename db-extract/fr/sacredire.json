                        "examples": [
                            {
                                "example_id": "708150df-4f12-4ced-971f-a7b6f6b5c198",
                                "sense_id": "f62f2b1f-5588-3c66-adc0-2fa4ea171ebe",
                                "text": "Sacrebleu, disait le comte de Caylus, qui sacredisait toujours…"
                            },
                            {
                                "example_id": "236b2f6c-e45a-4af3-b880-57eda5b29bff",
                                "sense_id": "f62f2b1f-5588-3c66-adc0-2fa4ea171ebe",
                                "text": "Que le bègue Brid’oison\n Nous condamne à la prison\n A la tenaille au poison\n Mon Avignonnaise\n Dans la barque de Caron\n Vous et moi sacredirons\n Comme de rudes charrons\n Mon Avignonnaise\n Sur la rive un violon\n Nous râpera tout du long\n Son lamentable flonflon\n Mon Avignonnaise"
                            }
                        ]
                    }
