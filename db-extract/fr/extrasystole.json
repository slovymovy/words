                        "sense_id": "3b149b88-4d16-3971-bbbc-8ead9212b405",
                        "entry_id": "4080acde-3a7b-31b6-b64c-4b11811b66af",
                        "glosses": [
                            "Contraction supplémentaire du cœur avant le moment normal de la systole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c163bd-6641-497a-beb3-b87ff4a0c90d",
                                "sense_id": "3b149b88-4d16-3971-bbbc-8ead9212b405",
                                "text": "L’irruption, au cours du rythme sinusal, de battements prématurés d’origine ventriculaire définit l’extrasystole ventriculaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9902d7ad-cae7-44ef-b38e-801ecf4d9708",
                        "source_entry_id": "4080acde-3a7b-31b6-b64c-4b11811b66af",
