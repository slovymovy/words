                                "example_id": "15170bfe-c764-45f1-9b89-1b9933589930",
                                "sense_id": "fbf03880-1b8e-31eb-bd68-5cd1f2eb5d34",
                                "text": "„Florence Schelling, der Goalie der Schweizer Frauen-Hockey-Nati, wird in der kommenden Saison im Tor des Männerteams von Erstligist EHC stehen.“"
                            }
                        ],
