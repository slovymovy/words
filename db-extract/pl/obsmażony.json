                "forms": [],
                "senses": [
                    {
                        "sense_id": "3bbd8971-d074-3367-ad71-b305c8a69d94",
                        "entry_id": "7f2a0bca-385e-3a50-a1fb-1f913589a242",
                        "glosses": [
                            "przyrządzony / przyrządzany w procesie obsmażenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81dfe70e-fb77-48ed-b620-fff11b04b5e2",
                                "sense_id": "3bbd8971-d074-3367-ad71-b305c8a69d94",
                                "text": "Krokiet nie jest niczym innym jak obsmażonym naleśnikiem z mięsem."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f715b254-fdd5-4e6d-95ef-aaf0ab020458",
                        "source_entry_id": "7f2a0bca-385e-3a50-a1fb-1f913589a242",
                        "source_sense_id": "3bbd8971-d074-3367-ad71-b305c8a69d94",
                        "target_lang_word": "lightly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lightly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9d1ec2-2d9b-33d7-b607-a7904421c69d",
                                        "entry_id": "2f30bc10-9c36-37f5-83af-be6129554918",
                                        "glosses": [
                                            "In a light manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a9011f-ae57-4146-8a4c-dc2d864f4021",
                                                "sense_id": "6b9d1ec2-2d9b-33d7-b607-a7904421c69d",
                                                "text": "As a teacher, I don't take rudeness in class lightly."
                                            },
                                            {
                                                "example_id": "1612da3c-3137-493f-973a-1d2dfd336d52",
                                                "sense_id": "6b9d1ec2-2d9b-33d7-b607-a7904421c69d",
                                                "text": "Elbows almost touching they leaned at ease, idly reading the almost obliterated lines engraved there. ¶ \"I never understood it,\" she observed, lightly scornful. \"What occult meaning has a sun-dial for the spooney? I'm sure I don't want to read riddles in a strange gentleman's optics.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89d1fb71-7f0d-4ac8-9187-c2f68cba5966",
                        "source_entry_id": "7f2a0bca-385e-3a50-a1fb-1f913589a242",
                        "source_sense_id": "3bbd8971-d074-3367-ad71-b305c8a69d94",
                        "target_lang_word": "fried",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
