                ],
                "translations": [
                    {
                        "translation_id": "8f5c0b83-93e3-4166-8f1b-f734a5a02c44",
                        "source_entry_id": "35681691-b383-38bc-bf20-2ccccf01018e",
                        "source_sense_id": "ec55704c-5719-35d6-9369-a9a820285d94",
                        "target_lang_word": "vexer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vexer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de01c367-1ec8-30e0-9637-7a2b67871e06",
                                        "entry_id": "23ec763e-1a84-3664-bcf1-ef9b920d17c0",
                                        "glosses": [
                                            "Tourmenter par abus de pouvoir ; opprimer ; persécuter."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4406a0b1-4384-404f-8862-af18eef10802",
                                                "sense_id": "de01c367-1ec8-30e0-9637-7a2b67871e06",
                                                "text": "Ce seigneur vexait ses vassaux."
                                            },
                                            {
                                                "example_id": "223e9179-622d-4e5a-8670-0cf305cec4cc",
                                                "sense_id": "de01c367-1ec8-30e0-9637-7a2b67871e06",
                                                "text": "Cet homme se plaît à vexer tous ceux qui sont sous ses ordres."
                                            },
                                            {
                                                "example_id": "f5a11fe5-bffe-4a78-a202-d4ff03b4ebaf",
                                                "sense_id": "de01c367-1ec8-30e0-9637-7a2b67871e06",
                                                "text": "Ce, n'est point pour être rançonnée et vexée par de nouveaux usurpateurs, que la France a renversé le trône d'un monarque inepte et parjure, supprimé les corporations presbytérales et féodales;"
                                            },
                                            {
                                                "example_id": "bf7c6743-c9b2-4983-acff-c83c6e454506",
                                                "sense_id": "de01c367-1ec8-30e0-9637-7a2b67871e06",
                                                "text": "C'est une erreur trop commune de la loi, de concevoir, de combiner à part, chacune de ses prescriptions (...) Et ne considérant point qu'elles portent tour à tour, sur telle personne ou telle contrée, laquelle déja vexée et pressurée par l'une, se trouve impuissante à satisfaire aux autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac65c26-9472-39ef-93f4-fb1a560e64b1",
                                        "entry_id": "23ec763e-1a84-3664-bcf1-ef9b920d17c0",
                                        "glosses": [
                                            "ou Froisser, chagriner ou dépiter quelqu’un ; le toucher dans son amour-propre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f4d615a-b824-4df3-85d2-eed1f014da8e",
                                                "sense_id": "aac65c26-9472-39ef-93f4-fb1a560e64b1",
                                                "text": "Mme Ida était vexée parce que justement elle ravalait sa façade, astiquait sa beauté tous les jours et qu'on lui disait qu'elle avait rajeuni de cinq ans. Et cinq ans, pour une femme, c'est quelque chose."
                                            },
                                            {
                                                "example_id": "bcd27644-e491-4baf-ac91-04cb4155ce5f",
                                                "sense_id": "aac65c26-9472-39ef-93f4-fb1a560e64b1",
                                                "text": "Il est très susceptible, il se vexe pour un rien."
                                            },
                                            {
                                                "example_id": "3a2e2678-9e9e-4605-a943-0d5ad0515153",
                                                "sense_id": "aac65c26-9472-39ef-93f4-fb1a560e64b1",
                                                "text": "Cela me vexe, j’en suis vexé : Cela me cause de l’ennui, du dépit, de la contrariété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db25b2c5-68a2-339d-8f0f-3b63bd11a271",
                                        "entry_id": "23ec763e-1a84-3664-bcf1-ef9b920d17c0",
                                        "glosses": [
                                            "(par extension du sens 1 aux choses) Malmener ; maltraiter."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90acae54-40c2-4f72-97e8-cd1609317e74",
                                                "sense_id": "db25b2c5-68a2-339d-8f0f-3b63bd11a271",
                                                "text": "Mme Duvalle, rouge et branlant un chignon vexé, venait de tourner le bouton, soufflait sur la peau du lait, empoignait la lavette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
