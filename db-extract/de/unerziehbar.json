                ],
                "senses": [
                    {
                        "sense_id": "4b26192d-0a95-3d91-83af-08a895c220b5",
                        "entry_id": "4c566315-32ed-3813-a707-fb7de5c28354",
                        "glosses": [
                            "so, dass es nicht erzogen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc7f2970-fda9-4cf7-846a-662a65b8340e",
                                "sense_id": "4b26192d-0a95-3d91-83af-08a895c220b5",
                                "text": "„Später waren mehrere junge Kaufleute als Mitarbeiter für das begonnene Elfenbeinnußgeschäft nachgekommen. Neben ihnen reifte sie heran, unabhängig, unerziehbar, stolz und eigen.“"
                            },
                            {
                                "example_id": "923471c6-5365-4db2-9c54-6c73bafea96e",
                                "sense_id": "4b26192d-0a95-3d91-83af-08a895c220b5",
                                "text": "„Diemitz war mit einer leichten Verbeugung vorausgerannt; er, der so gern Fürsten, Tenöre und Hochstapler in seiner stolzen Haltung, seiner eleganten Kleidung, seinem zurückhaltenden Benehmen und seiner trockenen Art zu reden nachahmte, er war und blieb der unerzogenste, unerziehbarste, von Natur aus formloseste Mensch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
