                },
                {
                    "sense_id": "9ab76a78-640f-3647-a912-1ac63d6b1a24",
                    "sense_definition": "Financial support provided by the government to people who are unemployed, ill, or in need; welfare.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her father had been living on <w>benefits</w> for several years after losing his job.",
                            "target_lang_translations": {
                                "ru": "Её отец несколько лет жил на <w>пособие</w> после потери работы."
                            }
                        },
                        {
                            "text": "Many families depend on government <w>benefits</w> to cover their basic living costs.",
                            "target_lang_translations": {
                                "ru": "Многие семьи зависят от государственных <w>пособий</w>, чтобы покрывать свои основные расходы на жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "welfare"
                    ],
                    "common_phrases": [
                        "on benefits",
                        "claim benefits",
                        "unemployment benefits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственные пособия или финансовая помощь для безработных, больных или нуждающихся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пособия",
                                "target_lang_sense_clarification": "социальные выплаты от государства"
                            },
                            {
                                "target_lang_word": "социальные выплаты",
                                "target_lang_sense_clarification": "денежная помощь государства"
                            }
                        ]
                    }
                }
            ]
        },
        {
