                            {
                                "example_id": "d8e40f01-064d-4bc4-afea-09df5a6f80d8",
                                "sense_id": "ea63e971-76b8-30f2-a727-0427ddd3594b",
                                "text": "„Nachdem die Detectives in dem einen Mädchenmord keine Verhaftung zustande gebracht haben, fällt ihnen zum zweiten wenig ein.“"
                            },
                            {
                                "example_id": "22561ba8-f27b-4e7a-84d3-07dd838cbb83",
                                "sense_id": "ea63e971-76b8-30f2-a727-0427ddd3594b",
                                "text": "„Indes hat das Bundesverwaltungsgericht (BvWG) die Schuldzuweisung des Bundesamts für Fremdenwesen und Asyl (BFA) nach dem Mädchenmord in Wien zurückgewiesen.“"
                            }
                        ],
