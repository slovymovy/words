{
    "word_family": [
        "embroilment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cab588a-fee0-3a24-bf73-bab3d59b2fde",
                    "sense_definition": "To involve someone deeply in an argument, conflict, or difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "involve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried hard not to <w>embroil</w> himself in the ongoing family dispute.",
                            "target_lang_translations": {
                                "zh": "他极力避免让自己<w>卷入</w>正在发生的家族纷争。"
                            }
                        },
                        {
                            "text": "The company was careful not to <w>embroil</w> its partners in unnecessary legal battles.",
                            "target_lang_translations": {
                                "zh": "公司非常谨慎，以免让合作伙伴<w>牵扯</w>进不必要的官司中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entangle",
                        "implicate",
                        "involve"
                    ],
                    "common_phrases": [
                        "embroil in controversy",
                        "embroil in conflict"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人卷入争吵、冲突或困境之中"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卷入",
                                "target_lang_sense_clarification": "使牵涉进纠纷或矛盾中"
                            },
                            {
                                "target_lang_word": "使陷入",
                                "target_lang_sense_clarification": "使落入困境或纠纷中"
                            },
                            {
                                "target_lang_word": "牵扯",
                                "target_lang_sense_clarification": "连带拉入纷争"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71ddb2b9-381c-3d8a-9566-c5bff88f89fc",
                    "sense_definition": "To throw into disorder, confusion, or uproar; to complicate or jumble.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected political scandal threatened to <w>embroil</w> the entire administration.",
                            "target_lang_translations": {
                                "zh": "突如其来的政治丑闻恐将整个政府<w>拖入混乱</w>。"
                            }
                        },
                        {
                            "text": "Contradictory witness statements serve only to <w>embroil</w> the ongoing investigation further.",
                            "target_lang_translations": {
                                "zh": "互相矛盾的证人陈述只会进一步<w>搅乱</w>正在进行的调查。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "disorder"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More commonly used today regarding people or nations than abstract situations"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使陷入混乱、骚乱或复杂难解的状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使陷入混乱",
                                "target_lang_sense_clarification": "使局势或体系变得混乱无序"
                            },
                            {
                                "target_lang_word": "搅乱",
                                "target_lang_sense_clarification": "使事情变得复杂或错乱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19d95a90-d361-3e70-b7ee-00aaa6ad269e",
                    "sense_definition": "To set on fire or consume with flames.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fierce blaze appeared to <w>embroil</w> the wooden cabins along the shore.",
                            "target_lang_translations": {
                                "zh": "熊熊大火似乎要将岸边的小木屋彻底<w>吞噬</w>。"
                            }
                        },
                        {
                            "text": "Sparks from the altar threatened to <w>embroil</w> the sacred draperies nearby.",
                            "target_lang_translations": {
                                "zh": "祭坛飞溅的火星有<w>点燃</w>附近圣帘的危险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "burn"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "点燃或被烈火吞噬"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "点燃",
                                "target_lang_sense_clarification": "使起火"
                            },
                            {
                                "target_lang_word": "吞噬",
                                "target_lang_sense_clarification": "指火焰吞没"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f7a0b5e-69ff-31f0-8881-f794282a9b22",
                    "sense_definition": "A state of confusion, uproar, or disturbance; a quarrel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden announcement produced a violent <w>embroil</w> among the assembled council members.",
                            "target_lang_translations": {
                                "zh": "这突如其来的消息在与会的议员中引发了一场激烈的<w>纷争</w>。"
                            }
                        },
                        {
                            "text": "He stepped into the crowded room hoping to calm the noisy <w>embroil</w>.",
                            "target_lang_translations": {
                                "zh": "他走进拥挤的房间，希望能平息这场吵闹的<w>骚乱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "commotion",
                        "turmoil",
                        "quarrel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Noun form is largely superseded by embroilment"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "混乱、骚动、争吵或动荡的状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纷争",
                                "target_lang_sense_clarification": "争吵或纠纷"
                            },
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "秩序被打乱的状态"
                            },
                            {
                                "target_lang_word": "骚乱",
                                "target_lang_sense_clarification": "喧闹动荡的场面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04f6151f-bfd5-35e5-8e1b-c91f9995452e",
                    "sense_definition": "A state of anxiety or inner disturbance of the mind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mental_agitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She suffered through sleepless nights of mental <w>embroil</w> after the incident.",
                            "target_lang_translations": {
                                "zh": "事件发生后，她饱受内心<w>纷扰</w>的折磨，彻夜难眠。"
                            }
                        },
                        {
                            "text": "His restless thoughts kept him in a continuous <w>embroil</w> during the voyage.",
                            "target_lang_translations": {
                                "zh": "航行途中，不安的思绪让他始终处于持续的<w>烦乱</w>之中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agitation",
                        "perplexity"
                    ],
                    "antonyms": [
                        "peace",
                        "serenity"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "内心的焦虑、困惑或心神不安"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "心乱",
                                "target_lang_sense_clarification": "内心烦躁不安"
                            },
                            {
                                "target_lang_word": "纷扰",
                                "target_lang_sense_clarification": "思绪混乱或烦恼"
                            },
                            {
                                "target_lang_word": "烦乱",
                                "target_lang_sense_clarification": "内心的焦虑与不安"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}