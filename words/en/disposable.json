{
    "word_family": [
        "dispose",
        "disposal",
        "disposed",
        "disposition"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "074ccb86-810d-3909-892a-fad100dd598a",
                    "sense_definition": "Designed to be thrown away after use, rather than reused, refilled, or repaired.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "single-use",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rather than purchase an expensive razor, he bought a packet of cheap <w>disposable</w> ones.",
                            "target_lang_translations": {
                                "tr": "Pahalı bir tıraş bıçağı satın almak yerine bir paket ucuz <w>tek kullanımlık</w> tıraş bıçağı aldı."
                            }
                        },
                        {
                            "text": "We should avoid using <w>disposable</w> plastic cups at the party to reduce waste.",
                            "target_lang_translations": {
                                "tr": "Atığı azaltmak için partide <w>tek kullanımlık</w> plastik bardaklar kullanmaktan kaçınmalıyız."
                            }
                        }
                    ],
                    "synonyms": [
                        "single-use",
                        "throwaway"
                    ],
                    "antonyms": [
                        "indisposable",
                        "non-disposable",
                        "nondisposable",
                        "undisposable"
                    ],
                    "common_phrases": [
                        "disposable cups",
                        "disposable camera",
                        "disposable razor"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kullanıldıktan sonra yeniden kullanılmak, doldurulmak veya tamir edilmek yerine atılmak üzere tasarlanmış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tek kullanımlık",
                                "target_lang_sense_clarification": "bir kez kullanılıp atılan"
                            },
                            {
                                "target_lang_word": "kullan-at",
                                "target_lang_sense_clarification": "pratik, tek kullanımlık ürünler için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e63635ea-cc88-33e4-93dd-20b76925b474",
                    "sense_definition": "Available to be used or spent; at one's disposal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "available",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After paying rent and bills, she has very little <w>disposable</w> income left for entertainment.",
                            "target_lang_translations": {
                                "tr": "Kira ve faturaları ödedikten sonra eğlence için çok az <w>harcanabilir</w> geliri kalıyor."
                            }
                        },
                        {
                            "text": "The company has a large amount of <w>disposable</w> capital to invest in new projects.",
                            "target_lang_translations": {
                                "tr": "Şirketin yeni projelere yatırım yapmak için büyük miktarda <w>kullanılabilir</w> sermayesi var."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disposable income",
                        "disposable assets"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kullanılmaya veya harcanmaya hazır; kişinin tasarrufuna açık."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "harcanabilir",
                                "target_lang_sense_clarification": "gelir veya sermaye için"
                            },
                            {
                                "target_lang_word": "kullanılabilir",
                                "target_lang_sense_clarification": "tasarruf edilebilir varlıklar için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7166c927-9de6-328c-b469-533775e736ed",
                    "sense_definition": "Capable of being disposed of or gotten rid of.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These chemical waste products are not easily <w>disposable</w> under current environmental laws.",
                            "target_lang_translations": {
                                "tr": "Bu kimyasal atık ürünler mevcut çevre yasalarına göre kolayca <w>elden çıkarılabilir</w> değil."
                            }
                        },
                        {
                            "text": "The manager made sure that all outdated equipment was safely <w>disposable</w>.",
                            "target_lang_translations": {
                                "tr": "Müdür, tüm eski ekipmanların güvenli bir şekilde <w>atılabilir</w> olmasını sağladı."
                            }
                        }
                    ],
                    "antonyms": [
                        "indisposable"
                    ],
                    "target_lang_definitions": {
                        "tr": "Elden çıkarılabilir veya imha edilebilir olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "atılabilir",
                                "target_lang_sense_clarification": "atık veya eski eşyalar için"
                            },
                            {
                                "target_lang_word": "elden çıkarılabilir",
                                "target_lang_sense_clarification": "imha edilebilir nesneler için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c42185b-dc03-3d3b-a603-8d375917d4d6",
                    "sense_definition": "An article or product designed to be discarded after a single use or a short period of utility.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "single-use-items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents who use cloth diapers often use <w>disposables</w> for travel or nights.",
                            "target_lang_translations": {
                                "tr": "Kumaş bebek bezi kullanan ebeveynler seyahatler veya geceler için genellikle <w>tek kullanımlık bezler</w> tercih eder."
                            }
                        },
                        {
                            "text": "Medical <w>disposables</w> like syringes and gloves are essential for maintaining hygiene in hospitals.",
                            "target_lang_translations": {
                                "tr": "Şırınga ve eldiven gibi tıbbi <w>kullan-at malzemeler</w> hastanelerde hijyeni korumak için elzemdir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical disposables",
                        "use disposables"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tek bir kullanımdan veya kısa bir kullanım süresinden sonra atılmak üzere tasarlanmış ürün veya madde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tek kullanımlık ürün",
                                "target_lang_sense_clarification": "kullan-at eşya"
                            },
                            {
                                "target_lang_word": "kullan-at malzeme",
                                "target_lang_sense_clarification": "tıbbi veya günlük kullan-at gereçler"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}