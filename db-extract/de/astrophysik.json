                        ],
                        "form": "der Astrophysik"
                    },
                    {
                        "form_id": "0d9cbc2e-5c97-4ad6-91cd-4a3034e214ea",
                        "entry_id": "b6fd5c94-a59b-3554-8890-ac22a7fa64a2",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Astrophysik"
                    },
                    {
                        "form_id": "adeb1725-6d32-4c51-b3df-1173564ce0b6",
                        "entry_id": "b6fd5c94-a59b-3554-8890-ac22a7fa64a2",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Astrophysik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                        "entry_id": "b6fd5c94-a59b-3554-8890-ac22a7fa64a2",
                        "glosses": [
                            "eine interdisziplinäre Wissenschaft, die grundlegende Gesetze der Physik auf Fragestellungen der Astronomie anwendet sowie den chemischen und physikalischen Aufbau des Weltalls, die physikalische Beschaffenheit sowie die Entwicklung der Himmelskörper erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19436b8f-8178-4af9-8632-d6d0c23aae1e",
                                "sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                                "text": "„‚Die Astrophysik und auch die Mathematik oder Informatik benötigen für ihre Forschungen unglaublich schnelle Computer mit enorm hohen Kapazitäten‘, so Gerhard Hensler.“"
                            },
                            {
                                "example_id": "6600a686-e9fc-4a95-9140-3b4d19047c31",
                                "sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                                "text": "„Astrophysik und Erdbeobachtung lassen sich ohnehin besser mit Satelliten betreiben, und …“"
                            },
                            {
                                "example_id": "2885b222-f227-4fdd-ae80-ba95b84ac8d2",
                                "sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                                "text": "„Sie könnten mir nur ein Thema aus dem Bereich der Astrophysik geben und nicht - wie ich mir vorgestellt hatte - aus der Quanten- und Atomphysik.“"
                            },
                            {
                                "example_id": "daaca36e-9da5-46d7-be6d-c66349ebd2d4",
                                "sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                                "text": "„Es wurde Neutrino genannt und noch zu Lebzeiten Paulis gesehen. Heute ist es einer der wichtigsten Protagonisten der Teilchenphysik, Astrophysik und Kosmologie.“"
                            },
                            {
                                "example_id": "58aef27b-fcc3-4e91-84f3-645254ddd8c1",
                                "sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                                "text": "„Auch der Tanz kam zu seinem Recht, und zwar in Verbindung mit Geometrie und Astrophysik, also in einem weiten Horizonte, der von den Pythagoreern bis in die Neuzeit reichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e51a9e3d-bf5d-4f65-adb8-287a59d57be1",
                        "source_entry_id": "b6fd5c94-a59b-3554-8890-ac22a7fa64a2",
                        "source_sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                        "source_sense_description": "interdisziplinäre Wissenschaft, die Gesetze der Physik auf die Astronomie anwendet",
                        "target_lang_word": "astrophysics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrophysics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a95cb57-6ba4-32b9-b3fc-095f51d28df5",
                                        "entry_id": "69a72791-8535-38dd-a79a-73e902d088a4",
                                        "glosses": [
                                            "The branch of astronomy or physics that deals with the physical properties of celestial bodies and with the interaction between matter and radiation in celestial bodies and in the space between them."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fb04e47-9dec-4a4e-982b-8402525dfb4a",
                                                "sense_id": "0a95cb57-6ba4-32b9-b3fc-095f51d28df5",
                                                "text": "The fact is, dark energy is the biggest mystery in science. It has driven a huge amount of research in the past decade, and was a key driver in last year’s “New Worlds, New Horizons” report from the National Academies of Science, which prioritized future astronomy and astrophysics projects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be08af40-7e4f-4226-a28d-3bd463d4009c",
                        "source_entry_id": "b6fd5c94-a59b-3554-8890-ac22a7fa64a2",
                        "source_sense_id": "0f3b0b47-59ee-3f80-94db-134c7506086a",
                        "source_sense_description": "interdisziplinäre Wissenschaft, die Gesetze der Physik auf die Astronomie anwendet",
                        "target_lang_word": "astrophysique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrophysique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f38ad7a-355d-35d0-9cd9-4e5c15db2ef5",
                                        "entry_id": "1ab60cd7-c294-3513-9e66-b8b094c0b306",
                                        "glosses": [
                                            "Relatif à l’astronomie sous un angle physicochimique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fbb4541-317a-4f0a-b6e6-c63337556a5c",
                                                "sense_id": "2f38ad7a-355d-35d0-9cd9-4e5c15db2ef5",
                                                "text": "Mais par quels processus astrophysiques des trous des millions de fois plus lourds peuvent-ils apparaître puisqu'il n'existe pas d'étoile dépassant les 200 masses solaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astrophysique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "806bc4ba-f09a-3f06-aee7-f10d4215f2c5",
                                        "entry_id": "4af664e7-2f2d-3a5b-8147-2b3c00c7e55b",
                                        "glosses": [
                                            "Branche de l’astronomie qui étudie les composants de l’univers (galaxies, étoiles, planètes, milieu interstellaire) sous un angle physico-chimique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e955ab3-5137-421a-83d0-4d7054e2567a",
                                                "sense_id": "806bc4ba-f09a-3f06-aee7-f10d4215f2c5",
                                                "text": "L’astrophysique a pour objectif de comprendre la physique de l’origine, de la structure et de l’évolution des astres et même celle de l’Univers dans son ensemble (la cosmologie)."
                                            },
                                            {
                                                "example_id": "d40a38a6-39f7-4a2c-86a2-0b615c8cce5d",
                                                "sense_id": "806bc4ba-f09a-3f06-aee7-f10d4215f2c5",
                                                "text": "\"À terme, NGC 1052-DF4 sera cannibalisée par le grand système entourant NGC 1035, avec au moins certaines de ses étoiles flottant librement dans l'espace lointain\", a dit Ignacio Trujillo, coauteur de l'étude, de l'Institut d'astrophysique des Canaries, cité dans le communiqué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
