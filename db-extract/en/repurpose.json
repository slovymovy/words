                                        "sense_id": "e07d676d-5856-3ead-aa19-e007df9e6add",
                                        "entry_id": "7e02228c-1074-3d83-beb8-d2b922658b39",
                                        "glosses": [
                                            "een begin maken"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22eb0d83-1bca-41e5-97eb-a927b0ef9efe",
                                                "sense_id": "e07d676d-5856-3ead-aa19-e007df9e6add",
                                                "text": "Net nadat de winter was ingezet, begon Napoleon met honderdduizend man de desastreuze aftocht."
                                            }
