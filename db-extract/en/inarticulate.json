                    {
                        "translation_id": "36f91b17-6679-4d29-bb56-5e30c1a53acf",
                        "source_entry_id": "4a648aa6-fa2d-3017-aa65-46b1860211df",
                        "source_sense_description": "speechless",
                        "target_lang_word": "sprachlos",
                        "target_lang_code": "de",
