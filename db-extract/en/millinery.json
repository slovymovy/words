                                        "glosses": [
                                            "Handwerk/Gewerbe, das sich mit der Herstellung von Hüten und anderen Kopfbedeckungen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fd6191d-a57a-4d7d-880b-8583fb322171",
                                                "sense_id": "68a76a0e-7044-30ca-b30c-2c5868ded32d",
                                                "text": "„Zu Beginn des 19. Jahrhunderts entwickelte sich auch die Hutmacherei; Ende desselben Jahrhunderts wurde von manueller auf mechanische Produktion umgestellt.“"
                                            }
