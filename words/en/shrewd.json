                            {
                                "target_lang_word": "złowieszczy",
                                "target_lang_sense_clarification": "o znaku lub przeczuciu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dd62696-494f-3884-8e7a-beca501fbd81",
                    "sense_definition": "Noxious, harmful, or mischievous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers feared the fairies would play a <w>shrewd</w> turn on them if they were not pleased.",
                            "target_lang_translations": {
                                "pl": "Mieszkańcy wioski bali się, że elfy płatają im <w>złośliwego</w> figla, jeśli nie będą zadowolone."
                            }
                        },
                        {
                            "text": "He was warned against the <w>shrewd</w> influence of those dishonest companions.",
                            "target_lang_translations": {
                                "pl": "Ostrzegano go przed <w>szkodliwym</w> wpływem tych nieuczciwych towarzyszy."
                            }
