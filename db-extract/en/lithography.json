                    {
                        "translation_id": "b4343797-863e-4269-9fe7-0f02b594e41d",
                        "source_entry_id": "019c6113-711d-3401-8cb3-6daff0674275",
                        "source_sense_id": "85c025a9-2335-3af5-ae3f-4b5ec1ef15dd",
                        "source_sense_description": "printing method",
                        "target_lang_word": "литогра́фия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "литогра́фия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9b344108-3cd4-3294-94ff-0752bf3d234c",
                                        "entry_id": "62db33f6-c353-371b-aa57-1c87db38aae2",
                                        "glosses": [
                                            "способ печати, печатание с плоской поверхности камня, на которой сделан рисунок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ec3200-85c3-466b-8d38-dcb27a83f506",
                                                "sense_id": "9b344108-3cd4-3294-94ff-0752bf3d234c",
                                                "text": "Тимм до тонкости освоил искусство литографии, и множество рисунков из этого журнала, представленных ныне на выставке, было исполнено на камне им самим."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5230264b-48af-3679-b20e-c1164f6bdae0",
                                        "entry_id": "62db33f6-c353-371b-aa57-1c87db38aae2",
                                        "glosses": [
                                            "полученный таким способом оттиск"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d25253b-387d-4760-852b-ce68e21eb9be",
                                                "sense_id": "5230264b-48af-3679-b20e-c1164f6bdae0",
                                                "text": "Полковник рассматривал литографию, изображающую какую-то битву русских с турками в 1829 году; я рассматривал полковника: я был довольнее своею картиной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4123e339-f498-3bec-9fe5-937f7d4a31c7",
                                        "entry_id": "62db33f6-c353-371b-aa57-1c87db38aae2",
                                        "glosses": [
                                            "предприятие или цех, где печатают таким способом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06848732-e1a9-4daa-9033-a72a21b107bf",
                                                "sense_id": "4123e339-f498-3bec-9fe5-937f7d4a31c7",
                                                "text": "Либович брался за любую работу: был резчиком, починял велосипеды, приготовлял фейерверки, служил в литографии, в меняльной конторе и даже преподавал кому-то «немецкое чистописание»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
