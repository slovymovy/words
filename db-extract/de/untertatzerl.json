                ],
                "senses": [
                    {
                        "sense_id": "e841b5eb-d46f-329e-b458-dccad95b8744",
                        "entry_id": "51a291af-1ed2-34d5-ade1-24da9c9febe5",
                        "glosses": [
                            "kleine, flache oder leicht gewölbte Scheibe, die das Verschmutzen einer Unterlage verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc34bae3-5c58-46a3-b6b3-5a7130447914",
                                "sense_id": "e841b5eb-d46f-329e-b458-dccad95b8744",
                                "text": "„Das Gelatinemonster nun auf ein Untertatzerl legen, es schrumpft und schrumpelt dann gemütlich vor sich hin, und fertig ist der Ramses.“"
                            },
                            {
                                "example_id": "14468db8-39e2-4bd7-9810-f78c5f6d409f",
                                "sense_id": "e841b5eb-d46f-329e-b458-dccad95b8744",
                                "text": "„Da säg i glei': Des siech i ei' hupf eine in dei' Untertatzerl saus ma auf an Wei'“"
                            },
                            {
                                "example_id": "ad8a8512-5aeb-4564-875d-1f62be8c480c",
                                "sense_id": "e841b5eb-d46f-329e-b458-dccad95b8744",
                                "text": "„Er ging eilenden Schrittes in Großmamas Wohnung und schrie wie ein Besessener: „Gesindel, Diebe, Mörder, elende Verbrecher“, und warf einige silberne Untertatzerln so heftig auf den Boden, daß sie sich stark verbogen und nicht mehr in ihren ursprünglichen Zustand gebracht werden konnten.“"
                            },
                            {
                                "example_id": "f6b7e766-9998-4286-b2d6-017d9dafa6fa",
                                "sense_id": "e841b5eb-d46f-329e-b458-dccad95b8744",
                                "text": "„Wir würden aber gerne wissen, ob ihr es lustig fandet, wie Leon als kleines Kind unbedingt nach dem Essen die Untertatzerln wegräumen wollte und dabei einen richtigen Tobsuchtsanfall bekam.“"
                            },
                            {
                                "example_id": "e1e13bd3-8c75-41bf-be75-e7aa9aa1db6b",
                                "sense_id": "e841b5eb-d46f-329e-b458-dccad95b8744",
                                "text": "„Auch dabei dachte ich mir nichts, ich verwendete zum Abstreifen der Asche irgendwelche Untertatzerln bzw. das Staniolpapier meiner Marlboroschachteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
