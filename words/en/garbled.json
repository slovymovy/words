{
    "word_family": [
        "garble",
        "garbler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc5c9d05-b7eb-33d4-b3dd-b18df398078a",
                    "sense_definition": "Difficult to understand because it has been distorted, confused, or scrambled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The phone connection was so poor that his voice became completely <w>garbled</w>.",
                            "target_lang_translations": {
                                "nl": "De telefoonverbinding was zo slecht dat zijn stem volkomen <w>onverstaanbaar</w> werd."
                            }
                        },
                        {
                            "text": "The radio received a <w>garbled</w> message that the rescue team could not interpret.",
                            "target_lang_translations": {
                                "nl": "De radio ontving een <w>verhaspeld</w> bericht dat het reddingsteam niet kon ontcijferen."
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "distorted",
                        "disjointed",
                        "mixed up"
                    ],
                    "antonyms": [
                        "clear",
                        "lucid",
                        "coherent"
                    ],
                    "common_phrases": [
                        "garbled message",
                        "garbled audio",
                        "garbled transmission"
                    ],
                    "target_lang_definitions": {
                        "nl": "Moeilijk te begrijpen doordat het vervormd, verhaspeld of verward is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verhaspeld",
                                "target_lang_sense_clarification": "door elkaar gehaald of verward"
                            },
                            {
                                "target_lang_word": "vervormd",
                                "target_lang_sense_clarification": "onduidelijk door slechte kwaliteit of ruis"
                            },
                            {
                                "target_lang_word": "onverstaanbaar",
                                "target_lang_sense_clarification": "niet te verstaan door vervorming"
                            },
                            {
                                "target_lang_word": "verminkt",
                                "target_lang_sense_clarification": "zodanig beschadigd dat de inhoud verloren is gegaan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9014e6a1-dfeb-3de1-88df-d9135119270c",
                    "sense_definition": "Simple past and past participle of <w>garble</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad microphone <w>garbled</w> every sentence the speaker tried to utter.",
                            "target_lang_translations": {
                                "nl": "De slechte microfoon <w>vervormde</w> elke zin die de spreker probeerde uit te brengen."
                            }
                        },
                        {
                            "text": "He accidentally <w>garbled</w> the secret code while typing it into the computer.",
                            "target_lang_translations": {
                                "nl": "Hij <w>verhaspelde</w> per ongeluk de geheime code toen hij deze in de computer invoerde."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'to garble' (verhaspelen, vervormen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verhaspelde",
                                "target_lang_sense_clarification": "verleden tijd enkelvoud van verhaspelen"
                            },
                            {
                                "target_lang_word": "vervormde",
                                "target_lang_sense_clarification": "verleden tijd enkelvoud van vervormen"
                            },
                            {
                                "target_lang_word": "verhaspeld",
                                "target_lang_sense_clarification": "voltooid deelwoord"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}