                                        "glosses": [
                                            "ogół produktów spożywczych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e737e9-e50a-427b-9b75-42df3e26a0d2",
                                                "sense_id": "0153bd68-2d0f-3c50-a020-9d35cc7adf14",
                                                "text": "Nasza firma dostarcza żywność do połowy sklepów w okolicy."
                                            },
                                            {
                                                "example_id": "ec5d1da0-b2df-46af-9895-c60fddf9b103",
                                                "sense_id": "0153bd68-2d0f-3c50-a020-9d35cc7adf14",
                                                "text": "Na przykład, jeśli mieli nadmiar margaryny, chcieli ją wymienić na inną żywność lub na inny potrzebny przedmiot."
                                            },
                                            {
                                                "example_id": "8c9d6be7-30d3-4941-9464-aadf508cfa18",
                                                "sense_id": "0153bd68-2d0f-3c50-a020-9d35cc7adf14",
                                                "text": "Świeża żywność wyprodukowana lokalnie ma niższy ślad węglowy niż produkty, które wędrują do nas z drugiego końca świata."
                                            },
                                            {
                                                "example_id": "14c4007f-adeb-4de3-b159-83c13e8822b6",
                                                "sense_id": "0153bd68-2d0f-3c50-a020-9d35cc7adf14",
                                                "text": "Statki stojące na redzie nie ponoszą opłat portowych oraz mogą zaopatrywać się w wodę, żywność oraz paliwo."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
