                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ece21c58-4598-372f-88e8-a5985d5229d4",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "An intern who lets too many non-serious cases into the emergency room."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bdcb2d-6938-40e0-b859-ae36e74d76d7",
                                                "sense_id": "ece21c58-4598-372f-88e8-a5985d5229d4",
                                                "text": "To be a sieve was to lack clinical judgment, courage, and group loyalty all at once."
                                            }
