                                "target_word": "discriminateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f118653-ed2a-38a4-a97f-b7abc5c4c135",
                                        "entry_id": "0b24506d-f659-37b8-8424-7de0753e38e1",
                                        "glosses": [
                                            "Qui discrimine, qui distingue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b70e037-364f-4b71-9c5e-8480e87def4f",
                                                "sense_id": "9f118653-ed2a-38a4-a97f-b7abc5c4c135",
                                                "text": "Une politique discriminatrice."
                                            },
                                            {
                                                "example_id": "f0aff8b1-341e-48bc-8fd6-518535d96bf4",
                                                "sense_id": "9f118653-ed2a-38a4-a97f-b7abc5c4c135",
                                                "text": "[À propos de la loi faisant de l'homosexualité un délit] Après une succession de détentions et d’intimidations, la loi discriminatrice a été abrogée, et ce malgré les protestations des autorités religieuses roumaines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "discriminateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e396ea2-bd17-33cb-9769-c07886a945e9",
                                        "entry_id": "28dbecb3-a061-3816-87ca-8d407e2813a6",
                                        "glosses": [
                                            "Chose qui discrimine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "194e0ab1-10cd-4e2d-8406-59fbd5de31e4",
                                                "sense_id": "5e396ea2-bd17-33cb-9769-c07886a945e9",
                                                "text": "A Paris, plus qu'ailleurs, le sport est un discriminateur social."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "discriminateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d5645c6-7455-3196-b1a9-4ab3eb65b5e6",
                                        "entry_id": "06a9bcc5-7e49-3b69-899a-2da5730c45c6",
                                        "glosses": [
                                            "Organe de calculateur qui peut comparer à tout moment une variable à sa valeur de référence, de manière à faire apparaître les écarts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9007ef11-5f04-480b-af86-1077920763de",
                                                "sense_id": "1d5645c6-7455-3196-b1a9-4ab3eb65b5e6",
                                                "text": "Le discriminateur peut aussi déterminer si un nombre est positif ou négatif."
                                            },
                                            {
                                                "example_id": "dbbd3b99-f56e-4c78-add0-3bbc298cfd92",
                                                "sense_id": "1d5645c6-7455-3196-b1a9-4ab3eb65b5e6",
                                                "text": "L’électronique de détection qui comprend les amplificateurs et les discriminateurs a été mise au point par le CEA et est restée pendant longtemps une référence dans le domaine de la détection des neutrons."
                                            },
                                            {
                                                "example_id": "68ac1c15-0894-4b90-9dac-1f201a8c1740",
                                                "sense_id": "1d5645c6-7455-3196-b1a9-4ab3eb65b5e6",
                                                "text": "Les récepteurs récents utilisent le discriminateur à coïncidence aussi appelé détecteur à quadrature ou détecteur synchrone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
