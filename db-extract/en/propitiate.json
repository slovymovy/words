                    },
                    {
                        "translation_id": "5c530a4a-3429-49f0-89a4-eb543ff0f8c0",
                        "source_entry_id": "ea7bfec2-8475-3fc6-8bd6-046547c9410e",
                        "source_sense_description": "to conciliate, appease, or make peace with someone",
                        "target_lang_word": "apaiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apaiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                        "entry_id": "b07389ef-570f-35ea-95e5-94a5217c6bfa",
                                        "glosses": [
                                            "Ramener au calme, à un état paisible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56d89f5-4652-4136-8b8a-e8bf9a216721",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "Le fracas de l’orchestre leur arrivait, assourdissant. Par instants, les violons dominaient le vacarme qu’ils semblaient apaiser, caresser, contenir, mais le saxo, le piston, la clarinette et surtout la trompette […] se mettaient ensemble à mugir et à pétarader de telle sorte que personne ne parlait plus."
                                            },
                                            {
                                                "example_id": "bdfd42c2-91d2-4188-ae78-1eea5a63e56c",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "Apaiser une personne furieuse. — Apaiser une sédition."
                                            },
                                            {
                                                "example_id": "7946b4d0-64d6-4798-8b22-6e194e701c87",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "Cet enfant ne cesse de crier, apaisez-le."
                                            },
                                            {
                                                "example_id": "1a21bb9f-cee0-4f74-9de0-83d71ded87a9",
                                                "sense_id": "e505749c-0413-3f6c-b15d-803b657adf48",
                                                "text": "La mer s’apaise. — Sa douleur, sa colère commence à s’apaiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfd95967-d8b4-3c69-a088-74c6e9691400",
                                        "entry_id": "b07389ef-570f-35ea-95e5-94a5217c6bfa",
                                        "glosses": [
                                            "Satisfaire ; assouvir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5aaa174-29ff-4e86-8bb9-246008944dae",
                                                "sense_id": "dfd95967-d8b4-3c69-a088-74c6e9691400",
                                                "text": "Scaër, il faut l'avouer, mangea comme quatre, et ce ne fut qu'après avoir apaisé sa faim qu'il se trouva en état de s'expliquer avec Mᵐᵉ de Mazatlan qui prenait plaisir à le voir satisfaire ce glorieux appétit, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61ecdce1-4fcb-430c-b854-b89e9427b7cb",
                        "source_entry_id": "ea7bfec2-8475-3fc6-8bd6-046547c9410e",
                        "source_sense_description": "to conciliate, appease, or make peace with someone",
                        "target_lang_word": "besänftigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besänftigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a66a470-7daa-314c-85ae-c8a4be71088a",
                                        "entry_id": "91b355c7-e6b9-314b-b879-6a0772d5e8c9",
                                        "glosses": [
                                            "durch Zureden bewirken, dass jemandes innere Erregung langsam nachlässt und abklingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d7ef062-8542-486a-881a-12b69812f406",
                                                "sense_id": "5a66a470-7daa-314c-85ae-c8a4be71088a",
                                                "text": "Mit sanften Worten und einem Wiegenlied besänftige die Mutter ihren schreienden Säugling."
                                            },
                                            {
                                                "example_id": "cb94816a-da06-4832-9f79-b005019a9d88",
                                                "sense_id": "5a66a470-7daa-314c-85ae-c8a4be71088a",
                                                "text": "Der Pfleger versuchte, den aufgeregten Hengst zu besänftigen."
                                            },
                                            {
                                                "example_id": "ee35b36d-2417-470d-8f94-0cf21f5a0798",
                                                "sense_id": "5a66a470-7daa-314c-85ae-c8a4be71088a",
                                                "text": "Seine Wut ließ sich auch durch Bier und Fernsehen nicht besänftigen."
                                            },
                                            {
                                                "example_id": "c753fb31-69a8-4633-9411-cd4cee841713",
                                                "sense_id": "5a66a470-7daa-314c-85ae-c8a4be71088a",
                                                "text": "„Erst 1903 ging der irische Boden in den Besitz der irischen Bauern über. Doch damit waren die Iren längst noch nicht besänftigt, die Unabhängigkeitsbestrebungen gingen weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
