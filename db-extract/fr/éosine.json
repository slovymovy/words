                        "entry_id": "2455d340-e7a8-38c5-98bf-782919a6e07d",
                        "glosses": [
                            "Substance colorée introduite par M. E. Fischer dans l’étude des tissus organiques pour colorer les préparations microscopiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4590f24c-046d-435d-8f2a-9f646c1c4ead",
                                "sense_id": "84a60f82-82a9-357f-b821-e8c81ca9208e",
                                "text": "Ce mélange est coloré avec 1 centimètre cube de teinture d’éosine ou de carmin et on le parfume avec 3 grammes par kilo de mélange de parfum artificiel, comme la muguettine principe."
                            }
                        ]
                    }
                ],
                "translations": [
