                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moteur de la voiture a surchauffé à cause d'une fuite du liquide de <w>refroidissement</w>."
                        },
                        {
                            "text": "Les scientifiques observent un <w>refroidissement</w> progressif des températures à l'approche de l'hiver."
                        }
                    ],
