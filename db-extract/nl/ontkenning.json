                    {
                        "sense_id": "2b0dbed8-201d-3ac6-8d3a-ea952165d215",
                        "entry_id": "74857e94-f269-33ae-ab07-a042147bcf4f",
                        "glosses": [
                            "handeling of uiting waarmee iemand kan laten weten dat hij denkt dat iets niet waar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a9c82e-0f67-4349-add6-4c64079fbeb8",
                                "sense_id": "2b0dbed8-201d-3ac6-8d3a-ea952165d215",
                                "text": "Je vraagt je af wat de volgende stap is in de ontkenning van wetenschappelijke waarheden. Wellicht is het slechts wachten op de Trump University, die volkomen zelfverzonnen wetenschappelijke resultaten en feiten gaat publiceren die de president wel goed uitkomen."
                            }
                        ]
                    },
