                    {
                        "translation_id": "39847efd-2e0e-43ed-a645-c33181ce2f0b",
                        "source_entry_id": "ffdc607f-8ed8-36c9-a2d3-9c6e88210a27",
                        "source_sense_description": "care given to a patient during recovery",
                        "target_lang_word": "postcure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
