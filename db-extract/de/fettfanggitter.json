                ],
                "senses": [
                    {
                        "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                        "entry_id": "da53c1cf-1c66-3004-8252-6d6df91e5722",
                        "glosses": [
                            "Gitter aus Streckmetall oder Lamellen, welches Fett aus der ihn durchströmenden Küchenabluft zurückhält und abscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de32c3a0-5be6-4798-b98c-ec8f906b1755",
                                "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                                "text": "„Fettfanggitter für Deckeneinbau bestehend aus Rahmen, Fettfangwanne und eingesetztem, auswechselbarem Gittereinsatz aus Aluminium naturfarben eloxiert."
                            },
                            {
                                "example_id": "4d9cf051-30d6-411e-ad77-25f8ec21fb69",
                                "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                                "text": "„Bevor die Abluft einer Küche in die Abluftleitungen strömt, muss sie zuvor durch hochwirksame Aerosolabscheider (früher Fettfanggitter) gereinigt werden.“"
                            },
                            {
                                "example_id": "7d85e5b8-9e1d-4086-a8c4-668b7d22a4dc",
                                "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                                "text": "„Diese Filteranordnung ist ein Fettfanggitter, bei dem in einem Rahmen im Querschnitt bogenförmige, parallel angeordnete Lamellen in zwei Reihen versetzt zueinander verwendet werden und so eine Verwirbelung in dem Gitter erzeugt wird, die zu einer Abscheidung von Verunreinigungen in der Luft führt“"
                            },
                            {
                                "example_id": "d70cba68-b298-4b84-93b8-6ca95428ee92",
                                "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                                "text": "„Unter der Gruppe Filterauslässe bietet Schako Filtergitter, Schwebstofffilterkästen, Fettfanggitter und Flusenabscheider.“"
                            },
                            {
                                "example_id": "92215269-ecdc-4514-9e8e-c0c027a9e120",
                                "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                                "text": "„In einigen Hauben wird neben Fettfanggittern, Filtermatten auch Aktivkohle oder Ionisation zur Geruchsneutralisation eingesetzt.“"
                            },
                            {
                                "example_id": "825469fe-a3d4-4b49-8766-66af62ea6a44",
                                "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                                "text": "„Dabei sollten sie darauf zu achten, dass die gesamte Anlage einschließlich aller Aggregate, vom Fettfanggitter bis zum Ventilator, gesäubert wird, um der Gefahr eines Brandes wirkungsvoll vorzubeugen.“"
                            },
                            {
                                "example_id": "ade83d13-df73-41cb-a519-7fb068356806",
                                "sense_id": "a03d08ff-10d8-3243-bb26-d01270831857",
                                "text": "„Aerosolabscheider (früher Fettfanggitter) - Küchenabluftanlagen müssen mit wirksamen Aerosolabscheidern ausgerüstet sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
