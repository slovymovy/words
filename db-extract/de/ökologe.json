                        ],
                        "form": "den Ökologen"
                    },
                    {
                        "form_id": "98fb002b-0947-4b78-b323-12b0deff2f8a",
                        "entry_id": "573de378-b6f5-3e66-8c96-0a1c77508fcf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ökologen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4892b83-c25a-3153-b937-167b4ddb41d7",
                        "entry_id": "573de378-b6f5-3e66-8c96-0a1c77508fcf",
                        "glosses": [
                            "eine Person, die sich in großem Ausmaß mit dem Fachgebiet der Ökologie beschäftigt"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "1d5bcaf0-8a50-4f04-85a8-352cd38e468e",
                                "sense_id": "a4892b83-c25a-3153-b937-167b4ddb41d7",
                                "text": "Einige Ökologen vermuten, dass es kein Zurück mehr gibt, wenn die Waldfläche zur Hälfte zerstört ist, andere setzen die Grenze bei 30 bis 40 Prozent Verlust an."
                            },
                            {
                                "example_id": "7288a66b-31d2-482e-a616-339701614a49",
                                "sense_id": "a4892b83-c25a-3153-b937-167b4ddb41d7",
                                "text": "„In einer anderen Studie interessierten sich Ökologen aus Georgia für die Verbreitung der sogenannten Indianerbanane in Amerika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9609359e-8da2-4410-bc08-c8c844ee4fe8",
                        "source_entry_id": "573de378-b6f5-3e66-8c96-0a1c77508fcf",
                        "source_sense_id": "a4892b83-c25a-3153-b937-167b4ddb41d7",
                        "source_sense_description": "Beruf: Person, die sich mit dem Fachgebiet der Ökologie beschäftigt",
                        "target_lang_word": "ecologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c087ddf1-039d-31ea-a0de-4ccd6feb8653",
                                        "entry_id": "6f0626d7-3915-3885-80c7-aef7fb57ec88",
                                        "glosses": [
                                            "A scholar of ecology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2120e24e-8b0f-478c-b965-36a350bbea4b",
                                                "sense_id": "c087ddf1-039d-31ea-a0de-4ccd6feb8653",
                                                "text": "Planting trees to combat climate change is a waste of time, according to a study by ecologists who say that most forests do not have any overall effect on global temperature, while those furthest from the equator could actually be making global warming worse."
                                            },
                                            {
                                                "example_id": "fbd8390e-9555-4856-9ee9-12a056ee77f1",
                                                "sense_id": "c087ddf1-039d-31ea-a0de-4ccd6feb8653",
                                                "text": "Once ecologists have more thoroughly identified indoor species, they hope to come up with strategies to scientifically manage homes, by eliminating harmful taxa and fostering species beneficial to our health."
                                            },
                                            {
                                                "example_id": "4ccebe28-96dd-42a3-a1ca-4b376e0e80bf",
                                                "sense_id": "c087ddf1-039d-31ea-a0de-4ccd6feb8653",
                                                "text": "Ecologists say the months of intense and unprecedented fires will almost certainly push several species to extinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d9fb922-0576-3b45-ab52-8dcc07e8b1d3",
                                        "entry_id": "6f0626d7-3915-3885-80c7-aef7fb57ec88",
                                        "glosses": [
                                            "An environmentalist (one who advocates for the protection of the environment)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b54855-f3f7-4089-8d7b-9753a4593171",
                                                "sense_id": "7d9fb922-0576-3b45-ab52-8dcc07e8b1d3",
                                                "text": "Protest actions of this type served to take debate, and the Basque ecologists, onto the street and to encourage people to carry out principled actions such as the eco-sabotage at Itoiz."
                                            },
                                            {
                                                "example_id": "379dee06-6f73-455a-a030-9482e1545869",
                                                "sense_id": "7d9fb922-0576-3b45-ab52-8dcc07e8b1d3",
                                                "text": "Despite the accomplishments and the vision of radical ecologists, however, most of the world's power is presently concentrated in economic systems and political institutions that bring about environmental deterioration."
                                            },
                                            {
                                                "example_id": "e54d0e0e-2a39-4baf-8728-70706258002d",
                                                "sense_id": "7d9fb922-0576-3b45-ab52-8dcc07e8b1d3",
                                                "text": "Second, throughout the 1970s, the party Executive guaranteed its support to numerous ecologists’ protest actions, and formed a number of broader umbrella organizations with ecology groups and smaller parties on the Left in order to facilitate communication, share ideas and strategies, and organize and promote common social initiatives on environmental matters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "949f4448-fbf3-4d72-81e3-3a66f81cb0d4",
                        "source_entry_id": "573de378-b6f5-3e66-8c96-0a1c77508fcf",
                        "source_sense_id": "a4892b83-c25a-3153-b937-167b4ddb41d7",
                        "source_sense_description": "Beruf: Person, die sich mit dem Fachgebiet der Ökologie beschäftigt",
                        "target_lang_word": "écologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Spécialiste de l’écologie et des écosystèmes."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ca03c0-4b66-4371-bc4b-3f2d7d064827",
                                                "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                                "text": "[…] certaines localités offrant des conditions de température toutes spéciales et deviennent ainsi des formes indicatrices pour l’écologiste […]"
                                            },
                                            {
                                                "example_id": "7c9a1e68-13d3-4838-8a03-e82d87bd014e",
                                                "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                                "text": "Ces lois de la nature, les écologistes des quelques dernières générations ont pensé qu'on pouvait les formuler en distinguant l’autécologie, la synécologie et la dynécologie."
                                            },
                                            {
                                                "example_id": "cc38491f-abea-457d-aa38-21b0e0dd7e8c",
                                                "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                                "text": "Plus précisément les écologistes accusent les essences résineuses de podzoliser les sols, la podzolisation étant précisément une évolution naturelle qui conduit, dans certaines conditions de climat et de roche-mère, à une destruction progressive des argiles dans les horizons supérieurs du sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Personne qui milite pour la préservation de l'environnement et le respect de la nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5857e9da-d66b-4b03-b502-96c21e976928",
                                                "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                                "text": "Certaines enquêtes ne retiennent que les études qui leur paraissent de bonne qualité ; d'autres sont moins exigeantes et il est probable que les précautionnistes ou les écologistes ont tendance à privilégier les travaux les plus pessimistes, au nom de l’heuristique de la peur, […]."
                                            },
                                            {
                                                "example_id": "6a0a0c84-b643-45bc-80e4-9744ac7bbca9",
                                                "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                                "text": "Nous allons utiliser les bons mots, messieurs mesdames les écologistes, vous n'êtes pas écologistes, ce refus du monde économique est l'apanage des babas cools des années 70.\nVous êtes donc des babas cools et pas des écologistes."
                                            },
                                            {
                                                "example_id": "82b4dce1-8fb5-4c51-b7af-26b459f90077",
                                                "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                                "text": "Il faut rentrer dans le détail des mesures présentées pour démontrer que cette « écologie du bon sens » opposée à l’« écologie punitive » révèle surtout le désir de combattre les écologistes et l’étranger - incarné en l’occurrence par l’Europe - davantage que les risques pour l’environnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "832b93c9-4178-3861-9795-607e735150f4",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Membre d'un parti ou d'un mouvement politique partisan de l'écologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7673edc-ce03-4881-82ed-457f8b779ecf",
                                                "sense_id": "832b93c9-4178-3861-9795-607e735150f4",
                                                "text": "René Dumont fut, en 1974, le premier écologiste candidat à la présidence de la République française."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e870b1b-2604-3e6f-a918-cc463362ed3a",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Activiste écologiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33dc6443-4f60-45e1-9ee2-d71179f9d1a0",
                                                "sense_id": "1e870b1b-2604-3e6f-a918-cc463362ed3a",
                                                "text": "« Non ce n’est pas une manifestation festive », a affirmé le ministre des Transports Philippe Tabarot sur X, fustigeant des « activistes soi-disant écologistes ». « Des catapultes, des boules de pétanque, des pierres : la violence est préparée », prévient-il."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca4174bf-b6b0-3006-8157-fc6722f02c4c",
                                        "entry_id": "87b0763c-afdd-36ca-9a76-0b517a811bf0",
                                        "glosses": [
                                            "Relatif à la défense de l'environnement et à la protection de la nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95247577-f4e8-4b33-8067-ebc4fe3a808a",
                                                "sense_id": "ca4174bf-b6b0-3006-8157-fc6722f02c4c",
                                                "text": "Les mouvements écologistes se sont particulièrement développés dans les dernières décennies du XXᵉ siècle."
                                            },
                                            {
                                                "example_id": "5866dba1-34e1-4b14-a12f-bc5a6359beaa",
                                                "sense_id": "ca4174bf-b6b0-3006-8157-fc6722f02c4c",
                                                "text": "René Dumont fut, en 1974, le premier candidat écologiste à la présidence de la République française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5091a8af-4f68-4c40-b3b1-c0c9ebe78054",
                        "source_entry_id": "573de378-b6f5-3e66-8c96-0a1c77508fcf",
                        "source_sense_id": "a4892b83-c25a-3153-b937-167b4ddb41d7",
                        "source_sense_description": "Beruf: Person, die sich mit dem Fachgebiet der Ökologie beschäftigt",
                        "target_lang_word": "écologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e122239-087d-389c-9867-0c02de4e5d79",
                                        "entry_id": "25de5470-de46-3dcc-bc39-d870532bdf78",
                                        "glosses": [
                                            "Spécialiste de l'écologie et des écosystèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efd6c859-5b99-46b4-9fbb-cf19382fc9e8",
                                                "sense_id": "5e122239-087d-389c-9867-0c02de4e5d79",
                                                "text": "En effet, lorsqu’un chercheur (le plus souvent un généticien des populations ou un écologue) se trouve devant un public, il continue à parler de « stratégie » au sujet des espèces, même s’il sait que c’est une métaphore."
                                            },
                                            {
                                                "example_id": "83d16084-2daf-4d4c-a61a-d149fbefec9f",
                                                "sense_id": "5e122239-087d-389c-9867-0c02de4e5d79",
                                                "text": "Il y a trois ans, l’écologue Philippe Clergeau appelait à intégrer la biodiversité dans les projets d’urbanisme."
                                            },
                                            {
                                                "example_id": "41983383-8f57-4791-9a0b-72a46140fe42",
