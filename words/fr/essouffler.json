                    "sense_definition": "Mettre hors d'haleine par un mouvement violent ou un effort trop soutenu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette marche rapide dans la neige finit par <w>essouffler</w> les enfants."
                        },
                        {
                            "text": "Le rythme imposé dès le départ a rapidement réussi à <w>essouffler</w> l'adversaire."
                        }
                    ],
                    "common_phrases": [
                        "essouffler l'adversaire"
                    ]
                },
                {
                    "sense_id": "dc926567-d246-3f5a-808b-ce50d1b8fba3",
                    "sense_definition": "Perdre son souffle, manquer de respiration à la suite d'un effort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je commence à m'<w>essouffler</w> sérieusement en montant cette pente raide."
                        },
                        {
                            "text": "Le randonneur s'<w>essouffle</w> dès que le chemin devient un peu trop escarpé."
                        }
                    ]
                },
                {
                    "sense_id": "ab3e035e-620a-379c-8a72-525526a80f78",
                    "sense_definition": "Perdre de sa vitalité, de son élan ou faiblir peu à peu.",
