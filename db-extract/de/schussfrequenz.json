                                "target_senses": [
                                    {
                                        "sense_id": "e9ef5b2d-71d1-33d5-bc82-cc49ae17e8f7",
                                        "entry_id": "610c77a7-6620-35c7-8e8f-1fcdf929508b",
                                        "glosses": [
                                            "Nombre de projectiles tirés par une arme ou un ensemble d'armes en un temps donné, généralement une minute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9905e0e9-c984-423f-a79a-184548720c46",
                                                "sense_id": "e9ef5b2d-71d1-33d5-bc82-cc49ae17e8f7",
                                                "text": "Il est doté d'un chargeur d'une trentaine de coups et sa cadence de tir est de quelques centaines de coups à la minute."
                                            },
                                            {
                                                "example_id": "48d92002-ab45-4eb5-8cf0-56f851f9dc80",
                                                "sense_id": "e9ef5b2d-71d1-33d5-bc82-cc49ae17e8f7",
                                                "text": "Avec ces six pièces, la cadence de tir de la batterie est de quatre coups/minute, pour une portée permettant soit de croiser les feux avec les pièces de la batterie Lothringen, à Jersey, soit de venir en appui aux principaux points de tir de la Festung malouine."
                                            },
                                            {
                                                "example_id": "cd3fba8c-fed4-44e7-8c2a-914817a9bb1f",
                                                "sense_id": "e9ef5b2d-71d1-33d5-bc82-cc49ae17e8f7",
                                                "text": "Les fortes cadences de tir, si elles doivent être longtemps soutenues, accélèrent l’usure de l’âme des bouches à feu, surtout dans les tirs à grandes vitesses initiales."
                                            }
                                        ]
                                    }
                                ]
                            }
