                        "glosses": [
                            "A very fine, almost invisible mist or drizzle that visits the Andean region, especially Ecuador and Peru."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2042e4b2-7123-4a2d-8894-222ce0ac3c18",
                                "sense_id": "8e064374-5d46-349e-9255-67ab8fcfe8ee",
                                "text": "I like the garua, the invisible drizzle which feels like spiders' feet on one's skin and makes everything wet, turning the city dwellers somewhat batrachian ..."
                            },
                            {
                                "example_id": "c0a0d8da-e0e6-49e8-aae8-10349086b2da",
                                "sense_id": "8e064374-5d46-349e-9255-67ab8fcfe8ee",
                                "text": "On idle afternoons I have patiently observed spiders spin shrouds of silk for their trapped prey. The light within must be similar to that which falls upon the city of Lima from April to December, when the sun is hidden by the dismal garua, […]"
                            }
                        ]
                    }
