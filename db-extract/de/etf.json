                "senses": [
                    {
                        "sense_id": "425c6eab-e7f1-36ca-9754-fa454f034698",
                        "entry_id": "0c7f0e0b-db64-364d-a371-83e17664be3d",
                        "glosses": [
                            "Exchange-Traded Fund ‚Börsengehandelter Fonds‘"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "009159bb-3d91-49d9-a87e-38e7002d4eaa",
                                "sense_id": "425c6eab-e7f1-36ca-9754-fa454f034698",
                                "text": "„Das Ziel des Fondsmanagements hinter einem ETF ist die möglichst exakte Nachbildung eines Index […]. Mit ETFs erhält der Anleger die Möglichkeit, mit einer einzigen Transaktion einen gesamten Index - sei es ein Aktien- Rohstoff- oder Anleihen-Index - zu kaufen.“"
                            },
                            {
                                "example_id": "2f358ccd-f1c6-4928-8191-fca5855299c4",
                                "sense_id": "425c6eab-e7f1-36ca-9754-fa454f034698",
                                "text": "„ETF können Sie laufend an der Börse kaufen und verkaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29bcba5a-7fc9-4654-873e-0e39ef3e8338",
                        "source_entry_id": "0c7f0e0b-db64-364d-a371-83e17664be3d",
                        "source_sense_id": "425c6eab-e7f1-36ca-9754-fa454f034698",
