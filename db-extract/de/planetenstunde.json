                "senses": [
                    {
                        "sense_id": "85442bd1-5ad2-3f04-9394-2a764e0b056a",
                        "entry_id": "b06ba1e3-06d7-31db-890b-e455e54f2341",
                        "glosses": [
                            "Zeitspanne, die etwa einer Stunde entspricht, die nach alter astrologischer/okkulter Tradition von einem der sieben Planeten (Sonne, Mond, Mars, Merkur, Jupiter, Venus, Saturn) \\\"regiert\\\" wird"
                        ],
                        "tags": [
                            "Esoterik",
                            "Astrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2076c0ae-d57e-45f4-af76-e4116f52e5dd",
                                "sense_id": "85442bd1-5ad2-3f04-9394-2a764e0b056a",
                                "text": "„Die erste Planetenstunde, die also mit Sonnenaufgang beginnt, gehört demselben Planeten, der den Tag regiert, also Sonntags der Sonne, Montags dem Mond, Dienstag dem Mars, Mittwochs dem Merkur, Donnerstag dem Jupiter, Freitags der Venus, Samstag dem Saturn.“"
                            }
                        ],
