                "senses": [
                    {
                        "sense_id": "53b13404-d149-363d-a2b2-4328c20fb33a",
                        "entry_id": "51103c04-da06-3ba2-934e-b5da8de95a06",
                        "glosses": [
                            "niet gepast, niet geschikt voor een situatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c8e15c-d724-44e0-8f9b-ec39e8c3705f",
                                "sense_id": "53b13404-d149-363d-a2b2-4328c20fb33a",
                                "text": "Die opmerking is ongepast."
                            },
                            {
                                "example_id": "26e4338c-bc94-4193-b6a1-7adc9b6f300d",
                                "sense_id": "53b13404-d149-363d-a2b2-4328c20fb33a",
                                "text": "De vrouw vindt niet dat ze de schuld moet dragen voor een systeem. Op de vraag of ze spijt heeft van haar reactie, antwoordt de telefoniste: ,,Laten we zeggen dat het ongepast was.” De telefoniste zou volgens haar advocaat gemiddeld 2000 telefoontjes per dag verwerken."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b3765fd-487d-3995-a809-7f8c996a7606",
                        "entry_id": "51103c04-da06-3ba2-934e-b5da8de95a06",
                        "glosses": [
                            "van kleding, niet geprobeerd of het de juiste grootte heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b928ce-c550-4630-9fe9-89880788c286",
                                "sense_id": "6b3765fd-487d-3995-a809-7f8c996a7606",
                                "text": "Ik heb de broek ongepast gekocht."
                            }
                        ]
                    }
                ],
