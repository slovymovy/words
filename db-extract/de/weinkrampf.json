                ],
                "senses": [
                    {
                        "sense_id": "46b7b416-b152-30ba-bf75-b139cdfb477d",
                        "entry_id": "2356400b-8679-363a-897a-1b0d604000e6",
                        "glosses": [
                            "kaum beherrschbares, krampfartig auftretendes Weinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7e9485-8f7e-46c8-8ebb-758628a52a58",
                                "sense_id": "46b7b416-b152-30ba-bf75-b139cdfb477d",
                                "text": "„Tom sprang plötzlich auf, kniete vor einem Papierkorb nieder und übergab sich mit lautem Würgen, das sich mit Weinkrämpfen mischte.“"
                            },
                            {
                                "example_id": "6ccf8aba-eaf6-4dc5-b416-719f99a8ee6a",
                                "sense_id": "46b7b416-b152-30ba-bf75-b139cdfb477d",
                                "text": "„Ich zittere am ganzen Leib, die Beine möchten versagen, ein Weinkrampf schüttelt mich.“"
                            },
                            {
                                "example_id": "eeeefbe3-75bd-4cb0-9b09-2fd53a875910",
                                "sense_id": "46b7b416-b152-30ba-bf75-b139cdfb477d",
                                "text": "„Sie holt im Weinkrampf ruckartig Luft.“"
                            },
                            {
                                "example_id": "ac9e2e9e-c717-44c5-868d-a06b4cee389c",
                                "sense_id": "46b7b416-b152-30ba-bf75-b139cdfb477d",
                                "text": "„In der Mitte standen eine von Weinkrämpfen geschüttelte Frau und ein Polizeibeamter, der vergeblich versuchte, sie zu beruhigen, ringsherum eine kleine Menschenmenge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
