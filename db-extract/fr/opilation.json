                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f38557-67a8-4b06-b846-db8a1016cee0",
                                "sense_id": "efd3ea4c-9d08-363e-bafb-0d01828b47cb",
                                "text": "Certains défauts anatomiques des organes de la génération ont des effets analogues : lʼimperforation ou lʼétroitesse du vagin ou du col de la matrice, lʼopilation (obstruction) de ces conduits, la présence de verrues ou dʼexcroissances au niveau de lʼ« étui viril »."
                            }
                        ]
                    }
