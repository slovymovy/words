                                        "entry_id": "34b10105-dbae-3aa2-b9a7-57f75e6e2f45",
                                        "glosses": [
                                            "A hard, black form of coal, sometimes used in jewellery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e67c324-32af-4c36-a97a-9ebb12c4ea19",
                                                "sense_id": "2bea630b-a96c-3ae3-830f-651ff1bd595d",
                                                "text": "There is also a factitious jeat made of glaſs, in imitation of the mineral jeat."
                                            }
                                        ]
