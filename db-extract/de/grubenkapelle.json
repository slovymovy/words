                ],
                "senses": [
                    {
                        "sense_id": "03137fb9-040d-3a1f-8de0-19133dd85f2d",
                        "entry_id": "59e4a4a5-1b7f-390e-a539-be160cde4a4a",
                        "glosses": [
                            "sehr kleine Kapelle unter etwas, in der gebetet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46cebb62-3ea3-4023-88a3-4529fbef6dd1",
                                "sense_id": "03137fb9-040d-3a1f-8de0-19133dd85f2d",
                                "text": "„1658 ließ der \"Salzbaron\" Eyssl von Eysselsberg die Grubenkapelle unter dem Chorraum neu gestalten.“"
                            },
                            {
                                "example_id": "c6bf6ec6-9d8a-49b0-bea8-5527b08873d5",
                                "sense_id": "03137fb9-040d-3a1f-8de0-19133dd85f2d",
                                "text": "„Denn zu seiner Aufgabe als Kantor gehörte es auch, in der kleinen Grubenkapelle die Orgel zu spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43204d14-8e53-3998-a8e1-bb1cec0ed2f4",
                        "entry_id": "59e4a4a5-1b7f-390e-a539-be160cde4a4a",
                        "glosses": [
                            "kleines Musiker-Ensemble einer Grube oder Köhlerei, die Musik spielen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "9a33d8ef-fafb-4b16-99c8-daeeb24151f9",
                                "sense_id": "43204d14-8e53-3998-a8e1-bb1cec0ed2f4",
                                "text": "„Die Grubenkapelle von Grimley probt für die nationale Endausscheidung der Blaskapellen, während ihre Zeche von der Schließung bedroht ist.“"
                            },
                            {
                                "example_id": "47d97ccd-f840-4a33-9aac-720a9c67900e",
                                "sense_id": "43204d14-8e53-3998-a8e1-bb1cec0ed2f4",
                                "text": "„Da Köhler, inzwischen Familienvater, davon mehr schlecht als recht leben konnte, kam ihm ein Zeitungsinserat gelegen, in dem die Frankenholzer Bergwerksdirektion einen Kapellmeister für ihre bereits 1892 gegründete Grubenkapelle suchte, die allerdings 1906, als Köhler an den Höcherberg kam, mit nur noch wenigen Musikern in einem jämmerlichen Zustand war.“"
                            },
                            {
                                "example_id": "db1b60a7-db56-4f6f-b404-e60e3f2fdeb9",
                                "sense_id": "43204d14-8e53-3998-a8e1-bb1cec0ed2f4",
                                "text": "„Doch die Grubenkapelle »Grimley Colliery« probt weiter für die nationale Endausscheidung der Blechbläser, obwohl die Zukunft ihrer Zeche in den Sternen steht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
