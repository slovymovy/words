                "senses": [
                    {
                        "sense_id": "71935592-e481-31dd-95ae-6ee114fb99bf",
                        "entry_id": "bb6b9e45-a016-3557-8d64-fe8b0fc8df9e",
                        "glosses": [
                            "Female homosexuality; the state of a woman being sexually attracted to other women."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cf44c267-3047-4bc7-a3f0-5b81e3afde76",
                                "sense_id": "71935592-e481-31dd-95ae-6ee114fb99bf",
                                "text": "Because all Asari present as female and use female pronouns, the deadly sexual nature of Ardat-Yakshi may reflect the continued fear of lesbianism that persists among many in human society."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17a3e9f9-a04c-4d9e-ac9d-453400973c00",
                        "source_entry_id": "bb6b9e45-a016-3557-8d64-fe8b0fc8df9e",
                        "source_sense_id": "71935592-e481-31dd-95ae-6ee114fb99bf",
                        "source_sense_description": "Female homosexuality",
                        "target_lang_word": "lesbianisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lesbianisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "318aeaca-501e-3cde-8870-144af90458d2",
                                        "entry_id": "9c4f6ee7-ebad-3ba0-aaaa-f6fee9aeb4ac",
                                        "glosses": [
                                            "Homosexualité féminine."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a099e17-b986-466e-87f7-6020ed4575f9",
                                                "sense_id": "318aeaca-501e-3cde-8870-144af90458d2",
                                                "text": "Bien que plus diffus, plus discret, moins affiché que l’homosexualité masculine, le lesbianisme est cependant tout aussi courant."
                                            },
                                            {
                                                "example_id": "8eda6505-93b6-4474-8c2f-a43bd220d6a6",
                                                "sense_id": "318aeaca-501e-3cde-8870-144af90458d2",
                                                "text": "Les romans écrits par des femmes sont pleins des désillusions de la dévirginisation, de la légitimité de l’adultère, de la réhabilitation du lesbianisme comme remplacement, etc. Nos mères n’auraient jamais osé étaler de pareilles choses, chacune gardait pour elle ses rancœurs, cherchant au besoin des consolations dans la religion."
                                            },
                                            {
                                                "example_id": "7c83c306-1b40-449f-b9c8-a348196bebf2",
                                                "sense_id": "318aeaca-501e-3cde-8870-144af90458d2",
                                                "text": "Dans tous les cas évoqués ci-dessus, tout se passe comme s’il était déjà excessivement osé de parler des anormaux : évoquer l’homosexualité, le lesbianisme, la pédérastie et les pratiques pornographiques, sans les inscrire dans un discours descriptif, semble être déjà subversif en soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
