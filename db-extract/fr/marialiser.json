                "senses": [
                    {
                        "sense_id": "9b5fcde7-64a0-3d41-92ae-fce2a9bf4989",
                        "entry_id": "14f77f86-4e99-35ce-83df-1d767021d882",
                        "glosses": [
                            "Donner un caractère marial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b880da-c2f9-495a-8e30-0867bf347d62",
                                "sense_id": "9b5fcde7-64a0-3d41-92ae-fce2a9bf4989",
                                "text": "Pour cela « marialiser » d'une manière ou d'une autre toutes nos actions apostoliques, importantes ou pas."
                            },
                            {
                                "example_id": "ea9c0e79-542a-43a1-b417-66f81a26be23",
                                "sense_id": "9b5fcde7-64a0-3d41-92ae-fce2a9bf4989",
                                "text": "Et sauf à marialiser la femme de l'Apocalypse, le Nouveau Testament reste aussi sobre sur Marie qu'il est entièrement centré sur Jésus le Christ."
                            },
                            {
                                "example_id": "ea12daed-a959-478f-acf6-aa006bcde2be",
                                "sense_id": "9b5fcde7-64a0-3d41-92ae-fce2a9bf4989",
                                "text": "Il faut tout marialiser; ce n'est pas une dévotion mais un don total."
                            }
                        ]
                    }
                ],
