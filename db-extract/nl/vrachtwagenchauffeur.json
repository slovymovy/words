                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d976f3c-ed5c-3784-9095-fad2f0677f25",
                                        "entry_id": "25c74fa0-7b56-36b4-b633-e4f17829fc4c",
                                        "glosses": [
                                            "jemand, der einen Truck/schweren LKW/Lastzug fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a17a51-8387-45a3-bbeb-c6d94ab1dd7d",
                                                "sense_id": "6d976f3c-ed5c-3784-9095-fad2f0677f25",
                                                "text": "„Ich mochte die Trucker sehr, so wie ich alle Spezialisten mag.“"
                                            },
                                            {
                                                "example_id": "217c7fb6-ce6b-42d5-b0a5-ad5345835313",
                                                "sense_id": "6d976f3c-ed5c-3784-9095-fad2f0677f25",
                                                "text": "„Alle mochten Lindsay, und sie mochte diesen besonderen Menschenschlag, diese offene, direkte Art der Trucker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
