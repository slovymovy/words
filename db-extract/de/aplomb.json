                        ],
                        "form": "des Aplombs"
                    },
                    {
                        "form_id": "a301f3b4-226b-4937-8f4f-a5ae9cfaa58f",
                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Aplomb"
                    },
                    {
                        "form_id": "ca7a5cbc-dde7-4c03-8acc-f2f91357a45a",
                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Aplomb"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                        "glosses": [
                            "eine gerade, sichere Haltung; ein selbstsicheres Auftreten, Nachdrücklichkeit in der Rede"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "09ab579f-dedc-414e-b57a-80611b120194",
                                "sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                                "text": "„Und nun erwartete man, zum Auftakt der Darlegung des Falles durch die Verteidigung, Dr. Davies, der den Gerichtssaal mit charakteristischem Aplomb und einer tiefen Verbeugung vor Richter Harrigan beginnen würde.“"
                            },
                            {
                                "example_id": "8882c2c1-9162-4c51-a1d1-37adcfe9935d",
                                "sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                                "text": "„Aber der Weltmeister ließ – ich hatte nach den Erzählungen meines Freundes derlei schon geahnt – gute zehn Minuten auf sich warten, wodurch allerdings sein Erscheinen dann erhöhten Aplomb erhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                        "glosses": [
                            "Forschheit, Dreistigkeit"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "4b43afe0-7fc3-4f73-bac1-6da77f6e9aa3",
                                "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                                "text": "„Aber der Weltmeister ließ – ich hatte nach den Erzählungen meines Freundes derlei schon geahnt – gute zehn Minuten auf sich warten, wodurch allerdings sein Erscheinen dann erhöhten Aplomb erhielt.“"
                            },
                            {
                                "example_id": "fd8ba8ff-3262-4881-bebe-6ecb812bf6b2",
                                "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                                "text": "„Ich habe noch nicht den Aplomb, der mir wachsen wird, weil er nötig ist, wenn man […] mit den Herren der Welt verkehren will.“"
                            },
                            {
                                "example_id": "ccd76f2b-698d-4e78-8235-d0fc763b2846",
                                "sense_id": "d6722b10-2543-3900-ac34-661dcfaee66a",
                                "text": "„Neusner war Anfang Vierzig, specknackig, rotblond – daß er Jude war, merkte man nur an seinen schläfrigen Augenlidern –, und trat mit dem Aplomb gewollter und betonter Mittelmäßigkeit auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bcec5a81-06c5-3519-ab70-36212865147c",
                        "entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                        "glosses": [
                            "die Fähigkeit zum Abfangen einer Bewegung, die Balance"
                        ],
                        "tags": [
                            "Ballett"
                        ],
                        "examples": [
                            {
                                "example_id": "4c3352c6-eba6-4878-9e02-5bcb817d4c00",
                                "sense_id": "bcec5a81-06c5-3519-ab70-36212865147c",
                                "text": "„Der Aplomb des Tänzers, wenn er ihn zulassen kann, ist der Ausdruck der Bewegung zur Erdmitte hin.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36e835b9-e8f9-4ec5-ac0e-ede60030bdc5",
                        "source_entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                        "source_sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                        "source_sense_description": "gerade, sichere Haltung; ein selbstsicheres Auftreten, Nachdrücklichkeit in der Rede",
                        "target_lang_word": "aplomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aplomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                        "entry_id": "1d4298ae-a975-384e-9c48-39e8224c153f",
                                        "glosses": [
                                            "Self-confidence; poise; composure."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54924790-f05e-4556-8ce2-f9a86e59546b",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "His nonchalance and aplomb during hard times have always been his best character trait."
                                            },
                                            {
                                                "example_id": "873be6d1-426b-411b-a657-ca18a3cca0b9",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "“Oh, Wooster,” he said, “I was talking to my mother a night or two ago.” “Oh, yes?” I said, with a slight wave of the hand intended to indicate that if he liked to talk to his mother anywhere, all over the house, he had my approval. “She tells me you are interested in mice.” I didn't like the trend the conversation was taking, but I preserved my aplomb. “Why, yes, fairly interested.” “She says she found you trying to catch one in my bedroom!”"
                                            },
                                            {
                                                "example_id": "85d1164b-7569-4695-b03e-60e7dcc81131",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "We can handle functions of a few variables with some aplomb and view sets of quantities totalling IO6 or IO7 with sangfroid."
                                            },
                                            {
                                                "example_id": "4a0f3a7e-a26f-485e-ba2d-63aebfc1413a",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "They have a seven-year-old son named Timothy, never called Timmy or Tim; a little scrawny guy who wears thick glasses already, and who tucks his striped T-shirts into his pants with the aplomb of a silver-templed CEO."
                                            },
                                            {
                                                "example_id": "5d7d340e-b8d5-4120-81a7-1996ed51befa",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "Fly-half Jonny Wilkinson put his below-par performance against Argentina behind him with a fine first-half showing, slotting four kicks from six and controlling his back-line with aplomb, while England's three-quarters were brimming with life and clinical with their execution."
                                            },
                                            {
                                                "example_id": "6368d498-3170-4ea3-ba9a-76c4b1a61d64",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "Installing lift shafts in station buildings which were not originally designed to accommodate them can be a fraught exercise, but a necessary one if the legitimate aspiration of the travelling public for step-free access is to be achieved. At Sudbury Hill, on London Underground's Piccadilly Line extension out to the north-western suburbs, Transport for London has achieved this with aplomb."
                                            },
                                            {
                                                "example_id": "66c9fa1b-33ca-40c3-9860-81f7b7812cb3",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "But Cruise remains the main attraction. He carries the film with aplomb and invests the action with enough familiarity from the previous films that fans will be more than happy."
                                            },
                                            {
                                                "example_id": "4afd5432-f960-4dd8-99bb-a4fb0a1cf847",
                                                "sense_id": "4eb5e8ca-9c01-3586-9d56-5db1b9ef54b1",
                                                "text": "Korda, preternaturally calm about everything, confronts his past with outward aplomb, but there’s an uneasiness growing in him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8328556e-b665-3799-a522-a8117fcf83a9",
                                        "entry_id": "1d4298ae-a975-384e-9c48-39e8224c153f",
                                        "glosses": [
                                            "The apparent elegance and precision exhibited by a confident, accomplished dancer."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e369041-7026-3a63-b164-7454f27a3da9",
                                        "entry_id": "1d4298ae-a975-384e-9c48-39e8224c153f",
                                        "glosses": [
                                            "The perpendicular; perpendicularity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bbe9c35-fedf-41b6-bb08-d7af3e9af6c2",
                        "source_entry_id": "035eb64c-c339-3464-9c79-15d2cc680a64",
                        "source_sense_id": "4830d87b-8b35-3168-aa55-982b67a8654c",
                        "source_sense_description": "gerade, sichere Haltung; ein selbstsicheres Auftreten, Nachdrücklichkeit in der Rede",
                        "target_lang_word": "aplomb",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aplomb",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Ligne perpendiculaire au plan de l’horizon indiquée par le fil à plomb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37493ca-239d-46cd-98fb-048e881fcb6e",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "Bien prendre l’aplomb."
                                            },
                                            {
                                                "example_id": "308182d4-9b95-4013-be6a-e3f951bd33ad",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "Un grondement sourd s’éleva dans le lointain, s'enfla peu à peu, fit bientôt vibrer le vitrage des ateliers : un rapide venant de Melun passait à l’aplomb du remblai, longeant le chemin du Ponceau."
                                            },
                                            {
                                                "example_id": "6b76f73f-b27c-4d12-a7f4-e6a0bb087ac5",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "[…]: un balustre portant des vases décoratifs à l’aplomb des entre-fenêtres, et des trophées opimes au-dessus des avancées qui interrompaient la monotonie du cheminement architectural et régulier."
                                            },
                                            {
                                                "example_id": "f4213689-5ea3-4c79-9866-78b238cb51d9",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "À l’aplomb du soleil, les eaux du lac avaient des lourdeurs de pétrole."
                                            },
                                            {
                                                "example_id": "dc2e0419-4ed0-47f1-9c1d-182e74984b5c",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "Quand il tire le portail elle le hèle, montrant du doigt la plate-bande des petits cactus Copiapoa. Au sommet d’une courte tige, enveloppées d’une bourre blanchâtre, deux minuscules fleurs jaunes ont éclos. Pétales de soie à l’aplomb d’un coussin d’épines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7aa1b2a-3a12-35e8-8054-a33860c4da4d",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Équilibre, stabilité d’un corps solide résultant de l’utilisation du fil à plomb."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb68c6f-3ce6-4f91-8815-0528e918b4ed",
                                                "sense_id": "e7aa1b2a-3a12-35e8-8054-a33860c4da4d",
                                                "text": "Ce mur tient bien son aplomb, a perdu son aplomb. - Cette muraille, toute vieille qu’elle est, a bien gardé son aplomb, a conservé son aplomb."
                                            },
                                            {
                                                "example_id": "350d829e-21a7-4411-85bc-5db8d38e47ac",
                                                "sense_id": "e7aa1b2a-3a12-35e8-8054-a33860c4da4d",
                                                "text": "Les fauteuils étaient renversés comme après une bagarre, les tables n’étaient plus sous l’aplomb de la suspension, le pupitre à musique était cassé. […]\nTout de suite, la nonne tirait la table à son aplomb, relevait les chaises, plaçait les fauteuils, ramassait les morceaux de musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da250b2e-dd75-3cda-b03c-61e9d942621a",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Juste pondération des figures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca0a61f4-4602-4603-8f10-d0e53643a488",
                                                "sense_id": "da250b2e-dd75-3cda-b03c-61e9d942621a",
                                                "text": "Ses figures manquent d’aplomb. - Cet artiste pèche par les aplombs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e7b1253-3d29-3387-833c-4cb68a773b69",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Équilibre des parties du corps."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18824c4b-973d-44be-b0c9-5c74d946e22d",
                                                "sense_id": "5e7b1253-3d29-3387-833c-4cb68a773b69",
                                                "text": "Les aplombs d’un cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05200d4e-46bd-3b48-aa1f-cacb1d6e6df8",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Précision de la rectitude de la mesure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Certaine assurance dans la manière de se présenter, de parler, d’agir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "780f80ed-ab6f-4bea-9860-b1923d684020",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "Et bien! monsieur, lui dit cet homme, qui avait gardé son sang-froid et son aplomb, au milieu des folies de la soirée, vous avez vu nos indépendans ; qu'en pensez-vous ?"
                                            },
                                            {
                                                "example_id": "767f8ada-cf73-455e-b6f8-7d13db96529e",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "C'était un gros garçon, artiste peintre au moins médiocre, à vue très-courte, moralement s'entend, qui ne doutait de rien et parlait de tout avec un aplomb imperturbable. Il prétendait avoir une grande instruction; mais il est à croire qu'il l'avait reçue sous le sceau de la confession, car il ne révélait jamais rien. — (Émile Mathieu, L'esprit de famille, Paris : Librairie Hachette & Cie, 1863, page 114)"
                                            },
                                            {
                                                "example_id": "1ae12808-a3b2-40ed-879b-a1d91628d454",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "– Eh bien, et moi, est-ce que je ne suis pas là ?\nL’autre eut l’aplomb de lui répondre :\n– Que voulez-vous ! On est toujours mieux auprès de ses enfants."
                                            },
                                            {
                                                "example_id": "5e4d89aa-962b-4572-a7a8-38c0981ed775",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "Mani portait en lui, depuis l’enfance, et même dans l’humilité de la palmeraie des Vêtements-Blancs, cet attribut éminemment royal qu’est l’aplomb, héritage manifeste des souverains parthes dont l’empire s’était autrefois étendu jusqu’à Deb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2350d4ea-7641-4e34-bfba-0a4c0ec2d05b",
