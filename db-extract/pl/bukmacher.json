                        "source_sense_id": "a856f6be-fe90-3fed-b6ae-c5f8f2b54d75",
                        "target_lang_word": "bookie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bookie",
