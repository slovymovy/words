    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "386bf047-1a0c-3401-8cc2-897ce01302e3",
                    "sense_definition": "Profondément ému, troublé ou accablé par une vive émotion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle était visiblement <w>bouleversée</w> en apprenant la triste nouvelle.",
                            "target_lang_translations": {
                                "en": "She was visibly <w>upset</w> on learning the sad news.",
                                "ru": "Она явно была <w>расстроена</w>, узнав печальную новость.",
                                "de": "Als sie die traurige Nachricht erfuhr, war sie sichtlich <w>aufgewühlt</w>.",
                                "es": "Estaba visiblemente <w>conmocionada</w> al enterarse de la triste noticia.",
                                "zh": "她得知这个悲伤的消息后，明显非常<w>难过</w>。"
                            }
                        },
                        {
                            "text": "Il est resté profondément <w>bouleversé</w> après avoir été témoin de cet accident.",
                            "target_lang_translations": {
                                "en": "He remained deeply <w>shaken</w> after witnessing the accident.",
                                "ru": "Он остался глубоко <w>потрясённым</w> после того, как стал свидетелем этой аварии.",
                                "de": "Nachdem er den Unfall miterlebt hatte, blieb er tief <w>erschüttert</w>.",
                                "es": "Se quedó profundamente <w>afectado</w> tras presenciar ese accidente.",
                                "zh": "目睹这场事故后，他仍然深感<w>震惊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chamboulé"
                    ],
                    "antonyms": [
                        "calme",
                        "impassible",
                        "serein"
                    ],
                    "common_phrases": [
                        "profondément bouleversé"
                    ],
                    "target_lang_definitions": {
                        "en": "Deeply moved, troubled or distressed by strong emotion.",
                        "ru": "Глубоко взволнованный, расстроенный или потрясённый сильным чувством.",
                        "de": "Tief bewegt, beunruhigt oder seelisch getroffen durch heftige Gefühle.",
                        "es": "Profundamente conmovido, turbado o abrumado por una fuerte emoción.",
                        "zh": "深受强烈情绪冲击，心神激荡、悲痛或不安的。"
                    },
                    "translations": {
                        "en": [
                            {
