                "senses": [
                    {
                        "sense_id": "769c64f1-a9e4-327b-af0e-2394696fdf5c",
                        "entry_id": "334ea690-241c-3131-864c-065ef3571a7c",
                        "glosses": [
                            "отобрать у кого-то имущество с применением силы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f0626ed-00d3-4a6e-807d-0d0e5072c083",
                                "sense_id": "769c64f1-a9e4-327b-af0e-2394696fdf5c",
                                "text": "Прохожего ограбили в тёмном переулке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac400d97-4e57-4d78-b39c-af38a37e7167",
                        "source_entry_id": "334ea690-241c-3131-864c-065ef3571a7c",
                        "source_sense_id": "769c64f1-a9e4-327b-af0e-2394696fdf5c",
                        "target_lang_word": "rob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6089d7e-28ea-3dd3-9a6b-d49187df73a0",
                                        "entry_id": "3ec07318-35db-3034-8023-8d00a3cdfe5c",
                                        "glosses": [
                                            "To steal from, especially using force or violence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "933db63e-3b97-4f4d-8301-6d7fe201b8fd",
                                                "sense_id": "e6089d7e-28ea-3dd3-9a6b-d49187df73a0",
                                                "text": "He robbed three banks before he was caught."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2036ad63-df0f-375d-aae2-e66fa4053315",
                                        "entry_id": "3ec07318-35db-3034-8023-8d00a3cdfe5c",
                                        "glosses": [
                                            "To deprive of, or withhold from, unjustly or injuriously; to defraud."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11dca387-f897-4a43-9754-9ca0ee2184e2",
                                                "sense_id": "2036ad63-df0f-375d-aae2-e66fa4053315",
                                                "text": "The best way to rob a bank is to own one."
                                            },
                                            {
                                                "example_id": "3918f844-961d-47ec-8800-37217372c688",
                                                "sense_id": "2036ad63-df0f-375d-aae2-e66fa4053315",
                                                "text": "I never robbed the soldiers of their pay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59cda70-9235-3e0c-a1e9-cff966f65c25",
                                        "entry_id": "3ec07318-35db-3034-8023-8d00a3cdfe5c",
                                        "glosses": [
                                            "To deprive (of)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89736523-1afa-437d-bd97-3209d7211e61",
                                                "sense_id": "e59cda70-9235-3e0c-a1e9-cff966f65c25",
                                                "text": "Working all day robs me of any energy to go out in the evening."
                                            },
                                            {
                                                "example_id": "dc5f8f29-8874-4823-a04b-97f5ff1805d2",
                                                "sense_id": "e59cda70-9235-3e0c-a1e9-cff966f65c25",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence. She devoured with more avidity than she had her food those pretentiously phrased chronicles of the snobocracy—[…]—distilling therefrom an acid envy that robbed her napoleon of all its flavor."
                                            },
                                            {
                                                "example_id": "5aa6909e-1a81-4080-8cd7-946f9153eb48",
                                                "sense_id": "e59cda70-9235-3e0c-a1e9-cff966f65c25",
                                                "text": "The railway is still vital to Jordan's export trade, but in spite of the poor quality of the road, diesel lorries are gradually robbing it of freight traffic, and anyone who can afford to fly does so rather than face the long desert journey by rail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d88096eb-0d05-3022-ae31-fcdb0f3ceecb",
                                        "entry_id": "3ec07318-35db-3034-8023-8d00a3cdfe5c",
                                        "glosses": [
                                            "To burgle."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e52b8432-8d08-4911-b998-804b73b35bc1",
                                                "sense_id": "d88096eb-0d05-3022-ae31-fcdb0f3ceecb",
                                                "text": "Her house was robbed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c03c4d21-e8be-34a5-96b0-10d7564742c3",
                                        "entry_id": "3ec07318-35db-3034-8023-8d00a3cdfe5c",
                                        "glosses": [
                                            "To steal."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58235b9c-19cd-4841-af1f-b7b0028755a1",
                                                "sense_id": "c03c4d21-e8be-34a5-96b0-10d7564742c3",
                                                "text": "That bloke robbed my phone!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f120ac2b-5ad1-3eb9-8356-b5bd53075a65",
                                        "entry_id": "3ec07318-35db-3034-8023-8d00a3cdfe5c",
                                        "glosses": [
                                            "To commit robbery."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "757f7d1b-2121-3563-9fd9-166d983de492",
                                        "entry_id": "3ec07318-35db-3034-8023-8d00a3cdfe5c",
                                        "glosses": [
                                            "To take possession of the ball, puck etc. from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8b466a-1fc2-4b06-a11c-13ede8a0434e",
                                                "sense_id": "757f7d1b-2121-3563-9fd9-166d983de492",
                                                "text": "Kevin Mirallas then robbed Bacary Sagna to run into the area and draw another save from Szczesny as the Gunners held on to lead at the break."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5d8d3f6-a102-3ab4-80fc-96f61a60d67b",
                                        "entry_id": "79d553b1-cdac-329a-bb50-83f5abeb41fc",
                                        "glosses": [
                                            "A syrup made of evaporating fruit juice over a fire, usually mixed with sugar or honey, and especially used for medicinal purposes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02a69429-2d14-4181-ab2c-5f9d4e709724",
                                                "sense_id": "c5d8d3f6-a102-3ab4-80fc-96f61a60d67b",
                                                "text": "[I]nſtead of Honey, Rob of Elder, Conſerve of Roſes, or Syrup of Violets; Glyſters, Pedilavia of emollient Decoctions with Nitre; or Elder, Vinegar, or Focus's of the ſame, applied with Sponges behind the Ears, to the Armpits, Groins, Hams, &c. or with Barley-water and a little Roſe-vinegar."
                                            },
                                            {
                                                "example_id": "d93fa49f-1a38-4bf7-bcaa-3c8f65d1b3a3",
                                                "sense_id": "c5d8d3f6-a102-3ab4-80fc-96f61a60d67b",
                                                "text": "Also began to make wort from the malt and give it to such people as had symptoms of the scurvy; one of them indeed is highly scorbutick altho he has been taking of the rob for some time past without finding himself benefited therefrom […] ."
                                            }
                                        ]
