{
    "word_family": [
        "royalty",
        "royally",
        "royalist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "65da7e00-7b2c-3ec3-ae6e-3a3c28a76c41",
                    "sense_definition": "Of or relating to a monarch (such as a king or queen) or their family.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "monarchy_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>royal</w> family waved to the crowd from the palace balcony.",
                            "target_lang_translations": {
                                "ru": "<w>Королевская</w> семья помахала толпе с балкона дворца.",
                                "zh": "<w>皇室</w>成员从宫殿阳台上向人群挥手。"
                            }
                        },
                        {
                            "text": "She dreams of attending a <w>royal</w> wedding one day.",
                            "target_lang_translations": {
                                "ru": "Она мечтает однажды побывать на <w>королевской</w> свадьбе.",
                                "zh": "她梦想着有一天能参加一场<w>王室</w>婚礼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kingly",
                        "princely",
                        "monarchical",
                        "regal"
                    ],
                    "antonyms": [
                        "common"
                    ],
                    "common_phrases": [
                        "royal family",
                        "royal palace",
                        "royal blood",
                        "royal navy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к монарху (королю или королеве) или его семье.",
                        "zh": "指君主（如国王或女王）或其家族的，或与他们相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королевский",
                                "target_lang_sense_clarification": "относящийся к королю или королеве"
                            },
                            {
                                "target_lang_word": "царский",
                                "target_lang_sense_clarification": "относящийся к царю; часто используется как синоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皇室的",
                                "target_lang_sense_clarification": "指属于或关于皇室的"
                            },
                            {
                                "target_lang_word": "王室的",
                                "target_lang_sense_clarification": "指属于或关于王室的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7b4fc34-1a99-365b-9c99-c2b1860cfa13",
                    "sense_definition": "Having the impressive quality, dignity, or size associated with a monarch; magnificent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests received a <w>royal</w> welcome when they arrived at the hotel.",
                            "target_lang_translations": {
                                "ru": "По прибытии в отель гостям оказали <w>королевский</w> прием.",
                                "zh": "客人们抵达酒店时受到了<w>隆重</w>的欢迎。"
                            }
                        },
                        {
                            "text": "The lion sat on the rock with a <w>royal</w> demeanor.",
                            "target_lang_translations": {
                                "ru": "Лев сидел на скале с <w>царственным</w> видом.",
                                "zh": "狮子坐在岩石上，神态<w>威严</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "majestic",
                        "stately",
                        "regal"
                    ],
                    "antonyms": [
                        "humble",
                        "modest"
                    ],
                    "common_phrases": [
                        "royal welcome",
                        "royal treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий впечатляющим качеством, достоинством или величием, присущим монарху; великолепный.",
                        "zh": "具有与君主相关的令人印象深刻的品质、尊严或规模；宏伟的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королевский",
                                "target_lang_sense_clarification": "роскошный, великолепный (напр. прием)"
                            },
                            {
                                "target_lang_word": "царский",
                                "target_lang_sense_clarification": "богатый, щедрый (напр. подарок)"
                            },
                            {
                                "target_lang_word": "царственный",
                                "target_lang_sense_clarification": "величественный (напр. вид, осанка)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隆重的",
                                "target_lang_sense_clarification": "形容仪式或接待非常盛大"
                            },
                            {
                                "target_lang_word": "威严的",
                                "target_lang_sense_clarification": "形容举止或气度庄重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7753af23-7697-39eb-849a-45f6b5f6dd14",
                    "sense_definition": "Used as an intensifier to emphasize something annoying or bad.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fixing this old engine is becoming a <w>royal</w> pain in the neck.",
                            "target_lang_translations": {
                                "ru": "Ремонт этого старого двигателя становится <w>настоящей</w> головной болью.",
                                "zh": "修理这台旧发动机简直成了<w>十足</w>的麻烦。"
                            }
                        },
                        {
                            "text": "He made a <w>royal</w> mess of the project schedule.",
                            "target_lang_translations": {
                                "ru": "Он устроил <w>полный</w> бардак в графике проекта.",
                                "zh": "他把项目进度表搞得<w>一塌糊涂</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "royal pain",
                        "royal mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to emphasize annoyance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления значения чего-то раздражающего или плохого.",
                        "zh": "用作强调词，以突出某事令人恼火或糟糕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "используется для усиления"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "абсолютный, совершенный"
                            },
                            {
                                "target_lang_word": "первостатейный",
                                "target_lang_sense_clarification": "разговорное, ироничное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十足的",
                                "target_lang_sense_clarification": "用于强调程度"
                            },
                            {
                                "target_lang_word": "极大的",
                                "target_lang_sense_clarification": "用于强调负面程度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "228f8978-9879-3a0e-abb0-c074e657048b",
                    "sense_definition": "A member of a royal family, such as a prince or princess.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "monarchy_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine featured photos of the young <w>royals</w> playing in the garden.",
                            "target_lang_translations": {
                                "ru": "В журнале были опубликованы фотографии молодых <w>членов королевской семьи</w>, играющих в саду.",
                                "zh": "杂志刊登了年轻的<w>皇室成员</w>在花园里玩耍的照片。"
                            }
                        },
                        {
                            "text": "Several <w>royals</w> attended the charity gala last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером благотворительный гала-концерт посетили несколько <w>особ королевской крови</w>.",
                                "zh": "昨晚有几位<w>皇室成员</w>出席了慈善晚宴。"
                            }
                        }
                    ],
                    "antonyms": [
                        "commoner"
                    ],
                    "common_phrases": [
                        "the royals",
                        "British royals",
                        "young royals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член королевской семьи, например, принц или принцесса.",
                        "zh": "皇室或王室成员，如王子或公主。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "член королевской семьи",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "особа королевской крови",
                                "target_lang_sense_clarification": "формальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皇室成员",
                                "target_lang_sense_clarification": "指皇室或王室的成员"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8284ea3f-c3ad-3fd0-aa27-7bed72dbd8b2",
                    "sense_definition": "A male given name or a surname.",
                    "learner_level": "A1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Royal</w> is coming to visit us next week.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Ройал</w> приедет навестить нас на следующей неделе.",
                                "zh": "我的叔叔<w>罗亚尔</w>下周要来看我们。"
                            }
                        },
                        {
                            "text": "Mr. <w>Royal</w> signed the documents this morning.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Ройал</w> подписал документы сегодня утром.",
                                "zh": "<w>罗亚尔</w>先生今天早上签署了文件。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя или фамилия.",
                        "zh": "男性名字或姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ройал",
                                "target_lang_sense_clarification": "имя или фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗亚尔",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}