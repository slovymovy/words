                                        "examples": [
                                            {
                                                "example_id": "9623d9b2-d1c9-4efd-8073-7fd815b97b6c",
                                                "sense_id": "b41d4010-fc30-3ec1-b596-70951788c6f0",
                                                "text": "\"We will not tolerate this. We gave them enough time to purchase helmets. Six months ago the price of helmets was below 800 naira so complaints about non-availability and high prices are no excuse,\" he told Reuters."
                                            },
                                            {
                                                "example_id": "910b4b35-c077-4f40-b179-ecefd87a5a06",
                                                "sense_id": "b41d4010-fc30-3ec1-b596-70951788c6f0",
                                                "text": "‘Five naira for one small cup. The big one is ten naira.’"
                                            }
