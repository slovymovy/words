                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d11bd3d-67ed-4355-a259-970805504feb",
                                                "sense_id": "ae40dfe1-6def-355c-b676-c3d8ad18d2ba",
                                                "text": "Bei großen Schiffen betreibt ein Zusatzmotor die Haspel für den Anker."
                                            }
                                        ],
                                        "sense_index_json": "\"4a\""
                                    },
                                    {
                                        "sense_id": "8f7f9370-e9fe-3eeb-b8f1-7614cadda38a",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
