                        "sense_id": "d350825f-0fd3-38b5-bbd7-448366e90001",
                        "entry_id": "bf23c385-2b23-3af4-a772-5ba3536227c1",
                        "glosses": [
                            "A hardwood tree (Hardwickia binata) native to dry regions of the Indian subcontinent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "31e3f653-2ceb-44eb-93c3-8b80f6352383",
                                "sense_id": "d350825f-0fd3-38b5-bbd7-448366e90001",
                                "text": "The anjan tree is found in isolated patches in dry areas of the subcontinent and is the source of one of India's most durable timbers."
                            },
                            {
                                "example_id": "bc7e6f6e-a26a-4e02-8f56-140e2dbfece9",
                                "sense_id": "d350825f-0fd3-38b5-bbd7-448366e90001",
                                "text": "The present paper addresses the non-timber produce of anjan (Hardwickia binata)."
                            },
                            {
                                "example_id": "0f70b483-ac37-44ff-964b-166d34b17ca6",
                                "sense_id": "d350825f-0fd3-38b5-bbd7-448366e90001",
                                "text": "The anjan plantation was intercropped with clusterbean, cowpea, greengram and sesamum during kharif season of each year of study i.e. 2001-02 to 2003-04."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdbf1519-6790-3d83-9cdd-0438a307fafe",
                        "entry_id": "bf23c385-2b23-3af4-a772-5ba3536227c1",
                        "glosses": [
                            "The wood obtained from this tree."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "954fa460-8606-40f8-8993-ac2b7c4f0644",
                                "sense_id": "bdbf1519-6790-3d83-9cdd-0438a307fafe",
                                "text": "...yields extremely hard, heavy and durable timber (trade name-anjan) that is used in a variety of ways locally."
                            },
                            {
                                "example_id": "7b45aec8-89c0-4220-98c3-6c9a258d4c87",
                                "sense_id": "bdbf1519-6790-3d83-9cdd-0438a307fafe",
                                "text": "H. binata yields an extremely hard, very heavy (specific gravity 1.08; weight 69 lb/cft) and durable timber known in trade as Anjan."
                            }
                        ]
                    }
