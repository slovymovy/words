                            {
                                "example_id": "ad9133b6-5e9c-4227-a83a-df5d739ae369",
                                "sense_id": "dedb42a3-0be0-3ccd-9e2e-b3df3a016663",
                                "text": "Un cordon-bleu est un empilage de tranches de viande blanche, de jambon et de fromage."
                            },
                            {
                                "example_id": "10176a42-74a7-4e54-89f2-b0a9304c7298",
                                "sense_id": "dedb42a3-0be0-3ccd-9e2e-b3df3a016663",
                                "text": "A la suite de cette machine , se trouve un empilage qui reçoit les tablettes de chocolat dès qu'elles ont été enveloppées."
                            },
                            {
                                "example_id": "7a318142-7904-46f3-874d-fb14f4262e16",
                                "sense_id": "dedb42a3-0be0-3ccd-9e2e-b3df3a016663",
                                "text": "D’autres aspects des loisirs militaires l’enchantent moins. Il se fait mal aux graisseux jeux de cartes des cafés et à leur empilage de soucoupes, aux gauloiseries rebattues sur le passage des jolies filles, aux propos insipides coupés de silences ou de bâillements."
                            }
                        ]
                    },
