                    {
                        "sense_id": "a5ae0ed4-7302-3fa8-9844-4d1ce57e3e6f",
                        "entry_id": "0b41355e-dfd0-3071-8787-c43dc7377ddd",
                        "glosses": [
                            "Nom propre donné à une période spécifique de temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4332ad31-07ba-4a15-8f6f-19a46b202662",
                                "sense_id": "a5ae0ed4-7302-3fa8-9844-4d1ce57e3e6f",
                                "text": "L’expression « Belle Époque », qui désigne les quinze premières années du XXᵉ siècle, constitue le type même du chrononyme rétrospectif, forgé après-coup pour pleurer « le monde que nous avons perdu »."
                            },
                            {
                                "example_id": "91563352-70d9-47f7-ba1a-b971197ec54f",
                                "sense_id": "a5ae0ed4-7302-3fa8-9844-4d1ce57e3e6f",
                                "text": "Ce type d’expression (qui est un chrononyme) est un lieu intéressant d’investigation de la sémantique des adverbiaux temporels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07c526fa-eac1-4dee-a1ce-8d42af64f190",
                        "source_entry_id": "0b41355e-dfd0-3071-8787-c43dc7377ddd",
                        "source_sense_id": "a5ae0ed4-7302-3fa8-9844-4d1ce57e3e6f",
