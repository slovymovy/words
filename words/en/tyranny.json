{
    "word_family": [
        "tyrant",
        "tyrannical",
        "tyrannize",
        "tyrannicide",
        "tyrannous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7745f828-1267-3a2f-ab4d-037a58bc55fe",
                    "sense_definition": "A government or system of rule in which a single leader has absolute power, especially one characterized by cruelty and injustice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nation suffered under the harsh <w>tyranny</w> of the dictator for decades."
                        },
                        {
                            "text": "Many citizens risked their lives in an attempt to escape foreign <w>tyranny</w>."
                        }
                    ],
                    "synonyms": [
                        "despotism",
                        "dictatorship",
                        "autocracy"
                    ],
                    "antonyms": [
                        "democracy"
                    ],
                    "common_phrases": [
                        "escape tyranny",
                        "live under tyranny",
                        "oppose tyranny"
                    ]
                },
                {
                    "sense_id": "1fc60f56-f14e-3121-b67a-320fa0ea9222",
                    "sense_definition": "Cruel, oppressive, or unreasonable use of power or authority.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers united to resist the petty <w>tyranny</w> of their manager."
                        },
                        {
                            "text": "Philosophers often warned about the <w>tyranny</w> of the majority in a society."
                        }
                    ],
                    "synonyms": [
                        "despotism"
                    ],
                    "common_phrases": [
                        "tyranny of the majority",
                        "petty tyranny"
                    ]
                },
                {
                    "sense_id": "6b4d8769-d3bb-3c96-8ad6-8c386a81ced6",
                    "sense_definition": "A political system where authority is exercised strictly to benefit the rulers without considering the will of the governed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The revolutionaries declared war against political <w>tyranny</w> and economic exploitation."
                        },
                        {
                            "text": "Without proper legal checks, any regime can slide rapidly into corrupt <w>tyranny</w>."
                        }
                    ],
                    "synonyms": [
                        "autocracy",
                        "despotism"
                    ],
                    "common_phrases": [
                        "fight against tyranny",
                        "political tyranny"
                    ]
                },
                {
                    "sense_id": "4a8aabd7-aa2c-39d9-9183-bee2fbba591c",
                    "sense_definition": "Extreme severity, rigor, or unbearable harshness in conditions or demands.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers could barely withstand the unrelenting <w>tyranny</w> of the winter cold."
                        },
                        {
                            "text": "Modern life often traps creative thinkers under the relentless <w>tyranny</w> of urgent deadlines."
                        }
                    ],
                    "common_phrases": [
                        "tyranny of the clock"
                    ]
                },
                {
                    "sense_id": "0dc71ee5-1ad5-356e-889c-b607fc34c626",
                    "sense_definition": "The formal office, rank, or territorial jurisdiction of an absolute ruler.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held the ancient city's <w>tyranny</w> for over a decade before being deposed."
                        },
                        {
                            "text": "During that century, several Greek states fell into hereditary <w>tyranny</w>."
                        }
                    ],
                    "synonyms": [
                        "tyranthood"
                    ]
                }
            ]
        }
    ]
}