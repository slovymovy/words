                                "target_senses": [
                                    {
                                        "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                        "entry_id": "17552cdc-9b10-3b76-b23e-3e55da97ce55",
                                        "glosses": [
                                            "Raison que l’on allègue pour expliquer ou atténuer une faute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7d4264-3cbe-4cfc-9f1c-4a386737e1e4",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Ces malfaiteurs littéraires voudraient persuader de tels hommes qu'ils n'ont pas besoin d’excuse et que leur conduite se conforme au dictamen de la nature."
                                            },
                                            {
                                                "example_id": "072b7429-ee8f-437f-8767-e5c193c1e644",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Excuse légitime, valable, recevable."
                                            },
                                            {
                                                "example_id": "80fba8b0-651e-4de7-a521-48df0ce1780b",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Bonne, mauvaise, sotte excuse."
                                            },
                                            {
                                                "example_id": "ca81f5ee-2291-4dbf-ab62-12367e3ed480",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Donner, apporter, alléguer, présenter une excuse."
                                            },
                                            {
                                                "example_id": "d74f82db-4048-46bd-85a1-984bb3c7c0be",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Se chercher, demander des excuses."
                                            },
                                            {
                                                "example_id": "793362da-db58-4165-8970-927f622b1060",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Il a pris pour excuse le mauvais temps."
                                            },
                                            {
                                                "example_id": "e99368dd-347c-47e0-add3-8ccd16029ac1",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Avoir une excuse toute prête."
                                            },
                                            {
                                                "example_id": "79234cd2-c16b-4d3f-991a-dbc29a62824e",
                                                "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                                                "text": "Sa jeunesse lui servira d’excuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                        "entry_id": "17552cdc-9b10-3b76-b23e-3e55da97ce55",
                                        "glosses": [
                                            "Dispense d’une obligation, en particulier scolaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f03f70b-0961-4bed-b9d6-de5cc164bacf",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Vous étiez absent à la classe du matin, vos parents vous ont-ils donné une excuse ?"
                                            },
                                            {
                                                "example_id": "935ff889-a79f-4c4d-ad78-ddcde5875688",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Expression du regret qu’on éprouve d’avoir offensé quelqu’un, de s’être mal comporté à son égard."
                                            },
                                            {
                                                "example_id": "b0f62ac8-2524-47f5-b07f-bb20cda248f3",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Cette dernière a présenté des excuses publiques à l’actrice, apache et yaqui, jadis célébrée par des militants pour sa démarche, mais mise au ban par les professionnels du cinéma."
                                            },
                                            {
                                                "example_id": "e30137e0-edf9-43fd-a9cd-5575b1832987",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Se confondre en excuses."
                                            },
                                            {
                                                "example_id": "adddac8d-cf8f-45fb-b932-7279bfb823ee",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "S’emploie surtout avec le verbe faire, comme dans ces phrases :"
                                            },
                                            {
                                                "example_id": "1e69f8ca-b10e-40f3-ac46-0118ad2de50d",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Faire des excuses à quelqu’un."
                                            },
                                            {
                                                "example_id": "3c506333-682a-4f75-972d-6e01cb85433b",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Je vous en fais mille excuses."
                                            },
                                            {
                                                "example_id": "3c7a9e7d-e8fc-49ff-986f-38690481b5ad",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Je vous en fais excuse pour lui."
                                            },
                                            {
                                                "example_id": "f70470ab-3233-493b-abb7-6e6c2c6fc7bd",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Je vous fais excuse, je vous fais bien excuse : S’emploie lorsqu’on veut contredire poliment quelqu’un."
                                            },
                                            {
                                                "example_id": "eeb48193-9fd3-4f46-b7d3-6cc909c74f5d",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Il n’est pas encore venu ?\nJe vous fais excuse, il est venu et il est reparti."
                                            },
                                            {
                                                "example_id": "4a759afd-8106-4fa6-95eb-ea3bbf11a4c2",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Il exigeait que son adversaire lui fît des excuses."
                                            },
                                            {
                                                "example_id": "8ac7b29e-6671-495f-813e-bfed8daad529",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "On dit, dans un sens analogue,"
                                            },
                                            {
                                                "example_id": "c66c66f4-a761-4ece-ae66-d58b8b27c6a6",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Exiger des excuses."
                                            },
                                            {
                                                "example_id": "11286d0c-91b3-40ca-8404-9590fbc31a17",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "Toutes mes excuses !"
                                            },
                                            {
                                                "example_id": "cfd59c6a-b641-4106-a3ce-0afec49e34bd",
                                                "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                                                "text": "— Est-elle seule ?\n— Faites excuse, le maréchal y est."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bd9a8ab-a94d-3ade-a93d-9c4b338143b9",
                                        "entry_id": "17552cdc-9b10-3b76-b23e-3e55da97ce55",
                                        "glosses": [
                                            "Carte du jeu de tarot, l’un des trois bouts et sorte de joker qui ne remporte pas le pli (sauf en cas de grand chelem) mais reste dans le camp qui la possède à condition qu’elle ne soit pas jouée dans la dernière levée. Caractère Unicode : 🃠."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
