                                "sense_id": "0ed5a8c4-01d1-3f6e-a1bc-c06a54a16902",
                                "text": "„Val rang mit der Erkenntnis, dass sie nun zur Komplizin beim Diebstahl von achtzehn Litern Anstrichfarbe geworden war.“"
                            },
                            {
                                "example_id": "6e05d35d-8ba0-49fb-bc6a-8b18fc7af158",
                                "sense_id": "0ed5a8c4-01d1-3f6e-a1bc-c06a54a16902",
                                "text": "„Ich wollte nicht zu seiner Komplizin werden.“"
                            }
                        ],
