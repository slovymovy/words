                "translations": [
                    {
                        "translation_id": "10c6b172-4458-457e-958f-f12a8693d993",
                        "source_entry_id": "5c0ab680-e997-368f-8799-cfb362aa6417",
                        "target_lang_word": "emmitoufler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emmitoufler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f2d7f5-1965-3eec-806a-3b62f8ceca4f",
                                        "entry_id": "baffa474-5d10-3051-baaf-4c5cb3330f9f",
                                        "glosses": [
                                            "Envelopper quelqu’un de fourrures, de vêtements, surtout au cou et à la tête, pour le tenir au chaud."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0850fccb-dc0c-4e4d-aa78-c1bdd3bff505",
                                                "sense_id": "f8f2d7f5-1965-3eec-806a-3b62f8ceca4f",
                                                "text": "Assis sur le coffre et déjà emmitouflé dans la pelisse de M. Butteridge, Bert avait drapé autour de son buste le vaste manteau de dame, et enroulé autour de ses jambes une épaisse couverture."
                                            },
                                            {
                                                "example_id": "718e95bf-14dd-4f2e-9f1c-0a65b927f3d2",
                                                "sense_id": "f8f2d7f5-1965-3eec-806a-3b62f8ceca4f",
                                                "text": "— […], et j’ai pensé qu’en m’emmitouflant ainsi, ma sortie me ferait plus de bien que de mal."
                                            },
                                            {
                                                "example_id": "d29faa11-c910-4727-962a-a8b7dcd9bea7",
                                                "sense_id": "f8f2d7f5-1965-3eec-806a-3b62f8ceca4f",
                                                "text": "— […], et une peinture sous verre, fixée sur la façade, représentait une femme appétissante aux yeux noirs qui, frileusement, s’emmitouflait de fourrures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ac26dc4-812a-48ee-9e63-dacc032638a7",
                        "source_entry_id": "5c0ab680-e997-368f-8799-cfb362aa6417",
                        "target_lang_word": "envelopper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envelopper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                                        "entry_id": "e2147909-ad3a-3df2-bda2-01f62d44978d",
                                        "glosses": [
                                            "Entourer de tous côtés quelque chose avec du papier, une étoffe, un linge, etc., qui couvre, qui environne de tous côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f794b5bb-d971-4053-978c-7c032f97d870",
                                                "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                                                "text": "Un brouillard fumeux, ressemblant à celui de l’été indien, enveloppait toutes choses et ajoutait naturellement à mon incertitude."
                                            },
                                            {
                                                "example_id": "22c17789-dc2a-47c8-9f16-083359d87245",
                                                "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                                                "text": "Enfin, ayant réussi à se mettre sur son séant, le malheureux frotta sa joue contusionnée et rajusta le pansement qui lui enveloppait encore la tête."
                                            },
                                            {
                                                "example_id": "b9700e01-56ed-4ec0-9fc8-6db711a3144a",
                                                "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                                                "text": "D’épais bancs de brume dévalaient en cascade des hauteurs de l’île et nous enveloppèrent bientôt; mais le calme était complet, […]."
                                            },
                                            {
                                                "example_id": "f7a05bba-70e5-4b21-a839-a5c75ac4727d",
                                                "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                                                "text": "- Ceux-ci, après avoir fait feu, avaient été enveloppés et massacrés avant d’avoir eu le temps de recharger leurs armes."
                                            },
                                            {
                                                "example_id": "b1c5af71-d6fa-4e47-8f1e-ab1e5bf56610",
                                                "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                                                "text": "Au milieu des livres, j’ai découvert ce livre d’images. Il était enveloppé de cellophane et entouré d’une ficelle dorée."
                                            },
                                            {
                                                "example_id": "932cbd30-f9ff-405a-8149-313fb46d5e67",
                                                "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                                                "text": "Mon Dieu, en quel martyre vous m’avez condamnée à vivre, enveloppée de duplicités, environnée d’embûches, cernée de chausses-trapes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aaa1f24-c75c-318e-a3bd-d2c59d403a12",
                                        "entry_id": "e2147909-ad3a-3df2-bda2-01f62d44978d",
                                        "glosses": [
                                            "Voiler ; recouvrir ; cacher."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b70d840-05d3-4699-bc62-66b80100f82a",
                                                "sense_id": "6aaa1f24-c75c-318e-a3bd-d2c59d403a12",
                                                "text": "[…] le ciel était à peine éclairci et la même vapeur sombre enveloppait tout et effaçait les contours des objets."
                                            },
                                            {
                                                "example_id": "6f771cfc-a9fc-4721-b120-9a6f2f977aa2",
                                                "sense_id": "6aaa1f24-c75c-318e-a3bd-d2c59d403a12",
                                                "text": "Au milieu de l’insondable obscurité, dont s’enveloppe le Kara-Koum, j’éprouve l’impression que donne l’immensité nocturne de la mer autour d’un navire."
                                            },
                                            {
                                                "example_id": "7779efea-fd8b-4a3d-b180-7b6ede1a6f3d",
                                                "sense_id": "6aaa1f24-c75c-318e-a3bd-d2c59d403a12",
                                                "text": "Mais, ô malheur! le vent saute au sud-ouest et nous enveloppe d'un brouillard épais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b0786d4-f183-3bc6-a6be-8a1d22b3ec43",
                                        "entry_id": "e2147909-ad3a-3df2-bda2-01f62d44978d",
                                        "glosses": [
                                            "Cacher ; déguiser ; brouiller."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244dbd80-7b1b-47fd-a8be-205110ca8b2a",
                                                "sense_id": "4b0786d4-f183-3bc6-a6be-8a1d22b3ec43",
                                                "text": "Les poètes ont enveloppé de fables la vérité, ont enveloppé la vérité du voile de la fable."
                                            },
                                            {
                                                "example_id": "c877f078-fa28-4b6f-95ba-fb1e338a46d5",
                                                "sense_id": "4b0786d4-f183-3bc6-a6be-8a1d22b3ec43",
                                                "text": "Il enveloppe à dessein sa pensée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0366c1c-03c0-3caf-97af-0a9c3a2e9a91",
                                        "entry_id": "e2147909-ad3a-3df2-bda2-01f62d44978d",
                                        "glosses": [
                                            "Comprendre ; inclure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ff686b-97c9-4e57-aa95-5deac003547d",
                                                "sense_id": "c0366c1c-03c0-3caf-97af-0a9c3a2e9a91",
                                                "text": "Un monde est une enveloppe du ciel, qui enveloppe astres, terre et tout ce qui apparaît, qui s’est scindée de l’illimité, et qui se termine par une limite ou rare ou dense, dont la dissipation bouleversera tout ce qu’elle contient ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aac3fcc-2d45-4e9c-bb39-ec8b1d37a9f3",
                        "source_entry_id": "5c0ab680-e997-368f-8799-cfb362aa6417",
                        "target_lang_word": "recouvrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recouvrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76644fce-fed8-312e-9a48-da93f5d0810e",
                                        "entry_id": "43288ba6-45b0-37b6-bdd8-9b62d5b6e747",
                                        "glosses": [
                                            "Couvrir de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baafa230-6f9c-4712-b00f-c88d7b965d07",
                                                "sense_id": "76644fce-fed8-312e-9a48-da93f5d0810e",
                                                "text": "Recouvrir un toit, une maison, les fauteuils."
                                            },
                                            {
                                                "example_id": "20acebd0-e48f-45f3-aee6-2f2d44fa46d7",
                                                "sense_id": "76644fce-fed8-312e-9a48-da93f5d0810e",
                                                "text": "Faire recouvrir un livre."
                                            },
                                            {
                                                "example_id": "cadd35d2-b728-4ab6-9250-8a3d39ac9ad2",
                                                "sense_id": "76644fce-fed8-312e-9a48-da93f5d0810e",
                                                "text": "Recouvrir un vase."
                                            },
                                            {
                                                "example_id": "2c66d180-dbd2-4fdd-8d60-d2d3b7a92e9d",
                                                "sense_id": "76644fce-fed8-312e-9a48-da93f5d0810e",
                                                "text": "Recouvrir un parapluie."
                                            },
                                            {
                                                "example_id": "2f4ac5f1-3e33-489c-b2dd-4408daea6c24",
                                                "sense_id": "76644fce-fed8-312e-9a48-da93f5d0810e",
                                                "text": "Le temps, le ciel se recouvre, Il est obscurci à nouveau par des nuages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d384727-54a4-3005-8a70-4bf2998ae9b0",
                                        "entry_id": "43288ba6-45b0-37b6-bdd8-9b62d5b6e747",
                                        "glosses": [
                                            "Couvrir entièrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54857395-28a6-4de8-9f0c-46247bbb2f72",
                                                "sense_id": "0d384727-54a4-3005-8a70-4bf2998ae9b0",
                                                "text": "Ce sont les larves des pucerons qui, réunies en familles innombrables, recouvrent quelquefois des branches entières de nos arbres fruitiers, la tige de nos fleurs, de nos légumes."
                                            },
                                            {
                                                "example_id": "b912e175-832d-48cd-92b5-c7d6a22ee4d5",
                                                "sense_id": "0d384727-54a4-3005-8a70-4bf2998ae9b0",
                                                "text": "Les pailles, dont les couches épaisses recouvraient entièrement le sol de la cour, se doraient peu à peu d'un jaune pâle sous la lueur grandissante du crépuscule."
                                            },
                                            {
                                                "example_id": "a0f1b067-903e-467e-a720-bfebe06c4632",
                                                "sense_id": "0d384727-54a4-3005-8a70-4bf2998ae9b0",
                                                "text": "[…], sur deux chaises était posé un cercueil de bois blanc, à demi recouvert d’une nappe de toile écrue qu’ornaient seulement le crucifix de cuivre et le rameau de buis bénit."
                                            },
                                            {
                                                "example_id": "071ef0c5-db8b-4bc5-8d2a-125776178403",
                                                "sense_id": "0d384727-54a4-3005-8a70-4bf2998ae9b0",
                                                "text": "Le revêtement en place, souvent recouvert de gravillons, n'est pas conçu pour être normalement circulable, mais seulement ponctuellement emprunté dans le cadre d'interventions de maintenance."
                                            },
                                            {
                                                "example_id": "7a57d0df-8896-4b5b-8ec3-1e3f206ff6d5",
                                                "sense_id": "0d384727-54a4-3005-8a70-4bf2998ae9b0",
                                                "text": "[…] deux ouvriers recouvrent les poissons d'une pelletée de sel avant de les précipiter dans une fosse de conservation."
                                            },
                                            {
                                                "example_id": "ae5e30fa-e37e-425e-a3f0-04d98d1e474a",
                                                "sense_id": "0d384727-54a4-3005-8a70-4bf2998ae9b0",
                                                "text": "— Tout au sommet de la dune, une vigie recouvre, très au loin, le pays; rien ne peut lui échapper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c40421-ff19-31f5-b7a1-de3771da9a24",
                                        "entry_id": "43288ba6-45b0-37b6-bdd8-9b62d5b6e747",
                                        "glosses": [
                                            "Masquer, cacher avec soin sous des prétextes spécieux, sous des apparences louables, quelque chose de vicieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6942e197-9e93-41d3-aa4e-04c24945901d",
                                                "sense_id": "f7c40421-ff19-31f5-b7a1-de3771da9a24",
                                                "text": "Mythologie du village français ? Oui, complètement ! C’est même drôle à quel point nous recouvrons la réalité par des métaphores et des mythes. Actuellement, ce sont l’image de la guerre et de l’abri qui dominent."
                                            },
                                            {
                                                "example_id": "5b1a197c-0539-4b91-88bf-b5a63b11d856",
                                                "sense_id": "f7c40421-ff19-31f5-b7a1-de3771da9a24",
                                                "text": "Il a eu soin de recouvrir tout cela de beaux prétextes. — Il recouvre ses défauts d’un vernis de politesse et d’agrément."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
