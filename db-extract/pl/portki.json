                                        "entry_id": "63f90225-f6cd-3542-9d09-e18a5ff4ffc6",
                                        "glosses": [
                                            "Qui est particulièrement drôle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2694b3d-a1c4-486b-b98c-417b8cc7bd8a",
                                                "sense_id": "7b4df7c7-ab8a-3e67-a749-92aa176624b2",
                                                "text": "Le film était trop fendard."
                                            },
                                            {
                                                "example_id": "29745efc-4f87-49e0-836d-a4542aa51a24",
                                                "sense_id": "7b4df7c7-ab8a-3e67-a749-92aa176624b2",
                                                "text": "Les dialogues sont juste ce qu’il faut (en VO of course, la VF est évidemment fendarde vu le doublage)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fendard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c3ce5aa-a717-344e-b18c-eee279b327f0",
                                        "entry_id": "931ef79c-6257-3f2c-b4ef-3310bc9595bc",
                                        "glosses": [
                                            "Pantalon."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03615b44-d01d-418e-94c8-a3b0ce5a6ecb",
                                                "sense_id": "4c3ce5aa-a717-344e-b18c-eee279b327f0",
                                                "text": "Elles durent le remarquer car avec une douceur surprenante, la nonne aux biscottos m’enfila une limace grise à col raide et un fendard marron qui m’arrivait jusqu’aux genoux, puis une paire de bas dont les talons et les bouts de panard étaient renforcés avec des bouts de tissu pour éviter l’usure."
                                            },
                                            {
                                                "example_id": "87d3fe37-638f-4bc6-953c-2712416d1459",
                                                "sense_id": "4c3ce5aa-a717-344e-b18c-eee279b327f0",
                                                "text": "Baisse ton fendard !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "828bbbf3-f7f8-4a61-913f-161d9805f0de",
                        "source_entry_id": "1a398140-8a12-348d-be37-1480957c8c4a",
