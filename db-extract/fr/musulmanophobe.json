                                        "entry_id": "b72d2cc7-f440-3b5b-8af0-630129a87438",
                                        "glosses": [
                                            "Islamophobic; having a fear or hatred Muslims."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "possibly",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f47bb41-48c0-4028-86a0-75217d953735",
                                                "sense_id": "4ef03efa-adfe-3320-9684-d1cb53ca2af8",
                                                "text": "Europe (especially Britain and France) are traditionally muslimphobic and their foreign policies have for decades been geared to prevent the establishment of state(s) that may have muslim majorities in order to, to their way of thinking, prevent any \"middle eastern\" Islamic governments from gaining a foothold in Europe."
                                            },
                                            {
                                                "example_id": "1443b662-1c3f-4101-bbcd-02f6d2e792b4",
                                                "sense_id": "4ef03efa-adfe-3320-9684-d1cb53ca2af8",
                                                "text": "[…] Muslimphobic vilification of Germans […]"
                                            },
                                            {
                                                "example_id": "f66aae4c-ccf4-4dfb-917b-119b6c388771",
                                                "sense_id": "4ef03efa-adfe-3320-9684-d1cb53ca2af8",
                                                "text": "[…] violence and aggression that occurred in the post-September 11 period might possibly better be described as Muslimphobic rather than Islamophobic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
