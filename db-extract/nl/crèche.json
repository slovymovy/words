                        "examples": [
                            {
                                "example_id": "7c542fc4-cea6-4d84-8453-1a60270b60bf",
                                "sense_id": "b4316239-683a-3717-ba13-80b147d39a1d",
                                "text": "Zij brengt haar kinderen vaak naar de crèche."
                            },
                            {
                                "example_id": "f38c7eba-5c77-4e73-a8cd-515cf0b6fe80",
                                "sense_id": "b4316239-683a-3717-ba13-80b147d39a1d",
                                "text": "Wij hebben de kleinkinderen vaak over de vloer. (...) Onze huiskamer lijkt af en toe wel een crèche."
                            },
                            {
                                "example_id": "817eca4f-e0f3-468d-85e1-832defe245d9",
                                "sense_id": "b4316239-683a-3717-ba13-80b147d39a1d",
                                "text": "Op Bonaire zijn de scholen en crèches vanaf woensdagochtend plaatselijke tijd gesloten. Er zijn schuilplaatsen ingericht op vijf plekken op het eiland, meldt Bonaire.nu."
                            }
                        ]
                    }
