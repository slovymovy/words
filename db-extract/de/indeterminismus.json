                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Indeterminismus"
                    },
                    {
                        "form_id": "f43f0532-aafb-4062-8284-e6393a3d5076",
                        "entry_id": "a74a0558-d7a7-3df5-93e3-698f63db00bd",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Indeterminismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                        "entry_id": "a74a0558-d7a7-3df5-93e3-698f63db00bd",
                        "glosses": [
                            "Weltbild, das nicht vom Determinismus ausgeht, sondern vertritt, dass der menschliche Willensakt nicht bestimmbar und vorhersehbar ist"
                        ],
                        "tags": [
                            "des Geistes"
                        ],
                        "examples": [
                            {
                                "example_id": "2bffece4-2870-4de4-9ace-ef8c134d480d",
                                "sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                                "text": "„Eine letzte Frage betrifft schließlich das bereits gelegentlich angeschnittene Problem des Verältnisses von Determinismus und Indeterminismus.“"
                            },
                            {
                                "example_id": "066bc63d-277a-4f97-818b-8809b8c58a16",
                                "sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                                "text": "Der Indeterminismus geht davon aus, dass der menschliche Wille sich selbst die Richtung gibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8efdd423-dec3-4fa5-b2bb-eb62e63a3cfd",
                        "source_entry_id": "a74a0558-d7a7-3df5-93e3-698f63db00bd",
                        "source_sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                        "target_lang_word": "非決定論",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
