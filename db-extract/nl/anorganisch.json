                    {
                        "translation_id": "82c48d0e-46bf-4d9c-9cbe-b8df059fab29",
                        "source_entry_id": "252bc073-e59b-32b6-af7e-952bb3936294",
                        "source_sense_id": "45e59d70-5957-37f5-9522-aff15e1e943c",
                        "source_sense_description": "niet tot de koolstofverbindingen behorend",
                        "target_lang_word": "inorganique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inorganique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b75641f9-ba9b-36ae-adaf-d7811b45f40a",
                                        "entry_id": "94a3f369-51b9-36b2-bcee-de6825161cf6",
                                        "glosses": [
                                            "Qualifie les corps qui ne sont pas organisés et qui ne peuvent s’accroître que par juxtaposition, tels que les minéraux."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ab5f0d-dca3-4169-9fa0-4f792c02e26e",
                                                "sense_id": "b75641f9-ba9b-36ae-adaf-d7811b45f40a",
                                                "text": "La nature physico-chimique et les degrés de l’animalité, de la végétabilité et de la sidéralité, qui forment le fond de la constitution organique, suborganique ou inorganique des trois principales sortes d’individualités naturelles, sont, jusqu’à ce jour, des mystères que la chimie et la physique organiques et inorganiques n’ont point encore pu parvenir à dévoiler."
                                            },
                                            {
                                                "example_id": "54a584a6-0c42-4ab3-8b04-c8cfd3d00886",
                                                "sense_id": "b75641f9-ba9b-36ae-adaf-d7811b45f40a",
                                                "text": "C’est encore plus vrai du corail qui synthétise sa propre matière à partir d’éléments inorganiques comme les végétaux, mais aussi à partir de matière organique comme les animaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d800d3-082a-3d7e-a2eb-b89c6262860a",
                                        "entry_id": "94a3f369-51b9-36b2-bcee-de6825161cf6",
                                        "glosses": [
                                            "Désigne la chimie liée aux molécules qui n'ont pas une chaîne carbonée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93bb8eb2-cbb1-4352-a16b-13b8bc68c73e",
                                                "sense_id": "70d800d3-082a-3d7e-a2eb-b89c6262860a",
                                                "text": "Si on considère que la chimie organique est la « chimie du carbone », la chimie inorganique est alors la chimie de tous les éléments autres que le carbone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
