                    }
                ],
                "translations": [
                    {
                        "translation_id": "13032d4f-7a32-4199-ac99-fae99d665a35",
                        "source_entry_id": "c50b867a-bed0-31e6-a1f8-acb29622bec7",
                        "source_sense_id": "49c15011-e97b-308d-b7a1-7bcc2ccb269d",
                        "target_lang_word": "makeweight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "makeweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57155467-66d7-37f8-ac04-5d6f672e581a",
                                        "entry_id": "c3990388-126b-34da-8225-c0333a5c749e",
                                        "glosses": [
                                            "Something of inferior quality which is included in a shipment to make up the weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7e609e-cdc6-4b95-93ab-9bbf255b58f9",
                                                "sense_id": "57155467-66d7-37f8-ac04-5d6f672e581a",
                                                "text": "1893, Richard Le Gallienne, in a publisher's report on stories by Ernest Dowson, quoted in Jad Adams, Madder Music, Stronger Wine, page 88.\nI would advise you to accept these as an instalment of a volume, (they are not big enough to make one themselves) with the promise that the stories to come should be more striking, more original in theme — not less so, not mere makeweights — than those under consideration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9643f30-bf1a-3505-a7aa-6ac013a66c50",
                                        "entry_id": "c3990388-126b-34da-8225-c0333a5c749e",
                                        "glosses": [
                                            "Something included to add to the apparent weight or force of an argument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f58156-672b-484e-be42-d5eb44c719bd",
                                                "sense_id": "a9643f30-bf1a-3505-a7aa-6ac013a66c50",
                                                "text": "He added a long litany of peripheral precedents which the judge dismissed as mere makeweights."
                                            },
                                            {
                                                "example_id": "ae8fb330-b894-46c5-b0da-a1c638fd8a56",
                                                "sense_id": "a9643f30-bf1a-3505-a7aa-6ac013a66c50",
                                                "text": "Other railway schemes of the earliest period certainly mentioned benefits to agriculture, but only as a make-weight; most of them justified themselves by improved transport of minerals for shipment, […], or by carriage of bulk loads of manufactured goods."
                                            },
                                            {
                                                "example_id": "be68cc33-5689-4b8f-af48-b82a3d56333c",
                                                "sense_id": "a9643f30-bf1a-3505-a7aa-6ac013a66c50",
                                                "text": "Fashion, as it happens, favors certain rows of the style matrix: museums, connoisseurs, and others are makeweights in the Artworld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7c70a83-c3bb-46d2-85ae-b24c819513ae",
                        "source_entry_id": "c50b867a-bed0-31e6-a1f8-acb29622bec7",
                        "source_sense_id": "49c15011-e97b-308d-b7a1-7bcc2ccb269d",
                        "target_lang_word": "Zuwaage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuwaage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c07e7f16-5e2b-30a4-89a9-48481414275a",
                                        "entry_id": "61779737-aac1-3ad7-83e4-3eae79a11ed1",
                                        "glosses": [
                                            "die Zugabe bei einem Einkauf (vor allem beim Metzger)"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e94386ad-5ca8-47ab-831c-f6f328d36f24",
                                                "sense_id": "c07e7f16-5e2b-30a4-89a9-48481414275a",
                                                "text": "Der Gemüsehändler hat mir eine ordentliche Zuwaage gegeben."
                                            },
                                            {
                                                "example_id": "510f789c-db98-49de-81b5-c29d6119c612",
                                                "sense_id": "c07e7f16-5e2b-30a4-89a9-48481414275a",
                                                "text": "„Demzufolge war die sogenannte Zuwaage wesentlicher Bestandteil des Rindfleischpreises, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "902881b5-0b78-4788-9ed1-1e9604ddcbc2",
                        "source_entry_id": "c50b867a-bed0-31e6-a1f8-acb29622bec7",
                        "source_sense_id": "49c15011-e97b-308d-b7a1-7bcc2ccb269d",
                        "target_lang_word": "complément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9887a0f-4d73-30ce-97bf-09ff90d00347",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Ce qui s’ajoute ou doit s’ajouter à une chose pour la rendre entière, complète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47625009-211e-4d7a-9566-bc8e5c350088",
                                                "sense_id": "b9887a0f-4d73-30ce-97bf-09ff90d00347",
                                                "text": "À Sparte, le vol était pratiqué et honoré : c’était une institution hiératique, un complément indispensable à l’éducation de tout Lacédémonien sérieux."
                                            },
                                            {
                                                "example_id": "26dd988d-1bba-4ad1-a48b-dddcec07dec2",
                                                "sense_id": "b9887a0f-4d73-30ce-97bf-09ff90d00347",
                                                "text": "La ration de base doit être complétée par un complément simple ou composé qui équilibre l'ensemble de la ration par rapport aux besoins de l'animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf13f37-5a8b-3393-ba72-384794e67608",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Ce qu’il faut ajouter à un angle pour compléter l’angle droit, c’est-à-dire quatre-vingt-dix degrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e9421af-2745-4591-bea0-e1c88ebc9ebf",
                                                "sense_id": "adf13f37-5a8b-3393-ba72-384794e67608",
                                                "text": "Complément d’un angle. - L’angle de trente degrés a pour complément l’angle de soixante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6d9dc64-4fdd-37e6-b4b6-8eb0d6617290",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Différence entre un nombre et l’unité suivie d’autant de zéros qu’il y a de chiffres dans ce nombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d81c179-a3e4-48a7-9106-6f96bd45cbc3",
                                                "sense_id": "a6d9dc64-4fdd-37e6-b4b6-8eb0d6617290",
                                                "text": "Complément arithmétique d’un nombre. - Le complément arithmétique de 760 est 240."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "069ffcae-9f26-3786-85fc-0dbe27797f40",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Distance angulaire d’un astre au zénith."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2e1b0ff-7310-30ba-95d1-04de726eb58e",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Ce qu’il faut ajouter pour compléter l’octave"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40ed22e2-4dd8-4b05-838c-103d75836407",
                                                "sense_id": "c2e1b0ff-7310-30ba-95d1-04de726eb58e",
                                                "text": "Complément d’un intervalle. - Le complément de la quinte est la quarte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b345b2-083c-30d7-a777-bc02f4e709b2",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Mots ou groupes de mots qui servent à compléter la notion ou à déterminer le sens des mots auxquels ils sont joints, soit directement, soit indirectement au moyen de prépositions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88de9ab1-ff5a-36a8-aa97-23e7727a0f64",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Protéine du sérum sanguin, à la base d'une réaction immunologique, la déviation du complément ou fixation du complément."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42ee1bd5-44a4-3587-b4cc-f385c54e4189",
                                        "entry_id": "4ad2f7ce-acc7-3c46-87db-d85e2bfe1afc",
                                        "glosses": [
                                            "Plantation d’arbres — les regarnis — pour compléter une régénération défaillante ou déséquilibrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f3e173-8dcf-4341-8016-18ce12b5ca54",
                                                "sense_id": "42ee1bd5-44a4-3587-b4cc-f385c54e4189",
                                                "text": "Le complément artificiel des régénérations naturelles dans des peuplements traités en futaie irrégulière doit rester très rare : il est nécessairement diffus ou en bouquets, ce qui rend le suivi délicat et coûteux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
