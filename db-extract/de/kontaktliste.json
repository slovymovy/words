                "senses": [
                    {
                        "sense_id": "f49a6c1a-a2ed-31e1-b82f-2df740ba8efb",
                        "entry_id": "d7f97e1e-fccb-3451-906d-88f9b15ca4ca",
                        "glosses": [
                            "schriftlich festgehaltene Reihe von Namen (mit denen man zum Beispiel Kontakt aufnehmen möchte oder bereits Kontakt hatte); Aufzeichnung (Liste) über diejenigen Situationen, in denen ein Zusammenkommen mit anderer Menschen stattgefunden hat; Liste aller Kontaktpersonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff9957a-16e6-47e4-b6b3-a1b836628049",
                                "sense_id": "f49a6c1a-a2ed-31e1-b82f-2df740ba8efb",
                                "text": "„Dort kann man sich entweder selber in die bereits vorhandene Kontaktliste eintragen, oder die Kontaktliste nach einem Tandempartner durchsuchen.“"
                            },
                            {
                                "example_id": "bd6f5dd5-bb85-493d-96ef-f830fbc56701",
                                "sense_id": "f49a6c1a-a2ed-31e1-b82f-2df740ba8efb",
                                "text": "Bei der Kontaktermittlung geht es darum festzustellen, welche Personen mit Ihnen als erkrankter Person Kontakt hatten. Diesen Personen aus Ihrer Kontaktliste wird Ihr Name nicht mitgeteilt, sie bleiben also anonym."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
