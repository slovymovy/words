                ],
                "senses": [
                    {
                        "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                        "entry_id": "9858ee0a-6f59-345e-9b26-9995e11f5bb8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21fd940-cf48-46c0-a0d9-0112e4dd002d",
                                "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                                "text": "Frau Offenbach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7ade6425-7501-442d-8d89-91a536393277",
                                "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                                "text": "Herr Offenbach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b671c94b-2b08-43d1-92a6-2bd93b657da8",
                                "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                                "text": "Die Offenbachs fliegen heute nach Rom."
                            },
                            {
                                "example_id": "204a5e3c-af90-4654-b8da-84fb45d1bcbe",
                                "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                                "text": "Der Offenbach trägt nie die Pullover, die die Offenbach ihm strickt."
                            },
                            {
                                "example_id": "a57d8f77-dcac-4d88-b8c9-666cdf86702b",
                                "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Offenbach kommt, geht der Herr Offenbach.“"
                            },
                            {
                                "example_id": "1cf38102-a0da-4fa5-be24-2f8d0c2016cd",
                                "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                                "text": "Offenbach kommt und geht."
                            },
                            {
                                "example_id": "335164ec-1beb-4e2c-8353-09d5d80fe531",
                                "sense_id": "bb6523b9-32f5-3ee3-b926-d668cfc545cb",
                                "text": "Offenbachs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
