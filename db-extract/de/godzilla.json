                                "sense_id": "6fcfbb68-e78a-33f4-af19-a2e698117a13",
                                "text": "„Dieser Typ ist King Kong und Godzilla in einer Person.“"
                            },
                            {
                                "example_id": "e01cbedc-8131-4a5c-abc7-17cc240ad690",
                                "sense_id": "6fcfbb68-e78a-33f4-af19-a2e698117a13",
                                "text": "„›Ich nehm 270 mit. Für den Fall, dass Godzilla uns angreift.‹“"
                            },
                            {
                                "example_id": "869b7a8f-ff05-4753-bae4-06e7971e239f",
                                "sense_id": "6fcfbb68-e78a-33f4-af19-a2e698117a13",
                                "text": "„›Aber nein, es hat keinen Körper wie Godzilla, der durch die Gegend stampft und Menschen zermalmt.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
