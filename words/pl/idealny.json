                    "frequency": "High",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To <w>idealny</w> kandydat na to stanowisko, ponieważ jest doświadczony i mądry.",
                            "target_lang_translations": {
                                "ru": "Это <w>идеальный</w> кандидат на эту должность, поскольку он опытен и умен.",
                                "de": "Er ist der <w>ideale</w> Kandidat für diese Stelle, da er erfahren und klug ist."
                            }
                        },
                        {
                            "text": "Słoneczna pogoda sprawiła, że był to <w>idealny</w> moment na spacer po parku.",
                            "target_lang_translations": {
                                "ru": "Благодаря солнечной погоде это был <w>идеальный</w> момент для прогулки по парку.",
                                "de": "Das sonnige Wetter machte es zu einem <w>idealen</w> Moment für einen Spaziergang im Park."
                            }
                        }
                    ],
                    "synonyms": [
                        "doskonały"
                    ],
                    "antonyms": [
                        "nieodpowiedni",
                        "niewłaściwy"
                    ],
                    "common_phrases": [
