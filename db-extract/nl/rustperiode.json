                            {
                                "example_id": "55a534b5-ce33-4eff-afbc-86f914716dd3",
                                "sense_id": "824c92f0-d0c9-3b94-992f-363660b2e5e6",
                                "text": "In de weekenden van de rustperiode worden er vijf in plaats van tien wedstrijden gespeeld in de hoogste Engelse divisie. Het ene weekend spelen tien clubs, het weekend erop tien andere clubs."
                            },
                            {
                                "example_id": "8bdfeeeb-cc9f-446a-aa47-97cd12167db9",
                                "sense_id": "824c92f0-d0c9-3b94-992f-363660b2e5e6",
                                "text": "Vincent Gouttebarge pleit voor een minimale rustperiode van zeven dagen voor goed herstel van een hersenschudding: \"Zeven dagen is een veilige periode, dat zou een grote verbetering zijn.\""
                            }
                        ]
