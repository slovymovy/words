                        "examples": [
                            {
                                "example_id": "7177fe39-7d42-4dfe-ac22-1e8e122a148e",
                                "sense_id": "b3f9a75c-4e8f-3304-b522-1f506e4171cb",
                                "text": "Het volk slikte het. De Duitsers bleven Hitler niet trouw uit liefde en overtuiging. Ze bleven hem trouw omdat de nationaalsocialistische verzorgingsstaat van hen een volk had gemaakt van kleine, angstige, schuldbewuste profiteurs."
                            },
                            {
                                "example_id": "ba7b3312-6fb8-4662-b741-f41c255a7a1a",
                                "sense_id": "b3f9a75c-4e8f-3304-b522-1f506e4171cb",
                                "text": "Vooral in de media werd Buikhuisen verguisd, onder meer door columnist Piet Grijs (een pseudoniem van Hugo Brandt Corstius). Die noemde hem een \"kale, impotente carrièrewetenschapper\" en vergeleek hem met de toenmalige leider van de nationaalsocialistische Nederlandse Volks-Unie (NVU)."
                            }
                        ]
                    }
