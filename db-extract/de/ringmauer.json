                "senses": [
                    {
                        "sense_id": "2cc6136d-6bf4-321f-9807-ade40a596efc",
                        "entry_id": "97246725-3727-319e-9e91-64949b1e5cb2",
                        "glosses": [
                            "Wehrmauer, welche den inneren Bereich einer Burg oder einer ähnlichen Befestigungsanlage ringförmig umschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4420d517-565a-433a-a5a0-7c7676fca9e2",
                                "sense_id": "2cc6136d-6bf4-321f-9807-ade40a596efc",
                                "text": "Die Ringmauer schützte vor einem weiteren Vordringen der Eindringlinge."
                            },
                            {
                                "example_id": "3beb81d9-9c6d-4ad3-8c0c-907fe4a22754",
                                "sense_id": "2cc6136d-6bf4-321f-9807-ade40a596efc",
                                "text": "„Wenn gleich minder großartig als die Ringmauer, zieht dennoch der nordwärts und ganz nahe, auf kahler Anhöhe hervorragende, mächtige Teufels-Stein die Aufmerksamkeit kräftiger auf sich hin.“"
                            },
                            {
                                "example_id": "399e7413-816e-4f5d-9a26-b42de44eff07",
                                "sense_id": "2cc6136d-6bf4-321f-9807-ade40a596efc",
                                "text": "„Auf dem Holzschnitt umschließt eine doppelte, mit zahlreichen Türmen bewehrte Ringmauer die Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
