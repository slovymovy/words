                "senses": [
                    {
                        "sense_id": "db6a9caf-88ff-3f81-97d4-ca24a842a61e",
                        "entry_id": "c87297db-99df-3e48-a20e-27b62c312e00",
                        "glosses": [
                            "разг. притворяться; принимать вид кого-либо с целью обмана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "586b98be-58f0-49a3-b7e0-39c3edc89bf0",
                                "sense_id": "db6a9caf-88ff-3f81-97d4-ca24a842a61e",
                                "text": "Он орёл, который пока по непонятным для неё причинам вынужден прикидываться облезлой вороной."
                            }
                        ]
                    },
                    {
                        "sense_id": "df8dea0a-d8b7-344e-aaec-e6b057c234e5",
                        "entry_id": "c87297db-99df-3e48-a20e-27b62c312e00",
                        "glosses": [
                            "страд. к прикидывать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc785c02-aecc-4c9a-82cb-4127a23ddacc",
                        "source_entry_id": "c87297db-99df-3e48-a20e-27b62c312e00",
                        "source_sense_description": "притворяться; принимать вид кого-либо с целью обмана",
                        "target_lang_word": "preteed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a38456c3-c71c-47ee-9730-162c6e02aa4c",
                        "source_entry_id": "c87297db-99df-3e48-a20e-27b62c312e00",
                        "source_sense_description": "притворяться; принимать вид кого-либо с целью обмана",
                        "target_lang_word": "feign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c506b66-b22b-35ae-ba00-1bc2fd32f4b5",
                                        "entry_id": "059eed7b-f6bb-3883-aeae-a53686fd3575",
                                        "glosses": [
                                            "To make a false show or pretence of; to counterfeit or simulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "267557b9-ed2f-4596-9a93-476cdb67e090",
                                                "sense_id": "6c506b66-b22b-35ae-ba00-1bc2fd32f4b5",
                                                "text": "The pupil feigned sickness on the day of his exam."
                                            },
                                            {
                                                "example_id": "6828e527-966c-4885-a288-976d266ad911",
                                                "sense_id": "6c506b66-b22b-35ae-ba00-1bc2fd32f4b5",
                                                "text": "They feigned her signature on the cheque."
                                            },
                                            {
                                                "example_id": "e4d2423f-94b7-4c2f-884b-526d19ed37b6",
                                                "sense_id": "6c506b66-b22b-35ae-ba00-1bc2fd32f4b5",
                                                "text": "[T]he truest poetry is the most\nfeigning, and lovers are given to poetry, and what\nthey swear in poetry may be said as lovers they do\nfeign."
                                            },
                                            {
                                                "example_id": "e65e10e5-abd8-4669-8361-dc1552977b64",
                                                "sense_id": "6c506b66-b22b-35ae-ba00-1bc2fd32f4b5",
                                                "text": "She had not been much of a dissembler, until now her loneliness taught her to feign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a0f485-84f2-3bdf-9e92-d7f92283b13c",
                                        "entry_id": "059eed7b-f6bb-3883-aeae-a53686fd3575",
                                        "glosses": [
                                            "To imagine; to invent; to pretend to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15fcc46a-3215-4a9b-bcc9-ec98e2f6b319",
                                                "sense_id": "b9a0f485-84f2-3bdf-9e92-d7f92283b13c",
                                                "text": "He feigned that he had gone home at the appointed time."
                                            },
                                            {
                                                "example_id": "22a49837-6ba7-441c-ad78-f505d16d53d1",
                                                "sense_id": "b9a0f485-84f2-3bdf-9e92-d7f92283b13c",
                                                "text": "Then I sent unto him, saying, There are no such things done as thou sayest, but thou feignest them out of thine own heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30ef6c08-917e-34c5-a2f3-a2d3cbb572c7",
                                        "entry_id": "059eed7b-f6bb-3883-aeae-a53686fd3575",
                                        "glosses": [
                                            "To make an action as if doing one thing, but actually doing another, for example to trick an opponent; to feint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b98d85-90ef-4278-9b18-154a572c5bd1",
                                                "sense_id": "30ef6c08-917e-34c5-a2f3-a2d3cbb572c7",
                                                "text": "Cahill was beaten far too easily for Miller's goal, although the striker deserves the credit for the way he controlled Alan Hutton's right-wing delivery, with his back to goal, feigned to his left then went the other way and pinged a splendid left-foot shot into Hart's bottom right-hand corner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77d473e3-acee-436d-a3f2-64a5097e1af6",
                        "source_entry_id": "c87297db-99df-3e48-a20e-27b62c312e00",
                        "source_sense_description": "притворяться; принимать вид кого-либо с целью обмана",
                        "target_lang_word": "faire semblant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faire semblant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "017f4e63-0e3b-343c-ba44-5a3bc7f26820",
                                        "entry_id": "471ce15c-497c-3ce1-8489-aa6ed1ff4815",
                                        "glosses": [
                                            "Feindre ; simuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51dee764-606b-4af6-9785-e678ed058367",
                                                "sense_id": "017f4e63-0e3b-343c-ba44-5a3bc7f26820",
                                                "text": "Milady regardait par la fenêtre, et fit semblant de ne pas entendre la porte qui s’ouvrait."
                                            },
                                            {
                                                "example_id": "7636050b-b52b-40db-bf72-ade93416074f",
                                                "sense_id": "017f4e63-0e3b-343c-ba44-5a3bc7f26820",
                                                "text": "On a souvent vu des vivants faire semblant d'être morts. Mais jamais des morts faire semblant d'être vivants."
                                            },
                                            {
                                                "example_id": "21295a3f-c1d0-4772-bff1-0a87fd96607a",
                                                "sense_id": "017f4e63-0e3b-343c-ba44-5a3bc7f26820",
                                                "text": "Après tout, les échecs se ramènent à des problèmes de crédit, et Malraux savait ce qu'il disait en annonçant (en 1963) que s’il n’obtenait pas une augmentation de 400% du budget de la musique, « on fera ce qu'on a beaucoup fait : on fera semblant »."
                                            },
                                            {
                                                "example_id": "26d7c0e6-e4ee-4db3-b319-85a3cd9ab750",
                                                "sense_id": "017f4e63-0e3b-343c-ba44-5a3bc7f26820",
                                                "text": "Dubois et Daubenton menèrent rondement cette intrigue matrimoniale, faisant en sorte que l'idée parût venir de Philippe V qui la proposa en septembre 1721 au Régent. Celui-ci fit semblant d'être agréablement surpris."
                                            },
                                            {
                                                "example_id": "978487a8-5e4c-463e-97ac-78dd32b2abdc",
                                                "sense_id": "017f4e63-0e3b-343c-ba44-5a3bc7f26820",
                                                "text": "– Je vais juste faire semblant, rassure-toi… concéda-t-il, avant de rajouter : Mais je te conseille de jouer le jeu à fond !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e211e7c0-a526-45f9-98e7-0f3f8e16f143",
                        "source_entry_id": "c87297db-99df-3e48-a20e-27b62c312e00",
                        "source_sense_description": "притворяться; принимать вид кого-либо с целью обмана",
                        "target_lang_word": "feindre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5aecc65-4a09-393c-8930-d1cfd4f304a0",
                                        "entry_id": "af5d4041-a194-3ddd-8583-a90d1e103d4b",
                                        "glosses": [
                                            "Présenter une chose comme réelle en lui donnant une fausse apparence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f16b0794-0d72-42a2-a338-c1592267fd59",
                                                "sense_id": "b5aecc65-4a09-393c-8930-d1cfd4f304a0",
                                                "text": "En effet, Lequeu, bien qu’il feignît de s’isoler dans sa lecture, était secoué de sursauts violents."
                                            },
                                            {
                                                "example_id": "b3a3e715-f78e-4efb-9b72-e048a5fa6905",
                                                "sense_id": "b5aecc65-4a09-393c-8930-d1cfd4f304a0",
                                                "text": "Les uns et les autres ne discernaient pas ou feignaient de ne pas discerner l'idée-maîtresse de Waldeck-Rousseau."
                                            },
                                            {
                                                "example_id": "2afbf7aa-be07-4a26-bee3-3ea1e1919ca1",
                                                "sense_id": "b5aecc65-4a09-393c-8930-d1cfd4f304a0",
                                                "text": "L’injurieur peut pousser encore plus loin l’outrage en feignant de s'adresser uniquement à ce témoin pour injurier l'autre à la troisième personne, considérant l’injurié comme absent et cherchant à lui enlever ainsi toute possibilité de répliquer."
                                            },
                                            {
                                                "example_id": "14866f02-1c7a-4196-b669-e6b816be4f9a",
                                                "sense_id": "b5aecc65-4a09-393c-8930-d1cfd4f304a0",
                                                "text": "Les scandales se répètent, les politiques, chaque fois, feignent de tomber des nues, ingénus comme Adam."
                                            },
                                            {
                                                "example_id": "44d5c339-b3be-4b37-ab30-4b337d6c38ed",
                                                "sense_id": "b5aecc65-4a09-393c-8930-d1cfd4f304a0",
                                                "text": "On sait ce que signifie \"je m'excuse\". On sait que cela ne signifie pas \"j'excuse moi\". On sait que dans cette expression, le pronom \"m'\" n'est pas employé comme COD. Pourquoi feint-on de croire que c'est un COD ? C'est quoi cette histoire cousue de fil blanc?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9f1e502-30f9-35fa-ac81-6b5cd9cd8b62",
                                        "entry_id": "af5d4041-a194-3ddd-8583-a90d1e103d4b",
                                        "glosses": [
                                            "Montrer à autrui ce qu’on ne pense ni ne ressent vraiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f6b30b-ccc4-44a0-ae67-1ed5838d8302",
                                                "sense_id": "e9f1e502-30f9-35fa-ac81-6b5cd9cd8b62",
                                                "text": "Savoir feindre."
                                            },
                                            {
                                                "example_id": "127fe8b5-742d-4109-a330-4e4ec8dfb154",
                                                "sense_id": "e9f1e502-30f9-35fa-ac81-6b5cd9cd8b62",
                                                "text": "Avoir l’art de feindre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
