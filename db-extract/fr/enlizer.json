                        "examples": [
                            {
                                "example_id": "f1f028fc-7a17-437e-bb2a-f5b3368cd3d6",
                                "sense_id": "a6980448-fcb1-36b4-a224-7dd01d450157",
                                "text": "La vase enlize le bruit aussi bien qu’elle enlize un homme, et la foudre même, quand elle s’y égare, devient presque aphone, a l’air de tousser."
                            },
                            {
                                "example_id": "50a26763-a286-4f3c-b238-d503fbcd8293",
                                "sense_id": "a6980448-fcb1-36b4-a224-7dd01d450157",
                                "text": "La navigation était dure dans ce ruisseau ; il fallait franchir des bancs de sable où la barque s’enlizait."
                            }
                        ]
                    }
