        "fr-extract.jsonl": [
            {
                "entry_id": "b81d6791-cd70-3993-a636-ea00d96808a0",
                "word": "bisaïeul",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "03deee77-1fb5-48f1-87bb-b686b4d391dd",
                        "entry_id": "b81d6791-cd70-3993-a636-ea00d96808a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "bisaïeuls"
                    },
                    {
                        "form_id": "b199817c-02dd-4ac1-8b0a-0d767ec749b3",
                        "entry_id": "b81d6791-cd70-3993-a636-ea00d96808a0",
                        "tags": [
                            "singular"
                        ],
                        "form": "bisaïeux"
                    },
                    {
                        "form_id": "b2e4bd68-424f-42e0-83ac-05ccee7c87d2",
                        "entry_id": "b81d6791-cd70-3993-a636-ea00d96808a0",
                        "tags": [
                            "feminine"
                        ],
                        "form": "bisaïeule"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70c7940e-01ce-3639-a833-6b71a8070e31",
                        "entry_id": "b81d6791-cd70-3993-a636-ea00d96808a0",
                        "glosses": [
                            "Arrière-grand-père du côté paternel ou maternel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472d2257-4e6c-42fe-929c-3719e8e8ca1d",
                                "sense_id": "70c7940e-01ce-3639-a833-6b71a8070e31",
                                "text": "Mon père, mon aïeul, mon bisaïeul, mon trisaïeul, mon quadrisaïeul, mon quinquisaïeul ont toujours mangé, comme les rats, à la table d’autrui."
                            },
                            {
                                "example_id": "eeca230e-b92f-4c12-a60e-8da5da694c11",
                                "sense_id": "70c7940e-01ce-3639-a833-6b71a8070e31",
                                "text": "Appius Claudius Cécus qui fit venir à Rome les eaux Claudia. Ce fut en 771 ; mais ce censeur ne fut, ni le bisaïeul, ni même le trisaïeul, mais bien le quinquisaïeul d’Appius, si l’on me passe l’expression."
                            },
                            {
                                "example_id": "ba857b9c-7b87-4ab5-bbf8-cf66d1640ec1",
                                "sense_id": "70c7940e-01ce-3639-a833-6b71a8070e31",
                                "text": "Une partie de cette grande fortune fut dépensée à la cour de France par l’aïeul et le bisaïeul du comte Charles; son père en dissipa le reste, et ne lui laissa que des terres grevées d’obligations et d’hypothèques ; […]."
                            },
                            {
                                "example_id": "d83ea832-3dc1-4cd7-b92b-2c87f77d0aeb",
                                "sense_id": "70c7940e-01ce-3639-a833-6b71a8070e31",
                                "text": "En outre, comme il ne se faisait plus de testaments, il n’y avait plus d’héritages, et les générations nouvelles ne possédaient rien en propre : tous les biens appartenaient de droit aux bisaïeuls et aux trisaïeuls, qui ne pouvaient en jouir."
                            },
                            {
                                "example_id": "a719c894-369c-4ce9-8772-eeb39c9b037b",
                                "sense_id": "70c7940e-01ce-3639-a833-6b71a8070e31",
                                "text": "Les vénérables personnages de la tapisserie gothique, remuée par le vent, se saluèrent l’un l'autre, et mon bisaïeul entra dans la chambre, — mon bisaïeul mort il y aura bientôt quatre-vingts ans !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7dc7f0b-0fac-4ac5-b23b-200e7b2388de",
                        "source_entry_id": "b81d6791-cd70-3993-a636-ea00d96808a0",
                        "source_sense_id": "70c7940e-01ce-3639-a833-6b71a8070e31",
                        "target_lang_word": "Urgroßvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urgroßvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                        "entry_id": "d29bcd32-42bf-3dbc-a2d2-8fb929bd6d79",
                                        "glosses": [
                                            "Vater von Großmutter oder Großvater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a350fb-2c9f-4834-b60e-9a2b1c8d625a",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "Mein Urgroßvater hatte einen Bart."
                                            },
                                            {
                                                "example_id": "889210f2-ad8a-480a-85c6-930dce96d134",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Johnnys Großvater, Urgroßvater, Ururgroßvater und Urururgroßvater, alle waren Schauspieler, nur sein Vater nicht.“"
                                            },
                                            {
                                                "example_id": "d063bd58-e4c4-431b-80c7-96ceeb4c0b71",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Dort saß schon Urgroßvater Jacob, der zweite Mann von Horsts Urgroßmutter mütterlicherseits, mit seiner Machorka-Pfeife.“"
                                            },
                                            {
                                                "example_id": "c474a9b4-167d-4545-9fe1-bb9d4501552f",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Er servierte Kartoffeln dazu und meinte, sich zu erinnern, dass sein Urgroßvater einmal gesagt hatte, in Kartoffeln verberge sich das Licht gefallener Sterne.“"
                                            },
                                            {
                                                "example_id": "9e2810c3-0979-4235-aa92-c4d2ac60cbe7",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Ihr Urgroßvater kam um 1910 in die damalige Kolonie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
