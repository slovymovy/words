    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0caa772d-b322-3307-a226-6e9f563c94c0",
                    "sense_definition": "The act of describing, depicting, or marking boundaries clearly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract requires a clear <w>delineation</w> of each party's responsibilities.",
                            "target_lang_translations": {
                                "pl": "Umowa wymaga wyraźnego <w>rozgraniczenia</w> obowiązków każdej ze stron."
                            }
                        },
                        {
                            "text": "Careful <w>delineation</w> of borders prevented disputes between the two neighboring towns.",
                            "target_lang_translations": {
                                "pl": "Staranne <w>wyznaczenie</w> granic zapobiegło sporom między dwoma sąsiednimi miastami."
                            }
                        }
                    ],
                    "synonyms": [
                        "demarcation",
                        "depiction"
                    ],
                    "common_phrases": [
                        "clear delineation",
                        "delineation of responsibilities",
                        "delineation of boundaries"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyznaczenie, precyzyjne rozgraniczenie lub określenie granic bądź zakresu obowiązków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozgraniczenie",
                                "target_lang_sense_clarification": "wyznaczenie podziału lub granic"
                            },
                            {
                                "target_lang_word": "wyznaczenie",
                                "target_lang_sense_clarification": "ustalenie granic lub zakresu"
                            },
                            {
                                "target_lang_word": "demarkacja",
                                "target_lang_sense_clarification": "dokładne ustalenie linii granicznej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25caa97e-6f16-3552-9d3d-a39a0595b815",
                    "sense_definition": "A detailed and vivid verbal or written description of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel offers a vivid <w>delineation</w> of life in nineteenth-century London.",
                            "target_lang_translations": {
                                "pl": "Powieść oferuje plastyczne <w>przedstawienie</w> życia w dziewiętnastowiecznym Londynie."
                            }
                        },
                        {
                            "text": "Her accurate <w>delineation</w> of the psychological struggle impressed critics.",
                            "target_lang_translations": {
                                "pl": "Jej trafny <w>opis</w> walki psychologicznej wywarł wrażenie na krytykach."
                            }
                        }
                    ],
                    "synonyms": [
                        "portrayal",
                        "characterization"
                    ],
                    "common_phrases": [
                        "vivid delineation",
                        "detailed delineation"
                    ],
                    "target_lang_definitions": {
                        "pl": "Szczegółowy i plastyczny opis słowny lub pisemny czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przedstawienie",
                                "target_lang_sense_clarification": "opis, zaprezentowanie czegoś"
                            },
                            {
                                "target_lang_word": "opis",
                                "target_lang_sense_clarification": "szczegółowa charakterystyka"
                            },
                            {
                                "target_lang_word": "ukazanie",
                                "target_lang_sense_clarification": "zobrazowanie sytuacji lub zjawiska"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e4aaffd-cbe2-3850-9afd-617988b9a17c",
                    "sense_definition": "A diagram, sketch, or image that traces the outline or form of an object.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect presented a preliminary <w>delineation</w> of the new museum building.",
                            "target_lang_translations": {
                                "pl": "Architekt przedstawił wstępny <w>szkic</w> nowego budynku muzeum."
                            }
                        },
                        {
                            "text": "A precise <w>delineation</w> of the shoreline was mapped out using modern instruments.",
                            "target_lang_translations": {
                                "pl": "Dokładny <w>zarys</w> linii brzegowej został naniesiony na mapę przy użyciu nowoczesnych instrumentów."
                            }
                        }
                    ],
                    "synonyms": [
                        "outline",
                        "sketch",
                        "diagram"
                    ],
                    "common_phrases": [
                        "precise delineation"
                    ],
                    "target_lang_definitions": {
