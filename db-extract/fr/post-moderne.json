                    {
                        "sense_id": "0c9fe145-35aa-3f33-95e3-4a7c35114eda",
                        "entry_id": "7ad75fa5-a256-3f49-a20f-58dcb959a27f",
                        "glosses": [
                            "Relatif au post-modernisme, mouvement artistique qui engage une rupture ironique avec les conventions anhistoriques du modernisme artistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a94cbc7-5853-44a0-babf-24cd892b81c0",
                                "sense_id": "0c9fe145-35aa-3f33-95e3-4a7c35114eda",
                                "text": "L'architecture post-moderne."
                            }
                        ]
                    },
                    {
                        "sense_id": "821c21aa-2338-3825-9b9a-ff84b1b9faa9",
                        "entry_id": "7ad75fa5-a256-3f49-a20f-58dcb959a27f",
                        "glosses": [
                            "Relatif à la post-modernité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517a24ac-2b6c-4c0b-b107-dd5c2e9b5f8a",
                                "sense_id": "821c21aa-2338-3825-9b9a-ff84b1b9faa9",
                                "text": "Un peu d'art et d'élégance dans ce monde numéricoscientifique, post-moderne et pré-robotique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ad99316-f97a-4abd-9232-1f523410e069",
                        "source_entry_id": "7ad75fa5-a256-3f49-a20f-58dcb959a27f",
                        "target_lang_word": "postmodern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postmodern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1772aeb-3708-30ef-b02d-f5ef073bb0d0",
                                        "entry_id": "4628caff-dc23-3eb6-84e9-6f604facb044",
                                        "glosses": [
                                            "Relating to what follows the modern era."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3f00286-4cf2-44ef-aad3-2ad454d2a7f1",
                                                "sense_id": "d1772aeb-3708-30ef-b02d-f5ef073bb0d0",
                                                "text": "The nearer is a fact to the temporary limits of knowledge, the more implicated becomes this regression and the more blurred ought to be statement of fact. [Percy W.] Bridgman of Harvard recently has emphasized this conclusion, but his postmodern position has as yet made small impression."
                                            },
                                            {
                                                "example_id": "5e2810fc-5da0-4ff3-a1a5-1bd3e5cafe2d",
                                                "sense_id": "d1772aeb-3708-30ef-b02d-f5ef073bb0d0",
                                                "text": "A new book by Peter Drucker, author of “The New Society” and “America's Next Twenty Years,” will be published next Wednesday by Harper. In “Landmarks of Tomorrow,” Mr. Drucker discusses the postmodern world and how it differs from the old “modern” world that began with Descartes and the empiricists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6eca2f9-8abb-300e-a10f-701775d9012f",
                                        "entry_id": "4628caff-dc23-3eb6-84e9-6f604facb044",
                                        "glosses": [
                                            "Of, relating to, or having the characteristics of postmodernism, especially as represented in art, architecture, literature, science, or philosophy that reacts against an earlier modernism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bccab22e-2191-4845-a330-636c9b940300",
                                                "sense_id": "d6eca2f9-8abb-300e-a10f-701775d9012f",
                                                "text": "What I am objecting to is that aspect of postmodern thought that rejects the idea of any objective reality."
                                            },
                                            {
                                                "example_id": "243dbfee-685a-4276-bcc8-5029e8f9bc34",
                                                "sense_id": "d6eca2f9-8abb-300e-a10f-701775d9012f",
                                                "text": "For an illustration of the differences between the traditional, positivist curriculum and the more postmodern reconceptualized curriculum, see Hanley and Montgomery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "postmodern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f40fffd7-9638-3144-9998-4f414cf26858",
                                        "entry_id": "0caeba90-7e3d-3f27-9bbd-8d0c5e6ecb1b",
                                        "glosses": [
                                            "A postmodernist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1550c9-84b3-4b2c-8f53-aa537a5ae381",
                                                "sense_id": "f40fffd7-9638-3144-9998-4f414cf26858",
                                                "text": "Trajal Harrell frames his program notes for “Twenty Looks or Paris Is Burning at the Judson Church (S)” with the potentially academic question, “What would have happened in 1963 if someone from the ball scene in Harlem had come downtown to perform alongside the early postmoderns at Judson Church?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
