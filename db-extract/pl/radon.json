                    {
                        "translation_id": "ace689bd-a797-4352-ba90-f5c43ea05c62",
                        "source_entry_id": "f97a3280-ad3a-3d6f-b6e7-2120a760d86c",
                        "source_sense_id": "61be2664-287c-3ecf-b41e-3ebfddc6af64",
