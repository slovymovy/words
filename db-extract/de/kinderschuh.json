                                    {
                                        "sense_id": "235df46c-ab9d-3dc4-96a4-a75864d88107",
                                        "entry_id": "b3d1e9d2-7a06-3d14-b54e-eb9d21f7390e",
                                        "glosses": [
                                            "kleine schoenen geschikt voor kinderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e107945d-96d8-4126-a75f-78b6906216ef",
                                                "sense_id": "235df46c-ab9d-3dc4-96a4-a75864d88107",
                                                "text": "Een kinderschoen is gauw gevuld. Met wat pepernoten en een mandarijntje kom je bij maat 34 al een heel eind."
                                            },
                                            {
                                                "example_id": "10577d25-d7cb-4ebc-8989-868a5e4d3525",
                                                "sense_id": "235df46c-ab9d-3dc4-96a4-a75864d88107",
                                                "text": "Zwart was hij door het roet van de hel. En natuurlijk moest hij zich door de schoorsteen ( de oudste offerplaats èn de verbinding van de geestenwereld met die der mensen ) laten zakken, om de cadeautjes bij de kinderschoenen te leggen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
