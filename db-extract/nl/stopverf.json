                    {
                        "sense_id": "e69c7160-d258-301e-8933-fd3b8d98f0a2",
                        "entry_id": "46a7ddf0-4b40-3fa0-b113-2be24d26aa56",
                        "glosses": [
                            "een deeg van krijt, loodwit en lijnolie dat gebruikt wordt voor het dichten van gaten of scheuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0fc15f7-57e8-409d-be8f-ada42fa24d1f",
                                "sense_id": "e69c7160-d258-301e-8933-fd3b8d98f0a2",
                                "text": "Hij gebruikte stopverf om het gat in het hout te dichten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54887bf2-9f5f-43d1-a325-d2c79c9267f8",
                        "source_entry_id": "46a7ddf0-4b40-3fa0-b113-2be24d26aa56",
                        "source_sense_id": "e69c7160-d258-301e-8933-fd3b8d98f0a2",
                        "target_lang_word": "Kitt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kitt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca69dcd8-20ab-377a-9523-a982469975f9",
                                        "entry_id": "3815f7dc-6e4a-3448-a9d0-286a92effec0",
                                        "glosses": [
                                            "plastische Masse zum Kleben und Abdichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee350b7-07ae-476f-8b07-3bcd03c63bc9",
                                                "sense_id": "ca69dcd8-20ab-377a-9523-a982469975f9",
                                                "text": "„Alter versprödeter Kitt lässt sich am schonendsten durch kurze Bestrahlung mit kurzwelligen Infrarotstrahlen erweichen und dann leicht ausschaben.“"
                                            },
                                            {
                                                "example_id": "00c40ca7-5dcf-41c3-8f0b-84ee14628e3b",
                                                "sense_id": "ca69dcd8-20ab-377a-9523-a982469975f9",
                                                "text": "„Wohl klafften ihre Zielvorstellungen auseinander, die Entzweiung mochte sich untergründig auch schon anbahnen, doch fürs Erste hielt der Kitt der Gemeinsamkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5fc3e02-6dfa-3a06-b41c-62cdfc658cef",
                                        "entry_id": "3815f7dc-6e4a-3448-a9d0-286a92effec0",
                                        "glosses": [
                                            "etwas, das zwei oder mehrere Personen/Gruppen/Objekte zusammenhält, verbindet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76fb5d0f-2aef-4a8f-ada4-2ad36e006ce9",
                                                "sense_id": "d5fc3e02-6dfa-3a06-b41c-62cdfc658cef",
                                                "text": "„Ein guter Kitt unserer Freundschaft war auch das Übereinkommen, daß wir uns gegenseitig bei den Schularbeiten halfen: Ich diktierte ihm die deutschen Aufsätze und er machte meine mathematischen Aufgaben, denn der Mathematik stand ich geradezu hilflos gegenüber.“"
                                            },
                                            {
                                                "example_id": "1c19dbd5-a98e-48ec-8ed5-ed97658b44a5",
                                                "sense_id": "d5fc3e02-6dfa-3a06-b41c-62cdfc658cef",
                                                "text": "„Es gibt einen Kitt, der uns doppelt bindet. Nicht nur den, daß wir den gleichen Rock des Königs tragen, sondern daß wir in diesem Rock miteinander im Feuer gestanden haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
