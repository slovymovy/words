    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e975b1c5-1040-3d67-ba8d-2e40f5690261",
                "word": "catnap",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "807db31d-9967-484b-a11e-5ff734ecdcf6",
                        "entry_id": "e975b1c5-1040-3d67-ba8d-2e40f5690261",
                        "tags": [
                            "plural"
                        ],
                        "form": "catnaps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffaaaaf9-98ab-3e53-b25d-08da6f637b5f",
                        "entry_id": "e975b1c5-1040-3d67-ba8d-2e40f5690261",
                        "glosses": [
                            "A brief, light sleep, usually during the daytime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4257453e-d487-4efb-8527-0902fb0bc078",
                                "sense_id": "ffaaaaf9-98ab-3e53-b25d-08da6f637b5f",
                                "text": "Besides, I reflected, Joe might easily have become a catnapper, as so many millions of other Americans had become since Sarah Perkins, during the campaign, had made it so widely known that although the incumbent President slept in a bed with the covers over him for three and sometimes four hours a night, she herself never slept at all except for the catnaps."
                            },
                            {
                                "example_id": "46a44c7a-077f-48db-a9f2-0f0e44ee582e",
                                "sense_id": "ffaaaaf9-98ab-3e53-b25d-08da6f637b5f",
                                "text": "A toddler who is still having two day sleeps will generally have one good sleep and one catnap, and a toddler who is around three years of age and getting close to dropping her day sleep will catnap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e93b950f-f640-49b8-9f7f-077a9a97776c",
                        "source_entry_id": "e975b1c5-1040-3d67-ba8d-2e40f5690261",
                        "source_sense_id": "ffaaaaf9-98ab-3e53-b25d-08da6f637b5f",
                        "source_sense_description": "a brief, light sleep",
                        "target_lang_word": "Nickerchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nickerchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42f36e1f-20be-3b40-8f75-34d3d11a0852",
                                        "entry_id": "118a61b9-7840-32b3-acf4-422f11855cc6",
                                        "glosses": [
                                            "kurzer Schlaf während des Tages"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6e4cdb-fc07-4a49-a613-a439732ca30b",
                                                "sense_id": "42f36e1f-20be-3b40-8f75-34d3d11a0852",
                                                "text": "„Während einer Präsentation vor Japanern habe ich deren traditionelles kurzes Nickerchen durch einen demonstrativen Schlag auf den Tisch – á la Haydns Paukenschlag – abrupt unterbrochen (tödlicher Fauxpas).“"
                                            },
                                            {
                                                "example_id": "2ee39008-b8bf-4008-ab27-9ad99c049bfe",
                                                "sense_id": "42f36e1f-20be-3b40-8f75-34d3d11a0852",
                                                "text": "„Für das verdiente Nickerchen nach getaner Arbeit standen anschließend zumindest Frauen und älteren Arbeitern Ruhehallen zur Verfügung.“"
                                            },
                                            {
                                                "example_id": "ae7ebb21-218d-4dd7-a92a-66d258697b4e",
                                                "sense_id": "42f36e1f-20be-3b40-8f75-34d3d11a0852",
                                                "text": "„Das wusste ich auch nur, weil ich einen Blick durch eine kaputte Tür werfen konnte und sah, wie die Arbeiter inmitten von Werkzeugen und ausgetretenen Lederstiefeln ein Nickerchen machten.“"
                                            },
                                            {
                                                "example_id": "c31feb89-7a15-42dc-9a38-d6c3a2ac8f19",
                                                "sense_id": "42f36e1f-20be-3b40-8f75-34d3d11a0852",
                                                "text": "„Wie lange mein Nickerchen dauerte oder was in der Zwischenzeit geschah, kann ich nicht sagen.“"
                                            },
                                            {
                                                "example_id": "2321d5f0-76d5-4825-9bcc-cf3412ff1ca4",
                                                "sense_id": "42f36e1f-20be-3b40-8f75-34d3d11a0852",
                                                "text": "„Ein Nickerchen im Büro, dafür herrscht wenig Verständnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
