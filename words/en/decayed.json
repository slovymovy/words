{
    "word_family": [
        "decay"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "29b81189-4084-359c-a633-dd7d13e49a4f",
                    "sense_definition": "Having undergone decay or become rotten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decomposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>decayed</w> wood of the old fence collapsed during the heavy storm.",
                            "target_lang_translations": {
                                "nl": "Het <w>verrotte</w> hout van het oude hek begaf het tijdens de zware storm."
                            }
                        },
                        {
                            "text": "Scientists examined the <w>decayed</w> leaves on the forest floor to study soil health.",
                            "target_lang_translations": {
                                "nl": "Wetenschappers onderzochten de <w>vergane</w> bladeren op de bosbodem om de gezondheid van de bodem te bestuderen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotten"
                    ],
                    "antonyms": [
                        "fresh"
                    ],
                    "common_phrases": [
                        "decayed wood",
                        "decayed matter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Aangetast door ontbinding of verrot."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verrot",
                                "target_lang_sense_clarification": "biologisch ontbonden of bedorven"
                            },
                            {
                                "target_lang_word": "vergaan",
                                "target_lang_sense_clarification": "door ouderdom of natuurlijk proces uiteengevallen"
                            },
                            {
                                "target_lang_word": "aangetast",
                                "target_lang_sense_clarification": "beschadigd door rot of verval, bijv. tanden of hout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23ff1b8e-3c72-3d57-90ce-739cad424498",
                    "sense_definition": "Reduced in social status or having lost one's former fortune.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He came from a <w>decayed</w> noble family that had lost all its lands.",
                            "target_lang_translations": {
                                "nl": "Hij kwam uit een <w>in verval geraakte</w> adellijke familie die al haar landerijen was kwijtgeraakt."
                            }
                        },
                        {
                            "text": "The aristocrat struggled to maintain his dignity despite his <w>decayed</w> financial circumstances.",
                            "target_lang_translations": {
                                "nl": "De aristocraat deed zijn best zijn waardigheid te behouden ondanks zijn <w>verarmde</w> financiële omstandigheden."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "In maatschappelijke status gedaald of vroegere rijkdom kwijtgeraakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verarmd",
                                "target_lang_sense_clarification": "financieel achteruitgegaan"
                            },
                            {
                                "target_lang_word": "in verval geraakt",
                                "target_lang_sense_clarification": "vroegere status of rijkdom verloren"
                            },
                            {
                                "target_lang_word": "vergane",
                                "target_lang_sense_clarification": "met betrekking tot vergane glorie of adel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b735b97a-69be-354e-a8ce-11a97eec0ed4",
                    "sense_definition": "Simple past and past participle of <w>decay</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decomposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fruit had <w>decayed</w> quickly because it was left in the sun.",
                            "target_lang_translations": {
                                "nl": "Het fruit was snel <w>bedorven</w> omdat het in de zon was blijven liggen."
                            }
                        },
                        {
                            "text": "The old bridge <w>decayed</w> over many years of neglect.",
                            "target_lang_translations": {
                                "nl": "De oude brug <w>verviel</w> gedurende vele jaren van verwaarlozing."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van ontbinden of vergaan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verging",
                                "target_lang_sense_clarification": "verleden tijd van vergaan"
                            },
                            {
                                "target_lang_word": "vergaan",
                                "target_lang_sense_clarification": "voltooid deelwoord van vergaan"
                            },
                            {
                                "target_lang_word": "rotte weg",
                                "target_lang_sense_clarification": "verleden tijd van wegrotten"
                            },
                            {
                                "target_lang_word": "weggerot",
                                "target_lang_sense_clarification": "voltooid deelwoord van wegrotten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}