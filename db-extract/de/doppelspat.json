                ],
                "senses": [
                    {
                        "sense_id": "dec41655-aaa3-3e95-9e39-d97a5bc70434",
                        "entry_id": "3436fdf5-5cc8-3ebd-b840-07d7cfda315d",
                        "glosses": [
                            "ein doppelbrechendes Mineral"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ba6540-e979-4ba6-895b-8a24dbef0de1",
                                "sense_id": "dec41655-aaa3-3e95-9e39-d97a5bc70434",
                                "text": "„Als in das künstliche Carbonatpulver Aragonit und Doppelspat eingebracht wurden, war der Argonit [sic!] völlig zerfallen und zersetzt, während der Doppelspat teilweise in ein festes körniges Aggregat umgewandelt worden war.“"
                            },
                            {
                                "example_id": "8060dadd-c068-4d30-9e03-514839bc6b03",
                                "sense_id": "dec41655-aaa3-3e95-9e39-d97a5bc70434",
                                "text": "„Diese Eigenschaft kann man nicht so einfach erkennen wie bei den als Doppelspat bekannten Kalkspatkristallen.“"
                            },
                            {
                                "example_id": "158bced0-4a54-4ae2-9c83-1d7d62f6b865",
                                "sense_id": "dec41655-aaa3-3e95-9e39-d97a5bc70434",
                                "text": "„In den Basaltgesteinen Islands jedoch findet man einen Calcit, dessen Doppelbrechung zu den stärksten aller Minerale zählt: den Island- oder Doppelspat.“"
                            },
                            {
                                "example_id": "098d48d2-0980-4c2c-8a46-d70475dd794c",
                                "sense_id": "dec41655-aaa3-3e95-9e39-d97a5bc70434",
                                "text": "„Daß diese Eigenschaft keineswegs dem Doppelspate ausschlieslich zukomme, und überhaupt nicht von der Beschaffenheit des Stofs abhänge, beweisen alle hinreichend durchsichtige Drusen und geschliffene Gläser […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
