                "senses": [
                    {
                        "sense_id": "f5fa2c67-9acd-320e-a01d-604030108e45",
                        "entry_id": "94dc65d7-9396-3e48-8633-d0e9168cf01e",
                        "glosses": [
                            "Extrêmement puissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b579d35e-3aaa-4c1d-9880-29d16fbbb2e2",
                                "sense_id": "f5fa2c67-9acd-320e-a01d-604030108e45",
                                "text": "En trois jours, en trois arrivées totalement différentes, le patron du Tour a marqué les esprits : adroit et offensif sur les pavés, surpuissant dans un sprint en côte, ultra-déterminé et impitoyable après les 7 km d’ascension de la Planche."
                            },
                            {
                                "example_id": "ded361c4-9483-4101-b392-10ce2e062c52",
                                "sense_id": "f5fa2c67-9acd-320e-a01d-604030108e45",
                                "text": "Grâce à un doublé surpuissant de Kylian Mbappé, les Bleus se sont offert, dimanche, la Pologne (3-1), ainsi que leur billet pour les quarts de finale du Mondial."
                            },
                            {
                                "example_id": "8f54a2a2-45a5-45b9-a45c-25ac7ef2baec",
                                "sense_id": "f5fa2c67-9acd-320e-a01d-604030108e45",
                                "text": "La bataille pour le maillot rouge s’annonce coriace entre le tenant du titre Evenepoel et les deux stars de la surpuissante Jumbo-Visma, Roglic et Vingegaard"
                            }
                        ]
                    }
