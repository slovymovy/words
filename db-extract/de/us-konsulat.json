                        "entry_id": "d43e146f-7bc7-3ba0-b25b-e661f412135d",
                        "glosses": [
                            "Vertretung der staatlichen Verwaltung der Vereinigten Staaten von Amerika (USA) im Ausland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8757ee1b-5973-4bfd-b9d7-0caaec1df2bd",
                                "sense_id": "b4743b7d-47f9-3975-93e6-21ecca8152c5",
                                "text": "„Das Kennzeichen in der ersten Zeile gab nicht nur Aufschluss über die Geheimhaltungsstufe, sondern auch über die Herkunft der Information. Sie stammte aus dem US-Konsulat in Istanbul.“"
                            },
                            {
                                "example_id": "644f2f58-aa28-479c-bce1-b001fc665810",
                                "sense_id": "b4743b7d-47f9-3975-93e6-21ecca8152c5",
                                "text": "„Wer etwas über ihn weiß, soll sich an die pakistanische Polizei oder das US-Konsulat in Karatschi wenden.“"
                            }
                        ],
