                        "sense_id": "a59a5640-5ce6-3d73-a71d-be21a9d4fbaf",
                        "entry_id": "8c8e2d87-3bb7-3cc5-a189-f7ad75c795f1",
                        "glosses": [
                            "chemische Reaktion; das Oxidieren einzelner Luftbestandteile (Gas)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e8ed9869-6b01-3d89-bb88-f175ed47097a",
                        "entry_id": "8c8e2d87-3bb7-3cc5-a189-f7ad75c795f1",
                        "glosses": [
                            "chemische Reaktion; das Oxidieren von etwas durch Luft (Stoff)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d8a702-42f6-4d32-b421-4159933fdace",
                                "sense_id": "e8ed9869-6b01-3d89-bb88-f175ed47097a",
                                "text": "„Die Carbonsäuren können aus nachwachsenden Rohstoffen gewonnen werden oder über Luftoxidation von Alkoholen oder Alkylarenen. “"
                            },
                            {
                                "example_id": "cb59d21f-cc4b-4ad0-902f-e8f29c19357e",
                                "sense_id": "e8ed9869-6b01-3d89-bb88-f175ed47097a",
                                "text": "„Der Einfluss der Luftoxidation geht nur wenig ein, da ein solcher Versuch in weniger als zwei Stunden durch war.“"
                            },
                            {
                                "example_id": "78a6e32b-63fa-4050-9652-0bf761daf49a",
                                "sense_id": "e8ed9869-6b01-3d89-bb88-f175ed47097a",
                                "text": "„Die synthetisierten iminosemichinonhaltigen Verbindungen wurden als Katalysator für die Luftoxidation von Substraten wie o-Aminophenol, Aminen und Alkoholen benutzt, um die katalytischen Reaktionen von kupferhaltigen Metalloenzymen, z.B. Phenoxazinon-Synthase (PHs), Amin-Oxidasen (AO) und Galactose-Oxidase (GO), im Labor nachzuahmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
