                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A rotatable fastening (turnbuckle) on a door or window.",
                        "ru": "Поворотный запор на двери или окне.",
                        "fr": "Fermeture pivotante (tourniquet) sur une porte ou une fenêtre."
