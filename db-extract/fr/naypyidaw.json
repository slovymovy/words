                        "examples": [
                            {
                                "example_id": "182a6d8c-074c-42a7-bf6e-800d5a052a5d",
                                "sense_id": "4346ad05-0247-3ceb-b41b-d4f6298650c9",
                                "text": "C’est la première fois qu’un dirigeant de Naypyidaw confirme publiquement la retraite de Than Shwe."
                            },
                            {
                                "example_id": "3954c38f-f0f0-4b75-88f8-17ee733c10b7",
                                "sense_id": "4346ad05-0247-3ceb-b41b-d4f6298650c9",
                                "text": "Quoi qu’il en soit, la junte militaire birmane au pouvoir décrète le 7 novembre 2005 que la capitale du pays n’est plus l’historique Rangoun, mais Naypyidaw. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, pages 172-173)"
                            },
                            {
                                "example_id": "3365d755-30fe-4aa4-8ee9-97105d9f5fc0",
                                "sense_id": "4346ad05-0247-3ceb-b41b-d4f6298650c9",
                                "text": "La police a fait usage de canons à eau à Naypyidaw, la capitale, contre des manifestants."
                            }
                        ]
                    }
