            {
                "entry_id": "e1b9342a-b733-3bea-b8e5-90c3e1c5806a",
                "word": "Meg",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5a49afb6-fe6d-4ba3-9779-ce7a761326b1",
                        "entry_id": "e1b9342a-b733-3bea-b8e5-90c3e1c5806a",
                        "tags": [
                            "plural"
                        ],
                        "form": "Megs"
