                "translations": [
                    {
                        "translation_id": "0048d7ec-a010-4590-af68-f7340c67d5dc",
                        "source_entry_id": "b28c119e-726d-3aa2-93d7-ee0e9f6fda6b",
                        "source_sense_id": "d11c1a4b-6b49-3216-ab39-5360ce472834",
                        "target_lang_word": "incandescent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incandescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6566b9f2-a3c0-3c63-9644-717af2b7c251",
                                        "entry_id": "4f35330a-5b4a-3392-97d7-f08c37c728ad",
                                        "glosses": [
                                            "Emitting light as a result of being heated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b59b442-2056-4fbd-a1f4-bbfd1ad9d71a",
                                                "sense_id": "6566b9f2-a3c0-3c63-9644-717af2b7c251",
                                                "text": "We will all go together when we go / All suffused with an incandescent glow"
                                            },
                                            {
                                                "example_id": "f98e542f-5ecd-4ac2-98d2-3170abaadfa5",
                                                "sense_id": "6566b9f2-a3c0-3c63-9644-717af2b7c251",
                                                "text": "Rather than burning out as incandescent bulbs do, L.E.D.’s light output dims over tens of thousands of hours. L.E.D.’s are also more resistant to vibration than incandescents or screw-in fluorescent bulbs, and do not flicker or hum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea8779a-8463-33b3-aa6a-c23c3cd596cd",
                                        "entry_id": "4f35330a-5b4a-3392-97d7-f08c37c728ad",
                                        "glosses": [
                                            "Shining very brightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3e9724b-21de-4824-9f14-62c9fa451532",
                                                "sense_id": "7ea8779a-8463-33b3-aa6a-c23c3cd596cd",
                                                "text": "Those multitoned buttes and mesas [of the Grand Canyon], and that incandescent sequence of colorful bands that make one of the natural wonders of the world so grand, can also be found over 100 million miles away [on Mars]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e9ba41-f269-3d2c-8914-f928781546de",
                                        "entry_id": "4f35330a-5b4a-3392-97d7-f08c37c728ad",
                                        "glosses": [
                                            "Showing intense emotion, as of a performance, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a00578b-8730-4db0-8264-909df1ab63d5",
                                                "sense_id": "94e9ba41-f269-3d2c-8914-f928781546de",
                                                "text": "The incandescent performance enraptured the audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fdbf6b3-40ba-3656-a9b4-b50d531ba6fa",
                                        "entry_id": "4f35330a-5b4a-3392-97d7-f08c37c728ad",
                                        "glosses": [
                                            "Extremely angry; furious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a71cab-b8f8-41e7-b638-7d85abe678de",
                                                "sense_id": "0fdbf6b3-40ba-3656-a9b4-b50d531ba6fa",
                                                "text": "She is incandescent with rage because someone stole her wallet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incandescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c57ee67c-066d-3e7c-a446-2c76f2ef39f6",
                                        "entry_id": "b9a3bd5d-cb42-3732-9760-1aac91fbd87b",
                                        "glosses": [
                                            "An incandescent lamp or bulb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d82275-3cb5-4130-a10c-fa110ec11e30",
                                                "sense_id": "c57ee67c-066d-3e7c-a446-2c76f2ef39f6",
                                                "text": "Compact fluorescents are typically rated at 7,500 to 10,000 hours, and incandescents at about 1,500 hours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
