                "senses": [
                    {
                        "sense_id": "2dd105fc-b90d-3c6a-8b37-d6cff8d7a785",
                        "entry_id": "a27a84a4-bd37-3c9a-9b48-f0cb6f807854",
                        "glosses": [
                            "odnoszący się do okresu w kulturze i sztuce brytyjskiej trwającego od wczesnych lat XX w. do wybuchu I wojny światowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f3075b-e2c0-4021-aa33-14bf74162777",
                                "sense_id": "2dd105fc-b90d-3c6a-8b37-d6cff8d7a785",
                                "text": "W willi wuja Johna znajdował się niepowtarzalny kominek edwardiański z 1905 r."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a82b5dd-774f-4735-85da-16a0386daa63",
                        "source_entry_id": "a27a84a4-bd37-3c9a-9b48-f0cb6f807854",
                        "source_sense_id": "2dd105fc-b90d-3c6a-8b37-d6cff8d7a785",
                        "target_lang_word": "Edwardian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edwardian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edbb0302-02bb-3cb6-9c06-453f30c3cc68",
                                        "entry_id": "5bf467eb-f0fd-3624-98ec-e47d0eef19cb",
                                        "glosses": [
                                            "Of the period in British history from circa 1901 to 1910, when Edward VII ruled the British Empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa59c26f-4806-4d7b-96f9-85699d38fb3e",
                                                "sense_id": "edbb0302-02bb-3cb6-9c06-453f30c3cc68",
                                                "text": "If the kind of network we envisage is to be established, it would be unwise to begin any of its services hurriedly with older stock, which, however admirable in its day, now has an air of faded Edwardian splendour that is out of joint with the times."
                                            },
                                            {
                                                "example_id": "841524fa-ad0b-4eda-95ed-6c67094b3842",
                                                "sense_id": "edbb0302-02bb-3cb6-9c06-453f30c3cc68",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra–wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            },
                                            {
                                                "example_id": "3f4760aa-8c19-4251-ac54-abfd185103c1",
                                                "sense_id": "edbb0302-02bb-3cb6-9c06-453f30c3cc68",
                                                "text": "This delightful four-platform station [Bognor Regis] is still controlled by semaphore signals and boasts a lovely red-brick Edwardian building with steel canopies, crowned with a clocktower which dates from 1902."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Edwardian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d78f97f2-3675-312e-97f6-8f6e4de95b47",
                                        "entry_id": "439e0194-e60a-3c01-bb42-e742ac68d8c2",
                                        "glosses": [
                                            "A person from the Edwardian era."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94137cac-7e26-489a-bd4b-3a1f0b66fffe",
                                                "sense_id": "d78f97f2-3675-312e-97f6-8f6e4de95b47",
                                                "text": "So he began, being an Edwardian, by describing accurately and minutely the sort of house Hilda lived in, and the sort of house she saw from the window. House property was the common ground from which the Edwardians found it easy to proceed to intimacy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
