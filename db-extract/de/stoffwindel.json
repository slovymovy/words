                                        "examples": [
                                            {
                                                "example_id": "451ee115-d5b0-4c87-9a29-69a0d9de2210",
                                                "sense_id": "005d4516-62a7-371c-8f5b-f6e42479d5c3",
                                                "text": "Golden Babe Disposable Napkins—unlike the old cloth nappies—are are specially shaped to give the baby freedom to kick and stretch."
                                            },
                                            {
                                                "example_id": "74b0f022-dd0b-4a1b-afb3-a8e679ede862",
                                                "sense_id": "005d4516-62a7-371c-8f5b-f6e42479d5c3",
                                                "text": "Sterilizing powder for soaking nannies; and about two dozen cloth nappy liners or several packets of disposable liners (to throw away after bowel movements or wash when wet only)."
                                            },
                                            {
                                                "example_id": "e318f577-e168-49c2-915c-6bd9a1856f2b",
                                                "sense_id": "005d4516-62a7-371c-8f5b-f6e42479d5c3",
                                                "text": "Fitted cloth nappies resemble disposable nappies in shape and are designed with extra thickness at the position of urination."
                                            }
                                        ]
