                "senses": [
                    {
                        "sense_id": "f5ade164-a7c6-31aa-b36d-f39c2234cb41",
                        "entry_id": "fde84dcb-4221-302b-8899-d5ce7026ff4c",
                        "glosses": [
                            "(о сельскохозяйственных культурах, разводимых в той или иной местности) высеваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "687b32e8-9e44-4e5a-8e87-6e073250e4a8",
                                "sense_id": "f5ade164-a7c6-31aa-b36d-f39c2234cb41",
                                "text": "Здесь сеется рожь. Рис сеется в Китае, Японии, Корее и других странах."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1c60c20-a898-3f06-88b3-d61b5683f648",
                        "entry_id": "fde84dcb-4221-302b-8899-d5ce7026ff4c",
                        "glosses": [
                            "засевать землю для себя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999c35f2-7fb2-4f01-9233-466c6db33565",
                                "sense_id": "b1c60c20-a898-3f06-88b3-d61b5683f648",
                                "text": "Сеетесь? - Уже отсеялись. Когда сеяться будем?"
                            }
                        ]
                    },
                    {
                        "sense_id": "158887fb-5f3e-3022-ad49-a6328a1b8a53",
                        "entry_id": "fde84dcb-4221-302b-8899-d5ce7026ff4c",
                        "glosses": [
                            "то же, что сеять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583f974b-0d0c-494a-b6f4-f0b37113e36c",
                                "sense_id": "158887fb-5f3e-3022-ad49-a6328a1b8a53",
                                "text": "Весь день сеется сухой снежок. С неба сеется мелкий дождик."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9337d49-3b91-33fd-a6a4-fbce5beacfd0",
                        "entry_id": "fde84dcb-4221-302b-8899-d5ce7026ff4c",
                        "glosses": [
                            "(о мелких или сыпучих предметах) сыпаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f3a7dd-ab0b-4232-bfa0-0dcc96a6ba24",
                                "sense_id": "b9337d49-3b91-33fd-a6a4-fbce5beacfd0",
                                "text": "Мука сеется на пол. Пули так и сеются!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9f9fa95e-4076-3240-8bdd-8853383ff235",
                        "entry_id": "fde84dcb-4221-302b-8899-d5ce7026ff4c",
                        "glosses": [
                            "(о рассеянном свете) проникать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5de3c1-29d2-4fc1-920c-605d02acd873",
                                "sense_id": "9f9fa95e-4076-3240-8bdd-8853383ff235",
                                "text": "Сквозь ветви деревьев сеется неяркий солнечный свет."
                            }
                        ]
                    }
                ],
