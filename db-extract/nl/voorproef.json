                                "target_senses": [
                                    {
                                        "sense_id": "17711927-ad04-3a40-a99f-9464e9154f6c",
                                        "entry_id": "998e6efe-d398-386c-93b5-d3661bd365c0",
                                        "glosses": [
                                            "One of the sensations produced by the tongue in response to certain chemicals; the quality of giving this sensation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30b6785d-ad8d-4ca8-a052-1611778e5a19",
                                                "sense_id": "17711927-ad04-3a40-a99f-9464e9154f6c",
                                                "text": "He had a strange taste in his mouth."
                                            },
                                            {
                                                "example_id": "bfef2587-061b-4cd0-b37a-2c3a27e1093d",
                                                "sense_id": "17711927-ad04-3a40-a99f-9464e9154f6c",
                                                "text": "Venison has a strong taste."
                                            },
                                            {
                                                "example_id": "7a96145b-0883-4239-bd83-3edb51b39f45",
                                                "sense_id": "17711927-ad04-3a40-a99f-9464e9154f6c",
                                                "text": "Like smell, taste has been found to imprint our minds with strong memories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a9acab-e87f-3b54-bdfd-bf701f497844",
                                        "entry_id": "998e6efe-d398-386c-93b5-d3661bd365c0",
                                        "glosses": [
                                            "The sense that consists in the perception and interpretation of this sensation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f8ec72-7cff-441e-adbb-90591b998a4b",
                                                "sense_id": "d1a9acab-e87f-3b54-bdfd-bf701f497844",
                                                "text": "His taste was impaired by an illness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe2aa867-266a-3d96-b87e-e2cf96dcf13b",
                                        "entry_id": "998e6efe-d398-386c-93b5-d3661bd365c0",
                                        "glosses": [
                                            "A small sample of food, drink, or recreational drugs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "649e1f78-0f7f-3cbb-9551-815207cd0cc9",
                                        "entry_id": "998e6efe-d398-386c-93b5-d3661bd365c0",
                                        "glosses": [
                                            "A person's implicit set of preferences, especially esthetic, though also culinary, sartorial, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13411f47-761b-489d-b032-0c4220b793c5",
                                                "sense_id": "649e1f78-0f7f-3cbb-9551-815207cd0cc9",
                                                "text": "Dr. Parker has good taste in wine."
                                            },
                                            {
                                                "example_id": "718250ec-bf72-406b-9c0e-0072b33c7777",
                                                "sense_id": "649e1f78-0f7f-3cbb-9551-815207cd0cc9",
                                                "text": "That's very true indeed Sir Peter! after having married you I should never pretend to Taste again I allow."
                                            },
                                            {
                                                "example_id": "29e033c6-1f83-48ce-94f1-75dedfbb1619",
                                                "sense_id": "649e1f78-0f7f-3cbb-9551-815207cd0cc9",
                                                "text": "\"My tastes,\" he said, still smiling, \"incline me to the garishly sunlit side of this planet.\" And, to tease her and arouse her to combat: \"I prefer a farandole to a nocturne; I'd rather have a painting than an etching; Mr. Whistler bores me with his monochromatic mud; I don't like dull colours, dull sounds, dull intellects;[…].\""
                                            },
                                            {
                                                "example_id": "56339e18-f315-4cf0-b2e1-b58dc8834155",
                                                "sense_id": "649e1f78-0f7f-3cbb-9551-815207cd0cc9",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century, when modish taste was just due to go clean out of fashion for the best part of the next hundred years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b4b6734-f7a3-3255-8f7a-78be717dea51",
                                        "entry_id": "998e6efe-d398-386c-93b5-d3661bd365c0",
                                        "glosses": [
                                            "Personal preference; liking; predilection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7717fb1-4a42-4bbe-b077-73c8aafbe131",
                                                "sense_id": "0b4b6734-f7a3-3255-8f7a-78be717dea51",
                                                "text": "I have developed a taste for fine wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1119c1ec-4ff2-374b-b1f1-2c1f10b251c0",
                                        "entry_id": "998e6efe-d398-386c-93b5-d3661bd365c0",
                                        "glosses": [
                                            "A small amount of experience with something that gives a sense of its quality as a whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "569b0e9e-5ad5-4e38-89c9-aee6620e38a0",
                                                "sense_id": "1119c1ec-4ff2-374b-b1f1-2c1f10b251c0",
                                                "text": "Such anecdotes give one a taste of life on a trauma ward."
                                            },
                                            {
                                                "example_id": "551212b4-b378-47ff-ba15-5ab98c364cce",
                                                "sense_id": "1119c1ec-4ff2-374b-b1f1-2c1f10b251c0",
                                                "text": "I'm all out of luck / I'm all out of faith / I would give everything just for one taste / But everything's here, all out of place[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "819624ce-07c0-31f0-94aa-ba31efd56094",
                                        "entry_id": "998e6efe-d398-386c-93b5-d3661bd365c0",
                                        "glosses": [
                                            "A kind of narrow and thin silk ribbon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "taste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0891f1e3-512f-3843-8c6c-7954d8906178",
                                        "entry_id": "898512f4-799d-3195-ba55-6842b615d378",
                                        "glosses": [
                                            "To sample the flavor of something orally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9480f8e3-2874-4bf4-946d-8d4f9cc4ea47",
                                                "sense_id": "0891f1e3-512f-3843-8c6c-7954d8906178",
                                                "text": "when the ruler of the feast had tasted the water that was made wine"
                                            },
                                            {
                                                "example_id": "a842517c-6c29-48d0-84a0-5a5877fcf2bd",
                                                "sense_id": "0891f1e3-512f-3843-8c6c-7954d8906178",
                                                "text": "Does a bagel in New York City really taste better because of the water, or is it our desire to feel like a “real” New Yorker, even for a few minutes over breakfast, that does the trick? […] The idea that a pint of Guinness tastes best in Ireland sounds like it could be a drinker’s romantic notion – but there is science to back up the claim. […] The stats were overwhelmingly in favor of the Guinness tasting better in Ireland – suggesting that the beer doesn’t travel well or perhaps that non-Irish bartenders don’t excel at pouring it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71dc559c-f6fe-3b7e-a500-317fe81b6a2c",
                                        "entry_id": "898512f4-799d-3195-ba55-6842b615d378",
                                        "glosses": [
                                            "To have a taste; to excite a particular sensation by which flavor is distinguished."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae753d8-208b-45e8-9408-a4b5cb9d4dc4",
                                                "sense_id": "71dc559c-f6fe-3b7e-a500-317fe81b6a2c",
                                                "text": "The chicken tasted great, but the milk tasted like garlic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "779fa250-3d79-375b-b61b-038c7f947dc9",
                                        "entry_id": "898512f4-799d-3195-ba55-6842b615d378",
                                        "glosses": [
                                            "To identify (a flavor) by sampling something orally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f75969f-d6e3-4ab6-ac4b-4812e37892ab",
                                                "sense_id": "779fa250-3d79-375b-b61b-038c7f947dc9",
                                                "text": "I can definitely taste the marzipan in this cake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cb26c5a-9b8b-3f2e-86cd-ee425e117d98",
                                        "entry_id": "898512f4-799d-3195-ba55-6842b615d378",
                                        "glosses": [
                                            "To experience."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71f26493-430b-4e94-9c26-9bea5d15ad78",
                                                "sense_id": "4cb26c5a-9b8b-3f2e-86cd-ee425e117d98",
                                                "text": "I tasted in her arms the delights of paradise."
                                            },
                                            {
                                                "example_id": "0ea13565-4d8c-4776-9f1d-3b0309770b71",
                                                "sense_id": "4cb26c5a-9b8b-3f2e-86cd-ee425e117d98",
                                                "text": "They had not yet tasted the sweetness of freedom."
                                            },
                                            {
                                                "example_id": "4cbe499d-e67c-4a32-bc53-4e10ad58524b",
                                                "sense_id": "4cb26c5a-9b8b-3f2e-86cd-ee425e117d98",
                                                "text": "He […] should taste death for every man."
                                            },
                                            {
                                                "example_id": "0da7d47d-3bf9-4117-a773-d81b4f76d514",
                                                "sense_id": "4cb26c5a-9b8b-3f2e-86cd-ee425e117d98",
                                                "text": "Cowards dye many times before their deaths, / The valiant neuer taſte of death but once: […]"
                                            },
                                            {
                                                "example_id": "7d546cf3-8269-4967-9c6d-075b59034703",
                                                "sense_id": "4cb26c5a-9b8b-3f2e-86cd-ee425e117d98",
                                                "text": "Thou […] wilt taste / No pleasure, though in pleasure, solitarie."
                                            },
                                            {
                                                "example_id": "7610454b-400e-48d7-91da-3af5ec8c6185",
                                                "sense_id": "4cb26c5a-9b8b-3f2e-86cd-ee425e117d98",
                                                "text": "Hopefully, Dux and Julie got to taste some of that good money, because after \"No More,\" there was no more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8c6707-9f9d-38b9-898a-d5017876cc03",
                                        "entry_id": "898512f4-799d-3195-ba55-6842b615d378",
                                        "glosses": [
                                            "To take sparingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f89dba02-b470-4c73-9d59-6247267c0aa8",
                                                "sense_id": "fb8c6707-9f9d-38b9-898a-d5017876cc03",
                                                "text": "1699, John Dryden, Epistle to John Drydenhttps://books.google.es/books?id=0fo_AAAAYAAJ&pg=PA147&dq=%22Age+but+tastes+of+pleasures,+youth+devours%22&hl=en&sa=X&ved=2ahUKEwihhoWhjrzqAhV9URUIHYdFCJw4ChDoATAAegQIBBAC#v=onepage&q=%22Age%20but%20tastes%20of%20pleasures%2C%20youth%20devours%22&f=false\nAge but tastes of pleasures, youth devours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e3b17d-d11a-324b-91f5-d92d617ecaf7",
                                        "entry_id": "898512f4-799d-3195-ba55-6842b615d378",
                                        "glosses": [
                                            "To try by eating a little; to eat a small quantity of."
                                        ],
                                        "tags": [],
