{
    "word_family": [
        "rigueur",
        "rigoureux",
        "rigorisme",
        "rigoriste"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cf0ec68f-a7c3-314c-b057-1ebe45ac244d",
                    "sense_definition": "D'une manière stricte, sévère et inflexible, sans admettre d'exception.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est <w>rigoureusement</w> interdit de fumer à l'intérieur de cet établissement public."
                        },
                        {
                            "text": "Les consignes sanitaires doivent être <w>rigoureusement</w> respectées par tout le personnel."
                        }
                    ],
                    "synonyms": [
                        "strictement",
                        "formellement"
                    ],
                    "common_phrases": [
                        "rigoureusement interdit",
                        "rigoureusement appliqué"
                    ]
                },
                {
                    "sense_id": "f5ce854d-908d-3a3c-b938-68d2498236e6",
                    "sense_definition": "Avec une exactitude, une logique ou une précision parfaites et scrupuleuses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques ont vérifié que cette théorie était <w>rigoureusement</w> exacte avant de la publier."
                        },
                        {
                            "text": "Chaque étape du protocole doit être <w>rigoureusement</w> suivie pour garantir des données fiables."
                        }
                    ],
                    "synonyms": [
                        "exactement",
                        "précisément"
                    ],
                    "common_phrases": [
                        "rigoureusement exact",
                        "rigoureusement démontré"
                    ]
                },
                {
                    "sense_id": "af23c4c5-4962-3c2d-867c-14eb0e99d891",
                    "sense_definition": "D'une manière totale et absolue, souvent pour renforcer une négation ou une impossibilité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absolu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous n'avons <w>rigoureusement</w> rien compris à ses explications confuses lors de la réunion."
                        },
                        {
                            "text": "Il est <w>rigoureusement</w> impossible de terminer ce travail complexe avant demain matin."
                        }
                    ],
                    "synonyms": [
                        "absolument",
                        "totalement"
                    ],
                    "common_phrases": [
                        "rigoureusement rien",
                        "rigoureusement impossible"
                    ]
                }
            ]
        }
    ]
}