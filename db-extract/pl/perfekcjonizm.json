                    {
                        "translation_id": "472d9717-6754-48e4-982a-8c8bf07dc988",
                        "source_entry_id": "cfa76522-aaf9-331d-9659-668bcebebfb0",
                        "source_sense_id": "fefaf1e5-abbb-3acd-ac9d-afd6904e477c",
