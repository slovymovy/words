                        "glosses": [
                            "Ski, der beim Abfahrtslauf verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae12659d-1ce8-4fbc-819c-b5644d7c6144",
                                "sense_id": "21d2ea3f-96f5-3ce7-9491-f9f13cfec47c",
                                "text": "„Höflehner hat noch Abfahrtsski in seinem Keller, sie stehen seit 1994 dort, seit er seine Karriere beendet hat.“"
                            },
                            {
                                "example_id": "ea36b017-aa9b-4e7c-b511-53b241033b8f",
                                "sense_id": "21d2ea3f-96f5-3ce7-9491-f9f13cfec47c",
                                "text": "„Sie fährt seit vier Jahren mit dem gleichen Abfahrtsski, dem gleichen Modell, mit dem auch Bode Miller fuhr - Miller und Vonn haben den selben Servicemann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
