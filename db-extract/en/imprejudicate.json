                    {
                        "sense_id": "e9726db5-2bf8-3ef6-8b50-9f391f2ea1eb",
                        "entry_id": "f8126780-9b70-33f3-ac38-8bf91411ec83",
                        "glosses": [
                            "Without prejudice; impartial."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6f7296e3-2e34-4bcb-9fd5-df064ec2c743",
                                "sense_id": "e9726db5-2bf8-3ef6-8b50-9f391f2ea1eb",
                                "text": "Thus in Law both Civil and Divine: that is onely esteemed a legal testimony, which receives comprobation from the mouths of at least two witnesses; and that not only for prevention of calumny, but assurance against mistake; whereas notwithstanding the solid reason of one man, is as sufficient as the clamor of a whole Nation; and with imprejudicate apprehensions begets as firm a belief as the authority or aggregated testimony of many hundreds."
                            },
                            {
                                "example_id": "57b93a4d-c2a0-424d-baa6-ac0028c41052",
                                "sense_id": "e9726db5-2bf8-3ef6-8b50-9f391f2ea1eb",
                                "text": "imprejudicate and uncorrupted persons"
                            }
                        ]
                    }
                ],
