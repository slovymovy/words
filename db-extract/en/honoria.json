                "senses": [
                    {
                        "sense_id": "9ffe77c6-9fa0-37d1-8bc3-577c7bedd8cf",
                        "entry_id": "98ff90c8-4944-3877-860e-70c43c5fb46b",
                        "glosses": [
                            "A female given name from Latin, the Latinized feminine of Honorius."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba65933c-89a4-4839-82d8-b3617040aca6",
                                "sense_id": "9ffe77c6-9fa0-37d1-8bc3-577c7bedd8cf",
                                "text": "She comforted herself however, on the first appearance of her pregnancy, that so odious a surname should be qualified in her children with the genteelest and most elegant Christian names that history or romance could supply. - - - My eldest sister, who came into the world a year after, was called Wilhelmina Charlotta, the second Penthesilea, the third Telethusa, and the fourth Honoria."
                            },
                            {
                                "example_id": "b8a91d46-8bd7-4862-85bf-9f53fcecedd7",
                                "sense_id": "9ffe77c6-9fa0-37d1-8bc3-577c7bedd8cf",
                                "text": "She doesn't like being called after Mother Hubbard, who is an old woman in a baby bonnet, even more than she doesn't like to be called Honoria. \"That name practically ruined mah entire childhood,\" she said once. \"Ah wanted to make darn sure Ah gave mah little girl a name nobody in creation could make fun of.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
