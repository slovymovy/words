                "senses": [
                    {
                        "sense_id": "20ca47b0-b7f3-36a1-947c-56e9a3cfb689",
                        "entry_id": "6bd95922-b90e-3098-a732-6dc8eba24307",
                        "glosses": [
                            "Mâle alpha, animal mâle qui domine une troupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b59c1de-a8a3-45a0-a68d-46e2fb3223f2",
                                "sense_id": "20ca47b0-b7f3-36a1-947c-56e9a3cfb689",
                                "text": "„Alphamann, ich weiß dein Rudel wartet auf dich. Aber Alphamännchen mach nur einmal Männchen für mich.“",
                                "translation": "Mâle alpha, je sais que ta meute t’attend. Mais le mâle alpha fait encore une fois le beau pour moi."
                            },
                            {
                                "example_id": "8b4ae0a4-0862-40df-8551-a4cff2cd6b96",
                                "sense_id": "20ca47b0-b7f3-36a1-947c-56e9a3cfb689",
                                "text": "Das Alphamännchen ist darum bemüht, die Harmonie in der Horde zu erhalten. Wenn sich zwei Schimpansen in die Haare bekommen, geht er dazwischen und trennt die Streitenden.",
                                "translation": "Le mâle alpha s’efforce de faire régner l’harmonie sociale au sein de sa troupe. Quand deux (chimpanzés) se battent, il intervient pour faire cesser la violence."
                            }
                        ]
                    }
