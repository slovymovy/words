                                    {
                                        "sense_id": "c5b5eb15-8692-3a30-9175-a743c96b0db7",
                                        "entry_id": "822d49f9-5a04-3ca0-8b94-ce5abeff7c46",
                                        "glosses": [
                                            "One's clothes, furniture, luggage, or possessions collectively; stuff"
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8433679d-6e41-4404-ac84-ab2782ce1ee8",
                                                "sense_id": "c5b5eb15-8692-3a30-9175-a743c96b0db7",
                                                "text": "Have you brought all your things with you?"
                                            },
                                            {
                                                "example_id": "e331192a-b9eb-437e-b571-8b1b23f2bd2e",
                                                "sense_id": "c5b5eb15-8692-3a30-9175-a743c96b0db7",
                                                "text": "Get your hands off my things!"
                                            },
                                            {
                                                "example_id": "3104d9e9-3bf0-4bea-80aa-d6d8096493ff",
                                                "sense_id": "c5b5eb15-8692-3a30-9175-a743c96b0db7",
                                                "text": "Ole Golly just had indoor things and outdoor things.... She just had yards and yards of tweed which enveloped her like a lot of discarded blankets, which ballooned out when she walked, and which she referred to as her Things. —Louise Fitzhugh, Harriet the Spy (1964)"
                                            }
                                        ]
                                    }
                                ]
                            },
