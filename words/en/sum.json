                                "target_lang_sense_clarification": "钱的数量"
                            },
                            {
                                "target_lang_word": "款项",
                                "target_lang_sense_clarification": "一笔钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2148a616-be7a-383c-a9f5-39e1bb81cf08",
                    "sense_definition": "A quantity obtained by addition or aggregation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "math_total",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sum</w> of two and three is five.",
                            "target_lang_translations": {
                                "ru": "<w>Сумма</w> двух и трех равна пяти.",
                                "zh": "二加三的<w>总和</w>是五。"
                            }
                        },
                        {
                            "text": "The <w>sum</w> total of the bill was higher than expected.",
                            "target_lang_translations": {
                                "ru": "Общая <w>сумма</w> счета оказалась выше ожидаемой.",
                                "zh": "账单的<w>总计</w>比预期的要高。"
                            }
                        }
                    ],
                    "synonyms": [
                        "total",
                        "aggregate",
                        "sum total",
                        "totality"
                    ],
                    "common_phrases": [
                        "the sum of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина, полученная путем сложения или объединения.",
                        "zh": "通过加法或汇总得到的数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумма",
