                "senses": [
                    {
                        "sense_id": "af3c0b25-14bb-3cb6-ad34-4297227bf371",
                        "entry_id": "2f948803-7978-3c6a-86bc-805f6925c945",
                        "glosses": [
                            "The property of being legible or easily readable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c59173aa-fbac-40a5-82bf-78363872a985",
                                "sense_id": "af3c0b25-14bb-3cb6-ad34-4297227bf371",
                                "text": "The legibility of this text is questionable: half the people asked said it was almost illegible, but the other half said it was easy to read."
                            },
                            {
                                "example_id": "62f3bd4b-f9ac-402e-a77b-18447099cfeb",
                                "sense_id": "af3c0b25-14bb-3cb6-ad34-4297227bf371",
                                "text": "The legibility of a type-face is very largely dependent on the absence of similarity between those characters of pairs or triplets which are the most easily mistaken for one another."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f086403-86dc-47eb-bc69-4562c2c295c0",
