                "senses": [
                    {
                        "sense_id": "731b6b17-a992-3d6f-9776-879bab058fb9",
                        "entry_id": "13f48f3d-84b0-3123-9339-64651aebadcf",
                        "glosses": [
                            "Verfahren, bei dem man die Wörter/ Wortgruppen eines Satzes in eine andere Reihenfolge bringt, wobei sich die Bedeutung des Satzes nicht ändern soll. Auf diese Weise kann man feststellen, welche Wörter eines Satzes eng zusammengehören und daher womöglich ein Satzglied bilden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82938b86-f49b-4d63-a751-6e1e039fa6ea",
                                "sense_id": "731b6b17-a992-3d6f-9776-879bab058fb9",
                                "text": "Bei dem Satz „Der kleine Junge ist sehr krank“ kann man mit der Verschiebeprobe den gleichbedeutenden Satz „Sehr krank ist der kleine Junge“ gewinnen und damit sehen, dass der Satz aus den drei Wortgruppen „der kleine Junge“, „ist“ und „sehr krank“ besteht. Weitere Überlegungen zeigen dann, dass es sich dabei um die drei Satzglieder des Satzes handelt."
                            },
                            {
                                "example_id": "956075a8-d0da-41f4-995e-79884e262521",
                                "sense_id": "731b6b17-a992-3d6f-9776-879bab058fb9",
                                "text": "Die Verschiebeprobe ist ein operationales Verfahren der Analyse von Satzgliedern."
                            },
                            {
                                "example_id": "a51abdad-f630-4c19-bd52-8a4844710e95",
                                "sense_id": "731b6b17-a992-3d6f-9776-879bab058fb9",
                                "text": "„Bei der Umstellprobe (Verschiebeprobe) werden Teile eines Satzes in ihrer Reihenfolge verändert..“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
