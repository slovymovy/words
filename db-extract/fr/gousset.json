        "fr-extract.jsonl": [
            {
                "entry_id": "f20185f5-5f07-33da-ac19-0548ed2ad4c4",
                "word": "Gousset",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1084198-7d52-35b7-ad6a-2677f68fcb8a",
                        "entry_id": "f20185f5-5f07-33da-ac19-0548ed2ad4c4",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0d19833-db7e-49a0-b910-28907139b2d1",
                                "sense_id": "c1084198-7d52-35b7-ad6a-2677f68fcb8a",
                                "text": "Explications avec Aurélie Gousset, enseignante-chercheuse en biologie végétale à l’Université Clermont Auvergne."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                "word": "gousset",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f7d5d91-7b11-411b-808e-a8155ff2ed1f",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "tags": [
                            "plural"
                        ],
                        "form": "goussets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a873b0b-b528-3903-9ff6-6cc20354825e",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Petite poche destinée à renfermer de l’argent, des bijoux, une montre, etc., et fixée à la ceinture du pantalon ou plus souvent au gilet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b70f84-f9d5-485d-822b-32a2037c28fd",
                                "sense_id": "7a873b0b-b528-3903-9ff6-6cc20354825e",
                                "text": "À la fin, le secrétaire soupira, se renversa sur son siège, sortit de son gousset un cure-dent et s’en servit pour accompagner sa méditation sur le cas de Bert."
                            },
                            {
                                "example_id": "e19b1a5d-d12e-4677-9230-6f627bcfa45d",
                                "sense_id": "7a873b0b-b528-3903-9ff6-6cc20354825e",
                                "text": "Je sors de la gare et je retrouve, dans mon gousset, encore un florin."
                            },
                            {
                                "example_id": "1cfd46eb-5975-46ba-b4b9-3dc8edf1c328",
                                "sense_id": "7a873b0b-b528-3903-9ff6-6cc20354825e",
                                "text": "Ce mot gousset est douillet, confortable, il suggère déjà un rapport satisfait avec une excroissance abdominale arborée sans vergogne, et caressée sans déplaisir, au moment de s’enquérir de l’heure."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd0764d3-5500-32d8-b444-55eb6be2b561",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Petite console de menuiserie servant à soutenir des tablettes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c01693be-2139-3d1f-8a87-f23d12137ab4",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Dans une structure métallique ou mécano-soudée, pièce mince (tôle) servant à rigidifier une liaison d'angle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "be6af0db-ef82-3cbf-aaa5-51cc2684b9e9",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Petite pièce triangulaire de toile ou de coton, que l’on met à la manche d’une chemise à l’endroit de l’aisselle."
                        ],
                        "tags": [
                            "Lingerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bca97ebf-c3fb-3bbd-80eb-31450fbbd308",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Petite poche située à l’entrejambe des sous-vêtements féminins."
                        ],
                        "tags": [
                            "Lingerie"
                        ],
                        "examples": [
                            {
                                "example_id": "6d56c020-031b-47fd-ad9a-a599cb00aedf",
                                "sense_id": "bca97ebf-c3fb-3bbd-80eb-31450fbbd308",
                                "text": "Le gousset est fabriqué en tissu de coton respirant et aide à protéger tes parties féminines en les gardant au sec et ventilées."
                            }
                        ]
                    },
                    {
                        "sense_id": "07eb5dc4-fa9d-3583-97d3-198a22e8028e",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Odeur spéciale qui vient parfois du creux de l’aisselle."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b59b2ef7-1fb9-458a-be2a-f6bd8a939bff",
                                "sense_id": "07eb5dc4-fa9d-3583-97d3-198a22e8028e",
                                "text": "Sentir le gousset."
                            },
                            {
                                "example_id": "d68ac5fc-3d5e-4dac-a178-781081ad79f3",
                                "sense_id": "07eb5dc4-fa9d-3583-97d3-198a22e8028e",
                                "text": "« Je tiens de mon père, mou, je sens le gousset » attribué à Henri IV"
                            }
                        ]
                    },
                    {
                        "sense_id": "cbdd34af-7a40-3e10-97e4-a45c98336dff",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Ouverture ménagée dans la voûte d’un bateau pour y passer la tête du gouvernail."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f4835d5c-2b07-3112-9e51-d18c4762073e",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Pièce de bois munie de deux tourillons qui entrent dans les barrotins du second pont d’un navire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b7551095-d21e-39cb-becb-728e82f0151d",
                        "entry_id": "483780cc-2695-3a8c-96be-de8ac4b1d455",
                        "glosses": [
                            "Pièce formée pour la partie supérieure par un triangle mouvant du chef, et qui rejoint un pal pour la partie inférieure. Similaire au pairle, si ce n’est que la partie supérieure est pleine."
                        ],
                        "tags": [],
                        "examples": []
                    }
