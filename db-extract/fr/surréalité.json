                                            {
                                                "example_id": "1a36a338-2dfd-4c6b-8ff8-9fad0f620963",
                                                "sense_id": "97094099-633d-31b5-9801-5896c7243c4b",
                                                "text": "The surrealities of life are the paradoxes thereof."
