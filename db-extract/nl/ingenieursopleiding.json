                            {
                                "example_id": "f48bf5e4-324b-4e25-a6a5-e3a100aa93e1",
                                "sense_id": "0907aa7d-bc53-3581-a5c0-a96261a7e232",
                                "text": "Hoe kon de technische staf hier dan zo middelmatig zijn dat zij, die geen ingenieursopleiding en geen echte werkervaring had, zo makkelijk hun werk over kon nemen? Ze kwam de reden gauw genoeg te weten."
                            },
                            {
                                "example_id": "3523a2ae-b35c-4137-b8dc-5fbc02d1605e",
                                "sense_id": "0907aa7d-bc53-3581-a5c0-a96261a7e232",
                                "text": "Een factor van belang was verder dat juist op de ingenieursopleidingen veel docenten (Joden, democraten, communisten) waren ontslagen."
                            },
                            {
                                "example_id": "8350fe3e-4631-4559-9a28-6d49c0cdb51e",
                                "sense_id": "0907aa7d-bc53-3581-a5c0-a96261a7e232",
                                "text": "Hij had zich vervoegd bij de ingenieursopleiding van de Universiteit van Oxford waar de werkplaats voor metaalbewerking beschikt over een indrukwekkend arsenaal van machines voor het frezen, buigen en zagen van metaal."
                            }
                        ]
