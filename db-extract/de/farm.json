                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2d32d43-bcea-4916-8237-ff0bcbebc3fa",
                                                "sense_id": "54ea4f1f-5d89-330a-9cd2-a58fd5286cfa",
                                                "text": "Neden çift tabanca? Çiftliği daha bir gösteriş."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b30540-5001-3099-b343-4f071c688749",
