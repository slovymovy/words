                ],
                "senses": [
                    {
                        "sense_id": "614faab9-0571-36e1-9342-03b988d0b11d",
                        "entry_id": "e9dedc9f-8a51-3efc-a928-3e3ecfbd6684",
                        "glosses": [
                            "Donner un caractère blafard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "338f9060-2e6f-4530-a37c-4ff1ec910201",
                                "sense_id": "614faab9-0571-36e1-9342-03b988d0b11d",
                                "text": "Sinon ça va te blafardiser/griser le teint et ça fera bizarre par rapport à ton cou et tes mains."
                            },
                            {
                                "example_id": "9e997000-d798-4307-bf65-23596a3322c5",
                                "sense_id": "614faab9-0571-36e1-9342-03b988d0b11d",
                                "text": "Dans mon malheur, j'ai été chanceuse : il aurait pu être bleu marine, soit la couleur opposée au mariage pour tous en plus blafardiser mon teint méditerranéen, ou pire que tout, chair, le genre de couleur qui n’en est pas, mais qui jure prodigieusement toute carnation."
                            },
                            {
                                "example_id": "2d16a894-5fbe-4cc2-bf6c-043050e6f42c",
                                "sense_id": "614faab9-0571-36e1-9342-03b988d0b11d",
                                "text": "Quel dommage de rentrer bronzer et devoir se blafardiser lol !"
                            },
                            {
                                "example_id": "92bbcc26-1743-4171-8528-2708e1aab81a",
                                "sense_id": "614faab9-0571-36e1-9342-03b988d0b11d",
                                "text": "C’était du débit de boissons à la française, baies vitrées, comptoir plastique, banquettes façon cuir, fausses lanternes chinoises blafardisant dans le jaune et l’orange."
                            }
                        ]
                    }
                ],
