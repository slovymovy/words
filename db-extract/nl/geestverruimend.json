                        "translation_id": "9ee74036-77f0-4c6b-8357-8473e373f785",
                        "source_entry_id": "793090f3-e943-377d-827a-1c944d8f3d19",
                        "source_sense_id": "3afc047c-ab4e-357f-a7d2-25b287825c09",
                        "source_sense_description": "(farmacologie) van drugs: dat ze een hallucinerende werking hebben",
                        "target_lang_word": "psychedelic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5447a64-0840-301c-8d38-27c657ce3551",
                                        "entry_id": "40156551-27b4-3fe8-8b2b-e588c9da5aa4",
                                        "glosses": [
                                            "Of, containing, generating, or reminiscent of drug-induced hallucinations, distortions of perception, altered awareness, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46754f92-cfde-4f60-a376-51d2aa62054e",
                                                "sense_id": "f5447a64-0840-301c-8d38-27c657ce3551",
                                                "text": "With those drugs has come the psychedelic philosophy, an impassioned belief in the self-revealing, mind-expanding powers of potent weeds and seeds and chemical compounds known to man since prehistory but wholly alien to the rationale of Western society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b20612-f272-3c73-9c93-b1acb4b67276",
                                        "entry_id": "40156551-27b4-3fe8-8b2b-e588c9da5aa4",
                                        "glosses": [
                                            "Having bright colours, abstract shapes, etc. reminiscent of drug-induced hallucinations or distortions of perception."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b68f8ce-e52c-42b6-a36c-a240130c346c",
                                                "sense_id": "03b20612-f272-3c73-9c93-b1acb4b67276",
                                                "text": "There was a woman sitting on the edge of his bed. She had coral-orange hair, beryl-blue eyes, arched brows, freckles, a coy smile, a psychedelic labcoat and she was, he suddenly realized, his best friend of over twenty years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychedelic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a3d6b1-607a-3497-b0c3-9f98c929b4c4",
                                        "entry_id": "c879a83a-e937-39d0-8ab1-c438060e34e2",
                                        "glosses": [
                                            "Any psychoactive substance (such as LSD or psilocybin) which, when consumed, causes perceptual changes (sometimes erratic and uncontrollable), visual hallucination, and altered awareness of the body and mind."
                                        ],
