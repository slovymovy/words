                        "examples": [
                            {
                                "example_id": "257bbc6a-6205-4dd3-9f2b-dc40d26a6dde",
                                "sense_id": "a24d5c71-33a0-3ff0-bcfd-7aab2e58fe45",
                                "text": "‘There is no higher feature this side of the river than your house. You could be the first to notice the Firangi army when it nears Kalinadi.’"
                            },
                            {
                                "example_id": "23af853f-63a4-4b66-b82a-0120652c107e",
                                "sense_id": "a24d5c71-33a0-3ff0-bcfd-7aab2e58fe45",
                                "text": "We watched the Firangi as they struggled through the pass, their hands frozen and fingers unable to load their heavy muskets."
                            }
                        ]
                    }
