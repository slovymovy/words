                        "source_sense_id": "837e1dd9-8ca6-3eb2-9bde-aa735a64d8a4",
                        "target_lang_word": "ichthyosaurus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
