                "senses": [
                    {
                        "sense_id": "6b87867f-6066-3823-a9b8-72bb647363dd",
                        "entry_id": "8ce5870f-ae1f-359f-9f63-dffef5453b56",
                        "glosses": [
                            "kleines Personenschiff für den Linienverkehr im Nahbereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ae11461-b9d6-4a04-b697-00de1d94e17d",
                                "sense_id": "6b87867f-6066-3823-a9b8-72bb647363dd",
                                "text": "„Eine schwarze Rauchpinne verfinstert die Mole, indes mit der gekräuselten Welle das winzige Lokalboot kämpft.“"
                            },
                            {
                                "example_id": "c29d9a51-b56f-4260-85e6-8092c8692064",
                                "sense_id": "6b87867f-6066-3823-a9b8-72bb647363dd",
                                "text": "„Dienten zunächst Schiffsbrücken oder Lokalboote dem Verkehr, so verbesserte die 1885 eröffnete feste Rheinbrücke die Verbindung erheblich.“"
                            },
                            {
                                "example_id": "af7d4136-05e1-4b41-b3ff-8b754a2bf0e3",
                                "sense_id": "6b87867f-6066-3823-a9b8-72bb647363dd",
                                "text": "„Ein anderes Lokalboot, das zwischen Mondorf und Bonn verkehrte und offiziell \"Mondorf\" hieß, wurde im Volksmund \"Gummipanzer\" genannt, weil das Schiff äußerst stabil gebaut und hart im Nehmen war.“"
                            },
                            {
                                "example_id": "0d4107fe-e8c3-4ae9-8230-73e2ebf84038",
                                "sense_id": "6b87867f-6066-3823-a9b8-72bb647363dd",
                                "text": "„Bis dahin verkehrten Lokalboote.“"
                            },
                            {
                                "example_id": "b1c34651-44fe-43f8-8782-d6e1c4ddf6a7",
                                "sense_id": "6b87867f-6066-3823-a9b8-72bb647363dd",
                                "text": "„Parallel zur Kribbe liegen die Lokalboote.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
