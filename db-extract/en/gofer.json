                                                "sense_id": "a4222bc7-f3fe-3c13-93fa-416e7754dac0",
                                                "text": "Odvětví nezaznamenalo pokrok, nýbrž velký poskok."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2315157-f04d-3950-83b1-4ae901389ade",
                                        "entry_id": "68e6ae98-ad18-3bce-96d3-58dd8ae433a5",
