        "de-extract.jsonl": [
            {
                "entry_id": "b91fa860-7729-3ad2-bdc0-482c30c9b2ea",
                "word": "virelangue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "01da6630-0d34-3bab-bdfc-dfb8c1f48791",
                        "entry_id": "b91fa860-7729-3ad2-bdc0-482c30c9b2ea",
                        "glosses": [
                            "bestimmte Wortfolge, deren schnelle, wiederholte Aussprache selbst Muttersprachlern schwerfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8beb21-5bc1-42cd-9095-751f11bd3872",
                                "sense_id": "01da6630-0d34-3bab-bdfc-dfb8c1f48791",
                                "text": "La phrase „Fischers Fritz fischt frische Fische, frische Fische fischt Fischers Fritz.“ est un virelangue.",
                                "translation": "Der Satz „Fischers Fritz fischt frische Fische, frische Fische fischt Fischers Fritz.“ ist ein Zungenbrecher."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c51c2204-d339-4350-a167-43f242982a0c",
                        "source_entry_id": "b91fa860-7729-3ad2-bdc0-482c30c9b2ea",
                        "source_sense_id": "01da6630-0d34-3bab-bdfc-dfb8c1f48791",
                        "source_sense_description": "bestimmte Wortfolge, deren schnelle, wiederholte Aussprache selbst Muttersprachlern schwerfällt",
                        "target_lang_word": "Zungenbrecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zungenbrecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                        "entry_id": "5616fbce-f1c3-3b9a-b950-266bad7e42fd",
                                        "glosses": [
                                            "Wort oder Wortverbindung, welche beim Aussprechen Probleme bereitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919634bf-0e09-4988-ada2-d424aa9b25fa",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "Schaffst du es, diesen Zungenbrecher fehlerfrei auszusprechen?"
                                            },
                                            {
                                                "example_id": "6a8dacc0-114d-47ad-92e5-3ec04b947500",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Im dichten Fichtendickicht sind dicke Fichten wichtig.“ ist ein Zungenbrecher."
                                            },
                                            {
                                                "example_id": "ef43f589-f84b-461a-b666-86d77df0936c",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Wir übten mit viel Vergnügen sogenannte Zungenbrecher im Hochdeutschen und im Regionalsprachlichen.“"
                                            },
                                            {
                                                "example_id": "fe206e1e-554c-4140-9b55-32a053af906d",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "Manche Nachnamen sind für viele Leute richtige Zungenbrecher."
                                            },
                                            {
                                                "example_id": "e403f361-eb3d-4695-8063-fb3ce1ab4765",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Mount Kośćiuszko nennen heute die Australier ihren höchsten Gipfel - und glauben sicher bis heute, daß dieser Zungenbrecher von den Aborigines stammt.“"
                                            },
                                            {
                                                "example_id": "92a16e0a-3876-4497-93e7-858fd7cac02d",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Als Dreijährige wiederholte sie oft Zungenbrecher, die sie faszinierten, wie »Partikulier« und »Binnenschifferseelsorge.«.“"
                                            },
                                            {
                                                "example_id": "3ad11f0b-625f-41ca-9bf3-81dbd818fae5",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„In Paris machte der Zungenbrecher Furore.“"
                                            },
                                            {
                                                "example_id": "367d6c7e-4da1-4418-a4ba-53ab88c16886",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Beim Zungenbrecher lacht man über den, der zuerst einen Fehler macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
