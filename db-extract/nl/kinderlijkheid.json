                                        "examples": [
                                            {
                                                "example_id": "0b0f1825-65b8-43fd-90cb-354b9410ae2a",
                                                "sense_id": "ca31ce5b-5619-3629-8fac-159279be7814",
                                                "text": "On page 297 [“Queens Not Balled Thru Robbers”], that quotation from a foreign bee-paper, about the foolishness of thinking that robber-bees ball a queen, is probably all right in the main. Robbers are indeed there for honey—not for reginacide—but perchance no one interferes, and after awhile the honey is gone, and the hive is filled with a miscellaneous crowd largely new comers, who are like a city mob, “the more part know not wherefore they are come together.”"
                                            }
                                        ]
