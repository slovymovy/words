                        "examples": [
                            {
                                "example_id": "7619e642-4190-4727-b7ae-b487e16f48a9",
                                "sense_id": "deb1fc0e-c92c-30ad-9642-25d8c52789cb",
                                "text": "La mensualisation vous permet d’étaler vos impôts sur l’année. Grâce à elle, pas de risque d’oublier l’échéance."
                            },
                            {
                                "example_id": "b1518fbf-71a1-42a2-ae8d-6fafc22b3c73",
                                "sense_id": "deb1fc0e-c92c-30ad-9642-25d8c52789cb",
                                "text": "Durant l’année, vous aurez payé des acomptes soit pas la mise en place de la mensualisation soit par le biais de tiers provisionnels."
                            }
                        ]
                    }
