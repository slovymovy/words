                "senses": [
                    {
                        "sense_id": "59c224d9-5e86-3a3c-967f-9924e5389651",
                        "entry_id": "a303b9ff-c7d2-3736-a4cb-febf27e5ba0b",
                        "glosses": [
                            "Gebiet, über das jemand herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e145568-9a06-4387-a192-cfb4e0bc1c56",
                                "sense_id": "59c224d9-5e86-3a3c-967f-9924e5389651",
                                "text": "„Der Belgier ist der Urgroßneffe jenes Königs Leopold II., dem das Land 1884/85 im Rahmen internationaler Verträge als persönlicher Herrschaftsbereich zuerkannt worden war (…)“"
                            },
                            {
                                "example_id": "f293a84d-eeb4-4825-a5aa-47dc37c8d2f3",
                                "sense_id": "59c224d9-5e86-3a3c-967f-9924e5389651",
                                "text": "„Er dehnte seinen Herrschaftsbereich von Britannien auf Gallien und Spanien aus, der reguläre Kaiser Gratian wurde wegen Erfolglosigkeit von seinen Soldaten umgebracht.“"
                            },
                            {
                                "example_id": "d2951807-4698-4098-8f2d-e0a89e9f7546",
                                "sense_id": "59c224d9-5e86-3a3c-967f-9924e5389651",
                                "text": "„Nun hat Dänemarks König Frederik X. mit einer nur wenig subtilen Botschaft deutlich gemacht, dass die Arktisinsel in seinen Herrschaftsbereich gehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
