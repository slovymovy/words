                        "sense_id": "f200b402-d0da-3a76-926c-759e27163395",
                        "entry_id": "1a230415-8101-3add-9822-332d07a11714",
                        "glosses": [
                            "Fille intéressée, qui profite de l’argent d’un homme."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "296be2c2-094f-47d7-ac0b-68afbd5ad4a4",
                                "sense_id": "f200b402-d0da-3a76-926c-759e27163395",
                                "text": "Elle veut que tu payes son appart’ car c’est une michto (...)."
                            },
                            {
                                "example_id": "a83ebe03-b60b-43e4-ad5e-f76297defee0",
                                "sense_id": "f200b402-d0da-3a76-926c-759e27163395",
                                "text": "Il y a donc une nuance: une michto dans l’argot des cités est juste une fille intéressée, alors qu’une michetonneuse, dans l’argot traditionnel et le langage policier, est une prostituée."
                            },
                            {
                                "example_id": "0ec92dcb-1581-4aaa-9ffa-eee436cc7ef4",
                                "sense_id": "f200b402-d0da-3a76-926c-759e27163395",
                                "text": "C’est pour ça que si Aria est une meuf bien, je ne la vaux pas ; mais si c’est une michto, je n’en veux pas..."
                            },
                            {
                                "example_id": "067a32f6-bc1d-426c-b9ee-12157ff541a8",
                                "sense_id": "f200b402-d0da-3a76-926c-759e27163395",
                                "text": "J’rends les michtos folles, au microphone"
                            }
                        ]
                    },
