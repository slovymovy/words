                                        "entry_id": "c5c56536-f5b0-3125-9424-d9f2f104dcf0",
                                        "glosses": [
                                            "Composant électronique de petite taille formé de transistors, et chargé d'exécuter des instructions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca81de6-fe91-463d-9893-7fdf3744360a",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "Les microprocesseurs sont de plus en plus petits et de plus en plus puissants."
                                            },
                                            {
                                                "example_id": "cb20ee7d-66f7-4b83-a11e-bffd68998abc",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "Une chaussure de sport dotée d'un microprocesseur."
                                            },
                                            {
                                                "example_id": "5c40376d-3e6a-4e68-a361-8a1ddb574377",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "Au cœur de tout ordinateur bat le microprocesseur."
                                            },
                                            {
                                                "example_id": "6f2391f0-cb45-46e4-a7c1-1bee823350fb",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "La présence d'un microprocesseur conformément à l'article 1ᵉʳ n'est pas une condition de validité d'un permis de conduire. La perte ou l'illisibilité d'un microprocesseur, ou tout autre dommage subi par celui-ci, n'a aucun effet sur la validité du document."
                                            }
                                        ]
