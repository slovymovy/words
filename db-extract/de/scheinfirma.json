                ],
                "senses": [
                    {
                        "sense_id": "30900198-2bd6-3a67-ad6d-165b285ba94c",
                        "entry_id": "d6d42e0a-a7ea-33d5-9ff4-8e634bf1c647",
                        "glosses": [
                            "Firma, die zum Schein geführt wird, um andersartige Aktivitäten zu verbergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3113fb40-bb32-4bcc-9658-c81ee8090663",
                                "sense_id": "30900198-2bd6-3a67-ad6d-165b285ba94c",
                                "text": "„Weil es darauf ankam, dass man nicht erkannte, wem die Maschinen gehörten, wurde eine Scheinfirma mit dem Namen Falcon Aviation gegründet, die sich laut Auftrag mit ganz harmlosen Dingen beschäftigte.“"
                            },
                            {
                                "example_id": "580fbb2d-bcdb-4ae0-b3e9-dcd5d7491c34",
                                "sense_id": "30900198-2bd6-3a67-ad6d-165b285ba94c",
                                "text": "„Innerhalb weniger Minuten waren sämtliche Unterlagen über die Scheinfirma Karpetland nur noch ein Häufchen Asche.“"
                            },
                            {
                                "example_id": "8b340984-aae2-4a9b-aaae-94f9e370f389",
                                "sense_id": "30900198-2bd6-3a67-ad6d-165b285ba94c",
                                "text": "„Maadi Land and Sea Freight war eine Scheinfirma, die der geheimen Verschiebung von Ausrüstung und Material von Ägypten nach Libyen diente.“"
                            },
                            {
                                "example_id": "02e94339-dd69-4975-87bf-0fa2448ba29f",
                                "sense_id": "30900198-2bd6-3a67-ad6d-165b285ba94c",
                                "text": "„Oder nehmen wir einen Fall, wo es sich bei der einen Partei offenkundig um eine Scheinfirma handelte, die vielleicht auf den Caymaninseln oder auf den Niederländischen Antillen registriert war.“"
                            },
                            {
                                "example_id": "ce489b52-fc97-4c9c-a513-7c39f74f0646",
                                "sense_id": "30900198-2bd6-3a67-ad6d-165b285ba94c",
                                "text": "„Eine Scheinfirma hatte kürzlich für die CIA vier alte, gebrauchte und nicht nachverfolgbare De Havilland DHC Twin Otter von einer pleitegegangenen indonesischen Lufttransportfirma aufgekauft und die Flugzeuge dann zwecks Instandsetzung und Umbau in die Staaten verschifft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
