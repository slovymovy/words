                    {
                        "translation_id": "12c6e261-05fb-4002-9f50-617279ad917f",
                        "source_entry_id": "1e293bf3-5161-3f91-a42f-4d05b31edf7a",
                        "source_sense_id": "9a6f0540-235a-3912-b9ab-95a35acb0e3c",
                        "target_lang_word": "epithalamium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epithalamium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0293cf5b-fef3-3068-8c1f-d0e902ed2459",
                                        "entry_id": "f91338b7-d7fe-3785-b4c0-115187c9972a",
                                        "glosses": [
                                            "A song or poem celebrating a marriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108942db-832d-4078-8726-cfb43ab097fc",
                                                "sense_id": "0293cf5b-fef3-3068-8c1f-d0e902ed2459",
                                                "text": "Softly she laughed and sighed, and swift her glances flew. She shook her heavy tresses, and their perfume filled the place; she struck her little sandalled foot upon the floor, and hummed a snatch of some old Greek epithalamium."
                                            },
                                            {
                                                "example_id": "0bf59022-1a4b-4824-afa1-59add0e2c9ca",
                                                "sense_id": "0293cf5b-fef3-3068-8c1f-d0e902ed2459",
                                                "text": "He has wittily redone a tardy epithalamium and some nursery rhymes (\"Three blind eunuchs\"), and deftly catches the cozy lawnfuls of plastic dwarfs and flamingos, outside the kenneled people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f793d4c8-04fb-3d11-afff-3868b9505f0f",
                                        "entry_id": "f91338b7-d7fe-3785-b4c0-115187c9972a",
                                        "glosses": [
                                            "A song in praise of the bride or bridegroom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de95cda-8f9d-4270-84d2-6b215765941d",
                                                "sense_id": "f793d4c8-04fb-3d11-afff-3868b9505f0f",
                                                "text": "The Caves of Ajanta, the medieval Courts of Love, the epithalamia of the erotic poets [...] all testify to the glorification of manhood, the supremacy of the sex motif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
