                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85c8d11-dfde-4efb-baac-6e07b922dcc2",
                                "sense_id": "bdc82633-aef8-3bc1-80f6-4a2d71e2826e",
                                "text": "Die Tierhäute werden zu Pelzen oder Leder verarbeitet."
                            }
