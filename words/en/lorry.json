{
    "word_family": [
        "lorry-driver",
        "lorry-load"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dbd74ab-d3d2-3a50-9bb3-4a96f09bdbcc",
                    "sense_definition": "A large and heavy motor vehicle designed to carry goods or soldiers; a <w>truck</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lorry</w> was carrying a heavy load of bricks to the construction site.",
                            "target_lang_translations": {
                                "ru": "<w>Грузовик</w> вез тяжелый груз кирпичей на строительную площадку."
                            }
                        },
                        {
                            "text": "A <w>lorry</w> driver must have a special license to operate such a large vehicle.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>грузовика</w> должен иметь специальные права для управления таким большим транспортным средством."
                            }
                        }
                    ],
                    "synonyms": [
                        "truck"
                    ],
                    "common_phrases": [
                        "lorry driver",
                        "heavy lorry",
                        "articulated lorry"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое и тяжелое транспортное средство, предназначенное для перевозки грузов или солдат; грузовик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грузовик",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "фура",
                                "target_lang_sense_clarification": "большой грузовой автомобиль"
                            },
                            {
                                "target_lang_word": "грузовая машина",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecb8fc7c-8332-32ad-9276-b9391d4e284c",
                    "sense_definition": "A truck with an open carriage, sometimes used for transporting construction workers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers piled into the open <w>lorry</w> to be driven to the site.",
                            "target_lang_translations": {
                                "ru": "Рабочие забрались в открытый <w>грузовик</w>, чтобы их отвезли на объект."
                            }
                        },
                        {
                            "text": "An open <w>lorry</w> is often used for short trips around the farm.",
                            "target_lang_translations": {
                                "ru": "Открытый <w>грузовик</w> часто используется для коротких поездок по ферме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "open lorry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грузовик с открытым кузовом, иногда используемый для перевозки строительных рабочих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грузовик с открытым кузовом",
                                "target_lang_sense_clarification": "описание типа кузова"
                            },
                            {
                                "target_lang_word": "бортовой грузовик",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cf7ecb2-32b4-3bd3-9514-4b7838163e4d",
                    "sense_definition": "A large, low, horse-drawn, four-wheeled cart without sides; also, a similar wagon modified for use on railways.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy goods were moved across the dock on a horse-drawn <w>lorry</w>.",
                            "target_lang_translations": {
                                "ru": "Тяжелые грузы перемещали по доку на конной <w>платформе</w>."
                            }
                        },
                        {
                            "text": "Railway workers used a hand <w>lorry</w> to transport tools along the tracks.",
                            "target_lang_translations": {
                                "ru": "Железнодорожники использовали ручную <w>тележку</w> для перевозки инструментов вдоль путей."
                            }
                        }
                    ],
                    "synonyms": [
                        "dray"
                    ],
                    "common_phrases": [
                        "horse-drawn lorry",
                        "hand lorry"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical transport methods"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая низкая четырехколесная повозка на конной тяге без бортов; также аналогичный вагон, приспособленный для использования на железных дорогах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платформа",
                                "target_lang_sense_clarification": "низкая повозка или вагон"
                            },
                            {
                                "target_lang_word": "подвода",
                                "target_lang_sense_clarification": "конная повозка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fa7352e-40fc-3f81-8408-6fefae44d45c",
                    "sense_definition": "A small cart or wagon used on the tramways in mines to carry coal or rubbish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners filled the <w>lorry</w> with coal before pushing it toward the shaft.",
                            "target_lang_translations": {
                                "ru": "Шахтеры наполнили <w>вагонетку</w> углем, прежде чем толкнуть ее к стволу шахты."
                            }
                        },
                        {
                            "text": "Old wooden <w>lorries</w> were once the primary way to move ore in deep mines.",
                            "target_lang_translations": {
                                "ru": "Старые деревянные <w>вагонетки</w> когда-то были основным способом перемещения руды в глубоких шахтах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coal lorry"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "often spelled 'larry' in mining contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая тележка или вагоннетка, используемая на путях в шахтах для перевозки угля или мусора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вагонетка",
                                "target_lang_sense_clarification": "в шахтах и рудниках"
                            },
                            {
                                "target_lang_word": "тележка",
                                "target_lang_sense_clarification": "для перевозки грузов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4489e9cc-7f2c-34d9-8fe2-c0ef5f6c1ee2",
                    "sense_definition": "A barrow or truck for shifting baggage, as at railway stations.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "baggage_handling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The porter loaded the heavy trunks onto a <w>lorry</w> to move them to the platform.",
                            "target_lang_translations": {
                                "ru": "Носильщик погрузил тяжелые сундуки на <w>тележку</w>, чтобы отвезти их на платформу."
                            }
                        },
                        {
                            "text": "A small <w>lorry</w> was used to shift the mail bags from the train.",
                            "target_lang_translations": {
                                "ru": "Для перемещения почтовых сумок из поезда использовалась небольшая <w>тележка</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in this sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тележка для перемещения багажа, например, на железнодорожных станциях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "багажная тележка",
                                "target_lang_sense_clarification": "на вокзалах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d8e53b5-5fa3-37e0-a08a-6d9b99826df9",
                    "sense_definition": "To transport by, or as if by, lorry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The troops were <w>lorried</w> to the front lines under the cover of darkness.",
                            "target_lang_translations": {
                                "ru": "Войска были <w>перевезены на грузовиках</w> к линии фронта под покровом темноты."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>lorrying</w> the old furniture to the new house.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, <w>перевозя на грузовике</w> старую мебель в новый дом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lorried away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить на грузовике или подобным способом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить на грузовике",
                                "target_lang_sense_clarification": "способ транспортировки"
                            },
                            {
                                "target_lang_word": "доставлять автотранспортом",
                                "target_lang_sense_clarification": "официальный стиль"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}