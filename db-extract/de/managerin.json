                "senses": [
                    {
                        "sense_id": "435d3600-7199-35a9-82f0-5dbae3368f31",
                        "entry_id": "de6f137e-eaf8-3193-8deb-d2968beda854",
                        "glosses": [
                            "eine weibliche Person, (meist angestellte) Führungskraft in einem Unternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ba264c-f128-454b-b46a-6f76959b55ee",
                                "sense_id": "435d3600-7199-35a9-82f0-5dbae3368f31",
                                "text": "Zurzeit wird über die Gehälter der Managerinnen heftig diskutiert."
                            },
                            {
                                "example_id": "49a2a890-83fc-4281-acbe-ecaa3dbb2b71",
                                "sense_id": "435d3600-7199-35a9-82f0-5dbae3368f31",
                                "text": "„Die Managerin und all die Wahl-Brüsseler auf der Veranstaltung hatten recht gehabt.“"
                            },
                            {
                                "example_id": "0ab376e7-ae7a-461e-963c-d009badff6ea",
                                "sense_id": "435d3600-7199-35a9-82f0-5dbae3368f31",
                                "text": "„Auf ihrer Facebook-Seite veröffentlichte die Gewerkschaft in dieser Woche einen satirischen, erfundenen Kalendereintrag der Managerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7656bd2-f767-4da5-9ac9-ad0268dd44a1",
                        "source_entry_id": "de6f137e-eaf8-3193-8deb-d2968beda854",
                        "source_sense_id": "435d3600-7199-35a9-82f0-5dbae3368f31",
                        "source_sense_description": "eine weibliche Person, (meist angestellte) Führungskraft in einem Unternehmen",
                        "target_lang_word": "manager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3333a928-571d-3722-80c0-800b894f030a",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "A person whose job is to manage something, such as a business, a restaurant, or a sports team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1389617e-c0b2-4532-ab36-dbce5a19cdfa",
                                                "sense_id": "3333a928-571d-3722-80c0-800b894f030a",
                                                "text": "Although they did not want to risk wasting money, faster-climbing managers did value generosity and fair-mindedness."
                                            },
                                            {
                                                "example_id": "e7fc4d11-ac2d-453c-b4dc-7a33627649da",
                                                "sense_id": "3333a928-571d-3722-80c0-800b894f030a",
                                                "text": "And it was a fitting victory for Liverpool as Anfield celebrated the 100th anniversary of the birth of their legendary Scottish manager Bill Shankly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2e8a70-bd27-36be-b254-6f1f0a067173",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "The head coach."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4c98147-148e-3697-b391-8f9a80b9de09",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "An administrator, for a singer or group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81b9a79e-0a9b-3229-a117-631a07dd9e5a",
                                        "entry_id": "b8869064-7871-3be0-b7dd-87ba32048942",
                                        "glosses": [
                                            "A window or application whose purpose is to give the user the control over some aspect of the system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02d77e2-5f82-4b7c-b586-55963b185fea",
                                                "sense_id": "81b9a79e-0a9b-3229-a117-631a07dd9e5a",
                                                "text": "a file manager; a task manager; Program Manager"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c06ca518-ccd4-48e9-bdd0-f270e1a2fbb3",
                        "source_entry_id": "de6f137e-eaf8-3193-8deb-d2968beda854",
                        "source_sense_id": "435d3600-7199-35a9-82f0-5dbae3368f31",
                        "source_sense_description": "eine weibliche Person, (meist angestellte) Führungskraft in einem Unternehmen",
                        "target_lang_word": "manageuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manageuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a97c947-3558-3703-b59f-bfd1337340db",
                                        "entry_id": "6ec40384-78f0-3d6e-bb63-42a39e927c73",
                                        "glosses": [
                                            "Cadre dirigeante qui fait du management, gestionnaire, gérante, organisatrice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5355dd-05fc-46a3-9b02-8aa6da5eaf34",
                                                "sense_id": "8a97c947-3558-3703-b59f-bfd1337340db",
                                                "text": "Ces nouvelles manageuses du début du xxiᵉ siècle ont une performance outillée, maîtrisée et conscientisée."
                                            },
                                            {
                                                "example_id": "1057fc93-af1b-4e04-8d57-38f892038713",
                                                "sense_id": "8a97c947-3558-3703-b59f-bfd1337340db",
                                                "text": "« Avec les enfants, nous écrivons aux soldats. Mais la vie reprend. Il y aura bientôt un accord de paix », espère celle qui a été promue manageuse du cirque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df824e85-58f4-300c-83f1-78d880d3927a",
                                        "entry_id": "6ec40384-78f0-3d6e-bb63-42a39e927c73",
                                        "glosses": [
                                            "Responsable d’une équipe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3624a4f0-460e-4696-b3cb-0eab3465e146",
                                                "sense_id": "df824e85-58f4-300c-83f1-78d880d3927a",
                                                "text": "Ces femmes manageuses, âgées de moins de 30 ans, qui font toujours partie de l’entreprise, ont été mises à pied et devraient suivre une formation maison “valeurs et volonté, qui met l’homme au cœur de l’entreprise”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa07372a-6d6e-36ea-937e-46b151b8361e",
                                        "entry_id": "6ec40384-78f0-3d6e-bb63-42a39e927c73",
                                        "glosses": [
                                            "Celle qui dirige une entreprise théâtrale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44f9a560-02ec-3d46-8121-62f612f0eba3",
                                        "entry_id": "6ec40384-78f0-3d6e-bb63-42a39e927c73",
                                        "glosses": [
                                            "Celle qui s’occupe de la vie professionnelle d’un ou d’une artiste ou d’un groupe d’artistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1985e91-4a5c-4afd-ae80-19df7993512b",
                                                "sense_id": "44f9a560-02ec-3d46-8121-62f612f0eba3",
                                                "text": "Je veux rompre mon contrat de manageuse avec Clay, annonce-t-elle. Il n’a pas l’air surpris et lui prépare les papiers. Quelques instants après, il les lui tend et elle les signe sans regret avant de retrouver son mari à la salle d’entraînement."
                                            },
                                            {
                                                "example_id": "fc86def5-e8d2-4061-b4cf-e90f38a7321f",
                                                "sense_id": "44f9a560-02ec-3d46-8121-62f612f0eba3",
                                                "text": "La manageuse de Madonna, Angela, exprime le souhait de suivre les répétitions depuis le car régie, pour garder un œil sur la réalisation. À la demande d’Élise, je l’accompagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7010ed-a0fa-3293-a9e9-9a9750531de1",
                                        "entry_id": "6ec40384-78f0-3d6e-bb63-42a39e927c73",
                                        "glosses": [
                                            "Celle qui dirige une carrière sportive ou une équipe sportive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf4ebfa-9f44-4754-9cf2-c9375bba84c7",
                                                "sense_id": "aa7010ed-a0fa-3293-a9e9-9a9750531de1",
                                                "text": "Depuis le début, j’ai annoncé l’Angleterre. Parce qu’elles sont chez elles et qu’elles possèdent une excellente manageuse (Sarina Wiegman) qui a également réussi de superbes choses avec les Pays-Bas (elle a remporté l’Euro 2017)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53054121-a975-4def-89bb-dcc63d2d39bc",
                        "source_entry_id": "de6f137e-eaf8-3193-8deb-d2968beda854",
                        "source_sense_id": "435d3600-7199-35a9-82f0-5dbae3368f31",
