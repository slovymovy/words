                        "glosses": [
                            "A document connected to the Areopagus, particularly an oration delivered before it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc779d5-f142-4b7f-84a6-d3dcb57372c7",
                                "sense_id": "93be7410-68d8-35ea-9e24-5e6d3c00db7b",
                                "text": "1836 (1810), William Mitford, The History of Greece, Volume VIII, T. Cadell (London), W. Blackwood & Sons (Edinburgh), New Edition, page 60,\nThe Areopagitic carries within itself clear indication of its own date, after the conclusion of peace with the confederates, and before the measures which quickly followed […] ."
                            },
                            {
                                "example_id": "30a265b8-f0f5-4066-8697-38f1d8fac754",
                                "sense_id": "93be7410-68d8-35ea-9e24-5e6d3c00db7b",
                                "text": "1884 (1869), Thomas Carlyle, Carlyles' Works: Critical and miscellaneous essays, Volume IV, Dana Estes & Charles E. Lauriat, page 201,\nAnd one Mr. Milton sat in his house, by Bride's Church, teaching grammar, writing Areopagitics; and had dined that day, not perhaps without criticism of the cookery."
                            }
                        ]
                    }
