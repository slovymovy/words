                ],
                "senses": [
                    {
                        "sense_id": "d7ccdc56-dbae-3f1f-be9e-ac5d8f7fed34",
                        "entry_id": "9307668c-648d-33c2-af18-1d31ded0f332",
                        "glosses": [
                            "Commencer à construire, en préalable à la construction définitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62afd62c-c9ff-47bc-81cf-9543e623fdc4",
                                "sense_id": "d7ccdc56-dbae-3f1f-be9e-ac5d8f7fed34",
                                "text": "Ici comme chez Jean Renoir les références picturales ne servent pas seulement à pré-construire l'espace filmique."
                            },
                            {
                                "example_id": "0b4eefbd-66d1-4261-b469-62e34d065e23",
                                "sense_id": "d7ccdc56-dbae-3f1f-be9e-ac5d8f7fed34",
                                "text": "C'est la capacité de pré-construire le temps à venir, et donc le procédé inverse de l'encadrement juridico-moral de responsabilité qui traite de ce qui s'est déjà passé, de ce que tu as fait par le passé."
                            }
                        ]
                    }
                ],
