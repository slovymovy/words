                        "sense_id": "dc094565-0fa2-3ee8-b36f-332ad907f751",
                        "entry_id": "2d82f0e0-3194-3c22-a04b-802d0a8a5a58",
                        "glosses": [
                            "van een jong persoon dat deze er al oud uitziet; er ouder uitzien dan past bij de leeftijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13355317-2795-4761-bb2b-e665abb3836e",
                                "sense_id": "dc094565-0fa2-3ee8-b36f-332ad907f751",
                                "text": "De vroegoude student Toon, wiens ‘bolronde hoofd [opdook] uit een geweldige hoeveelheid spierwit haar, dat even weelderig onder zijn kin als boven op zijn hoofd groeide’, heeft niet veel op met romanschrijvers."
                            },
                            {
                                "example_id": "0d1fc0c7-4374-483e-a91d-7daf1055e63a",
                                "sense_id": "dc094565-0fa2-3ee8-b36f-332ad907f751",
                                "text": "Iedere club verdient zijn legenden, mannen wier namen in verweerd marmer gebeiteld staan en wier portretten vroegoude jongens tonen."
                            }
                        ]
                    }
