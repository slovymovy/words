                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecce37ae-e7ae-4b1e-8c9b-c11ea4b8dc24",
                                                "sense_id": "8faf5910-791d-3f77-a3e1-52885889fb0f",
                                                "text": "Sie ist mit ihren neuen Gummistiefeln direkt durch die Pfütze geplatscht."
                                            },
                                            {
                                                "example_id": "7136fbcf-02d2-4f47-816b-e36b49dd5492",
                                                "sense_id": "8faf5910-791d-3f77-a3e1-52885889fb0f",
                                                "text": "Er hat hier eine Weile in den Pfützen geplatscht und ist dann dorthin weitergegangen."
                                            }
                                        ],
