                ],
                "senses": [
                    {
                        "sense_id": "7eb4652b-0bb6-370b-b7c2-e017a5d517a8",
                        "entry_id": "737d9f6a-f140-3be6-b153-9b7eeaaa89ab",
                        "glosses": [
                            "Veau ou agneau élevé en plein air, nourri au lait maternel et au pâturage."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "b289db37-65c2-4ec8-af29-597ad7dbbae3",
                                "sense_id": "7eb4652b-0bb6-370b-b7c2-e017a5d517a8",
                                "text": "Mes fils adhèrent, en 1969, à la coopérative Beef-Grill Champagne qui leur fournit des broutards, dits babys. Ce sont des taurillons venant de régions où ils vivaient une grande partie de l’année dans de bonnes pâtures."
                            },
                            {
                                "example_id": "57c9dbed-cd77-4705-94ae-a7517d8850bb",
                                "sense_id": "7eb4652b-0bb6-370b-b7c2-e017a5d517a8",
                                "text": "Le reste, c’est des broutards que je laisse dehors à l’année."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b64bdd25-0774-45df-8f9f-79e6f4aacd60",
                        "source_entry_id": "737d9f6a-f140-3be6-b153-9b7eeaaa89ab",
                        "source_sense_id": "7eb4652b-0bb6-370b-b7c2-e017a5d517a8",
                        "target_lang_word": "Kalb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "Jungtier eines Herdentieres, zum Beispiel von paarhufigen Säugetieren wie den Rindern oder Hirschen, aber auch Elefanten, Giraffen; auch Jungtier von Meeressäugern, also bei Walen und Seekühen; Je nach Tierart ist die Zeit des 'Kalbseins' unterschiedlich lang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63481365-1558-4a2c-8352-50d190a1b8d0",
                                                "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                                "text": "Das Kalb springt munter auf der Weide herum."
                                            },
                                            {
                                                "example_id": "30e690bc-f20f-4aea-b62a-8d9fe01fe5c1",
                                                "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                                "text": "„Wichtigstes Haustier war das Rind, das lange gehalten wurde, um Kälber und Milch zu produzieren.“"
                                            },
                                            {
                                                "example_id": "706014f9-b647-48ae-8314-6ef17c310ea4",
                                                "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                                "text": "„In einer Steuerliste des Jahres 1542 werden immerhin zehn Schweine (darunter drei Ferkel), fünf Kühe, neun Kälber und eine Ziege mit zwei Zicklein aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2373e00e-8ee8-3de3-9e04-d08595ea316d",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "Fleisch vom jungen Rind"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3576a85e-def6-4ca9-a62b-2f26a6082d36",
                                                "sense_id": "2373e00e-8ee8-3de3-9e04-d08595ea316d",
                                                "text": "Zur Zubereitung eines Schnitzels eignet sich Kalb bestens."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aab98eb9-e5a2-3b56-ae1b-bf52521d29bd",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "alberner, verspielter, einfältiger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dbc65ca-5f03-46ca-ae0f-7e1334836e17",
                                                "sense_id": "aab98eb9-e5a2-3b56-ae1b-bf52521d29bd",
                                                "text": "Er gebärdet sich manchmal noch wie ein junges Kalb."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b5c8f070-2f33-3a07-ac06-7224eee72800",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "großer, schlaksiger Hund"
                                        ],
                                        "tags": [
                                            "meißnisch"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9472e7c4-0ed9-3566-becd-54029d8cf9cd",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "Veraltete Form des Namens der Stadt Calw im Schwarzwald."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b6ee95e-9f3c-4b90-b1ce-9f66c1b69c62",
                        "source_entry_id": "737d9f6a-f140-3be6-b153-9b7eeaaa89ab",
                        "source_sense_id": "7eb4652b-0bb6-370b-b7c2-e017a5d517a8",
                        "target_lang_word": "Lamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66d79357-9b6a-303b-b434-edf8c5772505",
                                        "entry_id": "1548ab55-c911-32de-a2f4-7f87e910245f",
                                        "glosses": [
                                            "das junge Schaf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38af78cd-47ed-4162-a1fc-63948361800a",
                                                "sense_id": "66d79357-9b6a-303b-b434-edf8c5772505",
                                                "text": "Die Lämmer tobten auf der Weide."
                                            },
                                            {
                                                "example_id": "1d507563-d27e-4d4f-bf62-8cfd0660c6f0",
                                                "sense_id": "66d79357-9b6a-303b-b434-edf8c5772505",
                                                "text": "„Der Wolf (der Wolf),",
                                                "translation": "HURZ!“"
                                            },
                                            {
                                                "example_id": "0c149e08-d69c-4f10-a938-2a5184ce09d9",
                                                "sense_id": "66d79357-9b6a-303b-b434-edf8c5772505",
                                                "text": "„Ich sah sie nun zum ersten Mal in der Umzäunung, und dort hörte ich auch, wie sie ihre Lämmer riefen.“"
                                            },
                                            {
                                                "example_id": "38744eec-8578-4abb-a4c5-f79725520a13",
                                                "sense_id": "66d79357-9b6a-303b-b434-edf8c5772505",
                                                "text": "„Es sind schon einige Lämmer dabei, und sie laufen dicht hinter ihren Müttern.“"
                                            },
                                            {
                                                "example_id": "6f073e90-8156-4c2d-aeeb-bc29cb43a017",
                                                "sense_id": "66d79357-9b6a-303b-b434-edf8c5772505",
                                                "text": "„Vor allem jedoch sind da die Hirten mit ihren Schafen; einer trägt ein Lamm auf der Schulter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47e78cbe-d337-3a6f-9fcc-bb27d3a6508b",
                                        "entry_id": "1548ab55-c911-32de-a2f4-7f87e910245f",
                                        "glosses": [
                                            "Fleisch eines jungen Schafs"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d88d5ab9-10b2-4679-97e6-80107a9e5cc6",
                                                "sense_id": "47e78cbe-d337-3a6f-9fcc-bb27d3a6508b",
                                                "text": "Heute gibt's Lamm."
                                            },
                                            {
                                                "example_id": "4dbeae11-1a0a-4774-9ae5-9e6d45427581",
                                                "sense_id": "47e78cbe-d337-3a6f-9fcc-bb27d3a6508b",
                                                "text": "„Beim nächsten Hotel mußte Miss Runcible draußen im Wagen bleiben, wohin ihr kaltes Lamm und Salzheringe gebracht wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "98fd645d-9f07-3a28-8bc8-3e0d9e6406a0",
                                        "entry_id": "1548ab55-c911-32de-a2f4-7f87e910245f",
                                        "glosses": [
                                            "unschuldiger Mensch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab9bd3d-a3f3-4428-a2bf-bb11c0105a69",
                                                "sense_id": "98fd645d-9f07-3a28-8bc8-3e0d9e6406a0",
                                                "text": "Was hat deses Lamm verbrochen, dass es sterben musste?"
                                            },
                                            {
                                                "example_id": "1cfcdaae-8e0f-4d32-972b-205ff11649dc",
                                                "sense_id": "98fd645d-9f07-3a28-8bc8-3e0d9e6406a0",
                                                "text": "Der Gefangene wurde wie ein Lamm zur Schlachtbank geführt und wehrte sich nicht."
                                            },
                                            {
                                                "example_id": "5c6c8939-7f0e-4470-a2c3-fbc002e2a14e",
                                                "sense_id": "98fd645d-9f07-3a28-8bc8-3e0d9e6406a0",
                                                "text": "\"Seht das Lamm Gottes, das hinwegnimmt die Sünde der Welt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                        "entry_id": "8855978f-49ee-3c0f-a96c-5c9aeb1b0db3",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fafc2dc-9d98-4c91-a8a4-5404227e7845",
                                                "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                                "text": "Frau Lamm ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c81bc6ed-646e-43ac-aa9b-a6a9e8c0091a",
                                                "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                                "text": "Herr Lamm wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "c04f370a-efbf-49fb-ac7d-4b6009613772",
                                                "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                                "text": "Die Lamms fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "6fcf7482-e2fc-4115-979a-b5dadc5abe40",
                                                "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                                "text": "Der Lamm trägt nie die Pullover, die die Lamm ihm strickt."
                                            },
                                            {
                                                "example_id": "735aadbd-98bf-4b85-a70b-9ee9811e3d21",
                                                "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lamm kommt, geht der Herr Lamm.“"
                                            },
                                            {
                                                "example_id": "c026a3c0-18da-4a11-9978-3b71a1a16109",
                                                "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                                "text": "Lamm kommt und geht."
                                            },
                                            {
                                                "example_id": "63540626-f5fb-46f7-914a-8554aabe6ffa",
                                                "sense_id": "029762bc-252f-3c5c-8586-3fe27a46b189",
                                                "text": "Lamms kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
