                        "cross_references": [
                            {
                                "target_word": "проститу́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "69220f2b-6d7d-3a6b-9ac0-424be7713dff",
                                        "entry_id": "0ecb55fc-9004-3ffc-b728-348c885cea3b",
                                        "glosses": [
                                            "прост. мужчина, предоставляющий сексуальные услуги за деньги или другую материальную выгоду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7ced20-c405-415c-ba57-18c0e20fec84",
                                                "sense_id": "69220f2b-6d7d-3a6b-9ac0-424be7713dff",
                                                "text": "Ежегодно на проституцию тратит человечество около пятисот миллиардов рублей, не считая косвенных затрат здоровья, потери колоссального времени, наличия целого международного общественно вредного класса проституток и проститутов и пр. и т. п."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bdd4990-b00c-346d-9bd0-b9a59b10abf2",
                                        "entry_id": "0ecb55fc-9004-3ffc-b728-348c885cea3b",
                                        "glosses": [
                                            "устар. тот, кто продажен, бесчестен"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ca6ac64-e7fb-4846-a969-7b3619af8086",
                                                "sense_id": "2bdd4990-b00c-346d-9bd0-b9a59b10abf2",
                                                "text": "Повторять хотя бы с тем же однообразием форм и приёмов, которые употребляются самими клеветниками и проститутами."
                                            },
                                            {
                                                "example_id": "9671942b-a602-4b58-9ffb-d985990518e3",
                                                "sense_id": "2bdd4990-b00c-346d-9bd0-b9a59b10abf2",
                                                "text": "А с другой стороны, ведь и действительно в существо актёра, писателя, адвоката, даже «патера, который всех отпевает», — входит психология проститутки, т. е. этого и равнодушия ко «всем», и ласковости со «всеми». — Вам похороны или свадьбу? — спрашивает вошедшего поп, с равно спокойной, неопределённой улыбкой, готовой перейти в «поздравление» или «сожаление». Учёный, насколько он публикуется, писатель, насколько он печатается — суть, конечно, проституты."
                                            },
                                            {
                                                "example_id": "60d50958-9e06-4a8b-a0c7-26614072d1bc",
                                                "sense_id": "2bdd4990-b00c-346d-9bd0-b9a59b10abf2",
                                                "text": "Проституты в европейских костюмах с чековыми книжками и без оных продолжали губить Россию. И, казалось, во лбу каждого выжжено тавро продажности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "185c0fb0-1257-4b64-b838-b8877e0c98d0",
                        "source_entry_id": "669f6662-a7bf-3707-b329-95f52b12687c",
                        "source_sense_id": "e03e8090-4fae-3775-8225-b02943c2be05",
