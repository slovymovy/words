    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebf6751a-b5c4-343f-8334-19502515703d",
                    "sense_definition": "Changement ou développement progressif et graduel d'une chose, d'une situation ou d'un phénomène.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "changement_progressif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques observent attentivement l'<w>évolution</w> du climat depuis plusieurs décennies."
                        },
                        {
                            "text": "Cette entreprise est en constante <w>évolution</w> pour s'adapter aux nouveaux besoins de ses clients."
                        }
                    ],
                    "synonyms": [
                        "changement",
                        "développement",
                        "progression",
                        "transformation"
                    ],
                    "antonyms": [
                        "régression",
                        "stagnation"
                    ],
                    "common_phrases": [
                        "en constante évolution",
                        "suivre l'évolution",
                        "évolution des prix",
                        "évolution favorable"
                    ]
                },
                {
                    "sense_id": "4f713e05-7fac-3884-8f71-70599a748b69",
                    "sense_definition": "Processus biologique par lequel les espèces vivantes se transforment et se diversifient au fil des générations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Charles Darwin a développé la théorie de l'<w>évolution</w> par sélection naturelle au dix-neuvième siècle."
                        },
                        {
                            "text": "L'<w>évolution</w> des espèces vivantes s'étend généralement sur des millions d'années."
                        }
                    ],
                    "antonyms": [
                        "fixisme"
                    ],
                    "common_phrases": [
                        "théorie de l'évolution",
                        "évolution des espèces",
                        "évolution biologique"
                    ]
                },
                {
                    "sense_id": "72b537ad-3181-3b46-8ad1-3cdc5af80d80",
                    "sense_definition": "Changement d'idées, d'opinions ou de comportement chez une personne ou au sein d'une collectivité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changement_progressif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>évolution</w> des mentalités permet aujourd'hui une meilleure acceptation de toutes les différences."
                        },
                        {
                            "text": "Le journaliste analyse l'<w>évolution</w> politique de ce député au cours de son mandat."
                        }
                    ],
                    "synonyms": [
                        "changement"
                    ],
                    "common_phrases": [
                        "évolution des mentalités",
                        "évolution des mœurs",
                        "évolution politique"
                    ]
                },
                {
                    "sense_id": "b4cacc96-c107-3222-bfce-e1163e744b9a",
                    "sense_definition": "Mouvement, déplacement ou manœuvre coordonnée d'un groupe d'êtres vivants, de personnes ou d'engins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis la plage, nous admirions les <w>évolutions</w> spectaculaires des oiseaux dans le ciel."
                        },
                        {
                            "text": "Le public émerveillé suivait les <w>évolutions</w> rapides des avions au cours du salon aéronautique."
                        }
                    ],
                    "synonyms": [
                        "manœuvre",
                        "mouvement"
                    ],
                    "common_phrases": [
                        "faire des évolutions"
                    ]
                }
            ]
        }
    ]
