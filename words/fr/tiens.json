            "senses": [
                {
                    "sense_id": "5e68d151-b9ac-3c2c-91ef-47b56619dab1",
                    "sense_definition": "Mot qu'on dit en tendant quelque chose à quelqu'un pour le lui donner ; équivalent de « voici ».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tiens</w>, voici les clés de la voiture, n'oublie pas de me les rendre ce soir."
                        },
                        {
                            "text": "<w>Tiens</w>, prends ce stylo si tu veux écrire ton nom sur la liste."
                        }
                    ],
                    "common_phrases": [
                        "tiens voilà",
                        "tiens prends ça"
                    ]
                },
                {
                    "sense_id": "e94e6889-9c92-3bec-a033-88ed70e6d6f8",
                    "sense_definition": "Exclamation qui marque l'étonnement ou la surprise devant quelque chose d'inattendu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "étonnement et doute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tiens</w>, tu es déjà là ? Je ne t'attendais pas avant midi."
                        },
                        {
                            "text": "<w>Tiens</w>, <w>tiens</w>, voilà une belle surprise pour un lundi matin !"
                        }
                    ],
                    "synonyms": [
