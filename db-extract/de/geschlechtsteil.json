                ],
                "senses": [
                    {
                        "sense_id": "b80ebbea-7a5c-30ac-88eb-7ca5bc899a50",
                        "entry_id": "fa7a7182-ea76-36e7-ab1b-b26eb6b48bc3",
                        "glosses": [
                            "Körperteil, das hauptsächlich der Fortpflanzung dient; äußeres Geschlechtsorgan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e6fb804-dd17-4314-aec2-9e7587b9519f",
                                "sense_id": "b80ebbea-7a5c-30ac-88eb-7ca5bc899a50",
                                "text": "Das Entblößen der Geschlechtsteile in der Öffentlichkeit gilt als anstößig."
                            },
                            {
                                "example_id": "f8aab403-b434-49dc-8522-732d63b31b83",
                                "sense_id": "b80ebbea-7a5c-30ac-88eb-7ca5bc899a50",
                                "text": "„Er hatte vor einem Jahr bei der Mutter ein Buch über Naturvölker der Südsee gefunden und dabei Fotografien von nackten jungen Mädchen beim Fruchtbarkeitstanz entdeckt, die mit einem besonderen Lächeln ihr Geschlechtsteil darboten und mit ihren Fingern öffneten.“"
                            },
                            {
                                "example_id": "e2eb2457-a502-461e-b566-79abaec55942",
                                "sense_id": "b80ebbea-7a5c-30ac-88eb-7ca5bc899a50",
                                "text": "„Schließlich geht der Arzt vor jeder Person in die Hocke und untersucht die Geschlechtsteile von Männern und Frauen: Die Käufer wollen vermeiden, dass während der Atlantikquerung die Syphilis ausbricht.“"
                            },
                            {
                                "example_id": "efa548ce-6c45-47f3-846b-db34ccfe35d8",
                                "sense_id": "b80ebbea-7a5c-30ac-88eb-7ca5bc899a50",
                                "text": "„Vorsichtig berührte Jóakim Tóvós Oberschenkel und dessen Bauch, und obwohl Tóvó es nicht zu sagen wagte, hoffte er, dass Jóakim auch sein steifes Geschlechtsteil anfassen würde.“"
                            },
                            {
                                "example_id": "275d656c-ca5d-4fa0-b8ec-e8f4fe9fbbf7",
                                "sense_id": "b80ebbea-7a5c-30ac-88eb-7ca5bc899a50",
                                "text": "„Die Menge stellte willkürliche Vergleiche zwischen seinem Geschlechtsteil und einem Streichholz an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
