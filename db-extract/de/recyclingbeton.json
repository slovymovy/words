                ],
                "senses": [
                    {
                        "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                        "entry_id": "91594192-f004-3dad-96d7-0bd22eacde98",
                        "glosses": [
                            "Beton, der aus (normalem) Zement, Wasser und recycelten Zuschlagsstoffen, also Splitt, der aus aufbereitetem Bauschutt gewonnen wurde, hergestellt wird"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "145f2f18-d4df-4cd7-b606-b0f0f5bb8b94",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Das Gebäude aus Recyclingbeton wurde kürzlich eröffnet.“"
                            },
                            {
                                "example_id": "0a15e15b-5cfb-4989-92ab-89623850ce9d",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Zur Herstellung von Recyclingbeton wird die Gesteinskörnung aus primären Rohstoffen (Kies und Flusssand) zum Teil oder vollständig durch zerkleinerten Beton- oder Mauerwerksbruch ersetzt, der beim Abbruch von Gebäuden oder Verkehrsbauten gewonnen wurde und ähnliche Eigenschaften besitzt, wie gebrochene Mineralstoffe (also Brechsand und Splitt).“"
                            },
                            {
                                "example_id": "eb788e1d-ced4-4de1-88ef-a1c6241739bc",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Materialien wie Beton, Ziegel und Fliesen können in Brechanlagen zu Recyclingbeton oder Material für den Straßen- und Wegebau verarbeitet werden.“"
                            },
                            {
                                "example_id": "3fd0c160-1971-4804-9f5a-a627e8a26e6f",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Wie Primärbeton enthält auch Recyclingbeton Zement, Zusatzmittel, Wasser und eine rezyklierte Gesteinskörnung, auch Granulat genannt.“"
                            },
                            {
                                "example_id": "89c84ecd-5150-4969-90c6-4967ea160723",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Um Recyclingbeton vermehrt auf den Markt zu bringen, ist es wichtig, die Akzeptanz dieses Baustoffs bei Bauherren, Ingenieuren und Architekten zu fördern und Wissen zu verbreiten (Hiltbrunner, 2017; Noger, 2017).“"
                            },
                            {
                                "example_id": "57b634bd-7edf-4cef-a28c-0d0918a98f18",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Fakt ist, dass für gewisse Bereiche, beispielsweise für Wände, die nicht der Witterung ausgesetzt sind, keine Nachteile durch den Einsatz von Recyclingbeton entstehen.“"
                            },
                            {
                                "example_id": "9e9d6f03-e6b8-4c1a-a051-aa0403c84fc0",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Weil er Frost und Tausalz nicht so gut verträgt wie normaler Beton, darf Recyclingbeton derzeit nur innerhalb von Gebäuden eingesetzt werden.“"
                            },
                            {
                                "example_id": "7c1b2c21-13c5-4cd8-87bb-39227c723a29",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "[Die Studie von Klejer et al.] „kommt zum Schluss, dass Recyclingbeton in Bezug auf Treibhausgasemissionen nur geringfügig besser abschneidet als Primärbeton.“"
                            },
                            {
                                "example_id": "99d30af0-4c48-492c-a137-362c1799b59e",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Dieser Recyclingbeton weist unter dem Strich einen um 10 Prozent geringeren CO₂-Fussabdruck auf als vergleichbarer Beton.“"
                            },
                            {
                                "example_id": "dcc3fb40-f121-4a27-ac3f-385670358c41",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Das Kreislaufwirtschaftsgesetz schreibt Städten und Gemeinden zwar seit Herbst 2020 vor, künftig auch mit Recyclingbeton zu bauen, um die CO₂-Emissionen zu verringern. Der Nachteil des Gesetzes ist aber: Bisher fehlen Sanktionen für denjenigen, der es missachtet.“"
                            },
                            {
                                "example_id": "81f78304-63f8-4c16-9f2f-b910a81d7687",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Die Stadt Zürich hat das schon erkannt: Alle von der Stadt ausgeschriebenen Neubauten müssen aus Recyclingbeton bestehen. Fast 100 Gebäude, darunter Schulen und Krankenhäuser in Zürich sind inzwischen auf diese Weise entstanden.“"
                            },
                            {
                                "example_id": "f20473ca-7012-4030-8335-9e166310c0c0",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Im Rahmen eines internationalen Projekts entwickelten die Hamburger Recyclingbeton, der zu 70 Prozent aus mineralischem Abfall besteht.“"
                            },
                            {
                                "example_id": "c3f3dd96-a5f0-4307-9fd8-1ebe0d9bc1a5",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„»Beim Bau haben wir auf Ressourcenschonung Wert gelegt. So wurde nahezu ausschließlich Recyclingbeton im Rohbau verwendet.«“"
                            },
                            {
                                "example_id": "0c503955-8248-4075-a60f-33d7ed005e47",
                                "sense_id": "ea4af321-56b0-33e3-848c-ac0f079f917f",
                                "text": "„Abschliessend ist zu sagen, dass Recyclingbeton ein grosses Potenzial hat, welches noch weitgehend ungenutzt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
