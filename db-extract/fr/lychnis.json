                        "examples": [
                            {
                                "example_id": "f37a5410-8fcd-4d13-8b5a-f7abf5fb9f5c",
                                "sense_id": "e1e46a73-a952-3b83-9de4-2db89baf6cc4",
                                "text": "Le lychnis sauvage et visqueux, avec une fleur rouge et des feuilles étroites, est communément appelé attrape-mouche."
                            },
                            {
                                "example_id": "8a446dfb-6001-4107-838e-86fc34f7175e",
                                "sense_id": "e1e46a73-a952-3b83-9de4-2db89baf6cc4",
                                "text": "Le lychnis fleur de coucou a d’abord proliféré de manière excessive pour ensuite quasiment disparaître de nouveau quelques années plus tard, la cardamine s’installait, puis s’en allait."
                            }
                        ]
                    }
