                    {
                        "sense_id": "5cdd873f-40ca-3e44-8523-27f0cfbb966c",
                        "entry_id": "7f311173-f5c5-3496-9e95-46b8ba948936",
                        "glosses": [
                            "iemand die een zetel in een der kamers van de volksvertegenwoordiging bekleedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a727a7c-3885-4b7e-a2a9-dac6543d10f0",
                                "sense_id": "5cdd873f-40ca-3e44-8523-27f0cfbb966c",
                                "text": "Na dit schandaal traden een aantal ervaren Kamerleden af."
                            },
                            {
                                "example_id": "f4f3fe33-a40f-4e7d-8ae9-c7fbe6045a2f",
                                "sense_id": "5cdd873f-40ca-3e44-8523-27f0cfbb966c",
                                "text": "Kamerlid Wybren van Haga van de VVD wist eind november de aandacht van bijna de gehele media op zich te vestigen met een voorstel geld vrij te maken voor geboortebeperking in Afrika, omdat dat ‘meer rendement oplevert dan investeren in honger of onderwijs’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c5e9fca-2b07-4a2e-9cfd-2c111110c180",
                        "source_entry_id": "7f311173-f5c5-3496-9e95-46b8ba948936",
                        "source_sense_id": "5cdd873f-40ca-3e44-8523-27f0cfbb966c",
                        "source_sense_description": "iemand die een zetel in een der kamers van de volksvertegenwoordiging bekleedt",
                        "target_lang_word": "Abgeordneter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abgeordneter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                        "entry_id": "320be795-09f7-3600-9b59-61e34b163d47",
                                        "glosses": [
                                            "gewähltes Mitglied einer parlamentarischen Versammlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a31a69c-c122-4cd9-b858-7a403a854df1",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Die Abgeordneten des Deutschen Bundestages werden in allgemeiner, unmittelbarer, freier, gleicher und geheimer Wahl gewählt.“"
                                            },
                                            {
                                                "example_id": "bdc2636b-df4a-4534-885c-8dcb44f8d089",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„MS Exchange ist ein sogenannte Groupware, mit deren Hilfe die Abgeordneten nicht nur Mails verschicken und empfangen können wie bisher, sondern auch ihre Adressbücher zentral verwalten und Termine miteinander abstimmen.“"
                                            },
                                            {
                                                "example_id": "621eb680-29c2-44b4-a9db-b4ff89c281cd",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Als junger Abgeordneter hielt ich in den Dörfern des westlichen Landkreises von Fürstenfeldbruck Bauernversammlungen im Trachtenanzug.“"
                                            },
                                            {
                                                "example_id": "962606fa-c9e3-4a71-ad68-66f6d0fd6204",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Am Sonntag, 9. Juni, wählen die Menschen in Deutschland ihre Abgeordneten im Europäischen Parlament.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c28a065-63ba-4c54-a891-ffb68c33e36c",
                        "source_entry_id": "7f311173-f5c5-3496-9e95-46b8ba948936",
                        "source_sense_id": "5cdd873f-40ca-3e44-8523-27f0cfbb966c",
