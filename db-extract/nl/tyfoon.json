                                    {
                                        "sense_id": "19f8be59-9094-3a6f-98b8-e5356a38bc40",
                                        "entry_id": "135ac1b0-6069-3290-81f6-fbd59b6f785e",
                                        "glosses": [
                                            "A severe tropical cyclone; an intense, rotating storm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "964b52bf-dcdc-3d3f-b6ba-e14a8f8cb8a7",
                                        "entry_id": "135ac1b0-6069-3290-81f6-fbd59b6f785e",
                                        "glosses": [
                                            "A weather phenomenon in the northwestern Pacific that is precisely equivalent to a hurricane except for its geographical region, typically resulting in wind speeds of 64 knots (119 km/h) or above. Equivalent to a cyclone in the Indian Ocean and Indonesia and Australia."
                                        ],
                                        "tags": [
                                            "in particular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6635f1ae-0038-41d6-9a01-0a74e6ca79b0",
                                                "sense_id": "964b52bf-dcdc-3d3f-b6ba-e14a8f8cb8a7",
                                                "text": "Near-synonyms: cyclone (narrow sense), hurricane"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "typhoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a126648a-cf1c-311a-bb9d-c7d081b2cea1",
                                        "entry_id": "dc727e13-cd9e-3136-9f16-4e1f053c2044",
                                        "glosses": [
                                            "To swirl like a hurricane."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9665199d-f9d5-408e-9936-c4ef76dc3ba4",
                        "source_entry_id": "db0f8fd8-e208-39c3-af25-614ba773d18c",
                        "source_sense_id": "35e10817-5431-3e86-a3ad-3a06bc7c3cd6",
                        "source_sense_description": "een hevige wervelstorm in de Chinese Zee en de Stille Oceaan die ontstaat uit een tropische depressie.",
                        "target_lang_word": "typhon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typhon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                        "entry_id": "4c2f2b9e-dace-3412-8ced-18fdecb498ce",
                                        "glosses": [
                                            "Cyclone tropical très violent en Extrême-Orient, issu du Pacifique nord-ouest ou de la mer de Chine méridionale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f2ef72-f415-4d45-8821-39e2167aa95d",
                                                "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                                "text": "Voyez. C’est un typhon qui se prépare !\n− Va pour le typhon du sud, puisqu'il nous poussera du bon côté, répondit Mr Fogg."
                                            },
                                            {
                                                "example_id": "ef12a5b2-7766-4b4b-81a8-055795ceeb3e",
                                                "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                                "text": "Depuis, j'ai vérifié que le vent est un grand personnage de la géographie, et que l'on s'expose à ne rien comprendre à l'histoire si l'on oublie les brises, les typhons, les mistrals et les foehns, ou bien ce vent grec qui emporta par étourderie, voilà près de trois mille ans, quelques marins de Phocée en Asie Mineure, et qui les jeta en France afin qu'ils créent la ville de Marseille."
                                            },
                                            {
                                                "example_id": "289db892-b78b-4acb-9153-ac481597b52f",
                                                "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                                "text": "Les Philippines, classées parmi les pays les plus exposés au changement climatique, sont balayées par près de 20 tempêtes tropicales ou typhons chaque année qui détruisent généralement récoltes, habitations et infrastructures dans des régions déjà pauvres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
