                        "entry_id": "731713ca-a0f5-3e50-b703-23074a09dadc",
                        "glosses": [
                            "Ensemble d’œuvres inséparable précédant un autre ensemble similaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abdaa878-b33a-41b9-b80a-6ad04b279525",
                                "sense_id": "b9368531-f04a-397e-9f6c-e5372b933653",
                                "text": "La Revanche des Sith est le troisième volet de la « prélogie » (nouvelle trilogie précédant la trilogie originale) débutée par le réalisateur George Lucas en 1999."
                            },
                            {
                                "example_id": "7fc94d44-d48c-47fc-aa89-153e7ceedb12",
                                "sense_id": "b9368531-f04a-397e-9f6c-e5372b933653",
                                "text": "Trilogie, prélogie ou postlogie, à chaque génération sa série de films « Star Wars » préférée."
                            },
                            {
                                "example_id": "41c11b31-99f4-41b8-b71a-211cb8013e6f",
                                "sense_id": "b9368531-f04a-397e-9f6c-e5372b933653",
                                "text": "Après la prélogie, c’est devenu l’homme à abattre, ce qui est un peu injuste, raconte Laurent Hopman."
                            }
                        ]
                    }
