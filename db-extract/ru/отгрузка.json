                        "translation_id": "8d2bd46e-11b8-48c1-8a79-4474d42c379e",
                        "source_entry_id": "2b9ee6c3-9948-3694-b3de-03790d4c0863",
                        "target_lang_word": "dispatch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dispatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8c8868-ff2a-39db-a08e-cebbe772635e",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To send (a shipment) with promptness."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a19b6efb-7389-3a52-b935-e362e3bcc5e7",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To send (a person) away hastily."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d09c3fe1-a04b-4987-a9a5-d1e52a3cc296",
                                                "sense_id": "a19b6efb-7389-3a52-b935-e362e3bcc5e7",
                                                "text": "The League of One was suddenly exposed and in danger of being hunted by enemies of the salarians. Before any harm could be done, the team mysteriously disappeared.[...]Realizing the threat posed by this rogue outfit, the Special Tasks Group dispatched a team of hunters. When they didn't return, the STG dispatched ten of its brightest operators with broad discretionary powers. Only two returned; they reported no evidence of the League."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c548dbde-5a6a-31d4-940d-d42e1f6203c6",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To send (an important official message) promptly, by means of a diplomat or military officer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e06c20a9-59a6-351a-8269-23d8a73e2a1d",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To send (a journalist) to a place in order to report."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ef069b2-6e48-4b8f-a0d5-07b66ce59d3c",
                                                "sense_id": "e06c20a9-59a6-351a-8269-23d8a73e2a1d",
                                                "text": "Scores of foreign journalists have been dispatched to Seoul to report on the growing tensions between the two Koreas and the possibility of war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5991ed2-a52d-3077-ad45-f01d15b52ba9",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To dispose of speedily, as business; to execute quickly; to make a speedy end of; to finish; to perform."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04e035a0-6ddf-42ae-86b1-3a6a5171eca2",
                                                "sense_id": "b5991ed2-a52d-3077-ad45-f01d15b52ba9",
                                                "text": "Yet, ere we put ourselves in arms, dispatch we / The business we have talk'd of."
                                            },
                                            {
                                                "example_id": "05f4c872-bdf3-46f6-942a-3282f95ec06d",
                                                "sense_id": "b5991ed2-a52d-3077-ad45-f01d15b52ba9",
                                                "text": "the which company of harvest men, being ready at the day appointed, almost in one fair day dispatcheth all the harvest work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6436cc9d-1e5c-3b19-a48a-f7be1c8b4e0e",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To rid; to free."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feab4ab2-07f4-4ea9-9b41-04739e72886d",
                                                "sense_id": "6436cc9d-1e5c-3b19-a48a-f7be1c8b4e0e",
                                                "text": "But whā I had cleane diſpatched myſelf of this great charge and taſke, I loked not that I ſhould at any tyme afterwarde have any more to doe with this kynde of writing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8235c349-120f-3c6d-95cd-85c912204d49",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To destroy (someone or something) quickly and efficiently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2437fbac-05c4-4974-953c-5fcbe9687308",
                                                "sense_id": "8235c349-120f-3c6d-95cd-85c912204d49",
                                                "text": "\"And our dogs used to tree the cats on our property here, and we'd dispatch them.\""
                                            },
                                            {
                                                "example_id": "ec9a4edc-4701-4978-8b2c-c2eee673834a",
                                                "sense_id": "8235c349-120f-3c6d-95cd-85c912204d49",
                                                "text": "So Tyrion hatches one last brilliant scheme in a season full of them, and this one goes exactly as well as all the others, even if it doesn’t look like it at first. He alone takes a meeting with Cersei, in her chambers, with the Mountain ready and waiting to dispatch him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55d48fb-7902-37a9-9677-68f8e6936865",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To defeat"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3c2ecf-ea45-4f80-85d9-2738a82a7afb",
                                                "sense_id": "f55d48fb-7902-37a9-9677-68f8e6936865",
                                                "text": "Gareth Southgate's side had little trouble dispatching the side 172nd in the Fifa rankings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a996dabb-e10d-3199-9f82-19479c16a287",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To pass on for further processing, especially via a dispatch table (often with to)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4a2ce08-2c68-4b43-9da2-37c0f7f2839e",
                                                "sense_id": "a996dabb-e10d-3199-9f82-19479c16a287",
                                                "text": "These handlers perform any additional checking and processing that may be necessary before and after a message is dispatched to an object. In addition, some message types are handled internally by the kernel[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47acee59-06cc-332b-a7ba-1edce4a559fe",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To hurry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52d02c1a-84d8-4072-b63c-d2f0133c9572",
                                                "sense_id": "47acee59-06cc-332b-a7ba-1edce4a559fe",
                                                "text": "prithee, dispatch"
                                            },
                                            {
                                                "example_id": "0e09d4a8-f960-45d1-ab70-3dd6a5bda65d",
                                                "sense_id": "47acee59-06cc-332b-a7ba-1edce4a559fe",
                                                "text": "“Proceed, friend Nicolas, and let us dispatch; for, it grows late.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2dab2dd-43ae-31c4-822d-ae44da717cae",
                                        "entry_id": "348fb49f-0afe-3171-a21e-db593ba82dcc",
                                        "glosses": [
                                            "To deprive."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dispatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4da9ce1-0215-3a98-99c8-ffcff3230c4d",
                                        "entry_id": "e3032319-e10b-3c3a-9eda-556d12b730b5",
                                        "glosses": [
                                            "A message sent quickly, as a shipment, a prompt settlement of a business, or an important official message sent by a diplomat, government official, military officer, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eac97ed-45df-447a-8e2d-096ef21e703f",
                                                "sense_id": "e4da9ce1-0215-3a98-99c8-ffcff3230c4d",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets. They also exposed the blatant discrepancy between the west's professed values and actual foreign policies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0653d1e-747a-3065-8d48-b32c7975a016",
                                        "entry_id": "e3032319-e10b-3c3a-9eda-556d12b730b5",
                                        "glosses": [
                                            "The act of doing something quickly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd85278-ef13-47a8-8f68-f326f38d2f08",
                                                "sense_id": "f0653d1e-747a-3065-8d48-b32c7975a016",
                                                "text": "We must act with dispatch in this matter."
                                            },
                                            {
                                                "example_id": "7241f961-552e-41e7-a0ee-0df909998fcd",
                                                "sense_id": "f0653d1e-747a-3065-8d48-b32c7975a016",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "41a776db-8717-46d7-b122-fe10f470d7dd",
                                                "sense_id": "f0653d1e-747a-3065-8d48-b32c7975a016",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3101092-7650-3a72-a0e8-bc5ca5e0cbcf",
                                        "entry_id": "e3032319-e10b-3c3a-9eda-556d12b730b5",
                                        "glosses": [
                                            "A mission by an emergency response service, typically involving attending to an emergency in the field."
                                        ],
