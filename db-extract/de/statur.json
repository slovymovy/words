                        "entry_id": "8a531e0e-f9f5-399e-b6b7-96eeecbca3e2",
                        "glosses": [
                            "äußere Erscheinung, körperliches Erscheinungsbild, Gestalt, Größe, Körperbau, Wuchs (eines Menschen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d040cd8d-cb8d-4769-8510-ccf79d449e67",
                                "sense_id": "09bf8f7a-b4c1-3861-a279-ae756909fc9d",
                                "text": "Der Mann war von großer und kräftiger Statur."
                            },
                            {
                                "example_id": "e45f74f6-ca23-49ad-84d3-378fdddfc1b5",
                                "sense_id": "09bf8f7a-b4c1-3861-a279-ae756909fc9d",
                                "text": "„Seguns Statur erinnert eher an ein scheues Tier, das sich bei der geringsten Gefahr aus dem Staub macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
