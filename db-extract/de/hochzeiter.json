                        "examples": [
                            {
                                "example_id": "f176cf3a-0649-46d4-8552-721d2ed17081",
                                "sense_id": "bb5f85a7-0fe2-398d-8e32-0d49560ca2d8",
                                "text": "Die Hochzeiter haben den Hochzeitsbittern den Auftrag erteilt, die Hochzeitsgäste einzuladen."
                            },
                            {
                                "example_id": "5a19adcd-8ea8-4acf-a62e-1c7939983536",
                                "sense_id": "bb5f85a7-0fe2-398d-8e32-0d49560ca2d8",
                                "text": "„Die Dorfbewohner standen am Straßenrand und warfen Blumen auf Hochzeiter und Gäste, die alle zu Fuß von der Kirche zum Haus der Braut hinaufstiegen.“"
                            }
                        ],
