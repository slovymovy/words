            {
                "entry_id": "e00a5001-4fa1-3bb7-b89f-c875d200eeca",
                "word": "moderniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2607ad27-18e7-4dd0-9f2b-41f80ad13afc",
                        "entry_id": "e00a5001-4fa1-3bb7-b89f-c875d200eeca",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "modernistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca450be5-e658-3da2-80d7-8fdfde8ab97c",
                        "entry_id": "e00a5001-4fa1-3bb7-b89f-c875d200eeca",
                        "glosses": [
                            "(Historiographie) Celui, celle qui se consacre à l’étude de l’époque dite « moderne »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1d3520-0197-4eaa-a8dd-833eb24e9ef4",
                                "sense_id": "ca450be5-e658-3da2-80d7-8fdfde8ab97c",
                                "text": "M. Blanche ne m’en voudra pas, je veux l’espérer, si je lui dis que jusqu’à présent on le considérait surtout comme un portraitiste habile, comme un moderniste curieux."
                            },
                            {
                                "example_id": "19a400e2-1960-4cf2-b93b-fba2d784fa41",
                                "sense_id": "ca450be5-e658-3da2-80d7-8fdfde8ab97c",
                                "text": "Les antiquistes, les médiévistes, les modernistes, les contemporanéistes, sans compter les préhistoriens, les archéologues, ont tous largement abordé l’objet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78c7811d-17a8-419b-80df-bb8a9fd01324",
                        "source_entry_id": "e00a5001-4fa1-3bb7-b89f-c875d200eeca",
                        "source_sense_id": "ca450be5-e658-3da2-80d7-8fdfde8ab97c",
                        "target_lang_word": "Modernist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Modernist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                        "entry_id": "b3dab6f9-d78c-3e28-8986-d09ab6e45335",
                                        "glosses": [
                                            "Person, die der modernistischen Strömung angehört beziehungsweise den Modernismus unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56aae070-303b-4919-ac0a-837658887c97",
                                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                                "text": "„Die ersten Jahre waren durch Spannungen zwischen Modernisten und Traditionalisten gekennzeichnet.“"
                                            },
                                            {
                                                "example_id": "e369d4cb-b8c4-4cdf-9db7-b6f10df1c71e",
                                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                                "text": "„Als Modernisten galten danach alle jene, die neue Gebräuche in die Kirche einführen wollen, sei es in der Liturgie oder Pastoral oder hinsichtlich disziplinärer und kanonistischer Vorschriften bis hin zur Infragestellung des Zölibats.“"
                                            },
                                            {
                                                "example_id": "204cf998-ba43-478c-b4d7-d1e43632433a",
                                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                                "text": "„Ein nicht geringer Teil der ägyptischen Modernisten dieser Zeit waren Christen, die Europa und die Aufklärung prinzipiell nicht als Fremdkonzepte, sondern als Bestandteile ihrer eigenen Kultur auffaßten.“"
                                            },
                                            {
                                                "example_id": "b5f6465c-40fe-4e96-9887-dc45bff80968",
                                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                                "text": "„Allen Modernisten gemeinsam war damit die Absage an die älteren moralischen und ästhetischen Normen der bürgerlichen Literatur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
