                ],
                "senses": [
                    {
                        "sense_id": "189ca9b2-6560-3cfa-893c-622f9ea75699",
                        "entry_id": "e1b34f71-2184-3bf6-96b2-fcab20635234",
                        "glosses": [
                            "Crotalus gifslang uit de familie adders (Viperidae), onderfamilie groefkopadders (Crotalinae), meest bekend van de staartpunt die een ratel draagt"
                        ],
                        "tags": [
                            "reptielen"
                        ],
                        "examples": [
                            {
                                "example_id": "c219e065-b699-4302-8ed5-02a968c4e395",
                                "sense_id": "189ca9b2-6560-3cfa-893c-622f9ea75699",
                                "text": "Blijkbaar werkte mijn actie wel, dus ik schopte nogmaals wat zand waardoor de ratelslang sierlijk de struiken ingleed. Ik wachtte een paar minuten tot de kust echt veilig was."
                            },
                            {
                                "example_id": "8f96f103-df8b-41ef-a713-f14c67ae9b69",
                                "sense_id": "189ca9b2-6560-3cfa-893c-622f9ea75699",
                                "text": "Zo zag ik erg op tegen onbekende gevaren op de trail zoals ratelslangen, beren, steile bergen, felle zon en hoge temperaturen in de woestijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cd1cd4c-11b5-4d5f-aec3-903f5df10d60",
                        "source_entry_id": "e1b34f71-2184-3bf6-96b2-fcab20635234",
                        "source_sense_id": "189ca9b2-6560-3cfa-893c-622f9ea75699",
                        "source_sense_description": "gifslang uit het geslacht Crotalus",
                        "target_lang_word": "Klapperschlange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klapperschlange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "153d3070-72c8-3ca9-920a-52125a5f451c",
                                        "entry_id": "979404a1-e61d-3ce1-b72d-5234b8e1d879",
                                        "glosses": [
                                            "Giftschlange mit losen Hornringen am Schwanzende, womit sie rasseln kann; Vertreter der Gattung Crotalus oder Sistrurus (eigentlich Zwergklapperschlange) der Grubenottern"
                                        ],
                                        "tags": [
                                            "Herpetologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d3a8757-576a-43be-a32b-cdd511774f0d",
                                                "sense_id": "153d3070-72c8-3ca9-920a-52125a5f451c",
                                                "text": "Die Klapperschlange macht sich mit ihrem Rasseln oft rechtzeitig bemerkbar."
                                            },
                                            {
                                                "example_id": "16b8ce2d-653d-42c6-b9e1-b0e3443f38af",
                                                "sense_id": "153d3070-72c8-3ca9-920a-52125a5f451c",
                                                "text": "Es klapperten die Klapperschlangen, bis ihre Klappern schlapper klangen. (Zungenbrecher)"
                                            },
                                            {
                                                "example_id": "12e22a4a-bb1a-490e-9edb-9750b071ca2e",
                                                "sense_id": "153d3070-72c8-3ca9-920a-52125a5f451c",
                                                "text": "„Die Klapperschlange lag neben ihm auf dem Lehrerpult. So nannten wir seinen dünnen Rohrstock.“"
                                            },
                                            {
                                                "example_id": "405c0f10-4993-43d6-8ec2-76d692e309be",
                                                "sense_id": "153d3070-72c8-3ca9-920a-52125a5f451c",
                                                "text": "„Bitte senden Sie mir eine Liste aller Ärzte in Australien, die Gegengift gegen den Biss von Klapperschlangen vorrätig haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3778cf3d-7c77-4936-b537-69da784e4a34",
                        "source_entry_id": "e1b34f71-2184-3bf6-96b2-fcab20635234",
                        "source_sense_id": "189ca9b2-6560-3cfa-893c-622f9ea75699",
                        "source_sense_description": "gifslang uit het geslacht Crotalus",
                        "target_lang_word": "rattlesnake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rattlesnake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b19f1c9a-f06d-3b31-b6f9-cdd5eb48b00d",
                                        "entry_id": "a48eadc5-b459-337a-81cb-1b454c101c98",
                                        "glosses": [
                                            "Any of various venomous American snakes, of genera Crotalus and Sistrurus, having a rattle at the end of its tail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8675cad6-9d4a-4ecd-93c2-7076c6acdbc1",
                                                "sense_id": "b19f1c9a-f06d-3b31-b6f9-cdd5eb48b00d",
                                                "text": "Hooded rattlesnakes, horned toads, and lizards crawl in the dust and among the rocks."
                                            },
                                            {
                                                "example_id": "aec55761-e6fa-46f7-8092-1fbf2d64dc28",
                                                "sense_id": "b19f1c9a-f06d-3b31-b6f9-cdd5eb48b00d",
                                                "text": "The country ran shuttles and posted signs encouraging visitors to enjoy the display responsibly, but those precautions didn't prevent rattlesnake bites, twisted ankles, heat exhaustion, Instacelebs and other selfie-takers lying in or otherwise trampling the delicate blooms they'd come to see."
                                            },
                                            {
                                                "example_id": "ca52ad2c-ea69-4042-8620-622f3b409c9f",
                                                "sense_id": "b19f1c9a-f06d-3b31-b6f9-cdd5eb48b00d",
                                                "text": "Generally not aggressive, rattlesnakes strike when threatened or deliberately provoked, but given room they will retreat. Most snake bites occur when a rattlesnake is handled or accidentally touched by someone walking or climbing. The majority of snakebites occur on the hands, feet and ankles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79413f4a-6b8c-48a9-94c2-60c88ffc3f5a",
                        "source_entry_id": "e1b34f71-2184-3bf6-96b2-fcab20635234",
                        "source_sense_id": "189ca9b2-6560-3cfa-893c-622f9ea75699",
                        "source_sense_description": "gifslang uit het geslacht Crotalus",
                        "target_lang_word": "serpent à sonnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serpent à sonnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "884de3d7-9ae8-37bb-9b8e-a57f1a225dca",
                                        "entry_id": "9c760ec4-aebc-3272-9009-c4978cbd0918",
                                        "glosses": [
                                            "Vipère du genre biologique Crotalus (à l'exception des catalinensis) ou Sistrurus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab652617-81a9-45dc-a4d4-0ec1fd522985",
                                                "sense_id": "884de3d7-9ae8-37bb-9b8e-a57f1a225dca",
                                                "text": "Nous n’avons pas de serpent à sonnettes par chez nous et le seul de l’espèce dite « tête de cuivre », que nous avons pu identifier, a été tué par mes soins sur-le-champ."
                                            },
                                            {
                                                "example_id": "8d17166a-3832-4a0e-a781-c174e3bcacb1",
                                                "sense_id": "884de3d7-9ae8-37bb-9b8e-a57f1a225dca",
                                                "text": "Lorsque Augustus sortit sous le porche, les cochons bleus étaient en train de manger un serpent à sonnette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
