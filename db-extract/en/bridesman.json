                        "sense_id": "0cbdbb93-0d4f-30d9-8d6c-1c8377261544",
                        "entry_id": "09e646f4-e461-32a1-940d-9f560ec12d3e",
                        "glosses": [
                            "A male friend or companion of the bridegroom, having various ceremonial duties at a wedding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2537c899-8104-44cd-822c-54f115d94cee",
                                "sense_id": "0cbdbb93-0d4f-30d9-8d6c-1c8377261544",
                                "text": "It was customary, in those days, for the bride's-man and maiden, and a few select friends, to visit the newly married couple after they had retired to rest […]."
                            },
                            {
                                "example_id": "f5635168-e159-4136-afd4-86f21c920c60",
                                "sense_id": "0cbdbb93-0d4f-30d9-8d6c-1c8377261544",
                                "text": "According to him, on the following Thursday, the bridesmen, numbering “six, eight, even ten or more,” rode on horseback with four wagons to get the bride."
                            }
                        ]
                    },
                    {
                        "sense_id": "f43f232c-595a-3c94-85d1-9ddb4441fef5",
                        "entry_id": "09e646f4-e461-32a1-940d-9f560ec12d3e",
                        "glosses": [
                            "A male bridesmaid; a man who attends a bride during her wedding ceremony, as part of the wedding party."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88230465-1130-4d34-b233-1483bdc0c50c",
                                "sense_id": "f43f232c-595a-3c94-85d1-9ddb4441fef5",
                                "text": "She might be renting a tux, however, as she is willing to have a bridesman."
                            }
                        ]
                    }
                ],
