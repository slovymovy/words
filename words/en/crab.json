{
    "word_family": [
        "crabby",
        "crabber",
        "crabgrass",
        "crabstick"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa20a6fc-5e1b-392b-a5d9-2a93af68b3b3",
                    "sense_definition": "A sea creature with five pairs of legs, a hard shell, and two large claws.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a small <crab> bury itself in the wet sand.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как маленький <краб> зарывается в мокрый песок.",
                                "zh": "我们看着一只小<w>螃蟹</w>钻进湿沙里。"
                            }
                        },
                        {
                            "text": "The <crab> scuttled sideways across the beach to reach the water.",
                            "target_lang_translations": {
                                "ru": "<Краб> боком побежал по пляжу к воде.",
                                "zh": "那只<w>螃蟹</w>横着快速爬过海滩，朝水边去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hermit crab",
                        "horseshoe crab",
                        "king crab",
                        "blue crab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морское существо с пятью парами ног, твердым панцирем и двумя большими клешнями.",
                        "zh": "一种海生甲壳动物，有五对足、坚硬的外壳和两只大螯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краб",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "螃蟹",
                                "target_lang_sense_clarification": "动物"
                            },
                            {
                                "target_lang_word": "蟹",
                                "target_lang_sense_clarification": "较书面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3db27d65-41bf-37f2-b275-9903d0768ee8",
                    "sense_definition": "The meat of a crab eaten as food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My favorite appetizer at this restaurant is the spicy <crab> cake.",
                            "target_lang_translations": {
                                "ru": "Моя любимая закуска в этом ресторане — острая котлета из <краба>.",
                                "zh": "这家餐厅里我最喜欢的开胃菜是辣味<w>蟹肉</w>饼。"
                            }
                        },
                        {
                            "text": "She avoids eating <crab> because of her severe shellfish allergy.",
                            "target_lang_translations": {
                                "ru": "Она избегает есть <крабов> из-за сильной аллергии на моллюсков.",
                                "zh": "她因为对贝类严重过敏，所以不吃<w>螃蟹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crab cake",
                        "crab meat",
                        "dressed crab",
                        "crab salad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо краба, употребляемое в пищу.",
                        "zh": "作为食物食用的螃蟹肉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краб",
                                "target_lang_sense_clarification": "еда"
                            },
                            {
                                "target_lang_word": "крабовое мясо",
                                "target_lang_sense_clarification": "продукт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蟹肉",
                                "target_lang_sense_clarification": "食物"
                            },
                            {
                                "target_lang_word": "螃蟹",
                                "target_lang_sense_clarification": "作为食材或菜品时也可这样说"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61ba1473-61ac-3404-ab24-921419bbd8b5",
                    "sense_definition": "A person who is bad-tempered, grumpy, or easily annoyed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He becomes a real <crab> if he doesn't get enough sleep.",
                            "target_lang_translations": {
                                "ru": "Он становится настоящим <брюзгой>, если не высыпается.",
                                "zh": "他要是睡不够，就会变成一个十足的<w>脾气坏的人</w>。"
                            }
                        },
                        {
                            "text": "Don't be such a <crab> just because we had to change the plans.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <ворчуном> только из-за того, что нам пришлось изменить планы.",
                                "zh": "别因为我们不得不改计划，就变成个<w>爱抱怨的人</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "old crab"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с плохим характером, сварливый или легко раздражающийся.",
                        "zh": "指脾气坏、爱生气或容易烦躁的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюзга",
                                "target_lang_sense_clarification": "человек"
                            },
                            {
                                "target_lang_word": "ворчун",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脾气坏的人",
                                "target_lang_sense_clarification": "指人，口语"
                            },
                            {
                                "target_lang_word": "爱抱怨的人",
                                "target_lang_sense_clarification": "指人，强调爱发牢骚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2aac3c-cdb5-3a61-a61c-7ef3fd67a09f",
                    "sense_definition": "An infestation of lice that live in pubic hair.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a special shampoo to treat the <crabs>.",
                            "target_lang_translations": {
                                "ru": "Врач прописал специальный шампунь для лечения <лобковых вшей>.",
                                "zh": "医生开了一种专用洗剂来治疗<w>阴虱</w>。"
                            }
                        },
                        {
                            "text": "He was horrified to discover he had caught <crabs>.",
                            "target_lang_translations": {
                                "ru": "Он пришел в ужас, обнаружив, что подцепил <мандавошек>.",
                                "zh": "他惊恐地发现自己染上了<w>阴虱</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заражение вшами, живущими в лобковых волосах.",
                        "zh": "阴毛部位滋生阴虱的感染。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лобковые вши",
                                "target_lang_sense_clarification": "медицина"
                            },
                            {
                                "target_lang_word": "мандавошки",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴虱",
                                "target_lang_sense_clarification": "医学常用说法"
                            },
                            {
                                "target_lang_word": "阴虱感染",
                                "target_lang_sense_clarification": "更明确指感染"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "152068a7-0871-3bdb-b827-fa90454b4909",
                    "sense_definition": "A small, sour wild apple.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild <crab> is too sour to eat raw but makes excellent jelly.",
                            "target_lang_translations": {
                                "ru": "Это дикое <яблоко> слишком кислое, чтобы есть его сырым, но из него получается отличное желе.",
                                "zh": "这种野生<w>野苹果</w>太酸，不适合生吃，但做成果冻却很好。"
                            }
                        },
                        {
                            "text": "They planted a flowering <crab> in the front yard for decoration.",
                            "target_lang_translations": {
                                "ru": "Они посадили цветущую <дикую яблоню> в палисаднике для украшения.",
                                "zh": "他们在前院种了一棵开花的<w>野苹果树</w>作装饰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crab apple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькое кислое дикое яблоко.",
                        "zh": "一种个头较小、味道酸的野生苹果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дикое яблоко",
                                "target_lang_sense_clarification": "фрукт"
                            },
                            {
                                "target_lang_word": "дичка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "野苹果",
                                "target_lang_sense_clarification": "通俗说法"
                            },
                            {
                                "target_lang_word": "海棠果",
                                "target_lang_sense_clarification": "常见对应物种名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a4ff303-b5de-3992-b78f-16b1af641fd5",
                    "sense_definition": "To hunt or fish for crabs.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed <crabbing> from the wooden pier all afternoon.",
                            "target_lang_translations": {
                                "ru": "Детям нравилось <ловить крабов> с деревянного пирса весь день.",
                                "zh": "孩子们整个下午都喜欢在木码头上<w>捉螃蟹</w>。"
                            }
                        },
                        {
                            "text": "We went <crabbing> at low tide and caught a bucketful for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы ходили <ловить крабов> во время отлива и наловили целое ведро на ужин.",
                                "zh": "我们在退潮时去<w>捉螃蟹</w>，抓了满满一桶当晚饭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go crabbing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охотиться или ловить крабов.",
                        "zh": "捕捉螃蟹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить крабов",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捉螃蟹",
                                "target_lang_sense_clarification": "口语常用"
                            },
                            {
                                "target_lang_word": "捕蟹",
                                "target_lang_sense_clarification": "较书面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0c5cd14-0dd7-313b-bddb-b8de08f39ef8",
                    "sense_definition": "To move sideways or in a diagonal direction, often awkwardly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot <crabbed> the plane to compensate for the strong crosswind.",
                            "target_lang_translations": {
                                "ru": "Пилот <развернул> самолет <боком>, чтобы компенсировать сильный боковой ветер.",
                                "zh": "飞行员让飞机<w>斜着前进</w>，以抵消强烈的侧风。"
                            }
                        },
                        {
                            "text": "The injured dog <crabbed> sideways across the floor to avoid putting weight on its leg.",
                            "target_lang_translations": {
                                "ru": "Раненая собака <двигалась> боком по полу, чтобы не наступать на больную лапу.",
                                "zh": "那只受伤的狗为了不让伤腿承重，<w>横着移动</w>穿过了地板。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться боком или по диагонали, часто неуклюже.",
                        "zh": "侧着或斜着移动，通常显得有些别扭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двигаться боком",
                                "target_lang_sense_clarification": "движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "横着移动",
                                "target_lang_sense_clarification": "一般动作"
                            },
                            {
                                "target_lang_word": "斜着前进",
                                "target_lang_sense_clarification": "强调方向偏斜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec7aa92-efcb-3c9d-a79c-33bd34ed9566",
                    "sense_definition": "To complain or find fault with something in an annoying way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is always <crabbing> about the high cost of living in the city.",
                            "target_lang_translations": {
                                "ru": "Он вечно <ворчит> по поводу высокой стоимости жизни в городе.",
                                "zh": "他总是在<w>抱怨</w>城里的生活成本太高。"
                            }
                        },
                        {
                            "text": "She <crabbed> at her husband for forgetting to buy the groceries.",
                            "target_lang_translations": {
                                "ru": "Она <поворчала> на мужа за то, что он забыл купить продукты.",
                                "zh": "她因为丈夫忘了买杂货而对他<w>发牢骚</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жаловаться или придираться к чему-либо раздражающим образом.",
                        "zh": "以令人厌烦的方式抱怨或挑毛病。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "поведение"
                            },
                            {
                                "target_lang_word": "брюзжать",
                                "target_lang_sense_clarification": "поведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "常用"
                            },
                            {
                                "target_lang_word": "发牢骚",
                                "target_lang_sense_clarification": "口语，带烦人语气"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}