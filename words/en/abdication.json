{
    "word_family": [
        "abdicate",
        "abdicant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39824326-ff26-3c87-b2d0-37ef0f63fadb",
                    "sense_definition": "The formal act of giving up a high office, dignity, or position of trust.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "renunciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>abdication</w> of the prime minister caused significant political instability across the entire country.",
                            "target_lang_translations": {
                                "zh": "总理突然<w>辞职</w>，导致全国政局动荡不安。"
                            }
                        },
                        {
                            "text": "Historians often debate the underlying reasons for the <w>abdication</w> of such a powerful and influential leader.",
                            "target_lang_translations": {
                                "zh": "历史学家经常探讨这位权势显赫的领导人<w>退位</w>的深层原因。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resignation",
                        "renunciation"
                    ],
                    "common_phrases": [
                        "formal abdication"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式放弃高级职位、尊严或受托职位的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辞职",
                                "target_lang_sense_clarification": "指放弃职位或职务。"
                            },
                            {
                                "target_lang_word": "退位",
                                "target_lang_sense_clarification": "指放弃权力或地位。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9a5055b-d030-34ee-a945-c3547acebd8f",
                    "sense_definition": "The voluntary act of a monarch giving up their sovereign power or throne.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "renunciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king announced his <w>abdication</w> to the public after decades of ruling the nation.",
                            "target_lang_translations": {
                                "zh": "国王在统治国家数十年后，向公众宣布<w>退位</w>。"
                            }
                        },
                        {
                            "text": "Many citizens were shocked by the unexpected <w>abdication</w> of the throne by the beloved monarch.",
                            "target_lang_translations": {
                                "zh": "许多公民对这位受人爱戴的君主突然<w>退位</w>感到震惊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resignation"
                    ],
                    "common_phrases": [
                        "abdication of the throne"
                    ],
                    "target_lang_definitions": {
                        "zh": "君主自愿放弃主权或王位的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "退位",
                                "target_lang_sense_clarification": "专指君主放弃王位。"
                            },
                            {
                                "target_lang_word": "逊位",
                                "target_lang_sense_clarification": "指君主让出王位，较为正式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c42da596-70eb-31a1-abe9-ef83c9f543fa",
                    "sense_definition": "The act of giving up a legal claim, interest in property, or responsibility.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "renunciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal document confirmed the <w>abdication</w> of all his rights to the family estate.",
                            "target_lang_translations": {
                                "zh": "法律文件确认他已<w>放弃</w>了对家族遗产的所有权利。"
                            }
                        },
                        {
                            "text": "His <w>abdication</w> of responsibility for the project led to its eventual failure and closure.",
                            "target_lang_translations": {
                                "zh": "他对自己负责的项目<w>推卸</w>责任，最终导致项目失败并关闭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abandonment",
                        "relinquishment"
                    ],
                    "target_lang_definitions": {
                        "zh": "放弃法律权利、财产权益或责任的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "指丢弃权利或责任。"
                            },
                            {
                                "target_lang_word": "推卸",
                                "target_lang_sense_clarification": "特指逃避责任。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc01325f-1041-3f15-a74f-e3ed896f9bfd",
                    "sense_definition": "The act of disowning or formally rejecting a child.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "renunciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical records describe the <w>abdication</w> of the heir, who was subsequently removed from the royal line.",
                            "target_lang_translations": {
                                "zh": "历史记录描述了继承人被<w>废黜</w>的过程，他随后被逐出了皇室继承序列。"
                            }
                        },
                        {
                            "text": "Such a harsh <w>abdication</w> of parental duty was considered scandalous in the society of that time.",
                            "target_lang_translations": {
                                "zh": "在当时的社会，这种对父母职责的冷酷<w>放弃</w>被视为丑闻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disinheritance",
                        "disowning"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "断绝亲子关系或正式拒绝承认子女的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "断绝关系",
                                "target_lang_sense_clarification": "指正式解除亲属关系。"
                            },
                            {
                                "target_lang_word": "废黜",
                                "target_lang_sense_clarification": "指取消继承权。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05260a69-a09b-3687-b264-458a30b91939",
                    "sense_definition": "The state of being forced to leave a position of power.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "renunciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The revolution resulted in the forced <w>abdication</w> of the dictator from his seat of power.",
                            "target_lang_translations": {
                                "zh": "革命导致独裁者被迫<w>下台</w>。"
                            }
                        },
                        {
                            "text": "Following the military coup, the <w>abdication</w> of the ruling council was immediate and absolute.",
                            "target_lang_translations": {
                                "zh": "军事政变后，执政委员会立即且彻底地<w>下台</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deposition",
                        "removal"
                    ],
                    "target_lang_definitions": {
                        "zh": "被迫离开权力职位的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "下台",
                                "target_lang_sense_clarification": "指被迫离开权力中心。"
                            },
                            {
                                "target_lang_word": "被废黜",
                                "target_lang_sense_clarification": "指被强行剥夺权力。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}