                                "target_senses": [
                                    {
                                        "sense_id": "8c5d7dd6-dd98-3ad1-851b-c826fdfe39fa",
                                        "entry_id": "341733be-a311-35cd-8c9e-87aada705454",
                                        "glosses": [
                                            "Creating or producing excitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9509b2a1-721d-4c4f-bd92-b1a937eca237",
                                                "sense_id": "8c5d7dd6-dd98-3ad1-851b-c826fdfe39fa",
                                                "text": "Some of the most exciting games ever played have ended in draws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f56d122f-001a-3315-a690-81283bca5e6c",
                                        "entry_id": "341733be-a311-35cd-8c9e-87aada705454",
                                        "glosses": [
                                            "Sexually stimulating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64753531-ea15-4511-83f1-00fe418fa862",
                                                "sense_id": "f56d122f-001a-3315-a690-81283bca5e6c",
                                                "text": "Among the Turks, an exciting compound consists of olibanum, myrrh, camphor, musk, in pulverized form. The resultant perfume is said to affect the genitals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exciting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b118f3c6-61d6-327d-8a6b-69f666a7a095",
                                        "entry_id": "15744f44-1091-3604-a13f-5795eb01ae50",
                                        "glosses": [
                                            "The process of something becoming excited; excitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1a10bd-19af-4bda-8128-e314c24be26e",
                                                "sense_id": "b118f3c6-61d6-327d-8a6b-69f666a7a095",
                                                "text": "But parents and masters should make haste in this, as to a great purchase for their children and servants; which while they defer, both sides suffer; the one, in wanting many excitings of grace, the other, in being worse served and obeyed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50d285fb-1749-42d9-a197-880cab65d41d",
                        "source_entry_id": "7c89fbfb-b8d0-356c-8505-177b1158e14d",
                        "source_sense_id": "25102d23-2e67-3607-82a8-8030493eec29",
                        "target_lang_word": "passionnant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passionnant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                        "entry_id": "fdb56cc1-716b-3b02-8c51-399922d0fb45",
                                        "glosses": [
                                            "Qui passionne, qui est propre à passionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f515f21b-224d-4084-a1aa-3f3b688c05fc",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "La Canasta peut réunir de deux à six joueurs ; mais elle est surtout passionnante quand elle peut être pratiquée par deux équipes de deux joueurs."
                                            },
                                            {
                                                "example_id": "a3b1894f-e727-4354-b25c-26fe27d39b98",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "Fort heureusement pour moi, il n’eut pas le temps de m'expliquer plus avant tout l'intérêt qu’offrait la manière dont il eût souhaité que je conjuguasse mes verbes. Quelqu'un, en effet, venait d'arriver, interrompant dans l’œuf un développement qui risquait d'être plus passionné que passionnant."
                                            },
                                            {
                                                "example_id": "414f8e9a-7555-4c7b-9ff9-ebe93a563403",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "Parce que Charlie Roquin a le talent de nous émerveiller dans ces joutes oratoires wagnériennes, passionnantes, tout en maintenant une pression sur le lecteur quant à l’issue de cette confrontation."
                                            }
                                        ]
                                    }
                                ]
                            },
