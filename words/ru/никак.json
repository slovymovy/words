                            {
                                "target_lang_word": "still",
                                "target_lang_sense_clarification": "indicating a situation continuing longer than expected"
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "emphasizing the persistence of a negative situation"
                            }
                        ],
                        "zh": [
                            {
