                    {
                        "sense_id": "8c1591d0-df6b-3ea7-bfbd-c95e48cf814f",
                        "entry_id": "d8e3a8a0-f06d-31a9-88a8-c30ef5acf65c",
                        "glosses": [
                            "behorend tot of betrekking hebbend op de Roma, een volk in Europa en Azië dat traditioneel een zwervend bestaan leidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "708a0ac2-b002-4956-bfe3-644b5d115170",
                                "sense_id": "8c1591d0-df6b-3ea7-bfbd-c95e48cf814f",
                                "text": "De overige Roma en Sinti organisaties begeven zich vooral op lokaal terrein. De enige landelijke organisatie die wij nog noemen, is de Landelijke Stichting “Roma Emancipatie” te Oss. Deze stichting is in 1998 opgericht door een Roma vluchteling uit Macedonië."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2c9bf81d-9d9a-34cd-8b75-6cff30d1fa86",
                "word": "Roma",
                "pos": "name",
                "lang_code": "nl",
