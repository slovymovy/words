                "senses": [
                    {
                        "sense_id": "d91c2127-9345-35e5-a416-a5b669a8e9d1",
                        "entry_id": "bd76f256-adf9-3167-8a30-8e71884e6b4b",
                        "glosses": [
                            "Gerät mit Mängeln"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9b44c418-61d7-43e0-8070-e5dbbb0286bd",
                                "sense_id": "d91c2127-9345-35e5-a416-a5b669a8e9d1",
                                "text": "„Das war ein irrer Klapperatismus, der den halben Eßtisch einnahm.“"
                            },
                            {
                                "example_id": "63538a21-cd3b-4592-a6dc-2624a1bcd792",
                                "sense_id": "d91c2127-9345-35e5-a416-a5b669a8e9d1",
                                "text": "„Sie stellt ein elastisches, sich selbst regulierendes kybernetisches System dar, mit dem verglichen die sozialistische Planwirtschaft eher den Charakter eines starren \"Klapperatismus\" mit Hebeln und mit Schrauben hat.“"
                            },
                            {
                                "example_id": "91878a5c-0021-466c-8f41-f0d738d5708f",
                                "sense_id": "d91c2127-9345-35e5-a416-a5b669a8e9d1",
                                "text": "„Doch die Klapperatismen funktionierten auch beim wiederholten Mal, sie drehten sich und gaben Töne von sich oder Pingpong-Bälle, leierten, sägten, pumpten, klapperten und zischten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
