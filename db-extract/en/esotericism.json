                    },
                    {
                        "translation_id": "d16cc57e-cabd-4d0b-be29-785fab0baf8e",
                        "source_entry_id": "83f697c9-3c9b-3434-8876-0eab018142fe",
                        "source_sense_description": "tendency",
                        "target_lang_word": "Esoterik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esoterik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                        "entry_id": "fb13a798-9c09-3fcb-865d-1797be640659",
                                        "glosses": [
                                            "Sammelbegriff für ein weites Spektrum an Weltanschauungen, welche die spirituelle Entwicklung des Individuums betonen, jedoch keine Religion im engeren Sinn sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2181247c-2a84-4f20-85e5-c0a8d34899f7",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "Die Esoterik hat in den letzten Jahrzehnten viele Anhänger gewonnen."
                                            },
                                            {
                                                "example_id": "22af7c25-382d-4feb-859b-55b7a221f16c",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "Die Esoterik nahm Einflüsse aus den asiatischen Religionen auf."
                                            },
                                            {
                                                "example_id": "a01b3cf4-bcf7-4601-ba12-1cb88888e3e7",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "„Daher ist das heutige Schlagwort »Esoterik« als Bezeichnung für eine neue und alternative Religiosität zu verstehen.“"
                                            },
                                            {
                                                "example_id": "e7f18b8f-db80-429c-932d-afbc6879792b",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "„Seit dem 16. Jahrhundert werden die Zigeuner für die Esoterik wichtige mögliche Träger alten paganen Wissens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cd297e3-e98d-311f-96c9-10a8ef4f40f1",
                                        "entry_id": "fb13a798-9c09-3fcb-865d-1797be640659",
                                        "glosses": [
                                            "die Eigenschaft, ausgefallen, selten oder fernliegend zu sein und damit nur Eingeweihten zugänglich zu sein"
                                        ],
                                        "tags": [
                                            "Geistesleben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "126b34e7-7e1a-4807-a881-e97d4008e1d6",
                                                "sense_id": "7cd297e3-e98d-311f-96c9-10a8ef4f40f1",
                                                "text": "Die Esoterik ihrer Frage lässt mich vermuten, dass sie selbst auf diesem Feld geforscht haben?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
