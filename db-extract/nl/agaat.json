                                            {
                                                "example_id": "a6a3dc3d-5d56-40c1-8426-1451f22a112c",
                                                "sense_id": "a85b999e-c64d-3fa7-b07d-3a9371fac6c2",
                                                "text": "Durch Färbung und Zeichnung ausgezeichnete Achate wurden schon von jeher zu geschnittenen Steinen verarbeitet."
                                            },
                                            {
                                                "example_id": "aaf05b2d-b963-4d17-a0d5-7fc4fb7a9917",
                                                "sense_id": "a85b999e-c64d-3fa7-b07d-3a9371fac6c2",
                                                "text": "„Mir erteilte er ihn sehr nachdrücklich und schenkte mir noch einen Rosenkranz aus Achat mit einem dünnen Goldkettchen, der wohl zwölf Zechinen wert war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
