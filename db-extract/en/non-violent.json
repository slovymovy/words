                    },
                    {
                        "translation_id": "25364805-5bde-4669-8d0a-bce3b1a38840",
                        "source_entry_id": "541f3c69-2aab-3508-8896-8bed8e03a496",
                        "source_sense_description": "without violence",
                        "target_lang_word": "gewaltlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewaltlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                        "entry_id": "9d95649c-9824-3046-b0ac-f143e314af72",
                                        "glosses": [
                                            "ohne Gewalt; keine Gewalt anwendend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4f1bfe4-24b5-46f5-b64d-8bb20726d212",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Einschränkend muß wohl hinzugefügt werden, daß der Ursprungstext unter dem Einfluß des Taoismus stand, einer der gewaltlosesten Religionen überhaupt."
                                            },
                                            {
                                                "example_id": "ec2b47f9-1015-4c68-ac3a-c1cfa50ed598",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Die Wende in der ehemaligen DDR war eine gewaltlose Änderung des politischen Systems."
                                            },
                                            {
                                                "example_id": "771996d1-1d7c-4ceb-809e-557918fee9e6",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Das Aushängen der Tür ist gewaltloser als das Öffnen mittels Axt."
                                            },
                                            {
                                                "example_id": "2b1e9e37-49bc-4f9f-9510-e14e67076e62",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Am gewaltlosesten ist die Auseinandersetzung mit Worten."
                                            },
                                            {
                                                "example_id": "2f4a06a0-8e3c-4c10-8d8e-3f20720fb695",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Eine der gewaltlosesten ist zweifelsfrei die Volksetymologie oder, nach ihrem eigenen Gesetz verdreht, die Volksetymogelei."
                                            },
                                            {
                                                "example_id": "598bf9b4-78df-4b98-9d05-9823ee9ec13d",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Von der erneuerten Position revolutionärer Täterschaft des Poeten aus wendet sich das Ich wieder Tolstoi zu, dem »gewaltlosesten der Täter«."
                                            },
                                            {
                                                "example_id": "adda17c5-801b-469e-81c1-3fa8782c9364",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Am gewaltlosesten ging die Transformation zu einer demokratisch-republikanischen Verfassung auf dem Boden der Freien Hansestadt Bremen vor sich."
                                            },
                                            {
                                                "example_id": "9d2e9220-0e74-43ec-8580-c62451adf3ff",
                                                "sense_id": "dca9d816-2998-313c-b095-f8231b9d464d",
                                                "text": "Es war ihm auch hier um den einfachsten, gewaltlosesten, nächsten Weg zu tun."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "986c3bc3-4219-4fbc-a86a-a0935c947463",
                        "source_entry_id": "541f3c69-2aab-3508-8896-8bed8e03a496",
                        "source_sense_description": "without violence",
                        "target_lang_word": "gewaltfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewaltfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                        "entry_id": "4cc8f5c2-22c2-3ed1-a494-023eb24d545a",
                                        "glosses": [
                                            "ohne Anwendung physischer oder psychischer Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51821a7a-891d-418f-902b-a5541f2a4f2c",
                                                "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                                "text": "Deutschlands Wiedervereinigung lief weitgehend gewaltfrei ab."
                                            },
                                            {
                                                "example_id": "2b6befd0-35d1-4852-b0c4-74e57c567b89",
                                                "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                                "text": "Mit einem Dietrich kann man bestimmte Schlösser gewaltfrei öffnen."
                                            },
                                            {
                                                "example_id": "de819053-aa2a-41c3-afd9-8feee4993f94",
                                                "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                                "text": "Vor zehn Jahren wurde das Recht des Kindes auf eine gewaltfreie Erziehung im deutschen Familienrecht festgelegt."
                                            },
                                            {
                                                "example_id": "5ad1d31c-b298-4636-a845-a2607eb9ff12",
                                                "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                                "text": "Die Aktionen des zivilen Ungehorsams von „Ende Gelände“ sind zwar nicht legal, doch immer gewaltfrei angelegt."
                                            },
                                            {
                                                "example_id": "b85ffff1-30af-4079-929e-0aa798b259c1",
                                                "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                                "text": "Von dem großen Erbe Mahatma Gandhis, unter dem Indien vor 60 Jahren durch gewaltfreien Widerstand seine Unabhängigkeit erhielt, sei fast nichts geblieben, sagt der indische Schriftsteller Kiran Nagarkar."
                                            },
                                            {
                                                "example_id": "a2a7a43b-9d73-46a3-85f9-aa7c10af4871",
                                                "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                                "text": "Es gab […] sowohl Kritik an der Führungsrolle, die [Martin Luther] King einnahm, als auch an seinem Prinzip, ausschließlich gewaltfrei zu protestieren."
                                            },
                                            {
                                                "example_id": "f72671a1-b639-42f2-871f-2906cf6109c4",
                                                "sense_id": "c97e89a1-9cf8-3ae6-8b00-749607d95364",
                                                "text": "Auf die Frage, wann das Konzert ein Erfolg ist, antwortet Campino: „Wenn eine Riesenzahl von Menschen [kommt] und wenn alles gewaltfrei bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
