            "senses": [
                {
                    "sense_id": "9d31ddac-58f5-3bb3-9d2a-2628b7a63f6f",
                    "sense_definition": "Caractère d'une personne qui manque d'assurance en société et manifeste de la réserve ou de la gêne devant autrui.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa grande <w>timidité</w> l'empêche souvent de prendre la parole en public."
                        },
                        {
                            "text": "Avec les années, il a appris à vaincre sa <w>timidité</w> naturelle."
                        }
                    ],
                    "synonyms": [
                        "réserve",
                        "retenue",
                        "introversion"
                    ],
                    "antonyms": [
                        "assurance",
                        "audace",
                        "hardiesse"
                    ],
                    "common_phrases": [
                        "vaincre sa timidité",
                        "grande timidité",
                        "timidité maladive"
                    ]
                },
                {
                    "sense_id": "f415a9ff-13f3-38d3-891e-780ce4400015",
                    "sense_definition": "Sentiment passager d'embarras ou d'appréhension face à une situation sociale particulière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au moment de monter sur scène, elle ressentit une vive <w>timidité</w>."
                        },
                        {
                            "text": "Une soudaine <w>timidité</w> l'a empêché de lui adresser la parole."
                        }
                    ],
                    "synonyms": [
                        "embarras",
                        "gêne",
                        "trouble"
                    ],
                    "antonyms": [
                        "aisance",
                        "aplomb"
                    ],
                    "common_phrases": [
