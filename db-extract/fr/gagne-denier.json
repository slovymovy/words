                "senses": [
                    {
                        "sense_id": "6e9ab3f7-0208-3b51-839e-6b6579d65278",
                        "entry_id": "3893d91d-b0a5-365d-8a33-031c26f0a760",
                        "glosses": [
                            "Sorte de profession qui consistait à faire des commissions pour le service d’autrui à un prix qui, lorsqu’il était question d’affaires pécuniaires, était ordinairement d’un denier par livre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5c38ef0a-2bf2-400e-be9a-0d1f66d30017",
                                "sense_id": "6e9ab3f7-0208-3b51-839e-6b6579d65278",
                                "text": "Contrat de mariage entre Jean Pinot, colporteur suivant la cour, demeurant rue Cassette, paroisse Saint-Sulpice, fils de Pierre Pinot, menuisier, et de Marie Devaux, demeurant rue Férou à Saint-Germain-des-Prés, d’une part, et Jeanne Lange, demeurant rue des Canettes, fille de Cellerin Lange, gagne-denier, et de Nicole Nateu, d’autre part."
                            }
                        ]
                    },
                    {
                        "sense_id": "67815b5a-d580-3182-8add-03b695190564",
                        "entry_id": "3893d91d-b0a5-365d-8a33-031c26f0a760",
                        "glosses": [
                            "Employé subalterne qui avait la charge de mesurer et de tasser le bois dans les membrures en présence des jurés."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "247f34bc-1c11-47b9-8c11-1e6c8fe6203a",
                                "sense_id": "67815b5a-d580-3182-8add-03b695190564",
                                "text": "Il est défendu à tous gagne-deniers de se mêler de procurer des voitures au public sans en être requis"
                            },
                            {
                                "example_id": "d87f49f8-6c8a-412c-814e-8b4013af2cd8",
                                "sense_id": "67815b5a-d580-3182-8add-03b695190564",
                                "text": "Et que nous leur défendons et aux déchargeurs, forts, gagne-deniers et autres de les décharger [les marchandises"
                            }
                        ]
                    },
                    {
                        "sense_id": "c25dad03-fed5-309a-89c8-7ab01565c9cd",
                        "entry_id": "3893d91d-b0a5-365d-8a33-031c26f0a760",
                        "glosses": [
                            "Personne qui gagne sa vie par le travail de son corps, sans savoir de métier."
