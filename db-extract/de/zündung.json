                "senses": [
                    {
                        "sense_id": "3fd00e4b-bd41-3ff1-878e-565142b62251",
                        "entry_id": "149f6d2c-cd6f-31a0-a09e-5874b48b8ccd",
                        "glosses": [
                            "Initiierung einer chemischen Reaktion durch Zuführung von Energie in geeigneter Form (zum Beispiel in Form von Wärme oder Licht) beim Starten eines Verbrennungsmotors oder der Auslösung einer Sprengung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35fb6e8d-44bd-43db-8ea2-779b6a0dc0e6",
                                "sense_id": "3fd00e4b-bd41-3ff1-878e-565142b62251",
                                "text": "Die Verbrennung des Kraftstoff-Luft-Gemischs im Verbrennungsmotor wird durch die Zündung initiiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4532e16d-1408-3542-bb55-bd2baf3ee9c0",
                        "entry_id": "149f6d2c-cd6f-31a0-a09e-5874b48b8ccd",
                        "glosses": [
                            "Bezeichnung für den Zündapparat eines Fahrzeug-Motors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4da9a01-64eb-4690-a090-4a42593d8c7b",
                                "sense_id": "4532e16d-1408-3542-bb55-bd2baf3ee9c0",
                                "text": "An diesem Fahrzeug gibt es ein Problem mit der Zündung."
                            },
                            {
                                "example_id": "dc7dc4e0-0b0a-4fbb-9700-db3e318115fb",
                                "sense_id": "4532e16d-1408-3542-bb55-bd2baf3ee9c0",
                                "text": "Mit Zündung sind alle Teile zur Ansteuerung der funkengebenden Zündkerze gemeint."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
