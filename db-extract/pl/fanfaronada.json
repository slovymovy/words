                                        "sense_id": "42ab5ec4-4dfe-3399-aee0-bc1a459af23e",
                                        "entry_id": "975f368a-1afd-3f45-8da5-783ede0caac2",
                                        "glosses": [
                                            "Pretentiously boastful."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
