                    {
                        "sense_id": "aefbfe3f-f63b-335b-9ea7-baf2314c3b56",
                        "entry_id": "40a0d40c-7835-3a81-8c45-9204ef87fb73",
                        "glosses": [
                            "Épreuve sportive constituée de cinq disciplines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83eff626-eaf8-4e14-a979-64b7c65344f7",
                                "sense_id": "aefbfe3f-f63b-335b-9ea7-baf2314c3b56",
                                "text": "Le pentathlon sous sa forme moderne fut inventé par le baron Pierre de Coubertin."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdd7fdad-2c8e-3909-a25e-f3256795bb59",
                        "entry_id": "40a0d40c-7835-3a81-8c45-9204ef87fb73",
                        "glosses": [
                            "Discipline de l'athlétisme, ancêtre de l'heptathlon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4aba7102-d711-3351-aca7-2285ffca1693",
                        "entry_id": "40a0d40c-7835-3a81-8c45-9204ef87fb73",
                        "glosses": [
                            "Discipline de l'athlétisme féminin en salle comprenant dans l'ordre le 60 m haies, le saut en hauteur, le lancer du poids, le saut en longueur et le 800 m."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf4cf3c-e319-441a-ac5f-5fae295f0501",
                                "sense_id": "4aba7102-d711-3351-aca7-2285ffca1693",
                                "text": "Le pentathlon féminin figura au programme olympique de 1964 à 1980."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f470cc-fc00-44c0-be13-78953cbe08e7",
                        "source_entry_id": "40a0d40c-7835-3a81-8c45-9204ef87fb73",
                        "target_lang_word": "pentathlon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pentathlon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0547252f-8083-3417-a327-241543164f85",
                                        "entry_id": "aa2e43dc-9d9c-3e3b-805b-f9cbcff1c0ae",
                                        "glosses": [
                                            "An ancient athletics discipline, featuring five events: stadion, wrestling, long jump, javelin and discus"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b58f755a-7c83-3f1c-b83b-91d722ce27ec",
                                        "entry_id": "aa2e43dc-9d9c-3e3b-805b-f9cbcff1c0ae",
                                        "glosses": [
                                            "Ellipsis of women's pentathlon (“a 20th-century athletics discipline for women, the women's counterpart of the men's decathlon, the predecessor to the women's heptathlon, featuring five events: hurdles, shot put, high jump, long jump, and a run”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                        "entry_id": "aa2e43dc-9d9c-3e3b-805b-f9cbcff1c0ae",
                                        "glosses": [
                                            "Ellipsis of modern pentathlon, a discipline with five events based on late-19th century basic military skills."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7491e692-63b2-4335-8477-5d5304c06f2c",
                                                "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                                "text": "In the end, why not be happy with both, with the BMXes and the pentathlons, with the swans of synchro and the Quasimodos of wrestling? Sweet."
                                            },
                                            {
                                                "example_id": "e204fa0c-9692-474c-9f55-09be299120aa",
                                                "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                                "text": "Dwindling interest and a reputation for being outdated couldn’t change modern pentathlon. A brief video clip of a coach punching a horse at the Tokyo Olympics has altered it forever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
