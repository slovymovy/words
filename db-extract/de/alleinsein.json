                ],
                "senses": [
                    {
                        "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                        "entry_id": "aa48b730-d8e1-3d6c-8ed5-9c252478247b",
                        "glosses": [
                            "Zustand, in dem jemand für sich allein oder zumindest keine unerwünschte Person anwesend ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf10eeb-7f4e-4b38-8e9c-6791bfb54c79",
                                "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                                "text": "„In Wahrheit aber lag ihr weniger an dem Arzt als an einem Alleinsein und einer Aussprache mit dem geliebten Kinde.“"
                            },
                            {
                                "example_id": "cc1e7659-433e-4c16-a70d-8386022d8613",
                                "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                                "text": "„Sie hatte die Nacht in dem vollen Schlafsaal mit den vierzig bis fünfzig Kameradinnen wie immer zubringen müssen, statt endlich einmal das Alleinsein zu genießen.“"
                            },
                            {
                                "example_id": "44641831-8bc7-4c16-869a-746d73d22e71",
                                "sense_id": "1bdc05da-6f32-3802-b4b4-c5e81377ac49",
                                "text": "„Ich konnte das Alleinsein nicht mehr ertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
