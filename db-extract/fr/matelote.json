                ],
                "senses": [
                    {
                        "sense_id": "ed75bf81-0dc0-34c9-907a-8f8e237b4eb2",
                        "entry_id": "7751781e-eaff-3e11-8ac6-9332fffa9bce",
                        "glosses": [
                            "Mets composé d’une ou de plusieurs sortes de poissons apprêtés avec du vin et des oignons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd0a305-678f-44d6-a18d-221346895791",
                                "sense_id": "ed75bf81-0dc0-34c9-907a-8f8e237b4eb2",
                                "text": "Pour votre malheur, vous vous souvenez de la joyeuse et perverse fille qui avait un petit chapeau rose et qui frétillait dans votre tilbury quand, six ans auparavant, vous aviez passé par là pour aller manger une matelote."
                            },
                            {
                                "example_id": "76ec605d-3143-4ade-8f3e-f79ec6677920",
                                "sense_id": "ed75bf81-0dc0-34c9-907a-8f8e237b4eb2",
                                "text": "À chaque coin d’une grande cheminée bouillaient sur deux réchauds deux casseroles, d’où s’exhalait une double odeur de gibelotte et de matelote qui réjouissait l’odorat."
                            },
                            {
                                "example_id": "9cb525cc-387f-4702-b5c2-b3b9941dc92c",
                                "sense_id": "ed75bf81-0dc0-34c9-907a-8f8e237b4eb2",
                                "text": "C’était une bâtisse surchargée de galeries de bois, que la solitude faisait paraître plus grande, et qui sommeillait dans une paix rustique, en attendant que le dimanche la remplît des rires des filles, des cris des canotiers, de l’odeur des fritures et du fumet des matelotes."
                            },
                            {
                                "example_id": "941e4209-8e2e-4011-a1ec-662a65a7a729",
                                "sense_id": "ed75bf81-0dc0-34c9-907a-8f8e237b4eb2",
                                "text": "J’ai choisi au menu une matelote de la Marne – je ne pouvais faire autrement."
                            }
                        ]
                    },
                    {
                        "sense_id": "541dbeb1-940e-3dfb-a3ee-215b224a74b4",
                        "entry_id": "7751781e-eaff-3e11-8ac6-9332fffa9bce",
                        "glosses": [
                            "Danse pratiquée initialement par les marins français à partir de la fin du xviiᵉ siècle."
                        ],
