                                        "glosses": [
                                            "starogrecki instrument muzyczny, z grupy chordofonów szarpanych, z pudłem rezonansowym zakończonym dwoma ramionami połączonymi jarzmem i strunami z włókna roślinnego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e8e23c-a1e5-432f-b815-7936348f6baa",
                                                "sense_id": "ef5170be-ceca-3817-8a5b-bf0e12a252c6",
                                                "text": "Aojdowie opiewali czyny bogów i herosów, akompaniując sobie na kitarze lub formindze."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
