                "translations": [
                    {
                        "translation_id": "3453ec39-7237-401f-9d3a-3fe18fac369b",
                        "source_entry_id": "2dd2dea4-f01a-3d59-871e-af5f0423f783",
                        "source_sense_id": "900ef547-0644-31e2-b167-ad3b193b72d8",
                        "target_lang_word": "Geldstück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geldstück",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5a148ba-c91a-3b08-a29e-4785ec83c7a5",
                                        "entry_id": "d3605115-7ddf-38de-b51f-7ab34a87c37e",
                                        "glosses": [
                                            "Stück Metall, das einen bestimmten Wert hat und mit dem man daher etwas bezahlen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "847abcb3-5020-4072-bbbb-7313a40265e1",
                                                "sense_id": "c5a148ba-c91a-3b08-a29e-4785ec83c7a5",
                                                "text": "Ich habe leider nur noch ein paar kleine Geldstücke bei mir."
                                            },
                                            {
                                                "example_id": "1f677796-3200-4c2b-8690-39d5b8cc56e0",
                                                "sense_id": "c5a148ba-c91a-3b08-a29e-4785ec83c7a5",
                                                "text": "Geldstücke haben meistens einen geringeren Wert als Geldscheine."
                                            },
                                            {
                                                "example_id": "39aee56a-63e5-4136-8e93-79097ffda60c",
                                                "sense_id": "c5a148ba-c91a-3b08-a29e-4785ec83c7a5",
                                                "text": "„Da nahm der Mann das Geldstück und legte es neben sich aufs Pult, worauf er wieder mit seinen Papieren zu arbeiten begann.“"
                                            },
                                            {
                                                "example_id": "ba835679-fcf3-4fa7-af16-677e568503ff",
                                                "sense_id": "c5a148ba-c91a-3b08-a29e-4785ec83c7a5",
                                                "text": "„Der Farmer nahm das Geldstück und steckte es in die Tasche, wobei er seine Hand bis in den untersten Zipfel stieß.“"
                                            },
                                            {
                                                "example_id": "7b39ac5e-a83a-4a59-9d78-aaa2900f12e0",
                                                "sense_id": "c5a148ba-c91a-3b08-a29e-4785ec83c7a5",
                                                "text": "„Bevor sie die schwarze Lacktasche über den Unterarm hängt, holt sie das Portemonnaie heraus, fingert aus dem Kleingeld eine Mark für den Klingelbeutel und steckt das Geldstück in die Manteltasche.“"
                                            },
                                            {
                                                "example_id": "595ed7b1-bd57-421f-992d-f85df9f554d7",
                                                "sense_id": "c5a148ba-c91a-3b08-a29e-4785ec83c7a5",
                                                "text": "„Ich wiege das Geldstück in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "549087f0-ab94-4dff-abec-801b0fdaa009",
                        "source_entry_id": "2dd2dea4-f01a-3d59-871e-af5f0423f783",
                        "source_sense_id": "900ef547-0644-31e2-b167-ad3b193b72d8",
                        "target_lang_word": "coin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59ba1ff0-22b1-393e-a37c-1162871be69b",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A piece of currency, usually metallic and in the shape of a disc, but sometimes polygonal, or with a hole in the middle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd686f1-3187-4ffe-8e90-99492e9f158d",
                                                "sense_id": "59ba1ff0-22b1-393e-a37c-1162871be69b",
                                                "text": "...the coins were of all countries and sizes - doubloons, and louis d'ors, and guineas, and pieces of eight..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa19f6f-fe95-3428-8275-cbf1984f6ff5",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A token used in a special establishment like a casino."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "054b29a4-7998-391f-b770-e6be2520ba23",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "That which serves for payment or recompense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36149ecd-221c-4db8-9b0d-32e5c37b4dee",
                                                "sense_id": "054b29a4-7998-391f-b770-e6be2520ba23",
                                                "text": "The loss of every present advantage to flesh and blood is repaid in a nobler coin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6949849-a518-3558-a908-9c92504716e8",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "Something in broad circulation or use."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a78121-0c91-4de0-a356-67d5bdfe5b49",
                                                "sense_id": "f6949849-a518-3558-a908-9c92504716e8",
                                                "text": "Tho’ truths in manhood darkly join,\n⁠Deep-seated in our mystic frame,\n⁠We yield all blessing to the name\nOf Him that made them current coin; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "Money in general, not limited to coins."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6fdf748-0300-4619-8442-58cad7c57fc3",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "She spent some serious coin on that car!"
                                            },
                                            {
                                                "example_id": "d9d80894-dc03-4e26-a98a-89a3f6b0f0b7",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "It was the biggest thing in the town, and everybody I met was full of it. They were going to run an over-sea empire, and make no end of coin by trade."
                                            },
                                            {
                                                "example_id": "f3a0f250-1278-425f-b93b-2e23572d4ae3",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "Boy toy named Troy, used to live in Detroit, big dope dealer money he was getting some coin."
                                            },
                                            {
                                                "example_id": "ec389076-839b-4508-ab20-8cc21d1a241e",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "Of course, she [Charlie XCX] has a penchant for designer frames that cost upwards of $400. If you want to splurge on one of those exact pairs, go off. If you want to save some coin, I found similar options at more affordable brands and even some Amazon dupes. You’re welcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639f6923-37ea-3c0e-a9f6-737e93a07865",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "One of the suits of minor arcana in tarot, or a card of that suit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58b2af24-91da-3c29-8b43-b32616df8408",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A corner or external angle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a20beef-042b-3238-8186-0585dfc91453",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A small circular slice of food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "762f063b-2831-4930-8fc3-1955b9aed517",
                                                "sense_id": "3a20beef-042b-3238-8186-0585dfc91453",
                                                "text": "For munchies try deep-fried jalapeño coins, jumbo Buffalo wings, and hush puppies with a sweet edge."
                                            },
                                            {
                                                "example_id": "64d75210-601d-4c52-9bb0-1ffc905fe6cb",
                                                "sense_id": "3a20beef-042b-3238-8186-0585dfc91453",
                                                "text": "Spread out four bread and butter pickle coins on top, and sprinkle with onion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e4d6c2-3c47-3af2-95cd-51b03798c32e",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "Ellipsis of cryptocoin; a cryptocurrency."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f487ce64-9fd7-4d2c-88b2-b985aa4fd6aa",
                                                "sense_id": "12e4d6c2-3c47-3af2-95cd-51b03798c32e",
                                                "text": "What's the best coin to buy right now?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00cdeb5b-4cfd-3d34-b60c-5323a6dc8e1c",
                                        "entry_id": "4b5ecd5b-0581-3875-bc2c-d06fe30f7c66",
                                        "glosses": [
                                            "To make of a definite fineness, and convert into coins, as a mass of metal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c0eacf1-d3b7-4875-9371-efb032745636",
                                                "sense_id": "00cdeb5b-4cfd-3d34-b60c-5323a6dc8e1c",
                                                "text": "to coin silver dollars"
                                            },
                                            {
                                                "example_id": "fcd03c92-cb50-46e2-a419-2eecb2bef7ee",
                                                "sense_id": "00cdeb5b-4cfd-3d34-b60c-5323a6dc8e1c",
                                                "text": "to coin a medal"
                                            },
                                            {
                                                "example_id": "cc73d6ad-2c10-4f68-be2a-2338e37d75da",
                                                "sense_id": "00cdeb5b-4cfd-3d34-b60c-5323a6dc8e1c",
                                                "text": "Many persons believe that the so-called \"dollar of the daddies,\" weighing 412½ grains (nine tenths fine), having a ratio to gold of \"16 to 1\" in value when first coined, was the original dollar of the Constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788e6dbb-0d8b-3a8e-9aa4-6a4b94e0f2b5",
                                        "entry_id": "4b5ecd5b-0581-3875-bc2c-d06fe30f7c66",
                                        "glosses": [
                                            "To make or fabricate (especially a word or phrase)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8046f487-77dd-4c98-bac6-eb07cd4deb4f",
                                                "sense_id": "788e6dbb-0d8b-3a8e-9aa4-6a4b94e0f2b5",
                                                "text": "Over the last century the advance in science has led to many new words being coined."
                                            },
                                            {
                                                "example_id": "92c6f257-59b6-477f-ab36-07eb96eef619",
                                                "sense_id": "788e6dbb-0d8b-3a8e-9aa4-6a4b94e0f2b5",
                                                "text": "Not fearing outward force: So ſhall my Lungs / Coine words till their decay, againſt thoſe Meazels"
                                            },
                                            {
                                                "example_id": "7dcab5de-5d77-4b03-9be1-9446ee5b137f",
                                                "sense_id": "788e6dbb-0d8b-3a8e-9aa4-6a4b94e0f2b5",
                                                "text": "Some tale, some new pretense, he daily coined, / To soothe his sister and delude her mind."
                                            },
                                            {
                                                "example_id": "7cb05340-6229-4a7d-8cdb-13c76e58b104",
                                                "sense_id": "788e6dbb-0d8b-3a8e-9aa4-6a4b94e0f2b5",
                                                "text": "As a result, men turn to the women in their lives to fulfill their emotional needs. Ferrara and her coauthor are not the first to suggest that women bear the burden of mankeeping (although they did coin the term)."
                                            },
                                            {
                                                "example_id": "bf9ef1f3-e662-4b9f-b056-e803753a32f6",
                                                "sense_id": "788e6dbb-0d8b-3a8e-9aa4-6a4b94e0f2b5",
                                                "text": "According to Collins Dictionary and Wiktionary, the term was coined in 2017 by journalist Anzer Ayoob, the term Chenabi is derived from the Chenab River, with the suffix “-i”, commonly used to denote belonging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "422162ff-fbe8-3285-b990-551da004721b",
                                        "entry_id": "4b5ecd5b-0581-3875-bc2c-d06fe30f7c66",
                                        "glosses": [
                                            "To acquire rapidly, as money; to make."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc728d50-ae01-42d9-bf06-8d7c77670c59",
                                                "sense_id": "422162ff-fbe8-3285-b990-551da004721b",
                                                "text": "[...] Tenants cannot coin their Rent juſt at Quarter-day, but muſt gather it up by degrees, and lodge it with them till Pay-day, or borrow it of thoſe who have it lying by them, [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f02ec6c9-0524-4508-832b-21bef277e319",
                        "source_entry_id": "2dd2dea4-f01a-3d59-871e-af5f0423f783",
                        "source_sense_id": "900ef547-0644-31e2-b167-ad3b193b72d8",
                        "target_lang_word": "pièce de monnaie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pièce de monnaie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a931253-819b-3876-88f0-ec83c019ae43",
                                        "entry_id": "e771e18f-f0c2-3de2-9137-69e4e9485b4b",
                                        "glosses": [
                                            "Petit objet métallique, le plus souvent en forme de disque, ayant une certaine valeur monétaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76654779-8148-4797-9948-5ec0f18afbde",
                                                "sense_id": "8a931253-819b-3876-88f0-ec83c019ae43",
                                                "text": "Comme il avait payé son emplette avec une pièce de monnaie à l’effigie du duc Raymond de Toulouse, le doyen de Beaucaire le fit incarcérer, sous prétexte qu’il avait contrevenu à un édit royal interdisant l’emploi d’une monnaie autre que celle de Nîmes."
                                            },
                                            {
                                                "example_id": "05ec49a8-367b-4ae9-a8ff-e4854f2eab58",
                                                "sense_id": "8a931253-819b-3876-88f0-ec83c019ae43",
                                                "text": "Assis sur un tabouret pliant, un chapeau informe sur la tête et la sébile aux pieds, près de ma canne blanche, j’ébauche sur un Cavagnolo d’occasion quelques airs musette qui mettent du vague à l’âme des passants et leur soutirent des pièces de monnaie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d4e899-1d8e-435b-8a93-9bc6e1b9c0d4",
                        "source_entry_id": "2dd2dea4-f01a-3d59-871e-af5f0423f783",
