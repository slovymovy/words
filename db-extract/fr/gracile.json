                        "form_id": "e6b489f6-1ff1-4d13-ba82-ebfd488d4185",
                        "entry_id": "73f1920e-5834-3d18-933f-7bf9a280cfbc",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "graciles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68fc535e-311f-3021-a155-e1f2b0447597",
                        "entry_id": "73f1920e-5834-3d18-933f-7bf9a280cfbc",
                        "glosses": [
                            "Qui est menu, léger, élancé, délicat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b2fb7a-c398-4ab2-b61a-ee3738b9f34e",
                                "sense_id": "68fc535e-311f-3021-a155-e1f2b0447597",
                                "text": "Elle est dramatiquement belle. Gracile et obscure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "588b6967-5de0-4374-ad6c-6a8b5fc9cdb6",
                        "source_entry_id": "73f1920e-5834-3d18-933f-7bf9a280cfbc",
                        "source_sense_id": "68fc535e-311f-3021-a155-e1f2b0447597",
                        "target_lang_word": "gracile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gracile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                        "entry_id": "ee5dbd50-c679-323f-b33f-fd40e21bd04a",
                                        "glosses": [
                                            "Lean, slender, thin."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7520af0b-2f26-4643-974a-442c700e02a5",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "[T]hoſe Trees that are called Firs by the Vulgar (from their near conformity and likeneſs to that Tree) are well known by all Learned Men (by the Redneſs, the Roſinous Nature of the Wood, the Gracil Cones hanging downwards, &c.) to be the true Pitch-Tree, of which there are ſuch great plenty in Norway, Sweden, and other Countries of the North, [...]"
                                            },
                                            {
                                                "example_id": "b64cecf1-84a8-48c1-b6e4-d776082b2bac",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "Maxillary palpi shorter than the antennæ, the terminal joint small, gracile, subulated; [...]"
                                            },
                                            {
                                                "example_id": "6960fb38-67fb-4cae-9fb3-60721dd2bbd2",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "The finish, the extreme delicacy of his [William Blake's] pencil, in his light gracile forms, marvellouslfy contrast with the ideal figures of his mystic allegories; sometimes playful, as the loveliness of the arabesques of Raffaelle."
                                            },
                                            {
                                                "example_id": "88b8e9d2-f14c-4b0d-9c21-1fdc5f05ac78",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "Unswathe his Egyptian mummy; and from the folds of fine linen, bestrewn and impregnated with aromatics, you disclose the grave features and gracile bones of a goodly and venerable cat."
                                            },
                                            {
                                                "example_id": "68a17e1d-2b4e-43ed-b3be-10b7f3e21a0c",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "The gracile and cuneate nuclei [of the brainstem] take shape before the decussation of the pyramids is fully completed [...]. The gracile nucleus appears in the form of a small irregular mass of gray matter in the interior of the funiculus gracilis. [...] It [the cuneate nucleus] presents a very different appearance from the gracile nucleus, because throughout its whole length the gray nucleus and the fibres of the strand are separated from each other by a sharp line of demarcation."
                                            },
                                            {
                                                "example_id": "b17117c9-8f01-4c91-8b48-4f1065b87781",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "The cheetah's gracile, canid-like morphological features and the extremely fast sprint it uses to capture prey have fostered a popular mythology that the species is overly specialized and hence doomed to extinction [...]."
                                            },
                                            {
                                                "example_id": "c393d534-c2a1-4698-a6bf-64bdb151c769",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "I am helplessly addicted to this place, this wondrous geographic puzzle of canyons turning in on themselves, [...] of horizon-wide sweeps of sunlit emptiness and gracile unknown places where darkness hides and will not tell its name."
                                            },
                                            {
                                                "example_id": "d8769894-ac6a-4b7e-8d0d-935c2a6fd547",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "While the pelvis is the best area to determine an individual's sex, the skull may also be used. [...] For example, males usually have very prominent (or robust) mastoid processes, projections that serve as muscle attachment sites behind the ears, while females have much smaller (or gracile) mastoid processes. Due to human variation, it is possible for a man to have very gracile features or a female to have very robust features."
                                            },
                                            {
                                                "example_id": "dc70f3ab-03bc-49ac-9a5c-18cdea2bb020",
                                                "sense_id": "18e87ce8-de2f-3251-81a6-8dd3026ea2af",
                                                "text": "The deinonychosaurs have gracile skulls, a carnivorous diet, and asymmetric flight feathers; all these features possibly evolved secondarily in deinonychosaurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3d2cb1a-f5cd-3c52-9644-e5649d2d0641",
                                        "entry_id": "ee5dbd50-c679-323f-b33f-fd40e21bd04a",
                                        "glosses": [
                                            "Of an animal or skeletal element: having a slender frame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f08830b-b674-445b-abc6-6afdab91d462",
                                                "sense_id": "d3d2cb1a-f5cd-3c52-9644-e5649d2d0641",
                                                "text": "This tentative comparison, plus consideration of individual skulls, shows the Neolithic pre-Greeks more Mediterranean than the Greeks, with emphasis on intermediate or gracile Mediterranean rather more than on the rugged Basic White trend, [...]"
                                            },
                                            {
                                                "example_id": "6cb66c51-ebf9-4051-be7e-606fb25e8811",
                                                "sense_id": "d3d2cb1a-f5cd-3c52-9644-e5649d2d0641",
                                                "text": "Where stratified fossil sequences are known, \"gracile\" fossils precede robust ones. The extremely robust hominids do not appear on the scene until about 2 million years ago, followed shortly thereafter by an \"advanced\" gracile. Both the advanced gracile and robust forms probably evolved from earlier gracile australopithecines."
                                            },
                                            {
                                                "example_id": "14fbed7a-1ca8-48be-aa18-17d1b100ea2d",
                                                "sense_id": "d3d2cb1a-f5cd-3c52-9644-e5649d2d0641",
                                                "text": "At various times since Homo first appeared in Africa, it shared the continent with more robust hominids, perhaps several different species of them. [...] They seem to have evolved from more ‘gracile’ apes (gracile being the opposite of robust). The gracile apes are also placed in the genus Australopithecus, and we too almost certainly emerged from among gracile australopithecine ranks."
                                            },
                                            {
                                                "example_id": "f331d5ab-24f9-4aaf-b423-311f107e6185",
                                                "sense_id": "d3d2cb1a-f5cd-3c52-9644-e5649d2d0641",
                                                "text": "We would also expect increasing home-range size in Neanderthals in 'edge' regions (bordering the MLB and the plains), such as south-west France, in response to habitat fragmentation during periods of expansion of open vegetation. A more gracile morphology would have been far more efficient over larger areas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f713b1-302a-3ca9-88d3-c2cfac2d5bd0",
                                        "entry_id": "ee5dbd50-c679-323f-b33f-fd40e21bd04a",
                                        "glosses": [
                                            "Graceful or gracefully slender."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9532689-5563-43e7-966c-5a17b61dfcbd",
                                                "sense_id": "77f713b1-302a-3ca9-88d3-c2cfac2d5bd0",
                                                "text": "[A] band of dancers run upon the stage and perform a sylvan dance with gracile wavings of branches or the clinking of cymbals."
                                            },
                                            {
                                                "example_id": "e550e1ff-bfe4-4702-9681-7d0095f0c8ca",
                                                "sense_id": "77f713b1-302a-3ca9-88d3-c2cfac2d5bd0",
                                                "text": "Then Herr Spinnell turned his back and got away from there. Followed by the jubliations of the little Klŏterjahn, holding his arm in a certain cautious and stiffly gracile manner, he walked over the gravel with the vehement, yet hesitating steps of one who seeks to hide the fact that he is—inwardly—on the run."
                                            },
                                            {
                                                "example_id": "4ae9738c-3044-4480-8592-b0e981e82c5a",
                                                "sense_id": "77f713b1-302a-3ca9-88d3-c2cfac2d5bd0",
                                                "text": "Katafa had taken refuge in the second great pool, a pool some few feet deep and large enough for a person to swim in. The water was tepid and the floor of soft sand, and as she slipped into it, gracile as a serpent, she did not look to see what fish there might be there."
                                            },
                                            {
                                                "example_id": "4e46c256-2df9-4f5c-abdf-7a085c7d24f9",
                                                "sense_id": "77f713b1-302a-3ca9-88d3-c2cfac2d5bd0",
                                                "text": "The low women, coiffed, perfumed, / and decked out in high fashion, / Adorn the parlor's plush decor / like debutantes, stepping out / to greet gents with gracile, / fawning caresses and playful leers."
                                            },
                                            {
                                                "example_id": "e71c3c86-b8f0-4008-b95b-551da9ac3f57",
                                                "sense_id": "77f713b1-302a-3ca9-88d3-c2cfac2d5bd0",
                                                "text": "In Ovid's Amores, gracile Elegy, the presiding spirit of Ovid's poetry of unfulfilled desire, confronts ponderous Tragedy [...], only to dismiss her with insouciance: the pleasures and pains of erotic pursuit displace the ostensibly serious matters of tragic verse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04747bea-5683-491d-9d83-9f3e93b5b26a",
                        "source_entry_id": "73f1920e-5834-3d18-933f-7bf9a280cfbc",
                        "source_sense_id": "68fc535e-311f-3021-a155-e1f2b0447597",
                        "target_lang_word": "slender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Thin; slim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90d9a6f-073c-4c72-ad73-e5583d4890c0",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "A rod is a long slender pole used for angling."
                                            },
                                            {
                                                "example_id": "ba70c749-66a2-4b05-83d9-8affa575765e",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "She is very slender."
                                            },
                                            {
                                                "example_id": "0127d8bc-f5e0-49ce-8488-ba383eb3f2af",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Meagre; deficient."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2278568-096a-42f7-a28f-2c61d759af28",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "Being a person of slender means, he was unable to afford any luxuries."
                                            },
                                            {
                                                "example_id": "2c9e090e-a06b-44b7-8609-1dad26b94025",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "The grounds for the conjecture are somewhat slender."
                                            },
                                            {
                                                "example_id": "83df510e-0748-4e8a-abd7-6b7c67286d08",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "The slender service between Ellesmere Port and Helsby has been added, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1256381b-7d42-3cc1-9bc0-172a03b48829",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Palatalized."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
