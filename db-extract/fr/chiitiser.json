                "senses": [
                    {
                        "sense_id": "2ee9849d-bdb8-3452-99c0-29dec4ebe901",
                        "entry_id": "b79844d2-671b-33dd-b31b-ab38e4d96e02",
                        "glosses": [
                            "Donner un caractère chiite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f34ca52-5de1-4aaa-aac4-edc33ee104e6",
                                "sense_id": "2ee9849d-bdb8-3452-99c0-29dec4ebe901",
                                "text": "Ils essaient moins que les safavides de chiitiser les populations."
                            },
                            {
                                "example_id": "0eabd4ee-2131-4b56-830b-1cc775129632",
                                "sense_id": "2ee9849d-bdb8-3452-99c0-29dec4ebe901",
                                "text": "Depuis la Révolution islamique, le clergé chiite iranien aspire, au travers de ses discours à \"chiitiser\" l'Islam, pour islamiser le monde."
                            },
                            {
                                "example_id": "01f40721-accc-410d-879b-4296400c99b2",
                                "sense_id": "2ee9849d-bdb8-3452-99c0-29dec4ebe901",
                                "text": "Pourquoi s'est-il engagé à chiitiser les Comores à outrance ?"
                            }
                        ]
                    }
