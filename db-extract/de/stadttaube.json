                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f200d577-a7f5-44dc-ba07-cd24ac72c9c0",
                                                "sense_id": "4ab2338b-009b-3ffb-9fae-40680cc87f8e",
                                                "text": "U drzwiowego progu, okno kuchenne było otwarte: wychodził dym jakby pogorzelowy, aż z kłębów dymu, jak biały gołąbek, zabłysła kuchmistrzowa świecąca czapeczka."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d2bc8e7e-89d0-38d0-ad97-f00cfd0b452c",
                                        "entry_id": "8afaa2f6-e54b-3964-8f23-4721c9a661c4",
                                        "glosses": [
                                            "pisklę gołębia"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "726578b9-0d87-3d86-8c44-e44831dccbc3",
                                        "entry_id": "8afaa2f6-e54b-3964-8f23-4721c9a661c4",
                                        "glosses": [
                                            "Russulaceae, grzyb blaszkowy należący do rodziny gołąbkowatych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264fa30f-4eb0-43e1-acf4-e24cc7135e8f",
                                                "sense_id": "726578b9-0d87-3d86-8c44-e44831dccbc3",
                                                "text": "Marta nagotowała gołąbków, bigosów, flaczków, a goście jedzą tylko sałatkę warzywną."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "4be9c0db-1f6c-3e02-851c-1082998022cd",
                                        "entry_id": "8afaa2f6-e54b-3964-8f23-4721c9a661c4",
                                        "glosses": [
                                            "danie z ryżu i mielonego mięsa zawiniętego w liście kapusty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d014b9-4e6a-4c57-9af8-d36bae03e733",
                                                "sense_id": "4be9c0db-1f6c-3e02-851c-1082998022cd",
                                                "text": "Gołąbki są jedną ze specjalności polskiej kuchni, którą przygotowuje się z liści kapusty z farszem z mięsa i ryżu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
