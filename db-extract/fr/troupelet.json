                        "examples": [
                            {
                                "example_id": "5e239f91-19bb-4c00-8075-ada913b3d47e",
                                "sense_id": "84ff2a8c-8cfd-3e3b-b8bc-bf861c53c78a",
                                "text": "Volon devorar le tropelet petit. Veulent dévorer le troupelet petit — (Lexique roman de M. Raynouard, Paris, 1843)"
                            },
                            {
                                "example_id": "5c578b22-b04e-43b8-88d8-122d362e36ac",
                                "sense_id": "84ff2a8c-8cfd-3e3b-b8bc-bf861c53c78a",
                                "text": "Et on dit bien :\n Pour Saint André\n Étable ton troupelet\nSi tu n’étables pas\n À Pâques tu ne l’auras pas. Troupelet c’est pour jeune troupeau."
                            },
                            {
                                "example_id": "1b947f5a-73a7-45a8-b7b9-58edb0a7f872",
                                "sense_id": "84ff2a8c-8cfd-3e3b-b8bc-bf861c53c78a",
                                "text": "Versez goutte à gouttelette\nVotre mousse en ces puits, puis\nQue ces puits\nPassent au four, et, blondines,\nSortant en gais troupelets,\nCe sont les\nTartelettes amandines ! — (Edmond Rostand, Cyrano de Bergerac, 1898, Acte II, scène 4)"
                            }
                        ]
                    }
