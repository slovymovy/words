                    "frequency": "Low",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave the door a loud <w>chap</w> to get attention.",
                            "target_lang_translations": {
                                "ru": "Он громко <w>стукнул</w> в дверь, чтобы привлечь внимание."
                            }
