        "fr-extract.jsonl": [
            {
                "entry_id": "4da068ac-40a4-3178-bf3e-849a697de4d5",
                "word": "soixantaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5dedcc4e-c29b-4a09-a4f7-7fe1b48220b3",
                        "entry_id": "4da068ac-40a4-3178-bf3e-849a697de4d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "soixantaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c8174e4-72c0-3741-ac30-2a085095e53e",
                        "entry_id": "4da068ac-40a4-3178-bf3e-849a697de4d5",
                        "glosses": [
                            "Ensemble de soixante ou environ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0769110d-b3c8-49de-be05-cb5df30e423c",
                                "sense_id": "6c8174e4-72c0-3741-ac30-2a085095e53e",
                                "text": "Une recherche-action, conduite dans le département de la Seine-Saint-Denis durant deux ans par deux sociologues, a impliqué une soixantaine d’auxiliaires de puériculture volontaires venues d’une quinzaine de crèches départementales."
                            },
                            {
                                "example_id": "5d4c36bd-1971-4d79-8103-aed988654256",
                                "sense_id": "6c8174e4-72c0-3741-ac30-2a085095e53e",
                                "text": "La gamme de la coopérative compte une soixantaine de référence, du mini-romanesco en passant par le mini-poivron et le mini-pâtisson."
                            },
                            {
                                "example_id": "76a2fe5e-457e-4a73-8fd7-d32976a1df32",
                                "sense_id": "6c8174e4-72c0-3741-ac30-2a085095e53e",
                                "text": "Au petit matin, les permanents du secteur non alimentaire s’installent avant les marchands ponctuels ; Marc Assouline et Nathalie Guillon font partie de la soixantaine de vendeurs permanents du marché ; Noëlle Navarrete est placière au marché de Rochefort depuis 2017 ; Yann Lannemajou encaisse les marchands non-permanents."
                            }
                        ]
                    },
                    {
                        "sense_id": "4541b561-fa95-317b-952d-5438ea5faec5",
                        "entry_id": "4da068ac-40a4-3178-bf3e-849a697de4d5",
                        "glosses": [
                            "Âge de soixante ans ou environ."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "751b19ab-956c-4a21-a79c-20d2a4cda5d3",
                                "sense_id": "4541b561-fa95-317b-952d-5438ea5faec5",
                                "text": "Il approche de la soixantaine."
                            },
                            {
                                "example_id": "c1cfca45-d2be-4842-abc2-e5876336456e",
                                "sense_id": "4541b561-fa95-317b-952d-5438ea5faec5",
                                "text": "Il a passé la soixantaine."
                            },
                            {
                                "example_id": "d287f56c-eb5f-4230-8427-faef8664f0fa",
                                "sense_id": "4541b561-fa95-317b-952d-5438ea5faec5",
                                "text": "Si je parviens à échapper à la soixantaine, c'est que je serai mort avant."
                            },
                            {
                                "example_id": "99cf1370-ff8f-418a-b41b-28672de4218b",
                                "sense_id": "4541b561-fa95-317b-952d-5438ea5faec5",
                                "text": "Il a la soixantaine."
                            }
                        ]
                    },
