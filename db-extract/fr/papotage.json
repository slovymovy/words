                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chitchat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a190b8cc-0168-36a0-a705-dfe770a90b41",
                                        "entry_id": "e3ce76f0-23cc-35d7-81bf-844628f261b8",
                                        "glosses": [
                                            "Alternative spelling of chit-chat."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0c358c-ca0a-4920-bd97-1d64c528fc2e",
                                                "sense_id": "a190b8cc-0168-36a0-a705-dfe770a90b41",
                                                "text": "“What are you doing down here, father?” “Just having a bit of chitchat with your curious creation.” “Right.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chitchat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49de4630-370d-398c-9103-c7d9185a45c7",
                                        "entry_id": "9bc3f2de-3e49-3399-81de-399dd9392d73",
                                        "glosses": [
                                            "Alternative spelling of chit-chat."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d667c56-d159-42ba-a36b-064d64017d3f",
                                                "sense_id": "49de4630-370d-398c-9103-c7d9185a45c7",
                                                "text": "We were still chitchatting in the same nothingy vein five minutes later when George opened his bedroom door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f315418-757c-48e3-b429-7acf7e60459c",
                        "source_entry_id": "172ceb64-5354-396a-867e-eb4c725bca6a",
                        "source_sense_id": "d9cb289e-fbbf-36e5-be4e-b9a30188204f",
