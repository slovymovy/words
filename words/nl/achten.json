                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zal rond <w>achten</w> geweest zijn toen we eindelijk vertrokken.",
                            "target_lang_translations": {
                                "en": "It must have been around <w>eight o'clock</w> when we finally left."
                            }
