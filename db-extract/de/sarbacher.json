                "senses": [
                    {
                        "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                        "entry_id": "b6616cf8-5185-3c3a-a10b-c652a9056b2c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ad306c-97a4-49a1-958d-288f89bd988c",
                                "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                                "text": "Frau Sarbacher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "055def41-29da-4a31-9d3f-60ca878d0819",
                                "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                                "text": "Herr Sarbacher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a749c19b-a673-4f94-99f4-2b57ee66b159",
                                "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                                "text": "Die Sarbachers kommen heute von Usedom."
                            },
                            {
                                "example_id": "9328eb1e-74e6-4159-beb6-a2158306bfc8",
                                "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                                "text": "Der Sarbacher trägt nie die Schals, die die Sarbacher ihm strickt."
                            },
                            {
                                "example_id": "270c1878-ae28-4e61-808f-5ee157e02a98",
                                "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sarbacher kommt, geht der Herr Sarbacher.“"
                            },
                            {
                                "example_id": "82a2cb62-5bfd-4a95-8844-8d67177b21fb",
                                "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                                "text": "Sarbacher kommt und geht."
                            },
                            {
                                "example_id": "2c1d17d0-a120-4612-8766-444364e1e789",
                                "sense_id": "7018f94f-5f0a-31a2-9861-583ee15834ea",
                                "text": "Sarbachers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
