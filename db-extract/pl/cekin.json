                    {
                        "translation_id": "7728b337-1b73-451d-8d85-b68844096068",
                        "source_entry_id": "dd7886a4-71a3-3bd1-9aab-06499d75e7b4",
                        "source_sense_id": "27824328-ecdb-304b-abba-738d2ca4e072",
                        "target_lang_word": "Paillette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paillette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3454948e-959b-3c0c-a142-6c7b1b82493e",
                                        "entry_id": "04884c30-9bd9-382f-85c1-6cdc69924d2d",
                                        "glosses": [
                                            "kleines, rundes, flaches Plättchen aus Metall oder beschichtetem Kunststoff, das in Kleidung oder zur Verzierung von Textilien verwendet wird"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "333a0f54-7858-49da-94d2-8a826f29658e",
                                                "sense_id": "3454948e-959b-3c0c-a142-6c7b1b82493e",
                                                "text": "Eine Paillette löste sich vom Saum seines Anzugs."
                                            },
                                            {
                                                "example_id": "5d7e26b4-8c7d-4e7b-a46a-2d62d87a954f",
                                                "sense_id": "3454948e-959b-3c0c-a142-6c7b1b82493e",
                                                "text": "[…] „im Arbeitsraum“ […] „sticken ausgebildete Näherinnen Perlen und Pailletten auf Baumwollkleider.“"
                                            },
                                            {
                                                "example_id": "ec808063-3fab-4901-8de6-c757d88d72e3",
                                                "sense_id": "3454948e-959b-3c0c-a142-6c7b1b82493e",
                                                "text": "„Für königlichen Glanz sorgten bei der Eröffnung der 106. Bayreuther Wagner-Festspiele Königin Silvia von Schweden in einem langen, dunkelblauen und mit Pailletten besetzten Kleid und ihr Mann Carl Gustaf von Schweden.“"
                                            },
                                            {
                                                "example_id": "1770da97-fa3f-4d7c-bc13-fb870948df30",
                                                "sense_id": "3454948e-959b-3c0c-a142-6c7b1b82493e",
                                                "text": "„Hoffman und Melanie Griffith sprechen sich auf ihren BHs gegen den Krieg aus: \"War sucks\" sowie \"Make love not war\" sind mit silbernen Pailletten auf das schwarze Material gestickt.“"
                                            },
                                            {
                                                "example_id": "59371331-c8fb-4b3d-8a0f-8cfa0590fd88",
                                                "sense_id": "3454948e-959b-3c0c-a142-6c7b1b82493e",
                                                "text": "„1858 eröffnete er in Frankreichs Hauptstadt in der \"Rue de la Paix\" sein eigenes Modehaus, wo er Abendgarderobe aus silbernem Tüll und Pailletten schuf, die er auch schon mal mit Herzen oder Gänseblümchen verzierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
