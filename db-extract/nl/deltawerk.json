                        "examples": [
                            {
                                "example_id": "38c502e0-d3f7-451f-a6f9-49811bcab954",
                                "sense_id": "00c813b1-9537-39d0-b3cf-fe2c54e90d07",
                                "text": "Visioenen van een ondergelopen hoofdstad waren genoeg om in de jaren zeventig te besluiten tot het deltawerk, dat na diverse golven van staking en inflatie zo'n twee miljard gulden heeft gekost. Wanneer nu het alarmsein door de stormvoorspellingsstations in Noord Engeland wordt gegeven, heeft de bemanning van de Theemsbarrière acht uur de tijd om het parlement, de Tate Gallery en het halve ondergrondse treinnet voor de kolkende stromen te behoeden."
                            },
                            {
                                "example_id": "ac5c888f-a5c7-4851-8cf8-27af27435bfc",
                                "sense_id": "00c813b1-9537-39d0-b3cf-fe2c54e90d07",
                                "text": "Het werkterrein biedt het bekende aspect, van een groot deltawerk met, binnen de sterke eilanddijken, kranen, cilinders, woon- en kantoorketen en hele bergen stortsteen."
                            }
                        ]
                    }
