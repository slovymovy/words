                        "examples": [
                            {
                                "example_id": "e756845c-98ce-4d7b-a43c-1d2a615dca41",
                                "sense_id": "b4aa06b4-5fed-3983-b755-4555dcb4f608",
                                "text": "Zou dit de dood zijn? dacht vorst Andrej, terwijl hij met een nieuwe, jaloerse blik keek naar het gras, de alsem en de rooksliert die uit de draaiende zwarte bol omhoog kringelde."
                            },
                            {
                                "example_id": "f91e1dcb-3f8d-4e44-b00d-a35be0bf93c6",
                                "sense_id": "b4aa06b4-5fed-3983-b755-4555dcb4f608",
                                "text": "Rookslierten drijven op de begane grond de hal in. Al gauw hoort Cor ook de rookmelder op de eerste verdieping tekeergaan. Daar slapen zijn vier kinderen, Louise (12), Sophie (9), Paul (8) en Lucas (4). De verdieping biedt ook zicht op de nok van het huis. „Ik zag bovenin de nok dikke rook en oranje vuurtongen. Ik hoorde kerstballen in dozen knallen en zag het hete kunststof van smeulende skischoenen langs de wand druppelen.”"
                            }
                        ]
                    }
