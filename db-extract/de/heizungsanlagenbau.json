                    {
                        "sense_id": "259318d5-1dad-3b79-8a99-60fa6afb1563",
                        "entry_id": "7043fa76-2e06-3e4e-9aa1-a6c51926df0f",
                        "glosses": [
                            "Planung und Erstellung von heizungstechnischen Anlagen"
