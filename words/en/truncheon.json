{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fda3078-6f72-32f9-ad8d-b91ea0e3b30d",
                    "sense_definition": "A short, thick stick carried as a weapon by a police officer.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weapon_club",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer pulled out his <w>truncheon</w> to defend himself against the violent crowd.",
                            "target_lang_translations": {
                                "nl": "De agent trok zijn <w>wapenstok</w> om zich tegen de gewelddadige menigte te verdedigen."
                            }
                        },
                        {
                            "text": "Protesters retreated quickly when they saw the riot police draw each <w>truncheon</w>.",
                            "target_lang_translations": {
                                "nl": "Betogers trokken zich snel terug toen ze zagen dat de mobiele eenheid de <w>wapenstokken</w> trok."
                            }
                        }
                    ],
                    "synonyms": [
                        "baton",
                        "nightstick"
                    ],
                    "common_phrases": [
                        "police truncheon"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een korte, dikke stok die door een politieagent als wapen wordt gedragen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wapenstok",
                                "target_lang_sense_clarification": "slagwapen van de politie"
                            },
                            {
                                "target_lang_word": "knuppel",
                                "target_lang_sense_clarification": "politieknuppel"
                            },
                            {
                                "target_lang_word": "matrak",
                                "target_lang_sense_clarification": "Belgisch-Nederlands"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ba06927-cf32-31cb-a88b-02e9fd2ef487",
                    "sense_definition": "A short staff or heavy club used as a weapon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weapon_club",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard held a heavy wooden <w>truncheon</w> ready to strike any trespasser.",
                            "target_lang_translations": {
                                "nl": "De bewaker hield een zware houten <w>knuppel</w> gereed om elke indringer neer te slaan."
                            }
                        },
                        {
                            "text": "He wielded a sturdy <w>truncheon</w> to protect the entrance of the fortress.",
                            "target_lang_translations": {
                                "nl": "Hij hanteerde een stevige <w>knuppel</w> om de ingang van het fort te beschermen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historically used to describe a staff or club"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een korte staf of zware knuppel die als wapen wordt gebruikt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knuppel",
                                "target_lang_sense_clarification": "zware slagstok"
                            },
                            {
                                "target_lang_word": "staf",
                                "target_lang_sense_clarification": "korte slagstaf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8cabb8e-575c-3069-9ba7-00879d3d4adb",
                    "sense_definition": "A piece or fragment broken off from something, especially a spear or lance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "broken_fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the violent clash of lances, only a shattered <w>truncheon</w> remained in his grip.",
                            "target_lang_translations": {
                                "nl": "Na de hevige botsing van de lansen bleef er slechts een versplinterde <w>stomp</w> in zijn greep over."
                            }
                        },
                        {
                            "text": "The knight discarded the useless <w>truncheon</w> of his weapon and drew his broadsword.",
                            "target_lang_translations": {
                                "nl": "De ridder wierp het nutteloze <w>afgebroken lansstuk</w> van zijn wapen weg en trok zijn slagzwaard."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically for broken shafts or fragments"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een afgebroken stuk of fragment van iets, in het bijzonder van een speer of lans."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afgebroken lansstuk",
                                "target_lang_sense_clarification": "stomp van een gebroken lans"
                            },
                            {
                                "target_lang_word": "stomp",
                                "target_lang_sense_clarification": "afgebroken restant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12b293b5-1948-3d71-926f-dd67c0fc8c9a",
                    "sense_definition": "The wooden shaft of a spear or lance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gripped the polished <w>truncheon</w> of the spear firmly before aiming at the target.",
                            "target_lang_translations": {
                                "nl": "Hij pakte de gepolijste <w>schacht</w> van de speer stevig vast voordat hij op het doel mikte."
                            }
                        },
                        {
                            "text": "The ornate <w>truncheon</w> was carved from solid ash and tipped with steel.",
                            "target_lang_translations": {
                                "nl": "De sierlijke <w>schacht</w> was gesneden uit massief essenhout en voorzien van een stalen punt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers specifically to spear shafts in early modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De houten schacht van een speer of lans."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schacht",
                                "target_lang_sense_clarification": "van een speer of lans"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cf777fe-94da-3e33-8a70-9f891a9da7d0",
                    "sense_definition": "A thick tree cutting with branches removed, planted to root and grow quickly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horticulture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener planted a willow <w>truncheon</w> directly into the wet soil along the bank.",
                            "target_lang_translations": {
                                "nl": "De tuinman plantte een wilgen<w>pootstok</w> direct in de natte grond langs de oever."
                            }
                        },
                        {
                            "text": "Fresh green shoots emerged from the top of the dormant <w>truncheon</w> by late spring.",
                            "target_lang_translations": {
                                "nl": "Tegen het einde van de lente verschenen er verse groene scheuten aan de bovenkant van de slapende <w>stek</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een dikke takstek waarvan de zijtakken zijn verwijderd, geplant om snel te wortelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pootstok",
                                "target_lang_sense_clarification": "dikke takstek"
                            },
                            {
                                "target_lang_word": "stek",
                                "target_lang_sense_clarification": "dikke takstek voor beplanting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "656fca4a-b9cd-3e7b-877c-b630e9ea1e97",
                    "sense_definition": "A penis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eighteenth-century erotic novel explicitly described the lover's erect <w>truncheon</w>.",
                            "target_lang_translations": {
                                "nl": "De achttiende-eeuwse erotische roman beschreef expliciet de stijve <w>knuppel</w> van de minnaar."
                            }
                        },
                        {
                            "text": "Rude humor in the play included vulgar metaphors comparing a sword or <w>truncheon</w> to male anatomy.",
                            "target_lang_translations": {
                                "nl": "Schuine humor in het toneelstuk bevatte platte metaforen waarin een zwaard of <w>knuppel</w> werd vergeleken met het mannelijk lid."
                            }
