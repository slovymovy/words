                            {
                                "example_id": "f6454e9d-58e9-44e4-a303-81b9a1b64c27",
                                "sense_id": "b6f5f768-1398-3dd1-9ced-569f61bbf432",
                                "text": "Les hypocrites Néo-Zélandais firent un excellent accueil aux nouveaux arrivants."
                            },
                            {
                                "example_id": "08509924-be36-4326-b966-43d30aba06e8",
                                "sense_id": "b6f5f768-1398-3dd1-9ced-569f61bbf432",
                                "text": "Au début, pendant le concert qui chauffait les premiers arrivants, je me suis concentré sur les tracteurs. Les gens qui refilent des tracts, c'est comme ça qu'on les appelle ?"
                            },
                            {
                                "example_id": "462c49b2-f9db-4104-aa48-a974e4acebe2",
                                "sense_id": "b6f5f768-1398-3dd1-9ced-569f61bbf432",
                                "text": "L’AVF de Toulon accueille les nouveaux arrivants."
                            }
                        ]
                    }
                ],
                "translations": [
