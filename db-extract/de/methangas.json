                        "cross_references": [
                            {
                                "target_word": "methane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "417d03de-bdaa-3bd3-a33b-30240149811f",
                                        "entry_id": "31927b7f-d0ec-3aa2-904b-05d7a2b1543e",
                                        "glosses": [
                                            "The simplest aliphatic hydrocarbon, CH₄, being a constituent of natural gas, and one of the most abundant greenhouse gases."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46da6bb-1a5f-42b7-873a-aa7a62266bec",
                                                "sense_id": "417d03de-bdaa-3bd3-a33b-30240149811f",
                                                "text": "Cattle emit a large amount of methane."
                                            },
                                            {
                                                "example_id": "b7569ad7-6167-49ae-8b2c-06c59c7e0dfa",
                                                "sense_id": "417d03de-bdaa-3bd3-a33b-30240149811f",
                                                "text": "Methane, an invisible, odorless gas that makes up more than 95% of natural gas fuel, can be as much as 80 times more potent as a global warmer per given unit than CO₂, which is more plentiful in the atmosphere. While there are less emissions than CO₂, methane lasts around 12 years, while CO₂ lingers for centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11306617-b7dc-3413-bdea-0fcd77927f45",
                                        "entry_id": "31927b7f-d0ec-3aa2-904b-05d7a2b1543e",
                                        "glosses": [
                                            "Any of very many derivatives of methane."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f092c0f-9dc1-4db0-aa35-635b88368b79",
                        "source_entry_id": "5a69dd9f-41db-334c-95e6-fc90ce892c15",
                        "source_sense_id": "ff1207e4-40a5-3096-a955-1c0947587c3d",
