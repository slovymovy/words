                        "examples": [
                            {
                                "example_id": "bab24fb7-1813-49a8-8973-2121f728afd7",
                                "sense_id": "9616e133-2dc5-33a4-ad5e-b982090c8998",
                                "text": "„Die Zeitung hat von einer nicht genannten Quelle bei British Airways erfahren, dass ein Wartungstechniker die Stromversorgung versehentlich abgeschaltet haben soll.“"
                            },
                            {
                                "example_id": "1488e7da-5ff9-418c-9ccc-486bfa5157bc",
                                "sense_id": "9616e133-2dc5-33a4-ad5e-b982090c8998",
                                "text": "„Die Vernetzung hat ihren Charme: Sensoren rufen von allein den Wartungstechniker, wenn eine Maschine nicht mehr rundläuft.“"
                            },
                            {
                                "example_id": "7dd4838b-50f7-4e6e-a0ba-8abde8968126",
                                "sense_id": "9616e133-2dc5-33a4-ad5e-b982090c8998",
                                "text": "„Zusammen mit dem Wartungstechniker Mohamed Boudou fahren wir in einem Kleinbus vom Parkplatz Windeck über eine holprige Strecke weiter hinauf.“"
                            }
                        ],
