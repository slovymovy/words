{
    "word_family": [
        "apport",
        "apporteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9bd41e65-d2ef-3eae-9bdf-ae8976181d7a",
                    "sense_definition": "Porter un objet avec soi jusqu'au lieu où se trouve quelqu'un ou quelque chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas d'<w>apporter</w> un parapluie car il va pleuvoir aujourd'hui."
                        },
                        {
                            "text": "Le serveur nous <w>apporte</w> la carte des desserts avec le sourire."
                        }
                    ],
                    "synonyms": [
                        "amener",
                        "porter"
                    ],
                    "antonyms": [
                        "emporter"
                    ],
                    "common_phrases": [
                        "apporter des fleurs",
                        "apporter un cadeau"
                    ]
                },
                {
                    "sense_id": "a19ec2ec-891e-3ab8-b189-1ce1bf972f6c",
                    "sense_definition": "Causer, produire ou susciter un effet, une conséquence ou un changement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle technologie va <w>apporter</w> de profonds changements dans notre quotidien."
                        },
                        {
                            "text": "Le nouveau projet de loi doit <w>apporter</w> une amélioration des conditions de travail."
                        }
                    ],
                    "synonyms": [
                        "causer",
                        "produire"
                    ],
                    "common_phrases": [
                        "apporter des changements",
                        "apporter une amélioration"
                    ]
                },
                {
                    "sense_id": "d1458d98-c2a9-38f6-bf14-3a0553f704ae",
                    "sense_definition": "Fournir, donner ou procurer quelque chose d'abstrait comme une aide, un avis ou une solution.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le spécialiste a tenté d'<w>apporter</w> une réponse claire à toutes nos questions."
                        },
                        {
                            "text": "Les bénévoles souhaitent <w>apporter</w> leur soutien aux familles touchées par la tempête."
                        }
                    ],
                    "synonyms": [
                        "donner",
                        "procurer"
                    ],
                    "common_phrases": [
                        "apporter son aide",
                        "apporter une réponse"
                    ]
                },
                {
                    "sense_id": "b3e9079f-8d19-3858-b881-cf0672b15310",
                    "sense_definition": "Fournir sa part de quelque chose, contribuer personnellement avec des ressources ou des compétences.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque membre de l'équipe <w>apporte</w> ses compétences pour réussir la mission."
                        },
                        {
                            "text": "Les partenaires ont décidé d'<w>apporter</w> des capitaux supplémentaires pour sauver l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "fournir"
                    ],
                    "antonyms": [
                        "retirer"
                    ],
                    "common_phrases": [
                        "apporter des fonds",
                        "apporter sa contribution"
                    ]
                }
            ]
        }
    ]
}