                ],
                "senses": [
                    {
                        "sense_id": "9b1bee0c-1449-3cfe-ad9f-3f1a2ba261fc",
                        "entry_id": "5b6670f9-149a-3655-9df1-94ce6f047cdb",
                        "glosses": [
                            "Handlung, die aus einer Verzweiflung heraus erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51641827-5a6f-4528-9519-b1a9ad0f3398",
                                "sense_id": "9b1bee0c-1449-3cfe-ad9f-3f1a2ba261fc",
                                "text": "„Im Zusammenhang mit dem Selbstmordversuch des Unparteiischen aus Hannover am vergangenen Samstag war unter anderem auch gemutmaßt worden, dass der ungeheure Druck auf die Schiedsrichter zu einer solchen Verzweiflungstat geführt haben könnte.“"
                            },
                            {
                                "example_id": "f3beedc9-ed90-4151-9505-7e6715fd1d49",
                                "sense_id": "9b1bee0c-1449-3cfe-ad9f-3f1a2ba261fc",
                                "text": "„Welche Folgen mag diese Verzweiflungstat haben, hunderte von Menschen auf unserer Seite werden dafür büßen.“"
                            },
                            {
                                "example_id": "56b2f903-ac3b-4897-984b-e29b9c71d63e",
                                "sense_id": "9b1bee0c-1449-3cfe-ad9f-3f1a2ba261fc",
                                "text": "„Zunehmend vom harten Gefängnisleben in Alcatraz zermürbt, wollte Stroud die Öffentlichkeit mit einer Verzweiflungstat auf seine Situation aufmerksam machen.“"
                            },
                            {
                                "example_id": "ce2e0dfd-9a9a-41bd-9565-64e29801637f",
                                "sense_id": "9b1bee0c-1449-3cfe-ad9f-3f1a2ba261fc",
                                "text": "„Die Schwiegereltern einigten sich mit der Schwiegertochter, Rotermund am Wochenende an die Luft zu setzen, wobei sie jedes Risiko, wie etwa eine Verzweiflungstat Rotermunds, mit ins Auge faßten und in Kauf nehmen wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
