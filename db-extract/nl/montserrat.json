                                        "entry_id": "0631ad4b-2954-3f13-816d-6ae962f0ea9d",
                                        "glosses": [
                                            "Insel der kleinen Antillen, britische Kronkolonie"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
