                    {
                        "translation_id": "b378d9a4-4f28-4f94-aac1-2e4f4c994028",
                        "source_entry_id": "c5061690-2e69-3d2e-85eb-69e45b216a8f",
                        "source_sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                        "source_sense_description": "aus dem Stegreif: ohne Vorbereitung, improvisiert",
                        "target_lang_word": "offhand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offhand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fe67ebd-8aab-364a-86de-ab48736ab878",
                                        "entry_id": "171e6d0c-b46f-31b8-9050-bc4a2b0d4496",
                                        "glosses": [
                                            "Without planning or thinking ahead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "575956d5-8444-4145-a856-d912a55fedda",
                                                "sense_id": "0fe67ebd-8aab-364a-86de-ab48736ab878",
                                                "text": "She gave an offhand speech."
                                            },
                                            {
                                                "example_id": "6d21a742-6830-4621-9f81-daa7a18ff0bc",
                                                "sense_id": "0fe67ebd-8aab-364a-86de-ab48736ab878",
                                                "text": "He must also be fluent in obscenity, offhand in sex. Most important of all, he must play tough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab4c16e-a3cc-3a85-a1ad-3450200d9354",
                                        "entry_id": "171e6d0c-b46f-31b8-9050-bc4a2b0d4496",
                                        "glosses": [
                                            "Careless; without sufficient thought or consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba24d71-ec3c-4967-b636-d624f0974f40",
                                                "sense_id": "6ab4c16e-a3cc-3a85-a1ad-3450200d9354",
                                                "text": "He doesn't realise how hurtful his offhand remarks can be."
                                            },
                                            {
                                                "example_id": "66898c9c-8217-4148-9559-69fd0740be94",
                                                "sense_id": "6ab4c16e-a3cc-3a85-a1ad-3450200d9354",
                                                "text": "In September 2019, on the papal plane en route to Mozambique, Francis acknowledged the sharp opposition he faced from conservative detractors in the United States in an offhand remark. He said, it was “an honor that the Americans attack me.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76630b7c-be31-3555-a8b7-f8c4e2c63716",
                                        "entry_id": "171e6d0c-b46f-31b8-9050-bc4a2b0d4496",
                                        "glosses": [
                                            "Curt, abrupt, unfriendly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cad6df7-0546-444d-b310-553f0c9f3a9f",
                                                "sense_id": "76630b7c-be31-3555-a8b7-f8c4e2c63716",
                                                "text": "She was quite offhand with me yesterday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offhand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3bc4f43-93c0-3479-9fa5-bea9c8f69acd",
                                        "entry_id": "63258576-5847-3042-862b-95936fbbe3d7",
                                        "glosses": [
                                            "Right away, immediately, without thinking about it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2deaaf5-a1d2-4ed7-910c-e8ad94b54cbf",
                                                "sense_id": "e3bc4f43-93c0-3479-9fa5-bea9c8f69acd",
                                                "text": "Offhand, I'd guess that that's a yellow-bellied sapsucker."
                                            },
                                            {
                                                "example_id": "fd13b93d-39e5-468e-b108-7f42f351476a",
                                                "sense_id": "e3bc4f43-93c0-3479-9fa5-bea9c8f69acd",
                                                "text": "We will have no more of this shilly-shallying! Call the Archbishop, and let the Prince and Princess be married offhand!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b69534f-0fa1-3f8a-9655-cf868239f38b",
                                        "entry_id": "63258576-5847-3042-862b-95936fbbe3d7",
                                        "glosses": [
                                            "In an abrupt or unfriendly manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
