                        "glosses": [
                            "Goût, saveur, ressenti au niveau du palais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89315394-e025-45ab-afa0-56d19f50c381",
                                "sense_id": "ee775087-3992-396e-be10-44ca71f892f7",
                                "text": "La palatabilité, ou qualité gustative, dépend de la saveur, de la jutosité et de la tendreté des produits de boeuf."
                            },
                            {
                                "example_id": "49596a94-8c08-44a1-a30b-e514e5f492e9",
                                "sense_id": "ee775087-3992-396e-be10-44ca71f892f7",
                                "text": "Plus on mange quelque chose, plus on entraîne la palatabilité [la sensation agréable procurée lors de la consommation d’un aliment] et le circuit de récompense, et plus on aura de plaisir à le manger."
                            }
                        ]
                    }
