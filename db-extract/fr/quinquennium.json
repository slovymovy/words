                ],
                "senses": [
                    {
                        "sense_id": "f13cbc2c-4b7f-3eda-abe2-24b21c9c1fe6",
                        "entry_id": "93b39dd0-c15a-3034-864e-d066b3250883",
                        "glosses": [
                            "Espace de cinq ans qui s'écoulait entre la célébration des jeux quinquennaux, ou pendant l'exercice d'une magistrature."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "afdd3f75-d006-4f8a-a7be-5ad568177fb0",
                                "sense_id": "f13cbc2c-4b7f-3eda-abe2-24b21c9c1fe6",
                                "text": "En fait, que le quinquennium décerné à César en 59 pouvait ne point finir le 1er mars 54."
                            }
                        ]
                    },
                    {
                        "sense_id": "56d9fd48-e4d6-309c-9e8d-a2beacde68fb",
                        "entry_id": "93b39dd0-c15a-3034-864e-d066b3250883",
                        "glosses": [
                            "Nom anciennement donné à un cours d'études de cinq ans, dont deux en philosophie et trois en théologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2ea3f4a-6bff-4da2-98f6-5241b614ea93",
                                "sense_id": "56d9fd48-e4d6-309c-9e8d-a2beacde68fb",
                                "text": "Certificat de quinquennium, certificat que les universités accordaient aux gradués."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3550da8c-807d-492e-841e-721e9ff24ae5",
                        "source_entry_id": "93b39dd0-c15a-3034-864e-d066b3250883",
                        "target_lang_word": "Jahrfünft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jahrfünft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                        "entry_id": "46db260f-9e2f-35df-bd4e-cde0f765507f",
                                        "glosses": [
                                            "Zeitraum von fünf Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d360a831-03e2-496a-89ea-07e6be944d22",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„Berlin war seit 1871 in jedem Jahrfünft um 200 000 Einwohner gewachsen - aber zu einer Slumbildung wie heute in Städten der Dritten Welt kam es nicht.“"
                                            },
                                            {
                                                "example_id": "2179bd28-6636-4f59-85c2-3cbf7beab8f1",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„Nimmt man das Jahr 1975 als das Jahr mit dem ersten tiefen Beschäftigungseinbruch zum Ausgangspunkt, zeigen sich in den beiden Jahrfünften danach folgende Entwicklungslinien (siehe auch Tabelle II): daß weniger Arbeitnehmerrechte keineswegs zu größerer Produktivität und positiverer wirtschaftlicher Entwicklung führen.“"
                                            },
                                            {
                                                "example_id": "0b9689f2-b8e1-4739-94a2-805a18b81261",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„[…] – so wie wir geneigt sind, die Friedenszeiten, die sich auch in unserem Jahrhundert zwischen die Katastrophen schieben, als die Jahrfünfte oder Jahrzehnte zu begrüßen, in denen die Politik uns eine Atempause gewährt.“"
                                            },
                                            {
                                                "example_id": "e9dbcd0a-3f1f-4d3b-92f0-b194676ed517",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„Während des Jahrfünfts 1988-1992 wurden in den staatlichen Wäldern 46 % des Rundholzes in Eigenregie durch den Forstdienst gefällt und gerückt, während die restlichen 54 % des Rundholzes den Forstlichen Genossenschaften zur Fällung, Rückung und zum Handel […] überlassen wurden.“"
                                            },
                                            {
                                                "example_id": "69e47f14-53e8-48c3-a600-33a4aace303b",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„Äußerungen des gesunden Menschenverstandes. Ich habe es erlebt, wie innerhalb eines Jahrfünftes eine Reihe solcher gestrichener Sätze zu Aussagen und Forderungen der großen Politik werden, die in den Zeitungen stehen.“"
                                            },
                                            {
                                                "example_id": "7588d31d-3ae6-4321-a6b9-03f0c0966577",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„Auch wenn nicht alle Gebiete nutzbar waren, konnte der Staat mit den Ernten des ersten Jahrfünfts (1954-58) zufrieden sein.“"
                                            },
                                            {
                                                "example_id": "69cab777-1c17-482a-a6d1-6e5e1fdb47f3",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„‚[…] Ein Vergleich der Beträge für die beiden letzten Jahrfünfte weist ein Plus von 25 Prozent aus und dabei ist der letzte Wert für 2011 (10,8 Mrd. Euro) fast doppelt so hoch wie der des Vorjahres (5,5 Mrd. Euro) und stellt damit den zweithöchsten Betrag überhaupt dar.‘“"
                                            },
                                            {
                                                "example_id": "4a7db33f-ffe0-4d0c-bd7d-01ee4ed3c475",
                                                "sense_id": "138017f7-6e40-3691-adec-4b5ee29f1586",
                                                "text": "„Diese Entwicklung wurde nur im ersten Jahrfünft nach der Wiedervereinigung vorübergehend unterbrochen[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
