                ],
                "senses": [
                    {
                        "sense_id": "33e3322f-8c79-3db5-8afa-55faed8bd84a",
                        "entry_id": "489c0031-7d96-3b36-92aa-9ad5bc7551b0",
                        "glosses": [
                            "Zuordnung bestimmter Wertvorstellungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8caa7f79-702f-4ebf-9b2d-9b6a9dd68e7e",
                                "sense_id": "33e3322f-8c79-3db5-8afa-55faed8bd84a",
                                "text": "„In solcher Sinngebung kündet sich bereits ein neues Zeitalter vor.“"
                            },
                            {
                                "example_id": "09c1ed1e-642e-45ad-91ad-43bae82381ff",
                                "sense_id": "33e3322f-8c79-3db5-8afa-55faed8bd84a",
                                "text": "„Zwischen fremdverordneten und den eigenen Sehnsüchten erwachsenden Sinngebungen bestehen wesentliche Unterschiede: Die ersten sind vielfach mit Disstress verknüpft, der negativ empfundenen Form der Hochbelastung.“"
                            },
                            {
                                "example_id": "6cd74401-8794-419a-9d52-de8e2863e8ac",
                                "sense_id": "33e3322f-8c79-3db5-8afa-55faed8bd84a",
                                "text": "„In der Novelle Lenz ringt der Held ausdrücklich um die religiöse Sinngebung seines Leids.“"
                            },
                            {
                                "example_id": "9164883f-831a-4c3b-ae14-5271ed046407",
                                "sense_id": "33e3322f-8c79-3db5-8afa-55faed8bd84a",
                                "text": "„Die Beschäftigung mit dem Totenreich der Vergangenheit ist sinnlos, wenn sie nicht der Sinngebung der lebendigen Gegenwart dient.“"
                            },
                            {
                                "example_id": "a5c70bcc-23a7-4881-9ca3-f925994298b6",
                                "sense_id": "33e3322f-8c79-3db5-8afa-55faed8bd84a",
                                "text": "„Seiner Unfähigkeit zur prinzipiellen Sinngebung, zur Einfühlung auch, versucht Schmidt durch Reisen zu entgehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
