                "senses": [
                    {
                        "sense_id": "cab5262c-dd22-3f58-a4f3-99a0c0d9c0c7",
                        "entry_id": "4428b4e2-2aef-3646-96ab-b2e75d49678d",
                        "glosses": [
                            "Bourgeois, habitant d’un bourg, citadin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ac24b3-7fc8-4997-b304-924a6d0b099b",
                                "sense_id": "cab5262c-dd22-3f58-a4f3-99a0c0d9c0c7",
                                "text": "Бюргер или буржуа отдадут скорее жизнь, свободу, честь, но не отступятся от своей собственности.",
                                "translation": "Un bourgeois préférerait abandonner sa vie, sa liberté, son honneur plutôt que d’abandonner ses biens."
                            },
                            {
                                "example_id": "d942861c-7479-4fd3-9fac-403d29d73e60",
                                "sense_id": "cab5262c-dd22-3f58-a4f3-99a0c0d9c0c7",
                                "text": "Он знал, что дом, в который он только что стучался, принадлежит бургомистру, самому богатому бюргеру в городе.",
                                "translation": "Il savait que la maison chez laquelle il venait de frapper appartenait au bourgmestre, le bourgeois le plus riche de la ville."
                            }
                        ]
                    }
                ],
