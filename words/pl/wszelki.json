        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "ede1985f-6c8e-3ea9-b948-cc8b634ee441",
                    "sense_definition": "Słowo uogólniające, wskazujące na ogół rzeczy, spraw lub osób; używane często w utartych zwrotach dla podkreślenia bezwzględności lub całkowitości.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "totality_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy ukończyć ten projekt w terminie za <w>wszelką</w> cenę.",
                            "target_lang_translations": {
                                "ru": "Мы должны закончить этот проект в срок <w>любой</w> ценой.",
                                "en": "We have to finish this project on time at <w>all</w> costs."
                            }
                        },
                        {
                            "text": "Weź ze sobą parasol na <w>wszelki</w> wypadek, bo chmurzy się.",
                            "target_lang_translations": {
