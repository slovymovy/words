{
    "word_family": [
        "связь",
        "связка",
        "вязать",
        "связывать",
        "завязать",
        "развязать",
        "привязать",
        "повязка",
        "вязание",
        "увязать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6752260e-b645-3e06-9e88-da2a02a23fa2",
                    "sense_definition": "Изготовить предмет одежды или полотно из ниток, пряжи с помощью спиц или крючка.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка обещала <связать> мне тёплые шерстяные носки на зиму.",
                            "target_lang_translations": {
                                "en": "Grandma promised to <knit> me warm wool socks for the winter.",
                                "de": "Oma hat versprochen, mir warme Wollsocken für den Winter zu <stricken>."
                            }
                        },
                        {
                            "text": "Она успела <связать> красивый шарф всего за два вечера.",
                            "target_lang_translations": {
                                "en": "She managed to <knit> a beautiful scarf in just two evenings.",
                                "de": "Sie hat es geschafft, in nur zwei Abenden einen schönen Schal zu <stricken>."
                            }
                        }
                    ],
                    "antonyms": [
                        "распустить"
                    ],
                    "common_phrases": [
                        "связать свитер",
                        "связать носки",
                        "связать крючком",
                        "связать спицами"
                    ],
                    "target_lang_definitions": {
                        "en": "To make clothing or fabric from yarn using needles or a hook.",
                        "de": "Einen Gegenstand oder Stoff aus Garn mit Stricknadeln oder einer Häkelnadel herstellen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knit",
                                "target_lang_sense_clarification": "make fabric/clothing"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stricken",
                                "target_lang_sense_clarification": "mit Stricknadeln herstellen"
                            },
                            {
                                "target_lang_word": "häkeln",
                                "target_lang_sense_clarification": "mit einer Häkelnadel herstellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64c92703-16e7-3286-97c2-1176b6b47b53",
                    "sense_definition": "Скрепить, соединить концы чего-либо или обмотать кого-либо верёвкой, узлом, чтобы лишить подвижности.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_binding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <связать> эти старые газеты в стопку, чтобы вынести их.",
                            "target_lang_translations": {
                                "en": "We need to <tie> these old newspapers into a stack to take them out.",
                                "de": "Man muss diese alten Zeitungen zu einem Stapel <binden>, um sie hinauszutragen."
                            }
                        },
                        {
                            "text": "Охранники смогли <связать> грабителя до приезда полиции.",
                            "target_lang_translations": {
                                "en": "The guards were able to <tie up> the robber before the police arrived.",
                                "de": "Die Wachleute konnten den Räuber <fesseln>, bevor die Polizei eintraf."
                            }
                        }
                    ],
                    "synonyms": [
                        "скрутить"
                    ],
                    "common_phrases": [
                        "связать руки",
                        "связать узлом",
                        "связать верёвкой"
                    ],
                    "target_lang_definitions": {
                        "en": "To fasten ends together or wrap someone with rope to restrict movement.",
                        "de": "Die Enden von etwas zusammenbinden oder jemanden mit einem Seil fesseln, um die Bewegungsfreiheit einzuschränken."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tie up",
                                "target_lang_sense_clarification": "secure with rope"
                            },
                            {
                                "target_lang_word": "bind",
                                "target_lang_sense_clarification": "restrain movement"
                            },
                            {
                                "target_lang_word": "tie",
                                "target_lang_sense_clarification": "fasten"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "binden",
                                "target_lang_sense_clarification": "etwas zusammenfügen"
                            },
                            {
                                "target_lang_word": "fesseln",
                                "target_lang_sense_clarification": "jemanden bewegungsunfähig machen"
                            },
                            {
                                "target_lang_word": "zubinden",
                                "target_lang_sense_clarification": "etwas fest verschließen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bcd5564-2ef6-3eeb-8993-8265f3191ed5",
                    "sense_definition": "Соединить что-либо, создать общность или обеспечить сообщение между местами или людьми.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новая дорога должна <связать> отдалённую деревню с центром города.",
                            "target_lang_translations": {
                                "en": "The new road should <connect> the remote village with the city center.",
                                "de": "Die neue Straße soll das abgelegene Dorf mit dem Stadtzentrum <verbinden>."
                            }
                        },
                        {
                            "text": "Они решили <связать> свои жизни и пожениться.",
                            "target_lang_translations": {
                                "en": "They decided to <join> their lives and get married.",
                                "de": "Sie haben beschlossen, ihr Leben miteinander zu <verbinden> und zu heiraten."
                            }
                        }
                    ],
                    "synonyms": [
                        "соединить",
                        "объединить"
                    ],
                    "common_phrases": [
                        "связать жизнь",
                        "связать города",
                        "тесно связать"
                    ],
                    "target_lang_definitions": {
                        "en": "To join places or create a connection between people.",
                        "de": "Orte miteinander verbinden oder eine Beziehung zwischen Menschen herstellen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "connect",
                                "target_lang_sense_clarification": "join places/things"
                            },
                            {
                                "target_lang_word": "link",
                                "target_lang_sense_clarification": "join together"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verbinden",
                                "target_lang_sense_clarification": "eine Verbindung herstellen"
                            },
                            {
                                "target_lang_word": "verknüpfen",
                                "target_lang_sense_clarification": "eine Verbindung schaffen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53b9bf05-a5ad-32be-8fb8-2bd68cf85ddf",
                    "sense_definition": "Организовать общение или разговор между людьми, обычно по телефону или интернету.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Секретарь сейчас может <связать> вас с директором.",
                            "target_lang_translations": {
                                "en": "The secretary can <connect> you with the director now.",
                                "de": "Die Sekretärin kann Sie jetzt mit dem Direktor <verbinden>."
                            }
                        },
                        {
                            "text": "Прошу <связать> меня с отделом технической поддержки.",
                            "target_lang_translations": {
                                "en": "Please <connect> me with the technical support department.",
                                "de": "Bitte <verbinden> Sie mich mit der technischen Support-Abteilung."
                            }
                        }
                    ],
                    "synonyms": [
                        "соединить"
                    ],
                    "common_phrases": [
                        "связать по телефону",
                        "связать с начальником"
                    ],
                    "target_lang_definitions": {
                        "en": "To establish communication between people, usually by phone.",
                        "de": "Eine Kommunikation zwischen Personen herstellen, meistens telefonisch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "connect",
                                "target_lang_sense_clarification": "establish contact"
                            },
                            {
                                "target_lang_word": "put through",
                                "target_lang_sense_clarification": "connect by phone"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verbinden",
                                "target_lang_sense_clarification": "telefonisch weiterleiten"
                            },
                            {
                                "target_lang_word": "durchstellen",
                                "target_lang_sense_clarification": "einen Anruf weiterleiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6293b4f-5115-3b39-b385-6870cb0f68bd",
                    "sense_definition": "Найти или установить логическую зависимость между фактами, событиями или явлениями.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Следователю удалось <связать> эти два происшествия и найти преступника.",
                            "target_lang_translations": {
                                "en": "The investigator managed to <link> these two incidents and find the criminal.",
                                "de": "Dem Ermittler gelang es, diese beiden Vorfälle zu <verknüpfen> und den Täter zu finden."
                            }
                        },
                        {
                            "text": "Трудно <связать> его красивые слова с его плохими поступками.",
                            "target_lang_translations": {
                                "en": "It is hard to <connect> his beautiful words with his bad actions.",
                                "de": "Es ist schwer, seine schönen Worte mit seinen schlechten Taten zu <verbinden>."
                            }
                        }
                    ],
                    "synonyms": [
                        "увязать",
                        "объяснить"
                    ],
                    "common_phrases": [
                        "связать факты",
                        "связать теорию с практикой",
                        "связать воедино"
                    ],
                    "target_lang_definitions": {
                        "en": "To find or establish a logical connection between facts or events.",
                        "de": "Eine logische Abhängigkeit oder einen Zusammenhang zwischen Fakten oder Ereignissen herstellen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "link",
                                "target_lang_sense_clarification": "associate facts"
                            },
                            {
                                "target_lang_word": "connect",
                                "target_lang_sense_clarification": "find relation"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verknüpfen",
                                "target_lang_sense_clarification": "logisch verbinden"
                            },
                            {
                                "target_lang_word": "in Verbindung bringen",
                                "target_lang_sense_clarification": "einen Zusammenhang sehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12aa6f47-9729-3887-a8b9-934786d58cbf",
                    "sense_definition": "Ограничить свободу действий, поставить в зависимое положение (переносное значение).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот договор может <связать> компанию невыгодными условиями на долгие годы.",
                            "target_lang_translations": {
                                "en": "This contract could <bind> the company with unfavorable terms for many years.",
                                "de": "Dieser Vertrag könnte das Unternehmen für lange Jahre durch ungünstige Bedingungen <binden>."
                            }
                        },
                        {
                            "text": "Я не хочу <связать> себя обещанием, которое не смогу выполнить.",
                            "target_lang_translations": {
                                "en": "I don't want to <bind> myself with a promise I won't be able to keep.",
                                "de": "Ich möchte mich nicht durch ein Versprechen <binden>, das ich nicht halten kann."
                            }
                        }
                    ],
                    "common_phrases": [
                        "связать обещанием",
                        "связать обязательствами",
                        "связать по рукам и ногам"
                    ],
                    "target_lang_definitions": {
                        "en": "To restrict freedom of action or impose obligations.",
                        "de": "Die Handlungsfreiheit einschränken oder in eine abhängige Position bringen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bind",
                                "target_lang_sense_clarification": "impose obligation"
                            },
                            {
                                "target_lang_word": "tie down",
                                "target_lang_sense_clarification": "restrict freedom"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "binden",
                                "target_lang_sense_clarification": "verpflichten"
                            },
                            {
                                "target_lang_word": "einschränken",
                                "target_lang_sense_clarification": "in der Freiheit begrenzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}