                        "entry_id": "9e2f4b12-43f8-3a3e-b430-bd0927e1b389",
                        "glosses": [
                            "Great Singapore Sale: An event organized annually by the Singapore Retailers Association to promote Singapore’s tourism industry, with stores and malls having price reductions."
                        ],
                        "tags": [
                            "Singapore"
                        ],
                        "examples": [
                            {
                                "example_id": "c6b961c5-7d3a-4272-ad25-8670ac06945e",
                                "sense_id": "bcb1f27a-b6a7-36c1-9344-0a9e37a117e3",
                                "text": "In yesterday’s GSS supplement, we ran an article on Water Sculptures, a series of dance and music performance by Lifeskills & Lifestyle at People’s Association."
                            },
                            {
                                "example_id": "f6b8de34-632f-4111-a826-f3e30c9a75aa",
                                "sense_id": "bcb1f27a-b6a7-36c1-9344-0a9e37a117e3",
                                "text": "The offer price lasts till the end of the GSS so hurry. ."
                            },
                            {
                                "example_id": "b5c7f534-285c-4e06-910a-d187767296b6",
                                "sense_id": "bcb1f27a-b6a7-36c1-9344-0a9e37a117e3",
                                "text": "The total amount spent during the two-month GSS was US$1.4 billion this year, up US$1 million from the US$1.3billion in the same period last year."
                            },
                            {
                                "example_id": "63d8281d-7464-4c58-8dbf-70ea4948abce",
                                "sense_id": "bcb1f27a-b6a7-36c1-9344-0a9e37a117e3",
                                "text": "Stay vigilant while shopping during GSS: Police."
                            },
                            {
                                "example_id": "6a7d066e-27b7-423c-b816-def86c00161d",
                                "sense_id": "bcb1f27a-b6a7-36c1-9344-0a9e37a117e3",
                                "text": "But shoppers do not have to wait till the GSS starts to go bargain hunting."
                            },
                            {
                                "example_id": "7b0b7911-3757-4612-8e4d-331e1612be10",
                                "sense_id": "bcb1f27a-b6a7-36c1-9344-0a9e37a117e3",
                                "text": "During the GSS, retailers here offer steep discounts, sometimes up to 70 per cent off their original prices."
                            }
                        ]
                    }
