                    {
                        "sense_id": "323411f3-b1ea-38e7-8666-451112a6966c",
                        "entry_id": "6f2c0481-1e10-38ed-b58a-aef6444aa710",
                        "glosses": [
                            "A light, yeasted marble cake, traditionally baked in a circular bundt mould, and popular in parts of Europe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "baa12d2a-2b33-40fb-b368-eeaedfb5a06d",
                                "sense_id": "323411f3-b1ea-38e7-8666-451112a6966c",
                                "text": "What’s for after-school snacking at your house? Or to serve with tea or coffee when “the girls” drop by? / How about a slice of Gugelhupf — yeast-risen cake rich in eggs, fruit and deliciousness!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4bfe780e-82a0-3095-b7b0-2951687d4ec1",
                "word": "gugelhupf",
                "pos": "noun",
