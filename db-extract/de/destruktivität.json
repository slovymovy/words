                        "entry_id": "c01f07a5-3c46-37fd-a7b3-1ace3e5de815",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße zerstörerisches (destruktives) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b60527-2782-4052-8033-3abe7a7b67a6",
                                "sense_id": "f2b08816-995c-34a9-91e6-9f847561c500",
                                "text": "Selbstverstümmelung, und in letzter Konsequenz Selbstmord, ist auf den eigenen Körper gerichtete Destruktivität."
                            },
                            {
                                "example_id": "86cc40e5-0e71-4257-b241-7f2ea780cc36",
                                "sense_id": "f2b08816-995c-34a9-91e6-9f847561c500",
                                "text": "Der Konflikt eskalierte und die Situation mündete darin, dass die Jugendlichen ihrer Destruktivität freien Lauf ließen und den Probenraum verwüsteten."
                            }
                        ],
