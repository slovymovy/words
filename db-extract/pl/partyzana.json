                    },
                    {
                        "translation_id": "8458d4a5-c158-4569-b8f9-795c732f6430",
                        "source_entry_id": "721ff225-f249-3d9d-81e6-22743e0f01a5",
                        "source_sense_id": "967615cf-9b0b-3956-88fe-71385f158660",
                        "target_lang_word": "pertuisane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pertuisane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4db6f69a-a694-3b9b-8228-8d6cd0fd9844",
                                        "entry_id": "529588cc-3b01-37ab-a6cf-c50ca9aa75a5",
                                        "glosses": [
                                            "Ancienne arme d’hast avec un fer triangulaire pourvu à la base de deux orillons symétriques."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "note": "Elle fut utilisée du XVᵉ au XVIIᵉ siècle. Cette hallebarde avait un fer plus long, plus large et plus tranchant que celui des autres armes de ce genre",
                                        "examples": [
                                            {
                                                "example_id": "9817c25c-aa27-437e-b6fa-6d70bfa38b4d",
                                                "sense_id": "4db6f69a-a694-3b9b-8228-8d6cd0fd9844",
                                                "text": "Le clerc était maintenant complètement accoutré en yeoman, avec l’épée et le bouclier, l’arc et le carquois, et une grande pertuisane sur l’épaule."
                                            },
                                            {
                                                "example_id": "b797064d-9bb1-461e-a4e8-fc1f83f97e5b",
                                                "sense_id": "4db6f69a-a694-3b9b-8228-8d6cd0fd9844",
                                                "text": "Le chien avait enfilé une venelle, devant les pertuisanes du guet enrouillé par la pluie et morfondu par la bise."
                                            },
                                            {
                                                "example_id": "a72856d8-8c5a-4513-bb19-d11062e6b864",
                                                "sense_id": "4db6f69a-a694-3b9b-8228-8d6cd0fd9844",
                                                "text": "Et moi, dit l’hôte, […], moi, je vais fourbir ma salade, emmêcher mon arquebuse et affiler ma pertuisane. On ne sait pas ce qui peut arriver."
                                            },
                                            {
                                                "example_id": "7ea998e9-6e5f-4960-a954-4f3618e98207",
                                                "sense_id": "4db6f69a-a694-3b9b-8228-8d6cd0fd9844",
                                                "text": "Nous étions arrivés de nuit à Lübeck. – Lübeck, nom sonore qui sonne comme une pertuisane sur le pavé d'une cathédrale."
                                            },
                                            {
                                                "example_id": "831409ce-986a-407c-ab69-80d60c2a5fe0",
                                                "sense_id": "4db6f69a-a694-3b9b-8228-8d6cd0fd9844",
                                                "text": "Et quoi de plus emmuré […] que les étroits et hauts couloirs voûtés de la villa d'Este, faits pour loger à l'aise hallebardes et pertuisanes dressées ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
