                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4547e543-7740-40da-980a-348dd3f43efc",
                                "sense_id": "441a7490-1922-30ef-b94a-3348e8373e65",
                                "text": "Soleil empyréen."
