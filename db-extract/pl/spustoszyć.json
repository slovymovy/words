                        "cross_references": [
                            {
                                "target_word": "опустошить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b966f675-7d8b-3c99-9a22-4aa708e18af9",
                                        "entry_id": "e4ae5c90-ae8b-36ce-b0df-74750cc53cc5",
                                        "glosses": [
                                            "сделать пустым; опорожнить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f364ab-81d5-4b6a-9409-e0a5b4119649",
                                                "sense_id": "b966f675-7d8b-3c99-9a22-4aa708e18af9",
                                                "text": "В холодильнике он нашел одинокую коробочку вишневого йогурта и быстро опустошил ее, подрагивая от удовольствия, жадно закапываясь чайной ложкой сразу до самого дна и слизывая потом снизу густо стекающие розоватые оборки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f33d9b9-c7bc-37d8-a0e0-28a17c9bdcc4",
                                        "entry_id": "e4ae5c90-ae8b-36ce-b0df-74750cc53cc5",
                                        "glosses": [
                                            "привести в запустение; сделать безлюдным, нежилым"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4874ea36-3ac2-4e21-be0d-f3765aeb09d4",
                                                "sense_id": "6f33d9b9-c7bc-37d8-a0e0-28a17c9bdcc4",
                                                "text": "Покорив землю половцев, Батый напал на Южную Русь и опустошил княжества Черниговское, Киевское, Волынь и Галицию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6747b66f-ecbb-371d-9a64-ee321a3c710f",
                                        "entry_id": "e4ae5c90-ae8b-36ce-b0df-74750cc53cc5",
                                        "glosses": [
                                            "перен. лишить нравственного, духовного содержания; сделать неспособным к активной, творческой жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5d40bb-4ebe-4c1d-a0cc-5eda56e02202",
                                                "sense_id": "6747b66f-ecbb-371d-9a64-ee321a3c710f",
                                                "text": "Нищета суровой природы, холодное однообразие ноябрьской бесснежной пустыни, казалось, опустошили людей, ― не только быт их, но и мысли были бедны, однообразно тоскливы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
