            {
                "entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                "word": "stabiliteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "5b45ec25-0c01-4b1a-bb17-2e4398983ff6",
                        "entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                        "tags": [
                            "plural"
                        ],
                        "form": "stabiliteiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8591cde-97ea-3443-926c-7033e309dee5",
                        "entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                        "glosses": [
                            "een situatie waarin zonder verstoring geen verandering zal plaatsvinden. Dit kan zowel een maatschappelijke, psychologische alsook een natuur- of scheikundige betekenis hebben (dit is de definitie van statisch)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66799c65-5cb3-4295-b8ab-be1da6ea2725",
                                "sense_id": "f8591cde-97ea-3443-926c-7033e309dee5",
                                "text": "Ze beargumenteren op basis van hun onderzoeken onder meer dat je voor economische groei in een land vaak politieke stabiliteit nodig hebt."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6273d07-36ea-3267-964c-9620c9c21325",
                        "entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                        "glosses": [
                            "het vermogen van een dynamisch systeem om in de gewenste evenwichtsstand terug te komen na een verstoring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffc86bcb-70c7-438c-9048-f9c9553e18a6",
                                "sense_id": "e6273d07-36ea-3267-964c-9620c9c21325",
                                "text": "in een stabiel systeem kunnen grote veranderingen plaats vinden(!), de stabiliteit zegt alleen iets over de resistentie tegen ongewenste verstoringen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db6e75e2-e200-414e-8d48-dfd85e36d7f1",
                        "source_entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                        "target_lang_word": "Stabilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stabilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                        "entry_id": "44e0f22a-cc1b-389b-b851-fd0f3ac742c9",
                                        "glosses": [
                                            "Durchhaltevermögen; Belastungskapazität; die Eigenschaft standzuhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1269d18e-a463-4fcf-96fd-58a347ac09e8",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "Die Stabilität der Stahlträger wurde ausgiebig getestet."
                                            },
                                            {
                                                "example_id": "ba502ed3-94cf-42f1-97af-08518458c66f",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Die Befindlichkeit des Reiches war im Inneren durch sozialen Frieden und wirtschaftliche Prosperität gekennzeichnet sowie durch Stabilität in der Außenpolitik, die zeitweilig in den Hintergrund trat.“"
                                            },
                                            {
                                                "example_id": "c54f065b-ac55-40d3-b933-1886c981ab68",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Nach sechzig Jahren politischer Stabilität und mehr oder weniger stetigem Wirtschaftswachstum wird das Nachkriegseuropa, einst ein solides Gebäude, nachgerade baufällig und steht vor einer Identitätskrise, die hässlich zu werden droht.“"
                                            },
                                            {
                                                "example_id": "a47f2458-e39d-4ab5-aaea-5a516a0fce4b",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Stabilität existierte nur dort, wo bewaffnete Gruppen Absprachen miteinander getroffen hatten.“"
                                            },
                                            {
                                                "example_id": "3b57616a-67e2-451b-8253-6160bcd6d9db",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Frieden ist selten am Niger; Phasen der Stabilität wechseln mit Kämpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6d4c810-98b1-4c7a-bedd-dd40e35a038a",
                        "source_entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                        "target_lang_word": "stability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stability",
