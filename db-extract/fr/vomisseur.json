                            {
                                "example_id": "ea1a3458-a6f4-4a86-8fcc-e3825edb933f",
                                "sense_id": "73917c4d-0b44-3d74-8d93-28beb7326dd2",
                                "text": "Que trouvez-vous de libéral en ces vomisseurs de matin, qui ont le corps aussi gras et potelé comme l’esprit tabide et léthargique ?"
                            },
                            {
                                "example_id": "cce21105-04fd-48da-bb9d-ff1ecc1a79f8",
                                "sense_id": "73917c4d-0b44-3d74-8d93-28beb7326dd2",
                                "text": "Il informe son public (qui sera, un jour, le public de François Coppée,) que je suis un « crapaud visqueux et répugnant » (…), « un pleutre », un « polisson », un « poltron », un « vomisseur d’injures. »"
                            }
                        ]
                    }
