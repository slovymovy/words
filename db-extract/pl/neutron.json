                                "target_senses": [
                                    {
                                        "sense_id": "b4cc2104-3435-3c91-89b6-7bc275551576",
                                        "entry_id": "34870931-9770-3131-90f5-ec5a51530fc5",
                                        "glosses": [
                                            "Particule sans charge électrique (neutre), composée d’un quark up et deux quarks down, qui constitue le noyau atomique avec le ou les protons."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7118b41-ab3b-4282-ba59-ecf22f0fc21d",
                                                "sense_id": "b4cc2104-3435-3c91-89b6-7bc275551576",
                                                "text": "Le noyau de deutérium est composé d’un proton et d’un neutron."
                                            },
                                            {
                                                "example_id": "3c6843dc-762a-457b-be8e-082efcd4db25",
                                                "sense_id": "b4cc2104-3435-3c91-89b6-7bc275551576",
                                                "text": "Le neutron est une particule qui présente des caractéristiques très spécifiques par rapport aux autres rayonnements et autour duquel de nombreuses techniques insrtumentales ont été développées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
