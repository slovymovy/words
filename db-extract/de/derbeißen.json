                                                "sense_id": "b3c781bf-f84b-3043-a74f-bdd70cb52917",
                                                "text": "Er hat den Bonbon zerbissen."
                                            },
                                            {
                                                "example_id": "21037c05-187a-436c-82f1-6fa5b6ecd906",
                                                "sense_id": "b3c781bf-f84b-3043-a74f-bdd70cb52917",
                                                "text": "Der Hund zerbiss seine Leine."
