                                                "example_id": "dd112c4a-38b2-4d38-9535-57f3b71c47f2",
                                                "sense_id": "7ccc84d0-7ff9-3e1d-9315-1085e53d1038",
                                                "text": "The same Night it began to operate by Grippings and Sweating, and he being bred a Surgeon, took some Medicines to correct the Grippings, which in some Measure the Medicine did, but he lost his Appetite […]"
                                            }
                                        ]
                                    }
                                ]
