            "senses": [
                {
                    "sense_id": "6764be06-55fd-3849-ab26-66c8fa871951",
                    "sense_definition": "An awkward, naive, or unsophisticated person from a rural area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pejorative_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a total <w>hick</w> when he arrived in the big city for the first time.",
                            "target_lang_translations": {
                                "tr": "Büyük şehre ilk kez geldiğinde kendini tam bir <w>taşralı</w> gibi hissetti."
                            }
                        },
                        {
                            "text": "The city people often treated the local farmers like <w>hicks</w>.",
                            "target_lang_translations": {
                                "tr": "Şehirliler yerel çiftçilere genelde <w>köylü</w> muamelesi yapıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "yokel",
                        "rube",
                        "hillbilly",
                        "rustic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in a derogatory or insulting manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kırsal kesimden gelen, görgüsüz, toy veya kaba saba kimse."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "köylü",
                                "target_lang_sense_clarification": "görgüsüz, kaba anlamında aşağılayıcı"
                            },
                            {
                                "target_lang_word": "taşralı",
                                "target_lang_sense_clarification": "dünyadan habersiz, saf kimse"
                            },
                            {
                                "target_lang_word": "dağ ayısı",
                                "target_lang_sense_clarification": "kaba saba kimse için argo"
                            }
                        ]
                    }
                }
            ]
        },
        {
