                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1fbaaf7-7966-42e9-91ac-813619ff6632",
                                "sense_id": "75197e3a-641b-3cad-be2e-fb3ac052ce6a",
                                "text": "La pathologie nous offre des cas de substitution si nets qu’il convient de commencer par eux afin de bien précréer la nature du fait que l’on étudie."
                            },
                            {
                                "example_id": "92afcb96-6516-4160-a749-8d0a335ca9ed",
                                "sense_id": "75197e3a-641b-3cad-be2e-fb3ac052ce6a",
                                "text": "Ceci met en lumière la fonction dite « prophétique » de la poésie, seule science capable en fait de profiler et de précréer l’avenir."
