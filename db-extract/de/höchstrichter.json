                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053d667a-175e-40c9-8f36-693cd23266c5",
                                "sense_id": "21114fa6-1b8b-3b29-ba44-debf7aab0aba",
                                "text": "„Die Höchstrichter erhalten 90 Prozent der Bezüge eines Abgeordneten im Nationalrat, also 7.998,39 Euro monatlich.“"
                            },
                            {
                                "example_id": "e233b506-483e-483e-9429-b879b73b9078",
                                "sense_id": "21114fa6-1b8b-3b29-ba44-debf7aab0aba",
                                "text": "„Im Vorjahr hatte er durch die Ernennung des konservativen Juristen Neil Gorsuch das zuvor bestehende Patt zwischen vier liberalen und vier konservativen Höchstrichtern aufgehoben.“"
                            },
                            {
                                "example_id": "151d0b9d-1ef6-4b0b-96ee-ee3a00533bcc",
                                "sense_id": "21114fa6-1b8b-3b29-ba44-debf7aab0aba",
                                "text": "„Zu ihnen gesellte sich noch ein ehemaliger Höchstrichter, der die angeblichen Taten an die Klub-Obmänner aller Parlamentsparteien verteilte.“"
                            }
                        ],
