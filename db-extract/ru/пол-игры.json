                                                "sense_id": "d40e0f0d-bc02-3024-9281-7af2e81208ce",
                                                "text": "half-colored"
                                            },
                                            {
                                                "example_id": "f9eaa32f-661e-4712-8192-0f94bb2ea064",
                                                "sense_id": "d40e0f0d-bc02-3024-9281-7af2e81208ce",
