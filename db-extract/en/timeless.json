                    },
                    {
                        "translation_id": "8f6ff20d-9941-4677-aaf0-b44648ab737a",
                        "source_entry_id": "98630a2a-7888-3c9a-bc0d-1bbe6c850e24",
                        "source_sense_description": "not decreasing over time in quality and appeal",
                        "target_lang_word": "intemporel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intemporel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "048bfb34-9abd-3511-a185-14144a697620",
                                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                                        "glosses": [
                                            "Que l’on ne peut dater, qui est de toutes les époques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c3b2a18-a76f-4fa1-b259-c0bfaa990c58",
                                                "sense_id": "048bfb34-9abd-3511-a185-14144a697620",
                                                "text": "Voici une étape aussi sauvage qu'inédite entre l’intemporel village de Condé-Sainte-Libiaire et la fameuse ancienne chocolaterie de Noisiel. Cet itinéraire offre de magnifiques passages au plus près la Marne."
                                            },
                                            {
                                                "example_id": "d608107d-f904-40be-ac5a-c45e82c0be97",
                                                "sense_id": "048bfb34-9abd-3511-a185-14144a697620",
                                                "text": "Elle portait un pantalon de velours intemporel et un pull à col roulé fluide qui glissait sur son torse mince."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "569e7d5f-960b-3a08-9667-1f983ea6e925",
                                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                                        "glosses": [
                                            "Qui reste valable en tout temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90bc3b5b-4b0d-4d42-b722-230e175d0b05",
                                                "sense_id": "569e7d5f-960b-3a08-9667-1f983ea6e925",
                                                "text": "Lorsque des dispositions sont insérées dans un code, ce qui est devenu un cas de figure courant, elles doivent revêtir le caractère intemporel de celui-ci. Par suite, on n’écrit pas : « Il est créé une commission nationale de… chargée de… », mais « La commission nationale… est chargée de… »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0f7d84-7f87-31a1-9f36-f7abc0136a3b",
                                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                                        "glosses": [
                                            "Impérissable, éternel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26f12df-7718-4ba3-86ee-c1e8e81463e2",
                                                "sense_id": "ff0f7d84-7f87-31a1-9f36-f7abc0136a3b",
                                                "text": "Ces festivités, ce sont aussi des moments emprunts de coutumes quasi immuables. …. Il s’agit-là des valeurs intemporelles du Têt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b8bd934-25f3-4720-89e8-334ed27cadde",
                        "source_entry_id": "98630a2a-7888-3c9a-bc0d-1bbe6c850e24",
                        "source_sense_description": "not decreasing over time in quality and appeal",
                        "target_lang_word": "zeitlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeitlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                        "entry_id": "01a34f77-ab7c-37f2-a971-160dd3f2a0f6",
                                        "glosses": [
                                            "nicht einer bestimmten Mode oder Epoche unterliegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a78dff3-4442-4fc3-bbca-ad141cfb82fd",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Es gibt Autoklassiker wie einen Porsche Spyder 550, einen Mercedes 300 SL oder einen Karmann Ghia Typ 14, die sind zeitlos schön."
                                            },
                                            {
                                                "example_id": "c3bff4f9-f429-4fe6-8952-32b317d5d1c7",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Das Kleine Schwarze trug Audrey Hepburn in \"Frühstück bei Tiffany\", einem Film aus dem Jahr 1961. Es verkörpert zeitlose Eleganz. Denn auch heute noch wird das Kleine Schwarze gern getragen."
                                            },
                                            {
                                                "example_id": "016b0dd3-1f04-4b15-b208-d61bd78e5bee",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Das Klassische bildet somit den zeitlosen Kontrapunkt zur zeitabhängigen Mode. Beispiel: die klassische „griechische“ Nase oder die „klassische“ Rennstrecke von 100 m."
                                            },
                                            {
                                                "example_id": "74b8289a-bc2e-4e64-9d06-b14f6d378cd3",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Der Begriff \"Gute Form\" wurde in den 1950er Jahren geprägt und steht für ein Design, das zeitlos gültig sein sollte: Durch eine funktionelle, sachliche und trotzdem ästhetisch gültige Gestaltung sollte eine Dauerhaftigkeit der Dinge geschaffen werden, die über den modischen Zeitgeist hinausgeht."
                                            },
                                            {
                                                "example_id": "9bffd72e-9f7a-4a94-85df-385cc0e14f31",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "„Die Sehnsucht nach Tiefenerkenntnis der göttlichen Bestimmung des Menschen ist zeitlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
