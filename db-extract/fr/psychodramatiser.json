                "senses": [
                    {
                        "sense_id": "d50221e7-a627-317b-a50e-d898c744eb19",
                        "entry_id": "d60e7a36-149c-38fa-80b2-27fe8941347e",
                        "glosses": [
                            "Donner un caractère psychodramatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733af901-0da4-4666-b99a-593fb28e9c02",
                                "sense_id": "d50221e7-a627-317b-a50e-d898c744eb19",
                                "text": "Nous avions tenté de psychodramatiser ses angoisses (« Tempête Colère »), de les pictographier."
                            },
                            {
                                "example_id": "b122defc-3ed9-4a40-989c-0d38fc0b114c",
                                "sense_id": "d50221e7-a627-317b-a50e-d898c744eb19",
                                "text": "La discontinuité règne, en refusant le mouvement naturel des acteurs qui consiste aussi bien à « psychodramatiser » le rôle et à défendre le réalisme, mouvement auquel le corps vitézien entend ne jamais se soumettre : il affirme d’abord et surtout le théâtre."
                            }
                        ]
                    }
