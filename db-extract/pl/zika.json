                        "sense_id": "6a102782-9b91-3d6d-8fa6-fa8d62575409",
                        "entry_id": "361da65b-f463-3aca-9982-313682023f73",
                        "glosses": [
                            "wirus przenoszony przez komary, który rozprzestrzenił się w Azji, Ameryce i Europie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32754f8f-8bd1-4cbe-9a0b-71b67c613018",
                                "sense_id": "6a102782-9b91-3d6d-8fa6-fa8d62575409",
                                "text": "Byliśmy głęboko zaangażowani w walkę z wirusem ebola, równie mocno zaangażujemy się teraz w walkę z wirusem zika"
                            },
                            {
                                "example_id": "771b0e90-48df-4f43-bcd9-769e743e8134",
                                "sense_id": "6a102782-9b91-3d6d-8fa6-fa8d62575409",
                                "text": "Jeżeli zika pojawi się w Polsce, to będą to raczej pojedyncze przypadki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
