                    {
                        "sense_id": "8ce7f493-b970-3397-bf35-b93f87b2754a",
                        "entry_id": "71924d8e-90b9-328f-84f7-a690f8631049",
                        "glosses": [
                            "Equus caballus klein halfwild paard dat oorspronkelijk uit Polen en Wit-Rusland komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413c4dd4-0b67-45a8-9c6c-f70a6cec5093",
                                "sense_id": "8ce7f493-b970-3397-bf35-b93f87b2754a",
                                "text": "\"In de Oostvaardersplassen, helemaal niet zo'n groot gebied, is de afgelopen drie maanden elke werkdag elke tien minuten een heckrund, konikpaard of edelhert afgeschoten. Dat betekent dat er omgerekend per dag een vrachtwagen aan kadavers wordt afgevoerd.\""
                            },
                            {
                                "example_id": "cf44ecad-b020-4867-af7f-ad57a45ccaa3",
                                "sense_id": "8ce7f493-b970-3397-bf35-b93f87b2754a",
                                "text": "Er is vaker discussie over het welzijn van de heckrunderen, konikpaarden en edelherten die leven in natuurgebieden. Zo was er eerder dit jaar ophef over de slacht van twee konikpaarden, omdat ze een afwijkende kleur hadden."
                            }
                        ]
                    }
