                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85022658-1991-40ad-9761-59169ecb1a99",
                                                "sense_id": "3b5077d5-d636-3e8c-8334-f9b1354067c8",
                                                "text": "satellite dish"
                                            },
                                            {
                                                "example_id": "735853fe-5da4-4e60-88b2-aa8a195945d1",
                                                "sense_id": "3b5077d5-d636-3e8c-8334-f9b1354067c8",
                                                "text": "radar dish"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52cdb29e-fbe5-371c-94ec-7f500d2bd6bf",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "A sexually attractive person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb54461-7198-40e9-9924-4fb9348bce6c",
                                                "sense_id": "52cdb29e-fbe5-371c-94ec-7f500d2bd6bf",
                                                "text": "quite a dish"
                                            },
                                            {
                                                "example_id": "af41f2b2-b59b-4367-8abb-e461d79574aa",
                                                "sense_id": "52cdb29e-fbe5-371c-94ec-7f500d2bd6bf",
                                                "text": "Have you seen the new apothecary? I think her name is Sadie. What a dish!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6abf6cbb-8dd5-38c5-8cd7-35d236b3f02c",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "The state of being concave, like a dish, or the degree of such concavity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b681ea9-c183-4874-ba02-b96d921f7a9d",
                                                "sense_id": "6abf6cbb-8dd5-38c5-8cd7-35d236b3f02c",
                                                "text": "the dish of a wheel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "806d126b-db02-3907-b0d0-a7c783871e57",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "A hollow place, as in a field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f4ee73-657d-4308-8a47-488bdbfe6ff3",
                                                "sense_id": "806d126b-db02-3907-b0d0-a7c783871e57",
                                                "text": "As I topped the ridge I missed my first shot at a sharptail that flushed from a grassy dish."
                                            },
                                            {
                                                "example_id": "3f4085e1-1d61-4c25-89cb-09a976248855",
                                                "sense_id": "806d126b-db02-3907-b0d0-a7c783871e57",
                                                "text": "He and Stratemeier raced across the flats and dropped into the canyon, climbed swiftly through it and came out at the topside trail , which went straight south through the timber until it dropped into a small grassy dish surrounded by rock peaks."
                                            },
                                            {
                                                "example_id": "ea2b7eb9-b56e-4a71-8781-0eefebd23736",
                                                "sense_id": "806d126b-db02-3907-b0d0-a7c783871e57",
                                                "text": "Daylight revealed that the so-called summit was near the edge of a shallow, stony dish, which terminated abruptly in steep slopes, and actually offered poor fields of fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7056f68b-c90c-3b5c-9009-38b34f17ba05",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "The home plate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc26eaff-23d7-4177-9c30-22dabf68730f",
                                                "sense_id": "7056f68b-c90c-3b5c-9009-38b34f17ba05",
                                                "text": "He said, \"I don't like your chances at the dish [home plate] tonight.\""
                                            },
                                            {
                                                "example_id": "a2fcb32a-fe21-474c-bef0-acbb8435a544",
                                                "sense_id": "7056f68b-c90c-3b5c-9009-38b34f17ba05",
                                                "text": "At the plate, Graham pounded the dish three times, just like Bubbles did whenever he was up, […]"
                                            },
                                            {
                                                "example_id": "554f893f-f283-4827-8c90-d514f06311b0",
                                                "sense_id": "7056f68b-c90c-3b5c-9009-38b34f17ba05",
                                                "text": "Also, if you end up getting to the baseball, your pitcher needs to be covering home plate, which pitchers occasionally forget to do. However, if the ball stays near the dish and you have a pitcher on the mound who isn't a space-case, you've got a good shot to get the runner out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77985037-85e4-36cc-b4e1-92571f65c5b8",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "A trough in which ore is measured."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a9966ea-d580-35b0-9faa-3e6839db9b7f",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "That portion of the produce of a mine which is paid to the land owner or proprietor."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea74d675-b6e4-3d2e-904f-e38b9c5f9800",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "Gossip."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42885f7c-98c4-4f61-bb9b-f1e9779384dd",
                                                "sense_id": "ea74d675-b6e4-3d2e-904f-e38b9c5f9800",
                                                "text": "We've been a very lucky community: We've had GCN to collect our deep dish and write it up as political discourse. GCN is not just another clipboard of polite press releases. GCN is the sticky questions, the sweet moments, and the dirty stories that make up our lives."
                                            }
                                        ]
                                    }
                                ]
                            },
