                    }
                ],
                "translations": [
                    {
                        "translation_id": "62c20d4b-83e7-414a-aa5e-3d8900442e4f",
                        "source_entry_id": "ac193448-f6c2-3a06-947e-1c4a853fa8fd",
                        "source_sense_id": "37f2b72b-8c1c-36e4-b332-cda86b281451",
                        "target_lang_word": "knedlík",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knedlík",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d57f104d-b95f-3b93-9f9e-d492f20ba524",
                                        "entry_id": "ef4bfff4-feb7-3345-8659-a31baf1cdaee",
                                        "glosses": [
                                            "vařený pokrm vyrobený z těsta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e222a5cc-b599-4d27-bddb-bb0d9fe00765",
                                                "sense_id": "d57f104d-b95f-3b93-9f9e-d492f20ba524",
                                                "text": "Aroma jahod, ve kterém se snoubí výrazná kyselinka s vyzrálou sladkostí, se hodí ke křehkému těstu, tvarohovým knedlíkům i tučné smetaně."
                                            },
                                            {
                                                "example_id": "e2d68e51-6482-4f51-887c-99406964fe0d",
                                                "sense_id": "d57f104d-b95f-3b93-9f9e-d492f20ba524",
                                                "text": "A nad Středozemním mořem zpíval si dobrý voják Švejk: „Kdo chce býti veliký, musí jísti knedlíky, ajn, cvaj, na vojně ho nezabijou, ajn, cvaj, poněvadž jed knedlíky, ty vojanský knedlíky jako hlavy veliký, ajn, cvaj.“"
                                            },
                                            {
                                                "example_id": "09bf883f-a3c9-4598-b6c5-a03fb452288e",
                                                "sense_id": "d57f104d-b95f-3b93-9f9e-d492f20ba524",
                                                "text": "Stručně doplním, že se dodnes nejen v kuchyni rakouských rodin i mnohých restaurací udržela nekonečná řada zajímavých pokrmů, které se u nás přestaly vařit, a tudíž i jíst. Jen jeden příklad za všechny. Také naši sousedé holdují knedlíkům, ale většina z nich je žemlových a těsto doplňuje jednou slanina, podruhé špenát, jindy bylinky a třeba i sýr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc9ee3e-2fd3-36ca-ac70-f2129a0a6a69",
                                        "entry_id": "ef4bfff4-feb7-3345-8659-a31baf1cdaee",
