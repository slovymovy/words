        "ru-extract.jsonl": [
            {
                "entry_id": "074c1ec1-87ee-3ed9-9fbb-21c0d267d45c",
                "word": "понимаешь",
                "pos": "particle",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7129181-c958-33d7-9190-096a75abd883",
                        "entry_id": "074c1ec1-87ee-3ed9-9fbb-21c0d267d45c",
                        "glosses": [
                            "разг. используется для того, чтобы задержать внимание собеседника на предмете разговора, придать доверительность высказыванию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfea2a9a-c0ad-49e3-b82f-9113720f97aa",
                                "sense_id": "a7129181-c958-33d7-9190-096a75abd883",
                                "text": "А когда я узна́ю правду, понимаешь, правду, тогда и подумаем, как тебе помочь."
                            }
                        ]
                    },
                    {
                        "sense_id": "386abc68-a0a2-306b-9a51-35a31f3f95dd",
                        "entry_id": "074c1ec1-87ee-3ed9-9fbb-21c0d267d45c",
                        "glosses": [
                            "разг. используется для выражения возмущения, негодования, недовольства и т. п., иронии по поводу сообщаемого, для иронического цитирования чьей-либо речи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170ee642-a134-4961-86d2-81adc6d85103",
                                "sense_id": "386abc68-a0a2-306b-9a51-35a31f3f95dd",
                                "text": "— Присаживайся, — указал он Артёму на ближайший мешок. — Они там, понимаешь, веселятся, оставили меня здесь одного прозябать. Дай хоть с тобой поболтаю."
                            },
                            {
                                "example_id": "c64be3ff-9453-44ea-a5f8-8855e2d72ce7",
                                "sense_id": "386abc68-a0a2-306b-9a51-35a31f3f95dd",
                                "text": "Если заходит разговор о пробках, чиновники незамедлительно кивают на милицию, дескать, плохо организует дорожное движение. Та, в свою очередь, валит всё на водителей — невоспитанный у нас народ, понимаешь, от того все бе́ды."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcd9a0bb-48e9-4801-b8a1-b111ee8469fa",
                        "source_entry_id": "074c1ec1-87ee-3ed9-9fbb-21c0d267d45c",
                        "source_sense_description": "используется для того, чтобы задержать внимание собеседника на предмете разговора, придать доверительность высказыванию",
                        "target_lang_word": "you know",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "you know",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fea9f73-e178-3604-b94f-c050bfc868e0",
                                        "entry_id": "ef9d0be5-438d-3537-96e8-c09b82b2950b",
                                        "glosses": [
                                            "Expression signifying a pause or hesitation."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab18d25d-cdf1-4b63-8211-f794d2615c67",
                                                "sense_id": "3fea9f73-e178-3604-b94f-c050bfc868e0",
                                                "text": "I don’t usually get nervous in games and, you know, taking free kicks and penalties but that’s the first time I’ve been that nervous in, in a game, where I have to, I’m in a situation where I’m, you know […]"
                                            },
                                            {
                                                "example_id": "0cbbf69e-9f8c-40cd-b6cc-41abe6fd9b27",
                                                "sense_id": "3fea9f73-e178-3604-b94f-c050bfc868e0",
                                                "text": "Once, I remember, I was watching the twins on a trampoline, you know, and they looked so beautiful, and I was happy because they were happy, you know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992677c5-4f21-344f-b231-9ba1c4d54390",
                                        "entry_id": "ef9d0be5-438d-3537-96e8-c09b82b2950b",
                                        "glosses": [
                                            "Expression used to imply meaning, rather than say it, such as when a person is embarrassed."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620de757-dfd6-4df2-8dac-7ed235c258a4",
                                                "sense_id": "992677c5-4f21-344f-b231-9ba1c4d54390",
                                                "text": "A: I can’t go to the party because... you know...\nB: Your mom is still mad at you, huh?\nA: Yeah..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e64e848-0591-3dd0-88e1-819fdc6adecc",
                                        "entry_id": "ef9d0be5-438d-3537-96e8-c09b82b2950b",
                                        "glosses": [
                                            "Used as a rhetorical question to confirm agreement, knowing or understanding at the end of a statement."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5418fb14-dff5-4749-8c8a-e5452f51320b",
                                                "sense_id": "0e64e848-0591-3dd0-88e1-819fdc6adecc",
                                                "text": "But I guess that's life, you know?"
                                            },
                                            {
                                                "example_id": "4734f035-7e74-4cdd-9e35-51d098678661",
                                                "sense_id": "0e64e848-0591-3dd0-88e1-819fdc6adecc",
                                                "text": "I just wasn't into it, you know?"
                                            },
                                            {
                                                "example_id": "2ca11938-291c-4caa-a91e-a072f1fdb301",
                                                "sense_id": "0e64e848-0591-3dd0-88e1-819fdc6adecc",
                                                "text": "This was already a fresh departure for me. I was not used to get things that way, you know."
                                            },
                                            {
                                                "example_id": "4e3f26ed-8066-4464-9713-80944707592c",
                                                "sense_id": "0e64e848-0591-3dd0-88e1-819fdc6adecc",
                                                "text": "\"I heard Winnie the Pooh was like garlic to a vampire to the Chinese commies,\" he said. \"Popular arts and music, poetry, dancing and singing is a threat to those in power, and I'm really trying to bring back that rock-and-roll rebellious spirit into music, you know.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "758ebe76-a5a8-3f99-9e6e-14670698aba8",
                                        "entry_id": "ef9d0be5-438d-3537-96e8-c09b82b2950b",
                                        "glosses": [
                                            "Used to introduce information."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88bc133e-8953-4090-a949-5f860f42ad6c",
                                                "sense_id": "758ebe76-a5a8-3f99-9e6e-14670698aba8",
                                                "text": "You know, he's actually pretty nice."
                                            },
                                            {
                                                "example_id": "49908923-829c-4514-9dba-24d543883ccf",
                                                "sense_id": "758ebe76-a5a8-3f99-9e6e-14670698aba8",
                                                "text": "Tali: You know, there's always a few who go on their Pilgrimages and never return. I always assumed something bad happened to them, but maybe they just wanted a different life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d75cb1e6-f642-34da-8a51-4c2dd82a4087",
                                        "entry_id": "ef9d0be5-438d-3537-96e8-c09b82b2950b",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see you, know."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
