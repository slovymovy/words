                "senses": [
                    {
                        "sense_id": "88b08efb-625d-3d10-b155-dd3debb9ed8e",
                        "entry_id": "99fae905-19df-3a54-b9f7-8696ab96c6fc",
                        "glosses": [
                            "Substantiver à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8570b32d-d611-4c6e-8177-0e62272a14e8",
                                "sense_id": "88b08efb-625d-3d10-b155-dd3debb9ed8e",
                                "text": "L'artiste doit créer lui-même un contexte afin d'isoler son propre langage et le rendre différent : resubstantiver ce qui est devenu adjectif."
                            },
                            {
                                "example_id": "dc642185-083a-48e6-b15e-a4bd57e3d3ed",
                                "sense_id": "88b08efb-625d-3d10-b155-dd3debb9ed8e",
                                "text": "Le substantif adjectivisé bête (il est très bête, etc.), lorsqu'il est resubstantivé, est souvent dans la langue courante, employé au masculin : voyez-moi ce gros bête!"
                            }
                        ]
                    }
