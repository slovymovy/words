        "nl-extract.jsonl": [
            {
                "entry_id": "aff55acf-6342-3c0b-8278-940f7cdc232f",
                "word": "gekibbel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ae8b22b6-c266-3287-a208-877ae1f0f802",
                        "entry_id": "aff55acf-6342-3c0b-8278-940f7cdc232f",
                        "glosses": [
                            "aanhoudend ruzie maken over onbelangrijke dingen, over beuzelingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9182ab87-b8a3-42b4-b98e-f47528075549",
                                "sense_id": "ae8b22b6-c266-3287-a208-877ae1f0f802",
                                "text": "Waarom zouden de politici, wier beleid tot nu toe heeft uitgeblonken in zigzagbewegingen, uitstelgedrag en onderling gekibbel, dit keer wel in staat zijn tot daadkrachtig beleid? Het grootste probleem van het ontwerp is dat de concrete uitwerking ontbreekt."
                            },
                            {
                                "example_id": "c72fe5d8-6071-47ed-901b-72c38174f5e6",
                                "sense_id": "ae8b22b6-c266-3287-a208-877ae1f0f802",
                                "text": "Ondanks het gekibbel, was er ook ruimte om over emoties te praten. De Robinsonners kregen in de vorm van een brief of korte video eindelijk bericht van het thuisfront. En dat deed ze goed, al zorgde het wel voor de nodige waterlanders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e094ff1-bf45-4795-9061-145eb08710b8",
                        "source_entry_id": "aff55acf-6342-3c0b-8278-940f7cdc232f",
                        "source_sense_id": "ae8b22b6-c266-3287-a208-877ae1f0f802",
                        "target_lang_word": "bickering",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bickering",
