                                "target_word": "phallus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f420d4f8-0583-390b-a90f-58e4e683bf5c",
                                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                                        "glosses": [
                                            "Représentation du membre viril en érection, emblème de la fécondité, de la puissance génésique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df3277c0-cc63-4135-b92b-2bad58ad5aab",
                                                "sense_id": "f420d4f8-0583-390b-a90f-58e4e683bf5c",
                                                "text": "Du temps que j’étais gouverneur de Syrie, j’ai vu des phallus érigés sur les propylées de la ville d’Héra."
                                            },
                                            {
                                                "example_id": "0187ef37-ddd2-409a-83c7-ae61fbcb3a0f",
                                                "sense_id": "f420d4f8-0583-390b-a90f-58e4e683bf5c",
                                                "text": "Dans une comédie, il fallait bien sûr que les phallus pendouillassent par moments, mais il fallait aussi qu'ils pussent se dresser sur commande. Tout le monde savait cela."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec803331-c064-3d72-a6bc-84142a5f9203",
                                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                                        "glosses": [
                                            "Concept psychanalytique recouvrant le désir de puissance ou la puissance attribuée à l’objet d’un désir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ed7363-bf7a-43ad-acde-b13059b566b9",
                                                "sense_id": "ec803331-c064-3d72-a6bc-84142a5f9203",
                                                "text": "avoir le phallus."
                                            },
                                            {
                                                "example_id": "8af800fa-eabd-4076-a55f-765d95d4894c",
                                                "sense_id": "ec803331-c064-3d72-a6bc-84142a5f9203",
                                                "text": "Le phallus maternel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add0369d-e6d8-37a5-8c2c-906550bff46f",
                                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                                        "glosses": [
                                            "Concept psychanalytique recouvrant le désir de puissance ou la puissance attribuée à l’objet d’un désir.",
                                            "Signifiant du manque."
                                        ],
                                        "tags": [
                                            "Chez Lacan"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9893fd5-4e16-4adc-ae7b-70d2d3b4aadd",
                                                "sense_id": "add0369d-e6d8-37a5-8c2c-906550bff46f",
                                                "text": "Le phallus dans la doctrine freudienne n’est pas un fantasme […]. Il n’est pas non plus comme tel un objet (partiel, interne, bon, mauvais etc.) […]. Il est encore bien moins l’organe, pénis ou clitoris, qu’il symbolise […]. C’est le signifiant destiné à désigner dans leur ensemble les effets de signifié, en tant que le signifiant les conditionne par sa présence de signifiant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a73fe0-0e11-3fc2-9b08-a131035acaf4",
                                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                                        "glosses": [
                                            "Champignon, également appelé satyre puant, de forme phallique, à odeur repoussante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
