                    {
                        "translation_id": "ecd4cbdf-1da9-4926-89d2-8cee3105f1ed",
                        "source_entry_id": "ff9998ef-cce3-3e8f-ba25-116f167b25d2",
                        "source_sense_id": "992fd7c2-4e7f-342d-9af7-1d4a044151d9",
                        "target_lang_word": "phony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70dd4c88-e594-3308-8261-2f2ac8652c59",
                                        "entry_id": "ce847342-93b9-3121-a343-4e2f23fe4fe2",
                                        "glosses": [
                                            "Fraudulent; fake; having a misleading appearance."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf550b65-4435-4cf9-a4ea-f4f139f2e10c",
                                                "sense_id": "70dd4c88-e594-3308-8261-2f2ac8652c59",
                                                "text": "A good jeweler should be able to tell a real stone from a phony one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70bfe2a4-247d-31b1-87be-cb50f6be6947",
                                        "entry_id": "a011a1bb-f214-3518-9fa1-3a1cc88a8ae4",
                                        "glosses": [
                                            "A person who assumes an identity or quality other than their own."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d23256-1597-49dd-b188-c85e5c1567f1",
                                                "sense_id": "70bfe2a4-247d-31b1-87be-cb50f6be6947",
                                                "text": "He claims to be a doctor, but he's nothing but a fast-talking phony."
                                            },
                                            {
                                                "example_id": "9cd81f06-9d6f-49b9-abad-3f988d3cb5d3",
                                                "sense_id": "70bfe2a4-247d-31b1-87be-cb50f6be6947",
                                                "text": "What a deal that was. You never saw so many phonies in all your life, everybody smoking their ears off and talking about the play so that everybody could hear and know how sharp they were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c901729-1a08-30fc-b670-d42b80d870aa",
                                        "entry_id": "a011a1bb-f214-3518-9fa1-3a1cc88a8ae4",
                                        "glosses": [
                                            "A person who professes beliefs or opinions that they do not hold."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8141e7-c7c4-45b9-89f8-41fcf731df55",
                                                "sense_id": "3c901729-1a08-30fc-b670-d42b80d870aa",
                                                "text": "He's such a phony, he doesn't believe half of what he says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73d80c5d-4f02-30fd-b57b-9531477898d5",
                                        "entry_id": "a011a1bb-f214-3518-9fa1-3a1cc88a8ae4",
                                        "glosses": [
                                            "Anything fraudulent or fake."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ab1351-5e53-421d-bcb0-974dddb68103",
                                                "sense_id": "73d80c5d-4f02-30fd-b57b-9531477898d5",
                                                "text": "One name was a phony, but the other was the true name. The clerk remembered the man who had filed the tags since he acquired two sets of plates with different names."
                                            }
                                        ]
                                    }
                                ]
                            },
