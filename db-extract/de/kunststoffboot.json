                "senses": [
                    {
                        "sense_id": "560394ab-6333-38a0-98f2-d9266c7947f1",
                        "entry_id": "423df9f4-16f5-37d3-8c88-750cf3d351cb",
                        "glosses": [
                            "kleines Wasserfahrzeug, das aus Kunststoffen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64507ed-1378-47f6-83f1-c9d6397be2de",
                                "sense_id": "560394ab-6333-38a0-98f2-d9266c7947f1",
                                "text": "So manches Kunststoffboot passt gar in den Kofferraum."
                            },
                            {
                                "example_id": "5e020167-ca23-46a3-abc5-1c6a8699235e",
                                "sense_id": "560394ab-6333-38a0-98f2-d9266c7947f1",
                                "text": "„Er deutet zur Einfahrt, wo auf einem Trailer ein etwa fünf Meter langes, weißes Kunststoffboot mit Außenbordmotor parkt.“"
                            },
                            {
                                "example_id": "3811afb6-a038-42be-8837-6d57cbfce90f",
                                "sense_id": "560394ab-6333-38a0-98f2-d9266c7947f1",
                                "text": "„Angeboten werden Boote aus Sperrholz oder Kunststoff, wobei sich bei längeren Ausflügen wegen der Portagen die leichteren Kunststoffboote empfehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
