                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat <w>deftig</w> te eten terwijl de anderen nog wachtten.",
                            "target_lang_translations": {
                                "en": "He sat there eating <w>boldly</w> while the others were still waiting.",
                                "fr": "Il mangeait <w>tranquillement</w> pendant que les autres attendaient encore."
                            }
                        },
                        {
                            "text": "Ze liepen <w>deftig</w> door de afzetting heen zonder te vragen.",
                            "target_lang_translations": {
                                "en": "They <w>brazenly</w> walked through the barrier without asking.",
                                "fr": "Ils ont franchi le cordon de sécurité <w>effrontément</w> sans demander la permission."
                            }
                        }
