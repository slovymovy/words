                "senses": [
                    {
                        "sense_id": "a02b4e36-7999-3a78-95de-9abfadd7b23b",
                        "entry_id": "3133429a-9d9c-3394-b6f2-47f399027971",
                        "glosses": [
                            "der Lebensraum des tiefer liegenden Bodens in Binnenseen, der von wurzelnden Pflanzen frei ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d4d4f3-708b-4af7-b109-673375695734",
                                "sense_id": "a02b4e36-7999-3a78-95de-9abfadd7b23b",
                                "text": "Der tiefer liegende Teil des Seebodens, der von wurzelnden Pflanzen frei ist, wird oft als Profundal bezeichnet."
                            },
                            {
                                "example_id": "e287fb83-41a6-4b52-a9cc-7d74c858410b",
                                "sense_id": "a02b4e36-7999-3a78-95de-9abfadd7b23b",
                                "text": "Im Profundal ist aufgrund von Lichtmangel keine Fotosynthese möglich, es gibt dort also keine Pflanzen mehr."
                            },
                            {
                                "example_id": "d39553d4-f472-45fb-a14c-8f26c4aa1cf5",
                                "sense_id": "a02b4e36-7999-3a78-95de-9abfadd7b23b",
                                "text": "Das Litoral geht in das Profundal über, wobei das Kriterium zur Unterscheidung beider Regionen das Licht ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
