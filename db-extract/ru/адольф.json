                                            {
                                                "example_id": "ecd85b2e-9453-4afa-9af3-65667465ca05",
                                                "sense_id": "1a8a458f-7976-3229-8ab5-850ade593f00",
                                                "text": "Der Adolf aus dem Nachbarhaus hat schon wieder auf dem Balkon gegrillt."
                                            },
                                            {
                                                "example_id": "038c752e-9050-40d7-9828-c846a23f5f5b",
                                                "sense_id": "1a8a458f-7976-3229-8ab5-850ade593f00",
                                                "text": "Die neuen Mieter, diese Adolfs, sind nicht sehr hilfsbereit."
                                            },
                                            {
                                                "example_id": "45829899-bf69-4e2d-b7bc-7e8e0560c603",
                                                "sense_id": "1a8a458f-7976-3229-8ab5-850ade593f00",
                                                "text": "Die kleine Adolf ist vielleicht ein Frechdachs!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
