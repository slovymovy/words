{
    "word_family": [
        "оказывать",
        "оказание",
        "оказаться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f1178ce-14eb-3a0d-8b12-b8660bf0c71d",
                    "sense_definition": "Предоставить или сделать что-либо полезное для кого-то (помощь, услугу, поддержку).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач должен немедленно <w>оказать</w> первую помощь пострадавшему.",
                            "target_lang_translations": {
                                "en": "The doctor must immediately <w>render</w> first aid to the victim.",
                                "tr": "Doktor, kazazedeye derhal ilk yardım <w>müdahalesinde bulunmalıdır</w>."
                            }
                        },
                        {
                            "text": "Мы всегда готовы <w>оказать</w> вам необходимую поддержку в этом деле.",
                            "target_lang_translations": {
                                "en": "We are always ready to <w>provide</w> you with the necessary support in this matter.",
                                "tr": "Bu konuda size gerekli desteği <w>sağlamaya</w> her zaman hazırız."
                            }
                        }
                    ],
                    "common_phrases": [
                        "оказать помощь",
                        "оказать услугу",
                        "оказать поддержку",
                        "оказать содействие"
                    ],
                    "target_lang_definitions": {
                        "en": "To provide or perform something useful for someone (help, service, support).",
                        "tr": "Birine faydalı bir şey sunmak veya yapmak (yardım, hizmet, destek vb.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "render",
                                "target_lang_sense_clarification": "formal; used with assistance, aid, or service"
                            },
                            {
                                "target_lang_word": "provide",
                                "target_lang_sense_clarification": "used with support or help"
                            },
                            {
                                "target_lang_word": "do",
                                "target_lang_sense_clarification": "used with a service or favor"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "etmek",
                                "target_lang_sense_clarification": "yardım etmek, hizmet etmek kalıplarında"
                            },
                            {
                                "target_lang_word": "sağlamak",
                                "target_lang_sense_clarification": "destek veya kolaylık sunmak"
                            },
                            {
                                "target_lang_word": "vermek",
                                "target_lang_sense_clarification": "destek veya karşılık vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "828a84ee-0385-3df4-9601-f17e8bcc7711",
                    "sense_definition": "Произвести воздействие на кого-либо или что-либо (влияние, давление).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта книга <w>оказала</w> на меня сильное влияние в юности.",
                            "target_lang_translations": {
                                "en": "This book <w>had</w> a strong influence on me in my youth.",
                                "tr": "Bu kitap gençliğimde üzerimde derin bir etki <w>bıraktı</w>."
                            }
                        },
                        {
                            "text": "Никто не имеет права <w>оказать</w> давление на решение суда.",
                            "target_lang_translations": {
                                "en": "No one has the right to <w>exert</w> pressure on the court's decision.",
                                "tr": "Hiç kimse mahkemenin kararına baskı <w>yapma</w> hakkına sahip değildir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "оказать влияние",
                        "оказать давление",
                        "оказать воздействие"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce an effect on someone or something (influence, pressure).",
                        "tr": "Biri veya bir şey üzerinde etki veya baskı oluşturmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exert",
                                "target_lang_sense_clarification": "used with pressure or influence"
                            },
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "used with an influence or effect"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "etmek",
                                "target_lang_sense_clarification": "etki etmek kalıbında"
                            },
                            {
                                "target_lang_word": "yapmak",
                                "target_lang_sense_clarification": "baskı yapmak kalıbında"
                            },
                            {
                                "target_lang_word": "bırakmak",
                                "target_lang_sense_clarification": "etki bırakmak kalıbında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caf2c465-49eb-31ac-8799-ec87af906ba0",
                    "sense_definition": "Проявить активное противодействие силе или нападению.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Преступник попытался <w>оказать</w> сопротивление при задержании.",
                            "target_lang_translations": {
                                "en": "The criminal tried to <w>put up</w> resistance during the arrest.",
                                "tr": "Suçlu, yakalama esnasında direnç <w>göstermeye</w> çalıştı."
                            }
                        },
                        {
                            "text": "Армия противника не смогла <w>оказать</w> серьёзного сопротивления.",
                            "target_lang_translations": {
                                "en": "The enemy army was unable to <w>offer</w> serious resistance.",
                                "tr": "Düşman ordusu ciddi bir mukavemet <w>gösteremedi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "оказать сопротивление",
                        "оказать неповиновение"
                    ],
                    "target_lang_definitions": {
                        "en": "To show active opposition to force or attack.",
                        "tr": "Bir güce, saldırıya veya tutuklamaya karşı aktif karşı koyma sergilemek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "put up",
                                "target_lang_sense_clarification": "used with resistance"
                            },
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "formal; used with resistance"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göstermek",
                                "target_lang_sense_clarification": "direnç veya mukavemet göstermek kalıbında"
                            },
                            {
                                "target_lang_word": "koymak",
                                "target_lang_sense_clarification": "karşı koymak veya direnç koymak anlamında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a548f99-e1e4-37aa-892c-af549c73bf58",
                    "sense_definition": "Выразить уважение, почтение или сделать честь своим присутствием или действием.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гости старались <w>оказать</w> хозяйке знаки внимания и уважения.",
                            "target_lang_translations": {
                                "en": "The guests tried to <w>show</w> the hostess signs of attention and respect.",
                                "tr": "Misafirler ev sahibesine ilgi ve saygı <w>göstermeye</w> özen gösterdiler."
                            }
                        },
                        {
                            "text": "Вы <w>оказали</w> нам великую честь своим визитом.",
                            "target_lang_translations": {
                                "en": "You <w>did</w> us a great honor with your visit.",
                                "tr": "Ziyaretinizle bizi son derece <w>onurlandırdınız</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "оказать честь",
                        "оказать почтение",
                        "оказать знаки внимания",
                        "оказать приём"
                    ],
                    "target_lang_definitions": {
                        "en": "To express respect, reverence, or do honor by one's presence or action.",
                        "tr": "Varlığı veya davranışıyla saygı göstermek, hürmet etmek veya onurlandırmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "do",
                                "target_lang_sense_clarification": "used with honor"
                            },
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "used with signs of attention or respect"
                            },
                            {
                                "target_lang_word": "pay",
                                "target_lang_sense_clarification": "used with respect or homage"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göstermek",
                                "target_lang_sense_clarification": "saygı veya ilgi göstermek kalıbında"
                            },
                            {
                                "target_lang_word": "bahşetmek",
                                "target_lang_sense_clarification": "onurlandırmak, lütfetmek anlamında"
                            },
                            {
                                "target_lang_word": "etmek",
                                "target_lang_sense_clarification": "hürmet etmek, onur etmek kalıbında"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}