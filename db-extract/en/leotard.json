                        "entry_id": "422948ee-565d-3b64-acc4-8cd5d503f44d",
                        "glosses": [
                            "A one-piece skintight garment with or without sleeves and without legs (often worn by gymnasts, acrobats, wrestlers, female swimmers, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad53bcb2-7b61-4f2f-afa0-4d413240fba1",
                                "sense_id": "0e2a81d2-c98c-3a7f-bb7b-a420c099442c",
                                "text": "Tomorrow is the day. Marie makes her first trip out of this notebook and into the world. I'm off to buy a leotard."
                            }
                        ]
