                "senses": [
                    {
                        "sense_id": "1157b7f8-93f7-3338-8c68-4a4d0688036a",
                        "entry_id": "412f52e2-caa4-3aae-8e1e-6f5671f76d66",
                        "glosses": [
                            "Person oder Institution, die mit anderen Personen/Institutionen im Rahmen der NATO zusammenarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f2c0d9-12dc-4534-b48b-ece4cdf34a29",
                                "sense_id": "1157b7f8-93f7-3338-8c68-4a4d0688036a",
                                "text": "„Obgleich er völlig offen über seine Aufgaben in Paris zu sprechen schien, stellte Bond doch sehr bald fest, dass Leiter weder seine amerikanischen Kollegen in Europa noch die in Washington erwähnte, und so nahm er an, dass Leiter die Interessen seiner eigenen Organisation für weit wichtiger hielt als die Interessen der NATO-Verbündeten.“"
                            },
                            {
                                "example_id": "3d79e504-9d46-4482-b28c-66ff118f42ce",
                                "sense_id": "1157b7f8-93f7-3338-8c68-4a4d0688036a",
                                "text": "„Estland will atomwaffenfähige F-35-Kampfjets von Nato-Verbündeten aufnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
