                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mannen wegen gemiddeld 100 gram, <w>terwijl</w> vrouwtjes vaak zwaarder zijn.",
                            "target_lang_translations": {
                                "en": "Males weigh 100 grams on average, <w>whereas</w> females are often heavier.",
                                "ru": "Самцы весят в среднем 100 грамм, <w>тогда как</w> самки часто тяжелее.",
                                "pl": "Samce ważą średnio 100 gramów, <w>podczas gdy</w> samice są często cięższe.",
                                "de": "Männchen wiegen im Durchschnitt 100 Gramm, <w>während</w> Weibchen oft schwerer sind.",
                                "fr": "Les mâles pèsent en moyenne 100 grammes, <w>tandis que</w> les femelles sont souvent plus lourdes.",
                                "it": "I maschi pesano in media 100 grammi, <w>mentre</w> le femmine sono spesso più pesanti.",
                                "cs": "Samci váží v průměru 100 gramů, <w>zatímco</w> samice jsou často těžší.",
                                "tr": "Erkekler ortalama 100 gram gelir, dişiler <w>ise</w> genellikle daha ağırdır.",
                                "es": "Los machos pesan una media de 100 gramos, <w>mientras que</w> las hembras suelen ser más pesadas."
                            }
                        },
                        {
                            "text": "Hij houdt van koffie, <w>terwijl</w> zij liever thee drinkt.",
                            "target_lang_translations": {
                                "en": "He likes coffee, <w>while</w> she prefers tea.",
                                "ru": "Он любит кофе, <w>в то время как</w> она предпочитает чай.",
                                "pl": "On lubi kawę, <w>podczas gdy</w> ona woli pić herbatę.",
                                "de": "Er mag Kaffee, <w>während</w> sie lieber Tee trinkt.",
                                "fr": "Il aime le café, <w>alors que</w> de son côté elle préfère boire du thé.",
                                "it": "Lui ama il caffè, <w>mentre</w> lei preferisce il tè.",
                                "cs": "On má rád kávu, <w>zatímco</w> ona pije raději čaj.",
                                "tr": "O kahve seviyor, <w>hâlbuki</w> o (kadın) çay içmeyi tercih ediyor.",
                                "es": "A él le gusta el café, <w>mientras que</w> ella prefiere tomar té."
                            }
                        }
