                    },
                    {
                        "sense_id": "e51ce288-276e-3d61-8c8d-7884b3012c4b",
                        "entry_id": "a3dc6166-1f90-3355-ac5f-7a8f7f91e81c",
                        "glosses": [
                            "\\\"400\\\", het getal tussen driehonderdnegenennegentig en vierhonderdeen, vier maal honderd",
                            "om een hoeveelheid aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7add6eeb-8726-4c52-9771-b6d6db995a3f",
                                "sense_id": "e51ce288-276e-3d61-8c8d-7884b3012c4b",
                                "text": "De totale kosten bedragen vierhonderd euro en zevenendertig cent."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bf494c4-7bd4-3fb9-84e2-90143e668702",
                        "entry_id": "a3dc6166-1f90-3355-ac5f-7a8f7f91e81c",
                        "glosses": [
                            "\\\"400\\\", het getal tussen driehonderdnegenennegentig en vierhonderdeen, vier maal honderd",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "130e808a-c419-43c0-8b47-b9660b932e47",
                                "sense_id": "2bf494c4-7bd4-3fb9-84e2-90143e668702",
                                "text": "We logeerden vlakbij het strand in kamer vierhonderd van het grootste hotel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30f624b5-1b75-427e-80e6-4320a2ec8f73",
