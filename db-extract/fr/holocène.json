            {
                "entry_id": "bf6b5468-d026-3650-b8af-c57c8ee742f0",
                "word": "Holocène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2eb8ec1-b868-3fcb-a2de-1c4ce198c422",
                        "entry_id": "bf6b5468-d026-3650-b8af-c57c8ee742f0",
                        "glosses": [
                            "Époque géologique s’étendant sur les 10 000 dernières années."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8cda26c-7d6e-45cb-b7ec-6ed8840c3edc",
                                "sense_id": "e2eb8ec1-b868-3fcb-a2de-1c4ce198c422",
                                "text": "La richesse en grands mammifères herbivores, bien plus importante au début de l’Holocène, laisse à penser pour certains qu'ils auraient pu entretenir à eux seuls des forêts semi-ouvertes (de type forêt-parc) rien que par leurs activités d’abroutissement et de sélection végétale."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8985d8d-635e-37ee-a2e3-135b15c27c8d",
                        "entry_id": "bf6b5468-d026-3650-b8af-c57c8ee742f0",
                        "glosses": [
                            "Holocène ancien ou Holocène inférieur : Le Mésolithique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a5878180-9991-3bf3-8d67-6e5a4abb40c1",
                        "entry_id": "bf6b5468-d026-3650-b8af-c57c8ee742f0",
                        "glosses": [
                            "Holocène récent ou Holocène supérieur : L’Âge des métaux."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4545f6ff-070a-4234-955f-258f7a78b25e",
                        "source_entry_id": "bf6b5468-d026-3650-b8af-c57c8ee742f0",
                        "target_lang_word": "Holozän",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holozän",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3774c573-15e9-3c4a-a635-e4e103d3626b",
                                        "entry_id": "17e05044-cd82-3f8b-a904-6a4d4a4faf9e",
                                        "glosses": [
                                            "jüngste Epoche der Erdgeschichte; wörtlich „das völlig Neue“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca013770-cc45-42a5-bcfa-76a3d84e98fa",
                                                "sense_id": "3774c573-15e9-3c4a-a635-e4e103d3626b",
                                                "text": "Das Holozän folgte dem Pleistozän."
                                            },
                                            {
                                                "example_id": "629958ac-000d-4c68-aa11-605a210b9413",
                                                "sense_id": "3774c573-15e9-3c4a-a635-e4e103d3626b",
                                                "text": "„Pleistozän und Holozän bilden zusammen die vor 2,6 Millionen Jahren beginnende Periode des Quartärs.“"
                                            },
                                            {
                                                "example_id": "5558ed70-ff70-4314-8e4f-76dc53bb0a76",
                                                "sense_id": "3774c573-15e9-3c4a-a635-e4e103d3626b",
                                                "text": "„Der homo sapiens ist eine geologische Kraft und hat das 12.000 Jahre andauernde Holozän beendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
