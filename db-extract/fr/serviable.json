                    {
                        "sense_id": "a3eef975-d046-31bf-ab01-e02f8b950a6c",
                        "entry_id": "88073d4b-fb70-3713-8480-79da2f5795da",
                        "glosses": [
                            "Qui aime à rendre service, qui rend service, aidant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0209516-9c7d-417d-90ee-a309020cfb47",
                                "sense_id": "a3eef975-d046-31bf-ab01-e02f8b950a6c",
                                "text": "Sarah s’était mis à dos tout le monde. Aussi orgueilleuse que peu serviable, elle avait, dès les. premiers jours, agacé et choqué la troupe entière."
                            },
                            {
                                "example_id": "f8bc778a-de42-4b6f-bd1a-5b904b97895a",
                                "sense_id": "a3eef975-d046-31bf-ab01-e02f8b950a6c",
                                "text": "Le village eut vite fait de l'adopter, car il était très serviable et prenait sa tâche à cœur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9036dfcb-89c9-4e14-9889-07c485015d8a",
