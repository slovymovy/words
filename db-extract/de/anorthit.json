                    {
                        "translation_id": "a3d2efc1-f469-4091-a6f2-a9c22820b44a",
                        "source_entry_id": "36988f0b-034e-3a3f-b1ed-ec4e52a4d6bb",
                        "source_sense_id": "e115b9e6-3f6d-3b70-b805-e360d45938c0",
