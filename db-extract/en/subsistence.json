                    {
                        "sense_id": "32a29ee9-f2a0-3d82-aa7f-f351dbe31adf",
                        "entry_id": "7bd73276-e3a4-3f5d-9c71-fca5beb4d722",
                        "glosses": [
                            "Real being; existence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b245534-377c-41cc-b82e-8a6d2e97533c",
                                "sense_id": "32a29ee9-f2a0-3d82-aa7f-f351dbe31adf",
                                "text": "the human nature loseth its proper subsistence , and is assumed into the subsistence of the divine nature"
                            }
                        ]
                    },
                    {
                        "sense_id": "becda78b-7cf6-3d6d-94b5-0128df4a46cf",
                        "entry_id": "7bd73276-e3a4-3f5d-9c71-fca5beb4d722",
                        "glosses": [
                            "The act of maintaining oneself at a minimum level."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6288c718-4972-3506-9a29-e35b62e74559",
                        "entry_id": "7bd73276-e3a4-3f5d-9c71-fca5beb4d722",
                        "glosses": [
                            "Inherency."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "96499d38-1733-48dd-a92e-35b16bf13dad",
                                "sense_id": "6288c718-4972-3506-9a29-e35b62e74559",
                                "text": "the subsistence of qualities in bodies"
                            }
                        ]
                    },
                    {
                        "sense_id": "88e337ec-8c02-36ec-afe1-50e14dc90715",
                        "entry_id": "7bd73276-e3a4-3f5d-9c71-fca5beb4d722",
                        "glosses": [
                            "Something (food, water, money, etc.) that is required to stay alive."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ca181907-6ae4-4c89-9959-6352ceb7d5d4",
                                "sense_id": "88e337ec-8c02-36ec-afe1-50e14dc90715",
                                "text": "In the general course of human nature, a power over a man's subsistence amounts to a power over his will."
                            },
                            {
                                "example_id": "377b8ccd-daaa-40fa-80a2-213c9b608405",
                                "sense_id": "88e337ec-8c02-36ec-afe1-50e14dc90715",
                                "text": "His viceroy could only propose to himself a comfortable subsistence out of the plunder of his province."
                            }
                        ]
                    },
                    {
                        "sense_id": "acc14974-9975-3325-943e-954a89cd3dc1",
                        "entry_id": "7bd73276-e3a4-3f5d-9c71-fca5beb4d722",
                        "glosses": [
                            "Embodiment or personification or hypostasis of an underlying principle or quality."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
