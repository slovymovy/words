                    {
                        "translation_id": "3681c8ac-d803-4064-ab8f-9c30d60b057c",
                        "source_entry_id": "5824f353-d968-3327-9f19-3c346c6dd95e",
                        "source_sense_id": "3b0e3054-1722-329e-a695-9cc4c2d0a08a",
                        "target_lang_word": "симония",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "симония",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "21a22bc2-7711-3d17-94ec-8c66d5f293fa",
                                        "entry_id": "f6893c5f-0dbb-3bd9-ab94-c2468dec6c84",
                                        "glosses": [
                                            "истор., церк. покупка или продажа церковной должности или духовного сана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea9a5f8-bb5d-4c4f-bec1-14e7ba9b52db",
                                                "sense_id": "21a22bc2-7711-3d17-94ec-8c66d5f293fa",
                                                "text": "Тож делают и духовныя власти, которыя на сан Архиерейский или Иерейский, и иныя степени церковныя посвящают на мзде: и сие беззаконие нарицается святокупство и симония."
                                            },
                                            {
                                                "example_id": "75703e29-5acd-4320-a1c6-cc0fbf71009d",
                                                "sense_id": "21a22bc2-7711-3d17-94ec-8c66d5f293fa",
                                                "text": "Выказав себя человеком твердым и властным, к тому же искусным законником, новый папа заявил, что запретит симонию, приносившую кардиналам сказочные барыши."
                                            },
                                            {
                                                "example_id": "80247103-40fe-467b-bd9a-14b5c3315290",
                                                "sense_id": "21a22bc2-7711-3d17-94ec-8c66d5f293fa",
                                                "text": "В 1310—1311 годах на Переяславском соборе снова говорится о пороке симонии, который поразил всю русскую церковь снизу доверху."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
