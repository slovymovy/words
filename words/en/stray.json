{
    "word_family": [
        "astray"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "396c559d-d759-3487-8897-72522f4eaa16",
                    "sense_definition": "To move away from the correct path, group, or intended area.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "wander_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists <w>strayed</w> from the marked trail and got lost.",
                            "target_lang_translations": {
                                "ru": "Туристы <w>сошли</w> с размеченной тропы и заблудились.",
                                "de": "Die Touristen <w>kamen</w> vom markierten Weg ab und verliefen sich."
                            }
                        },
                        {
                            "text": "Please do not <w>stray</w> too far from the campsite.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>отходите</w> слишком далеко от лагеря.",
                                "de": "Bitte <w>entfernen</w> Sie sich nicht zu weit vom Campingplatz."
                            }
                        }
                    ],
                    "synonyms": [
                        "wander",
                        "drift",
                        "roam"
                    ],
                    "common_phrases": [
                        "stray from home",
                        "stray far"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняться от правильного пути, группы или намеченной зоны.",
                        "de": "Sich vom richtigen Weg, einer Gruppe oder einem vorgesehenen Bereich entfernen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбиваться с пути",
                                "target_lang_sense_clarification": "терять правильное направление"
                            },
                            {
                                "target_lang_word": "отходить",
                                "target_lang_sense_clarification": "удаляться на некоторое расстояние"
                            },
                            {
                                "target_lang_word": "блуждать",
                                "target_lang_sense_clarification": "ходить без цели или потеряв дорогу"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich verlaufen",
                                "target_lang_sense_clarification": "die Orientierung verlieren oder vom Weg abkommen"
                            },
                            {
                                "target_lang_word": "streunen",
                                "target_lang_sense_clarification": "ziellos umherziehen"
                            },
                            {
                                "target_lang_word": "abkommen",
                                "target_lang_sense_clarification": "vom geplanten Pfad oder Kurs abweichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50f9cfeb-5cce-3662-a185-926164bbf3d1",
                    "sense_definition": "To deviate from a subject, duty, or moral standard.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "wander_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conversation began to <w>stray</w> from the main topic.",
                            "target_lang_translations": {
                                "ru": "Разговор начал <w>отклоняться</w> от главной темы.",
                                "de": "Das Gespräch begann, vom Hauptthema <w>abzuweichen</w>."
                            }
                        },
                        {
                            "text": "He promised never to <w>stray</w> from his principles again.",
                            "target_lang_translations": {
                                "ru": "Он пообещал больше никогда не <w>отступать</w> от своих принципов.",
                                "de": "Er versprach, nie wieder von seinen Prinzipien <w>abzuweichen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "deviate",
                        "digress"
                    ],
                    "common_phrases": [
                        "stray from the point",
                        "stray from the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняться от темы, долга или моральных норм.",
                        "de": "Von einem Thema, einer Pflicht oder moralischen Standards abweichen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклоняться",
                                "target_lang_sense_clarification": "переходить к другой теме или нарушать нормы"
                            },
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "отказываться от принципов или правил"
                            },
                            {
                                "target_lang_word": "отвлекаться",
                                "target_lang_sense_clarification": "переключать внимание на посторонние вещи"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abweichen",
                                "target_lang_sense_clarification": "sich von einem Thema oder einer Norm entfernen"
                            },
                            {
                                "target_lang_word": "abschweifen",
                                "target_lang_sense_clarification": "im Gespräch vom Hauptthema abkommen"
                            },
                            {
                                "target_lang_word": "abkommen",
                                "target_lang_sense_clarification": "von Prinzipien oder dem rechten Weg abweichen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b9dace16-9011-340f-89e9-25660c45a108",
                    "sense_definition": "Describing an animal that is lost or has no home.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "animal_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She feeds the <w>stray</w> cats in her neighborhood every evening.",
                            "target_lang_translations": {
                                "ru": "Она кормит <w>бездомных</w> кошек в своём районе каждый вечер.",
                                "de": "Sie füttert jeden Abend die <w>streunenden</w> Katzen in ihrer Nachbarschaft."
                            }
                        },
                        {
                            "text": "A <w>stray</w> dog followed us all the way home.",
                            "target_lang_translations": {
                                "ru": "<w>Бродячая</w> собака увязалась за нами до самого дома.",
                                "de": "Ein <w>herrenloser</w> Hund folgte uns bis nach Hause."
                            }
                        }
                    ],
                    "synonyms": [
                        "homeless",
                        "wandering",
                        "lost"
                    ],
                    "antonyms": [
                        "collared"
                    ],
                    "common_phrases": [
                        "stray dog",
                        "stray cat"
                    ],
                    "target_lang_definitions": {
                        "ru": "О животном: потерявшееся или не имеющее дома.",
                        "de": "Bei einem Tier: verloren gegangen oder ohne Zuhause."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездомный",
                                "target_lang_sense_clarification": "не имеющий хозяина или жилья"
                            },
                            {
                                "target_lang_word": "бродячий",
                                "target_lang_sense_clarification": "постоянно перемещающийся, живущий на улице"
                            },
                            {
                                "target_lang_word": "заблудившийся",
                                "target_lang_sense_clarification": "потерявший дорогу домой"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "herrenlos",
                                "target_lang_sense_clarification": "ohne Besitzer oder Zuhause"
                            },
                            {
                                "target_lang_word": "streunend",
                                "target_lang_sense_clarification": "herumziehend, ohne festen Wohnsitz"
                            },
                            {
                                "target_lang_word": "verirrt",
                                "target_lang_sense_clarification": "den Weg nach Hause verloren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bf90386-598b-36af-b9a5-66c2c9779e12",
                    "sense_definition": "Separated from the main group or found in a place where it does not belong.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "misplaced_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>stray</w> bullet hit the wall during the conflict.",
                            "target_lang_translations": {
                                "ru": "<w>Шальная</w> пуля попала в стену во время конфликта.",
                                "de": "Eine <w>verirrte</w> Kugel traf während des Konflikts die Wand."
                            }
                        },
                        {
                            "text": "She brushed a <w>stray</w> hair from her face.",
                            "target_lang_translations": {
                                "ru": "Она убрала <w>выбившуюся</w> прядь волос с лица.",
                                "de": "Sie strich sich eine <w>herausgefallene</w> Haarsträhne aus dem Gesicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "isolated",
                        "random",
                        "accidental"
                    ],
                    "common_phrases": [
                        "stray bullet",
                        "stray hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделившийся от основной группы или находящийся в неположенном месте.",
                        "de": "Von der Hauptgruppe getrennt oder an einem Ort, an den es nicht gehört."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шальной",
                                "target_lang_sense_clarification": "о пуле или снаряде: летящий наугад"
                            },
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "непреднамеренный или редкий"
                            },
                            {
                                "target_lang_word": "выбившийся",
                                "target_lang_sense_clarification": "о пряди волос: лежащий неаккуратно"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verirrt",
                                "target_lang_sense_clarification": "an einem Ort, wo man nicht sein sollte"
                            },
                            {
                                "target_lang_word": "verirrt",
                                "target_lang_sense_clarification": "bei Projektilen: zufällig oder unkontrolliert"
                            },
                            {
                                "target_lang_word": "einzeln",
                                "target_lang_sense_clarification": "von der Gruppe getrennt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bbfe1992-f4eb-3369-80cc-2d8c3b20fe2f",
                    "sense_definition": "A domestic animal that is lost or has no home.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "animal_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shelter is looking for homes for several <w>strays</w>.",
                            "target_lang_translations": {
                                "ru": "Приют ищет дом для нескольких <w>бездомных животных</w>.",
                                "de": "Das Tierheim sucht für mehrere <w>Streuner</w> ein Zuhause."
                            }
                        },
                        {
                            "text": "He took the <w>stray</w> to the vet to check for a microchip.",
                            "target_lang_translations": {
                                "ru": "Он отвёз <w>найдёныша</w> к ветеринару, чтобы проверить наличие микрочипа.",
                                "de": "Er brachte den <w>Streuner</w> zum Tierarzt, um ihn auf einen Mikrochip prüfen zu lassen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feed a stray",
                        "adopt a stray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Домашнее животное, которое потерялось или не имеет дома.",
                        "de": "Ein Haustier, das verloren gegangen ist oder kein Zuhause hat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездомное животное",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "бродяжка",
                                "target_lang_sense_clarification": "разговорное, ласковое или пренебрежительное"
                            },
                            {
                                "target_lang_word": "найдёныш",
                                "target_lang_sense_clarification": "найденное потерявшееся животное"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Streuner",
                                "target_lang_sense_clarification": "herrenloses Tier"
                            },
                            {
                                "target_lang_word": "Fundtier",
                                "target_lang_sense_clarification": "aufgefundenes, herrenloses Tier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bde504c-284d-33f0-b20b-2da4819422ac",
                    "sense_definition": "A casual or offhand insult, often intended for someone else but affecting the listener.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insult_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was just minding my business and caught a <w>stray</w>.",
                            "target_lang_translations": {
                                "ru": "Я просто занимался своими делами и попал под <w>раздачу</w>.",
                                "de": "Ich wollte nur meine Ruhe haben und bin zufällig in den <w>Seitenhieb</w> geraten."
                            }
                        },
                        {
                            "text": "He threw a <w>stray</w> at his rival during the interview.",
                            "target_lang_translations": {
                                "ru": "Он отпустил <w>колкость</w> в адрес соперника во время интервью.",
                                "de": "Er teilte während des Interviews einen <w>Seitenhieb</w> gegen seinen Rivalen aus."
                            }
                        }
                    ],
                    "common_phrases": [
                        "catch a stray"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in the phrase 'catch a stray'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайное оскорбление или критика, задевающие того, кому они не предназначались.",
                        "de": "Eine beiläufige Beleidigung oder Kritik, die oft nicht direkt an den Betroffenen gerichtet war."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный выпад",
                                "target_lang_sense_clarification": "непреднамеренная обида"
                            },
                            {
                                "target_lang_word": "раздача",
                                "target_lang_sense_clarification": "в идиоме 'попасть под раздачу'"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Seitenhieb",
                                "target_lang_sense_clarification": "indirekte, beiläufige Kritik"
                            },
                            {
                                "target_lang_word": "zufällige Beleidigung",
                                "target_lang_sense_clarification": "unbeabsichtigt getroffene Person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}