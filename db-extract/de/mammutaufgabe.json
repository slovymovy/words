                "senses": [
                    {
                        "sense_id": "e65e21c6-2ee0-3835-98eb-1fe3d301d64a",
                        "entry_id": "58620e9f-aaff-36f0-9e88-4b71e7c75587",
                        "glosses": [
                            "besonders schwere Herausforderung, außerordentlich umfangreiche Aufgabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2771adfa-0ae1-45a1-b6d7-c8a4ba484fcc",
                                "sense_id": "e65e21c6-2ee0-3835-98eb-1fe3d301d64a",
                                "text": "„Die neuen Machthaber in Libyen stehen vor einer Mammutaufgabe.“"
                            },
                            {
                                "example_id": "474caa58-6290-4f90-b585-647c6d0abfc1",
                                "sense_id": "e65e21c6-2ee0-3835-98eb-1fe3d301d64a",
                                "text": "„Für die Gladbacher wurde es nun sehr schwer, einen Zwei-Tore-Rückstand auf Schalke aufzuholen glich einer Mammutaufgabe.“"
                            },
                            {
                                "example_id": "b200d551-0e7e-423b-9182-884c7d531da0",
                                "sense_id": "e65e21c6-2ee0-3835-98eb-1fe3d301d64a",
                                "text": "„Vom 15. November 1884 bis zum 26. Februar 1885 trafen sich die Großen der Welt im Reichskanzlerpalais an der Wilhelmstraße zu zehn Sitzungen - die Mammutkonferenz hatte sich eine Mammutaufgabe gestellt: die Zukunft Afrikas, Regeln für die Neuordnung eines Kontinents.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
