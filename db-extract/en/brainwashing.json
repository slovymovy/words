                    },
                    {
                        "translation_id": "5d4362ba-d6a5-4b6f-8261-1cbb29f004aa",
                        "source_entry_id": "4d07c624-cda1-3b6d-91f9-b0756451592c",
                        "source_sense_id": "11402b5c-f548-3f72-a769-bbff3d59e2e3",
                        "source_sense_description": "form of indoctrination",
                        "target_lang_word": "lavage de cerveau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lavage de cerveau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8386ed69-dd37-35ad-af61-cd50c41c6958",
                                        "entry_id": "627ea31a-e303-3697-8fbe-7c3f535e5c2a",
                                        "glosses": [
                                            "Mise en œuvre de procédés qui auraient la faculté de reconditionner le libre arbitre d’un individu par la modification cognitive, peut-être aussi physiologique et neurologique, du cortex cérébral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eca6e943-75d3-4f32-96a3-831656511338",
                                                "sense_id": "8386ed69-dd37-35ad-af61-cd50c41c6958",
                                                "text": "Prétendez-vous que nous abusons ces jeunes gens ? Que nous les soumettons à un lavage de cerveau ? Est-ce que vous nous placez sur le même plan que les sectes qui se multiplient chez vous aux États-Unis ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6bbbd70-2086-36bb-918d-6376e2a4934d",
                                        "entry_id": "627ea31a-e303-3697-8fbe-7c3f535e5c2a",
                                        "glosses": [
                                            "Intense propagande, désinformation manipulatrice."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f07034c7-43df-4b6f-95fb-defa0306e14b",
                                                "sense_id": "e6bbbd70-2086-36bb-918d-6376e2a4934d",
                                                "text": "L’enjeu est éducatif. En Israël, 24 % des élèves de CP n’étudient ni les mathématiques, ni l’anglais. Ils subissent un lavage de cerveau. […] Je ne veux plus vivre dans un pays où une ministre de l’Éducation explique à la télévision que les dinosaures n’ont jamais existé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc1abb40-7504-48c4-a7bd-ef69b82139ad",
                        "source_entry_id": "4d07c624-cda1-3b6d-91f9-b0756451592c",
                        "source_sense_id": "11402b5c-f548-3f72-a769-bbff3d59e2e3",
                        "source_sense_description": "form of indoctrination",
                        "target_lang_word": "Gehirnwäsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehirnwäsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                        "entry_id": "a118bd4a-595e-3eb3-b8b7-633e9694bd3f",
                                        "glosses": [
                                            "durch starken physischen und psychischen Druck erzwungene Änderung der Urteilskraft und eigener (politischer, weltanschaulicher) Einstellungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00510e18-cf65-41dc-8019-8ff45d81e1c5",
                                                "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                                "text": "Nach dem Krieg wurden alle Kriegsgefangenen einer Gehirnwäsche unterzogen."
                                            },
                                            {
                                                "example_id": "31c710e2-1ea0-4f43-8b39-1a53228e20c9",
                                                "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                                "text": "„Überhaupt schien der Beamte ein umgänglicher Vertreter seines Standes zu sein, keiner von der glatten und kalten Sorte, keiner von den ehrgeizigen jungen Burschen, die sich für Lügendetektoren auf Beinen hielten und aus jeder Befragung eine halbe Gehirnwäsche machten.“"
                                            },
                                            {
                                                "example_id": "c2846b12-014b-4c22-b3d6-21794201e856",
                                                "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                                "text": "„Stratton — so argwöhnen die Amerikaner jetzt — wurde ein Opfer jener psychischen Tortur, die Rotchinesen während des Korea-Krieges erstmals an US-Kriegsgefangenen erprobten: der Gehirnwäsche.“"
                                            },
                                            {
                                                "example_id": "f79c452c-4819-47ec-b53f-7140523a5e2a",
                                                "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                                "text": "„Unter dem Deckmantel einer philosophischen Vereinigung habe die Sekte ihre Mitglieder ausgebeutet und sie einer systematischen Gehirnwäsche unterzogen, um ihren Willen und ihre Entscheidungsfreiheit zu brechen.“"
                                            },
                                            {
                                                "example_id": "177adff0-d6ae-4bb5-a747-b54ab20a5538",
                                                "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                                "text": "„1962 schrieb er seinen berühmten Essay «Nach dem Kalten Krieg»: «Wir können uns nicht mehr zufriedengeben mit dem Orwellschen Bild einer vollständig und unwiderruflich entmenschlichten totalitären Welt von Robotern, von Gehirnwäschen und ‹spontanen Geständnissen›, von an Stelle des Denkens getretenen Pawlowschen Reflexen … »“"
                                            },
                                            {
                                                "example_id": "47cc567f-95b8-4c33-9946-98edfe4c052c",
                                                "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                                "text": "„Stattdessen schließen sich immer mehr Perspektivlose nach Gehirnwäsche in den Hinterhofmoscheen von Kairouan oder Sousse militanten Gruppen in den Bergen in Tunesiens Süden oder Libyen an.“"
                                            },
                                            {
                                                "example_id": "63fc42a3-fc86-4360-8a27-188269e8d506",
                                                "sense_id": "b513f51c-b40c-3524-9472-af34551cd4ae",
                                                "text": "„Die Welt weiß längst über die politischen Umerziehungslager, in denen Uiguren willkürlich gesteckt, körperlich gefoltert und einer ideologischen Gehirnwäsche unterzogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
