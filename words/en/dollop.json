{
    "word_family": [
        "dolloper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc5fbad3-f6b3-35a2-b046-56cf30b62eab",
                    "sense_definition": "A large, shapeless scoop or portion of something, especially soft food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each pancake comes with a <w>dollop</w> of soft butter in a tiny cup.",
                            "target_lang_translations": {
                                "cs": "Ke každému lívanci dostanete <w>kopeček</w> měkkého másla v malém kalíšku."
                            }
                        },
                        {
                            "text": "She added a large <w>dollop</w> of whipped cream to her hot chocolate.",
                            "target_lang_translations": {
                                "cs": "Do horké čokolády si přidala velký <w>kopeček</w> šlehačky."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoop",
                        "lump",
                        "glob",
                        "portion"
                    ],
                    "common_phrases": [
                        "generous dollop"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velká, neforemná porce nebo kopeček něčeho, zejména měkkého jídla."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kopeček",
                                "target_lang_sense_clarification": "často používané pro zmrzlinu nebo šlehačku"
                            },
                            {
                                "target_lang_word": "hromádka",
                                "target_lang_sense_clarification": "označuje neforemný kus měkké hmoty"
                            },
                            {
                                "target_lang_word": "porce",
                                "target_lang_sense_clarification": "obecnější označení množství jídla"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9874eb9d-90f8-368e-873d-b6ee18a06aed",
                    "sense_definition": "To add or apply something in large, messy, or informal portions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>dolloped</w> a generous quantity of mustard on her hot dog.",
                            "target_lang_translations": {
                                "cs": "Na párek v rohlíku si <w>nabrala</w> pořádnou porci hořčice."
                            }
                        },
                        {
                            "text": "He <w>dolloped</w> porridge into a bowl and added some milk.",
                            "target_lang_translations": {
                                "cs": "Do misky <w>nabral</w> kaši a přidal trochu mléka."
                            }
                        }
                    ],
                    "synonyms": [
                        "heap",
                        "plop",
                        "scoop"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přidat nebo nanést něco ve velkých, neformálních nebo neupravených porcích."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nabrat",
                                "target_lang_sense_clarification": "ve smyslu nabírání jídla lžící"
                            },
                            {
                                "target_lang_word": "dát",
                                "target_lang_sense_clarification": "neformální způsob vyjádření přidání jídla"
                            },
                            {
                                "target_lang_word": "navršit",
                                "target_lang_sense_clarification": "pokud je porce velká a neforemná"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0d8021a-9594-3bbe-b83c-39d88ad8df26",
                    "sense_definition": "To distribute or drip something in a thick, viscous manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick sauce <w>dolloped</w> slowly onto the plate from the spoon.",
                            "target_lang_translations": {
                                "cs": "Hustá omáčka pomalu <w>kapala</w> ze lžíce na talíř."
                            }
                        },
                        {
                            "text": "She <w>dollops</w> the mixture onto the baking tray with a large spoon.",
                            "target_lang_translations": {
                                "cs": "Velkou lžící <w>dává</w> směs na plech."
                            }
                        }
                    ],
                    "synonyms": [
                        "drip",
                        "ooze"
                    ],
                    "target_lang_definitions": {
                        "cs": "Distribuovat nebo nechat kapat něco hustým, viskózním způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kapat",
                                "target_lang_sense_clarification": "pomalé stékání husté tekutiny"
                            },
                            {
                                "target_lang_word": "stékat",
                                "target_lang_sense_clarification": "pohyb husté hmoty po povrchu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}