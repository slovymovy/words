    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1367526e-0c18-34ef-ad42-e4e182e29a9b",
                    "sense_definition": "The fruit of the Solanum melongena plant, typically purple and shaped like an egg, which is cooked and eaten as a vegetable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aubergine_plant_fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to roast a sliced <w>aubergine</w> with olive oil and garlic for dinner.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь запечь нарезанный <w>баклажан</w> с оливковым маслом и чесноком на ужин."
                            }
                        },
                        {
                            "text": "The recipe requires one large <w>aubergine</w> to make a traditional moussaka.",
                            "target_lang_translations": {
                                "ru": "Для приготовления традиционной мусаки по рецепту требуется один крупный <w>баклажан</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "the list at eggplant"
                    ],
                    "common_phrases": [
                        "roasted aubergine",
                        "sliced aubergine",
                        "stuffed aubergine"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плод растения Solanum melongena, обычно фиолетового цвета и яйцевидной формы, который готовят и употребляют в пищу как овощ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баклажан",
                                "target_lang_sense_clarification": "овощ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fece249-7be4-3df2-be5f-f316d16d5efd",
                    "sense_definition": "An Asian plant, Solanum melongena, cultivated for its edible purple, green, or white ovoid fruit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aubergine_plant_fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aubergine</w> grows best in warm climates with plenty of sunlight.",
                            "target_lang_translations": {
                                "ru": "<w>Баклажан</w> лучше всего растет в теплом климате с большим количеством солнечного света."
                            }
                        },
                        {
                            "text": "He decided to grow an <w>aubergine</w> in his greenhouse this summer.",
                            "target_lang_translations": {
                                "ru": "Этим летом он решил вырастить <w>баклажан</w> в своей теплице."
                            }
                        }
                    ],
                    "synonyms": [
                        "the list at eggplant"
                    ],
                    "common_phrases": [
                        "grow aubergine"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Азиатское растение Solanum melongena, культивируемое ради его съедобных фиолетовых, зеленых или белых яйцевидных плодов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баклажан",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb76cfd1-8161-3533-947c-6b2a4d6ec1f3",
                    "sense_definition": "A dark, brownish-purple colour resembling the skin of the aubergine fruit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aubergine_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a beautiful <w>aubergine</w> dress for the evening gala.",
                            "target_lang_translations": {
                                "ru": "Она выбрала красивое платье <w>баклажанового</w> цвета для вечернего торжества."
                            }
                        },
                        {
                            "text": "The walls of the study were painted a deep <w>aubergine</w> to create a cozy atmosphere.",
                            "target_lang_translations": {
                                "ru": "Стены кабинета были выкрашены в глубокий <w>баклажановый</w> цвет, чтобы создать уютную атмосферу."
                            }
                        }
                    ],
                    "synonyms": [
                        "the list at eggplant"
                    ],
                    "common_phrases": [
                        "deep aubergine",
                        "dark aubergine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темный, коричневато-фиолетовый цвет, напоминающий кожицу плода баклажана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баклажановый",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "тёмно-фиолетовый",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
