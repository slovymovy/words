                "senses": [
                    {
                        "sense_id": "68712274-a21d-3cb0-a263-e34384f8d313",
                        "entry_id": "fa3d9dd9-4dd3-3a55-952f-6783d61ec269",
                        "glosses": [
                            "große Halle, in der sich Arbeitslose und Menschen äußerst geringen Einkommens in den kalten Monaten wärmen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a9529fe-8123-4303-8d8a-c93fba652d39",
                                "sense_id": "68712274-a21d-3cb0-a263-e34384f8d313",
                                "text": "„In der Ackerstraße liegt die große Wärmehalle des Wohlfahrtsamts Mitte, die jedermann ohne Ausweis betreten kann.“"
                            },
                            {
                                "example_id": "2a45c2aa-cd4a-4f37-86ea-9677f3cfd19d",
                                "sense_id": "68712274-a21d-3cb0-a263-e34384f8d313",
                                "text": "„Die Wärmehallen in den Stadtbahnbögen 97 - 99 bieten hinreichenden Raum für alle Schutz gegen Kälte nachsuchenden Männer.“"
                            },
                            {
                                "example_id": "a86b3d22-9453-4df2-8344-aed7e508cd4d",
                                "sense_id": "68712274-a21d-3cb0-a263-e34384f8d313",
                                "text": "„Wer finanziert die Wärmehallen, wenn im Winter bei steigenden Energiepreisen die ersten Hartz-IV-Empfänger in ihren Wohnungen erfrieren?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
