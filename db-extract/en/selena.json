                                        "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                        "entry_id": "9d74b913-cf85-3b7d-88e3-158817aabeb3",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
