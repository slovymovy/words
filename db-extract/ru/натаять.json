                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01a9f4c5-d227-42d4-82a7-396f51464fd8",
                                "sense_id": "51e8fd33-402c-38da-b698-1a148a862127",
                                "text": "Я выпросил хлеба, вернулся в барак, натаял снегу и стал варить чернослив."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1fd4f58-3e10-3637-b8af-6116e72df136",
