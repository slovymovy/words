                "senses": [
                    {
                        "sense_id": "2d2d0f7c-5bfb-36b7-b50a-c428ebed6cea",
                        "entry_id": "4ceea41c-6c19-3121-8a52-7ff4cbcefa20",
                        "glosses": [
                            "Kapelle, die dem Heiligen Rupert (Apostel der Bayern) geweiht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8573c81e-d6f5-47b3-9f20-fcefe76ceda7",
                                "sense_id": "2d2d0f7c-5bfb-36b7-b50a-c428ebed6cea",
                                "text": "„Es darf nicht unerwähnt bleiben, daß bei der Alten Kapelle an derselben Stelle eine Marien- oder Rupertkapelle lag, ursprünglich eine zweigeschossige Anlage.“"
                            },
                            {
                                "example_id": "c2332e8b-394e-4081-9f56-e176c0d05f54",
                                "sense_id": "2d2d0f7c-5bfb-36b7-b50a-c428ebed6cea",
                                "text": "„Um 1140 entstand so der noch vorhandene Bergfried mit der Rupertkapelle.“"
                            },
                            {
                                "example_id": "815639b2-2c7b-4309-ad2c-8c43437b08ba",
                                "sense_id": "2d2d0f7c-5bfb-36b7-b50a-c428ebed6cea",
                                "text": "„Höchstens käme in diesem Zusammenhang die Halbfigur einer Madonna, neu übermalt, in der Rupertkapelle von St. Emmeram in Betracht wegen des in ähnlicher Weise dargestellten Kindes, sie steht an Qualität aber bedeutend zurück.“"
                            },
                            {
                                "example_id": "c65e6d08-7e9f-4cab-96e3-ffaaf5f31c82",
                                "sense_id": "2d2d0f7c-5bfb-36b7-b50a-c428ebed6cea",
                                "text": "„Die erwähnte Kirche am Prändtlhoff ist die heute als Scheuer benützte romanische Rupertkapelle am Brantlhofe, eine halbe Stunde Weges westlich vom Zollfelde am Auslaufe des Ulrichsberges.“"
                            },
                            {
                                "example_id": "145aa841-9849-4abc-b1f1-89279d6497b7",
                                "sense_id": "2d2d0f7c-5bfb-36b7-b50a-c428ebed6cea",
                                "text": "„Erzb. Konrad I. ließ den Petersberg ausbauen und den gewaltigen Bergfried mit der bemalten Rupertkapelle, der heute noch steht, errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
