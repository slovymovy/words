                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superorganism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c92ee3-48f4-3a0e-8307-505a42b4145d",
                                        "entry_id": "bcaac4d5-2b75-372b-aa1d-f945c7089737",
                                        "glosses": [
                                            "A social colony of individuals who, through division of labour, effective communication and self-organization, form a highly connected community that functions as if it were a single organism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acde43e4-0f98-4b1c-bfc6-de770c884eed",
                                                "sense_id": "b2c92ee3-48f4-3a0e-8307-505a42b4145d",
                                                "text": "A superorganism is an ensemble of living and non-living matter, which acts as a single self-regulating system. […] Gaia is the largest and most complex superorganism we know."
                                            },
                                            {
                                                "example_id": "8bdb137c-467f-47d7-82ce-ab7adbbb1a90",
                                                "sense_id": "b2c92ee3-48f4-3a0e-8307-505a42b4145d",
                                                "text": "To grasp why Metaman—our strange amalgam of concrete, humans, computer chips, and various plants and animals—is a superorganism rather than merely an elaborate “social grouping” of humans, look at another, far simpler grouping of organisms—a termite colony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
