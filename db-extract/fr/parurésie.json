                        "glosses": [
                            "Difficulté ou incapacité d’origine psychologique à uriner lorsqu’on se sent observé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173897d4-2dab-4080-ae33-cc633bbd3033",
                                "sense_id": "32fce323-6336-3431-95bf-d8949d446b18",
                                "text": "Souffrant de parurésie sévère, Martin a passé 30 heures pendant un vol de Dorval à Shanghaï sans se rendre une seule fois dans les toilettes de l’avion, pas plus que lors des escales."
                            }
                        ]
