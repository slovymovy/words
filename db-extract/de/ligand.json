                    {
                        "sense_id": "c5dd5865-9c08-314a-baf5-3eb4a18a36fa",
                        "entry_id": "24cc125e-9190-374f-bd4d-1b68ed3cc1c2",
                        "glosses": [
                            "Chemie, Komplexchemie: Ion oder Molekül, das an ein Zentralatom gebunden ist und mit diesem eine Komplexverbindung bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a76ef4-b0d9-48ea-ae9f-1576868927ab",
                                "sense_id": "c5dd5865-9c08-314a-baf5-3eb4a18a36fa",
                                "text": "Die Bezeichnung Ligand bezeichnet ein Atom oder Molekül, welches über eine dative Bindung an ein zentrales Metall-Ion koordiniert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "227e71a8-650b-3827-b878-7def37a9db44",
                        "entry_id": "24cc125e-9190-374f-bd4d-1b68ed3cc1c2",
                        "glosses": [
                            "chemischer Stoff, der an ein bestimmtes Enzym, etwa an einen Rezeptor binden kann"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "4ec40cee-836e-4b12-ac85-f1b3e41cf8ca",
                                "sense_id": "227e71a8-650b-3827-b878-7def37a9db44",
                                "text": "Liganden, die einen Rezeptor aktivieren, bezeichnet man als Agonisten, während Liganden, die einen Rezeptor inaktivieren, auch inverse Agonisten oder Antagonisten genannt werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
