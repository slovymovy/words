                "senses": [
                    {
                        "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                        "entry_id": "f2fb4c57-afe1-303c-a54b-520b518f72b8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327240b5-67cb-41ac-91b4-c964202fbf8b",
                                "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                                "text": "Frau Knauth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ee8b142d-25d6-48b8-80dc-861402b36abf",
                                "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                                "text": "Herr Knauth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d833bca6-59fd-489c-95b1-e93cfcaf6461",
                                "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                                "text": "Die Knauths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4c31ed98-51b2-442b-9354-4d031cf8550d",
                                "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                                "text": "Der Knauth trägt nie die Schals, die die Knauth ihm strickt."
                            },
                            {
                                "example_id": "5a84688d-f0dd-4c2c-a951-d6a83931078c",
                                "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knauth kommt, geht der Herr Knauth.“"
                            },
                            {
                                "example_id": "c0f167a0-d26b-4473-abd5-277c5bb90138",
                                "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                                "text": "Knauth kommt und geht."
                            },
                            {
                                "example_id": "2cbd6abd-2c33-4173-a145-6cbcaf6e710a",
                                "sense_id": "bfc17ab0-ff89-32f8-84fd-63696fac8be5",
                                "text": "Knauths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
