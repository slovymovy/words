                "senses": [
                    {
                        "sense_id": "1a86e159-381b-3b63-9fa6-9394ab044a09",
                        "entry_id": "d81519f0-dbd0-3c4d-bea5-6ce88c5bcd56",
                        "glosses": [
                            "grundsätzliche Versorgung von einem Raum mit Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7191033b-bfcd-48ce-b254-db2e127965a3",
                                "sense_id": "1a86e159-381b-3b63-9fa6-9394ab044a09",
                                "text": "„Die Luftmengen, die man für die Nachtauskühlung benötigt, sind zirka um das Zehnfache höher als die Luftmengen für die Grundlüftung.“"
                            },
                            {
                                "example_id": "bed58121-59f5-47d7-bc28-c1c321be21d0",
                                "sense_id": "1a86e159-381b-3b63-9fa6-9394ab044a09",
                                "text": "„Einfache Regelorgane sind in der Lage, die Grundlüftung selbsttätig regelnd, in Abhängigkeit von einer geeigneten Führungsgröße, z.B. die relative Raumluftfeuchte, durchzuführen.“"
                            },
                            {
                                "example_id": "617f0937-b8e3-46dc-9c1d-7ef74c309f1b",
                                "sense_id": "1a86e159-381b-3b63-9fa6-9394ab044a09",
                                "text": "„Eine kontrollierte Grundlüftung bringt viele Vorteile.“"
                            },
                            {
                                "example_id": "c4f87bcf-1049-41e9-81e8-748a5ca0cf4e",
                                "sense_id": "1a86e159-381b-3b63-9fa6-9394ab044a09",
                                "text": "„Die Werte für die Grundlüftung (GL) sind Bezugswerte für die Bemessung der Lüftungskomponenten der freien Lüftung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
