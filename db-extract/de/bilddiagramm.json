                "senses": [
                    {
                        "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                        "entry_id": "ef5ff930-f03b-32ba-895e-1c46650d080f",
                        "glosses": [
                            "Diagramm, das die Häufigkeit von etwas mithilfe von Bildern/Grafiken darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f6d32d-ec65-41af-a842-142139181155",
                                "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                                "text": "„In diesem Bilddiagramm stellt ein Mensch 10000000 Einwohner dar.“"
                            },
                            {
                                "example_id": "9bc2b1c5-c5fc-47cc-a795-4218f0f43469",
                                "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                                "text": "„Warum hat das Bilddiagramm für Stuttgart eine Figur mehr als das Bilddiagramm für Bremen?“"
                            },
                            {
                                "example_id": "d9181756-31c3-4416-a931-66ece728dbd3",
                                "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                                "text": "„Wie viele Schüler steigen im Bilddiagramm in den Bus?“"
                            },
                            {
                                "example_id": "009c289d-400a-4178-80d9-c96e23e5028f",
                                "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                                "text": "„Alternativ werden das Piktogramm als Bilddiagramm, freie Grafik, Grafik mit Illustrationselementen, Symboldiagramm oder einfach als Symbol bezeichnet […].“"
                            },
                            {
                                "example_id": "81d63840-3fc9-48ff-9fd7-47039229e966",
                                "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                                "text": "„Hier siehst du die gerundeten Einwohnerzahlen einzelner Länder in einer Tabelle aufgelistet und in einem Bilddiagramm veranschaulicht.“"
                            },
                            {
                                "example_id": "83976e0c-932e-4987-a1ea-77b444bf0620",
                                "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                                "text": "„Die meisten Bilddiagramme sind auf einer planen Oberfläche angeordnet, diederLeinwandvon Desportesgleicht.“"
                            },
                            {
                                "example_id": "06c4e30d-f007-474d-9f4c-f0ee901680cb",
                                "sense_id": "5de8c977-b0db-3b7d-a542-e86836d51040",
                                "text": "„Bilddiagramme werden zur allgemeinverständlichen Wiedergabe von statistischen Werten verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
