                ],
                "senses": [
                    {
                        "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                        "entry_id": "8797b064-1c72-3e0d-8e74-dba48aec1cf5",
                        "glosses": [
                            "Qui est situé tout près d’une ville, qui l’entoure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "593ef283-c32d-4e2e-8b2c-abd84e0b3006",
                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                "text": "Ce pavillon [d'Issy] fut la résidence suburbaine de Marguerite de Valois, la première femme de Henri IV, depuis 1606 jusqu’à sa mort en 1615."
                            },
                            {
                                "example_id": "5de4eb28-0001-4942-8b31-afe639b498bf",
                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                "text": "Devenu le mâle dominant du clan, il avait réussi à fédérer les familles de la pègre suburbaine."
                            },
                            {
                                "example_id": "51022298-e621-41a2-9666-eec9ec8651c9",
                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                "text": "Selon la loi sur la défusion des municipalités suburbaines qui a structuré le conseil d’agglomération, […]."
                            },
                            {
                                "example_id": "8b7d603f-bf78-4912-beb9-7e1a72d89968",
                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                "text": "Les communes suburbaines de Paris."
                            },
                            {
                                "example_id": "e38d1831-8b02-49bc-bd32-7424d912b3f7",
                                "sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                                "text": "La population suburbaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94e815fe-ea46-4cad-9f37-3eed012f38b3",
                        "source_entry_id": "8797b064-1c72-3e0d-8e74-dba48aec1cf5",
                        "source_sense_id": "158893cc-683e-3d07-8df2-9821d0059947",
                        "target_lang_word": "suburban",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suburban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3c3fcb3-e1d0-3e57-9249-fc0dc0fe419a",
                                        "entry_id": "21fe8cb0-0a82-304d-854b-ed05fb51aaed",
                                        "glosses": [
                                            "Relating to or characteristic of or situated on the outskirts of a city; of or relating to suburbia or the suburbs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a37d88-fe6c-456e-9d2f-e49434c6aeb7",
                                                "sense_id": "b3c3fcb3-e1d0-3e57-9249-fc0dc0fe419a",
                                                "text": "Suburban villas, highway-ſide retreats, / That dread th' encroachment of our growing ſtreets, / Tight boxes, neatly ſaſh'd, and in a blaze / With all a July ſun's collected rays, / Delight the citizen, who gaſping there, / Breathes clouds of duſt and calls it country air."
                                            },
                                            {
                                                "example_id": "e926a553-447c-4929-96ff-8d66480f5dc6",
                                                "sense_id": "b3c3fcb3-e1d0-3e57-9249-fc0dc0fe419a",
                                                "text": "Not only has suburban life separated the great concentrated masses of our people from their birthright of meadows, fields and woods; of Nature, in her untamed splendour and mystery, most of them have never had so much as a momentary glimpse."
                                            },
                                            {
                                                "example_id": "640fd4dd-18a5-4d4e-840d-24e84b2993c0",
                                                "sense_id": "b3c3fcb3-e1d0-3e57-9249-fc0dc0fe419a",
                                                "text": "They form part of the vast electrification and reconstruction schemes which have been in hand for a number of years at Liverpool Street, and in suburban Essex, and include the rearrangement of tracks, of which the Ilford flyover forms part; the modern signal boxes, now needed only at key points; the electric control or sub-stations; and a large electric car shed."
                                            },
                                            {
                                                "example_id": "fb34b01f-ed44-4bd2-94f2-61e1b7b09830",
                                                "sense_id": "b3c3fcb3-e1d0-3e57-9249-fc0dc0fe419a",
                                                "text": "Tiffany Henyard’s tumultuous tenure as mayor of south suburban Dolton is coming to an end, and voters were very clear about ousting her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suburban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fae96826-1b1f-30cc-b078-574d4fe3cf66",
