                        "entry_id": "c0592b57-41f8-3822-8f2f-81721669076d",
                        "glosses": [
                            "An angry or enraged citizen, especially one who feels politically marginalized."
                        ],
                        "tags": [
                            "derogatory",
                            "masculine",
