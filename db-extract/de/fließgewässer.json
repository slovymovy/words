                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "A division of a school year by perceived ability."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cac0d70d-abbf-429e-83c2-f0f2c0691dce",
                                                "sense_id": "197b147f-4a76-33aa-8db5-c9f435436dba",
                                                "text": "All of the bright kids went into the A stream, but I was in the B stream."
                                            }
                                        ]
