                "senses": [
                    {
                        "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                        "entry_id": "6222e6fd-40c0-3600-8ef1-fb16870a205f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dfceb09-1624-46a4-a0d4-d31f38a64e1b",
                                "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                                "text": "Frau Hirschle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "64b68d08-f238-4cc3-ba07-ce7f06dc13ea",
                                "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                                "text": "Herr Hirschle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "775a4a16-4b6a-4882-936c-967a5592e839",
                                "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                                "text": "Die Hirschles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3fe47c9a-ba8e-4011-98a3-38f2b911ae9d",
                                "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                                "text": "Der Hirschle trägt nie die Pullover, die die Hirschle ihm strickt."
                            },
                            {
                                "example_id": "bce00dcc-7da0-4eda-9af8-f87e45fab53a",
                                "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hirschle kommt, geht der Herr Hirschle.“"
                            },
                            {
                                "example_id": "fe0e6f7e-c0cd-403b-a33e-66f8a8eaafe9",
                                "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                                "text": "Hirschle kommt und geht."
                            },
                            {
                                "example_id": "8fe4b2c7-8955-4b57-a492-4f40ede171ae",
                                "sense_id": "9133f8f7-d82d-3785-9bcd-ad433cc26fa5",
                                "text": "Hirschles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
