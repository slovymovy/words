                "senses": [
                    {
                        "sense_id": "f87f1489-a358-371c-880b-848e41c9e2ad",
                        "entry_id": "e75c4172-28b2-33ef-9171-e13a5d586ca3",
                        "glosses": [
                            "Buch, in dem Einnahmen und Ausgaben eines Haushalts verzeichnet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c64fdc-7c02-4eeb-a358-201718c0326a",
                                "sense_id": "f87f1489-a358-371c-880b-848e41c9e2ad",
                                "text": "„Führen kann man ein Haushaltsbuch, indem man sich selbst eines „bastelt“, oder eine kostenlose Vorlage für ein Haushaltsbuch aus dem Internet verwendet.“"
                            },
                            {
                                "example_id": "8b9aad14-e70a-4f91-8ec7-dec79f5be4dc",
                                "sense_id": "f87f1489-a358-371c-880b-848e41c9e2ad",
                                "text": "„Papa schaute sich die Kladden genauer an, und wir entdeckten, dass es Mamas Haushaltsbücher waren.“"
                            },
                            {
                                "example_id": "f15fd3d6-323d-4720-ac91-f7671874f070",
                                "sense_id": "f87f1489-a358-371c-880b-848e41c9e2ad",
                                "text": "„Simen Tjing richtete also ein Haushaltsbuch ein, zahlte dreißig Unzen Silber und dreißig Kupferlinge aus und übertrug Goldlotos die Führung der Rechnungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
