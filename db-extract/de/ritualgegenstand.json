                "senses": [
                    {
                        "sense_id": "e5fb9519-6651-3c2d-af8f-f41a8c366922",
                        "entry_id": "978c25d2-554c-32da-a79f-36d4ebebab0d",
                        "glosses": [
                            "bei Ritualen verwendeter Gegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e9d877-90ff-4c25-ab41-958a2e73e941",
                                "sense_id": "e5fb9519-6651-3c2d-af8f-f41a8c366922",
                                "text": "„Kaum fiel Plombs Blick auf den Ritualgegenstand, streckte er mir die aufwärts gekehrten Handflächen entgegen, und ich brachte das wunderliche Gerät auf seinem rechtmäßigen Altar dar.“"
                            },
                            {
                                "example_id": "3d11717f-81f8-449a-8744-3e36a78cac14",
                                "sense_id": "e5fb9519-6651-3c2d-af8f-f41a8c366922",
                                "text": "„Aber Teil dessen war aus Amerys Sicht auch die von den Osmanen geduldete Praxis der Juden, Ritualgegenstände und sonstige Utensilien an der Westmauer zu verwenden, was ihnen nun auch weiterhin gestattet sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
