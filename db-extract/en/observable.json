                                        "examples": [
                                            {
                                                "example_id": "3e060055-783d-469d-adec-e320b4e228aa",
                                                "sense_id": "9e046f2f-1d63-3be2-9e2b-6e7d69838fbe",
                                                "text": "Faciès anthropogène à Polygonum sp. pl. observable dans les zones plus ou moins fangeuses fréquentées par les bestiaux et où s’installent des espèces nitratophiles […]"
                                            },
                                            {
                                                "example_id": "772146c2-15c2-43b4-b7ae-6627d546cd15",
                                                "sense_id": "9e046f2f-1d63-3be2-9e2b-6e7d69838fbe",
                                                "text": "Un service est tout d’abord intangible, pas directement observable, par rapport à un produit qui a une forme, est visible, solide, peut être palpé et a fait l'objet d'une série de transformations physiques."
                                            }
                                        ]
                                    }
                                ]
                            },
