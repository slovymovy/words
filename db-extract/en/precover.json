                    },
                    {
                        "sense_id": "06da4e5d-315b-37e8-ae0b-e358d48fe34e",
                        "entry_id": "7f22c8b7-6f21-3460-8c50-6b5ee752c1d9",
                        "glosses": [
                            "Something that occurs in preparation for a covering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262b4ab4-cb83-40aa-b0d1-805f244b1e5a",
                                "sense_id": "06da4e5d-315b-37e8-ae0b-e358d48fe34e",
                                "text": "Zineb did not give good control as a precover spray but as a cover spray it gave excellent control of late and storage scab."
                            },
                            {
                                "example_id": "20bc7fc3-76c2-4e4a-8f1d-15c9310d2874",
                                "sense_id": "06da4e5d-315b-37e8-ae0b-e358d48fe34e",
                                "text": "Excellent control of a storage rot of apples, caused by Gloeosporium album, was obtained with an orchard spraying program of captan in the precover followed by 3 regular and 2 late cover sprays of captan or a mixture of captan and zineb."
                            },
                            {
                                "example_id": "2141c05e-69b2-4693-bdcb-7c3ce86ba1bb",
                                "sense_id": "06da4e5d-315b-37e8-ae0b-e358d48fe34e",
                                "text": "At the discretion of the Agent, the permittee may be assessed a reinspection fee, not to exceed $235, when a precover inspection correction notice requires correction of improper construction and, at a subsequent inspection, the Agent finds system construction deficiencies have not been corrected."
                            }
                        ]
                    }
