                "senses": [
                    {
                        "sense_id": "4ccc96c9-160a-3a0e-9489-63db79d50622",
                        "entry_id": "50eca7ae-a3a3-3380-ab83-a658fdb17033",
                        "glosses": [
                            "Konzentrat aus Traubenmost, welches vor allem für die Streckung von Weinen benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "962504bc-f9ba-43ef-8160-4bc580343e34",
                                "sense_id": "4ccc96c9-160a-3a0e-9489-63db79d50622",
                                "text": "„Ach so - Ihnen genügt der Discounterbalsamico mit lecker Traubenmostkonzentrat, Karamell, Zuckercouleur, Aromastoffen, Konservierungsmittel und Glyzerin drin? Sorry, dann ist das alles hier natürlich total Essig.“"
                            },
                            {
                                "example_id": "88ec5423-3b1c-41c3-b372-7758be78ca71",
                                "sense_id": "4ccc96c9-160a-3a0e-9489-63db79d50622",
                                "text": "„[..] \"Und mancher kauft Traubenmostkonzentrat in Italien und gibt es hier in den Wein.\"“"
                            },
                            {
                                "example_id": "26559225-eca2-41b2-969d-1f6f1934a5de",
                                "sense_id": "4ccc96c9-160a-3a0e-9489-63db79d50622",
                                "text": "„Schwache Mosel-, Pfalz- und Rheinhessen-Weine, so die Staatsanwälte, seien zudem mit mehr als 1,1 Millionen Litern italienischem und französischem Tafelwein und 138 Tonnen Traubenmostkonzentrat gesüßt worden.“"
                            },
                            {
                                "example_id": "8a1b21c5-a377-4dae-970e-6926e662af00",
                                "sense_id": "4ccc96c9-160a-3a0e-9489-63db79d50622",
                                "text": "„1980 wurde die Idee geboren, eine Beihilfe dafür zu zahlen, daß die Winzer anstelle von Zucker dem Wein Traubenmostkonzentrat zusetzen sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
