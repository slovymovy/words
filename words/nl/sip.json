            "senses": [
                {
                    "sense_id": "c5444ed0-58fd-30d8-b9e6-db9d30ea1bc8",
                    "sense_definition": "teleurgesteld en bedrukt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij hoorde dat het feest niet doorging, keek hij erg <w>sip</w>.",
                            "target_lang_translations": {
                                "en": "When he heard that the party was cancelled, he looked very <w>glum</w>."
                            }
                        },
                        {
                            "text": "Met een <w>sip</w> gezicht vertelde het kind dat zijn ijsje op de grond was gevallen.",
                            "target_lang_translations": {
                                "en": "With a <w>sad</w> face, the child said that his ice cream had fallen on the ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "droevig",
                        "treurig"
                    ],
                    "antonyms": [
                        "vrolijk",
                        "blij"
                    ],
                    "common_phrases": [
                        "sip kijken",
                        "een sip gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "disappointed and dejected or downcast"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sad",
                                "target_lang_sense_clarification": "unhappy or disappointed"
                            },
                            {
                                "target_lang_word": "glum",
                                "target_lang_sense_clarification": "looking disappointed and quiet"
                            },
                            {
                                "target_lang_word": "sulky",
                                "target_lang_sense_clarification": "unhappy and silent because of disappointment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19199fc8-a863-34ef-a2f2-22017ade9f83",
                    "sense_definition": "droevig en ingetogen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de nederlaag van hun team zaten de supporters er maar <w>sip</w> bij.",
                            "target_lang_translations": {
                                "en": "After their team's defeat, the supporters just sat there looking <w>downcast</w>."
                            }
                        },
                        {
                            "text": "Zij voelde zich een beetje <w>sip</w> door het grijze en regenachtige weer.",
                            "target_lang_translations": {
                                "en": "She felt a bit <w>blue</w> because of the grey and rainy weather."
                            }
                        }
                    ],
                    "synonyms": [
                        "droevig",
                        "treurig"
                    ],
                    "antonyms": [
                        "opgewekt"
                    ],
                    "common_phrases": [
                        "er sip bij zitten"
                    ],
                    "target_lang_definitions": {
                        "en": "sad and subdued or low-spirited"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "downcast",
                                "target_lang_sense_clarification": "feeling sad or discouraged"
                            },
                            {
                                "target_lang_word": "blue",
                                "target_lang_sense_clarification": "feeling slightly sad or depressed"
                            },
                            {
                                "target_lang_word": "melancholy",
                                "target_lang_sense_clarification": "feeling a quiet, pensive sadness"
                            }
                        ]
                    }
                }
            ]
