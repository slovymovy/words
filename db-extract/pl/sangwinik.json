                "translations": [
                    {
                        "translation_id": "4caeb0f4-3f51-49f6-9fac-0250ff7bc1d1",
                        "source_entry_id": "7e0a9926-d876-3af1-ad98-b21f2f10c606",
                        "source_sense_id": "15fba288-a7ef-3b7b-8afd-420d4b4e286d",
                        "target_lang_word": "sanguin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanguin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1efaea5-87a6-3f92-9645-34c3fd5c71ef",
                                        "entry_id": "e2103428-c06d-3154-a1e2-967aba928d0a",
                                        "glosses": [
                                            "Qui a rapport au sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e706907-aae3-44a5-8df3-3e86227ef4c0",
                                                "sense_id": "c1efaea5-87a6-3f92-9645-34c3fd5c71ef",
                                                "text": "Le trentenaire, 22 mentions au casier, a été reconvoqué quelques jours plus tard, en attente des résultats des tests sanguins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a532e9f8-bfb2-3499-a27d-7533c123cf6e",
                                        "entry_id": "e2103428-c06d-3154-a1e2-967aba928d0a",
                                        "glosses": [
                                            "Qui est caractérisé par la richesse du sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9545ac-8f5c-4f53-b226-5c6637fac3e2",
                                                "sense_id": "a532e9f8-bfb2-3499-a27d-7533c123cf6e",
                                                "text": "C’était un homme d’une quarantaine d’années, de taille et de constitution ordinaires ; son tempérament sanguin se trahissait par une coloration forcée du visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a77d76-f3d1-3331-be46-e02ff420317f",
                                        "entry_id": "e2103428-c06d-3154-a1e2-967aba928d0a",
                                        "glosses": [
                                            "Qui est de couleur de sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e360ee-40f1-4e4f-9e8e-9869d008aa71",
                                                "sense_id": "58a77d76-f3d1-3331-be46-e02ff420317f",
                                                "text": "Un rouge sanguin, de couleur sanguine."
                                            },
                                            {
                                                "example_id": "9452a480-278a-4922-8bc4-dff3864c9746",
                                                "sense_id": "58a77d76-f3d1-3331-be46-e02ff420317f",
                                                "text": "Il a tout le visage d’un rouge sanguin."
                                            },
                                            {
                                                "example_id": "2d04d769-6334-4f4b-bbc3-2991cb1e1144",
                                                "sense_id": "58a77d76-f3d1-3331-be46-e02ff420317f",
                                                "text": "L’Empire était judicieusement mêlé aux meubles dont l’Angleterre nous enseigna le confort et dont le cuir fauve s’harmonisait à merveille avec le rouge sanguin de l’acajou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c603d49-5c9d-31fa-aeac-79e19248ef66",
                                        "entry_id": "e2103428-c06d-3154-a1e2-967aba928d0a",
                                        "glosses": [
                                            "Vif, colérique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56f4d54-2b13-4fde-989d-b74393bd3da8",
                                                "sense_id": "0c603d49-5c9d-31fa-aeac-79e19248ef66",
                                                "text": "Se venger, les tuer  ! La violence naturelle à son tempérament sanguin lui dicta les pires conseils."
                                            },
                                            {
                                                "example_id": "9109fdc5-5d75-4ede-b5cc-f845bfd136ae",
                                                "sense_id": "0c603d49-5c9d-31fa-aeac-79e19248ef66",
                                                "text": "C’était un homme grisonnant, sanguin, apoplectique, violent et suffisamment spirituel pour un mathématicien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sanguin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b53e3446-94fc-398e-9ea0-9807d430a89a",
                                        "entry_id": "6041a187-934f-3510-922f-f603a3305679",
                                        "glosses": [
                                            "Personnage sanguin, qui s'emporte facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2756bc-2994-4cd2-b496-86fb41a0185e",
                                                "sense_id": "b53e3446-94fc-398e-9ea0-9807d430a89a",
                                                "text": "« Gérard, c’est un sanguin, un instinctif. Il dit des choses comme elles lui viennent, mais il ne les pense pas toujours. Parfois, il regrette illico, puis il soupire : Tant pis, je l’ai dit. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddef6e6d-1dcd-383f-8d0e-eddd363c8fcf",
                                        "entry_id": "6041a187-934f-3510-922f-f603a3305679",
                                        "glosses": [
                                            "Ouvrier chargé de recueillir le sang des animaux aux abattoirs."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
