                                    {
                                        "sense_id": "15ef1a5e-80fc-328e-a0d8-501f6bfeb49a",
                                        "entry_id": "aa976c1a-8292-3b36-aa22-3bcf0504d5aa",
                                        "glosses": [
                                            "Großstadt im Südwesten Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d486ae90-eb85-40f2-8036-99ea7f008e29",
                                                "sense_id": "15ef1a5e-80fc-328e-a0d8-501f6bfeb49a",
                                                "text": "Bordeaux liegt an der Garonne, etwa 45 Kilometer vom Meer entfernt."
                                            },
                                            {
                                                "example_id": "eeb68175-11e2-43e3-8a7a-4cea246b830e",
                                                "sense_id": "15ef1a5e-80fc-328e-a0d8-501f6bfeb49a",
                                                "text": "„In Bordeaux formte der Iserlohner Friedrich Romberg mit seinen Partnern um 1780 eine der größten Sklavenhandelsfirmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b63b249d-d0fa-3d46-b01b-3945f1dab75c",
                                        "entry_id": "aa976c1a-8292-3b36-aa22-3bcf0504d5aa",
                                        "glosses": [
                                            "Region und bekanntes Weinbaugebiet im Südwesten Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b21522-1f14-49ca-8f6a-26c65f0d3e41",
                                                "sense_id": "b63b249d-d0fa-3d46-b01b-3945f1dab75c",
                                                "text": "Das Bordeaux ist bekannt für seinen Rotwein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bordeaux",
