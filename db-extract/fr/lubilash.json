                        "glosses": [
                            "rivière du Congo-Kinshasa, habituellement appelée Sankuru sur son cours inférieur."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "67b69c1b-d100-4eb1-8648-dcc6e7f3a1ae",
                                "sense_id": "c6552eab-3aaf-3ce6-87bf-bc5b008528c8",
                                "text": "La Compagnie du Kasaï, enfin, occupait le bassin du Kasaï, au sud de la Lukenye et à l’ouest de la Lubilash."
                            },
                            {
                                "example_id": "9c279bea-e6fa-436f-b463-cc462e005bb6",
                                "sense_id": "c6552eab-3aaf-3ce6-87bf-bc5b008528c8",
                                "text": "Des groupes de Luba kasai quittèrent le Shaba et se dispersèrent sur les rives du Lublilash, où ils trouvèrent des terres mieux irriguées."
                            }
                        ]
                    }
