    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "566bfda5-a3d1-3df8-b3cf-94e2270fed2e",
                    "sense_definition": "Maintenir en bon état et empêcher de se gâter ou de dépérir, notamment pour la nourriture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "preservation_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>conserver</w> ce fromage au frais pour éviter qu'il s'abîme."
                        },
                        {
                            "text": "Vous pouvez <w>conserver</w> ces légumes pendant plusieurs semaines dans le bac du réfrigérateur."
                        }
                    ],
                    "synonyms": [
                        "garder",
                        "préserver"
                    ],
                    "antonyms": [
                        "détruire",
                        "gaspiller"
                    ],
                    "common_phrases": [
                        "conserver au frais",
                        "conserver au réfrigérateur",
                        "conserver les aliments"
                    ]
                },
                {
                    "sense_id": "f558ea6a-66b7-3c01-8f99-fdebfb1e9c77",
                    "sense_definition": "Garder quelque chose en sa possession, ne pas le jeter ou s'en séparer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>conserver</w> tous les vieux livres de son grand-père."
                        },
                        {
                            "text": "Nous devons <w>conserver</w> ces factures pendant au moins cinq ans."
                        }
                    ],
                    "synonyms": [
                        "garder",
                        "retenir"
                    ],
                    "antonyms": [
                        "abandonner",
                        "jeter"
                    ],
                    "common_phrases": [
                        "conserver des documents",
                        "conserver un souvenir"
                    ]
                },
                {
                    "sense_id": "6f65d9e6-2d21-3616-8a5f-94129e2aff1c",
                    "sense_definition": "Maintenir une attitude, une disposition d'esprit ou un état sans le perdre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etat_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a su <w>conserver</w> son calme malgré la panique générale."
                        },
                        {
                            "text": "L'équipe espère <w>conserver</w> son avance jusqu'à la fin de la rencontre sportive."
                        }
                    ],
                    "synonyms": [
                        "garder",
                        "maintenir"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "conserver ses privilèges",
                        "conserver son calme",
                        "conserver son sang-froid"
                    ]
                },
                {
                    "sense_id": "48cfd6ef-bb87-313a-8ba9-303bf8e25715",
                    "sense_definition": "Prendre soin de son corps ou de sa santé pour rester jeune et vigoureux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À plus de quatre-vingts ans, ce monsieur se <w>conserve</w> admirablement bien."
                        },
                        {
                            "text": "Elle pratique la natation régulièrement pour se <w>conserver</w> en pleine forme."
                        }
                    ],
                    "common_phrases": [
                        "bien se conserver"
                    ]
                },
                {
                    "sense_id": "4de77130-87e0-3810-a186-6340d03fb8ae",
                    "sense_definition": "Rester en ligne lors d'un appel téléphonique en attendant d'être mis en relation.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "telephone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez <w>conserver</w> l'écoute pendant que je transfère votre appel à ma collègue."
                        },
                        {
                            "text": "L'opératrice nous a demandé de <w>conserver</w> l'écoute quelques instants."
                        }
                    ],
                    "synonyms": [
                        "patienter"
                    ],
                    "antonyms": [
                        "raccrocher"
                    ],
                    "common_phrases": [
                        "conserver l'écoute"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
