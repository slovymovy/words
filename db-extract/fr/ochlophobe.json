                "forms": [
                    {
                        "form_id": "a5b6749f-7cc9-4ae4-a1de-84d8b510106a",
                        "entry_id": "9a4c0680-90a3-35db-97b1-5f0b117cb596",
                        "tags": [
                            "plural"
                        ],
                        "form": "ochlophobes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fed4d69-979f-33d3-a1a5-e79f220c5404",
                        "entry_id": "9a4c0680-90a3-35db-97b1-5f0b117cb596",
                        "glosses": [
                            "Qui est atteint d'ochlophobie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e22e57b7-bcff-4827-ac6e-662b041f0764",
                                "sense_id": "3fed4d69-979f-33d3-a1a5-e79f220c5404",
                                "text": "S’estimant ochlophobe, il est maintenu cloisonné par ses angoisses dans l’appartement de Catherine, sa compagne, aux crochets de laquelle il végète davantage qu’il ne vit, roulant des joints à longueur de journée en regardant MTV."
                            },
                            {
                                "example_id": "a9184ef3-33e9-4db3-9c47-85ccb2acf69e",
                                "sense_id": "3fed4d69-979f-33d3-a1a5-e79f220c5404",
                                "text": "Comme la boîte de nuit n’est qu’à quelques rues du motel, nous y allons à pied. On nous laisse entrer et la première chose que je constate quand nous entrons, c’est la musique. Elle est tellement forte que je sens le plancher vibrer au rythme de la basse. Je suis certaine que lorsque je sortirai, mes oreilles seront bouchées. Une chance que je ne suis ni claustrophobe ni ochlophobe car il y a énormément de gens qui dansent collés les uns contre les autres."
                            },
                            {
                                "example_id": "53854653-c8ff-40a1-b707-f5cb286a3a76",
                                "sense_id": "3fed4d69-979f-33d3-a1a5-e79f220c5404",
                                "text": "Cinq minutes sont passées et je me lance dans une aventure pour les claustrophobes ! Je précise que je ne le suis pas du tout. Encore moins agoraphobe ou ochlophobe. Je suis même plutôt ochlophile. Bref."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8edc0c1c-c270-43ff-97a0-c8ae8090fb31",
                        "source_entry_id": "9a4c0680-90a3-35db-97b1-5f0b117cb596",
                        "source_sense_id": "3fed4d69-979f-33d3-a1a5-e79f220c5404",
                        "target_lang_word": "ochlophobic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ochlophobic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56f9000e-9cd6-33e7-a735-13b610b3a32b",
                                        "entry_id": "8eb01c6b-d5b3-305a-96e7-15ccf6329343",
                                        "glosses": [
                                            "Having an aversion to crowds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ochlophobic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c59063da-2291-3eac-a9cc-78c4cd90dc64",
                                        "entry_id": "e99168e5-7446-3122-8521-0215cbbcc84b",
                                        "glosses": [
                                            "Synonym of ochlophobe."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b563970-5d55-4ef4-8429-7ff15cdf21e0",
                                                "sense_id": "c59063da-2291-3eac-a9cc-78c4cd90dc64",
                                                "text": "Let ochlophobics in their towers stay, Hugging their egos ’gainst the Master Plan. / I shall ne’er boast that I am not as they, / But glad that I’m an advertising man."
                                            },
                                            {
                                                "example_id": "d293e361-4539-4dd2-840b-360f9b4d5ea3",
                                                "sense_id": "c59063da-2291-3eac-a9cc-78c4cd90dc64",
                                                "text": "If they are in a crowd, ochlophobics may fear that they cannot get out fast enough, or that there is no place that is safe with so many people around."
                                            },
                                            {
                                                "example_id": "8e2bfbd8-b375-4333-aa13-ee53b78b8121",
                                                "sense_id": "c59063da-2291-3eac-a9cc-78c4cd90dc64",
                                                "text": "“Hello indeed,” he said, causing Tynee’s ridiculous pretensions to evaporate as fast as the cryogenic helium from the golf cart, and leaving him with an expression more timorous than that of an ochlophobic who suddenly and inexplicably fmds himself naked and on third base at the World Series opener with a hundred thousand drunken sports fans pointing at him and guffawing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
