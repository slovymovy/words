                                        "entry_id": "16755daa-2fbc-3aa9-817e-14d34306bb1a",
                                        "glosses": [
                                            "In a faithful manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e3b3a6c-ab6e-4c87-a636-fdfb4e545a2a",
                                                "sense_id": "db456efd-a8bf-3480-98b6-2756e841ab0a",
                                                "text": "The CD reproduces music faithfully."
                                            },
                                            {
                                                "example_id": "d4ccf032-3f19-4457-9b10-7939687b683f",
                                                "sense_id": "db456efd-a8bf-3480-98b6-2756e841ab0a",
                                                "text": "I have been faithfully married for the past twenty years."
                                            },
                                            {
                                                "example_id": "584177cc-8410-4fbf-a49f-396f52e6d449",
                                                "sense_id": "db456efd-a8bf-3480-98b6-2756e841ab0a",
                                                "text": "You'll see your problems multiplied / if you continually decide / to faithfully pursue / the policy of truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6daa195a-91e0-3e3b-8f30-a52f15ad26ed",
