                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6542c61e-0796-3de4-91f2-3b34703ba05e",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "The act of appointing a person to hold an office or to have a position of trust"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f600ad-5fd4-4b61-8703-6c3ac9d9429f",
                                                "sense_id": "6542c61e-0796-3de4-91f2-3b34703ba05e",
                                                "text": "His appointment as treasurer was deemed suitable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234080d2-0f6b-3f02-a3c8-554dcf127b5c",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "The state of being appointed to a service or office; an office to which one is appointed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fbcdd28-8aaa-47f3-a798-34e6df6e3c8e",
                                                "sense_id": "234080d2-0f6b-3f02-a3c8-554dcf127b5c",
                                                "text": "the appointment of treasurer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df67aa6-5193-32dc-a005-5c31e3006745",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "Stipulation; agreement; the act of fixing by mutual agreement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75fffd76-737b-3f25-8c27-bb08796b2839",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "An arrangement between people to meet; an engagement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "947bfe06-de57-4a2a-8fd3-e4df2fb304e8",
                                                "sense_id": "75fffd76-737b-3f25-8c27-bb08796b2839",
                                                "text": "They made an appointment to meet at six."
                                            },
                                            {
                                                "example_id": "cf3ce2a0-6d96-4c68-b764-e9b9bc549e64",
                                                "sense_id": "75fffd76-737b-3f25-8c27-bb08796b2839",
                                                "text": "I’m leaving work early because I have a doctor’s appointment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edfb5c1a-abb7-320c-9ee3-c1291563f5e3",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "Decree; direction; established order or constitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c7718d-fe99-425c-bb97-884665f29937",
                                                "sense_id": "edfb5c1a-abb7-320c-9ee3-c1291563f5e3",
                                                "text": "to submit to the divine appointments"
                                            },
                                            {
                                                "example_id": "b1d58f47-1951-4025-831b-bc922362b012",
                                                "sense_id": "edfb5c1a-abb7-320c-9ee3-c1291563f5e3",
                                                "text": "According to the appointment of the priests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f232f085-f4fb-3742-bbef-1eba72c391c5",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "The exercise of the power of designating (under a power of appointment) a person to enjoy an estate or other specific property; also, the instrument by which the designation is made."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81b8e27a-9b44-31d9-ae90-a31df818eb70",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "The assignment of a person by an official to perform a duty, such as a presidential appointment of a judge to a court."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "662dc30e-7390-3aed-908a-30c9445c49de",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "Equipment, furniture."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db2ff48f-d2dd-4bf4-93ab-d4831d1ff1f4",
                                                "sense_id": "662dc30e-7390-3aed-908a-30c9445c49de",
                                                "text": "[…] the house had been inhabited for years by his father, and in many of its appointments was old-fashioned and grim […]"
                                            },
                                            {
                                                "example_id": "9f12e518-47c1-4f81-a2bc-aab7a0704c21",
                                                "sense_id": "662dc30e-7390-3aed-908a-30c9445c49de",
                                                "text": "The appointments were primitive, but the Schnitzel, the beer, and the cheese could not have been improved on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56e784a-0494-3d8f-9358-e7de8da72fb1",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "An honorary part or exercise, as an oration, etc., at a public exhibition of a college."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e20bd7-ca44-4468-85a2-0f22b4e9dfd5",
                                                "sense_id": "d56e784a-0494-3d8f-9358-e7de8da72fb1",
                                                "text": "to have an appointment"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c48149c3-f405-3555-9275-b16296b9db31",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "The allowance paid to a public officer."
                                        ],
