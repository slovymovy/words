                "senses": [
                    {
                        "sense_id": "188992bf-f76c-34c9-8669-390277257354",
                        "entry_id": "6106f921-70c6-39b6-910e-ea6a113221de",
                        "glosses": [
                            "Rendre moins glamour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ecbd650-f127-43d0-a300-7d104031745b",
                                "sense_id": "188992bf-f76c-34c9-8669-390277257354",
                                "text": "Siodmak cherche à « déglamouriser » cette radieuse et insipide poupée californienne, à la métamorphoser en « fleur du mal »."
                            },
                            {
                                "example_id": "e54fdf22-295b-4c54-9075-da8136d52397",
                                "sense_id": "188992bf-f76c-34c9-8669-390277257354",
                                "text": "Pour présenter la guerre aussi proche que possible, nous avons dû “déglamouriser” la technologie actuelle."
                            },
                            {
                                "example_id": "959d15cf-57ba-4281-b653-9a793226537d",
                                "sense_id": "188992bf-f76c-34c9-8669-390277257354",
                                "text": "Ça déglamourise le truc, tu comprends ?"
                            }
                        ]
                    }
                ],
