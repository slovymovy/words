                ],
                "senses": [
                    {
                        "sense_id": "d8c686c9-4ebf-363b-8019-decc00e3cb3f",
                        "entry_id": "ae61ec83-e362-3896-8a24-7e95250c8a3f",
                        "glosses": [
                            "Luftmassen, die sich in eine bestimmte/unbestimmte Richtung bewegen/strömen"
                        ],
                        "tags": [
                            "Wetter"
                        ],
                        "examples": [
                            {
                                "example_id": "e327576a-51f7-425a-917f-de999aac4cad",
                                "sense_id": "d8c686c9-4ebf-363b-8019-decc00e3cb3f",
                                "text": "Der DWD melde weltweit, jederzeit an Hafenämter: die Großwetterlage, den Luftdruck, die Luftrichtung, die Temperatur, Windstärke, Sturmwarnung, Orkanwarnung usw."
                            },
                            {
                                "example_id": "acef4d1a-be60-4268-a299-340eb6c41a36",
                                "sense_id": "d8c686c9-4ebf-363b-8019-decc00e3cb3f",
                                "text": "„Nur der großen Anstrengung der Eingesessenen und der lobenswerten Hilfe der nachbargemeinden Bromskirchen und Braunshausen, die rasch mit den Feuerspritzen herbei geeilt waren, der ziemlich günstiger Luftrichtung und vor allem dem Umstand, daß durch den am vorhergehenden Abend gefallenen harten Gewitterregen die Strohbedachung der in großem Maße nahe gelegenen Häuser durchnässt war, ist es beizumessen, daß das Unglück nicht erhebliche und das nicht ein großer Teil der Stadt ein Raub der Flammen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9454e74-ae5b-32c7-984e-ebc9897e0306",
                        "entry_id": "ae61ec83-e362-3896-8a24-7e95250c8a3f",
                        "glosses": [
                            "Richtung, in die sich Luft bewegen soll, strömt; oder aufgrund von Druck- und/oder Temperaturänderung strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b23163b-6e21-49f5-9f94-e28a8420f1c8",
                                "sense_id": "e9454e74-ae5b-32c7-984e-ebc9897e0306",
                                "text": "Im Brandfall wird die Luftrichtung im Tunnel oder der Tiefgarage von Rauchgasventilatoren bestimmt, um den Rauch gezielt abzuführen und Leben zu retten"
                            },
                            {
                                "example_id": "843a6e7d-5299-419d-8795-1024a985adba",
                                "sense_id": "e9454e74-ae5b-32c7-984e-ebc9897e0306",
                                "text": "„Je nachdem, an welchem Ort innerhalb der Garage der Brand detektiert wird, kann die für den Normalbetrieb vorgesehene Luftrichtung umgekehrt werden, so daß Zuluftschächte zu Abluftschächten werden können, falls diese näher am Brandherd gelegen sind.“"
                            },
                            {
                                "example_id": "a1982342-b4f6-4e16-bbb9-84284b7531c2",
                                "sense_id": "e9454e74-ae5b-32c7-984e-ebc9897e0306",
                                "text": "„Der Ventilator für die geräteinterne Luftrichtung von oben nach unten ist strömungstechnisch günstig im enthaltenen Untergestell positioniert.“"
                            },
                            {
                                "example_id": "cfdd9319-fcc6-448c-b666-61f9df1f297b",
                                "sense_id": "e9454e74-ae5b-32c7-984e-ebc9897e0306",
                                "text": "„Dabei kommt es oft zu einer unerwünschten Luftrichtung: Zur Küche ins Erdgeschoss hinein, zum offenen Schlafzimmerfenster im Dachgeschoss hinaus - nicht gerade ideal.“"
                            },
                            {
                                "example_id": "0f06bef1-08c1-4260-8d58-97b9c5f0a845",
                                "sense_id": "e9454e74-ae5b-32c7-984e-ebc9897e0306",
                                "text": "„Die Luftrichtung kann auf der Baustelle frei gewählt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
