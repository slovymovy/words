                    {
                        "sense_id": "1a415a48-49e8-38cb-a92c-23798e936b05",
                        "entry_id": "7e3e3979-8ee7-3a22-a5da-eca1f47247ac",
                        "glosses": [
                            "Féminin singulier de inconnu."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "778ee683-9459-448d-a17a-76b4502ca134",
                                "sense_id": "1a415a48-49e8-38cb-a92c-23798e936b05",
                                "text": "Cela signifie qu’une grande partie de la littérature kabbalistique nous est encore inconnue."
                            },
                            {
                                "example_id": "8ecae5e9-335f-4cd7-bf36-7f042138117f",
                                "sense_id": "1a415a48-49e8-38cb-a92c-23798e936b05",
                                "text": "On veut s’arrêter et puis on devine la beauté silencieuse d’une piazzetta inconnue qu’un chat traverse furtivement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3fbd72cb-a33d-338f-8487-d48f3afff05f",
