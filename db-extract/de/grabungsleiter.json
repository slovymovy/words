                "senses": [
                    {
                        "sense_id": "26817fec-de37-3e83-8926-2338caea914d",
                        "entry_id": "1bc0b8f8-eeaf-3900-8eec-bbe0980f66c9",
                        "glosses": [
                            "Person, welche die Aufsicht bei Grabungsarbeiten innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "003bff7f-fc4e-4a0e-a908-e5a75edec527",
                                "sense_id": "26817fec-de37-3e83-8926-2338caea914d",
                                "text": "„Für die Universität Wien war er langjähriger Grabungsleiter in der keltischen Siedlung Schwarzenbach in Niederösterreich und für die LMU München Vizegrabungsleiter im Sudan.“"
                            },
                            {
                                "example_id": "251b64ac-6f51-4991-863a-1403c3fb16b8",
                                "sense_id": "26817fec-de37-3e83-8926-2338caea914d",
                                "text": "„Der archäologische Grabungsleiter Uli Schlitzer berichtete beim Ortstermin, dass zunächst die typischen sogenannten Riegelbruchfragmente aus der römischen Kaiserzeit entdeckt worden waren.“"
                            },
                            {
                                "example_id": "601a3a51-bd14-4c26-802b-f14146530801",
                                "sense_id": "26817fec-de37-3e83-8926-2338caea914d",
                                "text": "„Doch Cusanits Roman endet vor der vielversprechenden Begegnung - und auch bevor sich zeigen kann, ob sich der Grabungsleiter mit seiner kühnen Selbstmedikamentierung gerettet oder nicht vielmehr in ernste gesundheitliche Schwierigkeiten gebracht hat.“"
                            },
                            {
                                "example_id": "b608fdb7-ac90-4d9f-bc34-264a71bfa56a",
                                "sense_id": "26817fec-de37-3e83-8926-2338caea914d",
                                "text": "„Um den Alltag kümmert sich Christoph Röder, der örtliche Grabungsleiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
