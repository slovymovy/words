                                    {
                                        "sense_id": "57ef4bab-6274-376a-a59b-7422910b1253",
                                        "entry_id": "f0eda6d5-bc25-3b9e-97b2-f13dbd4608df",
                                        "glosses": [
                                            "An ancient pentapolis in south-western Levant, comprising Ashkelon, Ashdod, Ekron, Gath, and Gaza."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5e082a-8116-405a-b146-5311c8670911",
                                                "sense_id": "57ef4bab-6274-376a-a59b-7422910b1253",
                                                "text": "The Babylonian Chronicles recount Nebuchadnezzar's conquest of Philistia between 604–601 B.C.E."
                                            },
                                            {
                                                "example_id": "ebdd44ed-2c17-4e90-a561-f48386e77fc5",
                                                "sense_id": "57ef4bab-6274-376a-a59b-7422910b1253",
                                                "text": "With Assyria in full control of the Levantine littoral, Philistia, which was vital to Assyrian political and commercial aspirations, was treated leniently and was awarded “favored nation” status."
                                            },
                                            {
                                                "example_id": "91cb86c1-d69b-41b4-880f-4438648d55f3",
                                                "sense_id": "57ef4bab-6274-376a-a59b-7422910b1253",
                                                "text": "All of Assyria's dealings with Egypt were obliged to pass through Philistia; geographic expediency also seems to have resulted in most of Assyria's interactions with Judah progressing via Philistia."
                                            }
                                        ]
                                    }
                                ]
                            }
