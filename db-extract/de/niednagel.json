                                    {
                                        "sense_id": "3bebc96f-1e14-38c1-8989-0251df2cb759",
                                        "entry_id": "9cb19171-a92a-3e42-b562-b650d1f51186",
                                        "glosses": [
                                            "A loose, narrow strip of nail tissue protruding from the side edge and anchored near the base of a fingernail or toenail."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f026677-1339-33c3-84f9-f6c4fcf35931",
                                        "entry_id": "9cb19171-a92a-3e42-b562-b650d1f51186",
                                        "glosses": [
                                            "A pointed upper corner of the toenail (often created by improperly trimming by rounding the corner) that, as the nail grows, presses into the flesh or protrudes so that it may catch (“hang”) on stockings or shoes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ac8a75c-f6bf-4625-9504-2b9061d08681",
                        "source_entry_id": "b77a3eb7-d3a1-3d39-83f5-69e9d56ebcd9",
                        "source_sense_id": "1f19a280-5075-3c63-b8d8-c05e251ad595",
                        "target_lang_word": "petite peau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb373912-5990-42f6-a11b-c9d9745cace0",
                        "source_entry_id": "b77a3eb7-d3a1-3d39-83f5-69e9d56ebcd9",
                        "source_sense_id": "1f19a280-5075-3c63-b8d8-c05e251ad595",
                        "target_lang_word": "envie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6286022-2bec-3183-80b1-ea72416b54ba",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "Chagrin ou haine que l’on ressent du bonheur, des succès, des avantages d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "119c00b6-3502-498e-9faf-be79c25b631f",
                                                "sense_id": "e6286022-2bec-3183-80b1-ea72416b54ba",
                                                "text": "Sa nomination lui attire l’envie de bien des gens."
                                            },
                                            {
                                                "example_id": "eed68402-65c1-4d2c-8c21-cb955cb5cbbb",
                                                "sense_id": "e6286022-2bec-3183-80b1-ea72416b54ba",
                                                "text": "On fait souvent vanité des passions même les plus criminelles ; mais l’envie est une passion timide et honteuse que l’on n’ose jamais avouer."
                                            },
                                            {
                                                "example_id": "9f70cba4-61d7-4347-9306-043dff2b94b9",
                                                "sense_id": "e6286022-2bec-3183-80b1-ea72416b54ba",
                                                "text": "L’envie est plus irréconciliable que la haine."
                                            },
                                            {
                                                "example_id": "8776cdf9-73a9-46aa-8e58-4ee9d061b8fd",
                                                "sense_id": "e6286022-2bec-3183-80b1-ea72416b54ba",
                                                "text": "Notre esprit d’envie, de méfiance et de dissensions nous empêchera, longtemps encore je le crains, de nous mettre d’accord ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8933740-bd7e-3b35-a7c1-1f5985758db4",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "Sentiment de vouloir jouir d’un avantage pareil à celui d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "901c998b-fd7b-4fcb-8100-7a64b6d36b31",
                                                "sense_id": "d8933740-bd7e-3b35-a7c1-1f5985758db4",
                                                "text": "Votre sort, votre bonheur est digne d’envie."
                                            },
                                            {
                                                "example_id": "cdc6e7e0-ade4-4356-921e-e7bb08f53a24",
                                                "sense_id": "d8933740-bd7e-3b35-a7c1-1f5985758db4",
                                                "text": "Non, si les ouvriers haïssaient la bourgeoisie, c’est qu’ils étaient conscients de sa supériorité. Le communisme, le socialisme ne s’expliquaient que par l’envie : « Et l’envie, disait mon père, est un vilain sentiment. »"
                                            },
                                            {
                                                "example_id": "6264f8f0-fc61-48fb-86dd-aa546c2354d1",
                                                "sense_id": "d8933740-bd7e-3b35-a7c1-1f5985758db4",
                                                "text": "Ce pauvre, tout ce qu'il a, tout ce qui lui reste, c'est l'envie – et surtout pas le désir. Le désir renvoie à la joie de l'existence …, il est l'augmentation de la puissance d'exister, alors que l'envie est la négation de ce qui existe maintenant, négation qui relève de la fuite perpétuelle dans un devenir-soi-autre qui n'aboutit jamais. « Il a envie, c'est tout ce qu'il a. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "Désir, volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b90dafa-fd64-439a-8a1f-113e2ca34402",
                                                "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                                "text": "Rien n’empêche tant d’être naturel que l’envie de le paraître."
                                            },
                                            {
                                                "example_id": "eb2adbd7-31ae-4ba5-9d44-562429bef10b",
                                                "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                                "text": "Des envies folles lui venaient de rosser Blanchette à coups de trique ; mais cela ne changerait rien à la situation, et, furibond il sacrait comme un païen pour se soulager un peu."
                                            },
                                            {
                                                "example_id": "27f6b95e-8510-4574-beb8-717613c2588d",
                                                "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                                "text": "Céline Thiébault était alors une jeune fille « bienfaisante », une de ces grandes filles brunes qui paraissent vingt ans au lieu de quinze, de celles qu’à la campagne on compare volontiers à une pouliche et que les hommes, vieux et jeunes, détaillent avec une basse envie, un violent désir."
                                            },
                                            {
                                                "example_id": "a35cd60b-45b8-4d56-90f7-4bf16e04a4c7",
                                                "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                                "text": "Avoir envie, une extrême envie de dire, de savoir, d’apprendre, etc."
                                            },
                                            {
                                                "example_id": "a13ac022-21ed-4427-9457-e79d525c6085",
                                                "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                                "text": "Je n’ai nulle envie de vous nuire."
                                            },
                                            {
                                                "example_id": "92cfbdf1-0787-403d-aa7b-bdd78faa5f39",
                                                "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                                "text": "Si l’envie lui en prend. L’envie lui a pris d’aller à Rome."
                                            },
                                            {
                                                "example_id": "552d7230-3a79-4c22-a186-5f9aa230eb94",
                                                "sense_id": "6a2638d1-dccb-3fd1-bc7e-5a23c0d9252e",
                                                "text": "– Tu t’installeras dans la chambre. Je sais que tu n’y seras pas à l’aise, mon pauvre Raymond. Mais tu travailles bien partout, quand l’envie t’en tient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91aed56-72c5-3d2a-b65c-aa2abc10867d",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "L’odieux d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74a002a-e35c-440e-a615-b7ab9eb1da3c",
                                                "sense_id": "c91aed56-72c5-3d2a-b65c-aa2abc10867d",
                                                "text": "De Mesmes n’avait rien oublié pour jeter sur moi toute l’envie de la collusion avec les ennemis de l’État."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36bbe9a4-2311-3bc3-90ab-3ae170b90a76",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "Besoin corporel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd30048a-234b-4b1a-961e-8c7761678d5d",
                                                "sense_id": "36bbe9a4-2311-3bc3-90ab-3ae170b90a76",
                                                "text": "Néologisme anglo-saxon, l’urgenturie désigne une envie impérieuse et brusque d’uriner difficilement contrôlable et aboutissant le plus souvent à une perte d’urine."
                                            },
                                            {
                                                "example_id": "b18792d6-12a8-4d37-81a0-d64f043b87a7",
                                                "sense_id": "36bbe9a4-2311-3bc3-90ab-3ae170b90a76",
                                                "text": "Bon sang, j'ai une de ces envies de pisser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25664c5d-f476-3e48-a005-54e92e098ba0",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "Petites portions de peau qui se détachent autour des ongles, et causent une assez vive douleur si on les arrache."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8f21460-4d92-4c5d-8934-6578a674c7f4",
                                                "sense_id": "25664c5d-f476-3e48-a005-54e92e098ba0",
                                                "text": "Les petites peaux autour des ongles sont appelés des « envies ». Il s’agit de petits fragments de peau, adhérents à la peau sous-jacente et souvent douloureux ou sensibles. Ils ne donnent qu’une envie (d’où leur nom) : les arracher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90cfa4a-17e2-3404-a502-0812dbda0ac5",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "Désir, notamment d’ordre alimentaire, exprimé par la femme enceinte pendant sa grossesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc8d2e0-2db5-4e07-90ea-a0651f7e85dd",
                                                "sense_id": "d90cfa4a-17e2-3404-a502-0812dbda0ac5",
                                                "text": "Potard.– Pendant sa grossesse, ma femme a eu des envies ruineuses… elle ne voulait manger que du melon et des fraises…\nNorine.– Moi, j’avalais des boîtes de sardines.\nPotard.– J’aurais préféré des sardines, parce que les melons et les fraises… au mois de janvier… ça coûte cher !… mais j’avais peur que le petit n’en fût marqué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79750ae2-41ec-3b41-9308-39ad8e9d6a72",
                                        "entry_id": "6226e96d-3cfe-32eb-a848-9352040e2cd2",
                                        "glosses": [
                                            "Tache de naissance sur la peau qu’on pensait ressembler aux objets dont la mère aurait eu envie pendant sa grossesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46030a08-2305-4c9b-9aa3-ccd20a63b6d5",
                                                "sense_id": "79750ae2-41ec-3b41-9308-39ad8e9d6a72",
                                                "text": "Les envies sont comme des nuées : on y voit ce que l’on veut."
                                            }
                                        ]
                                    }
