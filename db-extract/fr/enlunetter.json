                        "glosses": [
                            "Doter de lunettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad280eac-6c9e-403f-af32-d31fb770ac0a",
                                "sense_id": "602e84c0-9f59-3406-a48f-c62d3b62b2a8",
                                "text": "Ils occultent ce triste don de la « double vue » qui les enlunette, ils oublient les apparentes faiblesses de leur regard."
                            },
                            {
                                "example_id": "229a7257-110d-4b4a-b16d-790b676debab",
                                "sense_id": "602e84c0-9f59-3406-a48f-c62d3b62b2a8",
                                "text": "Il lui prête des livres, les lui commente, et elle lit tellement qu’elle est obligée de « s’enlunetter »."
                            }
                        ]
                    }
