                    {
                        "translation_id": "cba82a82-19e2-46ce-802f-8f83e721dee3",
                        "source_entry_id": "4e608da0-7a21-31b7-bb70-14ed2ab7a2a4",
                        "source_sense_id": "3014833a-a6ba-33db-b9da-0879704b06ac",
                        "target_lang_word": "atoll",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atoll",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c6e8b92-8f4a-37ef-b825-eb2739d6035c",
                                        "entry_id": "5c471de4-0813-39c6-958a-874be0d11d4f",
                                        "glosses": [
                                            "Type de récif corallien annulaire, généralement issu de l’enfoncement progressif d’une île volcanique, entourant un lagon central et affleurant à la surface de la mer."
                                        ],
                                        "tags": [
                                            "Biologie marine",
                                            "Biogéographie marine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98d095b2-42b8-48f5-b0ee-99a8da9969c3",
                                                "sense_id": "0c6e8b92-8f4a-37ef-b825-eb2739d6035c",
                                                "text": "En longeant l’atoll, j’étais rempli d’admiration et d’étonnement pour l’extraordinaire travail des madrépores."
                                            },
                                            {
                                                "example_id": "bc2b2b3d-4cc0-4069-ad15-9f87b11b5aaa",
                                                "sense_id": "0c6e8b92-8f4a-37ef-b825-eb2739d6035c",
                                                "text": "Enfin les îles sorties des eaux (atolls) portent une flore extrêmement pauvre, venue par des apports lointains."
                                            },
                                            {
                                                "example_id": "7634da96-d5d8-46a9-8d67-09c2a9a8ce0a",
                                                "sense_id": "0c6e8b92-8f4a-37ef-b825-eb2739d6035c",
                                                "text": "Chacun semble persuadé qu’un tel endroit existe, qu’il y a quelque part sur la mer une île, un atoll, un roc, un cap, où soudain tout pourra arriver, où tout se déchirera, tout s’éclairera, qu’il suffira d’une aurore un peu particulière."
                                            },
                                            {
                                                "example_id": "42401a3c-2194-42b4-99c1-18e8bb8b5888",
                                                "sense_id": "0c6e8b92-8f4a-37ef-b825-eb2739d6035c",
                                                "text": "Depuis le pont de la goélette, l'on pouvait voir des plongeurs à l'œuvre, au-delà de la mince bande de terre que formait l'atoll."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
