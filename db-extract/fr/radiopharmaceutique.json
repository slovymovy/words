                        "glosses": [
                            "Qui se rapporte à la radiopharmacie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51edc64-d914-4fee-b545-dbc9316083c8",
                                "sense_id": "ad3625ad-b1cc-3ebc-bc1e-955f87210507",
                                "text": "Cette technique irradiante utilise un agent radiopharmaceutique administré par voie intraveineuse."
                            },
                            {
                                "example_id": "a5f063a0-512b-403b-8f84-0fe1d42fda14",
                                "sense_id": "ad3625ad-b1cc-3ebc-bc1e-955f87210507",
                                "text": "L’information clinique apportée par cette technique est donnée par la distribution du produit de contraste radiopharmaceutique à travers le corps, la radioactivité permettant de le détecter par des moyens non invasifs en utilisant une gamma caméra pour donner à la fois une représentation anatomique par image et des mesures quantitatives."
                            }
                        ]
                    }
