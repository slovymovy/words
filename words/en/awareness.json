{
    "word_family": [
        "aware",
        "unaware",
        "unawareness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "477e1a21-aefb-312a-b8ab-ad4a0db85719",
                    "sense_definition": "The state or quality of being aware of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The campaign aims to raise <w>awareness</w> of healthy eating habits.",
                            "target_lang_translations": {
                                "ru": "Кампания направлена на повышение <w>осведомлённости</w> о привычках здорового питания.",
                                "zh": "这项活动旨在提高人们对健康饮食习惯的<w>意识</w>。"
                            }
                        },
                        {
                            "text": "There is a growing <w>awareness</w> of environmental issues in our society.",
                            "target_lang_translations": {
                                "ru": "В нашем обществе растёт <w>осознание</w> экологических проблем.",
                                "zh": "我们社会对环境问题的<w>关注</w>正在日益增长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knowledge",
                        "consciousness",
                        "perception"
                    ],
                    "antonyms": [
                        "unawareness",
                        "obliviousness"
                    ],
                    "common_phrases": [
                        "raise awareness",
                        "public awareness",
                        "growing awareness",
                        "lack of awareness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние обладания знанием или информацией о чём-либо; понимание важности чего-либо.",
                        "zh": "对某事物的了解、认识或关注程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осведомлённость",
                                "target_lang_sense_clarification": "наличие сведений или знаний о чём-либо"
                            },
                            {
                                "target_lang_word": "осознание",
                                "target_lang_sense_clarification": "глубокое понимание или признание факта"
                            },
                            {
                                "target_lang_word": "информированность",
                                "target_lang_sense_clarification": "наличие информации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意识",
                                "target_lang_sense_clarification": "对事物存在或重要性的认识"
                            },
                            {
                                "target_lang_word": "知晓",
                                "target_lang_sense_clarification": "对某事有所了解或察觉"
                            },
                            {
                                "target_lang_word": "关注",
                                "target_lang_sense_clarification": "对某议题的重视程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ae4c047-ed42-3669-b9c0-a47d228d0a5a",
                    "sense_definition": "The state or level of consciousness where sense data can be confirmed by an observer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I gradually passed from sleep to full <w>awareness</w> as the sun rose.",
                            "target_lang_translations": {
                                "ru": "С восходом солнца я постепенно перешёл от сна к полному <w>сознанию</w>.",
                                "zh": "随着太阳升起，我逐渐从睡梦中恢复了完全的<w>意识</w>。"
                            }
                        },
                        {
                            "text": "The patient showed no signs of <w>awareness</w> immediately after the accident.",
                            "target_lang_translations": {
                                "ru": "Сразу после аварии пациент не подавал признаков <w>сознания</w>.",
                                "zh": "事故发生后，病人立即表现出没有任何<w>知觉</w>的迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consciousness",
                        "wakefulness"
                    ],
                    "antonyms": [
                        "unconsciousness"
                    ],
                    "common_phrases": [
                        "full awareness",
                        "conscious awareness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором человек находится в сознании и способен воспринимать окружающую действительность.",
                        "zh": "人处于清醒状态，能够感知周围环境并进行思考的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сознание",
                                "target_lang_sense_clarification": "способность мыслить и воспринимать окружающее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意识",
                                "target_lang_sense_clarification": "清醒状态下的感知能力"
                            },
                            {
                                "target_lang_word": "知觉",
                                "target_lang_sense_clarification": "对外界刺激的感知和反应"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}