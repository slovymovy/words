                "senses": [
                    {
                        "sense_id": "db5cb640-3e54-33d9-b1a7-69d87b70b5bb",
                        "entry_id": "260419e7-1ba6-3913-a0a3-f984c40bd001",
                        "glosses": [
                            "qualitative Bezeichnung von reinen Geschmackseigenschaften im eigentlichen Sinn; Geschmacksempfindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fbb7a8c-1d5c-4718-b0e3-bdaf20542ffd",
                                "sense_id": "db5cb640-3e54-33d9-b1a7-69d87b70b5bb",
                                "text": "„Kommt es zu einer die 27°C übersteigenden Erwärmung, so spricht der \"Ölmühler\" von \"cocido\", was wörtlich übersetzt \"gekocht\" bedeutet und als negatives Geschmacksattribut bei der Verkostung von Olivenöl gilt.“"
                            },
                            {
                                "example_id": "abd228d2-1f40-4a7f-872d-9e37df2740a6",
                                "sense_id": "db5cb640-3e54-33d9-b1a7-69d87b70b5bb",
                                "text": "„Als Inhaltsstoff mit niedrigem Geruchs- und Geschmacksschwellenwert, Literaturangaben zufolge sind in Bier Gehalte zwischen 0,05 und 0,25 mg/l wahrnehmbar, wird Diacetyl in Rotweinen bis zum Gehalt von 4 mg/l mit Geschmacksattributen wie „frische Butter“ oder „sahnig, cremig“ als vorteilhaft angesehen.“"
                            },
                            {
                                "example_id": "ee74c5ac-6ef4-4749-9c44-b0618813d438",
                                "sense_id": "db5cb640-3e54-33d9-b1a7-69d87b70b5bb",
                                "text": "„Die große Vielfalt der positiven Geschmacksattribute reicht von fruchtig über grün, scharf, bitter bis schwarze Johannisbeere.“"
                            },
                            {
                                "example_id": "c1f9931d-47ec-4d3d-97c7-9d1bfbfbf7cd",
                                "sense_id": "db5cb640-3e54-33d9-b1a7-69d87b70b5bb",
                                "text": "„Was \"weiter\" ist, bestimme die \"Hipness\", das unabdingbare Geschmacksattribut der achtziger Jahre.“"
                            },
                            {
                                "example_id": "691bd9b8-0073-47cc-b0f1-0cd131f6fe5e",
                                "sense_id": "db5cb640-3e54-33d9-b1a7-69d87b70b5bb",
                                "text": "„Hier werden mehr als 100 hochwertige Olivenöle angeboten, über deren Geschmacksattribute eine Ölampel informiert; ein Novum bei Perfetto.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
