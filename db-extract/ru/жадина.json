                        ]
                    },
                    {
                        "translation_id": "09bdcc1b-f8bc-41b2-89b2-e2a3a45ffc23",
                        "source_entry_id": "8183e39e-0eac-3929-8d36-6e3ec798b9d1",
                        "source_sense_id": "e13589f6-3c2f-30b8-9bbb-a863d7875d40",
                        "target_lang_word": "skinflint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skinflint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "275dfc06-26ae-33b0-b70a-5dfd7d4a31c6",
                                        "entry_id": "434af2b8-3cb5-3177-910b-87ff1676e5b7",
                                        "glosses": [
                                            "One who is excessively stingy or cautious with money; a tightwad; a miser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6639ad56-a163-4679-8d21-88dda687621a",
                                                "sense_id": "275dfc06-26ae-33b0-b70a-5dfd7d4a31c6",
                                                "text": "You know, he is quite a different sort from the Public Prosecutor and our other provincial skinflints--fellows who shiver in their shoes before they will spend a single kopeck."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb0da414-a0c2-4bb7-aed1-bffe2caea5bf",
                        "source_entry_id": "8183e39e-0eac-3929-8d36-6e3ec798b9d1",
                        "source_sense_id": "e13589f6-3c2f-30b8-9bbb-a863d7875d40",
                        "target_lang_word": "pingre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pingre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                        "entry_id": "d19dc18b-649d-3345-960b-96b55b2ad3bd",
                                        "glosses": [
                                            "Avare."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da495a56-957d-4d18-834b-ba3e847009c6",
                                                "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                                "text": "La pingrerie, c'est une économie de la dépense qui dépasse les bornes, et le pingre est du genre à réclamer endéans le mois, à domicile, le remboursement d'une demi-obole."
                                            },
                                            {
                                                "example_id": "3bccf96a-ac73-4899-88ea-2c111265d788",
                                                "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                                "text": "Il devait me les payer. Mais, comme par hasard, cet abominable pingre, doublé d'un combineur sans vergogne, n'avait jamais le sou sur lui, […]."
                                            },
                                            {
                                                "example_id": "fb911d8c-0ec1-475c-8825-ec13f29c5548",
                                                "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                                "text": "Un collègue pourrait être un abominable pingre, doublé d'un radin, s’il venait travailler en étant conscient qu’il risquerait d’infecter tout le monde juste par peur de ne pas être payé , […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1785e74a-2cce-3c87-92ad-9a3ac7043005",
                                        "entry_id": "d19dc18b-649d-3345-960b-96b55b2ad3bd",
                                        "glosses": [
                                            "Personne méchante, effrontée et vêtue chichement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1368263f-a442-32bd-b5bc-5bbd5843d089",
                                        "entry_id": "d19dc18b-649d-3345-960b-96b55b2ad3bd",
                                        "glosses": [
                                            "Navire de commerce à fond plat du XVIIIᵉ siècle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e7f4d93-3a1d-4e4f-a5dd-93b07a2b724a",
                                                "sense_id": "1368263f-a442-32bd-b5bc-5bbd5843d089",
                                                "text": "… se trouvant attaquée par un pingre anglais, alors qu'elle revenait de Bourbon avec un plein chargement de café le 27 mars 1747, …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pingre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc080fa-d2bd-3906-a2f2-d9e89fad9ee3",
                                        "entry_id": "6ac5a018-bbd9-32a5-890c-53ab05d45cfc",
                                        "glosses": [
                                            "Avare."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a0ea0be-1fe9-4079-968b-1d5aeb7f1625",
                                                "sense_id": "4cc080fa-d2bd-3906-a2f2-d9e89fad9ee3",
                                                "text": "Je crois surtout que l'Europe montre une fois de plus son insuffisance et que lorsqu'il faut mettre la main à la poche, elle est pingre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5b8b925-12e4-40b1-8140-037499ae1346",
                        "source_entry_id": "8183e39e-0eac-3929-8d36-6e3ec798b9d1",
                        "source_sense_id": "e13589f6-3c2f-30b8-9bbb-a863d7875d40",
                        "target_lang_word": "rapiat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapiat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f3845bb-a993-374b-b1b8-a3ef06c3b1f2",
                                        "entry_id": "910fc046-ddb3-32bf-a1e1-1bf9b4b3b4ce",
                                        "glosses": [
                                            "Radin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfdbb9c6-dc1b-486c-b4ea-3d3697196681",
                                                "sense_id": "7f3845bb-a993-374b-b1b8-a3ef06c3b1f2",
                                                "text": "– Vieux rapiat ! – s’écria Bert, au moment où le secrétaire refermait la porte en s’en allant. – Quel sale vieux rapiat !"
                                            },
                                            {
                                                "example_id": "25c3fe7a-4a5d-4397-a3c3-22b862927dec",
                                                "sense_id": "7f3845bb-a993-374b-b1b8-a3ef06c3b1f2",
                                                "text": "Ça n’est pas comme sa rapiat de sœur, riposte Mme Sicagne. Elle est toujours vêtue comme un pauvresse !"
                                            },
                                            {
                                                "example_id": "2da72c8a-0605-40ce-9eb9-e85f16caa1c3",
                                                "sense_id": "7f3845bb-a993-374b-b1b8-a3ef06c3b1f2",
                                                "text": "Que voulez-vous qu'on pense d'un rapiat qui ne s'est même pas arrêté vingt minutes, le temps d'avaler une soupe, chez moi, au Lion d'Or, le soir de son arrivée ? Ça se nourrit, pour sûr, d'un oignon et d'un céleri, et ça dort sur des sacs d'écus. Ladres, fesse-mathieu, pas davantage !…"
                                            },
                                            {
                                                "example_id": "f56cb9a5-66fb-4972-abba-a9d3ad708ff9",
                                                "sense_id": "7f3845bb-a993-374b-b1b8-a3ef06c3b1f2",
                                                "text": "Ce riflard, c'est un rapiat de première."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rapiat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebee73e6-1c88-3726-8670-676a40fc845b",
                                        "entry_id": "ec9236d6-8c5f-3bfe-a346-20eaf73918b2",
                                        "glosses": [
                                            "Radin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce85a08c-8d36-46ee-a22a-9bc6d869fce2",
                                                "sense_id": "ebee73e6-1c88-3726-8670-676a40fc845b",
                                                "text": "Rapace et rapiat quand les salariés réclament une augmentation, le patronat n’hésite pas à banquer pour soutenir les revendications dominicales de certains."
                                            },
                                            {
                                                "example_id": "600d3346-4383-42f9-846d-9d29eb22df6f",
                                                "sense_id": "ebee73e6-1c88-3726-8670-676a40fc845b",
                                                "text": "Elle est tellement rapiate !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
