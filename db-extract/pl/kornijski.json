                                        "sense_id": "fc349d71-990e-3da2-8c4c-76ab661942fa",
                                        "entry_id": "365b8366-ecf9-3790-bf14-29a8eba684ad",
                                        "glosses": [
                                            "keltische Sprache, die in Cornwall gesprochen wurde/wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d132ed37-2da9-4dcc-b89d-5912a7d318a8",
                                                "sense_id": "fc349d71-990e-3da2-8c4c-76ab661942fa",
                                                "text": "Sprechen Sie Kornisch?"
                                            },
                                            {
                                                "example_id": "edd790cb-0c0b-4c4a-955f-6840e495f357",
                                                "sense_id": "fc349d71-990e-3da2-8c4c-76ab661942fa",
                                                "text": "Das Kornische ist 1777 ausgestorben, wurde aber im 20. Jahrhundert wiederbelebt."
                                            },
                                            {
                                                "example_id": "f977386f-5276-4106-8394-a0fd3cd9954d",
                                                "sense_id": "fc349d71-990e-3da2-8c4c-76ab661942fa",
                                                "text": "„Bei den inselkeltischen Sprachen wiederum unterscheidet man die goidelische Sprachgruppe mit den Sprachen Irisch, Gälisch und Manx und die britannische Sprachgruppe mit den Sprachen Kymrisch, Kumbrisch, Kornisch und Bretonisch.“"
                                            },
                                            {
                                                "example_id": "96c780ab-2701-47ba-bcdf-dade6f09bbe6",
                                                "sense_id": "fc349d71-990e-3da2-8c4c-76ab661942fa",
                                                "text": "„Im heutigen Cornwall und Devon entwickelte sich die Sprache zum Kornischen, in Wales zum Walisischen und in Cumbria und Teilen Schottlands zum Kumbrischen.“"
                                            },
                                            {
                                                "example_id": "60ee13fc-f7e1-4eed-9fa7-f86fc5ef929b",
                                                "sense_id": "fc349d71-990e-3da2-8c4c-76ab661942fa",
                                                "text": "„Das Kornische in Cornwall ist seit der Reformation nur gelegentlich geschrieben worden und im 18. Jahrhundert ausgestorben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
