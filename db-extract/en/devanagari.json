                                "target_senses": [
                                    {
                                        "sense_id": "82044acc-e317-3eca-afa2-f0e64bdfaa8b",
                                        "entry_id": "bb322053-8004-33d9-beb7-edec0dac9c6e",
                                        "glosses": [
                                            "indisches Schriftsystem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac81653-ec4f-459a-a34a-2e0a7cee11c2",
                                                "sense_id": "82044acc-e317-3eca-afa2-f0e64bdfaa8b",
                                                "text": "„Aus der Brahmischrift entwickelt sich die Devanagari, mit der sowohl das Sanskrit, die heilige Sprache des Großteils Indiens, wie auch das Hindi, eine der verbreitetsten Umgangssprachen, festgehalten werden.“"
                                            },
                                            {
                                                "example_id": "1d1e5d8c-954e-4a47-bff4-48197bcc05b6",
                                                "sense_id": "82044acc-e317-3eca-afa2-f0e64bdfaa8b",
                                                "text": "„Der Text auf der Briefmarke von 1877 ist in der indischen Devanagari gedruckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
