                ],
                "senses": [
                    {
                        "sense_id": "1f94865c-648d-3a26-840b-f31c03cb11a0",
                        "entry_id": "2cc10d28-719d-3b1e-841d-1b61543615ef",
                        "glosses": [
                            "übertriebene Anbetung heiliger Bücher, zum Beispiel der Bibel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62526bf8-8add-4f53-8d5c-bc390326e223",
                                "sense_id": "1f94865c-648d-3a26-840b-f31c03cb11a0",
                                "text": "„Die enge Beziehung zwischen beiden erfuhr durch die Reformation eine Vertiefung und Erweiterung; das protestantische Schriftprinzip führte zu dem, was Lessing als Bibliolatrie kritisiert hat.“"
                            },
                            {
                                "example_id": "6bb1b1ef-8a9f-42d7-bec5-39c74a43980c",
                                "sense_id": "1f94865c-648d-3a26-840b-f31c03cb11a0",
                                "text": "„Lessing führt in seiner Vorrede zu einem Entwurf einer Abhandlung über Bibliolatrie aus, die wesentliche Phase seines Lebens habe in einer Zeit gelegen, wo Schriften über das Christentum populär, ja geradezu Mode gewesen seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d40aa34e-9e64-330b-9d53-0699c9467ab7",
                        "entry_id": "2cc10d28-719d-3b1e-841d-1b61543615ef",
                        "glosses": [
                            "eine Form des Glaubens, die sich starr an das geschriebene Wort hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb1fab17-b413-4343-9dd2-fe1c371b5a8c",
                                "sense_id": "d40aa34e-9e64-330b-9d53-0699c9467ab7",
                                "text": "„Reimarus und Lessing wenden sich gegen die orthodoxe Buchstabenhörigkeit (Bibliolatrie, Lehre der Verbalinspiration) und unterscheiden zwischen den Buchstaben und der Bibel auf der einen Seite und dem Geist bzw. der Religion auf der anderen Seite. Nach Lessing können notwendige Vernunftwahrheiten nicht von zufälligen Geschichtswahrheiten abhängig gemacht werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "832f6280-41b3-477a-9fd4-b95ad5b1c2ff",
                        "source_entry_id": "2cc10d28-719d-3b1e-841d-1b61543615ef",
                        "source_sense_id": "1f94865c-648d-3a26-840b-f31c03cb11a0",
                        "source_sense_description": "übertriebene Anbetung heiliger Bücher, zum Beispiel der Bibel",
                        "target_lang_word": "bibliolatry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliolatry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98883f68-ba1b-3592-88c9-865e8877ca3d",
                                        "entry_id": "42cac813-90a7-3c1a-ba98-defaeb010bf4",
                                        "glosses": [
                                            "Excessive admiration for a book."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5d8e926-7bd9-3bc8-90e4-e37078f32f75",
                                        "entry_id": "42cac813-90a7-3c1a-ba98-defaeb010bf4",
                                        "glosses": [
                                            "Specifically, excessive reverence for, or worship of, the Bible or Qur'an, especially as taken literally."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16cd4641-84d9-4ed5-9306-2fff741e8d99",
                                                "sense_id": "b5d8e926-7bd9-3bc8-90e4-e37078f32f75",
                                                "text": "the danger of bibliolatry is only too apparent in the contemptuous references often made by Christian authorities to the uselessness of pagan literature since access to the Bible had been secured by the Church."
                                            },
                                            {
                                                "example_id": "b76829eb-84e1-4aa7-a536-a8f81456a48f",
                                                "sense_id": "b5d8e926-7bd9-3bc8-90e4-e37078f32f75",
                                                "text": "Bibliolatry led to a phobia about swearing; rejection of the Bible made it possible again, and with it a release of the repressions which gave the Puritan middle class their moral energy."
                                            },
                                            {
                                                "example_id": "d9cc0545-bf3a-4ffc-b222-80e7c903cfdd",
                                                "sense_id": "b5d8e926-7bd9-3bc8-90e4-e37078f32f75",
                                                "text": "The exponents of bibliolatry rely on the letter and make the spirit dependent on the letter"
                                            },
                                            {
                                                "example_id": "cce93519-241c-4494-a9cc-0c565bc3c259",
                                                "sense_id": "b5d8e926-7bd9-3bc8-90e4-e37078f32f75",
                                                "text": "they are also committing \"bibliolatry\" by putting the Bible where God alone belongs"
                                            },
                                            {
                                                "example_id": "7d562a90-6bc0-44f0-9aee-9947c939c0fe",
                                                "sense_id": "b5d8e926-7bd9-3bc8-90e4-e37078f32f75",
                                                "text": "\"bibliolatry\" (the fundamentalist insistence on the literal truth of \"the Bible as the Word of God\")"
                                            },
                                            {
                                                "example_id": "eda01858-af58-463a-8c8f-b23d28149af7",
                                                "sense_id": "b5d8e926-7bd9-3bc8-90e4-e37078f32f75",
                                                "text": "Some sectors of the religious world have been accused […] of \"bibliolatry,\" that is, valuing their Bible itself so highly that they are almost guilty of idolatry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
