    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cac9bef4-2c86-3cb1-a176-767bc15e242e",
                    "sense_definition": "Elaborately decorated with complex patterns or details.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace featured an <w>ornate</w> ceiling covered in gold leaf and intricate carvings.",
                            "target_lang_translations": {
                                "nl": "Het paleis had een <w>sierlijk</w> plafond bedekt met bladgoud en ingewikkeld houtsnijwerk."
                            }
                        },
                        {
                            "text": "She wore an <w>ornate</w> necklace that caught everyone's attention at the gala.",
                            "target_lang_translations": {
                                "nl": "Ze droeg een <w>sierlijke</w> ketting die op het gala ieders aandacht trok."
                            }
                        }
                    ],
                    "synonyms": [
                        "fancy",
                        "elaborate"
                    ],
                    "common_phrases": [
                        "ornate design",
                        "ornate frame",
                        "ornate carving"
                    ],
                    "target_lang_definitions": {
                        "nl": "Uitgebreid versierd met complexe patronen of details."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "sierlijk",
                                "target_lang_sense_clarification": "Met veel verfijnde decoratieve details."
                            },
                            {
                                "target_lang_word": "gedecoreerd",
                                "target_lang_sense_clarification": "Voorzien van versieringen."
                            }
                        ]
                    },
                    "antonyms": [
                        "plain"
                    ]
                },
                {
                    "sense_id": "728cc14b-4502-3b94-8c31-63a395e5e9ca",
                    "sense_definition": "Characterized by excessive or showy decoration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His writing style is often too <w>ornate</w> for a simple news report.",
                            "target_lang_translations": {
                                "nl": "Zijn schrijfstijl is vaak te <w>overladen</w> voor een simpel nieuwsbericht."
                            }
                        },
                        {
                            "text": "The room felt cluttered due to the <w>ornate</w> furniture and heavy curtains.",
                            "target_lang_translations": {
                                "nl": "De kamer voelde rommelig aan door de <w>overladen</w> meubels en zware gordijnen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekenmerkt door overmatige of opzichtige versiering."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overladen",
                                "target_lang_sense_clarification": "Te vol of te druk versierd."
                            },
                            {
                                "target_lang_word": "barok",
                                "target_lang_sense_clarification": "Grillig, overdadig of overdreven versierd."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d046e303-a650-3123-9ca3-d50768c6328e",
                    "sense_definition": "Refined and elegant in style, particularly regarding language or composition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet used <w>ornate</w> language to describe the beauty of the sunset.",
                            "target_lang_translations": {
                                "nl": "De dichter gebruikte <w>bloemrijk</w> taalgebruik om de schoonheid van de zonsondergang te beschrijven."
                            }
                        },
                        {
                            "text": "Her speech was highly <w>ornate</w> and impressed the academic audience.",
                            "target_lang_translations": {
                                "nl": "Haar toespraak was zeer <w>bloemrijk</w> en maakte indruk op het academische publiek."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ornate prose",
                        "ornate rhetoric"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verfijnd en elegant in stijl, met name wat betreft taalgebruik of compositie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bloemrijk",
                                "target_lang_sense_clarification": "Beeldend, kleurrijk en rijk aan stijlfiguren."
                            },
                            {
                                "target_lang_word": "verheven",
                                "target_lang_sense_clarification": "In een plechtige of verfijnde stijl."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9381bf96-dc64-3dd5-a213-d4b551282d66",
                    "sense_definition": "To decorate or add beauty to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist sought to <w>ornate</w> the walls with vibrant murals.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar probeerde de muren te <w>versieren</w> met levendige muurschilderingen."
                            }
                        },
                        {
                            "text": "They decided to <w>ornate</w> the hall for the upcoming celebration.",
                            "target_lang_translations": {
                                "nl": "Ze besloten de zaal te <w>versieren</w> voor het aanstaande feest."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets versieren of verfraaien."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "versieren",
                                "target_lang_sense_clarification": "Iets mooier maken door decoratie toe te voegen."
                            },
                            {
                                "target_lang_word": "verfraaien",
                                "target_lang_sense_clarification": "Het uiterlijk van iets verbeteren."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}