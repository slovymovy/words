                                    {
                                        "sense_id": "b1f91d42-1645-3817-951f-069b06033f68",
                                        "entry_id": "47818bc9-2634-36bf-b71e-523f761683dc",
                                        "glosses": [
                                            "Having no outstanding conditions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36641f23-e049-4109-90d9-9a44d4d56b28",
                                                "sense_id": "b1f91d42-1645-3817-951f-069b06033f68",
                                                "text": "I made an outright purchase of the house."
                                            },
                                            {
                                                "example_id": "e3fc6fb4-1850-41d7-90d6-475de3b2dcfe",
                                                "sense_id": "b1f91d42-1645-3817-951f-069b06033f68",
                                                "text": "They don't seek outright independence, but rather greater autonomy."
                                            }
                                        ]
