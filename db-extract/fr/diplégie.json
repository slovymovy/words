                "senses": [
                    {
                        "sense_id": "e7d4a2f9-6b3c-3064-af95-c69646e99732",
                        "entry_id": "3bd83b02-0a6b-355d-9cb1-d0f71525af78",
                        "glosses": [
                            "Paralysie bilatérale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e08a51e-f504-4dc5-8e6c-41017c826e8b",
                                "sense_id": "e7d4a2f9-6b3c-3064-af95-c69646e99732",
                                "text": "La diplégie faciale, atteinte bilatérale du nerf facial, qui innerve les muscles du visage."
                            },
                            {
                                "example_id": "cfc7dfc7-bcf6-4f4a-98a0-2d14b3fef0d2",
                                "sense_id": "e7d4a2f9-6b3c-3064-af95-c69646e99732",
                                "text": "La diplégie cérébrale infantile, ou syndrome de Little, double hémiplégie se traduisant par une paraplégie spasmodique séquellaire."
                            },
                            {
                                "example_id": "2446de21-18f7-48d3-b36f-0c1cacb192b8",
                                "sense_id": "e7d4a2f9-6b3c-3064-af95-c69646e99732",
                                "text": "D’autre part, ainsi que nous le verrons ultérieurement à propos de la paralysie faciale, nombreux commencent à être les faits bien démontrés de diplégie faciale et aussi de surdité double par fracture du rocher."
                            }
                        ]
                    }
                ],
