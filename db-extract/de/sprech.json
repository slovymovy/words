                    {
                        "sense_id": "f1f61f48-8214-35b7-a25f-b0e8b888a320",
                        "entry_id": "d19cb9e3-50cf-3e28-95c9-97051e8081a3",
                        "glosses": [
                            "Jargon einer bestimmten sozialen Gruppe"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4ab6427c-15ab-418b-bcad-48ea4d152c1a",
                                "sense_id": "f1f61f48-8214-35b7-a25f-b0e8b888a320",
                                "text": "„Im Sprech der Behavioral Finance wird dieses Phänomen auch als ‚all-time-high bias‘ bezeichnet.“"
                            },
                            {
                                "example_id": "7dd95695-c2f7-4ea8-9190-68611e3bf614",
                                "sense_id": "f1f61f48-8214-35b7-a25f-b0e8b888a320",
                                "text": "„Im Sprech der Bundesagentur summieren sich die sogenannten Überzahlungen 2009 auf 72 Millionen Euro.“"
                            },
                            {
                                "example_id": "e3e7e39a-f143-4bcc-a7d1-4031f7d25cb6",
                                "sense_id": "f1f61f48-8214-35b7-a25f-b0e8b888a320",
                                "text": "„Was sich außer dem Sprech […] noch ändert, sind die Waden: Ich bekomme Sportlerwaden.“"
                            },
                            {
                                "example_id": "93019495-b2fd-4444-b233-3abd714e6cf4",
                                "sense_id": "f1f61f48-8214-35b7-a25f-b0e8b888a320",
                                "text": "„Erfolgreich – das ist so der übliche Sprech.“"
                            },
                            {
                                "example_id": "6b7a2dc0-35a4-4904-a7cd-8aebbadff4b3",
                                "sense_id": "f1f61f48-8214-35b7-a25f-b0e8b888a320",
                                "text": "„Jedenfalls ist es genauso uneigentlicher Sprech wie doppelzüngige Diplomatie oder irreführende Propaganda oder gezielte Desinformation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
