                        ]
                    },
                    {
                        "translation_id": "d77e534a-09dc-4640-9920-d4b661db856b",
                        "source_entry_id": "88e9169f-4e9b-356d-821b-3d2ccc1144fd",
                        "target_lang_word": "extravagance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravagance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c4a0228-c674-3870-8707-afc6b84048b1",
                                        "entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
                                        "glosses": [
                                            "Action extravagante, discours extravagant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c2a59e-6f1c-4fe0-8bb3-21b700cc00f4",
                                                "sense_id": "8c4a0228-c674-3870-8707-afc6b84048b1",
                                                "text": "Ces écarts d’imagination ne paraissent pas invraisemblables, quand on est témoin des folies, des extravagances que ces belles Liméniennes font faire aux étrangers."
                                            },
                                            {
                                                "example_id": "eb50d9bb-9323-479a-b851-5eaad6099720",
                                                "sense_id": "8c4a0228-c674-3870-8707-afc6b84048b1",
                                                "text": "Puis, nous conférons. Impossible, nous en tombons tout de suite d’accord, de souscrire à l’extravagance dont on veut nous faire prendre la responsabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                        "entry_id": "e939b978-da3d-3c3a-8cf1-4eb990be8ea6",
                                        "glosses": [
                                            "Bizarrerie, incohérence, folie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e158674-1bbd-4746-a3a6-46e014be6ebc",
                                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                                "text": "Un petit chat entra, circonspect et naïf, un ordinaire et irrésistible chaton de quatre à cinq mois. Il se jouait à lui-même une comédie majestueuse, mesurait son pas et portait la queue en cierge, à l’imitation des seigneurs matous. Mais un saut périlleux en avant, que rien n’annonçait, le jeta séant par-dessus tête à nos pieds, où il prit peur de sa propre extravagance, se roula en turban, se mit debout sur ses pattes de derrière, dansa de biais, enfla le dos, se changea en toupie…"
                                            },
                                            {
                                                "example_id": "7ffeca50-786f-4456-8dae-393094ca3d7c",
                                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                                "text": "Nous avons déjà parlé de la mode excentrique des souliers de cette époque ; les pointes de ceux que portait Maurice de Bracy auraient pu concourir pour le prix de l’extravagance avec les plus bizarres, car elles étaient tournées et entortillées comme les cornes d’un bélier."
                                            },
                                            {
                                                "example_id": "a35ec3da-7095-4090-b879-95278bdcad95",
                                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                                "text": "À Jules Verne, trop pondéré, je préférais les extravagances de Paul d’Ivoi."
                                            },
                                            {
                                                "example_id": "43e7bff4-58ae-411a-87b3-54995d981146",
                                                "sense_id": "b721c9ae-6f2c-3381-889d-a5e326c9312e",
                                                "text": "Ils étaient arrivés à ce degré d’intimité où faire l’amour commence à ressembler à une extravagance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d46a366-22f4-4022-9a5a-b5b4413d42b9",
                        "source_entry_id": "88e9169f-4e9b-356d-821b-3d2ccc1144fd",
                        "target_lang_word": "folie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "172a5f66-f7b3-3bb5-bf39-2105329b5d91",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Dérangement de l’esprit, accès de folie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11966aa7-6da0-42cd-be84-21f6b5a252f7",
                                                "sense_id": "172a5f66-f7b3-3bb5-bf39-2105329b5d91",
                                                "text": "C’est une chose admirable que tous les grands hommes ont toujours quelque petit grain de folie mêlé à leur science."
                                            },
                                            {
                                                "example_id": "bad7206d-07d5-48de-9fb6-0fb7cfeb5dcc",
                                                "sense_id": "172a5f66-f7b3-3bb5-bf39-2105329b5d91",
                                                "text": "Qu'est-ce que la folie ? c’est d’avoir des pensées incohérentes et la conduite de même."
                                            },
                                            {
                                                "example_id": "5d5df8d5-42d6-4f82-9115-1f689974ad19",
                                                "sense_id": "172a5f66-f7b3-3bb5-bf39-2105329b5d91",
                                                "text": "S’il est réellement en proie à cette crise encore inobservée dans tous ses modes et que nous appelons folie, je suis tenté d’en attribuer la cause à sa passion. Ses études, son genre de vie avaient porté ses forces et ses facultés à un degré de puissance au delà duquel la plus légère surexcitation devait faire céder la nature ; l’amour les aura donc brisées ou élevées à une nouvelle expression que peut-être calomnions-nous en la qualifiant sans la connaître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fda35e87-3408-3ba9-822f-a83eb5c002f7",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Lésion plus ou moins complète et ordinairement de longue durée des facultés intellectuelles et affectives, sans trouble notable dans les sensations et les mouvements volontaires, et sans désordre grave ou même apparent des fonctions nutritives et génératrices."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b121461-4ccd-3356-905e-f5c438ac8140",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Absence de raison, extravagance, manque de jugement."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "836771e5-0973-4b9e-aef4-ec9aef76a9f2",
                                                "sense_id": "0b121461-4ccd-3356-905e-f5c438ac8140",
                                                "text": "Ces écarts d’imagination ne paraissent pas invraisemblables, quand on est témoin des folies, des extravagances que ces belles Liméniennes font faire aux étrangers."
                                            },
                                            {
                                                "example_id": "ab5994ed-7008-48bd-9934-7d5798b59974",
                                                "sense_id": "0b121461-4ccd-3356-905e-f5c438ac8140",
                                                "text": "Chacun veut en sagesse ériger sa folie,\nEt, se laissant régler à son esprit tortu,\nDe ses propres défauts se fait une vertu."
                                            },
                                            {
                                                "example_id": "aeaf0dfe-05cd-4813-8ece-cfb2fc91e58f",
                                                "sense_id": "0b121461-4ccd-3356-905e-f5c438ac8140",
                                                "text": "Comme le disait Albert Einstein : « La folie, c’est de faire toujours la même chose et de s’attendre à un résultat différent. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b04638e3-4793-3c62-80ea-d905c5f56502",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Action folle, idée folle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec493767-084e-4c36-933b-1ae45a60071b",
                                                "sense_id": "b04638e3-4793-3c62-80ea-d905c5f56502",
                                                "text": "Qui fait une folie, il doit la faire entière."
                                            },
                                            {
                                                "example_id": "e3822c48-1e02-46a2-b4d3-34049aec5b56",
                                                "sense_id": "b04638e3-4793-3c62-80ea-d905c5f56502",
                                                "text": "Oui, il nous a voulu faire accroire qu’il était dans la maison et que nous étions dehors ; et c’est une folie qu’il n'y a pas moyen de lui ôter de la tête."
                                            },
                                            {
                                                "example_id": "2153c102-80cd-4164-bf4c-28d03ba39bf8",
                                                "sense_id": "b04638e3-4793-3c62-80ea-d905c5f56502",
                                                "text": "Faire une folie et se marier par amourette, c’est épouser Mélite, qui est jeune, belle, sage, économe, qui plaît, qui vous aime, qui a moins de bien qu’Aegine qu’on vous propose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ec9f38-e171-3af5-8feb-d947fa4daba1",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Gaieté vive dans laquelle on fait ou dit des choses propres à divertir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416d15cb-229b-49c2-9f70-da961b1e6d22",
                                                "sense_id": "86ec9f38-e171-3af5-8feb-d947fa4daba1",
                                                "text": "Une aimable folie."
                                            },
                                            {
                                                "example_id": "9a5bd9d1-0d3e-4a2d-aa51-ea91e45bbfc0",
                                                "sense_id": "86ec9f38-e171-3af5-8feb-d947fa4daba1",
                                                "text": "Céliante : Elle est folle à l’excès.\nLisette : On plaît par la folie."
                                            },
                                            {
                                                "example_id": "ba7d1ccd-8d7b-4956-8075-cbd87f83df4c",
                                                "sense_id": "86ec9f38-e171-3af5-8feb-d947fa4daba1",
                                                "text": "Mon pinceau, trempé dans la lie, Sur tous les murs aurait écrit : Entrez, enfants de la folie ; Plus on est de fous, plus on rit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6112e33e-c6f9-3e86-864f-897f4f3604ec",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "La Folie, personnage fictif qu’on représente sous la figure d’une femme joyeuse avec une marotte et des grelots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5bb5ae-7026-46ab-8ad3-07dfcceae7cd",
                                                "sense_id": "6112e33e-c6f9-3e86-864f-897f4f3604ec",
                                                "text": "Le résultat de la suprême cour Fut de condamner la Folie [qui d’un coup avait rendu aveugle l’Amour] à servir de guide à l’Amour."
                                            },
                                            {
                                                "example_id": "4813d382-4324-43ec-ad3f-a579f74240f1",
                                                "sense_id": "6112e33e-c6f9-3e86-864f-897f4f3604ec",
                                                "text": "J’entends au loin l’archet de la Folie ; Ô mes amis, prolongez d’heureux jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da586b62-8bad-333e-9357-dd6fd6fdcf14",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Joyeusetés en paroles ou en actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ecfef3a-684e-4b49-94b1-fc4aa824d4c6",
                                                "sense_id": "da586b62-8bad-333e-9357-dd6fd6fdcf14",
                                                "text": "Elle me dit mille folies sur les plaisirs que vous avez."
                                            },
                                            {
                                                "example_id": "5a0fbd16-9867-493b-9845-eacf2cb2c490",
                                                "sense_id": "da586b62-8bad-333e-9357-dd6fd6fdcf14",
                                                "text": "Vous me donnez envie de vous conter des folies, tant vous entrez bien dans celles que je vous mande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce522029-a860-3345-963a-ebfc34582597",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Caricature, charge plaisante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff20cfa-a1ef-4da0-905e-001143e6e7a0",
                                                "sense_id": "ce522029-a860-3345-963a-ebfc34582597",
                                                "text": "On a fait une assez plaisante folie de la Hollande : c’est une comtesse âgée d’environ cent ans, elle est bien malade, elle a autour d’elle quatre médecins, ce sont les rois d’Angleterre, d’Espagne, de France et de Suède."
                                            },
                                            {
                                                "example_id": "1076710d-42b3-41ac-99d1-10e4a46a5730",
                                                "sense_id": "ce522029-a860-3345-963a-ebfc34582597",
                                                "text": "Les jeunes gens et les femmes lisent cette folie avec avidité ; les éditions de tous les livres dans ce goût se multiplient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "503cefea-881a-3949-baf9-1e561cf5054c",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Goût exclusif, passionné, idée en laquelle on se complaît."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f2b5b7-23da-4142-aacd-d9a6ee6ee2a2",
                                                "sense_id": "503cefea-881a-3949-baf9-1e561cf5054c",
                                                "text": "Il y eut cependant une époque, au commencement de la dynastie des Tcheou (XIᵉ siècle av. J.-C.), où l’architecture chinoise eut pour les palais de ses empereurs de plus hautes visées. On construisit alors des monuments, appelés taï ou hou, qui mesuraient jusqu’à cent mètres d’élévation; on accédait au sommet par un escalier extérieur. Pendant plusieurs siècles, ce fut le grand luxe, la ruineuse folie des Fils du Ciel."
                                            },
                                            {
                                                "example_id": "68207891-0b7d-4208-9a9e-872559891e70",
                                                "sense_id": "503cefea-881a-3949-baf9-1e561cf5054c",
                                                "text": "D'où vient la folie que j'ai pour ces sottises-là ?"
                                            },
                                            {
                                                "example_id": "db82d236-d2e6-409e-acec-5f8f83a79db0",
                                                "sense_id": "503cefea-881a-3949-baf9-1e561cf5054c",
                                                "text": "J'ai ma folie, hélas ! aussi bien que mon père."
                                            },
                                            {
                                                "example_id": "45d056b5-a18a-4c72-95a1-43b85a73b93b",
                                                "sense_id": "503cefea-881a-3949-baf9-1e561cf5054c",
                                                "text": "C'était la folie des Égyptiens de se perdre dans une antiquité dont aucun autre peuple n'approchât."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "becbf0de-eb34-3fc2-b73e-861a66a5b5f5",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "Accointance charnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84680ae-a846-4de7-8b03-5247050bf182",
                                                "sense_id": "becbf0de-eb34-3fc2-b73e-861a66a5b5f5",
                                                "text": "Avec quelqu'un as-tu fait la folie ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741d18e6-7653-300a-9842-e33f93924407",
                                        "entry_id": "ba9175af-b1ef-39eb-83c9-8bf84639b88b",
                                        "glosses": [
                                            "En chaleur, en parlant des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2da6c9e5-ba3a-43c0-8405-398a28a91611",
                                                "sense_id": "741d18e6-7653-300a-9842-e33f93924407",
                                                "text": "Cette chienne est en folie."
                                            },
                                            {
                                                "example_id": "82936619-a4fe-4efd-a21e-2f30f9482e5a",
                                                "sense_id": "741d18e6-7653-300a-9842-e33f93924407",
                                                "text": "Péronnelle est en folie tous les mois, et le matou n’abonde pas dans la contrée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "folie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a092e56-3731-3338-bc36-92109501360b",
                                        "entry_id": "f3eb22c2-4e43-3bdb-8bbb-e56fb8dba72f",
                                        "glosses": [
                                            "Maison de plaisance construite en dehors mais proche des métropoles, à partir des XVIIᵉ et XVIIIᵉ siècles et jusqu'au XIXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb186d7-f53c-4254-8444-6919ed8deb93",
                                                "sense_id": "3a092e56-3731-3338-bc36-92109501360b",
                                                "text": "En 1661, il avait des vues sur sa belle-sœur, et il se peut qu’il ait pensé à cette « folie » pour abriter leurs amours…"
                                            },
                                            {
                                                "example_id": "15ff792a-04ab-4f5f-9dbc-fef80669b290",
                                                "sense_id": "3a092e56-3731-3338-bc36-92109501360b",
                                                "text": "Pour « animer l’espace public, avec décalage », la ville de Neuilly-sur-Seine (Hauts-de-Seine) prévoit d’installer 19 folies, des pavillons de 30 à 35 m², à l’architecture innovante, le long de l’avenue qui relie la porte Maillot à la Défense."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81a425d2-9b90-4d69-bfc6-0852735fc38e",
                        "source_entry_id": "88e9169f-4e9b-356d-821b-3d2ccc1144fd",
                        "target_lang_word": "excentricité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excentricité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Position d’un centre qui s’écarte d’un point donné."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbe302e1-19ea-47b7-842a-ba3c7bcb1f7d",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "La ceinture d’astéroïdes venait de se former. Orbitant d'abord sur des orbites très excentriques, une partie de ces astéroïdes réduisirent ensuite leurs excentricités, mais vu leur nombre et leur absence de tourbillons individuels, ils se dévièrent et se dévient encore souvent les uns les autres."
                                            },
                                            {
                                                "example_id": "99e898b4-8bce-483a-b8a6-7b5ca68e3be6",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "Alors que l’orbite de Mimas revient à la normale et que son excentricité se réduit, y aura-t-il assez d’énergie pour continuer la fonte de la glace ou bien, la source de chaleur s’épuisant, l’eau va-t-elle recristalliser ?"
                                            },
                                            {
                                                "example_id": "3f014bfa-0fce-435c-bc45-b335919f0249",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "Excentricité des couches ligneuses, disposition particulière des couches concentriques qui sont plus larges d’un côté que de l’autre."
                                            },
                                            {
                                                "example_id": "7915cf09-8beb-4c5f-b1d9-df5c644ac29f",
                                                "sense_id": "1dd0393e-18a1-313f-9f5d-78586aa73e98",
                                                "text": "Excentricité d’une bouche à feu, déviation que présente l’axe de l’âme et qui nuit à la justesse du tir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee807824-f54b-3b60-8970-a5171af88983",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Caractéristique des coniques, indiquant la forme de la courbe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e599459a-1ff7-3fe8-85ca-7eede34765c7",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Éloignement du centre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86c5981-72c0-4d3d-b51e-a8b424d7d676",
                                                "sense_id": "e599459a-1ff7-3fe8-85ca-7eede34765c7",
                                                "text": "L’excentricité d’un quartier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038c966e-8e82-3c8a-8d29-e1e9f73c9a25",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "État de celui, celle, ce qui est excentrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca55d1ae-44d5-425a-8bdf-35ba75282946",
                                                "sense_id": "038c966e-8e82-3c8a-8d29-e1e9f73c9a25",
                                                "text": "Les enfants mis en situation d’excentricité voudraient se rendre invisibles et se fondre dans la bienheureuse conformité ; être comme tout le monde est leur plus vif désir. C’était en tout cas le mien, pour mettre fin aux bizarreries de l’existence."
                                            },
                                            {
                                                "example_id": "29d61a74-f47a-4086-b83b-1d36f179cd13",
                                                "sense_id": "038c966e-8e82-3c8a-8d29-e1e9f73c9a25",
                                                "text": "Le public ne boudait pas son plaisir. Chaque nouvelle excentricité de Brunet était accueillie pas nombre égal de murmures réprobateurs et de sifflements d'approbation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfbd6102-b037-323e-b7cf-6ceea0816aa8",
                                        "entry_id": "5faee74c-b4ec-3477-a737-21d372e5e24a",
                                        "glosses": [
                                            "Agissement ou comportement de ceux qui sont excentriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1f98e0-bfc0-4eea-8b3a-2a8691978dfa",
                                                "sense_id": "bfbd6102-b037-323e-b7cf-6ceea0816aa8",
                                                "text": "La jalousie formait la base de ce caractère plein d’excentricités, mot trouvé par les Anglais pour les folies non pas des petites mais des grandes maisons."
                                            },
                                            {
                                                "example_id": "3b43a001-ab23-4e78-87d4-b7929fd529fa",
                                                "sense_id": "bfbd6102-b037-323e-b7cf-6ceea0816aa8",
                                                "text": "Ceux qui fayotent avec l’originalité et qui à force d'abuser de fausses excentricités, de se mentir à eux-mêmes dans le but de se distinguer, ne sont plus que des pantins. Oui, on en perd du temps à s'affranchir des tabous, des flux et reflux des modes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
