                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>grouse</w> time at the party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>классно</w> провели время на вечеринке вчера вечером.",
