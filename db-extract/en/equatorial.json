                    {
                        "translation_id": "27abe5a0-d9ef-4501-ade4-f1d678971ab0",
                        "source_entry_id": "b73b0a76-67f2-3ea2-b6ca-014cf0342d8a",
                        "source_sense_description": "of, near, or relating to the equator",
                        "target_lang_word": "équatorial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "équatorial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                        "entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
                                        "glosses": [
                                            "Qui appartient à l’équateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7aefff1-d99a-4831-ba88-16e72d8d478d",
                                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                                "text": "Avec les vents alizés et le courant équatorial d'une vitesse de dix à soixante-dix milles par jour, ç’aurait été pour moi la traversée la plus courte et la plus facile."
                                            },
                                            {
                                                "example_id": "7fa52080-0715-421f-860c-cb8670b31207",
                                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                                "text": "Une plus grande teneur de l’air en gaz carbonique permettrait d'ailleurs d'expliquer la luxuriance de la végétation sans faire intervenir un climat équatorial."
                                            },
                                            {
                                                "example_id": "bf4f834e-9d1c-4965-acfe-6888e1e73906",
                                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                                "text": "La ligne équatoriale, l’équateur."
                                            },
                                            {
                                                "example_id": "20dccd08-2fe2-4a4a-9419-e992b2b670e8",
                                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                                "text": "Le rayon équatorial est à la fois perpendiculaire à l'axe terrestre et à la tangente respective de l'équateur et du méridien coupant ce rayon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "075b5689-56e5-342c-861e-42a77cb916c9",
                                        "entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
                                        "glosses": [
                                            "Voisin de l’équateur céleste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e586da53-6625-4362-a547-197344a9bf61",
                                                "sense_id": "075b5689-56e5-342c-861e-42a77cb916c9",
                                                "text": "Étoiles, constellations équatoriales."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "équatorial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c03e4e79-6c80-39b3-a88c-b704027dcb56",
                                        "entry_id": "d537614d-eb0d-39d0-8ab1-5d2e333fa71d",
                                        "glosses": [
                                            "Instrument dont on se sert pour suivre le mouvement des astres, pour déterminer leur ascension droite et leur déclinaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832c6318-fdf3-4bc5-90ca-b621a4d623f7",
