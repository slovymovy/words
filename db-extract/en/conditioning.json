                "senses": [
                    {
                        "sense_id": "1f669d42-ba4a-3fff-816e-807e3bbef2a8",
                        "entry_id": "87fa3017-15eb-36be-882d-e5b09c41c973",
                        "glosses": [
                            "The process of modifying a person or animal's behaviour."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6f7d4ff8-547d-3d2a-af42-4d9e66a51057",
                        "entry_id": "87fa3017-15eb-36be-882d-e5b09c41c973",
                        "glosses": [
                            "Any preparation or training, especially athletic training of the body."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c27a875b-ac55-4a2e-a94f-9b4d99f0425c",
                                "sense_id": "6f7d4ff8-547d-3d2a-af42-4d9e66a51057",
                                "text": "England's superior conditioning began to show in the final quarter and as the game began to break up, their three-quarters began to stamp their authority on the game. And when Foden went on a mazy run from inside his own 22 and put Ashton in for a long-range try, any threat of an upset was when and truly snuffed out."
                            }
                        ]
                    },
                    {
                        "sense_id": "eadee3a3-f7b8-3e15-89bd-21c1314b6be7",
                        "entry_id": "87fa3017-15eb-36be-882d-e5b09c41c973",
                        "glosses": [
                            "The storage of a material specimen under specified temperature, humidity for a specified time prior to testing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
