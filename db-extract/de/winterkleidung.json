                    {
                        "sense_id": "409267f1-a7c3-3213-a736-10e2abab4bf2",
                        "entry_id": "04773409-2bdd-3e11-8cad-68ef80e9d687",
                        "glosses": [
                            "Gesamtheit der Bekleidungsstücke, die für den Winter geeignet sind, weil sie den Körper warm halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54116eb1-c52f-4cba-b4a6-34757a92cf7c",
                                "sense_id": "409267f1-a7c3-3213-a736-10e2abab4bf2",
                                "text": "Typische Winterkleidung sind Schal, Mütze und Handschuhe."
                            },
                            {
                                "example_id": "06ffbcba-4248-4c5a-82d2-be77ff2cbaa9",
                                "sense_id": "409267f1-a7c3-3213-a736-10e2abab4bf2",
                                "text": "„Er streifte ihn mir in einer einzigen langen Bewegung über, kommentierte nicht, dass ich so spät in der Saison noch Winterkleidung anschleppte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
