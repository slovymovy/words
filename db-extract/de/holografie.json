                ],
                "senses": [
                    {
                        "sense_id": "d256281e-80c2-3854-9d32-b2a8834d3fed",
                        "entry_id": "db6234f0-34de-3f20-8674-c67e27122c4b",
                        "glosses": [
                            "technische Methode, mit der dreidimensionale Bilder hergestellt, gespeichert und wiedergegeben werden können"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb60440-6295-468c-b6fd-7e6ead7d658d",
                                "sense_id": "d256281e-80c2-3854-9d32-b2a8834d3fed",
                                "text": "„Die Holografie ist demnach ein zweistufiges Verfahren zur Aufzeichnung und räumlichen Wiedergabe von Bildern beliebiger Gegenstände, das im Prinzip keine Linsen erfordert.“"
                            },
                            {
                                "example_id": "96668c56-b005-4bb7-b838-229ed0ecd20d",
                                "sense_id": "d256281e-80c2-3854-9d32-b2a8834d3fed",
                                "text": "„Erfunden wurde die Methode der Holografie im Jahre 1948 durch den ungarischen Physiker Dennis Gabor in London.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                        "entry_id": "db6234f0-34de-3f20-8674-c67e27122c4b",
                        "glosses": [
                            "durch [1] erzeugtes dreidimensionales Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d084d561-7df3-45c9-ac6c-cc5f97ae7461",
                                "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                                "text": "„In vier Minuten schildert Hans Rosling anhand einer Art Holografie, wie sich in den letzten 200 Jahren Lebenserwartung und Wohlstand der Weltbevölkerung verändert haben.“"
                            },
                            {
                                "example_id": "ca71b1d6-3c12-4553-a566-95bb9b4b5236",
                                "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                                "text": "„Um den Körper des gealterten Moraners strahlten die Holografien Tausender Sterne, großer Planeten.“"
                            },
                            {
                                "example_id": "47a315dd-e784-411e-b05e-3c0d001b6c62",
                                "sense_id": "fbd0e571-5c86-3bb4-bd7d-19f68b8d7a11",
                                "text": "„Im Inneren des Fahrzeugs gab es auch eine Möglichkeit, Holografien in erstklassiger Qualität darzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
