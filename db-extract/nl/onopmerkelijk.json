                "senses": [
                    {
                        "sense_id": "b6b8ff57-318c-391f-a0bf-3ddd0a34aaf9",
                        "entry_id": "649cead6-ae37-3703-b11a-6e90c59d4f68",
                        "glosses": [
                            "van geen enkel bijzonder belang; helemaal niet bijzonder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28970e74-d117-4727-9ed5-392a2fc9e687",
                                "sense_id": "b6b8ff57-318c-391f-a0bf-3ddd0a34aaf9",
                                "text": "Morley Cottage was weliswaar op zich onopmerkelijk, maar het huisje bood wel een adembenemend uitzicht op Lyme Bay en de reeks heuvels aan de oostkant langs de kust, onderbroken door de hoogste piek, Golden Cap, met op een heldere dag aan het eind het Isle of Portland dat landafwaarts op de loer lag als een krokodil, ondergedompeld op zijn lange platte kop na."
                            },
                            {
                                "example_id": "ece473dd-c022-447b-ade6-2bf2d6bc0099",
                                "sense_id": "b6b8ff57-318c-391f-a0bf-3ddd0a34aaf9",
                                "text": "Het is allemaal heel alledaags en onopmerkelijk, maar tegelijkertijd levensveranderend."
                            }
                        ]
                    }
