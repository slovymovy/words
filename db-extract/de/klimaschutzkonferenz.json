                "senses": [
                    {
                        "sense_id": "6b43749a-ef7e-3f2d-a1c2-7d7e95a29b87",
                        "entry_id": "f8e958d4-825e-370a-afef-0b2c67f62c9a",
                        "glosses": [
                            "Konferenz zum Schutze des Klimas (meist der Welt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02eb4fd7-4fc7-4a92-80aa-959bb124ac3d",
                                "sense_id": "6b43749a-ef7e-3f2d-a1c2-7d7e95a29b87",
                                "text": "„Schellnhuber kennt sie also gut, die bisherigen deutschen Umwelt- und Forschungsminister. Mit Angela Merkel war er inzwischen als Vorsitzender des Beirats in Kyoto bei der weltweiten Klimaschutzkonferenz. Schellnhuber fängt an zu schwärmen von Frau Merkel, eine kluge, beeindruckende Frau, sagt er, »sie ist wirklich ausgeschlafen.“"
                            },
                            {
                                "example_id": "80fae2f3-bc40-4ea8-b0c3-b49daffb5776",
                                "sense_id": "6b43749a-ef7e-3f2d-a1c2-7d7e95a29b87",
                                "text": "„Diese Vorgaben des Waxman-Markey-Gesetzes seien „enorm ehrgeizig“, sagte der Klimaschutzbeauftragte der US-Regierung, Todd Stern, am Dienstag zum Abschluss einer zweitägigen Klimaschutzkonferenz in Mexiko-Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
