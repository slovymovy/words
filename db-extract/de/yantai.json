                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6da4a1-baf9-486a-ab9d-1c1dd09c9da3",
                                "sense_id": "e8da0ab8-ee5a-3450-8a84-4f0edbf77ffd",
                                "text": "„Das Gestein des Bergwerks sei überwiegend Granit und wegen dieses sehr harten Materials kämen die Arbeiten nur langsam voran, hatte der Bürgermeister von Yantai, zu dem Qixia gehört, erläutert.“"
                            }
                        ],
