                                        "sense_id": "48e4510e-a05f-3332-9f2f-bc582cf4e524",
                                        "entry_id": "1cd3ae30-c4b9-3bca-89db-ca0c38ba306c",
                                        "glosses": [
                                            "het onvermogen om woorden, waarvan men wel de letters ziet, in hun betekenis te vatten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e78ae45-4a56-493c-9cfe-31c2cc109780",
                                                "sense_id": "48e4510e-a05f-3332-9f2f-bc582cf4e524",
                                                "text": "Dyslexie komt meer bij jongens voor dan bij meisjes."
                                            }
