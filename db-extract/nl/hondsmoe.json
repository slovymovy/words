                                                "sense_id": "c93077ca-8b0a-3732-baa3-93ddef598035",
                                                "text": "The exhausted mine was worthless once all the ore had been extracted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78cbf932-547f-3ea1-b4cb-57b657d68130",
                                        "entry_id": "3a02a35a-ceba-35d5-b72c-f1bfc97e116f",
                                        "glosses": [
                                            "Emptied of contents, especially of air; that has been made into a vacuum."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
