                        ],
                        "examples": [
                            {
                                "example_id": "a01565fc-68c8-4f19-be8c-c6fbd2809fd3",
                                "sense_id": "8af52b87-653b-3c1a-b763-2bc36b6bf8c9",
                                "text": "распуска́ть ню́ни",
                                "translation": "to snivel, to slobber, to whimper",
                                "english": "to snivel, to slobber, to whimper"
                            },
                            {
                                "example_id": "6b7e1ee7-0c1a-4857-9e7a-77b8e9175204",
                                "sense_id": "8af52b87-653b-3c1a-b763-2bc36b6bf8c9",
                                "text": "Како́й дрянно́й мальчи́шка мой Воло́дька! В кого́ он тако́й? — Не зна́ю. Я, ка́жется, была́ верна́ его́ роди́телю. Пла́кса, ню́ня.",
                                "translation": "Pyotr Boborykin",
                                "english": "Pyotr Boborykin"
                            }
                        ]
                    }
