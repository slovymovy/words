                            "comparative"
                        ],
                        "form": "more parenthetically"
                    },
                    {
                        "form_id": "cc92c33d-3b8d-49a4-b198-2ff3687c0aaa",
                        "entry_id": "312739fd-606a-368f-afb8-e181eb48c07b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most parenthetically"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0ecf032-51e6-38ca-93b4-08a8ac0b467e",
                        "entry_id": "312739fd-606a-368f-afb8-e181eb48c07b",
                        "glosses": [
                            "As an aside, incidentally."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "070ee81d-c22f-4903-be95-de97e13e9384",
                                "sense_id": "c0ecf032-51e6-38ca-93b4-08a8ac0b467e",
                                "text": "«Just as we passed that other lamp I was going to tell you a further thing, Sal, but now I am parenthetically continuing with a new thought and by the time we reach the next I’ll return to the original subject, agreed?»"
                            }
                        ]
                    },
                    {
                        "sense_id": "16d2aeba-1a15-3a5a-920b-656e78343dad",
                        "entry_id": "312739fd-606a-368f-afb8-e181eb48c07b",
                        "glosses": [
                            "Using parentheses."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06c58f6b-82ca-4c6d-ac08-021a7620d05b",
                        "source_entry_id": "312739fd-606a-368f-afb8-e181eb48c07b",
                        "source_sense_description": "incidentally",
                        "target_lang_word": "entre parenthèses",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entre parenthèses",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96711902-72b5-362e-82fb-efb4d355047a",
                                        "entry_id": "57b0120e-9eb4-3896-b553-bfcf198ef467",
                                        "glosses": [
                                            "En passant, même si ce qu’on dit ainsi n’est pas en rapport direct avec le sujet ou est sans grande importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aaafa4c-31aa-4008-898f-4f8e4673c360",
                                                "sense_id": "96711902-72b5-362e-82fb-efb4d355047a",
                                                "text": "Entre parenthèses on assure que j’ai lâché ignominieusement ma femme pour aller vivre aux crochets d’une roulure."
                                            },
                                            {
                                                "example_id": "395ac1c3-4395-44bb-bec7-0c6ad658e58f",
                                                "sense_id": "96711902-72b5-362e-82fb-efb4d355047a",
                                                "text": "A signaler, entre parenthèses, une grosse grenouille en terre cuite revêtue d’un engobe blanc, symbole de « notre mère la terre »."
                                            },
                                            {
                                                "example_id": "ffcbe861-a3dd-43b4-976c-e068d2e8060c",
                                                "sense_id": "96711902-72b5-362e-82fb-efb4d355047a",
                                                "text": "C’est ainsi, soit dit entre parenthèses, que pour ne rien trahir lui-même, le narrateur a tendu à l’objectivité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42cc7fdd-0f08-3388-b158-25f9f294c106",
                                        "entry_id": "57b0120e-9eb4-3896-b553-bfcf198ef467",
                                        "glosses": [
                                            "En ayant la volonté d’oublier ce dont on parle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aee93bd-3366-4969-a510-01b7631aea84",
                                                "sense_id": "42cc7fdd-0f08-3388-b158-25f9f294c106",
                                                "text": "Malgré les presque cinquante ans qui nous séparent maintenant du début de notre exode, j’ai le sentiment que tout ce que nous avons vécu depuis est entre parenthèses."
                                            },
                                            {
                                                "example_id": "77648b97-f55f-498f-894f-da3e43bdd4a1",
                                                "sense_id": "42cc7fdd-0f08-3388-b158-25f9f294c106",
                                                "text": "La mise entre parenthèses du symptôme et donc le non-souci de la guérison doivent donc être interprétés comme une manière de faire entrer en action celui qui veut améliorer son sort ou comme une façon de lui dire que le principe du changement est en lui et que l’on ne peut vouloir à sa place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
