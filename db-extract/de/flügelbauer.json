                ],
                "senses": [
                    {
                        "sense_id": "b5512bab-14cd-3b14-813c-1b6a6eb9da76",
                        "entry_id": "30cb5275-2214-3842-ae6f-4d1a9c2c3701",
                        "glosses": [
                            "Bauer, der auf einem Flügel steht, also auf der a- bis c-Linie oder der f- bis h-Linie"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "22266779-cafe-4c59-ba93-1982a632f2ec",
                                "sense_id": "b5512bab-14cd-3b14-813c-1b6a6eb9da76",
                                "text": "In der Ausgangsstellung des Schachspiels stehen die weißen Flügelbauern auf den Feldern a2, b2 und c2 (Damenflügel) und auf f2, g2 und h2 (Königsflügel)."
                            },
                            {
                                "example_id": "5a9969a9-7a0f-4450-8ff3-fa21ce2be1c9",
                                "sense_id": "b5512bab-14cd-3b14-813c-1b6a6eb9da76",
                                "text": "Weiß opfert einen Flügelbauern (4.b2-b4) im Evans-Gambit."
                            },
                            {
                                "example_id": "32bd6a41-d778-4bcf-baa5-564fc31c2aec",
                                "sense_id": "b5512bab-14cd-3b14-813c-1b6a6eb9da76",
                                "text": "Die kleine aber in der 5. Spielstunde fiese Endspielfalle eroberte einen wichtigen Flügelbauern und damit auch den Gesamtsieg zum 4,5 zu 3,5 für den VFB."
                            },
                            {
                                "example_id": "f2d18881-70e3-402f-8a68-4f3356c9dcee",
                                "sense_id": "b5512bab-14cd-3b14-813c-1b6a6eb9da76",
                                "text": "Im neuen Umgang mit Rand- und Flügelbauern sieht der amerikanische IM die größte Veränderung der Schachstrategie der letzten Jahre."
                            },
                            {
                                "example_id": "29731722-61e8-4252-b60d-7fe515af7e43",
                                "sense_id": "b5512bab-14cd-3b14-813c-1b6a6eb9da76",
                                "text": "Nach Vorrücken seiner Flügelbauern gegen den feindlichen Königsstand will nun Schwarz den ihm hinderlichen weißen Königsläufer so abdrängen, daß sein eigener Damenläufer bzw. seine Dame ohne Widerstand bei dem beabsichtigten Königsangriff einwirken kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "730e2f22-af2f-3ecb-9f45-b22f66fb768a",
                        "entry_id": "30cb5275-2214-3842-ae6f-4d1a9c2c3701",
                        "glosses": [
                            "Person, die Klavierflügel herstellt/baut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69825eef-af71-4ffd-a0f5-a4e9b59d5821",
                                "sense_id": "730e2f22-af2f-3ecb-9f45-b22f66fb768a",
                                "text": "Der Flügelbauer lieferte der Schule den Flügel, sobald er fertig war."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
