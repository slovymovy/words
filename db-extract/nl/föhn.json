                        "source_sense_id": "f81986c5-ae59-39ff-b81e-274002f81f42",
                        "source_sense_description": "een toestel dat een warme luchtstroom voortbrengt voor het drogen en opmaken van het kapsel",
                        "target_lang_word": "Haartrockner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haartrockner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ae8630-d14e-3e2a-ae61-bcd1d268398b",
                                        "entry_id": "b7faaca5-a09c-38b5-89f0-ac20f0030bc4",
                                        "glosses": [
                                            "ein Heißluftapparat, um nasse Haare zu trocknen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a444265-2ed9-4f76-b16d-0887fca4f818",
                                                "sense_id": "f8ae8630-d14e-3e2a-ae61-bcd1d268398b",
                                                "text": "Es gibt mittlerweile auch Haartrockner mit einer Kaltluftstufe, die das Haar weniger schädigt."
                                            },
                                            {
                                                "example_id": "768923a1-ced1-4329-8f13-aa16322a0f46",
                                                "sense_id": "f8ae8630-d14e-3e2a-ae61-bcd1d268398b",
                                                "text": "„Ich fand ein kleines Geschäft mit zwei Fenstern, in denen Radioapparate, elektrische Bügeleisen, Haartrockner, Mixer und elektrische Kochapparate ausgestellt waren; es funkelte überall von Metall und Chrom, – aber die Tür war verschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fdb22e2-8dcc-4bca-89a1-2a61573d23f4",
                        "source_entry_id": "7394335c-a870-3d3d-9586-0f8ade7642ef",
                        "source_sense_id": "f81986c5-ae59-39ff-b81e-274002f81f42",
                        "source_sense_description": "een toestel dat een warme luchtstroom voortbrengt voor het drogen en opmaken van het kapsel",
                        "target_lang_word": "Föhn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Föhn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                        "entry_id": "98e93773-5d84-35c8-866a-67eb17337018",
                                        "glosses": [
                                            "an steileren Gebirgshängen absteigende, trockene und klare Luftmassen mit relativ hoher Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b271b94c-cbbd-4c09-aa5b-c62d42d3af21",
                                                "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                                "text": "Als sich der Föhn legte, waren ihre starken Kopfschmerzen schlagartig verschwunden."
                                            },
                                            {
                                                "example_id": "d0068bec-2288-4222-aa29-7347a0972203",
                                                "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                                "text": "„Im Flugsport kann sich z.B. eine Ordalsituation andeuten, wenn ein Pilot auf seinen Gerät- und Startcheck verzichtet, wenn ein Paragleiter bei Föhn oder aufziehender Gewitterfront einen Flug wagt, wenn ein Drachenflieger in ein Wolkenfenster startet, […].“"
                                            },
                                            {
                                                "example_id": "ab5af194-ba71-40ad-8b84-c1989c3b42d5",
                                                "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                                "text": "„Der Föhn kam wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0b925e1-771e-3835-94ae-91346eacbee7",
                                        "entry_id": "98e93773-5d84-35c8-866a-67eb17337018",
                                        "glosses": [
                                            "elektrisches Gerät zum Haaretrocknen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf9a9c6-9118-406f-9a9c-44fdbfd25525",
                                                "sense_id": "b0b925e1-771e-3835-94ae-91346eacbee7",
                                                "text": "Wenn die Erdung am Kabel nicht in Ordnung ist, sollte man den Föhn wegen Stromschlaggefahr nicht verwenden."
                                            },
                                            {
                                                "example_id": "797cd286-980b-472d-8179-0665ee984439",
                                                "sense_id": "b0b925e1-771e-3835-94ae-91346eacbee7",
                                                "text": "„Die Kosmetikerin schaltete den Föhn aus und tupfte sich die Stirn trocken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
