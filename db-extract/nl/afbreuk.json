                        "glosses": [
                            "afbreuk doen aan: het minder goed, mooi of waardevol maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33d5093-6584-4c1b-9435-d8fd0db793b6",
                                "sense_id": "7fbe5f35-5ff7-3145-9e67-46773d1ec84b",
                                "text": "De woede uitbarsting van het boze kind deed afbreuk aan het mooie verjaardagsfeest."
                            },
                            {
                                "example_id": "3e2fdbd7-4999-4ddc-8825-4448e2b34819",
                                "sense_id": "7fbe5f35-5ff7-3145-9e67-46773d1ec84b",
                                "text": "Het was zo een enorm leuke vakantie dat het slechte weer helemaal geen afbreuk deed aan het plezier dat we met elkaar hadden."
                            },
                            {
                                "example_id": "52dbfb89-faeb-4222-af7e-50e14661c881",
                                "sense_id": "7fbe5f35-5ff7-3145-9e67-46773d1ec84b",
                                "text": "Terwijl hij zich geregeld beklaagde over het geringe contact, de ene joint na de andere rokend, hadden de zeven slapers hem op het hart gedrukt dat de afstand geen afbreuk zou doen aan hun liefde - maar diep in hun harten leefden zij in dezelfde onzekerheid en vreesden ze voor hun vriend."
                            }
                        ]
                    }
