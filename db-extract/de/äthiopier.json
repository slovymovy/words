                "senses": [
                    {
                        "sense_id": "356938bc-7a62-33ae-a089-d77a6375448d",
                        "entry_id": "f8bb95b9-dd64-3705-bfa6-a43dd220aeba",
                        "glosses": [
                            "Éthiopien, citoyen de l'Éthiopie, personne (homme) aux origines éthiopiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d1bff7b-0f78-488f-89bf-e0b854e63492",
                                "sense_id": "356938bc-7a62-33ae-a089-d77a6375448d",
                                "text": "(Viele äthiopische Militärs) haben in Russland trainiert. Bis heute besteht das Waffenarsenal hauptsächlich aus russischem Gerät, das die Äthiopier bedienen können.",
                                "translation": "(De nombreux militaires éthiopiens) se sont entraînés en Russie. Jusqu’à aujourd’hui, l’arsenal se compose principalement de matériel russe que les Éthiopiens savent manœuvrer."
                            },
                            {
                                "example_id": "3d1011c2-fee0-47c6-88fe-0cda35bf62ad",
                                "sense_id": "356938bc-7a62-33ae-a089-d77a6375448d",
                                "text": "Obwohl Äthiopien fünftgrößter Kaffeeexporteur ist, konsumieren die Äthiopier mehr Kaffee als sie exportieren.",
                                "translation": "Bien que l'Éthiopie soit le cinquième exportateur de café, les Éthiopiens consomment plus de café qu'ils n'en exportent."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
