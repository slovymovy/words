                        "entry_id": "6eed3b5b-5763-33fe-bb3b-9bc83abd2abd",
                        "glosses": [
                            "A blog on which one posts brief, frequent updates on one's activities."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "2ae08ae8-9f63-4fed-80f2-c121511ce4d2",
                                "sense_id": "11299066-b871-3a31-a5fe-308938c41c57",
                                "text": "For Dorsey, creating this community of linked microblogs has been \"endearing, because you know what everyone you know is doing\" […]"
                            }
                        ]
                    }
                ],
