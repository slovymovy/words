                    {
                        "translation_id": "8c624724-c2c0-44f6-8fe2-01ba42997f12",
                        "source_entry_id": "80ba8f3b-1444-3e82-ae09-eb0db778f80c",
                        "source_sense_id": "5867f7ea-98b9-3af0-923a-33ffefed7c42",
