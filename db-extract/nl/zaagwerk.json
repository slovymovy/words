                        ],
                        "examples": [
                            {
                                "example_id": "1f58509e-e12d-4392-8c7a-3d57b009e941",
                                "sense_id": "4b0c2d09-3eee-35c2-90da-3b0fc8b26be6",
                                "text": "Het machtige, donkerbruine gebak vereist enig zaagwerk, maar is een feest op de tong, mede dankzij het zuurtje van de verse aarbeien."
                            }
                        ]
                    },
                    {
