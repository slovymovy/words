                "senses": [
                    {
                        "sense_id": "24334b07-4ea7-3905-a28a-e83f4d524c85",
                        "entry_id": "d9a9d6bb-b58e-3e64-8f27-0b03303bfaea",
                        "glosses": [
                            "Support de données numériques lisible par un système optique laser, disposant d’une capacité mémoire de 650 à 800 mégaoctets et sous forme de disque compact pressé sur lequel on ne peut graver de nouvelles données."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b4d8455-6454-4b25-8cb6-aa1d61263728",
                                "sense_id": "24334b07-4ea7-3905-a28a-e83f4d524c85",
                                "text": "Ce CD-ROM contient un dictionnaire très complet."
                            },
                            {
                                "example_id": "1d560a7d-0d20-47a6-8c69-a6992a983b72",
                                "sense_id": "24334b07-4ea7-3905-a28a-e83f4d524c85",
                                "text": "Lors de son invention, le CD-ROM représentait une formidable évolution dans le système de l’archive numérique."
                            }
                        ]
                    }
                ],
