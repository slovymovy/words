                    {
                        "sense_id": "19485ff5-b17e-36b2-b377-04e66eaf17d0",
                        "entry_id": "02e1eddb-353b-3843-b72c-30cc00ba583b",
                        "glosses": [
                            "Qui concerne l’univers des canards de Disney."
                        ],
                        "tags": [
                            "Univers des canards de Disney"
                        ],
                        "examples": [
                            {
                                "example_id": "5c8f35f3-0652-457f-a64d-8432bbd93a58",
                                "sense_id": "19485ff5-b17e-36b2-b377-04e66eaf17d0",
                                "text": "Comme le titre le suggère (du moins en anglais), ceci est une version canardière du cinéma existentialiste de 1957 L’Homme qui rétrécit."
                            }
                        ]
                    }
                ],
                "translations": [],
