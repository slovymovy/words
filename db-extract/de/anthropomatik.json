                "senses": [
                    {
                        "sense_id": "dbf8dc4d-0287-30c3-a9b5-1b61e9458b48",
                        "entry_id": "ef8e5e92-1a69-353a-99cd-509e76a236de",
                        "glosses": [
                            "die Wissenschaft der Symbiose zwischen Mensch und Maschine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6370df1a-a555-4aad-920a-436ce9db43c6",
                                "sense_id": "dbf8dc4d-0287-30c3-a9b5-1b61e9458b48",
                                "text": "In meiner Bibliothek steht ein Buch über Anthropomatik."
                            },
                            {
                                "example_id": "3713d80c-2e2b-45f6-b80a-6a65f58699c9",
                                "sense_id": "dbf8dc4d-0287-30c3-a9b5-1b61e9458b48",
                                "text": "„Im Rahmen der Anthropomatik wird nicht nur versucht, die Funktionsweise des Menschen zu verstehen, vielmehr sollen die Fähigkeiten des Menschen modelliert und in technischen Entwicklungen nachgebildet werden.“"
                            },
                            {
                                "example_id": "afcd9464-3a06-410e-94aa-03902d2b58b2",
                                "sense_id": "dbf8dc4d-0287-30c3-a9b5-1b61e9458b48",
                                "text": "„Generell lässt sich also sagen, dass die Anthropomatik die Gestaltung der Lebensbedingungen des Menschen in einer Informationsgesellschaft zum Ziel haben muss und damit Entwicklungen ermöglicht,deren Tragweite und Veränderungspotenzial für unser tägliches Leben außerordentlich sein werden und heute kaum abzusehen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
