                        "entry_id": "bbf86099-4477-32bc-8727-d4c3f9958067",
                        "glosses": [
                            "phantom, apparition, ghost"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "9337c9fd-8280-4b31-938e-4ed7f55b651f",
                                "sense_id": "f62edcf2-9df0-39be-9d0d-1b683da93282",
                                "text": "Veel mensen beweren een fantoom te hebben gezien in het oude kasteel.",
                                "translation": "Many people claim to have seen a phantom in the old castle.",
                                "english": "Many people claim to have seen a phantom in the old castle."
                            },
                            {
                                "example_id": "a7d01498-292d-42c2-be95-730da80c95ee",
                                "sense_id": "f62edcf2-9df0-39be-9d0d-1b683da93282",
                                "text": "In de mist leek het schip een fantoom te zijn.",
                                "translation": "In the fog, the ship appeared to be a ghost.",
                                "english": "In the fog, the ship appeared to be a ghost."
                            },
                            {
                                "example_id": "20e40957-2120-43dd-8d14-483d51dd6a6e",
                                "sense_id": "f62edcf2-9df0-39be-9d0d-1b683da93282",
                                "text": "Het kind was bang voor de fantomen onder zijn bed.",
                                "translation": "The child was afraid of the apparitions under his bed.",
                                "english": "The child was afraid of the apparitions under his bed."
                            }
                        ]
                    },
                    {
                        "sense_id": "30bfafcb-af5f-3016-91bd-542ad2f7783c",
                        "entry_id": "bbf86099-4477-32bc-8727-d4c3f9958067",
                        "glosses": [
                            "figment, mirage, product of fantasy"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "47352ef5-6b87-4cdb-9a6e-e5ade30326e2",
                                "sense_id": "30bfafcb-af5f-3016-91bd-542ad2f7783c",
                                "text": "Die perfecte stad is slechts een fantoom van je verbeelding.",
                                "translation": "That perfect city is just a figment of your imagination.",
                                "english": "That perfect city is just a figment of your imagination."
                            },
                            {
                                "example_id": "ec916f01-4e5f-417e-a93b-51ad3a686236",
                                "sense_id": "30bfafcb-af5f-3016-91bd-542ad2f7783c",
                                "text": "De oase in de woestijn bleek een fantoom te zijn.",
                                "translation": "The oasis in the desert turned out to be a mirage.",
                                "english": "The oasis in the desert turned out to be a mirage."
                            },
                            {
                                "example_id": "b94f7dd9-134f-4e87-aaaf-5b910fe3ae07",
                                "sense_id": "30bfafcb-af5f-3016-91bd-542ad2f7783c",
                                "text": "Het idee van eeuwige vrede is mogelijk een fantoom.",
                                "translation": "The idea of eternal peace might be a product of fantasy.",
                                "english": "The idea of eternal peace might be a product of fantasy."
                            }
                        ]
                    }
