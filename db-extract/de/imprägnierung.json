                            {
                                "example_id": "9377b63a-c491-4f8a-bb68-88fe5f3b6915",
                                "sense_id": "674115b9-538d-32fa-b535-df5d6787c19e",
                                "text": "Die Imprägnierung von Regenmänteln kann man selbst mit Sprays vornehmen.",
                                "translation": "On peut faire soi-même l’imperméabilisation des impers avec des pulvérisateurs."
                            }
