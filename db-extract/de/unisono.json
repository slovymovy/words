        "de-extract.jsonl": [
            {
                "entry_id": "febd9f87-8c2a-3a13-a301-08d7317c1f15",
                "word": "unisono",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e24ca0a-00e3-3baf-a63e-67f92f9d30c0",
                        "entry_id": "febd9f87-8c2a-3a13-a301-08d7317c1f15",
                        "glosses": [
                            "übereinstimmend, im Einklang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fa40659-215d-4d46-9888-9bf7513faf45",
                                "sense_id": "1e24ca0a-00e3-3baf-a63e-67f92f9d30c0",
                                "text": "„Erklärt wird sie mit dem unisono als typisch bezeichneten nachmittäglichen Ritual von ‚Kaffee und Kuchen‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80ff6f56-c3ab-3255-9ffa-869a2dee4795",
                        "entry_id": "febd9f87-8c2a-3a13-a301-08d7317c1f15",
                        "glosses": [
                            "(mus.) musikalische Bezeichnung für einstimmig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf922265-b330-4a17-b5d4-194011c58261",
                                "sense_id": "80ff6f56-c3ab-3255-9ffa-869a2dee4795",
                                "text": "„Die Proben werden intensiv genutzt, Liedpassagen wiederholt, bis alle unisono singen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8074ceb-3f2b-4978-b418-634e99897672",
                        "source_entry_id": "febd9f87-8c2a-3a13-a301-08d7317c1f15",
                        "source_sense_id": "1e24ca0a-00e3-3baf-a63e-67f92f9d30c0",
                        "source_sense_description": "übereinstimmend, im Einklang",
                        "target_lang_word": "unisonous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unisonous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86ee8526-c387-35ae-97d1-8c98ea3b5583",
                                        "entry_id": "ea8605cb-6ce9-31e4-b4fd-9e5103fd21fc",
                                        "glosses": [
                                            "Being in unison; unisonant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5a75bb2-0660-4794-a154-1b8b78d1b48f",
                                                "sense_id": "86ee8526-c387-35ae-97d1-8c98ea3b5583",
                                                "text": "Hitherto all the singing in the American churches had been unisonous, the melody only having been sung; but in 1720 a book of tunes in threo parts, \"Cantus,\" \"Medius\" and \"Basus,\" was published by Rev. Thomas Walter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "690e502d-1fee-4a7e-8078-a9c1143f46a6",
                        "source_entry_id": "febd9f87-8c2a-3a13-a301-08d7317c1f15",
                        "source_sense_id": "1e24ca0a-00e3-3baf-a63e-67f92f9d30c0",
                        "source_sense_description": "übereinstimmend, im Einklang",
                        "target_lang_word": "unanime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "627a1565-711d-3742-82e0-15d171d5cb51",
                                        "entry_id": "03cc9543-240c-30b9-9b57-6bae6434443e",
                                        "glosses": [
                                            "Qui réunit tous les suffrages, qui exprime un commun accord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d8b82c-a2ec-49a3-8a44-80c33b741d49",
                                                "sense_id": "627a1565-711d-3742-82e0-15d171d5cb51",
                                                "text": "Devant la réprobation presque unanime qui accueillit mon exposé, je me décourageai et me ralliai à l'interprétation probabiliste de Born, Bohr et Heisenberg […]."
                                            },
                                            {
                                                "example_id": "144aaf61-d3d6-4720-8870-355d4640e0a9",
                                                "sense_id": "627a1565-711d-3742-82e0-15d171d5cb51",
                                                "text": "Consentement unanime. — Résolution unanime. — Les opinions furent unanimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2837330d-aebc-306c-8438-49170700cf2e",
                                        "entry_id": "03cc9543-240c-30b9-9b57-6bae6434443e",
                                        "glosses": [
                                            "Qualifie les personnes qui sont en complet accord, qui ont le même sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313bb1a2-4560-4379-98c4-55098335d9a2",
                                                "sense_id": "2837330d-aebc-306c-8438-49170700cf2e",
                                                "text": "Nous avons été unanimes sur cette question."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
