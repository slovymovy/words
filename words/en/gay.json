    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d820ff55-18b3-3031-96ac-9bb6e1afecd6",
                    "sense_definition": "Sexually or romantically attracted to people of the same sex or gender.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sexual_orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother came out as <w>gay</w> to our parents last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году мой брат признался родителям, что он <w>гей</w>.",
                                "zh": "我哥哥去年向父母出柜，承认自己是<w>同志</w>。"
                            }
                        },
                        {
                            "text": "Many <w>gay</w> couples want the same legal rights as straight couples.",
                            "target_lang_translations": {
                                "ru": "Многие <w>гомосексуальные</w> пары хотят тех же законных прав, что и гетеросексуальные.",
                                "zh": "许多<w>同性恋</w>伴侣希望获得与异性恋伴侣相同的法律权利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "homosexual",
                        "queer"
                    ],
                    "antonyms": [
                        "straight",
                        "heterosexual"
                    ],
                    "common_phrases": [
                        "gay rights",
                        "gay marriage",
                        "gay bar",
                        "gay pride"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий сексуальное или романтическое влечение к людям своего пола.",
                        "zh": "指对同性或同性别的人产生性吸引或浪漫吸引的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гомосексуальный",
                                "target_lang_sense_clarification": "нейтральный, официальный термин"
                            },
                            {
                                "target_lang_word": "гей",
                                "target_lang_sense_clarification": "сущ., часто используется как определение (напр. гей-пара)"
                            },
                            {
                                "target_lang_word": "голубой",
                                "target_lang_sense_clarification": "разговорное, сленг"
                            }
                        ],
                        "zh": [
                            {
