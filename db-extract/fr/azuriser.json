                ],
                "senses": [
                    {
                        "sense_id": "91385d4a-4f00-3731-84d5-e3b5c396c8b7",
                        "entry_id": "b8867d2c-6e1c-327c-90ae-5cc03f09a1a6",
                        "glosses": [
                            "Donner un caractère azur à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bd15bbd-06d2-4746-b553-39d0d381a98b",
                                "sense_id": "91385d4a-4f00-3731-84d5-e3b5c396c8b7",
                                "text": "Les troncs des deux arbres n'en forment plus qu'un, leur couleur s’azurise;"
                            },
                            {
                                "example_id": "0a620fe2-4b19-4c5a-915a-cdba7244dde2",
                                "sense_id": "91385d4a-4f00-3731-84d5-e3b5c396c8b7",
                                "text": "Notre voyage débute sous les nuages gris puis le ciel s'azurise de plus en plus avec des percées de soleil suffisamment fortes pour nous faire enlever nos manteaux malgré une température extérieure qui s’entête à demeurer autour de 37 F."
                            }
                        ]
                    },
                    {
                        "sense_id": "665c51bf-eeae-324c-9d1d-d849a49e4b24",
                        "entry_id": "b8867d2c-6e1c-327c-90ae-5cc03f09a1a6",
                        "glosses": [
                            "Transformer (un véhicule Méhari) en fausse Méhari Azur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5691e1f3-aec9-45e0-a8a7-1e72c1d933cb",
                                "sense_id": "665c51bf-eeae-324c-9d1d-d849a49e4b24",
                                "text": "Plus sérieusement ; il fut tentant d'azuriser au temps des carrosseries exclusivement blanches et le MCC et MCDA en avaient même fait leur enseigne, d'où le nombre de fausses et il s'ajoute à cela le fait que le modèle ne manque pas de charme."
                            },
                            {
                                "example_id": "0f228e7b-482f-4116-9101-c4286771e24c",
                                "sense_id": "665c51bf-eeae-324c-9d1d-d849a49e4b24",
                                "text": "Ta voiture fait partie des Méhari azurisées dans les années 90."
                            }
                        ]
                    }
                ],
