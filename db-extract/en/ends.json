            {
                "entry_id": "19e2e3ff-655a-3112-af48-e9420d742bfc",
                "word": "ends",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf0f39e3-c103-3e0b-b03a-d36a12db5b37",
                        "entry_id": "19e2e3ff-655a-3112-af48-e9420d742bfc",
                        "glosses": [
                            "The area in close proximity to one's home; neighbourhood."
                        ],
                        "tags": [
                            "Multicultural-London-English",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "bc2b3cb1-47f9-428a-8c05-5715f8a9a505",
                                "sense_id": "cf0f39e3-c103-3e0b-b03a-d36a12db5b37",
                                "text": "Don't come 'round my ends again, yeah?"
                            },
                            {
                                "example_id": "d2b25657-9f2d-4d5d-a136-4158ffc12d10",
                                "sense_id": "cf0f39e3-c103-3e0b-b03a-d36a12db5b37",
                                "text": "On August 6, following the circulation of conflicting accounts of the shooting, the grime MC Scorcher tweeted, '25 years ago police killed my grandma in her house in Tottenham and the whole ends rioted, 25 years on and they're still keepin up fuckry.'"
                            },
                            {
                                "example_id": "fdee264c-1ede-4201-a7f1-9fa1c0df815a",
                                "sense_id": "cf0f39e3-c103-3e0b-b03a-d36a12db5b37",
                                "text": "I'm so London, I'm so south / Food in the ends like there ain't no drought / Flipz don't talk like he's got no mouth"
                            },
                            {
                                "example_id": "0aae5f0c-8f86-4db9-ba10-c7ff340bbb3b",
                                "sense_id": "cf0f39e3-c103-3e0b-b03a-d36a12db5b37",
                                "text": "Come to my ends, you must be crazy"
                            },
                            {
                                "example_id": "69cefdb0-51f8-4d14-85b4-e6e48660e3bf",
                                "sense_id": "cf0f39e3-c103-3e0b-b03a-d36a12db5b37",
                                "text": "Don-E, I roll thru my ends with my Bape hoodie"
                            }
                        ]
                    },
