                        "sense_id": "0592931e-9494-3439-9c49-370bc1c21ae0",
                        "entry_id": "2013cb04-67fb-3137-8e37-c1081cb0df4f",
                        "glosses": [
                            "To render giddy or senseless"
                        ],
                        "tags": [
                            "dialectal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f4d5679e-7db7-4595-b8cd-4e41b1f9cade",
                                "sense_id": "0592931e-9494-3439-9c49-370bc1c21ae0",
                                "text": "To masker their troubled heads the more, hee assaileth them with a great shout and maine violence."
                            },
                            {
                                "example_id": "90b440fe-8158-41df-a939-4764ec86c7a9",
                                "sense_id": "0592931e-9494-3439-9c49-370bc1c21ae0",
                                "text": "He is so, for he is not one that sets forth to the wars with great resolutions and hopes, and returns with maskered fears, and despairs; neither is he like those that take more care, and are more industrious to get gay clothes, and fine feathers, [...]"
                            }
                        ]
