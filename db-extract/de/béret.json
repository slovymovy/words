                "senses": [
                    {
                        "sense_id": "5c75ba85-766a-339f-bf27-c492e7dfd9a1",
                        "entry_id": "74cf6521-cf19-3e37-bcad-5fc00086bc4c",
                        "glosses": [
                            "charakteristische Kopfbedeckung, ursprünglich als Zeichen eines höheren Standes"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "d1f56a19-9b06-404e-a117-45ddd1963b9e",
                                "sense_id": "5c75ba85-766a-339f-bf27-c492e7dfd9a1",
                                "text": "Bérets gibt es in der französischen Hauptstadt in unzähligen Souvenirläden und an Strassenbuden zu kaufen."
                            },
                            {
                                "example_id": "5b04444f-c663-4424-862d-640d2236222e",
                                "sense_id": "5c75ba85-766a-339f-bf27-c492e7dfd9a1",
                                "text": "Er trägt seine ordentlich gebügelte grüne Windjacke geschlossen, das schwarze Béret mit dem goldenen Stern hat er vom Kopf genommen und hält es in den Händen."
                            },
                            {
                                "example_id": "e7dcbd30-96da-4414-baf8-14792dd31e51",
                                "sense_id": "5c75ba85-766a-339f-bf27-c492e7dfd9a1",
                                "text": "Ging er ins Bordell, so zog er sich sein Béret stets tief ins Gesicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82348e82-3343-4b91-a7e6-eec44c2f344f",
