                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df0cfaa9-f37f-4be9-bc41-544defb118ce",
                                "sense_id": "a9ca6912-8c46-31d7-a2a4-3efe06f023e5",
                                "text": "Nous remontons dans la clairière, car on doit schlitter, non plus des rondins empilés, mais des troncs énormes."
                            },
                            {
                                "example_id": "6ae174ce-2c15-4a64-89cc-bfca39273d3c",
                                "sense_id": "a9ca6912-8c46-31d7-a2a4-3efe06f023e5",
                                "text": "Une après-midi, qui devait être en fait celle de la veille du départ de la troupe, des Dörfermesch - des \"hommes du village\" - qui étaient partis schlitter du bois dans la forêt de Borensfall..."
                            }
                        ]
