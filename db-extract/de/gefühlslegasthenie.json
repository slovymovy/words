                "senses": [
                    {
                        "sense_id": "c8dbfa17-1510-3968-8d4b-4bb0ec044b17",
                        "entry_id": "20ee325f-7e30-3aa2-b5b6-5bd2cf1ecaea",
                        "glosses": [
                            "Unfähigkeit, eigene Gefühle adäquat wahrzunehmen und sie mit Worten zu beschreiben; Zustand der Empfindungslosigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b71480-816e-441c-9944-5090b4b4212b",
                                "sense_id": "c8dbfa17-1510-3968-8d4b-4bb0ec044b17",
                                "text": "„Unter Gefühlslegasthenie versteht man, würde ich sagen, fehlende Empathie gegenüber den Empfindungen, das Denken anderer Leute, stimmts?“"
                            },
                            {
                                "example_id": "3b7bbb5c-2c84-423f-9260-b34ae4e15695",
                                "sense_id": "c8dbfa17-1510-3968-8d4b-4bb0ec044b17",
                                "text": "„so ganz gewöhnlich/tut am meisten weh.",
                                "translation": "Du stehst vor mir und fragst mich: Wie heilt man Gefühlslegasthenie? (aus Es tut weh)“"
                            },
                            {
                                "example_id": "5adbbece-ea8e-46e2-b9b0-db53c934248e",
                                "sense_id": "c8dbfa17-1510-3968-8d4b-4bb0ec044b17",
                                "text": "„In Anbetracht dessen ist mir eine liebevolle Hartz-4 Mutti lieber als ne kinderlose Karrieretusse mit Gefühlslegasthenie.“"
                            },
                            {
                                "example_id": "b6dcbc28-9edf-4065-8361-57337cf56708",
                                "sense_id": "c8dbfa17-1510-3968-8d4b-4bb0ec044b17",
                                "text": "Die Alexithymie oder die Gefühlslegasthenie beschreibt die Unfähigkeit eigene Gefühle valide deuten zu können oder bezeichnet sogar die Unfähigkeit diese auch nur im Ansatz zu erkennen."
                            },
                            {
                                "example_id": "88fb7719-edc4-4995-ae56-c608fd79a804",
                                "sense_id": "c8dbfa17-1510-3968-8d4b-4bb0ec044b17",
                                "text": "Diese zwei neuen Richtungen, die sich parallel entwickelten und auch als Gefühlsblindheit oder gar Gefühlslegasthenie beschrieben wurden, waren die seelisch bedingte Gefühllosigkeit (‚psychological mindedness') und emotionale Achtsamkeit beziehungsweise die emotionale Bewusstheit (‚emotional awareness')."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
