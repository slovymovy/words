                ],
                "senses": [
                    {
                        "sense_id": "3803645d-ece1-3fe1-a2eb-59ae98015e2d",
                        "entry_id": "f8a2b3a3-3c1d-374b-88d9-b5bbafd59cf3",
                        "glosses": [
                            "Person, die aus der sachsen-anhaltinischen Stadt Salzwedel stammt oder dort lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ca90b9-81a7-454c-aee9-355b1348be79",
                                "sense_id": "3803645d-ece1-3fe1-a2eb-59ae98015e2d",
                                "text": "„Man blieb offenbar weiter auf der Suche und wurde schließlich in der Person des Salzwedelers Dietrich Bruns fündig, der in Frankfurt/Oder studiert, sein Studium jedoch nicht abgeschlossen hatte, wie das nicht ungewöhnlich war.“"
                            },
                            {
                                "example_id": "02b4000e-f931-464d-a1a9-7ac516ba0e93",
                                "sense_id": "3803645d-ece1-3fe1-a2eb-59ae98015e2d",
                                "text": "„Bei Landtagen auf dem Boden der Altmark dagegen gingen oder saßen die Stendaler vor den Vertretern der beiden Brandenburg, denen alsdann die Salzwedeler und dann erst die Bürgermeister Berlins und Colins und die sonstigen folgten.“"
                            },
                            {
                                "example_id": "76d5fc02-8c66-4bb2-8879-0e9a052d9538",
                                "sense_id": "3803645d-ece1-3fe1-a2eb-59ae98015e2d",
                                "text": "„Bis 1500 waren von 229 Stendaler Studiosi überhaupt 111 in Leipzig (1409 gegründet) immatrikuliert, 44 in Erfurt (1 392 gegründet), von 196 Salzwedelern 69 in Leipzig, 43 in Erfurt, von 77 aus Tangermünde 42 in Leipzig, 19 in Erfurt, von 51 Gardelegenern 22 in Leipzig, 20 in Erfurt, von 22 Osterburgern 13 in Leipzig, vier in Erfurt, von 16 aus Werben acht in Leipzig, einer in Erfurt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
