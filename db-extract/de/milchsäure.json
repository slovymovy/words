                                            {
                                                "example_id": "49d4a099-04e8-4fde-abda-fb11b9496781",
                                                "sense_id": "c5d8d0ba-0f02-35d3-a39d-86a2c2bfb559",
                                                "text": "Le déchaulage doit se faire avec de l’acide lactique ou sulfurique pour le tannage au chrome, mais il n’est pas nécessaire qu’il soit complet pour le tannage végétal."
                                            },
                                            {
                                                "example_id": "38c39e69-e301-44cf-be6d-5cbde9e58223",
                                                "sense_id": "c5d8d0ba-0f02-35d3-a39d-86a2c2bfb559",
                                                "text": "Précisons que le préfixe « lacto » fait référence à l’acide lactique, libéré lors de la fermentation, et non pas à un support laitier qui serait indispensable au phénomène de lacto-fermentation."
                                            }
