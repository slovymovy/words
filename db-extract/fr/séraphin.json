                "senses": [
                    {
                        "sense_id": "81d73cdf-cad7-351a-a420-c452d1a16ac4",
                        "entry_id": "ed79aa31-eac5-3d71-9f18-83bd2163f6e1",
                        "glosses": [
                            "Personne avare."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "76ae6440-32fc-48d2-b0bf-dd87cd5cc872",
                                "sense_id": "81d73cdf-cad7-351a-a420-c452d1a16ac4",
                                "text": "Sont-ils des Séraphin, avares et soucieux de leur portefeuille à l’extrême ou — au contraire — des cigales, qui dépensent et s’endettent sans compter ?"
                            },
                            {
                                "example_id": "240a300d-98eb-4f60-85fc-85ae92278a44",
                                "sense_id": "81d73cdf-cad7-351a-a420-c452d1a16ac4",
                                "text": "Y va jamais te donner une cenne : i'est trop Séraphin pour ça!"
                            }
                        ]
