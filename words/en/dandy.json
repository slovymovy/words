                {
                    "sense_id": "0114f691-05b3-303d-86f7-10b89f81c8a3",
                    "sense_definition": "Resembling or characteristic of a dandy; foppish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He strolled along the avenue with a delightfully <w>dandy</w> swagger.",
                            "target_lang_translations": {
                                "es": "Paseaba por la avenida con un contoneo deliciosamente <w>dandiesco</w>."
                            }
                        },
                        {
                            "text": "Her companion wore a <w>dandy</w> velvet vest and polished boots.",
                            "target_lang_translations": {
                                "es": "Su acompañante llevaba un chaleco de terciopelo muy <w>lechuguino</w> y botas lustradas."
                            }
                        }
                    ],
                    "synonyms": [
