                        "glosses": [
                            "Jeune négresse."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "38b473e4-22fa-4b28-ac74-543dc622b6d4",
                                "sense_id": "3290acc3-eb02-3716-b342-6e613574ab1e",
                                "text": "NEGRE. Nom qu’on donne à une variété d'hommes de l'Afrique, qui sont tout noirs. La femme s’appelle Négresse, & son enfant Négrillon ou Négrite."
                            },
                            {
                                "example_id": "8d25f775-5f00-45a6-9440-26c7b3125b1f",
                                "sense_id": "3290acc3-eb02-3716-b342-6e613574ab1e",
                                "text": "Anne-Françoise Bourrieu possédait une petite « négrite » Ana Loreto qu’elle voulait libérer."
                            }
                        ]
                    },
                    {
                        "sense_id": "493141f0-3803-3cd1-b43b-0b8fa4706705",
                        "entry_id": "229f22a0-d114-300e-9589-72447b9d213f",
                        "glosses": [
                            "Insecte qui ravage les plantations de pastel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a4b039-6c0a-4438-99e2-37bacb43a34f",
                                "sense_id": "493141f0-3803-3cd1-b43b-0b8fa4706705",
                                "text": "NÉGRITE. Un Insecte du genre Altise qui, dans le midi de la France, désole les plantations de Pastel, porte ce nom vulgaire dans certains cantons de l’Occitanie."
                            }
                        ]
                    }
