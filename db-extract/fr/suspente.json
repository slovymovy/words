                "forms": [
                    {
                        "form_id": "6b876967-c5dd-49e3-a35e-46e02695cf7a",
                        "entry_id": "a792b8e4-ab7d-35af-97a1-5e4c4ff18834",
                        "tags": [
                            "plural"
                        ],
                        "form": "suspentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a997c4f3-74f4-37c7-bbfc-9cc6982357e8",
                        "entry_id": "a792b8e4-ab7d-35af-97a1-5e4c4ff18834",
                        "glosses": [
                            "Sorte de cordelette très résistante reliant le harnais du parachutiste à la voile ou une nacelle au ballon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8122b867-d333-4cd7-8d24-dc5cf8fd59ae",
                                "sense_id": "a997c4f3-74f4-37c7-bbfc-9cc6982357e8",
                                "text": "Le filet qui recouvrait le ballon se terminait par des cordes attachées au cercle, sorte de grand cerceau de bois doublé d’acier, auquel des suspentes reliaient la nacelle."
                            },
                            {
                                "example_id": "23845738-9fbe-4306-a876-bcefb79c8501",
                                "sense_id": "a997c4f3-74f4-37c7-bbfc-9cc6982357e8",
                                "text": "Revenez, disciple! J'ai oublié de fixer la toile aux suspentes!"
                            }
                        ]
                    },
                    {
                        "sense_id": "cc98df17-6cd5-385b-ac56-219b7ace90a1",
                        "entry_id": "a792b8e4-ab7d-35af-97a1-5e4c4ff18834",
                        "glosses": [
                            "Dans un pont suspendu, les suspentes désignent les tiges verticales qui relient le tablier du pont aux câbles porteurs. — (http://fr.wikipedia.org/wiki/Suspente_%28pont%29)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77024ac-6431-4e36-9b43-da62530e7cdf",
                                "sense_id": "cc98df17-6cd5-385b-ac56-219b7ace90a1",
                                "text": "Le pont suspendu, dont le tablier est accroché à des câbles paraboliques par l’intermédiaire de suspentes, permet de franchir en une seule travée des distances supérieures à 1 500 mètres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbbbf94e-b2cf-497e-8e87-850a6e5f31f8",
                        "source_entry_id": "a792b8e4-ab7d-35af-97a1-5e4c4ff18834",
                        "target_lang_word": "борг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "борг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "33c5fe0e-2311-3b07-b702-c5836bfe6de4",
                                        "entry_id": "6c610f1a-7b0c-3544-bab7-c8cc3ec964a2",
                                        "glosses": [
                                            "морская снасть, прикрепляющая рею к мачте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2bcf36e-a6eb-4ca3-88f1-d0769cc425fe",
                                                "sense_id": "33c5fe0e-2311-3b07-b702-c5836bfe6de4",
                                                "text": "Требуется 3 цепных борга, мера коим доставится на заводы, когда вышлют из Кронштадта дельную книгу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "борг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "23ff0592-dedd-32c2-9c15-66001c6dd87f",
                                        "entry_id": "9a9a37f4-35dd-36cd-9898-5feb12e2bda3",
                                        "glosses": [
                                            "вымышленная высокотехнологичная раса киборгов во вселенной «Звёздного пути»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a6378e-612f-4c79-8714-7945564029eb",
                                                "sense_id": "23ff0592-dedd-32c2-9c15-66001c6dd87f",
                                                "text": "Мне вспомнился также борг из «Звёздного пути», рой частично биологических, частично робототехнических созданий с выраженными разрушительными наклонностями."
                                            },
                                            {
                                                "example_id": "6c69000e-43c1-4638-8d6e-6a2259b05856",
                                                "sense_id": "23ff0592-dedd-32c2-9c15-66001c6dd87f",
                                                "text": "Цивилизацией III типа можно, пожалуй, назвать Империю из саги «Звёздные войны» или, может быть, боргов из «Звездного пути». Те и другие колонизировали значительную часть своей галактики, захватив миллионы звёздных систем."
                                            },
                                            {
                                                "example_id": "7aa025e9-4e34-4a45-ab18-d763fbf6e0f5",
                                                "sense_id": "23ff0592-dedd-32c2-9c15-66001c6dd87f",
                                                "text": "— Вы помните боргов из «Звёздного пути»? Кира нахмурилась. В её детстве на экраны вышли семь сезонов «Нового поколения», и она смотрела все серии без исключений. Борг, сокращение от киборга, был огромным сообществом полуорганических, полумашинных существ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
