                        "sense_id": "0db5371d-381a-350e-88c1-d3096b0a31bc",
                        "entry_id": "e6850837-873c-3b98-92fe-2ce738acb43b",
                        "glosses": [
                            "mogelijkheid om via een uniek administratienummer bij een bank persoonlijke inkomsten en uitgaven te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52bbae75-dc85-4161-b1dd-773a56b42580",
                                "sense_id": "0db5371d-381a-350e-88c1-d3096b0a31bc",
                                "text": "Ze verplaatste het geld naar haar privérekening om het veilig te stellen, zegt ze, voor het geval ze het ooit moet terugbetalen."
                            },
                            {
                                "example_id": "cd3ef84e-ee55-430b-baa1-e3defe2c71e4",
                                "sense_id": "0db5371d-381a-350e-88c1-d3096b0a31bc",
                                "text": "Het geld dat we met het bedrijf verdienen, gaat deels naar een beleggingsrekening en deels naar onze privérekeningen om vrij te besteden. We noemen dat ons ‘zakgeld’."
                            }
                        ]
                    },
                    {
                        "sense_id": "69442162-204f-3186-9a3d-8c2e87a4de4b",
                        "entry_id": "e6850837-873c-3b98-92fe-2ce738acb43b",
                        "glosses": [
                            "geheel van persoonlijke inkomsten en uitgaven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02efdd5d-1d1c-4f48-afd1-b8a46b2ebca4",
                                "sense_id": "69442162-204f-3186-9a3d-8c2e87a4de4b",
                                "text": "De ene maand na de andere verstreek intussen zonder dat Stemvers zijn aandeel in de zaak stortte. Weliswaar had hij beloofd de boekdrukkers en papierverkopers voor zijn privérekening te nemen, om aldus ook van zijn kant iets effectiefs tot de zaak bij te dragen, maar Meijer zag geen kwitanties."
                            }
                        ]
                    }
