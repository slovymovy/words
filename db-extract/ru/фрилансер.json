                "senses": [
                    {
                        "sense_id": "9ddb1565-eaca-363b-8479-6b477e71c82f",
                        "entry_id": "0e2e84fa-e698-3741-bbce-9afb16693226",
                        "glosses": [
                            "неол. внештатный работник"
