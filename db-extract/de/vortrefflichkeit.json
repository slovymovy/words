                "senses": [
                    {
                        "sense_id": "a2d92d10-2475-31bc-8a92-d6974080c3e3",
                        "entry_id": "0336c1f4-57e1-33a1-a82d-e10de7ade627",
                        "glosses": [
                            "Eigenschaft, ausgezeichnet/sehr gut zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8814fdea-a8da-4ca2-9a5d-cb0395580133",
                                "sense_id": "a2d92d10-2475-31bc-8a92-d6974080c3e3",
                                "text": "„Der Krieg überzeugte ihn von der Vortrefflichkeit des Nationalismus.“"
                            },
                            {
                                "example_id": "4f8051e7-31ba-4a10-9d00-228011267237",
                                "sense_id": "a2d92d10-2475-31bc-8a92-d6974080c3e3",
                                "text": "„Bei meinem ersten Souper war ich überrascht über die Vortrefflichkeit meines Kochs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4cd34d2-13ad-492f-a6a2-f722cff7c894",
                        "source_entry_id": "0336c1f4-57e1-33a1-a82d-e10de7ade627",
                        "source_sense_id": "a2d92d10-2475-31bc-8a92-d6974080c3e3",
                        "source_sense_description": "Eigenschaft, ausgezeichnet/sehr gut zu sein",
                        "target_lang_word": "excellence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excellence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98c25bd6-a17a-3826-bea5-595395640676",
                                        "entry_id": "c31ced41-fad8-35e3-8e1e-448cf8543312",
                                        "glosses": [
                                            "Degré élevé de qualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e774127-4e74-492d-b9e7-c60b88fa6b15",
                                                "sense_id": "98c25bd6-a17a-3826-bea5-595395640676",
                                                "text": "En quoi consiste l’excellence de cette musique, de cette comédie, de ce livre ?"
                                            },
                                            {
                                                "example_id": "d6346e95-4fdd-4fd3-a110-ea0829b245fc",
                                                "sense_id": "98c25bd6-a17a-3826-bea5-595395640676",
                                                "text": "L’excellence d’un fruit, d’un vin, d’un mets, d’un remède."
                                            },
                                            {
                                                "example_id": "9f784371-a617-47dd-9246-51a615fec41a",
                                                "sense_id": "98c25bd6-a17a-3826-bea5-595395640676",
                                                "text": "L’opinion de Rabbi Hillel comporte une méfiance à l’égard de l’idée messianique, à l’égard de la rédemption par le Messie : Israël attend une excellence plus grande que celle qui consisterait à être sauvé par un Messie."
                                            },
                                            {
                                                "example_id": "e3c7c812-896a-44c5-a01e-3d513c5e20e7",
                                                "sense_id": "98c25bd6-a17a-3826-bea5-595395640676",
                                                "text": "L'éloge des nouvelles liaisons nodales, qu'entonnent imperturbablement Deleuze et Guattari, mettait des mots-clés à disposition de l’innovationnisme d'une industrie de la consultation agissant à l'échelle mondiale, mots qui tournent depuis autour de notions creuses comme « créativité », « invention », « excellence » et « incentive »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "808393de-b0e0-387e-bcf6-24e79a02b713",
                                        "entry_id": "c31ced41-fad8-35e3-8e1e-448cf8543312",
                                        "glosses": [
                                            "Appellation honorifique qu’on donne aux ambassadeurs, aux archevêques et évêques, et à certains autres prélats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813879f7-2b8e-40a5-8534-126b2c519221",
                                                "sense_id": "808393de-b0e0-387e-bcf6-24e79a02b713",
                                                "text": "J’ai exécuté les ordres de Votre Excellence."
                                            },
                                            {
                                                "example_id": "04a877f5-87e7-44c7-97ae-196867873ea0",
                                                "sense_id": "808393de-b0e0-387e-bcf6-24e79a02b713",
                                                "text": "Audition de M. Andrija Mandic, président du Parlement du Monténégro, et de Son Excellence Ivan Ivanišević, ambassadeur du Monténégro en France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae4b0886-83c7-4b15-bd50-63f6ffe8145f",
                        "source_entry_id": "0336c1f4-57e1-33a1-a82d-e10de7ade627",
                        "source_sense_id": "a2d92d10-2475-31bc-8a92-d6974080c3e3",
                        "source_sense_description": "Eigenschaft, ausgezeichnet/sehr gut zu sein",
                        "target_lang_word": "perfection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Qualité de ce qui est parfait dans son genre."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd7405e-d47a-48c4-be41-b3257229ee64",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "— Elle garde mes vaches, fait le beurre et les fromages à la crème dans la perfection."
                                            },
                                            {
                                                "example_id": "aafe1b27-15c3-4578-b483-57c0ad38dfc5",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "C'est pour cela que les catalogues illustrés sur les expositions ont toujours été des entreprises sans lendemain, malgré la perfection des gravures."
                                            },
                                            {
                                                "example_id": "843f2590-bae8-43fa-956b-00bd64420549",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "Il faut aspirer à la perfection."
                                            },
                                            {
                                                "example_id": "c3cb0580-8bd4-4cec-873e-5d70377745e0",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "Il est difficile d’atteindre, d’arriver à la perfection."
                                            },
                                            {
                                                "example_id": "d47ff970-1128-4f2d-8d05-c9207fe6e554",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "Donner à un ouvrage toute la perfection dont il est susceptible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "L’état le plus accompli de la vie religieuse."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dae065ee-3db6-470e-9f3c-84517b7fb5f2",
                                                "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                                "text": "Le quiétisme […] érigeait en système et posait avec franchise comme suprême perfection l’état d'immobilité et d’impuissance où l'âme parvient à la longue quand elle abdique son activité."
                                            },
                                            {
                                                "example_id": "28a90498-592f-4b0b-b3c6-3c10e688deac",
                                                "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                                "text": "Nous croyons avoir assez fait comprendre quʼil y a de sortes de perfections pour la langue internationale : l’une vraie, faite des qualités qui répondent amplement au rôle de l’organe. Celle-là, l’Esperanto la possède, et la pratique le prouve tous les jours. L’autre, fictive et trompeuse, loin de répondre à la fin de l’idiome, y nuit au contraire plus ou moins, selon qu’elle s’éloigne peu ou beaucoup des qualités que la langue internationale doit posséder pour tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d729a356-4af6-3daa-af27-1ea5ac596e48",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Qualités excellentes, soit de l’âme, soit du corps."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4bdeea-94a9-483b-93ad-e8cfdf9ac0f4",
                                                "sense_id": "d729a356-4af6-3daa-af27-1ea5ac596e48",
                                                "text": "Être doué de toute sorte de perfections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce07108f-66cf-34cd-87da-03fe712483a0",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "État parfait."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3edd1fc-25f8-4da4-822f-18c2185f63b2",
                                                "sense_id": "ce07108f-66cf-34cd-87da-03fe712483a0",
                                                "text": "Les perfections divines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9997cf-1683-3cf4-8015-92a1f8dd6c5c",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Être, chose qui a toutes les qualités."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e56d26a-26ed-4d86-9953-991797bc7fd0",
                                                "sense_id": "8a9997cf-1683-3cf4-8015-92a1f8dd6c5c",
                                                "text": "Cette personne est une perfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474f900f-c7e6-3b6d-be42-54b548d1f138",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Achèvement."
                                        ],
                                        "tags": [
                                            "Quelquefois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d594d7-2c65-477e-af2e-8987cfc6ddbe",
                                                "sense_id": "474f900f-c7e6-3b6d-be42-54b548d1f138",
                                                "text": "Il faut porter cet ouvrage à sa perfection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
