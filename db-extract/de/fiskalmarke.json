                ],
                "senses": [
                    {
                        "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                        "entry_id": "4aeb1807-953f-34ea-b170-1a24a7d6458d",
                        "glosses": [
                            "Marke (Wertzeichen) als Nachweis für eine beglichene Forderung, ausgenommen Briefmarken/Postwertzeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2801f5-6da6-42bc-95e6-e9decdd50048",
                                "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                                "text": "„Neben Deutsch-Südwestafrika war Deutsch-Ostafrika eine von nur zwei deutschen Kolonien, die eigene Fiskalmarken herausgegeben haben.“"
                            },
                            {
                                "example_id": "3d52a4fd-cdd0-4199-9484-bef6a56f02cf",
                                "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                                "text": "„Die FAI erforscht weiter den Einsatz von Stempelmaschinen, die Militärpostgeschichte, die Zensur- und Kriegsgefangenenpost, die irischen Ganzsachen, die Internationalen Antwortscheine und die Fiskalmarken.“"
                            },
                            {
                                "example_id": "5da5bd59-9fd5-4b08-a0b3-57ae793138d3",
                                "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                                "text": "„Nachdem Champion zwei Jahre später seinen Briefmarkenhandel gekauft hatte, spezialisierte sich Forbin auf Fiskalmarken.“"
                            },
                            {
                                "example_id": "6009476f-f8fb-4125-af5d-67c7c2f651df",
                                "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                                "text": "„Bei ‚Stamp Duty‘ Marken [sic!] handelt es sich um Stempelmarken. Sie sind auch unter den Namen Steuer-, Gebühren- oder Fiskalmarken bekannt und dienen zur Verrechnung von Gebühren oder Steuern.“"
                            },
                            {
                                "example_id": "b99ae663-7205-4bf7-a762-83e1713650c1",
                                "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                                "text": "„Herausgeber von Werbemarken, Gebührenmarken, Fiskalmarken, Vignetten waren nicht nur gemeindliche Verwaltungen oder Firmen, sondern auch Finanzämter, Sportvereine, Verkehrsvereine oder Wandervereine, um nur eine kleine Auswahl anzusprechen.“"
                            },
                            {
                                "example_id": "118aeae9-7600-414a-b915-56cb7a745119",
                                "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                                "text": "„Martin Bär arbeitet an einem neuen Perfins-Katalog und hat sich nur wenig um Fiskalmarken kümmern können.“"
                            },
                            {
                                "example_id": "cccdd40b-98d3-44f1-86a8-baae2eacbc17",
                                "sense_id": "b166b609-03e4-32fc-9216-73caae3af967",
                                "text": "„Als Sammelobjekte finden sie aber noch immer ihre Liebhaber, auch wenn sie längst nicht so häufig gesammelt werden wie Briefmarken oder Fiskalmarken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
