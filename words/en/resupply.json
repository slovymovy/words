{
    "word_family": [
        "supply",
        "supplier",
        "suppliable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1febd621-74c7-3e0f-a224-8ede50dda74c",
                    "sense_definition": "To provide or stock up on necessary items or materials again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "replenishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to <w>resupply</w> their water bottles at the stream before continuing the long trek.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось <w>пополнить запасы</w> воды в бутылках у ручья, прежде чем продолжить долгий поход."
                            }
                        },
                        {
                            "text": "It is essential to <w>resupply</w> the remote research station with fresh food every two weeks.",
                            "target_lang_translations": {
                                "ru": "Крайне важно каждые две недели <w>снабжать</w> отдаленную исследовательскую станцию свежими продуктами."
                            }
                        }
                    ],
                    "synonyms": [
                        "restock",
                        "replenish",
                        "refill"
                    ],
                    "antonyms": [
                        "deplete",
                        "exhaust"
                    ],
                    "common_phrases": [
                        "resupply the station",
                        "resupply with food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова обеспечивать или пополнять запасы необходимых предметов или материалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пополнять запасы",
                                "target_lang_sense_clarification": "общий термин для восполнения ресурсов"
                            },
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать необходимым повторно"
                            },
                            {
                                "target_lang_word": "дозаправлять",
                                "target_lang_sense_clarification": "в контексте воды или топлива"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fca8aba3-e5ec-36aa-8316-45a0f744e372",
                    "sense_definition": "The act or process of providing new stocks of something that has been used up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "replenishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military mission was delayed because the cargo <w>resupply</w> did not arrive on schedule.",
                            "target_lang_translations": {
                                "ru": "Военная миссия была отложена, так как <w>пополнение запасов</w> груза не прибыло по расписанию."
                            }
                        },
                        {
                            "text": "NASA scheduled a regular <w>resupply</w> mission to ensure the astronauts had enough oxygen and tools.",
                            "target_lang_translations": {
                                "ru": "НАСА запланировало регулярную миссию по <w>снабжению</w>, чтобы обеспечить астронавтов достаточным количеством кислорода и инструментов."
                            }
                        }
                    ],
                    "synonyms": [
                        "replenishment",
                        "restocking"
                    ],
                    "common_phrases": [
                        "cargo resupply",
                        "emergency resupply",
                        "resupply mission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс предоставления новых запасов чего-либо взамен израсходованного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пополнение запасов",
                                "target_lang_sense_clarification": "процесс восполнения"
                            },
                            {
                                "target_lang_word": "снабжение",
                                "target_lang_sense_clarification": "деятельность по доставке ресурсов"
                            },
                            {
                                "target_lang_word": "доставка припасов",
                                "target_lang_sense_clarification": "конкретное действие по подвозу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbc744ae-51ee-3705-8e8c-d6ad6015df0f",
                    "sense_definition": "A collection or package of materials intended to replace what has been consumed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "replenishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>resupply</w> contained enough medical bandages and antibiotics to last the clinic for a month.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>партия припасов</w> содержала достаточно медицинских бинтов и антибиотиков, чтобы клинике хватило на месяц."
                            }
                        },
                        {
                            "text": "The pilot dropped a <w>resupply</w> from the aircraft to the stranded explorers below.",
                            "target_lang_translations": {
                                "ru": "Пилот сбросил <w>груз снабжения</w> с самолета застрявшим внизу исследователям."
                            }
                        }
                    ],
                    "synonyms": [
                        "provisions",
                        "rations"
                    ],
                    "common_phrases": [
                        "receive a resupply",
                        "medical resupply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор или партия материалов, предназначенных для замены того, что было потреблено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партия припасов",
                                "target_lang_sense_clarification": "конкретный груз или посылка"
                            },
                            {
                                "target_lang_word": "груз снабжения",
                                "target_lang_sense_clarification": "материалы для восполнения нужд"
                            },
                            {
                                "target_lang_word": "провизия",
                                "target_lang_sense_clarification": "в контексте еды и медикаментов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}