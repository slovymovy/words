                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette suite cinématographique n'est malheureusement qu'un pâle <w>reflet</w> du film à succès d'origine."
