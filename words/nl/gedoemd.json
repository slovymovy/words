                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "voué",
                                "target_lang_sense_clarification": "utilisé pour exprimer une destination inévitable, souvent négative"
                            },
                            {
                                "target_lang_word": "condamné",
                                "target_lang_sense_clarification": "utilisé pour exprimer une fatalité ou une issue sans espoir"
