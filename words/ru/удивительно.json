                        {
                            "text": "Этот десерт был <w>удивительно</w> вкусным и нежным.",
                            "target_lang_translations": {
                                "en": "This dessert was <w>amazingly</w> tasty and tender.",
                                "nl": "Dit dessert was <w>verrassend</w> lekker en zacht.",
                                "pl": "Ten deser był <w>zadziwiająco</w> smaczny i delikatny.",
                                "de": "Dieses Dessert war <w>erstaunlich</w> lecker und zart.",
                                "fr": "Ce dessert était <w>étonnamment</w> savoureux et tendre.",
                                "it": "Questo dessert era <w>sorprendentemente</w> gustoso e delicato.",
                                "cs": "Tento dezert byl <w>překvapivě</w> chutný a jemný.",
                                "tr": "Bu tatlı <w>şaşırtıcı derecede</w> lezzetli ve yumuşaktı.",
                                "es": "Este postre estaba <w>sorprendentemente</w> rico y tierno.",
                                "zh": "这道甜点<w>非常</w>美味且口感细腻。"
                            }
                        },
                        {
                            "text": "Мы добрались до дома <w>удивительно</w> быстро.",
                            "target_lang_translations": {
                                "en": "We got home <w>surprisingly</w> fast.",
                                "nl": "We waren <w>verrassend</w> snel thuis.",
                                "pl": "Dotarliśmy do domu <w>zadziwiająco</w> szybko.",
                                "de": "Wir sind <w>erstaunlich</w> schnell nach Hause gekommen.",
                                "fr": "Nous sommes rentrés à la maison <w>étonnamment</w> vite.",
                                "it": "Siamo arrivati a casa <w>sorprendentemente</w> in fretta.",
                                "cs": "Domů jsme se dostali <w>překvapivě</w> rychle.",
                                "tr": "Eve <w>şaşırtıcı derecede</w> hızlı vardık.",
                                "es": "Llegamos a casa <w>sorprendentemente</w> rápido.",
                                "zh": "我们<w>格外</w>快地回到了家。"
                            }
                        }
                    ],
