                    {
                        "sense_id": "35723396-5f2d-38e1-a032-4552e9475c57",
                        "entry_id": "48271bcf-e81b-3c33-8b82-6a877f005f1a",
                        "glosses": [
                            "Qui contient de la paille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5620e817-0303-4b2f-865b-bf947e0bb934",
                                "sense_id": "35723396-5f2d-38e1-a032-4552e9475c57",
                                "text": "Les fumiers frais ou paillus sont préférables dans les terrains argileux ; ils les divisent, et les rendent plus pénétrables à l’humidité et à l’air."
                            },
                            {
                                "example_id": "ef6e3da2-4f1e-4a14-8ce3-d28c97917541",
                                "sense_id": "35723396-5f2d-38e1-a032-4552e9475c57",
                                "text": "Le jeu durait depuis longtemps, mais nul ne s’en montrait fatigué, bien que les visages fussent en feu, les cheveux ébouriffés et les habits hérissés d’aiguilles paillues."
                            },
                            {
                                "example_id": "cb99ae63-26af-4d61-be5e-86a1259b874a",
                                "sense_id": "35723396-5f2d-38e1-a032-4552e9475c57",
                                "text": "Il récupéra du bois sec, bouchonna une poignée d’herbe paillue et fit un feu pour cuire son repas."
                            }
                        ]
                    }
                ],
