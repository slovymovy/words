                        "examples": [
                            {
                                "example_id": "231fa55f-6796-4b7c-bd8a-9cdaca76c181",
                                "sense_id": "0780c540-ba16-3873-8493-6863c7d91c36",
                                "text": "„Es macht ihm anscheinend nichts aus, daß er zum Frühstück Kaffee-Ersatz trinken und sich beim Abendessen mit Schwarzbrot in Wasser begnügen muß.“"
                            },
                            {
                                "example_id": "a9ed3da1-0585-4888-b7a7-9339087d657f",
                                "sense_id": "0780c540-ba16-3873-8493-6863c7d91c36",
                                "text": "„Eine Frau verlangte ein Schwarzbrot, und ein Mädchen etwas Kuchen, und dann waren keine Kunden mehr im Laden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
