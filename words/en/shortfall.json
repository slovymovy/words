{
    "word_family": [
        "short",
        "fall"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "945da834-64d0-3e93-ba4a-682c7be132ef",
                    "sense_definition": "An instance of falling short, of not meeting a quota, an obligation, or more generally any expected target.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deficit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Due to a <w>shortfall</w> in revenue, we will have to make some cuts.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>дефицита</w> доходов нам придется пойти на некоторые сокращения."
                            }
                        },
                        {
                            "text": "The company had to face a budget <w>shortfall</w> at the end of the fiscal year.",
                            "target_lang_translations": {
                                "ru": "В конце финансового года компании пришлось столкнуться с бюджетным <w>дефицитом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "deficit",
                        "shortage",
                        "deficiency"
                    ],
                    "antonyms": [
                        "surplus",
                        "excess"
                    ],
                    "common_phrases": [
                        "budget shortfall",
                        "revenue shortfall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай невыполнения нормы, обязательства или недостижения ожидаемой цели; нехватка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефицит",
                                "target_lang_sense_clarification": "превышение расходов над доходами, нехватка ресурсов"
                            },
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "недостаток чего-либо необходимого"
                            },
                            {
                                "target_lang_word": "недостача",
                                "target_lang_sense_clarification": "недостающее количество денег или товаров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b91570a9-a3e6-3a9f-ba59-1046816fc474",
                    "sense_definition": "The amount by which a quota, obligation, or expected target was missed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deficit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government promised to cover the <w>shortfall</w> with a new grant.",
                            "target_lang_translations": {
                                "ru": "Правительство пообещало покрыть <w>нехватку</w> средств за счет нового гранта."
                            }
                        },
                        {
                            "text": "We need to find a way to make up the <w>shortfall</w> of ten thousand dollars.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти способ компенсировать <w>недостачу</w> в десять тысяч долларов."
                            }
                        }
                    ],
                    "synonyms": [
                        "deficit",
                        "gap"
                    ],
                    "antonyms": [
                        "surplus"
                    ],
                    "common_phrases": [
                        "cover the shortfall",
                        "make up the shortfall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма или объем, на которые не была выполнена квота, обязательство или ожидаемая цель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефицит",
                                "target_lang_sense_clarification": "недостающая сумма денег или объем ресурсов"
                            },
                            {
                                "target_lang_word": "недостача",
                                "target_lang_sense_clarification": "выявленный дефицит, нехватка определенной суммы"
                            },
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "недостающая разница в средствах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}