                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0d28840-beea-3f95-bea7-7d3723eee1aa",
                        "entry_id": "a223b0f9-f0fd-311b-8ef5-5d88c9c95874",
                        "glosses": [
                            "устар. слуга в частном доме, при гостинице и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0111516-5766-4aa7-a299-906ea39977e1",
                                "sense_id": "b0d28840-beea-3f95-bea7-7d3723eee1aa",
                                "text": "Дочь с гувернанткой и лакеем пошли в Летний сад."
                            },
                            {
                                "example_id": "7fa6375f-0f83-412e-8c99-ddafb925e7a3",
                                "sense_id": "b0d28840-beea-3f95-bea7-7d3723eee1aa",
                                "text": "Входит коридорный лакей-старик и спрашивает, если ли у меня постельное бельё."
                            }
                        ]
                    },
                    {
                        "sense_id": "d060588b-d454-3f86-873a-4393be3e7d8b",
                        "entry_id": "a223b0f9-f0fd-311b-8ef5-5d88c9c95874",
                        "glosses": [
                            "перен. чрезмерно услужливый, раболепствующий человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5365348b-e5ed-4153-9f79-3758133f0d01",
                                "sense_id": "d060588b-d454-3f86-873a-4393be3e7d8b",
                                "text": "взгляд вверх формирует гордость духа, тогда как поклоны рождают лакеев."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29f2e5d8-a02d-4efd-a817-aaafc831edf9",
                        "source_entry_id": "a223b0f9-f0fd-311b-8ef5-5d88c9c95874",
                        "source_sense_description": "слуга",
                        "target_lang_word": "lackey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lackey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57030b33-863e-3965-8bea-fd6282539c21",
                                        "entry_id": "fa1611fc-e319-3e4c-a278-707e9bf31ccc",
                                        "glosses": [
                                            "A footman, a liveried male servant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7da5c3e-65f2-4a3b-9263-39a954a1ad4d",
                                                "sense_id": "57030b33-863e-3965-8bea-fd6282539c21",
                                                "text": "My dearest father,—I say nothing of them,—but I dare to speak of myself,—I can never be a monk,—if that is your object—spurn me,—order your lacqueys to drag me from this carriage,—leave me a beggar in the streets to cry “fire and water,”—but do not make me a monk."
                                            },
                                            {
                                                "example_id": "77827604-cf7b-42cb-8a9c-0a37f30fa989",
                                                "sense_id": "57030b33-863e-3965-8bea-fd6282539c21",
                                                "text": "St. Martin [of Tours] looks round, first, deliberately;—becomes aware of a tatterdemalion and thirsty-looking soul of a beggar at his chair side, who has managed to get his cup filled somehow, also—by a charitable lacquey. St. Martin turns his back on the Empress, and hobnobs with him!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366b0de9-74a5-3b28-9f4f-8456ce33672d",
                                        "entry_id": "fa1611fc-e319-3e4c-a278-707e9bf31ccc",
                                        "glosses": [
                                            "A fawning, servile follower."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lackey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "668ec693-8397-3e2d-85f6-cd5ec8f42b9a",
                                        "entry_id": "f0262200-237d-30bc-9e32-354feb807c68",
                                        "glosses": [
                                            "To attend, wait upon, serve obsequiously."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fe561e9-44a7-4872-83c4-613a304039d3",
                                                "sense_id": "668ec693-8397-3e2d-85f6-cd5ec8f42b9a",
                                                "text": "[T]he ebbed man, ne'er loved till ne'er worth love,\nComes deared by being lacked. This common body,\nLike to a vagabond flag upon the stream,\nGoes to and back, lackeying the varying tide,\nTo rot itself with motion."
                                            },
                                            {
                                                "example_id": "40dab9ff-c5b1-4deb-9487-074299c43b10",
                                                "sense_id": "668ec693-8397-3e2d-85f6-cd5ec8f42b9a",
                                                "text": "So dear to Heav'n is Saintly chastity,\nThat when a soul is found sincerely so,\nA thousand liveried Angels lacky her […]",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9571f38-43df-3159-b04a-147f52a10f46",
                                        "entry_id": "f0262200-237d-30bc-9e32-354feb807c68",
                                        "glosses": [
                                            "To toady, play the flunky."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38b144d8-27b7-4ad7-8b40-f15025f6927b",
                        "source_entry_id": "a223b0f9-f0fd-311b-8ef5-5d88c9c95874",
                        "source_sense_description": "слуга",
                        "target_lang_word": "laquais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laquais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b67cbba8-77f1-3951-94a5-56b6e0938762",
                                        "entry_id": "e5ca81f7-9d14-3ee0-8f75-68a3d0c135d7",
                                        "glosses": [
                                            "Valet de livrée, destiné principalement à suivre son maître ou sa maîtresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0b527c-30d3-494f-8208-be35bf6b0df1",
                                                "sense_id": "b67cbba8-77f1-3951-94a5-56b6e0938762",
                                                "text": "Il jeta les rênes au laquais à cheval qui suivait sa voiture, et descendit pour prendre dans ses bras une jeune fille."
                                            },
                                            {
                                                "example_id": "e591f0d9-5374-4539-9f06-d2cdea6fb3fe",
                                                "sense_id": "b67cbba8-77f1-3951-94a5-56b6e0938762",
                                                "text": "De Mouy descendit de cheval, jeta la bride aux mains de son laquais, s’achemina vers le guichet, se fit reconnaître de la sentinelle."
                                            },
                                            {
                                                "example_id": "c4210088-492d-45e4-9b3b-bf6d3000cbb4",
                                                "sense_id": "b67cbba8-77f1-3951-94a5-56b6e0938762",
                                                "text": "[…]; la domesticité nobiliaire était fort recherchée, et il ne faudrait pas conclure que l’instruction musicale fût assez répandue à cette époque pour que tous les laquais jouassent du violon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a409e7f4-1c82-3d09-b20c-068b1254a50b",
                                        "entry_id": "e5ca81f7-9d14-3ee0-8f75-68a3d0c135d7",
                                        "glosses": [
                                            "Personne servile, sans vergogne, sans honneur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df4c36a7-5a7f-4aaf-a9a3-3995b2fd82f3",
                                                "sense_id": "a409e7f4-1c82-3d09-b20c-068b1254a50b",
                                                "text": "Accoutumé aux pires calomnies, et dédaigneux de leur sottise, il avait pris son parti d'avance des interprétations mesquines ou sordides, habituelles aux libéraux et conservateurs, qui sont les laquais des démocrates."
                                            },
                                            {
                                                "example_id": "74ced3d8-c19a-49c5-bde1-45584233b503",
                                                "sense_id": "a409e7f4-1c82-3d09-b20c-068b1254a50b",
                                                "text": "Pour troubler à nouveau le pays, pour salir notre armée, il fallait donc susciter un nouveau laquais du capitalisme, un homme qui léchât les bottes des juifs et proclamât l’innocence de Dreyfus."
                                            },
                                            {
                                                "example_id": "3f7e2c7b-2ed1-4356-ac7a-e99cdb603b08",
                                                "sense_id": "a409e7f4-1c82-3d09-b20c-068b1254a50b",
                                                "text": "Jamais n’avait-on vu un président dénoncer aussi ouvertement et même défier les décisions de juges, transformer de fond en comble l’état fédéral et imposer ses laquais dans tous les domaines:"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laquais",
                                "target_lang_code": "fr",
                                "target_senses": [
