                                            {
                                                "example_id": "3a8973ef-9c9f-4625-a4bb-1dfc4f8733b0",
                                                "sense_id": "72e0653a-f220-3cfe-9c7c-de803d0e8549",
                                                "text": "Ich habe Medizin studiert."
                                            },
                                            {
                                                "example_id": "8a502867-0912-4a2f-a742-910cb23ae007",
                                                "sense_id": "72e0653a-f220-3cfe-9c7c-de803d0e8549",
                                                "text": "Immer weniger junge Menschen studieren."
                                            },
                                            {
                                                "example_id": "47898bd0-7b51-46c0-b600-da757b500afa",
                                                "sense_id": "72e0653a-f220-3cfe-9c7c-de803d0e8549",
                                                "text": "Sabine studiert seit vier Semestern Psychologie und Soziologie in Wien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e069602-c18a-37de-84a9-7430060009cb",
                                        "entry_id": "d04ed4f9-c1b8-39e5-a9f1-994dac4b3e4f",
                                        "glosses": [
                                            "(etwas) genau/aufmerksam lesen, um den Inhalt zu erfahren, um sich zu informieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f4d3520-6578-4197-8881-b660bfe4124f",
                                                "sense_id": "1e069602-c18a-37de-84a9-7430060009cb",
                                                "text": "Sie studierte lange die Speisekarte, bestellte dann aber nur eine Cola."
                                            },
                                            {
                                                "example_id": "8532f86c-252b-455d-bd79-aac71b29ef75",
                                                "sense_id": "1e069602-c18a-37de-84a9-7430060009cb",
                                                "text": "„Hat Michael das Gerät schon zum Laufen gebracht?“ – „Nein, er studiert noch die Bedienungsanleitung!“"
                                            }
                                        ],
