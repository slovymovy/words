    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cae74853-9789-36fd-8d86-35c23d3b55f3",
                "word": "oppositionist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "785584e1-5f12-4509-8f87-a6bb0dcfd5c8",
                        "entry_id": "cae74853-9789-36fd-8d86-35c23d3b55f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "oppositionists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efe889c5-8e63-35bd-a509-15a1abf316d6",
                        "entry_id": "cae74853-9789-36fd-8d86-35c23d3b55f3",
                        "glosses": [
                            "A person who opposes; especially a member of an official opposition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a58f64-075f-494a-9957-45d9daeda6fa",
                                "sense_id": "efe889c5-8e63-35bd-a509-15a1abf316d6",
                                "text": "They felt that the fellow was a quockerwodger rather than a politician, an againster rather than a true American, an oppositionist in fundamental things rather than a sincere patriot."
                            },
                            {
                                "example_id": "367be9fb-8f69-4731-b58d-9f43d2345016",
                                "sense_id": "efe889c5-8e63-35bd-a509-15a1abf316d6",
                                "text": "I see your marriage as a move to establish links with the oppositionist Russian intelligentsia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7f4f313-c2a9-42ca-a807-462bce1488c5",
                        "source_entry_id": "cae74853-9789-36fd-8d86-35c23d3b55f3",
                        "source_sense_id": "efe889c5-8e63-35bd-a509-15a1abf316d6",
                        "source_sense_description": "a person who opposes; especially a member of an official opposition",
                        "target_lang_word": "opposant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f664f253-b584-3e34-b104-85f89877a3df",
                                        "entry_id": "3bada393-0e9e-357b-9035-efc5a2e77b93",
                                        "glosses": [
                                            "Qui s’oppose suivant les formes judiciaires à une sentence, à un arrêt, à un paiement, à une vente, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c336d8-359c-458c-a6a5-32614de1fc1b",
                                                "sense_id": "f664f253-b584-3e34-b104-85f89877a3df",
                                                "text": "Elle a été reçue opposante."
                                            },
                                            {
                                                "example_id": "86b82b89-ed96-4316-9bef-9f1da40ef282",
                                                "sense_id": "f664f253-b584-3e34-b104-85f89877a3df",
                                                "text": "Il s’est rendu opposant à l’exécution de cet arrêt."
                                            },
                                            {
                                                "example_id": "092d1b1d-d502-4d15-a70f-7410408c1839",
                                                "sense_id": "f664f253-b584-3e34-b104-85f89877a3df",
                                                "text": "Se rendre opposant à la vente d’un immeuble."
                                            },
                                            {
                                                "example_id": "92e04a45-bd00-42a7-b3dc-e1ff48f76007",
                                                "sense_id": "f664f253-b584-3e34-b104-85f89877a3df",
                                                "text": "Conseillé par Vinet, Rogron se rendit opposant à l’homologation de la délibération du Conseil de Famille par le Tribunal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5eacf0-8d2c-35ee-98c6-6cdc9a9e610c",
                                        "entry_id": "3bada393-0e9e-357b-9035-efc5a2e77b93",
                                        "glosses": [
                                            "Se dit de quiconque s’oppose à une mesure, combat une opinion, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e59fd121-6d75-4207-8c2a-d7a840e1f82b",
                                                "sense_id": "6b5eacf0-8d2c-35ee-98c6-6cdc9a9e610c",
                                                "text": "La minorité opposante."
                                            },
                                            {
                                                "example_id": "3a23c411-0b6a-4c19-a42c-380e1c5e6c1f",
                                                "sense_id": "6b5eacf0-8d2c-35ee-98c6-6cdc9a9e610c",
                                                "text": "Le parti opposant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a556c528-ea9e-3787-bacc-f292f2bc32f9",
                                        "entry_id": "3bada393-0e9e-357b-9035-efc5a2e77b93",
                                        "glosses": [
                                            "Qui est en opposition en face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d79b1b4d-ec6f-44c3-a2d4-e143815ca8e3",
                                                "sense_id": "a556c528-ea9e-3787-bacc-f292f2bc32f9",
                                                "text": "Muscle opposant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a39c3878-01f8-3e70-9703-aaffe1e89f1d",
                                        "entry_id": "9f918540-e3bf-3d70-a68e-376f52181b79",
                                        "glosses": [
                                            "Celui qui s’oppose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0214afef-8ccf-4f23-929b-0fa8b0936b83",
                                                "sense_id": "a39c3878-01f8-3e70-9703-aaffe1e89f1d",
                                                "text": "Existe-t-il un type de preuves incontournables qu’il suffirait d’évoquer pour persuader de la justesse de sa position ses opposants les plus tenaces ?"
                                            },
                                            {
                                                "example_id": "1d533041-af00-400a-ac2c-d374408746ca",
                                                "sense_id": "a39c3878-01f8-3e70-9703-aaffe1e89f1d",
                                                "text": "2020 : le principal opposant russe Alexeï Navalny est victime d’un empoisonnement par un agent neurotoxique de type Novitchok."
                                            },
                                            {
                                                "example_id": "f299f2ad-533a-4097-b84e-10b33823c2aa",
                                                "sense_id": "a39c3878-01f8-3e70-9703-aaffe1e89f1d",
                                                "text": "Dès 1933 donc, Kraus parle longuement des préparatifs de guerre de l’Allemagne nazie, de ses visées expansionnistes, de l’antisémitisme affiché et brutal, de la structure préfasciste de la société allemande, des camps de concentration (le premier, Oranienburg, a été ouvert en février 1933, suivi par celui de Dachau en mars de la même année), des tortures, des exécutions sommaires, des sévices perpétrés contre les femmes accusées de « se commettre » avec des Juifs, de la « détention préventive » comme incarcération arbitraire et sans jugement permettant de mettre rapidement les opposants à l’écart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f275d49-ac06-324c-af14-40d99e39e2f8",
                                        "entry_id": "9f918540-e3bf-3d70-a68e-376f52181b79",
                                        "glosses": [
                                            "Quelque chose qui est en opposition, en face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0de5916-1078-4194-9d60-89f242b87291",
                                                "sense_id": "4f275d49-ac06-324c-af14-40d99e39e2f8",
                                                "text": "L’opposant du petit doigt."
                                            },
                                            {
                                                "example_id": "5ed0ee7d-ab42-4505-86ea-0cf90235d9f3",
                                                "sense_id": "4f275d49-ac06-324c-af14-40d99e39e2f8",
                                                "text": "L’opposant du pouce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "278c5992-5be3-342c-abdf-28784aa543b6",
                                        "entry_id": "67d0a712-fcdf-3449-8856-05496588fcf4",
                                        "glosses": [
                                            "Participe présent du verbe opposer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1298cdd6-2090-44ca-99fc-417860d19db3",
                                                "sense_id": "278c5992-5be3-342c-abdf-28784aa543b6",
                                                "text": "Cette conception, pour séduisante qu’elle puisse paraître, ne constitue pas une issue réaliste au débat opposant les tenants de l’universel et du particulier."
                                            },
                                            {
                                                "example_id": "21662027-2b07-4738-8738-6196e0b16dc0",
                                                "sense_id": "278c5992-5be3-342c-abdf-28784aa543b6",
                                                "text": "Une jeune femme découvre le plan de réaménagement de son quartier qui passe par la destruction du fameux bâtiment 5 du titre, qu’elle va tenter de sauver en s’opposant à la municipalité dirigée par un maire ambitieux, incarné par Alexis Manenti, découvert dans Les Misérables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
