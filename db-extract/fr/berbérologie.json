                "senses": [
                    {
                        "sense_id": "25dfdeef-dbfa-32bc-9829-ae146facbb83",
                        "entry_id": "e8011d67-2a73-32c8-bfcd-4436419d5fc9",
                        "glosses": [
                            "Étude scientifique des langues et civilisations berbères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e15b1a19-adf5-47c7-9c34-a90b75537a4c",
                                "sense_id": "25dfdeef-dbfa-32bc-9829-ae146facbb83",
                                "text": "La berbérologie, s’il est permis de forger ce terme, est une science presque uniquement française, ce que l’histoire et la géographie expliquent aisément."
                            },
                            {
                                "example_id": "c299ac92-3fcc-44a5-8bd2-a29974321f99",
                                "sense_id": "25dfdeef-dbfa-32bc-9829-ae146facbb83",
                                "text": "La conjoncture actuelle de la berbérologie, telle que je l’ai esquissée, avantage considérablement les Algériens puisqu’ils sont fort nombreux à avoir un accès facile et quasi-simultané au berbère, à l’arabe et au français, et qu’au surplus, ils sont sur le chantier."
                            },
                            {
                                "example_id": "e8b52496-f07c-4743-8394-aa2aaee7c19d",
                                "sense_id": "25dfdeef-dbfa-32bc-9829-ae146facbb83",
                                "text": "Cette dernière se veut le reflet des recherches en cours au Centre de recherche berbère - chercheurs confirmés, doctorants,...- sans pour autant négliger les activités scientifiques en berbérologie hors de l’INALCO."
                            }
                        ]
                    }
