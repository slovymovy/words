                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e0f7572-ff22-4355-8483-dc73dac2fc2e",
                        "source_entry_id": "bf3e8109-b293-3eb7-b14f-abbe96831440",
                        "source_sense_id": "9a3ab4e3-c7c6-3765-bdd6-3a12e5a6cad1",
                        "target_lang_word": "Leuchter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leuchter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35afe42a-c27d-34d7-88a8-824145a1ff99",
                                        "entry_id": "d69bc148-caf2-31a6-b90d-fe2d59b91381",
                                        "glosses": [
                                            "Gestell/Halter für Kerzen oder Glühbirnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd66386-8f08-40cb-8748-d0a4cbb05c93",
                                                "sense_id": "35afe42a-c27d-34d7-88a8-824145a1ff99",
                                                "text": "Wir müssen einen neuen Leuchter für die großen Kerzen besorgen."
                                            },
                                            {
                                                "example_id": "83ed6436-8a3f-4d4d-bc0d-ca3a202fd39b",
                                                "sense_id": "35afe42a-c27d-34d7-88a8-824145a1ff99",
                                                "text": "„In der russischsprachigen Zeitung hatte meine Mutter gelesen, am dritten Advent werde am Brandenburger Tor ein Chanukkaleuchter angezündet, ein Leuchter aus acht oder neun Kerzen, der zum jüdischen Lichterfest gehört.“"
                                            },
                                            {
                                                "example_id": "8e3809da-8918-47eb-a743-a60f92411205",
                                                "sense_id": "35afe42a-c27d-34d7-88a8-824145a1ff99",
                                                "text": "„Martina wollte mir leuchten; doch die Tante befahl Nanetta, die sie für meine Angebetete hielt, energisch, mir mit dem Leuchter vorauszugehen.“"
                                            },
                                            {
                                                "example_id": "2da85ac6-2027-4eed-863a-b0ab9742c03a",
                                                "sense_id": "35afe42a-c27d-34d7-88a8-824145a1ff99",
                                                "text": "„Diesen Leuchter nahm jetzt Krist vom Kamin und zündete die beiden Wachslichter an, die seit lange schon in den Leuchtertellern steckten und ihrerzeit der verstorbenen Gnädigen zum Siegeln ihrer Briefe gedient hatten.“"
                                            },
                                            {
                                                "example_id": "e330635a-3561-42a5-9345-6263b53e8872",
                                                "sense_id": "35afe42a-c27d-34d7-88a8-824145a1ff99",
                                                "text": "„Sie nahmen den Leuchter, schirmten die Flamme mit einer alten Zeitung gegen den Luftzug ab und gingen an den Beeten entlang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfbf017b-bd01-4f5f-b56d-2f7d19ec3169",
                        "source_entry_id": "bf3e8109-b293-3eb7-b14f-abbe96831440",
                        "source_sense_id": "9a3ab4e3-c7c6-3765-bdd6-3a12e5a6cad1",
                        "target_lang_word": "candlestick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candlestick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff5971f4-82a1-3369-a291-60be960ac424",
                                        "entry_id": "95e1423f-f61f-3743-8521-6109b9b82c33",
                                        "glosses": [
                                            "A holder with a socket or spike for a candle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6192ee4e-1435-4ffa-8b0c-c29f41e308b1",
                                                "sense_id": "ff5971f4-82a1-3369-a291-60be960ac424",
                                                "text": "Neither doe men light a candle, and put it vnder a bushell: but on a candlesticke, and it giueth light vnto all that are in the house."
                                            },
                                            {
                                                "example_id": "39d35feb-c697-46ba-92ef-dfb407d96abd",
                                                "sense_id": "ff5971f4-82a1-3369-a291-60be960ac424",
                                                "text": "Sorcerers and other practitioners of witchcraft used to make a variety of candlestick called the Hand of Glory, chiefly from the flesh of criminals[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f2435ea-4ecb-3d19-af1e-3ab4783c75bb",
                                        "entry_id": "95e1423f-f61f-3743-8521-6109b9b82c33",
                                        "glosses": [
                                            "A gymnastics move in which the legs are pointed vertically upward."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13f9b9e9-14f3-349c-8691-e4cf5c4db2e2",
                                        "entry_id": "95e1423f-f61f-3743-8521-6109b9b82c33",
                                        "glosses": [
                                            "A color-coded bar showing the open and closing prices of a stock on a candlestick chart."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f0a1027-b00e-325a-bdd7-5dd7548ffcaf",
                                        "entry_id": "95e1423f-f61f-3743-8521-6109b9b82c33",
                                        "glosses": [
                                            "The central ignition tube connecting the fuse and charge of a WWI shrapnel shell, shaped like a candle stick."
                                        ],
                                        "tags": [
                                            "British",
                                            "historical",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74949c9e-e6a1-4034-8684-7d78fd9da076",
                                                "sense_id": "8f0a1027-b00e-325a-bdd7-5dd7548ffcaf",
                                                "text": "Inside the shrapnel shell was an iron bar with a flattened, broad nose. When the shell burst in the air this iron object fell to the ground and, since it came often from a great height, its fall was dangerous. The men called these candlesticks, which they much resembled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "candlestick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff4c531-1daa-39e0-ab0c-ab0c4d96bcfa",
                                        "entry_id": "ded2719a-ae66-33d4-a832-0ddfca15ca8d",
                                        "glosses": [
                                            "To catch on fire, so that the chute resembles a tapered candle with a flame on top."
                                        ],
                                        "tags": [
                                            "of a parachute"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a8c074-1362-46da-b9dd-e9ae8524d291",
                                                "sense_id": "6ff4c531-1daa-39e0-ab0c-ab0c4d96bcfa",
                                                "text": "Planes fell in flames, planes fell not in flames. Men fell in flames, men fell safely in their parachutes, some candlesticked."
                                            },
                                            {
                                                "example_id": "50651844-d2cb-43e7-a330-17e9b47bc87e",
                                                "sense_id": "6ff4c531-1daa-39e0-ab0c-ab0c4d96bcfa",
                                                "text": "Archie Jack had a second lucky escape in a later attempt when his pilot, nervous of flying over the high mountain ranges, made him jump out at a much greater altitude than was usual. What initially seemed inconsiderate saved Jack's life as his parachute 'candlesticked', ..."
                                            },
                                            {
                                                "example_id": "1d15f781-7589-43ef-be71-db12928fe3db",
                                                "sense_id": "6ff4c531-1daa-39e0-ab0c-ab0c4d96bcfa",
                                                "text": "Others with chutes aflame candlesticked into the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa0ce1e-b10a-35c0-a600-14efbe6734f5",
                                        "entry_id": "ded2719a-ae66-33d4-a832-0ddfca15ca8d",
                                        "glosses": [
                                            "To analyze stock behavior using Japanese candlestick charts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "232b19f8-24f1-4c90-b4dd-02bbf8a117a8",
                                                "sense_id": "dfa0ce1e-b10a-35c0-a600-14efbe6734f5",
                                                "text": "The other book I would recommend is on a technical evaluation method called “candlesticking.”"
                                            },
                                            {
                                                "example_id": "d8f900e1-41d0-4be8-8691-23aecd98d20b",
                                                "sense_id": "dfa0ce1e-b10a-35c0-a600-14efbe6734f5",
                                                "text": "“You wouldn't happen to be the B. J. Devine who wrote the Devine candlestick formula?” I blurted, not thinking it could be true. Candlesticking is one of the trickier methods of charting stock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcd5b818-9040-3ace-bb60-2472a73b2e82",
                                        "entry_id": "ded2719a-ae66-33d4-a832-0ddfca15ca8d",
                                        "glosses": [
                                            "To adorn with candlesticks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f68bd2-66a2-4e7e-913a-e2ec693be73b",
                                                "sense_id": "bcd5b818-9040-3ace-bb60-2472a73b2e82",
                                                "text": "The Drama's altar isn't on the stage; it is candlesticked and flowered in the box-office."
                                            },
                                            {
                                                "example_id": "237d86e3-3313-4e8f-b195-aa1af8502e30",
                                                "sense_id": "bcd5b818-9040-3ace-bb60-2472a73b2e82",
                                                "text": "3 When I get my room arranged, it will be carpeted, cushioned, curtained (one set crimson dama[s]k, one white), mirrored, silver candlesticked, etc., etc., etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca63f3b8-b2c3-3b3e-85f8-d21312d4d474",
                                        "entry_id": "ded2719a-ae66-33d4-a832-0ddfca15ca8d",
                                        "glosses": [
                                            "To form a tall, thin, tapering shape similar to a candle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e69176ac-4d96-4491-aba6-0a3272d82e8f",
                                                "sense_id": "ca63f3b8-b2c3-3b3e-85f8-d21312d4d474",
                                                "text": "If cut on the individual stems at three-leaf clusters, the cane will \"candlestick.\""
                                            },
                                            {
                                                "example_id": "1bdf6f81-55df-4a12-874d-437148970461",
                                                "sense_id": "ca63f3b8-b2c3-3b3e-85f8-d21312d4d474",
                                                "text": "Initially, the end of the shaft is ragged, but then begins to taper smoothly, exhibiting the \"candlesticking\" or \"pencilling\" referred to in the literature (Fig. 13)."
                                            },
                                            {
                                                "example_id": "e35b6e9f-897f-4250-8afb-ba8313f5b375",
                                                "sense_id": "ca63f3b8-b2c3-3b3e-85f8-d21312d4d474",
                                                "text": "Caught there on a candlesticked overhang of ice, Quaid turned to peer down at his buddy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7f7a7c8-b23e-44ae-a5da-4c9b88d385af",
                        "source_entry_id": "bf3e8109-b293-3eb7-b14f-abbe96831440",
                        "source_sense_id": "9a3ab4e3-c7c6-3765-bdd6-3a12e5a6cad1",
                        "target_lang_word": "chandelier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chandelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                        "entry_id": "010881bb-3429-3aa4-a223-e4c52bc7e4a8",
                                        "glosses": [
                                            "Ustensile servant de support à des chandelles ou à des bougies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5e167e-7291-42d4-85c5-01dbda7bb646",
                                                "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                                "text": "L’homme revint vers la porte, semblant pressé de refouler ces intrus trop curieux, et dédaigneux de ses richesses : des adonis marmoréens, des chandeliers, des meubles."
                                            },
                                            {
                                                "example_id": "e5e84d81-6d0a-419a-bda0-b328bc220d36",
                                                "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                                "text": "Deux bougies de cire jaune se répandaient en nappe sur les chandeliers de cuivre et chauffaient encore l'atmosphère de leur vapeur épaisse."
                                            },
                                            {
                                                "example_id": "6b172f84-115c-4d87-9ebc-24150c5294ff",
                                                "sense_id": "d822515b-60f2-3c2b-a83d-755bb7f2d451",
                                                "text": "Sylvius Hog, à la clarté de son chandelier de terre, relisait attentivement les lignes écrites au dos du billet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77480b6-6d6f-3aee-bb68-afe08b80d454",
                                        "entry_id": "010881bb-3429-3aa4-a223-e4c52bc7e4a8",
                                        "glosses": [
                                            "Troisième personne sur qui deux amoureux illicites font porter les soupçons pour ne pas être inquiétés. Syn. : paravent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8ba5fb-fdac-4b48-bdfe-7ca3020677a3",
                                                "sense_id": "a77480b6-6d6f-3aee-bb68-afe08b80d454",
                                                "text": "Comme il fallait absolument, pour leur propre tranquillité, détourner l'attention des courtisans, ils cherchèrent quelqu'un – quelqu'une plutôt – qui pourrait servir de chandelier. Ce chandelier qu'un certain Alfred de Musset mettra un jour si joliment en scène. Les amoureux passèrent en revue celles qui auraient l'honneur d'attirer l'attention – fictive – de Louis. Madame se méfiait – avec juste raison – d'un trop séduisant « chandelier ». Elle connaissait déjà bien le tempérament infiniment inflammable de son beau-frère, et elle ne voulait pas qu'un simple badinage pût devenir – qui sait? – quelque chose de plus sérieux.\nAprès avoir éliminé les dames ou filles d'honneur trop âgées, trop vilaines – ou trop jolies au goût de Madame – trois d'entre elles restent en lice …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chandelier",
                                "target_lang_code": "fr",
