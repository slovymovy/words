                ],
                "senses": [
                    {
                        "sense_id": "f9d0124c-e3b8-314d-a9bf-2c9a56014168",
                        "entry_id": "ac25baf1-51a4-3218-a50c-32b662a0825c",
                        "glosses": [
                            "Armor for the body, for example a breastplate and backpiece taken together."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "09007aac-0911-35f4-a49c-cc5c7c2d9380",
                        "entry_id": "ac25baf1-51a4-3218-a50c-32b662a0825c",
                        "glosses": [
                            "An entire suit of armor, made up chiefly of the breastplate and backpiece worn with a headpiece and with a gorget, pauldrons, vambraces, gauntlets, and tassets attached."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e16083-50ff-4bfb-8724-98b03f51bf2f",
                                "sense_id": "09007aac-0911-35f4-a49c-cc5c7c2d9380",
                                "text": "Strictly speaking, the word corcelet meant only that part which covered the body, but was generally used to express the whole suit, under the terms of a corselet furnished, or complete."
                            }
                        ]
                    },
                    {
                        "sense_id": "bab93763-7a51-3492-8331-4d101af37714",
                        "entry_id": "ac25baf1-51a4-3218-a50c-32b662a0825c",
                        "glosses": [
                            "A tight-fitting item of clothing which covers the body and not the limbs."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d7b882a1-8dc0-35b2-90c2-4a763e863615",
                        "entry_id": "ac25baf1-51a4-3218-a50c-32b662a0825c",
                        "glosses": [
                            "A type of women's underwear, combining a bra and a girdle in one garment; a corselette."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "17e545cc-d7e6-3b34-a5eb-79806948ea43",
                        "entry_id": "ac25baf1-51a4-3218-a50c-32b662a0825c",
                        "glosses": [
                            "The thorax of an insect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113848cb-7d73-45dd-a261-c8e0c722503e",
                                "sense_id": "17e545cc-d7e6-3b34-a5eb-79806948ea43",
                                "text": "With the added suggestion of her goggles it reminded her pupil of the polished shell or corslet of a horrid beetle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "557cbd2e-bc28-4165-8ee9-410bbabe6791",
