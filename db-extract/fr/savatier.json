                            {
                                "example_id": "9a99cd4b-95b4-4858-b8d9-60d5f7df611a",
                                "sense_id": "94481bab-17dd-3a94-9411-60ac98513d1a",
                                "text": "Le savatier mon voisin n’était pas un maladroit et connaissait les gloires du chausson."
                            },
                            {
                                "example_id": "eb97617a-04ee-48a6-8bc8-d2d4a76b42d3",
                                "sense_id": "94481bab-17dd-3a94-9411-60ac98513d1a",
                                "text": "Pour ne pas être en reste de bonnes manières, nous faisons une ample distribution de coups de pied dans le derrière à ceux qui fourrent leurs doigts dans nos chemises ou se piquent la langue avec nos fourchettes. Et vous, Loti, vous mettez à profit vos talents de savatier, qui sont fort appréciés."
                            }
                        ]
