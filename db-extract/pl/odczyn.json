                                "target_senses": [
                                    {
                                        "sense_id": "bd70efa6-8465-364e-b7a7-163cf19ad496",
                                        "entry_id": "0cd41bb1-28f0-3863-864a-12f86cc1688f",
                                        "glosses": [
                                            "An action or statement in response to a stimulus or other event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064c5789-4340-4bd5-95ed-9e23947ed4a8",
                                                "sense_id": "bd70efa6-8465-364e-b7a7-163cf19ad496",
                                                "text": "The announcement of the verdict brought a violent reaction."
                                            },
                                            {
                                                "example_id": "eabf9d07-1381-467e-b006-73c49763c1de",
                                                "sense_id": "bd70efa6-8465-364e-b7a7-163cf19ad496",
                                                "text": "You were in the courtroom. What is your reaction?"
                                            },
                                            {
                                                "example_id": "b7569efb-fe0e-4142-94d0-dab202a9ded2",
                                                "sense_id": "bd70efa6-8465-364e-b7a7-163cf19ad496",
                                                "text": "When I last tried to eat strawberries I had a terrible allergic reaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b787708b-76fa-3a18-b017-768f97e9a7c7",
                                        "entry_id": "0cd41bb1-28f0-3863-864a-12f86cc1688f",
                                        "glosses": [
                                            "A transformation in which one or more substances is converted into another by combination or decomposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "052bf5bb-4b69-40a5-8360-754b903496d9",
                                                "sense_id": "b787708b-76fa-3a18-b017-768f97e9a7c7",
                                                "text": "In this reaction, the acid and base will neutralize each other, producing a salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2769180e-bd46-38e8-8372-da37d0ff7a6b",
                                        "entry_id": "0cd41bb1-28f0-3863-864a-12f86cc1688f",
                                        "glosses": [
                                            "Reactionary politics; a period in which reactionary thought or politics is resurgent or dominant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e514ebc0-e802-3061-bfcc-241426ac93d7",
                                        "entry_id": "0cd41bb1-28f0-3863-864a-12f86cc1688f",
                                        "glosses": [
                                            "Unpurposeful behavior."
                                        ],
