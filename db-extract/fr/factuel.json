                                                "example_id": "822458d9-d916-48b3-afa4-48729fd400ad",
                                                "sense_id": "ce6138fe-8b3c-3fef-9a70-17562acba14d",
                                                "text": "Dit is een feitelijke erkenning van zijn ongelijk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b3f35f2-7ad4-3b37-bbdd-f81d487306ed",
                                        "entry_id": "111d5dde-7b31-39b2-b903-b132fcd1f48c",
                                        "glosses": [
                                            "eigenlijk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3764865e-7aee-4826-9dbf-9d463008aa8a",
                                                "sense_id": "9b3f35f2-7ad4-3b37-bbdd-f81d487306ed",
                                                "text": "Literatuurwetenschapper en historicus Joep Leerssen laat in zijn werk zien dat ongeacht het culturele domein (taal, literatuur, kunst, geschiedenis, sport) een nationalistisch (sport-)verhaal feitelijk steeds op dezelfde manier tot stand komt."
                                            },
                                            {
                                                "example_id": "228ca964-6200-4c21-8efc-f979a0f2e452",
                                                "sense_id": "9b3f35f2-7ad4-3b37-bbdd-f81d487306ed",
                                                "text": "Het maffe vond ik dat alle Nederlandse makelaars, aannemers en investeerders uitsluitend naar elkaar trokken en ze feitelijk hun netwerkborrels en presentaties dus net zo goed in Meppel of Ermelo hadden kunnen organiseren, maar de Franse Rivièra is blijkbaar een veel betere plek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feitelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fb354294-e9cb-383f-9bfc-7b8e9b34fb6a",
                                        "entry_id": "9813dcfa-f23a-32cc-a663-7b0277b65d11",
                                        "glosses": [
                                            "zo niet op papier dan toch wel in werkelijkheid"
                                        ],
