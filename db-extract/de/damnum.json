                "senses": [
                    {
                        "sense_id": "2d58c74a-293c-383e-bf63-70f20eafaf2b",
                        "entry_id": "c2230bdc-a167-3aa8-88ea-22ebc2320946",
                        "glosses": [
                            "Abschlag vom Nennwert bei der Darlehensgewährung oder Wertpapierausgabe, der als vorab bezahlter Zins gilt"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "ab2f62b8-f7f5-479e-b42f-e653e7e03b31",
                                "sense_id": "2d58c74a-293c-383e-bf63-70f20eafaf2b",
                                "text": "„Die Geldbeschaffungskosten (Schuldzinsen, Bereitstellungszinsen, Damnum) bilden den Löwenanteil der abzugsfähigen Aufwendungen. Bauherren können sogar noch weitergehende Aufwendungen absetzen, wie Baubetreuungs- und Verwaltungsgebühren.“"
                            },
                            {
                                "example_id": "a4f290da-4d9d-4e51-8329-4b6212eceb1d",
                                "sense_id": "2d58c74a-293c-383e-bf63-70f20eafaf2b",
                                "text": "„Über alle Jahre gerechnet, zahlt der Bankkunde zwar die gleichen Kosten wie ohne Damnum, hat aber einen niedrigeren Monatsaufwand und spart obendrein Steuern. Denn das Disagio kann der Käufer oder Bauherr als Anschaffungsnebenkosten sofort steuerlich geltend machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
