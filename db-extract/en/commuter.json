                    {
                        "translation_id": "632cfc52-0036-4f51-9361-fec3ac1d91cd",
                        "source_entry_id": "3441af40-142d-3497-8551-f295f565d8ce",
                        "source_sense_description": "a person who regularly travels to and from work and home",
                        "target_lang_word": "navetteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navetteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                        "entry_id": "14bd07a4-d603-3a1f-9bd3-33135e1780fd",
                                        "glosses": [
                                            "Personne qui fait régulièrement la navette au moyen d’un transport public ou d’un véhicule privé, de son habitation à son lieu de travail au sens strict, ou à son lieu d’étude et d’autres activités au sens large."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc819d43-4c0f-4695-89d9-94debe65f1ac",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "Le navetteur est sur le quai de la gare avec son abonnement à la main."
                                            },
                                            {
                                                "example_id": "acd0d635-0b2c-467a-8bec-bf9de177d96f",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "Que font les navetteurs belges dans les files ?"
                                            },
                                            {
                                                "example_id": "00ad3f64-921d-43c5-ba0e-eb46d82a55d6",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "Paris-Lyon : le TGV a changé la vie des «navetteurs»."
                                            },
                                            {
                                                "example_id": "d60030f6-5c28-4361-80b0-468a1d8b09fb",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "Dans cette étude, un navetteur est un actif en emploi ou un étudiant qui se déplace d’un point à un autre pour aller travailler ou étudier."
                                            },
                                            {
                                                "example_id": "40e7d887-fdcb-4343-beda-a0fed946a063",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "Les liaisons TGV, qui relient de plus en plus de grandes villes en quelques heures, ont fait naître ce que l’on appelle les navetteurs, ces personnes qui sont loin de leur domicile plusieurs jours par semaine, poursuit la sociologue."
                                            },
                                            {
                                                "example_id": "d80ee163-3470-403a-9d95-9c550079d2e5",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "Les navetteurs influencent la dynamique linguistique par la réalisation d’activités publiques à l’extérieur de leur municipalité de résidence."
                                            },
                                            {
                                                "example_id": "eaa9f1ec-f850-46e9-a21e-125eef0a2cb9",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "À Bruxelles, […] on se plaint de la moindre régularité des « navetteurs », […] de leur tendance à demander des horaires spéciaux et à en profiter pour se mettre à l’aise."
                                            },
                                            {
                                                "example_id": "577ce1ee-9db3-4906-b836-4c3b866a3e6c",
                                                "sense_id": "2134e144-91a1-3b80-bb77-8c0484042d55",
                                                "text": "Vu l’époque où la statistique fut dressée (31 décembre), on constate qu’il y a peu de chômage en Belgique parmi la multitude des navetteurs et des semainiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61767d53-2f74-3177-895b-7966d7d36e41",
                                        "entry_id": "14bd07a4-d603-3a1f-9bd3-33135e1780fd",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e47d2468-4549-4a4d-a1c2-508e112610a2",
                                                "sense_id": "61767d53-2f74-3177-895b-7966d7d36e41",
                                                "text": "La broderie compte 130 métiers occupant 130 brodeurs et 300 aides (bobineurs, navetteurs, etc…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4882df3-2307-4dd2-a2af-3f9b8d5394a1",
                        "source_entry_id": "3441af40-142d-3497-8551-f295f565d8ce",
                        "source_sense_description": "a person who regularly travels to and from work and home",
                        "target_lang_word": "pendulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pendulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1524ad3-db88-303e-89cb-88166a1faa7a",
                                        "entry_id": "e026f12d-7e4f-3907-9248-e63bef0c2d7e",
                                        "glosses": [
                                            "Qui se rapporte au pendule, affecté d’un mouvement oscillatoire."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d9d5929-e504-43cc-965d-44f830505ad8",
                                                "sense_id": "e1524ad3-db88-303e-89cb-88166a1faa7a",
                                                "text": "L’éclairage, toujours le même, était mesuré avant chaque séance, de façon à ce que nulle saute d’exposition ne vienne jamais altérer la pureté pendulaire de l’expérience en cours."
                                            },
                                            {
                                                "example_id": "219a1516-0541-44e6-8217-1f2b62131317",
                                                "sense_id": "e1524ad3-db88-303e-89cb-88166a1faa7a",
                                                "text": "Mouvement pendulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0e60c91-a12c-3c17-a7b7-caf1a879366b",
                                        "entry_id": "e026f12d-7e4f-3907-9248-e63bef0c2d7e",
                                        "glosses": [
                                            "Qui oscille sur son axe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd63387-9bf5-4495-89b1-e5bf3f0675e3",
                                                "sense_id": "e0e60c91-a12c-3c17-a7b7-caf1a879366b",
                                                "text": "Le train pendulaire est conçu pour s’incliner dans les courbes de manière à compenser la force centrifuge et maintenir le confort des voyageurs."
                                            },
                                            {
                                                "example_id": "f4c7edb0-e329-4bfa-9e7b-56efb9f27e47",
                                                "sense_id": "e0e60c91-a12c-3c17-a7b7-caf1a879366b",
                                                "text": "Il y a 15 ans, une étude suisse a proposé un train pendulaire entre Lyon et Saint-Étienne. Il s’agit de trains qui peuvent prendre plus vite les courbes, ils sont adaptés aux voies sinueuses et ne sont pas obligés de ralentir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f32616d7-17ee-3f90-92c4-37d384d71f4a",
                                        "entry_id": "e026f12d-7e4f-3907-9248-e63bef0c2d7e",
                                        "glosses": [
                                            "Qui fait un va-et-vient régulier, et en particulier qui se déplace quotidiennement entre le centre et la périphérie urbaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13392519-d144-487e-8f69-fbd9a20e33a7",
                                                "sense_id": "f32616d7-17ee-3f90-92c4-37d384d71f4a",
                                                "text": "La migration pendulaire est un phénomène caractéristique des métropoles et de leurs zones péri-urbaines dû à l’étalement urbain et de la division spatiale des activités, notamment par le zonage."
                                            },
                                            {
                                                "example_id": "4e4d7430-4d24-46fa-9c38-636661152e8d",
                                                "sense_id": "f32616d7-17ee-3f90-92c4-37d384d71f4a",
                                                "text": "Pour moi, en tout cas, les jeudis et les dimanches ne réservaient en guise de divertissement qu’un déplacement pendulaire, de la maison à la classe, de la classe à la maison, juste quelques pas à travers la cour."
                                            },
                                            {
                                                "example_id": "0538c38c-7f91-40ee-8ff3-783889862f5e",
                                                "sense_id": "f32616d7-17ee-3f90-92c4-37d384d71f4a",
                                                "text": "Le convoi a déraillé entre Laces et Castelbello, une ligne utilisée par les étudiants et les travailleurs pendulaires."
                                            },
                                            {
                                                "example_id": "5fdcf4e5-29e4-45b3-85a4-fcd46115aefc",
                                                "sense_id": "f32616d7-17ee-3f90-92c4-37d384d71f4a",
                                                "text": "En plus, ce faisant, on encourage le trafic pendulaire, qui est une vraie plaie dans le monde actuel, au sens où il n’est pas bon pour l’être humain de passer autant de temps de sa vie sur les routes ou dans les transports en commun pour aller au travail ou en revenir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pendulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b27ea098-ae7b-3bce-a87a-6103ee01bbad",
                                        "entry_id": "4abf710a-3d05-3348-a2c1-87018642d0b8",
                                        "glosses": [
                                            "Personne qui fait régulièrement la navette au moyen d’un transport public ou d’un véhicule privé, de son habitation à son lieu de travail au sens strict, ou à son lieu d’étude et d’autres activités au sens large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92dae678-60b1-4ce4-8e03-107269b669eb",
                                                "sense_id": "b27ea098-ae7b-3bce-a87a-6103ee01bbad",
                                                "text": "Il est l’un des innombrables «pendulaires» qui, chaque jour en France, sont contraints de faire l’aller-retour à la capitale pour rejoindre leur travail, suivant le mouvement brownien de l’instrument auquel ils doivent leur surnom dans le jargon ferroviaire."
                                            },
                                            {
                                                "example_id": "0b608e0f-3523-4803-ba24-62d8c18d0e0c",
                                                "sense_id": "b27ea098-ae7b-3bce-a87a-6103ee01bbad",
                                                "text": "Les pendulaires en provenance du Valais et du Chablais ont subi d’importants retards ce matin entre 7 heures 30 et 9 heures 30, en raison d’un accident de personne survenu à Epesses."
                                            },
                                            {
                                                "example_id": "6f69cd75-5100-4fc2-b875-274658ae1a48",
                                                "sense_id": "b27ea098-ae7b-3bce-a87a-6103ee01bbad",
                                                "text": "Des dizaines de milliers de pendulaires, Français, Vaudois et nouveaux «expats» genevois logés en terres voisines, se déversent chaque matin sur la Ville."
                                            },
                                            {
                                                "example_id": "622a1e58-29e7-4f15-8d06-3ae0b33faa50",
                                                "sense_id": "b27ea098-ae7b-3bce-a87a-6103ee01bbad",
                                                "text": "On peut, en effet, concevoir plusieurs catégories de pendulaires : quotidiens, semainiers, saisonniers ; on peut même y ajouter les possesseurs de résidences secondaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5040e0b9-b4ed-3781-8ced-aa03842d398e",
                                        "entry_id": "4abf710a-3d05-3348-a2c1-87018642d0b8",
                                        "glosses": [
                                            "ULM pendulaire, type d’ULM."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b79aa30-1073-4aa5-9684-52bf14370842",
                        "source_entry_id": "3441af40-142d-3497-8551-f295f565d8ce",
                        "source_sense_description": "a person who regularly travels to and from work and home",
                        "target_lang_word": "Pendler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pendler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c49bd3-77cd-37ba-aedf-1b63a029a45b",
                                        "entry_id": "6f9d2331-e6e5-306e-9d21-270abb2c4527",
                                        "glosses": [
                                            "jemand, der regelmäßig mindestens eine Gemeindegrenze überschreiten muss, um von seinem Wohnort an seinen Arbeits- oder Ausbildungsplatz zu gelangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "613ffbe6-05dd-4b34-be77-bc501ea44e9e",
                                                "sense_id": "f0c49bd3-77cd-37ba-aedf-1b63a029a45b",
                                                "text": "Mein Kollege ist Pendler und verbringt jeden Tag über drei Stunden in der Bahn."
                                            },
                                            {
                                                "example_id": "2cdc576b-23a7-4c6c-a184-ae4adf81f7e4",
                                                "sense_id": "f0c49bd3-77cd-37ba-aedf-1b63a029a45b",
                                                "text": "Pendler, die öffentliche Verkehrsmittel und nicht das Auto benutzen, entlasten die Straßen erheblich."
                                            },
                                            {
                                                "example_id": "31f6c611-f3b0-4809-829c-640bae34cbf8",
                                                "sense_id": "f0c49bd3-77cd-37ba-aedf-1b63a029a45b",
                                                "text": "Die britische Hauptstadt steht still. Das Personal der U-Bahnstationen streikt. Ob mit Bussen oder einfach zu Fuß: Millionen Pendler versuchten irgendwie durch die Stadt zu kommen."
