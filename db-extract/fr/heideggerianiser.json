                "senses": [
                    {
                        "sense_id": "87566344-9580-3524-be8b-a71ede524bcc",
                        "entry_id": "b0ba5713-a1dd-3ccb-8235-7c54bbd8cb06",
                        "glosses": [
                            "Donner un caractère heideggerien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db59e9a-0388-404b-adcf-19719019e6b0",
                                "sense_id": "87566344-9580-3524-be8b-a71ede524bcc",
                                "text": "Il a su récapituler un débat très compliqué sans pratiquement jamais heideggerianiser son propos."
                            },
                            {
                                "example_id": "912ccd27-2fb0-44cc-9758-85ed652ec355",
                                "sense_id": "87566344-9580-3524-be8b-a71ede524bcc",
                                "text": "(Bourgeois ne fait pas cela par coquetterie ou pour s'heideggerianiser, il le fait parce que Hegel parle aussi dExistenz, qui est un concept différent, et qu'il faut bien traduire \"existence\")"
                            }
                        ]
                    },
                    {
                        "sense_id": "d026817f-41fc-34bf-a8e5-ef74f8956cd9",
                        "entry_id": "b0ba5713-a1dd-3ccb-8235-7c54bbd8cb06",
                        "glosses": [
                            "Raisonner comme Heidegger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a8a0b2-fc3f-4ea5-a01c-c149d3138f5f",
                                "sense_id": "d026817f-41fc-34bf-a8e5-ef74f8956cd9",
                                "text": "D'ailleurs, quand, dans ses séminaires, un étudiant commençait à \"heideggerianiser\", il l'arrêtait tout de suite."
                            }
                        ]
                    }
