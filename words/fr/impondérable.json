                        "sens des impondérables"
                    ]
                },
                {
                    "sense_id": "512fbf0b-eb5b-308b-a057-b0f0eb29d307",
                    "sense_definition": "Cause morale ou psychologique difficile à évaluer, mais dont l'effet est considérable.",
