                ],
                "senses": [
                    {
                        "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                        "entry_id": "11ea7519-5821-3380-954f-26b1a25a1f5c",
                        "glosses": [
                            "Zimmer, in dem Sportgeräte stehen, an denen man trainiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344b30c6-6a44-410a-b91a-41b53a5cfcc5",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "„Wir trainieren zweimal pro Woche im Fitnessraum.“"
                            },
                            {
                                "example_id": "596f7038-d0b1-4293-bc43-3625cd95292a",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "Nach der Entlassung trainierten die Patienten drei Mal wöchentlich für eineinhalb Stunden im Fitnessraum der Klinik. Drei Monate lang stemmten sie Gewichte, trainierten das Gleichgewicht und machten Ausdauerübungen."
                            },
                            {
                                "example_id": "23e8a948-3646-4373-9b9f-a624d3cde729",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "„In meinem Fitnessraum gibt es ein Spinning- und ein Rudergerät und ein paar Hanteln.“"
                            },
                            {
                                "example_id": "c971f2cb-bc12-494b-9103-3070dd88ce6f",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "Der Wellnessbereich [im Hotel Lürzerhof] umfasst Saunen und Dampfbäder, einen Fitnessraum, ein Hallenbad und einen beheizten Außenpool."
                            },
                            {
                                "example_id": "4970737d-7ff0-4917-9771-01c3c1da320a",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "Das Weiße Haus ist mit Fitnessraum, Tennis- und Basketballplatz, Schwimmbad und Kegelbahn ausgestattet."
                            },
                            {
                                "example_id": "6ef3b469-aa91-415d-bc35-ce9fe440a7cf",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "Was früher der Partykeller war, das wird jetzt zum Fitnessraum oder zur Wellnessoase […]."
                            },
                            {
                                "example_id": "87b718fe-6bd2-4d95-813c-79d7d71d31d7",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "„Ich habe mir im Keller einen Fitnessraum eingerichtet.“"
                            },
                            {
                                "example_id": "a1522ce9-2128-4542-966a-a9da4fdb33c7",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "[Der Polizeihund] Astor zeigt, wie’s geht: Im Fitnessraum der Polizeiakademie soll er Sprengstoff suchen."
                            },
                            {
                                "example_id": "3483ac39-29c7-4c97-9cd1-7c98b92d624d",
                                "sense_id": "9b663757-3a5b-3e4f-b187-15d71be7af3b",
                                "text": "Der 74-Jährige erhängte sich an einem Treppengeländer seines Wohnhauses. Er wurde von seiner Frau gefunden, nachdem er am frühen Morgen nicht aus einem Fitnessraum im Keller zurückgekehrt war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
