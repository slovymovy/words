                "senses": [
                    {
                        "sense_id": "cd79694d-89ec-327b-9c13-bb0e5b4dd5bc",
                        "entry_id": "c2a1099e-c6ed-3940-abeb-27b26b284731",
                        "glosses": [
                            "Teilgebiet der Grammatik, das sich mit dem Aufbau von Wörtern aus Morphemen befasst, besonders mit Flexion und Wortbildung; oft werden auch die Wortarten eingeschlossen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc4d7037-32af-473b-8ebc-c9527b20a725",
                                "sense_id": "cd79694d-89ec-327b-9c13-bb0e5b4dd5bc",
                                "text": "„Bisher haben wir die Morphematik des Verbs getrennt nach den einzelnen grammatischen Kategorien behandelt und nur am Rande die Frage gestreift, wie sich die einzelnen Einheiten zum einheitlichen Verbgefüge zusammenschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
