                                        "entry_id": "09414b16-a454-36cb-91be-152143399aca",
                                        "glosses": [
                                            "A proclamation of joy at Christmas."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "938c7316-8ab0-4d0d-9456-c2fed737931f",
                                                "sense_id": "356e07a7-b8d3-3fef-a27f-a2ab5b1a3ec2",
                                                "text": "In the Countrey churches, at Christmas in the Holy-daies after Prayers, they will dance in the Church, and as they doe dance, they cry (or sing) Yole, Yole, Yole etc."
                                            }
                                        ]
                                    }
