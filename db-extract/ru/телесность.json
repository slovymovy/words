                ],
                "senses": [
                    {
                        "sense_id": "7b650032-9bff-370f-86c8-16bc1bff55f8",
                        "entry_id": "e40f101c-84f4-3ad7-997c-f04a1f6abef1",
                        "glosses": [
                            "нечто вещественное, материальное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e4d8b03-6b78-4a32-8c74-d2345b49546e",
                                "sense_id": "7b650032-9bff-370f-86c8-16bc1bff55f8",
                                "text": "Но упражнения духовные не всегда нас от телесности отвлекают; и для сохранения боков моих пошёл я пешком."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b460eeb-3130-3637-a61a-12960ee5b041",
                        "entry_id": "e40f101c-84f4-3ad7-997c-f04a1f6abef1",
                        "glosses": [
                            "устар. прост. тело [2]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "382737f9-b29d-432f-a523-5b64c8769bf4",
                                "sense_id": "1b460eeb-3130-3637-a61a-12960ee5b041",
                                "text": "Чёрт его знает, что делает это буйволиное молоко, подумал Чик, окончательно забыв о своей теории, объясняющей обилие телесности дочерей тёти Маши."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3b46ec2-7c01-4a04-b281-db1f0bf6e0a9",
                        "source_entry_id": "e40f101c-84f4-3ad7-997c-f04a1f6abef1",
                        "target_lang_word": "corporality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68fb4ad8-4a46-30ec-bf7b-37c0814df6d4",
                                        "entry_id": "a65afd3a-d860-31e9-8be7-a145798a6986",
                                        "glosses": [
                                            "The state of being or having a body (being corporal/corporeal); bodily existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9284c6-b67a-492f-a5a5-f7757ccfa3fb",
                                                "sense_id": "68fb4ad8-4a46-30ec-bf7b-37c0814df6d4",
                                                "text": "there is one Mundane spright / And body, vitall corporality We have from hence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa431e6-6ef3-3a24-a588-09ab1d66f218",
                                        "entry_id": "a65afd3a-d860-31e9-8be7-a145798a6986",
                                        "glosses": [
                                            "A confraternity; a guild."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e4724d6-ca1a-4067-ab5c-ba7bbdbee63f",
                                                "sense_id": "2aa431e6-6ef3-3a24-a588-09ab1d66f218",
                                                "text": "Whence may be guessed what their function was : was it to go about circled with a band of rooking officials , with cloakbags full of citations , and processes to be served by a corporality of griffonlike promoters and apparitors ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60e9b5b5-451b-49cb-af14-93b151008fb5",
                        "source_entry_id": "e40f101c-84f4-3ad7-997c-f04a1f6abef1",
                        "target_lang_word": "physicality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physicality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09c98cb1-a756-3d1d-a375-49e67033bfd6",
                                        "entry_id": "3e0c92de-bd4c-3b54-8511-6b8b882ac05a",
                                        "glosses": [
                                            "Physical attributes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d52984-81f9-4097-a6cf-7994572fe6d3",
                                                "sense_id": "09c98cb1-a756-3d1d-a375-49e67033bfd6",
                                                "text": "Their bodies started to melt, and lost what physicality they had. Pretty soon, all of the test subjects had melted together into … Those."
                                            },
                                            {
                                                "example_id": "9a67316b-ed7e-4f34-b41e-aa03a8d128db",
                                                "sense_id": "09c98cb1-a756-3d1d-a375-49e67033bfd6",
                                                "text": "At the heart of that was McTominay, using his physicality to break down Spanish momentum, and his reading of the game to stymie their attacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a16da1-eb51-32a2-974b-6fd55cb53b0c",
                                        "entry_id": "3e0c92de-bd4c-3b54-8511-6b8b882ac05a",
                                        "glosses": [
                                            "Obsession with physical urges."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
