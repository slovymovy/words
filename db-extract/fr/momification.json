        "fr-extract.jsonl": [
            {
                "entry_id": "64d14f69-eeeb-3839-b307-30cb333518bf",
                "word": "momification",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "577e861c-f168-4bbf-bc61-d0d2b357640f",
                        "entry_id": "64d14f69-eeeb-3839-b307-30cb333518bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "momifications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5be4380e-19d6-3c7c-92a1-f0814ecad337",
                        "entry_id": "64d14f69-eeeb-3839-b307-30cb333518bf",
                        "glosses": [
                            "Action de momifier, ou état d’un cadavre momifié."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "cb5c334a-1f9e-4ac7-ad7a-a49032b7d35d",
                                "sense_id": "5be4380e-19d6-3c7c-92a1-f0814ecad337",
                                "text": "La momification est un procédé funéraire moins fréquent mais largement attesté."
                            },
                            {
                                "example_id": "bd9850fd-764e-4289-a0a7-637de928c44d",
                                "sense_id": "5be4380e-19d6-3c7c-92a1-f0814ecad337",
                                "text": "L’Égypte a dévoilé ce week-end deux ateliers consacrés à la momification d’humains et d’animaux à Saqqarah, dans la nécropole de Memphis, la capitale de l’ancien empire des pharaons."
                            }
                        ]
                    },
                    {
                        "sense_id": "8da3732a-18cf-3a85-8fb6-4080d45d5ccb",
                        "entry_id": "64d14f69-eeeb-3839-b307-30cb333518bf",
                        "glosses": [
                            "Préservation naturelle ou artificielle des tissus mous d’un organisme mort, souvent par dessiccation, froid, sel ou absence de bactéries."
                        ],
                        "tags": [
                            "Taphonomie"
                        ],
                        "examples": [
                            {
                                "example_id": "299cf239-e273-452b-91ac-3e17e444dfa1",
                                "sense_id": "8da3732a-18cf-3a85-8fb6-4080d45d5ccb",
                                "text": "Sauf cas exceptionnels de momification volontaire ou involontaire, les parties dites « molles » ont disparu."
                            },
                            {
                                "example_id": "bf26d60d-4044-49e3-bf02-37ab3870bcda",
                                "sense_id": "8da3732a-18cf-3a85-8fb6-4080d45d5ccb",
                                "text": "Les puits de goudron et tourbières découverts (Californie et Carpates orientales) offrent d’autres conditions favorables aux momifications avec la préservation des tissus organiques mous et cellulaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d621ce0-f2d9-33f3-8655-a60ef9075671",
                        "entry_id": "64d14f69-eeeb-3839-b307-30cb333518bf",
                        "glosses": [
                            "(Sens figuré) Dessèchement, immobilisation d’une entité réelle ou abstraite, bloquée dans un état de mort ou d’absence d’évolution et de développement, comme le connaît la momie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "987ce4cd-91b2-4f7f-a34f-7298099a44dd",
                                "sense_id": "6d621ce0-f2d9-33f3-8655-a60ef9075671",
                                "text": "Or l’écriture, prenons le poème, mais aussi la lettre, permet de sortir la langue de sa momification et d’essayer autre chose : la possibilité de risquer, de s’amuser (oui), de se tromper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be1c8cfe-473f-4574-992b-44e06ad9a2f2",
                        "source_entry_id": "64d14f69-eeeb-3839-b307-30cb333518bf",
                        "target_lang_word": "mummification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
