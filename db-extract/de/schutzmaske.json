                    },
                    {
                        "form_id": "b8173eac-c5d1-4095-b910-f634e0e466f0",
                        "entry_id": "54b074b1-801c-33de-9f83-1f98c5b4bf2e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schutzmasken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                        "entry_id": "54b074b1-801c-33de-9f83-1f98c5b4bf2e",
                        "glosses": [
                            "vor dem Gesicht getragener Gegenstand, der"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49244ac0-f26e-41c7-ae41-cd2cc39d484d",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "In asiatischen Großstädten ist kaum jemand ohne Schutzmaske zu sehen."
                            },
                            {
                                "example_id": "6b73312e-2489-4a7d-b03a-36b5f2b28d5f",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "Um dem Infektionsschutz zu genügen tragen alle Mitarbeiter Schutzmasken."
                            },
                            {
                                "example_id": "ab8e7bf4-0006-4e06-bbbf-3905f8bed2fd",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "In ganz Deutschland fehlen Schutzmasken an allen Ecken und Enden."
                            },
                            {
                                "example_id": "203ad50c-bca8-46ca-8f9d-a3743550d7db",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "„Wegen eines besonders hartnäckigen Grippevirus hat das Genfer Universitätsspital sein Personal angewiesen, nur noch mit Schutzmaske zu arbeiten.“"
                            },
                            {
                                "example_id": "750bd211-d1c2-495a-b43d-67ca7ba9b54c",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "„Experten [empfehlen] für den alltäglichen Gebrauch weiterhin eher Hygienemaßnahmen – also regelmäßiges Händewaschen, Nutzung von Desinfektionsgelen sowie “Hust-Etikette” – als das Tragen einer Schutzmaske.“"
                            },
                            {
                                "example_id": "28fd2a12-6c2b-4054-98b6-98b52357ec33",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "„Im Kampf gegen die Coronavirus-Pandemie müssen die Menschen in Österreich künftig eine Schutzmaske beim Einkaufen tragen.“"
                            },
                            {
                                "example_id": "dad671a0-9b74-44f7-a5a0-db973884116d",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "[Der baden-württembergische] „Ministerpräsident […] plädierte für die Verwendung selbstgenähter einfacher Schutzmasken beim Einkaufen und im öffentlichen Verkehr.“"
                            },
                            {
                                "example_id": "2ad5f489-94f2-41b6-82bd-33328c06eac5",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "„Millionen Schutzmasken, Laboranzüge und Test-Kits wurden in die EU geliefert, und dort vor allem nach Italien, Spanien, Frankreich und Österreich.“"
                            },
                            {
                                "example_id": "3ad0f4cc-2fe7-42d1-a628-c3de8e27b3a8",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "„Um die Abhängigkeit von Lieferungen aus dem Ausland zu minimieren, stellt die Schweiz die Schutzmasken bald selbst her.“"
                            },
                            {
                                "example_id": "01a1a227-83f8-4d5f-aa5d-1aeed405b00c",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "„[…] die Bausoldaten [werden] militärisch gedrillt: Zum Essen müssen sie in Marschformation antreten oder stundenlang am Strand mit Schutzmaske marschieren.“"
                            },
                            {
                                "example_id": "51854594-81b2-4bbb-b6b6-2b135d65e04a",
                                "sense_id": "b539df90-c086-3c05-a689-8d8c32b85de2",
                                "text": "Bruno Preller braucht nicht zu überlegen. «Verdacht auf chemische Kampfstoffe. Sofort Meldung an Gruppenführer und Schutzmaske anlegen!»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98725dd5-14df-3f7c-af2b-9a2e8c7eaf7b",
                        "entry_id": "54b074b1-801c-33de-9f83-1f98c5b4bf2e",
                        "glosses": [
                            "des Trägers Augen, Haut und Lunge schützen soll unter anderem bei handwerklichen Arbeiten (beispielsweise beim Schweißen, Lackieren, Flexen), beim Sport (beispielsweise beim Fechten, Eishockey), bei der Feuerwehr (vor Rauchgasen Funken und Flammen), beim Militär (vor tödlichen Gasen) oder im medizinischen Bereich (vor gefährlichen Krankheiten)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9b42c6a9-c4c8-3baf-a179-fa7c90ef41e5",
                        "entry_id": "54b074b1-801c-33de-9f83-1f98c5b4bf2e",
                        "glosses": [
                            "eine Verbreitung von Viren oder Bakterien durch den Träger an die umgebenden Menschen oder die Raumluft mindern soll"
                        ],
                        "tags": [],
                        "examples": []
                    }
