                "senses": [
                    {
                        "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                        "entry_id": "a5e99e90-1f24-3d1e-adbc-531529107a54",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7010c7-6822-4240-b033-2c678902c3df",
                                "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                                "text": "Frau Helmbold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5f367c92-52a7-4c4f-8bef-694544421d7a",
                                "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                                "text": "Herr Helmbold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d505c38d-5366-4aa7-933b-9f874d41ecb0",
                                "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                                "text": "Die Helmbolds fahren heute nach Kassel."
                            },
                            {
                                "example_id": "49d975e0-3a84-4051-8db6-5dc218513457",
                                "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                                "text": "Der Helmbold trägt nie die Schals, die die Helmbold ihm strickt."
                            },
                            {
                                "example_id": "0ebbd04e-3e5f-4765-af98-2527bc432edd",
                                "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Helmbold kommt, geht der Herr Helmbold.“"
                            },
                            {
                                "example_id": "24cd822f-5efa-4125-89ff-984729799965",
                                "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                                "text": "Helmbold kommt und geht."
                            },
                            {
                                "example_id": "c47b0c52-1945-4072-8d6e-3f53cf63bb26",
                                "sense_id": "e5ff9228-286f-3989-99c4-562d94b1d6c7",
                                "text": "Helmbolds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
