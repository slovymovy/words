                                "target_senses": [
                                    {
                                        "sense_id": "fdf72017-8dc5-3cf3-b834-33ceee57556b",
                                        "entry_id": "af45110a-e4ba-3f77-88fb-975c68b81508",
                                        "glosses": [
                                            "Musikinstrument, bei dem der Ton dadurch erzeugt wird, dass eine in einem Rohr eingeschlossene Luftsäule durch direktes Anblasen (oder Anblasen über einen Blasebalg) in Schwingungen versetzt wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b58e5a-5fac-4f2a-b874-2c9749a4cd87",
                                                "sense_id": "fdf72017-8dc5-3cf3-b834-33ceee57556b",
                                                "text": "Er würde lieber ein Blasinstrument erlernen."
                                            },
                                            {
                                                "example_id": "397ff127-d5b2-44a7-99cf-82b771063e71",
                                                "sense_id": "fdf72017-8dc5-3cf3-b834-33ceee57556b",
                                                "text": "„Wir hören Fanfaren und Blasinstrumente, keine hundert Meter weiter wehen bunte Wimpel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
