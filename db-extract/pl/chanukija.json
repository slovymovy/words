                "senses": [
                    {
                        "sense_id": "6e034dd9-bcb0-31da-aeec-a81241758eee",
                        "entry_id": "8d063c6a-a16b-3497-be02-e71a1a181467",
                        "glosses": [
                            "judaistyczny dziewięcioramienny świecznik zapalany tradycyjnie z okazji Chanuki"
                        ],
                        "tags": [
                            "Jewish"
                        ],
                        "examples": [
                            {
                                "example_id": "81dce773-19fb-44b4-b7a5-26c2fb0c95f2",
                                "sense_id": "6e034dd9-bcb0-31da-aeec-a81241758eee",
                                "text": "W piątek wieczorem zarówno chanukiję, jak i świece szabatowe zapalamy 18 minut przed zachodem słońca"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d090ac85-163c-47be-af2b-5410399884c4",
                        "source_entry_id": "8d063c6a-a16b-3497-be02-e71a1a181467",
                        "source_sense_id": "6e034dd9-bcb0-31da-aeec-a81241758eee",
                        "target_lang_word": "hanukkiah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hanukkiah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                        "entry_id": "f4069dcf-5f96-3705-b5dd-ae397d977191",
                                        "glosses": [
                                            "A nine-branched menorah used during Hanukkah."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f9a490-f1ff-4fa7-9720-1d7d2e04fe32",
                                                "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                                "text": "Some might say that the hanukkiah is decorations, but it isn't; the hanukkiah is a ceremonial object, with specific, non-decorative purposes. Perhaps the Stars of David that many string about are appropriate Jewish decoration?"
                                            },
                                            {
                                                "example_id": "86bab17c-ca8b-476b-b865-f654ec9d103a",
                                                "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                                "text": "As a child of Holocaust survivors, there was nothing, no family relics. The celebration was very modest, with a very small hanukkiah, and my mother was a great maker of latkes. I now luckily have many different kinds of hanukkiahs."
                                            },
                                            {
                                                "example_id": "b2bfc09d-1328-49d2-a6a8-7d9bf9b2cc67",
                                                "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                                "text": "The candelabras lit on Hanukkah are technically called hanukkiahs. They have eight candles plus one more, a shamash, that is used for lighting the others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
