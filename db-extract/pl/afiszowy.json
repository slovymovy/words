                "translations": [
                    {
                        "translation_id": "b5a198fa-505f-4212-b868-a35f5e3f5658",
                        "source_entry_id": "005d3fec-cb98-3822-a1bb-183624e342cb",
                        "source_sense_id": "dd69e1f2-bad4-3c7a-8e2d-0ebf6a177405",
                        "target_lang_word": "Affiche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Affiche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b93cf662-14f7-3eff-8aaa-c57fbc0afceb",
                                        "entry_id": "273f447f-f248-3502-b00f-4c69db14a228",
                                        "glosses": [
                                            "Informationsblatt, das ausgehängt wird"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28cc1407-ebc6-4f57-8bfe-39d6a6624be6",
                                                "sense_id": "b93cf662-14f7-3eff-8aaa-c57fbc0afceb",
                                                "text": "„Die Affichen sind mit hochtrabenden Namen unterfertigt, ›Hochschule für geheime Wissenschaften‹, ›Gelehrte Gesellschaft für okkultes Wissen‹ und so weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e51d4d1-5ec1-4af5-9a6c-c5ae0c66a21d",
                        "source_entry_id": "005d3fec-cb98-3822-a1bb-183624e342cb",
                        "source_sense_id": "dd69e1f2-bad4-3c7a-8e2d-0ebf6a177405",
                        "target_lang_word": "Plakat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plakat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                        "entry_id": "d883adf6-6593-3913-be4c-382a61cbc1cd",
                                        "glosses": [
                                            "ein großes Blatt, mit einem Bild oder Foto mit Informationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9660f6b5-0183-4d9e-b4c1-16851b4088d2",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "In der Werbung werden oft Plakate eingesetzt."
                                            },
                                            {
                                                "example_id": "ae5c95c4-3e8e-4abd-9a39-c3fe78fd787d",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "Auf dem Plakat stehen Ort und Zeit."
                                            },
                                            {
                                                "example_id": "d912b698-3688-4f3f-91c3-08acfceb00c6",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "Die ganze Stadt ist mit Plakaten zugepflastert."
                                            },
                                            {
                                                "example_id": "5e311dc4-5724-49b4-8d4b-986b2cf76b58",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "Plakate Anschlagen verboten."
                                            },
                                            {
                                                "example_id": "28aa89dc-34b5-4a5c-bf81-ebdc5c7f4f07",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "Man ließ im ganzen Land Plakate aushängen, um die Suche zu unterstützen."
                                            },
                                            {
                                                "example_id": "e020e7a9-7b4e-46e9-8550-33d96ca41b57",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "„Ein Plakat verwies auf meine Lesung um 20 Uhr und auf die Öffnungszeit 19.30 Uhr.“"
                                            },
                                            {
                                                "example_id": "ad86ace4-eda7-4308-9405-3c5ca6ac84a0",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "„Ich lese das Plakat noch einmal und gehe dann hinein und zur Tribüne hinüber, die fast ganz leer ist.“"
                                            },
                                            {
                                                "example_id": "88e00535-b611-4abe-8da3-2c444cbeec66",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "„Wir stehen vor der abgesperrten Museumstür, im Gang hängen einige Plakate aus den 1990er Jahren.“"
                                            },
                                            {
                                                "example_id": "eb94ee16-01a0-4a8d-a5b7-e5c2db49cd9f",
                                                "sense_id": "e8e2e75b-b90a-3951-bfe0-47a75cb618a8",
                                                "text": "„Das Plakat zeigte einen kräftigen Jungarbeiter, dessen geballte Faust durch die Wolken stieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
