                "senses": [
                    {
                        "sense_id": "fa6148fe-fda3-34ed-9482-984a68e3ff50",
                        "entry_id": "a7b67495-7bfe-364c-abdd-07a1a4bcaa17",
                        "glosses": [
                            "Kunde einer Bank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5e4423a-3185-4441-b975-760f23a98b37",
                                "sense_id": "fa6148fe-fda3-34ed-9482-984a68e3ff50",
                                "text": "Die neuen Geschäftsbedingungen wurden den Bankkunden mit der Post zugesendet."
                            },
                            {
                                "example_id": "84249940-dab1-41d1-a9d1-a15939932efd",
                                "sense_id": "fa6148fe-fda3-34ed-9482-984a68e3ff50",
                                "text": "„Verfügen Betrüger über Name und Kreditkartennummer eines Bankkunden, können sie auf dessen Kosten einkaufen.“"
                            },
                            {
                                "example_id": "3e1dab4c-a642-4fb7-b1a0-85bd43bc0e5d",
                                "sense_id": "fa6148fe-fda3-34ed-9482-984a68e3ff50",
                                "text": "„Derzeit hat man den Eindruck, dass man als Bankkunde eigentlich nicht gewünscht ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
