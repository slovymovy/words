                        "examples": [
                            {
                                "example_id": "d1e022de-83d5-4c7c-a235-c883bb37e3a8",
                                "sense_id": "1fc01181-ee0b-359f-b471-4d26a7c9bb0a",
                                "text": "La vanterne en haut, au fond. Vitre éclatée, c'est pas une surprise. Elle donne à ras de la bande de terre qui sépare l'immeuble du trottoir."
                            },
                            {
                                "example_id": "898c84e3-8b71-4e2c-bc7f-0919100ee21c",
                                "sense_id": "1fc01181-ee0b-359f-b471-4d26a7c9bb0a",
                                "text": "Délinquance spécifiquement urbaine, les voleurs à la vanterne mettaient en coupe réglée, le plus souvent, les étages supérieurs des maisons de rapport."
                            }
                        ]
                    }
