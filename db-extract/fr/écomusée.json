                                        "entry_id": "375f9ccd-15d4-38d9-a1e9-d277762cf6b5",
                                        "glosses": [
                                            "A museum where the exhibitions are located outdoors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b29a53df-3964-4f10-99f2-1d2326f88eaf",
                                                "sense_id": "825705a5-29e6-3b47-a8a2-d503bfca7ef0",
                                                "text": "Mention must be made of the Valdres Folk Museum, situated just outside the town—one of those fascinating open-air museums for which Scandinavia is justly famed, to which have been transplanted a number of ancient buildings, such as farmhouses and storehouses, full of appropriate furniture, costumes and other exhibits."
                                            },
                                            {
                                                "example_id": "d601aa28-9fee-4190-99f1-5b84c187ad59",
                                                "sense_id": "825705a5-29e6-3b47-a8a2-d503bfca7ef0",
                                                "text": "Engineers from the Tyne & Wear Metro stepped back in time in December, to conduct a safety-critical inspection of the tramway at the open-air Beamish Museum in County Durham."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
