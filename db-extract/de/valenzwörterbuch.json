                    {
                        "sense_id": "faf87404-890a-3f4c-9a0d-fa16d79127ac",
                        "entry_id": "be1ddb06-5298-3206-8b8c-c6318b556dd4",
                        "glosses": [
                            "Wörterbuch, das angibt, welche Valenzen bestimmte Wörter haben, das heißt, mit welchen syntaktischen Konstruktionen diese Wörter im Satz verbunden sein können/müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026cf2b3-495e-4ee1-9907-228c61a0d5d6",
                                "sense_id": "faf87404-890a-3f4c-9a0d-fa16d79127ac",
                                "text": "„Valenz- und Distributionswörterbücher gehen selbstverständlich davon aus, daß syntaktische und morphologische Eigenschaften die Sememe eines Verbs voneinander scheiden.“"
                            },
                            {
                                "example_id": "b5e3aae8-5d34-46f0-b840-3648035b71b8",
                                "sense_id": "faf87404-890a-3f4c-9a0d-fa16d79127ac",
                                "text": "„Mit dem »Wörterbuch zur Valenz und Distribution der Substantive« wird die Reihe der Valenzwörterbücher zu den Autosemantika fortgesetzt…“"
                            },
                            {
                                "example_id": "f776a1b9-ce2f-4d2a-9e5c-fb1e1b014439",
                                "sense_id": "faf87404-890a-3f4c-9a0d-fa16d79127ac",
                                "text": "„Grammatisch-semantische Kriterien liegen der Zusammenstellung der Valenzwörterbücher zugrunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
