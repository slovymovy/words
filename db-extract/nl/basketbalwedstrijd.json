                        "examples": [
                            {
                                "example_id": "360a6fc8-1d4e-48ad-9bcc-65d4c5d24deb",
                                "sense_id": "7b0cccc5-2007-3db9-97d3-00f312cb39a6",
                                "text": "Het echtpaar is sinds september van 2016 niet meer samen op een rode loper gesignaleerd. In februari van vorig jaar werden Scott en Julie, die Claire Dunphy speelt in de populaire serie Modern Family, wel nog met hun kinderen gefotografeerd bij een basketbalwedstrijd."
                            },
                            {
                                "example_id": "65b37ba9-d0db-4d43-9b37-acc08cee875d",
                                "sense_id": "7b0cccc5-2007-3db9-97d3-00f312cb39a6",
                                "text": "De winst van de tv-divisie zakte met 3 procent, vooral door mindere resultaten van sportzender ESPN. Daar liepen de kosten op, onder meer door de duurdere uitzendrechten voor basketbalwedstrijden uit de NBA. De reclame-inkomsten groeiden wel, omdat er meer wedstrijden uit het college football konden worden uitgezonden."
                            }
