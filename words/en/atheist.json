{
    "word_family": [
        "atheism",
        "atheistic",
        "atheistical",
        "atheistically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3be19f1b-af37-3cb4-80e4-86bbbe6333da",
                    "sense_definition": "A person who does not believe in deities or the existence of God.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although his parents were deeply religious, he became an <w>atheist</w> during his college years.",
                            "target_lang_translations": {
                                "zh": "尽管他的父母都非常虔诚，他却在大学期间成了一名<w>无神论者</w>。"
                            }
                        },
                        {
                            "text": "As a committed <w>atheist</w>, she chooses to celebrate cultural holidays rather than religious ones.",
                            "target_lang_translations": {
                                "zh": "作为一名坚定的<w>无神论者</w>，她选择庆祝文化节日而非宗教节日。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nontheist"
                    ],
                    "antonyms": [
                        "theist"
                    ],
                    "common_phrases": [
                        "committed atheist",
                        "avowed atheist"
                    ],
                    "target_lang_definitions": {
                        "zh": "不相信神或上帝存在的人；无神论者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无神论者",
                                "target_lang_sense_clarification": "最通用称谓，指不信神明或上帝的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46abe5e6-5ecf-309b-82c8-822fd3ea1e3f",
                    "sense_definition": "A person who maintains that no deities exist and that the nonexistence of God can be established.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher identified as a strong <w>atheist</w> who argued that traditional religious doctrines were logically impossible.",
                            "target_lang_translations": {
                                "zh": "这位哲学家自称是<w>强无神论者</w>，主张传统宗教教义在逻辑上是不可能的。"
                            }
                        },
                        {
                            "text": "In the debate, the <w>atheist</w> sought to demonstrate that supernatural beings could not logically exist.",
                            "target_lang_translations": {
                                "zh": "在辩论中，这位<w>无神论者</w>试图证明超自然生物在逻辑上不可能存在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "positive atheist",
                        "strong atheist",
                        "gnostic atheist"
                    ],
                    "common_phrases": [
                        "strong atheist"
                    ],
                    "target_lang_definitions": {
                        "zh": "明确主张神明不存在且认为可证实神不存在的人；强无神论者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无神论者",
                                "target_lang_sense_clarification": "泛指无神论者"
                            },
                            {
                                "target_lang_word": "强无神论者",
                                "target_lang_sense_clarification": "哲学概念，指积极断言神不存在的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eddb7e9-0448-359c-9b15-282502e89fd2",
                    "sense_definition": "A person who merely lacks belief in deities or doubts their existence without actively asserting their nonexistence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A weak <w>atheist</w> simply finds insufficient evidence to accept religious claims.",
                            "target_lang_translations": {
                                "zh": "<w>弱无神论者</w>仅仅是觉得没有足够的证据来接受宗教主张。"
                            }
                        },
                        {
                            "text": "He described himself as an <w>atheist</w> rather than an agnostic, though he claimed no definitive knowledge.",
                            "target_lang_translations": {
                                "zh": "尽管他声称自己没有确凿的定论，但他还是将自己描述为<w>无神论者</w>，而非不可知论者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weak atheist"
                    ],
                    "common_phrases": [
                        "weak atheist"
                    ],
                    "target_lang_definitions": {
                        "zh": "仅缺乏对神明的信仰或怀疑其存在，而未明确断言神不存在的人；弱无神论者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弱无神论者",
                                "target_lang_sense_clarification": "哲学概念，指仅缺乏信仰、不断言神不存在的人"
                            },
                            {
                                "target_lang_word": "无神论者",
                                "target_lang_sense_clarification": "泛指不信神的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69097b86-baf0-323d-a15b-0e55fb7b5925",
                    "sense_definition": "A nonreligious person who does not adhere to or practice any religion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The census allowed citizens to register as Christian, Muslim, or as an <w>atheist</w>.",
                            "target_lang_translations": {
                                "zh": "人口普查允许公民登记为基督教徒、穆斯林或<w>无神论者</w>。"
                            }
                        },
                        {
                            "text": "Many people raised in secular households consider themselves <w>atheists</w> because they practice no faith.",
                            "target_lang_translations": {
                                "zh": "许多在世俗家庭长大的人认为自己是<w>无神论者</w>，因为他们不信奉任何宗教。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nontheist"
                    ],
                    "target_lang_definitions": {
                        "zh": "不遵从或不践行任何宗教信仰的人；无宗教信仰者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无神论者",
                                "target_lang_sense_clarification": "统计或分类中常用来指代不信教的人"
                            },
                            {
                                "target_lang_word": "无宗教信仰者",
                                "target_lang_sense_clarification": "指不践行任何宗教的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd3bad16-ebfe-3d01-b7eb-8bec02924ff0",
                    "sense_definition": "A person who rejects or does not believe in a specific deity or the prevalent religious beliefs of a culture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early Romans considered Christians to be <w>atheists</w> because they refused to venerate traditional civic gods.",
                            "target_lang_translations": {
                                "zh": "早期罗马人认为基督徒是<w>不敬神者</w>，因为他们拒绝崇拜传统的城邦神祇。"
                            }
                        },
                        {
                            "text": "In ancient times, anyone denying the city's protector deity was labeled an <w>atheist</w> by local authorities.",
                            "target_lang_translations": {
                                "zh": "在古代，任何否定城邦守护神的人都会被地方当局扣上<w>异端</w>的帽子。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historically used to describe denial of a specific religion's gods"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（历史用法）拒绝崇拜特定神明或不认同主流宗教信仰的人；异端者或不敬神者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不敬神者",
                                "target_lang_sense_clarification": "指拒拜特定城邦神或传统神祗的人"
                            },
                            {
                                "target_lang_word": "异端",
                                "target_lang_sense_clarification": "因不奉主流神明而被指控的人"
                            },
                            {
                                "target_lang_word": "无神论者",
                                "target_lang_sense_clarification": "历史指称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e051c41-be82-38bd-ad7f-b4523188897e",
                    "sense_definition": "Any individual who lacks an explicit belief in deities, including those who are unaware of religious concepts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some thinkers argue that infants are naturally <w>atheists</w> until introduced to religious dogma.",
                            "target_lang_translations": {
                                "zh": "一些思想家认为，婴儿在接触宗教教条之前天生就是<w>非有神论者</w>。"
                            }
                        },
                        {
                            "text": "Under this philosophical definition, anyone unexposed to theology qualifies as an <w>atheist</w>.",
                            "target_lang_translations": {
                                "zh": "按照这种哲学定义，任何未接触过神学的人都算得上是<w>无神论者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nontheist"
                    ],
                    "target_lang_definitions": {
                        "zh": "泛指任何对神明没有明确概念或信仰的个体（包括尚未接触宗教概念的人）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无神论者",
                                "target_lang_sense_clarification": "广义或哲学定义，指不具备有神概念的人"
                            },
                            {
                                "target_lang_word": "非有神论者",
                                "target_lang_sense_clarification": "指缺乏有神信仰的个体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "000ecec9-2219-369f-b9ef-a1fd93b2aae6",
                    "sense_definition": "Relating to or characteristic of atheists or atheism; atheistic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regime established strictly <w>atheist</w> policies to diminish the influence of religious institutions.",
                            "target_lang_translations": {
                                "zh": "该政权确立了严格的<w>无神论</w>政策，以削弱宗教机构的影响力。"
                            }
                        },
                        {
                            "text": "His writings reflect an openly <w>atheist</w> perspective on the natural world and human ethics.",
                            "target_lang_translations": {
                                "zh": "他的著作反映出对自然界与人类伦理的一种公开的<w>无神论</w>视角。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "无神论的；无神论者的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无神论的",
                                "target_lang_sense_clarification": "形容词，表示具有无神论特征"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2278090e-5729-3229-a45d-75ee2a85c3a4",
                    "sense_definition": "To cause someone to become an atheist or to abandon religious belief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He feared that endless theological disputes would only <w>atheist</w> curious young scholars.",
                            "target_lang_translations": {
                                "zh": "他担心无休止的神学争端只会<w>使</w>好奇的青年学者<w>放弃信仰</w>。"
                            }
                        },
                        {
                            "text": "Reading forbidden treatises threatened to <w>atheist</w> the devout monks of the abbey.",
                            "target_lang_translations": {
                                "zh": "阅读禁书有可能会<w>使</w>修道院里虔诚的僧侣们<w>变成无神论者</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧）使成为无神论者；使放弃宗教信仰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使放弃信仰",
                                "target_lang_sense_clarification": "动词义，促使他人不再信仰神明"
                            },
                            {
                                "target_lang_word": "使成为无神论者",
                                "target_lang_sense_clarification": "动词义"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}