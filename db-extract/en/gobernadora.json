                        "examples": [
                            {
                                "example_id": "0729ab86-ee7b-4439-afb2-ac1f16a54531",
                                "sense_id": "85f6bc0a-555a-366b-a801-9cf0c7d5f56d",
                                "text": "[…] the inquisitor of Valladolid advanced to the royal platform and demanded that the young Prince and Dona Juana, the gobernadora, should swear […]"
                            },
                            {
                                "example_id": "7da9ba79-dc0c-4fb8-88fb-e0e5c244da18",
                                "sense_id": "85f6bc0a-555a-366b-a801-9cf0c7d5f56d",
                                "text": "When the news of Alvarado's death reached his widow in Guatemala, she called all the alcaldes and regidores to the palace and proclaimed herself gobernadora […]"
                            },
                            {
                                "example_id": "a94828e4-7a0e-41af-b528-42089a7dc187",
                                "sense_id": "85f6bc0a-555a-366b-a801-9cf0c7d5f56d",
                                "text": "Not terribly conflicted by the part she must play, she seems beyond reproach, as effective and inscrutable in battle as she is as a gobernadora."
                            }
                        ]
                    }
