                "senses": [
                    {
                        "sense_id": "f75b1802-2be4-32df-aef7-26e6330685e0",
                        "entry_id": "b19bfdaa-a436-3c79-b2f6-8190d204591e",
                        "glosses": [
                            "проф. связанный, соотносящийся по значению с существительным горняк; свойственный, характерный для горняка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b8fcd1-b2a3-4dd7-aa0d-87f443719237",
                                "sense_id": "f75b1802-2be4-32df-aef7-26e6330685e0",
                                "text": "Спустя некоторое время, облаченный в горняцкий комбинезон, он уже был вместе с машинистами у комбайна, в лаве шахты «Рыдультово»."
                            },
                            {
                                "example_id": "1577a8e8-ee2e-4ae9-90b5-e1b1315d679a",
                                "sense_id": "f75b1802-2be4-32df-aef7-26e6330685e0",
                                "text": "Правильно снять все циклы вертикальной проходки им помогало знание горняцкого дела."
                            },
                            {
                                "example_id": "61d6afa3-2f85-419b-b2cc-d1e0dfe66085",
                                "sense_id": "f75b1802-2be4-32df-aef7-26e6330685e0",
                                "text": "За спиной индустриальный пейзаж горняцкой столицы, вокруг ― степь, полдень, Украина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93a47552-91ff-4130-a7ec-f52873e678e7",
                        "source_entry_id": "b19bfdaa-a436-3c79-b2f6-8190d204591e",
                        "source_sense_id": "f75b1802-2be4-32df-aef7-26e6330685e0",
                        "target_lang_word": "mining",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mining",
