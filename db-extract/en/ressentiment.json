                ],
                "senses": [
                    {
                        "sense_id": "e46bc4ce-a451-3e86-9ed6-8a170bb82033",
                        "entry_id": "f2836580-7777-336a-81c6-0fea94058437",
                        "glosses": [
                            "Obsolete form of resentment."
                        ],
                        "tags": [
                            "alt-of",
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b155a3d8-c57f-3db6-b797-2f7e86f9e70a",
                        "entry_id": "f2836580-7777-336a-81c6-0fea94058437",
                        "glosses": [
                            "a sense of resentment arising from deep-seated feelings of envy or hatred, leading the resentful one to blame it on an external agent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "78fd4f59-7086-4da9-9c69-ddc179cec590",
                                "sense_id": "b155a3d8-c57f-3db6-b797-2f7e86f9e70a",
                                "text": "When the weak call the strong evil the move is not merely defensive; it is also an expression of that peculiar malice which Nietzsche referred to as ressentiment. Those who cultivate humility and the other propitiatory virtues to cloak their weakness nourish an envious resentment against those stronger than themselves."
                            },
                            {
                                "example_id": "fc827599-2671-408e-994c-6ba52a020cd2",
                                "sense_id": "b155a3d8-c57f-3db6-b797-2f7e86f9e70a",
                                "text": "If his attack on Christian morality and on other moralities is going to be worth anything he has got to be right about the effect of teaching pity and justice — that it merely hides the ressentiment of the weak while it does injury to the strong."
                            },
                            {
                                "example_id": "09a67ff6-ec64-4063-ba42-f021fd2f403b",
                                "sense_id": "b155a3d8-c57f-3db6-b797-2f7e86f9e70a",
                                "text": "Historians such as Liah Greenfield and Daniel Chirot have attributed the major wars and genocides in the early decades of the 20th century to ressentiment in Germany and Russia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "190d89c9-87d2-44ce-bf94-0781138835ea",
                        "source_entry_id": "f2836580-7777-336a-81c6-0fea94058437",
                        "source_sense_description": "resentment arising from envy and hatred",
                        "target_lang_word": "verontwaardiging",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verontwaardiging",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a5f15f-357a-3215-9c2f-613d98fb3346",
                                        "entry_id": "3b265c23-45dc-3107-aa85-af99be762fb1",
                                        "glosses": [
                                            "boosheid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61b0dfa-f9c2-424b-a3ef-00d78bd17ff0",
                                                "sense_id": "c6a5f15f-357a-3215-9c2f-613d98fb3346",
                                                "text": "De verontwaardiging was groot bij die vrouw nadat ze opgelicht was."
                                            },
                                            {
                                                "example_id": "542499b4-5cca-485e-8c50-76a265b35361",
                                                "sense_id": "c6a5f15f-357a-3215-9c2f-613d98fb3346",
                                                "text": "De lakse aanpak om het virus in bedwang te houden heeft zowel lof als verontwaardiging gekregen. Critici beschuldigen de Zweedse autoriteiten van het gokken met het leven van burgers door geen strenge maatregelen op te leggen. Maar de gezondheidsautoriteit hield lange tijd vol dat haar aanpak op de lange termijn duurzaam is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
