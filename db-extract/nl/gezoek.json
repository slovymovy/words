                "senses": [
                    {
                        "sense_id": "c692b39f-48ca-3f6c-8d55-9a11fecdeace",
                        "entry_id": "e67c49fa-2853-3677-a8d3-124d34d275c9",
                        "glosses": [
                            "aanhoudend bezig zijn om iets te vinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bebd19f-e43b-4283-84ab-00d420798b25",
                                "sense_id": "c692b39f-48ca-3f6c-8d55-9a11fecdeace",
                                "text": "Om gezoek door hulpdiensten te voorkomen, komen er in Groenlo twee straatnamen bij. Het deel De Kunne in het plan Hartreize wordt gesplitst in de naam De Kunne voor de hoofdstraat en De Velver voor de woonstraat ernaast."
                            },
                            {
                                "example_id": "2554ca8c-10d7-436a-a238-f31609ea4b07",
                                "sense_id": "c692b39f-48ca-3f6c-8d55-9a11fecdeace",
                                "text": "Het eeuwige gezoek naar een leesbril behoort straks definitief tot het verleden. De Groningse oogarts Steven Koopmans heeft een elastische lens ontwikkeld die op termijn het troebel geworden exemplaar bij vijftigplussers kan vervangen."
                            },
                            {
                                "example_id": "93dc0d08-418d-4311-b530-2824af58d6c5",
                                "sense_id": "c692b39f-48ca-3f6c-8d55-9a11fecdeace",
                                "text": "Het mooie van Flickr.com is dat iedereen een digitale foto op het net kan zetten, aldus Ego. Vandaar dat hij samen met een paar kompanen de website first-enschede.nl in het leven heeft geroepen. Dat bespaart de internetter gezoek op Flickr. First-enschede linkt meteen door naar Enschede zoals het echt is."
                            }
                        ]
                    }
