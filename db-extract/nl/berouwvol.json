                        "source_sense_id": "8d2858ea-3901-37b2-9886-339a484beee9",
                        "source_sense_description": "met spijt vervuld",
                        "target_lang_word": "penitent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penitent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f078eae4-dd87-39bf-80a1-12bd8fa3e6e9",
                                        "entry_id": "2bdb2ecf-2d1e-30d4-a179-80df0744a563",
                                        "glosses": [
                                            "Feeling pain or sorrow on account of one's sins or offenses; feeling sincere guilt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97955446-bd96-4c27-bdad-de3ff0e7ec91",
                                                "sense_id": "f078eae4-dd87-39bf-80a1-12bd8fa3e6e9",
                                                "text": "Be penitent, and for thy fault contrite."
                                            },
                                            {
                                                "example_id": "f01633f8-60a1-4027-8172-dcfd17e5c617",
                                                "sense_id": "f078eae4-dd87-39bf-80a1-12bd8fa3e6e9",
                                                "text": "If thou be penitent and grieved, or desirous to be so, these heinous sins shall not be laid to thy charge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef75ab8-01af-31ef-8381-a37ed31ec1bc",
                                        "entry_id": "2bdb2ecf-2d1e-30d4-a179-80df0744a563",
                                        "glosses": [
                                            "Doing penance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a30da585-6c17-4053-b8d9-5a5339a77b52",
                                                "sense_id": "cef75ab8-01af-31ef-8381-a37ed31ec1bc",
                                                "text": "[…] But we that know what ’tis to faſt and pray, / Are penitent for your default to day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "penitent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f415a2c4-ba48-33e8-b61b-17962206c8db",
                                        "entry_id": "31ca2fff-3f9d-3806-a0ec-57d494e5ca76",
                                        "glosses": [
                                            "One who repents of sin; one sorrowful on account of their transgressions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efa0c90b-149a-31e9-9d98-4da553cb6686",
                                        "entry_id": "31ca2fff-3f9d-3806-a0ec-57d494e5ca76",
                                        "glosses": [
                                            "One under church censure, but admitted to penance; one undergoing penance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b131d28-659c-4e96-a94f-346923daa2aa",
                                                "sense_id": "efa0c90b-149a-31e9-9d98-4da553cb6686",
                                                "text": "Wamba, who defeated the Saracens in an attempt upon Spain, was deprived of the crown, because he had been clothed in the habit of a penitent, while labouring under the influence of poison, administered by the ambitious Erviga!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fbf14ef-2a42-3cf2-90dc-fec8d6697a67",
                                        "entry_id": "31ca2fff-3f9d-3806-a0ec-57d494e5ca76",
                                        "glosses": [
                                            "One under the direction of a confessor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6202ec5e-5732-44ef-987a-e591c11cd9f5",
                        "source_entry_id": "fe3f9d03-87aa-336f-8aff-cb2e71d8cb08",
                        "source_sense_id": "8d2858ea-3901-37b2-9886-339a484beee9",
                        "source_sense_description": "met spijt vervuld",
                        "target_lang_word": "repentant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repentant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afdc7f68-bd1e-30ca-bb9b-54fc05fed5ef",
                                        "entry_id": "b15f16be-f630-39b9-bab5-c2857f6e857a",
                                        "glosses": [
                                            "Participe présent de repentir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "repentant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e488adf-2ffb-3fcd-ba6c-02a930e88e73",
                                        "entry_id": "08eb23ab-0f4c-3e01-a7b3-d70bd2c93186",
                                        "glosses": [
                                            "Qui se repent d’avoir péché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a482857c-51ac-4ca6-af10-a9ae237b25c5",
                                                "sense_id": "3e488adf-2ffb-3fcd-ba6c-02a930e88e73",
                                                "text": "Il a donné l’absolution à un homme vraiment contrit et repentant."
                                            },
                                            {
                                                "example_id": "3cc1f2c5-c260-48ff-812c-ed264e66b255",
                                                "sense_id": "3e488adf-2ffb-3fcd-ba6c-02a930e88e73",
                                                "text": "Elle est très repentante."
                                            },
                                            {
                                                "example_id": "b00f2af4-bf48-4198-979a-4a48ba3c2ede",
                                                "sense_id": "3e488adf-2ffb-3fcd-ba6c-02a930e88e73",
                                                "text": "Je m’approchai, réellement furieuse.\nAlors elle, avec un sourire qui contenait toutes les réprimandes susceptibles de lui être adressées et toutes les excuses de sa part, et tous les appels à mon indulgence, de grande personne, avec un hochement de tête repentant et d’une adorable malice :\n— Je suis méchante, hein ?"
                                            },
                                            {
                                                "example_id": "d85b2031-bfe9-44e3-9016-ec259397f229",
                                                "sense_id": "3e488adf-2ffb-3fcd-ba6c-02a930e88e73",
                                                "text": "Si Arlette, repentante, revient frapper à notre porte, n’est-ce pas que nous lui ouvrirons ?…"
                                            },
                                            {
                                                "example_id": "46bceeca-fa89-4534-82a4-c54dfbdfb876",
                                                "sense_id": "3e488adf-2ffb-3fcd-ba6c-02a930e88e73",
                                                "text": "On la sauvait ; effrayée, repentante, Charlotte se gavait si gloutonnement qu’elle enflait comme une baudruche : sa mère conduisait chez le médecin un monstre ballonné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repentant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f644574-6e91-3065-81cd-8eb6207a41d1",
                                        "entry_id": "228aa57d-5797-3770-8e16-51172df87743",
                                        "glosses": [
                                            "Personne qui se repent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac124ff-b0a4-4f73-b54a-c5c9654faef1",
                                                "sense_id": "5f644574-6e91-3065-81cd-8eb6207a41d1",
                                                "text": "En réalité, si l’on regarde de plus près, la consolation est double : en confessant sa faute, le repentant console celui qu’il a offensé ; et en pardonnant, l’offensé console le repentant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
