                        "sense_id": "8dafb602-95a2-323d-bb97-21f8374c9050",
                        "entry_id": "288365e3-8e5b-3111-bc53-7365a7e496c3",
                        "glosses": [
                            "One of a set of rows of tightly braided hair close to the scalp, forming a hairstyle, of African origin."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a80b4cc5-e0fb-4e2e-9857-5b08f2adb608",
                                "sense_id": "8dafb602-95a2-323d-bb97-21f8374c9050",
                                "text": "The physician should evaluate for a history of tight ponytails, buns, chignons, braids, twists, weaves, cornrows, dreadlocks, sisterlocks, and hair wefts in addition to the usage of religious hair coverings."
                            },
                            {
                                "example_id": "850a972e-5f61-4076-bd60-80b35096dfd9",
                                "sense_id": "8dafb602-95a2-323d-bb97-21f8374c9050",
                                "text": "Coolio, whose spindly and sprouting cornrows defined his look, went on to sell over 17 million records throughout his career."
                            }
                        ]
                    }
                ],
