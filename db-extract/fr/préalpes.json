                "senses": [
                    {
                        "sense_id": "72cb047d-c3b9-35a6-b829-bd8b137d5132",
                        "entry_id": "d0423a9e-bdb5-3d3c-bee0-fb368ce4a987",
                        "glosses": [
                            "Ensemble de massifs montagneux de moyenne altitude formant la base des Alpes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8333080-a081-43f4-ae3a-9528bacd3919",
                                "sense_id": "72cb047d-c3b9-35a6-b829-bd8b137d5132",
                                "text": "Les flores montagnardes dans le secteur alpien sont réparties essentiellement sur les Vosges, le Jura et les Préalpes de Savoie, Dauphiné et Provence."
                            },
                            {
                                "example_id": "214c65ad-f6df-413a-8d8a-f155af200996",
                                "sense_id": "72cb047d-c3b9-35a6-b829-bd8b137d5132",
                                "text": "Le picodon est un fromage au lait cru de chèvre à pâte molle et à croûte naturelle produit dans les Cévennes ardéchoises, dans une partie de la vallée du Rhône et dans les Préalpes drômoises, en France."
                            },
                            {
                                "example_id": "8b3de811-64a5-4c7b-982b-48eb695ea9aa",
                                "sense_id": "72cb047d-c3b9-35a6-b829-bd8b137d5132",
                                "text": "Le séchard est le nom donné à la brise diurne de NE qui, canalisée entre le Jura et les Préalpes savoyardes, souffle dans l'axe du Petit-Lac."
                            }
                        ]
                    }
