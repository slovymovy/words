                        "translation_id": "0cf71f48-9932-45d7-aa78-37328132413b",
                        "source_entry_id": "42223263-0fd5-303f-bcd5-15d4fff6c877",
                        "source_sense_id": "c1e90a18-f731-3203-9053-608fd78c8fe1",
