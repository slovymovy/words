                    ]
                },
                {
                    "sense_id": "35f48fc3-caae-3af5-a22e-32391049f935",
                    "sense_definition": "Partie repliée, retournée ou rabattue d'un vêtement ou d'un couvre-chef.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a baissé le large <w>rebord</w> de son chapeau afin de dissimuler son regard."
