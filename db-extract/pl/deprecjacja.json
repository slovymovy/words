                        "sense_id": "de65a725-6ec1-3a87-9448-a55e4695e6c8",
                        "entry_id": "98750cd6-fd1a-3d75-b101-37a0bc642cb4",
                        "glosses": [
                            "spadek wartości dobra lub usługi, zwykle pieniądza w systemie płynnych kursów walut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9033a27e-6766-408b-a52e-f2adc87ad210",
                                "sense_id": "de65a725-6ec1-3a87-9448-a55e4695e6c8",
                                "text": "Spadek popytu na polskie towary spowodował deprecjację złotego, przez co kurs euro wzrósł z 3,80 zł do 4,20 zł."
                            }
                        ],
