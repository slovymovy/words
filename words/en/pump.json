{
    "word_family": [
        "pumper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bfeb3887-b0a0-31f9-b848-9673861609b2",
                    "sense_definition": "A device for moving or compressing a liquid or gas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "device_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water <w>pump</w> is broken and needs to be replaced.",
                            "target_lang_translations": {
                                "ru": "Водяной <w>насос</w> сломан и требует замены.",
                                "zh": "水<w>泵</w>坏了，需要更换。"
                            }
                        },
                        {
                            "text": "We used a small <w>pump</w> to inflate the bicycle tires.",
                            "target_lang_translations": {
                                "ru": "Мы использовали маленький <w>насос</w>, чтобы накачать шины велосипеда.",
                                "zh": "我们用一个小<w>泵</w>给自行车轮胎充气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "water pump",
                        "heat pump",
                        "bicycle pump",
                        "air pump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство для перемещения или сжатия жидкости или газа.",
                        "zh": "用于移动或压缩液体或气体的装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насос",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "помпа",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泵",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "抽水机",
                                "target_lang_sense_clarification": "特指抽水设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f027de7-9e4a-3075-80dd-a847bff4c7ea",
                    "sense_definition": "A device for dispensing liquid or gas to be sold, particularly fuel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "device_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can pay for your fuel directly at the <w>pump</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете заплатить за топливо прямо у <w>колонки</w>.",
                                "zh": "你可以直接在<w>加油机</w>处付款。"
                            }
                        },
                        {
                            "text": "The gas <w>pump</w> was out of order, so we went to another station.",
                            "target_lang_translations": {
                                "ru": "Бензиновая <w>колонка</w> не работала, поэтому мы поехали на другую заправку.",
                                "zh": "那台<w>加油机</w>坏了，所以我们去了另一家加油站。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dispenser"
                    ],
                    "common_phrases": [
                        "gas pump",
                        "petrol pump",
                        "at the pump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство для подачи жидкости или газа на продажу, особенно топлива.",
                        "zh": "用于销售液体或气体的设备，尤指燃料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колонка",
                                "target_lang_sense_clarification": "на заправке"
                            },
                            {
                                "target_lang_word": "бензоколонка",
                                "target_lang_sense_clarification": "для бензина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加油机",
                                "target_lang_sense_clarification": "加油站设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a9af729-4c1c-3171-a6a8-a3dc9f01a20c",
                    "sense_definition": "A type of women's shoe which leaves the instep uncovered and has a relatively high heel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shoe_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a pair of black <w>pumps</w> to the formal event.",
                            "target_lang_translations": {
                                "ru": "Она надела пару черных <w>лодочек</w> на официальное мероприятие.",
                                "zh": "她穿了一双黑色<w>浅口高跟鞋</w>参加了正式活动。"
                            }
                        },
                        {
                            "text": "These <w>pumps</w> are elegant but uncomfortable to walk in for long periods.",
                            "target_lang_translations": {
                                "ru": "Эти <w>лодочки</w> элегантны, но в них неудобно ходить долгое время.",
                                "zh": "这些<w>浅口高跟鞋</w>很优雅，但长时间穿着走路并不舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "court shoe"
                    ],
                    "common_phrases": [
                        "black pumps",
                        "leather pumps"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид женских туфель с открытым подъемом и относительно высоким каблуком.",
                        "zh": "一种露出脚背且鞋跟较高的女式浅口鞋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туфли-лодочки",
                                "target_lang_sense_clarification": "полное название"
                            },
                            {
                                "target_lang_word": "лодочки",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浅口高跟鞋",
                                "target_lang_sense_clarification": "正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb2fc111-84ed-3785-8a4f-a017086d417f",
                    "sense_definition": "A low-top shoe with a rubber sole and a canvas upper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shoe_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on his canvas <w>pumps</w> for the gym class.",
                            "target_lang_translations": {
                                "ru": "Он надел свои парусиновые <w>кеды</w> на урок физкультуры.",
                                "zh": "他穿上<w>帆布鞋</w>去上体育课。"
                            }
                        },
                        {
                            "text": "The children were asked to bring their <w>pumps</w> for indoor sports.",
                            "target_lang_translations": {
                                "ru": "Детей попросили принести <w>кеды</w> для занятий спортом в помещении.",
                                "zh": "孩子们被要求带上<w>帆布鞋</w>进行室内运动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plimsoll",
                        "sneaker"
                    ],
                    "common_phrases": [
                        "canvas pumps",
                        "gym pumps"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкая обувь на резиновой подошве с парусиновым верхом.",
                        "zh": "一种带有橡胶底和帆布鞋面的低帮运动鞋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кеды",
                                "target_lang_sense_clarification": "спортивная обувь"
                            },
                            {
                                "target_lang_word": "тапочки",
                                "target_lang_sense_clarification": "легкая обувь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帆布鞋",
                                "target_lang_sense_clarification": "休闲运动鞋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c227110b-e732-3e7b-988c-dcb1cf1950ef",
                    "sense_definition": "A swelling of the muscles caused by increased blood flow following high intensity weightlifting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a massive <w>pump</w> in his arms after the workout.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал мощный <w>памп</w> в руках после тренировки.",
                                "zh": "锻炼后，他感到手臂有强烈的<w>充血感</w>。"
                            }
                        },
                        {
                            "text": "Bodybuilders often try to achieve a <w>pump</w> before stepping on stage.",
                            "target_lang_translations": {
                                "ru": "Бодибилдеры часто пытаются достичь <w>пампа</w> перед выходом на сцену.",
                                "zh": "健美运动员在上台前通常会尝试达到<w>充血感</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle pump",
                        "get a pump"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "bodybuilding"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличение объема мышц, вызванное притоком крови после интенсивной тренировки.",
                        "zh": "高强度举重后因血流量增加而引起的肌肉肿胀感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "памп",
                                "target_lang_sense_clarification": "слэнг бодибилдеров"
                            },
                            {
                                "target_lang_word": "пампинг",
                                "target_lang_sense_clarification": "процесс накачки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充血感",
                                "target_lang_sense_clarification": "健身术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1476911b-163d-39a3-9857-ac1a71e8bba2",
                    "sense_definition": "To move water or other liquid by means of a pump.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heart <w>pumps</w> blood throughout the entire body.",
                            "target_lang_translations": {
                                "ru": "Сердце <w>качает</w> кровь по всему телу.",
                                "zh": "心脏将血液<w>泵</w>送到全身。"
                            }
                        },
                        {
                            "text": "They <w>pumped</w> the water out of the flooded basement.",
                            "target_lang_translations": {
                                "ru": "Они <w>откачали</w> воду из затопленного подвала.",
                                "zh": "他们把被淹地下室里的水<w>抽</w>干了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pump water",
                        "pump blood",
                        "pump oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещать воду или другую жидкость с помощью насоса.",
                        "zh": "用泵移动水或其他液体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качать",
                                "target_lang_sense_clarification": "перемещать жидкость"
                            },
                            {
                                "target_lang_word": "перекачивать",
                                "target_lang_sense_clarification": "из одного места в другое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽",
                                "target_lang_sense_clarification": "抽取液体"
                            },
                            {
                                "target_lang_word": "泵送",
                                "target_lang_sense_clarification": "工业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1a8e1aa-49d1-3e74-9bd1-75eefa265575",
                    "sense_definition": "To fill with air by means of a pump.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>pump</w> up my bicycle tires before we leave.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>накачать</w> шины велосипеда перед отъездом.",
                                "zh": "出发前我需要给自行车轮胎<w>打气</w>。"
                            }
                        },
                        {
                            "text": "He <w>pumped</w> air into the mattress until it was firm.",
                            "target_lang_translations": {
                                "ru": "Он <w>накачивал</w> воздух в матрас, пока тот не стал твердым.",
                                "zh": "他往床垫里<w>打气</w>，直到它变得结实。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inflate",
                        "blow up"
                    ],
                    "antonyms": [
                        "deflate"
                    ],
                    "common_phrases": [
                        "pump up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять воздухом с помощью насоса.",
                        "zh": "用泵充入空气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накачивать",
                                "target_lang_sense_clarification": "наполнять воздухом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打气",
                                "target_lang_sense_clarification": "充气动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad00ef0-db54-354f-aebb-609786ecaafc",
                    "sense_definition": "To move up and down or in and out rhythmically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pumped</w> his fist in the air when he won the race.",
                            "target_lang_translations": {
                                "ru": "Он победно <w>вскинул</w> кулак в воздух, когда выиграл гонку.",
                                "zh": "赢得比赛时，他兴奋地在空中<w>挥动</w>拳头。"
                            }
                        },
                        {
                            "text": "Her legs <w>pumped</w> hard as she sprinted towards the finish line.",
                            "target_lang_translations": {
                                "ru": "Ее ноги мощно <w>работали</w>, когда она мчалась к финишу.",
                                "zh": "当她冲向终点线时，双腿在用力<w>摆动</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pump one's fist",
                        "pump one's legs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритмично двигать вверх-вниз или вперед-назад.",
                        "zh": "有节奏地上下或前后移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ритмично двигать",
                                "target_lang_sense_clarification": "частями тела"
                            },
                            {
                                "target_lang_word": "вскидывать",
                                "target_lang_sense_clarification": "о руке/кулаке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥动",
                                "target_lang_sense_clarification": "指手臂动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2ead18f-10f5-3210-a27a-35772c52e7f8",
                    "sense_definition": "To inject or pour something into a system or person continuously or forcefully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>pumped</w> billions of dollars into the economy.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>влило</w> миллиарды долларов в экономику.",
                                "zh": "政府向经济中<w>注入</w>了数十亿美元。"
                            }
                        },
                        {
                            "text": "Doctors <w>pumped</w> antibiotics into his system to fight the infection.",
                            "target_lang_translations": {
                                "ru": "Врачи <w>закачивали</w> в его организм антибиотики, чтобы бороться с инфекцией.",
                                "zh": "医生为他<w>输送</w>抗生素以对抗感染。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pump money into",
                        "pump resources into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывно или с силой вводить что-либо в систему или человека.",
                        "zh": "持续或强力地向系统或人体内注入某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вливать",
                                "target_lang_sense_clarification": "деньги, ресурсы"
                            },
                            {
                                "target_lang_word": "закачивать",
                                "target_lang_sense_clarification": "жидкость, газ, лекарства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注入",
                                "target_lang_sense_clarification": "资金或资源"
                            },
                            {
                                "target_lang_word": "输送",
                                "target_lang_sense_clarification": "液体或药物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdad8c29-2767-351d-8f05-427cd6143771",
                    "sense_definition": "To gain information from a person by persistent questioning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reporter tried to <w>pump</w> the witness for more details.",
                            "target_lang_translations": {
                                "ru": "Репортер пытался <w>выпытать</w> у свидетеля подробности.",
                                "zh": "记者试图从证人那里<w>套取</w>更多细节。"
                            }
                        },
                        {
                            "text": "I knew he was just trying to <w>pump</w> me for information about the deal.",
                            "target_lang_translations": {
                                "ru": "Я знал, что он просто пытается <w>выудить</w> у меня информацию о сделке.",
                                "zh": "我知道他只是想从我这里<w>套取</w>关于那笔交易的信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interrogate",
                        "grill"
                    ],
                    "common_phrases": [
                        "pump for information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать информацию от человека путем настойчивых расспросов.",
                        "zh": "通过持续追问从某人那里获取信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпытывать",
                                "target_lang_sense_clarification": "информацию"
                            },
                            {
                                "target_lang_word": "выуживать",
                                "target_lang_sense_clarification": "сведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "套取",
                                "target_lang_sense_clarification": "获取信息"
                            },
                            {
                                "target_lang_word": "盘问",
                                "target_lang_sense_clarification": "追问细节"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06d9ad79-903e-3500-ba3a-87478d9f8da0",
                    "sense_definition": "To enlarge the body or muscles by means of weightlifting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He goes to the gym every day to <w>pump</w> iron.",
                            "target_lang_translations": {
                                "ru": "Он ходит в спортзал каждый день, чтобы <w>качать</w> железо.",
                                "zh": "他每天去健身房<w>练</w>举重。"
                            }
                        },
                        {
                            "text": "They want to <w>pump</w> up their muscles before the competition.",
                            "target_lang_translations": {
                                "ru": "Они хотят <w>накачать</w> мышцы перед соревнованиями.",
                                "zh": "他们想在比赛前<w>增肌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pump iron",
                        "pump up"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "bodybuilding"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать объем мышц с помощью силовых упражнений.",
                        "zh": "通过举重锻炼来增大肌肉体积。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качать",
                                "target_lang_sense_clarification": "мышцы"
                            },
                            {
                                "target_lang_word": "накачивать",
                                "target_lang_sense_clarification": "увеличивать объем"
                            }
                        ],
                        "zh": [
