                                    {
                                        "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                        "entry_id": "2421fb90-d794-3e1f-9d09-fa69f961e9bd",
                                        "glosses": [
                                            "die angeborene oder erworbene Eigenschaft, zu etwas imstande zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77fcfac5-bb2e-45e7-9f14-324849f0da5c",
                                                "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.“"
                                            },
                                            {
                                                "example_id": "fde3d101-ab17-4116-b693-414c09f8ab94",
                                                "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                                "text": "„Ihre Fähigkeit, eine Art von kleinbürgerlicher Behaglichkeit um sich zu verbreiten, war erstaunlich; ebenso ihre unerschütterliche gute Laune.“"
                                            },
                                            {
                                                "example_id": "6885b197-57a5-40fd-9081-0611307606ec",
                                                "sense_id": "ae7a7fdf-a35e-388a-a8e8-21dd0c7d58e8",
                                                "text": "Im Berufsleben muss man über bestimmte Fähigkeiten verfügen."
                                            }
                                        ],
