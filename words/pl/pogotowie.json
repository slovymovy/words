                {
                    "sense_id": "77c54b83-ec4d-3918-ac80-0ba0dbc7659f",
                    "sense_definition": "Stan gotowości do podjęcia szybkiego działania w razie konieczności.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy lekarze byli w <w>pogotowiu</w> przez całą noc sylwestrową.",
                            "target_lang_translations": {
                                "ru": "Все врачи были <w>наготове</w> всю новогоднюю ночь.",
                                "en": "All doctors were on <w>standby</w> all through New Year's Eve.",
                                "nl": "Alle artsen stonden de hele oudejaarsavond <w>stand-by</w>.",
                                "de": "Alle Ärzte waren die ganze Silvesternacht über in <w>Bereitschaft</w>.",
                                "fr": "Tous les médecins étaient <w>sur le qui-vive</w> pendant toute la nuit du Nouvel An.",
                                "it": "Tutti i medici sono rimasti in <w>allerta</w> per tutta la notte di Capodanno.",
                                "cs": "Všichni lékaři byli po celou silvestrovskou noc v <w>pohotovosti</w>.",
                                "tr": "Tüm doktorlar yılbaşı gecesi boyunca <w>tetikteydi</w>.",
                                "es": "Todos los médicos estuvieron de <w>guardia</w> durante toda la noche de Fin de Año.",
                                "zh": "除夕夜整晚，所有医生都处于<w>待命</w>状态。"
                            }
                        },
                        {
                            "text": "Trzymaj kluczyki w <w>pogotowiu</w>, musimy zaraz wyjeżdżać.",
                            "target_lang_translations": {
                                "ru": "Держи ключи <w>наготове</w>, нам нужно скоро выезжать.",
                                "en": "Keep the keys <w>ready</w>, we have to leave in a moment.",
                                "nl": "Houd de sleutels <w>klaar</w>, we moeten zo meteen vertrekken.",
                                "de": "Halte die Schlüssel <w>bereit</w>, wir müssen gleich losfahren.",
                                "fr": "Garde les clés <w>à portée de main</w>, nous devons partir tout de suite.",
                                "it": "Tieni le chiavi <w>pronte</w>, dobbiamo partire subito.",
                                "cs": "Měj klíče v <w>pohotovosti</w>, musíme hned odjet.",
                                "tr": "Anahtarları <w>hazırda</w> tut, hemen çıkmamız gerekiyor.",
                                "es": "Ten las llaves <w>a mano</w>, tenemos que salir enseguida.",
                                "zh": "把钥匙<w>准备好</w>，我们马上要出发了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "być w pogotowiu",
                        "stan pogotowia",
                        "ostre pogotowie"
