                    {
                        "sense_id": "9f07e284-4b9f-31f3-9163-994bbe512f25",
                        "entry_id": "97a91173-8bcc-316e-9c66-ff77ce3945ce",
                        "glosses": [
                            "To break up into small, mutually-hostile units, especially on a political basis."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4671bd85-b3bc-408c-97c3-1beac8780878",
                                "sense_id": "9f07e284-4b9f-31f3-9163-994bbe512f25",
                                "text": "The Pentagon and the CIA were being Balkanized, partially dismantled, and a Congressional investigation had focused on Screaming Fist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "923c0758-04b6-4507-98dc-c29534118b2f",
                        "source_entry_id": "97a91173-8bcc-316e-9c66-ff77ce3945ce",
