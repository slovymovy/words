                "senses": [
                    {
                        "sense_id": "36c657e7-3c65-39f5-9557-a99d398448fe",
                        "entry_id": "8d0f0bc8-e059-32e4-b03c-4606964abee5",
                        "glosses": [
                            "Leuchte, die die Fahrbahn hinter und gegebenenfalls neben dem Fahrzeug ausleuchtet und anderen Verkehrsteilnehmern anzeigt, dass das Fahrzeug rückwärtsfährt oder zu fahren beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cae2c2b-4bc5-4276-93fe-bd0f16edbb1f",
                                "sense_id": "36c657e7-3c65-39f5-9557-a99d398448fe",
                                "text": "„Die Rückfahrscheinwerfer tragen künftig ein dunkles Blinkerglas in Rauchglasoptik.“"
                            },
                            {
                                "example_id": "e4e925ce-6d7e-474a-ac33-8f98f614a966",
                                "sense_id": "36c657e7-3c65-39f5-9557-a99d398448fe",
                                "text": "„Und wie es sich für einen Prinzen gehörte, besaß er serienmäßig Ausstattungsdetails, die zu jener Zeit alle andere als selbstverständlich waren: umklappbare Rücksitzbank, Rückfahrscheinwerfer und ein Türschloss auf der rechten Seite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
