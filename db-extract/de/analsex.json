                                        "entry_id": "04f3317a-89cf-30e0-add5-9cd477a4453b",
                                        "glosses": [
                                            "A sexual activity involving stimulation of a sexual partner's anus or rectum, especially by penetration with a penis or other object."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810b5f71-a2b3-468e-80ec-57aa1deabf66",
                                                "sense_id": "d141df84-9eac-342c-a28d-dccf42fc9803",
                                                "text": "They had sex before either knew the other’s surname. They had anal sex before they had vaginal sex."
                                            },
                                            {
                                                "example_id": "d57bdb84-1043-4efb-bc0b-e157d6371ac8",
                                                "sense_id": "d141df84-9eac-342c-a28d-dccf42fc9803",
                                                "text": "It is a common misconception that anal intercourse is an exclusively homosexual male practice. […] As elsewhere in Africa, little data exist on the role of anal sex in HIV acquisition in women in the general population […]"
                                            }
                                        ]
                                    }
                                ]
