                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'archéologue a découvert un ancien <w>fusil</w> en métal auprès des pierres de silex."
                        },
                        {
                            "text": "On frappait vivement le <w>fusil</w> contre la pierre pour obtenir des étincelles."
                        }
