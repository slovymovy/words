                        "entry_id": "3f31f8f5-00b9-321f-afa1-927aef8a7e2e",
                        "glosses": [
                            "Aufbewahrungsort für Waffen; früher oft eigener Raum in einer Burg; auch auf Kriegsschiffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28464934-781d-49f3-832f-e30ff81833e8",
                                "sense_id": "aadb9030-69a4-360e-8cc3-f411dc774590",
                                "text": "Geht in die Waffenkammer und greift zu den Waffen!"
                            },
                            {
                                "example_id": "1ae455bf-ee71-42c2-b6cb-a864faf79903",
                                "sense_id": "aadb9030-69a4-360e-8cc3-f411dc774590",
                                "text": "„Den gewonnenen Raum in der Waffenkammer musste ich allein mit Wolfram auffüllen, da sich dort schon ein Einzelner kaum bewegen konnte.“"
                            },
                            {
                                "example_id": "968d08c5-0cf2-4c1e-ade0-5a85f6db17b6",
                                "sense_id": "aadb9030-69a4-360e-8cc3-f411dc774590",
                                "text": "„Gerade vor uns lag die Waffenkammer.“"
                            }
                        ],
