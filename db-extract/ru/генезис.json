                "senses": [
                    {
                        "sense_id": "86ffa3fd-dfd2-3aec-acdb-86652da49825",
                        "entry_id": "6b6a74c6-23df-3037-adf1-70a955b3546d",
                        "glosses": [
                            "книжн. происхождение, возникновение, зарождение, начало чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa73773-5c03-4b3f-b675-580d6daa39b1",
                                "sense_id": "86ffa3fd-dfd2-3aec-acdb-86652da49825",
                                "text": "Новелла — литературный малый повествовательный жанр, сопоставимый по объёму с рассказом, но отличающийся от него генезисом, историей и структурой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c09a3800-8e0c-4293-9f0c-0cded1dd553b",
                        "source_entry_id": "6b6a74c6-23df-3037-adf1-70a955b3546d",
                        "source_sense_id": "86ffa3fd-dfd2-3aec-acdb-86652da49825",
                        "target_lang_word": "genesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f6b88a-37b6-3356-9726-8f0767f988e6",
                                        "entry_id": "26bbce7e-ced8-352e-a7ad-1cca67aabc55",
                                        "glosses": [
                                            "The origin, start, or point at which something comes into being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f07717b5-08ce-4011-8824-634ff1244bbe",
                                                "sense_id": "d8f6b88a-37b6-3356-9726-8f0767f988e6",
                                                "text": "Some point to the creation of Magna Carta as the genesis of English common law."
                                            },
                                            {
                                                "example_id": "1175eb0a-b152-4cc0-90bf-2a6ce7de152c",
                                                "sense_id": "d8f6b88a-37b6-3356-9726-8f0767f988e6",
                                                "text": "The genesis of the Chinese bronze mirror can be traced far back into the Chou dynasty. Some pieces that may possibly date from the eighth century b.c., but certainly predate the year 655 b.c., were unearthed in 1956–1957 at Shang-ts’ung-ling near San-men-hsia in western Honan Province."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6471149b-69ef-419e-baf4-4415085506f3",
                        "source_entry_id": "6b6a74c6-23df-3037-adf1-70a955b3546d",
                        "source_sense_id": "86ffa3fd-dfd2-3aec-acdb-86652da49825",
                        "target_lang_word": "origin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "origin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db47246b-fa38-301a-b8a9-cdeab5cc0f32",
                                        "entry_id": "61c883cd-8ecc-3b31-b68a-807b689f1521",
                                        "glosses": [
                                            "The beginning of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d1eeb1-3a83-4a34-9781-641153b64e4f",
                                                "sense_id": "db47246b-fa38-301a-b8a9-cdeab5cc0f32",
                                                "text": "place of origin"
                                            },
                                            {
                                                "example_id": "464829e2-294d-4c90-a847-cfeed072c099",
                                                "sense_id": "db47246b-fa38-301a-b8a9-cdeab5cc0f32",
                                                "text": "trace the origin of something"
                                            },
                                            {
                                                "example_id": "317ef9a0-13e3-4e28-b9f9-d7294ce729c4",
                                                "sense_id": "db47246b-fa38-301a-b8a9-cdeab5cc0f32",
                                                "text": "unknown origin"
                                            },
                                            {
                                                "example_id": "f4ea014f-f0e8-4009-8d94-47bffffe9954",
                                                "sense_id": "db47246b-fa38-301a-b8a9-cdeab5cc0f32",
                                                "text": "The custom has its origin in ancient Greece."
                                            },
                                            {
                                                "example_id": "f0e372ff-faa4-4e2d-a98e-3d2bd01aa97b",
                                                "sense_id": "db47246b-fa38-301a-b8a9-cdeab5cc0f32",
                                                "text": "Scientists are studying the origin of the universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7315ad52-0e32-39fe-bcb8-d9d62652e84b",
                                        "entry_id": "61c883cd-8ecc-3b31-b68a-807b689f1521",
                                        "glosses": [
                                            "The source of a river, information, goods, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a46dc0-b065-4212-8562-01d2dd1179d0",
                                                "sense_id": "7315ad52-0e32-39fe-bcb8-d9d62652e84b",
                                                "text": "It is clear that the origin of the truth would be an admirable criterion of this sort, if only the various origins could be discriminated from one another from this point of view, and the history of dogmatic opinion shows that origin has always been a favorite test. Origin in immediate intuition; origin in pontifical authority; origin in supernatural revelation, as by vision, hearing, or unaccountable impression; origin in direct possession by a higher spirit, expressing itself in prophecy and warning; origin in automatic utterance generally,—these origins have been stock warrants for the truth of one opinion after another which we find represented in religious history."
                                            },
                                            {
                                                "example_id": "d4badfc6-5123-4873-b296-597042c37e0b",
                                                "sense_id": "7315ad52-0e32-39fe-bcb8-d9d62652e84b",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths. Consider for a moment the origins of almost any word we have for bad language – \"profanity\", \"curses\", \"oaths\" and \"swearing\" itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496b731c-1008-37c4-a7ca-2ea341ad7a27",
                                        "entry_id": "61c883cd-8ecc-3b31-b68a-807b689f1521",
                                        "glosses": [
                                            "The point at which the axes of a coordinate system intersect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73eceeee-a24b-37cd-9293-26d952eb53df",
                                        "entry_id": "61c883cd-8ecc-3b31-b68a-807b689f1521",
                                        "glosses": [
                                            "The proximal end of attachment of a muscle to a bone that will not be moved by the action of that muscle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5136a41e-9ee1-37ed-93e7-4944f5455c82",
                                        "entry_id": "61c883cd-8ecc-3b31-b68a-807b689f1521",
                                        "glosses": [
                                            "An arbitrary point on Earth's surface, chosen as the zero for a system of coordinates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f5c128d-c2bd-3fe4-ba35-2100281ce156",
                                        "entry_id": "61c883cd-8ecc-3b31-b68a-807b689f1521",
                                        "glosses": [
                                            "Ancestry."
                                        ],
