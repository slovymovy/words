                ],
                "senses": [
                    {
                        "sense_id": "5780d4ad-8a35-32c9-9de5-35e7e6247189",
                        "entry_id": "a2e5e2e3-8c7e-3e0b-81ea-cac33a223484",
                        "glosses": [
                            "Action de renouveler l’air au moyen de ventilateurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05289a63-678a-4679-960d-3885468ab1a9",
                                "sense_id": "5780d4ad-8a35-32c9-9de5-35e7e6247189",
                                "text": "L’installation d’une filature doit comprendre également une organisation du système de ventilation, d’humidification et de chauffage."
                            },
                            {
                                "example_id": "3990c9f8-bac0-4cc0-9684-6b91b3adac80",
                                "sense_id": "5780d4ad-8a35-32c9-9de5-35e7e6247189",
                                "text": "Longtemps confuse, la situation s’éclaircit à bord du cargo à mesure que le système de ventilation désenfumait le pont principal."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba26dd38-a84f-32e4-b866-38a53705048d",
                        "entry_id": "a2e5e2e3-8c7e-3e0b-81ea-cac33a223484",
                        "glosses": [
                            "Action de ventiler, de répartir."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "87df3224-b82b-4447-bc67-e83f579ec04e",
                                "sense_id": "ba26dd38-a84f-32e4-b866-38a53705048d",
                                "text": "Ce régime est notamment tributaire d’une subtile ventilation des effets attribués à la décision de réception des travaux d’une part, à l’établissement du décompte général et définitif du marché de maîtrise d’œuvre d’autre part."
                            },
                            {
                                "example_id": "eb197779-a518-42dd-adeb-c2bb75912907",
                                "sense_id": "ba26dd38-a84f-32e4-b866-38a53705048d",
                                "text": "On n’a pas fait la ventilation de cette somme, la ventilation de biens."
                            },
                            {
                                "example_id": "9809b125-ea5d-4b94-977b-55f813c0f2c4",
                                "sense_id": "ba26dd38-a84f-32e4-b866-38a53705048d",
                                "text": "On a fait la ventilation du domaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "10a96e82-9075-334b-9e0c-cc9961b871cb",
                        "entry_id": "a2e5e2e3-8c7e-3e0b-81ea-cac33a223484",
                        "glosses": [
                            "Régulation"
                        ],
                        "tags": [
                            "Transport aérien"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5e64393-726d-44c7-a3a4-7d932d5dc1b2",
                        "source_entry_id": "a2e5e2e3-8c7e-3e0b-81ea-cac33a223484",
                        "source_sense_description": "action de renouveler l’air",
                        "target_lang_word": "Lufterneuererung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "550ca52d-f1d8-4857-b26d-7230a231b5f9",
                        "source_entry_id": "a2e5e2e3-8c7e-3e0b-81ea-cac33a223484",
                        "source_sense_description": "action de renouveler l’air",
                        "target_lang_word": "Lufttechnik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lufttechnik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                                        "entry_id": "477f3a6d-e9f9-3675-9067-63bf42cb0d84",
                                        "glosses": [
                                            "Behandlung und Versorgung bestimmter Bereiche mit Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ffb644-5c49-4a42-89ee-dd4f5c52d15d",
                                                "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                                                "text": "„Nachhaltigkeitsthemen wie Arbeitsschutz, Maschinensicherheit und Umweltschutz spielen in den Anwendungsfeldern der Lufttechnik eine besonders große Rolle.“"
                                            },
                                            {
                                                "example_id": "976d56b5-638a-4887-847f-45817749217b",
                                                "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                                                "text": "„Der Begriff „Lufttechnik” sowie die weitere Untergliederung sind in der DIN 1946/Teil 1 dargestellt. Zwei grundsätzliche Richtungen werden mit den Begriffen Raumlufttechnik und Prozesslufttechnik unterschieden.“"
                                            },
                                            {
                                                "example_id": "43f6a979-ac88-41fd-8e6f-77a344c1d056",
                                                "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                                                "text": "„Die Lufttechnik ist ein fester Bestandteil moderner Fertigungsstätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b58f143-8bbe-420d-b0a8-58d79155e9ac",
                        "source_entry_id": "a2e5e2e3-8c7e-3e0b-81ea-cac33a223484",
                        "source_sense_description": "action de renouveler l’air",
                        "target_lang_word": "Lüftung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lüftung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2877267c-08f6-3483-9ed5-fe7426904cbc",
                                        "entry_id": "2a1fe9ce-5a9b-35a7-8183-beb1bb57eec4",
                                        "glosses": [
                                            "das Lüften; Versorgung eines Raumes/Systems mit Frischluft durch Luftaustausch oder kontinuierlichen Luftwechsel"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "330a4a86-2b05-4abe-bff4-86665c46abba",
                                                "sense_id": "2877267c-08f6-3483-9ed5-fe7426904cbc",
                                                "text": "„Lüftungsleitungen, in denen sich in besonderem Maße brennbare Stoffe ablagern können (z.B. Abluftleitungen von Dunstabzugshauben in Wohnungsküchen) oder die der Lüftung von Räumen mit erhöhter Brand- oder Explosionsgefahr dienen, dürfen untereinander und mit anderen Lüftungsleitungen nicht verbunden sein, es sei denn, die Übertragung von Feuer und Rauch ist durch geeignete Brandschutzklappen verhindert.“"
                                            },
                                            {
                                                "example_id": "0ebdcbf8-404f-422c-9653-8e40bf0f7de2",
                                                "sense_id": "2877267c-08f6-3483-9ed5-fe7426904cbc",
                                                "text": "„Die Lüftung der Tunnel im Eisenbahnbetrieb vollzieht sich in kürzeren Tunneln, auch in stärkeren Steigungen meist in natürlicher Weise und ist abhängig von der Lage der Tunnelmündungen, den Wärmeunterschieden an diesen, ihrer gegenseitigen Höhenlage und der herrschenden Windrichtung.“"
                                            },
                                            {
                                                "example_id": "99e6b3c3-f8cd-4cd7-a35a-477e1c3b943d",
                                                "sense_id": "2877267c-08f6-3483-9ed5-fe7426904cbc",
                                                "text": "„Diese Art der Lüftung (natürliche Lüftung) ist nur in der wärmeren Jahreszeit bei günstiger Witterung durchführbar; sie hat den Nachteil, daß die Reisenden durch Zugluft, Sand, Rauch, Flugasche u.s.w. belästigt werden.“"
                                            },
                                            {
                                                "example_id": "ac5ce6d3-aaf5-43ca-a97c-ef341b3072aa",
                                                "sense_id": "2877267c-08f6-3483-9ed5-fe7426904cbc",
                                                "text": "Die Lüftung eines geschlossenen Raumes kann manuell, durch regelmäßiges Fensterlüften oder maschinell, durch eine Lüftungstechnische Anlage geschehen."
                                            },
                                            {
                                                "example_id": "443b0cf5-1c79-4c16-8b90-f1573416768f",
                                                "sense_id": "2877267c-08f6-3483-9ed5-fe7426904cbc",
                                                "text": "„Lüftung ist die Erneuerung der Raumluft durch direkte oder indirekte Zuführung von Außenluft. Die Lüftung erfolgt durch a.) freie Lüftung oder b.) lüftungstechnische Anlagen (im DIN-und VDI-Regelwerk raumlufttechnische Anlagen - RLT-Anlage genannt/Technische Lüftung).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85c24129-749f-3974-a490-971ea3300856",
                                        "entry_id": "2a1fe9ce-5a9b-35a7-8183-beb1bb57eec4",
                                        "glosses": [
                                            "technische Teile und Anlagen für [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ba2c15-0e1f-4e2e-916d-c759e2bbb8d7",
                                                "sense_id": "85c24129-749f-3974-a490-971ea3300856",
                                                "text": "Die Lüftung eines geschlossenen Raumes kann manuell, durch regelmäßiges Fensterlüften oder maschinell, durch eine Lüftungstechnische Anlage geschehen."
                                            },
                                            {
                                                "example_id": "5b5cebb5-dd9e-4100-91a0-fb70080329ca",
                                                "sense_id": "85c24129-749f-3974-a490-971ea3300856",
                                                "text": "„Lüftung ist die Erneuerung der Raumluft durch direkte oder indirekte Zuführung von Außenluft. Die Lüftung erfolgt durch a.) freie Lüftung oder b.) lüftungstechnische Anlagen (im DIN-und VDI-Regelwerk raumlufttechnische Anlagen - RLT-Anlage genannt/Technische Lüftung).“"
                                            },
                                            {
                                                "example_id": "8f058786-95a3-40fb-a82a-8beff9cf37e7",
                                                "sense_id": "85c24129-749f-3974-a490-971ea3300856",
                                                "text": "Heute Mittag ist unsere Lüftung ausgefallen und wir öffneten die Fenster."
                                            },
                                            {
                                                "example_id": "c25b8ba6-7d1b-466f-bbe9-90b33d0fb729",
                                                "sense_id": "85c24129-749f-3974-a490-971ea3300856",
                                                "text": "„Eine Lüftung muss nach DIN 1946-6[1] nutzerunabhängig funktionieren, d.h. auch bei Abwesenheit der Nutzer.“"
                                            },
                                            {
                                                "example_id": "9a61720f-4738-41ee-894d-7fbf97494e6d",
                                                "sense_id": "85c24129-749f-3974-a490-971ea3300856",
                                                "text": "„Die DIN 1946 Teil 2 als eine wesentliche Richtlinie für die Lüftung von Nichtwohngebäuden wird ersetzt durch die DIN EN 13779.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
