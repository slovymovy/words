                "senses": [
                    {
                        "sense_id": "e08fb985-bc93-3c4a-87c8-0f9d334002f5",
                        "entry_id": "f0cd629a-fe08-3f6d-ae40-27f1ef17fbc8",
                        "glosses": [
                            "давать наставления; поучать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b5a544-98fe-4fc2-ac50-7b91377ece0e",
                                "sense_id": "e08fb985-bc93-3c4a-87c8-0f9d334002f5",
                                "text": "От нечего делать старик наставлял покупателя, как надо жить и как вести свои дела, и при этом всё ставил в пример самого себя."
                            }
                        ]
                    },
                    {
                        "sense_id": "da7f5a63-3433-39bc-ae09-41bd507c7e34",
                        "entry_id": "f0cd629a-fe08-3f6d-ae40-27f1ef17fbc8",
                        "glosses": [
                            "устар. ставить, устанавливать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf891f65-cb6a-4122-a475-242123696c8a",
                                "sense_id": "da7f5a63-3433-39bc-ae09-41bd507c7e34",
                                "text": "— Нет, кругом никого нет. Авдотья Марковна самовар в столовой наставляет."
                            },
                            {
                                "example_id": "cc5f3ee4-cc1c-4ce4-a571-f18bd6d9cfcb",
                                "sense_id": "da7f5a63-3433-39bc-ae09-41bd507c7e34",
                                "text": "Тишка (немедленно наставляет гвоздь в первое попавшееся место и колотит его со всей мочи)."
                            }
                        ]
                    }
                ],
