    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea247a63-47f8-352d-9b79-5f64119e1b26",
                    "sense_definition": "Récipient destiné à recevoir les déchets et les ordures ménagères.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dechets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de jeter les emballages vides dans la <w>poubelle</w> de la cuisine."
                        },
                        {
                            "text": "Il sort les <w>poubelles</w> tous les soirs avant d'aller se coucher."
                        }
                    ],
                    "synonyms": [
                        "boîte à ordures",
                        "boite à ordures"
                    ],
                    "common_phrases": [
                        "jeter à la poubelle",
                        "sac poubelle",
                        "vider la poubelle"
                    ]
                },
                {
                    "sense_id": "a1bca21d-547f-3318-9f5e-83c385c10b1e",
                    "sense_definition": "Espace de stockage temporaire d'un ordinateur contenant les fichiers supprimés.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu as effacé ce document par erreur, regarde dans la <w>poubelle</w> de ton ordinateur."
                        },
                        {
                            "text": "Pense à vider la <w>poubelle</w> pour libérer de la mémoire sur ton disque."
                        }
                    ],
                    "common_phrases": [
                        "vider la poubelle"
                    ]
                },
                {
                    "sense_id": "42e0a692-32a5-3b96-9c20-bfcd9c397c21",
                    "sense_definition": "Ensemble des résidus, des détritus ou des ordures accumulées.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "dechets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a trop de <w>poubelle</w> accumulée sur le trottoir depuis la grève des éboueurs."
                        },
                        {
                            "text": "Les odeurs de <w>poubelle</w> deviennent insupportables avec la forte chaleur de l'été."
                        }
                    ],
                    "synonyms": [
                        "déchets",
                        "ordures"
                    ]
