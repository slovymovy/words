{
    "word_family": [
        "rendering",
        "rendition",
        "renderer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3f6dd13-bd5a-3734-a1a7-0ed32e018dc7",
                    "sense_definition": "To cause someone or something to be in a specified condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "cause_to_be",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news <w>rendered</w> him speechless for several minutes.",
                            "target_lang_translations": {
                                "ru": "Внезапная новость <w>лишила</w> его дара речи на несколько минут.",
                                "zh": "突如其来的消息<w>让</w>他好几分钟都说不出话来。"
                            }
                        },
                        {
                            "text": "A lack of maintenance can <w>render</w> useless even the most expensive equipment.",
                            "target_lang_translations": {
                                "ru": "Отсутствие технического обслуживания может <w>сделать</w> бесполезным даже самое дорогое оборудование.",
                                "zh": "缺乏维护甚至会<w>使</w>最昂贵的设备也变得毫无用处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "make"
                    ],
                    "common_phrases": [
                        "render useless",
                        "render helpless",
                        "render obsolete"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить кого-либо или что-либо в определенное состояние.",
                        "zh": "使某人或某物处于某种特定状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать",
                                "target_lang_sense_clarification": "изменять состояние"
                            },
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "в состояние"
                            },
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "в каком-либо виде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使",
                                "target_lang_sense_clarification": "使某人或某物进入某种状态"
                            },
                            {
                                "target_lang_word": "让",
                                "target_lang_sense_clarification": "较口语，表示让某人或某物变成某种状态"
                            },
                            {
                                "target_lang_word": "致使",
                                "target_lang_sense_clarification": "较正式，表示导致某种结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fcb9114-9647-34b1-83f4-7e019309b23b",
                    "sense_definition": "To provide or give something, such as help, a service, or an account of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "give_provide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization is always ready to <w>render</w> assistance to those in need.",
                            "target_lang_translations": {
                                "ru": "Организация всегда готова <w>оказать</w> помощь нуждающимся.",
                                "zh": "该组织随时准备向有需要的人<w>提供</w>帮助。"
                            }
                        },
                        {
                            "text": "He was asked to <w>render</w> an account of his expenses during the trip.",
                            "target_lang_translations": {
                                "ru": "Его попросили <w>представить</w> отчет о расходах во время поездки.",
                                "zh": "他被要求<w>说明</w>自己在旅途中的开支情况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accord"
                    ],
                    "common_phrases": [
                        "render assistance",
                        "render a service",
                        "render an account"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять или давать что-либо, например помощь, услугу или отчет о чем-либо.",
                        "zh": "提供或给予某物，例如帮助、服务，或对某事作出说明、报告。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оказывать",
                                "target_lang_sense_clarification": "помощь или услугу"
                            },
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "сведения или услуги"
                            },
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "отчет или объяснение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提供",
                                "target_lang_sense_clarification": "提供帮助、服务等"
                            },
                            {
                                "target_lang_word": "给予",
                                "target_lang_sense_clarification": "较正式，给予帮助、支持等"
                            },
                            {
                                "target_lang_word": "作出",
                                "target_lang_sense_clarification": "用于报告、说明等较正式内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e8f038c-3212-377c-8406-503154844891",
                    "sense_definition": "To translate text or speech from one language into another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult to <w>render</w> poetry into another language without losing its soul.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>перевести</w> поэзию на другой язык, не потеряв ее душу.",
                                "zh": "要把诗歌<w>翻译</w>成另一种语言而不失其神韵，往往很难。"
                            }
                        },
                        {
                            "text": "The translator tried to <w>render</w> the technical terms accurately for the audience.",
                            "target_lang_translations": {
                                "ru": "Переводчик старался точно <w>передать</w> технические термины для аудитории.",
                                "zh": "译者努力为听众准确<w>传达</w>这些技术术语的意思。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "render into English"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переводить текст или речь с одного языка на другой.",
                        "zh": "把文字或口语从一种语言译成另一种语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переводить",
                                "target_lang_sense_clarification": "на другой язык"
                            },
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "смысл на другом языке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻译",
                                "target_lang_sense_clarification": "把文字或话语译成另一种语言"
                            },
                            {
                                "target_lang_word": "传达",
                                "target_lang_sense_clarification": "强调把原意在另一种语言中表达出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e50050d4-c2fc-3655-80b1-44200825272e",
                    "sense_definition": "To perform or interpret a piece of music, a role in a play, or an artistic work.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young violinist <w>rendered</w> the concerto with remarkable technical skill.",
                            "target_lang_translations": {
                                "ru": "Молодой скрипач <w>исполнил</w> концерт с замечательным техническим мастерством.",
                                "zh": "这位年轻的小提琴家以出色的技巧<w>演奏</w>了这首协奏曲。"
                            }
                        },
                        {
                            "text": "The actor <w>rendered</w> the character of the king with great dignity.",
                            "target_lang_translations": {
                                "ru": "Актер <w>воплотил</w> образ короля с большим достоинством.",
                                "zh": "那位演员以极大的庄重感<w>诠释</w>了国王这一角色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "render a song",
                        "render a performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять или интерпретировать музыкальное произведение, роль в пьесе или художественную работу.",
                        "zh": "演奏、表演或诠释音乐作品、戏剧角色或其他艺术作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнять",
                                "target_lang_sense_clarification": "произведение или роль"
                            },
                            {
                                "target_lang_word": "трактовать",
                                "target_lang_sense_clarification": "образ или персонажа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演奏",
                                "target_lang_sense_clarification": "演奏音乐作品，或演出作品、节目"
                            },
                            {
                                "target_lang_word": "诠释",
                                "target_lang_sense_clarification": "对角色、作品作艺术性表达"
                            },
                            {
                                "target_lang_word": "演绎",
                                "target_lang_sense_clarification": "较宽泛，可指表演或演绎作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "940a2b99-448d-3957-8eff-20690305bb7c",
                    "sense_definition": "To process a digital image or model using computer software to create a final display.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer took several hours to <w>render</w> the complex 3D animation.",
                            "target_lang_translations": {
                                "ru": "Компьютеру потребовалось несколько часов, чтобы <w>отрендерить</w> сложную 3D-анимацию.",
                                "zh": "电脑花了好几个小时才<w>渲染</w>出这个复杂的3D动画。"
                            }
                        },
                        {
                            "text": "Modern graphics cards can <w>render</w> high-quality images in real time.",
                            "target_lang_translations": {
                                "ru": "Современные видеокарты могут <w>визуализировать</w> высококачественные изображения в реальном времени.",
                                "zh": "现代显卡可以实时<w>渲染</w>高质量图像。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "render in 3D",
                        "render an image"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать цифровое изображение или модель с помощью программного обеспечения для создания финального изображения.",
                        "zh": "用计算机软件处理数字图像或模型，以生成最终显示画面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визуализировать",
                                "target_lang_sense_clarification": "создавать изображение"
                            },
                            {
                                "target_lang_word": "рендерить",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "отрисовывать",
                                "target_lang_sense_clarification": "графику"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "渲染",
                                "target_lang_sense_clarification": "计算机图形学中生成最终图像"
                            },
                            {
                                "target_lang_word": "生成",
                                "target_lang_sense_clarification": "强调生成画面结果"
                            },
                            {
                                "target_lang_word": "绘制",
                                "target_lang_sense_clarification": "偏技术语境，指把图像绘制出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "437dcc84-9832-3992-8b65-2f8bc09c15d2",
                    "sense_definition": "To officially announce or deliver a formal decision or judgment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury took three days of deliberation to <w>render</w> a verdict.",
                            "target_lang_translations": {
                                "ru": "Присяжным потребовалось три дня обсуждений, чтобы <w>вынести</w> вердикт.",
                                "zh": "陪审团经过三天审议才<w>作出</w>裁决。"
                            }
                        },
                        {
                            "text": "The judge will <w>render</w> a decision on the motion next week.",
                            "target_lang_translations": {
                                "ru": "Судья <w>вынесет</w> решение по ходатайству на следующей неделе.",
                                "zh": "法官将于下周<w>作出</w>对该动议的决定。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "render a verdict",
                        "render a decision",
                        "render a judgment"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально объявлять или выносить формальное решение или приговор.",
                        "zh": "正式宣布或作出决定、裁决或判决。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выносить",
                                "target_lang_sense_clarification": "вердикт или решение"
                            },
                            {
                                "target_lang_word": "выносить постановление",
                                "target_lang_sense_clarification": "официально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作出",
                                "target_lang_sense_clarification": "正式作出裁决、决定或判决"
                            },
                            {
                                "target_lang_word": "宣告",
                                "target_lang_sense_clarification": "强调正式宣布判决或裁定"
                            },
                            {
                                "target_lang_word": "宣判",
                                "target_lang_sense_clarification": "多用于法院正式判决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4e5f9e6-9b0f-304a-bf2a-9fc975d96d22",
                    "sense_definition": "To melt down fat from meat by cooking it slowly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>render</w> the fat from the bacon before adding the vegetables.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>вытопить</w> жир из бекона, прежде чем добавлять овощи.",
                                "zh": "加蔬菜之前，你应该先把培根里的油脂<w>熬出</w>来。"
                            }
                        },
                        {
                            "text": "The chef showed us how to <w>render</w> duck fat for later use.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар показал нам, как <w>перетапливать</w> утиный жир для последующего использования.",
                                "zh": "主厨向我们演示了如何<w>熬制</w>鸭油以备后用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "render off"
                    ],
                    "common_phrases": [
                        "render fat",
                        "render down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вытапливать жир из мяса путем медленного приготовления.",
                        "zh": "通过慢火加热，把肉里的脂肪熬出来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытапливать",
                                "target_lang_sense_clarification": "жир"
                            },
                            {
                                "target_lang_word": "перетапливать",
                                "target_lang_sense_clarification": "сало или жир"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "熬出",
                                "target_lang_sense_clarification": "把肉中的油脂慢慢加热逼出来"
                            },
                            {
                                "target_lang_word": "熬制",
                                "target_lang_sense_clarification": "烹饪中把油脂慢慢熬出来"
                            },
                            {
                                "target_lang_word": "炼出",
                                "target_lang_sense_clarification": "较书面，指提炼动物油脂"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdbe6127-28b4-3695-9438-3f5a3da004c7",
                    "sense_definition": "A digital image or video produced by computer processing of a model.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect showed us a high-quality <w>render</w> of the proposed building.",
                            "target_lang_translations": {
                                "ru": "Архитектор показал нам качественный <w>рендер</w> предлагаемого здания.",
                                "zh": "建筑师给我们看了那栋拟建大楼的一张高质量<w>效果图</w>。"
                            }
                        },
                        {
                            "text": "A low-resolution <w>render</w> might look blocky and lack detail.",
                            "target_lang_translations": {
                                "ru": "Низкокачественная <w>визуализация</w> может выглядеть зернистой и лишенной деталей.",
                                "zh": "低分辨率的<w>渲染图</w>看起来可能有明显像素感，而且缺乏细节。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "architectural render",
                        "final render"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровое изображение или видео, полученное в результате компьютерной обработки модели.",
                        "zh": "通过计算机处理模型而生成的数字图像或视频。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рендер",
                                "target_lang_sense_clarification": "результат визуализации"
                            },
                            {
                                "target_lang_word": "визуализация",
                                "target_lang_sense_clarification": "готовое изображение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "效果图",
                                "target_lang_sense_clarification": "建筑、设计等领域常用"
                            },
                            {
                                "target_lang_word": "渲染图",
                                "target_lang_sense_clarification": "指经过渲染生成的图像"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31773b85-00d8-3e8b-9be3-de2699ec2ce4",
                    "sense_definition": "A coat of plaster or cement applied to the exterior surface of a wall.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders applied a fresh layer of <w>render</w> to the outside of the house.",
                            "target_lang_translations": {
                                "ru": "Строители нанесли свежий слой <w>штукатурки</w> на внешнюю сторону дома.",
                                "zh": "工人们在房子外墙上抹了一层新的<w>抹灰层</w>。"
                            }
                        },
                        {
                            "text": "Cracks in the <w>render</w> can lead to damp problems inside the building.",
                            "target_lang_translations": {
                                "ru": "Трещины в <w>облицовке</w> могут привести к проблемам с сыростью внутри здания.",
                                "zh": "<w>抹灰层</w>出现裂缝可能会导致建筑内部受潮。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cement render",
                        "exterior render"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой штукатурки или цемента, нанесенный на внешнюю поверхность стены.",
                        "zh": "涂在墙体外表面的灰浆层或水泥层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штукатурка",
                                "target_lang_sense_clarification": "отделочный слой"
                            },
                            {
                                "target_lang_word": "облицовка",
                                "target_lang_sense_clarification": "внешнее покрытие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抹灰层",
                                "target_lang_sense_clarification": "墙体外表的一层灰浆或水泥层"
                            },
                            {
                                "target_lang_word": "外墙抹灰",
                                "target_lang_sense_clarification": "建筑外墙表面的灰浆覆盖层"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
