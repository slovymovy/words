                                        "examples": [
                                            {
                                                "example_id": "97c01e35-91ff-4277-b2ed-e99f4abce0c6",
                                                "sense_id": "5ec7955f-0090-3066-95d1-71c647a17175",
                                                "text": "to live poorly"
