                        "glosses": [
                            "Chez les astrologues arabes, révolution d’années selon lesquelles ils règlent les événements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06a079d-3b3b-44fa-a813-4af72292820d",
                                "sense_id": "6759d1b2-8f36-3109-98a8-00285566d861",
                                "text": "Adouar, et par altération akoua. s.m. (chronol. or.) Il se dit des révolutions d'années, selon lesquelles les astrologues arabes règlent les évènements humains. Adouar est le pluriel du nom arabe dour qui signifie cycle."
                            }
                        ]
