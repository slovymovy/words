                            {
                                "example_id": "ae9622d4-d44e-4993-941f-1111f4648254",
                                "sense_id": "463667c0-1ecc-35d0-90fc-a44bf53117f4",
                                "text": "Mam na imię Diego i jestem piłkarzem z Barcelony."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bb05c29-1267-4c4f-a9ba-5c0c8e055f12",
                        "source_entry_id": "ba4998b5-a9f3-3313-86c1-c7afebd7995b",
                        "source_sense_id": "463667c0-1ecc-35d0-90fc-a44bf53117f4",
                        "target_lang_word": "Diego",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diego",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14e13236-9a5b-3d49-948d-799849881535",
                                        "entry_id": "13fa5e0c-0ac3-377e-92ac-4d966344a26a",
                                        "glosses": [
                                            "A male given name from Spanish Diego."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d317208d-9285-4e20-a9d2-045c6294af31",
                                                "sense_id": "14e13236-9a5b-3d49-948d-799849881535",
                                                "text": "Diego Maradona is helping in the fight against coronavirus in his home city by autographing a replica of the Argentina jersey he wore in the country’s 1986 World Cup final triumph to raise money for an underprivileged community."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Diego",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5132c3bb-9cb3-32d0-9275-ca22c54f1090",
                                        "entry_id": "4471bdad-7717-3303-bc99-dacc41c93489",
                                        "glosses": [
                                            "Alternative letter-case form of diego (“Spanish speaker”)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d139a97-ff0c-44be-bfec-c4461292ed88",
                                                "sense_id": "5132c3bb-9cb3-32d0-9275-ca22c54f1090",
                                                "text": "I suppose the grog they serve out so liberally to those \"Diegos\" to keep up their courage in a fight had something to do with it. By Jove! that was a narrow escape."
                                            },
                                            {
                                                "example_id": "283a38af-22d5-4c6d-97be-21ad03f81534",
                                                "sense_id": "5132c3bb-9cb3-32d0-9275-ca22c54f1090",
                                                "text": "\"You tell the law what happened out there at Rancho Del Robles Viejo. Those Mexicans have been getting away with things too long around this country. Think they still own it. It's time those Diegos were taken down a notch.\""
                                            },
                                            {
                                                "example_id": "b384a913-b163-43be-8c92-f4372ab6e371",
                                                "sense_id": "5132c3bb-9cb3-32d0-9275-ca22c54f1090",
                                                "text": "The savory aroma of ham and eggs in Jubilee's special sauce wafted toward him. His mouth watered. He reached for his knife and fork. Beyond the fort's walls, a cannon thundered. \"Damn those Diegos!\" Dickson muttered. \"Impossible to eat a meal in peace.\""
                                            },
                                            {
                                                "example_id": "858afe12-f124-44e7-93ab-132f5c18902d",
                                                "sense_id": "5132c3bb-9cb3-32d0-9275-ca22c54f1090",
                                                "text": "\"[F]orget the confession; I heard about what you did to those Diegos. All I need to know is, can I trust you? Time was, I could with my life—\" His eyes darkened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
