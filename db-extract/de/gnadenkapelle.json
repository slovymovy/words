                "senses": [
                    {
                        "sense_id": "8a1ac069-43f6-3b40-a003-a1e2960d5a4c",
                        "entry_id": "12124247-b931-3319-bdca-1eac2f0c0e97",
                        "glosses": [
                            "einfach gestaltetes, kleineres Gotteshaus, das für Andachten zur Gnade genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58a8ba1a-8b9f-4bc3-bd40-c96e83b98f3e",
                                "sense_id": "8a1ac069-43f6-3b40-a003-a1e2960d5a4c",
                                "text": "In der Gnadenkapelle finden Andachten von Gläubigen zur Gnade und für Bittgesuche an verschiedene Heilige statt."
                            },
                            {
                                "example_id": "179fe83f-4e6c-4f91-87f3-a60b7944d829",
                                "sense_id": "8a1ac069-43f6-3b40-a003-a1e2960d5a4c",
                                "text": "„Klein an Gestalt, aber groß an Geschichte und Bedeutung, beherrscht die Gnadenkapelle den weiträumigen Kapellplatz.“"
                            },
                            {
                                "example_id": "3c47cb86-acde-4125-a9a1-62223685acf3",
                                "sense_id": "8a1ac069-43f6-3b40-a003-a1e2960d5a4c",
                                "text": "„Die Beuroner Gnadenkapelle wurde in den Jahren 1898 bis 1899 nördlich an das Schiff der damals im Sinne der Beuroner Kunstschule umgestalteten Abteikirche angebaut, um dem Gnadenbild, einer spätgotischen Pietà aus der Mitte des 15. Jahrhunderts, einen würdevollen Aufstellungsort zu erschaffen.“"
                            },
                            {
                                "example_id": "6fdacfd8-bc00-4041-bbc5-908f32bd4b12",
                                "sense_id": "8a1ac069-43f6-3b40-a003-a1e2960d5a4c",
                                "text": "„Damit ist die Gnadenkapelle auch eine der ältesten Kirchen in Deutschland.“"
                            },
                            {
                                "example_id": "b3433b39-40bd-422e-a54c-9faf58087948",
                                "sense_id": "8a1ac069-43f6-3b40-a003-a1e2960d5a4c",
                                "text": "„Wer sich Maria anvertraut, den vergisst sie nicht. So haben die Erbauer der Gnadenkapelle gedacht, so erfahren es alle, die vertrauend, betend oder dankend hierher kommen.“"
                            },
                            {
                                "example_id": "70a93c51-cf99-4295-bcda-e3d883ffeb39",
                                "sense_id": "8a1ac069-43f6-3b40-a003-a1e2960d5a4c",
                                "text": "„Die Beuroner Gnadenkapelle wurde in den Jahren 1898 bis 1899 nördlich an das Schiff der damals im Sinne der Beuroner Kunstschule umgestalteten Abteikirche angebaut, um dem Gnadenbild, einer spätgotischen Pietà aus der Mitte des 15. Jahrhunderts, einen würdevollen Aufstellungsort zu erschaffen.“"
                            }
                        ],
