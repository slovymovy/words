        "nl-extract.jsonl": [
            {
                "entry_id": "69887048-cf0a-3330-9808-ad3f42a7b214",
                "word": "schadeloosstellen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8cf5cfa2-a0dd-3f62-966b-b9e41604de7b",
                        "entry_id": "69887048-cf0a-3330-9808-ad3f42a7b214",
                        "glosses": [
                            "zorgen dat een geleden nadeel zoveel mogelijk hersteld of vergoed wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648bb935-c8a8-482b-a502-e93a5f92cfaa",
                                "sense_id": "8cf5cfa2-a0dd-3f62-966b-b9e41604de7b",
                                "text": "Deze ruime vergoeding zal de getroffenen, naar verwachting, voldoende schadeloosstellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9e4f6e5-087c-41bf-8e66-3fa81cbfab2b",
                        "source_entry_id": "69887048-cf0a-3330-9808-ad3f42a7b214",
                        "source_sense_id": "8cf5cfa2-a0dd-3f62-966b-b9e41604de7b",
                        "source_sense_description": "zorgen dat een geleden nadeel zoveel mogelijk hersteld of vergoed wordt",
                        "target_lang_word": "entschädigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entschädigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                        "entry_id": "1324113e-af9d-3652-8365-7330427d55fb",
                                        "glosses": [
                                            "einen Schaden, dem man einem anderen zugefügt hat, ausgleichen oder wiedergutmachen (häufig dadurch, dass man einen angemessenen Geldbetrag zahlt)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bfd77ff-80b2-473a-8b08-29d7158449c6",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "Ich wurde als Unfallopfer von der gegnerischen Versicherung entschädigt."
                                            },
                                            {
                                                "example_id": "b3692fea-d60a-4f81-ad08-adff0e0c0e93",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "„Mit dem Zeugengeld sollen die Kosten des Zeugen (Fahrtkosten, Arbeitsausfall) entschädigt werden.“"
                                            },
                                            {
                                                "example_id": "455f7316-3046-4ce3-871b-93fa99c633e6",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "Wenn in Dänemark ein Haus durch das Errichten einer bis zu 150 Meter großen Windkraftanlage in der Nachbarschaft an Wert verliert, dann muss der Betreiber den Wertverlust des Hausbesitzer ausgleichen, die Anwohner werden direkt entschädigt."
                                            },
                                            {
                                                "example_id": "66b31f8b-4e47-489a-8894-8869ec7b3656",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "[DDR-]„Jugendliche“ [mit regimekritischen Eltern] „, die in gefängnisähnlichen Jugendwerkhöfen unentgeltlich arbeiten mussten, werden pro Monat mit 300 Euro entschädigt.“"
                                            },
                                            {
                                                "example_id": "23b929fd-58fa-4321-9b3b-8cde0e7a47a8",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "„Das Geld, mit dem sie nach der Katastrophe“ [des Hurrikan Kathrina] „für den Verlust ihrer Häuser entschädigt wurden, reichte nicht aus, um auf dem Familiengrund neu zu bauen.“"
                                            },
                                            {
                                                "example_id": "51159e87-55f7-4e88-af2e-7d1b2f05eec7",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "„Der Rücktritt Smiths ist das Ergebnis von Enthüllungen, die belegen, dass \"Hockey Canada\" jahrelang einen dubiosen Fonds verwendet hat, um Opfer sexuellen Missbrauchs zu entschädigen.“"
                                            },
                                            {
                                                "example_id": "1d5f9b5d-d992-4e53-ad3e-27ab9daad84e",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "„Vor 16 Jahren begann RWE, die Höfe und Häuser in Lützerath abzureißen und die Bewohner zu entschädigen, um dort, im Westen des Landes in Nordrhein-Westfalen, künftig Braunkohle abzubauen.“"
                                            },
                                            {
                                                "example_id": "3b14bce5-a9e0-48a5-a58c-9db330cd2c9c",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "„Vor vier Jahren hatte ein Gericht in Seoul zwei japanische Unternehmen dazu verpflichtet, einige der koreanischen Arbeiter oder deren Familien zu entschädigen.“"
                                            },
                                            {
                                                "example_id": "1f38bf44-9476-4b98-8264-5c889063ac85",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "[Schlagzeile:] „Lettland will Holocaust-Überlebende entschädigen“"
                                            },
                                            {
                                                "example_id": "77f9ced5-bce1-40d5-958e-595289525824",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "[Völkermord an den Armeniern:] „Es sind keine Fälle bekannt, in denen Deportierte für die Enteignung entschädigt wurden.“"
                                            },
                                            {
                                                "example_id": "3ed9d94f-21cd-4270-83d9-4cecfda564a2",
                                                "sense_id": "bee1e770-de81-3242-bfb0-20d240a83d97",
                                                "text": "[…] „Nach dem Kriegsende sollte die Sowjetunion die schon im Hitler-Stalin-Pakt gewonnenen ostpolnischen Gebiete behalten, dafür sollte Polen mit ostdeutschen Gebieten entschädigt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "212792cf-f2b2-3772-b714-b8b6664c0304",
                                        "entry_id": "1324113e-af9d-3652-8365-7330427d55fb",
                                        "glosses": [
                                            "sich für einen erheblichen Aufwand oder Nachteil belohnen (in der Regel nicht durch Geld)"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4c6129-a26a-41fb-ba06-eea07f81fd05",
                                                "sense_id": "212792cf-f2b2-3772-b714-b8b6664c0304",
                                                "text": "Das Aufwachsen meiner Kinder zu sehen, meine Familie, das entschädigt mich für eine entgangene Karriere."
                                            },
                                            {
                                                "example_id": "fceb417b-6951-4eb4-b125-5fb5d62a82b0",
                                                "sense_id": "212792cf-f2b2-3772-b714-b8b6664c0304",
                                                "text": "\"Wenn ich als Arzt wirklich helfen kann, das entschädigt dann für all die Nachtschichten und den Stress auf der Station.\""
                                            },
                                            {
                                                "example_id": "ef5601a5-85e9-4ad5-88fa-a08ba668546f",
                                                "sense_id": "212792cf-f2b2-3772-b714-b8b6664c0304",
                                                "text": "\"Wenn ich dann am Ende eine Medaille in der Hand halte, das würde für die vielen einsamen Stunden des Trainings entschädigen.\""
                                            },
                                            {
                                                "example_id": "c5fd9b51-ff71-4f05-a472-e111401652a0",
                                                "sense_id": "212792cf-f2b2-3772-b714-b8b6664c0304",
                                                "text": "Die Aussicht vom Gipfel entschädigt für den strapazösen Aufstieg."
                                            },
                                            {
                                                "example_id": "c5c03afa-5b01-4679-8199-211b7bd31159",
                                                "sense_id": "212792cf-f2b2-3772-b714-b8b6664c0304",
                                                "text": "Die Stimmung im Stadion, die Gesänge der Fans, entschädigten ein bisschen für das miserable Spiel der Mannschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d95e452-48c2-460a-9d2f-ad4bb86748e7",
                        "source_entry_id": "69887048-cf0a-3330-9808-ad3f42a7b214",
                        "source_sense_id": "8cf5cfa2-a0dd-3f62-966b-b9e41604de7b",
                        "source_sense_description": "zorgen dat een geleden nadeel zoveel mogelijk hersteld of vergoed wordt",
                        "target_lang_word": "compensate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compensate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da5b6237-d469-332b-a867-e0cf641167e2",
                                        "entry_id": "ac3405ec-7313-31de-b1b0-4fdcd5ab43d6",
                                        "glosses": [
                                            "To do (something good) after (something bad) happens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81465564-aa4a-3642-81ca-5f0df7b8af39",
                                        "entry_id": "ac3405ec-7313-31de-b1b0-4fdcd5ab43d6",
                                        "glosses": [
                                            "To pay or reward someone in exchange for work done or some other consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66289f54-c784-4ccc-a067-fe8418837ab0",
                                                "sense_id": "81465564-aa4a-3642-81ca-5f0df7b8af39",
                                                "text": "It is hard work, but they will compensate you well for it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "255cc2a5-9758-3424-81f1-43db71c02e6c",
                                        "entry_id": "ac3405ec-7313-31de-b1b0-4fdcd5ab43d6",
                                        "glosses": [
                                            "To make up for; to do something in place of something else; to correct, satisfy; to reach an agreement such that the scales are literally or (metaphorically) balanced; to equalize or make even."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bf74393-73b5-430e-9ed8-65f6239a4b42",
                                                "sense_id": "255cc2a5-9758-3424-81f1-43db71c02e6c",
                                                "text": "His loud voice cannot compensate for a lack of personality."
                                            },
                                            {
                                                "example_id": "75f48182-5913-4e09-923d-8e59c67d77fe",
                                                "sense_id": "255cc2a5-9758-3424-81f1-43db71c02e6c",
                                                "text": "To compensate me for his tree landing on my shed, my neighbor paved my driveway."
                                            },
                                            {
                                                "example_id": "2c9c74d3-0f65-43cc-b2bd-41282511dbec",
                                                "sense_id": "255cc2a5-9758-3424-81f1-43db71c02e6c",
                                                "text": "The length of the night and the dews thereof do compensate the heat of the day."
                                            },
                                            {
                                                "example_id": "e75df432-77a9-442b-a519-2a46e2eec27a",
                                                "sense_id": "255cc2a5-9758-3424-81f1-43db71c02e6c",
                                                "text": ", Preface\nThe pleasures of life do not compensate the miseries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ff9c42b-d3b1-39ce-939a-bc1e429b8df4",
                                        "entry_id": "ac3405ec-7313-31de-b1b0-4fdcd5ab43d6",
                                        "glosses": [
                                            "To adjust or adapt to a change, often a harm or deprivation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5b1b45c-3ec6-4883-9008-67a977ecac8d",
                                                "sense_id": "9ff9c42b-d3b1-39ce-939a-bc1e429b8df4",
                                                "text": "I don't like driving that old car because it always steers a little to the left so I'm forever compensating for that when I drive it. Trust me, it gets annoying real fast."
                                            },
                                            {
                                                "example_id": "cc155e2c-9043-4f4d-8b59-e28c80faadc7",
                                                "sense_id": "9ff9c42b-d3b1-39ce-939a-bc1e429b8df4",
                                                "text": "To compensate for his broken leg, Gary uses crutches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
