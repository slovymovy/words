{
    "word_family": [
        "наём",
        "наёмный",
        "нанимать",
        "нанять",
        "наниматель"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b31609d4-fc02-3117-9952-6efaf6f6fb75",
                    "sense_definition": "Военнослужащий наёмного войска, профессионал, воюющий за деньги в интересах иностранного государства или частной организации",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В армию правителя входили опытные иностранные <w>наёмники</w>. ",
                            "target_lang_translations": {
                                "en": "The ruler's army included experienced foreign <w>mercenaries</w>."
                            }
                        },
                        {
                            "text": "Опытный <w>наёмник</w> прекрасно владел всеми видами оружия.",
                            "target_lang_translations": {
                                "en": "The experienced <w>mercenary</w> had mastered all types of weapons."
                            }
                        }
                    ],
                    "synonyms": [
                        "солдат удачи"
                    ],
                    "common_phrases": [
                        "иностранный наёмник",
                        "отряд наёмников"
                    ],
                    "target_lang_definitions": {
                        "en": "A professional soldier hired to fight in a foreign army or for private interests, motivated primarily by money"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mercenary",
                                "target_lang_sense_clarification": "professional soldier hired for money"
                            },
                            {
                                "target_lang_word": "soldier of fortune",
                                "target_lang_sense_clarification": "military adventurer fighting for pay"
                            },
                            {
                                "target_lang_word": "hireling",
                                "target_lang_sense_clarification": "person hired for military service, often derogatory"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9530000-a92b-3222-8356-578982d93d6e",
                    "sense_definition": "Человек, который служит кому-либо или защищает чужие интересы исключительно из корыстных побуждений",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hireling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Журналист утверждал, что его оппоненты — продажные политические <w>наёмники</w>.",
                            "target_lang_translations": {
                                "en": "The journalist claimed that his opponents were corrupt political <w>hacks</w>."
                            }
                        },
                        {
                            "text": "Этот <w>наёмник</w> готов защищать любые взгляды за высокую плату.",
                            "target_lang_translations": {
                                "en": "This <w>mercenary</w> is willing to defend any viewpoint for a high fee."
                            }
                        }
                    ],
                    "common_phrases": [
                        "политический наёмник"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who serves someone or champions an interest purely for monetary gain or selfish motives"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mercenary",
                                "target_lang_sense_clarification": "person motivated purely by personal gain"
                            },
                            {
                                "target_lang_word": "hireling",
                                "target_lang_sense_clarification": "someone doing partisan work purely for wages"
                            },
                            {
                                "target_lang_word": "hack",
                                "target_lang_sense_clarification": "person who works purely for money, often political"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f80eaf8-b69f-3cd0-ac1e-be8f93e464e7",
                    "sense_definition": "Человек, работающий по найму; наёмный работник или батрак",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "laborer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В хозяйстве богатого купца трудился не один вольный <w>наёмник</w>.",
                            "target_lang_translations": {
                                "en": "More than one free <w>hired hand</w> worked on the rich merchant's estate."
                            }
                        },
                        {
                            "text": "Хозяин неохотно выплачивал скудное жалованье уставшим <w>наёмникам</w>.",
                            "target_lang_translations": {
                                "en": "The master grudgingly paid a meager wage to the weary <w>laborers</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "батрак"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A hired laborer or farmhand"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hired hand",
                                "target_lang_sense_clarification": "manual worker employed for wages"
                            },
                            {
                                "target_lang_word": "laborer",
                                "target_lang_sense_clarification": "hired wage worker"
                            },
                            {
                                "target_lang_word": "farmhand",
                                "target_lang_sense_clarification": "hired agricultural worker"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e4e2e87-a519-34fe-b7c3-9d57d6a5c2d9",
                    "sense_definition": "Помещик, бравший за плату во временное владение чужое имение вместе с крепостными крестьянами",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Временный <w>наёмник</w> безжалостно разорял крестьян ради собственной сиюминутной выгоды.",
                            "target_lang_translations": {
                                "en": "The temporary <w>leaseholder</w> ruthlessly ruined the peasants for his own immediate gain."
                            }
                        },
                        {
                            "text": "Деревня страдала от постоянных поборов нового жадного <w>наёмника</w>.",
                            "target_lang_translations": {
                                "en": "The village suffered from the constant extortions of the greedy new <w>tenant-master</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "арендатор"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "историческое значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A landowner or tenant who temporarily rented an estate along with its serfs for a fee"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tenant farmer",
                                "target_lang_sense_clarification": "renter of an agricultural estate"
                            },
                            {
                                "target_lang_word": "leaseholder",
                                "target_lang_sense_clarification": "one holding an estate on lease"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}