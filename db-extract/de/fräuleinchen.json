                        "examples": [
                            {
                                "example_id": "dd296a98-b1e0-4bc4-8c0e-3dcef0c220c9",
                                "sense_id": "51fbf07a-605f-3b37-9595-342b0c0a0b90",
                                "text": "„Das wär' so'n richtiger Baron fürs gnädige Fräuleinchen, – und wie lieb er's gnädige Fräuleinchen hat!“"
                            },
                            {
                                "example_id": "f4ef34f4-7852-4cd2-bf05-e28c88dd8aee",
                                "sense_id": "51fbf07a-605f-3b37-9595-342b0c0a0b90",
                                "text": "„»Eine Menge, Fräuleinchen.« Sie musterte Bettina mit freundlichem Interesse. »Sie sind doch das Fräulein von der Polizei?«“"
                            },
                            {
                                "example_id": "867a6b6d-78f0-4f9f-bb15-569f362adca0",
                                "sense_id": "51fbf07a-605f-3b37-9595-342b0c0a0b90",
                                "text": "„»Fräuleinchen?« »Ja, Fräuleinchen.« Iris musste anfangen zu lachen, obwohl es das Letzte war, wonach ihr der Sinn stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
