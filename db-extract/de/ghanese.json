                "senses": [
                    {
                        "sense_id": "73d3fcf7-d3f5-312c-bbf4-75b47959132b",
                        "entry_id": "4c2299dd-6f3f-3438-b159-8b335e55287c",
                        "glosses": [
                            "Staatsbürger von Ghana"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3b132ad5-dcbc-49da-9572-662537f8ffdb",
                                "sense_id": "73d3fcf7-d3f5-312c-bbf4-75b47959132b",
                                "text": "„Der Ghanese strahlt nicht gerade vor Begeisterung, als John ihn bittet, mich in die Lodge zu bringen.“"
                            },
                            {
                                "example_id": "9cf78513-040b-4589-881e-a76b2939fd1e",
                                "sense_id": "73d3fcf7-d3f5-312c-bbf4-75b47959132b",
                                "text": "„Der 31-jährige Ghanese, der die Schweizer Bank UBS um mindestens 2,3 Milliarden Dollar brachte, wird von Kollegen und Freunden als hochbegabt, freundlich, ja charismatisch beschrieben.“"
                            },
                            {
                                "example_id": "6056d491-951f-412e-ac6c-4a5ef24de4c9",
                                "sense_id": "73d3fcf7-d3f5-312c-bbf4-75b47959132b",
                                "text": "„Obwohl Ghana zu den sichersten und stabilsten Ländern in ganz Afrika zählt, die Sterblichkeitsrate ist hoch, der Altersdurchschnitt schockierend niedrig. Nahezu zwei Drittel aller Ghanesen sind unter 15 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
