                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "00ed380f-c5da-46b5-b609-afc934751e68",
                        "source_entry_id": "0272cbf7-30e3-3df6-b475-78bf627c027e",
                        "source_sense_id": "ee2ddb98-f599-387d-9091-4ddbb2f45245",
                        "target_lang_word": "nécromancie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nécromancie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                        "entry_id": "85111fa4-666d-392d-8315-4f5ac7528747",
                                        "glosses": [
                                            "Évocation des morts par la magie, pour avoir connaissance de l’avenir, ou de quelque autre chose de caché."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61778007-3e32-40da-8f40-5680df299925",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "La nécromancie a été très anciennement pratiquée par les peuples de l’Orient."
                                            },
                                            {
                                                "example_id": "eeca5723-c5a6-4570-82c4-4bf1cdb21d2c",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "Il [l’Inquisiteur-général Manrique de Lara] dépêcha en Biscaye l’inquisiteur de Calahorra pour qu’il y conduise une enquête minutieuse et établisse la liste des pratiques magiques et des superstitions suspectes : esprits familiers et actes sacrilèges, astrologie judiciaire, géomancie, hydromancie, pyromancie, aéromancie et nécromancie sans oublier la divination par les ongles, l’on[ych]omancie."
                                            },
                                            {
                                                "example_id": "396f0fc1-88d9-4772-bdee-b5f96bd7a9af",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "Partisan de la nécromancie, John Dee organisait en effet des séances au cours desquelles il interrogeait les spectres pour qu'ils lui révèlent des choses cachées."
                                            },
                                            {
                                                "example_id": "1edbee72-3476-42cd-9a2b-450c8bcbea46",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "Le judaïsme et le christianisme sont deux religions particulièrement hostiles à la pratique de la nécromancie …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d9fe1e-f89c-320b-8954-89d642338a6b",
                                        "entry_id": "85111fa4-666d-392d-8315-4f5ac7528747",
                                        "glosses": [
                                            "Magie en général."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11ac3ad0-e3ed-46ba-aacd-27b2e5cd1cb0",
                                                "sense_id": "45d9fe1e-f89c-320b-8954-89d642338a6b",
                                                "text": "Cette accusation de nécromancie est trop souvent mise en usage pour ne pas couvrir de mauvais desseins contre notre race."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
