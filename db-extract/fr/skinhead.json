                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skinhead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "883e6261-a7d1-3c79-a0d4-cc3fd467a6b5",
                                        "entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
                                        "glosses": [
                                            "Someone with a shaved head."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "634a3f26-6fee-3c55-ab3b-052d8e8da687",
                                        "entry_id": "2d732524-093c-30f5-b504-4dd42dc516e7",
                                        "glosses": [
                                            "A member of a subculture that arose among working-class youth in late 1960s England or its diaspora, defined by close-cropped or shaven heads and working-class clothing, and often associated with violence and white-supremacist or anti-immigrant principles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f9fa0c8-3854-475c-91e7-0f478f2428ec",
                                                "sense_id": "634a3f26-6fee-3c55-ab3b-052d8e8da687",
                                                "text": "Their rules haven't changed: Skinheads are very young, mostly between the ages of 13 and 18, and they come from strictly working class backgrounds. They wear short‐ankled denims, T‐shirts, suspenders and heavy boots known as Bovverboots (Botherboots), and their hair is shorn to an eighth of an inch all over their skulls. They dance the Reggae, a West Indian shuffle, and they drink Coca Cola and they whip up riots at soccer games."
                                            },
                                            {
                                                "example_id": "02ab4b14-3b30-49c4-bfb7-684f63a4e41a",
                                                "sense_id": "634a3f26-6fee-3c55-ab3b-052d8e8da687",
                                                "text": "By the end of the show, fights would break out all over the place: the Atlantic City skins against the crew from Philly; the oldschool skinheads feuding with overzealous fresh-cuts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
