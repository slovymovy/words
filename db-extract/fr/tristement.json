                            },
                            {
                                "example_id": "0788923e-ee9e-4de0-a236-185ad3a8c627",
                                "sense_id": "de3018bf-91cd-3c8b-88cf-199364b6d891",
                                "text": "Un exploit tristement célèbre",
                                "translation": "một thành tích nổi tiếng chẳng hay ho gì"
                            },
                            {
                                "example_id": "9d15fc4b-4c77-4a79-a344-ca9be53b6844",
