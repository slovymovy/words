{
    "word_family": [
        "seethe"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea680cf1-20de-3402-bb60-e26263bb8086",
                    "sense_definition": "Filled with intense, often suppressed anger.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left the meeting <w>seething</w> with frustration after his ideas were ignored.",
                            "target_lang_translations": {
                                "cs": "Odešel ze schůzky <w>vroucí</w> frustrací poté, co byly jeho nápady ignorovány."
                            }
                        },
                        {
                            "text": "The <w>seething</w> crowd demanded an immediate explanation from the company director.",
                            "target_lang_translations": {
                                "cs": "<w>Zuřící</w> dav požadoval okamžité vysvětlení od ředitele společnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "furious",
                        "livid",
                        "enraged"
                    ],
                    "antonyms": [
                        "calm",
                        "placid"
                    ],
                    "common_phrases": [
                        "seething with anger"
                    ],
                    "target_lang_definitions": {
                        "cs": "Naplněný intenzivním, často potlačovaným hněvem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vroucí",
                                "target_lang_sense_clarification": "vyjadřuje vnitřní hněv nebo rozhořčení"
                            },
                            {
                                "target_lang_word": "zuřící",
                                "target_lang_sense_clarification": "vyjadřuje silný vztek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb17daaf-acfd-3efb-b026-73ea902e2b52",
                    "sense_definition": "Bubbling or churning as if boiling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship struggled to stay afloat in the <w>seething</w> waters of the storm.",
                            "target_lang_translations": {
                                "cs": "Loď se snažila udržet na hladině ve <w>vroucích</w> vodách bouře."
                            }
                        },
                        {
                            "text": "Steam rose from the <w>seething</w> liquid inside the large industrial vat.",
                            "target_lang_translations": {
                                "cs": "Z <w>vroucí</w> kapaliny uvnitř velké průmyslové kádě stoupala pára."
                            }
                        }
                    ],
                    "synonyms": [
                        "bubbling",
                        "churning",
                        "boiling"
                    ],
                    "common_phrases": [
                        "seething water"
                    ],
                    "target_lang_definitions": {
                        "cs": "Bublající nebo vířící, jako by vřel."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vroucí",
                                "target_lang_sense_clarification": "doslovný význam varu nebo prudkého pohybu tekutiny"
                            },
                            {
                                "target_lang_word": "vířící",
                                "target_lang_sense_clarification": "popisuje neklidný pohyb vody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e43a93d-153f-38a6-b635-8bb2ea82389a",
                    "sense_definition": "Characterized by constant, intense, or chaotic activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They navigated through the <w>seething</w> streets of the busy capital city.",
                            "target_lang_translations": {
                                "cs": "Proplétali se <w>hemžícími se</w> ulicemi rušného hlavního města."
                            }
                        },
                        {
                            "text": "The marketplace was a <w>seething</w> mass of merchants and shoppers.",
                            "target_lang_translations": {
                                "cs": "Tržiště bylo <w>kypící</w> masou obchodníků a nakupujících."
                            }
                        }
                    ],
                    "synonyms": [
                        "teeming",
                        "bustling",
                        "swarming"
                    ],
                    "common_phrases": [
                        "seething crowd"
                    ],
                    "target_lang_definitions": {
                        "cs": "Charakterizovaný neustálou, intenzivní nebo chaotickou aktivitou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hemžící se",
                                "target_lang_sense_clarification": "popisuje místo plné pohybu a lidí"
                            },
                            {
                                "target_lang_word": "kypící",
                                "target_lang_sense_clarification": "popisuje místo plné života a aktivity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "895fa57a-51be-3495-b52a-eed155487e78",
                    "sense_definition": "The act or state of <w>seethe</w>ing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>seething</w> of the ocean waves could be heard from the shore.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>vření</w> oceánských vln bylo slyšet až z břehu."
                            }
                        },
                        {
                            "text": "There was a <w>seething</w> of discontent among the workers during the strike.",
                            "target_lang_translations": {
                                "cs": "Mezi dělníky během stávky <w>vřela</w> nespokojenost."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav nebo proces vření či neklidného pohybu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vření",
                                "target_lang_sense_clarification": "fyzikální proces nebo přeneseně stav napětí"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47355b21-808d-303b-bbce-0e2948b8a9c2",
                    "sense_definition": "Present participle and gerund of <w>seethe</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water is <w>seething</w> because the temperature is too high.",
                            "target_lang_translations": {
                                "cs": "Voda <w>vře</w>, protože teplota je příliš vysoká."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon <w>seething</w> over the unfair treatment he received.",
                            "target_lang_translations": {
                                "cs": "Celé odpoledne strávil tím, že <w>vřel</w> vztekem kvůli nespravedlivému zacházení, kterého se mu dostalo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb seethe."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa vřít."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vřící",
                                "target_lang_sense_clarification": "příčestí slovesa vřít"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}