                                "target_lang_sense_clarification": "showing firm allegiance"
                            },
                            {
                                "target_lang_word": "devoted",
                                "target_lang_sense_clarification": "very loving or loyal"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fiel",
                                "target_lang_sense_clarification": "constante en su afecto o apoyo"
                            },
                            {
                                "target_lang_word": "leal",
                                "target_lang_sense_clarification": "que guarda fidelidad y no traiciona"
                            },
                            {
                                "target_lang_word": "devoto",
                                "target_lang_sense_clarification": "dedicado con fervor o gran afecto"
                            }
