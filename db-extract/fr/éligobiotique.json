                        "glosses": [
                            "Antibiotique de synthèse formé de l’enveloppe d’un bactériophage contenant une enzyme de type nucléase qui élimine spécifiquement une bactérie en détruisant son ADN."
                        ],
                        "tags": [],
                        "examples": [
                            {
