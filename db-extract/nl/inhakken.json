                                            {
                                                "example_id": "b71bd15e-8ace-41bd-95a5-c783b71fbdf1",
                                                "sense_id": "d4cc9dea-13fb-3ed7-8997-7b467582ec01",
                                                "text": "Whereof John de Ditton holds a moiety of the village for half a carve of land."
                                            },
                                            {
                                                "example_id": "5101627c-e074-44ee-82cc-a44ec565ba59",
                                                "sense_id": "d4cc9dea-13fb-3ed7-8997-7b467582ec01",
                                                "text": "... half a carve of arable land in Ballyncore, one carve of arable land in Pales, a quarter of arable land in Clonnemeagh, half a carve of arable land in Ballyfaden, half a carve of arable land in Ballymadran, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d4422e-fabd-3515-8432-88abb1ba1cd8",
                                        "entry_id": "154dd4d0-af89-3a4c-b8af-ad11dcf05821",
                                        "glosses": [
