                        "glosses": [
                            "Marée noire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50bc74ad-15ad-47f0-abac-511d9c8c7460",
                                "sense_id": "2141c2b1-f842-3e2a-ae25-5adcb22874db",
                                "text": "Die Safer liegt seit Jahren im Roten Meer vor der Küste Jemens und droht auseinanderzubrechen. Das würde zu einem gigantischen Ölteppich mit verheerenden ökologischen und wirtschaftlichen Folgen führen.",
                                "translation": "Le Safer gît depuis des années en mer Rouge, au large du Yémen, et menace de se briser. Cela entraînerait une gigantesque marée noire aux conséquences écologiques et économiques désastreuses."
                            }
                        ]
                    }
