                                        "entry_id": "f590c5c2-5cba-3613-9541-3694d1ff7720",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe gironner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
