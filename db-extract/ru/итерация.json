                                    {
                                        "sense_id": "6b5fcb86-7193-37d7-85be-a38454159bdc",
                                        "entry_id": "1b45dc2c-1db3-3fd6-b102-0eb09b520c46",
                                        "glosses": [
                                            "A recital or a second performance; a repetition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c0dc13d-ffd2-3d4c-bcc2-22f0314e0e1a",
                                        "entry_id": "1b45dc2c-1db3-3fd6-b102-0eb09b520c46",
                                        "glosses": [
                                            "A variation or version."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b8aea4-d1ab-47fc-a7b5-7d367f980e9f",
                                                "sense_id": "2c0dc13d-ffd2-3d4c-bcc2-22f0314e0e1a",
                                                "text": "The architect drafted several iterations of the floorplan before deciding on his final design."
                                            },
                                            {
                                                "example_id": "6f39783d-f221-451c-906d-d8dcaa25bf52",
                                                "sense_id": "2c0dc13d-ffd2-3d4c-bcc2-22f0314e0e1a",
                                                "text": "Still going strong in his ninth decade, Wein celebrates his 88th birthday behind the piano accompanied by the latest iteration of his band, the Newport All-Stars, featuring tenor saxophonist […]"
                                            },
                                            {
                                                "example_id": "2b5d9d2f-6ee9-4708-be1e-650ce15d7f08",
                                                "sense_id": "2c0dc13d-ffd2-3d4c-bcc2-22f0314e0e1a",
                                                "text": "If proximity is built into the very concept of ecology, not to mention iterations of environmentalism such as the local food movement, then a distancing mode like irony seems utterly unecological and unenvironmentalist."
                                            },
                                            {
                                                "example_id": "ad005650-675e-4940-84da-513e852b8439",
                                                "sense_id": "2c0dc13d-ffd2-3d4c-bcc2-22f0314e0e1a",
                                                "text": "Three or four complete iterations of various options are needed to gain cross-industry agreement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f22dd59-29d8-3bc2-b7a8-22e39a41cd06",
                                        "entry_id": "1b45dc2c-1db3-3fd6-b102-0eb09b520c46",
                                        "glosses": [
                                            "The use of repetition in a computer program, especially in the form of a loop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "305b73ce-3c4d-3071-b8f6-12360c0f384e",
                                        "entry_id": "1b45dc2c-1db3-3fd6-b102-0eb09b520c46",
                                        "glosses": [
                                            "A single repetition of the code within such a repetitive process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a04d8247-a80a-4376-bf1e-d5312bdf0074",
                                                "sense_id": "305b73ce-3c4d-3071-b8f6-12360c0f384e",
                                                "text": "The code calculates the appropriate value at each iteration."
                                            }
                                        ]
                                    }
                                ]
                            }
