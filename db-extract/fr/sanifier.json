                "senses": [
                    {
                        "sense_id": "4c458009-cc4e-3afe-ae4d-31ded272c958",
                        "entry_id": "cbc4de1b-e3c1-3ed3-be88-e6a66511c540",
                        "glosses": [
                            "Rendre sain, assainir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8c1863f2-aece-4d45-a59a-2acaabf4bead",
                                "sense_id": "4c458009-cc4e-3afe-ae4d-31ded272c958",
                                "text": "C’est le meilleur moyen de sanifier les salles des casernes et des hôpitaux, après les avoir évacuées."
                            },
                            {
                                "example_id": "369b7d6b-09a3-4632-b26f-85fdcf75b804",
                                "sense_id": "4c458009-cc4e-3afe-ae4d-31ded272c958",
                                "text": "Les plantations d’arbres le long des rivières et des canaux, autour des lacs, sont encore des moyens puissans pour corriger l’insalubrité de l'air. Les végétaux et surtout les grands, selon les chimistes, contribuent à sanifier l’atmosphère."
                            }
                        ]
                    }
