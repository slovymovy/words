                "senses": [
                    {
                        "sense_id": "52c23268-bc9c-378b-a983-8f0bd67f2817",
                        "entry_id": "9c0306b5-baa6-3885-8319-de12a2d5c638",
                        "glosses": [
                            "A person who studies molluscs; a specialist in malacology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76bd3e66-65b7-4ce3-9889-c60633190ceb",
                                "sense_id": "52c23268-bc9c-378b-a983-8f0bd67f2817",
                                "text": "In the early 1800s the French malacologist Pierre Denys de Montfort published an account of a British ship of the line that he claimed had been sunk, and its crew devoured, by a Colossal octopus, or Kraken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "536c55f6-0dbf-4de9-a015-f36350714d26",
                        "source_entry_id": "9c0306b5-baa6-3885-8319-de12a2d5c638",
                        "source_sense_id": "52c23268-bc9c-378b-a983-8f0bd67f2817",
                        "source_sense_description": "person who studies molluscs",
                        "target_lang_word": "malacologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malacologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "728ec113-1ecf-3bd6-8e5f-0c66948c56c1",
                                        "entry_id": "d12e3c53-1578-303c-85f3-5e9b576062a8",
                                        "glosses": [
                                            "Spécialiste de la malacologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e8d677-4389-4097-92ff-570668baffff",
                                                "sense_id": "728ec113-1ecf-3bd6-8e5f-0c66948c56c1",
                                                "text": "Une solide équipe pluridisciplinaire, composée d’archéologues et de spécialistes (malacologue, géoarchéologue, géomorphologue, palynologue, technologue et tracéologue), s’est alors appliquée à faire parler le sous-sol d’Angoulème, pour déchiffrer cette succession, mais aussi et surtout pour apprécier les relations entre les hommes préhistoriques et leur environnement."
                                            },
                                            {
                                                "example_id": "d64c2c9a-7e1b-45c6-8a04-2c11f7ae4f71",
                                                "sense_id": "728ec113-1ecf-3bd6-8e5f-0c66948c56c1",
                                                "text": "Parmi eux, il y avait un malacologue, un spécialiste des coquillages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "986738e5-fc04-404f-bef1-0630a0b8678c",
                        "source_entry_id": "9c0306b5-baa6-3885-8319-de12a2d5c638",
                        "source_sense_id": "52c23268-bc9c-378b-a983-8f0bd67f2817",
                        "source_sense_description": "person who studies molluscs",
                        "target_lang_word": "Malakologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Malakologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                                        "entry_id": "9423915a-6cf9-3b56-9269-c10423c4a10f",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit Weichtieren oder Mollusken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92873c92-4e06-46cd-a9b2-9795d9348142",
                                                "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                                                "text": "„Er forschte vor allem über Weichtiere (Schnecken; Muscheln) und machte sich einen Namen als Malakologe.“"
                                            },
                                            {
                                                "example_id": "b113eb84-13e8-4ed6-b893-a158a01992bb",
                                                "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                                                "text": "„Der Entdecker und Malakologe William Healy Dall wird in Boston, Massachusetts geboren.“"
                                            },
                                            {
                                                "example_id": "f956ba12-26ab-4e77-8602-2bc86d97b8b9",
                                                "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                                                "text": "„Aber auch die Thierwelt hat ihre Vertreter, und nicht minder wie der Botaniker muss der Entomologe und Malakologe hier Arbeit finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3bb150d-be97-4a31-bdae-6984a98084a0",
