                    {
                        "sense_id": "0b0cb5de-c9a0-3e9e-9a38-fd20d24507e7",
                        "entry_id": "e6316f23-11bf-3254-b25d-d24f69974c47",
                        "glosses": [
                            "tytuł, przydomek Ducha Świętego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6024c5a-1d1a-4ea3-a525-cd51cf5fdd28",
                                "sense_id": "0b0cb5de-c9a0-3e9e-9a38-fd20d24507e7",
                                "text": "Ja zaś będę prosił Ojca, a innego Parakleta da wam, aby z wami był na zawsze"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdc40311-fd97-407f-80ac-75af75bfdcc3",
                        "source_entry_id": "e6316f23-11bf-3254-b25d-d24f69974c47",
                        "source_sense_id": "0b0cb5de-c9a0-3e9e-9a38-fd20d24507e7",
                        "target_lang_word": "Paraclete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paraclete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                        "entry_id": "28302e80-1aae-34e3-aeeb-1e5ea9752f79",
                                        "glosses": [
                                            "The Holy Spirit, the Holy Ghost, especially in its role as comforter of the faithful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db77be9-1bae-42a6-a5f4-3dde1a806add",
                                                "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                                "text": "Apples of ashes, golden bright; / Waters of bitterness, how sweet! / O banquet of a foul delight, / Prepared by thee, dark Paraclete!"
                                            },
                                            {
                                                "example_id": "545bc7df-d8ce-45ae-9bc7-8e19676ce6d5",
                                                "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                                "text": "The matter of a Paraclete’s coming, the comforter, the dove; the tongues of flame, the gift of tongues: Pentecost. Third Person of the Trinity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41fe209b-8e51-4f87-aead-95ef44df3e8d",
                        "source_entry_id": "e6316f23-11bf-3254-b25d-d24f69974c47",
                        "source_sense_id": "0b0cb5de-c9a0-3e9e-9a38-fd20d24507e7",
                        "target_lang_word": "Paraclet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paraclet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5acf1b63-6725-39db-bcf7-9695aef35690",
                                        "entry_id": "3f272225-bb1a-3814-80de-b83b250785d0",
                                        "glosses": [
                                            "Autre nom du Saint-Esprit."
                                        ],
                                        "tags": [],
                                        "note": "Toujours déterminé avec l’article défini le",
                                        "examples": [
                                            {
                                                "example_id": "cb74e5ae-3139-4c04-acd3-0927e8b20805",
                                                "sense_id": "5acf1b63-6725-39db-bcf7-9695aef35690",
                                                "text": "Inséparable du Père et du Fils, l’Esprit saint n’en est pas moins présent à la vie des disciples, alors même que le départ de Jésus les laisserait quasiment « orphelins », s’il n’y avait justement le Paraclet pour les défendre contre le monde et leur donner de vivre en communion avec le Père et le Fils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
