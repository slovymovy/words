                        "sense_id": "d361966d-2102-3c90-ad7d-3e47babd8fe8",
                        "entry_id": "82e9cb59-0061-3e52-861c-0f124ae3c2a0",
                        "glosses": [
                            "osoba, której udzielono azylu"
                        ],
                        "tags": [],
