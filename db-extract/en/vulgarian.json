                    {
                        "translation_id": "b8502add-6499-4633-af1b-f91afe57f0cc",
                        "source_entry_id": "9a3ca09b-8338-3891-9724-9347ed7f8e20",
                        "source_sense_id": "3562d5f0-c32c-3fdf-88fe-327b6665a4f3",
                        "source_sense_description": "vulgar individual",
                        "target_lang_word": "Pöbel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pöbel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                        "entry_id": "f6fc3e7a-4162-397d-867d-2971e3677715",
                                        "glosses": [
                                            "unterste Gesellschaftsschicht"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa819901-0559-43f9-8e83-e3c73588a230",
                                                "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                                "text": "Soll doch der Pöbel sehen, wo er bleibt."
                                            },
                                            {
                                                "example_id": "8052dedb-5895-4969-969c-1971f5bde977",
                                                "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                                "text": "„Sie verachtet den Pöbel vor ihrem Zaun.“"
                                            },
                                            {
                                                "example_id": "a4491053-0aa1-4021-a45e-114c02039f64",
                                                "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                                "text": "„Die Sympathien und das Geschrei des Pöbels, der Armen, der Masse waren hilfreich auf dem Weg zur Macht, aber selten der entscheidende Faktor, es sei denn, der Pöbel war gut bewaffnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                        "entry_id": "f6fc3e7a-4162-397d-867d-2971e3677715",
                                        "glosses": [
                                            "randalierende, unkontrollierbare Menschenmenge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec2c735-7374-47e7-9310-dcae0550b7e1",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Die Sympathien und das Geschrei des Pöbels, der Armen, der Masse waren hilfreich auf dem Weg zur Macht, aber selten der entscheidende Faktor, es sei denn, der Pöbel war gut bewaffnet.“"
                                            },
                                            {
                                                "example_id": "afa4b45b-6556-4251-84de-891adefdfe8f",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "Der Pöbel machte die Straßen unsicher, und wir hatten große Schwierigkeiten, aus der Stadt heraus zu kommen."
                                            },
                                            {
                                                "example_id": "5e98e1a6-eb86-47fd-8872-148e13956bba",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Der simulierte Pöbel wich in simulierter Furcht zurück.“"
                                            },
                                            {
                                                "example_id": "831f5b87-8449-45b6-97c7-03daa812da67",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Ihn traf der Hass des Pöbels, und gegen solch massive Gefühle gab es keinen Schutz.“"
                                            },
                                            {
                                                "example_id": "1821141d-169a-4b8e-a2d7-02c1b38e053a",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Er wurde Gesandter in Persien, wo er im Alter von fünfunddreißig Jahren vom Pöbel ermordet wurde, seine Witwe aber überlebte ihn achtundzwanzig Jahre und wies alle Freier ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb95d134-5f8b-49f8-9832-0778c3ec1ea6",
                        "source_entry_id": "9a3ca09b-8338-3891-9724-9347ed7f8e20",
