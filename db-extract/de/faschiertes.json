                        "source_sense_id": "a088fa06-da53-3d9f-8ac0-e34d376d6a65",
                        "source_sense_description": "österreichisch: Hackfleisch",
                        "target_lang_word": "hash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hash",
