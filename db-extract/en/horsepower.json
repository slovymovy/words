                                    {
                                        "sense_id": "fead2726-691b-345e-b883-459542d05dc4",
                                        "entry_id": "ca704879-1cd4-3111-8a3a-f7dfa1d75e25",
                                        "glosses": [
                                            "traditionelle Maßeinheit für die Leistung von Motoren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1064ccb4-aff7-4bfc-b45c-17f317335465",
                                                "sense_id": "fead2726-691b-345e-b883-459542d05dc4",
                                                "text": "Mein Auto besitzt 100 Pferdestärken."
                                            },
                                            {
                                                "example_id": "bc97a419-0b7e-49d8-815f-509f1e6fe938",
                                                "sense_id": "fead2726-691b-345e-b883-459542d05dc4",
                                                "text": "Eine Pferdestärke ist/entspricht 735.5 Watt."
                                            },
                                            {
                                                "example_id": "d69dfcec-bcd6-46e3-b7b7-4e1423e5472f",
                                                "sense_id": "fead2726-691b-345e-b883-459542d05dc4",
                                                "text": "„Und schließlich wird die Power von Automobilen nach wie vor in PS, also Pferdestärken, gemessen, auch wenn offiziell die Bezeichnung kw gültig ist.“"
                                            },
                                            {
                                                "example_id": "42c7ffe1-6a44-4156-ad81-b8523bd9148f",
                                                "sense_id": "fead2726-691b-345e-b883-459542d05dc4",
                                                "text": "„Der ist, um zu zeigen, dass das lebendige Pferd sich vor den Pferdestärken der immer zahlreicher werdenden Automobile nicht zu verstecken braucht, vom 2. April bis zum 4. Juni 1928 mit seiner Kutsche und dem Wallach »Grasmus« von Berlin nach Paris gefahren, eine Strecke von mehr als tausend Kilometern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
