                        "entry_id": "9971adce-4593-33c8-b142-c47921fab529",
                        "glosses": [
                            "zbiór wielu zjawisk czy pojęć, które rozciągają się od jednej wartości skrajnej do drugiej"
                        ],
                        "tags": [],
