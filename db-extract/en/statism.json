                                    {
                                        "sense_id": "06abba61-4bab-37e9-a0a8-56ee503ea126",
                                        "entry_id": "43353885-f592-3061-a712-bc9fa0a02577",
                                        "glosses": [
                                            "Doctrine qui préconise la concentration des organismes industriels, commerciaux, etc., entre les mains de l’État et qui exagère les droits de l’État au détriment de ceux de l’individu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095d50dd-5fe6-46e9-9630-0dd1fac8fad3",
                                                "sense_id": "06abba61-4bab-37e9-a0a8-56ee503ea126",
                                                "text": "Son développement fut, donc, une lutte incessante contre les forces de l’étatisme et celle du capitalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2c34220-d76e-4b13-b51d-9249a209620d",
                        "source_entry_id": "d11a47cf-ce14-3a56-965e-08c96d4e7540",
                        "source_sense_description": "belief in the supreme legitimacy of the state",
                        "target_lang_word": "Etatismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Etatismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                                        "entry_id": "1a7378d0-e1d0-32e4-b9d0-8d024e909df3",
                                        "glosses": [
                                            "eine politische Anschauung beziehungsweise Theorie, welche dem Staat eine besondere Bedeutung im wirtschaftlichen und sozialen Leben einräumt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03f1710d-e12e-4558-a029-6daaabed5e24",
                                                "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                                                "text": "„Der französische Etatismus kommt in der Banlieue an eine seltsame sozialpsychologische Grenze.“"
                                            },
                                            {
                                                "example_id": "60f2c8de-ed79-4599-b1a7-79de77fdffb3",
                                                "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                                                "text": "„Nationalistische Integration und Etatismus in der Wirtschaftsplanung reichen hier zur Krisenbewältigung nicht mehr aus.“"
                                            },
                                            {
                                                "example_id": "82d1c873-6ca5-400d-afeb-6e2c728383d8",
                                                "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                                                "text": "„Man kann auf jeden Fall sagen, dass der Etatismus nicht geschadet hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
