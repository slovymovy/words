                ],
                "senses": [
                    {
                        "sense_id": "c86ffa91-00a3-3272-9836-0bee2e4fb64b",
                        "entry_id": "c786dd12-0552-32e3-9335-f44d7504c8ec",
                        "glosses": [
                            "aus Kunststoff bestehender Gegenstand von besonderer Gestalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d40c1bf-76de-46a6-b7be-595bc8a46a2b",
                                "sense_id": "c86ffa91-00a3-3272-9836-0bee2e4fb64b",
                                "text": "„Der Schwerpunkt liegt bei hochwertigen und technisch anspruchsvollen Kunststoffformteilen, etwa Steckverbinder für Automobil- und Elektronikindustrie.“"
                            },
                            {
                                "example_id": "62ebce00-ca05-458f-9afe-ebbcd61286a8",
                                "sense_id": "c86ffa91-00a3-3272-9836-0bee2e4fb64b",
                                "text": "„Im Mittelpunkt der Vorträge stehen die Anforderungen und Gestaltungsmöglichkeiten bei der Entwicklung, Fertigung und erfolgreichen Realisierung von Kunststoffformteilen.“"
                            },
                            {
                                "example_id": "835f23c9-3d6d-4a2a-920d-a24d0a3ec35c",
                                "sense_id": "c86ffa91-00a3-3272-9836-0bee2e4fb64b",
                                "text": "„Ziel ist es den Teilnehmern aufzuzeigen, wie überzogene Forderungen und unnötige «Angst-Toleranzen» bei der Gestaltung von Kunststoffformteilen zu vermeiden.“"
                            },
                            {
                                "example_id": "d99a5021-20c6-4a3f-84ca-ff6bcbf41964",
                                "sense_id": "c86ffa91-00a3-3272-9836-0bee2e4fb64b",
                                "text": "„Die Firma GFK Forming GmbH produziert seit 1981 Kunststoffformteile und beliefert Handel und Industrie zuverlässig mit qualitativ hochwertigen Produkten.“"
                            },
                            {
                                "example_id": "f8f9e073-ea9b-40f2-86f9-44be831312bf",
                                "sense_id": "c86ffa91-00a3-3272-9836-0bee2e4fb64b",
                                "text": "„Im vorliegenden Forschungsprojekt wurden Grundlagen für ein neues Verfahren zur Beflockung von Kunststoffformteilen als Einstoffsystem erarbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
