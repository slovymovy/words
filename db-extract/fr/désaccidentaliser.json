                ],
                "senses": [
                    {
                        "sense_id": "a1cf32a7-d9ec-3a80-b2e2-828e67de5655",
                        "entry_id": "929ba115-b13f-3d16-9067-0ff91a6c181d",
                        "glosses": [
                            "Faire perdre son caractère accidentel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c68933-6ed8-4d41-8577-2d5c98cb073e",
                                "sense_id": "a1cf32a7-d9ec-3a80-b2e2-828e67de5655",
                                "text": "On ne peut ni « désaccidentaliser » ni « désubstantialiser » l’être limité."
                            },
                            {
                                "example_id": "7d90f828-e12d-40ba-9878-d97455e864d4",
                                "sense_id": "a1cf32a7-d9ec-3a80-b2e2-828e67de5655",
                                "text": "La réalité virtuelle est désaccidentalisée."
                            },
                            {
                                "example_id": "519e82e0-581d-407f-b682-a6d27e52ecef",
                                "sense_id": "a1cf32a7-d9ec-3a80-b2e2-828e67de5655",
                                "text": "Cette phrase, qui semble si logique, est fausse, car il ne s’agit pas là d’intelligence, de comprendre ; il s’agit d’assimiler, de communier avec l’en-soi, et pour cela, il faut se « désaccidentaliser » pour ainsi dire… se délier de l’accidentel."
                            }
                        ]
                    }
                ],
