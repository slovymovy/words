                ],
                "senses": [
                    {
                        "sense_id": "a18216c8-dfdf-3e98-807d-64e85eb8931d",
                        "entry_id": "f287b052-9f8e-3a7a-b029-f535982c500b",
                        "glosses": [
                            "een krachtige of pittige (niet-zoete) smaak bezittend zoals die van vleeswaar, kaas enz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ec69818-7497-4405-a637-93b7b094027a",
                                "sense_id": "a18216c8-dfdf-3e98-807d-64e85eb8931d",
                                "text": "Naast zoet, zuur, zout en bitter wordt hartig wel de vijfde smaak genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c9aeca5-4159-4549-b58a-0657ff382c7e",
                        "source_entry_id": "f287b052-9f8e-3a7a-b029-f535982c500b",
                        "source_sense_id": "a18216c8-dfdf-3e98-807d-64e85eb8931d",
                        "target_lang_word": "herzhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herzhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13d80dc4-b83d-30a3-9857-887366dbbae2",
                                        "entry_id": "953e4bc4-64eb-3db8-9683-e235c75bbd3a",
                                        "glosses": [
                                            "von der Ausprägung her stark und intensiv, mit Kraft, von großem Ausmaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841d5708-c65c-4ed8-a6c9-2d5be9e485c8",
                                                "sense_id": "13d80dc4-b83d-30a3-9857-887366dbbae2",
                                                "text": "„Schmausen ist ein altes deutsches Wort. Es sich gut schmecken lassen, herzhaft zugreifen und mit Genuss essen – so etwa könnte man es umschreiben.“"
                                            },
                                            {
                                                "example_id": "f0448c4b-d61c-4060-9b99-79f47fa0c5a4",
                                                "sense_id": "13d80dc4-b83d-30a3-9857-887366dbbae2",
                                                "text": "„Uns Menschen ist ansteckendes Gähnen nicht fremd: Der Gesprächspartner fängt herzhaft an zu gähnen und wir müssen wohl oder übel mitmachen.“"
                                            },
                                            {
                                                "example_id": "c268fe8e-4431-46df-852d-4c8dfd81681a",
                                                "sense_id": "13d80dc4-b83d-30a3-9857-887366dbbae2",
                                                "text": "„Unendlich einfühlsam und poetisch und klug, bildstark und immer wieder herzhaft komisch erzählt Lars von Trier Joe's Lebensgeschichte in mehreren Kapiteln.“"
                                            },
                                            {
                                                "example_id": "ca13fc70-3b6a-4b78-b64c-94c781c648e8",
                                                "sense_id": "13d80dc4-b83d-30a3-9857-887366dbbae2",
                                                "text": "„Um den Studierenden die Hemmungen zu nehmen, wickelt sie [die geschäftsführende Direktorin des Instituts für wirtschafts- und rechtswissenschaftliche Forschung der Fachhochschule Frankfurt, Andrea Ruppert,] ihr Butterbrot aus der Alufolie und beißt herzhaft hinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf13288d-6531-3352-ac78-c4439f4f356b",
                                        "entry_id": "953e4bc4-64eb-3db8-9683-e235c75bbd3a",
                                        "glosses": [
                                            "mit Mut und Entschlossenheit"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "418a984d-4537-4632-9f82-309223aefe67",
                                                "sense_id": "bf13288d-6531-3352-ac78-c4439f4f356b",
                                                "text": "„Um den Studierenden die Hemmungen zu nehmen, wickelt sie [die geschäftsführende Direktorin des Instituts für wirtschafts- und rechtswissenschaftliche Forschung der Fachhochschule Frankfurt, Andrea Ruppert,] ihr Butterbrot aus der Alufolie und beißt herzhaft hinein.“"
                                            },
                                            {
                                                "example_id": "132500e6-a4b8-42e4-8623-ad92266cb626",
                                                "sense_id": "bf13288d-6531-3352-ac78-c4439f4f356b",
                                                "text": "„Da nahm sich der Herr Schulz ein Herz und sprach gravitätisch: „so zieht denn herzhaft in den Streit, hieran erkennt man tapfre Leut.““"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "597aa473-e009-3bf7-9353-3bb26764d1af",
                                        "entry_id": "953e4bc4-64eb-3db8-9683-e235c75bbd3a",
                                        "glosses": [
                                            "gehaltvoll, einen kräftigen würzigen Geschmack habend"
                                        ],
                                        "tags": [
                                            "Nahrung",
                                            "Speisen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf97e78-9c1f-45dc-bb4b-b051412c1250",
                                                "sense_id": "597aa473-e009-3bf7-9353-3bb26764d1af",
                                                "text": "Bevorzugst Du Dein Frühstück süß oder herzhaft?"
                                            },
                                            {
                                                "example_id": "ccba6711-e4cd-4798-8e89-aea828293949",
                                                "sense_id": "597aa473-e009-3bf7-9353-3bb26764d1af",
                                                "text": "Ich mag gerne mal einen herzhaften Eintopf, zum Beispiel Chili con Carne."
                                            },
                                            {
                                                "example_id": "4ea038a6-159d-4532-b081-9439fbe9744a",
                                                "sense_id": "597aa473-e009-3bf7-9353-3bb26764d1af",
                                                "text": "„Arme Ritter“ [, das sind] getrocknete Weißbrotscheiben in Milch und Ei gewendet – süß mit Vanillesauce oder auch herzhaft mit Ketchup bestrichen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cedca522-7bd1-422f-8cf0-6ebe75b31024",
                        "source_entry_id": "f287b052-9f8e-3a7a-b029-f535982c500b",
                        "source_sense_id": "a18216c8-dfdf-3e98-807d-64e85eb8931d",
                        "target_lang_word": "savoureux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savoureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de91a08d-fb1c-315d-9f4b-84a1bf923b6a",
                                        "entry_id": "bbb6f6b5-9633-31bc-9e5b-001fbba27bca",
                                        "glosses": [
                                            "Qui a une bonne saveur, une saveur agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758175cd-d010-458d-8cef-325da3d5896a",
                                                "sense_id": "de91a08d-fb1c-315d-9f4b-84a1bf923b6a",
                                                "text": "Si vous préparez la crème anglaise la veille, elle n'en sera que plus parfumée et plus savoureuse."
                                            },
                                            {
                                                "example_id": "e3c1261c-ecd8-4c45-879d-5405a5c4d234",
                                                "sense_id": "de91a08d-fb1c-315d-9f4b-84a1bf923b6a",
                                                "text": "Nourries au foin, les biquettes ne donnaient pas un lait aussi savoureux et parfumé. Rien ne valait les pâtures gourmandes du printemps et de l'été."
                                            },
                                            {
                                                "example_id": "fe24a5b6-a5fc-48c1-9a9d-aa033d52c2ab",
                                                "sense_id": "de91a08d-fb1c-315d-9f4b-84a1bf923b6a",
                                                "text": "Le maquasipa fut mangé au repas du soir, en même temps que deux autres singes, des babouins, dont la chair fut déclarée très savoureuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae0f4407-e4c3-3a25-ab13-0b326be19bb6",
                                        "entry_id": "bbb6f6b5-9633-31bc-9e5b-001fbba27bca",
                                        "glosses": [
                                            "Qui plaît, qui provoque l’intérêt, qui séduit l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7ba0e29-f2b8-4516-9b96-5ae2dc219037",
                                                "sense_id": "ae0f4407-e4c3-3a25-ab13-0b326be19bb6",
                                                "text": "Un style savoureux."
                                            },
                                            {
                                                "example_id": "3556e92d-a77b-41dc-b369-020c29d0b080",
                                                "sense_id": "ae0f4407-e4c3-3a25-ab13-0b326be19bb6",
                                                "text": "Une plaisanterie savoureuse."
                                            },
                                            {
                                                "example_id": "ef0a6560-06fe-4fbd-be48-05c7dfc94941",
                                                "sense_id": "ae0f4407-e4c3-3a25-ab13-0b326be19bb6",
                                                "text": "Une anecdote savoureuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
