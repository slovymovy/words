                    },
                    {
                        "translation_id": "b7f5531e-161d-4176-b5c5-a608f5af21c6",
                        "source_entry_id": "785b0e73-2615-39c8-bb2e-1bcac41afac1",
                        "source_sense_id": "0beb926b-9b7d-3029-8634-6a83d6a2237e",
                        "target_lang_word": "Klampe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klampe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                                        "entry_id": "0e07ad39-68c6-3ba9-8152-724a6e5e8d3b",
                                        "glosses": [
                                            "in der Seefahrt eine Vorrichtung zum Befestigen von Fasertauwerk, die aus zwei gegenüberliegenden Hörnern besteht und auf einem Untergrund befestigt ist"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9a54a69-8b3d-478a-b65b-6c4352fc7f6b",
                                                "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                                                "text": "Zur Befestigung des Schiffs wird die Klampe in der Regel mit Kreuzschlägen und einem Kopfschlag belegt."
                                            },
                                            {
                                                "example_id": "b87cb585-1af8-442b-ac0f-4d0520d7e516",
                                                "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                                                "text": "Kleinere Klampen sind aus Kunststoff oder Holz, größere meistens aus Metall."
                                            },
                                            {
                                                "example_id": "f543c237-2667-4900-a497-2ccf559804d9",
                                                "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                                                "text": "„Smoaks begann es an der Klampe zu vertäuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4e54a16-5618-47b9-8b73-1d33904abab8",
                        "source_entry_id": "785b0e73-2615-39c8-bb2e-1bcac41afac1",
                        "source_sense_id": "0beb926b-9b7d-3029-8634-6a83d6a2237e",
                        "target_lang_word": "Klampfe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klampfe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07378a4e-3cce-3c33-8e42-f55cd282b0e7",
                                        "entry_id": "aa882842-621d-33db-9d7d-54a53360c4ff",
                                        "glosses": [
                                            "die Klampe, eine Vorrichtung zum Befestigen von Seilen in der Seefahrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf1b107-4cf9-468e-9faa-f18e5ec3e3ad",
                                                "sense_id": "07378a4e-3cce-3c33-8e42-f55cd282b0e7",
                                                "text": "An Backbord waren zwei große Klampfen in das Decksholz geschraubt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5cbc464-9f3d-3ab1-9cc5-e0052e25b4bb",
                                        "entry_id": "aa882842-621d-33db-9d7d-54a53360c4ff",
                                        "glosses": [
                                            "die Krampe, ein U-förmiges Metallteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862200c2-a711-4d11-8412-3f1443f3158e",
                                                "sense_id": "a5cbc464-9f3d-3ab1-9cc5-e0052e25b4bb",
                                                "text": "Die Klampfe wird am Bau benutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "74768432-3cf6-317c-a792-d71dbadfc548",
                                        "entry_id": "aa882842-621d-33db-9d7d-54a53360c4ff",
                                        "glosses": [
                                            "Gitarre"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ea8cf11-a523-4da8-a3b5-ed79703ab883",
                                                "sense_id": "74768432-3cf6-317c-a792-d71dbadfc548",
                                                "text": "Am Wanderziel angelangt, griff Wollweber in die Saiten seiner Klampfe und sang revolutionäre Lieder, seine Genossen sangen mit und tranken starken Schnaps aus mitgebrachten Pullen."
                                            },
                                            {
                                                "example_id": "c3dd3378-9e8c-4b23-a5a4-8b1bbea9bf23",
                                                "sense_id": "74768432-3cf6-317c-a792-d71dbadfc548",
                                                "text": "„Er strahlte, klopfte mir auf die Schulter, nahm mich mit auf sein Zimmer, wo er ein großes Foto von Brecht an der Wand hatte, darunter eine Klampfe und viele Taschenbücher auf einem selbst zusammengehauenen Regal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
