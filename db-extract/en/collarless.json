    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e5f617b7-c62b-3329-a881-37eb315f30b6",
                "word": "collarless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fa4e59c7-86fe-35ad-aea8-c82299c2a9d1",
                        "entry_id": "e5f617b7-c62b-3329-a881-37eb315f30b6",
                        "glosses": [
                            "Of a garment, having no collar."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "df8302df-acee-465c-af7e-42eb690dd710",
                                "sense_id": "fa4e59c7-86fe-35ad-aea8-c82299c2a9d1",
                                "text": "Their records have sold 2,500,000 copies, and crowds stampede for a chance to touch the hem of the collarless coats sported onstage by all four of them."
                            },
                            {
                                "example_id": "a77fcb72-2ba1-45bd-92f7-6bc2b9fcfd1b",
                                "sense_id": "fa4e59c7-86fe-35ad-aea8-c82299c2a9d1",
                                "text": "He had been to Yemen twice, once wearing the white ankle-length, collarless gown worn by most Omanis."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb6ed611-542d-3c76-9012-182bcf914dc9",
                        "entry_id": "e5f617b7-c62b-3329-a881-37eb315f30b6",
                        "glosses": [
                            "Of a man, not wearing a detachable collar."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6249198d-1cda-43d5-9b80-b7ac13fe0062",
                                "sense_id": "fb6ed611-542d-3c76-9012-182bcf914dc9",
                                "text": "The driver of the jitney was a young, swarthy prairie man, in shirt sleeves, and collarless, with a derby on one side of his head […]"
                            },
                            {
                                "example_id": "b51945dc-d9d4-40cf-9782-23744bdbe7eb",
                                "sense_id": "fb6ed611-542d-3c76-9012-182bcf914dc9",
                                "text": "He was pining for England, though he dreaded facing it, as one dreads facing a pretty girl when one is collarless and unshaven."
                            }
                        ]
                    },
                    {
                        "sense_id": "106a976c-5792-3bcc-9bde-4113f16be697",
                        "entry_id": "e5f617b7-c62b-3329-a881-37eb315f30b6",
                        "glosses": [
                            "Of a dog, not wearing a dog collar."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "99443fe9-6560-4ed5-b8ea-5af0def21da0",
                                "sense_id": "106a976c-5792-3bcc-9bde-4113f16be697",
                                "text": "I wandered about Paris like a lost dog, like a collarless dog."
                            },
                            {
                                "example_id": "295fe92d-45c3-4d23-9c5f-41fa1ccd414c",
                                "sense_id": "106a976c-5792-3bcc-9bde-4113f16be697",
                                "text": "I rescued Safi, aged eight months, from an animal shelter where she had been brought as a stray, collarless, without history."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
