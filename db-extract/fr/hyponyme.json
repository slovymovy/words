                                            {
                                                "example_id": "47632d6d-d1fb-464a-9699-23efad06ed90",
                                                "sense_id": "cbab218e-92a7-3dc5-b52e-61d6a3677b69",
                                                "text": "„Hund“ ist ein Hyponym von „Säugetier“."
                                            },
                                            {
                                                "example_id": "8d56eee9-56d8-47c6-9d33-086d6ceb16d3",
                                                "sense_id": "cbab218e-92a7-3dc5-b52e-61d6a3677b69",
                                                "text": "„Riesenschnauzer“ ist ein Hyponym von „Hund“."
                                            },
                                            {
                                                "example_id": "0c87e3fc-5184-42ff-bb93-8403b51c795b",
                                                "sense_id": "cbab218e-92a7-3dc5-b52e-61d6a3677b69",
                                                "text": "„Das Verhältnis zwischen Hyperonym (Gattungswort) und Hyponym (Spezieswort) läßt sich mit der Auflösung S₂ ist ein S₁ beschreiben…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
