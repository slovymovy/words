{
    "word_family": [
        "ball",
        "gown"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd112474-f470-38ba-a6e1-bba44de28d55",
                    "sense_definition": "A formal gown to be worn by women to balls and similar social events.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "formal_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent months searching for the perfect <w>ballgown</w> to wear to the charity gala.",
                            "target_lang_translations": {
                                "ru": "Она потратила месяцы на поиски идеального <w>бального платья</w> для благотворительного вечера."
                            }
                        },
                        {
                            "text": "The princess appeared at the top of the stairs in a stunning silk <w>ballgown</w>.",
                            "target_lang_translations": {
                                "ru": "Принцесса появилась на вершине лестницы в потрясающем шелковом <w>бальном платье</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "balldress",
                        "evening gown",
                        "evening dress"
                    ],
                    "common_phrases": [
                        "silk ballgown",
                        "elegant ballgown",
                        "floor-length ballgown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное длинное платье, предназначенное для посещения балов и подобных светских мероприятий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бальное платье",
                                "target_lang_sense_clarification": "официальный наряд для торжественных мероприятий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0213744-3350-3b3a-ae56-e42bb2af4744",
                    "sense_definition": "To roleplay romance as part of a roleplaying game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "roleplaying_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players decided to <w>ballgown</w> for the entire evening instead of fighting monsters.",
                            "target_lang_translations": {
                                "ru": "Игроки решили весь вечер <w>отыгрывать романтику</w> вместо того, чтобы сражаться с монстрами."
                            }
                        },
                        {
                            "text": "She'll take any excuse to <w>ballgown</w> when her character meets a handsome NPC.",
                            "target_lang_translations": {
                                "ru": "Она воспользуется любым поводом, чтобы <w>пофлиртовать в роли</w>, когда её персонаж встречает красавца-NPC."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used within specific roleplaying communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отыгрывать романтические отношения в рамках ролевой игры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отыгрывать романтику",
                                "target_lang_sense_clarification": "сленг в ролевых играх"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}