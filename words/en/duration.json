{
    "word_family": [
        "durable",
        "durability",
        "endure",
        "endurance",
        "during"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f0fd666-5243-3783-8943-3096408e5b9f",
                    "sense_definition": "The length of time that something lasts or continues.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_span",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>duration</w> of the flight will be about two hours and forty-five minutes.",
                            "target_lang_translations": {
                                "ru": "<w>Продолжительность</w> полета составит около двух часов сорока пяти минут."
                            }
                        },
                        {
                            "text": "She was complaining for the entire <w>duration</w> of the long commercial break.",
                            "target_lang_translations": {
                                "ru": "Она жаловалась на протяжении всей <w>длительности</w> долгого рекламного перерыва."
                            }
                        }
                    ],
                    "synonyms": [
                        "length",
                        "period",
                        "span",
                        "term"
                    ],
                    "common_phrases": [
                        "entire duration",
                        "short duration",
                        "average duration",
                        "total duration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Промежуток времени, в течение которого что-либо длится или продолжается."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продолжительность",
                                "target_lang_sense_clarification": "время существования или действия чего-либо"
                            },
                            {
                                "target_lang_word": "длительность",
                                "target_lang_sense_clarification": "протяженность во времени"
                            },
                            {
                                "target_lang_word": "срок",
                                "target_lang_sense_clarification": "определенный период времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44743bb3-e5a8-365e-8cbc-baa22d1860ed",
                    "sense_definition": "The remaining time until a current difficult situation, such as a war, comes to an end.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_span",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Food rationing will likely last for the <w>duration</w> of the conflict.",
                            "target_lang_translations": {
                                "ru": "Нормирование продовольствия, вероятно, сохранится на <w>весь</w> <w>период</w> конфликта."
                            }
                        },
                        {
                            "text": "Many families had to live in shelters for the <w>duration</w> until peace was restored.",
                            "target_lang_translations": {
                                "ru": "Многим семьям пришлось жить в убежищах <w>все</w> <w>время</w>, пока не был восстановлен мир."
                            }
                        }
                    ],
                    "common_phrases": [
                        "for the duration"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the context of wartime"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставшееся время до завершения текущей сложной ситуации, например, войны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весь период",
                                "target_lang_sense_clarification": "в течение всего времени до конца события"
                            },
                            {
                                "target_lang_word": "продолжительность",
                                "target_lang_sense_clarification": "весь срок действия (например, войны)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e16cad69-88a5-3da3-bb3a-e7224afe013d",
                    "sense_definition": "A calculation of how much the price of a bond or financial asset is likely to change when interest rates move.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The portfolio manager analyzed the <w>duration</w> of the bonds to assess interest rate risk.",
                            "target_lang_translations": {
                                "ru": "Портфельный менеджер проанализировал <w>дюрацию</w> облигаций, чтобы оценить риск изменения процентных ставок."
                            }
                        },
                        {
                            "text": "A higher <w>duration</w> implies that the asset is more sensitive to fluctuations in market rates.",
                            "target_lang_translations": {
                                "ru": "Более высокая <w>дюрация</w> означает, что актив более чувствителен к колебаниям рыночных ставок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bond duration",
                        "modified duration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расчет того, насколько сильно изменится цена облигации или финансового актива при изменении процентных ставок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дюрация",
                                "target_lang_sense_clarification": "финансовый показатель чувствительности к ставкам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}