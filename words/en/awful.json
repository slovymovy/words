                    "semantic_group_id": "awe_inspiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sat upon his throne in <w>awful</w> majesty and silence.",
                            "target_lang_translations": {
                                "ru": "Король восседал на своем троне в <w>грозном</w> величии и молчании.",
                                "tr": "Kral, <w>heybetli</w> bir azamet ve sessizlik içinde tahtında oturuyordu.",
                                "zh": "国王坐在王位上，带着<w>威严</w>与沉默。"
                            }
                        },
                        {
                            "text": "They stood trembling before the <w>awful</w> power of the erupting volcano.",
                            "target_lang_translations": {
                                "ru": "Они стояли, дрожа перед <w>устрашающей</w> мощью извергающегося вулкана.",
                                "tr": "Patlayan yanardağın <w>dehşet verici</w> gücü karşısında titreyerek durdular.",
                                "zh": "他们站在喷发的火山前，在<w>可畏</w>的力量面前瑟瑟发抖。"
                            }
