                                        "glosses": [
                                            "Gerät in Form eines Kastens^([1]); zum Beispiel Fernseher oder Radio"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38e2467-62b8-4bc9-8e79-fb0287fd62be",
                                                "sense_id": "754b618d-ad9d-3590-a4b4-14a46dc53024",
                                                "text": "Jetzt stell doch mal den blöden Kasten ab!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ed9a89a3-cf6e-381e-bb5c-e17a772be32e",
                                        "entry_id": "b5a0d74a-5a96-393f-95c2-8a71221697d4",
                                        "glosses": [
