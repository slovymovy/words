                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "596af6a3-a8d0-30ab-aef5-922b63bd8ea6",
                        "entry_id": "0e7fa8d3-fb02-31b2-a567-e57f71b49228",
                        "glosses": [
                            "Krankenpflege, Pflege"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af502250-b209-47e1-80d1-3f75f45348ce",
                        "source_entry_id": "0e7fa8d3-fb02-31b2-a567-e57f71b49228",
                        "source_sense_id": "596af6a3-a8d0-30ab-aef5-922b63bd8ea6",
                        "source_sense_description": "Medizin: Krankenpflege, Pflege",
                        "target_lang_word": "Krankenpflege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankenpflege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e23e706d-3baf-3816-bea7-524c92afb85c",
                                        "entry_id": "c8593ac2-6eab-3a6b-8263-7a23aeb1e5d4",
                                        "glosses": [
                                            "Gesamtheit der zur Pflege und Betreuung von Kranken nötigen Maßnahmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69786461-7cae-4449-b26c-acf205734fe6",
                                                "sense_id": "e23e706d-3baf-3816-bea7-524c92afb85c",
                                                "text": "Versicherte aller gesetzlichen Kassen erhalten häusliche Krankenpflege, wenn dadurch eine Krankenhausbehandlung vermieden oder verkürzt wird."
                                            },
                                            {
                                                "example_id": "3dc8c4fe-3b05-4bf9-89ad-6fe9826e53ee",
                                                "sense_id": "e23e706d-3baf-3816-bea7-524c92afb85c",
                                                "text": "Krankenpflege ist ein Beruf, der mir weltweit meine Existenz sichern kann, weil Menschen immer und überall Hilfe benötigen."
                                            },
                                            {
                                                "example_id": "d72a0edd-56cd-4b28-8218-3dc8df2d4140",
                                                "sense_id": "e23e706d-3baf-3816-bea7-524c92afb85c",
                                                "text": "Die Berufe in der Gesundheits- und Krankenpflege werden an Bedeutung gewinnen."
                                            },
                                            {
                                                "example_id": "787ebb49-0078-46df-b41b-1f34629f7ca0",
                                                "sense_id": "e23e706d-3baf-3816-bea7-524c92afb85c",
                                                "text": "Die anderen, welche nur der Erhaltung angehören, sind Ernährung, Krankenpflege, Waffen- und Ausrüstungsersatz."
                                            },
                                            {
                                                "example_id": "85d034aa-b2b2-48fe-b0ed-f4f7426bbd85",
                                                "sense_id": "e23e706d-3baf-3816-bea7-524c92afb85c",
                                                "text": "Ein großer herzerfreuender Fortschritt war aber durch die Anstrengung der Regierung für bessere Krankenpflege gemacht worden, die völkerverwüstende Pest und andere Seuchen waren – so durfte man annehmen – von den Grenzen Deutschlands ausgesperrt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29448a8d-dfd4-42ec-9ae4-ff7f63fc7e3d",
                        "source_entry_id": "0e7fa8d3-fb02-31b2-a567-e57f71b49228",
                        "source_sense_id": "596af6a3-a8d0-30ab-aef5-922b63bd8ea6",
                        "source_sense_description": "Medizin: Krankenpflege, Pflege",
                        "target_lang_word": "Pflege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pflege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                        "entry_id": "1bb75fd1-fe42-3d99-bf1c-291de4a10a5c",
                                        "glosses": [
                                            "Fürsorge, Betreuung und Versorgung von Menschen oder Tieren, die gewisse Hilfe benötigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befec080-625f-4ce4-9137-a5929432cfb6",
                                                "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                                "text": "Die Pflege eines behinderten Kindes kann nicht jede Familie zu Hause leisten."
                                            },
                                            {
                                                "example_id": "89215594-d49a-445b-9256-fdbb5c0c9f5a",
                                                "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                                "text": "„Wurde die Versorgung anfangs noch von ungelernten Kräften oder Krankenpflegern übernommen, sah man immer mehr die Notwendigkeit, die Betreuung und Pflege von Senioren als speziellen Berufszweig zu etablieren.“"
                                            },
                                            {
                                                "example_id": "5fd1949b-f2d8-4372-9962-0f7556105781",
                                                "sense_id": "2b86535c-7672-3172-a410-7d5e18f65d07",
                                                "text": "„Später jedoch, als sich Mrs. Smart bereit erklärt hatte, die kranke Frau in Pflege zu nehmen, teilte Tom den wahren Sachverhalt mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                        "entry_id": "1bb75fd1-fe42-3d99-bf1c-291de4a10a5c",
                                        "glosses": [
                                            "sämtliche Maßnahmen und Handlungen, die dazu dienen, etwas (Materielles oder Geistiges) zu erhalten, zu bewahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1af8e19-509f-4887-99e3-7881c4e41463",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "Die Pflege des Datenbestandes ist ebenso wichtig wie die Erfassung."
                                            },
                                            {
                                                "example_id": "c1add20b-0ef2-422e-b342-daca6c32e4c0",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "Tragen Sie dieses Mittel zur Pflege der Haut regelmäßig auf."
                                            },
                                            {
                                                "example_id": "2f919209-45dd-4911-9b2f-bdd0c07c9bb6",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "Viele erachten die Pflege der deutschen Sprache für notwendig."
                                            },
                                            {
                                                "example_id": "abe17746-9295-407c-8ced-6b21724b3756",
                                                "sense_id": "5a755789-76e0-3854-9d65-71db50ca944e",
                                                "text": "„Unter der geistigen Kultur endlich versteht man den Umfang und die Intensität der Pflege von Wissenschaft und Kunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
