                    }
                ],
                "senses": [
                    {
                        "sense_id": "b330faba-c874-34f3-8ddd-0840120b097c",
                        "entry_id": "27e9c605-1748-3481-b83b-e7bd72576104",
                        "glosses": [
                            "One's parent's spouse who is not one's biological parent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bae854b-03c6-47d7-83cc-980ed3172cc0",
                                "sense_id": "b330faba-c874-34f3-8ddd-0840120b097c",
                                "text": "The age at which a stepparent entered a child’s life, and whether they lived together and for how long, influences the quality of the relationship, studies show. […] As parents age, “there’s a lot of negotiation and uncertainties,” Dr. Silverstein said. “Who has the right to make decisions for stepparents becomes murky.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e837be2-618b-481f-b1e3-d646add407e8",
                        "source_entry_id": "27e9c605-1748-3481-b83b-e7bd72576104",
                        "source_sense_id": "b330faba-c874-34f3-8ddd-0840120b097c",
                        "source_sense_description": "stepfather or stepmother",
                        "target_lang_word": "stiefouder",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stiefouder",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3746d495-9633-3afa-bca3-36c8dd77f160",
                                        "entry_id": "eb5aef94-27cb-30dd-8285-899d790a289a",
