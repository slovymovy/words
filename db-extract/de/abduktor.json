                    {
                        "sense_id": "018beea5-e490-3519-a10c-6a038f9259e2",
                        "entry_id": "e8f158c4-db6c-3b5d-ab55-2d6ae3550f6d",
                        "glosses": [
                            "ein Muskel, durch dessen Kontraktion eine Extremität abgespreizt wird (Abduktion)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a28fafca-cfdb-43b6-a805-69da0c3fe155",
                                "sense_id": "018beea5-e490-3519-a10c-6a038f9259e2",
                                "text": "„Wir arbeiten wie diese gegenläufigen Muskeln, Abduktoren und Adduktoren, und dank dieser gemeinsamen Anstrengung kriegen mein Schweinehund und ich es hin, dass bis weit nach Sonnenuntergang schweißtreibend gegrübelt und gelitten, aber eben überhaupt nichts erledigt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
