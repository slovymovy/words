                ],
                "senses": [
                    {
                        "sense_id": "c53af1a7-28a2-3b8c-af3f-46d40929e507",
                        "entry_id": "80338738-a4c1-3768-9c29-9ac93c49adc6",
                        "glosses": [
                            "Geländebereich, den zu betreten Todesgefahr bedeutet, vor allem früher an der ehemaligen DDR-Grenze oder als Teil der Sicherungsanlagen von Konzentrationslagern im Dritten Reich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f77257-8542-4011-843a-10086346b627",
                                "sense_id": "c53af1a7-28a2-3b8c-af3f-46d40929e507",
                                "text": "„Von dort fuhr ich über Mustin, ein Dörfchen, hinter dem früher samt Todesstreifen die Grenze verlief und die Straße sperrte, in östliche Richtung.“"
                            },
                            {
                                "example_id": "cbdce9ab-48e9-4b09-906d-6c9a4bfa07b2",
                                "sense_id": "c53af1a7-28a2-3b8c-af3f-46d40929e507",
                                "text": "„Als Grenzabschnitt des Eisernen Vorhangs waren die Lindewerraer Flure sogar Bestandteil des Todesstreifens.“"
                            },
                            {
                                "example_id": "ddb666ee-7461-40b8-ad1f-ab8d3688be46",
                                "sense_id": "c53af1a7-28a2-3b8c-af3f-46d40929e507",
                                "text": "„Deshalb müsse man auch von West-Berlin in den Osten fahren, und das eben nicht selten, sondern immer wieder, als gäbe es nicht die beschämende Mauer und den Todesstreifen und die Todesschützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
