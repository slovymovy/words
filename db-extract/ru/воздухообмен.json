                        "target_lang_word": "ricambio d'aria",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bdac1209-4780-4bd2-af61-944f58c3f9a4",
                        "source_entry_id": "04b8fb7f-73f3-398e-9ce7-b261e51ada23",
                        "source_sense_id": "f7e4f891-e632-3680-a1f6-26f2b49d83dd",
                        "target_lang_word": "Luftwechsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftwechsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d11b7c54-0f2a-3fce-a139-d3879c2d2c93",
                                        "entry_id": "9af9af6a-d668-342b-83e2-b813597c04ca",
                                        "glosses": [
                                            "definierter und gezielter Austausch der Raumluft in geschlossenen Räumen und Gebäuden"
                                        ],
                                        "tags": [
                                            "Bauphysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd7914ec-798b-400e-96bc-12edf4a930c2",
                                                "sense_id": "d11b7c54-0f2a-3fce-a139-d3879c2d2c93",
                                                "text": "„Im Gegensatz zu alten Häusern findet deshalb auf natürliche Weise kein Luftwechsel statt.“"
                                            },
                                            {
                                                "example_id": "9785967e-4a2e-4997-8904-0ef06c6e4cd0",
                                                "sense_id": "d11b7c54-0f2a-3fce-a139-d3879c2d2c93",
                                                "text": "„Ein Luftwechsel von 25 m3/h pro m2 Nutzfläche des Labors kann dann reduziert oder auch eine natürliche Lüftung eingesetzt werden, wenn die Gefährdungsbeurteilung ergibt, dass diese Maßnahme für die vorgesehenen Tätigkeiten dauerhaft ausreichend und wirksam ist. “"
                                            },
                                            {
                                                "example_id": "351aa899-b8a9-4887-b403-ee00cd7eaf76",
                                                "sense_id": "d11b7c54-0f2a-3fce-a139-d3879c2d2c93",
                                                "text": "„Wohngebäude sind im Laufe der aktuellen Entwicklung, den Energieverbrauch zu senken, immer dichter geworden, die Notwendigkeit eines ausreichenden Luftwechsels aus bautechnischen und hygienischen Gründen besteht jedoch unverändert weiter.“"
                                            },
                                            {
                                                "example_id": "54d4da8f-6091-4c13-8dd8-2d2bda08fc99",
                                                "sense_id": "d11b7c54-0f2a-3fce-a139-d3879c2d2c93",
                                                "text": "„6.2 Lüftungstechnische Anlagen in Umkleideräumen sind so auszulegen, daß sie einen vier- bis achtfachen Luftwechsel je Stunde ermöglichen.“"
                                            },
                                            {
                                                "example_id": "d8203b82-b2bd-458e-8b98-5d6e5bb432a4",
                                                "sense_id": "d11b7c54-0f2a-3fce-a139-d3879c2d2c93",
                                                "text": "„Für Sortierkabinen in Abfallbehandlungsanlagen hat sich ein zehnfacher Luftwechsel als überschlägiger Mindestwert etabliert und kann als grobes Kriterium zur Beurteilung herangezogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cec31231-5d6e-4f7f-816b-1f0cb65d6a1a",
                        "source_entry_id": "04b8fb7f-73f3-398e-9ce7-b261e51ada23",
                        "source_sense_id": "f7e4f891-e632-3680-a1f6-26f2b49d83dd",
                        "target_lang_word": "Luftdurchsatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a55e1e4b-1577-4602-ab1e-c37205762df4",
                        "source_entry_id": "04b8fb7f-73f3-398e-9ce7-b261e51ada23",
                        "source_sense_id": "f7e4f891-e632-3680-a1f6-26f2b49d83dd",
                        "target_lang_word": "Lufterneuerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lufterneuerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02b61e49-3463-3dd4-9270-1d5f78a58bca",
                                        "entry_id": "39649d7c-6a0e-34f2-92a2-4c743c6eb6cb",
                                        "glosses": [
                                            "Austausch der Luft in einem Raum oder in einem Gebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc17822-70a0-4336-801b-3bdf35417a0c",
                                                "sense_id": "02b61e49-3463-3dd4-9270-1d5f78a58bca",
                                                "text": "„Da Obrist Cathala bemerkte, daß wegen der in den Casernen eingeführten Ordnung die zufälligen Lufterneuerungen in den Zimmern bedeutend seyn müssen, so beschloß die Commission auf den Antrag mehrerer Mitglieder, daß eine Reihe von Versuchen angestellt werde, um durch die der Wissenschaft zu Gebote stehenden Mittel die Veränderung der Luft in verschiedenen Casernenzimmern bis zum Ablauf einer Nacht zu bestimmen.“"
                                            },
                                            {
                                                "example_id": "d55cc24c-4bf2-406c-b339-c39086ae9d0b",
                                                "sense_id": "02b61e49-3463-3dd4-9270-1d5f78a58bca",
                                                "text": "„Moderne Lüftungsanlagen ermöglichen die systematische, automatische Lufterneuerung und helfen gegen zu viel Feuchte und CO2 in Innenräumen.“"
                                            },
                                            {
                                                "example_id": "f54cd3e5-bb34-4af4-8c66-c9dcb10cab40",
                                                "sense_id": "02b61e49-3463-3dd4-9270-1d5f78a58bca",
                                                "text": "„Im Vergleich mit den dezentralen System kann die konventionelle zentrale Lüftungsanlage nicht nur für die hygienische Lufterneuerung eingesetzt werden.“"
                                            },
                                            {
                                                "example_id": "02eb0058-4a70-46fc-b614-47823b1cfeb6",
                                                "sense_id": "02b61e49-3463-3dd4-9270-1d5f78a58bca",
                                                "text": "„Der Gesamtaufbau der Anordnung zur Durchführung des Verfahrens zur Lufterneuerung nach Anspruch 1 besteht aus einem bzw. mehreren Behältern, die zusammen einen Vertikalaufbau des Behältersystems aufweisen.“"
                                            },
                                            {
                                                "example_id": "a6c84a48-a2f9-41b1-bf5c-609f5455e1b7",
                                                "sense_id": "02b61e49-3463-3dd4-9270-1d5f78a58bca",
                                                "text": "„Bei einer dichten Gebäudehülle ist eine systematische Lufterneuerung unverzichtbar, um anfallende Feuchte und Schadstoffe abzuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
