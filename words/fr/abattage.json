                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rendement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce centre d'appels, les employés sont soumis à un travail à l'<w>abattage</w> permanent."
