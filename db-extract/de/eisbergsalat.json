                    {
                        "translation_id": "6a241d5d-4521-45fd-a04f-6787a6c4b3d4",
                        "source_entry_id": "e50c0d85-3cf1-35f1-a6c2-f61c204b984f",
                        "source_sense_id": "4a2e8748-4a7b-380e-bedf-bacecbccb4bc",
                        "source_sense_description": "besonders knackige Form des Kopfsalates",
                        "target_lang_word": "iceberg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iceberg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3b44674-068e-37ce-a294-abcaa7139090",
                                        "entry_id": "ee63ac5b-f6c5-3612-8d1a-e0a903ef4d4c",
                                        "glosses": [
                                            "Bloc de glace d’eau douce, détaché du front des glaciers polaires ou d’une barrière flottante, dérivant sur l’océan en fondant peu à peu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "798ead3c-248c-41f5-9b37-2aea59b0e4f8",
                                                "sense_id": "d3b44674-068e-37ce-a294-abcaa7139090",
                                                "text": "M. Francisque Michel adresse une note sur un appareil destiné à signaler automatiquement la présence autour des navires de blocs de glace flottants ou icebergs… le jour, à moins d'un brouillard intense, les icebergs, frappés par les rayons du soleil, se voient à de grandes distances."
                                            },
                                            {
                                                "example_id": "8fa20bbe-9216-4d0b-a3c0-68fda2026766",
                                                "sense_id": "d3b44674-068e-37ce-a294-abcaa7139090",
                                                "text": "La surface du lac Snure était prise encore. […]. Quelques icebergs en ruine hérissaient sa surface solide, affectant des formes pittoresques du plus étrange effet."
                                            },
                                            {
                                                "example_id": "914631c3-ad64-4420-98be-5d2eb375ac6b",
                                                "sense_id": "d3b44674-068e-37ce-a294-abcaa7139090",
                                                "text": "Le navire imperturbable cingle vers l’immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "iceberg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49afc42f-8b57-3370-94c9-32f5654e6d79",
                                        "entry_id": "dfadc66d-f4c7-38dc-a06d-1097a1eaa633",
                                        "glosses": [
                                            "Variété de laitue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3fbc99d-9ffa-4ef9-81d5-b4845d0e223a",
                                                "sense_id": "49afc42f-8b57-3370-94c9-32f5654e6d79",
                                                "text": "Ainsi, il prépara un saladier contenant de l’iceberg, des carottes et de la charlotte puisqu’il avait faim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
