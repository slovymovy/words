                        "examples": [
                            {
                                "example_id": "e2f10ecd-90c4-432a-9c9f-7ee0e7a0cd31",
                                "sense_id": "2e45d2e0-492b-3386-a9bd-0560b7ae6437",
                                "text": "Naast auto's en andere dure goederen neemt justitie ook steeds meer designerkleding en tassen in beslag. Die leveren veel geld op bij veilingen. Justitiemedewerkers krijgen daarom een cursus om te leren waar ze op moeten letten."
                            },
                            {
                                "example_id": "d1e48f90-0ab7-40c4-8e5c-e41fd96ea735",
                                "sense_id": "2e45d2e0-492b-3386-a9bd-0560b7ae6437",
                                "text": "Gisterochtend zijn invallen en huiszoekingen gedaan in woningen in Rotterdam, Bleiswijk, Hank, Etten-Leur, Ridderkerk en Uithoorn. Op de verschillende adressen zijn vijf personen tussen de 25 en 50 jaar oud aangehouden. \"Ook is veel dure designerkleding gevonden, net als horloges, twee auto's en 240.000 euro. Dat is allemaal in beslag genomen\", zegt de politie."
                            },
                            {
                                "example_id": "184a7e9b-a30b-4450-b140-6653b2ef8a8c",
                                "sense_id": "2e45d2e0-492b-3386-a9bd-0560b7ae6437",
                                "text": "Vorige maand werd de Republikeinse oud-gouverneur Robert McDonnell veroordeeld tot twee jaar cel voor het aannemen van smeergeld van een zakenman. Maureen kreeg onder meer voor duizenden dollars designerkleding en een Rolex-horloge."
                            }
                        ]
                    }
