                "senses": [
                    {
                        "sense_id": "460b8b19-f8be-363e-bb37-8b19bbe9996a",
                        "entry_id": "3d7f0d8c-2333-37db-b77a-7d92fb0ca4ba",
                        "glosses": [
                            "Provoquer un choc ou une opposition entre plusieurs choses, personnes ou concepts."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2aca7c38-37b8-329c-b14b-84fc70c1e4b0",
                        "entry_id": "3d7f0d8c-2333-37db-b77a-7d92fb0ca4ba",
                        "glosses": [
                            "Se choquer l’un l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ce14e45-c4bf-48c4-960c-10ea3c5a2c6a",
                                "sense_id": "2aca7c38-37b8-329c-b14b-84fc70c1e4b0",
                                "text": "La fièvre sifflait dans ses tempes ; ses genoux s’entrechoquaient ; sa bouche était sèche et brûlante."
                            },
                            {
                                "example_id": "4cbb45fe-6904-4107-ac1d-4e96d6708665",
                                "sense_id": "2aca7c38-37b8-329c-b14b-84fc70c1e4b0",
                                "text": "En courant ils se sont entrechoqués."
                            }
                        ]
                    },
                    {
                        "sense_id": "da9fe289-3755-3db7-a74b-aa5e9dcf389e",
                        "entry_id": "3d7f0d8c-2333-37db-b77a-7d92fb0ca4ba",
                        "glosses": [
                            "Se contredire, s’opposer l’un à l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "446cd7db-847f-42ad-ab0c-ad4332ccdd1a",
                                "sense_id": "da9fe289-3755-3db7-a74b-aa5e9dcf389e",
                                "text": "Ces deux hommes s’entrechoquent sans cesse."
                            }
                        ]
                    }
