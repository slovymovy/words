        "fr-extract.jsonl": [
            {
                "entry_id": "1e55ffa8-06ac-3277-858d-c0aa157de151",
                "word": "Halloween",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f188697f-cd9b-35e5-b38b-73e503ddf2bf",
                        "entry_id": "1e55ffa8-06ac-3277-858d-c0aa157de151",
                        "glosses": [
                            "Fête, célébrée principalement en Irlande, au Canada, en Australie, en Grande-Bretagne et aux États-Unis, qui se déroule dans la nuit du 31 octobre au 1ᵉʳ novembre où traditionnellement les enfants demandent des friandises aux portes des maisons. D’autres activités incluent des bals masqués, le visionnage de films d’horreur, la visite de maisons « hantées », etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6edcae57-11dc-46fa-9afe-08e6d54b876f",
                                "sense_id": "f188697f-cd9b-35e5-b38b-73e503ddf2bf",
                                "text": "À la Toussaint on allait visiter ses morts alors qu’à Halloween ce sont les morts qui viennent nous rendre visite. C’est bien plus pratique, y a aucun effort à faire."
                            },
                            {
                                "example_id": "cf1d67cf-7a9a-4177-83e1-a6f7e0800eda",
                                "sense_id": "f188697f-cd9b-35e5-b38b-73e503ddf2bf",
                                "text": "Le premier ministre François Legault a annoncé que les enfants peuvent encore passer l'Halloween, pourvu qu'eux et leurs parents respectent les règles de distanciation sociale."
                            },
                            {
                                "example_id": "59e83e13-35b3-4664-84b2-a2ca92643564",
                                "sense_id": "f188697f-cd9b-35e5-b38b-73e503ddf2bf",
                                "text": "Les citrouilles lumineuses que l’on voit fleurir un peu partout pour la fête de Halloween sont parfois appelées des « Jack O’Lantern »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca15d295-4c24-4351-9665-88e42b56f73a",
                        "source_entry_id": "1e55ffa8-06ac-3277-858d-c0aa157de151",
                        "source_sense_id": "f188697f-cd9b-35e5-b38b-73e503ddf2bf",
                        "target_lang_word": "Halloween",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halloween",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                        "entry_id": "2c9f9de0-3fcb-3745-aa6f-aee2ed4963bc",
                                        "glosses": [
                                            "der Abend des 31. Oktobers, also der Vorabend von Allerheiligen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4163cd07-466c-4dc6-8705-23821fa65f9c",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„In den letzten Jahren hat sich Halloween in Deutschland zu einer festen Tradition entwickelt.“"
                                            },
                                            {
                                                "example_id": "b60fdf26-2448-411b-8bc3-5255501bb634",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„Auf jeden Fall hat die Popularisierung von Halloween auch den Kürbis wieder ganz nach vorne gebracht.“"
                                            },
                                            {
                                                "example_id": "e757ce99-bcb8-4ff3-852d-bbb8ffcfe08d",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„Allen voran ist heute - als vermeintlich keltisches Erbe - Halloween sowohl in den USA als auch in Europa populär geworden.“"
                                            },
                                            {
                                                "example_id": "92eac4f5-3de1-4d09-a806-710712a299f4",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„Jeder ist in diesen Tagen mit Halloween beschäftigt, dem großen amerikanischen Geisterfest, dem rituellen Übergang zu Dunkelheit, Kälte und Tod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3b6c256-dd4e-4b9a-bd52-152be2f90b36",
                        "source_entry_id": "1e55ffa8-06ac-3277-858d-c0aa157de151",
