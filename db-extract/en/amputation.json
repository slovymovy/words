                    {
                        "translation_id": "a48f2343-7093-4f8d-a003-5227ae46ad22",
                        "source_entry_id": "4987a065-cf3b-36c9-aad2-5b14d8347302",
                        "source_sense_description": "surgical removal of a limb",
                        "target_lang_word": "amputation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amputation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "640c1958-019b-3f51-a219-8297d53a4ba9",
                                        "entry_id": "0590d5a3-cba9-398c-a11d-c81677bfe41e",
                                        "glosses": [
                                            "Action d’amputer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a892474b-6b00-4ea2-96a7-431d8af60331",
                                                "sense_id": "640c1958-019b-3f51-a219-8297d53a4ba9",
                                                "text": "Le crapaud a la vie très dure. Il survit plusieurs heures à la décapitation, plusieurs jours à l'avulsion du cœur, quarante jours à l'ablation des poumons, plusieurs semaines à l’amputation du museau en arrière des yeux."
                                            },
                                            {
                                                "example_id": "0750deef-3a68-4cd5-8531-9e183ea003a3",
                                                "sense_id": "640c1958-019b-3f51-a219-8297d53a4ba9",
                                                "text": "Les contrevenants aux lois du servage et les criminels encouraient de sévères punitions : de 100 à 1000 coups de fouet, selon l’offense ; amputation de main, de jambe ou des yeux pour les crimes les plus graves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b285558-ee36-49b9-a587-cb4b26bc2503",
                        "source_entry_id": "4987a065-cf3b-36c9-aad2-5b14d8347302",
                        "source_sense_description": "surgical removal of a limb",
                        "target_lang_word": "Amputation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amputation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                        "entry_id": "7531cecc-6797-3439-96a7-d254677f1530",
                                        "glosses": [
                                            "die operative Abtrennung von Körperteilen aufgrund von Verletzungen oder anderer medizinischer Indikationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f06075-9f3a-47c3-b08c-2e60df0a84ee",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "Eine Amputation ist oft das letzte Mittel, um dem Patienten das Leben zu retten."
                                            },
                                            {
                                                "example_id": "b049c37b-7813-4e19-b6fb-deed32a578bd",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "Die psychologische Betreuung ist vor und nach einer Amputation für den Patienten sehr wichtig."
                                            },
                                            {
                                                "example_id": "f92b8872-1455-4358-876f-09030c8be1e7",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "„Auch wenn sie noch etwas humpelt, sie ist froh, die Amputation abgewendet zu haben.“"
                                            },
                                            {
                                                "example_id": "8df3b505-fcbd-40c7-b2ea-0e931589a5b2",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "„Also müssen sie eine Amputation vornehmen.“"
                                            },
                                            {
                                                "example_id": "ed16dc0d-1591-488b-8e6b-f21ad7280291",
                                                "sense_id": "2eb575d3-546c-3d82-bcff-aaed612bbd18",
                                                "text": "„So hat, laut Cora, eine medizinisch einwandfrei indizierte und chirurgisch präzise durchgeführte Amputation auszusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
