                                                "example_id": "85aa7963-4f4c-4caa-9f96-0c793461aca7",
                                                "sense_id": "f9f405f2-9641-3df9-bbd2-77eb3eabd078",
                                                "text": "optimal intervals between feedings for neonates with weak esophagogastric sphincter"
                                            },
                                            {
                                                "example_id": "d15b0386-b658-407f-aa03-73442bc74bb2",
                                                "sense_id": "f9f405f2-9641-3df9-bbd2-77eb3eabd078",
                                                "text": "[…] they are nevertheless always like the lion's keeper, who, when by long patience, a thousand feedings, and a thousand clawings, he hath made a fierce lion familiar, yet never gives him meat, but with pulling back his hand, always in fear […]"
                                            }
                                        ]
                                    },
                                    {
