                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c30919b8-7138-4419-b960-81057daa3c3e",
                                "sense_id": "94c75eb3-fce0-3794-abd2-77985f8fe726",
                                "text": "Blue at some distances unblues, […]"
                            },
                            {
                                "example_id": "0c62b054-5f1c-4f70-88fb-d6ee1d9f89db",
                                "sense_id": "94c75eb3-fce0-3794-abd2-77985f8fe726",
                                "text": "The boy was very hurt in the throat and his face was only now unbluing."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aacd209-e7cf-3ff8-ae37-528476f82e5b",
                        "entry_id": "423606c3-eb6e-3921-9a42-e588657145fc",
                        "glosses": [
                            "To cause (something) to cease being blue; to make (something) not blue."
                        ],
                        "tags": [
                            "poetic",
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f020102b-6167-43fd-91df-56c44e13d482",
                                "sense_id": "3aacd209-e7cf-3ff8-ae37-528476f82e5b",
                                "text": "[…] to clothe bodies surprised by bullets, to unblue hands frozen in ditches, […]"
                            },
                            {
                                "example_id": "6b86f386-d5a9-405c-9c0a-ce5055622d3e",
                                "sense_id": "3aacd209-e7cf-3ff8-ae37-528476f82e5b",
                                "text": "They look like iced teeth where a storm unblues them."
                            }
                        ]
                    }
