                    },
                    {
                        "sense_id": "75030987-dcfc-39fd-8a34-08611b85086d",
                        "entry_id": "50fc415e-c5c7-3004-aba6-c26d6640b09e",
                        "glosses": [
                            "minerał o doskonałej łupliwości"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c65ec0cc-3bf4-4823-99ab-62d4a5a8491f",
                        "source_entry_id": "50fc415e-c5c7-3004-aba6-c26d6640b09e",
                        "source_sense_id": "57ed5b0c-1b17-3af4-9330-aa375b603383",
                        "target_lang_word": "Spat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a1070e6-3f20-3290-835f-3a78f06ffed0",
                                        "entry_id": "fe1f4603-422e-39c3-97f3-2460fa17b245",
                                        "glosses": [
                                            "ein Mineral aus einer historisch begründeten Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3659e3b-ba1e-4301-b6b9-68babdf3c8af",
                                                "sense_id": "1a1070e6-3f20-3290-835f-3a78f06ffed0",
                                                "text": "„Auch auf der 13 m Sohle am Nassen Schacht wurde wieder Spat abgebaut.“"
                                            },
                                            {
                                                "example_id": "d07d2503-0e8e-426c-ba9f-c3b5bfd13fb6",
                                                "sense_id": "1a1070e6-3f20-3290-835f-3a78f06ffed0",
                                                "text": "„Der gewonnene Spat (rund 5000 t) erwies sich jedoch als zu stark mit Eisen- und Manganhydroxiden verunreinigt, so dass er für die von dieser Firma erzeugten Barytprodukte ([…]) nicht weiter in Betracht gezogen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2854eb76-2112-37d3-84d9-18d0ecfe9d68",
                                        "entry_id": "fe1f4603-422e-39c3-97f3-2460fa17b245",
                                        "glosses": [
                                            "geometrischer Körper mit 6 Parallelogrammen als Seitenflächen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5050ac85-b942-445b-b72b-5a3713241ddf",
                                                "sense_id": "2854eb76-2112-37d3-84d9-18d0ecfe9d68",
                                                "text": "„Für diesen Körper sind mehrere Namen in Umlauf, zum Beispiel Spat, Vielflach oder Parallelepiped. Weil es das kürzeste ist, nenne ich ihn Spat.“"
                                            },
                                            {
                                                "example_id": "3f38e634-75d0-4f40-b581-481aa4c0fb79",
                                                "sense_id": "2854eb76-2112-37d3-84d9-18d0ecfe9d68",
                                                "text": "„Da dieses Vektorprodukt das Volumen eines Parallelepipeds (Spat) angibt, heißt es manchmal auch Spatprodukt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Spat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e27abce-9e3f-3686-946e-ccc16deeecc8",
                                        "entry_id": "45d07505-29c9-3fcd-90e9-99f661a2a3d4",
                                        "glosses": [
                                            "eine Pferdekrankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f54d721-f213-457b-b806-eb36f7bab24a",
                                                "sense_id": "7e27abce-9e3f-3686-946e-ccc16deeecc8",
                                                "text": "„Ein wackeliges Sprunggelenk ist eine energetische Disharmonie, die häufig in Spat endet.“"
                                            },
                                            {
                                                "example_id": "b8a2f4bd-e7da-4c9d-b143-90755a30dcb9",
                                                "sense_id": "7e27abce-9e3f-3686-946e-ccc16deeecc8",
                                                "text": "„Spat ist eine schmerzhafte deformierende Knochenhaut- und Knochenentzündung an der Innenseite des Sprunggelenks bei Pferden, die allmählich zur Versteifung der kleinen Gelenke im Tarsus führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7edaa154-701e-44f8-9878-8e52e49846fe",
                        "source_entry_id": "50fc415e-c5c7-3004-aba6-c26d6640b09e",
                        "source_sense_id": "57ed5b0c-1b17-3af4-9330-aa375b603383",
                        "target_lang_word": "шпат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шпат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bbf3c24d-841f-3f1f-8dff-c2775fce5a1a",
                                        "entry_id": "92548d5f-433c-3175-b86e-d8b3b1490684",
                                        "glosses": [
                                            "минер. название различных минералов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d932d32d-f3eb-4e20-9308-7e549e91e7e1",
                                                "sense_id": "bbf3c24d-841f-3f1f-8dff-c2775fce5a1a",
                                                "text": "Монголы считают, что малиновый шпат в качестве амулета притягивает к своему владельцу любовь, успокаивает эмоции и заряжает позитивной энергией."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "шпат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd875da-0d50-36f6-b81a-d55568a125fe",
                                        "entry_id": "e9653cd3-f8f0-35d0-9f9d-1f1338add92f",
                                        "glosses": [
                                            "вет. болезнь лошадей; остеоартроз скакательных суставов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d01628-5958-462a-90a0-80620b007b4c",
                                                "sense_id": "9bd875da-0d50-36f6-b81a-d55568a125fe",
                                                "text": "Купит он лошадь со шпатом — сменяет на лошадь с колером, да ещё приплатит."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
