                "senses": [
                    {
                        "sense_id": "07cc0874-1515-3ec9-86a5-699b79f6c195",
                        "entry_id": "008d637e-7951-37a6-8df0-1be2ac1fcd29",
                        "glosses": [
                            "unregelmäßige bläuliche Muttermale meist am Rücken, Gesäß oder Kreuzbein eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c79a8d-86d9-475c-9b31-629e4110528e",
                                "sense_id": "07cc0874-1515-3ec9-86a5-699b79f6c195",
                                "text": "„Besonders in Frankreich soll es Regionen geben, wie in der Champagne, wo Ärztinnen und Ärzte überdurchschnittlich oft auf den »Mongolen-« oder eben »Hunnenfleck« treffen.“"
                            },
                            {
                                "example_id": "3b867cb7-e910-489f-b8ac-9e4a6b08d0c1",
                                "sense_id": "07cc0874-1515-3ec9-86a5-699b79f6c195",
                                "text": "„Dann macht der Autor sich auf die Suche im Internet nach einem dunklen Fleck kurz über dem Po, von Kinderärz*innen [sic] als ‚Mongolischer Fleck‘ oder ‚Hunnenfleck‘ benannt, und wird fündig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
