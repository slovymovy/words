                    {
                        "sense_id": "84bf6f3f-7afe-3cb0-81b4-13801d4f1907",
                        "entry_id": "f307e24e-43a4-3987-9de1-9dd745b62ba8",
                        "glosses": [
                            "Not tinted; having a plain or default colour."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d6256555-62a4-4585-ae9a-46a7a32863e1",
                                "sense_id": "84bf6f3f-7afe-3cb0-81b4-13801d4f1907",
                                "text": "The hideous exposure is not untinted with fairer lines; and we see traits here and there of true devotion, mistaken but heroic."
                            },
                            {
                                "example_id": "124345ac-bfa9-4552-a823-565d09fde7a4",
                                "sense_id": "84bf6f3f-7afe-3cb0-81b4-13801d4f1907",
                                "text": "A large map of Virginia and a series of hunting prints hung on the untinted walls, and there were racks for guns, and a work-bench at one end of the room, where guns might be taken apart and cleaned."
                            },
                            {
                                "example_id": "bff786fd-a528-44e3-8109-8543d1508fb9",
                                "sense_id": "84bf6f3f-7afe-3cb0-81b4-13801d4f1907",
                                "text": "Why can't you look at life through a plain sheet of glass--if you must look at it through something--instead of choosing the red and the yellow and the purples--anything but the plain, the untinted reality."
                            }
                        ]
                    }
                ],
