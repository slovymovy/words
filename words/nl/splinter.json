            "senses": [
                {
                    "sense_id": "c6e35dbe-fa4e-31ae-bea6-acc169910494",
                    "sense_definition": "een kleine, langwerpige scherf met een scherpe punt van een hard materiaal zoals hout of glas",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een houten <w>splinter</w> in mijn vinger gekregen tijdens het klussen.",
                            "target_lang_translations": {
                                "en": "I got a wooden <w>splinter</w> in my finger while doing DIY work."
                            }
                        },
                        {
                            "text": "Pas op voor de glazen <w>splinter</w> op de vloer na het breken van het glas.",
                            "target_lang_translations": {
                                "en": "Watch out for the glass <w>splinter</w> on the floor after the glass broke."
                            }
                        }
                    ],
                    "synonyms": [
                        "scherf",
                        "spaander"
                    ],
                    "common_phrases": [
                        "houten splinter",
                        "glazen splinter"
                    ],
                    "target_lang_definitions": {
                        "en": "a small, thin, sharp piece of wood, glass, or other hard material that has broken off from a larger piece"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splinter",
                                "target_lang_sense_clarification": "a sharp fragment of wood or glass"
                            },
                            {
