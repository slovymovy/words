                    {
                        "form_id": "564b277a-cc6a-4f5d-9736-3569c49dfa6c",
                        "entry_id": "cc2b3cc3-fcfe-3597-beb0-48331775bf06",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ка́рах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f8a63f9-819d-30c4-803f-17148c043f85",
                        "entry_id": "cc2b3cc3-fcfe-3597-beb0-48331775bf06",
                        "glosses": [
                            "высок. суровое наказание, возмездие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5af5099-514a-450f-81fe-26b27a4fde60",
                                "sense_id": "9f8a63f9-819d-30c4-803f-17148c043f85",
                                "text": "Чиновник стал узнавать стороной, и ему сказали, что мещане — мошенники страшные, торгуют гнилью, обвешивают, обмеривают даже казну, все безнравственны, так что побои эти — праведная кара…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e56f8b7d-c0b8-4b7c-959f-c43f19a1c77f",
                        "source_entry_id": "cc2b3cc3-fcfe-3597-beb0-48331775bf06",
                        "source_sense_id": "9f8a63f9-819d-30c4-803f-17148c043f85",
                        "target_lang_word": "Strafe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strafe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7539442c-c869-3c74-8207-1e114a76163e",
                                        "entry_id": "bd34d6d7-d0dd-31ee-bb22-ef9ec5745f8d",
                                        "glosses": [
                                            "Sanktion, wegen Fehlverhalten erhaltene Reaktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d62cb7-409e-4f42-8370-f0ad6bd6a6e1",
                                                "sense_id": "7539442c-c869-3c74-8207-1e114a76163e",
                                                "text": "Er muss als Strafe ins Gefängnis."
                                            },
                                            {
                                                "example_id": "c734c015-bdd0-4c6f-8a8e-8c11b82bbf7b",
                                                "sense_id": "7539442c-c869-3c74-8207-1e114a76163e",
                                                "text": "„Später hören wir, dass er zu drei Jahren Gefängnis verurteilt worden ist und die Strafe wortlos angenommen hat.“"
                                            },
                                            {
                                                "example_id": "9cbdbeea-6060-4185-a71e-daa839754353",
                                                "sense_id": "7539442c-c869-3c74-8207-1e114a76163e",
                                                "text": "„Viele waren vor Strafen oder Verfolgung in ihren Heimatländern geflohen, von Mördern und Kriegsverbrechern über Pleitiers bis zu Kriegsdienstverweigerern und politischen Aktivisten.“"
                                            },
                                            {
                                                "example_id": "0d127036-476d-467f-8dcb-7d348b8b39fc",
                                                "sense_id": "7539442c-c869-3c74-8207-1e114a76163e",
                                                "text": "„Weder ist die Strafe nur pädagogisches Mittel, noch kann sie gemäßigt werden durch politische Rücksichten.“"
                                            },
                                            {
                                                "example_id": "c85d06d1-e146-419d-be6e-3d2e6dba9935",
                                                "sense_id": "7539442c-c869-3c74-8207-1e114a76163e",
                                                "text": "„Auch das lehre Selbstkontrolle, meinte sie schulterzuckend, und dass für Milena der Kurs dann wohl Strafe genug gewesen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7132bc83-c8ac-3e9b-984f-28ba9f7943a4",
                                        "entry_id": "bd34d6d7-d0dd-31ee-bb22-ef9ec5745f8d",
                                        "glosses": [
                                            "Geldstrafe"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ab258e-cca5-44fd-9e68-8b16b1ec422a",
                                                "sense_id": "7132bc83-c8ac-3e9b-984f-28ba9f7943a4",
                                                "text": "Wenn du erwischt wirst, musst du sicher eine hohe Strafe zahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "917e9c93-e5ca-4943-ae38-ef3ec8a8662b",
                        "source_entry_id": "cc2b3cc3-fcfe-3597-beb0-48331775bf06",
                        "source_sense_id": "9f8a63f9-819d-30c4-803f-17148c043f85",
                        "target_lang_word": "Sühne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sühne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0cc1469-6fe3-3503-a98e-1eb8b9d7ea2c",
                                        "entry_id": "1f8d8e52-e843-365e-9092-25f66d6fe27f",
                                        "glosses": [
                                            "eine Wiedergutmachung, eine Genugtuung, eine Leistung für ein begangenes Unrecht oder ein Verschulden"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99b99e24-acd8-47f9-aeec-89906986dd51",
                                                "sense_id": "f0cc1469-6fe3-3503-a98e-1eb8b9d7ea2c",
                                                "text": "Als Sühne muss er 40 Stunden Sozialarbeit leisten."
                                            },
                                            {
                                                "example_id": "55206766-58a0-4767-bd56-7adde1ad3602",
                                                "sense_id": "f0cc1469-6fe3-3503-a98e-1eb8b9d7ea2c",
                                                "text": "„Die Bundesrepublik, so schien es mir, war als Demokratie unerschütterbar, das aufrichtige Bemühen um Veränderung und Sühne, Ausgleich, Völkerverständigung und Freiheit ihr nicht abzusprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
