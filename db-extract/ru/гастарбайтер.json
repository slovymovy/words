                    },
                    {
                        "translation_id": "e49f5324-6fe7-4063-8054-cbefd6060bc9",
                        "source_entry_id": "398b972a-506b-3172-aa85-190354e62bcd",
                        "source_sense_id": "49d3e3fa-9694-33f7-a75f-3bf9c3734620",
                        "target_lang_word": "foreign worker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "57a799a5-e6da-42ff-9dc4-68f0927d4258",
                        "source_entry_id": "398b972a-506b-3172-aa85-190354e62bcd",
                        "source_sense_id": "49d3e3fa-9694-33f7-a75f-3bf9c3734620",
                        "target_lang_word": "alien employee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb2bce1b-96c9-465e-92a3-b51f87260f4f",
                        "source_entry_id": "398b972a-506b-3172-aa85-190354e62bcd",
                        "source_sense_id": "49d3e3fa-9694-33f7-a75f-3bf9c3734620",
                        "target_lang_word": "Gastarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                        "entry_id": "8eea73dd-4bb3-393e-b5fb-b4f5588be12c",
                                        "glosses": [
                                            "Person, die legal (für eine begrenzte Zeit) in einem für ihn fremden Land arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b2a2cf4-d5f3-4d5f-9797-569e71fa8f1c",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "Nach dem Ende der DDR mussten die Gastarbeiter aus Vietnam und Mosambik in ihre Heimatländer zurückkehren."
                                            },
                                            {
                                                "example_id": "4a85f8ab-bdfd-4b7e-8ce2-1be97a289f36",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Die Gastarbeiter der 1960er Jahre kamen alle freiwillig ins Land.“"
                                            },
                                            {
                                                "example_id": "e75ee8b0-2ea4-4644-8bae-c82b60500931",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Noch der letzte Gstarbeiter aus Apulien oder Kastilien konnte Pass und Arbeitserlaubnis vorweisen.“"
                                            },
                                            {
                                                "example_id": "475a095b-4a08-41f1-8769-352ba7451af9",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„In den ewig hellen Sommermonaten müssen mittlerweile Gastarbeiter aus der ganzen Welt aushelfen, um die Touristenströme zu bewältigen.“"
                                            },
                                            {
                                                "example_id": "03ac4373-4231-4e48-b7fd-403298da71de",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Die Deutschen in den Sechzigerjahren des 20. Jahrhunderts hätten sie als Gastarbeiter bezeichnet.“"
                                            },
                                            {
                                                "example_id": "62e84297-a270-422e-a810-aef31e191ec0",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„In den Fünfzigerjahren des vergangenen Jahrhunderts begann die Bundesrepublik Deutschland, im großen Stil sogenannte Gastarbeiter anzuwerben.“"
                                            },
                                            {
                                                "example_id": "fa5dc07d-0a45-472f-a076-5df1740cc8f5",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Seine Großeltern kamen als Gastarbeiter in den 1970ern nach Kreuzberg und Deutschland wurde zu ihrer neuen Heimat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
