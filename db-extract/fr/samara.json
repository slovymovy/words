                                    {
                                        "sense_id": "8c15cac3-ce4f-32ec-a650-77d71c89f0db",
                                        "entry_id": "c17f4ae7-d648-3bbd-95fa-08d73040a345",
                                        "glosses": [
                                            "eine Stadt im Süden des europäischen Teils Russlands, die Hauptstadt der Oblast Samara"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f927e1-ffa1-4fd2-a422-9d899a770ea7",
                                                "sense_id": "8c15cac3-ce4f-32ec-a650-77d71c89f0db",
                                                "text": "Samara liegt am hochgelegenen linken Wolgaufer der „Samarer Krümmung“ zwischen den Mündungen der Flüsse Samara und Sok."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Samara",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7c6c30-bd6c-3246-a669-80820c6a3a23",
                                        "entry_id": "a20a4db8-e7a3-3ea2-a84d-2f0f7936c25d",
                                        "glosses": [
                                            "ein linker Nebenfluss der Wolga"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5486f92b-4fe7-4a47-927b-e81f34ad45ba",
                                                "sense_id": "4d7c6c30-bd6c-3246-a669-80820c6a3a23",
                                                "text": "Die Samara entspringt südwestlich des Uralgebirges nordwestlich von Orenburg in der gleichnamigen Oblast, im Höhenzug Obschtschi Syrt, der hier die Wasserscheide zum Ural bildet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
