            "senses": [
                {
                    "sense_id": "a74175aa-53a7-3826-aa72-87cdb5338f43",
                    "sense_definition": "No; a negative response.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "“Are you coming with us?” “<w>Na</w>, I think I'll stay here.”",
                            "target_lang_translations": {
                                "ru": "«Ты идешь с нами?» — «<w>Не-а</w>, я, пожалуй, останусь здесь».",
                                "zh": "“你要和我们一起去吗？”“<w>不</w>，我想我还是留在这里吧。”"
                            }
                        },
                        {
                            "text": "<w>Na</w>, that's not what I meant at all.",
                            "target_lang_translations": {
                                "ru": "<w>Не</w>, я совсем не это имел в виду.",
                                "zh": "<w>不</w>，我根本不是那个意思。"
                            }
                        }
                    ],
                    "synonyms": [
                        "no",
                        "nope",
                        "nah"
                    ],
                    "antonyms": [
                        "yes",
                        "yeah",
                        "aye"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Scottish, Northern English, or slang"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорный или диалектный вариант слова \"нет\", выражающий отрицание.",
                        "zh": "“不”；表示否定的口语或方言回答。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не-а",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "нет",
                                "target_lang_sense_clarification": "отрицание"
                            },
                            {
                                "target_lang_word": "не",
                                "target_lang_sense_clarification": "просторечное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不",
                                "target_lang_sense_clarification": "否定"
                            },
                            {
                                "target_lang_word": "没",
                                "target_lang_sense_clarification": "口语否定"
                            }
                        ]
