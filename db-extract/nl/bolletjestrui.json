                                        "sense_id": "96fe6f9e-2b7d-3b19-a2bf-f7e758642ec3",
                                        "entry_id": "df567bf5-e7aa-319a-b37a-db50dfc9cc94",
                                        "glosses": [
                                            "Maillot distinctif porté par le coureur ou la coureuse en tête du Grand Prix de la montagne dans plusieurs courses cyclistes par étapes, dont le Tour de France."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21384eac-102d-48d0-afb2-7cf44c762425",
                                                "sense_id": "96fe6f9e-2b7d-3b19-a2bf-f7e758642ec3",
                                                "text": "Le maillot à pois fête cette année ses cinquante ans d'existence. Trophée prisé des baroudeurs, parfois accaparé par le vainqueur final, il récompense le meilleur grimpeur du Tour de France depuis 1975."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee1eb85-96db-3123-9d91-677d27d5825c",
                                        "entry_id": "df567bf5-e7aa-319a-b37a-db50dfc9cc94",
                                        "glosses": [
                                            "Cycliste qui porte ce maillot."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f83c71-0c6c-4523-9811-6318f8eb8182",
                                                "sense_id": "9ee1eb85-96db-3123-9d91-677d27d5825c",
                                                "text": "\"Voyager t’enseigne la vie, la gentillesse, l’amour et la compréhension des autres, et j’en suis tellement reconnaissante\" a conclu la maillot à pois du Tour de France 2023, qu’on imagine comme totalement régénérée par cette compétition mondiale où elle s’était classée à la 3e place en 2021 en Belgique."
                                            }
                                        ]
                                    }
                                ]
