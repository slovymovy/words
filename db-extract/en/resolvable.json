                        ],
                        "form": "more resolvable"
                    },
                    {
                        "form_id": "75b99bdb-2bc7-4677-813b-40525f759131",
                        "entry_id": "813457ec-6466-3c59-95ba-0f8f09607857",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most resolvable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b9c2bf8-a301-320e-9a7c-dea6d2a4ce0b",
                        "entry_id": "813457ec-6466-3c59-95ba-0f8f09607857",
                        "glosses": [
                            "Able to be resolved; to which a solution may be found."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebe724cf-362d-4155-9f6c-d4f386e85440",
                                "sense_id": "3b9c2bf8-a301-320e-9a7c-dea6d2a4ce0b",
                                "text": "The conflict is rationally resolvable either by correcting the mistaken belief or by bringing the wayward desire under rational control."
                            },
                            {
                                "example_id": "84145332-54bb-4601-abe7-2b9fdc584d35",
                                "sense_id": "3b9c2bf8-a301-320e-9a7c-dea6d2a4ce0b",
                                "text": "[…] it was clear that most of the delays were not by external factors such as bad weather or major track issues, but rather by poor management, staff shortages and timetable conflicts. In other words, these problems are resolvable."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa6857df-9883-3bff-a190-9ef87a7e8754",
                        "entry_id": "813457ec-6466-3c59-95ba-0f8f09607857",
                        "glosses": [
                            "That may be resolved or reduced to its component elements."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a31981e8-833b-4f69-8158-ad0289dc6f51",
                        "source_entry_id": "813457ec-6466-3c59-95ba-0f8f09607857",
                        "source_sense_description": "able to be resolved",
                        "target_lang_word": "résoluble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résoluble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd50592-6e14-3f0f-9761-aac804c524ec",
                                        "entry_id": "fd251284-1d89-3026-9e14-d223f860add4",
                                        "glosses": [
                                            "Qui peut être résolu."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d6936c0-3da4-4a84-8be2-76802686ca20",
                                                "sense_id": "9bd50592-6e14-3f0f-9761-aac804c524ec",
                                                "text": "Ceux qui n'ont sur l'immeuble qu'un droit suspendu par une condition, ou résoluble dans certains cas, ou sujet à rescision, ne peuvent consentir qu'une hypothèque soumise aux mêmes conditions ou à la même rescision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3aac8fa-c490-3034-bf10-8102727bdcf3",
                                        "entry_id": "fd251284-1d89-3026-9e14-d223f860add4",
                                        "glosses": [
                                            "Qualifie les questions et les problèmes dont on peut trouver la solution."
                                        ],
                                        "tags": [
                                            "Principalement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5de97e2-d48a-46e7-a761-efc3398d931e",
                                                "sense_id": "f3aac8fa-c490-3034-bf10-8102727bdcf3",
                                                "text": "Si l'on en croit Sinân Ibn al-Fath, plusieurs mathématiciens avant lui avaient été amenés à considérer des monômes de degré supérieur à 2 et à les nommer, mais il dit être le premier à en avoir rédigé un exposé systématique et à s'en être servi pour étendre le domaine des équations résolubles par radicaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a5b45c-08be-367d-b07c-6baee83ff626",
                                        "entry_id": "fd251284-1d89-3026-9e14-d223f860add4",
                                        "glosses": [
                                            "Dont les parties sont visibles à l’aide d’outil optique."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9db12d7b-5342-4136-be29-8d68a19ad380",
                                                "sense_id": "16a5b45c-08be-367d-b07c-6baee83ff626",
                                                "text": "La clarté restant la même, la nébuleuse, qui était d’abord annulaire et irrésoluble, devient plus tard unie et résoluble."
                                            },
                                            {
                                                "example_id": "3518c0b7-2b4e-4460-af11-66b8625fbdcc",
                                                "sense_id": "16a5b45c-08be-367d-b07c-6baee83ff626",
                                                "text": "Herschel n’oublie cependant pas qu’il a distingué, à côté de la nébulosité « résoluble » et de la nébulosité « laiteuse », une troisième sorte « colorée mais irrésoluble »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1304546b-15eb-3e59-a50d-4551e50d8870",
                                        "entry_id": "fd251284-1d89-3026-9e14-d223f860add4",
                                        "glosses": [
                                            "Susceptible d’être annulé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951790e9-f156-491f-b956-2e5ec4820e55",
                                                "sense_id": "1304546b-15eb-3e59-a50d-4551e50d8870",
                                                "text": "Ce contrat n’est pas résoluble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
