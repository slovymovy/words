                        ],
                        "form": "преподава́я"
                    },
                    {
                        "form_id": "7d57b01e-b2c9-41bc-8f87-524d84f70d67",
                        "entry_id": "6dc5d1f1-ff15-380b-aa56-b8866d16693c",
                        "tags": [
                            "adverbial",
