                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba177537-356c-3605-90eb-44e1aa9fcda4",
                                        "entry_id": "a06fc6c9-4d5c-30a3-b667-8bfedd016bbb",
                                        "glosses": [
                                            "Remarkably bad; of poor quality."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8968c46-01d5-4bcb-9a1f-ce3864e6eb33",
                                                "sense_id": "ba177537-356c-3605-90eb-44e1aa9fcda4",
                                                "text": "No offense, but his cooking is lousy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dec749c-c4fe-30ed-b930-f9864f9734be",
                                        "entry_id": "a06fc6c9-4d5c-30a3-b667-8bfedd016bbb",
                                        "glosses": [
                                            "Dirty or untidy."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b63eccea-7936-4c79-8cef-64dd14d676b5",
                                                "sense_id": "5dec749c-c4fe-30ed-b930-f9864f9734be",
                                                "text": "I cleaned the lousy garage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fc6d577-9303-35bd-8322-e9f12a436a4b",
                                        "entry_id": "a06fc6c9-4d5c-30a3-b667-8bfedd016bbb",
                                        "glosses": [
                                            "Unwell; under the weather."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a400cfe9-edde-4800-90be-6315c49c2d55",
                                                "sense_id": "2fc6d577-9303-35bd-8322-e9f12a436a4b",
                                                "text": "I caught a cold and I've been feeling lousy all week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d25fdb-e9f9-396c-bfdc-e827db972e83",
                                        "entry_id": "a06fc6c9-4d5c-30a3-b667-8bfedd016bbb",
                                        "glosses": [
                                            "Underhanded; mean; contemptible."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18aa3c08-c2fb-4c73-bc38-2da7a97f3949",
                                                "sense_id": "38d25fdb-e9f9-396c-bfdc-e827db972e83",
                                                "text": "I've had enough of lousy backstabbing at this place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46639430-839d-3765-b3a8-b49936263a31",
                                        "entry_id": "a06fc6c9-4d5c-30a3-b667-8bfedd016bbb",
                                        "glosses": [
                                            "Infested with lice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "542866dc-e7cd-342f-9b7c-98ef889e65f3",
                                        "entry_id": "a06fc6c9-4d5c-30a3-b667-8bfedd016bbb",
                                        "glosses": [
                                            "Filled or packed (with something, usually bad)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5eaf881-536e-4e50-adf6-f5b636fce794",
                                                "sense_id": "542866dc-e7cd-342f-9b7c-98ef889e65f3",
                                                "text": "The place was lousy with students."
                                            },
                                            {
                                                "example_id": "dfd43ad9-6faf-4cd3-9df1-92d77234449f",
                                                "sense_id": "542866dc-e7cd-342f-9b7c-98ef889e65f3",
                                                "text": "The benignant influence crept like gas through the Row. […] And triangulation might possibly have located it in the Palace Flophouse and Grill. Certainly the Palace was lousy with it. Mack and the boys were charged. Jones was seen to leap from his chair only to do a quick tap dance and sit down again."
                                            },
                                            {
                                                "example_id": "0469dbed-3b99-4ccb-baf3-fa0dccdc6d9d",
                                                "sense_id": "542866dc-e7cd-342f-9b7c-98ef889e65f3",
                                                "text": "[I talked to] Annabeth about the Greek gods who hung out in New York and made her life difficult. Apparently North America was lousy with ancient gods. We had a full-blown infestation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
