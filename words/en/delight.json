                                "target_lang_word": "Entzückung",
                                "target_lang_sense_clarification": "sehr erfreute, begeisterte Stimmung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eeffd78-bef1-3908-9661-ea89b256da53",
                    "sense_definition": "Something or someone that causes great pleasure or happiness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beautiful garden is a <w>delight</w> to visit in the spring.",
                            "target_lang_translations": {
                                "ru": "Посещение этого прекрасного сада весной — одно <w>удовольствие</w>.",
                                "nl": "De prachtige tuin is in de lente een <w>genot</w> om te bezoeken.",
                                "pl": "Odwiedzanie tego pięknego ogrodu wiosną to czysta <w>przyjemność</w>.",
                                "de": "Der wunderschöne Garten ist im Frühling eine wahre <w>Freude</w> zu besuchen."
                            }
                        },
                        {
                            "text": "Her singing voice is a pure <w>delight</w> to listen to.",
                            "target_lang_translations": {
                                "ru": "Слушать её пение — чистое <w>наслаждение</w>.",
                                "nl": "Haar zangstem is een puur <w>genot</w> om naar te luisteren.",
                                "pl": "Słuchanie jej śpiewu to czysta <w>rozkosz</w>.",
                                "de": "Ihrer Singstimme zuzuhören ist ein reiner <w>Genuss</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "joy",
                        "pleasure"
                    ],
                    "common_phrases": [
                        "a pure delight",
                        "culinary delights",
                        "absolute delight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то или кто-то, доставляющий огромное удовольствие или радость.",
                        "nl": "Iets of iemand die groot plezier of geluk veroorzaakt.",
                        "pl": "Coś lub ktoś, co sprawia wielką przyjemność lub radość.",
                        "de": "Etwas oder jemand, das bzw. der große Freude oder Glück bereitet."
                    },
                    "translations": {
                        "ru": [
                            {
