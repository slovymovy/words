                    }
                ],
                "translations": [
                    {
                        "translation_id": "37bfc7da-4810-4f97-b414-1f9cd31751e9",
                        "source_entry_id": "a9207368-2782-3883-94b5-21ccff42d3b7",
                        "source_sense_id": "775d08d1-72c9-3d99-ad0d-a8a276671d20",
