                "senses": [
                    {
                        "sense_id": "eb3a81cf-5660-3ef9-aaa3-97dad21a9679",
                        "entry_id": "19a2d5c6-900b-3078-b6ee-8adcbd651a08",
                        "glosses": [
                            "niet helemaal gaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce97a3a-1fe3-4d56-a93f-df4a678742e8",
                                "sense_id": "eb3a81cf-5660-3ef9-aaa3-97dad21a9679",
                                "text": "„Wat het ook is, dit ding is groot’’, aldus een verbijsterde Barbie (Mike Vogel), een begeerlijke antiheld met zijn spieren op de juiste plaats. Voor een van de koeien loopt het niet goed af: die splijt van kop tot staart in tweeën als de rand van de dome precies op hem landt. Zijn binnenkant lijkt op een halfgaar tartaartje."
                            }
                        ]
                    },
                    {
                        "sense_id": "afcba976-4b69-3d5e-a0d5-4b622566e4f6",
                        "entry_id": "19a2d5c6-900b-3078-b6ee-8adcbd651a08",
                        "glosses": [
                            "niet goed doordacht en daardoor wat vreemd"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "710cabd0-6d06-4087-a203-afbf16abbc91",
                                "sense_id": "afcba976-4b69-3d5e-a0d5-4b622566e4f6",
                                "text": "Omdat met halfgare tweets en beledigingen een boek niet te vullen valt, hangt Jacobson juist als een alwetende verteller schmierend boven de tekst. En waar Roth strak één-op-één bleef, zwalkt Jacobson. Heldere verwijzingen - Fracassus krijgt bijvoorbeeld steun van een nativistische website genaamd Brightstar - zijn ingebed in een nodeloos complexe situatie die eerder verwart dan verheldert."
                            }
                        ]
                    }
