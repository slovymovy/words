                                                "sense_id": "934d9f21-7cf6-3744-b5ee-c90d1e4be971",
                                                "text": "Sowohl tierische als auch pflanzliche Zellen erzeugen Adenosintriphosphat in den Mitochondrien um Energie zu speichern."
                                            },
                                            {
                                                "example_id": "4afbc489-0f3e-44f0-8b38-1924b99805d2",
                                                "sense_id": "934d9f21-7cf6-3744-b5ee-c90d1e4be971",
                                                "text": "Braucht eine Zelle Energie, wird Adenosintriphosphat zu Adenosindiphosphat und einem Phosphat gespalten und exotherme Energie entweicht."
                                            }
