            "senses": [
                {
                    "sense_id": "b6cc57d3-1dbe-327d-b63f-a1fe37a667a0",
                    "sense_definition": "A large, thick-skinned herbivorous mammal with one or two horns on its snout.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were getting a grand shot of a charging <w>rhino</w> when the cameraman got scared and bolted.",
                            "target_lang_translations": {
                                "ru": "Мы делали отличный кадр атакующего <w>носорога</w>, когда оператор испугался и убежал."
                            }
                        },
                        {
                            "text": "The train was held up for an hour by an angry <w>rhino</w> on the tracks.",
                            "target_lang_translations": {
                                "ru": "Поезд задержался на час из-за разгневанного <w>носорога</w> на путях."
                            }
                        }
                    ],
                    "synonyms": [
                        "rhinoceros"
                    ],
                    "common_phrases": [
                        "charging rhino",
                        "angry rhino"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное травоядное млекопитающее с толстой кожей и одним или двумя рогами на морде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носорог",
                                "target_lang_sense_clarification": "общее название животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50abb17b-0e2d-3fad-abb6-a53edbb3b7e1",
                    "sense_definition": "Money or cash.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lived a very lavish lifestyle as long as the <w>rhino</w> lasted.",
                            "target_lang_translations": {
                                "ru": "Он жил на широкую ногу, пока у него были <w>деньги</w>."
                            }
                        },
                        {
                            "text": "He was happy to spend his <w>rhino</w> on expensive gifts for his friends.",
                            "target_lang_translations": {
                                "ru": "Он с радостью тратил свои <w>деньги</w> на дорогие подарки для друзей."
                            }
                        }
                    ],
                    "synonyms": [
                        "money",
                        "cash"
                    ],
                    "traits": [
