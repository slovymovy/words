                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a affirmé <w>positivement</w> que les impôts n'augmenteraient pas l'année prochaine."
