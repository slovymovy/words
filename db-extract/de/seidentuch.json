                ],
                "senses": [
                    {
                        "sense_id": "7a927469-ae79-37db-8c4a-4e84cb360cc2",
                        "entry_id": "35fdfd24-825a-3f69-8273-00ecbc1a49e4",
                        "glosses": [
                            "meist als Kleidungsstück genutztes Tuch, das aus Seide hergestellt worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d65728d-34f2-42e7-969f-21838ee827b4",
                                "sense_id": "7a927469-ae79-37db-8c4a-4e84cb360cc2",
                                "text": "„Ihre wilden langen Haare sind mit einem Seidentuch zusammengebunden.“"
                            },
                            {
                                "example_id": "8504643b-4f19-42f5-a44d-9509f1f345d7",
                                "sense_id": "7a927469-ae79-37db-8c4a-4e84cb360cc2",
                                "text": "„Die Herren trugen Janker oder förstergrüne Tweedjacketts, dazu maßgeschneiderte Hemden mit eingestickten Monogrammen, die Seidentücher wahlweise um den Hals oder in der Brusttasche.“"
                            },
                            {
                                "example_id": "891d9374-5271-4497-98c8-882181e3c9c4",
                                "sense_id": "7a927469-ae79-37db-8c4a-4e84cb360cc2",
                                "text": "„Noch im Alter von 80 Jahren ist es ihr wichtig, jeden Tag ins Atelier zu kommen und Seidentücher zu bemalen.“"
                            },
                            {
                                "example_id": "73268a44-f4ff-4bfd-9a04-a14a4451a328",
                                "sense_id": "7a927469-ae79-37db-8c4a-4e84cb360cc2",
                                "text": "„Claire holt ein Seidentuch aus ihrer Handtasche und wischt sich über Stirn und Nacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
