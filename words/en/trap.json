                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plumbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber had to clean out the <w>trap</w> under the kitchen sink.",
