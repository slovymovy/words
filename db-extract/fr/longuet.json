                            {
                                "example_id": "742acbfc-78a9-4f35-9737-6e3544e8332a",
                                "sense_id": "b451c6b7-277e-352f-b83a-377f48e87204",
                                "text": "La cheffe libérale Dominique Anglade ne l’a vraiment pas facile. Face à une CAQ indélogeable, la traversée du désert de son parti s’annonce longuette."
                            },
                            {
                                "example_id": "0ad94180-2b68-4070-b09e-ae51969c8252",
                                "sense_id": "b451c6b7-277e-352f-b83a-377f48e87204",
                                "text": "Son discours a été longuet, un peu longuet."
                            }
                        ]
