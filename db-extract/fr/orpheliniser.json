                "senses": [
                    {
                        "sense_id": "b23d4b45-8992-3902-8c79-673a3635f339",
                        "entry_id": "8984851b-36f3-380c-a0a1-dc78c1c4806a",
                        "glosses": [
                            "Donner un caractère orphelin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "753dcb23-2e6f-41dd-86d6-222240037433",
                                "sense_id": "b23d4b45-8992-3902-8c79-673a3635f339",
                                "text": "Orphelinisée l'an dernier en juin, elle s'est remérée sans essaimage."
                            },
                            {
                                "example_id": "baaf5674-d5a8-4004-b4f4-0c9d14aff279",
                                "sense_id": "b23d4b45-8992-3902-8c79-673a3635f339",
                                "text": "Pourraient-elles être le renoncement à la réconciliation entre époux ? Ou l'appétence d'orpheliniser les enfants pendant que leur parents vivent encore ?"
                            },
                            {
                                "example_id": "9bcc7f53-e2bf-4fab-9052-d148f5b07e07",
                                "sense_id": "b23d4b45-8992-3902-8c79-673a3635f339",
                                "text": "Quand ses parents, tout juste séparés, s’égarent dans des émissions de télé-réalité, Aurore, quatorze ans, décide de « s’orpheliniser » et part vivre chez sa grand-mère."
                            }
                        ]
                    }
