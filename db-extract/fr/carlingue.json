        "fr-extract.jsonl": [
            {
                "entry_id": "46c9e726-acd0-322f-a8d2-02f9442493c9",
                "word": "Carlingue",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4379995e-2149-3518-8ef4-5e84d3d3e6df",
                        "entry_id": "46c9e726-acd0-322f-a8d2-02f9442493c9",
                        "glosses": [
                            "Surnom de la Gestapo française (auxiliaires français de la Gestapo)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "594c8f86-954e-4283-8800-92dc0bc8e432",
                                "sense_id": "4379995e-2149-3518-8ef4-5e84d3d3e6df",
                                "text": "À la Carlingue, on traitait d’égal à égal avec les Fritz…"
                            },
                            {
                                "example_id": "98863c3c-49b4-4d71-8793-74ad2f31848f",
                                "sense_id": "4379995e-2149-3518-8ef4-5e84d3d3e6df",
                                "text": "Le 20 août, le chef de la Carlingue ayant fui la capitale, il accumule les indices et file cueillir la marquise d’Abrantès chez son coiffeur de la rue des Belles-Feuilles, ex-maîtresse de Lafont et petite amie d’Eddy Pagnon, l’ancien chauffeur du chef de la Carlingue."
                            },
                            {
                                "example_id": "c16a0ce2-469d-4c8c-82aa-0030f940d6e9",
                                "sense_id": "4379995e-2149-3518-8ef4-5e84d3d3e6df",
                                "text": "Mais entre deux arrestations et tortures, les membres de la Carlingue s'occupent surtout de leurs petites affaires personnelles, vols et rackets, pouvant aller jusqu'au meurtre, si nécessaire !"
                            }
                        ]
                    }
                ],
