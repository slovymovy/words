                                        "sense_id": "d1f73da9-7f28-38ba-a072-80b6a6241400",
                                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                                        "glosses": [
                                            "Having down, covered with a soft fuzzy coating as of small feathers or hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484b9de1-f9ac-4350-b481-8eac1a691701",
                                                "sense_id": "d1f73da9-7f28-38ba-a072-80b6a6241400",
                                                "text": "The chick's downy coat of feathers formed almost immediately to keep it warm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                                        "glosses": [
                                            "Sharp-witted, perceptive."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c992f75d-7f77-4efa-8932-ef6ddb9de8d8",
                                                "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                                "text": "The right hon. Gentleman has much more claim to the adjective downy than I have, but he really cannot catch me with that one."
                                            },
                                            {
                                                "example_id": "0e89a88a-f647-4be8-afe2-bf18e5672dbd",
                                                "sense_id": "bba21517-0478-33dc-891b-d8b5748c4532",
                                                "text": "I’m not clever, p’raps: but I am rather downy; and partial friends say I know what’s o’clock tolerably well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa5c3367-97dc-326b-8b6f-381c66eaa2d5",
                                        "entry_id": "712830a6-387d-3882-b34e-5dfc1f26bd68",
                                        "glosses": [
                                            "Low-spirited; down in the mouth."
                                        ],
                                        "tags": [
                                            "Norfolk",
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "downy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53b7ce45-759f-3916-8d11-696d21aa031b",
                                        "entry_id": "b0e2c104-1295-3a9d-bf36-495b6d73b02b",
                                        "glosses": [
                                            "A blanket filled with down; a duvet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d6d01d6-4375-4a1d-aeab-6a62f078227d",
                                                "sense_id": "53b7ce45-759f-3916-8d11-696d21aa031b",
                                                "text": "Went to bed with 2 downies on the bed, but the heat finally kicked in and ended with one cover and my feet sticking out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960659c4-598d-3da6-9624-6b9f1c94c636",
                                        "entry_id": "b0e2c104-1295-3a9d-bf36-495b6d73b02b",
                                        "glosses": [
                                            "A bed."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dae342a2-9637-43f6-94ae-bc303f51efc0",
                                                "sense_id": "960659c4-598d-3da6-9624-6b9f1c94c636",
                                                "text": "to do the downy (i.e. lie in bed)"
                                            },
                                            {
                                                "example_id": "f48a04fb-8b6e-45ba-99fb-5b509d5ccdd6",
                                                "sense_id": "960659c4-598d-3da6-9624-6b9f1c94c636",
                                                "text": "\"Lord love you, Mr. Scott, I've a deal to do before I get to my downy; and I don't like those doctored tipples. Good night, Mr. Scott; I wishes you good night, sir;\" and making another slight reference to his hat, which had not been removed from his head during the whole interview, Mr. Manylodes took himself off."
                                            }
                                        ]
                                    }
                                ]
                            }
