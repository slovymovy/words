                    }
                ],
                "translations": [
                    {
                        "translation_id": "56e3dad1-aed7-46cc-9fd1-98af753f8916",
                        "source_entry_id": "5cc0a802-95c5-37a1-965f-b8689f392433",
                        "source_sense_id": "ffca8b02-e3b9-3580-87aa-a88d29fe757f",
                        "source_sense_description": "manual worker",
                        "target_lang_word": "Handwerker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handwerker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                        "entry_id": "43a7f0c2-74a7-3488-994c-359510e7b7b6",
                                        "glosses": [
                                            "derjenige, der beruflich ein Handwerk betreibt, auch ein Kunsthandwerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db74795-6419-4de5-ad29-4d738b43c720",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "Den letzten, dritten Teil machen einige Patrizierfamilien, die Kaufleute und Handwerker aus, von denen die zwei andern Dritteile leben."
                                            },
                                            {
                                                "example_id": "1c3b14f7-0b07-4860-88bc-ae758b01c7cf",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "Er ist noch ein Handwerker der alten Schule."
                                            },
                                            {
                                                "example_id": "5ee941c2-f7cd-40cd-90a4-6ace407fcca9",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "Kannst du Morgen um 13.00 zu Hause sein? Die Handwerker kommen."
                                            },
                                            {
                                                "example_id": "8e990b86-4f68-430f-8998-da4ef72091b9",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "„Beginnend am Kiel, fügen die Handwerker nun den Rumpf zusammen.“"
                                            },
                                            {
                                                "example_id": "fccd3f18-6357-492a-b4b5-8b2ae380384d",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "„Obwohl es erfahrene Steinmetze auf den Färöern gab, würde es dennoch schwierig werden, eine tüchtige Schar Handwerker zu finden, die ein Steinhaus bauen konnten.“"
                                            },
                                            {
                                                "example_id": "502bce8f-1eae-462c-8cea-2c5219397d30",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "„Handwerker arbeiten draußen an den Regenrinnen.“"
                                            },
                                            {
                                                "example_id": "5235b79d-90ad-4662-b92c-fb7080aab75a",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "„Aber an der Klingelei wird deutlich, dass er kein Künstler, sondern vielmehr ein grobschlächtiger Handwerker ist.“"
                                            },
                                            {
                                                "example_id": "0226e8ec-c1f0-4c3c-b9f7-5b7f1c41e4bf",
                                                "sense_id": "0978acaa-c29f-3ee2-99f1-22d17c84a943",
                                                "text": "„Endlich ließ er eine Zahl Handwerker rufen, um sieben oder acht Amtsgürtel beschlagen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Handwerker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                        "entry_id": "edd2b0da-20c9-31b4-bb05-2e75199e7575",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f3150d-0ddc-48bd-bfa4-17bcb65f909e",
                                                "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                                "text": "Handwerkers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "5211783a-2f86-4c08-a6f3-79d9b5bd456a",
                                                "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                                "text": "Frau Handwerker ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "323d9148-bfb4-42f2-b923-ae774f156a8c",
                                                "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                                "text": "Herr Handwerker wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "7d6a9a53-4975-4ecb-b4ae-62b25f310536",
                                                "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                                "text": "Die Handwerkers fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "24a56510-5012-4452-82f4-927dfab5ad33",
                                                "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                                "text": "Der Handwerker trägt nie die Pullover, die die Handwerker ihm strickt."
                                            },
                                            {
                                                "example_id": "5bd4537d-bfe7-438b-b08e-c3988e1038b8",
                                                "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Handwerker kommt, geht der Herr Handwerker.“"
                                            },
                                            {
                                                "example_id": "21ee04b6-42d3-462a-a1a8-f2e7cb9803ac",
                                                "sense_id": "19061038-f99d-387e-8aca-e96b7137b979",
                                                "text": "Handwerker kommt und geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
