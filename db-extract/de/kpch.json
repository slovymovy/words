                                "example_id": "c1c76cd4-bb29-4938-8e6a-4274a2f627ad",
                                "sense_id": "c4f31275-e181-32a9-b880-ded18caa4295",
                                "text": "„Die überwiegende Mehrzahl der hochrangigen Mitglieder der KPCh, von denen viele unter der Kulturrevolution gelitten hatten, unterstützten Deng Xiaoping.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
