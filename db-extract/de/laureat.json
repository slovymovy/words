                                        "entry_id": "6681e28e-95e9-3998-b4a9-88fe81c5ca36",
                                        "glosses": [
                                            "Quelqu’un des poètes qui ont ont reçu solennellement une couronne de laurier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdae55df-7e13-4e5a-8cd3-d5c763ee41dc",
                                                "sense_id": "1f3403fc-e0f7-3e9f-bebe-1a5d20dcf5e2",
                                                "text": "Pétrarque est un poète lauréat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lauréat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "038103c4-d2fc-323b-9bd1-3537b630b150",
                                        "entry_id": "5b5bf5c8-511b-3892-aabb-83aace2eb5fd",
                                        "glosses": [
                                            "Celui ou celle qui a remporté le prix dans un concours scolaire ou académique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebaf918b-b15b-4c16-811d-b1f4215d76cc",
                                                "sense_id": "038103c4-d2fc-323b-9bd1-3537b630b150",
                                                "text": "Issu de la bourgeoisie intellectuelle parisienne, Jurgensen est un élève brillant : double lauréat du concours général en latin et en grec, admis à Henri-IV, il entre rue d'Ulm dès sa première tentative en 1937."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f0728b-5a7f-3567-bb6c-8dcebfd5d9c6",
                                        "entry_id": "5b5bf5c8-511b-3892-aabb-83aace2eb5fd",
                                        "glosses": [
                                            "Celui qui s'est distingué lors de son cursus universitaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f16db803-8b77-42a7-9593-9113c9f47894",
                                                "sense_id": "77f0728b-5a7f-3567-bb6c-8dcebfd5d9c6",
                                                "text": "[…] ; les deux premiers élèves peuvent recevoir une mission à l'étranger à l'instar des principaux lauréats des Écoles des Beaux-Arts, des Mines, des Ponts-et-Chaussées, etc... Ce sont les grands prix de l'Institut agronomique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8595346e-8188-36ae-a267-55ee713f5e32",
                                        "entry_id": "5b5bf5c8-511b-3892-aabb-83aace2eb5fd",
                                        "glosses": [
                                            "Celui à qui on a attribué un prix, une mention ou un accessit dans un concours quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "527ef299-90bd-49fb-b6ce-07f3af07acb7",
                                                "sense_id": "8595346e-8188-36ae-a267-55ee713f5e32",
                                                "text": "Marius André […] devait être couronné cette même année lauréat des Jeux Floraux septennaires du Félibrige et publier deux ans après son œuvre principale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
