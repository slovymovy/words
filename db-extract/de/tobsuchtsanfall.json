                "senses": [
                    {
                        "sense_id": "473571e9-ac49-3636-9242-5193d5c21a2c",
                        "entry_id": "47e30e47-2c60-325c-8ac9-58bce8485036",
                        "glosses": [
                            "plötzlich ausbrechende Wut, überschäumender Ärger, oft mit dem Beiton, dass diese Reaktion überzogen oder krankhaft ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b010329f-fc69-4200-a59d-58156544e7da",
                                "sense_id": "473571e9-ac49-3636-9242-5193d5c21a2c",
                                "text": "Mein Verlobter bekam einen Tobsuchtsanfall, als er von meiner Untreue hörte."
                            },
                            {
                                "example_id": "99304573-6605-45c7-9ba9-9f55c5fd9d08",
                                "sense_id": "473571e9-ac49-3636-9242-5193d5c21a2c",
                                "text": "Ein Tobsuchtsanfall hilft uns jetzt auch nicht weiter, lass uns in Ruhe an die Sache herangehen."
                            },
                            {
                                "example_id": "e3699f5f-fd73-42f8-add0-59ec584e1248",
                                "sense_id": "473571e9-ac49-3636-9242-5193d5c21a2c",
                                "text": "„Bei seiner Rückkehr bekam der abtrünnige General einen Tobsuchtsanfall.“"
                            },
                            {
                                "example_id": "7fad6688-8ec8-4aad-86da-ea69efd77fa0",
                                "sense_id": "473571e9-ac49-3636-9242-5193d5c21a2c",
                                "text": "„Damals hatte ich auch noch die landläufige Auffassung von Geisteskrankheiten und stellte mir darunter dauernde Tobsuchtsanfälle, Mordversuche und lallende Idioten vor – um so überraschender hob sich Geneviève davon ab.“"
                            },
                            {
                                "example_id": "92391640-d840-434b-9a15-089f92ae8969",
                                "sense_id": "473571e9-ac49-3636-9242-5193d5c21a2c",
                                "text": "„Man kann sich unschwer vorstellen, welche Tobsuchtsanfälle diese Mitteilungen bei de Sade auslösten, zu welch schrecklichen Szenen es dabei gekommen sein mag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
