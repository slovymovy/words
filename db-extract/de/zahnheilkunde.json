                        ],
                        "form": "die Zahnheilkunde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                        "entry_id": "6e0cd434-fd2f-3d65-9337-6dba87a47908",
                        "glosses": [
                            "Teilgebiet der Medizin, das sich mit der Vorbeugung, Erkennung und Behandlung von Erkrankungen im Zahn-, Mund- und Kieferbereich beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6b3731-f62d-44c8-8b8a-515ce0ecab5e",
                                "sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                                "text": "Zahnärzte üben die Zahnheilkunde aus."
                            },
                            {
                                "example_id": "7f48da3d-1fe2-4594-9063-6c504693e7b5",
                                "sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                                "text": "„Mit Freiheitsstrafe bis zu einem Jahr oder mit Geldstrafe wird bestraft, 1. wer die Zahnheilkunde ausübt, ohne eine Approbation oder Erlaubnis als Zahnarzt zu besitzen […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9561578-f542-4759-89d7-c4a1e5da6608",
                        "source_entry_id": "6e0cd434-fd2f-3d65-9337-6dba87a47908",
                        "source_sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                        "source_sense_description": "Teilgebiet der Medizin, das sich mit dem Zahn-, Mund- und Kieferbereich beschäftigt",
                        "target_lang_word": "dentistry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentistry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e748f20c-e089-3f4f-b112-5fcb15297a14",
                                        "entry_id": "d2684e75-f5ee-37c7-b0c8-9a0402aa55b1",
                                        "glosses": [
                                            "The field of medicine concerned with the study, diagnosis, and treatment of conditions of the teeth and oral cavity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afb97821-84f4-483e-b12e-ba9bb0c5594f",
                                                "sense_id": "e748f20c-e089-3f4f-b112-5fcb15297a14",
                                                "text": "Some provision should be made for the truly suffering poor, and also for our present students of dentistry to learn something about dental surgery before commencing a profession which has almost become a science."
                                            },
                                            {
                                                "example_id": "522a9297-b63c-454e-8d08-60adb1e2ae19",
                                                "sense_id": "e748f20c-e089-3f4f-b112-5fcb15297a14",
                                                "text": "A corporation may not operate a dentistry office unless all of its stockholders are licensed to practice dentistry."
                                            },
                                            {
                                                "example_id": "d4ba4445-c8a3-44b8-887b-8b4a817e0031",
                                                "sense_id": "e748f20c-e089-3f4f-b112-5fcb15297a14",
                                                "text": "He was born near Middleton in 1853, graduated from Mount Allison, and took his dentistry degree at Philadelphia in 1878."
                                            },
                                            {
                                                "example_id": "550a2857-2bc8-47ef-8297-0f70a6b603e3",
                                                "sense_id": "e748f20c-e089-3f4f-b112-5fcb15297a14",
                                                "text": "Wig-workers were not the only tradesmen who practiced dentistry on the side, or \"assumed the role\" of dentist, as the arrival of a thespian dentist from London attests in this ad from Boston's Independent Chronicle and Universal Advertiser"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887afa37-047c-3c36-bde6-e333282eee04",
                                        "entry_id": "d2684e75-f5ee-37c7-b0c8-9a0402aa55b1",
                                        "glosses": [
                                            "Operations performed on teeth and adjoining areas such as drilling, filling cavities, and placing crowns and bridges."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec2eb7dc-d31a-4f41-9992-c0b7342268e3",
                                                "sense_id": "887afa37-047c-3c36-bde6-e333282eee04",
                                                "text": "POOR Australians are resorting to do-it-yourself dentistry, including filing their own teeth and attempting their own extractions, because of lengthy queues for public dental services."
                                            },
                                            {
                                                "example_id": "eacbb0e7-c477-4019-9d43-bcdbf52b6c9a",
                                                "sense_id": "887afa37-047c-3c36-bde6-e333282eee04",
                                                "text": "This patient is an out-of-town physician who had to wait until retirement to complete his dentistry. He had holding pattern type dentistry done to get him by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e6d9a0a-b675-3fd4-bbe5-f98b4fddb3ae",
                                        "entry_id": "d2684e75-f5ee-37c7-b0c8-9a0402aa55b1",
                                        "glosses": [
                                            "A dental surgery, an operation on the teeth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b95ba1-a3be-43b2-9357-e8014036db8b",
                                                "sense_id": "7e6d9a0a-b675-3fd4-bbe5-f98b4fddb3ae",
                                                "text": "Dr. Landsberg, of Posen, states that when children's teeth are put in order by means of school dentistries, anaemia, one of the most frequent school diseases, will be greatly diminished."
                                            },
                                            {
                                                "example_id": "e192670e-46f4-4313-931b-404d58e8da46",
                                                "sense_id": "7e6d9a0a-b675-3fd4-bbe5-f98b4fddb3ae",
                                                "text": "I speak now only of your pet's bad breath. Dentistries will specifically improve the oral health of the pet as well as its overall health in the long term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294c4508-e545-3b86-a66b-dbb4a6bedfc2",
                                        "entry_id": "d2684e75-f5ee-37c7-b0c8-9a0402aa55b1",
                                        "glosses": [
                                            "A place where dental operations are performed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e01e4a-275e-4f87-8b25-c5499d3aa10e",
                                                "sense_id": "294c4508-e545-3b86-a66b-dbb4a6bedfc2",
                                                "text": "They are very fond of sweet things; and the ladies especially crowd the “candystores,” which are not less numerous than the dentistries—with which business they are intimately connected."
                                            },
                                            {
                                                "example_id": "f9221bff-5539-44f9-8320-fa96b12fafa4",
                                                "sense_id": "294c4508-e545-3b86-a66b-dbb4a6bedfc2",
                                                "text": "The author could dilate at great length on the possibilities in plant groceries, restaurants, and dentistries."
                                            },
                                            {
                                                "example_id": "56ba7f49-ab79-43e1-af02-2051f21672ec",
                                                "sense_id": "294c4508-e545-3b86-a66b-dbb4a6bedfc2",
                                                "text": "As a first step, the law with be amended to prepare for the privatization of pharmacies and dentistries by end-2003."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "970e4881-c11e-4e2e-9639-b8b3a5e36884",
                        "source_entry_id": "6e0cd434-fd2f-3d65-9337-6dba87a47908",
                        "source_sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                        "source_sense_description": "Teilgebiet der Medizin, das sich mit dem Zahn-, Mund- und Kieferbereich beschäftigt",
                        "target_lang_word": "odontologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odontologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93624dfd-6268-32b0-b940-2bfee960a127",
                                        "entry_id": "4478ea14-aa2c-374d-90a5-58e66d6334b0",
                                        "glosses": [
                                            "Étude et pratique médicale et chirurgicale des soins dentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98a72d63-b022-455b-be92-dec40b66477c",
                                                "sense_id": "93624dfd-6268-32b0-b940-2bfee960a127",
                                                "text": "La dentisterie restauratrice en rapport avec le parodonte comprend la prothèse fixée pour le traitement de l’édentement et la prothèse unitaire ou l’odontologie restauratrice, collée ou scellée."
                                            },
                                            {
                                                "example_id": "a416b9df-84f2-4516-b1ff-54b7f10824bd",
                                                "sense_id": "93624dfd-6268-32b0-b940-2bfee960a127",
                                                "text": "Chaque année, des dizaines de jeunes Français partent se former à la médecine ou à l’odontologie dans des cursus francophones en Roumanie, en Espagne ou encore en Hongrie, profitant de modalités d’accès plus avantageuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
