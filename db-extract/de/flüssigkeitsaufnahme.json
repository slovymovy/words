                "senses": [
                    {
                        "sense_id": "7d07fec3-2abf-384c-93b9-8546d5a3a952",
                        "entry_id": "916940f4-f405-3c88-b828-11d21d242803",
                        "glosses": [
                            "Vorgang, bei dem eine Flüssigkeit (wie etwa Wasser) in etwas hineingelangt, aufgenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db974f5-9736-4746-a639-fcfa1e73afda",
                                "sense_id": "7d07fec3-2abf-384c-93b9-8546d5a3a952",
                                "text": "„Die Flüssigkeitsaufnahme hat direkte Auswirkungen auf unsere Gesundheit und Leistungsfähigkeit.“"
                            },
                            {
                                "example_id": "fd7905fa-904e-4b8f-8e4a-980a1b20579b",
                                "sense_id": "7d07fec3-2abf-384c-93b9-8546d5a3a952",
                                "text": "„Sollte der Sportler keinen oder stark konzentrierten Urin produzieren, ist eine weitere Flüssigkeitsaufnahme von 3–5 ml/kg ungefähr 2 Stunden vor dem Start erforderlich […].“"
                            },
                            {
                                "example_id": "c819a7e9-caeb-46b0-b4c9-25f465575620",
                                "sense_id": "7d07fec3-2abf-384c-93b9-8546d5a3a952",
                                "text": "„Die Klientin neigt dazu viel zu wenig zu trinken, selbst zu Trainingszeiten wurde nicht auf eine ausreichende Flüssigkeitsaufnahme geachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
