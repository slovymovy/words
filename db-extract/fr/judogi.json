                    {
                        "sense_id": "aeea028b-572c-376c-9ba8-1003613aeb7e",
                        "entry_id": "790df507-4fea-35cd-a3d4-6b3cc0f9bcf5",
                        "glosses": [
                            "Vêtement utilisé pour la pratique du judo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1b262c-4560-4848-8830-5749b389bb6f",
                                "sense_id": "aeea028b-572c-376c-9ba8-1003613aeb7e",
                                "text": "Le kimono désigne en effet les vêtements traditionnels japonais, tandis que le judogi est utilisé dans le cadre de la pratique du judo."
                            },
                            {
                                "example_id": "9b3719d3-3a08-42b5-a1e9-62f7d76d4847",
                                "sense_id": "aeea028b-572c-376c-9ba8-1003613aeb7e",
                                "text": "Le contentieux qui opposait Clarisse Agbegnenou et Teddy Riner à la Fédération française de judo (FFJ) sur l’utilisation par les judokas de leur propre judogi (l’habit réglementaire) au lieu de celui de la fédé a été réglé, a annoncé L’Èquipe, mardi."
                            },
                            {
                                "example_id": "dcb918c2-bbbd-4f6e-83aa-fa26500ad903",
                                "sense_id": "aeea028b-572c-376c-9ba8-1003613aeb7e",
                                "text": "Ce que l’on nomme kumi-kata, est tout simplement la saisie du judogi."
                            }
                        ]
                    }
                ],
