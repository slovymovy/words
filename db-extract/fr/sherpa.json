                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee4772b-9d62-40f9-b4d5-367ea7ee18be",
                                "sense_id": "52672d59-7bcf-3157-85a7-9201e4b511ac",
                                "text": "La cinquième tentative aura été la bonne quand les 10 membres des la communauté ethnique des Sherpas ont planté simultanément leur^([sic]) piolet^([sic]) à la cime de la Montagne sauvage, culminant à 8611 m d'altitude."
                            }
                        ]
                    }
