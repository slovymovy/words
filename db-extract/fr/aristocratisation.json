                        "glosses": [
                            "Action de rendre aristocratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e507d7ef-b1a8-482e-a688-b6543c6b1436",
                                "sense_id": "bd325f7a-44eb-3824-ae61-dc081288e006",
                                "text": "Le désir d’aristocratisation se manifeste enfin par une volonté précoce, sensible dès la fin du XVIe siècle, d’imiter le mode de vie nobiliaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "84502b66-60e3-3a61-9e1c-853839bb5da0",
                        "entry_id": "16321c6d-39e4-3e66-b33e-d4a6d86b7f87",
                        "glosses": [
                            "Action de réserver à une élite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62d731a-e833-4a79-9175-b0717939c9b3",
                                "sense_id": "84502b66-60e3-3a61-9e1c-853839bb5da0",
                                "text": "Ces changements architecturaux accompagnaient l’aristocratisation de ces rues où le bois devait désormais laisser la place à des matériaux en dur plus dignes des élites qui s’y installaient."
                            },
                            {
                                "example_id": "3322bb08-757d-4e95-9d02-c4a21a5dde64",
                                "sense_id": "84502b66-60e3-3a61-9e1c-853839bb5da0",
                                "text": "Des canons d'élégance décagénaires se sont donc constitués et se renouvellent rapidement selon les normes de démocratisation/aristocratisation propres à la mode adulte ([…])."
                            }
                        ]
                    }
