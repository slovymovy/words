{
    "word_family": [
        "korsten",
        "aardkorst",
        "kaaskorst",
        "broodkorst",
        "ijskorst",
        "korstmos"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "535e761b-b9a7-3032-be8f-1176c76c69c3",
                    "sense_definition": "een harde buitenste laag om iets dat verder relatief zacht is, zoals bij brood of kaas",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "buitenlaag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel jonge kinderen willen de <w>korst</w> van hun brood niet opeten.",
                            "target_lang_translations": {
                                "en": "Many young children do not want to eat the <w>crust</w> of their bread."
                            }
                        },
                        {
                            "text": "Vergeet niet om de harde <w>korst</w> van de kaas af te snijden.",
                            "target_lang_translations": {
                                "en": "Don't forget to cut off the hard <w>rind</w> of the cheese."
                            }
                        }
                    ],
                    "common_phrases": [
                        "harde korst",
                        "korst van brood"
                    ],
                    "target_lang_definitions": {
                        "en": "a hard outer layer surrounding something that is otherwise relatively soft, such as with bread or cheese"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crust",
                                "target_lang_sense_clarification": "of bread or cheese"
                            },
                            {
                                "target_lang_word": "rind",
                                "target_lang_sense_clarification": "specifically for cheese or fruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c27655b8-ea1c-3826-ac47-187f011bbf45",
                    "sense_definition": "een hard laagje dat zich op een wond vormt tijdens het genezingsproces",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een dikke <w>korst</w> op de knie van het kind na de val.",
                            "target_lang_translations": {
                                "en": "There is a thick <w>scab</w> on the child's knee after the fall."
                            }
                        },
                        {
                            "text": "Je moet niet aan de <w>korst</w> krabben, want dan gaat de wond weer bloeden.",
                            "target_lang_translations": {
                                "en": "You shouldn't scratch the <w>scab</w>, because then the wound will start bleeding again."
                            }
                        }
                    ],
                    "common_phrases": [
                        "korst op de wond"
                    ],
                    "target_lang_definitions": {
                        "en": "a hard layer that forms on a wound during the healing process"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scab",
                                "target_lang_sense_clarification": "on a healing wound"
                            },
                            {
                                "target_lang_word": "crust",
                                "target_lang_sense_clarification": "medical/dried discharge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a4b36ed-0b5f-35e1-a65b-cc1fbb33e298",
                    "sense_definition": "de buitenste vaste laag van een planeet",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vloeibare magma bevindt zich direct onder de vaste <w>korst</w> van de aarde.",
                            "target_lang_translations": {
                                "en": "The liquid magma is located directly beneath the Earth's solid <w>crust</w>."
                            }
                        },
                        {
                            "text": "Wetenschappers bestuderen de bewegingen in de <w>korst</w> om aardbevingen te voorspellen.",
                            "target_lang_translations": {
                                "en": "Scientists study the movements in the <w>crust</w> to predict earthquakes."
                            }
                        }
                    ],
                    "synonyms": [
                        "aardkorst"
                    ],
                    "common_phrases": [
                        "korst van de aarde"
                    ],
                    "target_lang_definitions": {
                        "en": "the outermost solid layer of a planet"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crust",
                                "target_lang_sense_clarification": "geological layer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8801baed-7009-3102-a52a-1aa77acb86cf",
                    "sense_definition": "enkelvoud tegenwoordige tijd van <w>korsten</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wond <w>korst</w> langzaam dicht naarmate de week vordert.",
                            "target_lang_translations": {
                                "en": "The wound slowly <w>scabs</w> over as the week progresses."
                            }
                        },
                        {
                            "text": "Het oppervlak <w>korst</w> door de extreme hitte van de oven.",
                            "target_lang_translations": {
                                "en": "The surface <w>crusts</w> due to the extreme heat of the oven."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present tense singular of 'to crust over' or 'to form a crust'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crusts",
                                "target_lang_sense_clarification": "forming a hard layer"
                            },
                            {
                                "target_lang_word": "scabs over",
                                "target_lang_sense_clarification": "specifically for a wound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd985be1-98d8-33d6-9639-87dea1dc2573",
                    "sense_definition": "gebiedende wijs van <w>korsten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Korst</w> het deeg eerst voordat je de vulling toevoegt.",
                            "target_lang_translations": {
                                "en": "<w>Pre-bake</w> the dough first before you add the filling."
                            }
                        },
                        {
                            "text": "Bak het vlees kort aan en <w>korst</w> het aan alle kanten.",
                            "target_lang_translations": {
                                "en": "Fry the meat briefly and <w>sear</w> it on all sides."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to crust' or 'to brown'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crust",
                                "target_lang_sense_clarification": "to create a hard layer"
                            },
                            {
                                "target_lang_word": "sear",
                                "target_lang_sense_clarification": "to brown meat quickly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}