                        "sense_id": "213443bc-8b22-3f56-bbb0-4ed102d4b903",
                        "entry_id": "a3a7cecf-8a6f-3a5a-bfec-795e5be3f8cc",
                        "glosses": [
                            "wog (north-African or middle-eastern person)"
                        ],
