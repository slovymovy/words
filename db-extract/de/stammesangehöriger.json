                "senses": [
                    {
                        "sense_id": "bac4b229-8c3a-3f53-9b99-eb0e01e76663",
                        "entry_id": "72032a32-c450-36b8-a96a-5aeb2395126c",
                        "glosses": [
                            "Person, die einem Stamm angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ee2c1f-6061-4336-9e0c-67477a0d6a59",
                                "sense_id": "bac4b229-8c3a-3f53-9b99-eb0e01e76663",
                                "text": "„Für einen Stammesangehörigen ergibt sich die eigene gesellschaftliche Position aus der tribalen Zuordnung.“"
                            },
                            {
                                "example_id": "793a9414-8c13-44fa-a727-be4cab57be43",
                                "sense_id": "bac4b229-8c3a-3f53-9b99-eb0e01e76663",
                                "text": "„Bei näherer Befragung schüttelten die Stammesangehörigen nur den Kopf und deuteten zum Himmel.“"
                            },
                            {
                                "example_id": "143f9dc8-bf48-47be-82db-c9167c2d2ba5",
                                "sense_id": "bac4b229-8c3a-3f53-9b99-eb0e01e76663",
                                "text": "„Raynor war sich darüber im Klaren, dass sich seine eigene Situation damit noch heikler darstellte, denn es gab nun niemanden mehr, der für ihn das Reden übernehmen konnte, falls ein Stammesangehöriger an die Scheibe klopfte.“"
                            },
                            {
                                "example_id": "241604a1-6da9-4314-b73f-ce5b9ac92025",
                                "sense_id": "bac4b229-8c3a-3f53-9b99-eb0e01e76663",
                                "text": "„Den großen Tabarin-Stamm vertrieb die Armee nach Gaza; nur 1000 Stammesangehörigen erlaubte sie zu bleiben.“"
                            },
                            {
                                "example_id": "2553ee6f-159b-4287-8c81-3607da5331ea",
                                "sense_id": "bac4b229-8c3a-3f53-9b99-eb0e01e76663",
                                "text": "„Die Stammesangehörigen der Tungus in Sibirien behaupten, wenn der Schamane sich in Trance versetzt und unverständliche Silben hinausschreit, lernt er die ganze Sprache der Natur.“"
                            },
                            {
                                "example_id": "d20e0755-bc58-4b1b-a296-aaf9c9c77669",
                                "sense_id": "bac4b229-8c3a-3f53-9b99-eb0e01e76663",
                                "text": "„Stammesangehörige, die sich gerade aus der äußersten Barbarei emporkämpften, waren die Kritiker, und für sie war Ga-nor ein früher Meister.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
