                ],
                "senses": [
                    {
                        "sense_id": "e1849643-d573-3506-b088-91e5ee7c2a32",
                        "entry_id": "a2f46a9c-0c9a-3db0-887b-a8a41982b772",
                        "glosses": [
                            "Forme pronominale de étioler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b8ca15-e3fe-4432-9771-5c8d7d3561b6",
                                "sense_id": "e1849643-d573-3506-b088-91e5ee7c2a32",
                                "text": "Il eût mieux valu, pour la jeune fille, écouter les entretiens de Misé Médé, apprendre auprès d’elle ce peu de bonnes et sérieuses choses qu’elle pouvait lui enseigner, et développer son esprit librement au milieu de cette grande nature, que d’aller s’étioler entre les murs noirs et tristes du couvent de Saint-Benoît."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7071a27e-3e9b-4861-a5af-873895f21801",
                        "source_entry_id": "a2f46a9c-0c9a-3db0-887b-a8a41982b772",
                        "source_sense_id": "e1849643-d573-3506-b088-91e5ee7c2a32",
                        "target_lang_word": "languish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36987005-359a-3389-96bb-ac40d525c214",
                                        "entry_id": "a316f716-7835-3b84-b881-8a99c92fc01e",
                                        "glosses": [
                                            "To lose strength and become weak; to be in a state of weakness or sickness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36eab803-94f9-479d-b395-188824d04931",
                                                "sense_id": "36987005-359a-3389-96bb-ac40d525c214",
                                                "text": "We […] do languish of such diseases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e450daa0-8a17-30c5-8af2-48d56ebd98c3",
                                        "entry_id": "a316f716-7835-3b84-b881-8a99c92fc01e",
                                        "glosses": [
                                            "To pine away in longing for something; to have low spirits, especially from lovesickness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3df8c0-98b0-472d-971c-17b3ddbb4923",
                                                "sense_id": "e450daa0-8a17-30c5-8af2-48d56ebd98c3",
                                                "text": "He languished without his girlfriend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3037d8d8-960c-36cb-8afa-d728ad9fe1aa",
                                        "entry_id": "a316f716-7835-3b84-b881-8a99c92fc01e",
                                        "glosses": [
                                            "To live in miserable or disheartening conditions."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e57387f4-73a8-4fae-b258-73cf628d9261",
                                                "sense_id": "3037d8d8-960c-36cb-8afa-d728ad9fe1aa",
                                                "text": "He languished in prison for years."
                                            },
                                            {
                                                "example_id": "dc47816a-350a-44e5-9b4e-20f7dee53ea0",
                                                "sense_id": "3037d8d8-960c-36cb-8afa-d728ad9fe1aa",
                                                "text": "An elderly Hungarian found languishing in a Russian mental hospital could finally be allowed to return home - 55 years after being taken prisoner by the Russian Army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cdfaea3-d8cf-303a-8aab-319404bc81bb",
                                        "entry_id": "a316f716-7835-3b84-b881-8a99c92fc01e",
                                        "glosses": [
                                            "To be neglected; to make little progress, be unsuccessful."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3a26ff1-497c-4622-8ce4-603c0170e8ef",
                                                "sense_id": "4cdfaea3-d8cf-303a-8aab-319404bc81bb",
                                                "text": "The case languished for years before coming to trial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11a0035-2287-3eac-bc1c-d0e488aed662",
                                        "entry_id": "a316f716-7835-3b84-b881-8a99c92fc01e",
                                        "glosses": [
                                            "To make weak; to weaken, devastate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bf70d7b-6281-3e28-825a-8c892d5d9e40",
                                        "entry_id": "a316f716-7835-3b84-b881-8a99c92fc01e",
                                        "glosses": [
                                            "To affect a languid air, especially disingenuously."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bdb551-5f09-4b06-8803-600187b94394",
                                                "sense_id": "6bf70d7b-6281-3e28-825a-8c892d5d9e40",
                                                "text": "He is an excellent young man, and will suit Harriet exactly: it will be an \"exactly so,\" as he says himself; but he does sigh and languish, and study for compliments rather more than I could endure as a principal."
                                            },
                                            {
                                                "example_id": "afe7cc4a-f74c-4d6c-8562-e1166addf95c",
                                                "sense_id": "6bf70d7b-6281-3e28-825a-8c892d5d9e40",
                                                "text": "His bowstring slackened, languid Love, / Leaning his cheek upon his hand, / Droops both his wings, regarding thee, / And so would languish evermore, / Serene, imperial Eleänore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
