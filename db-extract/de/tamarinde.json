                    {
                        "translation_id": "76e93471-2247-411d-9bda-dab40aac109e",
                        "source_entry_id": "a834e017-8fac-3f7c-ab2c-d1cfc3d02c77",
                        "source_sense_id": "8712a0af-cd10-3be4-8c61-8d86d6279f59",
