                "senses": [
                    {
                        "sense_id": "783c70de-5ce4-31f7-8d30-77077a279c53",
                        "entry_id": "0e57cb5a-2e9b-3ab6-97df-5627e3e15b72",
                        "glosses": [
                            "Handlung/Entscheidung, sich erneut an eine gewisse Person, Meinung oder ein Weltbild zu richten, zu orientieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3daa84ce-9a7a-471d-9bb3-d943a54d545c",
                                "sense_id": "783c70de-5ce4-31f7-8d30-77077a279c53",
                                "text": "„Die Rückwendung zum Mittelalter in der Romantik ist einerseits ein Symptom der reaktionären Tendenzen in der nationalen Erneuerung, anderseits eine schwere Schädigung und Irreführung der späteren deutschen ideologischen Entwicklung.“"
                            },
                            {
                                "example_id": "8498ea77-2f5b-4921-9009-7e6a73f5b930",
                                "sense_id": "783c70de-5ce4-31f7-8d30-77077a279c53",
                                "text": "„In seinem Verhalten kehren wesentliche Momente von Benjamins Geschichtsdenken wieder, vor allem die eingedenkende Rückwendung in die Vergangenheit mitsamt der Intention, die Zerstörung und das Leid ungeschehen machen zu wollen.“"
                            },
                            {
                                "example_id": "02c836a6-36aa-42c5-a62a-c8dac36186af",
                                "sense_id": "783c70de-5ce4-31f7-8d30-77077a279c53",
                                "text": "„Zur Zeitgestaltung in der erzählenden Prosa gehören darüber hinaus auch Rückgriffe, Rückwendungen und Vorausdeutungen des Textes.“"
                            },
                            {
                                "example_id": "d6ecd811-9839-45a0-9f20-3463f43041a0",
                                "sense_id": "783c70de-5ce4-31f7-8d30-77077a279c53",
                                "text": "„Mit dieser Rückwendung zur Natur ist aber eine politische Rückwendung zu mittelalterlichen Gesellschafts- und Lebensformen verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
