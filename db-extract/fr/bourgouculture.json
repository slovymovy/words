                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9be2b49-2934-4691-ae8d-9df7574c8072",
                                "sense_id": "7b911380-4388-3127-b724-885059a093c2",
                                "text": "Le programme va permettre, entre autres, … le développement de la pisciculture sur 270 hectares, la bourgouculture sur 6820 hectares, la mise en œuvre des mesures environnementales des plans de gestion environnementale et sociale."
                            },
                            {
                                "example_id": "3398c046-cc4b-48f8-bb16-ac274d78311c",
                                "sense_id": "7b911380-4388-3127-b724-885059a093c2",
                                "text": "Les activités de bourgouculture sont renforcées et gérées durablement par les communautés qui y tirent des revenus substantiels renforçant leur pouvoir d’achat."
                            },
                            {
                                "example_id": "c7b60582-d564-444f-8514-8fa669901594",
                                "sense_id": "7b911380-4388-3127-b724-885059a093c2",
                                "text": "La création des revenus et la promotion de l’auto-emploi reposeront sur le développement d’activités économiquement viables, simples, et touchant des domaines variés (riziculture, bourgouculture, maraîchage, arboriculture fruitière, foresterie, etc.)."
                            }
                        ]
