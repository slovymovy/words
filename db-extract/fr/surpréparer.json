                ],
                "senses": [
                    {
                        "sense_id": "5a362717-249f-3ab6-98e7-7a79b380c1d7",
                        "entry_id": "7b9ae6f2-3ecf-3869-be3e-fb93a5471a75",
                        "glosses": [
                            "Préparer plus que la normale, ou de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c435dcb9-fcc3-498c-936e-a2043acc75eb",
                                "sense_id": "5a362717-249f-3ab6-98e7-7a79b380c1d7",
                                "text": "Les entretiens d'embauche sont souvent mal vécues par les candidats qui, pour s'éviter des moments difficiles, préfèrent \"surpréparer\" leur oral, peut-être un peu trop."
                            },
                            {
                                "example_id": "277d6954-39be-4245-8d0e-579c5fa2600a",
                                "sense_id": "5a362717-249f-3ab6-98e7-7a79b380c1d7",
                                "text": "En cas d'incertitude sur un sujet, mieux vaut éviter le « Je verrai bien » et se surpréparer pour se sentir capable de l'aborder."
                            },
                            {
                                "example_id": "13feedd9-f014-4f99-8468-9e4980a3caa5",
                                "sense_id": "5a362717-249f-3ab6-98e7-7a79b380c1d7",
                                "text": "La plupart des gens ont tendance à se « surpréparer » pour être prêt à parler dans une langue étrangère le jour J."
                            }
                        ]
                    }
                ],
