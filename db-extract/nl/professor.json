                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c607b3e3-f4a2-4da3-8fb7-521f21e48207",
                        "source_entry_id": "6f265a82-43a8-35bf-9ebf-b27c9081201e",
                        "source_sense_id": "f373f21d-adc2-3495-9d71-85b40f98423f",
                        "source_sense_description": "de aanspreektitel voor een hoogleraar",
                        "target_lang_word": "Professor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Professor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c04e612c-8448-3004-b9fa-211b2f9a8f57",
                                        "entry_id": "529a4238-65f1-3824-9881-0078a296d18d",
                                        "glosses": [
                                            "Forscher und Lehrer an einer wissenschaftlichen Hochschule; Professoren können auch in leitenden Funktionen in Behörden mit Forschungseinrichtung oder außeruniversitären Forschungsorganisationen arbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba2874e-6385-408b-828c-401829b62b63",
                                                "sense_id": "c04e612c-8448-3004-b9fa-211b2f9a8f57",
                                                "text": "Zu den Dienstaufgaben von Professoren gehören in der Regel Forschung, Lehre und Mitarbeit in der Selbstverwaltung."
                                            },
                                            {
                                                "example_id": "219d4d4a-3ee1-45e4-8006-ccb5158a14e9",
                                                "sense_id": "c04e612c-8448-3004-b9fa-211b2f9a8f57",
                                                "text": "„Er stammt aus der Bibliothek von Professor Gomperz.“"
                                            },
                                            {
                                                "example_id": "5a337f36-c9f1-466a-9918-17e4935a1344",
                                                "sense_id": "c04e612c-8448-3004-b9fa-211b2f9a8f57",
                                                "text": "„Sie lernte August Wilhelm Schlegel kennen, der als Professor für Literatur und Kunstgeschichte an der neuen Bonner Universität tätig war.“"
                                            },
                                            {
                                                "example_id": "ca724e57-5630-46ab-b9e7-04e41643189e",
                                                "sense_id": "c04e612c-8448-3004-b9fa-211b2f9a8f57",
                                                "text": "„Der Professor lächelte fast mitleidig.“"
                                            },
                                            {
                                                "example_id": "8357359c-5db5-4847-b723-ee1f91ce74fc",
                                                "sense_id": "c04e612c-8448-3004-b9fa-211b2f9a8f57",
                                                "text": "„Auch ihre Mutter sprühte vor Lebendigkeit, las Bücher, lud Professoren, Politiker und Schauspieler ein und servierte ihnen üppige Mahle im Schein der Kerzen, während angeregt über Bücher und Geschehnisse in der Welt diskutiert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff73a360-aa02-360c-b4b8-8c3e1152a9b3",
                                        "entry_id": "529a4238-65f1-3824-9881-0078a296d18d",
                                        "glosses": [
                                            "Titel der Gymnasiallehrer in Österreich, auch (wie in Baden-Württemberg) ehrenhalber verliehen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca95545e-ded3-45d5-81da-27ff883dfe55",
                        "source_entry_id": "6f265a82-43a8-35bf-9ebf-b27c9081201e",
                        "source_sense_id": "f373f21d-adc2-3495-9d71-85b40f98423f",
                        "source_sense_description": "de aanspreektitel voor een hoogleraar",
                        "target_lang_word": "professor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "professor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0b57a77-fa24-3377-8438-7f18719ac2c1",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "The most senior rank for an academic at a university or similar institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ea57fb-d3a8-41b4-b595-e1014c6ea998",
                                                "sense_id": "d0b57a77-fa24-3377-8438-7f18719ac2c1",
                                                "text": "Professor is what you become after teaching for twenty to thirty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0648a193-f236-3033-a788-4dcaf0ee3e7d",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A teacher or faculty member at a college or university regardless of formal rank."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "One who professes something, such as a religious doctrine."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea142e1e-4d80-4c01-9aa9-f3933ce438cb",
                                                "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                                "text": "As for Religion, I have not said, much lesse meant irreverently of it, or of the Professors thereof."
                                            },
                                            {
                                                "example_id": "e57c59e7-843b-450b-a3df-4c1e37e6776e",
                                                "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                                "text": "This period in which Abraham the Jew lived was one in which Magic was almost universally believed in, and in which its Professors were held in honour;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f62efaa3-0e29-3770-bf4d-5efed6e7d063",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A practitioner, one who (publicly) practises or teaches an art or skill."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c450cb3-7bd8-4d6e-a247-9a1397da5f17",
                                                "sense_id": "f62efaa3-0e29-3770-bf4d-5efed6e7d063",
                                                "text": "Two young men of familiar acquaintance … were one euening at a common Inne of this town (as I haue heard) where the one of them shewed his skill on the Virginals, to the no little contentement of the hearers. Nowe as diuers guests of the house came into the room to listen, so among the rest entered an artificiall Conny-catcher, who as occasion serued, in the time of ceissing betweene the seueral toyes and fancies hee plaid: very much commended his cunning, quicke hand, and such qualities praiseworthy in such a professour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9026d2-0d41-3d55-ac18-8dde6b60ffd1",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A pianist in a saloon, brothel, etc."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42855727-aa29-4c32-a189-b66a89488d47",
                                                "sense_id": "cb9026d2-0d41-3d55-ac18-8dde6b60ffd1",
                                                "text": "You could hear [...] pianos under the hands of whorehouse professors sounding like they came with keys between the keys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f5f94d-4bc3-3ffd-b9e9-2c95655bb70e",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "The puppeteer who performs a Punch and Judy show; a Punchman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99293113-f85b-4307-ab3f-6fb6fb94bd55",
                        "source_entry_id": "6f265a82-43a8-35bf-9ebf-b27c9081201e",
                        "source_sense_id": "f373f21d-adc2-3495-9d71-85b40f98423f",
                        "source_sense_description": "de aanspreektitel voor een hoogleraar",
                        "target_lang_word": "professeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "professeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                        "entry_id": "4ced9ebe-ed2b-375e-9d70-5f0de80627be",
                                        "glosses": [
                                            "Personne qui enseigne une science ou un art, quel que soit le niveau : de l’enseignement primaire à l’université, ou en dehors d’une structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bd4980-d35d-4690-b7c2-13914974adb4",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "Ainsi, quoiqu’il y ait un grand nombre de femmes qui professent, qui gravent, qui composent, qui traduisent, etc., on ne dit pas : professeuse, graveuse, compositrice, traductrice, etc., mais bien professeur, graveur, compositeur, traducteur, etc., par la raison que ces mots n’ont été inventés que pour les hommes qui exercent ces professions."
                                            },
                                            {
                                                "example_id": "d1179e4f-b7b8-42f7-826f-d6e087304f88",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "L’abondante littérature idyllique des professeurs de rhétorique est évidemment une pure vanité."
                                            },
                                            {
                                                "example_id": "5bebce95-939e-48c3-b2e0-7fa3e3d02c46",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "La professeur jouait le rôle de mère, de guide, d’avocate, et en même temps elle devait s’occuper des élèves qui lui demandaient en bafouillant à qui ils devaient s’adresser pour avoir un permis de conduire ou comment obtenir un prêt pour acheter un téléviseur."
                                            },
                                            {
                                                "example_id": "9eab85d3-49af-4cd5-9679-21fabc26031f",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "Pas de revendications, ni d’interpellations ad nominem ^([sic : ad hominem]) : pendant une heure, le successeur de Jean-Michel Blanquer a nagé dans la bienveillance, passant d’un stand à un autre sans avoir à gérer le comportement imprévisible de professeurs insatisfaits, voire mécontents."
                                            },
                                            {
                                                "example_id": "90fd19f6-d225-4f1e-8508-3806c0c1ccd4",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "Une fois, par exemple, Guido a proposé à la professeur de latin de nous faire lire des livres entiers au lieu des habituels extraits bourrés de problèmes grammaticaux, pour que nous prenions un minimum de plaisir au travail de traduction."
                                            },
                                            {
                                                "example_id": "60de223c-9ab4-4b8d-83ae-f88b51282728",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "Professeur de philosophie, de mathématiques."
                                            },
                                            {
                                                "example_id": "229c1a0d-4e0d-40e6-b98a-2b5ea2335cb5",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "Lorsque le célèbre professeur prononce la brochette de mots « maladie orpheline, incurable, pour l'instant, et pas mortelle », j'ai l'impression qu'il fait un exposé à ses étudiants sans penser à l'impact de ses paroles sur l'être humain qui lui fait face."
                                            },
                                            {
                                                "example_id": "6a2aaacd-10b7-4f9d-8ddb-ac6bfe25b9e5",
                                                "sense_id": "3930eae4-4cfc-3d0f-93af-04babde72cb5",
                                                "text": "Je tiens à remercier Madame le Professeur Maryse BAUDREZ et Monsieur le doyen, le professeur Thierry DI MANNO, pour leur aide, ainsi que leur soutien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742041bb-688e-316e-8ad0-cd51c3d62a20",
                                        "entry_id": "4ced9ebe-ed2b-375e-9d70-5f0de80627be",
                                        "glosses": [
                                            "Titre obtenu à l’issue d’un cursus universitaire, permettant d’encadrer des recherches académiques et universitaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d9a3cc7-8883-435d-8b3e-193ec576000b",
                                                "sense_id": "742041bb-688e-316e-8ad0-cd51c3d62a20",
                                                "text": "Le professeur Léon Schwartzenberg vient d’annoncer que le célèbre imitateur souffre d’un cancer des voies respiratoires et que le traitement chimiothérapique l’oblige à annuler son spectacle au palais des Congrès, qui devait débuter la semaine prochaine à guichets fermés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d7d3f9-7279-3f8a-a1c6-ffeb3a4370e0",
                                        "entry_id": "4ced9ebe-ed2b-375e-9d70-5f0de80627be",
                                        "glosses": [
                                            "Personne qui professe une doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7af114-9af3-45e7-a625-d2c7ce17de0f",
                                                "sense_id": "17d7d3f9-7279-3f8a-a1c6-ffeb3a4370e0",
                                                "text": "Le poète doit être un professeur d’espérance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
