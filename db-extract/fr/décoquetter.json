                "senses": [
                    {
                        "sense_id": "c87d70e2-f55c-35de-a9d9-8c1ae4bd01ff",
                        "entry_id": "d4f13330-2fa7-3cbb-8f8f-768ce51c92e2",
                        "glosses": [
                            "Cesser d’user de coquetterie ou d’échanger des propos galants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29f3f6d-66c2-42c0-ab0d-7595bdace6ae",
                                "sense_id": "c87d70e2-f55c-35de-a9d9-8c1ae4bd01ff",
                                "text": "Esprit à gouverner, moins aisé qu’une mule, Votre raisonnement me tourne en ridicule, Et me fait à mon nez passer pour un oison ; Pour vous décoquetter, rentrez dans la maison."
                            },
                            {
                                "example_id": "504f9375-d8bb-472f-8ac6-ffd1f96a804b",
                                "sense_id": "c87d70e2-f55c-35de-a9d9-8c1ae4bd01ff",
                                "text": "Ou décoquettez-vous, ou, si nous sommes joints, Vous n’approcherez pas ma femme sans témoins, Ou vous vous laisserez tailler comme un eunuque"
                            }
                        ]
                    }
                ],
