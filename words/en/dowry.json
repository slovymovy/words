    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9d645a2-de55-39c3-9f61-c060b7f3c206",
                    "sense_definition": "Payment, such as property or money, paid by the bride's family to the groom or his family at the time of marriage.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "marriage_payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her parents saved for many years to provide a generous <w>dowry</w> for her wedding.",
                            "target_lang_translations": {
                                "ru": "Её родители копили много лет, чтобы обеспечить щедрое <w>приданое</w> к её свадьбе.",
                                "fr": "Ses parents ont économisé pendant de nombreuses années pour constituer une généreuse <w>dot</w> pour son mariage.",
                                "zh": "她的父母积攒了多年，为她的婚礼准备了一份丰厚的<w>嫁妆</w>。"
                            }
                        },
                        {
                            "text": "In the past, a woman without a <w>dowry</w> often found it difficult to arrange a suitable marriage.",
                            "target_lang_translations": {
                                "ru": "В прошлом женщине без <w>приданого</w> часто было трудно устроить подходящий брак.",
                                "fr": "Dans le passé, une femme sans <w>dot</w> avait souvent des difficultés à faire un mariage convenable.",
                                "zh": "在过去，没有<w>嫁妆</w>的女子往往很难找到一门合适的亲事。"
                            }
                        }
                    ],
                    "antonyms": [
                        "bride price",
                        "reverse dowry"
                    ],
                    "common_phrases": [
                        "pay a dowry",
                        "provide a dowry",
                        "large dowry",
                        "marriage dowry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата, такая как имущество или деньги, передаваемая семьей невесты жениху или его семье при вступлении в брак.",
                        "fr": "Biens, argent ou propriété apportés par la famille de la mariée au marié ou à sa famille lors du mariage.",
                        "zh": "结婚时由新娘家送给新郎或其家庭的财产、钱财等嫁妆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приданое",
                                "target_lang_sense_clarification": "имущество невесты"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "dot",
                                "target_lang_sense_clarification": "apport de la mariée ou de sa famille"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嫁妆",
                                "target_lang_sense_clarification": "娘家陪送的财物"
                            },
                            {
                                "target_lang_word": "陪嫁",
                                "target_lang_sense_clarification": "随嫁的财物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d9d370d-43b9-3333-b5b6-854c6ecdc241",
                    "sense_definition": "Payment made by the groom or his family to the bride's family.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "marriage_payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The anthropologist observed that the <w>dowry</w> was paid in cattle to the bride's father.",
                            "target_lang_translations": {
                                "ru": "Антрополог заметил, что <w>выкуп</w> отцу невесты выплачивался скотом.",
                                "fr": "L'anthropologue a observé que le <w>prix de la fiancée</w> était payé en bétail au père de la mariée.",
                                "zh": "人类学家观察到，这笔<w>彩礼</w>是用牛支付给新娘父亲的。"
                            }
                        },
                        {
                            "text": "Negotiations for the <w>dowry</w> took several weeks before the engagement was finalized.",
                            "target_lang_translations": {
                                "ru": "Переговоры о <w>выкупе</w> заняли несколько недель, прежде чем помолвка была окончательно оформлена.",
                                "fr": "Les négociations pour la <w>dot</w> ont duré plusieurs semaines avant que les fiançailles ne soient conclues.",
                                "zh": "关于<w>聘礼</w>的协商持续了数周，随后才最终敲定订婚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bride price",
                        "reverse dowry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата, вносимая женихом или его семьей семье невесты.",
                        "fr": "Paiement ou biens remis par le marié ou sa famille à la famille de la mariée.",
                        "zh": "结婚时由新郎或其家庭付给新娘家的彩礼或聘金。"
                    },
                    "translations": {
