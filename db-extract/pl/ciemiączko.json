                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c94cf9f-d87a-4e34-999b-efcf006ed328",
                                                "sense_id": "25c096e6-4665-3958-b11e-e0c81c0c549a",
                                                "text": "Αναφέρθηκε σε συμπεράσματα από άλλα πειράματα χωρίς να βάλει την πηγή."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8003a480-4fe9-3f85-95ce-749911bc6db3",
                                        "entry_id": "2e0baf2f-abdb-328e-9eae-8ee7311b4784",
                                        "glosses": [
                                            "source: ό,τι παράγει ήχο, φώς, ηλεκτρικό ρεύμα, κλπ."
                                        ],
