                "senses": [
                    {
                        "sense_id": "035534fd-966a-323e-979e-4d710bd79bf2",
                        "entry_id": "a54d5a45-bd7a-3277-ac10-de5b7b52cee6",
                        "glosses": [
                            "Orthographe ancienne de privilège, en usage avant la réforme orthographique française de 1878."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bdefc2ca-e5c3-4ddb-b6c7-e0e785eb7908",
                                "sense_id": "035534fd-966a-323e-979e-4d710bd79bf2",
                                "text": "Après avoir réclamé pour lui-même le privilége d’un vétéran, il confia la garde de la Thrace et de l’Hellespont à Gainas le Goth, et il donna à Léo, son favori, le commandement de l’armée d’Asie."
                            },
                            {
                                "example_id": "46c8ea61-d663-41ef-a3ef-d731ee050a1a",
                                "sense_id": "035534fd-966a-323e-979e-4d710bd79bf2",
                                "text": "Les priviléges d’un président de Cour d’assises sont-ils donc bien dignes d’envie ?"
                            },
                            {
                                "example_id": "33a6814f-fe0a-4bb7-ac14-e61bc062715a",
                                "sense_id": "035534fd-966a-323e-979e-4d710bd79bf2",
                                "text": "— Je ne ris pas souvent, monsieur, reprit l’inconnu, ainsi que vous pouvez le voir vous-même à l’air de mon visage ; mais je tiens cependant à conserver le privilége de rire quand il me plaît."
                            },
                            {
                                "example_id": "c81d44b9-1e1c-40ed-8235-7ce67e3a8faf",
                                "sense_id": "035534fd-966a-323e-979e-4d710bd79bf2",
                                "text": "Vital est un homme de trente à quarante ans, d’une jovialité primitive rentrée sous la pression de ses idées ambitieuses. Il jouit de cette moyenne taille, privilége des belles organisations."
                            }
                        ]
                    }
