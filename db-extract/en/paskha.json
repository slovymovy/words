                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e52e5f-6dfa-4dde-b451-3ea0fcce0b8a",
                                                "sense_id": "70fb3209-2dbd-3b5d-a4a2-f86419b7efa8",
                                                "text": "Nauczyciel pyta cię: Gdzie jest izba, w której mógłbym spożyć Paschę z moimi uczniami?"
