                        "target_lang_word": "наоборот",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "наоборот",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "70e8c571-7828-3eb9-8adf-e4210c14b22b",
                                        "entry_id": "6222f54e-0f5f-3fd2-b183-b5950da5882d",
                                        "glosses": [
                                            "обратной или противоположной стороной, с обратной или противоположной стороны"
                                        ],
                                        "tags": [
                                            "нареч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c496f0-6c1f-4b65-b562-5962271b2338",
                                                "sense_id": "70e8c571-7828-3eb9-8adf-e4210c14b22b",
                                                "text": "Надеть фуражку наоборот, козырьком назад."
                                            },
                                            {
                                                "example_id": "e19717e5-d95b-45bf-9ce5-6dac20247544",
                                                "sense_id": "70e8c571-7828-3eb9-8adf-e4210c14b22b",
                                                "text": "Надеть рубаху наоборот."
                                            },
                                            {
                                                "example_id": "db21865f-753d-4eef-bd6a-0c456191b23d",
                                                "sense_id": "70e8c571-7828-3eb9-8adf-e4210c14b22b",
                                                "text": "Читать наоборот."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dae2d5d-460f-3318-b90c-5c36974c7b26",
                                        "entry_id": "6222f54e-0f5f-3fd2-b183-b5950da5882d",
                                        "glosses": [
                                            "напротив, противоположно тому, что делалось, говорилось или ожидалось"
                                        ],
                                        "tags": [
                                            "вводн."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e0f15dd-8993-4f34-bc8a-5fbc23eaf382",
                                                "sense_id": "8dae2d5d-460f-3318-b90c-5c36974c7b26",
                                                "text": "Наоборот, он только обрадовался."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7990a807-1ec6-3bff-b7b4-5227093673c0",
                                        "entry_id": "6222f54e-0f5f-3fd2-b183-b5950da5882d",
                                        "glosses": [
                                            "употребляется как категорический отрицательный ответ — противоположно сказанному (в начале реплики)"
                                        ],
                                        "tags": [
                                            "частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1361eb38-7793-4a85-a37c-6d36d2176fec",
                                                "sense_id": "7990a807-1ec6-3bff-b7b4-5227093673c0",
                                                "text": "— Вам нездоровится? Наоборот, я совсем здоров."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4db05171-74a7-41ce-bf37-2f4ad5a7df82",
                        "source_entry_id": "8f18543f-1f92-329a-8984-82e2de2818ca",
                        "source_sense_id": "b72d4920-8391-3d6c-94b6-2ed84c87bf1c",
                        "source_sense_description": "Einleitung einer Entgegnung",
                        "target_lang_word": "напротив",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "напротив",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c03fec-b079-3a31-9ed8-b63f7828aedf",
                                        "entry_id": "424a5acd-0c28-39e9-bc7e-25256c2e1574",
                                        "glosses": [
                                            "непосредственно перед чем-кем-либо, лицом к лицу, на противоположной стороне кого-чего-нибудь"
                                        ],
                                        "tags": [
                                            "нареч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08981977-a8d9-44da-884c-1469361536a3",
                                                "sense_id": "a2c03fec-b079-3a31-9ed8-b63f7828aedf",
                                                "text": "Он живёт напротив."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2d7b377-26c7-3439-9d19-da706e316cc1",
                                        "entry_id": "424a5acd-0c28-39e9-bc7e-25256c2e1574",
                                        "glosses": [
                                            "редк., иначе, против, противореча, наперекор, назло"
                                        ],
                                        "tags": [
                                            "нареч.",
                                            "кому-чему или без доп."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1ec325-07a8-4932-a534-0b06cb0327ab",
                                                "sense_id": "e2d7b377-26c7-3439-9d19-da706e316cc1",
                                                "text": "Он все делает мне напротив."
                                            },
                                            {
                                                "example_id": "d1011730-667b-4f38-a975-7b5a681c557f",
                                                "sense_id": "e2d7b377-26c7-3439-9d19-da706e316cc1",
                                                "text": "Зачем же говорить напротив?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faaba3ca-f2e9-3849-8cce-12b6a1b31f2e",
                                        "entry_id": "424a5acd-0c28-39e9-bc7e-25256c2e1574",
                                        "glosses": [
                                            "наоборот, нет"
                                        ],
                                        "tags": [
                                            "вводн."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9cabbf9-1cbf-492f-b99f-4cb3c33740e8",
                                                "sense_id": "faaba3ca-f2e9-3849-8cce-12b6a1b31f2e",
                                                "text": "— Я вам мешаю? — Напротив, очень рад видеть вас."
                                            },
                                            {
                                                "example_id": "13d6ff7a-9a9d-48dd-839a-116b0f750fd1",
                                                "sense_id": "faaba3ca-f2e9-3849-8cce-12b6a1b31f2e",
                                                "text": "А между тем вышло совсем, совсем напротив."
                                            },
                                            {
                                                "example_id": "27cca695-e2fd-419e-a5b1-c630782e8817",
                                                "sense_id": "faaba3ca-f2e9-3849-8cce-12b6a1b31f2e",
                                                "text": "Не то, чтоб он был труслив и забит, совсем даже напротив."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7caec937-c8d3-379d-a659-8fadb554d816",
                                        "entry_id": "424a5acd-0c28-39e9-bc7e-25256c2e1574",
                                        "glosses": [
                                            "прямо перед"
                                        ],
                                        "tags": [
                                            "в знач. предлога с род. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ac694f-836f-4423-a859-452d012aea63",
                                                "sense_id": "7caec937-c8d3-379d-a659-8fadb554d816",
                                                "text": "Сидеть напротив кого-нибудь."
                                            },
                                            {
                                                "example_id": "14f9233b-3db5-4c42-b82d-f96cca118251",
                                                "sense_id": "7caec937-c8d3-379d-a659-8fadb554d816",
                                                "text": "Их дверь напротив нашей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6932990-e429-31af-9efa-498940bc0d38",
                                        "entry_id": "424a5acd-0c28-39e9-bc7e-25256c2e1574",
                                        "glosses": [
                                            "а наоборот, а даже"
                                        ],
                                        "tags": [
                                            "в знач. противительного союза"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f3c9b28-78c9-4f03-9d20-613fc8f35217",
                                                "sense_id": "f6932990-e429-31af-9efa-498940bc0d38",
                                                "text": "Он нисколько не рассердился, напротив, сам посмеялся шутке."
                                            },
                                            {
                                                "example_id": "067b84a5-6d75-49d6-89cf-de9e746f172d",
                                                "sense_id": "f6932990-e429-31af-9efa-498940bc0d38",
                                                "text": "— Против отца у меня не было никакого дурного чувства. Напротив, он как будто ещё вырос в моих глазах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
