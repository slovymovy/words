        "fr-extract.jsonl": [
            {
                "entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
                "word": "affabilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0a99122b-20dd-4334-9f92-fe6ae559ec51",
                        "entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "affabilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                        "entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
                        "glosses": [
                            "Qualité de celui qui reçoit, qui écoute et entretient avec bienveillance ceux qui s'adressent à lui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52c11aa9-0e09-481a-8339-d23357364785",
                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                "text": "Sa figure intelligente, dont les traits et le teint trahissaient une assez forte proportion de sang soudanais, […], sévère au repos, prenait par moments une expression de grande affabilité."
                            },
                            {
                                "example_id": "9ec6fa92-e451-4134-bab5-6b72fe724c58",
                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                "text": "Son visage à demi incliné, où la satisfaction le disputait au comme il faut, se plissait de petites rides d'affabilité."
                            },
                            {
                                "example_id": "b68e7c68-b2b1-4ce5-b4ee-ce714f4ff888",
                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                "text": "L’affabilité de la mère supérieure l'agaçait brusquement."
                            },
                            {
                                "example_id": "85275468-e71e-4220-afcd-92803a1be863",
                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                "text": "Il riait aussi volontiers que de bonne grâce et prodiguait autant d’affabilité pour la dernière des souillons que pour les plus grands seigneurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15d44a17-9d02-4db8-a39e-c3d55b25b09f",
                        "source_entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
                        "source_sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                        "target_lang_word": "graciousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graciousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df61ffe1-152a-3430-8c38-4b3f540ec8e8",
                                        "entry_id": "e82a15f6-48ff-3fe0-9fd5-40d29e3c958b",
                                        "glosses": [
                                            "The state of being gracious."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c78bb51-b99e-4f2a-97e3-3489166779c6",
                        "source_entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
                        "source_sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                        "target_lang_word": "affability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c87a74bc-5b5d-3094-a26b-77c3a735ae5e",
                                        "entry_id": "3241e5bf-05cd-36de-a238-b47ee5aee9d1",
                                        "glosses": [
                                            "The state or quality of being affable, friendly, or approachable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d99bf8-7f8a-414e-a1af-c0b7a6ffa468",
                                                "sense_id": "c87a74bc-5b5d-3094-a26b-77c3a735ae5e",
                                                "text": "O conspiracy,\nShamest thou to show thy dangerous brow by night,\nWhen evils are most free? O, then by day\nWhere wilt thou find a cavern dark enough\nTo mask thy monstrous visage? Seek none, conspiracy;\nHide it in smiles and affability:"
                                            },
                                            {
                                                "example_id": "f9813c75-ef36-46be-8b7b-14650c84f6ce",
                                                "sense_id": "c87a74bc-5b5d-3094-a26b-77c3a735ae5e",
                                                "text": "The Landlady […] was not without some Concern for the Confinement of poor Sophia, of whose great Sweetness of Temper and Affability the Maid of the House had made so favourable a Report, which was confirmed by all the Squire’s Servants […]"
                                            },
                                            {
                                                "example_id": "93eda81a-bdca-4fb7-89a9-48621a3039c6",
                                                "sense_id": "c87a74bc-5b5d-3094-a26b-77c3a735ae5e",
                                                "text": "[…] he would sometimes pass me haughtily and coldly, just acknowledging my presence by a distant nod or a cool glance, and sometimes bow and smile with gentlemanlike affability."
                                            },
                                            {
                                                "example_id": "97b9e474-d80b-4ac9-a94e-c62001b96488",
                                                "sense_id": "c87a74bc-5b5d-3094-a26b-77c3a735ae5e",
                                                "text": "He [Toussaint L'Ouverture] knew how to listen to a subordinate officer with dignity and yet with affability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1225f073-ccff-42ee-8dd1-3532db5ff3b2",
                        "source_entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
                        "source_sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                        "target_lang_word": "friendliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friendliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebfeb13d-e6dc-39bd-be40-e7fd311f4370",
                                        "entry_id": "3b894d40-4f89-3aef-b47f-a6c3d35dd893",
                                        "glosses": [
                                            "The quality of being friendly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf858cb5-3755-4129-9538-f86ce8e1e6d9",
                                                "sense_id": "ebfeb13d-e6dc-39bd-be40-e7fd311f4370",
                                                "text": "Finding us easy in our ways, he […] told me a cock-and-bull story with the moral of another five francs for the narrator. The thing was palpably absurd; but I paid up, and at once dropped all friendliness of manner, and kept him in his place as an inferior with freezing British dignity. He saw in a moment that he had gone too far, and killed a willing horse; his face fell; I am sure he would have refunded if he could only have thought of a decent pretext."
                                            },
                                            {
                                                "example_id": "4729bae4-bba7-4cd8-9378-6d552a100f91",
                                                "sense_id": "ebfeb13d-e6dc-39bd-be40-e7fd311f4370",
                                                "text": "To foreigners we often seem guileless and overchatty, an impression which is dispersed when they find that much of our friendliness is just the ebullition of the moment and does not carry with it any permanence of devotion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "701bb351-3f96-4ec0-b9bf-2289e993330e",
                        "source_entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
