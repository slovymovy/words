                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9c3ec21c-a0ce-39a2-910e-12f37d754303",
                        "entry_id": "52ded8e0-4a68-32ad-ad89-e6b6cd3f1cea",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f63d16-d3b2-4567-9990-3f84f44c82e7",
                                "sense_id": "9c3ec21c-a0ce-39a2-910e-12f37d754303",
                                "text": "„Ich gehe den Weg zurück zum Honda, steige ein und werfe den Aktenkoffer auf den Beifahrersitz.“"
                            },
                            {
                                "example_id": "cf52be90-2d11-4a31-b1ce-1d59978a28a9",
                                "sense_id": "9c3ec21c-a0ce-39a2-910e-12f37d754303",
                                "text": "„Gegen 10 Uhr 15 vormittags, etwa eine Viertelstunde nach dem verabredeten Termin für das Gespräch, kam Neil bei einem Frontalzusammenstoß zwischen seinem kleinen Honda und einem Lastwagen ums Leben.“"
                            },
                            {
                                "example_id": "57565ce6-2983-432e-a61c-2af4ce9f822e",
                                "sense_id": "9c3ec21c-a0ce-39a2-910e-12f37d754303",
                                "text": "„›Hier hat sich viel verändert, was?‹ fragte Sonny und trat das Gaspedal des Honda durch, um einen Kapalaran-Bus zu überholen.“"
                            },
                            {
                                "example_id": "6473d48b-c435-43bc-93d9-5abb36f3b5a3",
                                "sense_id": "9c3ec21c-a0ce-39a2-910e-12f37d754303",
                                "text": "„Sie manövrierte ihren Honda in eine Parklücke, schaltete die Zündung aus, stieg jedoch nicht gleich ab.“"
                            },
                            {
                                "example_id": "88fc0771-d9f2-4323-8a00-352d0ffa305a",
                                "sense_id": "9c3ec21c-a0ce-39a2-910e-12f37d754303",
                                "text": "„Als er auf die stechend riechende Straße vor Maria Vasquez’ Haus trat, erhaschte er einen kurzen Blick auf den grünen Honda.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
