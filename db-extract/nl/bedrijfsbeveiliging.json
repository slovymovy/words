                        "glosses": [
                            "afdeling van een bedrijf die betrokken is bij de veiligheid in dat bedrijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4601b816-3441-476e-b053-9d4227a341f5",
                                "sense_id": "71f9c2f9-9440-3914-99ef-0c95de2e5e89",
                                "text": "In pretpark De Efteling in Kaatsheuvel heeft de nieuwe attractie Baron 1898 last van een storing. De bezoekers zitten vast in de achtbaan en zijn er uitgehaald door de bedrijfsbeveiliging."
                            },
                            {
                                "example_id": "d7139861-901d-4847-963f-8d73534095a6",
                                "sense_id": "71f9c2f9-9440-3914-99ef-0c95de2e5e89",
                                "text": "Het vuur werd vanochtend vroeg ontdekt in het casino aan het Gedempte Kattendiep, in het oosten van de binnenstad. De bedrijfsbeveiliging probeerde de brand te blussen, maar toen dat niet lukte nam de brandweer het over. Rond 14.15 uur had de brandweer het vuur onder controle. Het nablussen gaat nog wel enige tijd duren."
                            }
                        ]
