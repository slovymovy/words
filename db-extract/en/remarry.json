                        "sense_id": "89ed6cf7-5cfa-38b3-ba22-2863087f3372",
                        "entry_id": "f9cab07e-6cbc-36e3-803b-083777b0ac60",
                        "glosses": [
                            "再婚"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "490f1353-c9ca-4228-a365-15a441d3c702",
                                "sense_id": "89ed6cf7-5cfa-38b3-ba22-2863087f3372",
                                "text": "After his wife's death, he never remarried.",
                                "translation": "妻子去世後，他沒有續弦。"
                            },
                            {
                                "example_id": "141500d1-71c1-46b3-85c4-f8b736cf5c00",
                                "sense_id": "89ed6cf7-5cfa-38b3-ba22-2863087f3372",
                                "text": "To everyone's surprise, after being divorced for ten years the couple eloped to Las Vegas and remarried.",
                                "translation": "令所有人惊讶的是，离婚十年后，这对夫妇私奔到拉斯维加斯并复婚。"
                            },
                            {
                                "example_id": "79eb57c3-d8ce-41c5-a463-81ea57f9d707",
                                "sense_id": "89ed6cf7-5cfa-38b3-ba22-2863087f3372",
                                "text": "This church will remarry widows or widowers, but not divorcés.",
                                "translation": "這座教堂給寡婦、鰥夫辦結婚儀式，但不為離婚的人舉行。"
                            }
                        ]
                    }
