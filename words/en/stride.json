                    "common_phrases": [
                        "stride piano"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种爵士钢琴风格，左手以跳跃的节奏演奏。",
                        "ru": "Стиль джазовой фортепианной игры с ритмичным рисунком левой руки.",
                        "cs": "Styl jazzové hry na klavír s rytmickým vzorem v levé ruce."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跨步爵士乐",
                                "target_lang_sense_clarification": "一种特定的爵士钢琴演奏风格。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "страйд",
                                "target_lang_sense_clarification": "джазовый стиль игры на фортепиано"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "stride",
                                "target_lang_sense_clarification": "jazzový klavírní styl"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f2737b6-1377-332b-b862-8f0b6fa6c9c2",
                    "sense_definition": "The number of memory locations between successive elements in a data structure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The image processing algorithm requires a specific <w>stride</w> for the bitmap.",
                            "target_lang_translations": {
                                "zh": "图像处理算法要求位图具有特定的<w>步长</w>。",
                                "ru": "Алгоритм обработки изображений требует определенного <w>шага</w> для растрового изображения.",
                                "cs": "Algoritmus pro zpracování obrazu vyžaduje pro bitmapu specifický <w>krok</w>."
                            }
                        },
                        {
                            "text": "Adjusting the <w>stride</w> can improve memory access performance.",
                            "target_lang_translations": {
                                "zh": "调整<w>步长</w>可以提高内存访问性能。",
                                "ru": "Настройка <w>шага</w> может улучшить производительность доступа к памяти.",
                                "cs": "Úprava <w>kroku</w> může zlepšit výkon přístupu do paměti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "memory stride"
                    ],
                    "target_lang_definitions": {
                        "zh": "数据结构中相邻元素之间的内存地址间隔。",
                        "ru": "Количество ячеек памяти между последовательными элементами в структуре данных.",
                        "cs": "Počet paměťových míst mezi po sobě jdoucími prvky v datové struktuře."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "步长",
                                "target_lang_sense_clarification": "计算机科学中指内存访问的间隔。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "интервал между элементами в памяти"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "krok",
                                "target_lang_sense_clarification": "interval v paměti"
                            },
                            {
                                "target_lang_word": "stride",
                                "target_lang_sense_clarification": "odborný termín v informatice"
                            }
                        ]
                    }
                }
            ]
        },
