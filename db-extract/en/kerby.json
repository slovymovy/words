            {
                "entry_id": "982976c4-e4df-3e3f-8213-1b42eb756287",
                "word": "kerby",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "908f0b38-2b3a-3f43-8bdf-5a3b0dae336a",
                        "entry_id": "982976c4-e4df-3e3f-8213-1b42eb756287",
                        "glosses": [
                            "A children's ball game played in the street, the aim being to throw the ball against the opposite kerb and catch it on the rebound."
                        ],
                        "tags": [
                            "UK",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "621a8738-7974-42bf-9e9d-3a40fb4dc454",
                                "sense_id": "908f0b38-2b3a-3f43-8bdf-5a3b0dae336a",
                                "text": "It's dusk and there are a lot of kids out playing kerby and tag and football. For a December night, the weather isn't bad."
                            },
                            {
                                "example_id": "d3942444-db3b-4fb7-bba2-bcb61d00cdf3",
                                "sense_id": "908f0b38-2b3a-3f43-8bdf-5a3b0dae336a",
                                "text": "I'd play kerby in the street for hours looking up at contrails stretching across grey slate skies, wishing I was on a plane too, jetting away to somewhere else."
                            },
                            {
                                "example_id": "dbd236dd-aa05-4898-a44a-a938db817275",
                                "sense_id": "908f0b38-2b3a-3f43-8bdf-5a3b0dae336a",
                                "text": "The heat from the tarmac refracted the light and disturbed the vision of the children as they persisted in their game of kerby."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
