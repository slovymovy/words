                "senses": [
                    {
                        "sense_id": "49a754d0-a303-31c4-8b18-3ed9e198d257",
                        "entry_id": "fb170c69-ecda-3def-a742-83bd1fc6d708",
                        "glosses": [
                            "jemand, der (beruflich) Jazzmusik spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a6bb37-a430-4785-b312-22d4333d43eb",
                                "sense_id": "49a754d0-a303-31c4-8b18-3ed9e198d257",
                                "text": "Miles Davis war ein weltbekannter Jazzmusiker."
                            },
                            {
                                "example_id": "350a2f45-9524-4b84-97a0-095e88abbebc",
                                "sense_id": "49a754d0-a303-31c4-8b18-3ed9e198d257",
                                "text": "„Kein anderes Werk eines Jazzmusikers ist in seiner Entwicklung vergleichbar vielschichtig und abwechslungsreich wie das von Miles Davis.“"
                            },
                            {
                                "example_id": "030dcf9e-ec1b-461e-8340-c8c7955f8961",
                                "sense_id": "49a754d0-a303-31c4-8b18-3ed9e198d257",
                                "text": "„Es gab sogar Clubs, die Afroamerikanern'gehörten und wo schwarze Jazzmusiker eine musikalische Heimat fanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
