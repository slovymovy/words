                "translations": [
                    {
                        "translation_id": "70387982-75a0-4e4c-ae46-e18a485a20e9",
                        "source_entry_id": "7db06efd-feea-3417-b92f-ac502e740d51",
                        "source_sense_description": "свойство характера",
                        "target_lang_word": "truthfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truthfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1ad9bda-c81b-331d-9c36-e8e4e729ec07",
                                        "entry_id": "31eafc2b-bbed-3428-bd9c-9085e8980f30",
                                        "glosses": [
                                            "The quality of being truthful"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee34dc49-3862-4889-b738-3ec2bce2edf0",
                                                "sense_id": "c1ad9bda-c81b-331d-9c36-e8e4e729ec07",
                                                "text": "Many hard-working students, alive to the deficiencies of this kind of romance-writing, have grown to distrust not only all historical writing that is romantic, but all historical writing that is vivid. They feel that complete truthfulness must never be sacrificed to color."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bdff310-694e-4cdd-aa8e-9a3acff70ee9",
                        "source_entry_id": "7db06efd-feea-3417-b92f-ac502e740d51",
                        "source_sense_description": "свойство характера",
                        "target_lang_word": "uprightness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uprightness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7971487-4c69-372d-bbe2-26f8f34c8b74",
                                        "entry_id": "8ff20714-ee9e-3716-864f-5748e5cdf687",
                                        "glosses": [
                                            "The state of being honest, honourable, and moral."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15daf465-3697-4947-982c-49a826d328f8",
                                                "sense_id": "a7971487-4c69-372d-bbe2-26f8f34c8b74",
                                                "text": "You are responsible only for your own uprightness. See to that and all else will take care of itself. - Miles Williams Mathis"
                                            },
                                            {
                                                "example_id": "00214b5a-559f-4c07-b655-9e3193b2e93b",
                                                "sense_id": "a7971487-4c69-372d-bbe2-26f8f34c8b74",
                                                "text": "[S]uch as therefore ſhould not be adventured vpon vvithout mature and vnpartiall diſquiſition of the vprightneſſe of our affections therein, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b43369bd-24bf-31dc-a77d-eea4f7e45096",
                                        "entry_id": "8ff20714-ee9e-3716-864f-5748e5cdf687",
                                        "glosses": [
                                            "The state of being erect or vertical."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51951c9e-1138-4be7-bc49-bfc36b8169f2",
                                                "sense_id": "b43369bd-24bf-31dc-a77d-eea4f7e45096",
                                                "text": "It is singular how forcibly this passage in my narrative brings to my mind a picture which used to be, some years ago, at a broker's—that charnel-house of the comforts and graces of life. It had been taken out of its frame, and leant in a dark and dusty corner against a perpendicular armchair, whose rigid uprightness seemed suited only to the parlour of a dentist, repose being the last idea it suggested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7991116-066d-30ee-836d-97cc2e6125c7",
                                        "entry_id": "8ff20714-ee9e-3716-864f-5748e5cdf687",
                                        "glosses": [
                                            "The product or result of being upright."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ea10251-4caf-45f9-908b-3d3f157682ec",
                        "source_entry_id": "7db06efd-feea-3417-b92f-ac502e740d51",
                        "source_sense_description": "свойство характера",
                        "target_lang_word": "honesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "The act, quality, or condition of being honest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4624d23-fd06-4138-a1ed-2b4235cd29bd",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "academic / artistic / emotional / intellectual honesty"
                                            },
                                            {
                                                "example_id": "28a4c0d2-e815-4417-98bd-d99cd49c90a1",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "brutal / devastating / searing honesty"
                                            },
                                            {
                                                "example_id": "da12768b-a5e1-49c3-9a8f-780441a2eae0",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "There’s no trust, / No faith, no honesty in men; all perjured, / All forsworn, all naught, all dissemblers."
                                            },
                                            {
                                                "example_id": "3e75e1cb-2086-4789-baa9-c802ae305533",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "1787, George Colman, Junior, Inkle and Yarico, London: G.G.J. & J. Robinson, Act 2, p. 45,\nO give me your plain dealing Fellows\nWho never from honesty shrink;\nNot thinking on all they shou’d tell us,\nBut telling us all that they think."
                                            },
                                            {
                                                "example_id": "92a4bd1c-8abf-4ced-b7f9-f27347896b62",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "[…] Are you honest, boy? / Then be not spendthrift of your honesty, / But keep it to yourself; in Padua / Men think that honesty is ostentatious, so / It is not of the fashion."
                                            },
                                            {
                                                "example_id": "2aa4285a-cb24-4c72-a4c8-3f74a6d24289",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "To those who knew her and to the greatly enlarged circle who were electrified by her last poems and sudden death, she had come to signify the specific honesties and risks of the poet’s condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Honor; decency, propriety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02012f49-789c-40fc-ba29-63f2420e14ec",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "Have ye no wit, manners, nor honesty, but to gabble like tinkers at this time of night?"
                                            },
                                            {
                                                "example_id": "dc6092e2-0f95-4858-8843-ff0301c35d90",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "Fellovves in armes faithfull and valiant, / I thanke you for your paines and honeſties, […]"
                                            },
                                            {
                                                "example_id": "49ba45f2-5759-45ea-9e80-dbb5c1a7444a",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "[…] that we may lead a quiet and peaceable life in all godliness and honesty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Chastity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8045188-c6bf-4549-935e-2749d4b8e2f7",
                                                "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                                "text": "[…] spend all I have; only give me so much of your time in exchange of it, as to lay an amiable siege to the honesty of this Ford’s wife […]"
                                            },
                                            {
                                                "example_id": "29be6351-5bf4-470c-8105-a647778c1529",
                                                "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                                "text": "c. 1625, John Fletcher, The Fair Maid of the Inn, Act V, Scene 1, in Alexander Dyce (editor), The Works of Beaumont and Fletcher, New York: Appleton, 1890, Volume 2, p. 669,\n[…] Oh, these vild women,\nThat are so ill preservers of men’s honours,\nThey cannot govern their own honesties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Any of various crucifers in the genus Lunaria, several of which are grown as ornamentals, particularly annual honesty (Lunaria annua)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89822d94-5d5a-4824-8f57-123216c31c54",
                                                "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                                "text": "Various measures were taken to avoid it, most popular being the suspension of certain herbs and tree branches over the doorways of dwellings and stables. Commonly used greenery were tansy, honesty, garlic, St. John's Wort, mountain ash, roadside verbena."
                                            },
                                            {
                                                "example_id": "d135cff8-2a6f-438a-aa8b-ed5f8ab09c62",
                                                "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                                "text": "She thought a minute, then stepped nimbly back into her cottage; and what she came out with at last was, a sprig of dry leaves, round as shillings, white as paper, quivering on a few thin stalks that looked ready to snap. / It was honesty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2d0f32f-41d3-4b77-8567-3d793dd0a19f",
                        "source_entry_id": "7db06efd-feea-3417-b92f-ac502e740d51",
                        "source_sense_description": "соответствие истине, достоверность",
                        "target_lang_word": "credibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "credibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                        "entry_id": "5a537695-5ce3-3508-904d-74b519161e01",
                                        "glosses": [
                                            "Reputation impacting one's ability to be believed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c9457ab-03e0-43e2-b347-998d4fafc1c4",
                                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                                "text": "After weeks of blowing smoke, her credibility with me was next to nil."
                                            },
                                            {
                                                "example_id": "8e4ca38b-7e25-4ebd-b8cc-0bcc028dbaa8",
                                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                                "text": "The inability of Trump's own spokespeople to speak authoritatively on the president's thinking and actions -- a challenge even Trump himself has acknowledged -- has left the White House with an enormous credibility gap, and has tarnished the reputations of many of its most visible spokespeople."
                                            },
                                            {
                                                "example_id": "786c593d-a49d-4782-aa56-e7b580c1422c",
                                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                                "text": "The 'partygate' controversy has played a major part in undermining the credibility of Boris Johnson and his Government and has led to calls from senior MPs for him to resign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6041b0c-5678-3995-8a47-649ed634ce01",
                                        "entry_id": "5a537695-5ce3-3508-904d-74b519161e01",
                                        "glosses": [
                                            "Believability of statements by a witness, as measured by whether the testimony is probable or improbable when judged by common experience."
