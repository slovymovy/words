                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "garçon",
                                "target_lang_sense_clarification": "Enfant ou adolescent masculin."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8c334e2-e644-3fde-aef0-8a6430c9323b",
                    "sense_definition": "сын",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <w>мальчик</w> уже закончил университет и работает.",
                            "target_lang_translations": {
                                "en": "Our <w>boy</w> has already finished university and is working.",
                                "de": "Unser <w>Junge</w> hat bereits die Universität abgeschlossen und arbeitet.",
                                "pl": "Nasz <w>chłopak</w> skończył już uniwersytet i pracuje.",
                                "fr": "Notre <w>garçon</w> a déjà fini l'université et travaille."
                            }
                        },
                        {
                            "text": "Родители очень гордятся своим <w>мальчиком</w>.",
                            "target_lang_translations": {
                                "en": "Parents are very proud of their <w>boy</w>.",
                                "de": "Die Eltern sind sehr stolz auf ihren <w>Jungen</w>.",
                                "pl": "Rodzice są bardzo dumni ze swojego <w>chłopca</w>.",
                                "fr": "Les parents sont très fiers de leur <w>fils</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сын"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A son (colloquial).",
                        "de": "Ein Sohn (umgangssprachlich).",
                        "pl": "Syn (często z czułością, potocznie).",
                        "fr": "Fils (usage familier ou affectueux)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boy",
                                "target_lang_sense_clarification": "A son of any age, often used affectionately."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Junge",
                                "target_lang_sense_clarification": "Umgangssprachliche, oft liebevolle Bezeichnung für einen Sohn."
                            }
                        ],
                        "pl": [
