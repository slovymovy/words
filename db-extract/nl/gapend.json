                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gaping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3044417-9c1b-3369-9e0c-a3a3d8737482",
                                        "entry_id": "1a697283-e7ca-3844-a3b8-676a3484c0e4",
                                        "glosses": [
                                            "Wide open."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df0a381-087b-45ba-ad65-ae2639866178",
                                                "sense_id": "c3044417-9c1b-3369-9e0c-a3a3d8737482",
                                                "text": "There’s a gaping hole in the fence."
                                            },
                                            {
                                                "example_id": "cf4bb8e8-5ba4-4091-8d23-83fda13bc53e",
                                                "sense_id": "c3044417-9c1b-3369-9e0c-a3a3d8737482",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dbcdd86-bfa4-3573-8c5b-d98404124c98",
                                        "entry_id": "1a697283-e7ca-3844-a3b8-676a3484c0e4",
                                        "glosses": [
                                            "Having the jaw wide open, as in astonishment or stupefaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425d3c02-c7b8-4677-b520-0ff5e643a4c4",
                                                "sense_id": "2dbcdd86-bfa4-3573-8c5b-d98404124c98",
                                                "text": "The men who stood behind the scenes and worked the religious puppet-show by hidden wires to the awe and astonishment of the gaping vulgar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d97d17a-517f-3649-8631-96d3191daad8",
                                        "entry_id": "6c381c2f-b7b0-3e7a-831f-66d790db53d3",
                                        "glosses": [
                                            "The act of one who gapes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2b9ebc-98e8-4ff8-b0db-258348e45ca1",
                                                "sense_id": "8d97d17a-517f-3649-8631-96d3191daad8",
                                                "text": "M. Le Gallois considers these gapings, which continue for some time after decapitation, as the vain efforts of the head for respiration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc3b12ff-f862-3aca-940c-f2c0ab3b3231",
                                        "entry_id": "6c381c2f-b7b0-3e7a-831f-66d790db53d3",
                                        "glosses": [
                                            "Something gaping; something agape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2778760-7374-38cd-9d0f-0e727b2142e2",
                                        "entry_id": "6c381c2f-b7b0-3e7a-831f-66d790db53d3",
                                        "glosses": [
                                            "A threat or courtship behavior in animals involving holding the mouth open and displaying the teeth or other interior features."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52cd3195-9f95-4101-b32e-2712fbe3f810",
                        "source_entry_id": "0b4d9a25-ae63-37af-8408-d3c2a40dff11",
                        "source_sense_id": "8c5df3e0-39b2-34f7-9d2d-ff547618dae3",
                        "source_sense_description": "wijd openstaand",
                        "target_lang_word": "huge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8fa5a1-a8d4-44db-9d3c-6cb00ee94896",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera,[…]the chlorotic squatters on huge yachts,[…]the neurotic victims of mental cirrhosis, the jewelled animals whose moral code is the code of the barnyard—!”"
                                            },
                                            {
                                                "example_id": "756a1c7a-cb79-452a-8b00-709ce8431997",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                                            },
                                            {
                                                "example_id": "2d21e2b2-f460-4cf6-99f0-c7c69240bf45",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df94a0a2-df36-3de4-b4c2-0b5c9f6ea90c",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very strong, powerful, or dedicated."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70c4504b-e424-4a9b-b81a-764fa7012faa",
                                                "sense_id": "df94a0a2-df36-3de4-b4c2-0b5c9f6ea90c",
                                                "text": "Both of my parents are huge supporters of animal rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very interesting, significant, or popular."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3a2e1e-cbba-4939-bc35-1d53dc32c905",
                                                "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                                "text": "The band's next album is going to be huge."
                                            },
                                            {
                                                "example_id": "be4fa9d9-f27c-4d6c-ae72-8a73a776af17",
                                                "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                                "text": "In our league our coach is huge!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
