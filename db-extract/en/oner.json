                        "examples": []
                    },
                    {
                        "sense_id": "c127a004-b12f-39f3-98e1-313fd6aa251e",
                        "entry_id": "d75de927-4b84-36c2-83d7-2652b9293a65",
                        "glosses": [
                            "A small marble of little worth in children's games."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fdb59e4-8a2e-4c34-8cb7-7a098ba96a2f",
                                "sense_id": "c127a004-b12f-39f3-98e1-313fd6aa251e",
                                "text": "The winner was the last to flick a marble into the gully. A oner had to beat a fourer four times to win, a fourer had to beat a twelver three times, and so on."
                            }
                        ]
                    },
                    {
                        "sense_id": "033f8059-325d-3158-bc20-0082f69288b0",
                        "entry_id": "d75de927-4b84-36c2-83d7-2652b9293a65",
                        "glosses": [
                            "A conker that has won one match."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "a6270191-04fa-4d41-b555-8e8accf4aa9d",
                                "sense_id": "033f8059-325d-3158-bc20-0082f69288b0",
                                "text": "May all your conkers be oners / May your love life fail with dishonours"
                            },
                            {
                                "example_id": "cba43e62-f39f-490b-b4f9-c258842c8f15",
                                "sense_id": "033f8059-325d-3158-bc20-0082f69288b0",
                                "text": "The history of 'oners' becoming 'sixers' through successive victories[…]"
                            },
                            {
                                "example_id": "d994459b-2aec-48b2-800b-abb4bedd1ba8",
                                "sense_id": "033f8059-325d-3158-bc20-0082f69288b0",
                                "text": "Conkers so highly prized that it's a wonder they even manage to hit the ground before being swept away to be pickled or baked and then going on to new careers as 'oners', 'twoers', and so forth."
                            }
                        ]
                    },
                    {
                        "sense_id": "468ed649-4a1b-338b-931f-a3ccbd506380",
                        "entry_id": "d75de927-4b84-36c2-83d7-2652b9293a65",
                        "glosses": [
                            "A long one-take shot, or equivalent animated segment simulating a one-take shot"
