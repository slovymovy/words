            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "ccd38242-f1bd-3dcc-9271-fbcd3c9a36b2",
                    "sense_definition": "Следующий за первым по счёту, порядку или времени.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "order_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя квартира находится на <втором> этаже этого дома.",
                            "target_lang_translations": {
                                "en": "My apartment is on the <second> floor of this building.",
                                "zh": "我的公寓在这栋楼的<w>第二</w>层。"
                            }
                        },
                        {
                            "text": "Это уже <второй> раз, когда мы встречаемся на этой неделе.",
                            "target_lang_translations": {
                                "en": "This is already the <second> time we are meeting this week.",
                                "zh": "这是我们这周<w>第二</w>次见面了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "первый"
                    ],
                    "common_phrases": [
                        "второй этаж",
                        "второй раз",
                        "второе место",
                        "вторая половина дня",
                        "вторая мировая война"
                    ],
                    "target_lang_definitions": {
                        "en": "Coming after the first in count, order, or time.",
                        "zh": "在计数、顺序或时间上排在第一位之后。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "second",
                                "target_lang_sense_clarification": "ordinal number"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第二",
                                "target_lang_sense_clarification": "序数词，表示顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dcc0563-0f13-3a8a-a298-7986587f13e4",
                    "sense_definition": "Обозначение времени текущего часа, следующего за первым часом дня или ночи (используется с предлогами или для указания половины часа).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы договорились встретиться в половине <второго> у метро.",
                            "target_lang_translations": {
                                "en": "We agreed to meet at half past <one> by the subway.",
                                "zh": "我们约好在<w>一点</w>半在地铁站见面。"
                            }
                        },
                        {
                            "text": "Сейчас начало <второго>, мы ещё успеваем пообедать.",
                            "target_lang_translations": {
                                "en": "It is just past <one>, we still have time to have lunch.",
                                "zh": "现在刚过<w>一点</w>，我们还来得及吃午饭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "половина второго",
                        "начало второго",
                        "пятнадцать минут второго"
                    ],
                    "target_lang_definitions": {
                        "en": "Designating the time of the current hour, following the first hour of the day or night (used in phrases like 'half past one').",
                        "zh": "指代当前小时之后的一小时（用于表示时间，如一点半）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "second",
                                "target_lang_sense_clarification": "referring to the hour between 1:00 and 2:00"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "指代一点到两点之间的时间段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73e1cf2f-913b-3bfd-9d50-ce6a2d684e60",
                    "sense_definition": "Ещё один, появляющийся или совершаемый снова; подобный первому.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У спортсмена открылось <второе> дыхание, и он ускорил бег.",
                            "target_lang_translations": {
                                "en": "The athlete got a <second> wind and sped up.",
                                "zh": "运动员恢复了<w>第二</w>口气，加快了速度。"
                            }
                        },
                        {
                            "text": "Каждый человек заслуживает <второй> шанс исправить свои ошибки.",
                            "target_lang_translations": {
                                "en": "Every person deserves a <second> chance to fix their mistakes.",
                                "zh": "每个人都值得拥有<w>第二</w>次机会来改正错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "другой",
                        "дополнительный",
                        "ещё один"
                    ],
                    "common_phrases": [
                        "второе дыхание",
                        "второй шанс",
                        "вторая молодость"
                    ],
                    "target_lang_definitions": {
