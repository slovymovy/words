                        "entry_id": "25336eef-5307-3872-96da-5effc938c153",
                        "glosses": [
                            "Peur, phobie de ce qui est élevé, de ce qui est en hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be818a74-9703-44f8-8676-9e13fbe67ae0",
                                "sense_id": "ed98e12e-1bb8-3e4d-94cb-953749e7ccee",
                                "text": "Par ailleurs, la plupart des volontaires étaient atteints d’acrophobie depuis au moins une trentaine d’années !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16bfb476-8e90-43aa-abcc-7089739fdc15",
                        "source_entry_id": "25336eef-5307-3872-96da-5effc938c153",
                        "source_sense_id": "ed98e12e-1bb8-3e4d-94cb-953749e7ccee",
                        "source_sense_description": "Phobie de ce qui est en hauteur",
                        "target_lang_word": "Akrophobie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akrophobie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea524ad-f303-3f63-950f-8bf84e7748f6",
                                        "entry_id": "a48a988b-2e26-3c2f-a35e-794e620bba7c",
                                        "glosses": [
                                            "Angst vor der Höhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e43932-0a6f-468d-8f07-5c27581cc0f0",
                                                "sense_id": "1ea524ad-f303-3f63-950f-8bf84e7748f6",
                                                "text": "Dass viele Menschen unter Akrophobie leiden, ist ein Grund für die niedrigeren Passagierzahlen bei Fluggesellschaften."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18cd3bcd-15e7-4dec-b815-7d5e20b0ab4f",
                        "source_entry_id": "25336eef-5307-3872-96da-5effc938c153",
                        "source_sense_id": "ed98e12e-1bb8-3e4d-94cb-953749e7ccee",
                        "source_sense_description": "Phobie de ce qui est en hauteur",
                        "target_lang_word": "acrophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                        "entry_id": "3242a50d-4540-3c34-88d9-030d16bde90d",
                                        "glosses": [
                                            "phobia or strong fear of being high above ground level"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "000c0f11-31bf-4da0-b1e4-23f1c39aee71",
                                                "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                                "text": "You know, being elevated to the position of Chairman has given me rather a bad attack of acrophobia."
                                            },
                                            {
                                                "example_id": "347f36b9-4eac-4d63-b94e-3f76fcdbe663",
                                                "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                                "text": "But it's no place for anyone with acrophobia, what with its myriad drop-offs and switchbacks."
                                            },
                                            {
                                                "example_id": "468da335-1d5d-43e8-9c1c-dbdaa5a79512",
                                                "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                                "text": "You know, acrophobia? I get nervous just standing this close to the edge."
                                            },
                                            {
                                                "example_id": "d75d08af-1f93-4c1d-aeef-cde34ae395e5",
                                                "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                                "text": "Acrophobia describes an intense fear of heights that can cause significant anxiety and panic."
                                            },
                                            {
                                                "example_id": "16c8923d-481b-49b9-83fc-b096446e5a7d",
                                                "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                                "text": "The definition of acrophobia is, simply put, a phobia of heights."
                                            },
                                            {
                                                "example_id": "e8fc8951-3d58-4231-9c34-9da71899bc3f",
                                                "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                                "text": "Acrophobia is an intense fear of heights. If a person has acrophobia, being high up or thinking about heights may cause them to have a panic attack."
                                            },
                                            {
                                                "example_id": "476be34f-ff1b-402d-98dd-2de94a55fd2e",
                                                "sense_id": "9fd7d6fd-c792-336a-a6cd-a94f0ef8f261",
                                                "text": "Acrophobia is a persistent and intense fear of heights. People with acrophobia will experience panic and sudden anxiety in a variety of situations involving heights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
