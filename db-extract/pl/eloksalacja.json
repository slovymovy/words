                    {
                        "translation_id": "49b282cd-da48-481b-9a25-e6a3b5811ff8",
                        "source_entry_id": "28580631-ae1b-37ac-a0e6-51715b1dbf2b",
                        "source_sense_id": "ad830935-1dfb-3cc1-b56b-a7f35a33b100",
                        "target_lang_word": "treatment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treatment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5170d31-c668-3df7-bc4e-f2fa60d4ccce",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "The process or manner of treating someone or something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd3d4cb6-5ca9-4204-9ecf-e3216ac4a734",
                                                "sense_id": "a5170d31-c668-3df7-bc4e-f2fa60d4ccce",
                                                "text": "He still has nightmares resulting from the abusive treatment he received from his captors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "Medical care for an illness or injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f4b971-68cd-43ef-b98f-3520290a22a3",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "A treatment or cure is applied after a medical problem has already started."
                                            },
                                            {
                                                "example_id": "c4f9a85e-08ec-4d5c-a10b-919c261c8306",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "Cancer survivors who got radiation treatments as children have nearly twice the risk of developing diabetes as adults."
                                            },
                                            {
                                                "example_id": "7b3d26e4-3a3f-44db-b568-d52cb57f084b",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "The change is due largely to the increased availability of antiretroviral treatment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e052ea-6bfc-3f2e-980d-35dbeeb79dca",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "The use of a substance or process to preserve or give particular properties to something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1b92c1d-f164-3a4e-b3a6-f49c9cc5faaf",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "A treatise; a formal written description or characterization of a subject."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4c68f8-42e2-42db-9296-faa3464f8d6b",
                                                "sense_id": "b1b92c1d-f164-3a4e-b3a6-f49c9cc5faaf",
                                                "text": "Firstly, I continue to base most species treatments on personally collected material, rather than on herbarium plants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a50667-6da3-3037-bcd8-3c3a9950ef02",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "A brief, third-person, present-tense summary of a proposed film."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f2ea36c-785b-332a-838e-0f14d612baa6",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "entertainment; treat"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49c6d1f4-c7f2-4de2-bbfd-e8819c451146",
                                                "sense_id": "4f2ea36c-785b-332a-838e-0f14d612baa6",
                                                "text": "Accept such treatment as a swain affords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40466a1b-4477-329d-b903-3b5ed9164c35",
                                        "entry_id": "8f982a31-bc10-324f-86fa-9e109b706554",
                                        "glosses": [
                                            "harsh punishment; retribution"
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e12bff6a-3832-47dc-b9a9-3f35ea793297",
                                                "sense_id": "40466a1b-4477-329d-b903-3b5ed9164c35",
                                                "text": "He’s been a naughty boy, so give him a good treatment."
                                            },
                                            {
                                                "example_id": "52a4e5f0-9d14-4185-b04a-89b8dc0c126e",
                                                "sense_id": "40466a1b-4477-329d-b903-3b5ed9164c35",
                                                "text": "Even if you supported the socialist regime, your class background often meant you were going to get the treatment regardless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b21030-fdad-4ed6-98e8-95f165e6b0d1",
                        "source_entry_id": "28580631-ae1b-37ac-a0e6-51715b1dbf2b",
                        "source_sense_id": "ad830935-1dfb-3cc1-b56b-a7f35a33b100",
                        "target_lang_word": "eloxal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "deed6558-f01c-4a11-90ee-d296225b0828",
                        "source_entry_id": "28580631-ae1b-37ac-a0e6-51715b1dbf2b",
                        "source_sense_id": "ad830935-1dfb-3cc1-b56b-a7f35a33b100",
                        "target_lang_word": "process",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "process",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c4663ac-e00b-319d-b184-74c65b88765d",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "A series of events leading to a result or product."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f961291b-897e-42a1-80ab-0183016d45f8",
                                                "sense_id": "1c4663ac-e00b-319d-b184-74c65b88765d",
                                                "text": "This product of last month's quality standards committee is quite good, even though the process was flawed."
                                            },
                                            {
                                                "example_id": "9f089437-2d7f-4878-ac62-c284971b024d",
                                                "sense_id": "1c4663ac-e00b-319d-b184-74c65b88765d",
                                                "text": "But they came up against an impressive force in Bayern, who extended their run to 10 wins on the trot, having scored 28 goals in the process and conceding none."
                                            },
                                            {
                                                "example_id": "ae748e08-8c99-45ed-9413-6da47c33de46",
                                                "sense_id": "1c4663ac-e00b-319d-b184-74c65b88765d",
                                                "text": "Yet in “Through a Latte, Darkly”, a new study of how Starbucks has largely avoided paying tax in Britain, Edward Kleinbard […] shows that current tax rules make it easy for all sorts of firms to generate what he calls “stateless income”: […] In Starbucks’s case, the firm has in effect turned the process of making an expensive cup of coffee into intellectual property."
                                            },
                                            {
                                                "example_id": "59b36af8-af7a-4a6a-a158-7e5001e1a59a",
                                                "sense_id": "1c4663ac-e00b-319d-b184-74c65b88765d",
                                                "text": "For each of the schemes discussed, there is the four-stage process of planning, funding, delivery and operations, in which the various parties involved might be the lead, a partner or an influencer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e2d6b1-e5fe-30a6-a4f6-53c33b791f47",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "The set of procedures used in the manufacture of a product, especially in the food and chemical industries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3842ac-9b63-4823-90e2-010e9688d3d1",
                                                "sense_id": "f4e2d6b1-e5fe-30a6-a4f6-53c33b791f47",
                                                "text": "1960, Mack Tyner, Process Engineering Calculations: Material and Energy Balances – Ordinarily a process plant will use a steam boiler to supply its process heat requirements and to drive a steam-turbine generator."
                                            },
                                            {
                                                "example_id": "c1aa40a9-942d-4bc4-b22d-845eb893bd9c",
                                                "sense_id": "f4e2d6b1-e5fe-30a6-a4f6-53c33b791f47",
                                                "text": "1987, J. R. Richards, Principles of control system design in Modelling and control of fermentation processes – The words plant or process infer generally any dynamic system, be it primarily mechanical, electrical, or chemical process in nature, and may extend also to include social or economic systems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990eef1e-b7a4-3b0d-8bb3-0538ed578207",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "A path or succession of states through which a system passes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71fc6b7-d7fc-4506-a462-30bf0f21921a",
                                                "sense_id": "990eef1e-b7a4-3b0d-8bb3-0538ed578207",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "823a51c7-0d94-3d84-9f4a-683e8a691c51",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "Successive physiological responses to keep or restore health."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b0b696e-0479-3b6a-b5b9-5119cdbe3a62",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "Documents issued by a court in the course of a lawsuit or action at law, such as a summons, mandate, or writ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f2ec36d-74f3-4e21-8a3b-29f99813b354",
                                                "sense_id": "6b0b696e-0479-3b6a-b5b9-5119cdbe3a62",
                                                "text": "But if either at Calling by the Clerk, after the Session Bell, or before the Ordinary by the Roll, an Advocat compears, and craves to be Marked for the Defender, and to see the Process; The Clerk in the first Case, and the Judge in the second, will allow him to see it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "325dff0c-8949-3e13-a75e-88a3c17d2d18",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "An outgrowth of tissue arising above a surface, such as might form part of a joint or the attachment point for a muscle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b44aadb-75fb-3296-ba3e-1c699c7ea50c",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "An executable task or program."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffa79d81-04db-3a8e-8900-f4758b95e093",
                                        "entry_id": "dfa684a3-4b3b-3196-8820-451ad0b3a239",
                                        "glosses": [
                                            "The centre mark that players aim at in the game of squails."
                                        ],
                                        "tags": [],
