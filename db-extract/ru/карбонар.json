                                "target_senses": [
                                    {
                                        "sense_id": "71733788-a30e-3d0c-afe7-a3d3ba305f60",
                                        "entry_id": "3bcc612a-c78d-355a-b00e-4f4ba0a42bce",
                                        "glosses": [
                                            "Activiste, partisan des luttes de libération de l’Italie au XIXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb03fb5-20c2-4abd-827e-7f686b61075c",
                                                "sense_id": "71733788-a30e-3d0c-afe7-a3d3ba305f60",
                                                "text": "Carbonaro, républicain de la veille, sectaire évangélique, il avait conspiré à toutes les heures, dans tous les lieux, en lutte sans cesse contre le pouvoir, quel qu’il fût."
                                            },
                                            {
                                                "example_id": "f3573e29-9674-4885-b8bb-e04a15d28273",
                                                "sense_id": "71733788-a30e-3d0c-afe7-a3d3ba305f60",
                                                "text": "L’inconnu(e) est un carbonaro échappé, comme il l’avoue à Vanina après avoir entretenu le mystère pendant plusieurs jours."
                                            },
                                            {
                                                "example_id": "d29fd69b-68f8-45b2-836e-afb82ace7dd3",
                                                "sense_id": "71733788-a30e-3d0c-afe7-a3d3ba305f60",
                                                "text": "S’il se dévoue à la cause des carbonaros, il est aussi sans illusions sur ceux qui font profession de révolution, ces « cagots de la liberté »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
