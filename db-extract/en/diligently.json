                    {
                        "translation_id": "84a64713-e0bd-4318-aef4-cf0521142a49",
                        "source_entry_id": "b50588cb-936d-382b-87f4-538a12d94f24",
                        "source_sense_id": "69dfe297-63a3-3fa6-ad5f-327c45c86cef",
                        "source_sense_description": "in a diligent manner",
                        "target_lang_word": "приле́жно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "приле́жно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                        "entry_id": "de7a544a-8123-318a-8194-934366e686eb",
                                        "glosses": [
                                            "усердно, старательно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02aaba4c-ea32-4ac1-9296-c33582da996a",
                                                "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                                "text": "Дни его проходили однообразно; но он не скучал, хотя никого не видел; он прилежно и внимательно занимался хозяйством, ездил верхом по окрестностям, читал."
                                            },
                                            {
                                                "example_id": "8092a968-7a49-422f-b1d7-75c336584ee7",
                                                "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                                "text": "Она училась так прилежно, что скоро могла понимать французские книги, разговоры и даже выучилась немного говорить по-французски."
                                            },
                                            {
                                                "example_id": "db2188ce-e0fb-450c-8505-8f0a25e40caa",
                                                "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                                "text": "В воротах его опять встретил дворник, прилежно наблюдавший всё его прощание с Ярославом Ильичом, и ещё издали сделал ему какой-то пригласительный знак."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8518684-fcea-48af-9f73-bf58432b10dc",
                        "source_entry_id": "b50588cb-936d-382b-87f4-538a12d94f24",
