                        "glosses": [
                            "Établissement public ayant pour principale vocation la consommation de café ou autres boissons chaudes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca4cc19-4dbe-4bf6-ab95-4eb915fc79fa",
                                "sense_id": "51e0ac63-8f9e-343b-8bcb-557e62ddfc16",
                                "text": "Quand on s’était rencontrés, quelques semaines plus tôt, elle s’asseyait seule à la cafèt du lycée, à la table des exclus."
                            },
                            {
                                "example_id": "ca529dfc-aa9b-40cb-be63-202285891c42",
                                "sense_id": "51e0ac63-8f9e-343b-8bcb-557e62ddfc16",
                                "text": "Une fois dehors, je peux passer des heures à explorer le quartier : je visite les cafèts, les restos, les foodcourts, les boutiques, les mégasurfaces, les bureaux, les caves, mais aussi les apparts, en tout cas ceux dans lesquels je n’entends pas de bruit."
                            },
                            {
                                "example_id": "9b1dbe64-70b4-4338-be8a-e92d0bba7976",
                                "sense_id": "51e0ac63-8f9e-343b-8bcb-557e62ddfc16",
                                "text": "À compter de la rentrée, dans les cafèts, il faudra montrer sa carte d’étudiant."
                            }
                        ]
                    }
