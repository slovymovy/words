{
    "word_family": [
        "pastry",
        "pasty",
        "toothpaste",
        "wheatpaste",
        "pasting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b84f32e9-e042-3873-908b-16bba8c7871f",
                    "sense_definition": "A soft, wet, thick mixture used as an adhesive to stick things together, especially paper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adhesive_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We used flour and water to make a simple <w>paste</w> for the craft project.",
                            "target_lang_translations": {
                                "ru": "Мы использовали муку и воду, чтобы сделать простой <w>клейстер</w> для поделки.",
                                "zh": "我们用面粉和水做了一种简单的<w>浆糊</w>来做手工项目。"
                            }
                        },
                        {
                            "text": "Apply the wallpaper <w>paste</w> evenly to the back of the paper.",
                            "target_lang_translations": {
                                "ru": "Равномерно нанесите обойный <w>клей</w> на обратную сторону бумаги.",
                                "zh": "将壁纸<w>胶水</w>均匀地涂在纸的背面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glue",
                        "adhesive"
                    ],
                    "common_phrases": [
                        "wallpaper paste",
                        "make a paste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая, влажная, густая смесь, используемая в качестве клея для склеивания предметов, особенно бумаги.",
                        "zh": "一种柔软、潮湿且粘稠的混合物，用作粘合剂来粘贴物品，特别是纸张。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клейстер",
                                "target_lang_sense_clarification": "клей из крахмала или муки"
                            },
                            {
                                "target_lang_word": "клей",
                                "target_lang_sense_clarification": "общее название клеящего вещества"
                            },
                            {
                                "target_lang_word": "паста",
                                "target_lang_sense_clarification": "густая масса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浆糊",
                                "target_lang_sense_clarification": "由淀粉或面粉制成的粘合剂"
                            },
                            {
                                "target_lang_word": "胶水",
                                "target_lang_sense_clarification": "通用的粘合剂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59ed4264-abbf-3d95-8cc5-25a7abc190d0",
                    "sense_definition": "A smooth, soft food mixture made by crushing or blending ingredients until they become creamy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe requires two tablespoons of tomato <w>paste</w> to thicken the sauce.",
                            "target_lang_translations": {
                                "ru": "Для рецепта требуется две столовые ложки томатной <w>пасты</w>, чтобы загустить соус.",
                                "zh": "食谱需要两汤匙番茄<w>酱</w>来使酱汁变浓稠。"
                            }
                        },
                        {
                            "text": "She spread a thin layer of anchovy <w>paste</w> on the toast.",
                            "target_lang_translations": {
                                "ru": "Она намазала тонкий слой <w>пасты</w> из анчоусов на тост.",
                                "zh": "她在吐司上抹了一层薄薄的凤尾鱼<w>酱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spread",
                        "puree",
                        "pâté"
                    ],
                    "common_phrases": [
                        "tomato paste",
                        "curry paste",
                        "fish paste",
                        "almond paste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Однородная мягкая пищевая смесь, полученная путем измельчения или смешивания ингредиентов до кремообразного состояния.",
                        "zh": "通过研磨或混合食材至奶油状而制成的细腻、柔软的食物混合物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паста",
                                "target_lang_sense_clarification": "пищевая (томатная, шоколадная)"
                            },
                            {
                                "target_lang_word": "паштет",
                                "target_lang_sense_clarification": "из мяса или рыбы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酱",
                                "target_lang_sense_clarification": "浓稠的食物泥或调味品"
                            },
                            {
                                "target_lang_word": "膏",
                                "target_lang_sense_clarification": "质地浓稠的食品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ab9a4a1-850b-3bdd-87df-7e7baf04cb90",
                    "sense_definition": "A hard, shiny glass used to make artificial gemstones or fake jewelry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "material_glass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique brooch was made of <w>paste</w> rather than real diamonds.",
                            "target_lang_translations": {
                                "ru": "Старинная брошь была сделана из <w>стразов</w>, а не из настоящих бриллиантов.",
                                "zh": "这枚古董胸针是<w>水钻</w>做的，而不是真正的钻石。"
                            }
                        },
                        {
                            "text": "She wore a necklace of <w>paste</w> stones that sparkled under the lights.",
                            "target_lang_translations": {
                                "ru": "На ней было ожерелье из <w>стразов</w>, которое сверкало под огнями.",
                                "zh": "她戴着一条在灯光下闪闪发光的<w>水钻</w>项链。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "paste jewelry",
                        "paste gem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое блестящее стекло, используемое для изготовления искусственных драгоценных камней или фальшивых украшений.",
                        "zh": "一种坚硬且有光泽的玻璃，用于制作人造宝石或仿制首饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страз",
                                "target_lang_sense_clarification": "имитация драгоценного камня"
                            },
                            {
                                "target_lang_word": "подделка",
                                "target_lang_sense_clarification": "фальшивое украшение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水钻",
                                "target_lang_sense_clarification": "仿制宝石的玻璃制品"
                            },
                            {
                                "target_lang_word": "仿制品",
                                "target_lang_sense_clarification": "假冒的珠宝首饰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "085ffb6e-235f-34d9-812d-b85c7a628d37",
                    "sense_definition": "To insert text, images, or data into a document or application after copying or cutting it from another location.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computer_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can copy the link and <w>paste</w> it into your browser's address bar.",
                            "target_lang_translations": {
                                "ru": "Вы можете скопировать ссылку и <w>вставить</w> её в адресную строку браузера.",
                                "zh": "你可以复制链接并将其<w>粘贴</w>到浏览器的地址栏中。"
                            }
                        },
                        {
                            "text": "I need to <w>paste</w> the photo into the presentation slides.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>вставить</w> фотографию в слайды презентации.",
                                "zh": "我需要把照片<w>粘贴</w>到演示文稿的幻灯片里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "copy and paste",
                        "cut and paste"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставлять текст, изображения или данные в документ или приложение после копирования или вырезания из другого места.",
                        "zh": "在从其他位置复制或剪切后，将文本、图像或数据插入到文档或应用程序中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставить",
                                "target_lang_sense_clarification": "компьютерная команда"
                            },
                            {
                                "target_lang_word": "вставлять",
                                "target_lang_sense_clarification": "процесс вставки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粘贴",
                                "target_lang_sense_clarification": "计算机操作指令"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "848c71c5-a54c-37aa-96d5-9a45169cdfbe",
                    "sense_definition": "To stick something onto a surface using glue or a similar adhesive substance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_stick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>pasted</w> colorful shapes onto a large sheet of paper.",
                            "target_lang_translations": {
                                "ru": "Дети <w>наклеили</w> разноцветные фигурки на большой лист бумаги.",
                                "zh": "孩子们把彩色的形状<w>粘贴</w>在一张大纸上。"
                            }
                        },
                        {
                            "text": "He <w>pasted</w> the notice on the wall for everyone to see.",
                            "target_lang_translations": {
                                "ru": "Он <w>приклеил</w> объявление на стену, чтобы все его видели.",
                                "zh": "他把通知<w>贴</w>在墙上让大家看。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glue",
                        "stick",
                        "adhere",
                        "attach",
                        "fix"
                    ],
                    "antonyms": [
                        "peel"
                    ],
                    "common_phrases": [
                        "paste up",
                        "paste onto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикреплять что-либо к поверхности с помощью клея или подобного клейкого вещества.",
                        "zh": "使用胶水或类似的粘合物质将某物固定在表面上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приклеить",
                                "target_lang_sense_clarification": "прикрепить клеем"
                            },
                            {
                                "target_lang_word": "наклеить",
                                "target_lang_sense_clarification": "нанести на поверхность"
                            },
                            {
                                "target_lang_word": "клеить",
                                "target_lang_sense_clarification": "процесс склеивания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粘贴",
                                "target_lang_sense_clarification": "用胶水固定"
                            },
                            {
                                "target_lang_word": "贴",
                                "target_lang_sense_clarification": "将物体附着在表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6630ea9-7150-338e-bf85-a98046d69f68",
                    "sense_definition": "To hit someone very hard or to defeat an opponent decisively.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_hit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer <w>pasted</w> his opponent with a series of heavy blows.",
                            "target_lang_translations": {
                                "ru": "Боксер <w>отдубасил</w> своего противника серией тяжелых ударов.",
                                "zh": "拳击手用一系列重拳<w>痛打</w>了他的对手。"
                            }
                        },
                        {
                            "text": "Our team got absolutely <w>pasted</w> in the final match of the season.",
                            "target_lang_translations": {
                                "ru": "Нашу команду полностью <w>разгромили</w> в финальном матче сезона.",
                                "zh": "我们队在赛季最后一场比赛中彻底<w>惨败</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thrash",
                        "wallop",
                        "clobber"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударить кого-то или решительно победить противника.",
                        "zh": "猛烈地殴打某人或以压倒性优势击败对手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "победить с большим счетом"
                            },
                            {
                                "target_lang_word": "отдубасить",
                                "target_lang_sense_clarification": "сильно побить (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "痛打",
                                "target_lang_sense_clarification": "猛烈地殴打"
                            },
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "在比赛中被彻底击败"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}