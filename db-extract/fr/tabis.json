                                        "sense_id": "2a9089b7-72ec-3508-a29e-da0aac3a5567",
                                        "entry_id": "4d74e952-5eae-3b06-9494-e516cad133c2",
                                        "glosses": [
                                            "A kind of waved silk, usually called watered silk, manufactured like taffeta, but thicker and stronger. The watering is given to it by calendering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aade7f0-2a03-4a76-a5b6-83d2f3383111",
                                                "sense_id": "2a9089b7-72ec-3508-a29e-da0aac3a5567",
                                                "text": "\"Ay, ay; she wore a flowered silk tabby sacque, on band days,\" said Toole, who had an eye and a corner in his memory for female costume, \"a fine showy—I remember.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "717bdf94-dce5-36fa-9446-04ac3b67f3f4",
                                        "entry_id": "4d74e952-5eae-3b06-9494-e516cad133c2",
                                        "glosses": [
                                            "A mixture of lime with shells, gravel, or stones, in equal proportions, with an equal proportion of water. When dry, this becomes as hard as rock."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcd616b2-cff1-3741-8886-f7db047e18b4",
                                        "entry_id": "4d74e952-5eae-3b06-9494-e516cad133c2",
                                        "glosses": [
                                            "A brindled cat."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab87c191-3819-4ce5-afa7-f625997cf041",
                                                "sense_id": "bcd616b2-cff1-3741-8886-f7db047e18b4",
                                                "text": "A wise tabby, a blinking sphinx, watched from her warm sill. Pity to disturb them. Mohammed cut a piece out of his mantle not to wake her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a92109-837c-3bfe-a2b6-c0241d9710c9",
                                        "entry_id": "4d74e952-5eae-3b06-9494-e516cad133c2",
                                        "glosses": [
                                            "A woman, irrespective of age, but often used for a young, attractive woman."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca16f6f-3c6a-439f-bb2f-aa5ca6eeb911",
                                                "sense_id": "16a92109-837c-3bfe-a2b6-c0241d9710c9",
                                                "text": "‘The kids go for a drive in a borrowed car, park on another street between the corner lamps, and then there’s ructions because some little tabby gets up the stick.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088788c5-7d71-3233-bfb7-59f86aafe26b",
                                        "entry_id": "4d74e952-5eae-3b06-9494-e516cad133c2",
                                        "glosses": [
                                            "An old maid or gossip."
