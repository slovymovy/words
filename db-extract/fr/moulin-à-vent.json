                        "examples": [
                            {
                                "example_id": "c8c3bcc0-a0cc-4c27-84c1-c5992797659c",
                                "sense_id": "a6f75f5e-cdd3-38d0-ba39-1cd7636cbc62",
                                "text": "Début des travaux octobre 2019, livraison en mars 2021. C’est une construction au pas de charge en quelque sorte, qui a été menée ici, au Moulin-à-Vent, quartier du 8e arrondissement, car il convenait d’ouvrir des classes en urgence."
                            },
                            {
                                "example_id": "c08c9bf4-b483-4d4a-9c18-a383b1b8b4b6",
                                "sense_id": "a6f75f5e-cdd3-38d0-ba39-1cd7636cbc62",
                                "text": "Rue du Vercors à Vénissieux, dans le quartier du Moulin-à-Vent, la vaste demeure se souvient de la naissance de ces vingt-quatre maisons jumelles accolées deux à deux, soit douze bâtiments."
                            }
                        ]
                    }
