                "word": "raster",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "17546294-c569-41ec-b72e-d3a256de38bf",
                        "entry_id": "d9fd62f0-9437-3851-9efe-2a55c53fc6f1",
                        "tags": [
                            "plural"
                        ],
