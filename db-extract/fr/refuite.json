                "senses": [
                    {
                        "sense_id": "536419e4-8d15-30ca-91f3-7bad6465835b",
                        "entry_id": "61d07af5-56d5-3685-bd00-a9668c15961b",
                        "glosses": [
                            "Trajet et traces que fait une bête chassée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c53836b-00a0-43ba-b8a5-7bf5aad7c656",
                                "sense_id": "536419e4-8d15-30ca-91f3-7bad6465835b",
                                "text": "Il y a tant de refuites dans cette forêt."
                            },
                            {
                                "example_id": "313bb515-9f4a-4d80-9f05-325478c3db87",
                                "sense_id": "536419e4-8d15-30ca-91f3-7bad6465835b",
                                "text": "Mettre des relais aux refuites."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea5cc91b-7467-344b-9bc1-77fd70edcca2",
                        "entry_id": "61d07af5-56d5-3685-bd00-a9668c15961b",
                        "glosses": [
                            "Il se dit aussi des ruses d’une bête qu’on chasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70df2ebd-838a-443e-9376-6ee81c35f24e",
                                "sense_id": "ea5cc91b-7467-344b-9bc1-77fd70edcca2",
                                "text": "[…] si l'on ne retrouve pas la voie du cerf, on juge qu'il est resté dans l'enceinte dont on vient de faire le tour, on la foule de nouveau ; et lorsque le cerf ne s'y trouve pas, il ne reste d'autre moyen que d'imaginer la refuite qu'il peut avoir faite, vu le pays où l'on est, et d'aller l'y chercher."
                            },
                            {
                                "example_id": "1f525e31-f5ba-4c97-b11c-8a1ce78aecd8",
                                "sense_id": "ea5cc91b-7467-344b-9bc1-77fd70edcca2",
                                "text": "Pour l’attaque du sanglier et les refuites périlleuses, il y avait quarante griffons, poilus comme des ours."
                            }
                        ]
                    },
                    {
                        "sense_id": "401d0fa6-76ba-30ed-9b91-11420829208f",
                        "entry_id": "61d07af5-56d5-3685-bd00-a9668c15961b",
                        "glosses": [
                            "Retardements, détours d'une personne qui veut échapper à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e15f0906-eb48-48b2-b005-567f4eeda4a5",
                                "sense_id": "401d0fa6-76ba-30ed-9b91-11420829208f",
                                "text": "Mais cessez de chercher ces refuites frivoles…"
                            },
                            {
                                "example_id": "c31a6bd7-1d62-43ba-9d0f-624daa8ad8da",
                                "sense_id": "401d0fa6-76ba-30ed-9b91-11420829208f",
                                "text": "Mme la duchesse ne prit pas le change; accoutumée à ses refuites, elle le suivit jusqu'à ce qu'elle l'eût atteint."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fc68410-61d6-30dd-b9bc-a89a4b097d7d",
                        "entry_id": "61d07af5-56d5-3685-bd00-a9668c15961b",
                        "glosses": [
