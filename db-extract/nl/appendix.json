                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f20053a5-99c2-40a8-b365-83347e31521a",
                                                "sense_id": "dc95c5c1-2d83-3da7-8590-eb0113779dff",
                                                "text": "Near-synonyms: ancillary, auxiliary"
                                            },
                                            {
                                                "example_id": "13a7654b-4866-42c2-819e-d6381e7825e6",
                                                "sense_id": "dc95c5c1-2d83-3da7-8590-eb0113779dff",
                                                "text": "idleness is an appendix to nobility; they count it a disgrace to work, and spend all their days in sports, recreations, and pastimes […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf4104f-09d0-3033-87c6-3b62169c04cc",
