                    {
                        "translation_id": "d588b619-afc2-40ce-993c-890ece23945a",
                        "source_entry_id": "2d0ef002-9008-3e19-9385-0bb8e2760dba",
                        "source_sense_id": "87524986-9c23-3f87-95d5-e33fcc00321f",
                        "target_lang_word": "Dramatiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dramatiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                        "entry_id": "c3c9b982-05b2-30f1-8b56-8e89705214b8",
                                        "glosses": [
                                            "Person, die Dramen verfasst"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6932778-260e-481e-90ef-d8b3613f9cb4",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "Manche Dramatiker haben nur Komödien verfasst."
                                            },
                                            {
                                                "example_id": "320b27ee-aa7d-4a4e-b950-69ee8a462fc5",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "„Ruth Albu ist zu diesem Zeitpunkt noch mit Heinrich Schnitzler, dem Sohn des großen Wiener Dramatikers, verheiratet.“"
                                            },
                                            {
                                                "example_id": "ead9a367-e791-489a-8409-9748be34e4d2",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "„Was der Geschichtsschreiber als ungelöstes Problem stehen lassen muss, stellt der Dramatiker in einer Form hin, die ebenfalls keine Auflösung suggeriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50a5a39a-cb31-4e4a-bc24-6663769a07ec",
                        "source_entry_id": "2d0ef002-9008-3e19-9385-0bb8e2760dba",
                        "source_sense_id": "87524986-9c23-3f87-95d5-e33fcc00321f",
                        "target_lang_word": "драматург",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "драматург",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
                                        "entry_id": "74f8ebca-7b46-3080-8919-f43fb9f23451",
                                        "glosses": [
                                            "писатель, создающий драматические произведения, пьесы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf579006-fbdc-4207-90f1-9fc9d09bfe29",
                                                "sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
                                                "text": "Вкус последней законно увлёкся силой таланта драматурга в известную сторону ― и любимцами публики сделались талантливые исполнители его ролей."
                                            },
                                            {
                                                "example_id": "744626a2-3944-4800-8926-a0efdf060dca",
                                                "sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
                                                "text": "Жизнь драматурга соответствовала характеру его произведений ― в высшей степени уравновешенному, почти эпическому."
                                            },
                                            {
                                                "example_id": "5254634e-56ed-4003-abe2-26e698e4ab3b",
                                                "sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
                                                "text": "Спектакль начинается с того, что зрители, сидящие в зале, читают проецируемую на экран пьесу немецкого драматурга."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
