            {
                "entry_id": "bb3b1f12-e429-3eef-b26c-79d54c2f8e45",
                "word": "drave",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b7c1bc3b-6f47-432f-9f78-e69cc91d13c5",
