                "senses": [
                    {
                        "sense_id": "cd5503fc-1fd0-348a-9138-3502ce1958be",
                        "entry_id": "59f7cd91-a811-32a5-9e21-b5f44ad0cb47",
                        "glosses": [
                            "The appearance or study of feathers on a bird, including factors such as their texture or shape."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9b4985d7-74c7-470b-a865-78ab0a73a6af",
                                "sense_id": "cd5503fc-1fd0-348a-9138-3502ce1958be",
                                "text": "Pterylography must be based on the distribution of the follicles, for the ptilosis as seen externally does not reflect the actual pterylosis."
                            }
                        ]
                    },
                    {
                        "sense_id": "861b61a2-3881-3b0c-97a2-0762acde1413",
                        "entry_id": "59f7cd91-a811-32a5-9e21-b5f44ad0cb47",
                        "glosses": [
                            "Loss of the eyelashes, due to ulceration or other damage to the follicles."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5d7d51a1-89ca-46a5-bb16-ce5ad70ea131",
                                "sense_id": "861b61a2-3881-3b0c-97a2-0762acde1413",
                                "text": "The state of the lid, when deprived of the eyelashes, has been called ptilosis or alopecia ; the effect of the removal is very inconsiderable, and unless you look closely to the lid of a person of light hair, you can hardly distinguish whether the eyelashes are wanting or not."
                            },
                            {
                                "example_id": "03c00c51-2fe8-4a76-845e-a6aff0378508",
                                "sense_id": "861b61a2-3881-3b0c-97a2-0762acde1413",
                                "text": "This is an aggravated form of the last disease, and presents ulceration and induration of the edges of the eye: lids, so as to cause the cilia, or lashes to fall out—ptilosis."
                            },
                            {
                                "example_id": "fe2f6cce-3be3-4054-b560-58222937afa7",
                                "sense_id": "861b61a2-3881-3b0c-97a2-0762acde1413",
                                "text": "Loss of the eye-lashes, (ptilosis, madarosis, alopecia.) -- Destruction of the bulbs by ulceration or by injury causes permanent loss of the cilia, which may be either total or partial."
                            },
                            {
                                "example_id": "2e58948b-315c-4180-8a44-104da22e863e",
                                "sense_id": "861b61a2-3881-3b0c-97a2-0762acde1413",
                                "text": "There may be ulceration and notching (ptilosis) of the lid margin (Figure 1.3)."
                            }
                        ]
                    }
                ],
