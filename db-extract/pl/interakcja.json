                                "example_id": "279de41b-5887-41fd-ac7d-3e4a90421773",
                                "sense_id": "cbeffed9-5ac6-334e-804e-bd8176cc1ffc",
                                "text": "Pomiędzy elitą i masami zachodzą wzajemne interakcje."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6877b5f0-6936-4d40-8877-03524e1b989f",
                        "source_entry_id": "8723af9e-f838-3b72-ae77-9a826b0930f5",
                        "source_sense_id": "cbeffed9-5ac6-334e-804e-bd8176cc1ffc",
                        "target_lang_word": "interaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b15c8847-2cda-3077-8602-38827f5de896",
                                        "entry_id": "c07c9c22-fb7d-3d25-b577-d95fd76adace",
                                        "glosses": [
                                            "The situation or occurrence in which two or more objects or events act upon one another to produce a new effect; the effect resulting from such a situation or occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "101590d2-bb47-4ac3-bfa1-a656170d50b5",
                                                "sense_id": "b15c8847-2cda-3077-8602-38827f5de896",
                                                "text": "Be aware of interactions between different medications."
                                            },
                                            {
                                                "example_id": "72212650-02d5-4d78-aeca-1a954248bfa6",
                                                "sense_id": "b15c8847-2cda-3077-8602-38827f5de896",
                                                "text": "Such technologies will also “shape future human interaction with the machines we created,” he added."
                                            },
                                            {
                                                "example_id": "5af1b91f-c3d4-4ab3-a744-ed5808517e32",
                                                "sense_id": "b15c8847-2cda-3077-8602-38827f5de896",
                                                "text": "At the beginning of September South Western Railway withdrew its Class 442 EMUs from service due to a safety issue concerning interaction with lineside signals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f58e72c-ed60-329d-ba1e-41bda5232987",
                                        "entry_id": "c07c9c22-fb7d-3d25-b577-d95fd76adace",
                                        "glosses": [
                                            "A conversation or exchange between people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8502d9f8-b409-450a-b06c-676262f6104c",
                                                "sense_id": "0f58e72c-ed60-329d-ba1e-41bda5232987",
                                                "text": "I enjoyed the interaction with a bunch of like-minded people."
                                            },
                                            {
                                                "example_id": "b796964a-a0b3-4c88-a6f0-322abac83c42",
                                                "sense_id": "0f58e72c-ed60-329d-ba1e-41bda5232987",
                                                "text": "Another 'basic' is staff interaction with customers - and here, ScotRail excelled. Every single one of them whom RAIL engaged with was polite and chatty, and some were even humorous!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94a6a621-6d31-477a-98ad-750fb7ccd271",
                        "source_entry_id": "8723af9e-f838-3b72-ae77-9a826b0930f5",
                        "source_sense_id": "cbeffed9-5ac6-334e-804e-bd8176cc1ffc",
                        "target_lang_word": "interakce",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interakce",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "6699c48e-ece2-389c-b2f8-a01edea91c1a",
                                        "entry_id": "9c159dd7-3218-371d-aa0f-ff9389cd83e2",
                                        "glosses": [
                                            "vzájemné ovlivňování, působení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1563eaf9-2b69-4adf-ae81-0972719c2241",
                                                "sense_id": "6699c48e-ece2-389c-b2f8-a01edea91c1a",
                                                "text": "Současné podání těchto dvou léků vytváří nebezpečnou interakci, která může pacienta ohrozit na životě."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d425484-a26c-479f-acb7-900f3666d4f3",
                        "source_entry_id": "8723af9e-f838-3b72-ae77-9a826b0930f5",
                        "source_sense_id": "cbeffed9-5ac6-334e-804e-bd8176cc1ffc",
                        "target_lang_word": "interaction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interaction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "112b6d63-7187-3de2-a01d-d5a052ae413c",
                                        "entry_id": "df4f7989-149e-333b-af9a-d07253da1671",
                                        "glosses": [
                                            "Action ou influence réciproque qui peut s’établir entre deux objets ou plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2fea99b-cf91-4032-9207-234cd32b1d28",
                                                "sense_id": "112b6d63-7187-3de2-a01d-d5a052ae413c",
                                                "text": "Alliant tradition et modernité, la phytothérapie n'est exclusive d'aucune autre thérapeutique. Elle connaît des précautions d'emploi, des contre-indications, des interactions et, nous l'avons vu, un professionnel de la santé est le mieux placé pour la conseiller à chacun, selon ses besoins."
                                            },
                                            {
                                                "example_id": "5b3f18ca-bd1b-4479-8953-3815bfad0e05",
                                                "sense_id": "112b6d63-7187-3de2-a01d-d5a052ae413c",
                                                "text": "Il n’est qu’un élément du système phonatoire, dont le fonctionnement repose sur l’interaction entre trois classes d’organes : les poumons, le pharynx et les cavités supraglottiques (bouche, nez, lèvres, pharynx…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33bf6472-c705-37be-8aea-6095a60fddfb",
                                        "entry_id": "df4f7989-149e-333b-af9a-d07253da1671",
                                        "glosses": [
                                            "En parlant des interactions élémentaires."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04f24c2d-0801-362a-a187-6ff50c9e4b0a",
                                        "entry_id": "df4f7989-149e-333b-af9a-d07253da1671",
                                        "glosses": [
                                            "Influence réciproque pouvant s’établir entre deux personnes ou plus. Une interaction se décompose en plusieurs séquences, échanges et tours de parole."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90eea75d-5453-4879-be5c-92eed1418d17",
                                                "sense_id": "04f24c2d-0801-362a-a187-6ff50c9e4b0a",
                                                "text": "A priori, il ne paraît pas possible d'exclure l'existence d'une interaction phéromonale entre hommes ou plutôt, dans les deux cas précis, entre hommes et femmes ou entre femmes."
                                            },
                                            {
                                                "example_id": "6882028c-b375-4886-b0ee-6ee8edc79424",
                                                "sense_id": "04f24c2d-0801-362a-a187-6ff50c9e4b0a",
                                                "text": "Apprendre à animer une réunion en interaction avec les participants."
                                            },
                                            {
                                                "example_id": "d9b72aa7-4e61-4b3f-9d64-44373cb0f62b",
                                                "sense_id": "04f24c2d-0801-362a-a187-6ff50c9e4b0a",
                                                "text": "Ces extraits représentent des humains de 144 pays lors d’événements et d'interactions, comme regarder des feux d'artifice, danser ou consoler un enfant qui pleure, expliquent les auteurs dans un communiqué publié par l'université californienne et dont les travaux sont publiés dans la revue Nature (Nouvelle fenêtre) (en anglais)."
                                            },
                                            {
                                                "example_id": "1877ffe2-4eb7-42e6-bb3c-e8fbe1775e94",
                                                "sense_id": "04f24c2d-0801-362a-a187-6ff50c9e4b0a",
                                                "text": "Si vous observez bien les évolutions, les gens en Europe sont à des niveaux d'interactions sociales d'avant la pandémie, de rassemblements et bien d'autres choses, malgré le fait qu'on soit en plein milieu d'une résurgence très, très forte des cas et pour certains pays une énorme pression sur les systèmes de santé"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "343afd69-4c43-459d-b444-479ac5ec3362",
                        "source_entry_id": "8723af9e-f838-3b72-ae77-9a826b0930f5",
                        "source_sense_id": "cbeffed9-5ac6-334e-804e-bd8176cc1ffc",
