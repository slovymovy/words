                            },
                            {
                                "target_lang_word": "paquets",
                                "target_lang_sense_clarification": "amas de matière molle"
                            },
                            {
                                "target_lang_word": "grosses gouttes",
                                "target_lang_sense_clarification": "éclaboussures épaisses"
                            }
                        ]
