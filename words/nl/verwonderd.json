                    "sense_id": "c8d23973-3e52-38e3-ba82-33130b137d61",
                    "sense_definition": "vervuld van verbazing of bewondering door iets onverwachts of bijzonders",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij keek <w>verwonderd</w> naar de prachtige sterrenhemel boven de woestijn.",
                            "target_lang_translations": {
                                "en": "She looked <w>amazed</w> at the beautiful starry sky above the desert.",
                                "fr": "Elle regardait le magnifique ciel étoilé au-dessus du désert avec <w>émerveillement</w>."
                            }
                        },
                        {
                            "text": "De toeristen bleven <w>verwonderd</w> staan kijken naar het oude monument.",
                            "target_lang_translations": {
                                "en": "The tourists stood watching the old monument in <w>wonder</w>.",
                                "fr": "Les touristes sont restés à contempler le vieux monument, tout <w>ébahis</w>."
                            }
                        }
                    ],
                    "synonyms": [
