                "senses": [
                    {
                        "sense_id": "24f48ec3-4c90-3c38-9ab2-425afc498ce8",
                        "entry_id": "eb9d776e-dd50-3149-939c-b4f1d0e182d4",
                        "glosses": [
                            "Fest (Party), bei dem sich trotz Lockdown oder Kontaktbeschränkungen Menschen treffen und feiern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "795d0ec7-3226-4184-8a7c-b161f327efe0",
                                "sense_id": "24f48ec3-4c90-3c38-9ab2-425afc498ce8",
                                "text": "Spontan klang die Idee verlockend: sich jetzt bewusst auf einer Corona-Party mit dem neuen Krankheitserreger anstecken, dann hat man es durch."
                            },
                            {
                                "example_id": "abc4826b-3669-4943-b4d3-e79e8d7ccd9f",
                                "sense_id": "24f48ec3-4c90-3c38-9ab2-425afc498ce8",
                                "text": "„Corona-Partys konterkarieren durch die forcierte Ausbreitung solche Mühen und können dazu führen, dass das Gesundheitssystem kollabiert. Und wie der Fall Italien zeigt, auch zu mehr Toten führen, weil lebensrettende Beatmungsgeräte schlicht nicht mehr zur Verfügung stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
