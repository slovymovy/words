                                "target_senses": [
                                    {
                                        "sense_id": "c659a479-546b-36fd-99ee-34c5c2829312",
                                        "entry_id": "d9974b7d-5558-35cf-81f8-4ea9669fdeac",
                                        "glosses": [
                                            "elektronische Schaltung auf einem Halbleiter auf kleinstem Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9345b94-c5bf-46d2-9643-4d4a8275b736",
                                                "sense_id": "c659a479-546b-36fd-99ee-34c5c2829312",
                                                "text": "Der kleine, nicht einmal fingernagelgroße Chip vernetzt elektrische Geräte über das bestehende Stromnetz."
                                            },
                                            {
                                                "example_id": "f18a0de3-bda1-4bab-86ff-1445fd96eafa",
                                                "sense_id": "c659a479-546b-36fd-99ee-34c5c2829312",
                                                "text": "Mein Fiffi hat jetzt einen kleinen Chip unter der Haut im Nacken, sein Personalausweis, so zu sagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98f59ad7-35d1-3d32-b02e-ab663a895417",
                                        "entry_id": "d9974b7d-5558-35cf-81f8-4ea9669fdeac",
                                        "glosses": [
                                            "mit Fett gebackene oder frittierte dünne Scheibe eines Lebensmittels (meist Kartoffel)"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecce7e56-0329-4452-a8fe-a57147517852",
                                                "sense_id": "98f59ad7-35d1-3d32-b02e-ab663a895417",
                                                "text": "Es gibt Menschen, die leben nur von Chips und Dosenpils."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5c76146-f4e5-32c0-9ec7-4809cad9ed12",
                                        "entry_id": "d9974b7d-5558-35cf-81f8-4ea9669fdeac",
                                        "glosses": [
                                            "Spielmarke bei Glücksspielen"
                                        ],
                                        "tags": [
                                            "Glücksspiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e712673-2a86-49f6-b9dd-44729d52aa2d",
                                                "sense_id": "a5c76146-f4e5-32c0-9ec7-4809cad9ed12",
                                                "text": "Bereits nach dreißig Minuten hatte er keine Chips mehr und machte sich Gedanken darüber, mit dem Pokerspielen aufzuhören."
                                            },
                                            {
                                                "example_id": "6f9228aa-6391-412c-a251-ba480cad8ea0",
                                                "sense_id": "a5c76146-f4e5-32c0-9ec7-4809cad9ed12",
                                                "text": "„Der Croupier schob ihm eine Anzahl Chips zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c247152b-f030-3acf-a1c4-c9016c97e8a0",
                                        "entry_id": "d9974b7d-5558-35cf-81f8-4ea9669fdeac",
                                        "glosses": [
                                            "ein kurzer, flacher Annäherungsschlag auf das Grün"
                                        ],
                                        "tags": [
                                            "Golf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5161112d-0534-4b3b-9ffa-077ec7b788bf",
                                                "sense_id": "c247152b-f030-3acf-a1c4-c9016c97e8a0",
                                                "text": "„Ein Chip erfordert keine große Sportlichkeit, kein Hantelstemmen und keine Dehnübungen, sondern nur Trainingsfleiß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "237e0be4-865e-4b4f-ba12-b0b94c7788f0",
                        "source_entry_id": "30d10885-fb9b-38fd-8140-6783a32deaaf",
                        "source_sense_id": "fbcaa8d1-1ffe-3dd6-85f3-0cafa0c0f972",
