                    },
                    {
                        "translation_id": "729fe35f-e6bd-44bb-9448-7c09c36f0a43",
                        "source_entry_id": "dce6251d-4351-35c5-927c-3dfd8e2e8afb",
                        "source_sense_id": "6558d9a7-69d0-3943-9b7b-a89c040fe938",
                        "source_sense_description": "a flavored alcoholic beverage",
                        "target_lang_word": "liqueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                        "entry_id": "be7e7eff-ff7b-338b-bdf6-1243d76d7e03",
                                        "glosses": [
                                            "Substance fluide et liquide."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c88e680-185f-41b9-a32a-9ebf1eb1ae45",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "Si, au lieu d'eau, on plonge un bocal d’esprit de vin ou de toute autre liqueur non gelable, à une semblable température, la liqueur prend, sans tarder, celle du bain."
                                            },
                                            {
                                                "example_id": "42adfe58-ce04-4485-8bfa-ffb30caa7661",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "En bon Champenois, il célébra le vin de Champagne dans une ode en vers iambiques, dont le style vif et pétillant, présente la belle image de cette charmante liqueur."
                                            },
                                            {
                                                "example_id": "232ab943-e075-47af-ba0f-cb2f2bf495fd",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "Quand la cristallisation est achevée on sépare les cristaux de la liqueur mère qui se compose principalement d’acide oléique, on les fait recristalliser dans l’alcool à plusieurs reprises."
                                            },
                                            {
                                                "example_id": "a8fa5f61-8090-4550-b0e3-64ca79a65cee",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "Ce dieu malfaisant, environné d’une foule innombrable de Mensonges ailés qui voltigent autour de lui, vint répandre une liqueur subtile et enchantée sur les yeux du pilote Achamas, qui considérait attentivement à la clarté de la lune le cours des étoiles, et le rivage d’Ithaque, dont il découvrait déjà assez près de lui les roches escarpés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                        "entry_id": "be7e7eff-ff7b-338b-bdf6-1243d76d7e03",
                                        "glosses": [
                                            "Boisson résultant d’un alcoolat de plantes ou de fruits, généralement douce."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c63456d-c320-40fd-bd9d-629bc60219f0",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "En fait de liqueurs, le lieutenant Hobson emportait plusieurs barils de brandevin et de whisky, bien décidé, d'ailleurs, à économiser autant que possible ces liquides alcooliques, qui sont nuisibles à la santé des hommes sous les froides latitudes."
                                            },
                                            {
                                                "example_id": "2246b2e7-31c0-4031-a63f-2ea9fe0218e8",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "Ô vous qui buvez « sur le zinc », avez-vous jamais songé à toute la science qu'a dû déployer celui qui a fabriqué le verre dans lequel vous buvez le vin carminé ou la douce liqueur ?"
                                            },
                                            {
                                                "example_id": "aaf3cc66-6457-4481-8137-43987bc1f2c0",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "Ils s'attablent dans de bons restaurants, se font déboucher des bouteilles de Châteauneuf-du-Pape, dégustent des liqueurs."
                                            },
                                            {
                                                "example_id": "b08e3e0d-0d96-4a43-9774-74622726f458",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "S'ensuivirent quelques mondanités sur les mérites comparés de liqueurs d'hommes. Accord autour du Rebel Yell, un rince-cochon de première, distillé parcimonieusement par des bootleggers fous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7d79fa-6025-33fa-8adc-2316c9357920",
                                        "entry_id": "be7e7eff-ff7b-338b-bdf6-1243d76d7e03",
                                        "glosses": [
                                            "Boisson gazeuse non alcoolisée."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d360c3-93ec-447f-9891-4a408773c2a8",
                                                "sense_id": "fb7d79fa-6025-33fa-8adc-2316c9357920",
                                                "text": "J’l’ai rencontrée au dépanneur\nA s’achetait une grosse liqueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3293b9ca-ccf1-45ea-8260-382e27800f63",
                        "source_entry_id": "dce6251d-4351-35c5-927c-3dfd8e2e8afb",
