                "senses": [
                    {
                        "sense_id": "91c479b7-a5ec-39ed-b38f-ca8cfc19f581",
                        "entry_id": "69f78f6e-fb23-3958-91ac-f8a261b88823",
                        "glosses": [
                            "житель или уроженец Костромы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5adfd625-5c3e-445f-9e22-b1af47f15c62",
                                "sense_id": "91c479b7-a5ec-39ed-b38f-ca8cfc19f581",
                                "text": "Барин его русский офицер из Риги, а он, солдат, родом костромич."
                            },
                            {
                                "example_id": "495ee795-f553-4c94-926f-4529e8dc4dbe",
                                "sense_id": "91c479b7-a5ec-39ed-b38f-ca8cfc19f581",
                                "text": "В группе экспертов зафиксировано преобладание негативного мнения самих костромичей о костромском говоре, в то время как, скажем, в Тамбове ситуация иная, хотя тамбовский говор в гораздо большей степени отличается от московского."
                            }
                        ]
                    }
