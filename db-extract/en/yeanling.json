                                "target_senses": [
                                    {
                                        "sense_id": "60e2469b-8af5-3ccc-99d1-1773b7efe3f5",
                                        "entry_id": "29dafd4c-3fac-36be-8e46-0153e890b57e",
                                        "glosses": [
                                            "детёныш овцы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "948b3d34-5d31-4d4d-ad00-8926784a4b12",
                                                "sense_id": "60e2469b-8af5-3ccc-99d1-1773b7efe3f5",
                                                "text": "Ягнят выпустили на луг."
                                            },
                                            {
                                                "example_id": "d1797e2c-8f81-456f-aced-d8b36f5c4541",
                                                "sense_id": "60e2469b-8af5-3ccc-99d1-1773b7efe3f5",
                                                "text": "Ягнёнок в жаркий день зашёл к ручью напиться .."
                                            },
                                            {
                                                "example_id": "4fa7cc1a-a3ab-4c58-be8d-11de3027a09e",
                                                "sense_id": "60e2469b-8af5-3ccc-99d1-1773b7efe3f5",
                                                "text": "Волчиха помнила, что летом и осенью около зимовья паслись баран и две ярки, и когда она не так давно пробегала мимо, то ей послышалось, будто в хлеву блеяли. И теперь, подходя к зимовью, она соображала, что уже март и, судя по времени, в хлеву должны быть ягнята непременно."
                                            },
                                            {
                                                "example_id": "3584cf2c-b8fe-4141-88d5-61b0c0657a6c",
                                                "sense_id": "60e2469b-8af5-3ccc-99d1-1773b7efe3f5",
                                                "text": ".. свернувшись клубком на соломенной подстилке, спал маленький чёрный ягнёнок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7756071a-8d11-3802-9e44-b9222202d19d",
                                        "entry_id": "29dafd4c-3fac-36be-8e46-0153e890b57e",
                                        "glosses": [
                                            "перен. тихий, кроткий, безобидный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0082aa4-5cc0-4cdd-8006-f64c6feb214a",
                                                "sense_id": "7756071a-8d11-3802-9e44-b9222202d19d",
                                                "text": ".. он оказался кротким, смирным ягнёнком, самым простым человеком, с добродушными шутками .."
                                            }
                                        ]
                                    }
                                ]
