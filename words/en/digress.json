{
    "word_family": [
        "digression",
        "digressive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6557cd4-7eeb-38c4-9f63-d541ddfbdda4",
                    "sense_definition": "To turn aside from the main subject of attention or course of argument in writing or speaking.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>digress</w> when telling a long story about your childhood.",
                            "target_lang_translations": {
                                "ru": "Легко <w>отклониться от темы</w>, когда рассказываешь длинную историю о своём детстве."
                            }
                        },
                        {
                            "text": "The professor would often <w>digress</w> from the lecture topic to share personal anecdotes.",
                            "target_lang_translations": {
                                "ru": "Профессор часто <w>отвлекался</w> от темы лекции, чтобы поделиться историями из жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "sidetrack",
                        "stray",
                        "divagate"
                    ],
                    "antonyms": [
                        "recur"
                    ],
                    "common_phrases": [
                        "digress from topic",
                        "briefly digress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняться от главной темы, сути разговора или хода рассуждения в устной или письменной речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклоняться",
                                "target_lang_sense_clarification": "от темы разговора, сути дела"
                            },
                            {
                                "target_lang_word": "отвлекаться",
                                "target_lang_sense_clarification": "терять фокус, переключаться на постороннее"
                            },
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "делать отступление от темы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bf0c025-dabc-35ea-9034-c4c685222832",
                    "sense_definition": "To turn aside from the right path or to transgress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king warned his subjects not to <w>digress</w> from the moral laws of the land.",
                            "target_lang_translations": {
                                "ru": "Король предостерёг своих подданных от того, чтобы они <w>отступали</w> от нравственных законов государства."
                            }
                        },
                        {
                            "text": "He felt that his actions caused him to <w>digress</w> from the path of righteousness.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что его поступки заставили его <w>сбиться</w> с пути праведности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбиваться с истинного пути, нарушать моральные или религиозные нормы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "от правил, закона или морали"
                            },
                            {
                                "target_lang_word": "сбиваться с пути",
                                "target_lang_sense_clarification": "сходить с праведной дороги"
                            },
                            {
                                "target_lang_word": "согрешать",
                                "target_lang_sense_clarification": "нарушать заповеди"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}