                        "glosses": [
                            "einteiliges, enganliegendes Kleidungsstück, das auch die Beine bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75d1253-4982-4eeb-bbd9-802726a5e025",
                                "sense_id": "03c47c19-e9b4-3f07-a68f-3cb0a46d9f46",
                                "text": "„Aus Nylon oder Netzstoffen bestehende Catsuits haben einen ähnlichen optischen Effekt wie Strümpfe, bedecken aber neben den Beinen häufig auch den ganzen Körper.“"
                            },
                            {
                                "example_id": "02ee1c22-11b5-450f-8fad-b746b2904518",
                                "sense_id": "03c47c19-e9b4-3f07-a68f-3cb0a46d9f46",
                                "text": "„Dietrich kriegt nichts mit, weil er ganz im Bann einer jungen Frau im hautengen Catsuit steht.“"
                            }
                        ],
