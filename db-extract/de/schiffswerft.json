                        "source_sense_id": "51171ce4-d5e7-3b7e-83e2-9d1af6358e72",
                        "source_sense_description": "Industrieanlage zum Bauen und Reparieren von Schiffen",
                        "target_lang_word": "dockyard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dockyard",
