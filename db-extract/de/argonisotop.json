                "senses": [
                    {
                        "sense_id": "859a138a-395b-33f9-a549-0435220ed832",
                        "entry_id": "b1915012-68c7-39a4-9998-c4f1146af35c",
                        "glosses": [
                            "Variante eines Argonatoms mit einer spezifischer Massenzahl"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c35e03-cc13-4538-83c5-37b6d6dc60d5",
                                "sense_id": "859a138a-395b-33f9-a549-0435220ed832",
                                "text": "„In der irdischen Atmosphäre ist das Argonisotop 40 sowohl relativ zu den anderen Argonisotopen als auch relativ zu den anderen Edelgasen um etwa einen Faktor 3·10⁴ zu häufig.“"
                            },
                            {
                                "example_id": "896e3f32-412e-4d79-9232-325a4bd5570b",
                                "sense_id": "859a138a-395b-33f9-a549-0435220ed832",
                                "text": "„Um bei diesen Untersuchungen das Argonisotop mit der Masse 40 auszuschalten, verwendete NIER eine niedrige Ionisationsspannung von 7,5 V.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
