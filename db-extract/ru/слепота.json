                "senses": [
                    {
                        "sense_id": "213a6f41-be78-353a-a593-6472b6c5b367",
                        "entry_id": "5475d6d1-707d-3ea4-97c0-683b3ce4f9f4",
                        "glosses": [
                            "отсутствие или нарушение зрения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2559fcfc-37b8-40dd-bcc8-1581c57ab102",
                                "sense_id": "213a6f41-be78-353a-a593-6472b6c5b367",
                                "text": "Слепота наступила вследствие повреждения глаз."
                            }
                        ]
                    },
                    {
                        "sense_id": "40fe3601-f1a7-3128-ad07-799c17fbd685",
                        "entry_id": "5475d6d1-707d-3ea4-97c0-683b3ce4f9f4",
                        "glosses": [
                            "перен. игнорирование очевидного решения проблемы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe61e569-e36b-46ef-a8e8-5104931c3ac5",
                                "sense_id": "40fe3601-f1a7-3128-ad07-799c17fbd685",
                                "text": "В своей политической слепоте руководство национального лагеря упорно игнорирует главное достижение августовской революции."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "783c7c82-6770-4be4-b9c9-e343114ea5e0",
                        "source_entry_id": "5475d6d1-707d-3ea4-97c0-683b3ce4f9f4",
                        "target_lang_word": "blindness",
