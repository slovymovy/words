                "senses": [
                    {
                        "sense_id": "5f64471e-3574-3dcc-9b53-a165c6f55c5e",
                        "entry_id": "c1dbcae0-ef89-32cf-a047-4baef2844571",
                        "glosses": [
                            "deutsche Bezeichnung für Euphemismus, also für einen beschönigenden Ausdruck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849298ae-a606-4ffb-95f6-f8f4769f729b",
                                "sense_id": "5f64471e-3574-3dcc-9b53-a165c6f55c5e",
                                "text": "„Nach Hüllwörtern wie Striptease und Callgirl wird heute auch Appartementhaus gelegentlich beschönigend gebraucht…“"
                            },
                            {
                                "example_id": "e1c37007-2d40-4c9f-8837-247f74e68d0f",
                                "sense_id": "5f64471e-3574-3dcc-9b53-a165c6f55c5e",
                                "text": "„…; bei Leopold von Sacher-Masoch (1836-1895) gibt es in »Venus im Pelz« mehrere Stellen, in denen ‚Schoß‘ als Hüllwort benutzt wird…“"
                            },
                            {
                                "example_id": "ae3d2d5e-aff0-4336-967d-da679890b8b8",
                                "sense_id": "5f64471e-3574-3dcc-9b53-a165c6f55c5e",
                                "text": "„Im Mittelalter zeugen Euphemismen, Hüllwörter, davon, daß man sich scheute, Dinge beim Namen zu nennen, um nicht von ihnen gestraft zu werden.“"
                            },
                            {
                                "example_id": "3d1e9e27-b55c-4145-b052-13a3a1062b8c",
                                "sense_id": "5f64471e-3574-3dcc-9b53-a165c6f55c5e",
                                "text": "„In solchen Fällen werden gerne verhüllende Wörter (Hüllwörter oder Euphemismen) verwendet (…).“"
                            },
                            {
                                "example_id": "2a6b457d-c153-4506-8d94-076d76e4deab",
                                "sense_id": "5f64471e-3574-3dcc-9b53-a165c6f55c5e",
                                "text": "„Ein eigenartiges Schillern zwischen unerkannter Sprachverführung und gewollter Täuschung ist den Hüllwörtern oder Euphemismen eigen.“"
                            },
                            {
                                "example_id": "42796c4d-ca42-45c3-bfc0-96fd908f676f",
                                "sense_id": "5f64471e-3574-3dcc-9b53-a165c6f55c5e",
                                "text": "„Schon im 15. Jahrhundert diente der Begriff als so genanntes Hüllwort für eine Berufsbezeichnung, die man auch heute noch gern mit Tarnwörtern verschleiert: eine Sexualarbeiterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
