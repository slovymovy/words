                    },
                    {
                        "form_id": "b2237229-9532-4e45-82dd-71473e917b17",
                        "entry_id": "18704662-d2c2-37d6-8c29-bc71229f938b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "féodales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d27ad67f-cb19-31ae-acd6-8917aabb738a",
                        "entry_id": "18704662-d2c2-37d6-8c29-bc71229f938b",
                        "glosses": [
                            "Qui appartient à un fief, qui concerne un fief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66d156a-5fce-4fd5-96e5-b09f034341e9",
                                "sense_id": "d27ad67f-cb19-31ae-acd6-8917aabb738a",
                                "text": "Droit féodal. - En matière féodale."
                            }
                        ]
                    },
                    {
                        "sense_id": "61da36dc-0335-3b17-962c-518b98e331c6",
                        "entry_id": "18704662-d2c2-37d6-8c29-bc71229f938b",
                        "glosses": [
                            "Qui concerne les usages, les coutumes, la société de la féodalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086e21db-8ffc-4c1d-9236-ae3b9b2b9775",
                                "sense_id": "61da36dc-0335-3b17-962c-518b98e331c6",
                                "text": "Nous ne pouvons pas, quant à nous, suivre le Père Schneider dans cette voie ultra-personnalisante et, à notre sens, féodale, des « puissances politiques »."
                            },
                            {
                                "example_id": "456f4617-5c60-47ae-9b13-3b59f9a94fab",
                                "sense_id": "61da36dc-0335-3b17-962c-518b98e331c6",
                                "text": "D’une unité et d’une simplicité plus larges que celles de l’Empire romain, le monde passa, d’un seul coup, à une fragmentation aussi complète que celle du moyen–âge, à la période des seigneurs féodaux, brigands et pillards."
                            },
                            {
                                "example_id": "fd64d22e-df9b-420a-9d4c-db0e9986f997",
                                "sense_id": "61da36dc-0335-3b17-962c-518b98e331c6",
                                "text": "De temps en temps, ces potentats féodaux européens s'unissaient contre les musulmans pillards."
                            },
                            {
                                "example_id": "f46bc93f-9075-42c7-b98c-b134b2328ee2",
                                "sense_id": "61da36dc-0335-3b17-962c-518b98e331c6",
                                "text": "Cette association du politique et du religieux perpétua, jusqu’au milieu du XXᵉ siècle, un système féodal abusif entretenu par la noblesse et les moines."
                            },
                            {
                                "example_id": "16127372-1dd2-440c-b6b1-07dbaf6dbc0f",
                                "sense_id": "61da36dc-0335-3b17-962c-518b98e331c6",
                                "text": "Tandis que la guerre et la peste font éclater les cadres féodaux, ceux de la guilde et de la corporation deviennent, eux aussi, trop étroits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad082e55-14d1-4224-ad00-4f5fc59ae5ee",
                        "source_entry_id": "18704662-d2c2-37d6-8c29-bc71229f938b",
                        "target_lang_word": "feudal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feudal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cfd6c18-77b0-3c7f-872e-5262e46bc8b4",
                                        "entry_id": "efa0a7dd-f58e-36ea-8da9-5df246be8d6c",
                                        "glosses": [
                                            "Of, or relating to feudalism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a514063e-b750-4ac7-9580-2f6953b39498",
                                                "sense_id": "0cfd6c18-77b0-3c7f-872e-5262e46bc8b4",
                                                "text": "And the birth of nations implies many artifices: Not only are they constituted in an active struggle against the imperial or evolved systems, the feudal systems, and the autonomous cities, but they crush their own \"minorities,\" in other words, minoritarian phenomena that could be termed \"nationalitarian,\" which work from within and if need be turn to the old codes to find a greater degree of freedom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
