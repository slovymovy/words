                "senses": [
                    {
                        "sense_id": "428f7a91-bc3a-3f79-a814-beb82ce9ddde",
                        "entry_id": "21615735-bb11-30d0-9a11-e88db4b5476d",
                        "glosses": [
                            "Être premier ministre de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5108ec8-0241-4151-8b0f-b5659a9088dd",
                                "sense_id": "428f7a91-bc3a-3f79-a814-beb82ce9ddde",
                                "text": "Stephen Harper doit « premier-ministrer » un pays, Mario Dumont, s’il est élu, n’aura qu’à « premier-ministrer » une province."
                            },
                            {
                                "example_id": "87fb5e9c-e343-40a7-9c82-4b979163e348",
                                "sense_id": "428f7a91-bc3a-3f79-a814-beb82ce9ddde",
                                "text": "Il ne peut pas premier-ministrer la Belgique sans le soutien de Kabila."
                            }
                        ]
                    },
                    {
                        "sense_id": "27f7445b-a4e0-3ca5-b769-1fd28eaae5c1",
                        "entry_id": "21615735-bb11-30d0-9a11-e88db4b5476d",
                        "glosses": [
                            "Nommer premier ministre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45245f12-c6e3-4f02-9353-bb614a673acc",
                                "sense_id": "27f7445b-a4e0-3ca5-b769-1fd28eaae5c1",
                                "text": "Rien de mieux que « premier-ministrer » quelqu’un pour le griller quelque temps."
                            },
                            {
                                "example_id": "8774bc12-2e76-4d1b-b65f-8fddeed0d917",
                                "sense_id": "27f7445b-a4e0-3ca5-b769-1fd28eaae5c1",
                                "text": "Lui l’élu de circonstance, arriviste du pouvoir pour un mandat de 5 ans, démocrate prétendu qui s’éternise au nom d’accords bidons jusqu’à premier-ministrer un va-nu-pied comme Soro, à accepter l’arbitrage de celui qu’il désignait — dans sa xénophobie raciste et opportuniste exacerbée — comme son véritable ennemi, le président burkinabè."
                            }
                        ]
                    }
