                ],
                "translations": [
                    {
                        "translation_id": "d7df1056-5c1b-4f06-bd22-cf177a3edc52",
                        "source_entry_id": "d1aa9035-cfc2-3f3d-af23-6cce7622899f",
                        "source_sense_description": "страдающий заболеванием нервной системы",
                        "target_lang_word": "neurotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e14399c-ad90-32ef-a1ac-5a1b3cc85228",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Affected with a neurosis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45d3370b-5c11-40f3-8e8e-1405fa95cb7d",
                                                "sense_id": "0e14399c-ad90-32ef-a1ac-5a1b3cc85228",
                                                "text": "If there were such a thing as inspiration from a higher realm, it might well be that the neurotic temperament would furnish the chief condition of the requisite receptivity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Overly anxious."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f1edc2a-2160-4e5e-a3e2-55a840e06159",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "He is getting neurotic about time-keeping."
                                            },
                                            {
                                                "example_id": "e7ada65e-4d13-4587-b2da-cb9c64394a06",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers, the worn-out, passionless men,[…], the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosis,[…]!”"
                                            },
                                            {
                                                "example_id": "1a2a1df2-f3ff-4d01-87b3-20bd0d962dd0",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "“You did come down a wallop, didn't you? How art thou fallen from heaven, oh Lucifer, son of the morning, I said to myself. You're so terribly neurotic, Bertie. You must try to be less jumpy. What you need is a good nerve tonic.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4809abb0-05c2-3289-89b2-c6566f7a0210",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Useful in disorders of, or affecting, the nerves."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "neurotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf7508b-6506-32fa-b185-85a68db4be36",
                                        "entry_id": "85fe07bd-c171-3ba1-a4a3-5093133ab952",
                                        "glosses": [
                                            "A person who has a neurosis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17723cb8-4a60-3bde-9b84-7480b0636291",
                                        "entry_id": "85fe07bd-c171-3ba1-a4a3-5093133ab952",
                                        "glosses": [
                                            "A crazy person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9706d1a-63fc-450e-8983-8723c31c8c7c",
                                                "sense_id": "17723cb8-4a60-3bde-9b84-7480b0636291",
                                                "text": "Drag this neurotic to hysterics, leave him balked and unfulfilled;\nholding inside, outwardly patient 'til the time he'll call it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
