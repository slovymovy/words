                        "glosses": [
                            "Qui a un parlement constitué d’une seule assemblée législative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b1b343-82ca-4e01-8b64-6f82e9fd935f",
                                "sense_id": "f46ea5af-5a53-33fa-afe2-c9e89c6a083d",
                                "text": "Après l'adoption du régime monocamériste, le 10 septembre 1789, le premier comité de constitution, composé de « traditionalistes » fut profondément modifié."
                            },
                            {
                                "example_id": "bf79d3b5-5105-44ba-a8e6-17991ada4092",
                                "sense_id": "f46ea5af-5a53-33fa-afe2-c9e89c6a083d",
                                "text": "Le Sénégal se distingue encore par son régime monocamériste. Sur ce plan, le pays se trouve dans la même situation que les autres anciennes colonies françaises d'Afrique."
                            },
                            {
                                "example_id": "d5cbf67f-96a0-4ffd-8ca0-5722e8ecd0e9",
                                "sense_id": "f46ea5af-5a53-33fa-afe2-c9e89c6a083d",
                                "text": "Sur 180 États dotés, dans le monde actuel, d'une représentation parlementaire, 122 sont monocaméristes et 58 bicaméristes."
                            }
                        ]
                    }
