                "translations": [
                    {
                        "translation_id": "cb6641c7-60ea-4781-b709-46b3a7173406",
                        "source_entry_id": "2ef218ce-a1eb-33d6-850d-3de913379203",
                        "source_sense_id": "f98f7d93-a178-398e-8408-39d2e34a244e",
                        "source_sense_description": "het bevestigende antwoord op een huwelijksaanzoek",
                        "target_lang_word": "Jawort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jawort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19ced4d7-d0dc-3f4f-bef2-6899d964305a",
                                        "entry_id": "1c1ac8ec-e0d9-3ce0-9162-57dcfbb70a31",
                                        "glosses": [
                                            "allgemeine Äußerung der Einwilligung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c412b51-ae69-400d-9ba2-e2ff121e9ada",
                                                "sense_id": "19ced4d7-d0dc-3f4f-bef2-6899d964305a",
                                                "text": "Der Teufel verlangte deine Seele und er hat dein Jawort gewonnen."
                                            },
                                            {
                                                "example_id": "3d1ab10d-a577-4d07-866a-44e270b4de87",
                                                "sense_id": "19ced4d7-d0dc-3f4f-bef2-6899d964305a",
                                                "text": "„Ich hatte mein Jawort gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "817e9041-f396-309e-a51f-0352dcfc5755",
                                        "entry_id": "1c1ac8ec-e0d9-3ce0-9162-57dcfbb70a31",
                                        "glosses": [
                                            "Äußern der Zustimmung zur Schließung der Ehe insbesondere vonseiten der Braut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0621bb9b-44b6-4b26-a02f-9a3a6341906d",
                                                "sense_id": "817e9041-f396-309e-a51f-0352dcfc5755",
                                                "text": "Nachdem Henner über zwanzig Jahre auf Elses Jawort gewartet hatte, kam es endlich zur Hochzeit."
                                            },
                                            {
                                                "example_id": "3b999014-3e40-4820-9b29-e3bc8d58c167",
                                                "sense_id": "817e9041-f396-309e-a51f-0352dcfc5755",
                                                "text": "„Und er erteilte sein väterliches Jawort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "831270df-bcce-4769-9f00-f5d15f41b24d",
                        "source_entry_id": "2ef218ce-a1eb-33d6-850d-3de913379203",
                        "source_sense_id": "f98f7d93-a178-398e-8408-39d2e34a244e",
