    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f80954fb-8e32-360d-88e6-261b3b584e54",
                    "sense_definition": "To decrease in force or intensity; to subside.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We waited in the shelter for several hours until the storm began to <w>abate</w>.",
                            "target_lang_translations": {
                                "cs": "Čekali jsme v úkrytu několik hodin, dokud bouře nezačala <w>polevovat</w>.",
                                "ru": "Мы прождали в убежище несколько часов, пока буря не начала <w>стихать</w>."
                            }
                        },
                        {
                            "text": "As the fever started to <w>abate</w>, the patient finally fell into a peaceful sleep.",
                            "target_lang_translations": {
                                "cs": "Jakmile horečka začala <w>ustupovat</w>, pacient konečně upadl do klidného spánku.",
                                "ru": "Когда жар начал <w>спадать</w>, пациент наконец погрузился в спокойный сон."
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "ebb",
                        "slacken",
                        "soften",
                        "wane",
                        "decrease",
                        "lessen"
                    ],
                    "antonyms": [
                        "increase",
                        "intensify"
                    ],
                    "common_phrases": [
                        "storm began to abate",
                        "wind abated"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ztrácet na síle nebo intenzitě; ustupovat.",
                        "ru": "Уменьшаться по силе или интенсивности; стихать, ослабевать."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "polevit",
                                "target_lang_sense_clarification": "snížit svou intenzitu (např. bouře, bolest)"
                            },
                            {
                                "target_lang_word": "zeslábnout",
                                "target_lang_sense_clarification": "ztratit na síle"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "утихать",
                                "target_lang_sense_clarification": "о буре, ветре, шуме"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "терять силу, напряжённость"
                            },
                            {
                                "target_lang_word": "спадать",
                                "target_lang_sense_clarification": "об интенсивности, жаре, температуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "190179b0-04dc-3338-aa01-f83127eff4e7",
                    "sense_definition": "To lessen (something) in force or intensity; to moderate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decrease_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nothing could <w>abate</w> his anger after he discovered the truth.",
                            "target_lang_translations": {
                                "cs": "Nic nemohlo <w>zmírnit</w> jeho hněv poté, co zjistil pravdu.",
                                "ru": "Ничто не могло <w>умерить</w> его гнев после того, как он узнал правду."
                            }
                        },
                        {
                            "text": "The new medicine helped to <w>abate</w> the severe pain in her joints.",
                            "target_lang_translations": {
                                "cs": "Nový lék pomohl <w>ztlumit</w> silnou bolest v jejích kloubech.",
                                "ru": "Новое лекарство помогло <w>облегчить</w> сильную боль в суставах."
                            }
                        }
