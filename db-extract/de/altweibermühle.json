                "senses": [
                    {
                        "sense_id": "899e81c8-f79a-360d-9e21-5559b29c361f",
                        "entry_id": "11ba47fa-931e-30ce-a1f6-74a3e952b7a3",
                        "glosses": [
                            "Mühle, in der auf magische Weise alte Weiber wieder zu jungen Frauen werden"
                        ],
                        "tags": [
                            "Volkskunde"
                        ],
                        "examples": [
                            {
                                "example_id": "870c8702-4d63-4b9c-b1fe-483c30606be5",
                                "sense_id": "899e81c8-f79a-360d-9e21-5559b29c361f",
                                "text": "„Heimlich träumen wir noch von Altweibermühlen und Jungbrunnen, wie sie Lucas Cranach und Hans Sebald Beham gemalt haben.“"
                            },
                            {
                                "example_id": "b961e325-53e3-431e-948c-edac1634c4d9",
                                "sense_id": "899e81c8-f79a-360d-9e21-5559b29c361f",
                                "text": "„So hatte der Kleinwender Kirmesverein seine Altweibermühle nach über 15 Jahren das erste Mal wieder flottgemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
