                "senses": [
                    {
                        "sense_id": "ca673a29-b5f7-3404-95c3-e3425e4090d3",
                        "entry_id": "bf13820f-df0d-320d-bc68-9928c334b565",
                        "glosses": [
                            "Qui est opposé au puritanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c092049-97cf-497a-bd3c-9071e209811e",
                                "sense_id": "ca673a29-b5f7-3404-95c3-e3425e4090d3",
                                "text": "Pour information, cette série caustique, antipuritaine, antibeauf, anti-tout ce que l’Américain moyen peut avoir de pénible a réalisé des scores d’audience presque équivalents à X-Files sur la chaîne Fox."
                            },
                            {
                                "example_id": "ddca3bea-5f2b-4032-a0e2-5482337604eb",
                                "sense_id": "ca673a29-b5f7-3404-95c3-e3425e4090d3",
                                "text": "Alors les musiques antipuritaines s’épanouirent : et avec elles « le duel, l’escroquerie et le pillage devinrent bientôt les lettres de noblesse du parfait gentleman »."
                            },
                            {
                                "example_id": "ba4b7fe3-f903-4f13-a993-347125a35fe0",
                                "sense_id": "ca673a29-b5f7-3404-95c3-e3425e4090d3",
                                "text": "Je pense par exemple à ces poètes antipuritains de l’Angleterre du XVIIe siècle."
                            }
                        ]
                    }
                ],
