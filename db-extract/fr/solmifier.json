                        "examples": [
                            {
                                "example_id": "afea2c97-2b14-4f16-bec9-409f0e6cd94f",
                                "sense_id": "d65740b8-e5d7-388b-90b1-7bf25afaa898",
                                "text": "D'autres tentatives de syllabisation, à peu près contemporaines, ou même postérieures, prouvent que les théoriciens étaient à la recherche d'une manière commode de « solmifier » le chant."
                            },
                            {
                                "example_id": "749f7400-8605-4053-b2f5-b9a4eb27f427",
                                "sense_id": "d65740b8-e5d7-388b-90b1-7bf25afaa898",
                                "text": "Pouvons-nous interpréter ces signes comme donnant la possibilité de solmifier ces canons per b mollem et per b durum ?"
                            }
                        ]
