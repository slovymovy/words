                "senses": [
                    {
                        "sense_id": "e13b3e78-21fa-3ebd-872c-7157bec0b302",
                        "entry_id": "c117c371-99e7-38a3-9942-44eaae768a65",
                        "glosses": [
                            "zu einer Reihe von Impfungen, die erst in ihrer Gesamtheit die gewünschte Immunität erzeugen, gehörende Impfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd4142a-9257-4aec-8a7b-db21309a4de9",
                                "sense_id": "e13b3e78-21fa-3ebd-872c-7157bec0b302",
                                "text": "„In Österreich basiert die Impfkampagne bisher auf den mRNA-Vakzinen und jenem von Astra Zeneca – jeweils mit zwei Teilimpfungen.“"
                            },
                            {
                                "example_id": "835d52a6-2a49-44f2-a246-1332c922dbf5",
                                "sense_id": "e13b3e78-21fa-3ebd-872c-7157bec0b302",
                                "text": "„Zehn Tage zuvor hatte sie eine erste Teilimpfung erhalten.“"
                            },
                            {
                                "example_id": "23effd5d-7df2-4980-a851-5bd7308c8c60",
                                "sense_id": "e13b3e78-21fa-3ebd-872c-7157bec0b302",
                                "text": "„Nach Angaben der Weltgesundheitsorganisation WHO und des rumänischen Gesundheitsministeriums ist die Durchimpfungsrate für die erste Teilimpfung im Laufe der vergangenen zehn Jahre um 11 Prozent und für die zweite Teilimpfung um 29 Prozent gesunken.“"
                            }
                        ],
