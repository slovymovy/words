                    },
                    {
                        "translation_id": "5dff1f16-29a6-46d8-884f-3a9818c09d7c",
                        "source_entry_id": "e6316253-8ad0-31a8-abf2-da39b74105fb",
                        "source_sense_description": "characteristic of being ridiculous",
                        "target_lang_word": "ridiculité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ridiculité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d863684-cdae-3c9f-a090-732a9b1965b4",
                                        "entry_id": "00a946e9-d865-36e9-a7e4-b9a6e85252c4",
                                        "glosses": [
                                            "Action ou parole ridicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19719fac-8e3c-47ef-879b-ef3cc216b256",
                                                "sense_id": "1d863684-cdae-3c9f-a090-732a9b1965b4",
                                                "text": "Quelle ridiculité de dire que nous devons tout faire pour la plus grande gloire de Dieu ?"
                                            },
                                            {
                                                "example_id": "36f48120-146a-4834-b773-560fe3d27cf2",
                                                "sense_id": "1d863684-cdae-3c9f-a090-732a9b1965b4",
                                                "text": "Du Bruel est petit-fils d’un traitant anobli sur la fin du règne de Louis XIV, ses armes ont été composées par Chérin et la couronne Comtale ne messied pas à ce blason, qui n’offre aucune des ridiculités impériales."
                                            },
                                            {
                                                "example_id": "786d9105-81cd-4d29-9736-ecb00fdc167a",
                                                "sense_id": "1d863684-cdae-3c9f-a090-732a9b1965b4",
                                                "text": "Non, monsieur, de l’entêtement ! dit la baronne en l’interrompant pour en finir avec cette ridiculité."
                                            },
                                            {
                                                "example_id": "a6953206-1d68-4075-8347-a140479b912d",
                                                "sense_id": "1d863684-cdae-3c9f-a090-732a9b1965b4",
                                                "text": "Enfin il me dit cent ridiculités que je ne prendrais pas la peine de coucher par écrit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d283417-c516-365f-821b-764ed468ca47",
                                        "entry_id": "00a946e9-d865-36e9-a7e4-b9a6e85252c4",
                                        "glosses": [
                                            "Caractère de ce qui est ridicule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90fdbd8e-ba71-454d-855d-83a4bd3b155e",
                        "source_entry_id": "e6316253-8ad0-31a8-abf2-da39b74105fb",
                        "source_sense_description": "characteristic of being ridiculous",
                        "target_lang_word": "Lächerlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lächerlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7070c32-1b5a-3154-a3fa-bf38fc86b189",
                                        "entry_id": "02e92f8c-75a9-353b-9697-3ad473588cfe",
                                        "glosses": [
                                            "Eigenschaft, lächerlich zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4b6a6b-5561-4eef-99ef-ebb720989c53",
                                                "sense_id": "d7070c32-1b5a-3154-a3fa-bf38fc86b189",
                                                "text": "„Nichts tötet schneller als Lächerlichkeit.“"
                                            },
                                            {
                                                "example_id": "a532296e-fad7-4587-a928-7a74d0786f8f",
                                                "sense_id": "d7070c32-1b5a-3154-a3fa-bf38fc86b189",
                                                "text": "„Die Lächerlichkeit der Situation entgeht Hoffmann nicht; keinerlei Lächerlichkeit ist ihm jemals entgangen, und im gleichen Sinn wie Sterne ist er ein wahrhafter Barde des Grotesken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63f94d3e-118c-3d12-ac69-dcec118c78a2",
                                        "entry_id": "02e92f8c-75a9-353b-9697-3ad473588cfe",
                                        "glosses": [
                                            "etwas, das lächerlich ist; lächerliche Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c09033d-a7bd-4882-800a-dbbfa38c45a7",
                                                "sense_id": "63f94d3e-118c-3d12-ac69-dcec118c78a2",
                                                "text": "»Ich will aber nicht, daß er an mir Lächerlichkeiten bemerkt.«"
                                            },
                                            {
                                                "example_id": "49bc9335-45f4-44e5-ac5d-af7402abe474",
                                                "sense_id": "63f94d3e-118c-3d12-ac69-dcec118c78a2",
                                                "text": "Wenn man Achilles mit seinen Lächerlichkeiten zeichnet […], dann darf man ihn auch körperlich nur halbstark machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
