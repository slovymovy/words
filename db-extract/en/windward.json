                                        "glosses": [
                                            "in Richtung der dem Wind zuwandten Seite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac0d861-eb19-446a-a728-6a94ab386431",
                                                "sense_id": "a81bedd8-1f6c-33bc-b143-8c6aa760d047",
                                                "text": "„Rundum drehten sich die Speichen, und die »Julia« mit ihrem kurzen Kiel schwang sich luvwärts, wie sich ein Wimpel dreht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f0c62505-b22d-3d47-9714-f73c3bdc5087",
                                        "entry_id": "6569224e-0e72-3aaa-add0-f1f6543fe876",
                                        "glosses": [
                                            "sich auf der dem Wind zuwandten Seite befindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c05618-e4dc-4798-8101-ebf8dfd4b84f",
                                                "sense_id": "f0c62505-b22d-3d47-9714-f73c3bdc5087",
                                                "text": "„Es war dies ein Schiff, das in schräger Richtung auf sie lossteuerte und sich kaum noch eine halbe Seemeile luvwärts befand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
