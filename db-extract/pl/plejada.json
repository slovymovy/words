                "senses": [
                    {
                        "sense_id": "8e654322-3ad1-30c5-a0c7-0d00a36892bd",
                        "entry_id": "5d4c50c8-b72a-32ec-80af-089d64040c96",
                        "glosses": [
                            "każda z siedmiu nimf, córek Atlasa, które zostały przeniesione na firmament jako otwarta gromada gwiazd w gwiazdozbiorze Byka, zwana Plejadami"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "04f422fa-62ed-43ea-8932-4da3329fb4f8",
                                "sense_id": "8e654322-3ad1-30c5-a0c7-0d00a36892bd",
                                "text": "Plejady były córkami tytana Atlasa i okeanidy Plejone oraz siostrami Hiad i Hesperyd."
                            },
                            {
                                "example_id": "9e0d9a52-b48b-445c-9341-0771b57e5e64",
                                "sense_id": "8e654322-3ad1-30c5-a0c7-0d00a36892bd",
                                "text": "Mityczne Plejady są identyfikowane z Plejadami w gwiazdozbiorze Byka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
