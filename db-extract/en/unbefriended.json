                        "examples": [
                            {
                                "example_id": "3b9dff97-80cd-4868-a409-4ed94317b24a",
                                "sense_id": "67f3f34a-6cbe-3077-afc6-b2da44de789b",
                                "text": "I found him, lonely and unbefriended, the very next night after our talk, at the Dugald Delane's dinner."
                            },
                            {
                                "example_id": "29921444-82a0-4ec8-bdb1-e4c5e6cba362",
                                "sense_id": "67f3f34a-6cbe-3077-afc6-b2da44de789b",
                                "text": "But the Lord of Men allowed me to behold\nan ancient sword shining on the wall -\nfor he often helps the unbefriended -\na weapon made for giants, there for the wielding."
                            }
                        ]
                    }
