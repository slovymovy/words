                            {
                                "example_id": "0963a1da-d671-4559-aad5-8cd95ed52dc5",
                                "sense_id": "5885ef5f-f598-3f2a-8ee5-d549f1a355bb",
                                "text": "Forth issuing on a Summers Morn to breathe / Among the pleasant Villages and Farmes / Adjoind, from each thing met conceaves delight, / The smell of Grain, or tedded Grass, or Kine […]."
                            },
                            {
                                "example_id": "a8436eda-087e-41bd-bdf3-c86c2df97690",
                                "sense_id": "5885ef5f-f598-3f2a-8ee5-d549f1a355bb",
                                "text": "Wide flies the tedded grain; all in a row / Advancing broad, or wheeling round the field, / They spread the breathing harvest to the sun […]."
                            }
                        ]
                    }
