                ],
                "senses": [
                    {
                        "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                        "entry_id": "f2495a5f-9b4c-3355-9eba-5cf30db6cebf",
                        "glosses": [
                            "(menschliche) Nutzung dann nicht mehr naturbelassener Flächen, beispielsweise als Siedlungsfläche, Verkehrsfläche, im Tagebau, in der Landwirtschaft"
                        ],
                        "tags": [
                            "Stadtplanung",
                            "Raumordnung",
                            "Umwelt",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "eb5d1444-a445-4756-9f84-040e8caa4a11",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„In Deutschland wird jeden Tag eine Fläche von 100 Fußballfeldern verbaut. Der Flächenverbrauch zerstört Landschaften und schadet dem Klima.“"
                            },
                            {
                                "example_id": "743dba60-7c75-498c-b7e1-fc3abbbea74d",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Deutschlandweit liegt der Flächenverbrauch, also die Umwandlung von landwirtschaftlichen oder naturbelassenen Flächen in Siedlungs- und Verkehrsfläche, bei täglich zwischen 50 und 60 Hektar - doppelt so hoch, wie die Bundesregierung 2018 als Ziel ausgegeben hatte.“"
                            },
                            {
                                "example_id": "4403db96-4070-4443-8a98-9b8c03467851",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„15 Fußballfelder, Tag für Tag. Der Flächenverbrauch und die damit einhergehende Bodenversiegelung in Bayern ist ein Riesenproblem.“"
                            },
                            {
                                "example_id": "861605d2-badc-46e8-8047-eec692798bae",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Neben dem Wohnbau sind die Gewerbeflächen immer noch der zweitgrößte Faktor für den Flächenverbrauch in Bayern.“"
                            },
                            {
                                "example_id": "4a80647e-538c-46be-8f86-dfea2f5f31c8",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Einen weiteren Schwerpunkt will die neue Regierung auf die Umweltpolitik legen und etwa den Flächenverbrauch deutlich senken.“"
                            },
                            {
                                "example_id": "f001dc25-1ff2-4cd2-961e-5936a75d3a46",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Der Flächenverbrauch im Raum Bodensee-Oberschwaben hat in den vergangenen 20 Jahren um rund 8.000 Hektar zugenommen. Das entspricht mehr als 11.000 Fußballfeldern.“"
                            },
                            {
                                "example_id": "2b2bf11d-1b6d-4de4-9000-aaa1161b392f",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Der Flächenverbrauch in Bayern steigt, obwohl die Staatsregierung sich eigentlich zum Ziel gesetzt hat, ihn zu senken.“"
                            },
                            {
                                "example_id": "18bc0b53-57f5-4f83-9436-c681e049921b",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "[Um dem Zubetonieren und Asphaltieren wertvollen Bodens] „gegenzusteuern hat sich die Bundesregierung in ihrer Nachhaltigkeitsstrategie aus dem Jahr 2002 das Ziel gesetzt, den Flächenverbrauch bis 2020 auf 30 Hektar pro Tag zu begrenzen.“"
                            },
                            {
                                "example_id": "1e1e5f74-822e-41d3-99d5-fdfb285082f4",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "[Braunkohletagebau:] „Durch den großen Flächenverbrauch, der das Siedlungs-, Flur- und Verkehrsgefüge vollkommen verändert, ist die Ausweitung der Tagebaue häufig umstritten.“"
                            },
                            {
                                "example_id": "14859864-b2d4-4a7a-b55b-c42824a65f39",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Ein zentrales Problem ist der immense Flächenverbrauch für die Fleischproduktion.“"
                            },
                            {
                                "example_id": "a96d7e3e-5c43-4688-8ecb-a3d216f44bc4",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Demnach verursacht ein Kilogramm brasilianisches Rindfleisch dieselben Treibhausgas-Emissionen wie eine Autofahrt von 1600 Kilometern in einem Mittelklassewagen. Schuld ist der hohe Flächenverbrauch der Nutztierhaltung.“"
                            },
                            {
                                "example_id": "067d407c-b7f5-462d-9863-9f9b81663551",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Nicht nur Energiepflanzen stehen angesichts der angespannten Welternährungslage in der Kritik, auch der Flächenverbrauch für den Anbau von Tierfutter.“"
                            },
                            {
                                "example_id": "3c93a9d2-bdde-4d0d-94cc-0944b799cba7",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Vergleicht man eine Tasse Tee mit einer Tasse Kaffee, dann ist die Ökobilanz des Tees mindestens drei- bis viermal besser – je nachdem, wie man die einzelnen Aspekte gewichtet. Schaut man sich zum Beispiel den Flächenverbrauch an, dann schneidet die Herstellung von Tee deutlich besser ab.“"
                            },
                            {
                                "example_id": "6348a218-f639-4d55-9eaf-e451a20aab8e",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "[Palmöl:] „Das schlechte Image der Ölpalme entstand sicherlich durch den massiven Anbau auf großen Plantagen durch Großkonzerne. Wenn man sich aber den Flächenverbrauch ansieht, dann ist er zu einem Großteil Kleinbauern zuzuschreiben.“"
                            },
                            {
                                "example_id": "f93f98d7-9869-4131-a58c-4a48e3558eb9",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Außerdem würde der eigene Pkw unattraktiver werden, wenn die Fahrerinnen und Fahrer für die tatsächlichen Kosten des Autofahrens aufkommen müssten, wenn also beispielsweise auch Umwelt- und Klimaschäden oder Flächenverbrauch mit berechnet würden.“"
                            },
                            {
                                "example_id": "5791d6bd-84e2-4f61-84f4-d803c1b1d237",
                                "sense_id": "cc4ff2e1-de50-30d9-90da-2836f543dbec",
                                "text": "„Übrigens: Bei der ICE-Neubaustrecke Köln–Frankfurt wurde erstmals versucht, die neue Trasse mit der parallel laufenden Autobahn zu »bündeln«, um so den Flächenverbrauch zu vermindern und damit die Natur zu schonen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
