                    }
                ],
                "senses": [
                    {
                        "sense_id": "96f94ae4-20b5-33b6-bc33-47b002cd77b9",
                        "entry_id": "7a2e9054-a89a-3413-9cc6-9dff83fb02dc",
                        "glosses": [
                            "Calculatrice électronique de petite dimension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33200b17-3ca3-4b4d-9c16-e7740a2dab42",
                                "sense_id": "96f94ae4-20b5-33b6-bc33-47b002cd77b9",
                                "text": "Passe-moi ta calculette."
                            },
                            {
                                "example_id": "58535fe9-84d2-4f76-9598-8511dbd37c59",
                                "sense_id": "96f94ae4-20b5-33b6-bc33-47b002cd77b9",
                                "text": "S’il est vrai que l’utilisation de la calculette peut engendrer de mauvaises habitudes de travail et faire passer l’enfant à côté d’apprentissage de base, elle peut être envisagée selon une optique positive."
                            },
                            {
                                "example_id": "f9313021-3b85-4040-8582-85e29547b0b3",
                                "sense_id": "96f94ae4-20b5-33b6-bc33-47b002cd77b9",
                                "text": "Si l’on sait que 70 % du coût de construction d’une mégabassine est financé par de l’argent public — 50 % via les Agences de l’eau et 20 % par divers fonds d’État — avant de sortir sa calculette, il faut connaître le nombre de projets de mégabassines dans le pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2d72243-4a87-4dad-a514-22193fdb08cb",
                        "source_entry_id": "7a2e9054-a89a-3413-9cc6-9dff83fb02dc",
                        "source_sense_id": "96f94ae4-20b5-33b6-bc33-47b002cd77b9",
                        "target_lang_word": "Taschenrechner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschenrechner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfca562a-fe8b-3be3-9d02-35618f654a47",
                                        "entry_id": "8d1d9f67-5d03-33cd-bd49-036890f6ae6d",
                                        "glosses": [
                                            "handliche, elektronische Rechenmaschine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aff3046-5cb2-4b34-a05b-9572598ee1d8",
                                                "sense_id": "dfca562a-fe8b-3be3-9d02-35618f654a47",
                                                "text": "Der Taschenrechner zeigt das richtige Ergebnis an."
                                            },
                                            {
                                                "example_id": "0eea31f7-4a01-4b7c-adfa-e46f675d3225",
                                                "sense_id": "dfca562a-fe8b-3be3-9d02-35618f654a47",
                                                "text": "„Und der Taschenrechner? Hilft er den Schülerinnen und Schülern, oder behindert er sie darin, tatsächlich rechnen zu können?“"
                                            },
                                            {
                                                "example_id": "3f760168-e407-4ec9-967d-4760317a4254",
                                                "sense_id": "dfca562a-fe8b-3be3-9d02-35618f654a47",
                                                "text": "„Es sollte noch einmal fast zehn Jahre dauern, bis er mit dem Prototyp eine ersten Taschenrechners eine Perspektive für Mikrochip aufzeigen konnte.“"
                                            },
                                            {
                                                "example_id": "f3d51c0f-1445-4026-951a-918b4857aacb",
                                                "sense_id": "dfca562a-fe8b-3be3-9d02-35618f654a47",
                                                "text": "„Thomas freut sich, dass er sein Handy auch als Taschenrechner benutzen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
