                                "target_senses": [
                                    {
                                        "sense_id": "2f8fd56d-50f2-3c01-ac42-2258c117be93",
                                        "entry_id": "99b1224e-0238-325c-a857-ec4aeb3926dd",
                                        "glosses": [
                                            "Pour finir ; à la fin ; en conclusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e35d115-b2f5-461e-ac6e-ee2a8022bcd1",
                                                "sense_id": "2f8fd56d-50f2-3c01-ac42-2258c117be93",
                                                "text": "Le résidu, qui contient encore du kirsch, est mêlé avec de nouveaux fruits pour être réalambiqué ; et en dernier lieu on le donne aux cochons,qui le mangent très-bien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
