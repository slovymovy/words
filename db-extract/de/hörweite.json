                "senses": [
                    {
                        "sense_id": "2f11a151-bd9e-36b2-83a7-57ec0935b21e",
                        "entry_id": "939cf45a-2397-3e8b-828c-fc9b449bd210",
                        "glosses": [
                            "diejenige Entfernung von etwas/jemandem, so dass es/er gerade noch gehört werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "087d9695-f81f-4496-833c-a292188dce2b",
                                "sense_id": "2f11a151-bd9e-36b2-83a7-57ec0935b21e",
                                "text": "„Ich wartete, bis er außer Hörweite war und trat wieder zwischen die Büsche, aber Abed Jones war verschwunden.“"
                            },
                            {
                                "example_id": "92b47d8b-617a-4dea-a352-84fdd2aa35a8",
                                "sense_id": "2f11a151-bd9e-36b2-83a7-57ec0935b21e",
                                "text": "„Wenn ausländische Journalisten über deutsche Kollegen sprechen und diese nicht in Hörweite sind, fällt öfter mal ein ganz bestimmtes Wörtchen, was nicht gerade als typisch deutsch gilt: »faul«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
