                        "glosses": [
                            "A person who giggles, or an inanimate object that can emanate laughter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba354878-966b-4b6d-a7ad-26e399aaa346",
                                "sense_id": "4b2b6fd3-e883-33cd-b60e-76708323f62e",
                                "text": "Band concert public square Nebraska city. Flowing and circling dresses, summer-white dresses. Faces, flesh tints flung like sprays of cherry blossoms. And gigglers, God knows, gigglers, rivaling the pony whinnies of the Livery Stable Blues."
                            },
                            {
                                "example_id": "95a9cbae-bd2f-4a38-95e8-e9cdb992c044",
                                "sense_id": "4b2b6fd3-e883-33cd-b60e-76708323f62e",
                                "text": "She was not a giggler, despite her extreme youth, and she smiled the small slow smile that men brought to her face without knowing why."
                            }
                        ]
                    }
