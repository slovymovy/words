                    {
                        "sense_id": "7817185e-781c-3631-bf60-d4a602e7851b",
                        "entry_id": "7010edc9-75c5-3ee7-9a01-f85083a86b02",
                        "glosses": [
                            "suprematist (artist working in the style of Suprematism)"
                        ],
                        "tags": [
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "b0a76dc7-5359-41bb-8fd8-be831d33b16a",
                                "sense_id": "7817185e-781c-3631-bf60-d4a602e7851b",
                                "text": "Das nun in der Ausstellung vermittelte Malewitsch-Bild ist ebenso lückenhaft und korrekturbedürftig wie das bislang im Westen gepflegte Künstlerbild, nach dem Malewitsch als Suprematist zu gelten hatte und andere Teile seiner politischen und künstlerischen Arbeit ignoriert oder als nicht so bedeutend beiseite geschoben werden konnten."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9d2641a-5ca3-3e0d-9900-21a2ae9fb7d7",
                        "entry_id": "7010edc9-75c5-3ee7-9a01-f85083a86b02",
                        "glosses": [
                            "supremacist"
                        ],
                        "tags": [
                            "masculine",
                            "neologism",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "adfd6718-4215-4bb5-a95d-b104f08cb650",
                                "sense_id": "c9d2641a-5ca3-3e0d-9900-21a2ae9fb7d7",
                                "text": "Sicher gibt es die Abwehrkämpfe weißer Suprematisten und sie werden aggressiver, aber es braucht an einem musealen Nebenschauplatz globaler Kämpfe gegen Diskriminierung keine Sippenhaft hellhäutiger Nachgeborener, sondern deren so einsichtige wie effektive Solidarität mit Unterdrückten und Ausgebeuteten in aller Welt."
                            }
                        ]
                    }
