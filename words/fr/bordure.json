            "senses": [
                {
                    "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                    "sense_definition": "Bande ou élément décoratif qui garnit, orne ou renforce le pourtour d'un objet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extremite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a cousu une délicate <w>bordure</w> de dentelle autour de la nappe blanche."
                        },
                        {
                            "text": "Le menuisier a sculpté une fine <w>bordure</w> sur le cadre en bois du miroir."
                        }
                    ],
                    "common_phrases": [
