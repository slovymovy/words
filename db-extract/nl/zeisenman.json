                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f89f71df-d2bb-47e3-a36d-c7b62c6da110",
                                                "sense_id": "e5b5c45c-4827-3fe6-a610-28775e91cc3c",
                                                "text": "„Er verschlang die Seelen der Lebenden, eine Art Gevatter Tod in Oktopusgestalt, furzte sie dann aber wieder als neue Seelen heraus, wiederverwertet und wiedergeboren.“"
                                            },
                                            {
                                                "example_id": "31fe6a90-a5d9-4be4-be00-d7e7e9806d49",
                                                "sense_id": "e5b5c45c-4827-3fe6-a610-28775e91cc3c",
                                                "text": "„Auch wenn er den Text nicht verstehen konnte, verspürte Dr. Barnardo unglaubliches Entsetzen, fast so, als sei es ein Gebet an Gevatter Tod persönlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e9aaf05-4476-424f-b4db-904cf6054970",
