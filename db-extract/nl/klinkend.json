                                                "sense_id": "b78657e8-f6a0-3535-b1f0-eb81a1d06baf",
                                                "text": "The sailor took a sounding every five minutes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838a0187-8a27-354e-9e6e-c65f6ceb6650",
                                        "entry_id": "21be79bb-6bd1-38ea-9842-ecd076ce157f",
                                        "glosses": [
                                            "Any place or part of the ocean, or other water, where a sounding line will reach the bottom."
                                        ],
