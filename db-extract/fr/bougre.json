                                            "slang",
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b80c8f-5585-42a9-b547-7e7572134cf8",
                                                "sense_id": "e81c165d-1bac-3076-a290-1efc0ef624fa",
                                                "text": "This computer is buggered! Oh no! I've buggered it up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a3d9c35-6f55-38bf-9d98-e5c514cad4f7",
                                        "entry_id": "1e7ce623-a076-3c4f-b76d-e67ebe2bcbd7",
                                        "glosses": [
                                            "Expressing contemptuous dismissal of the grammatical object."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "slang",
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee00f9ab-b7ea-49f6-8976-9a6f89d4ffef",
                                                "sense_id": "8a3d9c35-6f55-38bf-9d98-e5c514cad4f7",
                                                "text": "Bugger Bognor. (Alleged to be the last words of King George V of the United Kingdom in response to a suggestion that he might recover from his illness and visit Bognor Regis.)"
                                            },
                                            {
                                                "example_id": "442cdc95-d48c-4927-a007-5df5fadf5c35",
                                                "sense_id": "8a3d9c35-6f55-38bf-9d98-e5c514cad4f7",
                                                "text": "Oh, bugger this! I'm going out for a beer instead."
                                            }
                                        ]
                                    }
                                ]
                            },
