                            },
                            {
                                "target_lang_word": "среда",
                                "target_lang_sense_clarification": "социальная сфера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环境",
                                "target_lang_sense_clarification": "社会或政治背景"
                            },
                            {
                                "target_lang_word": "局势",
                                "target_lang_sense_clarification": "政治或社会形势"
                            }
                        ]
                    }
                },
                {
