                        ]
                    },
                    {
                        "translation_id": "e3e445a9-33e9-4b19-a168-203ca4c8b004",
                        "source_entry_id": "c209dfc4-808f-3eb6-acb8-8b7694b445c3",
                        "source_sense_description": "the act of making false",
                        "target_lang_word": "falsification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falsification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                        "entry_id": "2970b7a4-6626-3a44-8474-f959952f2f4b",
                                        "glosses": [
                                            "Action de falsifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e456132-7c21-4887-aeb9-837dcbdbbf56",
                                                "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                                "text": "Une autre falsification, qu'opèrent les épureurs, se fait au moyen de l’huile de baleine, qu'on mélange avec celle épurée de colza par moitié, lorsque la différence des prix y donne lieu."
                                            },
                                            {
                                                "example_id": "fd10c86b-2a6e-40a6-8f3c-82be41c0e603",
                                                "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                                "text": "Il appartenait au gouvernement de montrer aux populations viticoles la périodicité inévitable des crises tant qu'il serait planté des ceps à tort et à travers, tant que producteurs et commerçants ne feraient pas la guerre aux falsifications."
                                            },
                                            {
                                                "example_id": "c1c4d987-aaaa-48db-8ed7-686c98fb8665",
                                                "sense_id": "1354ea70-ecd0-3f0c-992a-a56f33d939d1",
                                                "text": "Face aux falsifications historiques massives venant de Moscou, il nous semble essentiel de rappeler certains faits incontestables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c23fa1-9b23-3516-a165-3f6a6a149b2c",
                                        "entry_id": "2970b7a4-6626-3a44-8474-f959952f2f4b",
                                        "glosses": [
                                            "En particulier, action de diminuer les performances du moteur en matière d'émissions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad64ac00-8063-4f43-a5d9-d1ae5bf437ab",
                                                "sense_id": "34c23fa1-9b23-3516-a165-3f6a6a149b2c",
                                                "text": "Les différents types de moteurs et familles de moteurs sont conçus et pourvus de stratégies de limitation des émissions de manière à prévenir les falsifications dans la mesure du possible. L'utilisation de stratégies d'invalidation est interdite"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3975c89c-a108-4219-87bb-197aa3f86f54",
                        "source_entry_id": "c209dfc4-808f-3eb6-acb8-8b7694b445c3",
                        "source_sense_description": "the act of making false",
                        "target_lang_word": "Fälschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fälschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                        "entry_id": "ed14ff34-7344-37d8-b508-5c3d317cafd4",
                                        "glosses": [
                                            "das Fälschen, die Imitation eines Produktes unter Vortäuschung von dessen Authentizität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff60ecb4-b1c9-4cca-a159-cd42ff2dbf88",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "Die Fälschung von Banknoten ist ein Verbrechen."
                                            },
                                            {
                                                "example_id": "cc1b2bd3-8271-4399-8e22-4eb1d3b03f1c",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "„Es ging mit ihm immer mehr bergab, fünf oder sechs Jahre später beging er Fälschungen, für die er zu den Galeeren verurteilt wurde, wo er vor sechs oder sieben Jahren starb.“"
                                            },
                                            {
                                                "example_id": "7c21da85-b8a7-4513-a789-2a13d7c3eeca",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "„Doch bleibt die Möglichkeit einer Fälschung offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                        "entry_id": "ed14ff34-7344-37d8-b508-5c3d317cafd4",
                                        "glosses": [
                                            "das gefälschte Produkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44853d19-b894-4b59-825a-ece998be4095",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "Die goldene Rolex-Uhr für fünfzig Dollar ist mit Sicherheit eine Fälschung, da das Original sehr viel teurer ist."
                                            },
                                            {
                                                "example_id": "aa16209d-21dd-4e6c-bbc7-d4efb49dc696",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Sowohl vor als auch nach dieser Zeit wurden etliche Fälschungen produziert, die allesamt eine bessere Qualität als das Original aufweisen.“"
                                            },
                                            {
                                                "example_id": "8e7fc830-3a5e-4cb0-819b-2e9fbcb16696",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Vielmehr hat Masaryk (flankiert von vielen Fachwissenschaftlern) endgültig nachgewiesen, dass die Handschriften eine Fälschung des berühmten Bibliothekars Václav Hanka waren.“"
                                            },
                                            {
                                                "example_id": "ee25d8b8-27fc-490a-a900-2daf7eb4cea9",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
