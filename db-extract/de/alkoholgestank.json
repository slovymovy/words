                            {
                                "example_id": "fbfcba42-c1e5-4b1e-9102-5282bc133919",
                                "sense_id": "89e49aa3-1016-3f82-bdd7-61ceadcaf12a",
                                "text": "„Alkoholgestank strömte ihm aus den öligen Poren, und der Schnaps und Gin hatten eindeutig seine Zunge gelöst, denn er entließ eine ganze Tirade von Beschimpfungen, während Fiti vergebens versuchte, ihn zu beruhigen.“"
                            },
                            {
                                "example_id": "102eb070-f9da-4a69-911f-10e64de2e785",
                                "sense_id": "89e49aa3-1016-3f82-bdd7-61ceadcaf12a",
                                "text": "„Nebem dem geringfügigen Sachschaden und den verstreuten Tabletten fiel ihnen auch der Alkoholgestank auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
