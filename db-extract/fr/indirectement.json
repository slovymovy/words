                                "target_senses": [
                                    {
                                        "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                        "entry_id": "dcec3fa7-d4c8-3df9-9038-9543e25d997a",
                                        "glosses": [
                                            "In an indirect manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca4c042-3338-4894-8516-a13173daed86",
                                                "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                                "text": "His alcoholism had a direct effect on his health, and indirectly caused problems for others."
                                            },
                                            {
                                                "example_id": "5ec25608-e92c-49dc-8dc6-fadae65465eb",
                                                "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                                "text": "At laſt a new Ceſſation of Hoſtilities upon theſe Points was reſolved on; yet the Hatred continues, and the War goes on, though more covertly, and more indirectly than before."
                                            },
                                            {
                                                "example_id": "b2c75552-64ea-4675-a447-e9d02213304a",
                                                "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                                "text": "For while he refers to his gout (a good disease), he does not mention the complaint which indirectly killed him, his hydrocele – an enlargement of the scrotum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28e0e963-44b1-4790-b9df-29b983b119d6",
                        "source_entry_id": "5aac3d23-b70e-3697-ad82-245787cedc01",
                        "source_sense_id": "9a881773-f168-3932-b8bb-021eb4daec37",
                        "target_lang_word": "vicariously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vicariously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c158fe25-e242-3625-87f3-3d93ca124330",
                                        "entry_id": "cc831917-bccf-3115-a48f-b39be169904f",
                                        "glosses": [
                                            "In a vicarious manner; indirectly; as, by, or through a substitute; by proxy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b17fdeb-2e77-4510-ba1d-b2bf944ca9f5",
                                                "sense_id": "c158fe25-e242-3625-87f3-3d93ca124330",
                                                "text": "Mr. Miller argues convincingly that a majority of Americans shared the romantic nationalism of such expansionists as Theodore Roosevelt and Sen. Albert Beveridge and participated vicariously in their dreams of martial glory and expanding markets."
                                            }
                                        ]
                                    }
                                ]
