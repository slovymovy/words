                "senses": [
                    {
                        "sense_id": "e5bbf36f-a62e-31c8-b997-81421600cefe",
                        "entry_id": "a7fc2073-a61c-33e2-932a-98259589e660",
                        "glosses": [
                            "Embourgeoiser ; élever la catégorie sociale de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c704d3b4-ae33-4af7-9875-35ff36ed85d1",
                                "sense_id": "e5bbf36f-a62e-31c8-b997-81421600cefe",
                                "text": "Le quartier romain où on le retrouve et qui accueillait jadis des abattoirs, leurs employés et de nombreux bouchers s’est gentrifié. De ce passé disparu restent quelques plats typiques de viande, servis dans de vieux restaurants, comme ces tripes à la sauce tomate que Roberto Saviano a commandées."
                            },
                            {
                                "example_id": "02eddef6-2dd7-4312-a228-5c093572b7da",
                                "sense_id": "e5bbf36f-a62e-31c8-b997-81421600cefe",
                                "text": "Beliris à la rescousse pour « gentrifier » Saint-Gilles ?"
                            },
                            {
                                "example_id": "6621773b-6fc1-412f-88fe-4495e2f71fe6",
                                "sense_id": "e5bbf36f-a62e-31c8-b997-81421600cefe",
                                "text": "Avec un casino à proximité, Pointe-Saint-Charles risque de se gentrifier."
                            },
                            {
                                "example_id": "39c9e2c1-9d90-4d8e-90dd-b99eda1d6524",
                                "sense_id": "e5bbf36f-a62e-31c8-b997-81421600cefe",
                                "text": "Harlem: gentrifier pour mieux diviser"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5066b802-85ac-4acf-9073-5e52c74972a2",
                        "source_entry_id": "a7fc2073-a61c-33e2-932a-98259589e660",
                        "source_sense_id": "e5bbf36f-a62e-31c8-b997-81421600cefe",
                        "target_lang_word": "gentrify",
