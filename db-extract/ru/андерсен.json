                                "target_senses": [
                                    {
                                        "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                        "entry_id": "8654cfe2-6a65-3521-a83e-a1a7a548ac32",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03562557-5ccc-4177-889f-bdc030abc66f",
                                                "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                                "text": "Frau Andersen ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "6b00bba8-bbfa-4226-a7d2-705302bbeeed",
                                                "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                                "text": "Herr Andersen wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "89ccfefa-531b-4a10-b451-486edeff8712",
                                                "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                                "text": "Die Andersens fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "1af57f0f-29d8-45bf-a7da-50364e25ff94",
                                                "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                                "text": "Der Andersen trägt nie die Pullover, die die Andersen ihm strickt."
                                            },
                                            {
                                                "example_id": "18d78873-066c-4676-a6e9-cae2a50a2381",
                                                "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Andersen kommt, geht der Herr Andersen.“"
                                            },
                                            {
                                                "example_id": "e769b8b2-cbb5-4260-8d46-27b5de5367b2",
                                                "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                                "text": "Andersen kommt und geht."
                                            },
                                            {
                                                "example_id": "32a0de6f-54af-421e-b2d6-b8bed6538859",
                                                "sense_id": "fbb1de0f-7f75-3a2b-8143-2ee6ce3e9861",
                                                "text": "Andersens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
