                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost a <dime> betting on the football game last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером он проиграл <w>штуку</w> на ставках на футбол.",
                                "zh": "昨晚他赌足球赛输掉了<w>一千美元</w>。"
                            }
                        },
                        {
                            "text": "The car repairs cost me nearly a <dime>.",
                            "target_lang_translations": {
                                "ru": "Ремонт машины обошелся мне почти в <w>штуку</w>.",
                                "zh": "修车差不多花了我<w>一千美元</w>。"
                            }
                        }
