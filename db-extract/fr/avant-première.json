                "senses": [
                    {
                        "sense_id": "396d30a6-5f7a-3e6f-bf66-7e9c986ed801",
                        "entry_id": "3ad765c7-6658-3b1b-bfa1-155e29e616a4",
                        "glosses": [
                            "Projection d’un film devant un public restreint, destinée à recueillir les impressions des spectateurs avant la sortie en salle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "081d5960-cae6-4087-847d-c58b2ef4a10f",
                                "sense_id": "396d30a6-5f7a-3e6f-bf66-7e9c986ed801",
                                "text": "Celle-ci sera notamment composée de la projection en avant-première du dernier Steven Spielberg, The Fabelmans."
                            },
                            {
                                "example_id": "81216897-6fca-4e55-a6b7-268f680b3bf9",
                                "sense_id": "396d30a6-5f7a-3e6f-bf66-7e9c986ed801",
                                "text": "Elle avait pris l'habitude de m'inviter aux avant-premières de films d'action, de polar ou d'autres trucs qui pouvaient me plaire. Elle savait que les films intello où les acteurs se pignolent pendant deux heures sans que le spectateur comprenne rien, c'était pas mon truc."
                            },
                            {
                                "example_id": "95ca6072-8caf-4922-b69d-0b93ab142bbf",
                                "sense_id": "396d30a6-5f7a-3e6f-bf66-7e9c986ed801",
                                "text": "Le court métrage le voyage de l’eau, entièrement réalisé par quatre classes du bassin versant du Chavanon dans le cadre d’un projet pédagogique avec le PNR de Millevaches et le vidéaste Arnaud Jamin, a été présenté en avant-première."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ba07935-ed27-4ed5-b154-29a6f6372fdb",
                        "source_entry_id": "3ad765c7-6658-3b1b-bfa1-155e29e616a4",
