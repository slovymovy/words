                                            {
                                                "example_id": "cb9f7fcf-6706-4169-adbd-063719d66d1c",
                                                "sense_id": "47e0b5b1-5cd2-3e7e-8f33-9237fbbf4b14",
                                                "text": "Emmanuel Macron s’est entretenu ce dimanche par téléphone avec le Président Turc, Recep Tayyip Erdoğan."
                                            },
                                            {
                                                "example_id": "214016ac-f4b9-4ab8-8907-700fcd6cfcee",
                                                "sense_id": "47e0b5b1-5cd2-3e7e-8f33-9237fbbf4b14",
                                                "text": "Si la victoire du parti de Recep Tayyip Erdoğan lors du scrutin de dimanche ne fait aucun doute, elle pourrait cependant être moins écrasante que prévue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
