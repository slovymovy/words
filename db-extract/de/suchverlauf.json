                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1aeca3-ab52-4289-91aa-52f11bb2a771",
                                "sense_id": "0d55cb23-27ac-31bf-935c-f4edc647bddf",
                                "text": "„Einige personalisierte Signale, wie die Sprache, der Standort oder in manchen Fällen der Suchverlauf, können Hinweise geben, welche Ergebnisse nützlicher und relevanter sein können.“"
                            },
                            {
                                "example_id": "f4d99272-67e2-4a79-9701-76583bf67cd1",
                                "sense_id": "0d55cb23-27ac-31bf-935c-f4edc647bddf",
                                "text": "„Je relevanter die Werbung für die Nutzer ist, desto besser ist es für Google. Doch solche Werbung speist sich aus persönlichen Daten, etwa dem Suchverlauf im Browser.“"
                            },
                            {
                                "example_id": "7f1bc704-8bf5-4659-85b7-7929eab0cafd",
                                "sense_id": "0d55cb23-27ac-31bf-935c-f4edc647bddf",
                                "text": "„Vielleicht verbargen sich in ihrem Suchverlauf irgendwelche Hinweise darauf, dass sie geplant hatte, Eiríkur zu verlassen.“"
                            }
                        ],
