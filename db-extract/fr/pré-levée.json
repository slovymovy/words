                        "entry_id": "fc0a4d16-dc25-3a14-8e19-8e001751c6be",
                        "glosses": [
                            "Ensemble des stades phénologiques qui précèdent la levée d'une plantule du sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e9b31ac-0001-473d-8080-9dc5cc87cb99",
                                "sense_id": "4acfbdc4-00a5-3504-9dd7-e630ec8ddb4c",
                                "text": "Cette observation amène à réfléchir aux conséquences de l'emploi d'un herbicide de pré-levée sur les autres éléments de l'itinéraire technique."
                            },
                            {
                                "example_id": "73968700-a86c-4502-b29d-eb243ad62ab6",
                                "sense_id": "4acfbdc4-00a5-3504-9dd7-e630ec8ddb4c",
                                "text": "On a tendance à les négliger en agriculture conventionnelle, et à compter presque exclusivement sur les herbicides, soit de pré-levée soit de post-levée, pour réduire la pression des herbes."
                            }
                        ]
                    }
