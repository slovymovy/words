                        "examples": [
                            {
                                "example_id": "86e438b0-d595-4762-b62a-513205f977c4",
                                "sense_id": "28c8d3a5-db14-3700-8482-4833c9a3be9b",
                                "text": "\"Ik hoop dat het onder de komende regering gaat lukken om de bedrijfsuitbreiding af te ronden. Daar begonnen we in 2006 mee, we zouden er vier jaar over doen. Maar het is nog steeds niet klaar, omdat we niet alle spullen kunnen krijgen die we nodig hebben. Terwijl ik veel meer zou kunnen produceren.\""
                            },
                            {
                                "example_id": "100cf5f4-2700-43ff-87ff-a8863adb9f6e",
                                "sense_id": "28c8d3a5-db14-3700-8482-4833c9a3be9b",
                                "text": "De POR-regeling is een ontheffing voor boeren die mest op een duurzame manier verwerken. Boeren mogen dan meer dieren houden na een bedrijfsuitbreiding, zonder dat daar dierenrechten over betaald moeten worden. Met het vervallen van de regeling moeten de boeren een deel van hun dieren wegdoen of meer dierenrechten gaan kopen."
                            }
                        ]
