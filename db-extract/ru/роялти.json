                    {
                        "translation_id": "45de7fd2-cb1c-44ef-b263-85856739cd27",
                        "source_entry_id": "5cd4f072-a8df-36ab-a1d5-40dab70bae72",
                        "target_lang_word": "redevance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redevance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6381a979-ed94-3ad6-a6a9-54e5ed98c470",
                                        "entry_id": "34b232b3-f2c4-3f95-8a5f-e7c1c08800c9",
                                        "glosses": [
                                            "Rente, somme payable à termes fixes, généralement en contrepartie d’un service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b0d577-764a-4591-8f5a-6938d7c517c9",
                                                "sense_id": "6381a979-ed94-3ad6-a6a9-54e5ed98c470",
                                                "text": "En Pologne, chaque paysan, attaché en naissant à la glèbe du maître, cultive pour son propre compte une fraction de cette glèbe, dont il ne doit à son maître qu’une faible redevance, laquelle est un hommage lige plutôt qu’un impôt de quelque valeur."
                                            },
                                            {
                                                "example_id": "cd7c8286-d2b0-4057-b7ab-1f238da9f561",
                                                "sense_id": "6381a979-ed94-3ad6-a6a9-54e5ed98c470",
                                                "text": "Les troupeaux transhumants appartiennent tantôt à de riches propriétaires ou capitalistes, tantôt à de petits cultivateurs de Provence, qui les confient à un bayle ou berger chef qui, à ses risques et périls, conduit les troupeaux, loue les pâturages, etc., en un mot se charge de l'estivage moyennant une redevance."
                                            },
                                            {
                                                "example_id": "00a71903-d544-42b0-8dcf-36d1e2ca4610",
                                                "sense_id": "6381a979-ed94-3ad6-a6a9-54e5ed98c470",
                                                "text": "Wary de Dommartin la rebâtit ; d’abord bénédictin au monastère de Saint-Epvre à Toul, puis prieur de Varangéville il céda ensuite son prieuré, moyennant redevance, à Jean de Nicolinis ; […]."
                                            },
                                            {
                                                "example_id": "a02694fd-5152-4a74-a4fc-70fce17e16cf",
                                                "sense_id": "6381a979-ed94-3ad6-a6a9-54e5ed98c470",
                                                "text": "Voilà les carpes ; mais je n’en ai plus que six grosses qui sont de redevance et que je ne peux pas vendre."
                                            },
                                            {
                                                "example_id": "49055331-029b-4893-b150-80e68ce5120d",
                                                "sense_id": "6381a979-ed94-3ad6-a6a9-54e5ed98c470",
                                                "text": "Il est à peine besoin de faire remarquer que, vu la quantité de taxes et redevances auxquelles on les assujettissait […], les juifs se trouvaient dans une situation matérielle précaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0a0eddb-9861-3283-8331-2ff8f11d1598",
                                        "entry_id": "34b232b3-f2c4-3f95-8a5f-e7c1c08800c9",
                                        "glosses": [
                                            "Somme versée à échéances périodiques en contrepartie d’un avantage concédé contractuellement."
                                        ],
                                        "tags": [
                                            "Industrie pétrolière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fd685d9-a6a6-3077-a381-e759f2c991b3",
                                        "entry_id": "34b232b3-f2c4-3f95-8a5f-e7c1c08800c9",
                                        "glosses": [
                                            "Redevance audiovisuelle : contribution forfaitaire annuelle au bénéfice du service audiovisuel public."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0bc4f63-69ff-4077-91b5-3d8a62a89508",
                                                "sense_id": "5fd685d9-a6a6-3077-a381-e759f2c991b3",
                                                "text": "En 2007, la redevance a représenté 74 % des ressources du service public de l'audiovisuel, soit 2 milliards d'euros. En contrepartie de la redevance perçue, le groupe France Télévisions s'engage à n'effectuer aucune coupure publicitaire des longs métrages (cinéma et téléfilms) diffusés sur son réseau de chaînes."
                                            },
                                            {
                                                "example_id": "7a680f31-3735-4984-8d80-5ed3ca50b67f",
                                                "sense_id": "5fd685d9-a6a6-3077-a381-e759f2c991b3",
                                                "text": "La réforme proposée prévoit une augmentation de la redevance mensuelle de télévision de 135 CZK (environ 5,40 €) à 150 CZK (6 €) et de la redevance de radio de 45 CZK (1,80 €) à 55 CZK (2,20 €). Malgré l’inflation et l’augmentation des coûts d’exploitation, ces redevances n’ont pas été augmentées depuis 16 ans pour la télévision et 19 ans pour la radio. Les ménages qui utilisent des appareils connectés à Internet devront également verser une contribution."
                                            }
                                        ]
                                    }
                                ]
                            },
