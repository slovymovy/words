                    {
                        "translation_id": "451f5e5c-cc0d-466f-be55-51b80ab124bf",
                        "source_entry_id": "8e34b75a-ba90-3430-8dbe-0fac2d211df8",
                        "source_sense_id": "fad44b1e-6e5a-30b2-bad8-7c361baf0a28",
                        "target_lang_word": "Unfreundlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfreundlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6e3a22f-275c-3a3b-a517-34030a5036e7",
                                        "entry_id": "b134ae51-eefc-384f-934e-0baa2935894f",
                                        "glosses": [
                                            "abweisendes, respektloses Verhalten"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab65cf0-cfb6-4d4d-aa0f-a4b34e59cd2e",
                                                "sense_id": "b6e3a22f-275c-3a3b-a517-34030a5036e7",
                                                "text": "„Ich schreibe seine Unfreundlichkeit dem vielen Alkohol zu.“"
                                            },
                                            {
                                                "example_id": "64f8c37a-f9d4-441d-ba95-367376532853",
                                                "sense_id": "b6e3a22f-275c-3a3b-a517-34030a5036e7",
                                                "text": "„Ich ging davon aus, dass Marlene mir von nun an wieder mit Schärfe und Unfreundlichkeit begegnen würde, wie früher so oft.“"
                                            },
                                            {
                                                "example_id": "070b8579-a333-45da-a4e9-3d8524f7e364",
                                                "sense_id": "b6e3a22f-275c-3a3b-a517-34030a5036e7",
                                                "text": "„Jetzt tat ihm seine Unfreundlichkeit leid. Schließlich hatte sie es ja nur gut mit ihm gemeint, sagte er sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e238f0bf-b5be-37b3-85c6-34552635a67d",
                                        "entry_id": "b134ae51-eefc-384f-934e-0baa2935894f",
                                        "glosses": [
                                            "despektierliche Handlung oder Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c2ac54-e1a5-4730-8806-c72369da938b",
                                                "sense_id": "e238f0bf-b5be-37b3-85c6-34552635a67d",
                                                "text": "„In ihrer Gegenwart hatte er mit seiner Frau telefoniert und sie gebeten, ihm all seine Unfreundlichkeiten zu vergeben.“"
                                            },
                                            {
                                                "example_id": "74f00bbf-8673-4ff2-a8b3-34e2ee4963a5",
                                                "sense_id": "e238f0bf-b5be-37b3-85c6-34552635a67d",
                                                "text": "„Wenn die Schwyzer ihre Unfreundlichkeiten unterliessen, würden die Zürcher mit ihnen gerne in guter Freundschaft leben.“"
                                            },
                                            {
                                                "example_id": "f5d74596-0587-4781-addc-19743e778dce",
                                                "sense_id": "e238f0bf-b5be-37b3-85c6-34552635a67d",
                                                "text": "„Eine Unfreundlichkeit des Tons ist unverkennbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b9121a9-238c-4944-98cc-99850ae9ca08",
                        "source_entry_id": "8e34b75a-ba90-3430-8dbe-0fac2d211df8",
                        "source_sense_id": "fad44b1e-6e5a-30b2-bad8-7c361baf0a28",
                        "target_lang_word": "malveillance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malveillance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "701fe60b-e05a-3915-8c31-18421cbf7f0c",
                                        "entry_id": "33cc5738-17d9-3c9d-8b76-4b3b41d7f871",
                                        "glosses": [
                                            "Mauvaise volonté pour les hommes en général ou pour quelqu’un en particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818bdfdb-79ba-4478-beb3-3f454e3a293d",
                                                "sense_id": "701fe60b-e05a-3915-8c31-18421cbf7f0c",
                                                "text": "En me voyant, le colonel parut un peu gêné, et je crus m’apercevoir qu’il baissait la voix pour m’adresser la parole en français. Autour de nous, on chuchotait : « Frantzose… Frantzose… » Je sentais de la malveillance dans tous les yeux."
                                            },
                                            {
                                                "example_id": "2880e255-7e3f-4d00-b2b2-48506e9c127c",
                                                "sense_id": "701fe60b-e05a-3915-8c31-18421cbf7f0c",
                                                "text": "Pas la moindre festivité non plus, le 14 Juillet, à VIRIAT (Ain). Mais il ne faut pas y voir la moindre malveillance à l'égard de la République. On a l'habitude, ici, de célébrer le 14 Juillet... le 1ᵉʳ dimanche d'août !"
                                            },
                                            {
                                                "example_id": "cba7d50a-cf70-499f-8e6c-631adf6a3a17",
                                                "sense_id": "701fe60b-e05a-3915-8c31-18421cbf7f0c",
                                                "text": "Tandis que les deux textes des commissaires-ouvriers ménageaient la susceptibilité des marchands-fabricants afin de les amener à négocier, […], Dodieu transpose aux relations industrielles le style politique paranoïde des clubistes, suggérant une malveillance omniprésente autour des ouvriers « que l'incivisme dépourvoit de travail »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed129339-88b5-3640-9833-2759ca6e890b",
                                        "entry_id": "33cc5738-17d9-3c9d-8b76-4b3b41d7f871",
                                        "glosses": [
                                            "Acte criminel ayant pour objectif de nuire à autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6457181a-3943-4293-81c8-cdb2e102b75b",
                                                "sense_id": "ed129339-88b5-3640-9833-2759ca6e890b",
                                                "text": "La protection contre la malveillance, et ses formes extrêmes, le sabotage et les actes de terrorisme, a pris depuis quelques années une importance accrue, avec la montée des risques terroristes dans le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c503dafc-0641-42d2-99bf-717174df9b90",
                        "source_entry_id": "8e34b75a-ba90-3430-8dbe-0fac2d211df8",
                        "source_sense_id": "fad44b1e-6e5a-30b2-bad8-7c361baf0a28",
                        "target_lang_word": "hostilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Acte d’un ennemi ou état de guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c03b0e-e578-4116-b759-4e26065458d0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Un commencement d’hostilités, commencer les hostilités."
                                            },
                                            {
                                                "example_id": "24657e8c-d769-4f5f-8092-9dd6da6e5da9",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Suspendre les hostilités."
                                            },
                                            {
                                                "example_id": "5594bd17-f1ab-431c-ae7c-999762fcd6d0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Le monde entier prenait part aux hostilités, sans pouvoir envisager la possibilité d’une paix prochaine, sans même l’espoir de recouvrer jamais la paix."
                                            },
                                            {
                                                "example_id": "fa481410-6422-4c62-ad86-1a22907232f0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "L'Autriche déclarait en outre, qu'elle trouvait inadmissible que, dans l'article 3, les puissances se congratulassent de la signature de la paix entre la Prusse et le Danemarck, les hostilités ayant formellement repris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Comportement d’inimitié ou d’opposition ; disposition hostile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a36321f-b4d0-4dd7-94ee-7449cf69738a",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Voici, pour commencer, ce que j’écrivais, il y a six ans, dans un livre de colère que l’hostilité générale s’efforça d’étouffer par tous les moyens imaginables."
                                            },
                                            {
                                                "example_id": "5f1dc349-91c2-4ac6-bcb5-14c3d54fe625",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "L’indifférence en matière de foi était devenue de règle, car d’hostilité on n’en sentait point trop encore ; à peine sourdait-elle, peut-être, dans quelques propos sacrilèges que les mauvaises langues : […], s’essayaient malicieusement dans l’ombre à propager."
                                            },
                                            {
                                                "example_id": "f6d22563-06c5-4ad0-8066-790c375a6c6b",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Pavlov ne s’est pas borné à abdiquer simplement la psychologie en tant que science. Il voyait naître en lui le sentiment d’hostilité irréconciliable envers cette « alliée de la physiologie » qui n’a pas fait ses preuves."
                                            },
                                            {
                                                "example_id": "056d800d-0095-4f69-a9b3-10fb5abe728c",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Victime de l’hostilité d’Arago en France et de Humboldt en Allemagne, Paravey a la mentalité d'un persécuté. Il se plaint dès 1835 « de sourdes et odieuses manœuvres qui tendent sans cesse à se renouveler. »"
                                            },
                                            {
                                                "example_id": "25c40919-ceca-4be6-a962-dae008b7036a",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Il n’y avait pas encore de déclin appréciable dans l’influence des ordres soufis. L’hostilité que leur manifestaient les wahhabites avait peu de poids en dehors de l’Arabie centrale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d7421c-bf1d-388f-b8cf-378640130cbd",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Sentiment d’animosité, déclaré ou dissimulé, qui incline une personne à l’agression."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7844982-3108-4e9d-83a5-be0541af86b2",
                                                "sense_id": "13d7421c-bf1d-388f-b8cf-378640130cbd",
                                                "text": "Il éprouvait pour elle une hostilité à peine voilée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
