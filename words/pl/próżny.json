    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8542d56b-2dad-3a15-bf61-935018c94093",
                    "sense_definition": "mający przesadnie wysokie mniemanie o sobie oraz pragnący podziwu i pochlebstw",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cecha_charakteru",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten aktor był zbyt <w>próżny</w>, aby znieść jakąkolwiek krytykę ze strony widzów.",
                            "target_lang_translations": {
                                "en": "That actor was too <w>vain</w> to take any criticism from the audience."
                            }
                        },
                        {
                            "text": "Jej <w>próżna</w> natura sprawiała, że spędzała przed lustrem całe godziny.",
                            "target_lang_translations": {
                                "en": "Her <w>vain</w> nature meant she spent hours in front of the mirror."
                            }
                        }
                    ],
                    "common_phrases": [
                        "próżny człowiek"
                    ],
                    "target_lang_definitions": {
                        "en": "having an excessively high opinion of oneself and craving admiration and praise"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vain",
                                "target_lang_sense_clarification": "excessively proud or conceited"
                            },
                            {
                                "target_lang_word": "conceited",
                                "target_lang_sense_clarification": "having an exaggeratedly high opinion of oneself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1583e5-a3cf-39d0-a979-471e8ddc3c02",
                    "sense_definition": "nieprzynoszący pożądanych rezultatów ani skutków; daremny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bezskutecznosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszelkie próby przekonania go do zmiany decyzji okazały się całkowicie <w>próżne</w>.",
                            "target_lang_translations": {
                                "en": "All attempts to convince him to change his mind proved completely <w>futile</w>."
                            }
                        },
                        {
                            "text": "Ratownicy nie porzucali nadziei, choć ich dotychczasowe wysiłki były <w>próżne</w>.",
                            "target_lang_translations": {
                                "en": "The rescuers did not give up hope, even though their efforts so far had been <w>in vain</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "daremny",
                        "bezskuteczny",
                        "bezowocny",
                        "płonny",
                        "jałowy",
                        "nieefektywny",
                        "czczy"
                    ],
                    "antonyms": [
                        "owocny",
                        "skuteczny"
                    ],
                    "common_phrases": [
                        "próżny trud",
                        "próżne nadzieje",
                        "próżne słowa"
                    ],
                    "target_lang_definitions": {
                        "en": "producing no desired results or effects; pointless or fruitless"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "futile",
                                "target_lang_sense_clarification": "incapable of producing any useful result"
                            },
                            {
                                "target_lang_word": "vain",
                                "target_lang_sense_clarification": "pointless or unsuccessful, as in 'in vain'"
                            },
                            {
                                "target_lang_word": "fruitless",
                                "target_lang_sense_clarification": "failing to achieve the desired outcome"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c57835db-49a8-317a-8c9e-19e73e4be0a3",
                    "sense_definition": "niezawierający nic w środku; pusty",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pustka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pesymista widzi szklankę do połowy <w>próżną</w>, a optymista do połowy pełną.",
                            "target_lang_translations": {
                                "en": "A pessimist sees the glass half <w>empty</w>, while an optimist sees it half full."
                            }
                        },
                        {
                            "text": "W spiżarni stały tylko <w>próżne</w> naczynia, które dawno straciły swoją zawartość.",
                            "target_lang_translations": {
                                "en": "In the pantry stood only <w>empty</w> vessels that had long lost their contents."
                            }
                        }
                    ],
                    "synonyms": [
                        "pusty",
                        "niewypełniony"
                    ],
                    "antonyms": [
                        "pełny",
                        "wypełniony"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "w znaczeniu fizycznie pusty stosowane rzadziej lub w utartych związkach"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "containing nothing inside; hollow or vacant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "empty",
                                "target_lang_sense_clarification": "containing nothing"
                            },
                            {
                                "target_lang_word": "void",
                                "target_lang_sense_clarification": "completely empty or bare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}