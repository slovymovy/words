                        "entry_id": "3a12ff17-0516-327e-87b8-7643e54edd58",
                        "glosses": [
                            "A member of a traditional Korean caste of female entertainers, whose work often included prostitution."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1234385f-a9d7-4e94-92d6-254c22eb38a8",
                                "sense_id": "70b2958f-2ed4-3f26-b1c2-000b3c266a02",
                                "text": "These raw emotions and unpolished behaviors are placed against the seductive, perfected armor of the kisaeng, whose skill as the ultimate purveyors of fantasy is belied by the almost caustic loneliness threading through their poems."
                            }
                        ]
                    }
