{
    "word_family": [
        "klaring",
        "opklaren",
        "verklaren",
        "klaarheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "795b5eea-d10e-34f4-8394-1913b26ce2cc",
                    "sense_definition": "Een taak of klus succesvol voltooien of afhandelen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voltooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten deze moeilijke klus voor vanavond <w>klaren</w>.",
                            "target_lang_translations": {
                                "en": "We need to <w>get</w> this difficult job <w>done</w> before tonight."
                            }
                        },
                        {
                            "text": "Zij wist de ingewikkelde opdracht snel te <w>klaren</w>.",
                            "target_lang_translations": {
                                "en": "She managed to <w>accomplish</w> the complicated task quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "afhandelen",
                        "voltooien"
                    ],
                    "common_phrases": [
                        "een klus klaren",
                        "het klusje klaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To successfully complete, manage, or get a task or job done."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get done",
                                "target_lang_sense_clarification": "to complete a task or job"
                            },
                            {
                                "target_lang_word": "manage",
                                "target_lang_sense_clarification": "to successfully handle a task"
                            },
                            {
                                "target_lang_word": "accomplish",
                                "target_lang_sense_clarification": "to successfully complete a task"
                            },
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to complete a job or task"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6a6404a-3b9b-350e-85b3-9922ed3befa6",
                    "sense_definition": "Moeilijkheden of problemen oplossen en uit de weg ruimen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oplossen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geloof maar dat hij in die tijd veel te <w>klaren</w> kreeg!",
                            "target_lang_translations": {
                                "en": "You can bet he had a lot to <w>deal with</w> during that time!"
                            }
                        },
                        {
                            "text": "We moeten eerst deze problemen <w>klaren</w> voordat we verdergaan.",
                            "target_lang_translations": {
                                "en": "We must <w>resolve</w> these problems first before we move on."
                            }
                        }
                    ],
                    "common_phrases": [
                        "problemen klaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To resolve, clear up, or deal with difficulties or problems."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear up",
                                "target_lang_sense_clarification": "to resolve problems or misunderstandings"
                            },
                            {
                                "target_lang_word": "resolve",
                                "target_lang_sense_clarification": "to settle or solve difficulties"
                            },
                            {
                                "target_lang_word": "deal with",
                                "target_lang_sense_clarification": "to handle or cope with problems"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95882b4f-0a30-3fbb-9570-57d9dd593071",
                    "sense_definition": "Een vloeistof helder of zuiver maken door onzuiverheden te verwijderen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "helder_maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>klaarde</w> de gesmolten boter om er daarna bij hogere temperaturen in te kunnen bakken.",
                            "target_lang_translations": {
                                "en": "He <w>clarified</w> the melted butter so he could fry in it at higher temperatures afterwards."
                            }
                        },
                        {
                            "text": "De kok gebruikt eiwit om de bouillon te <w>klaren</w>.",
                            "target_lang_translations": {
                                "en": "The chef uses egg white to <w>clear</w> the broth."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boter klaren",
                        "bouillon klaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a liquid clear or pure by removing impurities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clarify",
                                "target_lang_sense_clarification": "to make a liquid, like butter or broth, clear"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "to remove impurities from a liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2979577-3ab0-3ab3-932a-f0e7a24d32c6",
                    "sense_definition": "Helder of transparant worden (van vloeistoffen of de lucht).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "helder_worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze wijn is na een paar weken vanzelf <w>geklaard</w>.",
                            "target_lang_translations": {
                                "en": "This wine <w>cleared</w> on its own after a few weeks."
                            }
                        },
                        {
                            "text": "Na de zware storm begon de lucht eindelijk te <w>klaren</w>.",
                            "target_lang_translations": {
                                "en": "After the heavy storm, the sky finally began to <w>clear up</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de lucht klaart"
                    ],
                    "target_lang_definitions": {
                        "en": "To become clear or transparent (referring to liquids or the sky)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear up",
                                "target_lang_sense_clarification": "referring to the sky or weather becoming clear"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "referring to a liquid or sky becoming transparent"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5af0703-c0a5-326e-80b7-232d5ee591d3",
                    "sense_definition": "De druk in de oren (achter het trommelvlies) gelijk maken met de buitenlucht.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medisch_fysiologisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door te slikken kan je je oren makkelijk <w>klaren</w>, en dan heb je geen last meer van druk in je oor.",
                            "target_lang_translations": {
                                "en": "By swallowing you can easily <w>clear</w> your ears, and then you won't suffer from pressure in your ear anymore."
                            }
                        },
                        {
                            "text": "Duikers moeten leren hoe ze hun oren goed moeten <w>klaren</w> tijdens de afdaling.",
                            "target_lang_translations": {
                                "en": "Divers must learn how to <w>equalize</w> their ears properly during the descent."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oren klaren"
                    ],
                    "target_lang_definitions": {
                        "en": "To equalize the pressure in the ears (behind the eardrum) with the outside air."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "to equalize pressure in one's ears"
                            },
                            {
                                "target_lang_word": "pop",
                                "target_lang_sense_clarification": "to equalize ear pressure, often informally"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b700d1d5-6d16-38c5-95a8-7033e6dea4fd",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>klare</w> (een soort jenever).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mannen bestelden aan de bar twee <w>klaren</w> om op te warmen.",
                            "target_lang_translations": {
                                "en": "The men ordered two <w>Dutch gins</w> at the bar to warm up."
                            }
                        },
                        {
                            "text": "Hij drinkt zijn <w>klaren</w> het liefst ijskoud.",
                            "target_lang_translations": {
                                "en": "He prefers to drink his <w>straight jenevers</w> ice-cold."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruikt voor glaasjes jenever"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'klare', a type of Dutch gin (jenever)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Dutch gins",
                                "target_lang_sense_clarification": "glasses of clear Dutch jenever"
                            },
                            {
                                "target_lang_word": "straight jenevers",
                                "target_lang_sense_clarification": "glasses of neat, clear Dutch gin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}