        "nl-extract.jsonl": [
            {
                "entry_id": "254f64ac-75d0-30e8-8b44-326bcdf0210f",
                "word": "gekletter",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "16324453-f12a-3f21-beb5-b7cd0d63f53a",
                        "entry_id": "254f64ac-75d0-30e8-8b44-326bcdf0210f",
                        "glosses": [
                            "het herhaald voortbrengen van een kort, helder en luid geluid zoals bij metalen voorwerpen die tegen elkaar stoten en bij heftige regen of hagel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b6d06b-63fd-42a1-9ac2-d6bef48479ac",
                                "sense_id": "16324453-f12a-3f21-beb5-b7cd0d63f53a",
                                "text": "Anderlecht sloot de ogen, wilde niet zien hoe Teodorczyk in een geblutste witte bestelwagen door een voetbalwedstrijd banjert, nijdig de versnellingspook hanteert, met wilde rukken aan het met een konijnenvel bekleed stuur de bocht neemt, waarbij het gekletter van lege bierblikjes zelfs de radio overstemt die Poolse housemuziek uitbraakt."
                            },
                            {
                                "example_id": "b95321f8-a45c-41ef-9b52-6d4c091996aa",
                                "sense_id": "16324453-f12a-3f21-beb5-b7cd0d63f53a",
                                "text": "John en Adrie Eijsink worden gek van het gekletter van eikels op hun dakpannen, zinken dakgoot en kunststof overkapping. Dat allemaal vanwege de boom van de buurman, die weigert de takken verder terug te snoeien. Wie dat is? De gemeente Bronckhorst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ad09819-5fbf-4eca-9180-d904f1875a14",
                        "source_entry_id": "254f64ac-75d0-30e8-8b44-326bcdf0210f",
                        "source_sense_id": "16324453-f12a-3f21-beb5-b7cd0d63f53a",
                        "target_lang_word": "clatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ded094c-5289-3293-a3e7-29805106492c",
                                        "entry_id": "b03b3c63-1f72-3140-af2f-46feb1d7f61a",
                                        "glosses": [
                                            "To make a rattling sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402846da-4979-487b-99e0-c5577ca19d49",
                                                "sense_id": "4ded094c-5289-3293-a3e7-29805106492c",
                                                "text": "When all the bees are gone to settle, / You clatter still your brazen kettle."
                                            },
                                            {
                                                "example_id": "f578de24-dd92-4424-b8e6-cd255558cc97",
                                                "sense_id": "4ded094c-5289-3293-a3e7-29805106492c",
                                                "text": "When he came to Nottingham, he entered that part of the market where butchers stood, and took up his inn in the best place he could find. Next, he opened his stall and spread his meat upon the bench, then, taking his cleaver and steel and clattering them together, he trolled aloud in merry tones: […]"
                                            },
                                            {
                                                "example_id": "21e056e4-bbe4-4104-95a1-2f8117d459b1",
                                                "sense_id": "4ded094c-5289-3293-a3e7-29805106492c",
                                                "text": "Over the cobbles he clattered and clashed in the dark inn-yard, / And he tapped with his whip on the shutters, but all was locked and barred; […]"
                                            },
                                            {
                                                "example_id": "ec657ae2-8fee-4744-a1a5-2fd827710c02",
                                                "sense_id": "4ded094c-5289-3293-a3e7-29805106492c",
                                                "text": "I sprang up the break of the poop, and saw -- Wolf Larsen. What of my impetus and the stunning surprise, I clattered three or four steps along the deck before I could stop myself."
                                            },
                                            {
                                                "example_id": "db3da285-5041-4ec9-83ae-f062c44a6c7a",
                                                "sense_id": "4ded094c-5289-3293-a3e7-29805106492c",
                                                "text": "[Hoop-and-stick] was not a little gentleman's game but was played by boys in heavy boots making a terrific noise as they clattered along on the pavements at quite a speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "353f680e-beee-3468-a531-205c3119b8f3",
                                        "entry_id": "b03b3c63-1f72-3140-af2f-46feb1d7f61a",
                                        "glosses": [
                                            "To chatter noisily or rapidly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91db7350-399a-49ca-912d-6f86a114fe84",
                                                "sense_id": "353f680e-beee-3468-a531-205c3119b8f3",
                                                "text": "But if that I knewe what his name hight, / For clatering of me I would him ſone quight; / For his falſe lying, of that I ſpake never, / I could make him ſhortly repent him forever: […]"
                                            },
                                            {
                                                "example_id": "f76e2c29-c640-4480-9325-8063450a190b",
                                                "sense_id": "353f680e-beee-3468-a531-205c3119b8f3",
                                                "text": "Here is a great deale of good matter, / loſt for lacke of telling, / Now ſicker I see, thou doeſt but clatter: / harme may come of melling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f08d6afb-c8cf-3ec4-9ec9-317ef917a1b2",
                                        "entry_id": "b03b3c63-1f72-3140-af2f-46feb1d7f61a",
                                        "glosses": [
                                            "To hit; to smack."
                                        ],
                                        "tags": [
                                            "Northern-England"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e196e0-113c-4602-a30a-617d4f6842a8",
                                                "sense_id": "f08d6afb-c8cf-3ec4-9ec9-317ef917a1b2",
                                                "text": "\"I can't watch it because I have to go outside and clatter someone in the nuts!”"
                                            },
                                            {
                                                "example_id": "35343d15-1d4f-4085-b0fc-894e2c7730f4",
                                                "sense_id": "f08d6afb-c8cf-3ec4-9ec9-317ef917a1b2",
                                                "text": "“An Orange bitch clattered seven shades of shite out of her,” Padraig eagerly piped up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcc882e5-728b-3b59-80a4-f20bf8034e47",
                                        "entry_id": "54257ad4-59e7-3a75-a740-ea7912bf6935",
                                        "glosses": [
                                            "A rattling noise; a repetition of abrupt, sharp sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f791273-9c2d-4d3f-9d63-28b33625a327",
                                                "sense_id": "dcc882e5-728b-3b59-80a4-f20bf8034e47",
                                                "text": "The patter of feet, and clatter of strap and swivel, seemed to swell into a bewildering din, but they were almost upon the fielato offices, where the carretera entered the town, before a rifle flashed."
                                            },
                                            {
                                                "example_id": "5dbb9f50-e70f-4c1f-82e0-fe5e56ace1a9",
                                                "sense_id": "dcc882e5-728b-3b59-80a4-f20bf8034e47",
                                                "text": "There was something distinctly low-key, even wilfully alienating about the band’s performance. A scattering of OK Computer tracks were interspersed with more abstract latterday material – the clatter of 15 Step and Myxamatosis."
                                            },
                                            {
                                                "example_id": "ef802773-c7d3-43af-8fed-3bbe8aa452ed",
                                                "sense_id": "dcc882e5-728b-3b59-80a4-f20bf8034e47",
                                                "text": "... disintegrated Incredibly , pitched your clattering pieces to the bottom stair Of intellect , insisting that you start Again . Or proud - flesh , clotted mental pores , might claim Authentic miracle only to decry it . Campanulas ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c85b35-c03c-3ed8-a564-a1b8a50f6e4d",
                                        "entry_id": "54257ad4-59e7-3a75-a740-ea7912bf6935",
                                        "glosses": [
                                            "A loud disturbance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f556c34-83e4-310b-8100-55b9769c5407",
                                        "entry_id": "54257ad4-59e7-3a75-a740-ea7912bf6935",
                                        "glosses": [
                                            "Noisy talk or chatter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                                        "entry_id": "54257ad4-59e7-3a75-a740-ea7912bf6935",
                                        "glosses": [
                                            "A large group, especially of sibling children; a lot"
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdc9231-24d5-492e-a39b-7aa98888d653",
                                                "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                                                "text": "a young mother with a clatter of kids told me ... her Catholic doctor refused point-blank to advise other than the rhythm method."
                                            },
                                            {
                                                "example_id": "a2583fe0-b73e-484c-b33c-7c1989442307",
                                                "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                                                "text": "There haven't been any men for years. The last one I can remember was a hairy old ballad singer who, it turned out, had a wife and a clatter of kids."
                                            },
                                            {
                                                "example_id": "bdcdd96b-f003-41e6-9a63-04b8f5a6550e",
                                                "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                                                "text": "There are a clatter of other PRSI classes. E is for Church of Ireland ministers only. H relates to enlisted military personnel and non-commissioned officers."
                                            },
                                            {
                                                "example_id": "c735a290-3ff7-47a0-ad6d-eb8f12538060",
                                                "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                                                "text": "The children are ... all in early middle-age, which means a clatter of grandchildren, as well as her own offspring, descend on Rosemarie’s house on a regular basis."
                                            },
                                            {
                                                "example_id": "99a53795-dec9-4961-b007-2bb45628017e",
                                                "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                                                "text": "The artisan redbrick cottages that line the streets off Barrow Street in Ringsend, Dublin 4 are pretty to look at, but, while historically clatters of kids have been reared within their walls, they can seem a bit compact for modern living."
                                            },
                                            {
                                                "example_id": "d75762b6-5fe1-4efb-a34f-631e7e74a416",
                                                "sense_id": "9ce6332e-6986-3266-9a2e-47c18ed9adc2",
                                                "text": "We assume that because a person has been elected to the Dáil or because they have a clatter of compliant, photo-ready children or they’re in a helicopter and their nickname is Slasher Larkin, their every utterance is gospel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df1a7789-c769-396a-9a29-7c8c973b3374",
                                        "entry_id": "54257ad4-59e7-3a75-a740-ea7912bf6935",
                                        "glosses": [
                                            "Alternative form of clitter; scree."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f028b446-e9cf-47aa-adce-b11f72d00adf",
                                                "sense_id": "df1a7789-c769-396a-9a29-7c8c973b3374",
                                                "text": "Clatter, or, as it is sometimes called, Clitter, is the name given to the confused masses of granite rocks that are so frequently seen covering large areas of ground on the hill sides of the moor, or clustering around the bases of many of the tors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a11c0a92-3008-45d8-b76c-425a21605a9a",
