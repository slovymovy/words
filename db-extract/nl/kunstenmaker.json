                        "sense_id": "a0d33645-5b37-36c6-959e-0c073beb40d7",
                        "entry_id": "1ee79338-d6fa-3111-9378-6e55f141bd4f",
                        "glosses": [
                            "aansteller, fratsenmaker"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "40fbc84a-e7a2-3cbf-bae1-2245ede7cb78",
                        "entry_id": "1ee79338-d6fa-3111-9378-6e55f141bd4f",
                        "glosses": [
                            "iemand die gemene truckjes uithaalt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9d88590c-937b-4ebd-a01c-2deb81355e40",
                                "sense_id": "40fbc84a-e7a2-3cbf-bae1-2245ede7cb78",
                                "text": "'Of mij gezegd werd waar die vergadering over ging? Nee, totaal niet. Vorige week woensdag heb ik nog drie uur lang met de verzoeningscommissie gesproken. Dat ging heel open en prettig, sindsdien heb ik niets meer gehoord. Dan denk je op de goede weg te zijn en dan gebeurt er ineens dit. Een stel kunstenmakers zijn het. Juridisch zullen ze allemaal wel weten hoe het in elkaar zit, maar dit stinkt natuurlijk aan alle kanten.'"
                            }
                        ]
                    }
