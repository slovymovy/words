{
    "word_family": [
        "ring",
        "ringer",
        "ringing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7dc422d-1db8-3e72-8766-eb0207679c2c",
                    "sense_definition": "A horizontal bar or crosspiece that forms a step on a ladder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ladder_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully placed his foot on the next <w>rung</w> of the wooden ladder.",
                            "target_lang_translations": {
                                "ru": "Он осторожно поставил ногу на следующую <w>перекладину</w> деревянной лестницы.",
                                "de": "Er setzte seinen Fuß vorsichtig auf die nächste <w>Sprosse</w> der Holzleiter."
                            }
                        },
                        {
                            "text": "The old ladder was dangerous because the bottom <w>rung</w> was loose.",
                            "target_lang_translations": {
                                "ru": "Старая лестница была опасной, так как нижняя <w>ступенька</w> шаталась.",
                                "de": "Die alte Leiter war gefährlich, weil die unterste <w>Sprosse</w> locker war."
                            }
                        }
                    ],
                    "synonyms": [
                        "step",
                        "round"
                    ],
                    "common_phrases": [
                        "bottom rung",
                        "top rung"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горизонтальная перекладина, служащая ступенью приставной лестницы.",
                        "de": "Ein waagerechter Stab oder Querbalken, der als Stufe einer Leiter dient."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекладина",
                                "target_lang_sense_clarification": "горизонтальный брус"
                            },
                            {
                                "target_lang_word": "ступенька",
                                "target_lang_sense_clarification": "опора для ноги"
                            },
                            {
                                "target_lang_word": "ступень",
                                "target_lang_sense_clarification": "часть лестницы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sprosse",
                                "target_lang_sense_clarification": "einer Leiter"
                            },
                            {
                                "target_lang_word": "Leitersprosse",
                                "target_lang_sense_clarification": "Trittstufe einer Leiter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ea8e99f-01e0-3594-9a8b-a82d917e2758",
                    "sense_definition": "A specific level or position within a hierarchy or career structure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hierarchy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started her career at the lowest <w>rung</w> of the corporate ladder.",
                            "target_lang_translations": {
                                "ru": "Она начала свою карьеру с самой низкой <w>ступени</w> корпоративной лестницы.",
                                "de": "Sie begann ihre Karriere auf der untersten <w>Stufe</w> der Karriereleiter."
                            }
                        },
                        {
                            "text": "Reaching the next <w>rung</w> in the social hierarchy requires a lot of hard work.",
                            "target_lang_translations": {
                                "ru": "Достижение следующей <w>ступени</w> в социальной иерархии требует много тяжелой работы.",
                                "de": "Die nächste <w>Stufe</w> in der sozialen Hierarchie zu erreichen, erfordert viel harte Arbeit."
                            }
                        }
                    ],
                    "synonyms": [
                        "level",
                        "stage",
                        "tier",
                        "step",
                        "grade"
                    ],
                    "common_phrases": [
                        "lowest rung"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный уровень или положение в иерархии или карьерной лестнице.",
                        "de": "Eine bestimmte Stufe oder Position innerhalb einer Hierarchie oder Karrierestruktur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ступень",
                                "target_lang_sense_clarification": "уровень развития или карьеры"
                            },
                            {
                                "target_lang_word": "ступенька",
                                "target_lang_sense_clarification": "этап в продвижении"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stufe",
                                "target_lang_sense_clarification": "in einer Hierarchie oder Karriere"
                            },
                            {
                                "target_lang_word": "Sprosse",
                                "target_lang_sense_clarification": "auf der Karriereleiter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e0a81e9-ec62-3515-a448-6d9aa762111f",
                    "sense_definition": "A crosspiece connecting and strengthening the legs of a chair or other furniture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child rested his feet on the <w>rung</w> of the high chair.",
                            "target_lang_translations": {
                                "ru": "Ребенок поставил ноги на <w>перекладину</w> детского стульчика.",
                                "de": "Das Kind stützte seine Füße auf den <w>Querstab</w> des Hochstuhls."
                            }
                        },
                        {
                            "text": "He broke a <w>rung</w> of the chair while trying to move it across the room.",
                            "target_lang_translations": {
                                "ru": "Он сломал <w>перекладину</w> стула, когда пытался передвинуть его через комнату.",
                                "de": "Er brach eine <w>Querverstrebung</w> des Stuhls ab, als er versuchte, ihn durch den Raum zu schieben."
                            }
                        }
                    ],
                    "synonyms": [
                        "stretcher"
                    ],
                    "common_phrases": [
                        "chair rung"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поперечина, соединяющая и укрепляющая ножки стула или другой мебели.",
                        "de": "Ein Querholz, das die Beine eines Stuhls oder anderer Möbelstücke verbindet und verstärkt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекладина",
                                "target_lang_sense_clarification": "между ножками мебели"
                            },
                            {
                                "target_lang_word": "проножка",
                                "target_lang_sense_clarification": "технический термин для мебели"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Querstab",
                                "target_lang_sense_clarification": "zwischen Stuhlbeinen"
                            },
                            {
                                "target_lang_word": "Querverstrebung",
                                "target_lang_sense_clarification": "bei Möbeln"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99d1039f-2bd5-3b05-9d52-f61810b58977",
                    "sense_definition": "One of the handles that sticks out from the rim of a ship's steering wheel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain gripped the <w>rung</w> of the wheel as the storm grew stronger.",
                            "target_lang_translations": {
                                "ru": "Капитан вцепился в <w>рукоятку</w> штурвала, когда шторм усилился.",
                                "de": "Der Kapitän umklammerte die <w>Speiche</w> des Steuerrads, als der Sturm stärker wurde."
                            }
                        },
                        {
                            "text": "Each <w>rung</w> of the steering wheel was polished until it shone.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>спица</w> штурвала была отполирована до блеска.",
                                "de": "Jede <w>Speiche</w> des Steuerrads war poliert, bis sie glänzte."
                            }
                        }
                    ],
                    "synonyms": [
                        "spoke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из рукояток, выступающих из обода штурвала корабля.",
                        "de": "Einer der Griffe, die aus dem Kranz eines Schiffssteuerrads herausragen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спица",
                                "target_lang_sense_clarification": "штурвального колеса"
                            },
                            {
                                "target_lang_word": "рукоятка",
                                "target_lang_sense_clarification": "выступающая часть штурвала"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Speiche",
                                "target_lang_sense_clarification": "eines Steuerrads"
                            },
                            {
                                "target_lang_word": "Griffsprosse",
                                "target_lang_sense_clarification": "am Steuerrad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7454a5b-e19a-3e15-9b83-c4be99e60c60",
                    "sense_definition": "A floor timber used in the construction of a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipwright inspected every <w>rung</w> to ensure the hull was sturdy.",
                            "target_lang_translations": {
                                "ru": "Корабельный мастер осмотрел каждый <w>флор</w>, чтобы убедиться в прочности корпуса.",
                                "de": "Der Schiffbauer überprüfte jede <w>Bodenwrange</w>, um sicherzustellen, dass der Rumpf stabil war."
                            }
                        },
                        {
                            "text": "The heavy <w>rung</w> was fitted into the frame of the vessel.",
                            "target_lang_translations": {
                                "ru": "Тяжелый <w>флор</w> был установлен в каркас судна.",
                                "de": "Die schwere <w>Bodenwrange</w> wurde in das Gerüst des Schiffes eingepasst."
                            }
                        }
                    ],
                    "synonyms": [
                        "floor-timber"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical nautical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть шпангоута, поперечный брус в основании корпуса судна.",
                        "de": "Ein Bodensegment (Bodenwrange), das beim Bau eines Schiffes verwendet wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флор",
                                "target_lang_sense_clarification": "морской термин, деталь набора судна"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bodenwrange",
                                "target_lang_sense_clarification": "Schiffbau"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45a9ddc3-a689-33d6-8da8-0b745fd99658",
                    "sense_definition": "The past participle of <w>ring</w>, used when referring to making a sound with a bell or telephone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church bells have <w>rung</w> every morning for over a century.",
                            "target_lang_translations": {
                                "ru": "Церковные колокола <w>звонят</w> каждое утро уже более века.",
                                "de": "Die Kirchenglocken haben seit über einem Jahrhundert jeden Morgen <w>geläutet</w>."
                            }
                        },
                        {
                            "text": "I have <w>rung</w> the doorbell three times, but nobody is answering.",
                            "target_lang_translations": {
                                "ru": "Я трижды <w>позвонил</w> в дверь, но никто не отвечает.",
                                "de": "Ich habe dreimal an der Tür <w>geklingelt</w>, aber niemand antwortet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have rung"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола ring (звонить).",
                        "de": "Partizip Perfekt von ring (klingen, läuten, anrufen)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прозвонил",
                                "target_lang_sense_clarification": "форма причастия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "geläutet",
                                "target_lang_sense_clarification": "Partizip Perfekt von läuten"
                            },
                            {
                                "target_lang_word": "angewählt",
                                "target_lang_sense_clarification": "telefonisch angerufen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "487c5d62-b806-3035-a1bc-8d4a64849174",
                    "sense_definition": "The simple past tense of <w>ring</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>rung</w> me up yesterday to discuss the plans for the weekend.",
                            "target_lang_translations": {
                                "ru": "Он <w>позвонил</w> мне вчера, чтобы обсудить планы на выходные.",
                                "de": "Er <w>rief</w> mich gestern <w>an</w>, um die Pläne für das Wochenende zu besprechen."
                            }
                        },
                        {
                            "text": "The telephone <w>rung</w> loudly in the middle of the quiet night.",
                            "target_lang_translations": {
                                "ru": "Телефон громко <w>зазвонил</w> посреди тихой ночи.",
                                "de": "Das Telefon <w>klingelte</w> laut mitten in der stillen Nacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "rang"
                    ],
                    "common_phrases": [
                        "rung up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered non-standard compared to 'rang'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола ring (разговорная форма).",
                        "de": "Einfache Vergangenheitsform (Präteritum) von ring (umgangssprachlich)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позвонил",
                                "target_lang_sense_clarification": "прошедшее время"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rief an",
                                "target_lang_sense_clarification": "machte einen Anruf"
                            },
                            {
                                "target_lang_word": "klingelte",
                                "target_lang_sense_clarification": "gab ein Geräusch von sich"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "185d1789-939f-3abd-88e2-6c4c61c8222e",
                    "sense_definition": "Describing a pig that has a metal ring fixed through its nose to prevent rooting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer kept a <w>rung</w> pig in the pen to protect the pasture.",
                            "target_lang_translations": {
                                "ru": "Фермер держал в загоне свинью <w>с кольцом в носу</w>, чтобы уберечь пастбище.",
                                "de": "Der Bauer hielt ein Schwein <w>mit Nasenring</w> im Gehege, um die Weide zu schützen."
                            }
                        },
                        {
                            "text": "A <w>rung</w> animal is much easier to manage on this type of soil.",
                            "target_lang_translations": {
                                "ru": "Животным <w>с кольцом в носу</w> гораздо легче управлять на таком типе почвы.",
                                "de": "Ein Tier <w>mit Nasenring</w> ist auf dieser Art von Boden viel einfacher zu handhaben."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rung pig"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "agricultural context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О свинье: с кольцом в носу для предотвращения рытья земли.",
                        "de": "Über ein Schwein: mit einem Metallring durch die Nase versehen, um das Wühlen zu verhindern."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с кольцом в носу",
                                "target_lang_sense_clarification": "о животном"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "mit Nasenring",
                                "target_lang_sense_clarification": "bei Schweinen"
                            }
                        ]
                    }
                }
            ]
        },
        {
