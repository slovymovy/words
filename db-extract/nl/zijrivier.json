                                    {
                                        "sense_id": "9bfaf298-fd85-3c5a-bed5-1a9e3e5a48ef",
                                        "entry_id": "ffff7abd-c6b9-3498-b153-14a09cbf58cd",
                                        "glosses": [
                                            "Somebody who is wealthy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaeed0f2-d8a8-45d5-b6ea-7cececfc8a78",
                                                "sense_id": "9bfaf298-fd85-3c5a-bed5-1a9e3e5a48ef",
                                                "text": "The affluents are most similar to the professional want-it-alls in their reasons for preferring specific hospitals and in their demographic characteristics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5aca7f2-86c3-303a-9e93-55a1a0fe557c",
                                        "entry_id": "ffff7abd-c6b9-3498-b153-14a09cbf58cd",
                                        "glosses": [
                                            "A stream or river flowing into a larger river or into a lake; a tributary stream; a tributary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7816e1f2-cddc-4930-8173-c71cb6cfd2fa",
                                                "sense_id": "f5aca7f2-86c3-303a-9e93-55a1a0fe557c",
                                                "text": "Its sources are everywhere in pine-clad mountains and plateaus, but all of the affluents quickly descend into the desert valley below, through which the Gila winds its way westward to the Colorado."
                                            },
                                            {
                                                "example_id": "e6a33ecd-2d67-4f26-a7cd-cb2c2b1b7dbf",
                                                "sense_id": "f5aca7f2-86c3-303a-9e93-55a1a0fe557c",
                                                "text": "The affluents of the Amazon are, half of them, of this nature, while the other half are whitish and opaque, the difference depending upon the class of country through which they have flowed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affluent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51ca37df-e3da-3d99-9884-7e2da7bee267",
                                        "entry_id": "f0e54b97-4868-33d9-877d-52a13a3a3b83",
                                        "glosses": [
                                            "Abundant; copious; plenteous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a577ce7f-3a55-42d3-b084-0254d0642a7f",
                                                "sense_id": "51ca37df-e3da-3d99-9884-7e2da7bee267",
                                                "text": "The shores are affluent in beauty, and incomparably lovely is the drive to the heights of Castel-a-Mare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9954ca-99be-3c40-b8d2-962515039b7f",
                                        "entry_id": "f0e54b97-4868-33d9-877d-52a13a3a3b83",
                                        "glosses": [
                                            "Abounding in goods or riches; having a moderate level of material wealth."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913f29f6-aa25-4b07-b054-87d5b6444aa8",
                                                "sense_id": "da9954ca-99be-3c40-b8d2-962515039b7f",
                                                "text": "They were affluent, but aspired to true wealth."
                                            },
                                            {
                                                "example_id": "ff5afac5-a685-4282-8538-93c48f6f4838",
                                                "sense_id": "da9954ca-99be-3c40-b8d2-962515039b7f",
                                                "text": "The Upper East Side is an affluent neighborhood in New York City."
                                            },
                                            {
                                                "example_id": "9868cec9-6600-4fd5-bde2-7936fcfab630",
                                                "sense_id": "da9954ca-99be-3c40-b8d2-962515039b7f",
                                                "text": "Nevertheless, it is clear that the global energy demand for air-conditioning will grow substantially as nations become more affluent, with the consequences of climate change potentially accelerating the demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cad83b9-04b6-3336-a74e-e5b92b66ffe8",
                                        "entry_id": "f0e54b97-4868-33d9-877d-52a13a3a3b83",
                                        "glosses": [
