                    "sense_id": "ba955afd-24fa-3536-aba8-ef7bf428358b",
                    "sense_definition": "Gesamtheit der geistigen und seelischen Kräfte eines Menschen sowie dessen seelische Verfassung",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psyche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das trübe und nasskalte Wetter im November schlägt vielen Menschen aufs <w>Gemüt</w>."
                        },
                        {
                            "text": "Nach dem hitzigen Wortwechsel versuchte der Versammlungsleiter, die erregten <w>Gemüter</w> vorsichtig zu beruhigen."
                        }
                    ],
                    "synonyms": [
                        "Herz",
                        "Innerstes",
                        "Seele"
                    ],
                    "antonyms": [
                        "Körper",
                        "Leib"
                    ],
                    "common_phrases": [
                        "aufs Gemüt schlagen",
                        "die Gemüter beruhigen",
                        "aufgebrachte Gemüter"
                    ]
                },
                {
                    "sense_id": "120cc04d-a280-3af0-b976-7773ce1d3c56",
                    "sense_definition": "Empfänglichkeit und seelische Offenheit für emotionale oder künstlerische Eindrücke",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psyche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine poetischen Verse sprachen direkt das empfindsame <w>Gemüt</w> der aufmerksamen Zuhörer an."
                        },
                        {
                            "text": "Sie besaß ein feines <w>Gemüt</w>, das auf jede leise Veränderung in der Musik reagierte."
                        }
                    ]
                },
                {
                    "sense_id": "783a1e95-87be-3619-8001-30f80da8001f",
                    "sense_definition": "Mensch in Bezug auf seine seelische oder charakterliche Grundhaltung",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Arbeitskollege ist ein friedfertiges <w>Gemüt</w>, das jedem unnötigen Streit aus dem Weg geht."
                        },
                        {
                            "text": "Als heiteres und optimistisches <w>Gemüt</w> lässt sie sich von Rückschlägen im Alltag selten entmutigen."
