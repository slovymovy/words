                "senses": [
                    {
                        "sense_id": "056beaa4-ad7c-361d-b315-bba433109e23",
                        "entry_id": "fcb065ba-5eb1-31f9-b386-8d67044bee0a",
                        "glosses": [
                            "Bett, dessen Gestell aus Holz besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72fac155-6d53-4a7c-83f5-ec61562fee7e",
                                "sense_id": "056beaa4-ad7c-361d-b315-bba433109e23",
                                "text": "„In seinem kahlen Zimmer mit dunklem Holzbett lehnt ein Landschaftsgemälde mit Goldrahmen an der Wand, schwere Gardinen lassen tagsüber wenig Licht herein.“"
                            },
                            {
                                "example_id": "04ba4ff9-0ea6-4847-b08d-587fbb4b0310",
                                "sense_id": "056beaa4-ad7c-361d-b315-bba433109e23",
                                "text": "„In den ersten Tagen nahm sie uns mit auf den Dachboden, den sie ausräumte, mit Lichterketten dekorierte und in dem sie, nach mühseliger Säuberungsaktion, zwei Holzbetten unter den gegenüberliegenden Dachschrägen aufbaute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
