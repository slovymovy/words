                "senses": [
                    {
                        "sense_id": "56528fb2-121b-39a1-b455-6204dc71de9a",
                        "entry_id": "0ef68101-80b2-3358-970b-81dda6f7452d",
                        "glosses": [
                            "Qui décrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1766acf3-f079-48cb-9a1f-b4a0eee9f31c",
                                "sense_id": "56528fb2-121b-39a1-b455-6204dc71de9a",
                                "text": "Il dit d’Homère qu’il est monotone, verbeux et descripteur."
                            },
                            {
                                "example_id": "5bc3fb5f-d0d1-4f5f-966a-587f4dd94e2a",
                                "sense_id": "56528fb2-121b-39a1-b455-6204dc71de9a",
                                "text": "Qu’on nous pardonne cette petite digression historique, nous ne sommes pas coutumier du fait, et nous allons revenir bien vite à notre humble mission de touriste descripteur et de daguerréotype littéraire."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cd1f4d04-13ad-38d1-86d0-9e09a5dc8f12",
                "word": "descripteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b4ef7e16-5f0e-4e40-8bab-d85a533d2467",
                        "entry_id": "cd1f4d04-13ad-38d1-86d0-9e09a5dc8f12",
