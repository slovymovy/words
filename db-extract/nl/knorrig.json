                "senses": [
                    {
                        "sense_id": "f3e4aa99-2308-3650-af89-b475b1e1e5b4",
                        "entry_id": "ee9f9786-0eb9-39c2-9145-a9acfd096681",
                        "glosses": [
                            "chagrijnig, ontevreden, altijd aan het knorren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "334852b2-c062-4d10-b98a-502fc81370a7",
                                "sense_id": "f3e4aa99-2308-3650-af89-b475b1e1e5b4",
                                "text": "De oude brombeer was vandaag weer eens in een knorrige bui."
                            },
                            {
                                "example_id": "6d4de86b-b106-461a-952f-e8e3f51de6e3",
                                "sense_id": "f3e4aa99-2308-3650-af89-b475b1e1e5b4",
                                "text": "Het is nooit te laat om aan jezelf te werken en het blijft altijd een keuze of je knorrig of vrolijk door het leven wilt gaan."
                            },
                            {
                                "example_id": "5dee3a66-564c-4d43-8884-e3d6f75b6b03",
                                "sense_id": "f3e4aa99-2308-3650-af89-b475b1e1e5b4",
                                "text": "Hoe dan ook, het was geweldig om de soms wat knorrige, gestreste kant van me af te kunnen schudden."
                            }
                        ]
                    }
                ],
