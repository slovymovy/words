                                    {
                                        "sense_id": "08f21e1e-6e6a-347b-b32a-45686e5222f7",
                                        "entry_id": "9018bb0e-5d74-3bcf-bb8d-697ff3ff8cea",
                                        "glosses": [
                                            "figuur met de vorm van een acht die laat zien hoe de schijnbare positie van een bepaald hemellichaam aan de hemel op een bepaald tijdstip van de dag in het verloop van een jaar verandert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5184a529-366f-4e9c-81f0-b8bad6e0af81",
                                                "sense_id": "08f21e1e-6e6a-347b-b32a-45686e5222f7",
                                                "text": "Elke plaats en elk tijdstip heeft zijn eigen analemma. In de achtvormige lus komen zowel de scheve stand van de aardas als het elliptische van de aardbaan tot uitdrukking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
