                "senses": [
                    {
                        "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                        "entry_id": "6c9d18e1-ddc2-3208-a5bc-3170e3be9395",
                        "glosses": [
                            "Dispositif servant à mesurer l’altitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b228ae6d-e339-45ef-97c5-c8e08462aef1",
                                "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                                "text": "Mon altimètre s’est détraqué, je suis tantôt ludion, tantôt scaphandrier, souvent les deux ensemble comme il convient dans notre partie : j’habite en l’air par habitude et je fouine en bas sans trop d’espoir."
                            },
                            {
                                "example_id": "cc565618-580a-41b7-bf10-8e91d0481002",
                                "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                                "text": "Celui de gauche est un altimètre barométrique du même type que ceux que nous venons dʼévoquer."
                            },
                            {
                                "example_id": "23393052-866f-4fc4-8bbe-69e25d844316",
                                "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                                "text": "\"Les données de l'altimètre confirment qu'Ingenuity a effectué son premier vol, le premier vol d'un engin motorisé sur une autre planète\", a dit son pilote en chef, Havard Grip, la voix étranglée par l'émotion."
                            }
                        ]
                    },
                    {
                        "sense_id": "acdcb428-dc35-303b-8b5b-d774ecd7d030",
                        "entry_id": "6c9d18e1-ddc2-3208-a5bc-3170e3be9395",
                        "glosses": [
                            "Appareil de mesure de la hauteur d’un objet distant."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7f8855a-5b5d-4892-b28c-4456d246f6b2",
                        "source_entry_id": "6c9d18e1-ddc2-3208-a5bc-3170e3be9395",
                        "target_lang_word": "altimeter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
