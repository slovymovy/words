{
    "word_family": [
        "snorer",
        "snoring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fc66e94-1076-385f-b5c8-0c29c1a263b7",
                    "sense_definition": "To breathe during sleep with a harsh, rough, vibrating sound.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tends to <w>snore</w> loudly when he sleeps on his back.",
                            "target_lang_translations": {
                                "ru": "Он склонно громко <w>храпеть</w>, когда спит на спине."
                            }
                        },
                        {
                            "text": "My husband used to <w>snore</w> loudly, but a special pillow helped him sleep quietly.",
                            "target_lang_translations": {
                                "ru": "Раньше мой муж громко <w>храпел</w>, но специальная подушка помогла ему спать спокойно."
                            }
                        }
                    ],
                    "synonyms": [
                        "saw wood"
                    ],
                    "common_phrases": [
                        "snore loudly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать хриплые, резкие звуки во время сна при дыхании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "храпеть",
                                "target_lang_sense_clarification": "издавать хриплые звуки во сне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "772c4d37-1495-33c6-b3d2-6d63fe193aae",
                    "sense_definition": "A rough, noisy sound made while breathing during sleep.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His loud <w>snore</w> kept everyone in the room awake all night.",
                            "target_lang_translations": {
                                "ru": "Его громкий <w>храп</w> не давал никому в комнате заснуть всю ночь."
                            }
                        },
                        {
                            "text": "She woke up suddenly when she heard a sudden <w>snore</w> beside her.",
                            "target_lang_translations": {
                                "ru": "Она внезапно проснулась, услышав внезапный <w>храп</w> рядом с собой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loud snore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, хриплый звук, издаваемый при дыхании во сне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "храп",
                                "target_lang_sense_clarification": "звук, издаваемый во сне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f291d42-d251-36c2-8e4d-4543386b1972",
                    "sense_definition": "An event, person, or thing that is extremely boring.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That lecture on history was a total <w>snore</w> from beginning to end.",
                            "target_lang_translations": {
                                "ru": "Эта лекция по истории была полной <w>скукотищей</w> от начала до конца."
                            }
                        },
                        {
                            "text": "I fell asleep because the movie turned out to be a total <w>snore</w>.",
                            "target_lang_translations": {
                                "ru": "Я заснул, потому что фильм оказался смертельной <w>тоской</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snooze",
                        "snoozefest",
                        "snore-fest"
                    ],
                    "common_phrases": [
                        "total snore"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень скучное мероприятие, человек или предмет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скукотища",
                                "target_lang_sense_clarification": "очень скучное событие или дело"
                            },
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "о чем-то крайне неинтересном"
                            },
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "о скучном человеке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}