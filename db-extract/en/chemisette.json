                        "glosses": [
                            "An item of women's clothing, popular in the 1860s and 1870s, worn to fill in the front and neckline of any garment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81cd722a-9a0a-43c2-9613-c7aa60033b0b",
                                "sense_id": "a46f9d7c-a511-3286-b626-b458317f4d91",
                                "text": "[Of Italian peasants] And then their dress—the fine plaited chemisette close round the throat—the long gold ear-rings, those indispensables of their toilette—the black velvet boddice, showing the figure to such advantage, laced with gold and coloured silks—the full petticoat—the apron trimmed with gay ribands; all put on so neatly, and with such a fine taste for harmony of colouring."
                            }
                        ]
