{
    "word_family": [
        "commodification",
        "commodify",
        "commoditize",
        "commoditization",
        "commodious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8000cffc-bba0-333b-83ba-ed2f2276dc21",
                    "sense_definition": "Something that is useful or valuable, often used to describe intangible qualities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In today's fast-paced world, free time has become a very precious <w>commodity</w>.",
                            "target_lang_translations": {
                                "ru": "В сегодняшнем стремительном мире свободное время стало очень драгоценной <w>ценностью</w>."
                            }
                        },
                        {
                            "text": "Patience is a rare <w>commodity</w> when dealing with such difficult technical problems.",
                            "target_lang_translations": {
                                "ru": "Терпение — редкое <w>качество</w>, когда имеешь дело с такими сложными техническими проблемами."
                            }
                        }
                    ],
                    "synonyms": [
                        "asset",
                        "resource",
                        "possession"
                    ],
                    "common_phrases": [
                        "precious commodity",
                        "rare commodity",
                        "valuable commodity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то полезное или ценное, часто используемое для описания нематериальных качеств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценность",
                                "target_lang_sense_clarification": "важное и полезное качество"
                            },
                            {
                                "target_lang_word": "ресурс",
                                "target_lang_sense_clarification": "запас или возможность"
                            },
                            {
                                "target_lang_word": "благо",
                                "target_lang_sense_clarification": "нечто доброе и полезное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62bb2625-4d3f-3cc1-a992-de286fcc14f0",
                    "sense_definition": "A physical substance, such as food, metal, or fixed energy, that can be bought and sold.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country relies heavily on the export of a single <w>commodity</w> like oil.",
                            "target_lang_translations": {
                                "ru": "Страна сильно зависит от экспорта одного <w>товара</w>, такого как нефть."
                            }
                        },
                        {
                            "text": "Farmers are worried about the falling price of every agricultural <w>commodity</w> this year.",
                            "target_lang_translations": {
                                "ru": "Фермеры обеспокоены падением цен на каждый сельскохозяйственный <w>продукт</w> в этом году."
                            }
                        }
                    ],
                    "synonyms": [
                        "good",
                        "product",
                        "merchandise"
                    ],
                    "common_phrases": [
                        "agricultural commodity",
                        "basic commodity",
                        "trade a commodity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая субстанция, такая как еда, металл или энергия, которую можно покупать и продавать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товар",
                                "target_lang_sense_clarification": "предмет торговли"
                            },
                            {
                                "target_lang_word": "продукт",
                                "target_lang_sense_clarification": "результат производства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fda9b7d6-fe67-3671-910e-697ffd692db7",
                    "sense_definition": "Raw materials or primary products that are traded in large quantities on specialized exchanges.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors often turn to a <w>commodity</w> market when the stock market is volatile.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто обращаются к <w>товарному</w> рынку, когда фондовый рынок нестабилен."
                            }
                        },
                        {
                            "text": "Crude oil is the most heavily traded <w>commodity</w> in the global financial system.",
                            "target_lang_translations": {
                                "ru": "Сырая нефть является наиболее активно торгуемым <w>товаром</w> в мировой финансовой системе."
                            }
                        }
                    ],
                    "synonyms": [
                        "raw material",
                        "staple"
                    ],
                    "common_phrases": [
                        "commodity market",
                        "commodity prices",
                        "commodity exchange"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in business and finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сырье или первичные продукты, которыми торгуют в больших количествах на специализированных биржах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сырьевой товар",
                                "target_lang_sense_clarification": "биржевой актив"
                            },
                            {
                                "target_lang_word": "биржевой товар",
                                "target_lang_sense_clarification": "объект торгов на бирже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0214c24-9ea6-34e1-b51b-1378bd3eaa4d",
                    "sense_definition": "A product that is no longer distinguished from others of the same type, leading to low profit margins.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personal computers have become a mere <w>commodity</w> with very little difference between brands.",
                            "target_lang_translations": {
                                "ru": "Персональные компьютеры стали обычным <w>товаром</w> массового потребления, почти не имеющим различий между брендами."
                            }
                        },
                        {
                            "text": "When a product becomes a <w>commodity</w>, companies must compete solely on price.",
                            "target_lang_translations": {
                                "ru": "Когда продукт становится <w>ширпотребом</w>, компаниям приходится конкурировать исключительно по цене."
                            }
                        }
                    ],
                    "antonyms": [
                        "specialty"
                    ],
                    "common_phrases": [
                        "become a commodity",
                        "mere commodity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in economic and marketing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукт, который перестал отличаться от других продуктов того же типа, что ведет к низкой прибыли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ширпотреб",
                                "target_lang_sense_clarification": "массовый однотипный товар"
                            },
                            {
                                "target_lang_word": "стандартизированный товар",
                                "target_lang_sense_clarification": "товар без уникальных свойств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bbeeaa8-d1b6-3c98-9196-edf8bd74fcc9",
                    "sense_definition": "Personal convenience, advantage, or self-interest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "utility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted only for his own <w>commodity</w> without considering the needs of his neighbors.",
                            "target_lang_translations": {
                                "ru": "Он действовал только ради собственной <w>выгоды</w>, не считаясь с нуждами соседей."
                            }
                        },
                        {
                            "text": "In the old text, the author argues that men use their means for their own <w>commodity</w>.",
                            "target_lang_translations": {
                                "ru": "В старом тексте автор утверждает, что люди используют свои средства для собственного <w>удобства</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "convenience",
                        "advantage",
                        "benefit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личное удобство, выгода или корысть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгода",
                                "target_lang_sense_clarification": "личный интерес"
                            },
                            {
                                "target_lang_word": "удобство",
                                "target_lang_sense_clarification": "комфорт или преимущество"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}