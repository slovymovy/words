                    "sense_id": "c7bd439e-1c49-3c5d-8f19-79b5e29077e4",
                    "sense_definition": "odnoszący się do planety Ziemi",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "astronomia_geografia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Atmosfera chroni glob <w>ziemski</w> przed szkodliwym promieniowaniem słonecznym.",
                            "target_lang_translations": {
                                "en": "The atmosphere protects the <w>terrestrial</w> globe from harmful solar radiation."
                            }
                        },
                        {
                            "text": "Naukowcy nieustannie badają pole <w>ziemskie</w> oraz jego wpływ na nawigację.",
                            "target_lang_translations": {
                                "en": "Scientists constantly study <w>Earth's</w> field and its effect on navigation."
                            }
                        }
                    ],
                    "antonyms": [
                        "kosmiczny",
                        "pozaziemski"
                    ],
