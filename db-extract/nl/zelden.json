                "entry_id": "b9a8c3c3-cfe1-38a4-b9ff-7713289ca099",
                "word": "zelden",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31865cfa-cb10-3208-98c0-2a20bff9bf2f",
                        "entry_id": "b9a8c3c3-cfe1-38a4-b9ff-7713289ca099",
                        "glosses": [
                            "bijzonder weinig voorkomend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d470aad8-43f0-4670-b85b-396972b81dfe",
                                "sense_id": "31865cfa-cb10-3208-98c0-2a20bff9bf2f",
                                "text": "Hij heeft zelden aan deze zaak aandacht besteed."
                            },
                            {
                                "example_id": "4289229d-bf9f-4877-9474-7f039528fcc2",
                                "sense_id": "31865cfa-cb10-3208-98c0-2a20bff9bf2f",
                                "text": "Het regent in de Mojave zo zelden dat de slapende zaden soms pas na een aantal jaar ontkiemen."
                            },
                            {
                                "example_id": "0a65e955-b102-4ade-a8ca-18c7e1885fe1",
                                "sense_id": "31865cfa-cb10-3208-98c0-2a20bff9bf2f",
                                "text": "Sinds het product in 2016 gelegaliseerd werd, is de hennepsector in Italië razendsnel gegroeid: de jaaromzet in 2024 bedroeg meer dan een half miljard euro. Bovengemiddeld veel werknemers in de sector zijn jongeren, niet zelden in economisch kwetsbare gebieden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e4790c8-a40d-4d54-afaf-56dbff6fb610",
                        "source_entry_id": "b9a8c3c3-cfe1-38a4-b9ff-7713289ca099",
                        "source_sense_id": "31865cfa-cb10-3208-98c0-2a20bff9bf2f",
                        "source_sense_description": "bijzonder weinig voorkomend",
                        "target_lang_word": "selten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "128f73e9-ea59-3dbb-b34e-2cc7f9427038",
                                        "entry_id": "8c59afa6-f560-3fa0-aa03-9e4a4696b022",
                                        "glosses": [
                                            "nur in geringen Mengen vorhanden"
                                        ],
                                        "tags": [
                                            "attributiv",
                                            "prädikativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b67d3913-c844-490e-9068-38ae8aef6858",
                                                "sense_id": "128f73e9-ea59-3dbb-b34e-2cc7f9427038",
                                                "text": "Mondgestein ist auf der Erde ein seltenes Material."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b30e1b1-5f80-35d8-acfb-6931f8981fc3",
                                        "entry_id": "8c59afa6-f560-3fa0-aa03-9e4a4696b022",
                                        "glosses": [
                                            "nicht häufig passierend; die Wiederholungen haben eine große Zeitspanne"
                                        ],
                                        "tags": [
                                            "adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15b0df4-4d7e-4f21-8f0f-5988d85d9810",
                                                "sense_id": "4b30e1b1-5f80-35d8-acfb-6931f8981fc3",
                                                "text": "Der Mann ging selten zur Kirche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b2024fa-feb7-3705-a120-0c1748ce401c",
                                        "entry_id": "8c59afa6-f560-3fa0-aa03-9e4a4696b022",
                                        "glosses": [
                                            "(von Eigenschaften) in einer Ausprägung, wie sie nur bei wenigen Exemplaren vorkommt"
                                        ],
                                        "tags": [
                                            "adverbiell",
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a7eb2e-72ed-4e3e-a24c-85d2595de22a",
                                                "sense_id": "2b2024fa-feb7-3705-a120-0c1748ce401c",
                                                "text": "„Seien Sie mir nicht böse, aber Sie sind doch ein selten dämlicher Hund!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a724475-73c0-4762-95e9-65fa2cfcf26d",
                        "source_entry_id": "b9a8c3c3-cfe1-38a4-b9ff-7713289ca099",
                        "source_sense_id": "31865cfa-cb10-3208-98c0-2a20bff9bf2f",
                        "source_sense_description": "bijzonder weinig voorkomend",
                        "target_lang_word": "seldom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seldom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                        "entry_id": "d6b226e6-4526-30b2-bf6c-ed356a973c0b",
                                        "glosses": [
                                            "Infrequently, rarely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd1efa2-cfe2-484b-b2d9-d3b3dec63d3e",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "They seldom come here now."
                                            },
                                            {
                                                "example_id": "87110131-9625-4240-8b66-b5f244a5da8f",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed."
                                            },
                                            {
                                                "example_id": "990e6365-3a77-4721-8862-ec1aebc654fe",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "I'll miss the sea. But a person needs new experiences. They draw something deep inside, allowing him to grow. Without change, something sleeps inside us and seldom awakens. The sleeper must awaken."
                                            },
                                            {
                                                "example_id": "58b00a85-1603-46ea-bd1f-69962149ed02",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "People who talk about an imminent possibility of war seldom pose this question: What would North Korea’s leadership get from unleashing a war that they are likely to lose in weeks, if not days?"
                                            },
                                            {
                                                "example_id": "1465c2f0-6081-4c72-b186-22d8d883c130",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seldom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                        "entry_id": "e078bb78-f32d-3041-975b-9238708b0207",
                                        "glosses": [
                                            "Rare; infrequent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa91202-c3da-46cf-a7d8-294dd7dfb361",
                                                "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                                "text": "a suppressed and seldom anger"
                                            },
                                            {
                                                "example_id": "a2973b3e-3552-4fd6-b0b3-43568b7dc3b7",
                                                "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                                "text": "He was very curious in his garden, which was never out of order; in which he would at seldom times take a short walk or two, not enduring to see a weed in it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b458af00-2084-4b89-a7d6-9d89637697c8",
                        "source_entry_id": "b9a8c3c3-cfe1-38a4-b9ff-7713289ca099",
                        "source_sense_id": "31865cfa-cb10-3208-98c0-2a20bff9bf2f",
                        "source_sense_description": "bijzonder weinig voorkomend",
                        "target_lang_word": "rarement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rarement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a54a59e0-22ed-392f-a2e5-fc00eeda014c",
                                        "entry_id": "4f3fd3e9-ebe3-3804-9508-d1d6cc46bc41",
                                        "glosses": [
                                            "Peu souvent ; peu fréquemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52ee7d01-66cc-4301-80e5-bc21a6a29c45",
                                                "sense_id": "a54a59e0-22ed-392f-a2e5-fc00eeda014c",
                                                "text": "Et ce petit univers grouille de cancans, d'intrigues, de projets, d'ambitions, qui dépassent rarement le cadre de la sous-préfecture. Vous croyez que la Chine existe, vous ? Comment peut-on être Chinois ?"
                                            },
                                            {
                                                "example_id": "46220c85-c4de-4ccd-8e90-2089aa83cc82",
                                                "sense_id": "a54a59e0-22ed-392f-a2e5-fc00eeda014c",
                                                "text": "J'avais été beaucoup plus rarement bombardé du haut des airs, et je me trouvai, devant ce danger-là, presque aussi béjaune que mes conscrits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
