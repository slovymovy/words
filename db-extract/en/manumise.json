                        "glosses": [
                            "aus der Sklaverei entlassen, freisetzen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b98121ce-8da5-46d5-b4e8-9751c8644be3",
                                "sense_id": "63176e25-7858-3352-a27c-7447cfbc3c4d",
                                "text": "\"Seeing you have refused to manumise your servants at my command, I will manumise you, and set you free from my protection and care.\"",
                                "translation": "Da du dich weigerst deine Diener auf mein Kommando freizulassen, werde ich dich aus meinem Schutz und Zuneigung freisetzen."
                            }
                        ],
