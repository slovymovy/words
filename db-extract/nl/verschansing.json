        "nl-extract.jsonl": [
            {
                "entry_id": "d78db636-9c58-38b8-8e70-33529621b25d",
                "word": "verschansing",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ff925154-ffac-43b8-8656-98d5960480a8",
                        "entry_id": "d78db636-9c58-38b8-8e70-33529621b25d",
                        "tags": [
                            "plural"
                        ],
                        "form": "verschansingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85929214-44b0-3407-9f6c-6f28e36158c0",
                        "entry_id": "d78db636-9c58-38b8-8e70-33529621b25d",
                        "glosses": [
                            "een (militair) versterkte plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cee3a34-9608-43a7-8738-eaae0bd4992d",
                                "sense_id": "85929214-44b0-3407-9f6c-6f28e36158c0",
                                "text": "Regelmatig patrouilleerden ze samen door Brussel of Vlaams-Brabant. ‘Op dagen zonder gijzelingen, gewapende verschansingen, rondvliegen met de Puma-helikopter, schietoefeningen of gevechtsport, reden we kriskras rond op zoek naar louche figuren’, zegt hij. ‘Chris was daar geregeld bij.’"
                            },
                            {
                                "example_id": "d88bf312-f386-4c76-abbd-634e24a65fd4",
                                "sense_id": "85929214-44b0-3407-9f6c-6f28e36158c0",
                                "text": "Dit is een 'ensemble in het duinlandschap, waarbij privacy, uitzicht, de omgeving en de bezonning optimaal op elkaar zijn afgestemd', zo voegt een makelaarssite eraan toe. Had ik even niet gezien. De verschansingen zijn te koop voor een kleine miljoen euro per stuk."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a29e08a-6acc-3421-8c1b-6379caacef0a",
                        "entry_id": "d78db636-9c58-38b8-8e70-33529621b25d",
                        "glosses": [
                            "vaste wand rondom het dek van een schip"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6315f2ef-294e-42c3-a9d5-753e25fa4308",
                        "source_entry_id": "d78db636-9c58-38b8-8e70-33529621b25d",
                        "source_sense_id": "85929214-44b0-3407-9f6c-6f28e36158c0",
                        "source_sense_description": "militaire versterking",
                        "target_lang_word": "bulwark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulwark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79b94f10-b302-3604-b78d-1b6d14510c68",
                                        "entry_id": "a29e40f7-55a8-38f8-9605-56c67366f4af",
                                        "glosses": [
                                            "A defensive wall or rampart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c40a56-7576-49fa-945a-9139d6e14434",
                                                "sense_id": "79b94f10-b302-3604-b78d-1b6d14510c68",
                                                "text": "Let thouſands die, their ſlaughtered Carkaſſes\nShal ſerue for walles and bulwarkes to the reſt:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a8e643-2fd4-3e10-ace8-468f938214d9",
                                        "entry_id": "a29e40f7-55a8-38f8-9605-56c67366f4af",
                                        "glosses": [
                                            "A defense or safeguard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f161924c-c164-43fc-8714-94b42497a678",
                                                "sense_id": "21a8e643-2fd4-3e10-ace8-468f938214d9",
                                                "text": "The royal navy of England hath ever been its greatest defence, […] the floating bulwark of the island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd37f32-d1a6-365a-b2b9-2e74afd28659",
                                        "entry_id": "a29e40f7-55a8-38f8-9605-56c67366f4af",
                                        "glosses": [
                                            "A breakwater."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "414cfcb1-ed6e-3ff3-8842-53503d6d2dff",
                                        "entry_id": "a29e40f7-55a8-38f8-9605-56c67366f4af",
                                        "glosses": [
                                            "The planking or plating along the sides of a nautical vessel above her gunwale that reduces the likelihood of seas washing over the gunwales and people being washed overboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ed9e7d-7805-46ac-8a2d-e937f5959862",
                                                "sense_id": "414cfcb1-ed6e-3ff3-8842-53503d6d2dff",
                                                "text": "Entering that gable-ended Spouter-Inn, you found yourself in a wide, low, straggling entry with old-fashioned wainscots, reminding one of the bulwarks of some condemned old craft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "492b6098-ca55-33f2-8cf2-c54403a034b9",
                                        "entry_id": "a29e40f7-55a8-38f8-9605-56c67366f4af",
                                        "glosses": [
                                            "Any means of defence or security."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "816ff85f-8173-48a6-a931-774739b393f1",
                                                "sense_id": "492b6098-ca55-33f2-8cf2-c54403a034b9",
                                                "text": "The party stalwarts constitute the bulwark that ensures the president's term of office."
                                            },
                                            {
                                                "example_id": "90e29304-b39a-4202-9d30-96bd50d93c8b",
                                                "sense_id": "492b6098-ca55-33f2-8cf2-c54403a034b9",
                                                "text": "Willing to upend the nation’s postwar role as a bulwark against authoritarianism, he promises to usher in a foreign policy rooted in “America First” transactionalism."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bulwark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fb07fb2-e9ab-3ff1-8adf-6b4fcf9967a2",
                                        "entry_id": "9b311c66-332a-388b-91f8-f02198c89f12",
                                        "glosses": [
                                            "To fortify something with a wall or rampart."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
