                "senses": [
                    {
                        "sense_id": "aea218a9-6c7f-3bb4-aadc-f6a4862c35e6",
                        "entry_id": "fe691e08-9558-3990-a0f2-2ff1bb2025c6",
                        "glosses": [
                            "Subsidier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b578e256-abce-43d7-affa-9a7082327093",
                                "sense_id": "aea218a9-6c7f-3bb4-aadc-f6a4862c35e6",
                                "text": "Peu de gens postent sur un forum vide, quite à le resubsidier lorsque les visiteurs seront là."
                            },
                            {
                                "example_id": "b7caf3d2-2a13-452b-b617-1c243b33c732",
                                "sense_id": "aea218a9-6c7f-3bb4-aadc-f6a4862c35e6",
                                "text": "Alors pourquoi nous soumettre ces documents comptable si ce n'est parce que vous avez l'intention de. «resubsidier » WN (d'ailleurs une nécessité !) ?"
                            },
                            {
                                "example_id": "7d892f60-c905-4d01-95ff-5c6fa0c14121",
                                "sense_id": "aea218a9-6c7f-3bb4-aadc-f6a4862c35e6",
                                "text": "Les gestes évoqués sont le retrait de la circulaire Peeters (obligeant les francophones de la périphérie à redemander systématiquement leurs documents administratifs en français), l'autorisation pour la Communauté française de resubsidier des associations culturelles situées en sol flamand, et de sérieuses garanties pour les francophones de la périphérie."
                            }
                        ]
                    }
