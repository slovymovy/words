{
    "word_family": [
        "diaphaneity",
        "diaphanously",
        "diaphanousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f52578d6-77a6-3a93-b98a-478ebd54ca7b",
                    "sense_definition": "Transparent or translucent; light and delicate enough to allow light to pass through.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning sun filtered softly through the <w>diaphanous</w> curtains hanging in the bedroom.",
                            "target_lang_translations": {
                                "es": "El sol de la mañana se filtraba suavemente a través de las cortinas <w>diáfanas</w> colgadas en el dormitorio."
                            }
                        },
                        {
                            "text": "She wore a <w>diaphanous</w> silk scarf that fluttered gracefully in the evening breeze.",
                            "target_lang_translations": {
                                "es": "Llevaba un pañuelo de seda <w>vaporoso</w> que ondeaba con gracia en la brisa del atardecer."
                            }
                        }
                    ],
                    "synonyms": [
                        "translucent",
                        "transparent",
                        "see-through",
                        "sheer"
                    ],
                    "antonyms": [
                        "opaque"
                    ],
                    "common_phrases": [
                        "diaphanous curtains",
                        "diaphanous fabric",
                        "diaphanous silk",
                        "diaphanous gown"
                    ],
                    "target_lang_definitions": {
                        "es": "Transparente o traslúcido; tan fino y ligero que deja pasar la luz a través de él."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "diáfano",
                                "target_lang_sense_clarification": "que deja pasar la luz casi por completo"
                            },
                            {
                                "target_lang_word": "transparente",
                                "target_lang_sense_clarification": "a través del cual se puede ver claramente"
                            },
                            {
                                "target_lang_word": "traslúcido",
                                "target_lang_sense_clarification": "que deja pasar la luz pero no permite ver nítidamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "810daa86-ea77-37ff-b021-d397df35a0dd",
                    "sense_definition": "Extremely delicate, light, or insubstantial in nature or texture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dragonfly fluttered around the pond on its <w>diaphanous</w> wings.",
                            "target_lang_translations": {
                                "es": "La libélula revoloteaba alrededor del estanque con sus alas <w>diáfanas</w>."
                            }
                        },
                        {
                            "text": "A <w>diaphanous</w> mist rose quietly from the river as dawn approached.",
                            "target_lang_translations": {
                                "es": "Una <w>vaporosa</w> niebla se elevaba silenciosamente del río al acercarse el amanecer."
                            }
                        }
                    ],
                    "synonyms": [
                        "delicate",
                        "insubstantial",
                        "sheer"
                    ],
                    "antonyms": [
                        "solid",
                        "concrete"
                    ],
                    "common_phrases": [
                        "diaphanous wings",
                        "diaphanous mist"
                    ],
                    "target_lang_definitions": {
                        "es": "Extremadamente delicado, ligero, sutil o vaporoso."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vaporoso",
                                "target_lang_sense_clarification": "ligero, tenue y delicado"
                            },
                            {
                                "target_lang_word": "sutil",
                                "target_lang_sense_clarification": "extremadamente delgado o delicado"
                            },
                            {
                                "target_lang_word": "etéreo",
                                "target_lang_sense_clarification": "extremadamente sutil, liviano o intangible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22f5ebac-ebde-371c-9ad8-390b117f88e4",
                    "sense_definition": "Having an identical refractive index; isorefractive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist tested the <w>diaphanous</w> minerals to observe how light bent across their boundaries.",
                            "target_lang_translations": {
                                "es": "El científico examinó los minerales <w>isorrefractivos</w> para observar cómo se refractaba la luz en sus límites."
                            }
                        },
                        {
                            "text": "When immersed in a matching liquid, the <w>diaphanous</w> crystal seemed completely invisible.",
                            "target_lang_translations": {
                                "es": "Al sumergirse en un líquido con propiedades idénticas, el cristal <w>isorrefractivo</w> parecía completamente invisible."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Que tiene el mismo índice de refracción; isorrefractivo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "isorrefractivo",
                                "target_lang_sense_clarification": "con idéntico índice de refracción"
                            },
                            {
                                "target_lang_word": "diáfano",
                                "target_lang_sense_clarification": "en óptica o mineralogía, isorrefractivo con el medio circundante"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}