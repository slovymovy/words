                "senses": [
                    {
                        "sense_id": "042b62b6-eb1c-3e85-8651-1e0ab55d72ae",
                        "entry_id": "252f6f0d-b40f-3296-b47e-6368ef8864e6",
                        "glosses": [
                            "Wirtschaftsbereich, der die Summe aller Geld- und Kreditinstitute umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fe3b6ca-c6fd-423f-8a76-5c9344f618c6",
                                "sense_id": "042b62b6-eb1c-3e85-8651-1e0ab55d72ae",
                                "text": "„Der Bankensektor kann als Hauptpfeiler des deutschen Finanzsystems gesehen werden, da dieses auf einem bankenbasierten System beruht.“"
                            },
                            {
                                "example_id": "c007055e-d185-4a9b-aee0-472fe463778c",
                                "sense_id": "042b62b6-eb1c-3e85-8651-1e0ab55d72ae",
                                "text": "„Der Autor befasst sich mit der Europäischen Bankenunion, durch deren Errichtung eine weitergehende Integration des europäischen Bankensektors sowie eine Förderung des Vertrauens in die Stabilität desselben angestrebt werden.“"
                            },
                            {
                                "example_id": "49126a54-6a44-4de1-a898-76c955bcbc79",
                                "sense_id": "042b62b6-eb1c-3e85-8651-1e0ab55d72ae",
                                "text": "„Kaum eine Industrie wird durch die Digitalisierung so stark geprägt wie der Bankensektor.“"
                            },
                            {
                                "example_id": "6f844ceb-03b3-42d3-99b0-64e430e9a200",
                                "sense_id": "042b62b6-eb1c-3e85-8651-1e0ab55d72ae",
                                "text": "„Andere Länder sind zu sehr damit beschäftigt, den Bankensektor zum Teufel zu wünschen, als dass sie auf kreative Lösungen kommen könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
