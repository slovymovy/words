                    }
                ],
                "senses": [
                    {
                        "sense_id": "34370789-ed24-309d-848d-263555a4903e",
                        "entry_id": "02045dcb-e749-39a7-8a62-445561ae341b",
                        "glosses": [
                            "albo osoba, która dorobiła się majątku lub pozycji społecznej, ale nie jest akceptowana przez nowe środowisko"
                        ],
                        "tags": [
                            "literary",
                            "pejorative",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "3d756fb4-1d9a-4e2a-8159-a132658be91d",
                                "sense_id": "34370789-ed24-309d-848d-263555a4903e",
                                "text": "W pierwszej klasie jacyś nuworysze z chłopskimi twarzami, ubrani w wykwintne garnitury, czarne płaszcze do kolan, koszule, teraz poszarzałe, poplamione podczas długiej podróży"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c1ff45c-3bd0-4211-bbae-72cd17f45af6",
                        "source_entry_id": "02045dcb-e749-39a7-8a62-445561ae341b",
                        "source_sense_id": "34370789-ed24-309d-848d-263555a4903e",
                        "target_lang_word": "nouveau riche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nouveau riche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac49e98-31e7-3aea-bf7a-6e5ca17055ff",
                                        "entry_id": "ed251667-9f2c-385a-adf8-fc99dfe7acb7",
                                        "glosses": [
                                            "New money; wealthy persons whose fortunes are newly acquired, and who are therefore perceived to lack the refinement of those who were raised wealthy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce1a025-f57d-416d-8aed-1eb6f10f8d0f",
                                                "sense_id": "1ac49e98-31e7-3aea-bf7a-6e5ca17055ff",
                                                "text": "You must find your opening at Paris. I wish you to spend a year in the capital, and live, not extravagantly, like a nouveau riche, but in a way not unsuited to your rank, and permitting you all the social advantages that belong to it."
                                            },
                                            {
                                                "example_id": "0b8f1e50-4f00-48d0-a52e-3404466b5f92",
                                                "sense_id": "1ac49e98-31e7-3aea-bf7a-6e5ca17055ff",
                                                "text": "Twenty-four hours later we were both in the vast halls of the Winter Palace in full uniform, as bedizened with gold as a nouveau riche’s drawing-room."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nouveau riche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5ec473-f8e2-35d5-9290-ce9a2623d9fb",
                                        "entry_id": "0f5879f5-e4eb-3a04-bd82-732fd3f8cfcd",
                                        "glosses": [
                                            "Newly rich; like a nouveau riche."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f5c0357-820c-4403-be2c-b4aedc6a3d2a",
                                                "sense_id": "bd5ec473-f8e2-35d5-9290-ce9a2623d9fb",
                                                "text": "Her supreme charm was the simplicity that comes of taking it for granted that people are born with carriages and country-places: it never occurred to her that such congenital attributes could be matter for self-consciousness, and she had none of the nouveau riche prudery which classes poverty with the nude in art and is not sure how to behave in the presence of either."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db564f84-3ed2-4a46-a898-71e01452c186",
                        "source_entry_id": "02045dcb-e749-39a7-8a62-445561ae341b",
                        "source_sense_id": "34370789-ed24-309d-848d-263555a4903e",
                        "target_lang_word": "nuevo rico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuevo rico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b74c3e-7c7f-3006-b784-54c90770cada",
                                        "entry_id": "3f1483e5-1eea-3e6c-9faa-f65684d90eba",
                                        "glosses": [
                                            "Una persona que anteriormente pertenecía a un menor extracto social, pero que recientemente logró enriquecerse y alcanzar la movilidad social, y por lo tanto no tiene el refinamiento y las costumbres características de las personas que nacieron ricas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4502c1b4-0640-4737-be6e-b506e8e74b33",
                        "source_entry_id": "02045dcb-e749-39a7-8a62-445561ae341b",
                        "source_sense_id": "34370789-ed24-309d-848d-263555a4903e",
                        "target_lang_word": "Neureicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neureicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa9bacf-be3c-3962-8926-d2d0ccd1c407",
                                        "entry_id": "79841f18-d476-3613-b831-a3fc1c3629c9",
                                        "glosses": [
                                            "jemand, der in kurzer Zeit zu Geld, Macht und Einfluss gekommen ist und damit protzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06bbdda3-0ce4-452d-8b0e-fedec54e74c3",
                                                "sense_id": "aaa9bacf-be3c-3962-8926-d2d0ccd1c407",
                                                "text": "„Die Abneigung der Polen gegen ihre Neureichen steht der der Westeuropäer in nichts nach.“"
                                            },
                                            {
                                                "example_id": "b83e15c0-35a7-4f61-b9a9-316251e3e7a5",
                                                "sense_id": "aaa9bacf-be3c-3962-8926-d2d0ccd1c407",
                                                "text": "„Das Fundament war die wirklich vornehme, wirklich aufgeschlossene, wirklich kultivierte Berliner Gesellschaft, die gediegenen Kreise aus dem Westen, der Tiergartenstraße oder dem Grunewald, die den lauten Parvenüs und Neureichen an Zahl, Rang und Gewicht immer noch überlegen waren – ebenso das Volk, die jungen Menschen aller Stände, und die – für ein paar Jahre – durch die erstarkende Großindustrie gesicherte Arbeiterschaft.“"
                                            },
                                            {
                                                "example_id": "c2e90ab4-51dc-4e41-b919-e51afdd2fe2a",
                                                "sense_id": "aaa9bacf-be3c-3962-8926-d2d0ccd1c407",
                                                "text": "„Er nahm von den Reichen der Besatzungszeit, von den Hyänen der Währungsreform, von den Neureichen des Wirtschaftswunders.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
