                        "glosses": [
                            "bei Deichbruch aufgespültes Wasserloch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a66634-b56f-44a9-a4e6-3df1e12c79d7",
                                "sense_id": "2a51f174-37be-39d7-abc4-280ee98d1d12",
                                "text": "Die Kinder baden in der Wehle."
                            },
                            {
                                "example_id": "cb9f0ed0-8726-4f69-a46f-4cfdccde4f4d",
                                "sense_id": "2a51f174-37be-39d7-abc4-280ee98d1d12",
                                "text": "„Als ich jene Stelle erreicht hatte, sah ich hart am Deich im Kooge unten das Wasser einer großen Wehle blinken – so nennen sie dort die Brüche, welche von den Sturmfluten in das Land gerissen werden und die dann meist als kleine, aber tiefgründige Teiche stehen bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
