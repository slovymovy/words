                "senses": [
                    {
                        "sense_id": "7ca2aefe-6a21-3c9e-935c-7baf43225cf4",
                        "entry_id": "3b803379-ccef-3323-aaff-5631e0b31a61",
                        "glosses": [
                            "Projekt, das der Erforschung von etwas dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f01716-c5c7-40a0-a172-77f8c04913c5",
                                "sense_id": "7ca2aefe-6a21-3c9e-935c-7baf43225cf4",
                                "text": "„Auf der Basis immer leistungsfähigerer Rechner haben Forscher 2005 in einem bisher einmaligen Forschungsprojekt damit begonnen, einen Teil eines echten Gehirns in Form eines gigantischen Computermodells zu simulieren, um das Zusammenspiel von Nervenzellverbänden besser zu verstehen („Blue Brain“-Projekt).“"
                            },
                            {
                                "example_id": "abe63de6-a225-481a-8a34-c98b22404a82",
                                "sense_id": "7ca2aefe-6a21-3c9e-935c-7baf43225cf4",
                                "text": "„Ingenieure vom Lehrstuhl für Elektronische Meß- und Schaltungstechnik an der Ruhr-Universität Bochum haben in einem gemeinsamen Forschungsprojekt mit dem Bereich Automobiltechnik der Siemens AG die Grundlagen für die elektromagnetische Ventilbetätigung der zweiten Generation erarbeitet.“"
                            },
                            {
                                "example_id": "df60dfd7-b40d-4c58-a70c-9493a0a71fd7",
                                "sense_id": "7ca2aefe-6a21-3c9e-935c-7baf43225cf4",
                                "text": "„In Zukunft wird die Plagiatorin Koch-Mehrin über die Förderung von Forschungsprojekten innerhalb der EU mitentscheiden dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
