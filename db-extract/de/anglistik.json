                        "form": "die Anglistik"
                    },
                    {
                        "form_id": "ccb432cf-ad4e-432f-9edd-fb39b01c90c2",
                        "entry_id": "9892529a-0781-3021-adca-50d8cc4ee4bb",
                        "tags": [
                            "accusative",
