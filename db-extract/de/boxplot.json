                "senses": [
                    {
                        "sense_id": "c7e1b65e-05e2-38e5-9411-f7b79220d2cf",
                        "entry_id": "f4ffe8c0-5fca-3812-863d-03daadebb4d2",
                        "glosses": [
                            "Darstellungsform für statistische Daten, in der insbesondere die Streuung verdeutlicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afe688b1-2aa1-478f-9f4d-30c6495f107e",
                                "sense_id": "c7e1b65e-05e2-38e5-9411-f7b79220d2cf",
                                "text": "„Ein Boxplot, das in verschiedenen Varianten Anwendung findet, veranschaulicht in Ergänzung eines Säulendiagramms oder eines Histogramms die Verteilung und die Struktur der zu analysierenden Daten.“"
                            },
                            {
                                "example_id": "6be51e80-87bc-40fe-919b-e05818b17fda",
                                "sense_id": "c7e1b65e-05e2-38e5-9411-f7b79220d2cf",
                                "text": "„Ist der Boxplot symmetrisch – liegt der Median also in der Mitte der Box und sind die Whiskers vergleichsweise gleich lang – liegt eine symmetrische Verteilung vor.“"
                            },
                            {
                                "example_id": "faca3432-9505-416c-a4c2-964b0154c280",
                                "sense_id": "c7e1b65e-05e2-38e5-9411-f7b79220d2cf",
                                "text": "„Boxplots […] bieten eine übersichtliche grafische Darstellung von intervallskalierten Daten mit wichtigen Lagekennwerten.“"
                            },
                            {
                                "example_id": "8f980a25-50e5-4a5e-9f9b-c48905fa45ad",
                                "sense_id": "c7e1b65e-05e2-38e5-9411-f7b79220d2cf",
                                "text": "„Ein Boxplot stellt die Lage und Verteilung der Werte einer Variablen grafisch dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
