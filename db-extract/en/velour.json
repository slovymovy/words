                "senses": [
                    {
                        "sense_id": "2ba72afc-09a3-3bc6-965e-7e8dd002abbe",
                        "entry_id": "77add784-1a5c-336b-a5e2-6ce152565a9e",
                        "glosses": [
                            "A knit fabric similar to velvet, but usually somewhat coarser."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d49d6370-038f-41ea-b479-d9bdfebacf00",
                        "source_entry_id": "77add784-1a5c-336b-a5e2-6ce152565a9e",
                        "source_sense_id": "2ba72afc-09a3-3bc6-965e-7e8dd002abbe",
                        "source_sense_description": "a knit fabric similar to velvet, but usually somewhat coarser",
                        "target_lang_word": "velours",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "velours",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b9addfd-e45d-39ae-b888-7baa550cedef",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Étoffe à poil court et serré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41db8fd7-e6c8-41b2-b3ac-0e134323160a",
                                                "sense_id": "0b9addfd-e45d-39ae-b888-7baa550cedef",
                                                "text": "Et en même temps une portière de velours violet fleurdelisé d’or se soulevant, le duc distingua dans l’ombre la reine elle-même […]"
                                            },
                                            {
                                                "example_id": "c08986e8-7514-4aee-bc6d-7c410e0e66c4",
                                                "sense_id": "0b9addfd-e45d-39ae-b888-7baa550cedef",
                                                "text": "Les tables peintes en marbre, les tabourets en velours d’Utrecht rouge, le quinquet à globe plein d’huile alimentant deux becs, attaché par une chaîne au plafond et enjolivé de cristaux, commencèrent la célébrité du Café de la Guerre."
                                            },
                                            {
                                                "example_id": "16f93c4c-1ea5-447d-971c-ac5198fb4112",
                                                "sense_id": "0b9addfd-e45d-39ae-b888-7baa550cedef",
                                                "text": "« Il y a vingt ans que j’ai dit : “Le velours fait des vêtements idiots, en tout cas ici”. Dès que c’est mouillé ça sent le chien et ça met un temps infini à sécher. »"
                                            },
                                            {
                                                "example_id": "d708713b-5667-4cba-b5a6-850399342095",
                                                "sense_id": "0b9addfd-e45d-39ae-b888-7baa550cedef",
                                                "text": "Mon attention a été attirée par un pantalon de velours côtelé, assez usagé, et qui séchait sur un fil de fer à proximité de la porte de la cuisine, ou plus précisément en face de cette porte."
                                            },
                                            {
                                                "example_id": "f8bb1568-7486-4718-b714-1c446f5061ef",
                                                "sense_id": "0b9addfd-e45d-39ae-b888-7baa550cedef",
                                                "text": "– Qu'est-ce que vous vouliez écouter ? lui demanda le patron en jetant sur le velours vert de la piste les trois dés qu’il avait dans la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "473cfb9d-e3cb-311d-923c-7305fb91aa9c",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Toute matière ou chose qui par sa douceur ou son aspect, rappelle ce tissu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a09079-82de-4e06-afb2-612136d0794a",
                                                "sense_id": "473cfb9d-e3cb-311d-923c-7305fb91aa9c",
                                                "text": "Le velours de sa peau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df45bb8-4233-3bf7-8f26-756820bb0c75",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Tissu tégumentaire qui assure la protection, la vascularisation et l’innervation des bois chez la plupart des cervidés."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a0dc594-ac6b-3cc5-99af-7daeb94e8269",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Duvet couvrant certaines parties de la plante ou ensemble d’éléments végétaux fins et serrés rappelant l’aspect duveté du velours."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83de2ce1-de6d-346a-879f-939a47967953",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Boisson, aliment d'une grande douceur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6401cc43-49d8-4f60-b69a-b5887618187b",
                                                "sense_id": "83de2ce1-de6d-346a-879f-939a47967953",
                                                "text": "Mais si t’as le gosier\nQu’une armure d’acier\nMatelasse,\nGoûte à ce velours,\nCe petit bleu lourd\nDe menaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b5b50e1-6d1b-3a72-991e-5223ba2ea378",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Ensemble des fils de laine qui ne sont pas des fils de trame d’un tapis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dde051d-bd9d-320f-b910-ce4d20b4fbe4",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Mauvaise prononciation d’une liaison par addition d’un \\\\z\\\\ ; Voir « z’ ». Celle par addition d’un \\\\t\\\\ est appelée cuir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a2b0c1-9e29-49af-9b57-8e04b87e5cde",
                                                "sense_id": "7dde051d-bd9d-320f-b910-ce4d20b4fbe4",
                                                "text": "Dire cent-z-étudiants ou donne-moi-z-en sont des velours courants."
                                            },
                                            {
                                                "example_id": "59066f22-43d0-4ce9-8290-a752bcaa54af",
                                                "sense_id": "7dde051d-bd9d-320f-b910-ce4d20b4fbe4",
                                                "text": "Le moment du sermon faisait de ma mère une diablesse. Les cuirs, les « velours », les naïvetés chrétiennes d’un vieux curé paysan, rien ne la désarmait. Les bâillements nerveux sortaient d’elle comme des flammes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f86399-c241-3113-92ee-83881651dafa",
                                        "entry_id": "ec0de0dc-e606-3b0d-8e83-48779c7638ee",
                                        "glosses": [
                                            "Bénéfice."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e22a0551-a771-4444-aed0-3eada945bac2",
                                                "sense_id": "78f86399-c241-3113-92ee-83881651dafa",
                                                "text": "Le vendredi et le samedi l’avaient quelques minutes rambiné au passage, avec leur velours respectif de quarante-cinq et soixante-dix mille, seulement, minute ! le reste du temps, la plongée moyenne s’établissait à quarante sacs."
                                            },
                                            {
                                                "example_id": "ace3c0bb-4a27-4115-8c90-00c2d875be98",
                                                "sense_id": "78f86399-c241-3113-92ee-83881651dafa",
                                                "text": "- Tu sais combien ça laisse une roulette?…. 60% de velours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
