                "senses": [
                    {
                        "sense_id": "1a49ed6c-5454-3aa8-bcb1-ff57793ba587",
                        "entry_id": "b8ad61b8-5a4f-3f8d-895e-97658efc7f3a",
                        "glosses": [
                            "Qualifie une arme pouvant tirer des munitions de différents calibres."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "2320464a-8d1e-4836-ab6d-313d07cbca29",
                                "sense_id": "1a49ed6c-5454-3aa8-bcb1-ff57793ba587",
                                "text": "Conçu pour le combat collaboratif, le Scarabée est en mesure d’embarquer différents systèmes tels que des tourelleaux multi-rôles, un canon multicalibre, une caméra RGL, des lanceurs MMP (ou MILAN), des systèmes de lutte anti-drones, un radar…"
                            },
                            {
                                "example_id": "61187520-7475-49cd-9c95-d859ad3b3a0e",
                                "sense_id": "1a49ed6c-5454-3aa8-bcb1-ff57793ba587",
                                "text": "Cette carabine multicalibre innovante permet, grâce à son système de changement de canon breveté, de changer de calibre tout en conservant le zérotage de l’arme à chaque fois."
                            }
                        ]
                    },
                    {
                        "sense_id": "5780a85d-1386-3ef0-9cb3-495aa23e15b6",
                        "entry_id": "b8ad61b8-5a4f-3f8d-895e-97658efc7f3a",
                        "glosses": [
                            "Qualifie un appareil pouvant fonctionner avec différentes tensions de courant électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1202863-9839-4dde-acec-4f0aa65f1eef",
                                "sense_id": "5780a85d-1386-3ef0-9cb3-495aa23e15b6",
                                "text": "L’aiguille d’un ampèremètre multicalibre ne donne pas directement sur le cadran la valeur de l’intensité mesurée, mais donne une indication proportionnelle à cette valeur."
                            },
                            {
                                "example_id": "1d7c980d-1acd-40d1-bd15-16a91fd67797",
                                "sense_id": "5780a85d-1386-3ef0-9cb3-495aa23e15b6",
                                "text": "Pour un laboratoire de métrologie, les étalons de référence seront des appareils à transfert thermique à base de convertisseurs. Ces appareils peuvent être monocalibres ou multicalibres avec différentes valeurs de résistance associées au même thermoélément."
                            }
                        ]
                    }
