                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93fb4ca8-8390-4712-aa82-c06cb58f369d",
                                "sense_id": "7fd9b3f7-4cac-397b-aeea-15904132a6bd",
                                "text": "Die Erstattung des Schadens ließ lange auf sich warten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2cebd37d-f740-3874-9a62-a449210ed20c",
                        "entry_id": "ef87fc52-ffa1-349e-9a72-105c26115291",
                        "glosses": [
                            "Vortrag (einer Anzeige, eines Berichts)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9632c280-c41f-4f95-987b-f6136cc0c026",
                                "sense_id": "2cebd37d-f740-3874-9a62-a449210ed20c",
                                "text": "Es war nur eine Frage der Zeit, bis es zur Erstattung der Anzeige kam."
                            },
                            {
                                "example_id": "099da618-7dae-42ba-9925-8bbe084b3bf3",
                                "sense_id": "2cebd37d-f740-3874-9a62-a449210ed20c",
                                "text": "„Am Mittwoch hat er mit der Erstattung seines Gutachtens begonnen, an diesem Donnerstag hat er seine Ausführungen fortgesetzt, am 6. Dezember soll er sie beenden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a183bf88-9a3f-4b69-b7b1-bc3451ed7ff4",
                        "source_entry_id": "ef87fc52-ffa1-349e-9a72-105c26115291",
                        "source_sense_id": "7fd9b3f7-4cac-397b-aeea-15904132a6bd",
                        "source_sense_description": "das Zurückgeben, Ersetzen",
                        "target_lang_word": "refund",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refund",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53c9d661-7747-3de6-b4fd-e464f6e29e96",
                                        "entry_id": "9297696d-2506-3162-b803-9cb21b79101e",
                                        "glosses": [
                                            "To return (money) to (someone); to reimburse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "587f99de-d044-4629-b1da-82c10793c3c8",
                                                "sense_id": "53c9d661-7747-3de6-b4fd-e464f6e29e96",
                                                "text": "If you find this computer for sale anywhere at a lower price, we’ll refund you the difference."
                                            },
                                            {
                                                "example_id": "d7d0b261-a440-4c18-83d8-c7f2d8966d57",
                                                "sense_id": "53c9d661-7747-3de6-b4fd-e464f6e29e96",
                                                "text": "A Governor, that had Pillag'd the People, was […] sentenc'd to Refund what he had Wrongfully Taken."
                                            },
                                            {
                                                "example_id": "4ab09832-dbbc-412a-90d5-cea80d8b6bd2",
                                                "sense_id": "53c9d661-7747-3de6-b4fd-e464f6e29e96",
                                                "text": "Finding us easy in our ways, he […] told me a cock-and-bull story with the moral of another five francs for the narrator. The thing was palpably absurd; but I paid up, and at once dropped all friendliness of manner, and kept him in his place as an inferior with freezing British dignity. He saw in a moment that he had gone too far, and killed a willing horse; his face fell; I am sure he would have refunded if he could only have thought of a decent pretext."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8145ad8b-0305-3d29-87d1-d00d91bcedcb",
                                        "entry_id": "9297696d-2506-3162-b803-9cb21b79101e",
                                        "glosses": [
                                            "To obtain a refund."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f39bb5-a10e-443c-a29a-f1a2fe9c9c2b",
                                                "sense_id": "8145ad8b-0305-3d29-87d1-d00d91bcedcb",
                                                "text": "this game sucks, imma refund it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c8cb26-5fbd-396c-a5c8-b3430c488496",
                                        "entry_id": "9297696d-2506-3162-b803-9cb21b79101e",
                                        "glosses": [
                                            "To supply (someone) again with funds."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7934bf2e-6916-4e76-9f2a-a39eacaa72e0",
                                                "sense_id": "b9c8cb26-5fbd-396c-a5c8-b3430c488496",
                                                "text": "to refund a railroad loan"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42400ba6-571d-32ca-b9a3-f61f88e5bc43",
                                        "entry_id": "9297696d-2506-3162-b803-9cb21b79101e",
                                        "glosses": [
                                            "To pour back (something)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6facd70b-9299-4e35-b1eb-30b145f494b6",
                                                "sense_id": "42400ba6-571d-32ca-b9a3-f61f88e5bc43",
                                                "text": "Were the humours of the eye tinctured with any colour, they would refund that colour upon the object."
                                            },
                                            {
                                                "example_id": "09da4ef7-e7da-455b-b9a5-770fcd295f50",
                                                "sense_id": "42400ba6-571d-32ca-b9a3-f61f88e5bc43",
                                                "text": "When our mutual trance was a little over, and the young fellow had withdrawn that delicious stretcher, with which he had most plentifully drowned all thoughts of revenge in the sense of actual pleasure, the widen'd wounded passage refunded a stream of pearly liquids, which flowed down my thighs, mixed with streaks of blood",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "refund",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50810d9a-fd2c-3ade-9a34-4549e22eb1df",
                                        "entry_id": "b4395d34-08fe-3341-a94e-1d9a23617044",
                                        "glosses": [
                                            "An amount of money returned."
                                        ],
