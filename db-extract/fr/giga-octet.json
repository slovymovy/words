                        "cross_references": [
                            {
                                "target_word": "gigabyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef667109-980e-33c9-bee3-b4d73ed89c27",
                                        "entry_id": "c557b962-a622-3fee-be1f-426f6990dfc2",
                                        "glosses": [
                                            "One billion (10⁹, or 1,000,000,000) bytes or 1,000 megabytes."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8714eb17-80b8-447a-93d2-e02fceea2691",
                                                "sense_id": "ef667109-980e-33c9-bee3-b4d73ed89c27",
                                                "text": "The IBM 3380 Direct Access Storage is a disk storage device with a storage capacity of 2.5 gigabytes (billion bytes) per unit, an increase of almost four times the capacity of the IBM 3350 Direct Access Storage."
                                            },
                                            {
                                                "example_id": "52afbfb4-b9bf-4c7c-8577-fc0d6692e250",
                                                "sense_id": "ef667109-980e-33c9-bee3-b4d73ed89c27",
                                                "text": "It does not take much effort these days to accumulate several hundred gigabytes of data. A few hundred songs, a couple of vacations’ worth of photos, a dozen movies and television programs — and suddenly the 80 gigabyte hard drive in the notebook computer is straining."
                                            },
                                            {
                                                "example_id": "f3d22db5-5cf1-4132-acc6-adb318a7b116",
                                                "sense_id": "ef667109-980e-33c9-bee3-b4d73ed89c27",
                                                "text": "In that trial, new customers can buy plans with a 5-gigabyte cap, a 20-gigabyte cap or a 40-gigabyte cap. Prices for those plans range from $30 to $50. Above the cap, customers pay $1 a gigabyte. Plans with higher caps come with faster service."
                                            },
                                            {
                                                "example_id": "7598a6b1-27c4-4336-a025-fc3fc0ead6a1",
                                                "sense_id": "ef667109-980e-33c9-bee3-b4d73ed89c27",
                                                "text": "GPT-3 belongs to a category of deep learning known as a large language model, a complex neural net that has been trained on a titanic data set of text: in GPT-3’s case, roughly 700 gigabytes of data drawn from across the web, including Wikipedia, supplemented with a large collection of text from digitized books. GPT-3 is the most celebrated of the large language models, and the most publicly available, but Google, Meta (formerly known as Facebook) and DeepMind have all developed their own L.L.M.s in recent years."
                                            }
                                        ]
                                    },
