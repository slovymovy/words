                                "target_senses": [
                                    {
                                        "sense_id": "6da27fea-a54a-3463-a89d-24fd530e1742",
                                        "entry_id": "5d88f05f-64e3-3c2c-af3f-3b4b3585d61e",
                                        "glosses": [
                                            "meist täglich erscheinende Zeitung"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673e550f-3a80-48ef-ada3-ecbe7a4d1761",
                                                "sense_id": "6da27fea-a54a-3463-a89d-24fd530e1742",
                                                "text": "„Am Bootssteg von Veracruz also stand ein schnurrbärtiger Mann. Er heiße Gomez und schreibe für mehrere Journale sowohl Neuspaniens als auch des Mutterlands.“"
                                            },
                                            {
                                                "example_id": "d25b080d-21cf-42dc-bbe8-068cee96f7ce",
                                                "sense_id": "6da27fea-a54a-3463-a89d-24fd530e1742",
                                                "text": "„Gaston saß, blaß vor Wut und Warten, an einem kleinen Tisch, auf dem eine Blattpflanze stand und ein paar Journale lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29932db8-b015-3a77-96de-c62ba96634cc",
                                        "entry_id": "5d88f05f-64e3-3c2c-af3f-3b4b3585d61e",
                                        "glosses": [
                                            "mit Bildern ausgestattete Zeitschrift"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f843199-2618-4fd1-8582-4c197a9fbf84",
                                                "sense_id": "29932db8-b015-3a77-96de-c62ba96634cc",
                                                "text": "„Gaston saß, blaß vor Wut und Warten, an einem kleinen Tisch, auf dem eine Blattpflanze stand und ein paar Journale lagen.“"
                                            },
                                            {
                                                "example_id": "2417aa3a-3bc6-48cc-8bb0-86a818482d29",
                                                "sense_id": "29932db8-b015-3a77-96de-c62ba96634cc",
                                                "text": "„Journalisten kritisierten in Journalen wortreich die Journaille…“"
                                            },
                                            {
                                                "example_id": "709d8417-17e8-4e93-af08-1fd7101d6070",
                                                "sense_id": "29932db8-b015-3a77-96de-c62ba96634cc",
                                                "text": "„Als Herausgeber eines populären Journals führt Wieland eine umfangreiche und vielfältige Korrespondenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
