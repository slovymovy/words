            "senses": [
                {
                    "sense_id": "bd1170ca-5337-3180-b995-d0a378cd377b",
                    "sense_definition": "The buttocks or anus.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slipped on the ice and landed right on her <w>butt</w>.",
                            "target_lang_translations": {
                                "ru": "Она поскользнулась на льду и приземлилась прямо на <w>попу</w>.",
                                "es": "Se resbaló en el hielo y aterrizó justo sobre su <w>trasero</w>.",
                                "zh": "她滑倒在冰面上，一<w>屁股</w>坐在了地上。"
                            }
                        },
                        {
                            "text": "Get off your <w>butt</w> and help me with these heavy boxes.",
                            "target_lang_translations": {
                                "ru": "Подними свою <w>задницу</w> и помоги мне с этими тяжелыми коробками.",
                                "es": "Levanta el <w>culo</w> y ayúdame con estas cajas pesadas.",
                                "zh": "别在那儿<w>偷懒</w>了，快来帮我搬这些重箱子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pain in the butt",
                        "kick butt"
                    ],
                    "traits": [
