                "senses": [
                    {
                        "sense_id": "f789aa91-f8bd-3e5f-91ac-7c6632787dca",
                        "entry_id": "e039033b-9ca4-3fa8-bb17-79b6bab31ce6",
                        "glosses": [
                            "künstlerische Darbietung, häufig mit albernen Elementen im Kontext von Straßenkunst"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "03412268-955d-4ba6-9974-1c05c52ec37d",
                                "sense_id": "f789aa91-f8bd-3e5f-91ac-7c6632787dca",
                                "text": "Beim Straßenkunstfestival wurden aufregende Gaukeleien dargeboten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "54eca4bf-1223-3c7b-b9ed-142be6a565d2",
                        "entry_id": "e039033b-9ca4-3fa8-bb17-79b6bab31ce6",
                        "glosses": [
                            "(böswillige) Irreführung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ef1dc902-cfaa-4f1a-8f85-e3d0c2e08ab6",
                                "sense_id": "54eca4bf-1223-3c7b-b9ed-142be6a565d2",
                                "text": "Scharlatane bieten Gaukeleien wie Handlesen oder Kartenlegen feil."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2dbf314-c2f7-40be-b346-6c83fe36fd47",
                        "source_entry_id": "e039033b-9ca4-3fa8-bb17-79b6bab31ce6",
                        "source_sense_id": "f789aa91-f8bd-3e5f-91ac-7c6632787dca",
                        "source_sense_description": "veraltend: künstlerische Darbietung, häufig mit albernen Elementen im Kontext von Straßenkunst",
                        "target_lang_word": "jugglery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jugglery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94e50d6f-e96e-3800-b7ca-17b9c4795fc9",
                                        "entry_id": "99f950c7-6c94-37bd-9c03-8859b244b134",
                                        "glosses": [
                                            "Witchcraft, sorcery; magical trickery, legerdemain."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e19bc09e-ace6-4580-88fd-b6150df5970d",
                                                "sense_id": "94e50d6f-e96e-3800-b7ca-17b9c4795fc9",
                                                "text": "Omens were expounded, dreams were interpreted, and other tricks of jugglery perhaps resorted to, by which the pretended adepts of the period deceived and fascinated their deluded followers."
                                            },
                                            {
                                                "example_id": "29e1a108-e824-4d96-ba21-bdd9a144565e",
                                                "sense_id": "94e50d6f-e96e-3800-b7ca-17b9c4795fc9",
                                                "text": "[T]he vessel swarmed with the most hideous apparitions. […] But Huldbrand was indignant at such unsightly jugglery [translating Gaukeleien]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d390147c-8c89-3d44-b63d-c531ea4ccd8f",
                                        "entry_id": "99f950c7-6c94-37bd-9c03-8859b244b134",
                                        "glosses": [
                                            "Trickery or deception in general, or an instance of such."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ede4ed4-751f-41e9-82c1-66a19e7da5bb",
                                                "sense_id": "d390147c-8c89-3d44-b63d-c531ea4ccd8f",
                                                "text": "What they call the Great War is over […] and yet what do we see around us? Nothing but strife and juggleries and hatred and contempt and discord wherever you look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2bd8c8a-c926-4f33-bf91-cb1f7fc9d6c7",
                        "source_entry_id": "e039033b-9ca4-3fa8-bb17-79b6bab31ce6",
                        "source_sense_id": "54eca4bf-1223-3c7b-b9ed-142be6a565d2",
                        "source_sense_description": "übertragen: (böswillige) Irreführung",
                        "target_lang_word": "trickery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trickery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "Deception, deceit or underhanded behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871907d6-e92c-4c39-8de2-45e79bdc6b6d",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "[H]e did not wrap his rugged subject in silks and ermines, and other sickly trickeries of phrase."
                                            },
                                            {
                                                "example_id": "e9436b22-cc9b-4f75-9b0e-c58ed05a1925",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "In trickery, evasion, procrastination, spoliation, botheration, under false pretences of all sorts, there are influences that can never come to good."
                                            },
                                            {
                                                "example_id": "0615eac1-3a39-4bec-b197-27e7e4e05478",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "The miners found diversions even in his alleged frauds and trickeries . . . and were fond of relating with great gusto his evasion of the Foreign Miners' Tax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66879016-362f-3471-a02f-535f32de41aa",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "The art of dressing up; imposture, pretense."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcd77d8c-a31a-3e6b-9db1-225598845646",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "Artifice; the use of one or more stratagems."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1336742-b3e2-4753-b71c-f427588189a1",
                                                "sense_id": "dcd77d8c-a31a-3e6b-9db1-225598845646",
                                                "text": "French winger Hatem Ben Arfa has also taken plenty of plaudits recently and he was the architect of the opening goal with some superb trickery on the left touchline."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
