                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c40b9b55-7f49-426f-a743-eac288d9e50c",
                                "sense_id": "a0944da2-ddd2-366d-a64b-5efeb9745ea7",
                                "text": "Le pouvoir a été rapidement amené à confondre la qualité d’intellectuels créatifs avec celle de doxophiles, voire de doxocrates."
                            },
                            {
                                "example_id": "a791cc75-6a9a-404f-b2cc-5b2222a26426",
                                "sense_id": "a0944da2-ddd2-366d-a64b-5efeb9745ea7",
                                "text": "Et les doxocrates de démontrer que le Peuple souhaite que M. Mitterrand se maintienne au pouvoir et, surtout, qu’il ne qu’il soit pas réduit à l’impuissance."
                            }
                        ]
                    }
