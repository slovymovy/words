                "senses": [
                    {
                        "sense_id": "d1d9f900-25a3-32e2-8e33-366853ec33f3",
                        "entry_id": "c58fe6a6-3d58-3dc6-a0b0-74a7fd30f281",
                        "glosses": [
                            "to touch (make physical contact with)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "071225e3-241c-4433-a0a6-a367f9126f15",
                                "sense_id": "d1d9f900-25a3-32e2-8e33-366853ec33f3",
                                "text": "Ну́жно заме́тить, что он терпе́ть не мог, когда́ кто́-нибудь хозя́йничал в его́ владе́ниях. Беда́ тому́, кто дотро́гивался до книг его́!",
                                "translation": "I must observe that he could not bear anyone to meddle in his domain. Woe to anyone who touched his books!",
                                "english": "I must observe that he could not bear anyone to meddle in his domain. Woe to anyone who touched his books!"
                            }
                        ]
                    }
                ],
