    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95403cc9-112e-3e97-b2e8-f6be1a5fc24b",
                    "sense_definition": "Choix possible entre plusieurs partis ou solutions ; alternative offerte.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons examiner chaque <w>option</w> avant de prendre une décision finale."
                        },
                        {
                            "text": "Partir vivre à l'étranger reste une très bonne <w>option</w> pour son avenir."
                        }
                    ],
                    "synonyms": [
                        "choix",
                        "alternative",
                        "possibilité"
                    ],
                    "common_phrases": [
                        "choisir une option"
                    ]
                },
                {
                    "sense_id": "a4fc18e6-2c77-366c-8b5d-459214806918",
                    "sense_definition": "Équipement ou prestation supplémentaire proposé en plus du modèle de base, souvent avec un surcoût.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le système de navigation par satellite est vendu en <w>option</w> sur cette voiture."
                        },
                        {
                            "text": "Il a acheté un véhicule avec de nombreuses <w>options</w> pour voyager confortablement."
                        }
                    ],
                    "synonyms": [
                        "supplément"
                    ],
                    "common_phrases": [
                        "en option",
                        "options payantes"
                    ]
                },
                {
                    "sense_id": "750b55b2-c7af-3da8-bea4-8befaea16196",
                    "sense_definition": "Matière d'enseignement choisie librement par un élève ou un étudiant en complément du tronc commun.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lycée, elle a choisi l'<w>option</w> théâtre pour développer son expression orale."
                        },
                        {
                            "text": "Les étudiants doivent suivre deux <w>options</w> scientifiques durant le second semestre."
                        }
                    ],
                    "common_phrases": [
                        "prendre une option",
                        "option facultative"
                    ]
                },
                {
                    "sense_id": "459316fe-ccfa-370a-ba41-1928297d3b43",
                    "sense_definition": "Action de choisir ou d'adopter formellement une position, une orientation ou une doctrine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a confirmé son <w>option</w> politique dès le début de la campagne électorale."
                        },
                        {
                            "text": "L'entreprise a maintenu son <w>option</w> stratégique en faveur des énergies renouvelables."
                        }
                    ],
                    "synonyms": [
                        "décision",
                        "orientation"
                    ],
                    "common_phrases": [
                        "faire une option"
                    ]
                },
                {
                    "sense_id": "089c814d-dd4f-38db-b127-51bd63b7ad74",
                    "sense_definition": "Droit contractuel accordé à une partie d'acheter ou de vendre un bien à des conditions convenues à l'avance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le club de football a décidé de lever l'<w>option</w> d'achat sur ce jeune joueur."
                        },
                        {
                            "text": "Nous avons posé une <w>option</w> sur cet appartement en attendant la réponse de la banque."
                        }
                    ],
                    "common_phrases": [
                        "lever une option",
                        "option d'achat"
                    ]
                },
                {
                    "sense_id": "d8ba4ea1-e655-37e5-87f6-eba135c48f38",
                    "sense_definition": "En informatique, paramètre facultatif passé à une commande ou un programme pour modifier son exécution.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette commande accepte une <w>option</w> pour afficher les détails du fichier."
                        },
                        {
                            "text": "Vous pouvez modifier le comportement du script en ajoutant une <w>option</w> dans le terminal."
                        }
                    ],
                    "common_phrases": [
                        "option de configuration"
                    ]
                },
                {
                    "sense_id": "46acbff0-c4bf-39a0-aada-1c527d4dfa80",
                    "sense_definition": "En droit civil, faculté accordée à une personne d'accepter ou de refuser un droit ou un régime juridique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La veuve a exercé son <w>option</w> légale concernant le partage des biens matrimoniaux."
                        },
                        {
                            "text": "Le notaire a précisé le délai maximal pour exercer cette <w>option</w> successorale."
                        }
                    ],
                    "common_phrases": [
                        "droit d'option"
                    ]
                }
            ]
        }
    ]
}