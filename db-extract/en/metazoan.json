                "translations": [
                    {
                        "translation_id": "f194df81-ff00-45f3-af8d-4595dcf37928",
                        "source_entry_id": "3343dc18-d276-3a4b-80d7-2550c40cad4b",
                        "source_sense_description": "(zoology) relating to metazoa",
                        "target_lang_word": "métazoaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métazoaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3bd9473-6377-304a-94eb-e7c0438f4ccd",
                                        "entry_id": "aa893409-ad46-32c5-b2ac-f77e1266e979",
                                        "glosses": [
                                            "Animal eucaryote multicellulaire mobile et hétérotrophe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447d7690-04e1-4b74-a5ec-70055b5a3452",
                                                "sense_id": "d3bd9473-6377-304a-94eb-e7c0438f4ccd",
                                                "text": "Chaque individu se comporte envers sa société comme la cellule d’un métazoaire envers son organisme si bien que la termitière ou la ruche peut être considérée comme un organisme à part entière."
                                            },
                                            {
                                                "example_id": "cf97c6c1-aed7-4c65-8a14-39c2b6b0034e",
                                                "sense_id": "d3bd9473-6377-304a-94eb-e7c0438f4ccd",
                                                "text": "La méduse, la mouche ou l’éléphant sont des métazoaires ou Metazoa."
                                            },
                                            {
                                                "example_id": "41b2e436-8d8c-4054-9b99-4606c65fa903",
                                                "sense_id": "d3bd9473-6377-304a-94eb-e7c0438f4ccd",
                                                "text": "Son père lui avait montré, dans un de ses livres de médecine, comment, chez les métazoaires, toutes les cellules proviennent d’une seule cellule primitive : l’œuf. De là naissent trente-deux cellules, agglomérées comme les grains d’une mûre."
                                            }
                                        ]
                                    }
                                ]
                            },
