                                    },
                                    {
                                        "sense_id": "48619b9d-2f79-3c79-99b1-b22db4233f0e",
                                        "entry_id": "6494113a-0d76-3426-8c02-54a35e37e208",
                                        "glosses": [
                                            "…określająca granicę między przeszłością a przyszłością"
                                        ],
                                        "tags": [],
