                        ],
                        "form": "die Vorahnungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                        "entry_id": "ba5a4f98-0752-35c8-8ab3-c5c446c0b268",
                        "glosses": [
                            "undeutliches Gefühl, dass etwas geschehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b62cdfcf-f613-4aa6-87a9-38960969f53a",
                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                "text": "„Spät abends trieb es ihn wie in einer Vorahnung auf den Hof.“"
                            },
                            {
                                "example_id": "f2f40cdd-5964-4935-87a1-4fabadf228f8",
                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                "text": "„Daher brach ich mit einer düsteren Vorahnung zu dieser Reise auf.\""
                            },
                            {
                                "example_id": "8625351e-5492-40aa-bc90-ffa663163432",
                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                "text": "„Aber schon in das Hochgefühl der Siegesfeiern mischten sich dunkle Vorahnungen.“"
                            },
                            {
                                "example_id": "d8ff349c-8e88-4bdb-8dbf-a7b5a9a35a73",
                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                "text": "„Hoffmann hat nicht nur ein sehr lebhaftes Traumleben, oft kommt es auch vor, daß ihm Wachträume erscheinen, er hat oft Vorahnungen und Gesichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e37fda8-d825-4426-b88e-ec520cdcc8df",
                        "source_entry_id": "ba5a4f98-0752-35c8-8ab3-c5c446c0b268",
                        "source_sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                        "source_sense_description": "undeutliches Gefühl, dass etwas geschehen wird",
                        "target_lang_word": "premonition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "premonition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b36becde-2032-34b2-9d0c-b137f1823b87",
                                        "entry_id": "b5160aeb-7717-31f1-a02d-870b89f5f1e0",
                                        "glosses": [
                                            "A clairvoyant or clairaudient experience, such as a dream, which resonates with some event in the future."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06fa0608-2cce-3efa-a78c-6254bf2babe9",
                                        "entry_id": "b5160aeb-7717-31f1-a02d-870b89f5f1e0",
                                        "glosses": [
                                            "A strong intuition that something is about to happen (usually something negative, but not exclusively)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2318bcaa-5d37-40b0-829c-84c4fa1f0d49",
                                                "sense_id": "06fa0608-2cce-3efa-a78c-6254bf2babe9",
                                                "text": "The sinister face of Dr. Bauerstein recurred to me unpleasantly. A vague suspicion of everyone and everything filled my mind. Just for a moment I had a premonition of approaching evil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d11473f-d7fe-4e41-ae35-329a9198ec55",
                        "source_entry_id": "ba5a4f98-0752-35c8-8ab3-c5c446c0b268",
                        "source_sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                        "source_sense_description": "undeutliches Gefühl, dass etwas geschehen wird",
                        "target_lang_word": "présentiment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "présentiment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dff48260-7de7-3b2b-8167-e40e79062b25",
                                        "entry_id": "eaa2d59a-2ca3-302c-8024-e8640648e7a9",
                                        "glosses": [
                                            "Variante de pressentiment."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5516713-5626-479b-bd21-cce95e7bf307",
                        "source_entry_id": "ba5a4f98-0752-35c8-8ab3-c5c446c0b268",
                        "source_sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                        "source_sense_description": "undeutliches Gefühl, dass etwas geschehen wird",
                        "target_lang_word": "pressentiment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressentiment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                        "entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                                        "glosses": [
                                            "Intuition d'un événement à venir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba51e69a-0ba8-4dfc-ac0d-264543abec2d",
                                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                                "text": "Au reste, ses pressentiments ne l’avaient pas trompée, à peine avait-elle fait vingt lieues, que son mari avait été pris d’une fièvre cérébrale."
                                            },
                                            {
                                                "example_id": "75978f79-1208-4709-9a0f-06358d527fd1",
                                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                                "text": "Les bizarres pressentiments qui avaient si souvent agité Julie se trouvaient tout à coup réalisés."
                                            },
                                            {
                                                "example_id": "936a27df-492d-4cc1-9a13-ad29a79c30ee",
                                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                                "text": "La jeune fille s’était jetée toute vêtue sur son lit, l’inquiétude la tenait éveillée, un secret pressentiment l’avertissait de se tenir sur ses gardes."
                                            },
                                            {
                                                "example_id": "2f8fada5-8d5b-4d8a-9c46-24015a11f2c8",
                                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                                "text": "Nous trouvons ici de plus sombres pressentiments ; l’auteur se demande même si notre humanité atteindra sa véritable fin."
                                            },
                                            {
                                                "example_id": "c46e7c3e-7637-4f77-a227-efe41ed9d163",
                                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                                "text": "Le cœur en émoi, secouée de pressentiments inquiets, Zaheira se vêtit et gagna le village voisin sur un âne."
                                            },
                                            {
                                                "example_id": "4fda78b1-ca14-4070-b5d4-ee64a96d42d0",
                                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                                "text": "Le bruit, les allées et venues des gens m’alertèrent. J’accourus avec un funèbre pressentiment, sans toutefois penser à un malheur aussi terrible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4fd7c1-2a9f-31d1-87c4-128cc82225c6",
                                        "entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                                        "glosses": [
                                            "Idée intuitive d'un concept qui sera ou non confirmé plus tard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63f73ef6-2b82-45eb-8880-720af62ae032",
                                                "sense_id": "7a4fd7c1-2a9f-31d1-87c4-128cc82225c6",
                                                "text": "Nous ne connaissons pas le contour précis de ce visage, ni sa réalisation concrète, nous en avons simplement le pressentiment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
