                ],
                "senses": [
                    {
                        "sense_id": "cb35c93f-a6a4-34ed-82f2-2ce859d1b43e",
                        "entry_id": "2d96fe2e-2a92-3df0-a41f-4bacb760136a",
                        "glosses": [
                            "großes Betonbecken oder Kanal, in dem das zu reinigende Abwasser beim Belebtschlammverfahren in einem Klärwerk schwimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9731560f-8e39-4975-a72c-6f1e70890cbe",
                                "sense_id": "cb35c93f-a6a4-34ed-82f2-2ce859d1b43e",
                                "text": "„Kontinuierlich durchflossene, mit einem Vorklärbecken und einem nachgeschalteten Nachklärbecken kombinierte Belebungsbecken sind für Groß- und Kleinkläranlagen die am häufigsten angewendeten \"technischen\" Bauteile zur traditionellen aeroben biologische Abwasserreinigung.“"
                            },
                            {
                                "example_id": "3da36baf-b794-4632-a84b-4fbe827254a6",
                                "sense_id": "cb35c93f-a6a4-34ed-82f2-2ce859d1b43e",
                                "text": "„Im Belebungsbecken wird zusätzlich der im Abwasser enthaltene Stickstoff eliminiert.“"
                            },
                            {
                                "example_id": "0d6bb825-f6ff-4a40-aa00-252913713921",
                                "sense_id": "cb35c93f-a6a4-34ed-82f2-2ce859d1b43e",
                                "text": "„Im Belebungsbecken erfolgt der biologische Ab- und Umbau der organischen und anorganischen Schmutzstoffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
