                        "sense_id": "c8ec6c7c-943c-32b0-adf7-58dece334918",
                        "entry_id": "4ec962de-c609-3459-a5d0-a682de20c285",
                        "glosses": [
                            "To make or become haughty."
                        ],
                        "tags": [
                            "ambitransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "395de7b3-de56-4793-b775-153df4499a0d",
                                "sense_id": "c8ec6c7c-943c-32b0-adf7-58dece334918",
                                "text": "Till now her innocent wrongs, endured in isolation, had hardened and, if the word be permissible, haughtened her."
                            },
                            {
                                "example_id": "988fcb05-6201-4985-b7ce-8a3ac419b276",
                                "sense_id": "c8ec6c7c-943c-32b0-adf7-58dece334918",
                                "text": "And when, the day's work well accomplished, and the haughty, Haughtoned rival betook his weary and humbled prowess back to his haunts of New Jersey or Connecticut, the Jester, stein in hand, would sit before his birch fire and discuss the salient features of the famous game, as if the world itself had stopped wagging for a moment to gaze in awe at the grassy gridiron and wave a crimson flag above the cheering multitudes."
                            },
                            {
                                "example_id": "2f0048bc-7681-41e1-9399-c04f7a13d4e3",
                                "sense_id": "c8ec6c7c-943c-32b0-adf7-58dece334918",
                                "text": "\"Obviously,\" said Michael, haughtening his accent."
                            },
                            {
                                "example_id": "972b8ef8-6b2b-4863-a71f-7a412ff58571",
                                "sense_id": "c8ec6c7c-943c-32b0-adf7-58dece334918",
                                "text": "A haughtening sprits."
                            }
                        ]
                    }
