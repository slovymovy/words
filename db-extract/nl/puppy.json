                                        "sense_id": "9571b012-78c6-37f7-8f33-49e5ca95d43d",
                                        "entry_id": "8eacc87c-4f88-3307-91ce-bb1d8725fcc0",
                                        "glosses": [
                                            "A dog with a youthful appearance, or any dog."
                                        ],
                                        "tags": [],
