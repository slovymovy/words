                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85d030f7-1ff9-4863-b7b7-4291366fe013",
                                                "sense_id": "e612ddb2-c5fa-3111-b18b-1d81a2566803",
                                                "text": "The attribution of the quote is widely regarded as dubious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6280d401-dfd9-32bd-b023-644b406fac57",
