                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "страща́вши"
                    },
                    {
                        "form_id": "5bb08b46-650b-4bec-be6b-8b88e11bfe76",
                        "entry_id": "a9d3328b-5c14-3aa8-a212-d5e832fc5e4b",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… страща́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                        "entry_id": "a9d3328b-5c14-3aa8-a212-d5e832fc5e4b",
                        "glosses": [
                            "прост. пугать, устрашать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f5b59c-ce71-4446-a6a4-a8b889604c0b",
                                "sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                                "text": "Ах, не пугай, не стращай, родная!"
                            },
                            {
                                "example_id": "be61ef4b-0516-466f-8a01-f55c0abc7222",
                                "sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                                "text": "Стали стращать да пужать, что всё семейство наше чрез то погибнуть должно: на поселенье там сошлют, а либо вас, экого человека, в рекруты сдадут."
                            },
                            {
                                "example_id": "8af5818d-b9b7-4105-83bc-e18ff1eb6b4c",
                                "sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                                "text": "— Да вы, князь, что же это: возите с собой крокодила вместо паспорта — стращать жандармов на границах?"
                            },
                            {
                                "example_id": "ca1ed962-a15f-47b4-a5c3-c68d47055f85",
                                "sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                                "text": "Облика христианского на тебе нет, а ты хочешь по станицам идти: ведь казачки-то тебя за беса сочтут — детей стращать станут."
                            },
                            {
                                "example_id": "09184373-caae-49b5-8b13-59e44fb8fa7f",
                                "sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                                "text": "Пришлось стращать, что оставят дома тех, кто не будет слушаться и не даст себя как следует закутать."
                            },
                            {
                                "example_id": "a9b603a5-4b50-4f51-8b01-1e35c02c7c3b",
                                "sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                                "text": "А про следователя скажите: он, мол, на нас шибко закричал, стал стращать, мы испугались и сказали, как он велел."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e8e2da7-0c9a-4f56-97fc-a510b3dbe9ea",
                        "source_entry_id": "a9d3328b-5c14-3aa8-a212-d5e832fc5e4b",
                        "source_sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                        "target_lang_word": "frighten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frighten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb91ea8f-8491-3e5a-9ca9-49bc7eed5cb5",
                                        "entry_id": "c6b86c1e-9cfe-3fef-bbb3-02920a44c69f",
                                        "glosses": [
                                            "To cause to feel fear; to scare; to cause to feel alarm or fright."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2faf77-99f3-45fa-a5c7-561589b803fa",
                                                "sense_id": "fb91ea8f-8491-3e5a-9ca9-49bc7eed5cb5",
                                                "text": "Avery puts a sheet over her head, pretending to be a ghost to frighten Emily."
                                            },
                                            {
                                                "example_id": "e490a4f2-8737-488b-8994-68e934c579f1",
                                                "sense_id": "fb91ea8f-8491-3e5a-9ca9-49bc7eed5cb5",
                                                "text": "His Deſign was only to frighten France, and get more Money."
                                            },
                                            {
                                                "example_id": "b0be54a8-432e-430b-9af2-be99bbdfb044",
                                                "sense_id": "fb91ea8f-8491-3e5a-9ca9-49bc7eed5cb5",
                                                "text": "You may frighten a pig, a goose, a frog, and even a fly, but you cannot frighten or surprise a sloth."
                                            },
                                            {
                                                "example_id": "f72a118c-44f4-4329-87f0-3a19702404ed",
                                                "sense_id": "fb91ea8f-8491-3e5a-9ca9-49bc7eed5cb5",
                                                "text": "And he commanded his soldiers […] to frighten them with fierce swords, but the hearts of the holy men did not quail, and they were unable to alter their words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e286bc39-4875-3132-9ce4-f6e9fd8e2543",
                                        "entry_id": "c6b86c1e-9cfe-3fef-bbb3-02920a44c69f",
                                        "glosses": [
                                            "To become scared or alarmed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45087b19-a40b-4d61-a29f-b2525ecd1e63",
                                                "sense_id": "e286bc39-4875-3132-9ce4-f6e9fd8e2543",
                                                "text": "In fitting the White Leghorns for exhibition, it must be remembered that they are of nervous disposition and frighten easily."
                                            },
                                            {
                                                "example_id": "64e0243e-0d9c-46fd-b6ef-d8ab6d49e82d",
                                                "sense_id": "e286bc39-4875-3132-9ce4-f6e9fd8e2543",
                                                "text": "Those male moose at the southeast arm didn't frighten very much when we docked to fly-fish one day. One was so scared of us he just walked toward us and snorted."
                                            },
                                            {
                                                "example_id": "c59c2863-0722-48d1-8f02-df5a5432818a",
                                                "sense_id": "e286bc39-4875-3132-9ce4-f6e9fd8e2543",
                                                "text": "Be sneaky. Fish frighten easily."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d34c3d6-e9a8-4349-8259-81096ced13cc",
                        "source_entry_id": "a9d3328b-5c14-3aa8-a212-d5e832fc5e4b",
                        "source_sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                        "target_lang_word": "scare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78d3ae6f-6c24-336c-a7ae-825314198afc",
                                        "entry_id": "86db324e-112f-3aff-9106-f41116471c9f",
                                        "glosses": [
                                            "A minor fright."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c23a43-e11b-47f5-9b87-7e29883ca9ce",
                                                "sense_id": "78d3ae6f-6c24-336c-a7ae-825314198afc",
                                                "text": "Johnny had a bad scare last night."
                                            },
                                            {
                                                "example_id": "823fceed-6576-4a6d-9268-85a5f2f84db2",
                                                "sense_id": "78d3ae6f-6c24-336c-a7ae-825314198afc",
                                                "text": "England were held to a draw after surviving a major scare against Switzerland as they were forced to come from two goals behind to earn a point in the Euro 2012 qualifier at Wembley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04152328-d71f-34a5-b835-ef01187eeca4",
                                        "entry_id": "86db324e-112f-3aff-9106-f41116471c9f",
                                        "glosses": [
                                            "A cause of terror or alarm; a panic; something that inspires fear or dread."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cea4f3e-32fa-4872-b24a-1e574a478200",
                                                "sense_id": "04152328-d71f-34a5-b835-ef01187eeca4",
                                                "text": "a food-poisoning scare"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51cda877-b0fd-34df-a82a-e20f5fb2cafe",
                                        "entry_id": "86db324e-112f-3aff-9106-f41116471c9f",
                                        "glosses": [
                                            "A device or object used to frighten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08ee077-a95e-44da-8080-1cb92ee9a112",
                                                "sense_id": "51cda877-b0fd-34df-a82a-e20f5fb2cafe",
                                                "text": "But I admit the possibility of their being used as \"scares\" for either birds of prey or snakes, or both."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                                        "entry_id": "11d51a1f-7d29-328b-9aa9-0ee9c42224d3",
                                        "glosses": [
                                            "To frighten, terrify, startle, especially in a minor way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3b29a39-0091-4aa3-b6d1-ee16c41992d5",
                                                "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                                                "text": "Did it scare you when I said \"Boo!\"?"
                                            },
                                            {
                                                "example_id": "18315ba1-9469-4ff7-9696-3eac210bcfe3",
                                                "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                                                "text": "That cannot be; the noise of thy crossbow / Will scare the herd, and so my shoot is lost."
                                            },
                                            {
                                                "example_id": "de391e2f-439c-45c9-a121-154251b5a4a5",
                                                "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                                                "text": "Late triumphs of Russian science are scaring the very dogwater out of large elements in our society, and we both fear more \"purging\" instead of more effort at catching up."
                                            },
                                            {
                                                "example_id": "5260869a-b79d-4502-a476-dbd2125a0553",
                                                "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                                                "text": "(Laurel Stevenson) Would you please be quiet? You're scaring the little girl.\n(Craig Toomey) Scaring the little girl?! Scaring the little girl?! Lady!"
                                            },
                                            {
                                                "example_id": "df1fa0bb-166f-43d0-a250-c96d16c991a6",
                                                "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                                                "text": "In other words, the transaction is preferred because it is the best of bad choices. And at least one study has found that when management preannounces a deal it results in lower premiums presumably because it scares off other bidders."
                                            },
                                            {
                                                "example_id": "bb368366-124b-424f-aae4-62f487b3f71d",
                                                "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                                                "text": "Residents of Sihu Township in the central county of Yunlin were left scared and angry after hundreds of dead geese were found dumped in an irrigation channel Tuesday, inciting a minor panic as avian flu continues to spread throughout the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5a3714-b05f-3c81-8de1-1507a7793a18",
                                        "entry_id": "11d51a1f-7d29-328b-9aa9-0ee9c42224d3",
                                        "glosses": [
                                            "(To be able) to be scared."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2610fcf-7d76-4e2d-b66e-3c40703bdc55",
                                                "sense_id": "9f5a3714-b05f-3c81-8de1-1507a7793a18",
                                                "text": "I don't scare easily."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ded6356b-f334-3d1a-bad1-8031fa5da9f2",
                                        "entry_id": "a62d879b-c930-35d0-989a-d95beab0cdb5",
                                        "glosses": [
                                            "lean; scanty"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f1bc586-9fdd-47ae-9d54-512f6ccf2e68",
                        "source_entry_id": "a9d3328b-5c14-3aa8-a212-d5e832fc5e4b",
                        "source_sense_id": "ebeea6a5-9002-30d7-8b6e-083e41bad2ce",
                        "target_lang_word": "browbeat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "browbeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dfb4965-fdd4-3a38-802d-7f711ee562a2",
                                        "entry_id": "2334a26f-0176-3e4c-827d-35077d490402",
                                        "glosses": [
                                            "To bully in an intimidating, bossy, or supercilious way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cefa40b-062e-47c5-9527-e572bc35034c",
                                                "sense_id": "0dfb4965-fdd4-3a38-802d-7f711ee562a2",
                                                "text": "Though the teacher browbeat all the children, they still acted out during the lesson."
                                            },
                                            {
                                                "example_id": "dd9e978b-2a33-48f9-b56f-d9ba402b187e",
                                                "sense_id": "0dfb4965-fdd4-3a38-802d-7f711ee562a2",
                                                "text": "Beware lest thy mind be swayed by the brow-beating of the Demons."
                                            },
                                            {
                                                "example_id": "d7a4f1f9-5166-46f6-859f-1ce3fb7ad189",
                                                "sense_id": "0dfb4965-fdd4-3a38-802d-7f711ee562a2",
                                                "text": "Dudley Fitts reared far back, pronouncing her [Laura Riding] with “few equals” when it came to “browbeating an audience into conviction by sheer force of arrogance, among any poets living or dead.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
