                ],
                "senses": [
                    {
                        "sense_id": "574986d4-83ff-3545-97ae-3edf8cd8a1c0",
                        "entry_id": "cdbd7d82-7246-3eec-b67e-02bb267cd0e0",
                        "glosses": [
                            "Lacking in sap."
                        ],
                        "tags": [
                            "of a plant"
                        ],
                        "examples": [
                            {
                                "example_id": "33d3f95e-386e-4796-b6da-71e6778ced61",
                                "sense_id": "574986d4-83ff-3545-97ae-3edf8cd8a1c0",
                                "text": "[…] Thou\nFor whose path the Atlantic’s level powers\nCleave themselves into chasms, while far below\nThe sea-blooms and the oozy woods which wear\nThe sapless foliage of the ocean, know\nThy voice, and suddenly grow grey with fear,\nAnd tremble to despoil themselves: O, hear!"
                            },
                            {
                                "example_id": "63971d04-f4f6-48bf-9b6e-a4508e5d4226",
                                "sense_id": "574986d4-83ff-3545-97ae-3edf8cd8a1c0",
                                "text": "Below, all their earthward-looking branches are sapless and shattered, splintered by the weight of many winters’ snows; above, they are still green and full of life, but their summits overtop all the deciduous trees around them, and in their companionship with heaven they are alone."
                            }
                        ]
                    },
                    {
                        "sense_id": "24736885-37cf-3e25-acf2-1c0322b4305b",
                        "entry_id": "cdbd7d82-7246-3eec-b67e-02bb267cd0e0",
                        "glosses": [
                            "Lacking vivacity."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "83b177cb-8d2e-4fcb-9015-e6433b9b0f63",
                                "sense_id": "24736885-37cf-3e25-acf2-1c0322b4305b",
                                "text": "O young John Talbot! I did send for thee\nTo tutor thee in stratagems of war,\nThat Talbot’s name might be in thee revived\nWhen sapless age and weak unable limbs\nShould bring thy father to his drooping chair."
                            },
                            {
                                "example_id": "f6758b51-5a70-4a4b-ab2a-fb49bfdae145",
                                "sense_id": "24736885-37cf-3e25-acf2-1c0322b4305b",
                                "text": "O smooth my rugged heart, and there\nEngrave thy rev’rend Law and fear:\nOr make a new one, since the old\nIs saplesse grown,\nAnd a much fitter stone\nTo hide my dust, then thee to hold."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
