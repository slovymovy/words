                    {
                        "sense_id": "743fbeed-649d-3f36-a43d-ec9fd6e69d59",
                        "entry_id": "aea6270b-46cd-3ce5-bb74-7fb826367924",
                        "glosses": [
                            "huurwoning die een deel is van een groter gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7f6d39-8b65-4036-8b11-0471b9b1c4be",
                                "sense_id": "743fbeed-649d-3f36-a43d-ec9fd6e69d59",
                                "text": "Toen ze bij Robert wegging had ze in de kelderbox van het huurappartement in Kreuzberg een kist met restanten uit haar studententijd gevonden."
                            },
                            {
                                "example_id": "4f864981-12dc-4f33-a93d-85f3324a262e",
                                "sense_id": "743fbeed-649d-3f36-a43d-ec9fd6e69d59",
                                "text": "Ze wonen nu in een huurappartement in de plaats Chico. Ze hebben vrienden en familieleden verteld dat ze veilig waren en het is voor hen een raadsel waarom Singh nog zo lang te boek stond als vermist."
                            },
                            {
                                "example_id": "b301cf97-b0b6-438b-b4a7-535d8a77216d",
                                "sense_id": "743fbeed-649d-3f36-a43d-ec9fd6e69d59",
                                "text": "Derwort woont als zzp'er in een slecht geïsoleerd huurappartement in Den Haag. Ze ging het gesprek aan met haar huurbaas, die nu haar kozijnen en ramen aanpast. \"Met de eerste dingen word ik nu gelukkig geholpen\", zegt ze. \"Maar er zal voor huurders zoals ik meer moeten gebeuren. De energieprijzen blijven hoog. Ik wil ook een warmtepomp of zonnepanelen, zoals vrienden met een koophuis hebben.\""
                            }
                        ]
                    }
