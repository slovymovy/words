                    {
                        "sense_id": "f405ba29-524c-33e5-9b55-e5bb8583d62b",
                        "entry_id": "c6516ba8-76f5-3c9b-8798-4f042a77db6a",
                        "glosses": [
                            "The best, most favourable or desirable, especially under some restriction."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b63ba7be-4c2e-4538-a225-a625ed87069e",
                                "sense_id": "f405ba29-524c-33e5-9b55-e5bb8583d62b",
                                "text": "Finding the optimal balance between features and price is a common problem."
                            },
                            {
                                "example_id": "3d1422fd-2725-4df8-a694-da3619b6e122",
                                "sense_id": "f405ba29-524c-33e5-9b55-e5bb8583d62b",
                                "text": "Herewith, a brief primer in speaking basic North Carolinaese, meant to be read aloud for optimal effect."
                            }
                        ]
                    },
