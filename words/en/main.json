    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "feb9cbc8-ef46-3e21-85e9-f918db02dc1e",
                    "sense_definition": "Of chief or leading importance; prime, principal.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>main</w> office is actually one of the smaller rooms in the building.",
                            "target_lang_translations": {
                                "ru": "<w>Главный</w> офис на самом деле является одной из самых маленьких комнат в здании."
                            }
                        },
                        {
                            "text": "Our <w>main</w> goal is to finish the project before the deadline next week.",
                            "target_lang_translations": {
                                "ru": "Наша <w>основная</w> цель — закончить проект до крайнего срока на следующей неделе."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "main office",
                        "main goal",
                        "main reason",
                        "main entrance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий первостепенное или ведущее значение; основной, главный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "первостепенный"
                            },
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "базовый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43a3774d-a2c7-349d-97cf-c5970ecaa2fe",
                    "sense_definition": "Chief, most important, or principal in extent, size, or strength; consisting of the largest part.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>main</w> body of the army marched toward the city at dawn.",
                            "target_lang_translations": {
                                "ru": "<w>Основные</w> силы армии двинулись к городу на рассвете."
                            }
                        },
                        {
                            "text": "Kerosene was the <w>main</w> fuel for artificial lighting in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Керосин был <w>основным</w> топливом для искусственного освещения в девятнадцатом веке."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "main body",
                        "main road",
                        "main branch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главный или основной по размеру, силе или протяженности; составляющий большую часть чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "составляющий большую часть"
                            },
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "крупнейший"
                            },
                            {
                                "target_lang_word": "магистральный",
                                "target_lang_sense_clarification": "о дороге или пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "301d28a2-943f-3ec6-ae13-7495a97c1687",
                    "sense_definition": "Belonging to or connected with the principal mast in a vessel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors worked quickly to secure the <w>main</w> rigging during the storm.",
                            "target_lang_translations": {
                                "ru": "Моряки быстро работали, чтобы закрепить <w>грот-</w>такелаж во время шторма."
                            }
                        },
                        {
                            "text": "The <w>main</w> mast was damaged when the ship hit the rocks.",
                            "target_lang_translations": {
                                "ru": "<w>Грот-</w>мачта была повреждена, когда корабль ударился о скалы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "main mast",
                        "main rigging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грот-мачте (главной мачте) судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грот-",
                                "target_lang_sense_clarification": "приставка для обозначения принадлежности к главной мачте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98d4de06-5619-3a12-a9a9-138f5a1a1d86",
                    "sense_definition": "Full, sheer, undivided.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to open the heavy door by <w>main</w> force alone.",
                            "target_lang_translations": {
                                "ru": "Ему удалось открыть тяжелую дверь одной лишь <w>грубой</w> силой."
                            }
                        },
                        {
                            "text": "The heavy stone was moved by the <w>main</w> strength of the workers.",
                            "target_lang_translations": {
                                "ru": "Тяжелый камень был сдвинут <w>всей</w> силой рабочих."
                            }
                        }
                    ],
                    "common_phrases": [
                        "main force",
                        "main strength"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the phrase 'by main force'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный, абсолютный, неразделенный (обычно о силе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вся",
                                "target_lang_sense_clarification": "в выражении 'всей силой'"
                            },
                            {
                                "target_lang_word": "грубая",
                                "target_lang_sense_clarification": "о физической силе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d68b33c8-05dd-32e7-9caf-ce9ef36cf86c",
                    "sense_definition": "The principal dish of a meal; a <w>main course</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had scampi and chips for my <w>main</w> and a slice of cheesecake for dessert.",
                            "target_lang_translations": {
                                "ru": "На <w>основное</w> я взял креветки с картофелем фри, а на десерт — кусочек чизкейка."
                            }
                        },
                        {
                            "text": "Would you like to see the menu for the <w>main</w> or just the starters?",
                            "target_lang_translations": {
                                "ru": "Вы хотите посмотреть меню <w>основных блюд</w> или только закуски?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основное блюдо приема пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основное блюдо",
                                "target_lang_sense_clarification": "главная часть обеда"
                            },
                            {
                                "target_lang_word": "горячее",
                                "target_lang_sense_clarification": "разговорное название основного блюда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e0d20e0-fff6-31f9-9177-fc17967de3df",
                    "sense_definition": "A large cable or pipe providing utility service to an area or a building.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "utilities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a gas leak in the <w>main</w> outside the building.",
                            "target_lang_translations": {
                                "ru": "В газовой <w>магистрали</w> снаружи здания произошла утечка."
                            }
                        },
                        {
                            "text": "The workers are repairing a broken water <w>main</w> on the street.",
                            "target_lang_translations": {
                                "ru": "Рабочие чинят прорванный водопроводный <w>канал</w> на улице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "water main",
                        "gas main",
                        "electric main"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный кабель или труба, обеспечивающая коммунальные услуги (воду, газ, электричество) в районе или здании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магистраль",
                                "target_lang_sense_clarification": "трубопровод или линия электропередач"
                            },
                            {
                                "target_lang_word": "сеть",
                                "target_lang_sense_clarification": "коммунальная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13a74ae5-2473-31f0-8a52-cad9d81a1378",
                    "sense_definition": "The primary character that one plays in a video game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My WoW <w>main</w> has reached level cap and I am starting an alt.",
                            "target_lang_translations": {
                                "ru": "Мой <w>мейн</w> в WoW достиг максимального уровня, и я завожу альта."
                            }
                        },
                        {
                            "text": "He decided to switch his <w>main</w> to a different class after the update.",
                            "target_lang_translations": {
                                "ru": "После обновления он решил сменить своего <w>основного персонажа</w> на другой класс."
                            }
                        }
                    ],
                    "antonyms": [
                        "alt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной персонаж, за которого играет человек в видеоигре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мейн",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "основной аккаунт или персонаж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d43227b-5334-3871-b698-2fc12b7cad20",
                    "sense_definition": "The high seas; the open ocean.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirate ship sailed across the Spanish <w>Main</w> in search of gold.",
                            "target_lang_translations": {
                                "ru": "Пиратский корабль шел по <w>просторам</w> Испанского Мэйна в поисках золота."
                            }
                        },
                        {
                            "text": "He had to cross the <w>main</w> to reach his native land.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось пересечь <w>открытое море</w>, чтобы добраться до родной земли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Spanish Main"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытое море или океан."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открытое море",
                                "target_lang_sense_clarification": "океанские просторы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c2248eb-4eb5-3a5e-a322-f78a5ce3d57b",
                    "sense_definition": "To mainly play a specific character or side during a game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>mains</w> the same character as me in that fighting game.",
                            "target_lang_translations": {
                                "ru": "В том файтинге он <w>мейнит</w> того же персонажа, что и я."
                            }
                        },
                        {
                            "text": "For new players, I recommend <w>maining</w> the dagger for its speed.",
                            "target_lang_translations": {
                                "ru": "Новичкам я рекомендую <w>использовать как основное</w> оружие кинжал из-за его скорости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть преимущественно за определенного персонажа или сторону в игре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мейнить",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0ed264be-c1f5-3c62-ac40-3322d74eae6b",
                    "sense_definition": "A river in southern Germany, flowing from Bavaria to the Rhine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Frankfurt is located on the banks of the river <w>Main</w>.",
                            "target_lang_translations": {
                                "ru": "Франкфурт расположен на берегах реки <w>Майн</w>."
                            }
                        },
                        {
                            "text": "The <w>Main</w> flows through several picturesque German towns.",
                            "target_lang_translations": {
                                "ru": "<w>Майн</w> протекает через несколько живописных немецких городов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Frankfurt am Main"
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в южной Германии, приток Рейна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Майн",
                                "target_lang_sense_clarification": "название реки"
                            }
                        ]
