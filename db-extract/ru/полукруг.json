                    {
                        "translation_id": "c9700c0c-d4fe-4d5f-84ee-2f1948de3daf",
                        "source_entry_id": "cd8a02f6-7f25-308d-b7dd-8818e4585d20",
                        "target_lang_word": "półokrąg",
                        "target_lang_code": "pl",
