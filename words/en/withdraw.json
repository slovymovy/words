{
    "word_family": [
        "withdrawal",
        "withdrawn"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1cfa16d-4a73-3f39-a98e-3d0349492600",
                    "sense_definition": "To take money out of a bank account.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "banking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to find an ATM to <w>withdraw</w> some cash for the weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нужно найти банкомат, чтобы <w>снять</w> наличные на выходные.",
                                "tr": "Hafta sonu için biraz nakit <w>çekmek</w> üzere bir bankamatik bulmam gerekiyor.",
                                "zh": "我得找台自动取款机<w>取</w>点周末用的现金。"
                            }
                        },
                        {
                            "text": "She <w>withdrew</w> five hundred dollars from her savings account to pay the bill.",
                            "target_lang_translations": {
                                "ru": "Она <w>сняла</w> пятьсот долларов со своего сберегательного счета, чтобы оплатить счет.",
                                "tr": "Faturayı ödemek için tasarruf hesabından beş yüz dolar <w>çekti</w>.",
                                "zh": "她从储蓄账户里<w>取</w>了五百美元来付账。"
                            }
                        }
                    ],
                    "antonyms": [
                        "deposit"
                    ],
                    "common_phrases": [
                        "withdraw cash",
                        "withdraw money",
                        "withdraw funds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать деньги с банковского счета.",
                        "tr": "Banka hesabından para almak.",
                        "zh": "从银行账户中取出钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "деньги со счета"
                            },
                            {
                                "target_lang_word": "снять",
                                "target_lang_sense_clarification": "деньги со счета (сов. вид)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "para çekmek",
                                "target_lang_sense_clarification": "banka hesabından"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "取",
                                "target_lang_sense_clarification": "从账户中提取现金"
                            },
                            {
                                "target_lang_word": "提款",
                                "target_lang_sense_clarification": "从银行账户中取出资金"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da529486-3740-34fd-9ad6-755e522b9149",
                    "sense_definition": "To move away from a place or situation, often to go to a quieter or safer place; to retreat.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "retreating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The troops were ordered to <w>withdraw</w> from the border after the ceasefire.",
                            "target_lang_translations": {
                                "ru": "Войскам было приказано <w>отступить</w> от границы после прекращения огня.",
                                "tr": "Ateşkesin ardından birliklere sınırdan <w>geri çekilmeleri</w> emredildi.",
                                "zh": "停火后，部队接到命令从边境<w>撤退</w>。"
                            }
                        },
                        {
                            "text": "After the argument, he chose to <w>withdraw</w> to his room to calm down.",
                            "target_lang_translations": {
                                "ru": "После ссоры он решил <w>удалиться</w> в свою комнату, чтобы успокоиться.",
                                "tr": "Tartışmadan sonra sakinleşmek için odasına <w>çekilmeyi</w> tercih etti.",
                                "zh": "争吵过后，他选择<w>退避</w>到自己的房间里冷静一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "backpedal",
                        "walk back"
                    ],
                    "common_phrases": [
                        "withdraw from",
                        "withdraw troops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уходить или перемещаться из какого-либо места или ситуации, часто в более тихое или безопасное место; отступать.",
                        "tr": "Daha sakin veya güvenli bir yere gitmek amacıyla bir yerden veya durumdan uzaklaşmak; geri çekilmek.",
                        "zh": "离开某地或某种情况，通常是为了去更安静或更安全的地方；撤退。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "воен., отходить назад"
                            },
                            {
                                "target_lang_word": "удаляться",
                                "target_lang_sense_clarification": "уходить в уединение"
                            },
                            {
                                "target_lang_word": "отходить",
                                "target_lang_sense_clarification": "перемещаться в сторону"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geri çekilmek",
                                "target_lang_sense_clarification": "askeri veya bir yerden uzaklaşma"
                            },
                            {
                                "target_lang_word": "çekilmek",
                                "target_lang_sense_clarification": "bir yere kapanmak, uzaklaşmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撤退",
                                "target_lang_sense_clarification": "军事或集体行动中向后撤离"
                            },
                            {
                                "target_lang_word": "退避",
                                "target_lang_sense_clarification": "离开现场或避开某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3ead385-be69-30e6-9879-9dc85c6ce642",
                    "sense_definition": "To take back something previously offered, stated, or given; to remove support or funding.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "retracting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>withdraw</w> its offer to buy the rival firm.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>отозвать</w> свое предложение о покупке фирмы-конкурента.",
                                "tr": "Şirket, rakip firmayı satın alma teklifini <w>geri çekmeye</w> karar verdi.",
                                "zh": "该公司决定<w>撤回</w>收购竞争对手公司的提议。"
                            }
                        },
                        {
                            "text": "The newspaper had to <w>withdraw</w> the article after several errors were discovered.",
                            "target_lang_translations": {
                                "ru": "Газете пришлось <w>отозвать</w> статью после того, как было обнаружено несколько ошибок.",
                                "tr": "Gazete, birkaç hata tespit edildikten sonra makaleyi <w>geri çekmek</w> zorunda kaldı.",
                                "zh": "在发现几处错误后，报社不得不<w>撤回</w>了那篇文章。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retract",
                        "revoke",
                        "take back",
                        "recall",
                        "recant"
                    ],
                    "common_phrases": [
                        "withdraw an offer",
                        "withdraw support",
                        "withdraw a statement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забирать обратно то, что было предложено, заявлено или дано; прекращать поддержку или финансирование.",
                        "tr": "Daha önce sunulan, belirtilen veya verilen bir şeyi geri almak; desteği veya finansmanı kesmek.",
                        "zh": "收回之前提出的建议、声明或给予的东西；停止支持或资助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отзывать",
                                "target_lang_sense_clarification": "офиц., предложение, заявление"
                            },
                            {
                                "target_lang_word": "брать назад",
                                "target_lang_sense_clarification": "слова, обещание"
                            },
                            {
                                "target_lang_word": "забирать",
                                "target_lang_sense_clarification": "разг., возвращать себе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geri çekmek",
                                "target_lang_sense_clarification": "teklifi veya desteği iptal etmek"
                            },
                            {
                                "target_lang_word": "iptal etmek",
                                "target_lang_sense_clarification": "teklif veya beyanı feshetmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撤回",
                                "target_lang_sense_clarification": "收回提议、声明或申请"
                            },
                            {
                                "target_lang_word": "收回",
                                "target_lang_sense_clarification": "撤销之前给出的承诺或支持"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee4ed75a-6c57-31fe-b50d-e9664088dd75",
                    "sense_definition": "To stop participating in an activity, competition, or organization.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "retreating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis player had to <w>withdraw</w> from the tournament due to a severe injury.",
                            "target_lang_translations": {
                                "ru": "Теннисисту пришлось <w>сняться</w> с турнира из-за серьезной травмы.",
                                "tr": "Tenisçi, ciddi bir sakatlık nedeniyle turnuvadan <w>çekilmek</w> zorunda kaldı.",
                                "zh": "由于伤势严重，这位网球选手不得不<w>退出</w>了比赛。"
                            }
                        },
                        {
                            "text": "Several countries decided to <w>withdraw</w> from the international trade agreement.",
                            "target_lang_translations": {
                                "ru": "Несколько стран решили <w>выйти</w> из международного торгового соглашения.",
                                "tr": "Birçok ülke uluslararası ticaret anlaşmasından <w>çekilmeye</w> karar verdi.",
                                "zh": "几个国家决定<w>退出</w>该国际贸易协定。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "withdraw from the competition",
                        "withdraw from the race"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращать участие в деятельности, соревновании или организации.",
                        "tr": "Bir etkinlik, yarışma veya kuruluşa katılmayı bırakmak.",
                        "zh": "停止参与某项活动、比赛或组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "из состава, из организации"
                            },
                            {
                                "target_lang_word": "сниматься",
                                "target_lang_sense_clarification": "с соревнований, с выборов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çekilmek",
                                "target_lang_sense_clarification": "yarışmadan veya örgütten ayrılmak"
                            },
                            {
                                "target_lang_word": "ayrılmak",
                                "target_lang_sense_clarification": "üyelikten veya anlaşmadan çıkmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "退出",
                                "target_lang_sense_clarification": "不再参与比赛、组织或协议"
                            },
                            {
                                "target_lang_word": "退赛",
                                "target_lang_sense_clarification": "特指从比赛中中途退出"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}