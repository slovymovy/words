                "senses": [
                    {
                        "sense_id": "ebec778a-0fe3-335b-b763-ec897fcefde7",
                        "entry_id": "78517561-2ed6-321f-9fb0-e7131a9d2c4c",
                        "glosses": [
                            "die längstmögliche Sehne eines Kreises; der Durchmesser eines Kreises"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3c6153-9301-44ee-9233-6927cbd58523",
                                "sense_id": "ebec778a-0fe3-335b-b763-ec897fcefde7",
                                "text": "„Seit 1987 feiern Matheverrückte, Computerfreaks und Wissenschaftler die Zahl Pi, die das Verhältnis von Kreisumfang und Kreisdurchmesser repräsentiert.“"
                            },
                            {
                                "example_id": "48ba30b2-4607-4f7a-ab0f-d2e1d3e06807",
                                "sense_id": "ebec778a-0fe3-335b-b763-ec897fcefde7",
                                "text": "„Zum Nörtener Frühjahrsmarkt im Mai 2003 hat Proffen die erste Platte verlegen lassen. Schon drei Jahre hatte er sich mit Pi beschäftigt, war fasziniert von den Facetten dieser „unendlichen“ Zahl, die das Verhältnis vom Kreisumfang zum Kreisdurchmesser beschreibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
