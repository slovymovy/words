                },
                {
                    "sense_id": "9ed3e64b-1d5a-3311-8667-6fefa17033fa",
                    "sense_definition": "Suc blanchâtre qui s'écoule de certains végétaux ou fruits lorsqu'on les coupe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand on coupe une branche de figuier, un <w>lait</w> épais et blanc apparaît immédiatement."
