                        "examples": [
                            {
                                "example_id": "ce18da97-1ed1-48a6-925a-941746e7b3f6",
                                "sense_id": "70de890d-14a7-340d-8aac-0404c5eecddc",
                                "text": "Vertrekkend vicepresident Joe Biden kreeg deze week de Presidential Medal of Freedom uitgereikt door president Obama. Correspondent Michiel Vos ontmoette \"allemansvriend\" Biden acht jaar geleden bij \"een gezellige Ierse drinkpartij\". Vos keek voor het Oog terug op Bidens rol in de regering van Obama."
                            },
                            {
                                "example_id": "23d8db31-c90d-4fdd-ae29-58caec4b9b76",
                                "sense_id": "70de890d-14a7-340d-8aac-0404c5eecddc",
                                "text": "Het gewraakte artikel werd vorig jaar november gepubliceerd in Rolling Stone. Een eerstejaarsstudente vertelde daarin dat ze in 2012 het slachtoffer was geworden van een groepsverkrachting na een zware drinkpartij in het huis van de studentenvereniging. Haar verhaal illustreerde een artikel over seksueel geweld op campussen in de Verenigde Staten en baarde veel opzien in Amerika."
                            }
                        ]
