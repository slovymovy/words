{
    "word_family": [
        "faltering",
        "falteringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "727ac9f5-4d38-3fbf-bc06-025f0a7e8312",
                    "sense_definition": "To lose strength, momentum, or determination; to begin to fail or weaken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy began to <w>falter</w> after several years of rapid and unsustainable growth.",
                            "target_lang_translations": {
                                "ru": "Экономика начала <w>пошатываться</w> после нескольких лет быстрого и неустойчивого роста.",
                                "cs": "Ekonomika začala <w>zakolísávat</w> po několika letech rychlého a neudržitelného růstu."
                            }
                        },
                        {
                            "text": "Even when things got difficult, his <w>falter</w> in resolve never happened and he kept going.",
                            "target_lang_translations": {
                                "ru": "Даже когда становилось трудно, его решимость ни разу не <w>дрогнула</w>, и он продолжал идти вперед.",
                                "cs": "I když se věci zkomplikovaly, jeho odhodlání nikdy <w>nezaváhalo</w> a pokračoval dál."
                            }
                        }
                    ],
                    "common_phrases": [
                        "never falter",
                        "begin to falter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять силу, темп или решимость; начинать терпеть неудачу или ослабевать.",
                        "cs": "Ztrácet sílu, tempo nebo odhodlání; začít selhávat nebo slábnout."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрогнуть",
                                "target_lang_sense_clarification": "потерять уверенность или решимость"
                            },
                            {
                                "target_lang_word": "пошатнуться",
                                "target_lang_sense_clarification": "о положении дел или экономике"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "терять силу или интенсивность"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zakolísat",
                                "target_lang_sense_clarification": "ztratit stabilitu nebo jistotu v postupu"
                            },
                            {
                                "target_lang_word": "zaváhat",
                                "target_lang_sense_clarification": "projevit nejistotu v rozhodování"
                            },
                            {
                                "target_lang_word": "slábnout",
                                "target_lang_sense_clarification": "ztrácet sílu nebo intenzitu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bb14913-0f03-36a9-b22c-2ef47ce8d516",
                    "sense_definition": "To move unsteadily or stumble while walking or standing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt his legs <w>falter</w> as he tried to climb the steep mountain path.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал, как его ноги <w>подкашиваются</w>, когда он пытался взобраться по крутой горной тропе.",
                                "cs": "Cítil, jak se mu <w>podlamují</w> nohy, když se snažil vyjít strmou horskou cestu."
                            }
                        },
                        {
                            "text": "The tired runner started to <w>falter</w> just a few meters before the finish line.",
                            "target_lang_translations": {
                                "ru": "Уставший бегун начал <w>спотыкаться</w> всего за несколько метров до финиша.",
                                "cs": "Unavený běžec začal <w>klopýtat</w> jen pár metrů před cílovou páskou."
                            }
                        }
                    ],
                    "synonyms": [
                        "flounder"
                    ],
                    "common_phrases": [
                        "legs falter",
                        "steps falter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться неуверенно или спотыкаться при ходьбе или стоя.",
                        "cs": "Pohybovat se nejistě nebo klopýtat při chůzi či stání."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спотыкаться",
                                "target_lang_sense_clarification": "терять равновесие при ходьбе"
                            },
                            {
                                "target_lang_word": "заплетаться",
                                "target_lang_sense_clarification": "о ногах при сильной усталости"
                            },
                            {
                                "target_lang_word": "оступаться",
                                "target_lang_sense_clarification": "неловко ступать"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "klopýtat",
                                "target_lang_sense_clarification": "ztrácet rovnováhu při chůzi"
                            },
                            {
                                "target_lang_word": "potácet se",
                                "target_lang_sense_clarification": "pohybovat se velmi nejistou chůzí"
                            },
                            {
                                "target_lang_word": "zapotácet se",
                                "target_lang_sense_clarification": "náhle ztratit stabilitu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cdc2459-89ed-3962-8bf6-f98f2423aab8",
                    "sense_definition": "To speak hesitantly, often with a broken or trembling voice.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her voice started to <w>falter</w> as she reached the most emotional part of her speech.",
                            "target_lang_translations": {
                                "ru": "Ее голос начал <w>дрожать</w>, когда она дошла до самой эмоциональной части своей речи.",
                                "cs": "Její hlas začal <w>zadrhávat</w>, když se dostala k nejdojemnější části svého projevu."
                            }
                        },
                        {
                            "text": "He began to <w>falter</w> forth his apology, unable to look her in the eye.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>запинаясь</w> бормотать свои извинения, не в силах смотреть ей в глаза.",
                                "cs": "Začal <w>koktavě</w> přednášet svou omluvu, neschopen se jí podívat do očí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voice falter",
                        "falter forth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить нерешительно, часто прерывающимся или дрожащим голосом.",
                        "cs": "Mluvit váhavě, často přerývaným nebo třesoucím se hlasem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрогнуть",
                                "target_lang_sense_clarification": "о голосе, под влиянием чувств"
                            },
                            {
                                "target_lang_word": "запинаться",
                                "target_lang_sense_clarification": "говорить с заминками"
                            },
                            {
                                "target_lang_word": "прерываться",
                                "target_lang_sense_clarification": "о голосе"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zadrhávat",
                                "target_lang_sense_clarification": "mluvit s obtížemi nebo záseky"
                            },
                            {
                                "target_lang_word": "chvět se",
                                "target_lang_sense_clarification": "o hlasu pod vlivem emocí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "384b0166-ec67-3894-994e-c922ea168a99",
                    "sense_definition": "To cleanse or sift grain, such as barley, to remove husks or hairs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>falter</w> the barley thoroughly before it could be used for brewing.",
                            "target_lang_translations": {
                                "ru": "Рабочим приходилось тщательно <w>очищать</w> ячмень, прежде чем его можно было использовать для пивоварения.",
                                "cs": "Dělníci museli ječmen důkladně <w>očistit</w>, než mohl být použit k vaření piva."
                            }
                        },
                        {
                            "text": "In the old days, farmers would <w>falter</w> the grain by hand using large sieves.",
                            "target_lang_translations": {
                                "ru": "В прежние времена фермеры <w>просеивали</w> зерно вручную, используя большие сита.",
                                "cs": "Za starých časů zemědělci <w>prosévali</w> obilí ručně pomocí velkých sít."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional agricultural usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать или просеивать зерно (например, ячмень), чтобы удалить шелуху или волоски.",
                        "cs": "Čistit nebo prosévat obilí, například ječmen, za účelem odstranění plev nebo chloupků."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "удалять шелуху с зерна"
                            },
                            {
                                "target_lang_word": "просеивать",
                                "target_lang_sense_clarification": "через сито"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "čistit",
                                "target_lang_sense_clarification": "odstraňovat nečistoty ze zrna"
                            },
                            {
                                "target_lang_word": "prosévat",
                                "target_lang_sense_clarification": "oddělovat pomocí síta"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69f989ee-4589-327a-bc81-529d859f3967",
                    "sense_definition": "An instance of being unsteady, hesitant, or weakening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a slight <w>falter</w> in his voice that betrayed his hidden nervousness.",
                            "target_lang_translations": {
                                "ru": "В его голосе была легкая <w>дрожь</w>, выдавшая его скрытое волнение.",
                                "cs": "V jeho hlase bylo lehké <w>zaváhání</w>, které prozradilo jeho skrytou nervozitu."
                            }
                        },
                        {
                            "text": "The sudden <w>falter</w> in the engine's rhythm worried the pilot during the flight.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>сбой</w> в ритме двигателя обеспокоил пилота во время полета.",
                                "cs": "Náhlé <w>zakolísání</w> v rytmu motoru pilota během letu znepokojilo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "falter in voice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай неуверенности, колебания или ослабления.",
                        "cs": "Případ nejistoty, váhání nebo slábnutí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "в голосе"
                            },
                            {
                                "target_lang_word": "запинка",
                                "target_lang_sense_clarification": "в речи или действии"
                            },
                            {
                                "target_lang_word": "сбой",
                                "target_lang_sense_clarification": "в ритме или процессе"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zaváhání",
                                "target_lang_sense_clarification": "krátká chvíle nejistoty"
                            },
                            {
                                "target_lang_word": "zakolísání",
                                "target_lang_sense_clarification": "ztráta stability nebo rytmu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}