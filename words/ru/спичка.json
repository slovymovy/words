{
    "word_family": [
        "спичечный",
        "спичечница"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40d94f78-5b2a-399d-ab1a-25ec65f1c037",
                    "sense_definition": "Тонкая деревянная или картонная палочка с головкой из горючего вещества, служащая для зажигания огня.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "бытовой предмет",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он достал из кармана коробок и зажёг <w>спичку</w>, чтобы развести костёр.",
                            "target_lang_translations": {
                                "en": "He took a box out of his pocket and struck a <w>match</w> to start a campfire."
                            }
                        },
                        {
                            "text": "Горящая <w>спичка</w> быстро потухла от сильного порыва осеннего ветра.",
                            "target_lang_translations": {
                                "en": "The burning <w>match</w> quickly went out from a strong gust of autumn wind."
                            }
                        }
                    ],
                    "common_phrases": [
                        "коробок спичек",
                        "зажечь спичку",
                        "погасшая спичка"
                    ],
                    "target_lang_definitions": {
                        "en": "A thin wooden or cardboard stick tipped with a flammable substance, used to ignite a flame."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "match",
                                "target_lang_sense_clarification": "small stick used for lighting fire"
                            },
                            {
                                "target_lang_word": "matchstick",
                                "target_lang_sense_clarification": "stick part or individual match"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e6c59d6-c476-38b1-9207-bcd393214992",
                    "sense_definition": "Очень худой, щуплый человек.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "характеристика человека",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После болезни мальчик сильно похудел и стал выглядеть как настоящая <w>спичка</w>.",
                            "target_lang_translations": {
                                "en": "After his illness, the boy lost a lot of weight and began to look like a real <w>beanpole</w>."
                            }
                        },
                        {
                            "text": "Она ничего не ест целыми днями и скоро превратится в сухую <w>спичку</w>.",
                            "target_lang_translations": {
                                "en": "She doesn't eat anything all day and will soon turn into a dried-up <w>stick</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "жердь"
                    ],
                    "antonyms": [
                        "бочонок"
                    ],
                    "common_phrases": [
                        "худой как спичка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в переносном значении для описания чрезмерной худобы"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very thin, skinny, or frail person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beanpole",
                                "target_lang_sense_clarification": "informal, very skinny or tall person"
                            },
                            {
                                "target_lang_word": "matchstick",
                                "target_lang_sense_clarification": "figurative, extremely thin person"
                            },
                            {
                                "target_lang_word": "stick",
                                "target_lang_sense_clarification": "informal, very thin person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}