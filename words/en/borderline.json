                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Clinicians must be trained to support <w>borderlines</w> with empathy.",
                            "target_lang_translations": {
                                "ru": "Клиницисты должны быть обучены поддерживать <w>людей с пограничным расстройством</w> с эмпатией."
                            }
