                        "entry_id": "43f370ca-e0cb-3001-ac32-7517690e2d14",
                        "glosses": [
                            "Petite monnaie de cuivre d’Espagne qui valait environ un centime et demi de France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c927101-e9e1-4529-88f2-cd523c273f33",
                                "sense_id": "dea1f300-a22f-3752-a553-f94a6627a6c2",
                                "text": "Je ne crois pas qu’on prenne une âme\nComme on vole un maravédi."
                            },
                            {
                                "example_id": "67ab1ee0-5c16-4e0e-8eca-1ae7036e2a48",
                                "sense_id": "dea1f300-a22f-3752-a553-f94a6627a6c2",
                                "text": "Il nommait des châteaux, et à peine en avait-il vu sur des doubles maravédis."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8ce2c3e-8906-3492-a012-0d2ff88ed5a3",
                        "entry_id": "43f370ca-e0cb-3001-ac32-7517690e2d14",
                        "glosses": [
                            "Monnaie, radis."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "362ae464-5362-46b0-acf8-06cadf07ce2a",
                                "sense_id": "b8ce2c3e-8906-3492-a012-0d2ff88ed5a3",
                                "text": "Petite Suzon, ouvre ton lit,\nJe vais t’mener au paradis.\nPetite Suzon, c’est bon la vie,\nLes poches bourrées d’maravédis."
                            }
                        ]
                    }
