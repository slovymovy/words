                            {
                                "example_id": "0df343ee-790c-4186-af8b-d9144a41ea90",
                                "sense_id": "db44d1e5-3a9a-33a9-9783-c0c426e5cd91",
                                "text": "W 991 w wyprawie i oblężeniu Brenny przez cesarza Ottona brał udział Mieszko I, a w 992 cesarza wsparł swoimi wojami Bolesław Chrobry"
                            }
