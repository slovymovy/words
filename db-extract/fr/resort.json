                                "target_senses": [
                                    {
                                        "sense_id": "4faf76a7-1d8e-3a3c-a835-eb14d5436ccb",
                                        "entry_id": "334cac7a-e19d-35b3-8b2f-66ef5fcb4bc5",
                                        "glosses": [
                                            "een park met vakantiehuizen die verhuurd worden aan vakantiegangers en toeristen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2cd6a64-2513-4e60-8610-488904724e5c",
                                                "sense_id": "4faf76a7-1d8e-3a3c-a835-eb14d5436ccb",
                                                "text": "‘Ik ben op weg naar een huisje op een vakantiepark in Venlo, een weekendje weg met ons gezin, mijn ouders en mijn zus. Dat doen wij een keer per jaar, en dit was al een half jaar van tevoren gepland. We hebben ervoor gekozen om het toch door te laten gaan. Er is daar ruimte en groen, het is geen massale mensenmassa waarin we ons begeven. We zien wel wat er daar nog open is. En dit weekend is belangrijk voor ons, er worden al zo veel leuke dingen afgelast."
                                            },
                                            {
                                                "example_id": "0b7f1939-4551-4910-bc1d-b036463697ce",
                                                "sense_id": "4faf76a7-1d8e-3a3c-a835-eb14d5436ccb",
                                                "text": "Salemink gaf tijdens een werkbezoek van Gedeputeerde Staten van Overijssel aan de Wierdense buurtschappen een uitleg hoe hij de verdere ontwikkeling van het platteland ziet. Notter-Zuna was voor hem geen geheel onbekend terrein, hij verbleef er enkele jaren geleden al eens een weekend in vakantiepark ’t Mölke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
