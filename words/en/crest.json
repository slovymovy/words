                            },
                            {
                                "target_lang_word": "Kamm",
                                "target_lang_sense_clarification": "einer Welle"
                            },
                            {
                                "target_lang_word": "Wellenspitze",
                                "target_lang_sense_clarification": "Spitze einer Welle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25d76508-04a6-3c86-9cf2-12a218dfbe75",
                    "sense_definition": "The highest point or summit of a hill or mountain ridge.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "top_summit",
                    "name_type": "no",
                    "examples": [
                        {
