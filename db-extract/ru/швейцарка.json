                                            {
                                                "example_id": "cecd2803-db7a-4d7f-bd76-3ac8ca7f9d72",
                                                "sense_id": "ae25fd13-3b4d-3377-8416-a604e57ac7ca",
                                                "text": "Ursula Andress ist Schweizerin."
                                            },
                                            {
                                                "example_id": "e5ff5aab-19fb-41d4-acca-27276e5a49ad",
                                                "sense_id": "ae25fd13-3b4d-3377-8416-a604e57ac7ca",
                                                "text": "Der Schweizer hat den Hut verloren und die Schweizerin hat's gemerkt."
                                            },
                                            {
                                                "example_id": "29481372-f5b7-4961-b970-0abed21bf173",
                                                "sense_id": "ae25fd13-3b4d-3377-8416-a604e57ac7ca",
                                                "text": "„Auch die einstige Sonderermittlerin zu Syrien, die Schweizerin Carla del Ponte, warf den Vereinten Nationen Versagen beim Schutz der Menschenrechte vor.“"
                                            },
                                            {
                                                "example_id": "14cd9713-3672-4b4a-816a-7452458f65f5",
                                                "sense_id": "ae25fd13-3b4d-3377-8416-a604e57ac7ca",
                                                "text": "„Letztlich habe die Schweizerin Sitting Bull nur sehr begrenzt helfen können.“"
                                            },
                                            {
                                                "example_id": "97931665-1e90-4d0b-853a-3ac0bf2e4e0a",
                                                "sense_id": "ae25fd13-3b4d-3377-8416-a604e57ac7ca",
                                                "text": "„Schneewittchen, als typische Schweizerin, war zu blöde oder zu gutmütig, um auf Geld aus zu sein.“"
                                            }
