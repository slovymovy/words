{
    "word_family": [
        "scrabbler"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "334693ef-85c5-3106-8d5e-7f38c2207491",
                    "sense_definition": "A board game in which players use lettered tiles to form words on a grid, scoring points based on letter values and board positions.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "game",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "Every Sunday evening, our family sits down together to play <w>Scrabble</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый воскресный вечер наша семья собирается вместе, чтобы поиграть в <w>«Скрэббл»</w>."
                            }
                        },
                        {
                            "text": "She won the match of <w>Scrabble</w> by placing seven letters in one turn.",
                            "target_lang_translations": {
                                "ru": "Она выиграла партию в <w>«Скрэббл»</w>, выложив сразу семь букв за один ход."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play Scrabble",
                        "Scrabble board",
                        "game of Scrabble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настольная игра, в которой игроки составляют слова на поле из плиток с буквами, набирая очки за стоимость букв и призовые клетки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Скрэббл",
                                "target_lang_sense_clarification": "оригинальное название игры"
                            },
                            {
                                "target_lang_word": "Эрудит",
                                "target_lang_sense_clarification": "русскоязычный аналог игры"
                            },
                            {
                                "target_lang_word": "Словодел",
                                "target_lang_sense_clarification": "русскоязычный аналог игры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d152835-4c91-315f-bc50-fd498e94490a",
                    "sense_definition": "To move or climb hurriedly, often using both hands and feet or making rapid scratching movements.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was trying to <w>scrabble</w> up the slippery bank after the ball.",
                            "target_lang_translations": {
                                "ru": "Собака пыталась <w>вскарабкаться</w> по скользкому склону за мячом."
                            }
                        },
                        {
                            "text": "She <w>scrabbled</w> desperately against the steep rock face to avoid falling.",
                            "target_lang_translations": {
                                "ru": "Она отчаянно <w>цеплялась</w> за отвесную скалу, чтобы не упасть."
                            }
                        }
                    ],
                    "synonyms": [
                        "scramble",
                        "clamber"
                    ],
                    "common_phrases": [
                        "scrabble up",
                        "scrabble around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Карабкаться или поспешно пробираться, цепляясь руками и ногами или быстро скребя когтями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "с трудом взбираться, цепляясь"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "подниматься по крутой поверхности"
                            },
                            {
                                "target_lang_word": "семенить",
                                "target_lang_sense_clarification": "быстро и суетливо перебирать лапами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e66ad715-f9a1-3f13-900a-1bb2076e8cf3",
                    "sense_definition": "To scrape, scratch, or search hastily and frantically with fingers or claws.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scrape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He desperately <w>scrabbled</w> at the loose dirt trying to unearth the hidden keys.",
                            "target_lang_translations": {
                                "ru": "Он отчаянно <w>разгребал руками</w> рыхлую землю, пытаясь откопать спрятанные ключи."
                            }
                        },
                        {
                            "text": "She <w>scrabbled</w> in her purse looking for her phone as it rang.",
                            "target_lang_translations": {
                                "ru": "Она <w>лихорадочно рылась</w> в сумочке в поисках звонящего телефона."
                            }
                        }
                    ],
                    "synonyms": [
                        "claw",
                        "scratch",
                        "scrape"
                    ],
                    "common_phrases": [
                        "scrabble in the dirt",
                        "scrabble at the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торопливо и лихорадочно скрести, царапать или шарить пальцами либо когтями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрести",
                                "target_lang_sense_clarification": "царапать пальцами или когтями"
                            },
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "лихорадочно искать что-либо руками"
                            },
                            {
                                "target_lang_word": "шарить",
                                "target_lang_sense_clarification": "быстро ощупывать в поисках чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7cace7c-29dc-36bd-b39a-e219a6b3f2e2",
                    "sense_definition": "To struggle or compete frantically to collect or obtain something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many small companies are forced to <w>scrabble</w> for scarce funding during economic downturns.",
                            "target_lang_translations": {
                                "ru": "Многие небольшие компании вынуждены <w>отчаянно бороться</w> за скудное финансирование в период экономических кризисов."
                            }
                        },
                        {
                            "text": "Commuters <w>scrabbled</w> for the few remaining seats on the crowded morning train.",
                            "target_lang_translations": {
                                "ru": "Пассажиры <w>бились</w> за несколько оставшихся мест в переполненном утреннем поезде."
                            }
                        }
                    ],
                    "synonyms": [
                        "scramble"
                    ],
                    "common_phrases": [
                        "scrabble for money",
                        "scrabble for survival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчаянно бороться или соперничать ради получения или добычи чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "отчаянно сражаться за что-либо"
                            },
                            {
                                "target_lang_word": "драться",
                                "target_lang_sense_clarification": "бороться за ограниченные ресурсы"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "прилагать отчаянные усилия для получения чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dfe27dd-8b67-3271-8925-764744587186",
                    "sense_definition": "To scribble or write carelessly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "write",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>scrabble</w> random marks across the wooden door.",
                            "target_lang_translations": {
                                "ru": "Пациент начал <w>выцарапывать</w> беспорядочные знаки на деревянной двери."
                            }
                        },
                        {
                            "text": "He managed to <w>scrabble</w> a short note before running out of ink.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>начеркать</w> короткую записку до того, как закончились чернила."
                            }
                        }
                    ],
                    "synonyms": [
                        "scribble",
                        "scrawl"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used rarely in modern English in the sense of scribbling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небрежно или торопливо писать, черкать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чиркать",
                                "target_lang_sense_clarification": "быстро и небрежно набрасывать текст"
                            },
                            {
                                "target_lang_word": "строчить",
                                "target_lang_sense_clarification": "торопливо записывать"
                            },
                            {
                                "target_lang_word": "царапать",
                                "target_lang_sense_clarification": "коряво или небрежно писать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9dd000-0dfc-30b6-b07e-8c6722a8a06e",
                    "sense_definition": "To mark or cover a surface with irregular lines or letters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "write",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>scrabble</w> paper with broken crayons.",
                            "target_lang_translations": {
                                "ru": "Ребёнок принялся <w>черкать</w> по бумаге сломанными мелками."
                            }
                        },
                        {
                            "text": "Vandals had <w>scrabbled</w> the wall with strange symbols during the night.",
                            "target_lang_translations": {
                                "ru": "Ночью вандалы <w>изрисовали</w> стену странными символами."
                            }
                        }
                    ],
                    "synonyms": [
                        "scribble",
                        "scrawl"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used transitively to mean defacing or covering with scribbles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность каракулями, царапинами или беспорядочными знаками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчиркать",
                                "target_lang_sense_clarification": "покрыть неровными линиями или каракулями"
                            },
                            {
                                "target_lang_word": "исцарапать",
                                "target_lang_sense_clarification": "оставить следы или надписи на поверхности"
                            },
                            {
                                "target_lang_word": "изрисовать",
                                "target_lang_sense_clarification": "беспорядочно разрисовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ad3f396-f529-3de7-986c-27ea245931c4",
                    "sense_definition": "A hurried, frantic struggle or scramble to achieve or obtain something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a desperate <w>scrabble</w> among reporters to reach the courtroom first.",
                            "target_lang_translations": {
                                "ru": "Среди репортёров развернулась отчаянная <w>борьба</w> за то, чтобы первыми попасть в зал суда."
                            }
                        },
                        {
                            "text": "Their climb up the crumbling slope turned into a dangerous <w>scrabble</w>.",
                            "target_lang_translations": {
                                "ru": "Их подъём по осыпающемуся склону превратился в опасную <w>карабканье-схватку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scramble",
                        "struggle"
                    ],
                    "common_phrases": [
                        "a mad scrabble",
                        "scrabble for survival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лихорадочная, отчаянная борьба или суматошные попытки чего-то достичь или заполучить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "ожесточённая или суматошная схватка за что-либо"
                            },
                            {
                                "target_lang_word": "толкотня",
                                "target_lang_sense_clarification": "суета и давка ради достижения цели"
                            },
                            {
                                "target_lang_word": "свалка",
                                "target_lang_sense_clarification": "беспорядочная борьба или суматоха"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}