                                "example_id": "87bf86d0-c20b-4661-8894-34b8d1ec4451",
                                "sense_id": "d7e7e080-96a6-3237-b970-742b913d98ee",
                                "text": "Autocoureur Rinus van Kalmthout heeft in de Amerikaanse IndyCar de prestigieuze Rookie of the Year-prijs gewonnen. Hij treed in de voetsporen van Arie Luyendyk en Robert Doornbos. Verslaggever Martin Vriesema sprak met Van Kalmthout."
                            },
                            {
                                "example_id": "22463e5a-b330-4fe0-b05c-dfbe6c16abbc",
                                "sense_id": "d7e7e080-96a6-3237-b970-742b913d98ee",
                                "text": "Presentator Amber Brantsen praat in de NOS Formule 1-podcast met commentator Louis Dekker en autocoureur en simulatorexpert Rudy van Buren over het afgelopen raceweekend."
                            }
                        ]
                    }
