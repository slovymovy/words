                        "entry_id": "a871f488-447c-378b-9e02-9aee946b1364",
                        "glosses": [
                            "zu Athen gehörig, aus ihm kommend oder es betreffend"
                        ],
                        "tags": [
                            "nur attributiv"
                        ],
                        "examples": [
                            {
                                "example_id": "8140f7a3-a7f7-4acf-a5a1-b0140a25359a",
                                "sense_id": "7c296fcc-7ef6-3032-a06d-af6d4ef1a7d1",
                                "text": "„Als Sohn einer führenden Athener Aristokratenfamilie verschrieb sich Platon ursprünglich der Politik, zog sich aber unter dem Eindruck der Peloponesischen Kriege und der Hinrichtung seines langjährigen Lehrers Sokrates 399 v.Chr. resigniert daraus zurück und wandte sich der Philosophie zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f45f84d6-8ef4-464c-93c0-9c20ec327ec1",
                        "source_entry_id": "a871f488-447c-378b-9e02-9aee946b1364",
                        "source_sense_id": "7c296fcc-7ef6-3032-a06d-af6d4ef1a7d1",
                        "source_sense_description": "zu Athen gehörig, aus ihm kommend oder es betreffend",
