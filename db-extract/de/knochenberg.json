                        "examples": [
                            {
                                "example_id": "d6a2dee7-a530-4b10-9ecd-db2046d236ec",
                                "sense_id": "74e65d9b-f7fc-33dd-8288-fa216f0e3686",
                                "text": "„Fast sofort verloren sie sich aus den Augen, da die Wände gekrümmt waren und der Knochenberg die Sicht quer durch die Höhle versperrte.“"
                            },
                            {
                                "example_id": "09bc61e1-734f-42c3-b9af-82d26146a577",
                                "sense_id": "74e65d9b-f7fc-33dd-8288-fa216f0e3686",
                                "text": "„Ich hörte das entsetzliche Geräusch der Schädel, die ihren Halt verloren aus dem Knochenberg rutschten.“"
                            }
                        ],
