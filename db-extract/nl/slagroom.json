                    {
                        "translation_id": "cec46a17-4646-4f4b-9038-fe556180f79e",
                        "source_entry_id": "00c94fc0-2893-34eb-a7ef-f657e1c3bccf",
                        "source_sense_id": "37b4e399-cbf4-376f-aed0-108b0a0a4fab",
