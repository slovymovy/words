                "senses": [
                    {
                        "sense_id": "7f69ab2b-3e6d-311e-943e-c596ba0c012d",
                        "entry_id": "23c6b4d7-1597-3521-8fb9-c4df4617cee4",
                        "glosses": [
                            "akcesoria i środki techniczne stanowiące uzupełnienie wyposażenia maszyn i urządzeń, umożliwiające wykonanie specjalistycznych zadań i operacji"
                        ],
                        "tags": [
                            "masz."
                        ],
                        "examples": [
                            {
                                "example_id": "9cafac2c-d9a8-45c5-8fa8-05de57fb6587",
                                "sense_id": "7f69ab2b-3e6d-311e-943e-c596ba0c012d",
                                "text": "Do maszyny dołączono bardzo bogate oprzyrządowanie fabryczne"
                            },
                            {
                                "example_id": "b0a1c091-e7bd-4159-a21e-e2412ddad621",
                                "sense_id": "7f69ab2b-3e6d-311e-943e-c596ba0c012d",
                                "text": "Przykładowe elementy oprzyrządowania frezarki narzędziowej to głowica dłutująca, podzielnica, tulejki, stół obrotowy i uchylny, podtrzymka do poziomów oraz wibroizolatory"
                            },
                            {
                                "example_id": "a33136ec-20b5-4d93-afc5-b4572ce3cc0d",
                                "sense_id": "7f69ab2b-3e6d-311e-943e-c596ba0c012d",
                                "text": "Maszyna posiada kompletne oprzyrządowanie: główkę podwójnie skrętną, główkę do dłutowania, dwa okulary, podzielnicę, konik do podzielnicy, gitarę, imadło, trzpienie i tulejki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4452009-f479-4b30-a6a4-8b6fc07b341a",
                        "source_entry_id": "23c6b4d7-1597-3521-8fb9-c4df4617cee4",
                        "source_sense_id": "7f69ab2b-3e6d-311e-943e-c596ba0c012d",
                        "target_lang_word": "instrumentation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instrumentation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3bfa1c5-e096-34c3-beff-95b68da06ad6",
                                        "entry_id": "7d018d4d-77a3-3173-8f15-4dcffa738629",
                                        "glosses": [
                                            "The act of using or adapting as an instrument; a series or combination of instruments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5a0a3cb-e5a6-4fec-b381-c6dc3875afb0",
                                                "sense_id": "e3bfa1c5-e096-34c3-beff-95b68da06ad6",
                                                "text": "Science should be distinguished from technique and its scientific instrumentation, technology. Science is practised by scientists, and techniques by ‘engineers’ — a term that in our terminology includes physicians, lawyers, and teachers. If for the scientist knowledge and cognition are primary, it is action and construction that characterises the work of the engineer, though in fact his activity may be based on science. In history, technique often preceded science."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169c6bb7-3abd-3e5c-8696-c6f3f542b694",
                                        "entry_id": "7d018d4d-77a3-3173-8f15-4dcffa738629",
                                        "glosses": [
                                            "The arrangement of a musical composition for performance by a number of different instruments; instrumental composition; composition for an orchestra or military band."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aea15e90-1223-4ab7-a625-9f2009566a13",
                                                "sense_id": "169c6bb7-3abd-3e5c-8696-c6f3f542b694",
                                                "text": "They changed the woodwind instrumentation to piccollos and saxophones, and as a result it sounded much more clumsy."
                                            },
                                            {
                                                "example_id": "561d8105-4253-4473-94a1-f7be7dffb859",
                                                "sense_id": "169c6bb7-3abd-3e5c-8696-c6f3f542b694",
                                                "text": "MOHAMMAD REZA SHAJARIAN (Thursday) Renowned in his native Iran, the vocalist Mohammad Reza Shajarian has been performing since the 1960s, and is now widely considered one of the finest classical Persian singers in the world. Mr. Shajarian’s son, Homayoun Shajarian, will provide additional vocals and tombak (goblet drum), while Ensemble Ava, a four-piece, will contribute additional instrumentation on the ancient Persian instruments barbat (short-necked lute), tar (long-necked lute), kamancheh (spike fiddle) and daf (frame drum)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7957ce0-d9ec-3c86-9ced-e128bfcb167a",
                                        "entry_id": "7d018d4d-77a3-3173-8f15-4dcffa738629",
                                        "glosses": [
                                            "The act or manner of playing upon musical instruments; performance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebd7f170-c6a6-42fd-9d20-addf0ee000b1",
                                                "sense_id": "f7957ce0-d9ec-3c86-9ced-e128bfcb167a",
                                                "text": "He had a wonderful instrumentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2269407-bf13-3e46-95d6-a5a52c7c1f8f",
                                        "entry_id": "7d018d4d-77a3-3173-8f15-4dcffa738629",
                                        "glosses": [
                                            "On a vehicle, dashboard gauges monitoring engine functions and performance, along with other essential functions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46d7405-a438-4f5d-9155-4f70c0a69249",
                                                "sense_id": "d2269407-bf13-3e46-95d6-a5a52c7c1f8f",
                                                "text": "The car's instrumentation included fuel, temperature, voltimeter and oil pressure gauges, along with a speedometer and tachometer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833fda9c-dd96-366f-8525-68466e1aa52f",
                                        "entry_id": "7d018d4d-77a3-3173-8f15-4dcffa738629",
                                        "glosses": [
                                            "The dynamic analysis of a program's performance and behaviour, usually by injecting profiling code into it."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "423d22d4-1035-4238-9e0d-7d525629937d",
                                                "sense_id": "833fda9c-dd96-366f-8525-68466e1aa52f",
                                                "text": "bytecode instrumentation"
                                            },
                                            {
                                                "example_id": "3128b509-beb5-4624-b251-44193b1e735b",
                                                "sense_id": "833fda9c-dd96-366f-8525-68466e1aa52f",
                                                "text": "Xcode is Apple's toolkit for developers. It includes an IDE, a design tool (Interface Builder), a compiler, and the iOS emulator, as well as a set of tools for instrumentation and performance analysis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
