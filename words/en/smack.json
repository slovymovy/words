{
    "word_family": [
        "smacker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af3c4ed2-2513-3b69-bfd5-a4db7b7eb564",
                    "sense_definition": "To hit or slap someone with a flat hand or a hard blow.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry customer suddenly <w>smacked</w> the table and walked out of the store.",
                            "target_lang_translations": {
                                "ru": "Разгневанный покупатель внезапно <w>хлопнул</w> по столу и вышел из магазина."
                            }
                        },
                        {
                            "text": "She threatened to <w>smack</w> him if he did not stop teasing her.",
                            "target_lang_translations": {
                                "ru": "Она пригрозила <w>шлёпнуть</w> его, если он не перестанет её дразнить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smack in the face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо или что-либо ладонью или с размаху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлёпнуть",
                                "target_lang_sense_clarification": "ударить ладонью или плашмя"
                            },
                            {
                                "target_lang_word": "хлопнуть",
                                "target_lang_sense_clarification": "с шумом ударить"
                            },
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "нанести удар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee6c487f-ad81-384b-91ed-b5d9268f064d",
                    "sense_definition": "To hit a child as a form of physical discipline.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many parents believe it is completely wrong to <w>smack</w> a child.",
                            "target_lang_translations": {
                                "ru": "Многие родители считают абсолютно недопустимым <w>шлёпать</w> ребёнка."
                            }
                        },
                        {
                            "text": "The law forbids teachers from <w>smacking</w> pupils under any circumstances.",
                            "target_lang_translations": {
                                "ru": "Закон запрещает учителям <w>наказывать шлепками</w> учеников при любых обстоятельствах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шлёпать ребёнка в качестве физического наказания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлёпать",
                                "target_lang_sense_clarification": "наказывать шлепками"
                            },
                            {
                                "target_lang_word": "дать шлепка",
                                "target_lang_sense_clarification": "наказать ударом ладони"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3853974-d607-3cae-86e5-fe6018af5c5f",
                    "sense_definition": "To make a sharp, snapping sound, or to cause something to make such a noise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long leather whip <w>smacked</w> loudly against the ground.",
                            "target_lang_translations": {
                                "ru": "Длинный кожаный кнут громко <w>хлестнул</w> по земле."
                            }
                        },
                        {
                            "text": "Loose sails were <w>smacking</w> against the mast in the heavy wind.",
                            "target_lang_translations": {
                                "ru": "Ослабленные паруса со стуком <w>хлопали</w> о мачту на сильном ветру."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать резкий, хлопающий звук или ударяться со звуком о поверхность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "издавать резкие звуки от ударов"
                            },
                            {
                                "target_lang_word": "шлёпать",
                                "target_lang_sense_clarification": "со звуком ударяться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9e5076b-5a49-3eea-af01-be9943c15f27",
                    "sense_definition": "To open and close the lips loudly in anticipation or enjoyment of food.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lips",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy was <w>smacking</w> his lips as he smelled the fresh pizza.",
                            "target_lang_translations": {
                                "ru": "Мальчик с аппетитом <w>облизывался и причмокивал</w>, почувствовав запах свежей пиццы."
                            }
                        },
                        {
                            "text": "He took a generous bite of the stew and <w>smacked</w> happily.",
                            "target_lang_translations": {
                                "ru": "Он откусил большой кусок рагу и с удовольствием <w>причмокнул</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smack one's lips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко смыкать и размыкать губы в предвкушении или во время еды; причмокивать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причмокивать",
                                "target_lang_sense_clarification": "издавать звуки губами от удовольствия"
                            },
                            {
                                "target_lang_word": "чмокать",
                                "target_lang_sense_clarification": "размыкать губы со звуком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fef4b51a-2cb7-3d22-94f5-eee3aa21fe5a",
                    "sense_definition": "To give a strong impression of or suggest something unpleasant or undesirable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "suggest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His defensive explanation <w>smacks</w> of dishonesty and arrogance.",
                            "target_lang_translations": {
                                "ru": "В его оправдательном объяснении явно <w>сквозит</w> неискренность и высокомерие."
                            }
                        },
                        {
                            "text": "The whole suspicious deal <w>smacked</w> of corruption from the start.",
                            "target_lang_translations": {
                                "ru": "Вся эта подозрительная сделка с самого начала <w>попахивала</w> коррупцией."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smack of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдавать чем-либо неприятным, наводить на мысль о чем-либо дурном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смахивать на",
                                "target_lang_sense_clarification": "быть похожим на что-то нежелательное"
                            },
                            {
                                "target_lang_word": "попахивать",
                                "target_lang_sense_clarification": "наводить на подозрения о чем-то дурном"
                            },
                            {
                                "target_lang_word": "отдавать",
                                "target_lang_sense_clarification": "иметь неприятный оттенок чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "663c13c1-4657-3025-8cdd-d4df087638fa",
                    "sense_definition": "To have a distinctive taste or perceptible flavor of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This ancient wine still <w>smacks</w> of the wooden barrel in which it aged.",
                            "target_lang_translations": {
                                "ru": "Это старинное вино до сих пор <w>отдает</w> деревянной бочкой, в которой оно созревало."
                            }
                        },
                        {
                            "text": "The broth was hearty, <w>smacking</w> slightly of wild herbs.",
                            "target_lang_translations": {
                                "ru": "Бульон был сытным, с легким <w>привкусом</w> диких трав."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь отчетливый привкус или оттенок вкуса чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдавать",
                                "target_lang_sense_clarification": "иметь привкус чего-либо"
                            },
                            {
                                "target_lang_word": "иметь привкус",
                                "target_lang_sense_clarification": "сохранять дополнительный вкус"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "749ed3c6-ff8a-3c88-8fb3-88a2f2260a4e",
                    "sense_definition": "To kiss someone loudly with compressed lips.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kiss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmother affectionately <w>smacked</w> him on both cheeks.",
                            "target_lang_translations": {
                                "ru": "Бабушка нежно <w>чмокнула</w> его в обе щеки."
                            }
                        },
                        {
                            "text": "He pulled his wife close and <w>smacked</w> her noisily on the mouth.",
                            "target_lang_translations": {
                                "ru": "Он притянул к себе жену и сочно <w>чмокнул</w> её в губы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко, смачно поцеловать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чмокнуть",
                                "target_lang_sense_clarification": "поцеловать со звуком"
                            },
                            {
                                "target_lang_word": "расцеловать",
                                "target_lang_sense_clarification": "громко поцеловать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbbbcdd1-eab2-3de3-ae82-ed05dcbe5f8d",
                    "sense_definition": "To taste or perceive the distinct flavor of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He eagerly <w>smacked</w> the wine, trying to identify the hidden spices.",
                            "target_lang_translations": {
                                "ru": "Он увлеченно <w>смаковал</w> вино, пытаясь различить скрытые пряности."
                            }
                        },
                        {
                            "text": "The critic paused and <w>smacked</w> the sauce before giving his review.",
                            "target_lang_translations": {
                                "ru": "Критик сделал паузу и <w>распробовал</w> соус, прежде чем вынести свой вердикт."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пробовать на вкус или смаковать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смаковать",
                                "target_lang_sense_clarification": "пробовать с наслаждением"
                            },
                            {
                                "target_lang_word": "отведать",
                                "target_lang_sense_clarification": "попробовать на вкус"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26e4a379-debd-331f-b610-ac09f6578bde",
                    "sense_definition": "A sharp, forceful blow delivered with an open hand or a flat surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave the stubborn machine a solid <w>smack</w> to make it work.",
                            "target_lang_translations": {
                                "ru": "Он отвесил упрямому аппарату увесистый <w>шлепок</w>, чтобы тот заработал."
                            }
                        },
                        {
                            "text": "She threatened to give him a <w>smack</w> if he did not behave.",
                            "target_lang_translations": {
                                "ru": "Она пригрозила дать ему <w>подзатыльник</w>, если он не будет себя вести прилично."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звонкий удар ладонью или плоским предметом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепок",
                                "target_lang_sense_clarification": "удар плашмя"
                            },
                            {
                                "target_lang_word": "хлопок",
                                "target_lang_sense_clarification": "звонкий удар"
                            },
                            {
                                "target_lang_word": "пощечина",
                                "target_lang_sense_clarification": "удар ладонью по лицу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c66d9b67-2a90-3685-b686-27610c003614",
                    "sense_definition": "An illicit opioid drug; heroin.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years struggling with an addiction to <w>smack</w> before getting clean.",
                            "target_lang_translations": {
                                "ru": "Он годами боролся с зависимостью от <w>героина</w>, прежде чем окончательно завязать."
                            }
                        },
                        {
                            "text": "The police seized several bags of <w>smack</w> during the overnight raid.",
                            "target_lang_translations": {
                                "ru": "Во время ночного рейда полиция изъяла несколько пакетов с <w>героином</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "heroin",
                        "junk",
                        "dope",
                        "horse",
                        "brown sugar"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in street drug contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жаргонное обозначение героина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "героин",
                                "target_lang_sense_clarification": "наркотическое вещество"
                            },
                            {
                                "target_lang_word": "герыч",
                                "target_lang_sense_clarification": "жаргонное название героина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e57e41cb-99bd-3f61-a8b8-ec033e3cf1a0",
                    "sense_definition": "A loud, sharp noise such as that made by a slap, separated lips, or a whip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the loud <w>smack</w> of the ball striking the wooden fence.",
                            "target_lang_translations": {
                                "ru": "Мы услышали громкий <w>хлопок</w> от удара мяча о деревянный забор."
                            }
                        },
                        {
                            "text": "The sudden <w>smack</w> of thunder startled the sleeping passengers.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>раскат</w> грома напугал спавших пассажиров."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, резкий звук от удара ладонью, губами или кнутом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепок",
                                "target_lang_sense_clarification": "звук удара плашмя"
                            },
                            {
                                "target_lang_word": "хлопок",
                                "target_lang_sense_clarification": "резкий звонкий звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd75805a-c638-3596-a986-ff88a9fb23a5",
                    "sense_definition": "A loud kiss, or the sharp sound produced by one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kiss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She greeted the little boy with a noisy <w>smack</w> on the forehead.",
                            "target_lang_translations": {
                                "ru": "Она встретила малыша звонким <w>чмоком</w> в лоб."
                            }
                        },
                        {
                            "text": "The aunt planted a firm <w>smack</w> right on his cheek.",
                            "target_lang_translations": {
                                "ru": "Тетя смачно <w>поцеловала</w> его прямо в щеку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий поцелуй или звук такого поцелуя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чмок",
                                "target_lang_sense_clarification": "звонкий поцелуй или его звук"
                            },
                            {
                                "target_lang_word": "чмоканье",
                                "target_lang_sense_clarification": "звук громкого поцелуя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efbc3de2-6aa3-3873-9768-463a95702a81",
                    "sense_definition": "A slight, distinct flavor or lingering taste.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rich dessert had a subtle <w>smack</w> of roasted almond.",
                            "target_lang_translations": {
                                "ru": "Этот сытный десерт обладал тонким <w>привкусом</w> жареного миндаля."
                            }
                        },
                        {
                            "text": "There was a sharp <w>smack</w> of vinegar in the salad dressing.",
                            "target_lang_translations": {
                                "ru": "В заправке для салата чувствовался резкий <w>привкус</w> уксуса."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий привкус или остаточный вкусовой оттенок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привкус",
                                "target_lang_sense_clarification": "слабо выраженный оттенок вкуса"
                            },
                            {
                                "target_lang_word": "вкус",
                                "target_lang_sense_clarification": "вкусовое ощущение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82ab1305-e9f1-33f8-acaf-1b7aeb3f71c2",
                    "sense_definition": "A slight trace, hint, or smattering of a quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "suggest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech had a definite <w>smack</w> of irony that amused the audience.",
                            "target_lang_translations": {
                                "ru": "В его речи явно сквозил <w>оттенок</w> иронии, позабавивший слушателей."
                            }
                        },
                        {
                            "text": "There was a distinct <w>smack</w> of rebellion in the young soldier's demeanor.",
                            "target_lang_translations": {
                                "ru": "В поведении молодого солдата отчетливо читался <w>налёт</w> бунтарства."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий след, оттенок или признак какого-либо свойства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "едва заметное проявление свойства"
                            },
                            {
                                "target_lang_word": "налёт",
                                "target_lang_sense_clarification": "переносно: слабый признак качества"
                            },
                            {
                                "target_lang_word": "привкус",
                                "target_lang_sense_clarification": "переносно: отпечаток, призвук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6a1ffcd-99e4-3a3a-a5e3-24e2f1563c59",
                    "sense_definition": "A traditional small sailing boat, typically rigged as a sloop or cutter, used for coastal fishing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "boat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden <w>smack</w> was tied up beside the stone harbor wall.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный <w>смак</w> был пришвартован у каменной стены гавани."
                            }
                        },
                        {
