                "forms": [
                    {
                        "form_id": "979b9299-21fc-4074-bf39-d4222efd58ad",
                        "entry_id": "a96f7a4f-d3d3-381a-b0dd-2f8de614c09d",
                        "tags": [
                            "plural"
                        ],
                        "form": "parolis"
