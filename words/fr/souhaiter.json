    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54da4ff7-d6dd-3140-823d-d521bcf239c4",
                    "sense_definition": "Adresser des vœux de bienveillance, de bonheur ou de civilité à quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "souhaiter_formules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute l'équipe se réunit pour lui <w>souhaiter</w> un très joyeux anniversaire."
                        },
                        {
                            "text": "Le directeur est venu en personne nous <w>souhaiter</w> la bienvenue au bureau."
                        }
                    ],
                    "common_phrases": [
                        "souhaiter la bienvenue",
                        "souhaiter un joyeux anniversaire",
                        "souhaiter le bonsoir",
                        "souhaiter une bonne journée"
                    ]
                },
                {
                    "sense_id": "364fc053-2e44-3a7e-bc27-755bcebf8663",
                    "sense_definition": "Former le vœu ou désirer qu'un fait se produise, qu'une situation se réalise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "souhaiter_desir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>souhaite</w> réussir mes examens universitaires à la fin du semestre."
                        },
                        {
                            "text": "Nous <w>souhaitons</w> vivement que la situation s'améliore dans les plus brefs délais."
                        }
                    ],
                    "synonyms": [
                        "appeler de ses vœux"
                    ],
                    "common_phrases": [
                        "souhaiter ardemment",
                        "souhaiter de tout cœur"
                    ]
                },
                {
                    "sense_id": "8aa7221b-cc7d-348d-abca-ce0c3c5e2b80",
                    "sense_definition": "Désirer auprès de soi la présence ou l'arrivée d'une personne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après tant de jours d'isolement, il <w>souhaitait</w> ses amis auprès de lui."
                        },
                        {
                            "text": "Dans cette épreuve difficile, elle <w>souhaitait</w> ardemment sa sœur à son chevet."
                        }
                    ]
                }
            ]
        }
