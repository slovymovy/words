                    {
                        "sense_id": "4c16212c-2666-3c40-94c1-8abc522c95b7",
                        "entry_id": "4ccd4588-18e7-3c75-89cb-1a982bf4abad",
                        "glosses": [
                            "Accentuation, surlignage, proéminence."
