                        "target_lang_word": "phaser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phaser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04510cfc-56be-375a-b404-d335d21d48fe",
                                        "entry_id": "efc1d163-021e-3405-9c2a-6c0121588f6f",
                                        "glosses": [
                                            "An electronic device that produces special effects on the sound produced by an electric guitar etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cae30944-82a1-3a9a-92a2-29953a7f07cb",
                                        "entry_id": "efc1d163-021e-3405-9c2a-6c0121588f6f",
                                        "glosses": [
                                            "Fictional energy weapon, with multiple settings for degree of intensity, from the television series Star Trek (1966–69)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bad8daa-149b-4980-b3a6-d3ce7624df55",
                                                "sense_id": "cae30944-82a1-3a9a-92a2-29953a7f07cb",
                                                "text": "Captain James Kirk: \"Set your phaser on one quarter. I'll leave mine on stun.\""
                                            },
                                            {
                                                "example_id": "f47b0111-805c-4e31-9656-c30ed979544a",
                                                "sense_id": "cae30944-82a1-3a9a-92a2-29953a7f07cb",
                                                "text": "His oddly reserved nature stands out [...]. Whyte sets his phaser on stun, not kill."
                                            },
                                            {
                                                "example_id": "bc51ed44-7b10-4f9e-9cea-0181265d7c93",
                                                "sense_id": "cae30944-82a1-3a9a-92a2-29953a7f07cb",
                                                "text": "A Bajoran rushed past with an armful of phaser rifles, another with a box of hand phasers."
                                            },
                                            {
                                                "example_id": "f2fa8c58-c186-490f-95d7-355a751c3319",
                                                "sense_id": "cae30944-82a1-3a9a-92a2-29953a7f07cb",
                                                "text": "Giolitti's Gold Key art is widely admired, [...] and this is a terrific opportunity to pick up a page—set your phasers on bid."
                                            },
                                            {
                                                "example_id": "38003241-0e3e-4e75-9c61-fe54574919db",
                                                "sense_id": "cae30944-82a1-3a9a-92a2-29953a7f07cb",
                                                "text": "I said, \"Set phasers on be-a-bastard.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad273e7-4d55-330c-b271-370cf7565efd",
                                        "entry_id": "efc1d163-021e-3405-9c2a-6c0121588f6f",
                                        "glosses": [
                                            "A phase modulator"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a7ef8a3-0193-34c5-8544-5aa5bc2c2521",
