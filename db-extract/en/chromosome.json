                                    {
                                        "sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
                                        "entry_id": "dfcefe56-b146-3669-9aff-c1658dcbd77c",
                                        "glosses": [
                                            "staafachtig lichaampje in de celkern dat drager van erfelijke eigenschappen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23500652-37f6-4f73-9e9c-a56e9c4a66bf",
                                                "sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
                                                "text": "Bij de mens hebben de lichaamscellen 23 paren chromosomen, te weten 22 paren autosomen en 1 paar geslachtschromosomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73af1540-c555-49be-a794-11d9447e28c5",
                        "source_entry_id": "05ccde40-f940-3433-847f-217d90ece234",
                        "source_sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
                        "source_sense_description": "structure in the cell nucleus",
                        "target_lang_word": "chromosome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chromosome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                        "entry_id": "776486d4-394e-389e-a612-77a0792a2d43",
                                        "glosses": [
                                            "Élément microscopique des cellules constitué de molécules d’ADN et de protéines présent dans le noyau et servant de support à la transmission des caractères héréditaires."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46554e55-974d-43e4-9f21-5c9f0d42a2e2",
                                                "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                                "text": "Dans chaque cellule somatique les chromosomes apparaissent en double exemplaire ; un chromosome d’une même paire est d’origine maternelle, l’autre d’origine paternelle : ce sont des chromosomes homologues."
                                            },
                                            {
                                                "example_id": "2b53855d-4b24-4216-8477-53471e07a683",
                                                "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                                "text": "\"En fait, les femmes disposent de renforts du système immunitaire à un stade précoce des infections, alors que les hommes, avec leurs seuls chromosomes X, n’en possèdent pas\", explique-t-elle."
                                            },
                                            {
                                                "example_id": "6d945384-7e15-4375-aa45-bbfe0e160f1d",
                                                "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                                "text": "Les surdités congénitales chez les nourrissons et les enfants sont généralement provoqués par une anomalie génétique. Cela s’explique par une détérioration et une modification du chromosome 22."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89471b89-f3df-4669-b1dc-6acc75bbf494",
                        "source_entry_id": "05ccde40-f940-3433-847f-217d90ece234",
                        "source_sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
