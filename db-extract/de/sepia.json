                "translations": [
                    {
                        "translation_id": "eea3105b-ac36-4f18-887b-98b39f0e25e0",
                        "source_entry_id": "e971e6cc-7094-3ace-8022-106db6e62c99",
                        "source_sense_id": "a82f7d9f-7ef4-3b67-9e56-07343a49fd80",
                        "source_sense_description": "Farbe zwischen braun, grau und schwarz",
                        "target_lang_word": "sepia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sepia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aff11fea-936e-3aee-8c76-321febf7f258",
                                        "entry_id": "fc5a8a26-9816-3533-ba0a-bd6b29eb25df",
                                        "glosses": [
                                            "A dark brown pigment made from the secretions of the cuttlefish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428ccc65-1f22-49e5-bd54-668ef1a32a36",
                                                "sense_id": "aff11fea-936e-3aee-8c76-321febf7f258",
                                                "text": "Sepia had some use in ancient times as a writing ink, and in modern times has has occasionally been used as a pigment, but it never attained any popularity, as it is extremely fugitive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b07b057e-8a4d-3dc1-bd72-18f5f6e17396",
                                        "entry_id": "fc5a8a26-9816-3533-ba0a-bd6b29eb25df",
                                        "glosses": [
                                            "A dark, slightly reddish, brown colour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e8e8b7c-4b34-335f-926d-38eb3bfa0b1d",
                                        "entry_id": "fc5a8a26-9816-3533-ba0a-bd6b29eb25df",
                                        "glosses": [
                                            "A sepia-coloured drawing or photograph."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3da5b93-03e9-3876-b321-65b692ee8a37",
                                        "entry_id": "fc5a8a26-9816-3533-ba0a-bd6b29eb25df",
                                        "glosses": [
                                            "A cuttlefish."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sepia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc59eff-e901-3a9e-a618-2ba8fa41dd1b",
                                        "entry_id": "0c34198e-cb1b-32a4-9ed8-460e26fa96df",
                                        "glosses": [
                                            "Of a dark reddish-brown colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9396847e-cf79-4411-87e4-715e2b1cca1c",
                                                "sense_id": "4dc59eff-e901-3a9e-a618-2ba8fa41dd1b",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            },
                                            {
                                                "example_id": "1748f972-22de-495f-b25f-b7179ca5e554",
                                                "sense_id": "4dc59eff-e901-3a9e-a618-2ba8fa41dd1b",
                                                "text": "Only now did he realise how few colours there had been at the end of the universe. The world had been sepia, drained of colour and light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0da117b9-93cc-4bf3-8166-eb69ba10786b",
                        "source_entry_id": "e971e6cc-7094-3ace-8022-106db6e62c99",
                        "source_sense_id": "a82f7d9f-7ef4-3b67-9e56-07343a49fd80",
