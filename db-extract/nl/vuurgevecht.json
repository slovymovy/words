                            {
                                "example_id": "13f70e82-6eed-4cd7-9229-a7fb8d42b0ff",
                                "sense_id": "ac99123c-7eb7-33dc-b8d0-58f9a23d3824",
                                "text": "Er ontstond een vuurgevecht, dat echter maar van korte duur was."
