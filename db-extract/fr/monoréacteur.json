                        "glosses": [
                            "Équipé d’un seul réacteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564fff7f-c50f-40b9-89d8-6f08c45d58ac",
                                "sense_id": "6434e720-49df-3a74-aaad-8f7efff0919e",
                                "text": "Le chasseur monoréacteur de Hindustan Aeronautics réalise ses premiers essais d’appontage… terrestres. Un premier pas vers l’embarquement de l’appareil indien sur porte-avions."
                            },
                            {
                                "example_id": "ef298510-a230-448f-9b48-485644e3884f",
                                "sense_id": "6434e720-49df-3a74-aaad-8f7efff0919e",
                                "text": "Un avion monoréacteur comme le Mirage 2000 présente plusieurs avantages : il est plus petit et plus léger, sa maintenance est moins chère, sa fiabilité n’est plus un problème."
                            },
                            {
                                "example_id": "9f9276a8-00e0-4ce2-bdd4-ac387ad9e46a",
                                "sense_id": "6434e720-49df-3a74-aaad-8f7efff0919e",
                                "text": "Cirrus s’est vu décerner le Collier Trophy pour son jet monoréacteur, le SF 50 Vision Jet."
                            }
                        ]
                    }
                ],
