                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4327de43-7def-4894-be26-645d3ce619ad",
                                "sense_id": "bafa422a-1cf9-39b0-be9d-398172fc8116",
                                "text": "„Der Goldbergbau entwickelte sich schnell zum Industrialisierungsmotor Südafrikas und zog viele, oft gut ausgebildete Arbeitskräfte aus Europa in die bis dahin ländlich geprägte Burenrepublik.“"
                            },
                            {
                                "example_id": "e42d320c-16a2-495c-9a07-9f236b68c139",
                                "sense_id": "bafa422a-1cf9-39b0-be9d-398172fc8116",
                                "text": "„Vielmehr wurden diese Rohstoffe dem Export und der Veredelung in den Importländern vorbehalten, wodurch Tunesien den Rohstoffsektor nicht als Industrialisierungsmotor nutzen und in der Folge seine Rolle als weltmarktabhängiger Rohstofflieferant nicht abschütteln konnte.“"
                            },
                            {
                                "example_id": "c87bdb31-8a87-4a97-b36d-30f9f1c19125",
                                "sense_id": "bafa422a-1cf9-39b0-be9d-398172fc8116",
                                "text": "„Das Heraufbeschwören des Entwicklungsstaats im 20. Jahrhunderts als Industrialisierungsmotor hat hierbei auch heute noch eine starke politische Resonanz.“"
                            },
                            {
                                "example_id": "6407404b-a357-4600-b918-392d7183d5b2",
                                "sense_id": "bafa422a-1cf9-39b0-be9d-398172fc8116",
                                "text": "„Kritisch wird es insbesondere für ein entwickeltes Industrieland, wenn die Computerindustrie als Industrialisierungsmotor abwandert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
