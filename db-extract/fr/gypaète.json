                        "sense_id": "f1ad0504-3549-3ceb-8510-453aaa5652de",
                        "entry_id": "7863cd2c-5231-3796-8a7d-17b4b11c5b7d",
                        "glosses": [
                            "Grand rapace diurne qui vit en hautes montagnes et se nourrit de charognes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c3b004-c016-447c-a5c7-5d5500d2d10e",
                                "sense_id": "f1ad0504-3549-3ceb-8510-453aaa5652de",
                                "text": "Les gypaètes volaient en traçant d’immenses cercles."
                            },
                            {
                                "example_id": "0178ee54-c020-4fca-a60d-c44bc5b27e65",
                                "sense_id": "f1ad0504-3549-3ceb-8510-453aaa5652de",
                                "text": "Des oiseaux passaient à grand bruit d’ailes, et le moindre d’entre eux, par suite de cette illusion d’optique, paraissait plus grand qu’un condor ou un gypaète."
                            }
                        ]
                    }
                ],
