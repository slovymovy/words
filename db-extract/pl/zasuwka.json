                "translations": [
                    {
                        "translation_id": "3928efc5-81e7-46cd-b1bf-cd2c9da8370d",
                        "source_entry_id": "9b78d262-2e9f-3299-9aca-29de00a6bb90",
                        "source_sense_id": "fcbf811e-266a-3ed9-8bc0-417fed1a3df4",
                        "target_lang_word": "deadlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deadlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d021c688-6583-33dc-b1fc-e6bb8b51eeb6",
                                        "entry_id": "5a1ef12b-a067-39ae-9280-7be723df4066",
                                        "glosses": [
                                            "A standstill resulting from the opposition of two evenly matched forces; a stalemate or impasse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09da409e-4b92-461d-8a07-13fedfbbf4ef",
                                                "sense_id": "d021c688-6583-33dc-b1fc-e6bb8b51eeb6",
                                                "text": "The negotiation ended in deadlock, with neither party willing to compromise on the price."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7cea60a-f459-34f4-8891-ca4e5bf3ca54",
                                        "entry_id": "5a1ef12b-a067-39ae-9280-7be723df4066",
                                        "glosses": [
                                            "An inability to continue due to two programs or devices each requiring a response from the other before completing an operation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fce886a-56e3-40e9-b85e-8063024abea4",
                                                "sense_id": "a7cea60a-f459-34f4-8891-ca4e5bf3ca54",
                                                "text": "If synchronization is always performed in least-first order with respect to object tags, then situations can never arise in which one thread has the synchronization lock for x while waiting for y and another has the lock for y while waiting for x. Instead, they will both obtain the locks in the same order, thus avoiding this form of deadlock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f260094-cdc3-3f4d-960c-8adb9f4c7082",
                                        "entry_id": "5a1ef12b-a067-39ae-9280-7be723df4066",
                                        "glosses": [
                                            "Synonym of deadbolt (“type of lock”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deadlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf8d1cc4-5bcb-3388-9522-f04ff723f015",
                                        "entry_id": "ccd65300-1d5a-35e9-a0d3-a82d4fcfd9e7",
                                        "glosses": [
                                            "To cause or come to a deadlock."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b079828-b187-4ae0-a3f9-4fc689f8d704",
                                                "sense_id": "bf8d1cc4-5bcb-3388-9522-f04ff723f015",
                                                "text": "A suspect was arrested on November 30 and charged with attempted murder. The evidence against him consisted of two jailhouse informers and an eyewitness who picked him out of a lineup after having identified a different man in an initial photo array. A jury ultimately convicted the suspect of assault after deadlocking twice in three days of deliberation."
                                            },
                                            {
                                                "example_id": "48c8cca9-1c46-4347-9b47-5c96d056588e",
                                                "sense_id": "bf8d1cc4-5bcb-3388-9522-f04ff723f015",
                                                "text": "Since we cannot solve this problem completely, it may sometimes be better to use explicit locks and risk deadlock if a thread exits unexpectedly. It may be better to have a deadlocked system than to have a corrupted system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
