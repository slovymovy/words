                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d978dbf3-5f67-44fb-8250-ec57857d3981",
                                "sense_id": "899cd87d-6d93-35bc-b925-3c36ac26bf76",
                                "text": "„Nun wird der Treibstoff eingespritzt, und das überschallschnell durch die Düse jagende Gemisch muß innerhalb einer Tausendstelsekunde verbrennen.“"
                            },
                            {
                                "example_id": "4823dbce-925e-4e70-bbca-d921b2b0fcb6",
                                "sense_id": "899cd87d-6d93-35bc-b925-3c36ac26bf76",
                                "text": "„Nun scheint die Dauer, für die das Licht gestoppt wurde, wenig spektakulär: Gerade einmal für eine Tausendstelsekunde konnten die Wissenschaftler das Wellenpaket anhalten, bevor sie es wieder loslassen mussten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
