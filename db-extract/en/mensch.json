    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f09c10b3-c12e-3593-b5db-29ef7010e118",
                "word": "mensch",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a31d88a1-e771-4e7d-8255-807f9ecbeec5",
                        "entry_id": "f09c10b3-c12e-3593-b5db-29ef7010e118",
                        "tags": [
                            "plural"
                        ],
                        "form": "mensches"
                    },
                    {
                        "form_id": "061eaea0-4d08-49c8-9e2c-76bdaafb5636",
                        "entry_id": "f09c10b3-c12e-3593-b5db-29ef7010e118",
                        "tags": [
                            "plural"
                        ],
                        "form": "menschen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95eabaca-253b-37d2-bcbe-0df9e6ef6fd0",
                        "entry_id": "f09c10b3-c12e-3593-b5db-29ef7010e118",
                        "glosses": [
                            "A person (chiefly male) of strength, integrity, and honor or compassion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dcbbb0f-bf82-428c-b3a8-b058bc1f346c",
                                "sense_id": "95eabaca-253b-37d2-bcbe-0df9e6ef6fd0",
                                "text": "[…]Scott Nearing was a grand old man a real mensch[…]"
                            },
                            {
                                "example_id": "271aa85e-eacd-4c29-b724-e28706437b5f",
                                "sense_id": "95eabaca-253b-37d2-bcbe-0df9e6ef6fd0",
                                "text": "Doctor Dreyfuss [to C. C. Baxter]: Be a mensch!"
                            },
                            {
                                "example_id": "3a6be911-642d-47d3-8b89-5139ee224187",
                                "sense_id": "95eabaca-253b-37d2-bcbe-0df9e6ef6fd0",
                                "text": "Lionel Kessler, relaxing perhaps on a Louis Quinze day bed, garlanded all round with lines of beauty, seeing welcome proof that his clever maligned young friend was a mensch."
                            },
                            {
                                "example_id": "c0ef7c05-9577-478f-ac1b-6e3a3bd3e2a6",
                                "sense_id": "95eabaca-253b-37d2-bcbe-0df9e6ef6fd0",
                                "text": "Where have all the mensches gone? The character of the administration reflects the character of the man at its head."
                            },
                            {
                                "example_id": "a8f1c264-919b-4dcc-8945-c140be678361",
                                "sense_id": "95eabaca-253b-37d2-bcbe-0df9e6ef6fd0",
                                "text": "Olie Kolzig: Goalie for the Washington Capitals who spent most of 16 seasons between the pipes for the team until being released in 2008. Had the longest career of any Capital. Now plays for Tampa Bay. The ultimate mensch, in my book."
                            },
                            {
                                "example_id": "713e9b7b-1ea0-4312-8672-e638a1939e59",
                                "sense_id": "95eabaca-253b-37d2-bcbe-0df9e6ef6fd0",
                                "text": "She was an Amerindian, and stout. She was a real mensch, […] a hard working person, who took pride in her job, which was to spray from an aerosol can a particular base."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dbb1beb-ebce-3aaa-a3a0-5a9997c2c9d8",
                        "entry_id": "f09c10b3-c12e-3593-b5db-29ef7010e118",
                        "glosses": [
                            "A gentleman."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a61cda8d-0483-416b-a1ed-e3a0fee02ef6",
                        "source_entry_id": "f09c10b3-c12e-3593-b5db-29ef7010e118",
                        "source_sense_description": "person of strength, integrity and compassion",
                        "target_lang_word": "homme de bien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme de bien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "439265f5-c380-3701-a3e9-7b8a29dc8ad7",
                                        "entry_id": "b8e854b9-39ba-3dcb-8399-9e2a0cb281cd",
                                        "glosses": [
                                            "Homme d’une véritable vertu, dont la conduite est conforme à la morale."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccdbe869-2450-4b76-becd-45afcd55671a",
                                                "sense_id": "439265f5-c380-3701-a3e9-7b8a29dc8ad7",
                                                "text": "Je ne pense pas que vous aimassiez mieux un homme de bien fort et nerveux, que grêle et flouet."
                                            },
                                            {
                                                "example_id": "992170e1-fcfe-46d2-923d-6c812e7b52a1",
                                                "sense_id": "439265f5-c380-3701-a3e9-7b8a29dc8ad7",
                                                "text": "Quelle marque donne le Saint-Esprit de la justice et de l’innocence d’un homme de bien ? c’est de n'avoir pas reçu favorablement l’opprobre et la médisance contre ses frères."
                                            },
                                            {
                                                "example_id": "a52f9161-eeca-48b3-91d6-8b6fb53d46eb",
                                                "sense_id": "439265f5-c380-3701-a3e9-7b8a29dc8ad7",
                                                "text": "Des chansons et des quolibets populaires, se joignant aux intrigues de la cour, ruinèrent auprès du roi le crédit d’un homme de bien, […] ."
                                            },
                                            {
                                                "example_id": "dd2fdd83-f77f-4485-97fd-a100d6a96dfc",
                                                "sense_id": "439265f5-c380-3701-a3e9-7b8a29dc8ad7",
                                                "text": "Mais ce catéchisme est donné comme le résultat des méditations pénibles et consciencieuses et méritoires des hommes de bien qui fabriquent la Philosophie."
                                            },
                                            {
                                                "example_id": "8a6acde7-4053-4091-be65-6e492316df2c",
                                                "sense_id": "439265f5-c380-3701-a3e9-7b8a29dc8ad7",
                                                "text": "— Dis-nous, homme de bien, ô dis-nous cela ! supplia le propriétaire de la tchaïkhana."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "396e391b-dfb3-4aca-a964-750e12bfdab7",
                        "source_entry_id": "f09c10b3-c12e-3593-b5db-29ef7010e118",
                        "source_sense_description": "person of strength, integrity and compassion",
                        "target_lang_word": "Ehrenmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehrenmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb8bb141-1891-3c13-af11-7eb40ab362b6",
                                        "entry_id": "ffde77da-2088-3cc3-a994-f0953e7c1ced",
                                        "glosses": [
                                            "Mann, den eine ehrenhafte Gesinnung und Handlungsweise auszeichnet und auf dessen Wort man sich verlassen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0724e537-a23d-4958-b499-4dcdafa3cfea",
                                                "sense_id": "bb8bb141-1891-3c13-af11-7eb40ab362b6",
                                                "text": "„In seinen Memoiren beschreibt Markus Wolf, wie er von CIA und BND nach der Wende umworben wurde, aber widerstanden hat. So möchte er gern gesehen werden: Als ein Ehrenmann, der wegen seiner Anständigkeit heute der Strafverfolgung in der Bundesrepublik ausgesetzt ist.“"
                                            },
                                            {
                                                "example_id": "0e3b4301-e2f6-4d1d-bcc6-8f0e6bc3f9c4",
                                                "sense_id": "bb8bb141-1891-3c13-af11-7eb40ab362b6",
                                                "text": "„Ich weiß nicht, ob ich jemals wirklich ein Ehrenmann gewesen bin; aber ich weiß, daß die Empfindungen, die ich in meiner ersten Jugend hegte, viel zarter waren als jene, an die ich mich in meinem weiteren Leben zwangsläufig gewöhnte.“"
                                            },
                                            {
                                                "example_id": "dd2af5fd-9015-45c3-8d78-c97fb6236268",
                                                "sense_id": "bb8bb141-1891-3c13-af11-7eb40ab362b6",
                                                "text": "„Die beiden dänischen Ehrenmänner kümmerten sich nicht um die Zwischenrufe des Junkers, und Ture las weiter, bis es am Schluß hieß, daß dieses Abkommen geheimzuhalten sei, wie es sich für Übereinkünfte zwischen Männern von Stand gezieme, sowohl dessentwillen, auf daß das gemeine Volk oder Landstreicherpack die drei Partner nicht zur Zielscheibe von Spott bekämen, wie auch dessentwillen, auf daß niemand von ihnen durch Leute, die alldies nichts angehe, seinen guten Namen molestiert oder demoralisiert erhielte, und dieses einzige Exemplar des Kontraktes sollte in der Obhut des Schreibers verwahrt bleiben.“"
                                            },
                                            {
                                                "example_id": "e64ef1e5-1e65-4677-88df-ff69da44653d",
                                                "sense_id": "bb8bb141-1891-3c13-af11-7eb40ab362b6",
                                                "text": "„Der Ehrenmann weiß um den Lehrgang seiner Tochter und erteilt Vollmacht zur Bestrafung seiner Frau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
