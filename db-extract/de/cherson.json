                                            {
                                                "example_id": "d41886e5-1a3e-4611-9447-7005306ab2bb",
                                                "sense_id": "59390a72-6167-301b-8478-620dfd0b9987",
                                                "text": "La route quitte le parc, tourne à droite et s'approche de Kherson qu'on peut voir étalée en amphithéâtre sur la rive droite."
                                            },
                                            {
                                                "example_id": "b83ca1fb-5588-438b-a42d-40ab1beafd14",
                                                "sense_id": "59390a72-6167-301b-8478-620dfd0b9987",
                                                "text": "La seule ville d'importance occupée par l'armée russe est pour l'instant Kherson, sur la mer d'Azov."
                                            },
                                            {
                                                "example_id": "fa58e884-d834-48df-8549-0e9d334a9b5b",
                                                "sense_id": "59390a72-6167-301b-8478-620dfd0b9987",
                                                "text": "Les républiques de Donetsk et de Lougansk, reconnues indépendantes par Vladimir Poutine avant le début de la guerre, ainsi que les régions de Kherson et de Zaporijie, sont concernées."
                                            }
                                        ]
