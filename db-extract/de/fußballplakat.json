                "senses": [
                    {
                        "sense_id": "bd117361-a31f-3c03-8da4-44e8ca12699b",
                        "entry_id": "7347871c-abb7-335b-88a5-0d7bca57ec70",
                        "glosses": [
                            "Plakat, mit dem für Fußball geworben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5165a84b-3e89-4ac0-9a67-0e6db9725c12",
                                "sense_id": "bd117361-a31f-3c03-8da4-44e8ca12699b",
                                "text": "„Fußballplakate hängen in den Fenstern billiger Cafés.“"
                            },
                            {
                                "example_id": "f303a528-9e99-4787-b4a5-34bb48df30ef",
                                "sense_id": "bd117361-a31f-3c03-8da4-44e8ca12699b",
                                "text": "„Der Zeichner, Grafiker und Karikaturist verkündete vor Zeiten bereits auf einem Fußballplakat: »Nur Korn bringt uns nach vorn!«“"
                            },
                            {
                                "example_id": "1288965e-2be9-459c-99cf-ba17bc26c529",
                                "sense_id": "bd117361-a31f-3c03-8da4-44e8ca12699b",
                                "text": "„Unter den 80 politischen Postern von Studenten der Offenbacher Hochschule für Gestaltung, die im Refektorium des Frankfurter Karmeliterklosters unter der Überschrift „Ins Auge. Junge politische Plakatkunst“ ausgestellt werden, ist das Fußballplakat eines der auffälligsten und gelungensten.“"
                            },
                            {
                                "example_id": "796f7666-8535-45cd-9fdb-900ab75b8c2d",
                                "sense_id": "bd117361-a31f-3c03-8da4-44e8ca12699b",
                                "text": "„An den Wänden zeigten verschossene Stellen, wo früher einmal Fußballplakate und Bilder gehangen hatten, in Thomas' Etagenbett lagen noch immer zwei aufgerollte Bettdecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
