                "senses": [
                    {
                        "sense_id": "df0cfe6f-68a2-37e6-9e09-6b3d659bdae4",
                        "entry_id": "e91b7e9e-4d5f-3388-a9da-57827add2d06",
                        "glosses": [
                            "positive Einstellung zur Demokratie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15aa85df-1cab-4a25-aa74-40899039f6eb",
                                "sense_id": "df0cfe6f-68a2-37e6-9e09-6b3d659bdae4",
                                "text": "„Die Annahme ist, dass bei der Kosten-Nutzen-Abschätzung der nationalen Akteure und ebenso für die Glaubwürdigkeit der EU auch exogene Faktoren eine Rolle spielen, nämlich zum einen die Demokratiefreundlichkeit (oder nicht) des internationalen Klimas und zum anderen die Ab- bzw. Anwesenheit einer attraktiven, alternativen Option zur EU.“"
                            },
                            {
                                "example_id": "de20bc62-86d6-4b05-a724-bbfd3da452db",
                                "sense_id": "df0cfe6f-68a2-37e6-9e09-6b3d659bdae4",
                                "text": "„Der Blick von den amerikanischen zurück auf die deutschen Lutheraner lehrt, daß die Demokratiefreundlichkeit des Luthertums nicht polar beschrieben werden kann, sondern unterschiedliche Grade umfaßt […].“"
                            },
                            {
                                "example_id": "51f774f7-f2fb-444d-9966-ac7a949249fa",
                                "sense_id": "df0cfe6f-68a2-37e6-9e09-6b3d659bdae4",
                                "text": "„Aus der schlichten Anzahl der Abstimmungslokale läßt sich nicht zwangsläufig die Demokratiefreundlichkeit eines Verfahrens ableiten, wohl aber aus der daraus zu errechnenden Anzahl der Stimmberechtigten je Stimmbezirk.“"
                            },
                            {
                                "example_id": "e0e6cca9-57fc-4751-a5bf-2f20e7782bd2",
                                "sense_id": "df0cfe6f-68a2-37e6-9e09-6b3d659bdae4",
                                "text": "„Wenn man auf die Zeiten vor und kurz nach dem Zerfall der UdSSR zurückblickt, erinnert man sich an die Demokratiefreundlichkeit der damaligen russischen Gesellschaft, vor allem, was die Ansichten der intellektuellen und kreativen Eliten, also der Multiplikatoren betraf.“"
                            },
                            {
                                "example_id": "fd57ca7c-d46c-4e32-988f-e810ce5b680c",
                                "sense_id": "df0cfe6f-68a2-37e6-9e09-6b3d659bdae4",
                                "text": "„Ein hohes Maß an Optimismus hinsichtlich der Demokratiefreundlichkeit des asiatischen Völkerrechts ist sicherlich unangebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
