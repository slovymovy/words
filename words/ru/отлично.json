                                "target_lang_sense_clarification": "enthusiastic approval"
                            },
                            {
                                "target_lang_word": "excellent",
                                "target_lang_sense_clarification": "strong approval"
                            },
                            {
                                "target_lang_word": "very good",
                                "target_lang_sense_clarification": "formal agreement or praise"
                            },
                            {
                                "target_lang_word": "perfect",
                                "target_lang_sense_clarification": "complete agreement"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "太好了",
                                "target_lang_sense_clarification": "表示热情的赞同"
                            },
                            {
                                "target_lang_word": "好极了",
                                "target_lang_sense_clarification": "表示强烈的赞同"
                            },
                            {
                                "target_lang_word": "没问题",
                                "target_lang_sense_clarification": "表示同意"
                            }
                        ]
