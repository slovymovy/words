        "fr-extract.jsonl": [
            {
                "entry_id": "9d7e551b-f5fd-37dc-951d-baaab4b36228",
                "word": "complies",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b8fe1b2-f545-3d7f-894b-dd1fef630340",
                        "entry_id": "9d7e551b-f5fd-37dc-951d-baaab4b36228",
                        "glosses": [
                            "Office du soir, qui est le dernier office de la journée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd8e3f3b-8567-4751-b756-5fc1d54400b8",
                                "sense_id": "4b8fe1b2-f545-3d7f-894b-dd1fef630340",
                                "text": "Je remplis mes devoirs de chapelain loyalement et sincèrement : deux messes par jour, une le matin, l’autre le soir, primes, complies, vêpres avec Credo et Pater."
                            },
                            {
                                "example_id": "7bcd12a8-5d85-4fbd-8293-e5459adb4ffd",
                                "sense_id": "4b8fe1b2-f545-3d7f-894b-dd1fef630340",
                                "text": "5 1/2 Examen et oraison. 6 Souper et récréation. 7 Litanies, grand silence. 7 1/4 Assister à Complies. 7 1/2 Chant de Salve Regina, Angelus."
                            },
                            {
                                "example_id": "30c33ec5-d953-453f-b8c2-79e22c82b010",
                                "sense_id": "4b8fe1b2-f545-3d7f-894b-dd1fef630340",
                                "text": "Après complies, André et moi retrouvons le sous-prieur qui nous mène à sa cellule, laquelle est grande, bien éclairée, pleine de livres."
                            },
                            {
                                "example_id": "c1740aa5-9c36-45dd-be63-c81f45a8d4fe",
                                "sense_id": "4b8fe1b2-f545-3d7f-894b-dd1fef630340",
                                "text": "Les sœurs avouent leurs fautes après avoir baisé le parquet.\n— Ma révérente mère, ma mère, mes sœurs, je m'accuse humblement d'être arrivée en retard aux complies."
                            },
                            {
                                "example_id": "a2b6cf3f-5018-4b25-844c-3db800a978de",
                                "sense_id": "4b8fe1b2-f545-3d7f-894b-dd1fef630340",
                                "text": "Avant de la laisser seule, le moine lui indiqua la liturgie des heures, matines, laudes, tierce, sexte, none, vêpres, complies et vigiles, et devant son air concentré et perdu, il lui dit que chaque horaire était noté sur une feuille posée sur le bureau..."
                            }
                        ]
                    }
                ],
