                        "sense_id": "abd80195-c8a8-37f2-bc5f-532b802bdf12",
                        "entry_id": "f5735480-3857-3bb3-a876-312eeec1a484",
                        "glosses": [
                            "Deuxième éon de l’échelle des temps géologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab5cd191-78f3-4f6a-93d1-512583e3a6f9",
                                "sense_id": "abd80195-c8a8-37f2-bc5f-532b802bdf12",
                                "text": "L’Archéen commence avec l’apparition certaine de la vie sur Terre."
                            }
                        ]
