                ],
                "senses": [
                    {
                        "sense_id": "450c01be-6dca-3f93-b5b5-c3095cded41e",
                        "entry_id": "6424e18e-963a-37af-a06c-68397f6361b5",
                        "glosses": [
                            "Spielzeug in Form eines Tieres aus weichem, plüschigem Material"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d3251a-350b-499d-bb2e-30b2b3896107",
                                "sense_id": "450c01be-6dca-3f93-b5b5-c3095cded41e",
                                "text": "„Ich entdecke fünf oder sechs Kindergräber von Neugeborenen, mit knöchelhohen Holzgittern und einem schlichten weißen Kreuz, auf den Plastikblumen ein Plüschtier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65647a06-6c45-45dc-8a8e-855f3e1a9757",
                        "source_entry_id": "6424e18e-963a-37af-a06c-68397f6361b5",
                        "source_sense_id": "450c01be-6dca-3f93-b5b5-c3095cded41e",
                        "source_sense_description": "Spielzeug in Form eines Tieres aus weichem, plüschigem Material",
                        "target_lang_word": "stuffed animal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stuffed animal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e246dd-932b-36dd-a92f-9e82522c0fb6",
                                        "entry_id": "96d8b53f-382c-36e8-8060-0d03c7e7290d",
                                        "glosses": [
                                            "A soft toy in the form of an animal."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9343c572-f026-3ca0-b915-0d8a71a8a8de",
                                        "entry_id": "96d8b53f-382c-36e8-8060-0d03c7e7290d",
                                        "glosses": [
                                            "An animal that has undergone taxidermy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "645cefae-acb7-4282-9a80-783abc5f5c3a",
                                                "sense_id": "9343c572-f026-3ca0-b915-0d8a71a8a8de",
                                                "text": "Apparently this section had been devoted to natural history, but everything had long since passed out of recognition. A few shrivelled and blackened vestiges of what had once been stuffed animals, desiccated mummies in jars that had once held spirit, a brown dust of departed plants: that was all!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f6c9399-b72b-491b-a3f8-cd6ab52fe871",
                        "source_entry_id": "6424e18e-963a-37af-a06c-68397f6361b5",
                        "source_sense_id": "450c01be-6dca-3f93-b5b5-c3095cded41e",
                        "source_sense_description": "Spielzeug in Form eines Tieres aus weichem, plüschigem Material",
                        "target_lang_word": "animal en peluche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bb554bad-d1cd-455c-af21-99dbc5cf994e",
                        "source_entry_id": "6424e18e-963a-37af-a06c-68397f6361b5",
                        "source_sense_id": "450c01be-6dca-3f93-b5b5-c3095cded41e",
                        "source_sense_description": "Spielzeug in Form eines Tieres aus weichem, plüschigem Material",
                        "target_lang_word": "peluche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peluche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3084676-502a-3379-afa2-22ab19c4645b",
                                        "entry_id": "66217232-cebc-32dd-9e2a-e5235a8c5c0e",
                                        "glosses": [
                                            "Étoffe de laine, de soie, de fil, analogue au velours, mais dont le poil est long, couché et brillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fefeea6-a7d6-40ca-8410-acc0fcda27d8",
                                                "sense_id": "c3084676-502a-3379-afa2-22ab19c4645b",
                                                "text": "Lorsqu’elle monta dans sa chambre, son mari, sur le palier, la guettait, en robe de chambre de peluche mordorée, une espèce de bonnet de doge encadrant son visage pâle et creux."
                                            },
                                            {
                                                "example_id": "396a32c0-760a-42fa-a528-c188b8373bbd",
                                                "sense_id": "c3084676-502a-3379-afa2-22ab19c4645b",
                                                "text": "Les fils de mohair seuls ou mélangés […], servent à la production d’étoffes très jolies […]; mais c’est surtout dans les tissus zibelinés et satinés, dans la peluche, le velours d’Utrecht, l’astrakan, l’alpaga, les articles moirés, que se révèlent les qualités de brillant et de soyeux de cette fibre textile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a7117b-cb48-3d97-b13d-3e9813da3cef",
                                        "entry_id": "66217232-cebc-32dd-9e2a-e5235a8c5c0e",
                                        "glosses": [
                                            "Poupée ou jouet recouvert de ce type de fibres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09627273-4829-459a-860c-a1a6a91137af",
                                                "sense_id": "46a7117b-cb48-3d97-b13d-3e9813da3cef",
                                                "text": "Puis débarquèrent les Tortues Ninja en de multiples exemplaires, ainsi que des poupées de toutes sortes et des peluches… des peluches à n'en plus finir, depuis le Snoopy miniature jusqu'au Roi Lion grand modèle."
                                            },
                                            {
                                                "example_id": "6ec4e4e3-248b-4fb7-a45b-d22bb8ecda6f",
                                                "sense_id": "46a7117b-cb48-3d97-b13d-3e9813da3cef",
                                                "text": "Et juste à côté, une peluche chez Schwartz, n’importe laquelle."
                                            },
                                            {
                                                "example_id": "bb5d2c0e-c3dc-40b2-b215-e9508f55987c",
                                                "sense_id": "46a7117b-cb48-3d97-b13d-3e9813da3cef",
                                                "text": "L’élan des grands manèges soulevant le cœur et faisant crier d’effroi les adolescentes dans la nuit bleue ne s'écarte qu’en apparence des loteries pauvrettes et des tirettes aux peluches à deux sous."
                                            },
                                            {
                                                "example_id": "f96f6bec-cf63-4f45-ad24-1a1e40b10735",
                                                "sense_id": "46a7117b-cb48-3d97-b13d-3e9813da3cef",
                                                "text": "Le comité d’organisation a précisé que, finalement, seulement 8 % des peluches en forme de bonnets phrygiens devraient être fabriquées en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bfab1f8-079b-304a-be40-a0d61085f3f4",
                                        "entry_id": "66217232-cebc-32dd-9e2a-e5235a8c5c0e",
                                        "glosses": [
                                            "Fibres textiles arrachées à un tissu par usure ou par frottement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25189265-9b57-467e-8005-14a6ea74fb24",
                                                "sense_id": "0bfab1f8-079b-304a-be40-a0d61085f3f4",
                                                "text": "Ce pull est plein de peluches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3b5dd56-5f94-3fa5-8c3a-3e7f15220e8e",
                                        "entry_id": "66217232-cebc-32dd-9e2a-e5235a8c5c0e",
                                        "glosses": [
                                            "Sobriquet que l’on peut attribuer à un être aimé."
                                        ],
