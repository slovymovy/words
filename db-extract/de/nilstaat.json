                "senses": [
                    {
                        "sense_id": "b6cee2ab-5910-35e1-9352-9327c47a69cc",
                        "entry_id": "8bf42251-b5c4-32f7-89fa-e95d8e53912a",
                        "glosses": [
                            "einer der Staaten, durch den der Nil fließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55dedf70-5024-44b1-b301-31fbf53f203e",
                                "sense_id": "b6cee2ab-5910-35e1-9352-9327c47a69cc",
                                "text": "„Wenn sie gemeinsam den Nil bewirtschaften und die Profite daraus teilen, könnten die Nilstaaten ihre ökonomischen und demografischen Probleme vielleicht in den Griff bekommen.“"
                            },
                            {
                                "example_id": "d238336d-002d-4952-ab35-f7c8029de23f",
                                "sense_id": "b6cee2ab-5910-35e1-9352-9327c47a69cc",
                                "text": "„Ramses III. ist der letzte bedeutende ägyptische Pharao des Neuen Reiches, der den Nilstaat gegen die Seevölker und Libyer verteidigen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
