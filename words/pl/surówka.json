{
    "word_family": [
        "surowy",
        "surowiec",
        "surowość"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee760373-365e-306a-98e0-fa8533bb8a10",
                    "sense_definition": "potrawa ze świeżych, surowych warzyw lub owoców, podawana zazwyczaj jako dodatek do obiadu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kulinaria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do niedzielnego obiadu podano kotlety, ziemniaki oraz pyszną <w>surówkę</w> z marchewki.",
                            "target_lang_translations": {
                                "ru": "К воскресному обеду подали котлеты, картофель и вкусный морковный <w>салат</w>."
                            }
                        },
                        {
                            "text": "Świeża <w>surówka</w> z kiszonej kapusty doskonale pasuje do smażonej ryby.",
                            "target_lang_translations": {
                                "ru": "Свежий <w>салат</w> из квашеной капусты отлично подходит к жареной рыбе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surówka z kapusty",
                        "surówka z marchewki"
                    ],
                    "target_lang_definitions": {
                        "ru": "салат из сырых овощей или фруктов, обычно подаваемый как гарнир к основному блюду"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "салат",
                                "target_lang_sense_clarification": "из сырых овощей"
                            },
                            {
                                "target_lang_word": "салат из свежих овощей",
                                "target_lang_sense_clarification": "гарнир к обеду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e85ee0-cef5-359b-a80f-066f9dd33485",
                    "sense_definition": "stop żelaza z dużą zawartością węgla, otrzymywany w wielkim piecu i przetwarzany na stal lub żeliwo",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hutnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W hucie wytapia się płynną <w>surówkę</w>, która potem trafia do konwertora tlenowego.",
                            "target_lang_translations": {
                                "ru": "На металлургическом заводе выплавляют жидкий <w>чугун</w>, который затем поступает в кислородный конвертер."
                            }
                        },
                        {
                            "text": "Płynna <w>surówka</w> żelaza jest głównym półproduktem w procesie produkcji nowoczesnej stali.",
                            "target_lang_translations": {
                                "ru": "Жидкий <w>передельный чугун</w> является основным полуфабрикатом в процессе производства современной стали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surówka hutnicza"
                    ],
                    "target_lang_definitions": {
                        "ru": "железный сплав с высоким содержанием углерода, получаемый в доменной печи и используемый для переплавки в сталь или чугун"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чугун",
                                "target_lang_sense_clarification": "доменный / передельный чугун"
                            },
                            {
                                "target_lang_word": "передельный чугун",
                                "target_lang_sense_clarification": "металлургический полуфабрикат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b04e0bc-6482-3baa-878d-4eb23335004f",
                    "sense_definition": "niebielona tkanina lniana lub bawełniana, pozbawiona wykończenia chemicznego",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "włókiennictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Artysta naciągnął na drewniane krosna grubą <w>surówkę</w> i zaczął nanosić podkład malarski.",
                            "target_lang_translations": {
                                "ru": "Художник натянул на деревянный подрамник плотное <w>суровое полотно</w> и начал наносить грунт."
                            }
                        },
                        {
                            "text": "Torbę na zakupy uszyto z naturalnej, mocnej <w>surówki</w> bawełnianej.",
                            "target_lang_translations": {
                                "ru": "Сумка для покупок сшита из натурального, прочного хлопчатобумажного <w>суровья</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "неотбеленная и необработанная льняная или хлопчатобумажная ткань"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суровьё",
                                "target_lang_sense_clarification": "неотбеленная ткань"
                            },
                            {
                                "target_lang_word": "суровое полотно",
                                "target_lang_sense_clarification": "грубая необработанная ткань"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22a34c6f-7b55-3b54-93d6-85b01e033e5e",
                    "sense_definition": "nieoczyszczony spirytus otrzymywany bezpośrednio po pierwszej destylacji zacieru",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gorzelnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gorzelnia wysyłała wyprodukowaną <w>surówkę</w> do zakładu rektyfikacji w celu jej oczyszczenia.",
                            "target_lang_translations": {
                                "ru": "Винокурня отправляла произведённый <w>спирт-сырец</w> на ректификационный завод для его очистки."
                            }
                        },
                        {
                            "text": "Taka <w>surówka</w> zawiera jeszcze wiele niepożądanych związków chemicznych i zapachów.",
                            "target_lang_translations": {
                                "ru": "Такой <w>спирт-сырец</w> содержит ещё много нежелательных химических соединений и запахов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "неочищенный спирт первой перегонки, спирт-сырец"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спирт-сырец",
                                "target_lang_sense_clarification": "неочищенный спирт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b371c250-bde9-3e52-8c24-0718d21ad459",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Surówka</w> został powołany na stanowisko dyrektora nowego oddziału firmy.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Сурувка</w> был назначен на должность директора нового филиала компании."
                            }
                        },
                        {
                            "text": "Wczoraj rozmawiałem z profesorem <w>Surówką</w> o wynikach moich ostatnich badań.",
                            "target_lang_translations": {
                                "ru": "Вчера я беседовал с профессором <w>Сурувкой</w> о результатах моих недавних исследований."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сурувка",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1307565-cf52-3d46-bfad-262ec69125e8",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Surówka</w> odebrała prestiżową nagrodę za wybitne osiągnięcia w dziedzinie medycyny.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Сурувка</w> получила престижную премию за выдающиеся достижения в области медицины."
                            }
                        },
                        {
                            "text": "Spotkałem wczoraj Annę <w>Surówkę</w>, która prowadzi własną kancelarię prawną.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил Анну <w>Сурувку</w>, которая руководит собственной юридической конторой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сурувка",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}