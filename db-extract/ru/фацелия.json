                        "cross_references": []
                    },
                    {
                        "translation_id": "76eb8cad-4bf7-4d58-b7f8-2d31ecad3af4",
                        "source_entry_id": "00bcf3b8-fb47-30cd-98d0-cf17582a6b21",
                        "source_sense_id": "4c384b57-2aa1-3ad3-b072-c746d7aebfa1",
                        "target_lang_word": "Bienenweide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bienenweide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                        "entry_id": "54253edd-0c76-3d7b-85e1-6eee04e9ea89",
                                        "glosses": [
                                            "von honigproduzierenden Insekten geschätzte Pflanzen(gesellschaft)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af4c852-9a1e-468e-abb2-f07d9952a326",
                                                "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                                "text": "„Säen Sie eine Bienenweide!“"
                                            },
                                            {
                                                "example_id": "8ab8ad2c-2bc3-407f-9c5d-a3ec872f8df1",
                                                "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                                "text": "„Seine vielen blauen und stark duftenden Blüten sind eine gute Bienenweide.“"
                                            },
                                            {
                                                "example_id": "0ef89f4a-c3bd-4ec2-9a18-ec751568f315",
                                                "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                                "text": "„Nach Ansicht der Berufungsbehörde ist … die Schaffung einer Bienenweide kein derartig höherwertiger Verwendungszweck, der den Entzug des Waldes aus dem landwirtschaftlichen Betrieb rechtfertigen würde.“"
                                            },
                                            {
                                                "example_id": "98706e20-e416-47b5-82a3-6e981efb9b09",
                                                "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                                "text": "„Berücksichtigt man alle anfallenden Arbeiten, ergibt sich für die Bodenvorbereitung, Ansaat und Pflege der Veitshöchheimer Bienenweide bei 5 Jahren Standzeit in etwa folgender Finanzierungsbedarf: …“"
                                            },
                                            {
                                                "example_id": "9a926165-140c-4498-9953-a1d4807dd553",
                                                "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                                "text": "„Die Anlagen waren nicht nur für die Vogelwelt von Nutzen, sie dienten vor allem der Bienenweide.“"
                                            },
                                            {
                                                "example_id": "54cdd5a4-adec-48d9-93fd-be481df21b7b",
                                                "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                                "text": "„Die Eibe kann als Gartenbaum entweder Vögel ernähren oder aber als Bienenweide dienen. Der Grund dafür liegt an ihrer sogenannten Zweihäusigkeit.“"
                                            },
                                            {
                                                "example_id": "fd959f48-5b17-43bd-80d1-c99c2b2d1c91",
                                                "sense_id": "b8ab1666-fe84-313f-aab6-1b2e4270dd31",
                                                "text": "„[…] die gelben Blüten [des Jakobskreuzkraut] sind eine beliebte Bienenweide, aber ihr Nektar ist [für Menschen] hochgiftig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
