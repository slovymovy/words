                "senses": [
                    {
                        "sense_id": "ccc4f2e9-0cea-3c06-8828-db4a7924b6b7",
                        "entry_id": "d562e1f6-52d0-33ea-80a4-1e51e848c110",
                        "glosses": [
                            "heel erg behorend tot de werkelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c96bcbf-1b99-42bd-899d-b3e99a8f2a37",
                                "sense_id": "ccc4f2e9-0cea-3c06-8828-db4a7924b6b7",
                                "text": "Vandaag keek hij vanzelfsprekend niet meer zo tegen de dingen aan. Hij wist dat de oorlog niets anders was dan een reusachtige loterij met levensechte kogels, waarin vier jaar overleven aan het wonderbaarlijke grensde."
                            }
                        ]
                    },
                    {
                        "sense_id": "a26ef62d-496f-33ca-84f7-b85701ddb0c9",
                        "entry_id": "d562e1f6-52d0-33ea-80a4-1e51e848c110",
                        "glosses": [
                            "fictief, maar de indruk wekkend uit de realiteit te stammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c433b4e-629e-44ef-9387-30c4e3f36522",
                                "sense_id": "a26ef62d-496f-33ca-84f7-b85701ddb0c9",
                                "text": "In zijn tweede boek zijn de personages een stuk levensechter geworden."
                            }
                        ]
                    }
