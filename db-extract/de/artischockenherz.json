                "senses": [
                    {
                        "sense_id": "dda1cdd4-1ca0-3c38-930e-e5b689443c94",
                        "entry_id": "dd2d1b55-ab72-3630-805c-be0674d99d98",
                        "glosses": [
                            "als Lebensmittel verwendeter unterer Teil der Artischocke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac4f90b6-a4d7-4a3a-9f04-80e77372e7d0",
                                "sense_id": "dda1cdd4-1ca0-3c38-930e-e5b689443c94",
                                "text": "„In der Küche sind Tyler, Albert, Len und Jerry, sie spülen und stapeln die Teller, und ein Koch, Leslie, haut Knoblauchbutter auf die mit Shrimps und Schnecken gefüllten Artischockenherzen.“"
                            },
                            {
                                "example_id": "d879dead-fc61-4604-b4aa-850d6a602214",
                                "sense_id": "dda1cdd4-1ca0-3c38-930e-e5b689443c94",
                                "text": "„Mit ihrer Gabel vergewaltigte sie die grünen Blätter ihres Salates auf der Suche nach einem Artischockenherz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
