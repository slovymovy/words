                        "entry_id": "7d7c778a-75a5-33e7-a6f0-95c01d0b31ad",
                        "glosses": [
                            "Supprimer les doublons dans (des listes, des fichiers, en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b172359-52b2-49ef-8956-233cf5aef948",
                                "sense_id": "6c0dc7a9-99e4-33e5-8b33-27707c8fbed1",
                                "text": "Avant toute chose, les termes de la liste doivent être uniques, il faut donc la dédupliquer, autrement dit supprimer les doublons de la liste élaborée."
                            },
                            {
                                "example_id": "5eba017a-a150-41fb-b890-e4c7c768fc81",
                                "sense_id": "6c0dc7a9-99e4-33e5-8b33-27707c8fbed1",
                                "text": "Il permet de dédupliquer les données dans les trajectoires stockées le long du dernier axe des observations."
                            }
                        ]
                    }
