    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8cb94841-18e6-3162-989b-bbaba0ec1f95",
                "word": "unslept",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "233f22ae-b94a-3c7b-bae7-15aea2bf5737",
                        "entry_id": "8cb94841-18e6-3162-989b-bbaba0ec1f95",
                        "glosses": [
                            "Not having been slept."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7e71b835-0800-456f-b240-feacf449b2a6",
                                "sense_id": "233f22ae-b94a-3c7b-bae7-15aea2bf5737",
                                "text": "As you stagger in, your eyes struggling to focus, your throat claggy with sleep unslept, you might expect it to be more or less deserted, save for the odd bomb-disposal squad blowing up someone's lost suitcase."
                            },
                            {
                                "example_id": "0d02c8f6-0464-466b-8601-34b00268804b",
                                "sense_id": "233f22ae-b94a-3c7b-bae7-15aea2bf5737",
                                "text": "And in the midst of the mirror-like stillness through which it was impossible to see the great machineries grinding, my mother, the brand-new Amina Sinai, who also looked still and unchanging although great things were happening beneath her skin, woke up one morning with a head buzzing with insomnia and a tongue thickly coated with unslept sleep and found herself saying aloud, without meaning to at all, \"What's the sun doing here, Allah? It's come up in the wrong place.'"
                            },
                            {
                                "example_id": "63c73803-ea99-4b88-bcde-41732c0cb725",
                                "sense_id": "233f22ae-b94a-3c7b-bae7-15aea2bf5737",
                                "text": "My eyes burn from sleep unslept and from tears unshed. I long for oblivion. I am impossibly tired."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0b850ec-1faa-362d-8368-b1dcb1a73103",
                        "entry_id": "8cb94841-18e6-3162-989b-bbaba0ec1f95",
                        "glosses": [
                            "Not having been slept (in, on, with, etc.); usually with a preposition."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5713943e-e017-4f87-8ef5-8197aa8c6cdf",
                                "sense_id": "b0b850ec-1faa-362d-8368-b1dcb1a73103",
                                "text": "The high-tension wires were lightning held forever, blazing, a threat above the unslept houses."
                            },
                            {
                                "example_id": "1b2dac5b-b023-4948-a644-e1bd741f7b45",
                                "sense_id": "b0b850ec-1faa-362d-8368-b1dcb1a73103",
                                "text": "Tom's room was empty, the bed unslept in."
                            },
                            {
                                "example_id": "7cae0043-d41a-4752-8120-b63e1fcd7b0a",
                                "sense_id": "b0b850ec-1faa-362d-8368-b1dcb1a73103",
                                "text": "For a whole lifetime With no guaranties And promises not kept How ever hard you try to please All the nights unslept"
                            },
                            {
                                "example_id": "e0671793-9b16-4d4c-9604-f422414679d5",
                                "sense_id": "b0b850ec-1faa-362d-8368-b1dcb1a73103",
                                "text": "Awakened to the lighted room by the rining telephone beside her bed, she reached across the vacant unslept pillow and glanced automatically at the clock—the book she'd been reading slid sideways off the coverlet in a spill of pages onto the floor."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ae5f819-f809-3340-a7a8-c1bc7ce49519",
                        "entry_id": "8cb94841-18e6-3162-989b-bbaba0ec1f95",
                        "glosses": [
                            "Not having slept; sleep-deprived."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b785f102-057f-40c6-8ea2-3ee713e170ee",
                                "sense_id": "2ae5f819-f809-3340-a7a8-c1bc7ce49519",
                                "text": "Dawn of a new day, me unslept from the old, a refugee from the night."
                            },
                            {
                                "example_id": "aeb94758-44df-4928-a952-5a38bf4339b0",
                                "sense_id": "2ae5f819-f809-3340-a7a8-c1bc7ce49519",
                                "text": "Hollow-eyed, unslept and unshaven, I was by no means my usual neatly groomed self when the following day Virgilio, my friend in the carabinieri, arranged for a helicopter to fly me over the scene."
                            },
                            {
                                "example_id": "6fcafd6d-7429-4a9d-8b15-57a6a3c833ce",
                                "sense_id": "2ae5f819-f809-3340-a7a8-c1bc7ce49519",
                                "text": "In recent years, Mathieu has risen to prominence in ASO. He is the unshaven, unslept, pastis-guzzling chain-smoking doyen of the press."
                            },
                            {
                                "example_id": "97056442-cc0b-43a0-aa76-ca3e942576bc",
                                "sense_id": "2ae5f819-f809-3340-a7a8-c1bc7ce49519",
                                "text": "He received his room key from the owner, a shambling, unslept oaf named Ali, and as he passed he offered the young Japanese a rough acknowledgement the way the young men do —\"Auss\" — on the way to his double room with its two single beds and ants all over the floor."
                            }
                        ]
                    }
