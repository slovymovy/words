                    {
                        "translation_id": "7191555c-c847-4cfa-951a-641e3c8e2ff4",
                        "source_entry_id": "3197e525-e8fe-38f8-8c13-8fa26a94e090",
                        "target_lang_word": "sarriette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarriette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "520d0d32-d699-3053-989b-dac292159d79",
                                        "entry_id": "a4af5ca6-9c9c-34ef-86ce-0d944b600dc0",
                                        "glosses": [
                                            "Plante vivace aromatique de la famille des Lamiacées, que l’on trouve sur les bords des chemins méditerranéens et qui s’emploie en cuisine comme assaisonnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f11a14bc-1bcb-4a56-9d3c-c067aa8b0bbb",
                                                "sense_id": "520d0d32-d699-3053-989b-dac292159d79",
                                                "text": "On cultive surtout la sarriette d'hiver et la sarriette des jardins, la plus parfumée des deux."
                                            },
                                            {
                                                "example_id": "9c00a97a-1a99-4d7f-81aa-73e6e7413433",
                                                "sense_id": "520d0d32-d699-3053-989b-dac292159d79",
                                                "text": "Puis elle retira de la casserole les boudins blancs qu’elle venait de pocher et qui sentaient la sarriette."
                                            },
                                            {
                                                "example_id": "8e2613e9-bd2c-47f0-8c0c-32b8483d722e",
                                                "sense_id": "520d0d32-d699-3053-989b-dac292159d79",
                                                "text": "Promenant l’un d’eux par la main, il pointait sa canne sur une plante, annonçait simplement « Sarriette » et retombait dans son mutisme rêveur. Par cet emploi de naturaliste, cette transmission de savoir, il lui semblait remplir son rôle d’éducateur."
                                            },
                                            {
                                                "example_id": "e43e9549-a1f3-4604-8370-ffc38a9ff34b",
                                                "sense_id": "520d0d32-d699-3053-989b-dac292159d79",
                                                "text": "La sarriette sauvage résiste aux grands froids, mais il vaut mieux couvrir la plante en cas de froid excessif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
