        "fr-extract.jsonl": [
            {
                "entry_id": "160e621d-85c8-3ae7-9d16-65fad9dbf376",
                "word": "Châteauroux",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70011d48-0079-339c-83e4-41cdfb3d992e",
                        "entry_id": "160e621d-85c8-3ae7-9d16-65fad9dbf376",
                        "glosses": [
                            "Chef-lieu de département situé dans le département de l’Indre, en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f1d419-3595-4367-9441-9a4c7ac862d8",
                                "sense_id": "70011d48-0079-339c-83e4-41cdfb3d992e",
                                "text": "Le bassin entier de la Brenne, à l'ouest de la route de Châteauroux à Lothiers, est notablement plus bas que les plateaux correspondants des bords de l'Indre ou de la Creuse."
                            },
                            {
                                "example_id": "868f6841-a425-4989-9c78-fe7830c2a9bb",
                                "sense_id": "70011d48-0079-339c-83e4-41cdfb3d992e",
                                "text": "Arrivés enfin comme des épaves à Châteauroux, après maints circuits, détours et contre-détours pouvant équivaloir à une notable partie de la distance qui nous sépare de la lune, il avait paru nécessaire à quelques personnages éminentissimes et superfins d’empiler ce calamiteux bétail dans des trains cataleptiques dont la lenteur eût exaspéré le cocher des morts."
                            },
                            {
                                "example_id": "6a389f1c-b0b9-4148-a6ea-8e883fe04c3c",
                                "sense_id": "70011d48-0079-339c-83e4-41cdfb3d992e",
                                "text": "– Oui… un nom… comme château…\n– Châteaubriant ?… Château-Thierry ?\n– Non… non…\n– Châteauroux ?\n– C’est ça… Châteauroux…"
                            },
                            {
                                "example_id": "7f0b7897-155d-433d-8159-d4c04d5b021e",
                                "sense_id": "70011d48-0079-339c-83e4-41cdfb3d992e",
                                "text": "De mémoire de Montgivrains, puisque c'est ainsi que l'on appelle les 1714 habitants de Montgivray, on n'avait jamais connu pareille folie thermométrique : il a fait 42,3°C, samedi après-midi, dans cette commune de l'Indre, située entre La Châtre et Châteauroux."
                            },
                            {
                                "example_id": "921bbe05-c546-4d68-aa1f-7bb95783ddd0",
                                "sense_id": "70011d48-0079-339c-83e4-41cdfb3d992e",
                                "text": "Nous nous arrêtâmes dans une brasserie en face d’un aérodrome désaffecté, à la sortie de Châteauroux."
                            }
                        ]
                    },
                    {
                        "sense_id": "68084034-8ec4-3276-b8d6-3eeba8761b6a",
                        "entry_id": "160e621d-85c8-3ae7-9d16-65fad9dbf376",
                        "glosses": [
                            "Ancien nom de Châteauroux-les-Alpes."
