                                        "entry_id": "53f31832-d954-3dcd-9a47-a53ac4280e74",
                                        "glosses": [
                                            "Any of various species of buttercup, or the marsh marigold, Caltha palustris."
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24be40f8-f2df-4c90-9978-6b2fc40ae7c5",
                                                "sense_id": "95e998a2-d711-390d-acc7-3edc4eacb415",
                                                "text": "He told me how the wise toad who squats among the kingcups by the stream in summer has a very precious jewel in his head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d803369-0fa7-4b08-94da-56ba49bbf891",
                        "source_entry_id": "e8dcac06-2862-3bee-b487-45c86768ca3b",
