                            },
                            {
                                "target_lang_word": "get around",
                                "target_lang_sense_clarification": "to travel or move from place to place"
                            },
                            {
                                "target_lang_word": "travel",
                                "target_lang_sense_clarification": "to go from one place to another"
                            }
                        ]
                    }
                },
