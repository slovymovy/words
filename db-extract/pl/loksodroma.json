                                "target_senses": [
                                    {
                                        "sense_id": "9acf5b54-6153-3413-b703-fb51aee1eceb",
                                        "entry_id": "8d0e0a53-93b7-3c3e-bdb1-6af025dccd7e",
                                        "glosses": [
                                            "A line on a surface (such as the Earth) that cuts all meridians at a constant angle (but not a right angle) – on Earth, the path followed by a ship or aircraft that maintains a constant course by the compass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbd77e3a-031a-467d-9f49-6000387abd14",
                        "source_entry_id": "7caa14c5-a836-3805-b4c6-66ba7acaad90",
                        "source_sense_id": "6a9be034-7cbb-377e-b72b-4168dd0ef90c",
                        "target_lang_word": "rhumb line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhumb line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc43bfef-0134-34ac-ab0d-33240c5193b3",
                                        "entry_id": "dc1a7cdd-84f8-36aa-84b9-9434edef084d",
                                        "glosses": [
                                            "A line that cuts all meridians at the same angle, the path of a vessel that maintains a constant compass direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c43350c-8e43-4584-8cbf-3567bda2c74b",
                                                "sense_id": "cc43bfef-0134-34ac-ab0d-33240c5193b3",
                                                "text": "On portolan maps rhumb lines were all the go long before Mercator's time. […] It's a different matter putting a straight rhumb line on a map made for a round world. And on a map made for the whole world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0c74697-bb92-45f3-90c1-b3fdc09330eb",
                        "source_entry_id": "7caa14c5-a836-3805-b4c6-66ba7acaad90",
                        "source_sense_id": "6a9be034-7cbb-377e-b72b-4168dd0ef90c",
                        "target_lang_word": "loxodromie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loxodromie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff7dce73-9946-3b99-8d23-d5d8d35c4a73",
                                        "entry_id": "1f7c4c65-47e0-30dc-9242-4558583ba3c1",
                                        "glosses": [
                                            "Courbe tracée sur la surface d'une sphère, qui coupe tous les méridiens sous le même angle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c28e58f-2a6f-450c-8c98-df744c6c0c24",
                                                "sense_id": "ff7dce73-9946-3b99-8d23-d5d8d35c4a73",
                                                "text": "Une loxodromie, bien que mesurable, n'est pas une distance, au sens mathématique du terme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aff2c4d6-0c5d-3c4c-bfb8-08f8ba0b1b3a",
                                        "entry_id": "1f7c4c65-47e0-30dc-9242-4558583ba3c1",
                                        "glosses": [
                                            "Courbe de l’ellipsoïde faisant un angle constant avec chaque méridien, ou son image sur le plan de projection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5f6a259-ae4e-4c2c-b8a2-04c2a462c640",
                                                "sense_id": "aff2c4d6-0c5d-3c4c-bfb8-08f8ba0b1b3a",
                                                "text": "Les cercles de latitude, appelés aussi parallèles, sont des loxodromies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc97b5d-dcb9-3be3-a982-3f71efb3c97a",
                                        "entry_id": "1f7c4c65-47e0-30dc-9242-4558583ba3c1",
                                        "glosses": [
                                            "Itinéraire qui coupe les méridiens terrestres sous un angle (cap) constant ; en particulier, route d’un navire ou d’un avion qui suit constamment le même cap. Par opposition à l’orthodromie qui correspond à la route la plus courte (si celle-ci doit couper plusieurs méridiens, comme c'est le cas pour les routes est/ouest) mais qui oblige le navigateur à changer de cap régulièrement au fur et à mesure qu’il avance, et ce d’autant plus qu’il s’éloigne de l’équateur."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
