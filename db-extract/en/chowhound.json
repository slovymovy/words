                        "glosses": [
                            "A foodie or glutton."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "37310357-becb-4ba7-9c60-25e98d43cbb0",
                                "sense_id": "155bb418-eaf9-317d-8f87-e12cfc9e2959",
                                "text": "Fortunately for me, I'm one of those people who can be a chowhound and never have to worry about putting on weight."
                            },
                            {
                                "example_id": "6e542de3-80cd-4e1c-a3d0-a333f6af68f0",
                                "sense_id": "155bb418-eaf9-317d-8f87-e12cfc9e2959",
                                "text": "There was no danger of a chowhound like Rags starving himself in her absence, but she feared he might pine away and be gone when she returned."
                            },
                            {
                                "example_id": "a7351c4d-358c-49f4-8f16-c249ec88e18e",
                                "sense_id": "155bb418-eaf9-317d-8f87-e12cfc9e2959",
                                "text": "Besides being one of the most dangerous and feared guys on the yard, Roscoe is also a chowhound. He would kill for a can of ham […]"
                            },
                            {
                                "example_id": "c8073630-1e13-434a-bb76-6310c4bd314c",
                                "sense_id": "155bb418-eaf9-317d-8f87-e12cfc9e2959",
                                "text": "One in 10 people is a chowhound, a person who is on a passionate search for quality, he says."
                            }
                        ]
                    }
