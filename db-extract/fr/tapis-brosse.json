                        "sense_id": "82377fd7-001e-3593-ad4d-b056dcefd992",
                        "entry_id": "0813c6be-b585-3518-b5f6-65c2869be622",
                        "glosses": [
                            "Natte de paille, tapis de fibre végétale, que l’on met à l’entrée d’une maison ou d’un appartement pour permettre de s’essuyer les pieds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b9ce996-657e-41ff-9ee5-9eab697297e2",
                                "sense_id": "82377fd7-001e-3593-ad4d-b056dcefd992",
                                "text": "Sur le tapis-brosse du vestibule, qu’elle avait traîné dehors, la concierge exécutait une danse magique. Un nuage de poussière l’enveloppait de gloire."
                            },
                            {
                                "example_id": "a0e14c42-f290-4a58-8859-7ab32a3abed7",
                                "sense_id": "82377fd7-001e-3593-ad4d-b056dcefd992",
                                "text": "Je frotte mes semelles sur le tapis-brosse, j’ouvre avec précaution la double porte vitrée, je grimpe aussi vite que je peux l’escalier ciré jusqu’au second…"
                            }
                        ]
                    }
