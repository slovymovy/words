                        "bon compère"
                    ]
                },
                {
                    "sense_id": "153a1d01-7bee-3a76-8776-01e6e41a9178",
                    "sense_definition": "Parrain d'un enfant, considéré par rapport au père, à la mère ou à la marraine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "parente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le père et le parrain de l'enfant se saluèrent chaleureusement en se donnant du <w>compère</w>."
                        },
                        {
                            "text": "Autrefois, le lien spirituel entre les parents et le <w>compère</w> créait une solide entraide familiale."
                        }
                    ],
                    "synonyms": [
                        "parrain"
                    ],
                    "traits": [
