                        "examples": [
                            {
                                "example_id": "adeb450d-f3ab-4bd5-9b02-45c22fb98c07",
                                "sense_id": "76c7595a-49c8-3afc-b2ea-1c0b933502f9",
                                "text": "„Um der sogenannten Bodenerschöpfung vorzubeugen, hat die Landwirthschaft drei bewährte Mittel: Brache, Wechselwirthschaft und Düngung eingeführt.“"
                            },
                            {
                                "example_id": "831774c9-adcd-4fa0-be0d-c40e67415f43",
                                "sense_id": "76c7595a-49c8-3afc-b2ea-1c0b933502f9",
                                "text": "„Bodenerschöpfungen und Störungen im Wasserhaushalt kamen gewiß vereinzelt vor; […]“"
                            },
                            {
                                "example_id": "99386085-4192-4eaa-a728-4c846bf283cc",
                                "sense_id": "76c7595a-49c8-3afc-b2ea-1c0b933502f9",
                                "text": "„Es kann hie und da locale und zeitliche Bodenerschöpfungen geben, aber die Natur bietet nirgends ein Beispiel permanenter Erschöpfung.“"
                            }
                        ],
