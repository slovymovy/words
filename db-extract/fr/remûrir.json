                "senses": [
                    {
                        "sense_id": "26239cc0-64d5-3916-9398-d6d73ff38a06",
                        "entry_id": "385ab6c4-da9f-342e-8f14-c88b33b71df2",
                        "glosses": [
                            "Mûrir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d538190-b4cd-4193-95d6-0ece7ee42f4f",
                                "sense_id": "26239cc0-64d5-3916-9398-d6d73ff38a06",
                                "text": "Hais ton orgueil, vaillante petite bête, est déjà depuis longtemps presque infini, et trop impatiente, tu n'accordes souvent même plus au Fruit le temps qu'il lui faudrait pour repousser et remûrir pleinement sur l'Arbre."
                            },
                            {
                                "example_id": "88aad425-43a8-447c-864e-f0fe7dc42803",
                                "sense_id": "26239cc0-64d5-3916-9398-d6d73ff38a06",
                                "text": "dans ce cas, l'état de maturation des ovaires est à nouveau complet (5 à 7 œufs \"mûrs\"/ovariole), ce qui nous permet de vérifier qu'une femelle ayant pondu un nombre appréciable d’œufs a besoin d'un certain laps de temps pour \"remûrir\" ses oeufs (maturation des œufs cyclique)."
                            }
                        ]
                    }
