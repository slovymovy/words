                "senses": [
                    {
                        "sense_id": "d2c0d21d-d7e8-3357-8fed-32510a3d4143",
                        "entry_id": "e027965c-e141-3891-ac98-9657af634e2a",
                        "glosses": [
                            "Armee, die für eine Invasion eingesetzt wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720e821c-44b3-4aa3-9022-e6de680484eb",
                                "sense_id": "d2c0d21d-d7e8-3357-8fed-32510a3d4143",
                                "text": "„Die Invasionsarmee zieht nach Osten und erreicht ihr Endziel, nämlich Moskau.“"
                            },
                            {
                                "example_id": "a2585816-1ef6-40cc-a37f-648a174261e3",
                                "sense_id": "d2c0d21d-d7e8-3357-8fed-32510a3d4143",
                                "text": "„Nach dem Völkermord im ostafrikanischen Ruanda hatte 1994 die Ruandische Patriotische Front (RPF), eine Invasionsarmee von Tutsi-Exilanten aus dem benachbarten Uganda, Ruanda erobert.“"
                            },
                            {
                                "example_id": "52275dbb-486c-4672-8d8f-e637db0cf906",
                                "sense_id": "d2c0d21d-d7e8-3357-8fed-32510a3d4143",
                                "text": "„Mit General Montgomerys Invasionsarmee überquerte er den Rhein und rückte bis Nordwestdeutschland vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
