                                    {
                                        "sense_id": "1599038f-cedb-3eae-963a-6521fc85e0b7",
                                        "entry_id": "a0405fd6-9881-3543-8926-bdef054e431c",
                                        "glosses": [
                                            "ein flacher Knochen als Bestandteil des Brustkorbes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a817095d-214b-4832-8730-b8096687a18f",
                                                "sense_id": "1599038f-cedb-3eae-963a-6521fc85e0b7",
                                                "text": "Der Patient berichtet dem Kardiologen von einem Druckschmerz hinter seinem Brustbein."
                                            },
                                            {
                                                "example_id": "a3227b36-a177-4854-9357-806a54a4726d",
                                                "sense_id": "1599038f-cedb-3eae-963a-6521fc85e0b7",
                                                "text": "Beim Menschen sind 14 von insgesamt 24 Rippenbögen mit dem Brustbein verwachsen."
                                            },
                                            {
                                                "example_id": "446971c9-d6b8-45b6-b625-a429a678dd1b",
                                                "sense_id": "1599038f-cedb-3eae-963a-6521fc85e0b7",
                                                "text": "„Es gab noch einen leisen Knall, und diesmal drang das Geschoss direkt unter dem Brustbein in Crawdad Gilmores Körper ein und durchbohrte sein Herz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64069312-318a-4eaf-996b-a1a3de8d19a1",
                        "source_entry_id": "2e7af1d3-8091-36ba-9a03-184ed5c43bfc",
                        "source_sense_id": "86b4f842-2f20-337d-8daf-d331c39b793a",
