                "senses": [
                    {
                        "sense_id": "5ff5e9eb-1c93-3711-902e-de723ce72660",
                        "entry_id": "63a24836-77a5-357c-ada1-afafa67cfcab",
                        "glosses": [
                            "Qui indique une circonstance de l’action ou de l’état marqué par le verbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f3dd39-a4fb-41ba-a452-7dadceb9fab7",
                                "sense_id": "5ff5e9eb-1c93-3711-902e-de723ce72660",
                                "text": "Propositions circonstancielles."
                            }
                        ]
                    },
                    {
                        "sense_id": "22178a34-78ae-38f5-acc1-cf26109fdf5a",
                        "entry_id": "63a24836-77a5-357c-ada1-afafa67cfcab",
                        "glosses": [
                            "Qui dépend des circonstances."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "bfa67f3e-c398-49f1-9b36-cb56f0076dc1",
                                "sense_id": "22178a34-78ae-38f5-acc1-cf26109fdf5a",
                                "text": "Ce sentiment serait-il propre à madame Kirry, ou expressif d’un malaise circonstanciel ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d7557c0-cf8c-424d-966c-42467aa60bea",
                        "source_entry_id": "63a24836-77a5-357c-ada1-afafa67cfcab",
                        "target_lang_word": "circumstantial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circumstantial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7f9c13-684d-3a45-9ebf-f100dd02ff24",
                                        "entry_id": "338f2912-fc2d-3fe8-ad1f-978e281d81b4",
                                        "glosses": [
                                            "Pertaining to or dependent on circumstances, especially as opposed to essentials; incidental, not essential."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c075351-8943-463c-9224-565d63168677",
                                                "sense_id": "cd7f9c13-684d-3a45-9ebf-f100dd02ff24",
                                                "text": "We must therefore distinguish between the essentials in religious worship […] and what is merely circumstantial."
                                            },
                                            {
                                                "example_id": "a3678924-fc04-4ccb-961f-01a690f414e1",
                                                "sense_id": "cd7f9c13-684d-3a45-9ebf-f100dd02ff24",
                                                "text": "Evidence for cannibalism abounds - even if circumstantial - both from the modern world and throughout history, but academic anthropology has found itself in a funk of denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c77af51-cfd3-34da-a44e-84db1ef49ce3",
                                        "entry_id": "338f2912-fc2d-3fe8-ad1f-978e281d81b4",
                                        "glosses": [
                                            "Involving evidence that relies on inference to connect it to a conclusion of fact, thus, suggesting guilt but not directly proving it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36b372a-b239-4f56-aea0-941ed5e6ae94",
                                                "sense_id": "8c77af51-cfd3-34da-a44e-84db1ef49ce3",
                                                "text": "It is unlikely he will be convicted; the evidence against him is circumstantial at best."
                                            },
                                            {
                                                "example_id": "8f942014-db1c-4dc7-a2e8-8b298ad17cc3",
                                                "sense_id": "8c77af51-cfd3-34da-a44e-84db1ef49ce3",
                                                "text": "Never, he said, in the course of his long experience, had he known a charge of murder rest on slighter evidence. Not only was it entirely circumstantial, but the greater part of it was practically unproved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ab284f1-422b-305b-b152-3eb14e6708ec",
                                        "entry_id": "338f2912-fc2d-3fe8-ad1f-978e281d81b4",
                                        "glosses": [
                                            "Abounding with minor circumstances; in great detail; particular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601a4260-5060-4e29-bbdc-651c64e6d097",
                                                "sense_id": "5ab284f1-422b-305b-b152-3eb14e6708ec",
                                                "text": "My Unkle's account is more circumstantial I must confess—but I believe mine is the true one for all that."
                                            },
                                            {
                                                "example_id": "c3e713dc-7b97-4e79-ad02-48ee0c7b7fbd",
                                                "sense_id": "5ab284f1-422b-305b-b152-3eb14e6708ec",
                                                "text": "For although my information appears too direct and circumstantial to be fictitious, yet the magnitude of the enterprise, the desperation of the plan, and the stupendous consequences with which it seems pregnant, stagger my belief […]"
                                            },
                                            {
                                                "example_id": "e3249d06-cb1b-4f35-a8c4-ce86dcd35c36",
                                                "sense_id": "5ab284f1-422b-305b-b152-3eb14e6708ec",
                                                "text": "Second-hand but clearly from the best possible source - the King himself - [the story] is highly circumstantial, taking twenty-two pages of text."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b820780-e3c9-3cc6-a298-b1524f381016",
                                        "entry_id": "338f2912-fc2d-3fe8-ad1f-978e281d81b4",
                                        "glosses": [
                                            "Full of circumstance or pomp; ceremonial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "circumstantial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0376468-f634-3252-8ffa-871fec75a14c",
                                        "entry_id": "d3d1d404-3f83-3a8c-988b-c81a769a3eca",
