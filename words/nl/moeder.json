                    "sense_definition": "Een vrouwelijke ouder.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>moeder</w> werkt in een groot ziekenhuis.",
