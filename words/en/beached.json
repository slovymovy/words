{
    "word_family": [
        "beach",
        "beachy",
        "beachfront"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "18cdedb4-30a2-3909-891a-ea02ae82a50b",
                    "sense_definition": "Stranded and helpless, especially on a beach or unable to move.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stranded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team worked quickly to save the <w>beached</w> whale before the tide went out.",
                            "target_lang_translations": {
                                "ru": "Спасательная команда работала быстро, чтобы спасти <w>выбросившегося на берег</w> кита до того, как начнется отлив."
                            }
                        },
                        {
                            "text": "After the storm, we found a <w>beached</w> boat lying on its side near the dunes.",
                            "target_lang_translations": {
                                "ru": "После шторма мы обнаружили <w>выброшенную на берег</w> лодку, лежащую на боку возле дюн."
                            }
                        }
                    ],
                    "synonyms": [
                        "stranded",
                        "grounded",
                        "marooned"
                    ],
                    "antonyms": [
                        "afloat"
                    ],
                    "common_phrases": [
                        "beached whale",
                        "beached vessel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выброшенный на берег или севший на мель и беспомощный, неспособный двигаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выброшенный на берег",
                                "target_lang_sense_clarification": "о морских животных или судах"
                            },
                            {
                                "target_lang_word": "севший на мель",
                                "target_lang_sense_clarification": "о судах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "341e2d3b-3e19-3aff-85f0-f5f41b3cc1a6",
                    "sense_definition": "Run or brought ashore, especially of a boat or ship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stranded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishermen left their <w>beached</w> canoes on the sand while they repaired their nets.",
                            "target_lang_translations": {
                                "ru": "Рыбаки оставили свои <w>вытащенные на берег</w> каноэ на песке, пока чинили сети."
                            }
                        },
                        {
                            "text": "We walked past the <w>beached</w> ship that had been resting there since the last century.",
                            "target_lang_translations": {
                                "ru": "Мы прошли мимо <w>севшего на мель</w> корабля, который покоился там с прошлого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "grounded",
                        "ashore"
                    ],
                    "common_phrases": [
                        "beached ship",
                        "beached boat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вытащенный или причаленный к берегу (о лодке или корабле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытащенный на берег",
                                "target_lang_sense_clarification": "о лодках, каноэ"
                            },
                            {
                                "target_lang_word": "причаленный к берегу",
                                "target_lang_sense_clarification": "о судах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff4ff1fe-c969-39da-8ffc-49acee967c03",
                    "sense_definition": "Having a beach or sandy shore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They built their summer cottage on the <w>beached</w> verge of the beautiful lake.",
                            "target_lang_translations": {
                                "ru": "Они построили свой летний коттедж на <w>песчаном</w> берегу красивого озера."
                            }
                        },
                        {
                            "text": "The explorer described a <w>beached</w> coastline stretching for miles without any cliffs.",
                            "target_lang_translations": {
                                "ru": "Исследователь описал <w>песчаную</w> береговую линию, тянущуюся на мили без каких-либо скал."
                            }
                        }
                    ],
                    "synonyms": [
                        "beachy"
                    ],
                    "common_phrases": [
                        "beached verge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean having a beach"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий пляж или песчаный берег (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "песчаный",
                                "target_lang_sense_clarification": "о побережье или береге"
                            },
                            {
                                "target_lang_word": "имеющий пляж",
                                "target_lang_sense_clarification": "о береговой линии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c23355ec-73bd-34ff-b7bd-754ad38313a8",
                    "sense_definition": "Simple past and past participle of <w>beach</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain safely <w>beached</w> the damaged vessel to prevent it from sinking in deep water.",
                            "target_lang_translations": {
                                "ru": "Капитан благополучно <w>посадил на мель</w> поврежденное судно, чтобы оно не затонуло на глубине."
                            }
                        },
                        {
                            "text": "They <w>beached</w> their kayaks on the riverbank and started setting up the campsite.",
                            "target_lang_translations": {
                                "ru": "Они <w>вытащили</w> свои байдарки на берег реки и начали обустраивать лагерь."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола beach (вытаскивать на берег, сажать на мель)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытащил на берег",
                                "target_lang_sense_clarification": "прошедшее время глагола"
                            },
                            {
                                "target_lang_word": "посадил на мель",
                                "target_lang_sense_clarification": "прошедшее время глагола"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}