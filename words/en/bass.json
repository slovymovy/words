                },
                {
                    "sense_id": "0ce43b10-2270-3e19-b8eb-13b8e63b58e3",
                    "sense_definition": "A male singer with the lowest vocal range.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir director asked the <w>bass</w> section to sing a bit louder.",
                            "target_lang_translations": {
                                "ru": "Дирижер хора попросил партию <w>басов</w> петь немного громче.",
                                "zh": "合唱团指挥要求<w>男低音</w>声部唱得再大声一点。"
                            }
                        },
                        {
                            "text": "He has a rich <w>bass</w> voice that adds depth to the harmony.",
                            "target_lang_translations": {
                                "ru": "У него богатый <w>бас</w>, который добавляет глубины гармонии.",
                                "zh": "他有着浑厚的<w>男低音</w>，为和声增添了深度。"
                            }
                        }
