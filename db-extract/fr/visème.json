                                "target_senses": [
                                    {
                                        "sense_id": "6a287e3a-8eb4-3256-81d1-451af463ba9b",
                                        "entry_id": "51e92654-0218-3693-80b3-b7fa2098633a",
                                        "glosses": [
                                            "Any of a group of speech sounds that look the same, for example when lipreading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a0422de-1cbd-405e-940c-52c4e84ae186",
                                                "sense_id": "6a287e3a-8eb4-3256-81d1-451af463ba9b",
                                                "text": "Resulting confusion matrices were analyzed for significant confusions among consonants; these confusions were grouped into mutually exclusive classes termed visemes."
                                            },
                                            {
                                                "example_id": "aeea672e-2863-4420-bd27-24add45ae48e",
                                                "sense_id": "6a287e3a-8eb4-3256-81d1-451af463ba9b",
                                                "text": "Each of these groups is called a viseme, a term coined by Fisher (1968). It is possible for a viseme to contain only one speech sound, but that is unusual."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
