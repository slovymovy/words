                "senses": [
                    {
                        "sense_id": "1ba80269-d6c5-3cf3-a9b1-321d5338ceac",
                        "entry_id": "b47e6bcd-9d96-36ef-8d54-d7331a9ad09b",
                        "glosses": [
                            "eine von zwei Halterungen (Bügeln), mit denen man eine Brille an den Ohren halten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c82871d-9e99-4186-b980-0ff42cad11e4",
                                "sense_id": "1ba80269-d6c5-3cf3-a9b1-321d5338ceac",
                                "text": "„Er nahm die Lesebrille in die Hand und spielte mit den Brillenbügeln.“"
                            },
                            {
                                "example_id": "e7e4223b-1043-404d-abb4-48add5f6a28c",
                                "sense_id": "1ba80269-d6c5-3cf3-a9b1-321d5338ceac",
                                "text": "„Ich war gut darin, alberne kleine Videos zu machen, zum Beispiel, wie ich den Schlüssselbund suchte, während er am eigenen Brillenbügel hing.“"
                            }
                        ],
