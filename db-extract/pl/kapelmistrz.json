                "forms": [],
                "senses": [
                    {
                        "sense_id": "42a7d75b-f3fc-3104-a458-53ac7d0999b2",
                        "entry_id": "4492501c-dfde-31b2-8d67-d7d1d00ae585",
                        "glosses": [
                            "muzyk kierujący chórem, kapelą lub orkiestrą, dyrygent"
                        ],
                        "tags": [],
