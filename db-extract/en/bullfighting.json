                        "entry_id": "261f24f0-99c1-3dc6-9285-51bfdb5457a6",
                        "glosses": [
                            "A traditional spectacle, popular in Spain and many former Spanish colonies, in which a matador manipulates and ultimately kills a bull at close range."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0b28ff6f-18b9-48dd-b59d-fad615540f07",
                                "sense_id": "eede4ac7-5156-3dcb-9e02-c159c994c939",
                                "text": "In Portugal, Spain, Southern France and some Latin American countries, bulls are used in the sport of bullfighting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1995ae3a-bc93-48d1-a026-8c2e07180e30",
                        "source_entry_id": "261f24f0-99c1-3dc6-9285-51bfdb5457a6",
