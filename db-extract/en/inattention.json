                                        "glosses": [
                                            "Falta de educación o de la deferencia debida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36261cd5-bc94-4821-8893-c84f377f3a66",
                                                "sense_id": "33a05de9-e0ae-3a8a-a8ef-609e50377b58",
                                                "text": "Ese saber tan afiebradamente adquirido no me vacuna contra la tentación de hacer, desde las otras experiencias en las que he contraído mis principales defectos, indiscretas interpretaciones, de incurrir en el feo vicio de la descortesía"
                                            }
