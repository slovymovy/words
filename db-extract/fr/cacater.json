                        "glosses": [
                            "Faire caca, chier."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7470c759-ff1d-46d1-b3a1-be6032d1d337",
                                "sense_id": "aa8e630a-7800-3b80-b39c-b2820c73dbd9",
                                "text": "Ah oui, j'entends les oiseaux chanter, ils me consolent des pigeons qui viennent cacater sur mon balcon."
                            },
