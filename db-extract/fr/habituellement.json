                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habitually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae2d4cf-c65d-3927-aeb3-b04d24174322",
                                        "entry_id": "223a385f-b922-3117-967e-efff71d3156a",
                                        "glosses": [
                                            "By habit; in a habitual manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b906a7-7cdd-43ab-8201-fb8f6f9250dc",
                                                "sense_id": "3ae2d4cf-c65d-3927-aeb3-b04d24174322",
                                                "text": "He is habitually inattentive of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b18936-d792-3bf1-ad6e-689a027d302b",
                                        "entry_id": "223a385f-b922-3117-967e-efff71d3156a",
                                        "glosses": [
                                            "Occurring regularly or usually."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "713e70bb-c42f-4fd9-ba92-4ec1c2aad851",
                                                "sense_id": "72b18936-d792-3bf1-ad6e-689a027d302b",
                                                "text": "Professor Franklein is habitually pessimistic."
                                            },
                                            {
                                                "example_id": "2b32c2fc-8e30-43e3-b2af-ff8ecae7bdb9",
                                                "sense_id": "72b18936-d792-3bf1-ad6e-689a027d302b",
                                                "text": "Such recognition is a much-needed boost for Scotland's habitually busiest station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "425b92ec-2ba4-4121-b0e5-a43d762db15f",
                        "source_entry_id": "715c56e5-41a9-3024-8b13-312e53810a67",
                        "source_sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                        "target_lang_word": "常常",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "常常",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                        "entry_id": "6cfb4e64-d7df-3f79-90f3-e5c421f73abe",
                                        "glosses": [
                                            "指事情發生的頻率很高，次數頻繁"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa873b97-6fad-4323-a5c3-3b5c9b4f6f4d",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "這房子常常鬧鬼。"
                                            },
                                            {
                                                "example_id": "1e591edd-0ea7-4948-983c-0ba754ac5812",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "这房子常常闹鬼。"
                                            },
                                            {
                                                "example_id": "b49c6c61-0d51-4c09-b049-3427cb676567",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "我在蒙自住過五個月，我的家也在那裡住過兩個月。我現在常常想起這個地方，特別是在人事繁忙的時候。蒙自小得好，人少得好。"
                                            },
                                            {
                                                "example_id": "5e74ecb4-3605-414d-ace2-7f00152ebd49",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "我在蒙自住过五个月，我的家也在那里住过两个月。我现在常常想起这个地方，特别是在人事繁忙的时候。蒙自小得好，人少得好。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f9fac92-b78a-4327-a207-fe893dc8b3e4",
