                        "examples": [
                            {
                                "example_id": "66d19128-d5be-4daf-b708-ef45acd3ee49",
                                "sense_id": "72b8b754-f7fa-329a-925b-ba9ca9d8674c",
                                "text": "„Der Siedlungsbau konnte ungehindert forgesetzt werden, Jerusalem wurde weiter vom Westjordanland abgetrennt, und Palästinensern aus den besetzten Gebieten wurde die Einreise nach Israel zunehmend verwehrt.“"
                            },
                            {
                                "example_id": "ecf27640-aa78-479a-bdde-04e7103e87bd",
                                "sense_id": "72b8b754-f7fa-329a-925b-ba9ca9d8674c",
                                "text": "„Hintergrund der Gewalteskalation war nicht nur, dass sich unter den von Benjamin Netanjahu seit 2009 geführten Regierungen die Besatzung weiter verfestigt hatte, Siedlungsbau und De-facto-Annexion im Westjordanland vorangetrieben wurden und die palästinensische Bevölkerung in strategischen Gebieten zunehmend durch Verdrängung bedroht wurde.“"
                            },
                            {
                                "example_id": "f2e9aaee-e598-47a6-bedf-703ac89b57eb",
                                "sense_id": "72b8b754-f7fa-329a-925b-ba9ca9d8674c",
                                "text": "„Die Proteste richteten sich nun auch gegen die israelische Besatzung überhaupt und den Siedlungsbau in der Westbank.“"
                            }
                        ],
