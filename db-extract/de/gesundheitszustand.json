                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e33ba06e-225c-31aa-b8b0-772db2f068ff",
                                        "entry_id": "d7df74ec-e188-3dee-8df5-01530f23ed26",
                                        "glosses": [
                                            "A toast to prosperity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
