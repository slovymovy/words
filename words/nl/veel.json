                    "sense_id": "e3ac230e-080e-34cd-abcf-1da3b9954648",
                    "sense_definition": "Een grote hoeveelheid aanduidend; niet weinig (gebruikt bij niet-telbare woorden).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was <w>veel</w> regen gevallen in de afgelopen dagen.",
                            "target_lang_translations": {
                                "ru": "В последние дни выпало <w>много</w> дождя.",
                                "en": "There had been <w>much</w> rain in recent days."
                            }
                        },
                        {
                            "text": "Daar is <w>veel</w> discussie over geweest in de media.",
                            "target_lang_translations": {
                                "ru": "Об этом было <w>много</w> дискуссий в СМИ.",
                                "en": "There has been <w>a lot of</w> discussion about that in the media."
                            }
                        }
