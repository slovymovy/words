                        "examples": [
                            {
                                "example_id": "81d07dce-f50c-49c7-8406-6c29bfaa8e64",
                                "sense_id": "9f4e29f8-4c6a-31e1-a353-9dff1147745d",
                                "text": "De l'œuf sort une larve nageante, le miracidium, qui pénètre dans un mollusque gastéropode d’eau douce."
                            },
                            {
                                "example_id": "b9fed9fa-03f6-4cac-90b0-877174b1d604",
                                "sense_id": "9f4e29f8-4c6a-31e1-a353-9dff1147745d",
                                "text": "Une larve ciliée sort alors de l'œuf : c'est le miracidium. Cette larve peut vivre deux jours. Elle doit trouver une limnée (petit gastéropode aquatique) et pénétrer activement à travers son tégument."
                            }
                        ]
                    }
