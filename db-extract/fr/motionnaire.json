                        "glosses": [
                            "Pendant la révolution, personne qui faisait des motions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2729d6-791e-41b2-9414-4180eaa456c7",
                                "sense_id": "6b115885-f63e-3ce8-89cc-b447193b262d",
                                "text": "J’ai le récit d’un meurtre, là le chant d’un vaudeville ; les propositions de la débauche à côté du tréteau du motionnaire."
                            },
                            {
                                "example_id": "7f4b10d0-b06f-4ec8-8a44-40ca874f1c61",
                                "sense_id": "6b115885-f63e-3ce8-89cc-b447193b262d",
                                "text": "Il est vrai que l’auteur était Camille Desmoulins, le motionnaire du Palais-Royal, l’homme à la chaise, au pistolet et aux feuilles de marronnier."
                            }
                        ]
