                "senses": [
                    {
                        "sense_id": "19b53418-13f5-3d2f-9488-e3f9416d717d",
                        "entry_id": "da071c6a-4b7a-3f12-a5ec-4328329b10f7",
                        "glosses": [
                            "A woman's breasts, especially large breasts."
                        ],
                        "tags": [
                            "plural-normally",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "85ccda9c-61cf-40c0-b540-4d19d79d49c2",
                                "sense_id": "19b53418-13f5-3d2f-9488-e3f9416d717d",
                                "text": "As she exited the tomb, momentarily blinded by the bright sun, she was vaguely aware that the other members of the party were staring at the impressive zoomers filling out her dusty tank top."
                            },
                            {
                                "example_id": "68f1b1ff-458f-4e5b-8f73-a2071c56a180",
                                "sense_id": "19b53418-13f5-3d2f-9488-e3f9416d717d",
                                "text": "\"Kelso said she had the biggest zoomers he'd ever seen.\"\n\"Zoomers, Brian?\"\n\"You know what I mean, zoomers, coconuts, boobs!\""
                            },
                            {
                                "example_id": "4cd50777-b3ab-482c-ab96-7ee351ad58bc",
                                "sense_id": "19b53418-13f5-3d2f-9488-e3f9416d717d",
                                "text": "Sonya Posner had herself a serious rack. I'm talking major league zoomers. She could give even Lovely Rita a run for her cup size."
                            },
                            {
                                "example_id": "b7b6459a-0202-430e-849e-73f60ed36a7a",
                                "sense_id": "19b53418-13f5-3d2f-9488-e3f9416d717d",
                                "text": "He was hoping she was going to come back out since she left the glass wall open. He kept lowering the paper hoping to get another eyeful of her awesome tits in high def in the bright morning sun. The last time he lowered the paper and took a drag on his cigarette he saw her standing there with her double barreled rocket grenade launcher pointed at him.\n\"You like my tits? I'll show you a pair of zoomers.\""
                            }
                        ]
                    }
                ],
