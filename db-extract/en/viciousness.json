                        "entry_id": "2a12226b-8c99-3ecc-82cb-b1a78e242f40",
                        "glosses": [
                            "Bösartigkeit, Fehlerhaftigkeit, Verdorbenheit, Lasterhaftigkeit, Verderbtheit, Boshaftigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa38b5aa-c586-4654-be39-9dc866512fcd",
                                "sense_id": "d49b9335-ffcd-39e0-bef0-3989f0931e01",
                                "text": "He told me about the viciousness of his father.",
                                "translation": "Er erzählte mir von der Boshaftigkeit seines Vaters."
