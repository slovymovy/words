                },
                {
                    "sense_id": "f841e523-7e44-3c70-8082-49db7c4308a7",
                    "sense_definition": "Very unpleasant or disagreeable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unpleasantness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not going out for a walk in this <w>filthy</w> weather.",
                            "target_lang_translations": {
                                "ru": "Я не пойду гулять в такую <w>мерзкую</w> погоду.",
                                "zh": "这种<w>恶劣</w>的天气我才不出去散步呢。",
                                "es": "No voy a salir a caminar con este tiempo tan <w>asqueroso</w>."
                            }
                        },
                        {
                            "text": "She has been in a <w>filthy</w> mood ever since she woke up.",
                            "target_lang_translations": {
                                "ru": "У неё <w>отвратительное</w> настроение с тех пор, как она проснулась.",
                                "zh": "她从起床开始心情就一直很<w>糟糕</w>。",
                                "es": "Ha estado de un humor <w>detestable</w> desde que se despertó."
                            }
                        }
                    ],
                    "common_phrases": [
                        "filthy weather",
                        "filthy mood",
                        "filthy night"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень неприятный или противный (обычно о погоде или настроении).",
                        "zh": "非常令人不快或讨厌的。",
                        "es": "Muy desagradable o molesto."
                    },
