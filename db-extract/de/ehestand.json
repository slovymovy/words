                        "examples": [
                            {
                                "example_id": "3f7aa0aa-f32c-48b2-a6f4-becd715243c3",
                                "sense_id": "5613b49e-2bfa-34e6-8d0d-258a0990b2fe",
                                "text": "Da ward Vermählung gehalten, und sie blieben in dem Schloß, das war viel größer als ihres Vaters Schloß. Weil aber der Alte jammerte daß er allein bleiben sollte, so fuhren sie weg, und holten ihn zu sich, und hatten zwei Königreiche, und lebten in gutem Ehestand."
                            }
                        ]
                    }
