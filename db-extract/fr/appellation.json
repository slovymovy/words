        "fr-extract.jsonl": [
            {
                "entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                "word": "appellation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a04076e-6916-4835-a50e-2bea2f29e09c",
                        "entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                        "tags": [
                            "plural"
                        ],
                        "form": "appellations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "438760ea-8caa-3cb2-bca3-1bda66a386ae",
                        "entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                        "glosses": [
                            "Action d’appeler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763b2c6c-803e-4469-82cf-bf5def4ce2d5",
                                "sense_id": "438760ea-8caa-3cb2-bca3-1bda66a386ae",
                                "text": "Appellation à haute voix, familière, injurieuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "a35dd748-81df-391e-b931-7c1a3d0ee2d0",
                        "entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                        "glosses": [
                            "Façon de dénommer quelqu’un ou quelque chose."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "17585611-eb73-4e46-ae82-801b23935b5d",
                                "sense_id": "a35dd748-81df-391e-b931-7c1a3d0ee2d0",
                                "text": "Ces nodules sphéroïdes ou cylindroïdes, si singulièrement affublés, en Champagne, comme en Picardie ou en Haute-Normandie, de l’appellation imprévue de pierres de tonnerre ou de pierres de foudre sont formés de cristaux prismatiques de bisulfure de fer irradiant de leur centre."
                            },
                            {
                                "example_id": "9c6241b1-3064-4659-8502-f5b9381ac752",
                                "sense_id": "a35dd748-81df-391e-b931-7c1a3d0ee2d0",
                                "text": "[…], on les désignait généralement, le premier sous le nom de gros Zidore, le second sous celui de gros Léon, appellations qui leur seyaient d’autant mieux qu’ils avaient conquis, comme il convenait à leur âge et à leur position sociale, la pointe de bedon qui confère toute son importance au campagnard cossu."
                            },
                            {
                                "example_id": "8493aaae-187a-4f54-bfe5-8213b27dbdd5",
                                "sense_id": "a35dd748-81df-391e-b931-7c1a3d0ee2d0",
                                "text": "L’autre, sec, noueux, noiraud, correct à la façon d’un danseur salarié, répondait à l’appellation du « Mondain »."
                            },
                            {
                                "example_id": "5c01600d-d5b5-46d1-920e-d586500d63a9",
                                "sense_id": "a35dd748-81df-391e-b931-7c1a3d0ee2d0",
                                "text": "L’appellation « hydroxyde d’ammonium » de cette bouteille contenant de l’ammoniaque, nom donné à une solution aqueuse d’ammoniac, est incorrecte."
                            }
                        ]
                    },
                    {
                        "sense_id": "689a6306-2e26-3fdb-9725-9ba73b60ef95",
                        "entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                        "glosses": [
                            "Action de nommer chaque lettre de l’alphabet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "201267b9-08a5-37eb-b77d-428353bdb7e9",
                        "entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                        "glosses": [
                            "Appel d’un jugement."
                        ],
                        "tags": [],
                        "note": "Il ne se dit guère que dans les formules des arrêts et des jugements",
                        "examples": [
                            {
                                "example_id": "37ae9492-7a31-4548-b94c-8a10b8bbe309",
                                "sense_id": "201267b9-08a5-37eb-b77d-428353bdb7e9",
                                "text": "La Cour a mis l’appellation à néant."
                            },
                            {
                                "example_id": "203897eb-3860-41e9-96e0-297cd6b9c021",
                                "sense_id": "201267b9-08a5-37eb-b77d-428353bdb7e9",
                                "text": "Le jugement sera exécuté nonobstant opposition ou appellation quelconque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07ad4d21-ab7b-4667-8762-995428e6a50c",
                        "source_entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                        "target_lang_word": "Bezeichnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bezeichnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                        "entry_id": "3b172792-541c-3379-b807-5e3b59ea2141",
                                        "glosses": [
                                            "Code aus Zeichen und Symbolen, der auf einen Gegenstand oder Begriff verweist"
                                        ],
                                        "tags": [
                                            "Semiotik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ceac54-fb57-44dc-90fd-ea3789e41f58",
                                                "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                                "text": "Eine einheitliche Bezeichnung der Waren erleichtert die Suche."
                                            },
                                            {
                                                "example_id": "76805492-8a32-4b4b-9422-4c6491d7509c",
                                                "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                                "text": "Die Europäische Artikelnummer (EAN) ist ein Strichcode, der auf jeder Ware sein sollte und so die eindeutige Bezeichnung des Artikels ermöglicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                        "entry_id": "3b172792-541c-3379-b807-5e3b59ea2141",
                                        "glosses": [
                                            "Wort, sprachlicher Ausdruck für etwas Gemeintes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d652fd4d-78d2-44af-ad27-184e6ba9d266",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "In manchen Regionen Norddeutschlands verwendet man für „Samstag“ die Bezeichnung „Sonnabend“."
                                            },
                                            {
                                                "example_id": "2bdf1dd1-d885-47b7-b689-0ff00f9bf64e",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Nur die Richtung der Fragestellung - die Richtung vom Sachverhalt zur Sprache, vom zu Bezeichnenden zur Bezeichnung - verbindet unterschiedliche Vorgehensweisen.“"
                                            },
                                            {
                                                "example_id": "f2c20618-777d-4a98-b1ad-df5173558bdc",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Damit gehen Entdeckungen und Erfindungen einher, die genaue und immer differenziertere Bezeichnungen (Nominationen) verlangen.“"
                                            },
                                            {
                                                "example_id": "2fce1ef0-867d-46ac-8d48-d236c257b47f",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Wenn wir überdies auch für die frühen Zeiträume das Wort »Computer« benutzen, dann ist dieses als unsere Bezeichnung für das Gerät beziehungsweise die Technologie der jeweiligen Entwicklungsstufe zu verstehen und keineswegs als Zitat aus den damaligen (oft anderslautenden) Sprachgebräuchen.“"
                                            },
                                            {
                                                "example_id": "6de29c6a-4766-41ce-83c6-a44439a8d5ec",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Erst später gingen über das Warenangebot der Geschäfte die überregionalen Bezeichnungen allmählich in den Sprachgebrauch der Käufer aller Schichten und Sprachlandschaften über.“"
                                            },
                                            {
                                                "example_id": "1a4440b0-10b9-40c9-983e-3ac159d34e02",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Der Hängegleiter, so die amtliche Bezeichnung, ist zu einem ausgereiften Luftfahrtgerät und selbst wieder zum Ausgangspunkt einer neuen Sparte der Luftfahrt geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2fe6d7b-1b9e-411b-a69b-8dbbee44a5a0",
                        "source_entry_id": "7e8b3e29-71cd-3527-aac6-d8689fa5018a",
                        "target_lang_word": "moniker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moniker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a12707a-7bac-3f68-96a0-861dabf90531",
                                        "entry_id": "a248c239-d109-35d7-b949-11aeab1cfe0d",
                                        "glosses": [
                                            "A personal name or nickname; an informal label, often drawing attention to a particular attribute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7477419d-d2bc-45f5-9413-f61076efce68",
                                                "sense_id": "9a12707a-7bac-3f68-96a0-861dabf90531",
                                                "text": "The rookie was upset at being called Lemon Drop until she realized that everyone on the team had a silly moniker."
                                            },
                                            {
                                                "example_id": "8a066a5c-ffca-4c64-a0b1-fb587d6f2f3d",
                                                "sense_id": "9a12707a-7bac-3f68-96a0-861dabf90531",
                                                "text": "Again fairly common, and always amusing, are the monikers drawn from the (imagined) childhood of a particular vagrant."
                                            },
                                            {
                                                "example_id": "44c823d5-c71f-4c91-81d1-2ea876074693",
                                                "sense_id": "9a12707a-7bac-3f68-96a0-861dabf90531",
                                                "text": "A gang member may receive a new identity by taking on a nickname, or moniker, which others in the gang world would recognize. Monikers affirm a youth's commitment to gang life and may become their sole identity, the only way they see thselves and the only name they go by."
                                            },
                                            {
                                                "example_id": "557b4315-1277-45c7-9aa1-8f15ae172075",
                                                "sense_id": "9a12707a-7bac-3f68-96a0-861dabf90531",
                                                "text": "Recently, a class of reactions has gained tremendous attention in the chemistry community under the moniker of \"click chemistry,\" a concept introduced by Kolb and colleagues."
                                            },
                                            {
                                                "example_id": "1d8f7daa-4216-4013-973f-234894edf033",
                                                "sense_id": "9a12707a-7bac-3f68-96a0-861dabf90531",
                                                "text": "Actually, the various monikers Pilgrims, Puritans, Plymouth Rocks, Red Stockings, Hubs and Hubites were frequently used, informally, for both Boston big league clubs until 1912."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912cd12b-a321-3370-984b-70d4c1ac853a",
                                        "entry_id": "a248c239-d109-35d7-b949-11aeab1cfe0d",
                                        "glosses": [
                                            "A person's signature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40911856-589d-4bb9-b341-094260b83c06",
                                                "sense_id": "912cd12b-a321-3370-984b-70d4c1ac853a",
                                                "text": "The monikers of both these famously well-endowed movie stars contain enormous sworls (two of them, no less, for Ms West!) that could only signify you-know-what, according to Ms Koren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "349b9067-d804-306e-b72e-442f03486938",
                                        "entry_id": "a248c239-d109-35d7-b949-11aeab1cfe0d",
                                        "glosses": [
                                            "An object (structured item of data) used to associate the name of an object with its location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8065efaa-ff25-4909-b2d6-bb55900492a6",
                                                "sense_id": "349b9067-d804-306e-b72e-442f03486938",
                                                "text": "Monikers are often composed from other monikers to allow object hierarchies to be navigated based on a textual description of a path."
                                            },
                                            {
                                                "example_id": "65ce9487-adcd-4b2a-80e2-3c7dd4f09fac",
                                                "sense_id": "349b9067-d804-306e-b72e-442f03486938",
                                                "text": "The GetObject function can also be used to access objects via monikers. A moniker is itself an object that acts as an intermediary between VBScript and the actual object to be accessed. Monikers are typically used when the objects to be accessed exist in a namespace other than the file system."
                                            },
                                            {
                                                "example_id": "e6898e70-a737-4e33-9012-5b225eee4710",
                                                "sense_id": "349b9067-d804-306e-b72e-442f03486938",
                                                "text": "There are different types of monikers, but the one that deals with object instantiation is the class moniker. A class moniker portrays a class factory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
