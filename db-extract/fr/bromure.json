        "fr-extract.jsonl": [
            {
                "entry_id": "e4788126-daae-3b95-b606-f4a0d5d37d12",
                "word": "bromure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "de72fe45-3c5e-47fe-b6c9-6f7d892214d9",
                        "entry_id": "e4788126-daae-3b95-b606-f4a0d5d37d12",
                        "tags": [
                            "plural"
                        ],
                        "form": "bromures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7156d4e3-36aa-3a07-913c-4fe32511557d",
                        "entry_id": "e4788126-daae-3b95-b606-f4a0d5d37d12",
                        "glosses": [
                            "Composé résultant de la combinaison du brome avec un corps simple, sel de l’acide bromhydrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c69ed1-9b41-4fe0-b3d1-3abd734bf71e",
                                "sense_id": "7156d4e3-36aa-3a07-913c-4fe32511557d",
                                "text": "Pour apaiser ma soif sur mes lèvres brûlées dont la peau s’enlevait, desséchée, encroûtée de fièvre, une cuillerée de bromure iodé, à goût de sel amer : c’était l’éponge trempée de vinaigre et de fiel."
                            },
                            {
                                "example_id": "613ca342-1753-4e75-be59-1eda4d480428",
                                "sense_id": "7156d4e3-36aa-3a07-913c-4fe32511557d",
                                "text": "Celui qui veut vendre un cheval atteint d’épilepsie n’en peut pas dissimuler les accès à son gré à moins qu’il ne puisse les retarder ou les modérer par la vertu de substances médicamenteuses : le bromure de potassium par exemple ; […]."
                            },
                            {
                                "example_id": "093ddd9b-4b93-418a-b85b-6a4e509bef69",
                                "sense_id": "7156d4e3-36aa-3a07-913c-4fe32511557d",
                                "text": "On a constaté que la cellulose sous forme de papier-filtre est soluble dans les solutions aqueuses concentrées de certains sels, tel que ceux d'antimoine, chlorure d’étain, bromure de zinc."
                            },
                            {
                                "example_id": "e521abe3-bf5e-47b7-96c1-bc98fc001226",
                                "sense_id": "7156d4e3-36aa-3a07-913c-4fe32511557d",
                                "text": "Il est certaines excitations redoutables pour les tuberculeux, et que des lectures mal choisies peuvent fort bien créer, entretenir, développer. Le bromure et les douches froides s’imposent alors."
                            },
                            {
                                "example_id": "b050e68b-0cab-446e-9a12-7e1bfa214445",
                                "sense_id": "7156d4e3-36aa-3a07-913c-4fe32511557d",
                                "text": "On évitera de préférence en culture maraîchère les nématicides contenant du brome, comme le dibromoéthane ou le bromure de méthyle ; […]."
                            }
                        ]
                    },
                    {
