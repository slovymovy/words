                        "examples": [
                            {
                                "example_id": "5ff35ef0-f587-47b3-a57a-35b2331893dd",
                                "sense_id": "e511229c-55e3-3b4f-ab13-c4da6a2f00ac",
                                "text": "„Da Naz, a niederösterreichischer Baurnbui, geht in d’Fremd.“"
                            },
                            {
                                "example_id": "b5330595-6cfd-4a2b-bcc0-9a3b5580527d",
                                "sense_id": "e511229c-55e3-3b4f-ab13-c4da6a2f00ac",
                                "text": "„»Der Badhuiber Naz! Was, der Naz? Ja, der ist's, der Naz ist's.«“"
                            },
                            {
                                "example_id": "314c59a5-c56d-4f15-aa73-4b6d1dc314e1",
                                "sense_id": "e511229c-55e3-3b4f-ab13-c4da6a2f00ac",
                                "text": "„Der Naz und die Dorth sagten einander nicht schöne Worte, aber sie zankten sich nicht miteinander“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
