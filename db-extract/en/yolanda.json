{
    "word": "yolanda",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7720effc-67f5-39da-b546-c8727835ca0a",
                "word": "Yolanda",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a65a331d-2a7a-3c4e-8005-a2598981e25f",
                        "entry_id": "7720effc-67f5-39da-b546-c8727835ca0a",
                        "glosses": [
                            "A female given name from Spanish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80bc562-591b-4856-b49b-ae115e84b94c",
                                "sense_id": "a65a331d-2a7a-3c4e-8005-a2598981e25f",
                                "text": "I chose the name Yolanda Denise, but my husband had reservations about it. He questioned whether people would call her Yolanda or mispronounce the name. He was right. Her name is so frequently mispronounced that it bothers her. There is a tendency among middle-class Negroes to give their children unusual names. Perhaps they are seeking elegance or some special identification. I fell victim to this custom, rather than following the sensible practice of naming the baby after a member of the family."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03222353-cae0-44bf-a2de-5a47343b0d65",
                        "source_entry_id": "7720effc-67f5-39da-b546-c8727835ca0a",
                        "source_sense_id": "a65a331d-2a7a-3c4e-8005-a2598981e25f",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Yolande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yolande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4822371f-0eb2-3327-801d-054265365e6e",
                                        "entry_id": "bd5bc21b-4147-3faa-80a0-72f71963e19f",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f333e397-4251-4384-9c91-56f6a030d404",
                                                "sense_id": "4822371f-0eb2-3327-801d-054265365e6e",
                                                "text": "Nul homme n’eût vu Yolande sans en devenir amoureux, mais être aimé d’elle était une chimère que bien peu se permettaient de caresser."
                                            },
                                            {
                                                "example_id": "fd241172-d076-4096-9191-e9f44c8de001",
                                                "sense_id": "4822371f-0eb2-3327-801d-054265365e6e",
                                                "text": "Yolande Serruzier s’était réinstallée confortablement."
                                            },
                                            {
                                                "example_id": "da2e5545-c5a2-4326-9e4b-4eec079577bd",
                                                "sense_id": "4822371f-0eb2-3327-801d-054265365e6e",
                                                "text": "La Yolande de Bourgbarré qui, elle, voulait que je te demande de faire curer le doué (lavoir) toutes les semaines."
                                            },
                                            {
                                                "example_id": "c4215af1-b410-49a7-9fb7-29cfb5c191c4",
                                                "sense_id": "4822371f-0eb2-3327-801d-054265365e6e",
                                                "text": "Yolande, si heureuse d’avoir tout vendu et prétendant qu’on lui a porté chance, nous offre un carré de Bray avec une bouteille de cidre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21af90bc-de56-4084-8efd-fe3b7ab529f5",
                        "source_entry_id": "7720effc-67f5-39da-b546-c8727835ca0a",
                        "source_sense_id": "a65a331d-2a7a-3c4e-8005-a2598981e25f",
