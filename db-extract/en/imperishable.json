                                        "examples": [
                                            {
                                                "example_id": "60a6c702-51d6-417b-8903-8364257b751a",
                                                "sense_id": "a493999b-77f8-3127-81ae-9dab45edf1ea",
                                                "text": "Maar die nummers bleken vreemd onvergankelijk, en in de loop van de jaren groeide mijn affectie voor Barry White - die stem, de uitgekiende ritmes, dit was wel degelijk ook soul."
                                            }
                                        ]
