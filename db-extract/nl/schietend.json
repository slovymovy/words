        "nl-extract.jsonl": [
            {
                "entry_id": "6965cb97-f6dc-3746-91c0-47deb57e86c0",
                "word": "schietend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4177b7b1-1718-38e2-93d9-9bd657272aa2",
                        "entry_id": "6965cb97-f6dc-3746-91c0-47deb57e86c0",
                        "glosses": [
                            "heel snel gaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfdef2af-1f78-4a5a-b0a2-13ca0c807169",
                                "sense_id": "4177b7b1-1718-38e2-93d9-9bd657272aa2",
                                "text": "Volgens de veiligheidsregio waren er twee mensen aan boord. Eentje, de 39-jarige eigenaar van het schip uit Rilland, is door een te hulp schietende boot uit het water gehaald."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7fd5af9-2f3a-3fd9-ac46-73d968c7d75c",
                        "entry_id": "6965cb97-f6dc-3746-91c0-47deb57e86c0",
                        "glosses": [
                            "een schietwapen gebruikend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e867d76-a6d5-4b8e-8fcc-42aa2b585bec",
                                "sense_id": "c7fd5af9-2f3a-3fd9-ac46-73d968c7d75c",
                                "text": "Het panel - zeven scherp schietende buurtkinderen - spuit keer op keer de wapens leeg."
                            },
                            {
                                "example_id": "8efb5675-9cfd-47d2-b3c0-9dbd8957604e",
                                "sense_id": "c7fd5af9-2f3a-3fd9-ac46-73d968c7d75c",
                                "text": "Ik ben blij dat ik op dit moment niet op zoek ben naar een huis. Veilingsites zijn voor mij verboden terrein. Dat heb ik met mezelf afgesproken. Ik krijg een waas voor mijn ogen als ik op zo'n site zit. Voor ik het weet, bied ik fanatiek mee op een avondje onbeperkt spareribs eten in Barneveld. Als vegetariër uit Rotterdam. Of ik heb ineens een dagje horrorpaintball ‘gewonnen'. Waardoor ik op mijn vrije dag tegen een stelletje verf schietende zombies moet strijden. Die veilingssites triggeren een combinatie van hebzucht en competitiedrang, waardoor ik me er helemaal in kan verliezen."
                            }
                        ]
                    }
