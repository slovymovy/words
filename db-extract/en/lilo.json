                                        "glosses": [
                                            "opblaasbare matras, erg praktisch bij het kamperen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa1f59d-7397-4b63-a275-e635f49cf92f",
                                                "sense_id": "fab70b43-585f-3c17-9c00-775302b9d289",
                                                "text": "Met mijn luchtbed op het grondzeil kroop ik mijn slaapzak in en keek omhoog naar de sterren in de hemel."
                                            }
                                        ]
                                    }
                                ]
                            }
