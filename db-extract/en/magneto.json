                        "form_id": "5d61a572-7a79-403b-8f7d-532f4d1cffb4",
                        "entry_id": "24fd6f04-6b5b-3bd1-a4df-94613d51f792",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnetos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21a382bd-11d2-3704-8f85-64a67c5c50e0",
                        "entry_id": "24fd6f04-6b5b-3bd1-a4df-94613d51f792",
                        "glosses": [
                            "A small magnetic dynamo, especially one that provides power to the spark plugs of a small internal combustion engine (now mostly used in aircraft)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f797aa1f-de10-48c1-9dfc-aee543b5e831",
                                "sense_id": "21a382bd-11d2-3704-8f85-64a67c5c50e0",
                                "text": "Black tracks on the magneto, a hairline crack in the flywheel casing, pitted points or a spitless exhaust — all are clues to potential conkouts"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d76ab8e5-8832-4ab5-9aa8-86e71c5dc6f1",
                        "source_entry_id": "24fd6f04-6b5b-3bd1-a4df-94613d51f792",
                        "source_sense_id": "21a382bd-11d2-3704-8f85-64a67c5c50e0",
                        "source_sense_description": "Translations",
                        "target_lang_word": "magnéto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnéto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b999cf9-1df0-3eb0-99fc-5a0a2eed316d",
                                        "entry_id": "9ab34c4e-93f0-3c03-9096-87e85ce8b916",
                                        "glosses": [
                                            "Appareil dont l’aimant permanent produit un champ inducteur et un courant électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e9946d-dcc6-4783-a44a-2cb45df62785",
                                                "sense_id": "0b999cf9-1df0-3eb0-99fc-5a0a2eed316d",
                                                "text": "Des boutefeux sont spécialement chargés du tir des mines. Ce tir se fait électriquement : les boutefeux emportent avec eux la magnéto de tir, les fils de raccord et les amorces."
                                            },
                                            {
                                                "example_id": "2248ac53-6d4f-4ac9-a899-b8a544b1f3c2",
                                                "sense_id": "0b999cf9-1df0-3eb0-99fc-5a0a2eed316d",
                                                "text": "Près de mon oreille avait jailli une longue étincelle et je sentis dans ma poitrine mon cœur s'emballer. Je me tordais en hurlant et me raidissais à me blesser, tandis que les secousses commandées par Cha....., magnéto en mains, se succédaient sans arrêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f6b441a-8900-31c3-8090-6b3840166bbc",
                                        "entry_id": "9ab34c4e-93f0-3c03-9096-87e85ce8b916",
                                        "glosses": [
                                            "Appareil électrique qui produit l'étincelle nécessaire à l'allumage de certains types de moteur à explosion."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "magnéto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4c6839-1c14-38be-adf9-36f32f01d393",
                                        "entry_id": "0995e45b-5e4c-3586-8e5d-581ee197fecd",
                                        "glosses": [
                                            "Magnétophone."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61eaca00-6489-41fb-9262-957f8f62014f",
                                                "sense_id": "bc4c6839-1c14-38be-adf9-36f32f01d393",
                                                "text": "Mon magnéto a rendu l'âme, par chance, j'ai fini le gros des enregistrements."
                                            },
                                            {
                                                "example_id": "29ab61e6-31d3-4738-a305-e13495a32656",
                                                "sense_id": "bc4c6839-1c14-38be-adf9-36f32f01d393",
                                                "text": "Il ne se contentera pas de laisser tourner les bandes du magnéto, comme l’ont fait avant lui les gens de chez Blue Note (avec délices) ou Prestige (avec désinvolture). Il tentera d’infléchir le cours de la vie artistique de Monk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab6eb38-e0dd-32fb-8a49-7627f0c674ae",
                                        "entry_id": "0995e45b-5e4c-3586-8e5d-581ee197fecd",
                                        "glosses": [
                                            "Magnétoscope."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
