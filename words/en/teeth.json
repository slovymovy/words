            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa522472-5591-3ad7-a7d8-456a59df2d81",
                    "sense_definition": "The plural of <w>tooth</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should brush your <w>teeth</w> at least twice a day to keep them healthy.",
                            "target_lang_translations": {
                                "ru": "Вам следует чистить <w>зубы</w> как минимум дважды в день, чтобы они оставались здоровыми."
                            }
                        },
                        {
                            "text": "The dentist checked all my <w>teeth</w> and said I have no cavities.",
                            "target_lang_translations": {
                                "ru": "Стоматолог проверил все мои <w>зубы</w> и сказал, что у меня нет кариеса."
                            }
                        }
                    ],
                    "synonyms": [
                        "pearly whites"
                    ],
                    "common_phrases": [
                        "brush your teeth",
                        "white teeth",
                        "front teeth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова tooth (зуб)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубы",
                                "target_lang_sense_clarification": "костные образования во рту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e37917df-4f68-36ba-b5b3-ae6555b843c1",
                    "sense_definition": "The power or ability to be effectively enforced or to have a real impact",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effectiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international community's sanctions against the regime had some <w>teeth</w> to them this time around.",
                            "target_lang_translations": {
                                "ru": "На этот раз санкции международного сообщества против режима показали свои <w>зубы</w>."
                            }
                        },
                        {
                            "text": "Without a way to fine companies, the new environmental law has no <w>teeth</w>.",
                            "target_lang_translations": {
                                "ru": "Без возможности штрафовать компании новый экологический закон не имеет реальной <w>силы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "enforceability"
                    ],
                    "common_phrases": [
                        "have some teeth",
                        "law with teeth",
                        "give it teeth"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in political or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила или способность быть эффективно примененным или иметь реальное влияние"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубы",
                                "target_lang_sense_clarification": "в переносном смысле о законе или санкциях"
                            },
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "эффективность воздействия"
                            },
                            {
                                "target_lang_word": "действенность",
                                "target_lang_sense_clarification": "способность приносить результат"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0cce5e8d-d618-37b4-8b3a-ec28e0e0501a",
                    "sense_definition": "A dated spelling of <w>teethe</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A mother should not worry just because her baby <w>teeths</w> later than her neighbor's baby.",
                            "target_lang_translations": {
                                "ru": "Матери не стоит беспокоиться только из-за того, что у её ребенка зубы <w>прорезываются</w> позже, чем у соседского."
                            }
                        },
                        {
                            "text": "The infant <w>teethed</w> for several weeks before the first tooth finally appeared.",
                            "target_lang_translations": {
                                "ru": "У младенца зубы <w>прорезывались</w> в течение нескольких недель, прежде чем наконец появился первый зуб."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "modern spelling is teethe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова teethe (прорезываться о зубах)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорезываться",
                                "target_lang_sense_clarification": "о зубах у младенца"
                            }
                        ]
                    }
                }
            ]
        }
    ]
