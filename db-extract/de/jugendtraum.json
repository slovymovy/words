                "senses": [
                    {
                        "sense_id": "ecbefee0-d181-359c-8680-b55389c1099d",
                        "entry_id": "f43ce367-b3a1-349c-bed3-0d4f7cf1653a",
                        "glosses": [
                            "Wunschvorstellung, die sich eine Person in der Jugend von der eigenen Zukunft ausmalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6cb590d-1a67-40e0-9a40-ffeaf5ff6606",
                                "sense_id": "ecbefee0-d181-359c-8680-b55389c1099d",
                                "text": "„Seine Jugendträume von Schießereien, Schlägereien und Messerstechereien hatten aufgehört.“"
                            },
                            {
                                "example_id": "6586a4ad-c51a-4abf-9ad7-db5a8a31b845",
                                "sense_id": "ecbefee0-d181-359c-8680-b55389c1099d",
                                "text": "„Sie hatte an Dominic monatelang nicht einmal gedacht, und jetzt fluteten alle ihre Jugendträume zurück und verwirrten sie durch ihre Präsenz und Intensität.“"
                            },
                            {
                                "example_id": "c4771bd7-117e-4aeb-82e4-82c05a1b4027",
                                "sense_id": "ecbefee0-d181-359c-8680-b55389c1099d",
                                "text": "„Sie will sich einen Jugendtraum erfüllen und die Vulkane Ätna und Vesuv besteigen, in luftigen Musselinkleidern durch die mediterrane Landschaft wandern und die Kirchen und Ruinen der zahlreichen früheren Eroberer besichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
