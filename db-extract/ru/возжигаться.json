                "senses": [
                    {
                        "sense_id": "cbe6cf62-5834-378c-84f3-2301deec7f92",
                        "entry_id": "0fbd24f8-3443-3e0a-8d75-66ed911b4b9e",
                        "glosses": [
                            "устар. страд. к возжигать; воспламеняться, загораться"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "decfbc2a-bed4-4d2b-8499-439c86396508",
                                "sense_id": "cbe6cf62-5834-378c-84f3-2301deec7f92",
                                "text": "В день рождения и в день смерти матушки перед её портретом возжигались настоящие восковые свечи и в комнате едва ощутимо пахло пчельником."
                            }
                        ]
                    },
                    {
                        "sense_id": "764d48c2-3252-372d-9d19-230732dd0867",
                        "entry_id": "0fbd24f8-3443-3e0a-8d75-66ed911b4b9e",
                        "glosses": [
                            "перен. устар. возбуждаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaa26af7-aa8c-408f-8b48-1074cc0796e3",
                                "sense_id": "764d48c2-3252-372d-9d19-230732dd0867",
                                "text": "Тогда он уразумел, что невозможно найти насыщения во грехах: потому что, чем более человек предаётся им, тем большим вожделением их возжигается."
                            }
                        ]
                    }
