                                        "entry_id": "c043f753-1eca-3ee0-a690-552e8b6a7373",
                                        "glosses": [
                                            "sygnalizuje treść przeciwstawną do tego, co było powiedziane przed chwilą"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4951f7f-28f6-424e-ae8a-b49ab5c17615",
                                                "sense_id": "3b2b9321-3141-38e0-93f4-91ae5d89a276",
                                                "text": "Lubię horrory, tymczasem moja żona woli komedie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "240bea96-851b-3a85-b04e-c47fde6f2b0a",
                                        "entry_id": "c043f753-1eca-3ee0-a690-552e8b6a7373",
                                        "glosses": [
                                            "sygnalizuje treść niezgodną z oczekiwaniami wyrażonymi w pierwszej części zdania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc30456-8159-4ca1-ae8d-aba307cf2341",
                                                "sense_id": "240bea96-851b-3a85-b04e-c47fde6f2b0a",
                                                "text": "Miałem nadzieję, że na urlopie wypocznę, tymczasem okazał się bardziej męczący od pracy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tymczasem",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd286ef9-62cd-3f43-9134-dbc8058c3af4",
                                        "entry_id": "00da8ae6-8d27-36c7-b3d1-ae60d6ae27f7",
                                        "glosses": [
                                            "w tym samym czasie, o którym była mowa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35e232a-ec67-409a-a6a5-945307165da8",
                                                "sense_id": "cd286ef9-62cd-3f43-9134-dbc8058c3af4",
                                                "text": "My tu sobie rozmawiamy, tymczasem dzieci podkradają ciasto!"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    },
                                    {
                                        "sense_id": "baa1b7ef-b338-33f5-9520-c890973c9a3a",
                                        "entry_id": "00da8ae6-8d27-36c7-b3d1-ae60d6ae27f7",
                                        "glosses": [
                                            "do tego czasu, o którym była mowa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af4a26b-50cd-49bb-83a7-32e595d976fd",
                                                "sense_id": "baa1b7ef-b338-33f5-9520-c890973c9a3a",
                                                "text": "Może jeszcze kiedyś będę miał dzieci, tymczasem jednak przestań mnie o nie męczyć, mamo."
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
