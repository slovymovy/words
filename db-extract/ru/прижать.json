                "senses": [
                    {
                        "sense_id": "eb2470ad-f73f-379b-b39d-d74632b4f6c8",
                        "entry_id": "68555a28-d4a9-36d7-a96c-c4c1c07c883f",
                        "glosses": [
                            "to press (to), to clasp (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e838f8e7-c2c5-45bd-a329-d6781b00f20f",
                                "sense_id": "eb2470ad-f73f-379b-b39d-d74632b4f6c8",
                                "text": "прижа́ть к груди́",
                                "translation": "to clasp/press to one's breast/bosom",
                                "english": "to clasp/press to one's breast/bosom"
                            },
                            {
                                "example_id": "c885459c-a6e5-4076-91cc-5b6802f3894d",
                                "sense_id": "eb2470ad-f73f-379b-b39d-d74632b4f6c8",
                                "text": "прижа́ть проти́вника к земле́",
                                "translation": "to keep the enemy's heads down; to pin the enemy down to the ground",
                                "english": "to keep the enemy's heads down; to pin the enemy down to the ground"
                            },
                            {
                                "example_id": "a1f5e6b4-3f98-45de-b6ef-45990dde2ebc",
                                "sense_id": "eb2470ad-f73f-379b-b39d-d74632b4f6c8",
                                "text": "прижа́ть у́ши",
                                "translation": "to lay back its ears",
                                "english": "to lay back its ears"
                            },
                            {
                                "example_id": "4e2eaa7a-5383-492d-bfb0-7716b550c6e1",
                                "sense_id": "eb2470ad-f73f-379b-b39d-d74632b4f6c8",
                                "text": "прижа́ть к стене",
                                "translation": "to drive into a corner",
                                "english": "to drive into a corner"
                            }
                        ]
                    },
                    {
                        "sense_id": "a33a81ed-69e4-3506-bbbc-d014e549d329",
                        "entry_id": "68555a28-d4a9-36d7-a96c-c4c1c07c883f",
                        "glosses": [
                            "to press hard, to put in a tight situation"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3038062e-c80c-47b5-945f-cdbe66bc1367",
                                "sense_id": "a33a81ed-69e4-3506-bbbc-d014e549d329",
                                "text": "вида́ть, его́ действи́тельно прижа́ло",
                                "translation": "it seems he found himself in a really tight situation",
                                "english": "it seems he found himself in a really tight situation"
                            },
                            {
                                "example_id": "cf42c391-c90f-496c-b0cf-dca784871242",
                                "sense_id": "a33a81ed-69e4-3506-bbbc-d014e549d329",
                                "text": "е́сли прижмёт",
                                "translation": "if it comes to the push; at a pinch/push ; in a pinch",
                                "english": "if it comes to the push; at a pinch/push ; in a pinch"
                            }
                        ]
                    }
