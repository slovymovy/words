                "senses": [
                    {
                        "sense_id": "59ed3a90-8c87-3cfd-9e2e-688133718859",
                        "entry_id": "d90b6477-480e-30c5-af65-6ea820003622",
                        "glosses": [
                            "Se stimuler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74eab34b-4f70-4226-b595-3bd8ed2e44b3",
                                "sense_id": "59ed3a90-8c87-3cfd-9e2e-688133718859",
                                "text": "Il insiste sur le fait que l'homme peut retarder sa réponse, choisir entre plusieurs réponses, qu'il peut s'auto-stimuler, s'auto-conditionner."
                            },
                            {
                                "example_id": "99178c95-cc01-4151-b21e-f52b2b39c351",
                                "sense_id": "59ed3a90-8c87-3cfd-9e2e-688133718859",
                                "text": "Des rats apprennent très vite à s' auto-stimuler;"
                            },
                            {
                                "example_id": "d0df7436-5392-4bf9-853b-7955a0d85df7",
                                "sense_id": "59ed3a90-8c87-3cfd-9e2e-688133718859",
                                "text": "Le tout petit est stimulé par ce qu'il entend de l'autre, ce qui le conduit à s'auto-stimuler."
                            }
                        ]
                    }
