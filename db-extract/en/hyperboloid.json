                        "source_entry_id": "68ff39b0-e901-3d8f-83ed-be11b5f99cc5",
                        "source_sense_id": "5c57df7b-ccff-34da-8469-f9c7133a4afe",
                        "source_sense_description": "surface in three-dimensional space",
                        "target_lang_word": "hyperboloïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperboloïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7bab529-deb3-373f-bec2-2c23205c2939",
                                        "entry_id": "d44734dd-07b1-335a-9bc7-ef2560bb0bc3",
                                        "glosses": [
                                            "Qui ressemble à une hyperbole ; qui rappelle l’hyperbole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf8229b6-26a6-4d4e-be7f-5c605cacc91b",
                                                "sense_id": "c7bab529-deb3-373f-bec2-2c23205c2939",
                                                "text": "Les vanniers font des corbeilles qui ressemblent aux tables hyperboloïdes. Ils lient à une baguette droite, un cercle d'osier destiné à former le pied de la corbeille, puis la volette circulaire du fond, puis le cercle d'osier du bord. Le rayon de la volette est moindre que celui du pied et il en est de même de ce dernier relativement au rayon du bord."
                                            },
                                            {
                                                "example_id": "a7fd9763-e07e-4221-9ba6-95a3e66f0682",
                                                "sense_id": "c7bab529-deb3-373f-bec2-2c23205c2939",
                                                "text": "Petits chapeaux à grands bords, grands chapeaux à petits bords, troncs de cône, cylindres, hyperboloïdes, il les connaissait tous […]."
                                            },
                                            {
                                                "example_id": "16c16ea9-e195-498f-9938-aa9d49ec9d0e",
                                                "sense_id": "c7bab529-deb3-373f-bec2-2c23205c2939",
                                                "text": "D’après les explications de Vincent, l’ambitus total des diverses régions vocales serait d’environ deux octaves, plus la partie réservée à la voix hyperboloïde ou de soprano."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hyperboloïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bbb9dc6-df7d-38b8-9ae1-6975cfa35933",
                                        "entry_id": "e65f1f59-b36a-320b-9fc1-bcadc68872d5",
                                        "glosses": [
                                            "Surface engendrée par le déplacement d’une hyperbole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac886ba-58ad-4f4a-9e8f-149406fd7932",
                                                "sense_id": "2bbb9dc6-df7d-38b8-9ae1-6975cfa35933",
                                                "text": "Ces points se trouvent sur un hyperboloïde de révolution ayant les sources pour foyers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
