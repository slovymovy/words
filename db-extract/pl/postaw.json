                ],
                "translations": [
                    {
                        "translation_id": "fc19f815-69e6-4e31-a5eb-49062577d715",
                        "source_entry_id": "fa4a686a-ee81-3737-96d3-d803855085f7",
                        "source_sense_id": "a19fa4fd-060b-3791-9bd8-8f8d69faa030",
                        "target_lang_word": "Kern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d476968-4cd4-3474-bd05-efaf68070ddb",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "in der Mitte befindlicher Hauptbestandteil eines Ganzen; Basis, Zentrum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b04da49-c9ea-4f8f-98d8-f36520f8a9fd",
                                                "sense_id": "7d476968-4cd4-3474-bd05-efaf68070ddb",
                                                "text": "Im Kern der Stadt liegt die Kirche mit Marktplatz."
                                            },
                                            {
                                                "example_id": "53d439ba-1a00-480c-b014-1c88eed9e86b",
                                                "sense_id": "7d476968-4cd4-3474-bd05-efaf68070ddb",
                                                "text": "„Im Unterhaltsstreit geht es im Kern darum, ob, in welcher Höhe und für welchen Zeitraum die eine Partei der anderen Unterhalt schuldet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc28331c-1fe5-37a9-8e30-2826d2f4a72b",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "Menge aller Elemente, die auf das neutrale Element abgebildet werden"
                                        ],
                                        "tags": [
                                            "Algebra"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c6675c5-1427-44d3-81f2-be65311af176",
                                                "sense_id": "fc28331c-1fe5-37a9-8e30-2826d2f4a72b",
                                                "text": "„Enthält [der Gruppenhomomorphismus] nur das neutrale Element bzw. den Nullvektor, so nennt man den Kern trivial“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5af0a46a-ebc1-3487-b2fb-d4ed1e9507b1",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "Stein^([10]) der Steinfrüchte; innen befindlicher Teil, fester Teil von Früchten oder Samen von Früchten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a27666f8-2f87-4851-bf9f-1074da004f87",
                                                "sense_id": "5af0a46a-ebc1-3487-b2fb-d4ed1e9507b1",
                                                "text": "Pfirsiche haben große, harte Kerne."
                                            },
                                            {
                                                "example_id": "370ab575-83c7-49ce-a729-9bf63e244b0b",
                                                "sense_id": "5af0a46a-ebc1-3487-b2fb-d4ed1e9507b1",
                                                "text": "„Wir hatten im Freibad eine Decke im Schatten ausgerollt, uns auf den Rücken gelegt, Kirschen ausgepackt und versucht, die Kerne so hoch wie möglich zu spucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c3d460e2-b659-38bf-8a7a-6135eafda78a",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "Innenteile des Fruchtkerns/der Fruchthülle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d93b77-7c31-4cc9-aa6c-2e0e80094c5d",
                                                "sense_id": "c3d460e2-b659-38bf-8a7a-6135eafda78a",
                                                "text": "Einzeln stehende Kastanien tragen keine Früchte oder nur unbefruchtete Nüsse ohne Kern."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "02bb255c-72c4-3e33-9272-fc29f905cc5c",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "enthülstes Getreidekorn, meist Dinkelkorn"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a284d531-2866-310d-8fba-fc9809421298",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "Zellkern"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b79307c-a91d-4f5b-a6b3-cda14b969be9",
                                                "sense_id": "a284d531-2866-310d-8fba-fc9809421298",
                                                "text": "„In Embryonen der Fruchtfliege teilen sich Kerne sehr schnell, ohne dass zunächst trennende Zellmembranen entstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "08da5fea-7eda-30df-ad63-707dc25b7b81",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "Atomkern"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b9d486-8249-45b1-92f0-ea4042533d7c",
                                                "sense_id": "08da5fea-7eda-30df-ad63-707dc25b7b81",
                                                "text": "Nach dem klassischen Modell kreisen die Elektronen um den Kern."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "0e87b5cc-9ed9-3b69-868a-ab774ffe986a",
