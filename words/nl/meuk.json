            "senses": [
                {
                    "sense_id": "f6da7cb4-824f-325f-8646-d6024d105539",
                    "sense_definition": "Rommel of spullen van lage kwaliteit die weinig tot geen waarde hebben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde al die oude <w>meuk</w> eindelijk eens weggooien.",
                            "target_lang_translations": {
                                "en": "He finally wanted to throw away all that old <w>junk</w>."
                            }
                        },
                        {
                            "text": "Koop geen goedkope <w>meuk</w> die na een week al kapot gaat.",
                            "target_lang_translations": {
                                "en": "Don't buy cheap <w>trash</w> that breaks after just a week."
                            }
                        }
                    ],
                    "synonyms": [
                        "troep",
                        "rommel",
                        "rotzooi",
                        "bucht"
                    ],
                    "common_phrases": [
                        "oude meuk",
                        "goedkope meuk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel woord voor troep of rommel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Junk, trash, or low-quality stuff that has little to no value"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "junk",
                                "target_lang_sense_clarification": "useless or low-quality items"
                            },
                            {
