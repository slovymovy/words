        "nl-extract.jsonl": [
            {
                "entry_id": "33ba1375-b408-349b-8881-73bd88b9eaf6",
                "word": "illustratie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "04da4d94-9370-4faa-aaf5-6dffdac9c21c",
                        "entry_id": "33ba1375-b408-349b-8881-73bd88b9eaf6",
                        "tags": [
                            "plural"
                        ],
                        "form": "illustraties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fef0658-0fb1-34f4-a2bf-e9487c3bd1e7",
                        "entry_id": "33ba1375-b408-349b-8881-73bd88b9eaf6",
                        "glosses": [
                            "afbeelding in een boek of tijdschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1597c7-992d-4170-be16-777081c3286c",
                                "sense_id": "2fef0658-0fb1-34f4-a2bf-e9487c3bd1e7",
                                "text": "Er ging een hele nieuwe wereld voor me open door opeens met woorden te moeten schilderen. Als art director in de reclame was ik altijd al visueel ingesteld, degene die verhalen vertelt op een beeldende manier, door middel van illustraties, fotografie of film."
                            }
                        ]
                    },
                    {
                        "sense_id": "d47619f4-e663-3ebf-9492-3ed9a5931cc0",
                        "entry_id": "33ba1375-b408-349b-8881-73bd88b9eaf6",
                        "glosses": [
                            "mededeling ter toelichting of verduidelijking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "759a6069-b561-4df5-b0cb-1cf7d0edca28",
                                "sense_id": "d47619f4-e663-3ebf-9492-3ed9a5931cc0",
                                "text": "Minder toerisme bedreigt immers het voortbestaan van veel eilandbewoners op de korte termijn. Ik betwijfel of dit is wat de Lonely Planet bedoelt wanneer ze de Malediven beschrijven als ‘the world in an island’, maar het is wrange allegorie. Voor zover we in een eindtijd leven, is deze clusterfuck de illustratie ervan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b27d62a2-f003-439f-b4d7-2ee2aaad652a",
                        "source_entry_id": "33ba1375-b408-349b-8881-73bd88b9eaf6",
                        "target_lang_word": "illustration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illustration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f59220f-a755-3841-b4a6-6640203113cf",
                                        "entry_id": "24fc8b26-7d88-3dec-b0f0-48fbd60062ff",
                                        "glosses": [
                                            "The act of illustrating; the act of making clear and distinct."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34a21073-5ebe-3a9d-b331-df66b41f49ee",
                                        "entry_id": "24fc8b26-7d88-3dec-b0f0-48fbd60062ff",
                                        "glosses": [
                                            "The state of being illustrated, or of being made clear and distinct."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "796170bb-3692-335e-99fe-4734240b4b0c",
                                        "entry_id": "24fc8b26-7d88-3dec-b0f0-48fbd60062ff",
                                        "glosses": [
                                            "Something which illustrates; a comparison or example intended to make clear or apprehensible, or to remove obscurity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b960268-ea19-4d24-804e-5d98273e2512",
                                                "sense_id": "796170bb-3692-335e-99fe-4734240b4b0c",
                                                "text": "England will regard it as a measure of justice for Frank Lampard's disallowed goal against Germany in Bloemfontein at the 2010 World Cup - but it was also an illustration of how they rode their luck for long periods in front of a predictably partisan home crowd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6463827e-9253-38c6-8715-8760e8da3221",
                                        "entry_id": "24fc8b26-7d88-3dec-b0f0-48fbd60062ff",
                                        "glosses": [
                                            "A picture designed to decorate a publication, or elucidate a literary work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c93919-4212-4194-98d1-47081806c7a9",
                                                "sense_id": "6463827e-9253-38c6-8715-8760e8da3221",
                                                "text": "The illustration showing the water cycle made it much easier to understand for the children."
                                            },
                                            {
                                                "example_id": "4533ee40-98d7-48da-b0f6-9898ec409ad6",
                                                "sense_id": "6463827e-9253-38c6-8715-8760e8da3221",
                                                "text": "The sleeve of the band's new CD includes illustrations from deceased former members."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bdc5190-e2d9-3d1d-abf8-19d2b4868c37",
                                        "entry_id": "24fc8b26-7d88-3dec-b0f0-48fbd60062ff",
                                        "glosses": [
                                            "A calculated prevision of insurance premiums and returns (life insurance)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e18e809e-5845-49c3-90fa-0d4443ed5237",
                        "source_entry_id": "33ba1375-b408-349b-8881-73bd88b9eaf6",
                        "target_lang_word": "illustration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illustration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52a96b09-7ca9-3149-b472-314209b84f09",
                                        "entry_id": "6daa7831-0521-3b12-a273-c14e966164ce",
                                        "glosses": [
                                            "Dessin pour accompagner du texte, en particulier de la presse écrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4426e712-9090-4c4a-8773-bcc3701657e0",
                                                "sense_id": "52a96b09-7ca9-3149-b472-314209b84f09",
                                                "text": "Les journaux et les magazines qui alimentaient les cerveaux américains (…) devinrent instantanément un feu d’artifice où les illustrations et les titres de colonnes s’enlevaient comme des fusées et éclataient comme des bombes."
                                            },
                                            {
                                                "example_id": "7db1226a-cc3f-4a69-8e9b-037ccc49dd51",
                                                "sense_id": "52a96b09-7ca9-3149-b472-314209b84f09",
                                                "text": "Les transis des livres d’heures et les illustrations du Dict des trois morts et des trois vifs insistent sur le cadavre et les signes de la décomposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a51348d-5aea-3c21-bc05-c81bc0f1191b",
                                        "entry_id": "6daa7831-0521-3b12-a273-c14e966164ce",
                                        "glosses": [
                                            "Photographie, dessin, graphe, etc., composés pour être intercalés dans le texte d’un livre ou d’un journal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6862ee-f6ad-43a2-b2be-5aba9a52d896",
                                                "sense_id": "5a51348d-5aea-3c21-bc05-c81bc0f1191b",
                                                "text": "Des illustrations en noir et blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                                        "entry_id": "6daa7831-0521-3b12-a273-c14e966164ce",
                                        "glosses": [
                                            "Action d’illustrer ou état de ce qui est illustre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a62be04-b593-4383-aff2-e7c64e93ac50",
                                                "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                                                "text": "Les victoires qui contribuèrent à l’illustration du règne de Louis XIV, à l’illustration du nom français."
                                            },
                                            {
                                                "example_id": "0136ae8d-b084-4165-97a2-749c9c675beb",
                                                "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                                                "text": "Acquérir de l’illustration, une grande illustration."
                                            },
                                            {
                                                "example_id": "072f375a-e07a-4772-8d7e-0c30d5351506",
                                                "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                                                "text": "C’est une famille noble et ancienne, mais sans illustration."
                                            },
                                            {
                                                "example_id": "3ccdcb41-3bac-4530-8fb6-d8ab3447b6e3",
                                                "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                                                "text": "Je suis issu d’une famille très ancienne, mais qui n’a eu que peu d’illustration et moins encore de biens."
                                            },
                                            {
                                                "example_id": "3cc4e583-b105-484f-97d6-e6d88686cee2",
                                                "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                                                "text": "On voit à la manière dont le regarde et l’écoute sa femme, qu’elle croit au génie et à l’illustration de son mari."
                                            },
                                            {
                                                "example_id": "b5383ef9-378e-42a2-a28e-ac51ea332104",
                                                "sense_id": "9bc07e2e-e99f-3f65-914b-db9d93672149",
                                                "text": "Bref, capitaine, quelque illustration qu’ait eue cette famille dans les temps passés, elle est aujourd’hui éprouvée d’un malheur qu’il faut savoir nommer : la pauvreté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474edd31-c15c-356e-a896-aaa8c93935b7",
                                        "entry_id": "6daa7831-0521-3b12-a273-c14e966164ce",
                                        "glosses": [
                                            "Personnage célèbre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f858954a-fa0a-4b5b-87de-d20557e434aa",
                                                "sense_id": "474edd31-c15c-356e-a896-aaa8c93935b7",
                                                "text": "Des hommes du pays montraient la Villa Bergougnard à des illustrations :\n« C’est là que demeure le philosophe, disaient-ils en étendant les bras vers la villa, — c’est là que M. Bergougnard écrit : De la Raison chez les Grecs… C’est la maison du sage. »"
                                            },
                                            {
                                                "example_id": "b645abff-005e-4f58-b263-43f7231365f9",
                                                "sense_id": "474edd31-c15c-356e-a896-aaa8c93935b7",
                                                "text": "Il apparaît comme le Réprouvé. […]. Mais il tient chez lui, dans son hôtel particulier, sur les boulevards extérieurs, table ouverte, et tout ce que notre admirable société recèle d’illustrations dans tous les genres et tous les goûts s'expose paisiblement, sans le moindre souci des répercussions possibles."
                                            },
                                            {
                                                "example_id": "ef6b0d02-c402-4146-9387-8be45f3178fa",
                                                "sense_id": "474edd31-c15c-356e-a896-aaa8c93935b7",
                                                "text": "Mme Frazé n’avait prié au « lunch » que des membres de sa famille, trente-trois illustrations cantonales qui remplissaient la Pélissière d’un murmure élégant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996e0298-06ad-3b18-b9ef-b18af64bf324",
                                        "entry_id": "6daa7831-0521-3b12-a273-c14e966164ce",
                                        "glosses": [
                                            "Exemple qui rend plus évident et plus clair ; explication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eecf2dac-a964-4204-a6c8-545c7029c6c6",
                                                "sense_id": "996e0298-06ad-3b18-b9ef-b18af64bf324",
                                                "text": "A contrario, mais toujours à échelle régionale, les différentiels de croissance économique génèrent de puissants mouvements centripètes vers les régions et les villes en expansion : la Chine littorale en est actuellement une bonne illustration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
