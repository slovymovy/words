        "fr-extract.jsonl": [
            {
                "entry_id": "0eff94ec-2363-387f-9071-4fa9b1fb3675",
                "word": "hertz",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "938709ad-6c5a-41bd-84df-7cf9bc05297f",
                        "entry_id": "0eff94ec-2363-387f-9071-4fa9b1fb3675",
                        "tags": [
                            "Singulier et pluriel"
                        ],
                        "form": "^((h aspiré))\\ɛʁts\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                        "entry_id": "0eff94ec-2363-387f-9071-4fa9b1fb3675",
                        "glosses": [
                            "Unité de fréquence permettant de mesurer le nombre de fois où un événement cyclique survient par seconde et dont le symbole est Hz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea831b6d-5c71-4522-999a-5bf6f0097709",
                                "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                                "text": "Le courant alternatif standard en France a une fréquence de 50 hertz."
                            },
                            {
                                "example_id": "01b82c36-7f07-41a6-9b12-cacc488f45db",
                                "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                                "text": "Le son musical le plus grave que nous percevions est de 16 hertz (celui d'un des tuyaux de l'orgue) et notre oreille ne peut aller au-delà d'une fréquence aiguë de 20 000 hertz."
                            },
                            {
                                "example_id": "f9db14fb-428f-4e22-90ef-280c055b203d",
                                "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                                "text": "À Malte, dans la grotte d’Hypogeum, est creusée de main d’homme une cavité résonatrice. Sa fréquence est de quatre-vingt-dix hertz dont l’amplification se révèle terrifiante dès l’instant où les voix émises sont basses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "311f0317-05dd-4d63-9b89-052979257829",
                        "source_entry_id": "0eff94ec-2363-387f-9071-4fa9b1fb3675",
                        "source_sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                        "source_sense_description": "Unité de mesure",
                        "target_lang_word": "Hertz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hertz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f6b9b8-9075-3f4a-9f90-c8300853b05b",
                                        "entry_id": "1e72ea9c-03ac-3f13-9402-9e5fb88f3398",
                                        "glosses": [
                                            "Maßeinheit der Frequenz; 1 Hz = 1 Schwingung pro Sekunde"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38956287-fe3e-4d7a-91ad-f65167e75b0e",
                                                "sense_id": "e9f6b9b8-9075-3f4a-9f90-c8300853b05b",
                                                "text": "„Bis heute jedoch ist das technische Kernproblem, ob nämlich die künftigen Lokomotiven elektrischen Strom zu 50 Hertz*) aus den allgemeinen Überlandleitungen der Elt-Werke tanken oder diesen Strom auf der Basis 16 2/3-Hertz-Spannung aus neu zu errichtenden Kraftstationen und Umformern beziehen sollen, noch nicht entschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6193046-aa7b-4fa6-b368-8c6c0f2338bb",
                        "source_entry_id": "0eff94ec-2363-387f-9071-4fa9b1fb3675",
