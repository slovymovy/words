                            "comparative"
                        ],
                        "form": "межгосуда́рственнее"
                    },
                    {
                        "form_id": "93c8500e-9791-40ee-ab61-8b63ff969f9e",
                        "entry_id": "8b0a46fb-b182-3eca-bb65-a6670efa1219",
                        "tags": [
