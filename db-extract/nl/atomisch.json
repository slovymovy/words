                                        ]
                                    },
                                    {
                                        "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Employing or relating to nuclear energy or processes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800abb26-f7f3-45ca-a522-a3ff273dc3b9",
                                                "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                                "text": "atomic energy; atomic bombs"
                                            },
                                            {
                                                "example_id": "821f02ab-583e-4863-8a01-bc01196e1e69",
                                                "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                                "text": "Some nutjob once built a small atomic pile in his back yard."
                                            },
                                            {
                                                "example_id": "efcedae2-c36e-4f8e-b776-2f63e2b1e3bc",
                                                "sense_id": "5b76bac4-c573-383a-ad3b-40039f461af0",
                                                "text": "Before the atomic spy Allan Nunn May left Canada to go to London, a treff in London had to be arranged for him and another agent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "260b0eff-e417-39a9-b304-a9b16065d2ae",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Employing or relating to nuclear energy or processes.",
                                            "Very strong and overpowering."
                                        ],
                                        "tags": [
