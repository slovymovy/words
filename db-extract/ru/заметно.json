                                "target_senses": [
                                    {
                                        "sense_id": "5eafdce2-4344-3b97-954c-3de5d22bc625",
                                        "entry_id": "f097c588-9e0a-3af3-b529-bb7442e18978",
                                        "glosses": [
                                            "In a noticeable way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d2c9c36-36d8-4299-a392-8ba348f88b33",
                                                "sense_id": "5eafdce2-4344-3b97-954c-3de5d22bc625",
                                                "text": "We all saw it: he paled noticeably."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a09f910-72c3-3239-9432-434341def574",
                                        "entry_id": "f097c588-9e0a-3af3-b529-bb7442e18978",
                                        "glosses": [
                                            "To a detectable degree, sufficient to be noticed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ceb0b5f-35c6-48dd-ac56-dad2bccf3b91",
                                                "sense_id": "1a09f910-72c3-3239-9432-434341def574",
                                                "text": "It suddenly became noticeably cooler when the sun went behind a cloud."
                                            },
                                            {
                                                "example_id": "c3367dd3-3a45-4e6d-b4fa-e5182aa72aa2",
                                                "sense_id": "1a09f910-72c3-3239-9432-434341def574",
                                                "text": "My best subject was the nature table, because I brought in the shiversome newts with their uterine flanged backs. I was moderately bullied. There were kids more noticeably tormentable than me."
                                            },
                                            {
                                                "example_id": "aaa11440-636c-40dd-a016-e8d441a6f8a6",
                                                "sense_id": "1a09f910-72c3-3239-9432-434341def574",
                                                "text": "A normally bustling border crossing between Tanzania and Malawi was noticeably quieter than usual on Thursday as a result of an escalating regional trade row."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ed2f522-29e4-3f08-a26b-9f61177ff4d3",
                                        "entry_id": "f097c588-9e0a-3af3-b529-bb7442e18978",
                                        "glosses": [
                                            "In truth and observably."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a127de6-9d72-4baf-a52e-9aeec71ce300",
                                                "sense_id": "5ed2f522-29e4-3f08-a26b-9f61177ff4d3",
                                                "text": "Noticeably, what had been merely annoying to her was becoming infuriating."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "305aa2e3-a95b-4e36-b5b5-8e6be7a8b05e",
                        "source_entry_id": "316beb41-7696-3089-bcf7-57824b1519b6",
                        "source_sense_id": "1cc4aad5-05a9-3a78-9c01-5479e46671aa",
