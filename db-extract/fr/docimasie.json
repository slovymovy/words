                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b818be-1237-4af3-bc02-448b3772f769",
                                                "sense_id": "a32a1619-6302-3c64-8f20-a2d4a839c686",
                                                "text": "This cannot be, by no assay of reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fbffcce-6256-376e-9b2a-ac7cb9dc6ffe",
