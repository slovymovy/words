        "fr-extract.jsonl": [
            {
                "entry_id": "e7c0b9d7-1915-3942-8d91-1313be01f0c7",
                "word": "admirable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27662053-0af5-4c48-a5b2-f17e89cf96ee",
                        "entry_id": "e7c0b9d7-1915-3942-8d91-1313be01f0c7",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "admirables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3dce081a-2752-371c-9f2c-5d99a3b53655",
                        "entry_id": "e7c0b9d7-1915-3942-8d91-1313be01f0c7",
                        "glosses": [
                            "Qui mérite ou qui attire l’admiration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aac4287-37b8-4fca-8fa1-7fbd7fd12940",
                                "sense_id": "3dce081a-2752-371c-9f2c-5d99a3b53655",
                                "text": "— Voilà, dis-je, qui est admirable.\n— Admirable ! admirable ! dit le capitaine Renaud en marchant plus vite, c’est le mot actuel ; quel mot puéril ! Je déteste l’admiration ; c’est le principe de trop de mauvaises actions. On la donne à trop bon marché à présent, et à tout le monde ; nous devons bien nous garder d’admirer légèrement."
                            },
                            {
                                "example_id": "e8c94974-9554-4e80-856c-5a2a58f18159",
                                "sense_id": "3dce081a-2752-371c-9f2c-5d99a3b53655",
                                "text": "Le reste du visage se composait d’un teint rosé, d’une lèvre mince, surmontée d’une moustache fauve et de dents admirables."
                            },
                            {
                                "example_id": "77b5475d-7645-4415-8be1-cc5696e33570",
                                "sense_id": "3dce081a-2752-371c-9f2c-5d99a3b53655",
                                "text": "L'admirable Calvignac, en équilibre au bord de sa falaise, n'a plus que 386 habitants après en avoir compté, en 1789, 900 ; …."
                            },
                            {
                                "example_id": "7a292463-83bd-4441-82ed-ea98de9931ed",
                                "sense_id": "3dce081a-2752-371c-9f2c-5d99a3b53655",
                                "text": "A cette occasion, il me revient à l'esprit certain passage de Marcel Schwob, cet admirable artiste qu'il est toujours précieux de relire […]."
                            },
                            {
                                "example_id": "f5f81770-4830-43b8-a613-fb463b2297a5",
                                "sense_id": "3dce081a-2752-371c-9f2c-5d99a3b53655",
                                "text": "La porte du pullman de queue, fermée à clef, s'ouvrit : superbement, admirablement vide, la voiture offrait à ses visiteurs impromptus le plus admirable décor de marqueterie en bois de rose — jaune citron et carmin pâle — qui se pût imaginer."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c0511c8-2a56-3e18-8ed0-5a9538b858a8",
                        "entry_id": "e7c0b9d7-1915-3942-8d91-1313be01f0c7",
                        "glosses": [
                            "Sert à marquer qu’on est surpris ou choqué de ce que quelqu’un dit ou fait."
                        ],
                        "tags": [
                            "familiar",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "a3f8a799-9153-4972-8f22-1609e40b1812",
                                "sense_id": "8c0511c8-2a56-3e18-8ed0-5a9538b858a8",
                                "text": "Vous êtes admirable de venir ici nous contrôler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "964ea14f-3e09-4f27-809c-f182c9977e5a",
                        "source_entry_id": "e7c0b9d7-1915-3942-8d91-1313be01f0c7",
                        "target_lang_word": "admirable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admirable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0432abc7-3a48-3b9d-8ba4-26f10cea1aa0",
                                        "entry_id": "d070268b-f6b1-3642-8c55-6d08efc1ccb8",
                                        "glosses": [
                                            "Deserving of the highest esteem or admiration; estimable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fb4666-d95c-4a01-854d-56713699937a",
                                                "sense_id": "0432abc7-3a48-3b9d-8ba4-26f10cea1aa0",
                                                "text": "It's admirable that Shelley overcame her handicap and excelled in her work."
                                            },
                                            {
                                                "example_id": "0bfc7f3c-5fe0-446e-9748-cb6cef5bb350",
                                                "sense_id": "0432abc7-3a48-3b9d-8ba4-26f10cea1aa0",
                                                "text": "The admirable smoothness of the riding also reflected the greatest credit on those who, despite the difficulties caused by the shortage of men and materials, have succeeded in maintaining the track in such first-class order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10283efa-4431-350c-8a46-1b76b4a0d222",
                                        "entry_id": "d070268b-f6b1-3642-8c55-6d08efc1ccb8",
                                        "glosses": [
                                            "Good or heroic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e3eac80-b9f0-4c43-bbad-59b6e747a83e",
                                                "sense_id": "10283efa-4431-350c-8a46-1b76b4a0d222",
                                                "text": "The act of putting out the burning fires was admirable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
