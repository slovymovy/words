                        "glosses": [
                            "Qui a valeur d’évaluation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef41ad8-49fe-4e00-9f32-7934c1278415",
                                "sense_id": "fc70f646-71f5-306f-9ef9-5cc9da14cd1b",
                                "text": "Le montant prévisionnel ou évaluatif du marché permet au pouvoir adjudicateur de réserver l’enveloppe budgétaire et de déterminer le type de procédure de passation du marché et son niveau de publicité."
                            },
                            {
                                "example_id": "afc098ac-b7d2-441b-b49c-746a64b6ca42",
                                "sense_id": "fc70f646-71f5-306f-9ef9-5cc9da14cd1b",
                                "text": "Avec REHA, le PUCA réalise des opérations démonstratrices, teste de nouveaux montages de projets, fournit aux maîtres d’ouvrage des outils pour monter ce type d’opérations et engage des études évaluatives pour lever les verrous."
                            }
                        ]
                    }
