                        "glosses": [
                            "iemand die graag spannende dingen wil beleven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abeefe90-68d8-4b0b-b8fb-f26c81f70d46",
                                "sense_id": "6033e7a7-f980-364f-af2f-0a2113949236",
                                "text": "Spelers van computergames zijn oppervlakkige sensatiezoekers. Ze gaan helemaal op in het fictieve verhaal, kicken vooral op scoren en kennen daarbij weinig scrupules."
                            },
                            {
                                "example_id": "79f8274a-5c5b-4712-a057-ddc9a8e318e6",
                                "sense_id": "6033e7a7-f980-364f-af2f-0a2113949236",
                                "text": "De achttienjarige Dennis krijgt 80 uur werkstraf, waarvan twintig voorwaardelijk. Zijn moeder is geschrokken: „Het is een sensatiezoeker. Dit is wel erg zwaar. Ik ben blij dat hij niet buiten het stadion heeft meegedaan aan de rellen. Dan had ik hem eigenhandig bij de politie afgeleverd”, zegt ze. „Nu moet hij zestig uur werken. Een harde les voor het jochie.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e32176a-0d1e-3496-94e1-86289a15e350",
                        "entry_id": "e8219ff6-4e11-38e6-95f2-a92328c2630c",
                        "glosses": [
                            "mensen die een gebeurtenis vooral willen meemaken omdat die uitzonderlijk is en daardoor in de belangstelling staat"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c224a059-5e90-43aa-af16-a52739efa8ae",
                                "sense_id": "9e32176a-0d1e-3496-94e1-86289a15e350",
                                "text": "Wat Tim „echt respectloos” vond, waren de sensatiezoekers die meteen op de plaats van de aanslag afkwamen."
                            },
                            {
                                "example_id": "ec435125-96d6-4224-9ba2-dcb8dd157289",
                                "sense_id": "9e32176a-0d1e-3496-94e1-86289a15e350",
                                "text": "Maar altijd is er rondom de kunstenaar het odium blijven hangen van goedkope sensatiezoeker."
                            }
                        ]
                    }
