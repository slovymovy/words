                    {
                        "sense_id": "5e3b6fcb-364a-3604-946d-b08394f01ed3",
                        "entry_id": "cd72e63e-b9cb-3714-a5d8-501896fc145b",
                        "glosses": [
                            "De façon épaisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f1d5ce-644a-49d7-b334-6cc8761787ac",
                                "sense_id": "5e3b6fcb-364a-3604-946d-b08394f01ed3",
                                "text": "Pendant un bon moment, je me demandais ce que pouvaient être trois silhouettes noires que j'avais vues sortir d'une lointaine maison aux fenêtres épaissement grillagées. Elles me rappelaient les pénitents en cagoule qui suivent les processions d'Italie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cabd7d9f-1532-4043-a0f3-ccca9a004c47",
                        "source_entry_id": "cd72e63e-b9cb-3714-a5d8-501896fc145b",
                        "source_sense_id": "5e3b6fcb-364a-3604-946d-b08394f01ed3",
                        "target_lang_word": "thickly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thickly",
