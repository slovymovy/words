                    {
                        "translation_id": "933fac8b-f5b9-4e94-abc0-47def6865ba2",
                        "source_entry_id": "057536ab-836a-3b32-b1b6-2e2aff212cf1",
                        "source_sense_id": "5b19630e-9e1c-3a33-a463-03765ad48160",
                        "source_sense_description": "seeming to never end",
                        "target_lang_word": "perpétuellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perpétuellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9cc04e-6851-34af-8182-7af6087b03ba",
                                        "entry_id": "98200cf6-57a6-3668-a75a-7951111d8815",
                                        "glosses": [
                                            "D’une façon perpétuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8eb2b33-e0eb-4095-82e5-959fac7e0b74",
                                                "sense_id": "7e9cc04e-6851-34af-8182-7af6087b03ba",
                                                "text": "Tous les animaux sont perpétuellement en guerre : chaque espèce est née pour en dévorer une autre."
                                            },
                                            {
                                                "example_id": "47d82f40-5b4d-4efa-bbcd-031535dfce8b",
                                                "sense_id": "7e9cc04e-6851-34af-8182-7af6087b03ba",
                                                "text": "Les Féroë se dressent dans une des régions les plus tourmentées du globe, perpétuellement balayées par des dépressions atmosphériques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae245dd2-15d5-3b1a-bd22-a43396c424c4",
                                        "entry_id": "98200cf6-57a6-3668-a75a-7951111d8815",
                                        "glosses": [
                                            "Habituellement, fréquemment."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91c6e135-598f-44d8-a336-a8f6d72387ee",
                                                "sense_id": "ae245dd2-15d5-3b1a-bd22-a43396c424c4",
                                                "text": "Ils sont perpétuellement en querelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb970d53-2940-419a-85c4-aaef8bfdff6e",
                        "source_entry_id": "057536ab-836a-3b32-b1b6-2e2aff212cf1",
                        "source_sense_id": "5b19630e-9e1c-3a33-a463-03765ad48160",
                        "source_sense_description": "seeming to never end",
                        "target_lang_word": "ewig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ewig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                        "entry_id": "c527ebf9-1964-3bbd-bae5-2ebf9ac771f6",
                                        "glosses": [
                                            "endlos, zeitlich unbegrenzt"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7538a61-c1df-408a-a088-7b78a2cfe676",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "Ewig existiert Gott."
                                            },
                                            {
                                                "example_id": "55ca9294-07cb-4adf-a502-e32c1e4b6d70",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "Sie sind ewig in Liebe verbunden."
                                            },
                                            {
                                                "example_id": "91d80915-23a3-4555-8adb-0479a7c079cd",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "Uns ist das Ewige Leben versprochen."
                                            },
                                            {
                                                "example_id": "777034e2-f366-4a49-8f30-2d7c532f5713",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "„Ich, dessen Herz in die entferntesten Jahrtausende der Vergangenheit und der Zukunft immer tiefer und tiefer Wurzel schlägt, ich, der ich selbst einer der ewigsten Menschen bin, jeder Atemzug ein ewiges Leben, jeder Gedanke ein ewiger Stern – ich sollte nicht an Unsterblichkeit glauben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                        "entry_id": "c527ebf9-1964-3bbd-bae5-2ebf9ac771f6",
                                        "glosses": [
                                            "einen langen Zeitraum betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0becee02-eeca-4277-9f5d-c416665d10ab",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "„Die Flucht vor der Qual der Sinnlosigkeit des täglichen Lebens führt in die menschenfeindlichsten Landschaften der Erde, in das vegetationslose Hochgebirge mit seinem ewigen Eis und Schnee, seinen unsichtbaren Gletscherspalten, seinen abweisenden Wänden und Graten, seinen gefährlichen Steinschlägen und Lawinen, seiner mörderischen Kälte und Hitze, seinen Stürmen und Wetterschlägen.“"
                                            },
                                            {
                                                "example_id": "e4824948-56b3-470a-a101-225f22aa7f98",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "Nein, Thomas, bist du es wirklich? Wir haben uns ja ewig nicht gesehen! Wie gehts so, alter Kumpel?"
                                            },
                                            {
                                                "example_id": "e63c5281-e121-4178-b830-84180d130a90",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "Ich habe keine Ahnung, das ist ewig her, dass ich sie gesehen habe. Vielleicht fünf Jahre, oder so."
                                            },
                                            {
                                                "example_id": "22a834e2-0512-48fb-8a59-33cac9d77aee",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "Nacktbaden? Das habe ich ewig nicht gemacht, also los!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a8ea14e6-83e9-3b87-a114-342cf50b5502",
                                        "entry_id": "c527ebf9-1964-3bbd-bae5-2ebf9ac771f6",
                                        "glosses": [
                                            "sich ständig wiederholend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103e7943-ddb6-487f-a360-0785bd8294e6",
                                                "sense_id": "a8ea14e6-83e9-3b87-a114-342cf50b5502",
                                                "text": "Ich habe den Typen sowas von satt, der nörgelt ewig an mir rum."
                                            },
                                            {
                                                "example_id": "9eafaad1-2dac-4c6b-a637-a446ca0fcf08",
                                                "sense_id": "a8ea14e6-83e9-3b87-a114-342cf50b5502",
                                                "text": "Im Grunde habe ich mich ewig gefragt, ob der Fehler nicht bei mir lag."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
