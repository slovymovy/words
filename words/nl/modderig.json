                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het pad door het bos was erg <w>modderig</w> na de hevige regenval.",
                            "target_lang_translations": {
