                ],
                "senses": [
                    {
                        "sense_id": "42272456-50a8-394f-8e43-c6f9567b4db2",
                        "entry_id": "ba8d9e8c-6be8-3115-a9c8-2a6c575dd929",
                        "glosses": [
                            "популярность, знаменитость, слава"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2670d049-cb43-4679-b71a-f141f58b4888",
                                "sense_id": "42272456-50a8-394f-8e43-c6f9567b4db2",
                                "text": "К сожалению, пятеро людей из этого списка получили известность ценой своей жизни."
                            }
                        ]
                    },
                    {
                        "sense_id": "6176df5d-9f5e-3d43-bfec-482b1ab95430",
                        "entry_id": "ba8d9e8c-6be8-3115-a9c8-2a6c575dd929",
                        "glosses": [
                            "разг. известный, пользующийся популярностью человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ab87d9-b174-4826-9ac2-ab76ce30dd26",
                                "sense_id": "6176df5d-9f5e-3d43-bfec-482b1ab95430",
                                "text": "Съехались все провинциальные известности."
                            }
                        ]
                    },
                    {
                        "sense_id": "b73eccf5-4bfd-3da0-b2d1-27aecafbc396",
                        "entry_id": "ba8d9e8c-6be8-3115-a9c8-2a6c575dd929",
                        "glosses": [
                            "офиц. осведомлённость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54bc7da6-5637-4c53-beaa-52cbdc27a579",
                                "sense_id": "b73eccf5-4bfd-3da0-b2d1-27aecafbc396",
                                "text": "В случае, если Вы не сможете прийти, прошу заранее поставить меня в известность."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bff257d-ddb7-3672-9ba7-10cfdcb4368b",
                        "entry_id": "ba8d9e8c-6be8-3115-a9c8-2a6c575dd929",
                        "glosses": [
                            "устар. выясненное, определённое состояние"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077e9aae-467c-45fd-8c53-c9fc15f36a4b",
                                "sense_id": "1bff257d-ddb7-3672-9ba7-10cfdcb4368b",
                                "text": "Я поручил своим помощникам привести в известность всё пропавшее и испорченное по подлинным счетам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e18e1496-963f-4c68-a907-b4f9d464165f",
                        "source_entry_id": "ba8d9e8c-6be8-3115-a9c8-2a6c575dd929",
                        "target_lang_word": "renown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                        "entry_id": "bcd52aa8-8af9-356f-8121-ceffd0b61684",
                                        "glosses": [
                                            "Fame; celebrity; wide recognition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e233d85-6c4a-4d64-8365-d43af46a1493",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "She is a theame of honour and renowne, / A ſpurre to valiant and magnanimous deeds, / Whoſe preſent courage may beate downe our foes, / And fame in time to come canonize us, […]"
                                            },
                                            {
                                                "example_id": "0edefe53-e9d6-4eb7-a5d7-aafc22f3bb98",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "And they rose up before Moses, with certain of the children of Israel, two hundred and fifty princes of the assembly, famous in the congregation, men of renown: […]"
                                            },
                                            {
                                                "example_id": "675580e6-bc6f-426d-b5d7-6b9fab587267",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "[…] Nor envy we / Thy great Renown, nor grudge thy Victory; / 'Tis thine, O King, th' Afflicted to redreſs, / And Fame has fill'd the World with thy Succeſs; […]"
                                            },
                                            {
                                                "example_id": "f69176cd-1176-47c4-9103-a5970bdf41e7",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "There sleep the mighty dead as in life they slept, warriors and princes of high renown."
                                            },
                                            {
                                                "example_id": "37b42298-70fe-45b9-969f-92c15f0c5327",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "[…] one day local fame would become world renown […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1285ef19-a78f-3b64-9e99-64a281b8d86f",
                                        "entry_id": "bcd52aa8-8af9-356f-8121-ceffd0b61684",
                                        "glosses": [
                                            "Reports of nobleness or achievements; praise."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ba5732-e9d2-49b7-8339-e0b2241e5c92",
                                                "sense_id": "1285ef19-a78f-3b64-9e99-64a281b8d86f",
                                                "text": "[…] She / Is daughter to this famous Duke of Milan, / Of whom so often I have heard renown, / But never saw before;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "renown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e258ee-90fd-3510-9592-fc6fe748e0ac",
                                        "entry_id": "f18461f3-9a87-33d3-b15c-095fd9dd69ee",
                                        "glosses": [
                                            "To make famous."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d1766d3-d625-49ac-9640-9c41a65ed7db",
                        "source_entry_id": "ba8d9e8c-6be8-3115-a9c8-2a6c575dd929",
                        "target_lang_word": "publicity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "publicity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1437c5b-e5a4-3cb3-8371-0f4d5776c5a0",
                                        "entry_id": "2b4d335d-00bf-3da4-a3fd-d27521604863",
                                        "glosses": [
                                            "Advertising or other activity designed to rouse public interest in something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d9fc6ec-577e-4ba7-9eb1-f6c2ab76896c",
                                                "sense_id": "d1437c5b-e5a4-3cb3-8371-0f4d5776c5a0",
                                                "text": "A gay man accused of disorderly conduct for posting publicity for a Boston gay event was found not guilty in Cambridge District Court on July 22."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c22a06-b989-3951-8011-ed013f9d5fb6",
                                        "entry_id": "2b4d335d-00bf-3da4-a3fd-d27521604863",
                                        "glosses": [
                                            "Public interest attracted in this way."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f9f963-0c03-44e6-adce-8538a6475bee",
                                                "sense_id": "e6c22a06-b989-3951-8011-ed013f9d5fb6",
                                                "text": "Any publicity, runs the axiom, is good publicity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15f6839d-3361-36c0-92f1-bbf767f397ab",
                                        "entry_id": "2b4d335d-00bf-3da4-a3fd-d27521604863",
                                        "glosses": [
                                            "The condition of being the object of public attention."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d74c47d2-d1a3-3102-99b0-b9167281c397",
                                        "entry_id": "2b4d335d-00bf-3da4-a3fd-d27521604863",
                                        "glosses": [
                                            "The quality of being public, not private."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a85d4a78-6bb7-4a6b-baa1-9519c1fc9244",
                                                "sense_id": "d74c47d2-d1a3-3102-99b0-b9167281c397",
                                                "text": "Amelia's gentle eyes, too, had been fixed anxiously on the pair, whose conduct had so chafed the jealous General; but when Rebecca entered her box, she flew to her friend with an affectionate rapture which showed itself, in spite of the publicity of the place; for she embraced her dearest friend in the presence of the whole house, at least in full view of the General's glass, now brought to bear upon the Osborne party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
