                        "source_sense_id": "a68169aa-9146-31c7-a6d8-07cc7a012df5",
                        "source_sense_description": "Vorrichtung an Kameras und anderen optischen Geräten, die den Fokus automatisch scharf stellt",
                        "target_lang_word": "autofocus",
