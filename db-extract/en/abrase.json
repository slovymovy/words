                    },
                    {
                        "translation_id": "834199a9-d0e3-4e3d-b023-726dd2e50196",
                        "source_entry_id": "855b3115-c88c-31fd-a6c9-dbd115edf71a",
                        "source_sense_id": "c5bc97e8-cdc5-3ab1-a74c-f1d272d6b633",
                        "source_sense_description": "abtragen, abschürfen, aufscheuern",
                        "target_lang_word": "abtragen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abtragen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1327391-3096-3795-9def-c00ed31f9724",
                                        "entry_id": "a9846062-f381-3bb5-8986-39ffde491aba",
                                        "glosses": [
                                            "schichtweise entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8497fd60-db6c-4875-b675-01372458abce",
                                                "sense_id": "b1327391-3096-3795-9def-c00ed31f9724",
                                                "text": "Die Restauratorin trägt sehr vorsichtig die obersten Farbschichten ab."
                                            },
                                            {
                                                "example_id": "83a06156-12f6-47b8-8ce8-50c20fed6ab9",
                                                "sense_id": "b1327391-3096-3795-9def-c00ed31f9724",
                                                "text": "Wegen der Kontamination muss das gesamte Erdreich abgetragen werden."
                                            },
                                            {
                                                "example_id": "1b04dce3-955e-4f48-bfcf-96feaaf83da6",
                                                "sense_id": "b1327391-3096-3795-9def-c00ed31f9724",
                                                "text": "„Auch hier sei die kontaminierte Erde abgetragen worden, beruhigt uns der Biologe, und im Übrigen werde jedes Gemüse und Milchprodukt auf Cäsium, Strontium und andere Nuklide gemessen, bevor es in den Handel gelange.“"
                                            },
                                            {
                                                "example_id": "4ce08b08-ffa2-495d-ae01-4a3ec3910b79",
                                                "sense_id": "b1327391-3096-3795-9def-c00ed31f9724",
                                                "text": "„Durch Erosion wurde die Deckschicht abgetragen und das mineralreiche Innere dieses rund zwei Kilometer breiten Schlots wurde zugänglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b963e5b-99ce-3888-9ce6-3946c6f31a8a",
                                        "entry_id": "a9846062-f381-3bb5-8986-39ffde491aba",
                                        "glosses": [
                                            "Kleidung so lange benutzen, bis sie kaputt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de397b3-6602-47e4-9914-0f5cd1421c65",
                                                "sense_id": "4b963e5b-99ce-3888-9ce6-3946c6f31a8a",
                                                "text": "Ich kaufe erst eine neue Hose, wenn ich diese hier abgetragen habe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d5129fa-c34b-3a59-95df-0da4ff9ac627",
                                        "entry_id": "a9846062-f381-3bb5-8986-39ffde491aba",
                                        "glosses": [
                                            "bezahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "868f30fa-5190-45e9-850f-b039eda7fbc6",
                                                "sense_id": "5d5129fa-c34b-3a59-95df-0da4ff9ac627",
                                                "text": "Sie können die Summe in zwei Zahlungen abtragen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "721537b6-2b27-31fd-97eb-e4a7f334495b",
                                        "entry_id": "a9846062-f381-3bb5-8986-39ffde491aba",
                                        "glosses": [
                                            "das Geschirr vom Tisch räumen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3bc796f-0f75-4762-8149-6aa192756715",
                                                "sense_id": "721537b6-2b27-31fd-97eb-e4a7f334495b",
                                                "text": "Wir haben das Mahl jetzt beendet. Das Hausmädchen kann nun abtragen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "575d97df-1c6e-3aa3-b8c3-7332883192b2",
                                        "entry_id": "a9846062-f381-3bb5-8986-39ffde491aba",
                                        "glosses": [
                                            "operativ entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b936ce-cf19-4a79-8991-48f3ef1d1d63",
                                                "sense_id": "575d97df-1c6e-3aa3-b8c3-7332883192b2",
                                                "text": "Der Arzt musste die Warze abtragen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f5a4b030-d6fc-3e18-bfde-0bdddd639787",
                                        "entry_id": "a9846062-f381-3bb5-8986-39ffde491aba",
                                        "glosses": [
                                            "Strecke auf Gerade festlegen"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f18df6f2-91f4-4270-a37e-a5fa957aee3b",
                                                "sense_id": "f5a4b030-d6fc-3e18-bfde-0bdddd639787",
                                                "text": "Das Abtragen einer gegebenen Streckenlänge auf einer Geraden ist eine der grundlegenden Aufgaben der Geometrie."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f5ecc54-bd42-4c06-bc97-322b2af0a4d2",
                        "source_entry_id": "855b3115-c88c-31fd-a6c9-dbd115edf71a",
                        "source_sense_id": "c5bc97e8-cdc5-3ab1-a74c-f1d272d6b633",
                        "source_sense_description": "abtragen, abschürfen, aufscheuern",
                        "target_lang_word": "abschürfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abschürfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96ce7274-e397-3980-955e-7082b7eb8d3f",
                                        "entry_id": "21a19798-43a9-3d19-8210-7459c3886c20",
                                        "glosses": [
                                            "(sich) durch Schürfen verletzen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9960719e-7f67-408f-a1ba-75db836563ea",
                                                "sense_id": "96ce7274-e397-3980-955e-7082b7eb8d3f",
                                                "text": "Es gibt zwei Arten dieser Verletzung. Hautlappen, bei denen alle Hautschichten komplett abgeschürft wurden und Hautlappen, bei denen manche Schichten noch teilweise vorhanden sind."
                                            },
                                            {
                                                "example_id": "e0216624-1a8e-4356-b043-1310c314c437",
                                                "sense_id": "96ce7274-e397-3980-955e-7082b7eb8d3f",
                                                "text": "Wenn du Zweifel hast, solltest du den abstehenden Hautlappen behandeln, als wäre die gesamte Hautschicht abgeschürft und ihn von einem Arzt oder einer Krankenschwester behandeln lassen."
                                            },
                                            {
                                                "example_id": "d216bed9-270f-4dae-a8ae-8e78cfdc5740",
                                                "sense_id": "96ce7274-e397-3980-955e-7082b7eb8d3f",
                                                "text": "Schürfwunden sind oberflächliche Verletzungen (Wunden) der Haut, welche nur die obersten Hautschichten betreffen. Diese sind „abgeschürft“, wodurch die kleinen Gefäße der Lederhaut offen liegen."
                                            },
                                            {
                                                "example_id": "0778bb53-6630-4ea5-85ac-c1d117530ed5",
                                                "sense_id": "96ce7274-e397-3980-955e-7082b7eb8d3f",
                                                "text": "Sie würde sich nie daran gewöhnen. Nicht an die Stahlmanschetten, die ihre Haut an den Hand- und Fußgelenken abschürften, auch nicht an das ängstliche Warten darauf, dass sich die Tür am Ende der Treppe öffnete und er auftauchte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
