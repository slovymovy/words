                    "sense_definition": "To travel or transport by automobile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <autoed> across the country during the early days of road travel.",
                            "target_lang_translations": {
                                "ru": "Они <w>путешествовали на автомобиле</w> по стране на заре дорожных путешествий.",
                                "de": "In den Anfängen des Automobilverkehrs <w>fuhren</w> sie <w>mit dem Auto</w> quer durch das Land."
                            }
                        },
                        {
                            "text": "We <autoed> to the coast to enjoy the summer breeze.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поехали на машине</w> на побережье, чтобы насладиться летним бризом.",
                                "de": "Wir <w>fuhren mit dem Wagen</w> an die Küste, um die Sommerbrise zu genießen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или перевозить на автомобиле.",
                        "de": "Mit dem Automobil reisen oder befördern (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествовать на автомобиле",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "ехать на машине",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "mit dem Auto fahren",
                                "target_lang_sense_clarification": "sich im Auto fortbewegen"
