                    {
                        "sense_id": "a21ff0c1-ce60-3f23-9e8f-7d3cd4bc4d93",
                        "entry_id": "408050d0-6b53-3856-a972-8250c80be808",
                        "glosses": [
                            "ein Treffer, der nur durch Glück, nicht durch Wissen oder Können zustande kam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59507bd6-4262-4af4-9bb6-d987f763e4a1",
                                "sense_id": "a21ff0c1-ce60-3f23-9e8f-7d3cd4bc4d93",
                                "text": "Das Tor zum eins zu eins war ein absoluter Glückstreffer."
                            },
                            {
                                "example_id": "2de0c3ae-11a9-4f21-a329-82fafd16e1ab",
                                "sense_id": "a21ff0c1-ce60-3f23-9e8f-7d3cd4bc4d93",
                                "text": "Meine Antwort auf die letzte Frage war ein reiner Glückstreffer. Ich habe einfach geraten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
