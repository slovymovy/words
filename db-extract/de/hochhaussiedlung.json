                        "examples": [
                            {
                                "example_id": "8e1c7b97-ae75-4719-9090-f6e3ece72263",
                                "sense_id": "96db7dbf-841d-30e5-bc6e-1c760e4f53b8",
                                "text": "„Für ein Wahlkampfporträt führte er ich durch die Hochhaussiedlung von Bonames, jenem Stadtteil von Frankfurt, in dem er aufgewachsen ist.“"
                            },
                            {
                                "example_id": "48ec962f-40b8-4079-9be5-6383a086b476",
                                "sense_id": "96db7dbf-841d-30e5-bc6e-1c760e4f53b8",
                                "text": "„Die Hochhaussiedlung wird zu den schwierigsten sozialen Brennpunkten des Landes gerechnet, in der öffentlichen Wahrnehmung steht sie für Kriminalität, Verwahrlosung und Gewalt.“"
                            }
