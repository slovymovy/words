            {
                "entry_id": "f17ad1ed-e2fd-3ee0-a69b-c60a66fb72f8",
                "word": "CSU",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3075140-9892-3c11-b3b8-b7cfb33d6314",
                        "entry_id": "f17ad1ed-e2fd-3ee0-a69b-c60a66fb72f8",
                        "glosses": [
                            "The Bavarian Christian Social Union (Christlich-Soziale Union), a major mainstream right-wing political party in Bavaria."
                        ],
                        "tags": [
                            "German"
                        ],
                        "examples": [
                            {
                                "example_id": "1e5852ae-15c3-46da-9087-0e7b4b68e79d",
                                "sense_id": "f3075140-9892-3c11-b3b8-b7cfb33d6314",
                                "text": "The ever-present two dominant parties of German politics, the Christian Democrats (CDU) and Christian Social Union (CSU), unofficially known as the Union, make up one grouping. The Social Democrats, or SPD, form another.\nGiven the German system of proportional representation, the government tends to be formed in a coalition, usually headed by the CDU/CSU or the SPD."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2bf4e07-319e-427b-bde6-3a82e020ed43",
                        "source_entry_id": "f17ad1ed-e2fd-3ee0-a69b-c60a66fb72f8",
                        "source_sense_id": "f3075140-9892-3c11-b3b8-b7cfb33d6314",
                        "source_sense_description": "Christlich-Soziale Union",
                        "target_lang_word": "CSU",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "CSU",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                                        "entry_id": "d94f4278-9d09-3f25-a417-a92dcc28c88b",
                                        "glosses": [
                                            "Kurzwort für Christlich-Soziale Union (in Bayern (e. V.))"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a29c2a-3d1f-4e85-84d1-4c0e1813d5a9",
                                                "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                                                "text": "Die CSU bezeichnet sich als Volkspartei in Bayern."
                                            },
                                            {
                                                "example_id": "66cdb25e-f452-4e5c-96f6-24b23516ca38",
                                                "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                                                "text": "„Die folgende Fußballgeschichte handelt vom letzten Habsburger, Otto Habsburg, der in Bayern lebte und für die CSU im Europaparlament in Straßburg saß.“"
                                            },
                                            {
                                                "example_id": "fe3a0938-4321-4503-a832-87c495e87710",
                                                "sense_id": "8237b099-0fe6-33c0-90ed-a0c18c5ac8b0",
                                                "text": "„»Sie waren unfähig, den Ausbau der erneuerbaren Energien herbeizuführen. Sie haben Abwehrkämpfe geführt gegen jede einzelne Windkraftanlage«, sagt Scholz und zeigt dabei auf die Sitzreihen von CDU und CSU.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
