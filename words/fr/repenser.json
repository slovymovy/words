{
    "word_family": [
        "penser",
        "pensée",
        "penseur",
        "pensif",
        "pensable",
        "impensable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5377b878-f7b9-34f8-8eb5-dc729da97cc0",
                    "sense_definition": "Penser de nouveau à quelque chose ou à quelqu'un, se remémorer un souvenir ou y réfléchir encore.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souvenir_reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>repense</w> souvent à nos dernières vacances passées au bord de la mer."
                        },
                        {
                            "text": "En ouvrant cette boîte à souvenirs, il a soudainement <w>repensé</w> à son enfance."
                        }
                    ],
                    "synonyms": [
                        "se remémorer",
                        "songer"
                    ],
                    "antonyms": [
                        "oublier"
                    ],
                    "common_phrases": [
                        "repenser au passé",
                        "repenser à son enfance"
                    ]
                },
                {
                    "sense_id": "7503b15c-5914-3a95-a23b-20e47b2bcb6a",
                    "sense_definition": "Examiner de nouveau un projet, une méthode ou une organisation afin de l'adapter ou de l'améliorer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reconsideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux nouvelles difficultés économiques, la direction doit <w>repenser</w> sa stratégie commerciale."
                        },
                        {
                            "text": "Nous devons <w>repenser</w> notre mode de vie pour limiter notre impact écologique."
                        }
                    ],
                    "synonyms": [
                        "reconsidérer",
                        "réexaminer",
                        "remanier"
                    ],
                    "antonyms": [
                        "maintenir"
                    ],
                    "common_phrases": [
                        "repenser la stratégie",
                        "repenser le système"
                    ]
                },
                {
                    "sense_id": "e641d177-09a9-3069-b97c-f020000f2fdd",
                    "sense_definition": "Reviser en profondeur les fondements théoriques ou conceptuels d'une doctrine, d'une idée ou d'une œuvre intellectuelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reconsideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe contemporain a tenté de <w>repenser</w> les fondements de la morale classique."
                        },
                        {
                            "text": "Ces nouvelles découvertes archéologiques forcent les historiens à <w>repenser</w> toute cette théorie."
                        }
                    ],
                    "synonyms": [
                        "refondre",
                        "réévaluer"
                    ],
                    "common_phrases": [
                        "repenser les fondements",
                        "repenser une théorie"
                    ]
                }
            ]
        }
    ]
}