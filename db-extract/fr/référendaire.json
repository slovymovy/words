                "senses": [
                    {
                        "sense_id": "0cb7b538-946b-3408-8858-f64f70f62006",
                        "entry_id": "6e575839-c150-3f5b-86f5-645354a38a49",
                        "glosses": [
                            "Organisateur d'un référendum politique"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af90f7c-e2aa-4ca4-81a9-eede9bdbbb11",
                                "sense_id": "0cb7b538-946b-3408-8858-f64f70f62006",
                                "text": "Les référendaires estiment avoir de bonnes chances en votation."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d55b8ac-7a83-3f66-8fee-4b944fc4cb13",
                        "entry_id": "6e575839-c150-3f5b-86f5-645354a38a49",
                        "glosses": [
                            "Officier qui faisait le rapport des lettres royales dans les chancelleries, pour qu’on décidât si elles devaient être signées et scellées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8fd1b8-8132-4587-abab-08fd3be770e6",
                                "sense_id": "3d55b8ac-7a83-3f66-8fee-4b944fc4cb13",
                                "text": "Le grand référendaire du Sénat impérial, de la Chambre des pairs, dignitaire chargé d’apposer le sceau et de garder les archives."
                            },
                            {
                                "example_id": "574bee2a-d2f2-4dd7-a1c5-2000b4713a12",
                                "sense_id": "3d55b8ac-7a83-3f66-8fee-4b944fc4cb13",
                                "text": "À Rome, les référendaires de l'une et de l'autre signature sont des prélats de la cour de Rome qui rapportent les causes, soit de justice, soit de grâce."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c3988e7-65af-333d-9f43-6c56c01305a8",
                        "entry_id": "6e575839-c150-3f5b-86f5-645354a38a49",
                        "glosses": [
                            "Magistrat de la Cour des comptes."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "0c4494ea-60d2-4c3e-9788-18c857218a17",
                                "sense_id": "5c3988e7-65af-333d-9f43-6c56c01305a8",
                                "text": "Attiré par la gloire de Canalis, […], un jeune Référendaire à la Cour des Comptes se constitua le secrétaire bénévole du poète, et fut caressé par lui comme un spéculateur caresse son premier bâilleur de fonds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "286a72ea-b9d8-4c7f-a5cc-f3bea47077d0",
