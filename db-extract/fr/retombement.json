                        "glosses": [
                            "Action de retomber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb3c7d1-0656-4711-aa3f-684b49c8ce8e",
                                "sense_id": "1fe59844-49eb-3ba6-a875-ad990941f6b7",
                                "text": "Des branches de marbre soutenaient les retombements d’épaisses toisons d’or."
                            },
                            {
                                "example_id": "b9045f0c-cbf0-4cc3-8a87-472f765e346e",
                                "sense_id": "1fe59844-49eb-3ba6-a875-ad990941f6b7",
                                "text": "Nietzsche s'est dressé face au siècle. Et l’adversaire qu'il s'est choisi, c'est l’esprit de lourdeur, notre poids naturel, notre faculté naturelle de retombement dans la coutume."
                            },
                            {
                                "example_id": "d212cc7b-b6f3-4e12-b1c4-9c9a477d51b4",
                                "sense_id": "1fe59844-49eb-3ba6-a875-ad990941f6b7",
                                "text": "Sa piété, enfin, faisait honte à la mienne, à mes tiédeurs et à mes retombements..."
                            },
                            {
                                "example_id": "ca6e83d4-9984-4d86-bcdf-334ffa3761cb",
                                "sense_id": "1fe59844-49eb-3ba6-a875-ad990941f6b7",
                                "text": "Le front pur s'est ridé ; la bouche, faite pour les sanglots de l'amour, a les retombements de l'amertume."
                            }
                        ]
                    }
                ],
