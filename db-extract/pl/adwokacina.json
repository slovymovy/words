                                                "example_id": "1d5052b8-ef45-4610-bdce-8cfb593763cc",
                                                "sense_id": "757d7db6-2c0a-3580-b462-f8401fbd73f5",
                                                "text": "Der Vertrag wurde von einem Rechtsanwalt entworfen."
                                            },
                                            {
                                                "example_id": "d9bfb5aa-04c5-47c8-94d6-1cdb4dc20abd",
                                                "sense_id": "757d7db6-2c0a-3580-b462-f8401fbd73f5",
                                                "text": "„Nach einigen Monaten ohne Stellung arbeitete er von 1934 bis 1940 als Kanzleivorsteher bei Rechtsanwälten in Hannover.“"
                                            },
                                            {
                                                "example_id": "4f8e455a-00e1-48f0-a980-7b18187fba6d",
                                                "sense_id": "757d7db6-2c0a-3580-b462-f8401fbd73f5",
                                                "text": "„Bevor Eigil am nächsten Tag verhört wurde, sprach er mit seinem Rechtsanwalt Hedin Poulsen.“"
                                            },
                                            {
                                                "example_id": "92c8280f-3e8e-42c7-8023-8e911e932180",
                                                "sense_id": "757d7db6-2c0a-3580-b462-f8401fbd73f5",
                                                "text": "„Es gelang ihm glücklicherweise, sich mithilfe eines befreundeten Rechtsanwalts zu verteidigen.“"
                                            },
                                            {
                                                "example_id": "5aa93dbd-a18d-4937-9d81-e608508b1959",
                                                "sense_id": "757d7db6-2c0a-3580-b462-f8401fbd73f5",
                                                "text": "„Es war schon deshalb ein Bluff, weil ihm die Mittel fehlten, den berühmten Rechtsanwalt zu bezahlen.“"
                                            },
                                            {
                                                "example_id": "2a76a420-20eb-4d59-b1f5-2242d4f122e2",
                                                "sense_id": "757d7db6-2c0a-3580-b462-f8401fbd73f5",
                                                "text": "„Mit einer eigenen Kanzlei in Karatschi machte sich Jinnah schnell einen Namen als exzellenter Rechtsanwalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b439342-b73b-4ca1-a224-ecd078913f77",
                        "source_entry_id": "7652c969-d93d-31ba-b6f1-4c4aea05baa4",
                        "source_sense_id": "0a2bcdd8-abc2-305d-aa12-063afdb73b3b",
                        "source_sense_description": "armer schlechter oder kaum bekannter Rechtsanwalt",
                        "target_lang_word": "Anwalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                        "entry_id": "ca6ea344-51f4-3f41-8851-b6c1839908f8",
                                        "glosses": [
                                            "bevollmächtigter Rechtsvertreter"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325ae5e1-492a-4ae0-b3f8-c877101a9f9e",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "Der Angeklagte wird durch seinen Anwalt entlastet."
                                            },
                                            {
                                                "example_id": "e8db64d0-b59f-47cb-95f3-554d92ad9642",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Häufig suchen auch die Anwälte reicher Anleger seinen Rat, wenn sie Ärger mit der Steuer befürchten.“"
                                            },
                                            {
                                                "example_id": "8a0d7bd0-33e5-48b4-929b-ab06664977ba",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Manchen Anwälten entziehen die Behörden die Lizenz, wenn man glaubt, dass es mit den Veränderungen reicht.“"
                                            },
                                            {
                                                "example_id": "346405a2-1311-407f-a663-e6a8e05f9a96",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Die beiden Anwälte werden lebendig.“"
                                            },
                                            {
                                                "example_id": "13078789-3677-4680-9846-73ca67a42482",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Auf der rechten Seite sah er Henni mit ihrem Anwalt und auf der linken Schwester Angelika in ihrem Habit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "913a6947-a413-3e96-8a1e-67caf31864d6",
                                        "entry_id": "ca6ea344-51f4-3f41-8851-b6c1839908f8",
                                        "glosses": [
                                            "Person, die sich für etwas/jemanden nachhaltig einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7ad1a6-73ab-4616-87df-e3077c26bbf0",
                                                "sense_id": "913a6947-a413-3e96-8a1e-67caf31864d6",
                                                "text": "Die Wissenschaftsminister sind nicht immer die besten Anwälte der Studenten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1008da9a-d18b-4421-b027-5b962cbe9d3e",
                        "source_entry_id": "7652c969-d93d-31ba-b6f1-4c4aea05baa4",
                        "source_sense_id": "0a2bcdd8-abc2-305d-aa12-063afdb73b3b",
                        "source_sense_description": "armer schlechter oder kaum bekannter Rechtsanwalt",
                        "target_lang_word": "Advokat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Advokat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0bb8c08-bff3-3d56-a6f0-ef7c7cf36cbd",
                                        "entry_id": "38a0c89a-5689-3ae9-ad89-a3d60013f73e",
                                        "glosses": [
                                            "(männlicher^☆) Rechtsanwalt"
                                        ],
                                        "tags": [
                                            "in Deutschland und Österreich veraltet",
                                            "bildungssprachlich oder abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06668607-ceb5-401c-95be-e5dd038683b1",
                                                "sense_id": "b0bb8c08-bff3-3d56-a6f0-ef7c7cf36cbd",
                                                "text": "„Ich will auch mit diesem allen kein Urteil über die Arbeit des Advokaten abgeben, auch war die Eingabe, die ich gelesen habe, nur eine unter mehreren, jedenfalls aber, und davon will ich jetzt sprechen, konnte ich damals in meinem Prozeß keinen Fortschritt sehen.“"
                                            },
                                            {
                                                "example_id": "e113979d-e201-45d4-b5d4-edaed96baf40",
                                                "sense_id": "b0bb8c08-bff3-3d56-a6f0-ef7c7cf36cbd",
                                                "text": "„Eigil erzählte von den Briefen, die der alte Mann aus Nólsoy ihm geschenkt hatte, und er berichtete auch von dem kostbaren Degas-Gemälde, das ein durchtriebener Advokat Martin abgeluchst hatte.“"
                                            },
                                            {
                                                "example_id": "10eac74d-524f-4f24-98b8-d1bb3adbe82b",
                                                "sense_id": "b0bb8c08-bff3-3d56-a6f0-ef7c7cf36cbd",
                                                "text": "„Ihre unaufhörlichen Jeremiaden hatten die Geduld des Advokaten auf eine so harte Probe gestellt, daß er die Gelegenheit seiner Berufung an das Gericht in Insterburg dazu benutzte, seiner quengelnden Gefährtin mit den allzu sauber gebürsteten Kleidern und der von Tränen ewig geröteten Nase endgültig zu entfliehen.“"
                                            },
                                            {
                                                "example_id": "721e89db-7fb7-4ee2-a530-6b331264852a",
                                                "sense_id": "b0bb8c08-bff3-3d56-a6f0-ef7c7cf36cbd",
                                                "text": "„Ein Barbier erschien, rasierte den Advokaten und bot mir mit einer Miene, die mir mißfiel, den gleichen Dienst an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b57974-3a53-4d3b-802a-fca354bdc696",
                        "source_entry_id": "7652c969-d93d-31ba-b6f1-4c4aea05baa4",
                        "source_sense_id": "0a2bcdd8-abc2-305d-aa12-063afdb73b3b",
                        "source_sense_description": "armer schlechter oder kaum bekannter Rechtsanwalt",
                        "target_lang_word": "Verteidiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verteidiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dff80324-5423-307b-9555-c68d9c19f924",
                                        "entry_id": "d7a7a4c6-74e3-3e00-b46a-7733de47ab56",
                                        "glosses": [
                                            "defensiv eingestellter Spieler, dessen Aufgabe es ist, das gegnerische Spiel zu stören, um anschließend das eigene Spiel wieder aufbauen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a6addf-d27a-49e9-83cc-518b3760570c",
                                                "sense_id": "dff80324-5423-307b-9555-c68d9c19f924",
                                                "text": "An den Verteidigern war kein Vorbeikommen."
                                            },
                                            {
                                                "example_id": "743f0080-adc0-4a0f-a55c-0224443292cd",
                                                "sense_id": "dff80324-5423-307b-9555-c68d9c19f924",
                                                "text": "In Brasilien treffen die besten Spieler aus 32 Ländern aufeinander. Die torgefährlichsten Angreifer versuchen an den stärksten Verteidigern vorbeizukommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66ad48b3-abf1-355c-9f68-31f5eed75ebc",
                                        "entry_id": "d7a7a4c6-74e3-3e00-b46a-7733de47ab56",
                                        "glosses": [
                                            "Rechtsanwalt, der vor Gericht die Interessen des Angeklagten vertritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b72c190-e4cb-46bb-ae23-4ea02389d050",
                                                "sense_id": "66ad48b3-abf1-355c-9f68-31f5eed75ebc",
                                                "text": "Der Verteidiger versuchte die Unschuld des Angeklagten nachzuweisen."
                                            },
                                            {
                                                "example_id": "16e1a3ea-a0a5-4139-9b0e-c66098d3aeb2",
                                                "sense_id": "66ad48b3-abf1-355c-9f68-31f5eed75ebc",
                                                "text": "Beate Zschäpe, Hauptangeklagte im NSU-Prozess, will sich von ihren Verteidigern trennen."
                                            },
                                            {
                                                "example_id": "83cb35b5-8977-4302-a67f-f967b64551a8",
                                                "sense_id": "66ad48b3-abf1-355c-9f68-31f5eed75ebc",
                                                "text": "„Sie hatten aber auch einen brillanten Verteidiger: den Rechtsanwalt und Abgeordneten Karel Baxa, der schon Leopold Hilsner als Ritualmörder zu fassen versucht hatte.“"
                                            },
                                            {
                                                "example_id": "62aeaf00-26f2-4842-aca5-57e94c07c6db",
                                                "sense_id": "66ad48b3-abf1-355c-9f68-31f5eed75ebc",
                                                "text": "„Bei Staatsanwaltschaft und Verteidigern ist er beliebt, weil er routinierte, schnelle Verhandlungen macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9edaf751-d1e9-3296-b129-d8219c0a83c3",
                                        "entry_id": "d7a7a4c6-74e3-3e00-b46a-7733de47ab56",
                                        "glosses": [
                                            "Gegenpart zum Angreifer oder Aggressor, in der Regel innerhalb der eigenen Grenzen"
                                        ],
                                        "tags": [
                                            "auch übertragen in Spielen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db935058-9e48-4518-ac1c-f92f218f38ba",
                                                "sense_id": "9edaf751-d1e9-3296-b129-d8219c0a83c3",
                                                "text": "Die Verteidiger wehrten Angriffswelle um Angriffswelle auf die Burgmauern ab."
                                            },
                                            {
                                                "example_id": "bf527bc2-1572-41f8-a4e2-2f72e6cc4168",
                                                "sense_id": "9edaf751-d1e9-3296-b129-d8219c0a83c3",
                                                "text": "\"Wir sind stolz, Russland ist stolz auf die Verteidiger von Stalingrad\", sagte der russische Präsident auf einer Gedenkzeremonie in der Millionenstadt. \"Der Mut und das Heldentum der Verteidiger sind beispiellos und einmalig.\""
                                            },
                                            {
                                                "example_id": "043d706d-37ba-44fd-b957-a90284535d91",
                                                "sense_id": "9edaf751-d1e9-3296-b129-d8219c0a83c3",
                                                "text": "Sie [die Peschmerga-Kämpfer] wollen die kurdischen Verteidiger von Kobane [Nordsyrien] im Kampf gegen die IS-Terroristen unterstützen."
                                            },
                                            {
                                                "example_id": "dd06600e-c1c6-41e6-bcb9-8b4a078c11cc",
                                                "sense_id": "9edaf751-d1e9-3296-b129-d8219c0a83c3",
                                                "text": "Xerxes I. marschierte nach Athen und verwüstete die Stadt. Sie war schutzlos und ohne Verteidiger, denn die wehrfähigen Männer hatten sich auf die Kriegsschiffe zurückgezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4429d792-60f3-33fa-8184-ac2205350675",
                                        "entry_id": "d7a7a4c6-74e3-3e00-b46a-7733de47ab56",
                                        "glosses": [
                                            "Person, die sich für etwas (zum Beispiel eine Idee) stark macht oder sich gegen etwas (zum Beispiel einen Angriff) wehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a27c084a-27cc-418e-b623-bccabd6c4fe1",
                                                "sense_id": "4429d792-60f3-33fa-8184-ac2205350675",
                                                "text": "„In den wenigen Wochen seiner Abgeordnetentätigkeit profiliert er sich als erzkonservativer Verteidiger der ständisch-monarchischen Ordnung.“"
                                            },
                                            {
                                                "example_id": "6d92e4b7-7ea8-4f81-b625-3dddec791c01",
                                                "sense_id": "4429d792-60f3-33fa-8184-ac2205350675",
                                                "text": "Schon die Jugendlichen von heute nähmen doch kaum noch ein Buch in die Hand, keinen Text mehr, der auf Papier gedruckt ist, und wenn, dann nur noch, um an Infos zur Inbetriebnahme des neusten Smartphones zu kommen. Ha, auch in Zukunft werde es noch Bücher geben, halten die Verteidiger des Kulturgutes Buch dann dagegen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
