                                        "sense_id": "b65dca3c-6153-3013-b5ee-4d6c8bc6412c",
                                        "entry_id": "08349039-6f7c-39de-b0c2-4fd1953f11a6",
                                        "glosses": [
                                            "stav kdy se lidé upomínají na určitou událost či osobnost"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad0fd5a6-adf6-409a-8cff-0edfd8cc63e2",
                                                "sense_id": "b65dca3c-6153-3013-b5ee-4d6c8bc6412c",
                                                "text": "Na památku na zesnulého prezidenta po něm bylo pojmenováno letiště."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "460a375d-0cf6-3005-86c1-e0850c713a9c",
                                        "entry_id": "08349039-6f7c-39de-b0c2-4fd1953f11a6",
                                        "glosses": [
                                            "předmět vyvolávající památku (1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55181477-653d-4e71-938f-2f72110719ef",
                                                "sense_id": "460a375d-0cf6-3005-86c1-e0850c713a9c",
                                                "text": "Tenhle hrníček je památka po mojí babičce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7e721f-3090-3e91-83ab-b7036adc7bba",
                                        "entry_id": "08349039-6f7c-39de-b0c2-4fd1953f11a6",
                                        "glosses": [
                                            "věc historické či kulturní hodnoty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca8dc557-88c1-458c-a77a-896877656f48",
                                                "sense_id": "2f7e721f-3090-3e91-83ab-b7036adc7bba",
                                                "text": "V našem městě se nachází spousta památek, bohužel část z nich chátrá bez jakéhokoliv zájmu úřadů."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65582194-f74a-3e03-8603-e074518fc317",
                                        "entry_id": "08349039-6f7c-39de-b0c2-4fd1953f11a6",
                                        "glosses": [
                                            "svátek, slavnost, obřad či jiná společenská událost pořádaná na památku (1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2453e1e9-da68-47f8-a0e9-5d3dd62481af",
                                                "sense_id": "65582194-f74a-3e03-8603-e074518fc317",
                                                "text": "Památka všech věrných zemřelých"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16559bc-148a-3452-bd8f-c96caf2f3899",
                                        "entry_id": "08349039-6f7c-39de-b0c2-4fd1953f11a6",
                                        "glosses": [
                                            "dožínky, posvícení a masopust"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b078d5-d9d0-4bff-b249-9815fd2c2bb9",
                                                "sense_id": "d16559bc-148a-3452-bd8f-c96caf2f3899",
                                                "text": "„Starý mrav káže o památkách se veselit, jít mezi lidi — svoje bratry — s nimi se potěšit — uctít čas, aby on zase uctil nás.“\n„A kdy je to o památkách? Čemu tak říkáte? Neslyšel jsem to ještě,“ upřímně ptal se Cimbura.\n„To je o obžínkách, když poděkujeme v kostele Bohu za šťastně ukončenou žeň, potom je to dnes, kdy slavíme paměť posvěcení putimského chrámu a pak je to v masopustě, kdy koná se svatební veselí a kdy sedlák v zimě odpočívá a síly sbírá na blížící se jarní práci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
