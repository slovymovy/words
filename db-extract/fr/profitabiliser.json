                "senses": [
                    {
                        "sense_id": "a1122f0a-c5f3-342e-9907-016dd79c9f76",
                        "entry_id": "d0710e2b-b3c2-3e31-96ba-4594417d5c4b",
                        "glosses": [
                            "Donner un caractère profitable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e8198c-90c8-48d0-8855-4bbac9e42e5d",
                                "sense_id": "a1122f0a-c5f3-342e-9907-016dd79c9f76",
                                "text": "Carlos Ghosn indique encore que la stratégie et le modèle commercial justifiant les investissements et les moyens de \"profitabiliser\" les véhicules électriques feraient pleinement partie des secrets internes révélés."
                            },
                            {
                                "example_id": "667cde71-90f3-4a0d-a5f9-714f9854149d",
                                "sense_id": "a1122f0a-c5f3-342e-9907-016dd79c9f76",
                                "text": "Il est un fait que toute entreprise ou compagnie œuvre à profitabiliser ses opérations."
                            },
                            {
                                "example_id": "70968cc2-8312-4a60-bd6c-9139bbf67e45",
                                "sense_id": "a1122f0a-c5f3-342e-9907-016dd79c9f76",
                                "text": "L'assurance implicite derrière une telle promesse requiert les moyens de saisir, de réaliser et de profitabiliser."
                            }
                        ]
                    }
