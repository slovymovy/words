                        "cross_references": [
                            {
                                "target_word": "parabiosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98ba99da-909d-3ead-bb51-d871d3a4ccef",
                                        "entry_id": "f0cb04bd-28f3-339f-a086-685f8aac22fb",
                                        "glosses": [
                                            "The (natural or surgical) union of parts of two organisms, especially in such a way as to cause them to share their vascular systems. Organisms so joined then are called parabionts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b64fbc-bbc3-4817-a1e7-8cd85554003f",
                                                "sense_id": "98ba99da-909d-3ead-bb51-d871d3a4ccef",
                                                "text": "Parabiosis is the condition of more than one living organism joined ..., with ... circulatory fluids being exchanged among the parabionts."
                                            },
                                            {
                                                "example_id": "ad130dc1-c5ed-48fb-bd5a-3373ae31d9fd",
                                                "sense_id": "98ba99da-909d-3ead-bb51-d871d3a4ccef",
                                                "text": "2017 Cosima in \"Manacled Slim Wrists\", Orphan Black\nMud, parabiosis means that he is processing young blood and transfusing it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bcb1898-e2da-3a5b-8e98-f6ab7226b786",
                                        "entry_id": "f0cb04bd-28f3-339f-a086-685f8aac22fb",
                                        "glosses": [
                                            "The fusion of two embryos to form conjoined twins"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b3c7ca-d06e-4447-bdc9-8fc433cf7214",
                                                "sense_id": "1bcb1898-e2da-3a5b-8e98-f6ab7226b786",
                                                "text": "Conjoined identical twins... could be thought of as parabionts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "231e7bca-f36b-3221-ba6f-5630f599d5dd",
                                        "entry_id": "f0cb04bd-28f3-339f-a086-685f8aac22fb",
                                        "glosses": [
                                            "A transient physiological state of suspension of obvious vital activities such as to enable an organism to escape the notice of its enemies or to conserve its energy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cbe93eb-df90-3beb-8db0-9383fd01e991",
                                        "entry_id": "f0cb04bd-28f3-339f-a086-685f8aac22fb",
                                        "glosses": [
                                            "A form of symbiosis, typically among ants, in which different species share common nest galleries but maintain distinct broods and do not practice mutualism other than incidentally."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b8b70d9-e9cf-3c3a-b078-5fbb701ddfc8",
                                        "entry_id": "f0cb04bd-28f3-339f-a086-685f8aac22fb",
                                        "glosses": [
                                            "An alien form of life within an organism, commonly invasive, such as a growing cancer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6552a8b7-532e-435f-a548-16eb647c4a68",
                                                "sense_id": "6b8b70d9-e9cf-3c3a-b078-5fbb701ddfc8",
                                                "text": "1873, Walter Moxon, Guy's Hospital Reports, 3rd series, Vol XVIII https://archive.org/details/3reportsguy18guysuoft\n…the fever sperm coming into ... the living frame ... is able to create a sort of other life or parabiosis within it ...."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
