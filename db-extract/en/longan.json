                    },
                    {
                        "translation_id": "b7f04f3d-53ac-4048-a158-63f089db0d54",
                        "source_entry_id": "d96a3147-b07b-3338-bbf4-af7a36eef016",
                        "source_sense_description": "fruit",
                        "target_lang_word": "longane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f878070-ff66-33c4-b139-6c41fdd5347a",
                                        "entry_id": "d7d3ceaf-d1df-3158-97b3-cd2ef11f7beb",
                                        "glosses": [
                                            "Fruit du longanier (Dimocarpus longan), ressemblant au litchi, dont la peau extérieure, fine et dure, se pèle facilement, et dont l’arille translucide très sucrée entoure un gros noyau noir, dur et brillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb6924a-f3a4-49ea-ace6-6e07520fbed5",
                                                "sense_id": "6f878070-ff66-33c4-b139-6c41fdd5347a",
                                                "text": "Certains autres jours, nous étions ensevelis sous des montagnes de mangues, de longanes, de litchis, de rosette de Lyon, de choux à la crème."
                                            },
                                            {
                                                "example_id": "276260a0-a352-4b49-af0a-25b7e7b740d7",
                                                "sense_id": "6f878070-ff66-33c4-b139-6c41fdd5347a",
                                                "text": "Tout à leur discussion, ils furent surpris d’être déjà arrivés au carrefour marqué par un petit pagodon où l’on avait laissé des gâteaux et des grappes de longanes en offrande au Génie du croisement."
                                            },
                                            {
                                                "example_id": "f3fe82b0-293c-45c9-b501-292f72375372",
                                                "sense_id": "6f878070-ff66-33c4-b139-6c41fdd5347a",
                                                "text": "La résistance du longane aux coups de vent est bien meilleure que celle du letchi."
                                            },
                                            {
                                                "example_id": "3902f7b9-fe07-494a-a146-0dfd4f5a556a",
                                                "sense_id": "6f878070-ff66-33c4-b139-6c41fdd5347a",
                                                "text": "Le longane se consomme frais, en jus, en conserve, sec, les Asiatiques le préfèrent au litchi à cause de ses vertus médicinales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
