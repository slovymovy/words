                "senses": [
                    {
                        "sense_id": "9df9ee7a-af74-3caf-bb69-b209dea65e8a",
                        "entry_id": "5087f42e-4784-3076-9486-55a18f6a0e70",
                        "glosses": [
                            "Donner un caractère colossal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8928928f-5963-4db0-9aee-a1378a6fc8be",
                                "sense_id": "9df9ee7a-af74-3caf-bb69-b209dea65e8a",
                                "text": "Si l’on pouvait risquer un néologisme, l’Allemagne est une nation qui se colossalise."
                            },
                            {
                                "example_id": "03995fa3-805d-4c34-8167-f836d368474f",
                                "sense_id": "9df9ee7a-af74-3caf-bb69-b209dea65e8a",
                                "text": "Il peut diviniser l'homme mais aussi le « colossaliser » dit Sri Aurobindo."
                            },
                            {
                                "example_id": "46be5730-c37e-4c94-85d5-796476c9222e",
                                "sense_id": "9df9ee7a-af74-3caf-bb69-b209dea65e8a",
                                "text": "Non seulement parce qu’elle est en cours et d’un cours pour lequel la fin d’un telos est hors d’atteinte (elle ne l’attend même pas, elle ne l’appelle plus; l’appel même, S.P. l’incisenère, et en intitulant un tableau » hors d’attente » (1985), plutôt que, comme le voudrait l’idiome français, « hors d’atteinte », il colossalise peut-être, avec cette petite différence, la forme non seulement phallique du I absent)."
                            }
                        ]
                    }
