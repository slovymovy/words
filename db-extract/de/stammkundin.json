                    {
                        "sense_id": "4c58eb53-68b1-305f-934c-cef3aa7f1c82",
                        "entry_id": "d228e255-7686-3f1a-b259-695d42b8b151",
                        "glosses": [
                            "Kundin, die immer wieder beim selben Anbieter einkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94f64b86-3773-4afe-be90-4fe4a1c6f624",
                                "sense_id": "4c58eb53-68b1-305f-934c-cef3aa7f1c82",
                                "text": "Für Stammkundinnen gibt es oft besondere Preisnachlässe."
                            },
                            {
                                "example_id": "952d7628-d6af-40f6-8f68-0fa4ed5ce481",
                                "sense_id": "4c58eb53-68b1-305f-934c-cef3aa7f1c82",
                                "text": "„Während die Angestellte und eine Stammkundin mit dem Burschen eine zehnminütige Diskussion führten, fuchtelte der Täter mit dem Messer herum.“"
                            },
                            {
                                "example_id": "0e745d63-8ced-4238-8630-e6d5c79ca2ca",
                                "sense_id": "4c58eb53-68b1-305f-934c-cef3aa7f1c82",
                                "text": "„Marian Willard, eine der Stammkundinnen aus den Zwanzigern, erbot sich sogar, eine New Yorker Dependance der »Freunde« zu eröffnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
