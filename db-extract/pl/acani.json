                ],
                "senses": [
                    {
                        "sense_id": "fc179008-0f26-3386-b4f2-a140bb0b8c41",
                        "entry_id": "3696586d-2929-384b-8d4f-5c9e47a59988",
                        "glosses": [
                            "Anredeform für eine Frau; Sie, meine Dame"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "71be847f-0ab2-4bf6-a421-25be0ee9e51f",
                                "sense_id": "fc179008-0f26-3386-b4f2-a140bb0b8c41",
                                "text": "„Idź, acani, i nie przeszkadzaj mi.“",
                                "translation": "Gehen Sie, meine Dame, und stören Sie mich nicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17d57e0f-c3d1-4c08-aa58-4c9f884f9ca6",
                        "source_entry_id": "3696586d-2929-384b-8d4f-5c9e47a59988",
                        "source_sense_id": "fc179008-0f26-3386-b4f2-a140bb0b8c41",
                        "source_sense_description": "veraltet: Anredeform für eine Frau; Sie, meine Dame",
                        "target_lang_word": "Sie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "777e14d6-73d5-3bf7-9fc5-7df7d0609d46",
                                        "entry_id": "dcca5ce9-b1e0-3f07-9d61-fe355f8a48ff",
                                        "glosses": [
                                            "die offizielle Anrede (im Geschäftsleben, in und an Behörden, privat unter Erwachsenen) an die angesprochene(n) oder angeschriebene(n) Person(en), falls nicht die vertraute Form du verwendet wird, andere Regeln gelten oder Gewohnheit sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c973a6f-bf9a-41c2-8dc3-38ac43cf6ecb",
                                                "sense_id": "777e14d6-73d5-3bf7-9fc5-7df7d0609d46",
                                                "text": "Ich freue mich, Sie kennenzulernen!"
                                            },
                                            {
                                                "example_id": "22bf7a61-203e-4d64-8bfb-43dce4ae8987",
                                                "sense_id": "777e14d6-73d5-3bf7-9fc5-7df7d0609d46",
                                                "text": "Können Sie mir bitte sagen, wie spät es ist?"
                                            },
                                            {
                                                "example_id": "1491bb5b-617c-41dd-b1be-63e5c907b12c",
                                                "sense_id": "777e14d6-73d5-3bf7-9fc5-7df7d0609d46",
                                                "text": "Ach, sind Sie wirklich der Bruder von Thomas Gottschalk?"
                                            },
                                            {
                                                "example_id": "2c16d449-5de7-48a9-a14a-102798fa72d6",
                                                "sense_id": "777e14d6-73d5-3bf7-9fc5-7df7d0609d46",
                                                "text": "Ich möchte Sie alle um Ihre geneigte Aufmerksamkeit bitten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1ca703-b236-3a94-9f9a-2f6ebc0e3fd4",
                                        "entry_id": "3110705d-8f2a-358e-a3a1-a105f238227f",
                                        "glosses": [
                                            "ein Weibchen; ein weibliches Wesen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a00c83d-c710-4409-a0e9-3bc1888cb399",
                                                "sense_id": "dd1ca703-b236-3a94-9f9a-2f6ebc0e3fd4",
                                                "text": "Ist dein Hund ein Er oder eine Sie?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d31ffc98-e56f-324c-9164-0768f6104c4c",
                                        "entry_id": "e8a15386-f22b-3e2f-9f9c-6a8ca4441064",
                                        "glosses": [
                                            "eine besondere Form eines Solos, bei der ein Spieler die acht höchsten Trümpfe (also vier Ober und vier Unter) besitzt"
                                        ],
                                        "tags": [
                                            "Kartenspiele",
                                            "Schafkopf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4282f07a-b1b6-4c4d-821e-d90da97b2afb",
                                                "sense_id": "d31ffc98-e56f-324c-9164-0768f6104c4c",
                                                "text": "„Die Regeln der Schafkopfschule verbieten es, nach einem Sie mit den gleichen Karten weiterzuspielen.“"
                                            },
                                            {
                                                "example_id": "ec84b9c0-4932-4e69-b9ea-dc1e56407214",
                                                "sense_id": "d31ffc98-e56f-324c-9164-0768f6104c4c",
                                                "text": "„Wer ein Solo-Sie spielt, hat praktisch bereits vor dem ersten ausgespielten Blatt gewonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c8a92f4-fffd-4a9d-877f-5f4c64581aaa",
                        "source_entry_id": "3696586d-2929-384b-8d4f-5c9e47a59988",
                        "source_sense_id": "fc179008-0f26-3386-b4f2-a140bb0b8c41",
                        "source_sense_description": "veraltet: Anredeform für eine Frau; Sie, meine Dame",
                        "target_lang_word": "mein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b297fe46-b7e3-358d-8763-3541a47cdfa8",
                                        "entry_id": "d8bec85c-f80f-3ab3-9c44-b883e1a53797",
                                        "glosses": [
                                            "zeigt den Besitz, das Eigentum oder die Zugehörigkeit einer Person bzw. Sache zu sich selbst an"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4ddd8b0-1f0f-4ef7-abb4-7582042cfe45",
                                                "sense_id": "b297fe46-b7e3-358d-8763-3541a47cdfa8",
                                                "text": "Er ist mein Taufpate."
                                            },
                                            {
                                                "example_id": "6ffada0e-ace4-44ee-aa8f-1328a344e7bf",
                                                "sense_id": "b297fe46-b7e3-358d-8763-3541a47cdfa8",
                                                "text": "Das ist dein Haus; mein[e]s (gehoben: das meine) steht hier."
                                            },
                                            {
                                                "example_id": "0d987853-cde9-403e-a0d3-2cb943b94220",
                                                "sense_id": "b297fe46-b7e3-358d-8763-3541a47cdfa8",
                                                "text": "„Gen Himmel zu dem Vater mein fahr ich von diesem Leben“ (Lied Nun freut euch, lieben Christen g'mein)"
                                            },
                                            {
                                                "example_id": "67e1e989-ac0f-4203-b631-bb564c7822ef",
                                                "sense_id": "b297fe46-b7e3-358d-8763-3541a47cdfa8",
                                                "text": "Ich möchte mit meinem Anwalt sprechen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "mein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95be049b-d5c5-3a5f-b372-7e0ddac1fee6",
                                        "entry_id": "792f52e0-74de-3574-bbb0-932276c2b6cd",
