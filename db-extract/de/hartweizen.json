                                "target_senses": [
                                    {
                                        "sense_id": "c04f0444-a045-309d-8a77-5a0967ceb2c9",
                                        "entry_id": "b60cfc67-90ea-37b7-8d38-0946d4fd4144",
                                        "glosses": [
                                            "Triticum turgidum subsp. durum, syn. Triticum durum (hard wheat), the flour of which is used to make pasta and bread."
                                        ],
                                        "tags": [
                                            "countable",
