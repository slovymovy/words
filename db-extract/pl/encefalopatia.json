                    {
                        "sense_id": "f45a5ec4-0e87-382a-9016-2acc4ecf6f52",
                        "entry_id": "e2696418-c742-3e4d-9d61-35631087415b",
                        "glosses": [
                            "ogólne określenie uszkodzenia mózgu przez czynniki różnego pochodzenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74f9ddd6-078f-48dd-8500-0f76f61c9e01",
                                "sense_id": "f45a5ec4-0e87-382a-9016-2acc4ecf6f52",
                                "text": "Do zarażenia dochodzi prawdopodobnie po zjedzeniu mięsa krów cierpiących na encefalopatię gąbczastą"
                            },
                            {
                                "example_id": "ac76a690-6d3e-43ed-844f-2c3976f260ba",
                                "sense_id": "f45a5ec4-0e87-382a-9016-2acc4ecf6f52",
                                "text": "Najwięcej trudności diagnostycznych sprawia minimalna encefalopatia wątrobowa (utajona), gdyż wtedy obserwujemy brak objawów neurologicznych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d86d4d13-b735-496f-a36f-c55838fcb1a5",
                        "source_entry_id": "e2696418-c742-3e4d-9d61-35631087415b",
                        "source_sense_id": "f45a5ec4-0e87-382a-9016-2acc4ecf6f52",
                        "target_lang_word": "encephalopathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encephalopathy",
