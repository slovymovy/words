                        "glosses": [
                            "een moeilijkheid die er is bij het beginnen van iets nieuws maar die verdwijnt als men meer ervaring krijgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6594b40e-8433-42bc-b48e-9c0bf50b1e70",
                                "sense_id": "93cbcf21-8e58-34bb-884b-244262172d25",
                                "text": "„De afgelopen twee jaar kampten we met aanloopproblemen en een storing in de software, nu flitsen we weer op volle kracht”, zegt Egbert-Jan van Hasselt, verantwoordelijk voor verkeersveiligheid bij de Nationale Politie in het AD."
                            },
                            {
                                "example_id": "005f7bee-ae0c-4586-b21e-e448386150d8",
                                "sense_id": "93cbcf21-8e58-34bb-884b-244262172d25",
                                "text": "De woordvoerder stelt dat het gebeuren van zondag om een incident gaat. „Wij hadden eerst aanloopproblemen, maar die zijn nu voorbij.”"
                            }
                        ]
