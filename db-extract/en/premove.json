                "senses": [
                    {
                        "sense_id": "877c9d98-6582-3d68-b374-c849c16acde8",
                        "entry_id": "76bb2c74-fde6-3ba5-a49c-0e11f815bd7f",
                        "glosses": [
                            "To make a premove."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "32c6f797-c00f-4222-bc60-1144d815c486",
                                "sense_id": "877c9d98-6582-3d68-b374-c849c16acde8",
                                "text": "Game 18 was another up-and-down affair. First, Esipenko dropped a full rook, which went unpunished as Sarana had probably premoved his reply."
                            },
                            {
                                "example_id": "d5c4cbae-dd2d-49ab-89a2-83395daa129b",
                                "sense_id": "877c9d98-6582-3d68-b374-c849c16acde8",
                                "text": "The second game was drawn. In the third, a bit of drama happened: in a position that was somewhere between equality and a slight advantage to White, Nakamura, by misclicking or premoving or for whatever other reason, hung a piece to a one-move tactic."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e0869b9-bc30-3783-92c4-6745df216acd",
                        "entry_id": "76bb2c74-fde6-3ba5-a49c-0e11f815bd7f",
                        "glosses": [
                            "To incite or cause someone to do something."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "346aee87-29c1-45af-8f2a-113352330b50",
                                "sense_id": "6e0869b9-bc30-3783-92c4-6745df216acd",
                                "text": "Let it be assumed, then, that God does premove earthly phenomena, and let the further very obvious supposition be also made that He does not desire this premovement to be a visible and palpable fact."
                            }
                        ]
                    },
                    {
                        "sense_id": "7122d29b-5481-34f5-a2c4-ac70246b6fda",
                        "entry_id": "76bb2c74-fde6-3ba5-a49c-0e11f815bd7f",
                        "glosses": [
                            "To promote or endorse."
