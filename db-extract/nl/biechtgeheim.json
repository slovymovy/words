                        "entry_id": "3249b3df-f0a0-3af2-9fbf-f00af60577be",
                        "glosses": [
                            "de verplichting om datgene wat de priester tijdens de biecht verneemt geheim te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36959526-8256-4875-b579-7516515c5c5f",
                                "sense_id": "dbec4b7c-8f49-337a-9bda-5faf95a2f417",
                                "text": "Hij moest zich aan zijn biechtgeheim houden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa3ccf3f-c4ff-40af-8536-de3c380b4538",
                        "source_entry_id": "3249b3df-f0a0-3af2-9fbf-f00af60577be",
                        "source_sense_id": "dbec4b7c-8f49-337a-9bda-5faf95a2f417",
                        "source_sense_description": "de verplichting om datgene wat de priester tijdens de biecht verneemt geheim te houden",
                        "target_lang_word": "Beichtgeheimnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beichtgeheimnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d57923b-28c0-3864-a31a-a2777e8b09dc",
                                        "entry_id": "6f521960-f8c3-377e-bfc7-8d47811dd3f3",
                                        "glosses": [
                                            "das strikte Verbot für den Priester, Informationen, die er im Kontext einer Beichte erhalten hat, irgendwem weiterzugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03fe4e56-0ebb-47c6-aaa5-759dcbfeeb20",
                                                "sense_id": "6d57923b-28c0-3864-a31a-a2777e8b09dc",
                                                "text": "Ein Priester, der das Beichtgeheimnis bricht, zieht sich die Tatstrafe der Exkommunikation zu."
                                            },
                                            {
                                                "example_id": "e0276822-db54-49ba-934b-f869ac68edd8",
                                                "sense_id": "6d57923b-28c0-3864-a31a-a2777e8b09dc",
                                                "text": "Nach can. 983 CIC darf das Beichtgeheimnis unter keinen Umständen gebrochen werden."
                                            },
                                            {
                                                "example_id": "7e2435ae-aa2b-45bd-956d-c04c3a89f659",
                                                "sense_id": "6d57923b-28c0-3864-a31a-a2777e8b09dc",
                                                "text": "Erfährt ein Priester in der Beichte von einem Mord, kann er dem Schuldigen Pönitent ein Geständnis anraten und unter bestimmten Bedingungen die Absolution (Lossprechung) aufschieben, doch keinesfalls jemanden darüber informieren oder staatlichen Stellen gegenüber Auskünfte geben."
                                            },
                                            {
                                                "example_id": "4a96e714-7bc3-4f7b-bfe7-ddcbce0095cf",
                                                "sense_id": "6d57923b-28c0-3864-a31a-a2777e8b09dc",
                                                "text": "Das Beichtgeheimnis gilt auch für alle anderen, die irgendwie Kenntnis über das Beichtgespräch erhalten haben, beispielsweise Übersetzer."
                                            },
                                            {
                                                "example_id": "733a5738-2fd6-447c-8944-71901b1bc35c",
                                                "sense_id": "6d57923b-28c0-3864-a31a-a2777e8b09dc",
                                                "text": "„Ich glaubte an das Beichtgeheimnis und war nicht fähig zu schwindeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
