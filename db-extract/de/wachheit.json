                        "glosses": [
                            "Zustand, in dem wenig oder kaum Müdigkeit empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3134ed-a6b0-407c-a144-f6389a87468b",
                                "sense_id": "8c6f7b92-6677-3714-81b3-7c75e918fd2d",
                                "text": "Nach einem 10-Stunden-Schlaf befand sich der Patient in einem Zustand absoluter Wachheit."
                            },
                            {
                                "example_id": "48810571-601c-4004-b213-ea0d21389133",
                                "sense_id": "8c6f7b92-6677-3714-81b3-7c75e918fd2d",
                                "text": "„Das Gefühl von Wachheit und Sensibilität trage sie durch das ganze Konzert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
