    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "85cb104a-5a6e-3f27-908e-392b8a1fb8a5",
                "word": "abubble",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "162b6c2e-81ac-3932-a9e1-dbf257063c3c",
                        "entry_id": "85cb104a-5a6e-3f27-908e-392b8a1fb8a5",
                        "glosses": [
                            "In a state of excitement, agitated activity, or motion."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6f92689d-533a-46d2-be19-04ca49d1bbb1",
                                "sense_id": "162b6c2e-81ac-3932-a9e1-dbf257063c3c",
                                "text": "After they had sat down, the party remained abubble until the speaker rose."
                            },
                            {
                                "example_id": "f0252edb-fe3b-4a17-8b68-eda4dce5159e",
                                "sense_id": "162b6c2e-81ac-3932-a9e1-dbf257063c3c",
                                "text": "1885, Alexander Stewart, ’Twixt Ben Nevis and Glencoe, Edinburgh: William Paterson, Chapter 46, p. 337,\nIt was at times as if a score of tiny rainbows of the most brilliant hues were being rapidly interwoven, only to be instantly untwisted again, in order to be rewoven into a newer and still brighter pattern, in and over an acre of sea, all abubble and aboil with the gambols of the frolicsome shoal."
                            },
                            {
                                "example_id": "959a9e6f-94ce-4410-8b05-6e6e6c30ca66",
                                "sense_id": "162b6c2e-81ac-3932-a9e1-dbf257063c3c",
                                "text": "The men in stripes worked a shorter day than I at my machine. And there was vastly more romance in being an oyster pirate or a convict than in being a machine slave. And behind it all, behind all of me with youth a-bubble, whispered Romance, Adventure."
                            },
                            {
                                "example_id": "fff540bf-4c8b-4207-bb20-ecf49e997baa",
                                "sense_id": "162b6c2e-81ac-3932-a9e1-dbf257063c3c",
                                "text": "When we left the restaurant he was all abubble and said over and over again that he’d had the best time that evening he had ever had in the Army."
                            },
                            {
                                "example_id": "a958d22d-3d7f-400b-96bd-2d98c06cebfb",
                                "sense_id": "162b6c2e-81ac-3932-a9e1-dbf257063c3c",
                                "text": "Dr. Walter Dürrfeld […] a director of IG Farbenindustrie, that […] conglomerate—inconceivably huge even for its day—whose prestige and size are alone enough to set Professor Biegański’s mind abubble with giddy euphoria."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0a6cc77-1a5f-3901-bab0-eeb5e70fd03d",
                        "entry_id": "85cb104a-5a6e-3f27-908e-392b8a1fb8a5",
                        "glosses": [
                            "Bubbling."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "56944e0a-cb4c-4e12-b3c4-74ced115fb3b",
                                "sense_id": "f0a6cc77-1a5f-3901-bab0-eeb5e70fd03d",
                                "text": "The sour mash was abubble."
                            },
                            {
                                "example_id": "ca575393-11ac-4f6c-9cd1-67157b77069d",
                                "sense_id": "f0a6cc77-1a5f-3901-bab0-eeb5e70fd03d",
                                "text": "Part haste the boiling caldron all a-bubble,"
                            }
                        ]
                    }
