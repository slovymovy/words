                {
                    "sense_id": "f0722ef8-bb1f-3897-b919-d29a7dbf18be",
                    "sense_definition": "Sytuacja, w której wszyscy mają to samo zdanie lub opinię na dany temat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej kwestii panowała wśród nas pełna <zgoda>.",
                            "target_lang_translations": {
                                "ru": "В этом вопросе среди нас царило полное <согласие>.",
                                "en": "There was complete <agreement> among us on this matter.",
                                "nl": "Op dit punt heerste er onder ons volledige <overeenstemming>.",
                                "de": "In dieser Frage herrschte unter uns völlige <w>Einigkeit</w>.",
                                "fr": "Sur cette question, il y avait un <accord> total parmi nous.",
                                "it": "Su questo punto c'era pieno <accordo> tra di noi.",
                                "cs": "V této otázce mezi námi panovala naprostá <w>shoda</w>.",
                                "tr": "Bu konuda aramızda tam bir <fikir birliği> vardı.",
                                "es": "En este asunto había un pleno <w>acuerdo</w> entre nosotros."
                            }
                        },
                        {
                            "text": "Politykom trudno było dojść do <zgody> w sprawie budżetu.",
                            "target_lang_translations": {
                                "ru": "Политикам было трудно прийти к <согласию> по вопросу бюджета.",
                                "en": "It was difficult for politicians to reach an <agreement> on the budget.",
                                "nl": "Het was voor politici moeilijk om tot een <akkoord> te komen over de begroting.",
                                "de": "Für die Politiker war es schwierig, eine <w>Einigung</w> in der Budgetfrage zu erzielen.",
                                "fr": "Il a été difficile pour les politiciens de parvenir à un <consensus> sur le budget.",
                                "it": "È stato difficile per i politici raggiungere un <accordo> sul bilancio.",
                                "cs": "Pro politiky bylo těžké dosáhnout <w>shody</w> ohledně rozpočtu.",
                                "tr": "Siyasetçilerin bütçe konusunda bir <anlaşmaya> varması zordu.",
                                "es": "A los políticos les resultó difícil llegar a un <w>acuerdo</w> sobre el presupuesto."
                            }
                        }
                    ],
                    "synonyms": [
                        "porozumienie"
                    ],
                    "common_phrases": [
                        "dojść do zgody",
                        "pełna zgoda",
                        "brak zgody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, когда у всех одинаковое мнение или взгляд на данную тему.",
                        "en": "A situation in which everyone has the same opinion or view on a given topic.",
                        "nl": "Situatie waarin iedereen dezelfde mening of opvatting heeft over een bepaald onderwerp.",
                        "de": "Situation, in der alle dieselbe Meinung oder Ansicht zu einem Thema haben.",
                        "fr": "Situation dans laquelle tout le monde partage la même opinion ou le même avis sur un sujet donné.",
                        "it": "Situazione in cui tutti hanno la stessa opinione o punto di vista su un determinato argomento.",
                        "cs": "Situace, kdy mají všichni stejný názor na dané téma.",
                        "tr": "Herkesin belirli bir konuda aynı fikirde veya görüşte olması durumu.",
                        "es": "Situación en la que todos tienen la misma opinión o punto de vista sobre un tema."
                    },
