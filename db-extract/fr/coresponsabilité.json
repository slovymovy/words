                "senses": [
                    {
                        "sense_id": "ba098e05-4d14-3fff-b850-d8c3785d4d93",
                        "entry_id": "638e03fb-16e9-3ce7-993b-e5c05bdba7c2",
                        "glosses": [
                            "Fait d’être coresponsable, obligé de répondre de ses actions, de celles des autres, ou d’en être garant, à même niveau qu’une autre personne ou entité"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec5c0d3-c2bf-4abe-b719-a47eca62984d",
                                "sense_id": "ba098e05-4d14-3fff-b850-d8c3785d4d93",
                                "text": "L’Allemagne a reconnu jeudi soir pour la première fois le «génocide» arménien par la voix de son président Joachim Gauck, qui a souligné la «coresponsabilité» allemande dans ce crime."
                            },
                            {
                                "example_id": "19a78067-9521-41c8-83a7-612cce7ba8b6",
                                "sense_id": "ba098e05-4d14-3fff-b850-d8c3785d4d93",
                                "text": "En toute coresponsabilité, nous partageons les rôles."
                            },
                            {
                                "example_id": "7d0c77c3-de46-4147-989a-d6a7f44b703b",
                                "sense_id": "ba098e05-4d14-3fff-b850-d8c3785d4d93",
                                "text": "La coresponsabilité parentale, garantit à l’enfant le respect de son droit par ses deux parents, responsables à égalité."
                            },
                            {
                                "example_id": "4f8d5c02-390e-4507-8cc1-0493074fc80b",
                                "sense_id": "ba098e05-4d14-3fff-b850-d8c3785d4d93",
                                "text": "La coresponsabilité parentale, les mêmes devoirs dans la coparentalité."
                            }
                        ]
                    }
                ],
