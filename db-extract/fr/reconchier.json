                "senses": [
                    {
                        "sense_id": "a49346db-ae28-3565-8878-d66a3a7ad2ff",
                        "entry_id": "35f21caa-9ee5-3fd9-8c2d-6439bd5e1a4f",
                        "glosses": [
                            "Conchier de nouveau."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "96f427cc-75c3-455a-94dd-dc751d726733",
                                "sense_id": "a49346db-ae28-3565-8878-d66a3a7ad2ff",
                                "text": "Maudit pays, affreuse contrée, répugnante région ! Je te conchie et reconchie ! Sur ces mots vengeurs, Aristobule Lepépin se lève."
                            },
                            {
                                "example_id": "10db55a5-b26f-4963-a5d7-15bbe1557641",
                                "sense_id": "a49346db-ae28-3565-8878-d66a3a7ad2ff",
                                "text": "Tu vois la différence entre vouloir chier, conchier et reconchier une idéologie de merde, et pas vouloir stigmatiser l’ensemble d’une population qui sont originaires de pays où cette idéologie est majoritaire ?"
                            }
                        ]
                    }
                ],
