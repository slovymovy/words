                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ceb427-7ae2-4bff-92d9-8eae2c287bb7",
                                                "sense_id": "df48ced6-2e9c-3b59-a6dc-b58c8cb69770",
                                                "text": "Mettre ses ressources en commun."
                                            },
                                            {
                                                "example_id": "085fba27-dad5-4b7c-85b6-cd33565659c3",
