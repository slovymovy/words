                "senses": [
                    {
                        "sense_id": "f0031507-3a96-3cb7-8d47-51dbf689e3d5",
                        "entry_id": "d76cea64-2bd7-3c67-9bc6-64d753b80ede",
                        "glosses": [
                            "bijzonder belangrijk of goed ogenblik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25512ee5-16f6-4b2a-80f3-39fed2b6ea7c",
                                "sense_id": "f0031507-3a96-3cb7-8d47-51dbf689e3d5",
                                "text": "Toch zijn wij er bijzonder aan gehecht, omdat het hier ter plekke naar het leven is geschilderd, toen de vioolvirtuoos op het hoogtepunt van zijn roem in dit hotel verbleef op doorreis naar bijval en furore aan de grote vorstenhoven van Europa."
                            },
                            {
                                "example_id": "645706c7-b5cd-4417-bf00-2835d4d4e10c",
                                "sense_id": "f0031507-3a96-3cb7-8d47-51dbf689e3d5",
                                "text": "Ik was verheugd de CAMP Corsa Nanotech IJsbijl (205 gram) te zien, en de Kahtoola microspikes voor onder mijn schoenen in de sneeuw. Verder zaten er handschoenen, een lange wollen onderbroek, een sneeuwbril en een hele lading pillen in. Maar het hoogtepunt van de dag was mijn nieuwe paar schoenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b925dac0-bd9d-34b7-ab80-c37abda17475",
                        "entry_id": "d76cea64-2bd7-3c67-9bc6-64d753b80ede",
                        "glosses": [
                            "het snijpunt van de hoogtelijnen van een driehoek"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "02bf836a-d7f6-3b08-9a92-54b08e19b1d3",
                        "entry_id": "d76cea64-2bd7-3c67-9bc6-64d753b80ede",
                        "glosses": [
                            "orgasme"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43b33706-1f40-4596-a2d9-b8fe573aaed4",
                        "source_entry_id": "d76cea64-2bd7-3c67-9bc6-64d753b80ede",
                        "source_sense_id": "f0031507-3a96-3cb7-8d47-51dbf689e3d5",
                        "source_sense_description": "bijzonder belangrijk of goed ogenblik",
                        "target_lang_word": "Höhepunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höhepunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                        "entry_id": "8eba4bc8-2d6e-3cce-8672-93c353945c48",
                                        "glosses": [
                                            "der beste oder einer der besten Punkte in einer längeren Abfolge von verschiedenen Ereignissen, die sich vorher schon positiv entwickelt haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "465a550e-e338-40d3-8194-dff18ff08227",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "„Der Ausflug in den Zoo war der Höhepunkt meiner Herbstferien.“"
                                            },
                                            {
                                                "example_id": "ca3cd483-760f-4cff-93d2-6666a7d09062",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "Einer der Höhepunkte dieses Konzertes war sicher das Duett der beiden Sängerinnen."
                                            },
                                            {
                                                "example_id": "58e6d142-4dee-4a59-9124-a70609f5e304",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "Das war der Höhepunkt seiner Karriere."
                                            },
                                            {
                                                "example_id": "f8aab14e-5cc6-43f8-b489-26d9c19ae6b7",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "„Das Wirtschaftswachstum, das 2010 mit 7,5 Prozent seinen Höhepunkt erreichte, ist fast zum Erliegen gekommen.“"
                                            },
                                            {
                                                "example_id": "57da332e-9822-4231-a97c-b330264d2ff8",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "„Ein halbes Jahr später erreichte die ausländerfeindliche Hetze ihren nächsten Höhepunkt.“"
                                            },
                                            {
                                                "example_id": "83491752-27b9-4d06-8c27-830a8e5fe4da",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "„Der Höhepunkt unserer Begegnung war die Vollversammlung der Société de Géographie drei Tage später.“"
                                            },
                                            {
                                                "example_id": "a2c545f8-ea43-4792-9439-aabc12eed78e",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "„Ich will vom Höhepunkt dieser Tage berichten.“"
                                            },
                                            {
                                                "example_id": "3d675d8e-3232-4516-99bc-189a23a0d635",
                                                "sense_id": "8c7d9d55-b170-3726-9f9a-958afdf3811a",
                                                "text": "[…] Großbritannien muss umgerechnet 56 Milliarden Euro neue Schulden aufnehmen. Die Staatsverschuldung erreicht mit über 86 Prozent des Sozialprodukts einen Höhepunkt, sie soll dann aber bis zum Jahr 2022 unter die 80 Prozent-Marke fallen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3da0a3eb-2ca4-3a1b-8327-830af80e7b4b",
                                        "entry_id": "8eba4bc8-2d6e-3cce-8672-93c353945c48",
                                        "glosses": [
                                            "sexueller Höhepunkt beim Geschlechtsverkehr oder der Onanie"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c7ade1-046b-4e7e-88b5-223d417c9130",
                                                "sense_id": "3da0a3eb-2ca4-3a1b-8327-830af80e7b4b",
                                                "text": "Und, bist Du gestern Nacht noch zum Höhepunkt gekommen?"
                                            },
                                            {
                                                "example_id": "994f669b-f2ba-4e03-85b8-5709f89cb94c",
                                                "sense_id": "3da0a3eb-2ca4-3a1b-8327-830af80e7b4b",
                                                "text": "„Sie hatte gewollt, dass er den Höhepunkt hinauszögerte; jetzt antwortete sie mit einer stillen Extase, einem dezenten Orgasmus.“"
                                            },
                                            {
                                                "example_id": "986d86cd-95de-4c80-a71f-894ac38e425e",
                                                "sense_id": "3da0a3eb-2ca4-3a1b-8327-830af80e7b4b",
                                                "text": "„Eher als gedacht, kam der Höhepunkt, an dem das Wonne-Einhorn die beglückenden Empfindungen nicht höher steigern konnte und mit dem Safte, von dem wie von Moschus und Orchideen Duft ausströmte, ihren Schoß füllte.“"
                                            },
                                            {
                                                "example_id": "c87ed660-b4c4-4ea9-b13d-52b1b84d3aa4",
                                                "sense_id": "3da0a3eb-2ca4-3a1b-8327-830af80e7b4b",
                                                "text": "„Wir haben uns geliebt, er ist ein schöner Mensch, ein guter Liebhaber, er liebt mich, und trotzdem habe ich mir kurz vor dem Höhepunkt auf die Lippen beißen müssen, um nicht deinen Namen zu flüstern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
