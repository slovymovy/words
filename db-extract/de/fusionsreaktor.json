                "senses": [
                    {
                        "sense_id": "0857981c-52f9-3c4f-9656-1fb1cf015ee2",
                        "entry_id": "2a352e88-d5e0-3a8e-ab99-28ba6a35c3fd",
                        "glosses": [
                            "technische Anlage, in der eine kontrollierte Kernfusion abläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3873b794-9d9a-418e-b53d-267986b97c49",
                                "sense_id": "0857981c-52f9-3c4f-9656-1fb1cf015ee2",
                                "text": "„Auch als Brennstoff zukünftiger Fusionsreaktoren werden Deuteronen benötigt.“"
                            },
                            {
                                "example_id": "1dbad988-6302-445c-8527-94834195d6f6",
                                "sense_id": "0857981c-52f9-3c4f-9656-1fb1cf015ee2",
                                "text": "„Ein Fusionsreaktor benötigt einen Divertor, wo Teilchen, die den inneren Einschlussbereich des Magnetfeldes verlassen, mittels einer Magnetfeldstruktur gezielt auf dafür vorgesehene Prallplatten gelenkt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
