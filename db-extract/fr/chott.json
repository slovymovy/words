                        "form": "chotts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "edd237d8-02a9-35fa-b3ce-cd95489839f1",
                        "entry_id": "744e9d33-be6f-3c8b-a569-32873551392b",
                        "glosses": [
                            "Vaste dépression de terrain, en Algérie et en Tunisie, renfermant ou ayant renfermé un lac salé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51e199c-1fb8-4769-b0c6-f93f506546f4",
                                "sense_id": "edd237d8-02a9-35fa-b3ce-cd95489839f1",
                                "text": "Deux années auparavant, Hama Srir chassait avec Sélem dans les environs du bordj de Stah-el-Hamraïa, dans la région des grands chotts sur la route de Biskra à El Oued."
                            },
                            {
                                "example_id": "7faeeabe-888f-4458-b640-9b065e9751e4",
                                "sense_id": "edd237d8-02a9-35fa-b3ce-cd95489839f1",
                                "text": "[…]\n Et les dépressions d’or plus sombre où s’endorment\n Les chotts et les sebkhas dont les eaux lourdes\n Ont des reflets de froid métal brillant et morne,\n Angoissants comme des sourires ennemis ;\n […]"
                            },
                            {
                                "example_id": "06fed5c5-64ef-4113-9eb1-94ccca8b38af",
                                "sense_id": "edd237d8-02a9-35fa-b3ce-cd95489839f1",
                                "text": "Ou bien, le long d’une route jalonnée, mais défoncée et par instants presque dangereuse, ils traversaient des chotts immenses et c’était, de chaque côté, à perte de vue, une croûte blanchâtre qui brillait sous le soleil, suscitant, à l’horizon, des scintillations fugitives qui par instants ressemblaient presque à des mirages, à des vagues déferlant, à des murailles crénelées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1ecc62c-96d4-438a-91f7-662ef75da753",
                        "source_entry_id": "744e9d33-be6f-3c8b-a569-32873551392b",
                        "source_sense_id": "edd237d8-02a9-35fa-b3ce-cd95489839f1",
                        "target_lang_word": "Salzsee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salzsee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8866653f-f23c-39f1-80d4-93d5404a4803",
                                        "entry_id": "a64c60c4-81ee-3419-a958-b39db89ed39d",
                                        "glosses": [
                                            "See mit Salzwasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a204298-6cc2-4207-bcf7-6c0d17d1e56c",
                                                "sense_id": "8866653f-f23c-39f1-80d4-93d5404a4803",
                                                "text": "„Südlich des Winnipeg-Sees gibt es einige kleinere Salzseen.“"
                                            },
                                            {
                                                "example_id": "cf76d1bc-838c-4958-bd4e-3cf015d98b42",
                                                "sense_id": "8866653f-f23c-39f1-80d4-93d5404a4803",
                                                "text": "„Die letzten Kilometer in Tunesien führten mich über den außerirdisch anmutenden Chott el Jerid, einen riesigen Salzsee, der in allen denkbaren Schattierungen von Pink und Lila das Sonnenlicht reflektierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
