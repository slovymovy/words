                    {
                        "translation_id": "5498fa7e-7cce-4bb1-8e6c-57b157869a6e",
                        "source_entry_id": "5bc5df06-5837-3b31-ba2d-60b57569627c",
                        "source_sense_id": "9b3496c8-b9b2-3baf-974f-09d4c0c9acbf",
                        "source_sense_description": "to expose one's body to the sun",
                        "target_lang_word": "prendre un bain de soleil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "24c19c0d-0c21-47ea-ac2f-6f8de491cbb9",
                        "source_entry_id": "5bc5df06-5837-3b31-ba2d-60b57569627c",
                        "source_sense_id": "9b3496c8-b9b2-3baf-974f-09d4c0c9acbf",
                        "source_sense_description": "to expose one's body to the sun",
                        "target_lang_word": "sonnenbaden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonnenbaden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                        "entry_id": "30438b5f-5244-3525-a5e5-0d8b8479b49a",
                                        "glosses": [
                                            "ein oder mehrere Sonnenbäder nehmen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9282222-9143-4db6-83d8-a17fa9a6a563",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Von gewöhnlichen Sonnenstrahlen bekommst du den Sonnenbrand: wenn du zuviel sonnenbadest, kannst du sogar Brandwunden kriegen.“"
                                            },
                                            {
                                                "example_id": "fb7d07d5-700c-4927-b843-f31a4ee0e0ba",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Erst seitdem man sich im Freien auszieht und ausgiebig sonnenbadet, nehmen die Melanome zu.“"
                                            },
                                            {
                                                "example_id": "69ac0237-f2a4-4665-82e5-1b16c42d748d",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Die Mehrzahl der Gäste, so erzählt Hotelbesitzer Serag Hwaidak, wolle einfach nur relaxen - essen, trinken, ausruhen, sonnenbaden, schwimmen und schnorcheln.“"
                                            },
                                            {
                                                "example_id": "6cbd8dbe-af0b-4bac-a3df-1c779411c40e",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Die helleren Stellen im Brust- und Intimbereich lassen darauf schließen, daß im Bikini sonnengebadet wurde.“"
                                            },
                                            {
                                                "example_id": "e42fdbe1-bb12-4694-a762-e7faba80f29d",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Bald darauf hielt sie ihm vor, dass er sich nur mit Shorts bekleidet im heimischen Garten sonnenbade: ‚Du bist nicht mehr doll und attraktiv genug, um dich in Sichtweite der Nachbarn so ihm Liegestuhl präsentieren zu können.‘“"
                                            },
                                            {
                                                "example_id": "4808aca2-1167-465e-be44-144551be4156",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Schatz, du sonnenbadest zu viel, das geht nicht.“"
                                            },
                                            {
                                                "example_id": "1a2ac96d-bd20-4921-8cf2-7bd0827b8643",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Zum Ersten haben in Österreich und Deutschland keineswegs nur die von der Geschichtsschreibung erfassten Widerstandskämpfer Widerstand geleistet: Als die Polizei bei meinen Eltern anklopfte, weil ein Nachbar angezeigt hatte, dass eine unbekannte Frau - die von meinen Eltern versteckte Jüdin - auf der Dachterrasse sonnenbade, gab sich eine zufällig zu Besuch anwesende arische Studentin ohne mit der Wimper zu zucken als die Gesuchte aus.“"
                                            },
                                            {
                                                "example_id": "cc8b4acf-c632-4c0e-ab49-5e89a758dc5d",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Ich liebe das Meer, besonders im Winter; ich liebe es, an den Strand zu gehen, auch wenn ich nie sonnenbade.“"
                                            },
                                            {
                                                "example_id": "55ec7dbf-3397-42db-8504-5cdd1d47ba40",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Junge Sachsen schützen sich zu selten vor schädlicher Sonnenstrahlung. Das hat eine repräsentative Umfrage von Academic Data ergeben. […] Jeder Zweite gab jedoch an, oft sonnenzubaden.“"
                                            },
                                            {
                                                "example_id": "3fc4bc39-2379-4cdf-a314-764f3e3790f2",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Das befreundete Ehepaar Walser mit den vier kleinen Töchtern verbrachte bei ihnen auf Sylt seine Sommerurlaube, wo zwischen 1966 und 1968 ein illustres Kulturvölkchen gemeinsam sonnenbadete.“"
                                            },
                                            {
                                                "example_id": "81f2cb32-41e7-4740-9f46-341f9f202c4d",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„So aktiv er in Job und Sport sei, so passiv pflege er die Freizeit zu verbringen: vorzugsweise sonnenbadend am See.“"
                                            },
                                            {
                                                "example_id": "233237f2-7512-460e-8068-6127e8455178",
                                                "sense_id": "63ffdc31-ab88-34ec-9931-832d521a5aff",
                                                "text": "„Eine Lehre, die er aus dem vergangenen Jahr gezogen hatte, als ihn Paparazzi dabei ertappten, wie er und seine sich im Bikini räkelnde Lebensgefährtin an der Côte d’Azur sonnenbadeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8ddf5ce-235d-4005-a534-853e0e1b263d",
                        "source_entry_id": "5bc5df06-5837-3b31-ba2d-60b57569627c",
