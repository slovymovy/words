                        "entry_id": "20e60337-acb2-3b37-a65a-471fbbfa39d0",
                        "glosses": [
                            "The raw material or partially finished piece that is shaped by performing various operations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a907fa0-4fdd-4748-a4fe-bd1ae6d990b7",
                                "sense_id": "620ab838-7f02-3d10-8f4b-46453f106487",
                                "text": "Make sure the workpiece is properly secured in the chuck before turning on the lathe."
                            },
                            {
                                "example_id": "9664b5df-e53f-4ebd-a9f4-9231ff9befd2",
                                "sense_id": "620ab838-7f02-3d10-8f4b-46453f106487",
                                "text": "It is theorized that when the surface velocity is below certain minimum values the material at the interface between workpieces WP-1 and WP-2 rolls up and extrudes from the interface in the form of long twisted cylindrical projections which are sometimes referred to as \"dingle-berries.\""
                            },
                            {
                                "example_id": "292c741f-fc85-48b8-a11e-f5484fb5019b",
                                "sense_id": "620ab838-7f02-3d10-8f4b-46453f106487",
                                "text": "If the operator violates this instruction and, for example, tries to slightly move the workpiece while the robot is screwdriving it, then the execution may be interrupted […]"
                            }
                        ]
                    }
