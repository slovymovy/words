            "senses": [
                {
                    "sense_id": "3175cfc2-1999-3aeb-8364-af649fe6c5f0",
                    "sense_definition": "Devenir le parrain d'une personne, lui apporter son soutien moral, ses conseils ou se porter garant pour elle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soutien_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un employé expérimenté va <w>parrainer</w> le nouveau stagiaire pendant ses premières semaines dans l'entreprise."
                        },
                        {
                            "text": "Plusieurs maires de petites communes ont accepté de <w>parrainer</w> ce jeune candidat à l'élection."
                        }
                    ],
                    "synonyms": [
                        "épauler",
                        "soutenir"
                    ],
                    "common_phrases": [
                        "parrainer un candidat",
                        "parrainer un nouvel arrivant"
                    ]
                },
                {
                    "sense_id": "18428625-7601-3e97-94e6-a59080b059a9",
                    "sense_definition": "Apporter un soutien financier ou matériel à un événement, un projet ou une organisation à des fins publicitaires.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soutien_commercial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande banque a décidé de <w>parrainer</w> un événement culturel majeur dans la région."
                        },
                        {
                            "text": "L'équipementier sportif <w>parraine</w> la compétition internationale de football depuis plus de dix ans."
                        }
                    ],
                    "synonyms": [
                        "financer",
                        "sponsoriser"
                    ],
                    "common_phrases": [
                        "parrainer un événement",
                        "parrainer une émission"
                    ]
                }
            ]
        }
    ]
