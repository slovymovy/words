                ],
                "senses": [
                    {
                        "sense_id": "61b56f09-5cae-3d05-a02a-635df654a6d5",
                        "entry_id": "b5747a8c-fa6f-3b49-ae3c-915af37e3e6e",
                        "glosses": [
                            "dyskusja, wymiana zdań"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d86099-9744-4b35-a5d0-d3621671bc75",
                                "sense_id": "61b56f09-5cae-3d05-a02a-635df654a6d5",
                                "text": "Tradycyjny empirystyczny dyskurs feministyczny koncentruje się na uciśnieniu kobiet."
                            },
                            {
                                "example_id": "8d5d0789-bb4d-4f84-a9bc-2aae8bc56771",
                                "sense_id": "61b56f09-5cae-3d05-a02a-635df654a6d5",
                                "text": "Z całkowitym, u źródła, odrzuceniem dogmatu o odseparowaniu wiąże się teza o „przesiąkliwości” (…) dyskursów."
                            },
                            {
                                "example_id": "f201b8e4-d2e3-4514-b41a-dff879f69ee6",
                                "sense_id": "61b56f09-5cae-3d05-a02a-635df654a6d5",
                                "text": "Dyskurs jest tu rozumiany jako wielozdaniowa wypowiedź, gdzie poszczególne jej wyrażenia składowe mogą być powiązane relacjami anaforycznymi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cbf4856-df6f-46b3-89cb-a87c37bbc438",
                        "source_entry_id": "b5747a8c-fa6f-3b49-ae3c-915af37e3e6e",
                        "source_sense_id": "61b56f09-5cae-3d05-a02a-635df654a6d5",
                        "target_lang_word": "discourse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discourse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "731d3a0d-8b52-30a4-91b5-af0117ba8e5b",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "Verbal exchange, conversation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c054ec08-5355-4996-bffd-7150930de6c9",
                                                "sense_id": "731d3a0d-8b52-30a4-91b5-af0117ba8e5b",
                                                "text": "UUho when he ſhal embrace you in his arms\nUUil tell how many thouſand men he ſlew.\nAnd when you looke for amorous diſcourſe,\nWill rattle foorth his facts of war and blood: […]"
                                            },
                                            {
                                                "example_id": "5b927a68-6ed6-4de9-b70c-82abd262e7ff",
                                                "sense_id": "731d3a0d-8b52-30a4-91b5-af0117ba8e5b",
                                                "text": "Two or three of the gentlemen sat near him, and I caught at times scraps of their conversation across the room. At first I could not make much sense of what I heard; for the discourse of Louisa Eshton and Mary Ingram, who sat nearer to me, confused the fragmentary sentences that reached me at intervals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4802b96c-5228-3c49-84a5-406b1fb9fd28",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "Expression in words, either speech or writing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3c334a-4830-465c-ab9b-c434e5e9b958",
                                                "sense_id": "4802b96c-5228-3c49-84a5-406b1fb9fd28",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b907b8f-5e30-3bfb-86ac-8e358a834c96",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "A conversation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f193befa-eb16-4360-a68d-f3bd2c90640a",
                                                "sense_id": "0b907b8f-5e30-3bfb-86ac-8e358a834c96",
                                                "text": "It ſeems, the Minds of theſe People are ſo taken up with intenſe Speculations, that they neither can ſpeak, nor attend to the Diſcourſes of others, without being rouzed by ſome external Taction upon the Organs of Speech and Hearing; for which reaſon, thoſe Perſons who are able to afford it always keep a Flapper (the Original is Climenole) in their Family, as one of their Domeſticks, nor ever walk abroad or make Viſits without him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06d30a14-fe4e-32a5-bae9-01d039e66722",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "A formal lengthy exposition of some subject, either spoken or written."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff42f14-836f-4a91-95f1-c3c7827fcfe8",
                                                "sense_id": "06d30a14-fe4e-32a5-bae9-01d039e66722",
                                                "text": "The preacher gave us a long discourse on duty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa9f1c4-fe06-3884-b1b8-37e148b245e9",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "Any rational expression, reason."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b2393a-723c-495a-8986-d4d842d72766",
                                                "sense_id": "baa9f1c4-fe06-3884-b1b8-37e148b245e9",
                                                "text": "Sure he that made us with such large discourse, / Looking before and after, gave us not / That capability and godlike reason / To rust in us unused."
                                            },
                                            {
                                                "example_id": "0d4c8f19-a1c2-4cab-8626-da89791f0cbd",
                                                "sense_id": "baa9f1c4-fe06-3884-b1b8-37e148b245e9",
                                                "text": "difficult, strange, and harsh to the discourses of natural reason"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4297b586-4d17-31e8-af2c-75bd2597933a",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "An institutionalized way of thinking, a social boundary defining what can be said about a specific topic (after Michel Foucault)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b13c4751-8145-4d68-aca3-1a3d85f5a4ec",
                                                "sense_id": "4297b586-4d17-31e8-af2c-75bd2597933a",
                                                "text": "Furthermore, it should be recalled from the previous chapter that criminological discourse of the 1930s deemed every woman a potential criminal, implicitly including the domestic woman."
                                            },
                                            {
                                                "example_id": "ce0a0d62-ed98-469b-8009-6ae0ed8ccca0",
                                                "sense_id": "4297b586-4d17-31e8-af2c-75bd2597933a",
                                                "text": "But equally important to the emergence of uniquely African-American queer discourses is the refusal of African-American movements for liberation to address adequately issues of sexual orientation and gender identity."
                                            },
                                            {
                                                "example_id": "909fd07f-c134-4107-8368-573d76ffe7eb",
                                                "sense_id": "4297b586-4d17-31e8-af2c-75bd2597933a",
                                                "text": "Brown University's Friday Night Jews (FNJ) [...] began as an informal Shabbat dinner gathering in 2016, as a space for Jewish students who were feeling fed up with Hillel’s limitations regarding Israel/Palestine discourse, after the Brown/RISD Hillel rescinded sponsorship of a film screening by the Israeli nonprofit Zochrot, an organization that educates Jewish Israelis about the Nakba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "263f321c-84d5-30ec-bcf3-b055b229bb00",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "Lengthy, often heated debate over controversial subject matter, particularly within fandom and activist spaces. Sometimes rendered as a proper noun with the definite article (i.e. \\\"the Discourse\\\")."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6b02006-8e06-447f-8b54-e3bf3a233924",
                                                "sense_id": "263f321c-84d5-30ec-bcf3-b055b229bb00",
                                                "text": "We all know — or know now — the Internet meme known as “The Discourse,” which became popular on the social media site Tumblr in April of last year."
                                            },
                                            {
                                                "example_id": "54388719-74ec-4fae-9482-f52dfed45be0",
                                                "sense_id": "263f321c-84d5-30ec-bcf3-b055b229bb00",
                                                "text": "Nobody will ever know if Gene Roddenberry would hate DS9 had he lived to see it, but the controversy was patient zero for the arguments that define modern Star Trek discourse."
                                            },
                                            {
                                                "example_id": "5be4ca1c-d982-42a8-9124-0824cda80db7",
                                                "sense_id": "263f321c-84d5-30ec-bcf3-b055b229bb00",
                                                "text": "...needless to say, the small-scale nature of these controversies provides a window into who the true 'snowflakes' are when it comes to Doctor Who discourse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430668ca-f87c-393b-9607-fdde80e206b4",
                                        "entry_id": "c49cb021-3a7e-3c66-8aa5-cfdf0dd1f1f8",
                                        "glosses": [
                                            "Dealing; transaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f6287b-87e8-4a8a-99e7-d2cdd8c1e187",
                                                "sense_id": "430668ca-f87c-393b-9607-fdde80e206b4",
                                                "text": "Good Captain Bessus, tell us the discourse / Betwixt Tigranes and our king, and how / We got the victory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "discourse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
