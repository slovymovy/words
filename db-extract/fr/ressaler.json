                    {
                        "sense_id": "c800b838-9b25-33bb-bb32-facecc8e6af6",
                        "entry_id": "88a4b4d2-a8bd-33a0-8af1-5322d885f9b9",
                        "glosses": [
                            "Remettre du sel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "685b211a-34dc-4f14-9be3-b35024d31f02",
                                "sense_id": "c800b838-9b25-33bb-bb32-facecc8e6af6",
                                "text": "N'abusez pas du sel, préférez le sel iodé et goûtez avant de vous ressaler."
                            },
                            {
                                "example_id": "6e3176d5-3683-4903-b1d4-3957d0de128c",
                                "sense_id": "c800b838-9b25-33bb-bb32-facecc8e6af6",
                                "text": "Il est conseillé de limiter la consommation de sel à 6grs/Jour : ne pas ressaler et éviter de consommer des plats cuisinés."
                            }
                        ]
                    },
                    {
                        "sense_id": "32b5e573-efe3-3ece-aeb2-43439427f523",
                        "entry_id": "88a4b4d2-a8bd-33a0-8af1-5322d885f9b9",
                        "glosses": [
                            "Redresser un bateau qui a chaviré."
                        ],
                        "tags": [],
                        "examples": [
                            {
