                                "sense_id": "8e07dbe2-9a4d-31af-95da-645c50012df5",
                                "text": "In het Nederlands kennen we veel diminutieven zelfs als het over zeer grote dingen gaat zoals de zon."
                            },
                            {
                                "example_id": "fb373c95-28f3-4331-9da6-8c44adc5002c",
                                "sense_id": "8e07dbe2-9a4d-31af-95da-645c50012df5",
                                "text": "In het Nederlands gebruiken we het diminutief ook om dingen minder gevaarlijk te laten schijnen zoals bijvoorbeeld het monstertje."
                            }
                        ]
                    }
