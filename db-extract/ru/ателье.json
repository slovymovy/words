                    },
                    {
                        "translation_id": "decf97ed-a508-4851-8c5e-c3b049cdfe7f",
                        "source_entry_id": "68213b0c-19c7-3048-b34d-11bf44cd6b4e",
                        "source_sense_description": "мастерская",
                        "target_lang_word": "studio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "studio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07e7afdc-49f9-3e56-8de9-9ae3ee988a5e",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "An artist’s or photographer’s workshop or the room in which an artist works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae716b34-e328-4b2e-8954-92a5d5f7bccd",
                                                "sense_id": "07e7afdc-49f9-3e56-8de9-9ae3ee988a5e",
                                                "text": "His studio was cramped when he began as an artist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cbb2e01-85c1-317c-9f52-09b116226f89",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "An establishment where an art is taught."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61d982f-0191-49a0-97f0-617506bdb573",
                                                "sense_id": "9cbb2e01-85c1-317c-9f52-09b116226f89",
                                                "text": "As he gained a reputation, he took larger space and took students into his studio,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A place where radio or television programs, records or films are made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bf6f4f-6370-421d-b18b-4596593ee1a4",
                                                "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                                "text": "The recording studio had some slight echo, but was good enough to make a demo."
                                            },
                                            {
                                                "example_id": "631d0afd-713c-4ff6-a1a7-dfbf20daea60",
                                                "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                                "text": "The studio was dark and cool, with thick cords running from one end to the other and huge cameras on either side, each primed to swivel and record what the lights from above illuminated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0577c3be-8d75-39d5-ae2c-c39c28fc1306",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A company or organization that makes films, records or other artistic works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4507543-b4af-4928-bb57-a20c876f2a56",
                                                "sense_id": "0577c3be-8d75-39d5-ae2c-c39c28fc1306",
                                                "text": "The studios still make films, but they rely on the strength of their distribution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6753a559-9530-3f83-a2cf-0cf47c3c60e9",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A studio apartment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee61de42-7a79-45d1-8bbd-09699b5af2e1",
                                                "sense_id": "6753a559-9530-3f83-a2cf-0cf47c3c60e9",
                                                "text": "It’s a lovely little studio with almost a river view."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a88b74d-958f-4fe1-b34d-82e578f51277",
                        "source_entry_id": "68213b0c-19c7-3048-b34d-11bf44cd6b4e",
                        "source_sense_description": "мастерская",
                        "target_lang_word": "Werkstatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werkstatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                        "entry_id": "014af371-b1d0-330e-8db7-fdd1146187a7",
                                        "glosses": [
                                            "Arbeitsraum eines Handwerkers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19d621b-590f-4178-8a85-9b3ea9f651eb",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "In unserer Werkstatt sind auch Schraubenzieher aller Größen."
                                            },
                                            {
                                                "example_id": "2e6d2113-13e8-48d8-9ec0-bca9c10201e6",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Für andere Geschäfte bediente er sich der Rotunde, die ihm auf dem Wege vom Mittagessen zur Werkstatt am nächsten lag.“"
                                            },
                                            {
                                                "example_id": "1e1e6477-0b63-497f-aa19-c3897e2becf0",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Kunst ist in Benin stets Teil des Ritus, die Bronzegießer vollziehen in ihren Werkstätten sakrale Handlungen.“"
                                            },
                                            {
                                                "example_id": "ba9e98c8-9257-43d9-b09e-dc75fc0bcb35",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Gestern hat er einen Anruf bekommen: Seiner Werkstatt fehle die Baugenehmigung.“"
                                            },
                                            {
                                                "example_id": "83d47b5a-a5e8-46b3-8668-193e029f618e",
                                                "sense_id": "0d0801de-bab2-3d71-9f48-cbfab5d8e99b",
                                                "text": "„Der Ingenieur führte mich in den vielen Höfen, Werkstätten und Geschäftszimmern des gewaltigen Betriebes umher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7711f5fb-58b0-4a67-a845-e74a70d1c404",
                        "source_entry_id": "68213b0c-19c7-3048-b34d-11bf44cd6b4e",
                        "source_sense_description": "мастерская",
                        "target_lang_word": "Studio",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Studio",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5339c7a9-a78e-31cc-b42a-8f6c2201993c",
                                        "entry_id": "1b492e4e-756a-3c98-8c62-5a71c2033479",
                                        "glosses": [
                                            "Atelier eines Künstlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcbb05d8-e00d-408c-82a3-f1be15ab989b",
                                                "sense_id": "5339c7a9-a78e-31cc-b42a-8f6c2201993c",
                                                "text": "„Wir gingen hinunter zu dem Studio, in dem Black seine Bilder zeigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b278dd3-ada4-391a-bbb1-c4594cb1162e",
                                        "entry_id": "1b492e4e-756a-3c98-8c62-5a71c2033479",
                                        "glosses": [
                                            "Raum zur Aufzeichnung von Musik, Filmen, Fotografien oder Rundfunksendungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd57dd98-4d4a-4285-b31b-1835f5782da9",
                                                "sense_id": "8b278dd3-ada4-391a-bbb1-c4594cb1162e",
                                                "text": "Das Studio darf nicht betreten werden, weil gerade eine Sendung aufgezeichnet wird."
                                            },
                                            {
                                                "example_id": "afa6fb5b-469a-4098-ba82-50f989c3aad4",
                                                "sense_id": "8b278dd3-ada4-391a-bbb1-c4594cb1162e",
                                                "text": "„Der Stiftungsrat genehmigte am Donnerstag ein Alternativkonzept, wonach alle notwendigen Büros und Studios samt dem geplanten Newsroom im vorhandenen Gebäudekomplex untergebracht werden sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3485c8d7-4d08-3018-94b2-0a2e0de3d118",
                                        "entry_id": "1b492e4e-756a-3c98-8c62-5a71c2033479",
                                        "glosses": [
                                            "Versuchsbühne beim Theater"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b3363aa6-75ee-31dd-ac4d-2ecbbd6ed2b7",
                                        "entry_id": "1b492e4e-756a-3c98-8c62-5a71c2033479",
                                        "glosses": [
                                            "abgeschlossene Einzimmerwohnung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b6381981-b522-32ac-a737-82b8518efcf2",
                                        "entry_id": "1b492e4e-756a-3c98-8c62-5a71c2033479",
                                        "glosses": [
                                            "Raum, in dem Sport oder Tanz trainiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f792feba-a280-423b-85e9-cbbd9a733613",
                                                "sense_id": "b6381981-b522-32ac-a737-82b8518efcf2",
                                                "text": "„Sabina und Djuna gingen in das Studio, wo sie noch immer Trommeln hörten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4960a79b-63d9-495e-85d7-5170fef6d52a",
                        "source_entry_id": "68213b0c-19c7-3048-b34d-11bf44cd6b4e",
                        "source_sense_description": "мастерская",
                        "target_lang_word": "Atelier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atelier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                        "entry_id": "9762b74d-86a1-35a3-8c83-31d72968270e",
                                        "glosses": [
                                            "die Werkstatt eines Künstlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f28a89be-b384-4ab7-ac5a-6b53777ccdb4",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "Er ist gerade in seinem Atelier und zeichnet."
                                            },
                                            {
                                                "example_id": "2f9e693a-5e1a-406a-b569-ed9d7c50fafb",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Das Halbrund der Morgensonne zeigte sich über den Dächern und füllte sein kleines Atelier mit diesem besonderen Licht, das nur in der ersten Stunde eines wolkenlosen Tages zu sehen war.“"
                                            },
                                            {
                                                "example_id": "7732106b-b282-4805-8b96-3bd7c50dca28",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Die weißen Vorhänge des Ateliers waren zugezogen, und man sah darauf Schatten, die sich bewegten.“"
                                            },
                                            {
                                                "example_id": "bf77ac73-074b-460d-8671-c8b2d56300b2",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Aus dem Stockwerk unter dem Atelier kamen plötzlich zwei Männer herauf, weitere zwei Männer kamen vom Dachboden herab.“"
                                            },
                                            {
                                                "example_id": "d78674cf-c1c2-43a8-a87e-e8a99d81d39e",
                                                "sense_id": "036e5733-0800-30eb-8170-d65dd3a2f8b3",
                                                "text": "„Später bekam ich die Einladung, im Winter jederzeit nach fünf ins Atelier zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b89485a2-7cfc-4da9-99f2-ccccb4ad2977",
