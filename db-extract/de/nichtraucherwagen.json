                    {
                        "sense_id": "883d6865-846d-3983-9dab-7e8315da0eb3",
                        "entry_id": "186d1864-917a-3e10-a974-075e799c110d",
                        "glosses": [
                            "Eisenbahn-/Straßenbahnwagen, in dem nicht geraucht werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9372907a-92e0-414f-8701-fb2b99e3dc62",
                                "sense_id": "883d6865-846d-3983-9dab-7e8315da0eb3",
                                "text": "„Nichtraucherwagen gibt es nicht, auch in den Damenabteilen befinden sich Aschenbecher.“"
                            },
                            {
                                "example_id": "2c2d23c9-3257-4058-ab58-0bf2e80ed4dc",
                                "sense_id": "883d6865-846d-3983-9dab-7e8315da0eb3",
                                "text": "„Er wirkte vielfältig für das öffentliche Gesundheitswesen, unter anderem gingen auf seine Initiative die Einführung von Nichtraucherwagen der Straßenbahn sowie die Maulkorbpflicht für Hunde zurück.“"
                            }
                        ],
