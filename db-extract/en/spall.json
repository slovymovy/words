                    }
                ],
                "senses": [
                    {
                        "sense_id": "33666bf7-771e-3cc5-9e7d-8571597e2834",
                        "entry_id": "302b7460-241b-3a65-b5ea-71d87ed1eb93",
                        "glosses": [
                            "A splinter, fragment or chip, especially of stone."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "e449d60a-2235-416e-81cd-c100dec3b9af",
                                "sense_id": "33666bf7-771e-3cc5-9e7d-8571597e2834",
                                "text": "My father knew Bert Le Feuvre, the foreman of Griffith's yard, and there was a little heap of spawls waiting ready every night in summer after school for me to crack."
                            }
                        ]
                    },
                    {
                        "sense_id": "367713ef-af9f-3d4f-b0b9-228c7d4df45b",
                        "entry_id": "302b7460-241b-3a65-b5ea-71d87ed1eb93",
                        "glosses": [
                            "A process of weathering, aging, or other wear that involves the crumbling of the substrate."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "48145c38-c189-4071-9ecb-66106952b53a",
                                "sense_id": "367713ef-af9f-3d4f-b0b9-228c7d4df45b",
                                "text": "The failure of this bearing involved spall under high load."
                            },
                            {
                                "example_id": "37e0e524-3d14-4b8a-a5c2-71333b2dcef5",
                                "sense_id": "367713ef-af9f-3d4f-b0b9-228c7d4df45b",
                                "text": "The inspection of this bridge abutment found extensive spall."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab9c1ba7-c24c-4ae0-9f40-2cd156629e6b",
                        "source_entry_id": "302b7460-241b-3a65-b5ea-71d87ed1eb93",
                        "source_sense_description": "splinter of stone",
                        "target_lang_word": "odłamek",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odłamek",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9438aa86-c932-3f11-9d46-cd6e696242b7",
                                        "entry_id": "d2b22bec-7701-3bc4-ae0d-4a29d9424bb9",
                                        "glosses": [
                                            "mała część odłamana od całości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94479e6f-f87a-44cc-a2aa-58e491b4ddfd",
                                                "sense_id": "9438aa86-c932-3f11-9d46-cd6e696242b7",
                                                "text": "Wpełzła pod konsolę od sterburty i zawołała: – No i te odłamki nieźle poturbowały antenę!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "559b0865-a9a1-33b5-8ed6-a46bcab361fc",
                                        "entry_id": "d2b22bec-7701-3bc4-ae0d-4a29d9424bb9",
                                        "glosses": [
                                            "część pocisku oderwana w czasie wybuchu"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e788d734-ad03-4da0-bc77-7ff97b5a1a1d",
                        "source_entry_id": "302b7460-241b-3a65-b5ea-71d87ed1eb93",
                        "source_sense_description": "splinter of stone",
                        "target_lang_word": "обло́мок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обло́мок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c94f7fdb-36bf-3b94-8f05-10532a2c5f20",
                                        "entry_id": "2e950545-83c9-3a12-8022-40972a9ab88c",
                                        "glosses": [
                                            "отбитый, отломившийся кусок чего-либо; остаток чего-либо сломанного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "870a2f38-a1df-4802-bd1e-f17c9c45ce6e",
                                                "sense_id": "c94f7fdb-36bf-3b94-8f05-10532a2c5f20",
                                                "text": "Ныряльщик захватил ногами большой обломок кораллового известняка, привязанный к концу веревки, и быстро опустился на дно."
                                            },
                                            {
                                                "example_id": "7fa03960-38c5-41ca-858e-a883634eac33",
                                                "sense_id": "c94f7fdb-36bf-3b94-8f05-10532a2c5f20",
                                                "text": "Места камнепадов определяются наличием на их склонах и под ними обломков камней и осыпей, каменной пыли и царапин на скалах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab28c99-c2da-3eab-a366-beb55db888f6",
                                        "entry_id": "2e950545-83c9-3a12-8022-40972a9ab88c",
                                        "glosses": [
                                            "перен. то, что сохранилось, уцелело от чего-либо исчезнувшего, ставшего старым, прошлым"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03a0a85-e011-4120-85a5-3cb8ae94da83",
                                                "sense_id": "6ab28c99-c2da-3eab-a366-beb55db888f6",
                                                "text": "Во многих домах в Москве были тогда французы-гувернеры, обломки наполеоновской великой армии."
                                            },
                                            {
                                                "example_id": "9b898c8e-812e-4e12-a0f4-79ae7f6a1fbe",
                                                "sense_id": "6ab28c99-c2da-3eab-a366-beb55db888f6",
                                                "text": "Баратынский превосходно назвал предрассудок обломком древней правды."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8fa9e4a-0c2d-496d-8a30-08c7149cedc8",
                        "source_entry_id": "302b7460-241b-3a65-b5ea-71d87ed1eb93",
                        "source_sense_description": "splinter of stone",
                        "target_lang_word": "оско́лок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оско́лок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "526ea06e-2c4c-34ba-aee0-31ff5f381c40",
                                        "entry_id": "7fa1c149-d0ea-30fe-8327-083452a1368c",
                                        "glosses": [
                                            "кусок, образовавшийся в результате дробления какого-либо твёрдого предмета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058c103e-6ce5-47fd-865d-292d287b4a13",
                                                "sense_id": "526ea06e-2c4c-34ba-aee0-31ff5f381c40",
                                                "text": "Затем заткнём горлышко пробкой и положим на клеёнку под донное отверстие мелкий осколок колотого сахара."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f761fb4a-d1fa-312f-833c-7c09dd3d9494",
                                        "entry_id": "7fa1c149-d0ea-30fe-8327-083452a1368c",
                                        "glosses": [
                                            "воен. кусок снаряда, мины, бомбы и т. п., отколовшийся при взрыве"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ed185b-c9f8-4d3f-b278-88c76e62a07e",
                                                "sense_id": "f761fb4a-d1fa-312f-833c-7c09dd3d9494",
                                                "text": "Однажды потянуло пропагандиста рассказать о боевом пути его героического «соединения», как бы между прочим сообщить о том, как на станции Попельня его однажды чуть не убило: осколком бомбы выбило стекло в здании сортировки и угодил тот осколок в стену, прямо над головой начальника."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b51d197e-f628-35fb-9c50-5bd635626e24",
                                        "entry_id": "7fa1c149-d0ea-30fe-8327-083452a1368c",
                                        "glosses": [
                                            "перен., книжн. оставшаяся часть, остаток чего-либо более не существующего"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9061c6da-f4a4-47d1-b5eb-2e63827b3be2",
                                                "sense_id": "b51d197e-f628-35fb-9c50-5bd635626e24",
                                                "text": "Зато бабушка, этот осколок дореволюционного строя, в тяжелые и опасные моменты во время эвакуации впадала в состояние какой-то прострации, становясь как бы равнодушной ко всему происходящему."
                                            },
                                            {
                                                "example_id": "9f5842a6-239f-4370-a59e-7badc6f24a24",
                                                "sense_id": "b51d197e-f628-35fb-9c50-5bd635626e24",
                                                "text": "В глубине двора стоял четвёртый, замыкающий дом: осколок старого мира."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4852beb5-e30b-36af-8648-2fc6761f7227",
                                        "entry_id": "7fa1c149-d0ea-30fe-8327-083452a1368c",
                                        "glosses": [
                                            "физ. то же, что осколок деления, один из фрагментов атомного ядра, претерпевшего реакцию деления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5ddbac-886d-48f5-b6f8-4b04348039ac",
                                                "sense_id": "4852beb5-e30b-36af-8648-2fc6761f7227",
                                                "text": "При делении ядра урана-235 спектр масс осколков имеет два максимума."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
