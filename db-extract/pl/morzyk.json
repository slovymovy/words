                        ]
                    },
                    {
                        "translation_id": "4b4c508f-47a2-4fc3-beab-d2275066f7d8",
                        "source_entry_id": "0e054dcf-8670-3010-aaac-848851b0a4c5",
                        "source_sense_id": "5d5e1257-88d2-3faa-9ecb-77dc972ecf96",
                        "target_lang_word": "старик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "старик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мужчина, достигший старости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "438affe1-0653-41d1-b6bf-5b47297a0209",
                                                "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                                "text": "Мудрый старик и глупый царь ¶ Во времена давно прошедшие был в одном городе молодой царь. Невзлюбил он стариков и повелел всех их убить. ❬…❭"
                                            },
                                            {
                                                "example_id": "c880514c-1c44-4dc8-bc76-80e6b2c80eb6",
                                                "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                                "text": "❬…❭ Он как-то сразу сдал, посерел. Ещё не старик, но уже пожилой, с обмякшими щёчками дяденька. ❬…❭"
                                            },
                                            {
                                                "example_id": "d2ba33d1-c28f-4117-b520-5cce2271da7d",
                                                "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                                "text": "❬…❭ Выглядит [Фукс] стариком, хотя не стар, лет сорока пяти: лысина, пенсне, сивая борода. ❬…❭"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e046a3cb-da93-366a-a51c-4a7bbea74cff",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мн. ч. старые люди (мужчины и женщины)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ada96d5-c027-4289-ad4b-f89a916805ce",
                                                "sense_id": "e046a3cb-da93-366a-a51c-4a7bbea74cff",
                                                "text": "❬…❭ Мне рассказали такой случай. Ярмарка взялась обеспечить прибавку к пенсии старикам и инвалидам микрорайона. Через несколько месяцев учредителей вызывают в префектуру и показывают им письмо — жалобу, что ярмарка мешает спокойно жить, развели шум и грязь, антисанитарию и махинации, надо её закрыть, зарыть, уничтожить. Подписи под жалобой вполне соответствовали списку лиц, получающих вспоможение от дирекции. ❬…❭"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мн. ч., разг. родители и/или другие родственники старшего возраста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b04e5e-d9d9-472b-ba71-acff4531e0a4",
                                                "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                                "text": "Он сидит на шее у своих стариков."
                                            },
                                            {
                                                "example_id": "45011b42-b42f-4099-ac86-77d80ab6b599",
                                                "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                                "text": "Надо навестить своих стариков."
                                            },
                                            {
                                                "example_id": "6a461e0e-474b-4357-81c3-ad14b9c52db1",
                                                "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                                "text": "Постарели мои старики."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3543fc39-49bb-3253-9c48-cb9c6a2d7fdc",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мн. ч., фам. обращение к своим родителям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ca8081-dbe1-472e-919f-1cbca3c623aa",
                                                "sense_id": "3543fc39-49bb-3253-9c48-cb9c6a2d7fdc",
                                                "text": "— Эй, старики, гоните монету!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "разг. опытный, бывалый человек, уже знающий какое-либо дело, работу (в противоположность новичку)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d33aec0-6c2f-4c37-9883-cccc3754298c",
                                                "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                                "text": "— Этот студент не впервые в стройотряде, уже старик."
                                            },
                                            {
                                                "example_id": "c84e67db-4306-4047-8485-57c1ac073d4a",
                                                "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                                "text": "В археологическую экспедицию поехали новенькие и старики."
                                            },
                                            {
                                                "example_id": "5221cb70-6eef-4109-874d-e37e45fd5cc2",
                                                "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                                "text": "Эти парни уже старики на стройке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "фам. или шутл. обращение к давнему другу, приятелю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99e76ff0-fdda-47ff-9a1b-cf92979c5f74",
                                                "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                                "text": "— Привет, старик!"
                                            },
                                            {
                                                "example_id": "be85bfd9-d3ad-4028-b6af-6d5b3b182b48",
                                                "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                                "text": "— Эй, старик, дай прикурить!"
                                            },
                                            {
                                                "example_id": "8a6f9e75-0c38-4c95-a68b-5b19bb2bd889",
                                                "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                                "text": "— Ну ты, старик, даёшь!"
                                            }
                                        ]
                                    }
                                ]
                            },
