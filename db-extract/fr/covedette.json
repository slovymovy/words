            {
                "entry_id": "cb1ee6fb-5c20-3d6c-be47-24c61d8c16dd",
                "word": "covedette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7a3153d-45ca-443f-930d-2c59fa6baf0f",
                        "entry_id": "cb1ee6fb-5c20-3d6c-be47-24c61d8c16dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "covedettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3f70c11-e6f5-3b5c-a5a0-1cde05fecb67",
                        "entry_id": "cb1ee6fb-5c20-3d6c-be47-24c61d8c16dd",
                        "glosses": [
                            "Personne qui partage la vedette d’un film ou d'une pièce de théâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b049cd5-53d5-4079-b271-837000bfc772",
                                "sense_id": "a3f70c11-e6f5-3b5c-a5a0-1cde05fecb67",
                                "text": "À cette époque-là, Arlan venait d'avoir 58 ans, ses films se viandaient les uns après les autres et il venait d'interrompre une tournée théâtrale pourtant médiatiquement très en faveur, sous le seul prétexte que sa covedette avait refusé de l'épouser."
                            },
                            {
                                "example_id": "51dcb693-2efc-439f-9750-8a483a5c59a4",
                                "sense_id": "a3f70c11-e6f5-3b5c-a5a0-1cde05fecb67",
                                "text": "Un cinéaste comme Denis Côté, abonné des festivals internationaux, aimé des cinéphiles mais trop confidentiel, aura en 2013, avec son noir et angoissant Vic + Flo, donnant il est vrai la covedette à la populaire Pierrette Robitaille, formidable dans ce rôle dramatique, élargi son public."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7460a5ac-652c-4cf3-b7c1-394cfcbe1369",
                        "source_entry_id": "cb1ee6fb-5c20-3d6c-be47-24c61d8c16dd",
                        "source_sense_id": "a3f70c11-e6f5-3b5c-a5a0-1cde05fecb67",
                        "target_lang_word": "costar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "costar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9118a6fa-616f-38b0-b199-f27a80402120",
                                        "entry_id": "21ee4f70-521b-36ec-8fee-1c28504c51b1",
                                        "glosses": [
                                            "A person who shares star billing with another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e9747dd-c58b-450b-97a3-89ab62990362",
                                                "sense_id": "9118a6fa-616f-38b0-b199-f27a80402120",
                                                "text": "The once famous actor objected to his costar having a bigger dressing room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01902f6d-4c7d-3999-bc52-0b7773898b1a",
                                        "entry_id": "21ee4f70-521b-36ec-8fee-1c28504c51b1",
                                        "glosses": [
                                            "A person who slightly lacks the status to be considered a star."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341c5660-2267-4312-8a4f-d3b6ef2be576",
                                                "sense_id": "01902f6d-4c7d-3999-bc52-0b7773898b1a",
                                                "text": "Alas, always a costar but never a star."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "costar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "038f4f3d-8fc4-3024-abb6-6bf41fc6265e",
                                        "entry_id": "e3b1c143-50d2-366d-908e-51b7b7c2d32c",
                                        "glosses": [
                                            "To perform with the billing of a costar."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa4d36c-ff68-4ad7-b538-129317a69a44",
                                                "sense_id": "038f4f3d-8fc4-3024-abb6-6bf41fc6265e",
                                                "text": "People thought his career was over but now he will get to costar on Broadway next month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1479e1c-8179-317d-9e0a-591a848f32ed",
                                        "entry_id": "e3b1c143-50d2-366d-908e-51b7b7c2d32c",
                                        "glosses": [
                                            "To feature (a number of star performers) jointly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b3a29db-e3eb-4155-b56c-565a61c4cd72",
                                                "sense_id": "d1479e1c-8179-317d-9e0a-591a848f32ed",
                                                "text": "Purchasing a snowplow transforms Homer into a new man. Mr. Burns' laziest employee suddenly becomes an ambitious self-starter who buys ad time on local television at 3:17 A.M^([sic]) (prime viewing hours, Homer gingerly volunteers, for everyone from alcoholics to the unemployable to garden-variety angry loners) and makes a homemade commercial costarring his family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
