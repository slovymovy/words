                        "sense_id": "29eb56eb-92e0-37e9-9782-52916473fb69",
                        "entry_id": "42c0df23-d581-37d7-aaa6-c3a59ded2220",
                        "glosses": [
                            "A kitchenware utensil for cutting ball-shaped pieces of foods."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0a14d6-7534-4930-9374-5ecb3d9ec52c",
                                "sense_id": "29eb56eb-92e0-37e9-9782-52916473fb69",
