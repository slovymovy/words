                                "sense_id": "4684ab5e-9239-3058-b398-096e7e01272b",
                                "text": "La Pulsatilla vulgaris est la coquelourde, la coquerelle, le coqueret, la coquerette, la clochette."
                            },
                            {
                                "example_id": "30a52608-4e7d-4898-b5ca-3bcadf946ef1",
                                "sense_id": "4684ab5e-9239-3058-b398-096e7e01272b",
                                "text": "Cette ganivelle formée de piquets en châtaignier reliés par du fil de fer apporte une touche naturelle tout en soutenant les fleurs de coquelourde."
                            }
                        ]
                    }
