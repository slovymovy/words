                                "target_senses": [
                                    {
                                        "sense_id": "be8f2ebf-013e-3a08-9c9a-75c6183cbe24",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "Weg, der nach unten führt; eine Treppe, eine Rampe, die abwärts führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec420a69-2703-40af-b968-f5adb80416c2",
                                                "sense_id": "be8f2ebf-013e-3a08-9c9a-75c6183cbe24",
                                                "text": "Der Abgang führte nach einigen Stufen zu einer eisernen Tür."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "342e290c-17e0-3ee8-bf6b-24f882727873",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "Verlassen einer Organisationseinheit; Rückzug eines Politikers, Mandatsträger, Würdenträgers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696d84f6-f9f9-4450-9572-90d3d2ca98d8",
                                                "sense_id": "342e290c-17e0-3ee8-bf6b-24f882727873",
                                                "text": "Trotz katastrophaler Umfragewerte wurde sein Abgang pompös inszeniert."
                                            },
                                            {
                                                "example_id": "8803a074-f227-431a-acc4-ac010a1d1d1e",
                                                "sense_id": "342e290c-17e0-3ee8-bf6b-24f882727873",
                                                "text": "Unser Verein schrumpft, denn die Mitgliederstatistik zeigt, dass wir sechs Abgänge aber nur drei Zugänge hatten."
                                            },
                                            {
                                                "example_id": "0c2f4da6-9988-4d8e-9a24-6a8c3641c5a0",
                                                "sense_id": "342e290c-17e0-3ee8-bf6b-24f882727873",
                                                "text": "Nach meinem Abgang von der Schule begann ich eine Tischlerlehre."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f20f47f4-e603-3436-a4f5-46ae9e23b602",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "Herabstürzen von Schnee- Eis- oder Geröllmassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab2978d-ef0c-4841-a310-b3a9d1d142ad",
                                                "sense_id": "f20f47f4-e603-3436-a4f5-46ae9e23b602",
                                                "text": "Bei dem Abgang einer Lawine letzten Donnerstag wurde ein Bergsteiger verschüttet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "93fdb25b-4bc4-3c0c-90f1-d7b041339091",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "Fehlgeburt, Verlust der Leibesfrucht; Ausscheiden eines versteinerten Fremdkörpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443052e1-c84a-4875-bad1-b8b35cbf5fb9",
                                                "sense_id": "93fdb25b-4bc4-3c0c-90f1-d7b041339091",
                                                "text": "Drogenkonsum in der Schwangerschaft kann den vorzeitigen Abgang des Fetus zur Folge haben."
                                            },
                                            {
                                                "example_id": "92b1f8a6-517e-41e6-9ce6-188cb6cf91cf",
                                                "sense_id": "93fdb25b-4bc4-3c0c-90f1-d7b041339091",
                                                "text": "Der Abgang eines Blasensteins kann eine schmerzhafte Angelegenheit sein."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c4923c7f-6b39-3607-98b2-e30d045a02f3",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "Verlassen der Bühne in einem Theaterstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a8746cb-ae2b-4b18-8879-ddb83dcd096d",
                                                "sense_id": "c4923c7f-6b39-3607-98b2-e30d045a02f3",
                                                "text": "Ein Abgang ist der Schluss einer Szene beziehungsweise eines Auftritts in einem Drama."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2111199f-229a-3018-9651-b5452aab2f9c",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "Geschmackserlebnis beim Verköstigen von Wein, Nachgeschmack eines Schlucks Wein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d956af0d-8246-4f86-9206-60fb4cdb795c",
                                                "sense_id": "2111199f-229a-3018-9651-b5452aab2f9c",
                                                "text": "Tafelweine und nicht sehr bedeutende Qualitätsweine haben in der Regel keinen Abgang, d. h. sie hinterlassen keinen Nachgeschmack und die Geschmacksempfindung am Gaumen setzt aus; […]"
                                            },
                                            {
                                                "example_id": "d0002371-e516-4e08-9634-7d7b68cec906",
                                                "sense_id": "2111199f-229a-3018-9651-b5452aab2f9c",
                                                "text": "Der Wein war im Abgang zu kurz."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "23a46304-7fee-3de6-8ff1-ee2713c0d33b",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "das Fehlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a36037-f665-41c1-96b3-cd306176b29f",
                                                "sense_id": "23a46304-7fee-3de6-8ff1-ee2713c0d33b",
                                                "text": "„Für den Abgang von eigentlichen ‚Zugbildern‘ wird man indeß durch die reiche Zahl von ganz tüchtigen Kunstwerken nicht ersten Ranges – der Katalog enthält hundert und achtzig Nummern – theilweise enschädigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "a3fb23e8-1bdd-3dca-940c-3e02fbb0eb48",
                                        "entry_id": "d6bc1220-6782-3dfa-a8b5-da02b42cf8b9",
                                        "glosses": [
                                            "Abschluss / letzter Teil einer Übung an einem Turngerät (beispielsweise einem Barren, dem Reck, den Ringen, dem Schwebebalken), die im Stand enden sollte"
                                        ],
                                        "tags": [
                                            "Turnen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78373d5d-4c26-42b6-b3e8-88e7548b10e8",
                                                "sense_id": "a3fb23e8-1bdd-3dca-940c-3e02fbb0eb48",
                                                "text": "„[Andreas Toba] hält durch, turnt seine Elemente bis zum Ende, steht sogar den Abgang - und hat schließlich die beste Wertung seines gesamten Teams am Pferd.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
