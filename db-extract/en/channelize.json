                    {
                        "sense_id": "201d1120-d5cd-34dd-af84-c7da81ac289f",
                        "entry_id": "5e37ea05-43a3-3a0d-b926-6794d1d98ee7",
                        "glosses": [
                            "To direct into a specific course or pathway; to channel."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6a5f2d37-0280-43d0-bb98-c8c6f32cca5a",
                                "sense_id": "201d1120-d5cd-34dd-af84-c7da81ac289f",
                                "text": "It is particularly confusing when the motorist is channelized across the highway centerline. For long-term closures conflicting pavement markings must be removed or obliterated before relaning the roadway."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "906342a6-f82a-4ef4-a302-61b3b22f7832",
                        "source_entry_id": "5e37ea05-43a3-3a0d-b926-6794d1d98ee7",
                        "source_sense_description": "To form a channel",
                        "target_lang_word": "kanalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kanalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c33f2b-be81-38db-9f94-f509a511b9db",
                                        "entry_id": "8fbe46d6-beae-3ff9-8093-94e14a096218",
                                        "glosses": [
                                            "eine Anlage zur Wasserabfuhr (Kanalisation) verlegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed21080a-781b-47a8-a3b8-09607c23775f",
                                                "sense_id": "d8c33f2b-be81-38db-9f94-f509a511b9db",
                                                "text": "Das Neubaugebiet an der Weider-Straße wurde kanalisiert und zunächst mit einer Baustraße erschlossen."
                                            },
                                            {
                                                "example_id": "05b1222f-3ad3-4313-9c39-1fe4800ac8af",
                                                "sense_id": "d8c33f2b-be81-38db-9f94-f509a511b9db",
                                                "text": "„Mannheim soll langfristig zu einer Schwammstadt werden. Deren Flächen nehmen, wenn es regnet, das Wasser auf und speichern es möglichst lange, anstatt es zu kanalisieren und abzuleiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c365102-abbe-3df8-9643-27785c4fb8d7",
                                        "entry_id": "8fbe46d6-beae-3ff9-8093-94e14a096218",
                                        "glosses": [
                                            "ein Thema in bestimmte Bahnen (Kanäle) lenken, damit es auf die so bestimmte Art behandelt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61720f00-0334-453c-9baf-cf4c6dd4a4e1",
                                                "sense_id": "3c365102-abbe-3df8-9643-27785c4fb8d7",
                                                "text": "Es galt, möglichst schnell den zu erwartenden Widerstand der Anwohner und Umweltschützer zu kanalisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                        "entry_id": "8fbe46d6-beae-3ff9-8093-94e14a096218",
                                        "glosses": [
                                            "einen Fluss/Bach naturfern umbauen/in ein Steinbett zwängen; Schleusen/Stauwehre bauen, begradigen, vertiefen, schiffbar machen, unterirdisch in Röhren fließen lassen"
                                        ],
                                        "tags": [
                                            "Wasserbau",
                                            "oft verbunden mit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7dba82-aa81-4a11-ae2d-4d083b132c91",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„Die Burgerau wurde kanalisiert und durch den Kudensee in den erweiterten Bütteler Kanal geführt.“"
                                            },
                                            {
                                                "example_id": "3c4ebe54-5884-41c4-bd22-7e5b21127634",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„In den 1960er Jahren wurde der Bellingerbach auf seinem Weg durch den Ort Opperzau durchgängig kanalisiert.“"
                                            },
                                            {
                                                "example_id": "28eaffd8-fcc5-4aff-98d5-d5e4bae54f99",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„Zum Hochwasserschutz wurde sie [Anm.: der Fluss Weiße Elster] stark begradigt, eingetieft, kanalisiert und eingedeicht.“"
                                            },
                                            {
                                                "example_id": "6744231d-5d7f-4e6b-8f17-362435ff0611",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„Früher überschwemmte der Henningbach bei starken Regenfällen nur Wiesen und Felder, doch 1930 wurde er mit Beton kanalisiert.“"
                                            },
                                            {
                                                "example_id": "309a0aec-6367-4a7a-9879-0e818f8ec818",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„Bereits beim Bau der Eintrachtstraße in den 1930er-Jahren wurde der Bach weitgehend kanalisiert. Mit der Erweiterung des Gewerbegebiets Röbbeck wurde in den 1980er-Jahren auch der Oberlauf neben die Zeiss-Straße in ein unzulängliches Bett gezwängt, welches eher an einen Straßengraben erinnert.“"
                                            },
                                            {
                                                "example_id": "ee58d094-93f1-4ab6-b9d7-f76b1d7dbbaf",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„Er beteiligt sich am Kampf gegen ein Mini-Wasserkraftwerk in einer kleinen Gemeinde unweit des Flusses Bukovica. Dieser war über acht Kilometer kanalisiert worden und hat ein steiniges Flussbett hinterlassen - wo einst kristallklares Wasser floss.“"
                                            },
                                            {
                                                "example_id": "2e428274-042d-48f3-8ff4-6eeb6fc6431d",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„[…] unberührte Fließgewässer gibt es in Deutschland so gut wie nicht mehr. Der Mensch gestaltet Bäche und Flüsse seit Jahrhunderten um. Er verlegt und verkürzt, begradigt und kanalisiert. Menschliche Eingriffe haben zu einer weitreichenden Entwässerung vieler Auen geführt.“"
                                            },
                                            {
                                                "example_id": "e8e00d62-ef36-4421-899a-b2a7e27383ae",
                                                "sense_id": "e58685cd-ed16-39c3-bea7-528e17929042",
                                                "text": "„Die 170 km lange Hase ist das bedeutendste Nebengewässer der Ems. Über Jahrhunderte wurden der Fluss und viele seiner Zuläufe kanalisiert und eingedeicht: Beispielsweise der Schierenbach, der im Rahmen des Baus der Autobahn A1 begradigt und eingetieft wurde, um als Entwässerungsgraben für die Autobahn zu dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
