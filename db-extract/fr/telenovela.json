                    {
                        "sense_id": "3bd4334d-15fd-385f-912d-5a184b3d4b7b",
                        "entry_id": "78e68930-9ea2-3b14-92e0-243baf918172",
                        "glosses": [
                            "Série ou feuilleton télévisé dans le monde hispanophone et lusophone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f758ee-9c73-43fd-a952-ceda3facce62",
                                "sense_id": "3bd4334d-15fd-385f-912d-5a184b3d4b7b",
                                "text": "Avec son esthétique très colorée, mêlant des influences qui font penser à un cocktail de telenovela et de propagande communiste, cette coproduction hispano-argentine parrainée par Alex de la Iglesia a séduit les jurés par son originalité."
                            },
                            {
                                "example_id": "0de7449e-007d-424b-a350-6c37a3ccdb30",
                                "sense_id": "3bd4334d-15fd-385f-912d-5a184b3d4b7b",
                                "text": "Toutes les étapes de la production d'une telenovela se trouvent ainsi concentrées en un seul endroit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
