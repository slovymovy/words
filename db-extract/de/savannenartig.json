                        ],
                        "form": "sie sind savannenartig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c22bd70-1b68-37eb-ad54-8d760aba72fb",
                        "entry_id": "c166c267-8e64-3f6a-817c-e2a5a7dc7982",
                        "glosses": [
                            "einer Savanne ähnelnd, an eine Savanne erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "473e6f91-d906-4c5e-809e-ae160e9facca",
                                "sense_id": "8c22bd70-1b68-37eb-ad54-8d760aba72fb",
                                "text": "„Was einige der importierten Arten, zumal die Kängurus und Giraffen, allem Anschein nach als Einladung aufgefasst hatten, diese ausgedehnte, inzwischen savannenartig bewachsene Region in Besitz zu nehmen.“"
                            },
                            {
                                "example_id": "d2c2fa09-cb25-4970-a33e-c464883ee15d",
                                "sense_id": "8c22bd70-1b68-37eb-ad54-8d760aba72fb",
                                "text": "„Clayton setzte sich an den Rand des Felsvorsprungs und blickte auf eine weite, savannenartige Ebene.“"
                            },
                            {
                                "example_id": "4cda5725-ea66-4060-872e-3805b65070c3",
                                "sense_id": "8c22bd70-1b68-37eb-ad54-8d760aba72fb",
                                "text": "„Manche, insbesondere in den Randgebieten, wo der geschlossene Regenwald in savannenartige Landschaften übergeht, repräsentieren das seit Langem bekannte Muster des Wanderfeldbaus.“"
                            },
                            {
                                "example_id": "96d5932e-a9f0-4ce1-924d-1c9d0ee488db",
