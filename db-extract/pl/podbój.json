                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "завоевание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3bab7fa7-422c-3514-8458-dc99cbc620ed",
                                        "entry_id": "6a288ddb-952c-31a3-8351-4934fe0a0b36",
                                        "glosses": [
                                            "действие по значению гл. завоёвывать; подчинение, часто с помощью агрессивных, насильственных мер, захват, обретение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bccef72a-e9f7-440c-9b92-bc09e11e6843",
                                                "sense_id": "3bab7fa7-422c-3514-8458-dc99cbc620ed",
                                                "text": "По условиям заключенного мира орден отказался от дальнейших завоеваний на Востоке."
                                            },
                                            {
                                                "example_id": "ed9b489b-2ac3-4fb7-91e4-a7649ac41f19",
                                                "sense_id": "3bab7fa7-422c-3514-8458-dc99cbc620ed",
                                                "text": "Участники рынка предполагают, что завоевание крупной доли рынка возможно сегодня лишь путём резкого демпинга."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ed5eef-e99b-37b5-b077-037bd7c34276",
                                        "entry_id": "6a288ddb-952c-31a3-8351-4934fe0a0b36",
                                        "glosses": [
                                            "то, что было завоёвано, достижение"
                                        ],
                                        "tags": [
                                            "often",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607b0319-0027-4882-861e-5ca6cb097b23",
                                                "sense_id": "f7ed5eef-e99b-37b5-b077-037bd7c34276",
                                                "text": "Сегодня все завоевания августа 1991 года отступили на второй план."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
