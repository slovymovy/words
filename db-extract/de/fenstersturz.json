                    },
                    {
                        "translation_id": "c3ee2dff-595e-41ee-97be-a9bde60fb6aa",
                        "source_entry_id": "45af5143-cb17-3f04-a298-a0b611ca0e1b",
                        "source_sense_id": "e3fd4f68-e588-3c17-b7ca-9859db91116e",
                        "source_sense_description": "Architektur: waagerechtes, balkenförmiges, tragendes Konstruktionselement über einer Fensteröffnung",
                        "target_lang_word": "nadokenní překlad",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
