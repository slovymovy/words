                ],
                "translations": [
                    {
                        "translation_id": "be3bbc86-8088-4f5c-a459-8a36097bb853",
                        "source_entry_id": "7ee41f07-3ebb-3e22-b81a-eca62913848a",
                        "target_lang_word": "Schirmherr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schirmherr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae53a64-758b-345b-b5a6-3f555577e8a8",
                                        "entry_id": "3af5ffe0-413d-3efd-89a4-6ed8100695ae",
                                        "glosses": [
                                            "jemand, der mit seinem (bekannten) Namen als offizieller Unterstützer für eine Veranstaltung, eine Organisation, ein Projekt oder Ähnliches in Erscheinung tritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08186160-36bf-42d0-a12a-2259b2e8d969",
                                                "sense_id": "4ae53a64-758b-345b-b5a6-3f555577e8a8",
                                                "text": "„Ex-Nationalmannschaftskapitän Michael Ballack vom Fußball-Bundesligisten Bayer Leverkusen ist Schirmherr der Aufklärungskampagne ‚Rote Karte dem Schlaganfall‘.“"
                                            },
                                            {
                                                "example_id": "fd6361cd-590b-4449-ad77-0c33b5e83a0c",
                                                "sense_id": "4ae53a64-758b-345b-b5a6-3f555577e8a8",
                                                "text": "„Die Organisatoren des Christopher Street Days (CSD) in Stuttgart suchen erstmals mit einer öffentlichen Stellenausschreibung nach einem Schirmherrn oder einer ‚Schirmfrau‘ aus der Wirtschaft für ihre Veranstaltungswoche im Juli. Bislang ohne Ergebnis.“"
                                            },
                                            {
                                                "example_id": "9f829980-616a-4961-9a85-eb01595c4b92",
                                                "sense_id": "4ae53a64-758b-345b-b5a6-3f555577e8a8",
                                                "text": "„Bei dieser Gelegenheit stellte ich mich dem Kardinal Orsini vor, dem Schirmherrn der ›Academia degli Infecondi‹, der mir die Ehre verschaffte, dort Mitglied zu werden.“"
                                            },
                                            {
                                                "example_id": "74087bf2-8f1d-4902-b5d9-b5223c2fc8a6",
                                                "sense_id": "4ae53a64-758b-345b-b5a6-3f555577e8a8",
                                                "text": "„So wenig anzuzweifeln wie die persönliche Reliquiengläubigkeit Albrechts ist die von Luthers Schirmherrn Friedrich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4fe37f9-cdd7-4fe3-8d23-c6e71304bc7e",
                        "source_entry_id": "7ee41f07-3ebb-3e22-b81a-eca62913848a",
                        "target_lang_word": "Gönner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gönner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd96f5b1-23dc-3414-a47b-efe6d3e94c78",
                                        "entry_id": "0cfc6f1b-a557-32ae-93c4-ac2e528783d6",
                                        "glosses": [
                                            "wohlhabende, einflussreiche Person, die jemand anderen (Künstler oder Einrichtung) in seinen Bestrebungen mit Geld unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1697c2-915d-436d-b11a-d2995965e7a1",
                                                "sense_id": "dd96f5b1-23dc-3414-a47b-efe6d3e94c78",
                                                "text": "Der junge Künstler hat im Fürsten einen Gönner gefunden, der ihm ein gutes Auskommen ermöglicht."
                                            },
                                            {
                                                "example_id": "33a9dc84-b7c2-4e3c-89f8-7675e2053bec",
                                                "sense_id": "dd96f5b1-23dc-3414-a47b-efe6d3e94c78",
                                                "text": "Jeden Monat steckt der Gönner ihr 40 000 Baht (rund 2150 Mark) zu - mehr, als ein thailändischer Professor verdient."
                                            },
                                            {
                                                "example_id": "5872aec0-3d1b-4ea8-86f8-f164cb3fa68f",
                                                "sense_id": "dd96f5b1-23dc-3414-a47b-efe6d3e94c78",
                                                "text": "„Die Schnorrer, das heißt die Bettler, die auf Kosten reicher Gönner lebten, waren fester Bestandteil des durch die jüdische Religion geprägten Selbstverständnisses.“"
                                            },
                                            {
                                                "example_id": "9920877d-e26f-4492-8612-a073df5d8f70",
                                                "sense_id": "dd96f5b1-23dc-3414-a47b-efe6d3e94c78",
                                                "text": "„Wir saßen nebeneinander vor einem Tischchen, mit dem Rücken zur Tür, hinter der wir unsern Gönner schlafend wähnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb8c928b-b617-4ca1-b52d-b3e064249a34",
