                ],
                "senses": [
                    {
                        "sense_id": "f25fea9b-c338-3e3e-9b17-20d3d1a1fe0f",
                        "entry_id": "e3542027-1043-3b35-8d7c-15f355f109ba",
                        "glosses": [
                            "мысленно представить, воспроизвести в зримых образах"
                        ],
                        "tags": [],
