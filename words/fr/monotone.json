{
    "word_family": [
        "monotonie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "66529ff2-dec3-3b83-b890-0c4a8ce93421",
                    "sense_definition": "Qui manque de diversité ou de changement, uniforme et fastidieux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uniformite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois dans ce bureau, il trouvait sa vie quotidienne particulièrement <w>monotone</w>."
                        },
                        {
                            "text": "Le train traversait un paysage <w>monotone</w> composé de champs plats à perte de vue."
                        }
                    ],
                    "synonyms": [
                        "uniforme",
                        "ennuyeux",
                        "fastidieux",
                        "répétitif"
                    ],
                    "antonyms": [
                        "varié",
                        "diversifié",
                        "stimulant"
                    ],
                    "common_phrases": [
                        "vie monotone",
                        "quotidien monotone",
                        "paysage monotone"
                    ]
                },
                {
                    "sense_id": "e4b473e2-bf24-3b7e-bad6-99b1b53257b5",
                    "sense_definition": "Qui est émis sur un ton invariable, sans modulation ni inflexion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur lisait ses notes d'une voix <w>monotone</w> qui endormait la moitié des élèves."
                        },
                        {
                            "text": "Le bruit <w>monotone</w> des gouttes de pluie contre la fenêtre l'aida à trouver le sommeil."
                        }
                    ],
                    "synonyms": [
                        "invariable",
                        "égal"
                    ],
                    "antonyms": [
                        "modulé",
                        "expressif"
                    ],
                    "common_phrases": [
                        "voix monotone",
                        "bruit monotone",
                        "ronronnement monotone"
                    ]
                },
                {
                    "sense_id": "312e1a71-ba45-3e41-adfa-475f503f44eb",
                    "sense_definition": "Qui s'exprime sur un ton uniforme et sans relief, provoquant l'ennui de l'auditoire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce conférencier <w>monotone</w> n'a pas réussi à capter l'attention du public pendant son intervention."
                        },
                        {
                            "text": "Bien qu'il maîtrise son sujet, le jeune orateur reste trop <w>monotone</w> pour susciter l'enthousiasme."
                        }
                    ],
                    "synonyms": [
                        "terne",
                        "ennuyeux"
                    ],
                    "antonyms": [
                        "captivant",
                        "éloquent"
                    ],
                    "common_phrases": [
                        "orateur monotone",
                        "conférencier monotone"
                    ]
                },
                {
                    "sense_id": "0ad22b3c-a71b-3eca-9295-f151b3040c41",
                    "sense_definition": "Qualifie une fonction dont le sens de variation ne change pas sur un intervalle, étant constamment croissante ou décroissante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant doit démontrer que cette fonction est strictement <w>monotone</w> sur tout l'intervalle défini."
                        },
                        {
                            "text": "Si la suite réelle est <w>monotone</w> et bornée, alors elle converge nécessairement vers une limite finie."
                        }
                    ],
                    "common_phrases": [
                        "fonction monotone",
                        "suite monotone",
                        "croissance monotone"
                    ]
                }
            ]
        }
    ]
}