                "senses": [
                    {
                        "sense_id": "9adaeb84-c86f-37d0-887a-eb0d0bb903ef",
                        "entry_id": "9e31a0f7-1f12-3665-9aef-1b09ff82fae4",
                        "glosses": [
                            "Induire en utilisant un médicament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d85c7cd-0f33-41f8-ac75-617c5160e77a",
                                "sense_id": "9adaeb84-c86f-37d0-887a-eb0d0bb903ef",
                                "text": "Ils se montrent pourtant potentiellement capables de pharmaco-induire un fonctionnement clairement psychotique durable (délire, hallucinations, interprétations, dissociation mentale…) y compris chez des individus étant de structure préalable névrotique."
                            },
                            {
                                "example_id": "1c618693-89e7-4da0-9028-4851e0cc3a24",
                                "sense_id": "9adaeb84-c86f-37d0-887a-eb0d0bb903ef",
                                "text": "Accès maniaque pharmaco-induit et entrée dans le trouble bipolaire."
                            },
                            {
                                "example_id": "074e3856-3200-450a-bc03-d325c1a01898",
                                "sense_id": "9adaeb84-c86f-37d0-887a-eb0d0bb903ef",
                                "text": "Le pronostic à court terme de ces psychoses aiguës pharmaco-induites est bon, avec régression rapide de la symptomatologie sous traitement neuroleptique."
                            }
                        ]
                    }
