                    },
                    {
                        "sense_id": "9981c3a8-2c1b-3563-b47c-5a6363cd3e15",
                        "entry_id": "32ba2673-32d1-39eb-abb1-a27ec13de59e",
                        "glosses": [
                            "Urinoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04ba2378-132f-4638-9abd-59861c8e8d88",
                                "sense_id": "9981c3a8-2c1b-3563-b47c-5a6363cd3e15",
                                "text": "Beim Betreten des Pissoirs:\n1. Wenn noch kein Pissoir besetzt ist, dann sollte man das Pissoir ganz links oder das ganz rechts bevorzugen…."
                            },
                            {
                                "example_id": "2e90352f-7531-41d1-9903-4526bb7ca5a0",
                                "sense_id": "9981c3a8-2c1b-3563-b47c-5a6363cd3e15",
                                "text": "Männer erleichtern sich in Pissoirs oder an Bäumen, Frauen müssen fast immer lange vor Kabinen warten. Deshalb gibt es jetzt das „Missoir“.",
                                "translation": "Les hommes se soulagent dans les urinoirs ou contre les arbres, les femmes doivent presque toujours attendre longtemps devant les cabines. C’est pourquoi il y a maintenant le \"Missoir\"."
                            }
                        ]
                    }
