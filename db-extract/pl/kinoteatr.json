                                "target_senses": [
                                    {
                                        "sense_id": "c85fea9d-9035-345a-8721-dd1f6b3fe838",
                                        "entry_id": "d5695ada-277e-3d14-81a4-15dd32053aeb",
                                        "glosses": [
                                            "отдельно стоящее здание или встроенные помещения, где основным композиционным и функциональным элементом является один или несколько кинозалов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74042b2-47c4-49f7-9164-5d8793eb7f4e",
                                                "sense_id": "c85fea9d-9035-345a-8721-dd1f6b3fe838",
                                                "text": "У кассирши кинотеатра «Знание» с утра разболелась голова."
                                            },
                                            {
                                                "example_id": "931cf7f5-4582-4a3e-a684-5dbce02a83ab",
                                                "sense_id": "c85fea9d-9035-345a-8721-dd1f6b3fe838",
                                                "text": "Мы приближались к кинотеатру, и я с ужасом чувствовал, что через десять минут на меня обрушится ещё одно унижение, которого я не в силах вынести, и стал ругать фильм."
                                            },
                                            {
                                                "example_id": "a4dc810d-0f4f-4271-999c-920018d2a295",
                                                "sense_id": "c85fea9d-9035-345a-8721-dd1f6b3fe838",
                                                "text": "Теперь во всех городах возводят типовой кинотеатр «Космос», в котором можно посмотреть типовой художественный фильм."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
