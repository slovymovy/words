                                "target_senses": [
                                    {
                                        "sense_id": "dfa4f80d-97ad-3bb2-8385-9b00f6211a4c",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "The land immediately next to, and inland from, a coast."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a9a14f8-7ce3-4cfc-8781-94036840b592",
                                                "sense_id": "dfa4f80d-97ad-3bb2-8385-9b00f6211a4c",
                                                "text": "In West Wales it has never been possible until recently to exploit the magnificent natural harbour of Milford Haven, for there was no industrial hinterland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5b40cf-5337-36ce-b829-0d97f4a0786f",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "The rural territory surrounding an urban area, especially a port."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d1a5594-65b7-3c6c-baad-9a72503a4098",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "A remote or undeveloped area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0adce716-94b9-46ac-9429-53f23b055fed",
                                                "sense_id": "4d1a5594-65b7-3c6c-baad-9a72503a4098",
                                                "text": "In the film, Hanks is a veteran traversing the Texas hinterlands during the Reconstruction period when he stumbles upon a lost young white girl (Helena Zengel) who only speaks Kiowa, and is forced to undergo a dangerous journey to bring the orphan to her family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22bedc63-e7b9-38ca-a566-bce659b96d2a",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "That which is unknown or unexplored about someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea769729-10cb-41d7-8732-ed31400345e8",
                                                "sense_id": "22bedc63-e7b9-38ca-a566-bce659b96d2a",
                                                "text": "Near-synonym: shadow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496a3a32-8f41-35f4-8fab-e2cf94e75450",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "An area of land far from the sea."
                                        ],
