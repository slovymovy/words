                "senses": [
                    {
                        "sense_id": "a4e3aa6f-6b75-3ef9-9784-52b525b9dcec",
                        "entry_id": "cb72522e-1f25-32e4-8fcd-8ef0a3b4a12b",
                        "glosses": [
                            "US-amerikanischer Auslandsnachrichtendienst"
