                "senses": [
                    {
                        "sense_id": "f3bd2fe9-aab4-3f43-87a4-6e1ba6a77d3d",
                        "entry_id": "49d3dcdb-d213-3027-9306-d4dbeb6794b1",
                        "glosses": [
                            "Faire perdre son caractère latin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff1bcd4-3722-4365-9d09-2e278abdd986",
                                "sense_id": "f3bd2fe9-aab4-3f43-87a4-6e1ba6a77d3d",
                                "text": "C'est pourquoi je travaille à la réhébraïser, à la déchristianiser, à la déshelléniser et à la délatiniser."
                            },
                            {
                                "example_id": "4a798364-54a5-4283-9ea4-55e9159cc1d2",
                                "sense_id": "f3bd2fe9-aab4-3f43-87a4-6e1ba6a77d3d",
                                "text": "Non content de toscaniser ou, si l’on préfère de dire, latiniser les graphies, selon moi originales, comme valuri, on est allé jusqu’à toscaniser, tout en les délatinisant, des graphies originales comme nivi."
                            }
                        ]
                    }
