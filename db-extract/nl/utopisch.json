                    }
                ],
                "translations": [
                    {
                        "translation_id": "bde47dea-e5d9-4ca2-9284-561737753e8e",
                        "source_entry_id": "fa63a6a1-7868-3643-9ac9-b4dde1d5fde6",
                        "target_lang_word": "utopian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utopian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55fe2a71-6a40-3dcd-9900-9a49d39d5ec2",
                                        "entry_id": "41dae8eb-cd27-3975-8c23-f257a268c827",
                                        "glosses": [
                                            "Of or pertaining to or resembling a utopia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae9c30c-4c49-4fd7-8f6b-8848c66526bb",
                                                "sense_id": "55fe2a71-6a40-3dcd-9900-9a49d39d5ec2",
                                                "text": "utopian happiness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5906fe6b-e60c-316d-b5b6-cc4307653ce3",
                                        "entry_id": "41dae8eb-cd27-3975-8c23-f257a268c827",
                                        "glosses": [
                                            "Ideal but often impractical; visionary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf0f25a-1818-4524-9f2d-324c7b2b6050",
                                                "sense_id": "5906fe6b-e60c-316d-b5b6-cc4307653ce3",
                                                "text": "a utopian project"
                                            },
                                            {
                                                "example_id": "22f9ef94-a72b-4443-ab30-596e3fa74591",
                                                "sense_id": "5906fe6b-e60c-316d-b5b6-cc4307653ce3",
                                                "text": "The Great Society was never, in my mind, just a visionary utopian ideal. I considered it a realistic outline of what this nation could achieve in a limited period of time if we marshaled our will and committed our resources."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "utopian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f00821-ef5a-37ee-9942-e822d833f893",
                                        "entry_id": "a2d01a54-c9ee-34f0-aa7d-c681600b0283",
                                        "glosses": [
                                            "Someone who supports or heralds the establishment of a utopia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1affebf9-4a8c-48a0-ad10-ae59b4976f95",
                                                "sense_id": "c6f00821-ef5a-37ee-9942-e822d833f893",
                                                "text": "One of our brighter young Utopians, Aldous Huxley, predicts that the movies of the future will include “feelies” and “smellies.”"
                                            },
                                            {
                                                "example_id": "5b3f19e1-67f0-4629-bc6b-3b1c7402ed7c",
                                                "sense_id": "c6f00821-ef5a-37ee-9942-e822d833f893",
                                                "text": "Digital utopians have heralded the dawn of an era in which Web 2.0 […] ushers in the democratization of the world: more information, more perspectives, more opinions, more everything, and most of it without filters or fees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a75fd22-5d74-4dab-934e-065692963086",
                        "source_entry_id": "fa63a6a1-7868-3643-9ac9-b4dde1d5fde6",
                        "target_lang_word": "utopique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utopique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf3eb220-8bbc-3988-a29f-26b8de8b023f",
                                        "entry_id": "be0b72a3-1ea7-3d3f-a94c-7c2582302f84",
                                        "glosses": [
                                            "Qui a le caractère de l’utopie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41bb366d-135f-438b-9be9-ca6985d97abb",
                                                "sense_id": "cf3eb220-8bbc-3988-a29f-26b8de8b023f",
                                                "text": "L'exemple extrême d'une attitude utopique prônant la passivité a été celle de l'Église du XIXᵉ siècle proposant à la classe ouvrière éhontément exploitée de prendre patience, les souffrances subies sur cette terre lui ouvrant pour après la mort les portes du Paradis."
                                            },
                                            {
                                                "example_id": "a62aa042-138c-4cb3-85a1-ab0168a562c2",
                                                "sense_id": "cf3eb220-8bbc-3988-a29f-26b8de8b023f",
                                                "text": "Il est bien sûr utopique de rêver un monde sans guerres, mais cette utopie ne manque cependant pas de réalisme."
                                            },
                                            {
                                                "example_id": "02c4dba9-3e29-44cd-bd02-c2114459693e",
                                                "sense_id": "cf3eb220-8bbc-3988-a29f-26b8de8b023f",
                                                "text": "Nous fantasmons des situations utopiques — un travail formidable, passionnant et ultra-payé tout de suite, rompre sans faire souffrir, renouveler l’art ou ce métier au premier coup d’essai — pour mieux fuir le réel et le réalisable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
