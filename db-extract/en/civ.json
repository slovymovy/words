            {
                "entry_id": "6bff6af2-ffd5-31be-ab9b-7abee53bd4db",
                "word": "Civ",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37e9c1ee-41b3-3d8b-8ab6-83e7f497def7",
                        "entry_id": "6bff6af2-ffd5-31be-ab9b-7abee53bd4db",
                        "glosses": [
                            "Civilization, a turn-based strategy video game from 1991 (and various sequels) in which the player attempts to build and maintain an empire throughout history."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4ec9396f-4ad4-44c4-9309-23611bd6bd21",
                                "sense_id": "37e9c1ee-41b3-3d8b-8ab6-83e7f497def7",
                                "text": "If you have played Civ before then, you already know what I am talking about. If you haven't, then what are you waiting for?"
                            },
                            {
                                "example_id": "8ba77c9a-d427-46e5-9021-7e2692d4ff1d",
                                "sense_id": "37e9c1ee-41b3-3d8b-8ab6-83e7f497def7",
                                "text": "I'd worked almost exclusively on the Wizardry series, so I knew everything about it like the back of my hand. So when I played Civ, I became fascinated with how it did that."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaa75b9e-7742-3846-bc9b-a66be148210d",
                        "entry_id": "6bff6af2-ffd5-31be-ab9b-7abee53bd4db",
                        "glosses": [
                            "a civilization, any of various playable empires controlled by a player in the Civilization games."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
