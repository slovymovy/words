                ],
                "senses": [
                    {
                        "sense_id": "d1510aed-847e-34c0-8b04-7e7bab1f82df",
                        "entry_id": "24e0b47a-ecd1-305f-bc82-c1d0ee7fdb69",
                        "glosses": [
                            "Übungs- und Wettkampfanlage, die der Jugend zur körperlichen Ertüchtigung dient"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "098a5868-bf64-42f2-8cf0-da5e997483ce",
                                "sense_id": "d1510aed-847e-34c0-8b04-7e7bab1f82df",
                                "text": "Gymnasion und Poliskultur bilden spätestens seit klassischer Zeit eine untrennbare Einheit."
                            },
                            {
                                "example_id": "e151013b-62f0-40ba-b3a6-c73615d733e1",
                                "sense_id": "d1510aed-847e-34c0-8b04-7e7bab1f82df",
                                "text": "Eine Stadt ist von nun an ohne eine derartige Einrichtung kaum denkbar, und umgekehrt formt das Gymnasion einen wichtigen Teil im Leben der Bürger."
                            },
                            {
                                "example_id": "d94f21c8-f563-4ee0-8d2f-85ce2e9692e0",
                                "sense_id": "d1510aed-847e-34c0-8b04-7e7bab1f82df",
                                "text": "Jedoch kommen in der späteren prachtliebenden Zeit allerdings noch Erweiterungen dieser Anlage vor, und es scheint mit dem Gymnasion auch mitunter ein Stadion verbunden worden zu sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3bf1508-a408-4396-aa8e-96b289dca911",
                        "source_entry_id": "24e0b47a-ecd1-305f-bc82-c1d0ee7fdb69",
                        "source_sense_id": "d1510aed-847e-34c0-8b04-7e7bab1f82df",
                        "target_lang_word": "gymnasion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gymnasion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                        "entry_id": "7f507354-5f3c-3928-b759-13dc812effc4",
                                        "glosses": [
                                            "Alternative form of gymnasium."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0022201-5b3a-423b-9e9e-1b60bd1f68a0",
                                                "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                                "text": "The most extensive employment of columns in civic architecture was in the porticos, the stoas, which surrounded the market-places and extended through many streets, being connected with baths, gymnasions, palaestras, stadia, and hippodromes, and even appearing as independent buildings."
                                            },
                                            {
                                                "example_id": "3dc441ce-8760-4fcc-b919-4b181ee26d4d",
                                                "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                                "text": "Spandex had not yet been invented, so swimming, as many other sports, was done in the nude (see earlier discussion about gymnasions)."
                                            },
                                            {
                                                "example_id": "d6462d2f-c016-40ec-8b98-2aa06a543a99",
                                                "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                                "text": "The gymnasions did not remain training camps, but became places where people could spend time and hold meetings as needed, and it was there that the early Sophists began teaching youngsters. After the Athenian gymnasions, Academy, Lyceion, and Kynosarges became schools of famous philosophers, gymnasions were no longer merely places where naked men conducted physical training and then washed and relaxed, but were also centers for cultural education — if not schools (see below)."
                                            },
                                            {
                                                "example_id": "027f2e20-eeac-4748-b81e-1195df96779b",
                                                "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                                "text": "The new bathing standard of (some) Late Hellenistic gymnasia is probably reflected in Vitruvius’ description of an ideal Greek gymnasion, which included in the corners of its northern suite of rooms two areas that were physically clearly separated: on one side a traditional loutron for cold water ablutions, and on the other an extended suite with various warm bathing forms, among them especially sweat baths."
                                            },
                                            {
                                                "example_id": "afcead9e-4299-4617-b5c3-ee82ef49d82a",
                                                "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                                "text": "Although athlete figurines were found in early levels at Seleucia-on-the-Tigris (Van Ingen 1939, 8), archaeological and textual evidence both indicate that gymnasia were not introduced into Babylonia until late in the Hellenistic period, and even then were only founded at Babylon and Seleucia-on-the-Tigris. The earliest evidence for a gymnasion at Babylon is a Greek inscription “giving a victory list of ephebes and youths in gymnastic contests” that dates to 109 bce, over two centuries after Alexander the Great, as well as three decades after the Parthian conquest of the Seleucid Empire (Downey 1988, 14)."
                                            },
                                            {
                                                "example_id": "64b62988-2d77-41bd-a295-f64511356757",
                                                "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                                "text": "Private individuals also supplied financial support for important institutions, such as those housed in the gymnasion."
                                            },
                                            {
                                                "example_id": "ac9b6e7c-21ec-4a64-8800-26b1fae60fc0",
                                                "sense_id": "ecadb39e-bf7a-3776-aabf-c376fb2f0ef6",
                                                "text": "Gymnasia were public institutions, but in the Roman period the running of the gymnasion was often left to private citizens who were appointed as gymnasiarchs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95e4238f-1b22-4a4a-a218-0dfae4015bd8",
                        "source_entry_id": "24e0b47a-ecd1-305f-bc82-c1d0ee7fdb69",
                        "source_sense_id": "d1510aed-847e-34c0-8b04-7e7bab1f82df",
                        "target_lang_word": "gymnase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gymnase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55315046-5c83-3f41-86fc-382b754500ec",
                                        "entry_id": "22f1fa00-70ce-3a8f-9688-675064d29a05",
                                        "glosses": [
                                            "Lieu où les Grecs s’exerçaient, nus (ou presque nus) à lutter, à lancer le disque, et à d’autres jeux propres à développer et à fortifier le corps."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f8945a2-3177-41be-a250-dd6fd0aafb98",
                                                "sense_id": "55315046-5c83-3f41-86fc-382b754500ec",
                                                "text": "Les exercices, les jeux du gymnase."
                                            },
                                            {
                                                "example_id": "0690c325-3d0d-4654-b3f0-e90cafd2b24b",
                                                "sense_id": "55315046-5c83-3f41-86fc-382b754500ec",
                                                "text": "Les portiques extérieurs des gymnases étaient particulièrement destinés aux conférences philosophiques et aux exercices littéraires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a217047-fc54-347b-9ecb-d24e94040959",
                                        "entry_id": "22f1fa00-70ce-3a8f-9688-675064d29a05",
                                        "glosses": [
                                            "Établissement où l’on forme aux exercices du corps."
                                        ],
                                        "tags": [
                                            "Aujourd’hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c2290ef-fcb3-49bd-b1d8-9673614dc149",
                                                "sense_id": "6a217047-fc54-347b-9ecb-d24e94040959",
                                                "text": "Puis je sentais bien que cela faisait plaisir à ma mère de me faire du mal ; qu’elle avait besoin de mouvement et pouvait se payer de la gymnastique sans aller au gymnase, où il aurait fallu qu’elle mît un petit pantalon et une petite blouse. — Je ne la voyais pas bien en petite blouse et en petit pantalon."
                                            },
                                            {
                                                "example_id": "b5ab2f3e-9809-4380-b3da-1b9ba28e5da8",
                                                "sense_id": "6a217047-fc54-347b-9ecb-d24e94040959",
                                                "text": "L’équipe des hockeyeuses avait disparu, mais il trouva sans mal le gymnase, un bâtiment bas près d’une piste d’athlétisme, avec sur le devant une grande statue représentant un discobole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687e8fac-14d3-361f-86af-6955222f3dc9",
                                        "entry_id": "22f1fa00-70ce-3a8f-9688-675064d29a05",
                                        "glosses": [
                                            "Grande salle aménagée pour les exercices du corps, dans un établissement scolaire."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "110f7266-2bc0-4bf0-ad41-604e623b3366",
                                                "sense_id": "687e8fac-14d3-361f-86af-6955222f3dc9",
                                                "text": "Les gymnases militaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63736de8-f67f-3480-a1ee-8ff1fb7610a5",
                                        "entry_id": "22f1fa00-70ce-3a8f-9688-675064d29a05",
                                        "glosses": [
                                            "Établissement d’enseignement secondaire supérieur. En usage dans les cantons de Vaud et Berne uniquement."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac63f650-4b2f-40eb-9a6a-826c6e77dc67",
                                                "sense_id": "63736de8-f67f-3480-a1ee-8ff1fb7610a5",
                                                "text": "Gymnases de la Cité, de Bienne et du Jura bernois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98ff5fe4-422b-32e8-9c6d-9a683a12e122",
                                        "entry_id": "22f1fa00-70ce-3a8f-9688-675064d29a05",
                                        "glosses": [
                                            "(Empire russe) Équivalent des petits et grands lycées classiques français ou allemands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ea6773-45c6-44ca-9b46-78423b13eab2",
                                                "sense_id": "98ff5fe4-422b-32e8-9c6d-9a683a12e122",
                                                "text": "On avait deux chevaux, un gris pommelé et un noir, et tous les matins, le cocher Piotr nous menait, Odette et moi, au lycée (au « gymnase » comme on appelait là-bas les lycées)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
