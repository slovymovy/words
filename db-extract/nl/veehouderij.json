                ],
                "senses": [
                    {
                        "sense_id": "4b0a8999-371a-3f05-b49a-d588114add86",
                        "entry_id": "82e657e5-2e72-349b-ad6f-8a78764311f2",
                        "glosses": [
                            "het houden van vee"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "519d06b9-31fe-43a2-bb75-70e4f32ab0fe",
                                "sense_id": "4b0a8999-371a-3f05-b49a-d588114add86",
                                "text": "De veehouderij zorgt voor vlees, zuivel en eieren, maar ook voor bijvoorbeeld wol en leer."
                            },
                            {
                                "example_id": "83b8c562-f9d2-4d7e-b648-26f508f61e1c",
                                "sense_id": "4b0a8999-371a-3f05-b49a-d588114add86",
                                "text": "Directeur Anne Hilhorst van Wakker Dier zegt zich zorgen te maken om de stijging van het aantal megastallen. \"De schaalvergroting en intensivering van de veehouderij zet alsmaar door. Het wordt echt tijd om paal en perk te stellen\", aldus Hilhorst."
                            },
                            {
                                "example_id": "931bf205-758c-4513-bca9-89e1b2729bd1",
                                "sense_id": "4b0a8999-371a-3f05-b49a-d588114add86",
                                "text": "Kosten-batenanalyse De intensieve veehouderij in Nederland levert jaarlijks 15 miljard euro op, maar kost 9 miljard euro aan gezondheids- en milieuschade."
                            }
                        ]
                    },
                    {
                        "sense_id": "c60b13f8-6d52-3d3b-9f33-45044cda4c68",
                        "entry_id": "82e657e5-2e72-349b-ad6f-8a78764311f2",
                        "glosses": [
                            "bedrijf voor het houden van vee"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "3a29a757-e660-4d2e-958b-17fa8ef87c7d",
                                "sense_id": "c60b13f8-6d52-3d3b-9f33-45044cda4c68",
                                "text": "In dit verband betoogt [appellant] dat aan de eigenaar van de veehouderij ten onrechte een subsidie is verstrekt ten behoeve van de bedrijfsverplaatsing. Volgens hem betreft dit staatssteun, waarvan ten onrechte geen melding is gedaan bij de Europese Commissie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "284bc638-0d12-47a7-a566-a8fa2673d495",
                        "source_entry_id": "82e657e5-2e72-349b-ad6f-8a78764311f2",
                        "source_sense_id": "4b0a8999-371a-3f05-b49a-d588114add86",
