                    {
                        "sense_id": "bf4fab9e-8c08-38d3-b09a-3ecfc34ea238",
                        "entry_id": "67d2f2e5-fc73-3023-b393-e6b0314c32ec",
                        "glosses": [
                            "ideale Machtverteilung innerhalb einer Gesellschaft, bei der Macht möglichst unabhängig voneinander auf verschiedene Gruppen übertragen ist"
                        ],
                        "tags": [],
