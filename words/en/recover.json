{
    "word_family": [
        "recovery",
        "recoverable",
        "irrecoverable",
        "unrecoverable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42481889-80ee-369d-828d-0810e0c7fa87",
                    "sense_definition": "To become healthy again after an illness, injury, or period of difficulty.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "health_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took him several weeks to <w>recover</w> from the flu.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось несколько недель, чтобы <w>выздороветь</w> после гриппа.",
                                "pl": "Zajęło mu kilka tygodni, aby <w>wyzdrowieć</w> po grypie.",
                                "zh": "他花了几个星期才从流感中<w>康复</w>。"
                            }
                        },
                        {
                            "text": "She is staying home to <w>recover</w> from a bad cold.",
                            "target_lang_translations": {
                                "ru": "Она осталась дома, чтобы <w>поправиться</w> после сильной простуды.",
                                "pl": "Zostaje w domu, aby <w>dojść do siebie</w> po silnym przeziębieniu.",
                                "zh": "她待在家里，以便从重感冒中<w>恢复</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "worsen",
                        "deteriorate"
                    ],
                    "common_phrases": [
                        "recover from surgery",
                        "recover from a cold",
                        "fully recover",
                        "recover quickly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова стать здоровым после болезни, травмы или трудного периода.",
                        "pl": "Powrócić do zdrowia po chorobie, urazie lub trudnym okresie.",
                        "zh": "指在生病、受伤或经历困难后恢复健康或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выздоравливать",
                                "target_lang_sense_clarification": "процесс восстановления здоровья"
                            },
                            {
                                "target_lang_word": "поправляться",
                                "target_lang_sense_clarification": "разговорный вариант; восстанавливать силы"
                            },
                            {
                                "target_lang_word": "оправиться",
                                "target_lang_sense_clarification": "прийти в себя после болезни или потрясения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyzdrowieć",
                                "target_lang_sense_clarification": "odzyskać zdrowie po chorobie"
                            },
                            {
                                "target_lang_word": "wrócić do zdrowia",
                                "target_lang_sense_clarification": "proces rekonwalescencji"
                            },
                            {
                                "target_lang_word": "dojść do siebie",
                                "target_lang_sense_clarification": "odzyskać siły po trudnym przeżyciu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "康复",
                                "target_lang_sense_clarification": "指身体从疾病或伤痛中恢复"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指状态或健康回到正常水平"
                            },
                            {
                                "target_lang_word": "痊愈",
                                "target_lang_sense_clarification": "指病痛完全消失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "463566b3-3f2f-3c39-a9ea-eabeec6d453b",
                    "sense_definition": "To find or get back something that was lost, stolen, or missing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "retrieval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police managed to <w>recover</w> the stolen paintings.",
                            "target_lang_translations": {
                                "ru": "Полиции удалось <w>вернуть</w> украденные картины.",
                                "pl": "Policji udało się <w>odzyskać</w> skradzione obrazy.",
                                "zh": "警方成功<w>找回</w>了被盗的画作。"
                            }
                        },
                        {
                            "text": "He was lucky to <w>recover</w> his wallet after leaving it on the bus.",
                            "target_lang_translations": {
                                "ru": "Ему повезло <w>найти</w> свой кошелек после того, как он оставил его в автобусе.",
                                "pl": "Miał szczęście, że <w>odnalazł</w> portfel po tym, jak zostawił go w autobusie.",
                                "zh": "他很幸运，把钱包落在公交车上后又<w>取回</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "lose"
                    ],
                    "common_phrases": [
                        "recover stolen property",
                        "recover data",
                        "recover a vehicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Найти или получить обратно что-то потерянное, украденное или пропавшее.",
                        "pl": "Znaleźć lub odzyskać coś, co zostało zgubione, skradzione lub zaginęło.",
                        "zh": "找回或取回丢失、被盗或不见的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вернуть",
                                "target_lang_sense_clarification": "получить обратно"
                            },
                            {
                                "target_lang_word": "находить",
                                "target_lang_sense_clarification": "обнаруживать потерянное"
                            },
                            {
                                "target_lang_word": "возвращать",
                                "target_lang_sense_clarification": "процесс возврата"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odzyskać",
                                "target_lang_sense_clarification": "otrzymać z powrotem zgubioną rzecz"
                            },
                            {
                                "target_lang_word": "odnaleźć",
                                "target_lang_sense_clarification": "znaleźć coś, co zaginęło"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "找回",
                                "target_lang_sense_clarification": "寻回丢失的物品"
                            },
                            {
                                "target_lang_word": "取回",
                                "target_lang_sense_clarification": "拿回属于自己的东西"
                            },
                            {
                                "target_lang_word": "寻获",
                                "target_lang_sense_clarification": "正式用语，指找到失物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c4c70c2-27fc-33a6-ab33-ba44916d65f3",
                    "sense_definition": "To regain control of one's physical balance or emotional calmness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stumbled on the stairs but quickly <w>recovered</w> his balance.",
                            "target_lang_translations": {
                                "ru": "Он споткнулся на лестнице, но быстро <w>восстановил</w> равновесие.",
                                "pl": "Potknął się na schodach, ale szybko <w>odzyskał</w> równowagę.",
                                "zh": "他在楼梯上绊了一下，但很快<w>恢复</w>了平衡。"
                            }
                        },
                        {
                            "text": "It took a moment for her to <w>recover</w> her composure after the shock.",
                            "target_lang_translations": {
                                "ru": "Ей потребовалось мгновение, чтобы <w>вернуть</w> самообладание после шока.",
                                "pl": "Zajęło jej chwilę, by <w>odzyskać</w> opanowanie po szoku.",
                                "zh": "受惊之后，她花了一会儿才<w>平复</w>心情。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recover one's balance",
                        "recover one's breath",
                        "recover one's composure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть контроль над физическим равновесием или эмоциональным спокойствием.",
                        "pl": "Odzyskać kontrolę nad równowagą fizyczną lub spokojem emocjonalnym.",
                        "zh": "重新获得对身体平衡或情绪冷静的控制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "равновесие, дыхание"
                            },
                            {
                                "target_lang_word": "обретать снова",
                                "target_lang_sense_clarification": "возвращать утраченное состояние"
                            },
                            {
                                "target_lang_word": "овладеть",
                                "target_lang_sense_clarification": "собой, своими эмоциями"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odzyskać",
                                "target_lang_sense_clarification": "np. równowagę lub spokój"
                            },
                            {
                                "target_lang_word": "opanować się",
                                "target_lang_sense_clarification": "odzyskać panowanie nad emocjami"
                            },
                            {
                                "target_lang_word": "złapać",
                                "target_lang_sense_clarification": "np. oddech"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "使平衡或情绪回到正常"
                            },
                            {
                                "target_lang_word": "稳住",
                                "target_lang_sense_clarification": "指保持身体平衡"
                            },
                            {
                                "target_lang_word": "平复",
                                "target_lang_sense_clarification": "指情绪变得平静"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85795dc7-b527-310b-b58e-6f96915411e4",
                    "sense_definition": "To rescue someone or retrieve something from a difficult or dangerous situation, such as a wreck.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retrieval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Divers were sent to <w>recover</w> the sunken treasure from the ocean floor.",
                            "target_lang_translations": {
                                "ru": "Водолазы были отправлены, чтобы <w>поднять</w> затонувшие сокровища со дна океана.",
                                "pl": "Wysłano nurków, aby <w>wydobyli</w> zatopiony skarb z dna oceanu.",
                                "zh": "潜水员被派去从海底<w>打捞</w>沉没的宝藏。"
                            }
                        },
                        {
                            "text": "Rescue teams worked all night to <w>recover</w> the trapped hikers.",
                            "target_lang_translations": {
                                "ru": "Спасательные команды работали всю ночь, чтобы <w>спасти</w> застрявших туристов.",
                                "pl": "Zespoły ratownicze pracowały całą noc, aby <w>uratować</w> uwięzionych turystów.",
                                "zh": "救援队彻夜工作以<w>营救</w>被困的徒步旅行者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recover a body",
                        "recover the wreckage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спасти кого-то или извлечь что-то из трудной или опасной ситуации (например, после крушения).",
                        "pl": "Uratować kogoś lub wydobyć coś z trudnej lub niebezpiecznej sytuacji, np. z wraku.",
                        "zh": "从困难或危险的情况（如残骸中）营救某人或打捞某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "доставать объекты или тела"
                            },
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "со дна, из руин"
                            },
                            {
                                "target_lang_word": "спасать",
                                "target_lang_sense_clarification": "живых людей"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wydobyć",
                                "target_lang_sense_clarification": "wyciągnąć coś z wraku lub dna"
                            },
                            {
                                "target_lang_word": "odnaleźć",
                                "target_lang_sense_clarification": "ciało lub szczątki"
                            },
                            {
                                "target_lang_word": "uratować",
                                "target_lang_sense_clarification": "osoby z niebezpieczeństwa"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打捞",
                                "target_lang_sense_clarification": "从水底或废墟中取出物体"
                            },
                            {
                                "target_lang_word": "营救",
                                "target_lang_sense_clarification": "从危险中救出人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77acabb0-cf0e-3feb-bebd-c84dfd3291e0",
                    "sense_definition": "To put a new cover on something, such as furniture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>recover</w> the old armchair with a modern fabric.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>перетянуть</w> старое кресло современной тканью.",
                                "pl": "Zdecydowaliśmy się <w>obić</w> stary fotel nowoczesną tkaniną.",
                                "zh": "我们决定用现代面料给旧扶手椅<w>重包</w>。"
                            }
                        },
                        {
                            "text": "The gardener had to <w>recover</w> the plants before the frost returned.",
                            "target_lang_translations": {
                                "ru": "Садовнику пришлось снова <w>укрыть</w> растения перед возвращением заморозков.",
                                "pl": "Ogrodnik musiał ponownie <w>przykryć</w> rośliny przed powrotem przymrozków.",
                                "zh": "霜冻再次来临前，园丁不得不把植物<w>重新覆盖</w>好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recover a chair",
                        "recover the sofa"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often spelled re-cover"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать новое покрытие на чем-либо, например, на мебели.",
                        "pl": "Nałożyć nowe obicie lub pokrycie na coś, np. na meble.",
                        "zh": "为某物（如家具）重新覆盖表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перетягивать",
                                "target_lang_sense_clarification": "менять обивку мебели"
                            },
                            {
                                "target_lang_word": "покрывать заново",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "оббивать",
                                "target_lang_sense_clarification": "мебель тканью или кожей"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obić",
                                "target_lang_sense_clarification": "nałożyć nowe obicie na mebel"
                            },
                            {
                                "target_lang_word": "ponownie przykryć",
                                "target_lang_sense_clarification": "np. rośliny przed mrozem"
                            },
                            {
                                "target_lang_word": "przetapicerować",
                                "target_lang_sense_clarification": "wymienić tapicerkę"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重包",
                                "target_lang_sense_clarification": "更换家具的表面覆盖物"
                            },
                            {
                                "target_lang_word": "重新覆盖",
                                "target_lang_sense_clarification": "再次遮盖某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6abbfd4-4d89-3da6-9651-8acc88e5f32f",
                    "sense_definition": "To get back money, time, or position that has been lost or spent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "retrieval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hopes to <w>recover</w> its initial investment within two years.",
                            "target_lang_translations": {
                                "ru": "Компания надеется <w>окупить</w> свои первоначальные вложения в течение двух лет.",
                                "pl": "Firma ma nadzieję <w>odzyskać</w> początkową inwestycję w ciągu dwóch lat.",
                                "zh": "公司希望在两年内<w>收回</w>初始投资。"
                            }
                        },
                        {
                            "text": "We drove fast to <w>recover</w> lost time on the highway.",
                            "target_lang_translations": {
                                "ru": "Мы ехали быстро, чтобы <w>наверстать</w> упущенное время на шоссе.",
                                "pl": "Jechaliśmy szybko, aby <w>nadrobić</w> stracony czas na autostradzie.",
                                "zh": "我们在高速公路上开得很快，以<w>挽回</w>失去的时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recoup"
                    ],
                    "common_phrases": [
                        "recover costs",
                        "recover losses",
                        "recover expenses",
                        "recover lost time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить обратно деньги, время или положение, которые были потеряны или потрачены.",
                        "pl": "Odzyskać pieniądze, czas lub pozycję, które zostały utracone lub wydane.",
                        "zh": "收回已损失或花费的金钱、时间或地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возмещать",
                                "target_lang_sense_clarification": "расходы, убытки"
                            },
                            {
                                "target_lang_word": "навёрстывать",
                                "target_lang_sense_clarification": "упущенное время"
                            },
                            {
                                "target_lang_word": "окупать",
                                "target_lang_sense_clarification": "вложения, затраты"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odrobić",
                                "target_lang_sense_clarification": "np. stracony czas lub straty"
                            },
                            {
                                "target_lang_word": "odzyskać",
                                "target_lang_sense_clarification": "np. koszty lub inwestycję"
                            },
                            {
                                "target_lang_word": "nadrobić",
                                "target_lang_sense_clarification": "stracony czas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收回",
                                "target_lang_sense_clarification": "拿回投入的资金或成本"
                            },
                            {
                                "target_lang_word": "挽回",
                                "target_lang_sense_clarification": "弥补损失的时间或名誉"
                            },
                            {
                                "target_lang_word": "弥补",
                                "target_lang_sense_clarification": "补足损失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35d618f7-8ef6-3109-856f-5cb970580d97",
                    "sense_definition": "To obtain money or compensation through a formal legal process.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plaintiff sought to <w>recover</w> damages for the injury caused by the accident.",
                            "target_lang_translations": {
                                "ru": "Истец стремился <w>взыскать</w> убытки за травму, полученную в результате аварии.",
                                "pl": "Powód starał się <w>uzyskać</w> odszkodowanie za obrażenia spowodowane wypadkiem.",
                                "zh": "原告试图就事故造成的伤害<w>索赔</w>。"
                            }
                        },
                        {
                            "text": "He sued the contractor to <w>recover</w> the debt owed for the work.",
                            "target_lang_translations": {
                                "ru": "Он подал в суд на подрядчика, чтобы <w>взыскать</w> долг за работу.",
                                "pl": "Pozwał wykonawcę, aby <w>wyegzekwować</w> dług należny za wykonaną pracę.",
                                "zh": "他起诉了承包商，以<w>追回</w>因工作欠下的债务。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recover damages",
                        "recover a debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить деньги или компенсацию через официальный юридический процесс.",
                        "pl": "Uzyskać pieniądze lub odszkodowanie na drodze formalnego procesu prawnego.",
                        "zh": "通过正式法律程序获得金钱或赔偿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взыскивать",
                                "target_lang_sense_clarification": "долги, убытки через суд"
                            },
                            {
                                "target_lang_word": "получать возмещение",
                                "target_lang_sense_clarification": "компенсацию"
                            }
                        ],
                        "pl": [
