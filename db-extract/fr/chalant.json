                        "glosses": [
                            "Forme rare de chaland, la personne qui achète ordinairement chez un même marchand."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb9edd8-915d-4c80-9142-60361dc91bf0",
                                "sense_id": "ff697eed-3f37-34e4-bd76-53a63afce7b4",
                                "text": "Il falloit absolument en ouvrant sa boutique en uset avec plus de ruse pour attirer des Chalants en grand nombre , & debiter les nippes à bon marché."
                            },
                            {
                                "example_id": "5663f6df-4743-4ca6-95e7-6ffa5796559e",
                                "sense_id": "ff697eed-3f37-34e4-bd76-53a63afce7b4",
                                "text": "A l'instar de son homonyme de Deauville, la terminaison anglo-saxonne en moins, le Normandie accueille les chalants depuis plusieurs dizaines d'années."
                            }
                        ]
                    }
