                "senses": [
                    {
                        "sense_id": "ad8bd4c7-131a-3441-9707-c9457015557b",
                        "entry_id": "49db8211-c740-33ec-aaa4-b5122a17827a",
                        "glosses": [
                            "To sell goods for a lower price than a competitor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e218693-2e47-47a0-ad2f-09c5e74ade0b",
                                "sense_id": "ad8bd4c7-131a-3441-9707-c9457015557b",
                                "text": "Our price-match guarantee: we will not be undersold!"
                            }
                        ]
                    },
                    {
                        "sense_id": "d3c3f800-581a-3cb9-89a6-55b541212005",
                        "entry_id": "49db8211-c740-33ec-aaa4-b5122a17827a",
                        "glosses": [
                            "To sell something for less than its value."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cc430007-83b0-3c1a-b199-8e1f47f187b2",
                        "entry_id": "49db8211-c740-33ec-aaa4-b5122a17827a",
                        "glosses": [
                            "To put forward an idea, or to market a new product (or oneself), with insufficient enthusiasm or excessive understatement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741e66ba-2b52-435b-9f50-83d2f8a26032",
                                "sense_id": "cc430007-83b0-3c1a-b199-8e1f47f187b2",
                                "text": "Near-synonym: sell short"
                            },
                            {
                                "example_id": "e1792834-7a1a-44dd-ad2d-9306ac4fe968",
                                "sense_id": "cc430007-83b0-3c1a-b199-8e1f47f187b2",
                                "text": "don't undersell it"
                            },
                            {
                                "example_id": "20ab32aa-9f4c-4164-8902-94b0761b88c8",
                                "sense_id": "cc430007-83b0-3c1a-b199-8e1f47f187b2",
                                "text": "don't undersell yourself"
                            },
                            {
                                "example_id": "ca23c7a4-b011-4b14-ba24-82e8fb81442c",
                                "sense_id": "cc430007-83b0-3c1a-b199-8e1f47f187b2",
                                "text": "But by inferring sleep, the etymology also undersells Siberia's scope, both real and imagined."
                            }
                        ]
                    }
