            {
                "entry_id": "3233cc01-a291-32a3-ae02-6ee36305f0db",
                "word": "infanterist",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "bd4386ad-252f-4e7d-86b7-82407b462559",
                        "entry_id": "3233cc01-a291-32a3-ae02-6ee36305f0db",
                        "tags": [
                            "plural"
