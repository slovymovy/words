{
    "word_family": [
        "success",
        "successful",
        "successfully",
        "succession",
        "successor",
        "successive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c356e95b-a86e-3ef0-aefc-7cee2e16430c",
                    "sense_definition": "To achieve a desired aim or result; to do what you tried or wanted to do.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She worked hard and finally <w>succeeded</w> in passing the exam.",
                            "target_lang_translations": {
                                "ru": "Она усердно работала, и, наконец, <w>сумела</w> сдать экзамен.",
                                "tr": "Çok çalıştı ve sonunda sınavı geçmeyi <w>başardı</w>.",
                                "zh": "她努力工作，最终<w>成功</w>通过了考试。"
                            }
                        },
                        {
                            "text": "If you want to <w>succeed</w> in life, you must be persistent.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите <w>преуспеть</w> в жизни, вы должны быть настойчивы.",
                                "tr": "Hayatta <w>başarılı olmak</w> istiyorsanız kararlı olmalısınız.",
                                "zh": "如果你想在生活中<w>成功</w>，就必须坚持不懈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prosper",
                        "flourish",
                        "do well"
                    ],
                    "antonyms": [
                        "fail"
                    ],
                    "common_phrases": [
                        "succeed in",
                        "succeed at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добиться желаемой цели или результата; сделать то, что вы пытались или хотели сделать.",
                        "tr": "İstenen bir amaca veya sonuca ulaşmak; denediğiniz veya yapmak istediğiniz şeyi başarmak.",
                        "zh": "达到预期的目标或结果；做到了你尝试或想要做的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преуспеть",
                                "target_lang_sense_clarification": "в делах или жизни"
                            },
                            {
                                "target_lang_word": "добиться успеха",
                                "target_lang_sense_clarification": "достичь желаемого"
                            },
                            {
                                "target_lang_word": "суметь",
                                "target_lang_sense_clarification": "справиться с задачей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başarmak",
                                "target_lang_sense_clarification": "bir işi başarıyla tamamlamak"
                            },
                            {
                                "target_lang_word": "başarılı olmak",
                                "target_lang_sense_clarification": "hayatta veya işte başarı göstermek"
                            },
                            {
                                "target_lang_word": "muvaffak olmak",
                                "target_lang_sense_clarification": "sonuca ulaşmak (resmi/eski)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成功",
                                "target_lang_sense_clarification": "达成目标"
                            },
                            {
                                "target_lang_word": "如愿",
                                "target_lang_sense_clarification": "实现愿望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c85cdbfb-f4a9-3a8a-b500-c8869f750396",
                    "sense_definition": "To take an official position, title, or role after someone else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prince will <w>succeed</w> his father as king when the time comes.",
                            "target_lang_translations": {
                                "ru": "Принц <w>сменит</w> своего отца на посту короля, когда придет время.",
                                "tr": "Zamanı geldiğinde prens kral olarak babasının <w>yerine geçecek</w>.",
                                "zh": "时机成熟时，王子将<w>继任</w>他父亲成为国王。"
                            }
                        },
                        {
                            "text": "She <w>succeeded</w> to the throne at a very young age.",
                            "target_lang_translations": {
                                "ru": "Она <w>наследовала</w> трон в очень юном возрасте.",
                                "tr": "Çok genç yaşta tahta <w>geçti</w>.",
                                "zh": "她年纪轻轻就<w>继承</w>了王位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "take the place of",
                        "follow"
                    ],
                    "antonyms": [
                        "precede"
                    ],
                    "common_phrases": [
                        "succeed to the throne",
                        "succeed someone as"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять официальную должность, титул или роль после кого-то другого.",
                        "tr": "Başka birinin ardından resmi bir pozisyonu, unvanı veya görevi devralmak.",
                        "zh": "在某人之后接任官方职位、头衔或角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследовать",
                                "target_lang_sense_clarification": "титул или право"
                            },
                            {
                                "target_lang_word": "сменить",
                                "target_lang_sense_clarification": "кого-либо на посту"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerine geçmek",
                                "target_lang_sense_clarification": "birinin makamını veya görevini devralmak"
                            },
                            {
                                "target_lang_word": "halefi olmak",
                                "target_lang_sense_clarification": "sonraki makam sahibi olmak"
                            },
                            {
                                "target_lang_word": "tahta geçmek",
                                "target_lang_sense_clarification": "miras yoluyla unvanı devralmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "继任",
                                "target_lang_sense_clarification": "接替职位"
                            },
                            {
                                "target_lang_word": "继承",
                                "target_lang_sense_clarification": "承袭头衔或王位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3489d071-6faf-38a8-9a46-7670a526095c",
                    "sense_definition": "To come next after something in time or a series.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A long silence <w>succeeded</w> the loud explosion.",
                            "target_lang_translations": {
                                "ru": "За громким взрывом <w>последовала</w> долгая тишина.",
                                "tr": "Yüksek patlamanın <w>ardından</w> uzun bir sessizlik <w>geldi</w>.",
                                "zh": "巨大的爆炸声后<w>随之而来</w>的是长久的寂静。"
                            }
                        },
                        {
                            "text": "Summer <w>succeeds</w> spring in the cycle of the seasons.",
                            "target_lang_translations": {
                                "ru": "Лето <w>сменяет</w> весну в цикле времен года.",
                                "tr": "Mevsimlerin döngüsünde yaz, ilkbaharın <w>yerini alır</w>.",
                                "zh": "在四季轮回中，夏天<w>接替</w>了春天。"
                            }
                        }
                    ],
                    "synonyms": [
                        "follow",
                        "come after",
                        "ensue"
                    ],
                    "antonyms": [
                        "precede"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти следом за чем-то во времени или в последовательности.",
                        "tr": "Zaman veya dizi içinde bir şeyden hemen sonra gelmek, bir şeyi takip etmek.",
                        "zh": "在时间或顺序上紧随某事之后发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следовать за",
                                "target_lang_sense_clarification": "идти после"
                            },
                            {
                                "target_lang_word": "сменять",
                                "target_lang_sense_clarification": "приходить на смену"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ardından gelmek",
                                "target_lang_sense_clarification": "zaman veya sıra olarak izlemek"
                            },
                            {
                                "target_lang_word": "takip etmek",
                                "target_lang_sense_clarification": "sonrasında yer almak"
                            },
                            {
                                "target_lang_word": "yerini almak",
                                "target_lang_sense_clarification": "sonrasında onun yerine geçmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随之而来",
                                "target_lang_sense_clarification": "紧接着发生"
                            },
                            {
                                "target_lang_word": "接替",
                                "target_lang_sense_clarification": "在顺序上更替"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}