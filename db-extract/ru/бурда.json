                ],
                "senses": [
                    {
                        "sense_id": "7a5b6d04-ff5a-3bc2-b2a8-3184f270b550",
                        "entry_id": "8a7598ea-f082-38f7-9a2a-4f6561cea3fe",
                        "glosses": [
                            "dishwater, slops"
                        ],
                        "tags": [
                            "colloquial",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "02eb4d37-e183-43b9-bef2-7e1b310af2e1",
                                "sense_id": "7a5b6d04-ff5a-3bc2-b2a8-3184f270b550",
                                "text": "э́то не чай, а бурда́",
                                "translation": "it's not tea but slops",
                                "english": "it's not tea but slops"
                            },
                            {
                                "example_id": "51b0270b-e007-4030-863d-85d8798709d8",
                                "sense_id": "7a5b6d04-ff5a-3bc2-b2a8-3184f270b550",
                                "text": "— А что? — трево́жится жена́. — Ра́зве суп не хоро́ш?\n— Не зна́ю, како́й ну́жно име́ть сви́нский вкус, что́бы есть э́ту бурду́! Пересо́лен, тря́пкой воня́ет… клопы́ каки́е-то вме́сто лу́ка…",
                                "translation": "\"What's wrong?\" asks his wife anxiously. \"Isn't the soup good?\"\n\"One must have the taste of a pig to eat hogwash like that! There's too much salt in it; it smells of dirty rags . . . more like bugs than onions. . . .<...>\"",
                                "english": "\"What's wrong?\" asks his wife anxiously. \"Isn't the soup good?\"\n\"One must have the taste of a pig to eat hogwash like that! There's too much salt in it; it smells of dirty rags . . . more like bugs than onions. . . .<...>\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
