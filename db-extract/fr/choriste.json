                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chorist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae518c85-d3eb-3424-a612-efd9c2f49a63",
                                        "entry_id": "8892c11a-975a-364e-8e10-50b1182d90c0",
                                        "glosses": [
                                            "Person, die in einem Chor (meist einem Opernchor) singt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c66e34db-dbfd-4574-b35d-af8721828cf6",
                                                "sense_id": "ae518c85-d3eb-3424-a612-efd9c2f49a63",
                                                "text": "„Einmal wöchentlich kommen Musiker oder Choristen für eine halbe Stunde zu Besuch, um den Kindern durch Vorspielen und Erklären ihre Instrumente und ihre Begeisterung für die Musik nahezubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8f1788b-d378-4d53-89f1-e3c0c29411a1",
                        "source_entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
