                    {
                        "sense_id": "ec46267c-2b2c-3f1f-ba10-c429f9838973",
                        "entry_id": "bf8c33d2-35c8-3488-830d-9048107a08f0",
                        "glosses": [
                            "Qui a atteint la saturation, qui ne peut plus rien accepter de plus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ec72875-c9ca-3c1c-898d-b8b3d96ff391",
                        "entry_id": "bf8c33d2-35c8-3488-830d-9048107a08f0",
                        "glosses": [
                            "Qui a atteint la saturation, qui ne peut plus rien accepter de plus.",
                            "Qui a atteint la concentration maximale que peut accepter le solvant."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae27bd4d-56f0-39c8-8d67-7e206638a849",
                        "entry_id": "bf8c33d2-35c8-3488-830d-9048107a08f0",
                        "glosses": [
                            "Qui a atteint la saturation, qui ne peut plus rien accepter de plus.",
                            "Qui a atteint nombre total d'atomes de valence."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf05edad-a1c0-353f-88c8-d53f0111bfd1",
                        "entry_id": "bf8c33d2-35c8-3488-830d-9048107a08f0",
                        "glosses": [
                            "Qualifie un sol ou un horizon dont le rapport S/T est élevé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f620132a-b6d3-4987-ac46-0c31c89169cc",
                                "sense_id": "cf05edad-a1c0-353f-88c8-d53f0111bfd1",
                                "text": "Le complexe adsorbant est en général saturé, très majoritairement par le calcium et le magnésium."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7fb6cbe-de3e-3058-8b75-4ec733ada312",
                        "entry_id": "bf8c33d2-35c8-3488-830d-9048107a08f0",
                        "glosses": [
                            "Comblé, rempli au maximum."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5b3e3096-8b82-4fc9-8502-0474d785038c",
                                "sense_id": "c7fb6cbe-de3e-3058-8b75-4ec733ada312",
                                "text": "Le public est saturé de ce genre d’ouvrages."
                            },
                            {
                                "example_id": "b6f374c6-d650-4fe8-86ba-ce3f17d72661",
                                "sense_id": "c7fb6cbe-de3e-3058-8b75-4ec733ada312",
                                "text": "En août, bien avant dans la nuit, la terre, saturée de soleil, est chaude encore. Ainsi l’amour de sa mère morte rayonnait autour de lui, touchait les cœurs les plus durs."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1e17f79-a5d0-37b1-bd28-d21c45d0b8f5",
                        "entry_id": "bf8c33d2-35c8-3488-830d-9048107a08f0",
                        "glosses": [
                            "Se dit d'hydrocarbure linéaire, ramifié ou non, où tous les atomes de carbones sont liés entres eux par une liaison simple. → voir alcane"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30e9850d-cb04-4afa-ba8e-8e7289aa4675",
                        "source_entry_id": "bf8c33d2-35c8-3488-830d-9048107a08f0",
                        "target_lang_word": "насыщенный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "насыщенный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98fee6aa-6c14-33fe-bef2-41e1bff1fdb8",
                                        "entry_id": "f86be559-0dad-3f81-93fd-5744856ac195",
                                        "glosses": [
                                            "содержащий в себе очень большое количество какого-либо растворённого или газообразного вещества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4641eb8-b9a0-4c2c-b1e9-e125f7d9f615",
                                                "sense_id": "98fee6aa-6c14-33fe-bef2-41e1bff1fdb8",
                                                "text": "Медные наконечники для углей могут быть сделаны гальванопластическим путём без помощи ванны, для чего предварительно изготовляют насыщенный раствор медного купороса в воде."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b39402fa-f978-34a8-9f93-538921279d3c",
                                        "entry_id": "f86be559-0dad-3f81-93fd-5744856ac195",
                                        "glosses": [
                                            "перен. очень содержательный, обильный, богатый чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57aabc1d-bc2a-4b3e-ab5b-c2038966e484",
                                                "sense_id": "b39402fa-f978-34a8-9f93-538921279d3c",
                                                "text": "Натуральный гранатовый сок обладает чересчур насыщенным вкусом, поэтому его разбавляют сахарным сиропом и в какой-то степени освобождают от вяжущих дубильных веществ."
                                            },
                                            {
                                                "example_id": "5d3f3e65-3899-4273-b933-89af44e83899",
                                                "sense_id": "b39402fa-f978-34a8-9f93-538921279d3c",
                                                "text": "Белорецк превратился в культурный центр, полный яркой, здоровой и насыщенной жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4248bb8-2a9b-32d1-80e2-e10d44cf9926",
                                        "entry_id": "f86be559-0dad-3f81-93fd-5744856ac195",
                                        "glosses": [
                                            "яркий, сочный, густой"
                                        ],
                                        "tags": [
                                            "о цвете"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84389c3d-eab2-4aeb-82a8-fcbe146f8b1a",
                                                "sense_id": "d4248bb8-2a9b-32d1-80e2-e10d44cf9926",
                                                "text": "Введение микродоз различных элементов позволяет получить богатейшую гамму тонов — от розовых или бледно-голубых до таких вот насыщенных зелёных."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "насыщенный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c01c952c-e233-30e0-9504-db3bd63724c8",
                                        "entry_id": "f0d83eea-db20-31a3-90a0-7885562749d4",
                                        "glosses": [
                                            "страд. прич. прош. вр. от насытить"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81aa332b-1bff-49cc-acc4-9d5e07dc5e29",
                                                "sense_id": "c01c952c-e233-30e0-9504-db3bd63724c8",
                                                "text": "О горе нам, насыщенным ныне и не редко с пренебрежением на дары Божии взирающим!"
                                            },
                                            {
                                                "example_id": "aaa1f932-f71c-44f1-9a44-12c980c8f8a4",
                                                "sense_id": "c01c952c-e233-30e0-9504-db3bd63724c8",
                                                "text": "Всякому, вероятно, случалось, проходя мимо клоаки, не только зажимать нос, но и стараться не дышать; точно такое же насилие должен делать над собой человек, когда вступает в область, насыщенную празднословием и пошлостью."
                                            },
                                            {
                                                "example_id": "b37d6e63-0d2e-415b-848a-3a3e3ad62946",
                                                "sense_id": "c01c952c-e233-30e0-9504-db3bd63724c8",
                                                "text": "В один прекрасный вечер, при возвращении её из Сен-Дени в карете, на неё напали шесть всадников с намерением разбить об её лицо две бутылки с чернилами, насыщенными раствором купороса."
                                            },
                                            {
                                                "example_id": "522cdcfc-7d4a-47c4-855f-30d12af316f0",
                                                "sense_id": "c01c952c-e233-30e0-9504-db3bd63724c8",
                                                "text": "Неподвижный воздух был густо насыщен запахом сирени и черёмухи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
