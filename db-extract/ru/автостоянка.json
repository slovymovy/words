                ],
                "translations": [
                    {
                        "translation_id": "5044a690-c7e1-4c49-b868-a8d80d5ede41",
                        "source_entry_id": "20aa35eb-9863-3d30-9c38-bab5fcd665bc",
                        "source_sense_id": "e02f1f9b-d6ca-31dd-8778-4f9f80f0bbe2",
                        "target_lang_word": "parking lot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parking lot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55a38d7b-d317-3ce7-b646-bf4c0d6716fa",
                                        "entry_id": "1c9c1a4c-3b79-3323-b54a-4536ce11b181",
                                        "glosses": [
                                            "A parking area, generally paved and open-air (sometimes with limited overhead covering), where automobiles may be left when not in use."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Malaysia",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d79cda2d-762f-4d2b-9272-9b78200112e6",
                                                "sense_id": "55a38d7b-d317-3ce7-b646-bf4c0d6716fa",
                                                "text": "Meronyms: parking space, parking spot, parking place"
                                            },
                                            {
                                                "example_id": "3ca393a4-12ec-4864-92d6-ef9c47aa4bb1",
                                                "sense_id": "55a38d7b-d317-3ce7-b646-bf4c0d6716fa",
                                                "text": "Should we park in that parking lot, or in the garage up the street?"
                                            },
                                            {
                                                "example_id": "6e9136c4-d443-4f28-a1b1-087443dea8a2",
                                                "sense_id": "55a38d7b-d317-3ce7-b646-bf4c0d6716fa",
                                                "text": "They paved paradise and put up a parking lot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b0e858d-b1ed-3730-b3ed-f5ecc76de2d3",
                                        "entry_id": "1c9c1a4c-3b79-3323-b54a-4536ce11b181",
                                        "glosses": [
                                            "A road blocked by stop-start traffic."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "585d7d56-eeb8-4a17-b5d6-78528acb574f",
                                                "sense_id": "0b0e858d-b1ed-3730-b3ed-f5ecc76de2d3",
                                                "text": "The 101 was a parking lot again today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f1958f-301b-3754-b9b1-04c529401525",
                                        "entry_id": "1c9c1a4c-3b79-3323-b54a-4536ce11b181",
                                        "glosses": [
                                            "A holding area in which to set aside some question or concern for likely future consideration."
                                        ],
                                        "tags": [
                                            "especially",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "426cfcc5-c24f-406c-8840-be123e0551ec",
                                                "sense_id": "22f1958f-301b-3754-b9b1-04c529401525",
                                                "text": "Let's put this question in the parking lot for now, and we'll follow up on it later this week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c85e1af-e7f0-3fb9-a6d6-355850766595",
                                        "entry_id": "1c9c1a4c-3b79-3323-b54a-4536ce11b181",
                                        "glosses": [
                                            "A place in a state of complete destruction, especially one achieved through military means."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50415c8c-3eab-4359-ab56-7ab471d1c550",
                                                "sense_id": "4c85e1af-e7f0-3fb9-a6d6-355850766595",
                                                "text": "America believed it had smashed Israel’s greatest enemy and turned Iraq into a parking lot, so now Israel could take risks it had never been able to take before."
                                            },
                                            {
                                                "example_id": "649d2087-cf5f-4aa0-ad3e-83c61ff40c35",
                                                "sense_id": "4c85e1af-e7f0-3fb9-a6d6-355850766595",
                                                "text": "I was one of the people understanding the need to turn Afghanistan into a parking lot on the way to finding Bin Laden and bringing him to justice."
                                            },
                                            {
                                                "example_id": "0a3eed3c-4dc8-45ad-83f2-ab1619b15e2a",
                                                "sense_id": "4c85e1af-e7f0-3fb9-a6d6-355850766595",
                                                "text": "Eager for “round two,” a member of Israel’s regional council adjoining Gaza exhorted the military that next time they should “flatten Gaza into a parking lot, destroy them.”"
                                            },
                                            {
                                                "example_id": "cbf50301-5640-4f9f-964b-b2eab9b5542e",
                                                "sense_id": "4c85e1af-e7f0-3fb9-a6d6-355850766595",
                                                "text": "While the former called for end to the fighting in Gaza in his first Sunday address, Mr. Prevost said that after the Oct. 7, 2023, attacks on Israelis by members of Hamas, “I’d have flattened Gaza and made it a parking lot.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c45f9a88-7568-4c72-a60c-21a69e618617",
                        "source_entry_id": "20aa35eb-9863-3d30-9c38-bab5fcd665bc",
                        "source_sense_id": "e02f1f9b-d6ca-31dd-8778-4f9f80f0bbe2",
                        "target_lang_word": "car park",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "car park",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                        "entry_id": "82ccf45a-b21a-3b66-b6d0-4102f902d055",
                                        "glosses": [
                                            "An outdoor area or a building where cars may be parked."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Hong-Kong",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bb7bf6a-3eeb-475d-9fa1-b7743ca8caa7",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "It is important also that we improve car park security."
                                            },
                                            {
                                                "example_id": "c49dcd19-9948-4502-9d1f-374d5e1f2181",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "The dog lumbered his way across the car park to a point where he had to cross Emmons′s path."
                                            },
                                            {
                                                "example_id": "f7d689e0-3688-45b4-bbf2-01a3746e307c",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "Beyond the car park a rough old track ran uphill."
                                            },
                                            {
                                                "example_id": "30ffcb51-f182-47f7-9a6d-fa113aaf2b94",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "Follow the road to the car park and boat ramp at Buffalo Creek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968bda4f-5704-3d7a-80af-70ed95af0c5c",
                                        "entry_id": "82ccf45a-b21a-3b66-b6d0-4102f902d055",
                                        "glosses": [
                                            "An outdoor area or a building where cars may be parked.",
                                            "A rectangular section, usually marked by painted lines, designated for the parking of a single car."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Commonwealth",
                                            "Hong-Kong",
                                            "Ireland",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b72a8f4b-b8af-3599-9f29-40cd5d8135a0",
                                        "entry_id": "82ccf45a-b21a-3b66-b6d0-4102f902d055",
                                        "glosses": [
                                            "A road with serious traffic congestion preventing the movement of vehicles."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a51ba91-7c53-4405-9019-8621f28fbcef",
                        "source_entry_id": "20aa35eb-9863-3d30-9c38-bab5fcd665bc",
                        "source_sense_id": "e02f1f9b-d6ca-31dd-8778-4f9f80f0bbe2",
                        "target_lang_word": "Parkplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parkplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                        "entry_id": "fa6323c1-912d-3e9f-b86b-0150e6366c9b",
                                        "glosses": [
                                            "Fläche auf öffentlichem oder privatem Grund zum Abstellen von Fahrzeugen über die Dauer eines Haltevorgangs hinaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725cec3f-2b16-49b5-8fe4-069056c8c3e7",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "Fahren Sie auf den Parkplatz dort rechts!"
                                            },
                                            {
                                                "example_id": "00c97046-cc7d-4031-86dc-b8339a7942ee",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„Er bog auf den kleinen Parkplatz vor dem winzigen Rathaus ein.“"
                                            },
                                            {
                                                "example_id": "a512f957-e4aa-4cad-89f3-f55fcf64c584",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„Auf dem Parkplatz steht ihr Wagen nicht mehr allein.“"
                                            },
                                            {
                                                "example_id": "3b21eb49-7a98-4836-8af2-d449386ff9fa",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„Das von außen nicht gerade einladend wirkende Hotel ist in einem schwarz getünchten Flachbau neben dem Parkplatz des Flughafens zu finden.“"
                                            },
                                            {
                                                "example_id": "d203e7cd-28f5-4b0b-93ce-ad4ae629b773",
                                                "sense_id": "c1704aec-8663-3b99-ac46-b8ce142d220b",
                                                "text": "„In Teguise fand ich einen Parkplatz ganz in der Nähe des Marktes und setzte mich gleich ins erste Straßencafé; Rudi ließ ich allein zwischen den Marktständen schlendern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55303aee-820f-3dd9-bbce-aee100b88c31",
                                        "entry_id": "fa6323c1-912d-3e9f-b86b-0150e6366c9b",
                                        "glosses": [
                                            "Platz zum Parken von Fahrzeugen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "472a510b-45ab-4931-96b7-42217a7d16ce",
                                                "sense_id": "55303aee-820f-3dd9-bbce-aee100b88c31",
                                                "text": "Der Parkplatz in der Innenstadt ist sehr knapp geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be77c4b5-9154-3238-bf4b-cd251d4c20dc",
                                        "entry_id": "fa6323c1-912d-3e9f-b86b-0150e6366c9b",
                                        "glosses": [
                                            "individueller Stellplatz auf einem Parkplatz^([1]) oder in einem Parkhaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29911749-b0c8-4e9e-af6d-7900067fded8",
                                                "sense_id": "be77c4b5-9154-3238-bf4b-cd251d4c20dc",
                                                "text": "Auf dem Parkplatz, auf dem sie ihr Auto sonst meist abstellte, stand ein Motorrad."
                                            },
                                            {
                                                "example_id": "23ffc545-e52a-48e4-b85d-49e41d2d7f50",
                                                "sense_id": "be77c4b5-9154-3238-bf4b-cd251d4c20dc",
                                                "text": "„Zum ersten Mal seit Monaten hatte ich das Glück gehabt, einen Parkplatz am Straßenrand zu ergattern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b764c2bb-1e4d-40e1-9b60-688cc4e9d0bd",
                        "source_entry_id": "20aa35eb-9863-3d30-9c38-bab5fcd665bc",
                        "source_sense_id": "e02f1f9b-d6ca-31dd-8778-4f9f80f0bbe2",
                        "target_lang_word": "parking",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parking",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77fe2e02-ae07-3369-a1b3-ea439f15cdfa",
                                        "entry_id": "5e4c8fdc-5187-3b1b-8352-a28597ca040d",
                                        "glosses": [
                                            "Terrain ou aménagement destiné au stationnement des automobiles."
                                        ],
                                        "tags": [
                                            "Faux anglicisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95aed809-63e0-42e1-a647-3fd9e111e271",
                                                "sense_id": "77fe2e02-ae07-3369-a1b3-ea439f15cdfa",
                                                "text": "En arrivant sur la place, avec la ville dans le dos, il y a une dernière rangée de constructions, un peu disparates, des kiosques, des parkings, des manèges, des échoppes. — (Florence Aubenas, Le Quai de Ouistreham, Éditions de l’Olivier, 2010, pages 166-167)"
                                            },
                                            {
                                                "example_id": "731a020f-b98a-4b5f-ab2d-98a78dbd7a4b",
                                                "sense_id": "77fe2e02-ae07-3369-a1b3-ea439f15cdfa",
                                                "text": "Pôle d’échanges multimodal de la gare de Poitiers, accueillant une gare routière, un dépose-minute ainsi qu’un tout nouveau parking de 700 places."
                                            },
                                            {
                                                "example_id": "43319bf1-ede5-4020-bc78-d9d6557af0cb",
                                                "sense_id": "77fe2e02-ae07-3369-a1b3-ea439f15cdfa",
                                                "text": "Jamais plus de 100 personnes, seulement à certaines heures de la nuit, des parkings ultragérés, de la propreté, un tout petit son au milieu des bois, très bien placé pour éviter de gêner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "682d5b56-7b49-317b-9ba7-3c725826fca3",
                                        "entry_id": "5e4c8fdc-5187-3b1b-8352-a28597ca040d",
                                        "glosses": [
                                            "Espace de stationnement pour une automobile."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fcc3e91-c2e5-45b7-8d15-7ff10c932d52",
                                                "sense_id": "682d5b56-7b49-317b-9ba7-3c725826fca3",
                                                "text": "Les places de parking ne sont pas devenues trop petites, ce sont les voitures qui sont devenues trop grosses, juge leur fédération, qui ajoute que réviser la norme ne résoudra pas le problème des parkings existants, dont la plupart ont des places impossibles à modifier à cause des poteaux. (...) Les partisans d'un dépoussiérage des normes devront aussi convaincre les collectivités. \"Qui dit places de parking plus grosses, dit moins de places de parking, et il existe déjà de gros problèmes d'accès aux commerces des centres-villes”, pointe Jean-François Vigier, maire de Bures-sur-Yvette et vice-président de l'Association des maires de France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
