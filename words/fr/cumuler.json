            "senses": [
                {
                    "sense_id": "e38e0770-7f1d-358a-b2f6-8f1a882e062f",
                    "sense_definition": "Occuper plusieurs emplois, mandats ou fonctions simultanément, ou percevoir plusieurs rémunérations à la fois.",
