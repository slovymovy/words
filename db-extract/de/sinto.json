                        ],
                        "form": "die Sinti"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a99d5fb-ebc0-38a9-b2e7-a44cb1d6ff9c",
                        "entry_id": "3cc1bc38-8fac-3717-b864-b2b79b94f0f0",
                        "glosses": [
                            "Angehöriger einer Teilgruppe der europäischen Roma, die etwa seit Beginn des 15. Jahrhunderts im deutschsprachigen Raum lebt und ursprünglich über Südosteuropa aus dem indischen Subkontinent einwanderte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a2504b-e1dd-46ac-bce8-ce813b390bdf",
                                "sense_id": "2a99d5fb-ebc0-38a9-b2e7-a44cb1d6ff9c",
                                "text": "\"Sinti … bezeichnet mit einem Romanes-Wort die Angehörigen einer seit dem ausgehenden Mittelalter in Mitteleuropa beheimateten Teilminderheit der Roma.\""
                            },
                            {
                                "example_id": "1e03a649-7a15-456e-828b-9573ec88c786",
                                "sense_id": "2a99d5fb-ebc0-38a9-b2e7-a44cb1d6ff9c",
                                "text": "„Der Ordensgeistliche erfährt schnell von den immerwährenden Sorgen der Sinti und den scheinbar unausrottbaren Vorurteilen ihrer Umgebung.“"
                            },
                            {
                                "example_id": "db2b2269-82fe-4754-9620-742eca29e299",
                                "sense_id": "2a99d5fb-ebc0-38a9-b2e7-a44cb1d6ff9c",
                                "text": "„Deshalb geht sein Bericht über seine Zeit in Auschwitz und Buchenwald, über die Zwangsarbeit in Dora so zu Herzen. Daß die Diskriminierungen für einen Sinto auch nach der Befreiung und dem Ende der Diktatur nicht völlig vorbei waren, erahnt man am Ende von Rosenbergs Bericht.“"
                            },
                            {
                                "example_id": "2ef4dd90-664d-4934-acb7-d18622e16fc5",
                                "sense_id": "2a99d5fb-ebc0-38a9-b2e7-a44cb1d6ff9c",
                                "text": "„Und wenn eine Sintessa einen heiratete, der nicht Sinto wäre? Das würden diese Mütter dulden.“"
                            },
                            {
                                "example_id": "957cef8c-4ecd-4ff5-b964-d64925920ad7",
                                "sense_id": "2a99d5fb-ebc0-38a9-b2e7-a44cb1d6ff9c",
                                "text": "„Wer als Ausländer keinen Vermieter findet oder als Sinto, weil er ein Sinto ist, keinen Job bekommt, der ist unmittelbar von Fremdenfeindlichkeit betroffen, ohne dass ein Tropfen Blut geflossen ist, ohne blauen Fleck.“"
                            },
                            {
                                "example_id": "1f8fa866-53e5-4bb9-822a-f08019863d88",
                                "sense_id": "2a99d5fb-ebc0-38a9-b2e7-a44cb1d6ff9c",
                                "text": "„Der Sinto Hugo Höllenreiner überlebte die Todesfabrik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
