    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71547a8c-6558-3eee-bf22-004c651ef462",
                    "sense_definition": "Relating to the universe or cosmos, especially as distinct from the earth.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "universe_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists study <w>cosmic</w> dust to understand how stars form.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают <w>космическую</w> пыль, чтобы понять, как образуются звезды.",
                                "zh": "科学家研究<w>宇宙</w>尘埃以了解恒星是如何形成的。"
                            }
                        },
                        {
                            "text": "The telescope captures <w>cosmic</w> rays coming from deep space.",
                            "target_lang_translations": {
                                "ru": "Телескоп улавливает <w>космические</w> лучи, идущие из глубокого космоса.",
                                "zh": "望远镜捕捉到了来自深空的<w>宇宙</w>射线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "universal"
                    ],
                    "common_phrases": [
                        "cosmic rays",
                        "cosmic dust",
                        "cosmic radiation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к вселенной или космосу, особенно в отличие от Земли.",
                        "zh": "与宇宙或外太空有关的，尤指区别于地球的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "космический",
                                "target_lang_sense_clarification": "относящийся к космосу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宇宙的",
                                "target_lang_sense_clarification": "与宇宙相关的"
                            },
                            {
                                "target_lang_word": "太空的",
                                "target_lang_sense_clarification": "与外太空相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b08da6-0c71-31d4-9605-ceb2a4e0bf34",
                    "sense_definition": "Extremely vast, important, or significant; on a scale comparable to the universe.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "universe_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The failure of the project was a disaster of <w>cosmic</w> proportions.",
                            "target_lang_translations": {
                                "ru": "Провал проекта стал катастрофой <w>космического</w> масштаба.",
                                "zh": "该项目的失败是一场<w>巨大</w>的灾难。"
                            }
                        },
                        {
                            "text": "We must consider the <w>cosmic</w> scale of time when studying the history of the planet.",
                            "target_lang_translations": {
                                "ru": "Мы должны учитывать <w>космический</w> масштаб времени при изучении истории планеты.",
                                "zh": "在研究地球历史时，我们必须考虑<w>宏大</w>的时间尺度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cosmic proportions",
                        "cosmic scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно обширный, важный или значительный; сопоставимый по масштабам со вселенной.",
                        "zh": "极其巨大的、重要的或意义深远的；规模可与宇宙相比的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "космический",
                                "target_lang_sense_clarification": "огромный, колоссальный"
                            },
                            {
                                "target_lang_word": "вселенский",
                                "target_lang_sense_clarification": "глобальный, грандиозный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨大的",
                                "target_lang_sense_clarification": "形容规模极其宏大"
                            },
                            {
                                "target_lang_word": "宏大的",
                                "target_lang_sense_clarification": "形容意义深远或规模宏伟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac75c847-bbfa-372e-8e52-5eb71e9409ef",
                    "sense_definition": "Relating to abstract spiritual concepts or the metaphysical order of the universe.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a deep <w>cosmic</w> connection to nature while meditating.",
                            "target_lang_translations": {
                                "ru": "Во время медитации она почувствовала глубокую <w>космическую</w> связь с природой.",
                                "zh": "冥想时，她感到自己与自然之间存在一种深层的<w>宇宙</w>联系。"
                            }
                        },
                        {
                            "text": "The philosopher wrote about the <w>cosmic</w> consciousness that unites all living beings.",
                            "target_lang_translations": {
                                "ru": "Философ писал о <w>космическом</w> сознании, которое объединяет всех живых существ.",
                                "zh": "这位哲学家撰写了关于连接所有生物的<w>宇宙</w>意识的文章。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cosmic consciousness",
                        "cosmic energy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к абстрактным духовным понятиям или метафизическому порядку вселенной.",
                        "zh": "与抽象的精神概念或宇宙的形而上学秩序有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "космический",
                                "target_lang_sense_clarification": "духовный, метафизический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宇宙的",
                                "target_lang_sense_clarification": "指代精神或形而上学层面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a084085-11e2-3ca4-aabc-7a0677861480",
                    "sense_definition": "Rising or setting simultaneously with the sun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient astronomers recorded the <w>cosmic</w> rising of the star.",
                            "target_lang_translations": {
                                "ru": "Древние астрономы зафиксировали <w>космический</w> восход звезды.",
                                "zh": "古代天文学家记录了这颗恒星的<w>偕日</w>升起。"
                            }
                        },
                        {
                            "text": "This specific <w>cosmic</w> setting marks the beginning of the harvest season.",
                            "target_lang_translations": {
                                "ru": "Этот конкретный <w>космический</w> заход знаменует начало сезона сбора урожая.",
                                "zh": "这种特定的<w>偕日</w>落下标志着收获季节的开始。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восходящий или заходящий одновременно с солнцем.",
                        "zh": "指天体与太阳同时升起或落下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "космический",
                                "target_lang_sense_clarification": "астрономический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偕日",
                                "target_lang_sense_clarification": "天文学术语，指与太阳同时升落"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}