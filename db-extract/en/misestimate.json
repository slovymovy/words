                        "sense_id": "4533943e-7423-3289-bc9a-b5fdd06c7f3b",
                        "entry_id": "7f6c638f-d54d-3569-8be1-763bcc75ae62",
                        "glosses": [
                            "To estimate erroneously."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d827cd0f-2051-4c83-8c6d-e8e73f06bd08",
                                "sense_id": "4533943e-7423-3289-bc9a-b5fdd06c7f3b",
                                "text": "[W]e shall infallibly bestow a disproportionate attention upon those which our theory takes into account, while we mis-estimate the rest, and probably underrate their importance."
                            },
                            {
                                "example_id": "5a3f157f-9cd8-4af3-b0c6-350ae5981f4a",
                                "sense_id": "4533943e-7423-3289-bc9a-b5fdd06c7f3b",
                                "text": "However, in the absence of real data on actual language use in the aural-oral landscape, there will always exist the possibility to misestimate such impacts."
                            }
                        ]
                    }
                ],
