                ],
                "senses": [
                    {
                        "sense_id": "69c963c8-c2bd-3b65-bae5-f3f2fb202338",
                        "entry_id": "82d66884-ad70-3765-8ea3-4b033912d41f",
                        "glosses": [
                            "kleine Schneeflocke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68949c68-1076-47c0-ac03-ff160a6daf6a",
                                "sense_id": "69c963c8-c2bd-3b65-bae5-f3f2fb202338",
                                "text": "„Er strich sich über die Stirn und warf das wirre Haar zurück, in dem noch einige Schneeflöckchen hingen.“"
                            },
                            {
                                "example_id": "0ae0f702-251b-4d0a-9da4-542c31078994",
                                "sense_id": "69c963c8-c2bd-3b65-bae5-f3f2fb202338",
                                "text": "„Wenn aus stahlb[l]auem Himmel Schneeflöckchen wirbeln, ist Peking wie in Staubzucker gehüllt.“"
                            },
                            {
                                "example_id": "3b95eeb4-a77c-4984-b541-063d4b95d5a8",
                                "sense_id": "69c963c8-c2bd-3b65-bae5-f3f2fb202338",
                                "text": "„Erst schwebten nur ein paar einzelne Schneeflöckchen vom Himmel, doch schon wenige Minuten später wirbelten ihre dicken Freunde hinterher. Immer wilder und immer mehr.“"
                            },
                            {
                                "example_id": "d5742235-25d2-485f-a550-a8d534994b7e",
                                "sense_id": "69c963c8-c2bd-3b65-bae5-f3f2fb202338",
                                "text": "„Er sah auf die über dem Feuer herumflatternden Schneeflöckchen und dachte an den russischen Winter mit dem warmen, hellen Hause, dem flaumigen Pelz, dem schnellen Schlitten, dem gesunden Körper und mit all der Liebe und Sorge der Seinigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
