                                        "examples": [
                                            {
                                                "example_id": "8391f359-b8c0-4777-8bf7-555027ee0157",
                                                "sense_id": "6942c15b-6796-3327-85ad-ee880d5327ed",
                                                "text": "Die Nachforschung der Polizei ergab, dass Peter nicht zum Kreis der Verdächtigen zählt."
                                            },
                                            {
                                                "example_id": "4f657e7f-484f-4ed9-8d26-40ba5a8f3a93",
                                                "sense_id": "6942c15b-6796-3327-85ad-ee880d5327ed",
                                                "text": "„Da seine Nachforschungen ins Leere verliefen, mußte das Geld zurück nach Transsilvanien geschickt werden.“"
                                            },
                                            {
                                                "example_id": "5827a0d4-47bf-44e2-b00b-a0a60dc234b1",
                                                "sense_id": "6942c15b-6796-3327-85ad-ee880d5327ed",
                                                "text": "„Ich war verkatert, aber ich hatte ein paar Nachforschungen angestellt.“"
                                            },
                                            {
                                                "example_id": "c990f904-36b9-4282-b541-b50e39408ba7",
                                                "sense_id": "6942c15b-6796-3327-85ad-ee880d5327ed",
                                                "text": "„Alle Nachforschungen liefen ins Leere.“"
                                            },
                                            {
                                                "example_id": "2426ac2a-c29c-480c-b38c-63d08af8683f",
                                                "sense_id": "6942c15b-6796-3327-85ad-ee880d5327ed",
                                                "text": "„Das Ergebnis all dieser Nachforschungen ist dieses Buch.“"
                                            }
                                        ],
