    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "841ba621-e86c-315b-8f1d-7999e54ac893",
                    "sense_definition": "Relating to or belonging to people (the species Homo sapiens).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>human</w> body is made up of many different systems.",
                            "target_lang_translations": {
                                "ru": "<w>Человеческое</w> тело состоит из множества различных систем.",
                                "zh": "<w>人的</w>身体由许多不同的系统组成。"
                            }
                        },
                        {
                            "text": "We must work together to protect basic <w>human</w> rights.",
                            "target_lang_translations": {
                                "ru": "Мы должны работать вместе, чтобы защитить основные права <w>человека</w>.",
                                "zh": "我们必须共同努力，保护基本的<w>人的</w>权利。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nonhuman"
                    ],
                    "common_phrases": [
                        "human body",
                        "human rights",
                        "human race",
                        "human nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к людям или принадлежащий им (виду Homo sapiens).",
                        "zh": "与人或人类这种物种有关的；属于人的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человеческий",
                                "target_lang_sense_clarification": "относящийся к человеку"
                            },
                            {
                                "target_lang_word": "людской",
                                "target_lang_sense_clarification": "принадлежащий людям, свойственный людям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人的",
                                "target_lang_sense_clarification": "表示属于人、和人有关"
                            },
                            {
                                "target_lang_word": "人类的",
                                "target_lang_sense_clarification": "强调与人类这一物种有关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4bf6e67-28f3-3d95-b7fd-91dd6310ae47",
                    "sense_definition": "Having the typical qualities, feelings, or weaknesses of people, as opposed to being divine or perfect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is only <w>human</w> to make mistakes when you are tired.",
                            "target_lang_translations": {
                                "ru": "Совершать ошибки, когда устал, — это <w>свойственно человеку</w>.",
                                "zh": "累的时候犯错是<w>难免</w>的。"
                            }
                        },
                        {
                            "text": "The doctor showed a very <w>human</w> side when he comforted the crying child.",
                            "target_lang_translations": {
                                "ru": "Доктор проявил свою <w>человеческую</w> сторону, когда утешал плачущего ребенка.",
                                "zh": "医生安慰那个哭泣的孩子时，表现出了非常<w>有人性</w>的一面。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inhuman"
                    ],
                    "common_phrases": [
                        "human error",
                        "only human"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий типичными качествами, чувствами или слабостями людей, в отличие от божественного или совершенного.",
                        "zh": "具有人的典型品质、感情或弱点的，而不是神一般完美无缺的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человеческий",
                                "target_lang_sense_clarification": "свойственный человеку"
                            },
                            {
                                "target_lang_word": "свойственный человеку",
                                "target_lang_sense_clarification": "фраза: присущий людям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有人性",
                                "target_lang_sense_clarification": "指表现出人的感情、弱点或真实一面"
                            },
                            {
                                "target_lang_word": "难免",
                                "target_lang_sense_clarification": "指某种情况很符合人的常情，常用于“犯错、紧张、软弱”等"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae8a02c3-a08b-3373-967f-098bf1394c50",
                    "sense_definition": "A person; a member of the species Homo sapiens.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dogs have been best friends with <w>humans</w> for thousands of years.",
                            "target_lang_translations": {
                                "ru": "Собаки были лучшими друзьями <w>людей</w> на протяжении тысяч лет.",
                                "zh": "几千年来，狗一直是<w>人类</w>最好的朋友。"
                            }
                        },
                        {
                            "text": "Every <w>human</w> deserves to be treated with respect and dignity.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>человек</w> заслуживает уважения и достойного обращения.",
                                "zh": "每个<w>人</w>都应当受到尊重和有尊严的对待。"
                            }
                        }
                    ],
                    "synonyms": [
                        "human being",
                        "person",
                        "man"
                    ],
                    "antonyms": [
                        "nonhuman"
                    ],
                    "common_phrases": [
                        "modern humans",
                        "humans and animals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек; представитель вида Homo sapiens.",
                        "zh": "人；智人的一员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "единственное число"
                            },
                            {
                                "target_lang_word": "люди",
                                "target_lang_sense_clarification": "множественное число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人",
                                "target_lang_sense_clarification": "单数或泛指一个人时最常用"
                            },
                            {
                                "target_lang_word": "人类",
                                "target_lang_sense_clarification": "强调整个人类或作为物种的人类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ea8841b9-ebad-336f-8c46-5d84b7df3bcb",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Human</w> signed the guest book at the hotel reception.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хьюман</w> расписался в гостевой книге на стойке регистрации отеля.",
                                "zh": "<w>休曼</w>先生在酒店前台的来宾登记簿上签了名。"
                            }
                        },
                        {
                            "text": "We are looking for a record of a Sarah <w>Human</w> in the archives.",
                            "target_lang_translations": {
                                "ru": "Мы ищем запись о Саре <w>Хьюман</w> в архивах.",
                                "zh": "我们正在档案中查找一位名叫萨拉·<w>休曼</w>的人的记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хьюман",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "休曼",
                                "target_lang_sense_clarification": "作为姓氏的音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af8e9842-def6-3115-8bb2-ae1829bcdd90",
                    "sense_definition": "A fictional language spoken by humans, often used in fantasy or science fiction contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "The alien struggled to speak <w>Human</w> because the sounds were difficult for it.",
                            "target_lang_translations": {
                                "ru": "Инопланетянину было трудно говорить на <w>человеческом</w>, потому что звуки были для него сложны.",
                                "zh": "那个外星人很难说<w>人类语</w>，因为这些发音对它来说很难。"
                            }
                        },
                        {
                            "text": "In the story, the animals could understand <w>Human</w> but could not speak it back.",
                            "target_lang_translations": {
                                "ru": "В рассказе животные понимали <w>человеческую речь</w>, но не могли ответить.",
                                "zh": "在这个故事里，动物能听懂<w>人类语言</w>，却不会说。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "fictional context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленный язык, на котором говорят люди, часто используется в фэнтези или научной фантастике.",
                        "zh": "一种虚构的、由人类使用的语言，常见于奇幻或科幻语境中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человеческий язык",
                                "target_lang_sense_clarification": "название языка"
                            },
                            {
                                "target_lang_word": "всеобщий",
                                "target_lang_sense_clarification": "в контексте фэнтези (Common)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人类语",
                                "target_lang_sense_clarification": "奇幻、科幻作品中作为语言名称使用"
                            },
                            {
                                "target_lang_word": "人类语言",
                                "target_lang_sense_clarification": "较直白的说法，指人类所说的语言"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08b652dc-61d7-3090-b4bc-266c3f12c058",
                    "sense_definition": "To behave as a human or to become human.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character in the novel spends the entire story <w>humaning</w> his way through difficult social situations.",
                            "target_lang_translations": {
                                "ru": "Персонаж романа проводит всю историю, <w>проявляя человечность</w> в трудных социальных ситуациях.",
                                "zh": "小说中的这个角色在整个故事里都在艰难的社交处境中努力<w>像人一样行事</w>。"
                            }
                        },
                        {
                            "text": "After years of isolation, he found himself <w>humaning</w> again by reconnecting with old friends.",
                            "target_lang_translations": {
                                "ru": "После долгих лет изоляции он обнаружил, что снова <w>становится человеком</w>, восстанавливая связи со старыми друзьями.",
                                "zh": "与老朋友重新取得联系后，隔绝多年后的他发现自己又开始<w>变得像人</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humanize"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя как человек или становиться человеком.",
                        "zh": "像人一样行动，或逐渐变成人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очеловечиваться",
                                "target_lang_sense_clarification": "становиться человеком"
                            },
                            {
                                "target_lang_word": "вести себя по-человечески",
                                "target_lang_sense_clarification": "проявлять человеческие качества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像人一样行事",
                                "target_lang_sense_clarification": "指像人一样行动、处事"
                            },
                            {
                                "target_lang_word": "变得像人",
                                "target_lang_sense_clarification": "指逐渐成为人或恢复人的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}