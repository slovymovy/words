                        "source_sense_id": "f9a808ed-2402-307a-9127-d45ea7d40cf5",
                        "source_sense_description": "(informal) self-important, pompous; arrogant or egotistical",
                        "target_lang_word": "hoogdravend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoogdravend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                                        "entry_id": "120987e2-c7e8-36a0-886e-912ce63c437d",
                                        "glosses": [
                                            "te emotionele of plechtige manier van spreken of schrijven; vol bombast"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d09f258-5664-4c40-858d-5abedb2abd05",
                                                "sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                                                "text": "'We gaan Nederland veranderen' was een uitspraak die opviel: ik kreeg er veel positieve reacties op, maar ook het verwijt veel te hoogdravend te zijn. Een politicus die denkt Nederland te kunnen veranderen - is dat niet een beetje te veel van het goede? Nee, dat is het niet; het is precies wat ik ambieer."
                                            },
                                            {
                                                "example_id": "f360ea97-6657-41c8-bd94-c9e7b1e0da42",
                                                "sense_id": "b9707d93-ada3-3efb-8522-7a87eff6bbc6",
                                                "text": "Ik ben het helemaal met u eens, antwoordde Nikolaj met een hoogrode kleur, terwijl hij zijn bord ronddraaide en zijn glazen met een vastbesloten en onverschrokken gezicht verplaatste, alsof hij zich op dat moment in groot gevaar bevond, ik ben ervan overtuigd dat wij Russen moeten sterven of overwinnen, zei hij, en zodra hij die woorden had uitgesproken voelde hij, evenals de anderen, dat ze te hartstochtelijk en te hoogdravend waren voor de gelegenheid, en daarom niet op hun plaats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5526c7b-30a8-4abc-97fa-a95aebc8e02e",
                        "source_entry_id": "efbdcff6-3bf2-3ba7-95b3-bcecee3ae7fb",
                        "source_sense_id": "f9a808ed-2402-307a-9127-d45ea7d40cf5",
                        "source_sense_description": "(informal) self-important, pompous; arrogant or egotistical",
                        "target_lang_word": "arrogant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                                        "entry_id": "aa84377a-1e26-3719-a3d7-f80bd279ec96",
                                        "glosses": [
                                            "te veel met zichzelf ingenomen, verwaand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "451f7861-9cd1-4b0a-b5b1-af9610819675",
                                                "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                                                "text": "Heb jij mij verraden? Wat ben je toch een arrogante kwal!"
                                            },
                                            {
                                                "example_id": "91e03a61-5087-4731-ba4f-af18d4854341",
                                                "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                                                "text": "De arrogante leerling pronkte met zijn hoge cijfers."
                                            },
                                            {
                                                "example_id": "725b72e6-ae1f-4061-a867-52842039938c",
                                                "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                                                "text": "Maar vergis je niet, dit was geen utopisch paradijs. Er waren de nodige vervelende lui, die onbeschoft, arrogant of verwend waren en ik deed mijn best om ze te vermijden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
