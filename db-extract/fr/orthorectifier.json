                "senses": [
                    {
                        "sense_id": "d997baab-c13f-398c-8775-6229e67d3477",
                        "entry_id": "b9ad0da2-f445-3c85-96f6-73d389177855",
                        "glosses": [
                            "Traiter géométriquement (une photo aérienne) de façon à la rendre utilisable de la même façon qu’une carte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58409fea-264e-4cea-b53d-62ff891a20bb",
                                "sense_id": "d997baab-c13f-398c-8775-6229e67d3477",
                                "text": "Effectivement, orthorectifier une image sans modèle numérique de terrain (ou de surface, ou de façade), ça va être difficile."
                            },
                            {
                                "example_id": "befa5216-b58f-4d39-bf16-dd1973ff2b9c",
                                "sense_id": "d997baab-c13f-398c-8775-6229e67d3477",
                                "text": "Existerait-il un logiciel libre permettant d'orthorectifier (comme ER MAPPER, ERDAS, ENVI) des photo-aériennes préalablement numérisées et géoréférencées ?"
                            },
                            {
                                "example_id": "4e7d2d0d-629c-49b7-8650-7a5d175c21f2",
                                "sense_id": "d997baab-c13f-398c-8775-6229e67d3477",
                                "text": "Ce logiciel propose différentes méthodes pour orthorectifier une image."
                            }
                        ]
                    }
                ],
