    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57e00070-f7ac-30c6-ac97-4db5b71543eb",
                    "sense_definition": "A fast, lively folk dance, or the music played for it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musicians began to play a fast Irish <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "De muzikanten begonnen een snelle Ierse <w>jig</w> te spelen."
                            }
                        },
                        {
                            "text": "The wedding guests joined hands and danced a lively <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "De bruiloftsgasten gaven elkaar de hand en dansten een levendige <w>jig</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dance a jig"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een snelle, levendige volksdans, of de muziek die ervoor gespeeld wordt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "jig",
                                "target_lang_sense_clarification": "levendige volksdans of muziek"
                            },
                            {
                                "target_lang_word": "gigue",
                                "target_lang_sense_clarification": "dansvorm of muziekstuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c9b896f-39cd-3c4d-a380-083506b30c80",
                    "sense_definition": "A traditional dance performed by one or two solo dancers rather than a whole group.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The solo dancer showed great skill while performing the traditional <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "De solodanser toonde grote vaardigheid tijdens het uitvoeren van de traditionele <w>jig</w>."
                            }
                        },
                        {
                            "text": "She won first place at the festival for her solo <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "Ze won de eerste prijs op het festival voor haar <w>solojig</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een traditionele dans uitgevoerd door één of twee solodansers in plaats van een hele groep."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "solojig",
                                "target_lang_sense_clarification": "solodans"
                            },
                            {
                                "target_lang_word": "jig",
                                "target_lang_sense_clarification": "traditionele solodans"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c7b2044-2cb7-38b8-a10c-a96a7280d8cf",
                    "sense_definition": "A device or guide used in manufacturing or woodworking to hold work or guide a tool accurately.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He built a wooden <w>jig</w> to help make precise cuts with the saw.",
                            "target_lang_translations": {
                                "nl": "Hij bouwde een houten <w>mal</w> om precieze sneden te kunnen maken met de zaag."
                            }
                        },
                        {
                            "text": "Using a drilling <w>jig</w> ensures all the holes are placed identically.",
                            "target_lang_translations": {
                                "nl": "Het gebruik van een <w>boormal</w> zorgt ervoor dat alle gaten op identieke wijze worden geplaatst."
                            }
                        }
                    ],
                    "common_phrases": [
                        "woodworking jig"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een hulpmiddel of mal gebruikt bij fabricage of houtbewerking om een werkstuk vast te houden of gereedschap nauwkeurig te geleiden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "mal",
                                "target_lang_sense_clarification": "hulpstuk of geleider"
                            },
                            {
                                "target_lang_word": "boormal",
                                "target_lang_sense_clarification": "specifiek voor boren"
                            },
                            {
                                "target_lang_word": "kaliber",
                                "target_lang_sense_clarification": "technisch richt- of meetgereedschap"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c793d4-e711-344c-8669-d8568002421e",
                    "sense_definition": "A type of fishing lure with a weighted metal hook, often dressed with feathers or plastic.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attached a colorful <w>jig</w> to the end of his fishing line.",
                            "target_lang_translations": {
                                "nl": "Hij bevestigde een kleurrijke <w>jig</w> aan het uiteinde van zijn vislijn."
                            }
                        },
                        {
                            "text": "Deep-water fishing often requires using a heavy lead <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "Bij diepzeevissen moet men vaak een zware loden <w>jigkop</w> gebruiken."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een soort visaas met een verzwaarde haak, vaak voorzien van veertjes of plastic."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "jig",
                                "target_lang_sense_clarification": "kunstaas"
                            },
                            {
                                "target_lang_word": "jigkop",
                                "target_lang_sense_clarification": "verzwaarde haak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b29f48a-3a32-3a7a-b074-8e6ce065f586",
                    "sense_definition": "A light, brisk movement in classical instrumental music; a gigue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suite concludes with a brisk orchestral <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "De suite sluit af met een pittige orkestrale <w>gigue</w>."
                            }
                        },
                        {
                            "text": "The composer included an energetic <w>jig</w> in the final movement.",
                            "target_lang_translations": {
                                "nl": "De componist voegde een energieke <w>gigue</w> toe aan het slotdeel."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een licht, levendig deel in klassieke instrumentale muziek; een gigue."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gigue",
                                "target_lang_sense_clarification": "klassiek muziekdeel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b3f659c-d994-327e-adb2-debe1448fdd9",
                    "sense_definition": "An apparatus or sieve machine used in mining to separate minerals or ore in water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mineral processing plant installed a new mechanical <w>jig</w> to separate heavier particles.",
                            "target_lang_translations": {
                                "nl": "De mineraalverwerkingsfabriek installeerde een nieuwe mechanische <w>zetmachine</w> om zwaardere deeltjes te scheiden."
                            }
                        },
                        {
                            "text": "Dense minerals settled quickly at the bottom of the vibrating <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "Zware mineralen bezonken snel op de bodem van de trillende <w>zetmachine</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een toestel of zeefmachine gebruikt in de mijnbouw om mineralen of erts in water te scheiden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zetmachine",
                                "target_lang_sense_clarification": "mijnbouwzeef"
                            },
                            {
                                "target_lang_word": "waszeef",
                                "target_lang_sense_clarification": "scheidingszeef"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d288663-03a7-31f0-83d4-c10c2b35ee9d",
                    "sense_definition": "A clever trick, deceit, or playful prank.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ruse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police discovered their illegal scheme, so the <w>jig</w> was up.",
                            "target_lang_translations": {
                                "nl": "De politie ontdekte hun illegale plannen, dus het <w>spel</w> was uit."
                            }
                        },
                        {
                            "text": "Once their plan was exposed, they knew the clever <w>jig</w> was finished.",
                            "target_lang_translations": {
                                "nl": "Zodra hun plan aan het licht kwam, wisten ze dat de slimme <w>streek</w> voorbij was."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the jig is up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly surviving in the idiom 'the jig is up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een slimme list, bedrog of speelse poets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spel",
                                "target_lang_sense_clarification": "streek, list (als in 'het spel is uit')"
                            },
                            {
                                "target_lang_word": "streek",
                                "target_lang_sense_clarification": "list, poets"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "393a5a40-4744-3888-9aed-79716d791aea",
                    "sense_definition": "A short, lighthearted piece of comic verse or rhyming farce, popular in early theater.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Renaissance actors concluded their dramatic performance with an amusing rhyming <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "De renaissancetoneelspelers sloten hun dramatische voorstelling af met een amusante rijmende <w>klucht</w>."
                            }
                        },
                        {
                            "text": "Old playbills reveal that a satirical theatrical <w>jig</w> was performed after each play.",
                            "target_lang_translations": {
                                "nl": "Oude theateraffiches onthullen dat er na elk toneelstuk een satirische theatrale <w>klucht</w> werd opgevoerd."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kort, luchtig komisch vers of rijmende klucht, populair in het vroegere theater."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "klucht",
                                "target_lang_sense_clarification": "kort komisch theaterstuk"
                            },
                            {
                                "target_lang_word": "rijmklucht",
                                "target_lang_sense_clarification": "komisch versstuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6502deb7-732d-3921-b9c7-d8eee4d7c1d4",
                    "sense_definition": "A former phonetic clear-code word representing the letter J in communications.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "telecom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older radio procedures, the operator transmitted the letter J as <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "In oudere radioprocedures verzond de telefonist de letter J als <w>jig</w>."
                            }
                        },
                        {
                            "text": "The military communicator confirmed the call sign starting with <w>jig</w>.",
                            "target_lang_translations": {
                                "nl": "De militaire verbindingsman bevestigde de roepnaam beginnend met <w>jig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Juliett"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een voormalig spellingsalfabetwoord voor de letter J in telecommunicatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Jig",
                                "target_lang_sense_clarification": "naam voor letter J in ouder spellingsalfabet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "764605b4-429d-30aa-ae9c-d58918f97225",
                    "sense_definition": "To dance or bounce around energetically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children started to <w>jig</w> excitedly to the upbeat rhythm.",
                            "target_lang_translations": {
                                "nl": "De kinderen begonnen opgewonden te <w>huppelen</w> op het opgewekte ritme."
                            }
                        },
                        {
                            "text": "She could not help but <w>jig</w> along to the joyful music.",
                            "target_lang_translations": {
                                "nl": "Ze kon het niet laten om mee te <w>dansen</w> op de vrolijke muziek."
                            }
