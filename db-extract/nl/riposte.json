                                    {
                                        "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Réponse vive faite sur-le-champ, repartie prompte à quelque raillerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271b965f-dd8b-4957-858d-b5aa2cb61927",
                                                "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                                "text": "Avoir la riposte prête, la riposte en main."
                                            },
                                            {
                                                "example_id": "d8d5abaf-9d45-4378-b299-418f75278f8c",
                                                "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                                "text": "Être prompt, être vif à la riposte."
                                            },
                                            {
                                                "example_id": "676b5cf5-aa32-4fb8-a0ea-26884d1c6d49",
                                                "sense_id": "cb3fcc4b-2417-3e76-9713-392fb4b67208",
                                                "text": "Gare à la riposte!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9cd3ba2-2fd2-3f00-81ff-e2351ce68a05",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Ce qui se fait sur-le-champ en réponse à une injure, à un coup, à un acte quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fa5d12f-5505-4f16-ab13-be88d1fbca91",
                                                "sense_id": "f9cd3ba2-2fd2-3f00-81ff-e2351ce68a05",
                                                "text": "Il lui donna un démenti ; la riposte fut un soufflet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414ac599-cf2c-337b-8e2b-3ca72d02cb92",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Action de défense par l'attaque."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "914eeedb-636a-4b82-990b-3c21b6e6d47e",
                                                "sense_id": "414ac599-cf2c-337b-8e2b-3ca72d02cb92",
                                                "text": "Mais tous les membres de la coalition des forces antihitlériennes du pays étaient d’accord à ce qu’une ferme riposte soit donnée à tout essai des troupes allemandes d’empêcher la Roumanie de sortir de la guerre hitlérienne."
                                            },
                                            {
                                                "example_id": "b7a2917e-8813-4a24-88ca-0a25de55b6a9",
                                                "sense_id": "414ac599-cf2c-337b-8e2b-3ca72d02cb92",
                                                "text": "Mais, ajoutent-ils, elle ne suffit plus pour assurer aux progressistes les instruments d'une riposte efficace à la reféodalisation du capitalisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd16bb6b-39de-3d06-9e06-79cd49343777",
                                        "entry_id": "90856f7c-5b32-3d5c-852c-3a140dd3fd75",
                                        "glosses": [
                                            "Botte que l’on porte après avoir paré."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
