        "fr-extract.jsonl": [
            {
                "entry_id": "e88c3c83-f235-3197-8465-9f6c93eb86cd",
                "word": "pus",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e7e13de-eba8-44b2-8afd-37b6e6958da3",
                        "entry_id": "e88c3c83-f235-3197-8465-9f6c93eb86cd",
                        "tags": [],
                        "form": "pu"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce4688c3-7018-3b8b-91d8-c2933fa81dfa",
                        "entry_id": "e88c3c83-f235-3197-8465-9f6c93eb86cd",
                        "glosses": [
                            "Déformation de l’adverbe plus."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6a700a85-68e9-475a-8459-0d9d158eaadf",
                                "sense_id": "ce4688c3-7018-3b8b-91d8-c2933fa81dfa",
                                "text": "Je comprenais pus rien. … ma vie ne serait pus jamais pareille. Le monde ne parlais plus de ma musique."
                            },
                            {
                                "example_id": "a45e519f-595b-465d-9f7f-00c776820cda",
                                "sense_id": "ce4688c3-7018-3b8b-91d8-c2933fa81dfa",
                                "text": "Et moi, est-ce que ch'uis toi ? Ch'ais pus si ch'uis moi ou si ch'uis toi. Dis, tu peux m'dire si ch'uis toi ? Tu peux m'dire si ti'es moi ? P't-ête ch'uis toi ? P't-ête ch'uis pas moi ? P't-ête ch'uis moi ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8cd559f1-918e-3170-89c0-964bb2db3deb",
                "word": "pus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac466be3-63ee-308c-9c78-6f9b33718b4f",
                        "entry_id": "8cd559f1-918e-3170-89c0-964bb2db3deb",
                        "glosses": [
                            "Matière liquide, épaisse, blanchâtre, qui se forme dans les abcès, qui sort des plaies et des ulcères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f120467-82d8-40cf-b992-1249a9fbc302",
                                "sense_id": "ac466be3-63ee-308c-9c78-6f9b33718b4f",
                                "text": "Mais outre ces leucocytes, il y a dans le pus sécrété par les plaies un bactérien qui possède aussi la propriété de provoquer la formation du pus en plus grande quantité, quand il est introduit dans les tissus vivants ; […]."
                            },
                            {
                                "example_id": "83711a0e-6f20-48a2-a727-5cc1b8fe57a0",
                                "sense_id": "ac466be3-63ee-308c-9c78-6f9b33718b4f",
                                "text": "Le cryptocoque est cultivable à 38°, en ensemençant, avec du pus aseptique d’abcès, de la gélose au crottin de cheval recouverte d’une macération de ganglions du même animal : […]."
                            },
                            {
                                "example_id": "8c34147c-3fc7-491c-8271-5461d99c9bde",
                                "sense_id": "ac466be3-63ee-308c-9c78-6f9b33718b4f",
                                "text": "Le pus présent dans les lésions d’actinobacillose est un pus blanc laiteux, inodore, visqueux, renfermant des grains parfois difficiles à observer. L’écrasement du pus entre lame et lamelle permet de mieux visualiser les grains […]."
                            },
                            {
                                "example_id": "3a88244b-c1b3-465f-ba97-6817c2bc9e69",
                                "sense_id": "ac466be3-63ee-308c-9c78-6f9b33718b4f",
                                "text": "Et c’était bien elle, la mort, l’horrible chenille qui, Ouroz le sentait, décomposait sa chair, effritait ses os et changeait le beau sang rouge en pus infect."
                            },
                            {
                                "example_id": "e5adc03f-38ad-46e0-b03e-e08ad8a5228e",
                                "sense_id": "ac466be3-63ee-308c-9c78-6f9b33718b4f",
                                "text": "— Au loin, il y avait de ces champignons qui érigent un gland glueux de pus verdâtre ou qui s’affaissent, flasques, comme des éponges pourries aux puanteurs de charognes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6adea9e4-46c6-466a-8c5e-2754fd6c6160",
                        "source_entry_id": "8cd559f1-918e-3170-89c0-964bb2db3deb",
                        "source_sense_id": "ac466be3-63ee-308c-9c78-6f9b33718b4f",
                        "source_sense_description": "Matière liquide qui se forme dans les abcès",
                        "target_lang_word": "Eiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f70a1d87-9be3-3908-b17a-8941a2ae0fc8",
                                        "entry_id": "b8e830d8-0b16-3977-a262-bf5b0b46dbe6",
                                        "glosses": [
                                            "weiß-gelbliche Körperflüssigkeit, die sich bei Entzündungen bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bcdc11b-314c-43f1-b8dd-7f42ff031262",
                                                "sense_id": "f70a1d87-9be3-3908-b17a-8941a2ae0fc8",
                                                "text": "Die Produktion von Eiter schützt den Körper vor negativen Folgen von Entzündungen."
                                            },
                                            {
                                                "example_id": "fd966367-a773-4b84-af05-4fcb7bb5fa1b",
                                                "sense_id": "f70a1d87-9be3-3908-b17a-8941a2ae0fc8",
                                                "text": "„Es roch draußen nach Bohnerwachs und Eiter.“"
                                            },
                                            {
                                                "example_id": "18082efc-00c8-4079-b5ff-5734f2439b7d",
                                                "sense_id": "f70a1d87-9be3-3908-b17a-8941a2ae0fc8",
                                                "text": "„Der Eiter lief aus, ohne daß sich eine Entzündung gebildet hätte, auch das Fieber blieb konstant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
