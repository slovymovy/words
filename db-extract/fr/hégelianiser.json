                ],
                "senses": [
                    {
                        "sense_id": "ed3402df-52a2-3751-8b36-f89f4ac8e75b",
                        "entry_id": "c5823706-a7f0-3e49-af2e-f3529c517708",
                        "glosses": [
                            "Donner un caractère hégelien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f0a6ce-ccaf-4d5e-8924-2d333734e2ad",
                                "sense_id": "ed3402df-52a2-3751-8b36-f89f4ac8e75b",
                                "text": "C’est la rupture avec toutes les versions hégelianisées du marxisme au profit d’une interprétation qui s’accommode en fin de compte plus facilement de l’orthodoxie du Parti."
                            },
                            {
                                "example_id": "b57a42f9-5da5-4bc5-ae15-bcf4e31e711e",
                                "sense_id": "ed3402df-52a2-3751-8b36-f89f4ac8e75b",
                                "text": "À cet égard, je ne peux que rappeler en un mot le projet poursuivi par Joseph Margolis de hégelianiser Darwin et de darwiniser Hegel."
                            },
                            {
                                "example_id": "48053f21-6c38-403c-bb5e-53df6a9a5e44",
                                "sense_id": "ed3402df-52a2-3751-8b36-f89f4ac8e75b",
                                "text": "Le marxisme « hégelianisé » ne semble pas sans rapport avec la domination réelle caractérisée par l’accumulation intensive."
                            }
                        ]
                    },
                    {
                        "sense_id": "320073a5-6ea8-3d84-b42e-f55e550ed299",
                        "entry_id": "c5823706-a7f0-3e49-af2e-f3529c517708",
                        "glosses": [
                            "Raisonner à la manière de Hegel."
                        ],
                        "tags": [],
                        "examples": []
                    }
