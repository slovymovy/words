                            },
                            {
                                "target_word": "intriguing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "503821c0-01f5-32ee-b03c-36bd908c3674",
                                        "entry_id": "2e3991a0-ffd7-3058-9567-1cc83a414c4c",
                                        "glosses": [
                                            "An intrigue."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02e19f3a-37d2-4376-95c6-a341489288e3",
                                                "sense_id": "503821c0-01f5-32ee-b03c-36bd908c3674",
                                                "text": "In all these negotiations, and caballings, and intriguings, the person most concerned, Frances Coke, the beauty and the heiress, was only the ball in the game."
                                            }
                                        ]
                                    }
                                ]
                            }
