    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "71dd8bc0-dfd7-3e5b-9fa8-f81435420193",
                    "sense_definition": "met het doel om; wordt gevolgd door een infinitief met te",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "doelstelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De minister nam extra maatregelen <w>teneinde</w> de economische crisis te bezweren.",
                            "target_lang_translations": {
                                "en": "The minister took extra measures <w>in order to</w> avert the economic crisis."
                            }
                        },
                        {
                            "text": "Men dient dit formulier volledig in te vullen <w>teneinde</w> een vergunning te verkrijgen.",
                            "target_lang_translations": {
                                "en": "One must fill out this form completely <w>so as to</w> obtain a permit."
                            }
                        }
                    ],
                    "synonyms": [
                        "om"
                    ],
                    "common_phrases": [
                        "teneinde te bereiken",
                        "teneinde te voorkomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formeel en ambtelijk taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "with the purpose of; followed by an infinitive with 'to'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in order to",
                                "target_lang_sense_clarification": "formal way to express purpose"
                            },
                            {
                                "target_lang_word": "so as to",
                                "target_lang_sense_clarification": "formal way to express purpose"
                            },
                            {
                                "target_lang_word": "with a view to",
                                "target_lang_sense_clarification": "very formal, often used in legal or official contexts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e083be5-6a68-3681-b62a-560167f57b7b",
                    "sense_definition": "met het doel dat; wordt gebruikt om een bijzin van doel in te leiden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "doelstelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wet werd aangepast <w>teneinde</w> de veiligheid van de burgers beter gewaarborgd zou zijn.",
                            "target_lang_translations": {
                                "en": "The law was amended <w>so that</w> the safety of citizens would be better guaranteed."
                            }
                        },
                        {
                            "text": "Hij sprak luid en duidelijk <w>teneinde</w> iedereen in de zaal hem goed kon verstaan.",
                            "target_lang_translations": {
                                "en": "He spoke loudly and clearly <w>in order that</w> everyone in the hall could hear him well."
                            }
                        }
                    ],
                    "synonyms": [
                        "opdat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "zeer formeel en enigszins verouderd in deze constructie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "with the goal that; used to introduce a subordinate clause of purpose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so that",
                                "target_lang_sense_clarification": "introducing a clause of purpose"
                            },
                            {
                                "target_lang_word": "in order that",
                                "target_lang_sense_clarification": "very formal way to introduce a clause of purpose"
                            }
                        ]
                    }
                }
            ]
        }
    ]
