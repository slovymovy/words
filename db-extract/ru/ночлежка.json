                "senses": [
                    {
                        "sense_id": "087cedcf-f32c-3c82-a30f-14d8161e3516",
                        "entry_id": "934d8177-50a5-33ab-a3a7-83350a6341aa",
                        "glosses": [
                            "doss-house, doss, flophouse (sleeping-place for the homeless)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e58bc2-814a-4348-95ab-456a25dc6ec9",
                                "sense_id": "087cedcf-f32c-3c82-a30f-14d8161e3516",
                                "text": "Са́мый дом необита́ем, но в э́том зда́нии, ра́ньше ку́знице, тепе́рь помеща́лась «ночле́жка», содержи́мая ро́тмистром в отста́вке Аристи́дом Фомичо́м Кува́лдой.",
                                "translation": "The house itself was of course unoccupied, but this shed, formerly a blacksmith's forge, was now turned into a \"dosshouse,\" kept by a retired Captain named Aristid Fomich Kuvalda.",
                                "english": "The house itself was of course unoccupied, but this shed, formerly a blacksmith's forge, was now turned into a \"dosshouse,\" kept by a retired Captain named Aristid Fomich Kuvalda."
                            },
                            {
                                "example_id": "447f714b-5eb3-4ee2-a6b9-7a385decb4f6",
                                "sense_id": "087cedcf-f32c-3c82-a30f-14d8161e3516",
                                "text": "Вре́мя дви́жется наза́д.\nХо́лодно в ночле́жке.\nЯ смотрю́ в твои́ глаза́,\nВ них одна́ насме́шка.",
                                "translation": "Hadn Dadn",
                                "english": "Hadn Dadn"
                            }
                        ]
                    }
                ],
