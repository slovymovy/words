                        "glosses": [
                            "Jeune qui travaille dans les houillères du Hainaut."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "3e98511c-1bee-4f52-b9bf-04cfcc7837ee",
                                "sense_id": "64f81ea9-8809-3a60-8246-7a9880ab455b",
                                "text": "Les enfants ou jambots, qui commencent à descendre vers l’âge de dix à onze ans dans la mine."
                            },
                            {
                                "example_id": "2e8e219f-3b7a-468e-85b7-e3dec10e45d7",
                                "sense_id": "64f81ea9-8809-3a60-8246-7a9880ab455b",
                                "text": "Jambots de crachets, ceux qui entretiennent les lampes dans les galeries."
                            },
                            {
                                "example_id": "ce77c346-824a-44e0-97fc-2066eae873e5",
                                "sense_id": "64f81ea9-8809-3a60-8246-7a9880ab455b",
                                "text": "Les autres travaillent, le jour, depuis trois et quatre heures du matin, jusqu’à trois et six heures du soir : ce sont les ouvriers à la taille, les chargeurs à la taille et leurs jambots."
                            }
                        ]
