                    }
                ],
                "senses": [
                    {
                        "sense_id": "66bb27d6-d862-3b01-b2fb-21407589d9ff",
                        "entry_id": "5fe41f29-7008-3e2d-8242-f50f927e3b63",
                        "glosses": [
                            "Membre d’un peuple du Xinjiang, en Chine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c862aa-970d-4ce3-9a4a-3781a0cd8bfa",
                                "sense_id": "66bb27d6-d862-3b01-b2fb-21407589d9ff",
                                "text": "Douze millions de Ouïgours, un peuple turcophone à majorité musulmane, vivent au Xinjiang. Depuis l’accession au pouvoir de Mao Zedong en 1949, les Ouïgours vivent sous la domination chinoise. Depuis plus de 20 ans, ils subissent une véritable répression de la part des autorités chinoises. Plusieurs centaines de milliers de Ouïgours sont enfermés de manière arbitraire dans des camps de détention."
                            },
                            {
                                "example_id": "eb73a340-1724-4d6b-ad96-ce415adce604",
                                "sense_id": "66bb27d6-d862-3b01-b2fb-21407589d9ff",
                                "text": "Plus tard dans la soirée, Washington a exigé que Pékin rende des comptes sur le « génocide » des Ouïgours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64a9d45f-cbd1-4f95-a987-63b5d6f4c8a7",
                        "source_entry_id": "5fe41f29-7008-3e2d-8242-f50f927e3b63",
                        "source_sense_id": "66bb27d6-d862-3b01-b2fb-21407589d9ff",
                        "target_lang_word": "Uigure",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uigure",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60d9b51c-64a5-3918-beab-ad90932c1201",
                                        "entry_id": "b04772ed-eb8b-313c-b5ab-aa8e18c3b7c8",
                                        "glosses": [
                                            "Angehöriger einer turksprachigen Ethnie, die in dem autonomen Gebiet Xinjiang im Nordwesten der Volksrepublik China lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e26aff5c-1d7d-4759-a6ce-9b3d7d59292a",
                                                "sense_id": "60d9b51c-64a5-3918-beab-ad90932c1201",
                                                "text": "Uiguren werden in China unterdrückt."
                                            },
                                            {
                                                "example_id": "059c6639-9a29-4317-8b30-4dcc0650e1d4",
                                                "sense_id": "60d9b51c-64a5-3918-beab-ad90932c1201",
                                                "text": "„In der Region kommt es immer wieder zu blutigen Konflikten zwischen der Zentralmacht und muslimischen Uiguren.“"
                                            },
                                            {
                                                "example_id": "13d5c2d7-2764-43d5-a589-0809df2a2610",
                                                "sense_id": "60d9b51c-64a5-3918-beab-ad90932c1201",
                                                "text": "Der Technologie-Konzern Huawei testet offenbar eine Software, mit der Uiguren erkannt werden können - Angehörige einer in China unterdrückten Minderheit."
                                            },
                                            {
                                                "example_id": "a0f82685-3a3b-4539-8542-2a0fac676029",
                                                "sense_id": "60d9b51c-64a5-3918-beab-ad90932c1201",
                                                "text": "Die Außenminister der 27 Mitgliedstaaten beschlossen in Brüssel Strafmaßnahmen gegen Verantwortliche für die Unterdrückung der muslimischen Minderheit der Uiguren in der Region Xinjiang."
                                            },
                                            {
                                                "example_id": "91d0b380-4690-4fec-aa72-0d2ff25f21cc",
                                                "sense_id": "60d9b51c-64a5-3918-beab-ad90932c1201",
                                                "text": "Mitgliedstaaten beschlossen in Brüssel Strafmaßnahmen gegen Verantwortliche für die Unterdrückung der muslimischen Minderheit der Uiguren in der Region Xinjiang."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
