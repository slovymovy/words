                ],
                "senses": [
                    {
                        "sense_id": "ab89172d-ad2d-3306-8680-29ecce70c600",
                        "entry_id": "ffa9f5ee-b2eb-3e1d-ac26-dc2bb44c6665",
                        "glosses": [
                            "Ausgang eines Gebäudes, der im Notfall benutzt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f3e5cc-221c-4353-b747-f98a01349413",
                                "sense_id": "ab89172d-ad2d-3306-8680-29ecce70c600",
                                "text": "Der Notausgang ermöglicht im Brandfall das schnelle Verlassen eines Gebäudes."
                            },
                            {
                                "example_id": "311e8c20-232f-43fb-9aa4-e5fd11ede52d",
                                "sense_id": "ab89172d-ad2d-3306-8680-29ecce70c600",
                                "text": "„Hinter einem Vorhang befand sich eine Kochnische, gleich neben dem Notausgang, der in den Hinterhof führte, wo übrigens ein Klosett war.“"
                            },
                            {
                                "example_id": "6057abd5-ad9c-4bdb-9c2a-26b40296705a",
                                "sense_id": "ab89172d-ad2d-3306-8680-29ecce70c600",
                                "text": "„Wir schlafen tief und fest; der Notausgang würde wahrscheinlich nichts nützen, denn kein noch so drohendes Türeschlagen, Stiefelpoltern oder Waffengeklirr könnte uns jetzt wecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e63257b1-0696-4fab-97a8-e9857e004b88",
                        "source_entry_id": "ffa9f5ee-b2eb-3e1d-ac26-dc2bb44c6665",
                        "source_sense_id": "ab89172d-ad2d-3306-8680-29ecce70c600",
                        "source_sense_description": "Ausgang eines Gebäudes, der im Notfall benutzt werden soll",
                        "target_lang_word": "emergency exit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emergency exit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "172eba47-838d-3bc6-843a-beb8b7c3a812",
                                        "entry_id": "305efe15-999c-363d-9cec-6596584fd1a7",
                                        "glosses": [
                                            "An exit that is designed to allow rapid evacuation in the case of emergencies such as a fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f74cb9d-9e9e-45ae-9a39-f5f9fbea6761",
                                                "sense_id": "172eba47-838d-3bc6-843a-beb8b7c3a812",
                                                "text": "As well as their obvious novelty value, the Class 313s offered fast acceleration, those power-operated sliding doors, non-opening passenger windows, closed ventilators to prevent any body part, head or limbs reaching out, drivers' and guards' doors opening inwards, and end doors for emergency exit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d3ff742-3072-476f-a47a-fe77e3bd17da",
                        "source_entry_id": "ffa9f5ee-b2eb-3e1d-ac26-dc2bb44c6665",
                        "source_sense_id": "ab89172d-ad2d-3306-8680-29ecce70c600",
                        "source_sense_description": "Ausgang eines Gebäudes, der im Notfall benutzt werden soll",
                        "target_lang_word": "fire escape",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fire escape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40695917-e342-38f4-aed6-3cd74ac7d312",
                                        "entry_id": "34a44959-5c11-3ad5-8013-2c11e76fa462",
                                        "glosses": [
                                            "Any of the series of emergency doors, ladders, or stairs used to evacuate a building if a fire breaks out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b879193-7fdf-4c77-96a9-01da1ea14bef",
                                                "sense_id": "40695917-e342-38f4-aed6-3cd74ac7d312",
                                                "text": "Eight ladies with Ugandan associations had ascended the fire escape and were making their way through his room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42762d96-1ee2-3b32-9f1b-f1a9c3bc3c55",
                                        "entry_id": "34a44959-5c11-3ad5-8013-2c11e76fa462",
                                        "glosses": [
                                            "The entire escape route viewed as a whole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d9569d2-63b7-3c26-8d30-d5384f37add6",
                                        "entry_id": "34a44959-5c11-3ad5-8013-2c11e76fa462",
                                        "glosses": [
                                            "Any apparatus designed to allow people to escape a burning building, such as a canvas tube for sliding down."
                                        ],
