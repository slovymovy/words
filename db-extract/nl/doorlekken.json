                        "examples": []
                    },
                    {
                        "sense_id": "2fb136a2-570e-31a2-b85e-5e834a055064",
                        "entry_id": "72b6d37f-fa53-34ed-a107-de6b2e39bd02",
                        "glosses": [
                            "to menstruate through clothes (despite the presence of menstrual pads and tampons)"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e26bea8f-9f84-4798-ad1b-12093fcb6bdc",
                                "sense_id": "2fb136a2-570e-31a2-b85e-5e834a055064",
                                "text": "Ze was tijdens de werkdag doorgelekt, dus wisselde ze van kleren.",
                                "translation": "Her menstrual blood leaked through her clothes during the workday, so she changed clothes.",
                                "english": "Her menstrual blood leaked through her clothes during the workday, so she changed clothes."
                            }
                        ]
                    }
