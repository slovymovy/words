                    {
                        "sense_id": "6ea38a00-9ed5-3279-8907-aad901886f55",
                        "entry_id": "d1c83756-5542-3c99-accd-a53423b7c444",
                        "glosses": [
                            "Funding by many individuals pooling their money together for a common goal, usually via the Internet."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "535df4ca-8a34-4c69-8285-9008ebd55d98",
                                "sense_id": "6ea38a00-9ed5-3279-8907-aad901886f55",
                                "text": "It was discovered in September 2020 that Cosgrove was raising money on the “Christian crowdfunding site” GiveSendGo to fund his retirement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b624a7c4-6b53-4525-8425-43d7ace517f2",
                        "source_entry_id": "d1c83756-5542-3c99-accd-a53423b7c444",
                        "source_sense_id": "6ea38a00-9ed5-3279-8907-aad901886f55",
                        "source_sense_description": "pooling of money for a common goal",
