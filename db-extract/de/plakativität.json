                "senses": [
                    {
                        "sense_id": "c36eab33-bb92-3359-ac28-5b9ea2b66ad2",
                        "entry_id": "14605d28-eb58-385a-8698-b447def33b6b",
                        "glosses": [
                            "Eigenschaft, eine prägnante, knappe, leicht zu begreifende (plakative) Form der Darstellung zu besitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afac42b6-cd1b-4e14-80e9-e550087a6916",
                                "sense_id": "c36eab33-bb92-3359-ac28-5b9ea2b66ad2",
                                "text": "„Beispielhaft für die Plakativität der Ich-Figur ist die Schilderung des Alltages des zunächst Langzeitarbeitslosen: Sein im Grunde trostloses, isoliertes Dasein wird durchweg komisch pointiert dargestellt.“"
                            },
                            {
                                "example_id": "2e8859bd-bfcb-4014-80cf-4c9900ef255d",
                                "sense_id": "c36eab33-bb92-3359-ac28-5b9ea2b66ad2",
                                "text": "„Die Weltmeister der Plakativität sind übrigens die Brasilianer. Und wissen Sie warum? Aus einem Mangel: Jeder fünfte Brasilianer ist Analphabet.“"
                            },
                            {
                                "example_id": "84a55a49-4d6a-438c-80a9-36f14ea32b88",
                                "sense_id": "c36eab33-bb92-3359-ac28-5b9ea2b66ad2",
                                "text": "„Den Vollzug der Synthese dieser Antagonismen visualisiert Vertov in seltener Plakativität.“"
                            },
                            {
                                "example_id": "189205c0-5627-45d3-991e-975c238f32dc",
                                "sense_id": "c36eab33-bb92-3359-ac28-5b9ea2b66ad2",
                                "text": "„Der Versuch einer Begriffsbestimmung und Eingrenzung der Vielzahl unternehmerischer Qualifikationen erscheint nur bedingt sinnvoll, da nach Auffassung des Autors die Gefahr der Plakativität und einer damit verbundenen fehlenden Tiefe besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
