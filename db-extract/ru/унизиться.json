                "senses": [
                    {
                        "sense_id": "a0fd68fc-2b6f-3ec6-ad7c-72622cee309d",
                        "entry_id": "fc65a8e4-af39-3932-a463-9d7002f2ca98",
                        "glosses": [
                            "поставить себя в унизительное, жалкое положение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "657047c2-6f7e-49e8-8766-83e60267d86b",
                                "sense_id": "a0fd68fc-2b6f-3ec6-ad7c-72622cee309d",
                                "text": "Благородные стыдились ходить пешком и не имели знакомства с мещанами, опасаясь тем унизиться."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3283e5e-7963-3aff-8389-2ac45fc296aa",
                        "entry_id": "fc65a8e4-af39-3932-a463-9d7002f2ca98",
                        "glosses": [
                            "умалить своё достоинство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87dd750b-3dbf-4f55-b0c1-720fa6f77aaf",
                                "sense_id": "a3283e5e-7963-3aff-8389-2ac45fc296aa",
                                "text": "Я не унижусь пред тобою; // Ни твой привет, ни твой укор // Не властны над моей душою."
                            }
                        ]
                    }
