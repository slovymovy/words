                "senses": [
                    {
                        "sense_id": "21d86e70-8ccf-3452-8a44-12a664016f1d",
                        "entry_id": "3fcc997e-34aa-36cb-8752-82b1aa3bd46f",
                        "glosses": [
                            "(meist mündliche) Information, dass eine Person aufgrund einer Erkrankung nicht zur Arbeit/Schule erscheint ( schriftliche Krankschreibung vom Arzt)"
                        ],
                        "tags": [
                            "Arbeitsverhältnis",
                            "Schulgang",
                            "auch umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "2d385ac0-8c3a-47c7-ab25-d9650cec514f",
                                "sense_id": "21d86e70-8ccf-3452-8a44-12a664016f1d",
                                "text": "Die Krankmeldung beim Arbeitgeber ist unverzüglich vorzunehmen."
                            },
                            {
                                "example_id": "823ced50-fc6c-4f73-ae29-5381a11547dd",
                                "sense_id": "21d86e70-8ccf-3452-8a44-12a664016f1d",
                                "text": "„Akuter Brech-Durchfall, das Mittagessen sei ihm nicht bekommen. Ja, natürlich werde er die Krankmeldung nachreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
