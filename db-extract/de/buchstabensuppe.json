                ],
                "senses": [
                    {
                        "sense_id": "af081d7f-4a1f-3488-a007-53a2472064fd",
                        "entry_id": "71e5818a-c5e2-326f-8444-0bc0340f429b",
                        "glosses": [
                            "Nudelsuppe mit zu Buchstaben geformten Nudeln als Einlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c144999f-1415-40b2-ae3d-e0f091ecbc70",
                                "sense_id": "af081d7f-4a1f-3488-a007-53a2472064fd",
                                "text": "„Bei einer warmen Buchstabensuppe könnte man sich sein Lieblingsbuch quasi auf der Zunge zergehen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12cda9d3-e64d-4ff1-9497-a796ba884ac9",
                        "source_entry_id": "71e5818a-c5e2-326f-8444-0bc0340f429b",
                        "source_sense_id": "af081d7f-4a1f-3488-a007-53a2472064fd",
                        "source_sense_description": "Gastronomie: Nudelsuppe mit zu Buchstaben geformten Nudeln als Einlage",
                        "target_lang_word": "alphabet soup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alphabet soup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07058148-39fe-3fdf-851d-2c23a045974b",
                                        "entry_id": "5258aaa8-376a-3aa8-a0dc-d1387d3e63a1",
                                        "glosses": [
                                            "A type of soup that contains noodles in the shape of various alphabetical letters, sometimes also numbers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "442f4219-66e5-4fec-8256-8cd157b5ab27",
                                                "sense_id": "07058148-39fe-3fdf-851d-2c23a045974b",
                                                "text": "Meronym: alfabeto"
                                            },
                                            {
                                                "example_id": "42b4cd3e-1896-454e-abdd-5b33866b336b",
                                                "sense_id": "07058148-39fe-3fdf-851d-2c23a045974b",
                                                "text": "Parents have been entertaining their children at mealtime with alphabet soup since the nineteenth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c78fcc5-eb64-39bb-be32-b27daaf3f6e0",
                                        "entry_id": "5258aaa8-376a-3aa8-a0dc-d1387d3e63a1",
                                        "glosses": [
                                            "A cryptic overabundance of acronyms and abbreviations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d24d4f5f-09e0-4618-ab49-71ec952421fe",
                                                "sense_id": "2c78fcc5-eb64-39bb-be32-b27daaf3f6e0",
                                                "text": "The various engineering teams' correspondence on circuit board design was an alphabet soup to outsiders."
                                            },
                                            {
                                                "example_id": "d9557b5c-a03b-412d-b769-a58cd44fbd6b",
                                                "sense_id": "2c78fcc5-eb64-39bb-be32-b27daaf3f6e0",
                                                "text": "And particularly in headlines and written materials, gay was used over LGBT. One ambivalent heterosexual ally explained this decision-making: I think there were several people who were sensitive to issues like that about do we use the word lesbian? Do we use the word transgender? And it's not that we didn't use those words, but in general, if you're doing a brochure and you have a headline, you don't include the whole alphabet soup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57d3a454-daed-33a6-8e49-136773394b0d",
                                        "entry_id": "5258aaa8-376a-3aa8-a0dc-d1387d3e63a1",
                                        "glosses": [
                                            "A quantity of people or organizations that are referred to by acronyms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e027af8-5d91-4fb6-82e1-1acbd464b27a",
                                                "sense_id": "57d3a454-daed-33a6-8e49-136773394b0d",
                                                "text": "too many three-letter agencies, constituting an alphabet soup"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb168b8-b597-3081-a318-b185880333ef",
                                        "entry_id": "5258aaa8-376a-3aa8-a0dc-d1387d3e63a1",
                                        "glosses": [
                                            "A physical state in which there is a miscellany of different particles, often designated by letters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "particle",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdfce423-8565-4002-b1ea-45c022c9c8e8",
                                                "sense_id": "3eb168b8-b597-3081-a318-b185880333ef",
                                                "text": "This part of the neutron star has been described as ‘a rich Greek alphabet soup’."
                                            },
                                            {
                                                "example_id": "d409a648-5988-4de0-b178-b62d1dea2864",
                                                "sense_id": "3eb168b8-b597-3081-a318-b185880333ef",
                                                "text": "GCN has published debates between and about Left groups like the Revolutionary Socialist League, Workers World Party, and Philadelphia Worokers Organizing Committee, but their debates are likely to leave the uninitiated in a daze. For folks who are new to the Left, the multitude of group acronyms must seem like an alphabet soup ― RSL, WWP, PWOC, SWP, CPML, NAM, DCSO, etc. ― and they are likely to have no appetite for it."
                                            },
                                            {
                                                "example_id": "eeb419e6-47e8-434a-b6b3-8853d686dac6",
                                                "sense_id": "3eb168b8-b597-3081-a318-b185880333ef",
                                                "text": "The early big bang is an alphabet soup of quarks, W bosons, gluons, and other exotic particles and flavors. In the usual scenario, there is no place for the pion. It dissociates in the alphabet soup of the early universe."
                                            },
                                            {
                                                "example_id": "a26eac7c-0229-4913-8ea4-944b98e7ff17",
                                                "sense_id": "3eb168b8-b597-3081-a318-b185880333ef",
                                                "text": "At shorter distances (probed at higher energies), an alphabet-soup of other types of spin 0 (scalar) and spin 1 (vector) mesons are exchanged […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d018f08-b2c0-3919-8f72-cfbd081e57ea",
                                        "entry_id": "5258aaa8-376a-3aa8-a0dc-d1387d3e63a1",
                                        "glosses": [
                                            "The series of preliminary races (denoted by letters) through which drivers must advance to the main event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
