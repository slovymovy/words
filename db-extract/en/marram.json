        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ab23b29a-7b8e-3a4d-b301-a95ab6df7b29",
                "word": "marram",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9508ceb7-bf3c-4fbb-939b-b87ace52c107",
                        "entry_id": "ab23b29a-7b8e-3a4d-b301-a95ab6df7b29",
                        "tags": [
                            "plural"
                        ],
                        "form": "marrams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44b9953d-637e-343f-859f-084a772b4307",
                        "entry_id": "ab23b29a-7b8e-3a4d-b301-a95ab6df7b29",
                        "glosses": [
                            "Ammophila arenaria, a coarse grass found on sandy beaches."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8e2755d6-7735-4f66-b055-3177dd35604c",
                                "sense_id": "44b9953d-637e-343f-859f-084a772b4307",
                                "text": "Rather would we compare these marram-tufted, wind-sculptured sand-wastes with the Red Sea litoral and the Egyptian Soudan, where Osman Digna led British troops memorable dances in the ‘nineties—alike both in their physical aspect and in their climate, red-hot by day, yet apt to be deadly chilly after sundown."
                            },
                            {
                                "example_id": "e20e88a4-a07a-4174-bc2d-fddef4b6258c",
                                "sense_id": "44b9953d-637e-343f-859f-084a772b4307",
                                "text": "He circled rapidly, stopped, swerved, and, at the canter, took up another scent. Suddenly, in a tussock of marram, his nose and he stopped dead."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe47767a-f2b4-427e-92d5-0527d615d741",
                        "source_entry_id": "ab23b29a-7b8e-3a4d-b301-a95ab6df7b29",
                        "source_sense_id": "44b9953d-637e-343f-859f-084a772b4307",
                        "source_sense_description": "Ammophila arenaria",
                        "target_lang_word": "helm",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helm",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "41d9457a-ec91-3fed-a5db-4f76bc61d5fa",
                                        "entry_id": "6f9d7524-70b9-3a1a-ab97-43455b916eff",
                                        "glosses": [
                                            "; beschermend hoofddeksel"
                                        ],
                                        "tags": [
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4837aa-cb46-4f6c-934d-c8536116f5ca",
                                                "sense_id": "41d9457a-ec91-3fed-a5db-4f76bc61d5fa",
                                                "text": "'Daar stonden ze, helm aan helm, geweer aan geweer, als in steen gehouwen. Ik werd met trots vervuld dat ik het bevel mocht voeren over een handvol mannen die mogelijk in stukken konden worden gereten maar zich niet lieten overwinnen. Op dit soort momenten triomfeert de menselijke geest over de enorme kracht van de materie."
                                            },
                                            {
                                                "example_id": "698e6922-f074-4c4b-8440-fff6307ce7e3",
                                                "sense_id": "41d9457a-ec91-3fed-a5db-4f76bc61d5fa",
                                                "text": "Om het aantal fietsslachtoffers te verminderen, wil minister Madlener dat over tien jaar ongeveer een kwart van de Nederlanders een helm draagt. Nu is dat nog maar 4 procent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d43b2bed-c63f-367c-8101-5dcf051fb7f7",
                                        "entry_id": "6f9d7524-70b9-3a1a-ab97-43455b916eff",
                                        "glosses": [
                                            "/ Ammophila arenaria een vaste plant, die tot de grassenfamilie (Poaceae) behoort. Het is een pioniersplant die belangrijk is bij de vorming van duinen. De plant produceert lange wortelstokken en waar deze wortelstokken met licht in aanraking komen ontstaat een nieuwe spruit"
                                        ],
                                        "tags": [
                                            "feminine",
                                            "masculine"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b45d036e-9cbb-49c3-bc5c-85a6ad400237",
                        "source_entry_id": "ab23b29a-7b8e-3a4d-b301-a95ab6df7b29",
                        "source_sense_id": "44b9953d-637e-343f-859f-084a772b4307",
                        "source_sense_description": "Ammophila arenaria",
                        "target_lang_word": "gourbet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gourbet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4600ea-0309-351f-825f-99366a09793b",
                                        "entry_id": "be7c2aeb-3e6c-3c4d-9679-84a708067be5",
                                        "glosses": [
                                            "Oyat, ou ammophila arenaria."
                                        ],
                                        "tags": [
                                            "Aquitaine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a5e813c-ac74-4061-a868-4c34495daf52",
                                                "sense_id": "dc4600ea-0309-351f-825f-99366a09793b",
                                                "text": "L'unique plante accrue au pied et sur le flanc des dunes, connue dans le pays sous la dénomination de gourbet, [sert] habituellement à la nourriture des vaches et des chevaux."
                                            },
                                            {
                                                "example_id": "b35e0dca-bd5f-4c56-afcf-a08f2b876b96",
                                                "sense_id": "dc4600ea-0309-351f-825f-99366a09793b",
                                                "text": "A chaque tempête, les dunes progressent vers l'intérieur des terres. […]. Des villages entiers sont engloutis : habitations, église, tout disparaît sous le sable. […]. Au fléau que ne pourraient conjurer les forces de l'homme, on oppose une graminée, le psamma des sables, dans les landes, gourbet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2671e47-a2f4-40d9-b368-e2752e0caba0",
                        "source_entry_id": "ab23b29a-7b8e-3a4d-b301-a95ab6df7b29",
                        "source_sense_id": "44b9953d-637e-343f-859f-084a772b4307",
