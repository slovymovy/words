                                        "entry_id": "3d60fed8-30c0-3d84-9945-6efe9412621f",
                                        "glosses": [
                                            "A vessel, aircraft or spacecraft that serves or carries a smaller vessel or vessels that operate independently from it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da9599c8-6494-38bc-b409-998790b62a4b",
                                        "entry_id": "3d60fed8-30c0-3d84-9945-6efe9412621f",
                                        "glosses": [
                                            "The main source or supporter of something."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a61378bd-9583-436f-b58d-1a7658d61efb",
                                                "sense_id": "da9599c8-6494-38bc-b409-998790b62a4b",
                                                "text": "“Tragically the mothership of terrorism is a country in India’s neighbourhood,” Modi told a gathering in India of the heads of governments of the Brics countries – Brazil, Russia, India, China and South Africa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ef438e-bda9-3527-933f-22925005039c",
                                        "entry_id": "3d60fed8-30c0-3d84-9945-6efe9412621f",
                                        "glosses": [
                                            "The largest vessel, especially a spaceship, in a fleet, from which the fleet is commanded; a flagship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56e84b6c-736b-30f7-8c9d-a75a45b8a147",
                                        "entry_id": "3d60fed8-30c0-3d84-9945-6efe9412621f",
                                        "glosses": [
                                            "The largest and most fearsome example of something."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4475de70-7f6e-4487-9377-695617bc2c2b",
                                                "sense_id": "56e84b6c-736b-30f7-8c9d-a75a45b8a147",
                                                "text": "SDCC is the mothership of all cons. It's enormous. It has the best stars."
                                            },
                                            {
                                                "example_id": "a4e57a64-957b-4ee7-81a0-5feb74b9bd5e",
                                                "sense_id": "56e84b6c-736b-30f7-8c9d-a75a45b8a147",
                                                "text": "These vices all feed the mothership of hubris, however, which several of the key characters demonstrate in ample measure."
                                            },
                                            {
                                                "example_id": "e1aff891-0716-45fc-9f2b-8bf1d660be4e",
                                                "sense_id": "56e84b6c-736b-30f7-8c9d-a75a45b8a147",
                                                "text": "Sephora is the “mothership of the modern-day beauty industry”, claims Greg Silverman, global director of brand economics at the marketing consultancy Interbrand."
                                            }
                                        ]
