    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2804ae87-9812-3f19-bd5f-c18de1f04f98",
                    "sense_definition": "Être constitué de certains éléments ou avoir pour objet d'accomplir une action précise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "composition_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau projet <w>consiste</w> à rénover entièrement la bibliothèque municipale du quartier."
                        },
                        {
                            "text": "Son repas du midi <w>consiste</w> en une salade verte et un fruit frais."
                        }
                    ],
                    "synonyms": [
                        "comporter",
                        "comprendre"
                    ],
                    "common_phrases": [
                        "consister à",
                        "consister en"
                    ]
                },
                {
                    "sense_id": "2dd37e70-d20d-3419-bad4-b1934d5bae2a",
                    "sense_definition": "Se résumer ou revenir pour l'essentiel à quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute sa défense <w>consistait</w> à affirmer qu'il ignorait totalement la présence du document."
                        },
                        {
                            "text": "Leurs ressources financières <w>consistent</w> essentiellement dans les revenus tirés de la vente de livres."
                        }
                    ],
                    "synonyms": [
                        "résider",
                        "revenir"
                    ],
                    "common_phrases": [
                        "consister principalement en"
                    ]
                },
                {
                    "sense_id": "fbad7765-4a18-3bd4-b1b2-7f4120aac024",
                    "sense_definition": "Avoir pour fondement ou trouver sa justification essentielle dans.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fondement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le véritable honneur de ce philosophe <w>consiste</w> dans le respect absolu de ses principes."
                        },
                        {
                            "text": "La difficulté de l'exercice <w>consistait</w> dans l'analyse critique de textes anciens complexes."
                        }
                    ],
                    "synonyms": [
                        "reposer"
                    ],
                    "common_phrases": [
                        "consister dans"
                    ]
                }
            ]
        }
