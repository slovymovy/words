                ],
                "senses": [
                    {
                        "sense_id": "a04a7d3d-ddb2-30c5-8149-0022e6a875d3",
                        "entry_id": "503bd9f3-981a-34e7-855c-56cf398bf146",
                        "glosses": [
                            "für Ausländer und ihre Belange zuständige Behörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47fa9c15-fc79-41ea-82d8-9fe8663fc50d",
                                "sense_id": "a04a7d3d-ddb2-30c5-8149-0022e6a875d3",
                                "text": "„Bei meinen zahlreichen Besuchen bei der Ausländerbehörde gewann nicht nur ich den Eindruck, dass die Beamten dort ihr Hauptaugenmerk nicht darauf richten, Ausländern Aufenthaltstitel zu geben, sondern vielmehr darauf, sie loszuwerden.“"
                            },
                            {
                                "example_id": "66879b2f-2dda-44a8-bde9-aa5d2929df78",
                                "sense_id": "a04a7d3d-ddb2-30c5-8149-0022e6a875d3",
                                "text": "„Das Angebot für eine Ausbildung zum Industrieelektriker konnte bedauerlicherweise nicht angenommen werden, da die Ausländerbehörde in diesem Fall eine unverhältnismäßig lange Zeit für die Erstellung einer Aufenthaltserlaubnis benötigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
