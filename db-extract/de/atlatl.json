                "senses": [
                    {
                        "sense_id": "5a4f8838-6f2f-37a9-99a8-bb4bb873d804",
                        "entry_id": "04e93aec-67ec-3eb5-b1a7-243b265339b4",
                        "glosses": [
                            "Speerschleuder der amerikanischen Ureinwohner"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "b057efa1-d372-489a-a4c6-730009042cfa",
                                "sense_id": "5a4f8838-6f2f-37a9-99a8-bb4bb873d804",
                                "text": "„Eine ebenfalls von den Paläoindianern Nordamerikas entwickelte Waffe ist der Atlatl, mit dessen Hilfe man Speere zielgenau über größere Entfernungen schleudern konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb8a63c3-d9e2-4734-95c8-fb99924a0b93",
                        "source_entry_id": "04e93aec-67ec-3eb5-b1a7-243b265339b4",
                        "source_sense_id": "5a4f8838-6f2f-37a9-99a8-bb4bb873d804",
                        "source_sense_description": "Fachsprache: Speerschleuder der amerikanischen Ureinwohner",
                        "target_lang_word": "atlatl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atlatl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b66eb073-dc55-33c0-942f-3a8c42c6904f",
                                        "entry_id": "319e44bc-838f-3988-9c2f-fb3ea682ac22",
                                        "glosses": [
                                            "A spearthrower consisting of a wooden stick with a thong or perpendicularly protruding hook on the rear end that grips a grove or socket on the butt of its accompanying spear (or dart), intended to steady the spear immediately prior to throwing, to increase its potential range when thrown, and to increase its force of penetration of the target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ba727c4-6fbb-43f8-95b6-f8f66a6006f5",
                                                "sense_id": "b66eb073-dc55-33c0-942f-3a8c42c6904f",
                                                "text": "While large game was still hunted, mainly using projectile spears but later enhanced by atlatls (spear-throwers) and bows and arrows, evidence for the exploitation of small game such as tortoises, rabbits, wild fowl and eggs increased."
                                            },
                                            {
                                                "example_id": "cd152aba-11d5-47e4-812b-dacda715eb54",
                                                "sense_id": "b66eb073-dc55-33c0-942f-3a8c42c6904f",
                                                "text": "World's oldest weapon delivery system. It's called an atlatl. Developed over 30,000 years ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
