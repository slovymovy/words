                "senses": [
                    {
                        "sense_id": "6284490a-518a-3293-98cf-f30302378f64",
                        "entry_id": "f9d3f40e-a232-3125-8a68-bfa779b0d83b",
                        "glosses": [
                            "Prostitution, die auf der Straße stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c57fd56-af8a-4a8e-8547-e9503004cac3",
                                "sense_id": "6284490a-518a-3293-98cf-f30302378f64",
                                "text": "„Ihr Vorgesetzter, William Copeland Dodge, hatte sie in mehreren Prozessen eingesetzt, bei denen die Stadt New York gegen die Straßenprostitution in gewissen Vierteln vorging.“"
                            },
                            {
                                "example_id": "3ff63911-55ad-42fd-bf9d-288890753c3f",
                                "sense_id": "6284490a-518a-3293-98cf-f30302378f64",
                                "text": "„Ich ahndete Delikte wegen Trunkenheit am Steuer und Straßenprostitution, schrieb kartonweise Strafzettel aus und durchstreifte ansonsten mein Revier auf der Suche nach etwas, das aus dem Rahmen fiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
