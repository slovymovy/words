                        "sense_id": "08c54b45-247d-3f2b-9860-5cbb170efecb",
                        "entry_id": "9ecd68c6-93ec-3add-a81a-375f19b1d979",
                        "glosses": [
                            "Débarrasser le chemin, ranger des objets en désordre."
                        ],
