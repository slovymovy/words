                        "entry_id": "4ac53e7d-1591-3f9e-ae13-ae86f06494f9",
                        "glosses": [
                            "gwiazda, której jasność gwałtownie wzrosła na skutek wybuchowego odrzucenia przez nią swoich zewnętrznych warstw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50197ad0-15f8-4408-a9bc-41dff7dfe557",
                                "sense_id": "cf1c669b-e4d3-3836-b840-bb02229a02e1",
                                "text": "Pierwiastki chemiczne cięższe od żelaza powstają w wybuchach supernowych."
                            },
                            {
                                "example_id": "0e66692f-82a6-4b79-8d26-dfe6eb45ecac",
                                "sense_id": "cf1c669b-e4d3-3836-b840-bb02229a02e1",
                                "text": "Najlepszymi świecami standardowymi do pomiaru parametru Hubble’a są dwa rodzaje gwiazd: Cefeidy oraz supernowe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
