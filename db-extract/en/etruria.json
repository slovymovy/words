                                        "entry_id": "1cb4d1d4-0980-3d6c-b07a-faf92ca3249d",
                                        "glosses": [
                                            "Territoire des Étrusques, correspondant à l’actuelle Toscane."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed6c57e1-9a6f-4943-a595-c04834f363fe",
                                                "sense_id": "7b8e2055-9cbd-367c-bb38-644797298e2c",
                                                "text": "Les sculptures et les peintures provenant de l’Étrurie ont pour la plupart subi l’influence de l’art et de la civilisation des Grecs."
                                            },
                                            {
                                                "example_id": "a4fbbde7-c66b-4e45-a5a2-66c236facc53",
                                                "sense_id": "7b8e2055-9cbd-367c-bb38-644797298e2c",
                                                "text": "Une même teinte fauve tirant sur le rouge-brique, celle des terres cuites claires de la vieille Étrurie, était répandue sur tout son corps, depuis le haut de son front jusqu’au bout de ses pieds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5888c856-56ee-4978-aed4-c14714a28892",
                        "source_entry_id": "55f8fec7-f817-3c3d-9df2-8c77ce53a4b4",
                        "source_sense_description": "ancient country",
