    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d705cb6-3937-379a-b31d-d89bb1814525",
                    "sense_definition": "A state of calm, quiet, or tranquillity, especially in the weather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>lown</w> after the heavy storm brought great relief to the sailors.",
                            "target_lang_translations": {
                                "fr": "La soudaine <w>accalmie</w> après la violente tempête apporta un grand soulagement aux marins."
                            }
                        },
                        {
                            "text": "They waited in the garden during the quiet <w>lown</w> of the evening.",
                            "target_lang_translations": {
                                "fr": "Ils attendirent dans le jardin durant le doux <w>calme</w> de la soirée."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "peace",
                        "quiet",
                        "serenity",
                        "tranquillity"
                    ],
                    "antonyms": [
                        "storm",
                        "turmoil"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Primarily used in northern England and Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un état de calme, de tranquillité ou d'accalmie, en particulier concernant la météo."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "accalmie",
                                "target_lang_sense_clarification": "apaisement passager du vent ou de la météo"
                            },
                            {
                                "target_lang_word": "calme",
                                "target_lang_sense_clarification": "état de tranquillité"
                            },
                            {
                                "target_lang_word": "tranquillité",
                                "target_lang_sense_clarification": "absence de bruit ou d'agitation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0058879-9822-33e5-907f-cdaa34abac26",
                    "sense_definition": "A sheltered, calm, or peaceful place protected from wind or weather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep gathered near the stone wall seeking a <w>lown</w> from the bitter wind.",
                            "target_lang_translations": {
                                "fr": "Les brebis se rassemblèrent près du mur de pierre, cherchant un <w>abri</w> contre le vent glacial."
                            }
                        },
                        {
                            "text": "We pitched our tents in the <w>lown</w> of the valley to stay safe from the gale.",
                            "target_lang_translations": {
                                "fr": "Nous avons monté nos tentes à <w>l'abri</w> de la vallée pour nous protéger de la bourrasque."
                            }
                        }
                    ],
                    "synonyms": [
                        "refuge",
                        "shelter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Primarily used in northern England and Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un endroit calme, paisible ou abrité du vent et des intempéries."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "abri",
                                "target_lang_sense_clarification": "lieu protégé des intempéries"
                            },
                            {
                                "target_lang_word": "refuge",
                                "target_lang_sense_clarification": "endroit sûr ou calme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da17ee6a-d569-38f7-86e7-9394559f800b",
                    "sense_definition": "A worthless, despicable, or low fellow; a rogue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fellow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The innkeeper chased the dishonest <w>lown</w> out into the street.",
                            "target_lang_translations": {
                                "fr": "L'aubergiste chassa le malhonnête <w>vaurien</w> dans la rue."
                            }
                        },
                        {
                            "text": "He warned his daughter never to trust such a deceitful <w>lown</w>.",
                            "target_lang_translations": {
                                "fr": "Il avertit sa fille de ne jamais faire confiance à un <w>maraud</w> aussi fourbe."
                            }
                        }
                    ],
                    "synonyms": [
                        "knave",
                        "rascal",
                        "rogue",
                        "scoundrel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used as an archaic or dialectal insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un individu méprisable, vil ou malhonnête ; un vaurien ou une fripouille."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vaurien",
                                "target_lang_sense_clarification": "personne sans valeur, fripouille"
                            },
                            {
                                "target_lang_word": "coquin",
                                "target_lang_sense_clarification": "terme ancien pour fripon ou scélérat"
                            },
                            {
                                "target_lang_word": "maraud",
                                "target_lang_sense_clarification": "terme archaïque désignant un coquin ou fripon"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0f610f10-975e-3462-b97b-d9c6588b701b",
                    "sense_definition": "Peaceful, quiet, and sheltered from wind or disturbance; calm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You could hear the church bells ringing clearly across the valley on such a <w>lown</w> day.",
                            "target_lang_translations": {
                                "fr": "On pouvait entendre distinctement les cloches de l'église sonner à travers la vallée en une journée si <w>calme</w>."
                            }
                        },
                        {
                            "text": "The horses rested peacefully in a <w>lown</w> corner of the meadow.",
                            "target_lang_translations": {
                                "fr": "Les chevaux se reposaient paisiblement dans un coin <w>abrité</w> du pré."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "peaceful",
                        "quiet",
                        "serene",
                        "sheltered",
                        "still",
                        "tranquil"
                    ],
                    "antonyms": [
                        "stormy",
                        "turbulent",
                        "windy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Chiefly Scottish and Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Paisible, tranquille et à l'abri du vent ou des perturbations ; calme."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "calme",
                                "target_lang_sense_clarification": "sans vent ni agitation"
                            },
                            {
                                "target_lang_word": "abrité",
                                "target_lang_sense_clarification": "protégé du vent"
                            },
                            {
                                "target_lang_word": "paisible",
                                "target_lang_sense_clarification": "tranquille et serein"
                            }
                        ]
                    }
                }
            ]
        },
