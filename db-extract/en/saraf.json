                    {
                        "sense_id": "38a5f984-90fb-3466-804f-ecac5ffccd4c",
                        "entry_id": "228e5978-f6d6-3584-af7a-f2f26745849f",
                        "glosses": [
                            "A provider of financial services in the Middle East and in South Asia, especially (historical) during the early modern and colonial period."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13fc5753-8cb4-4b95-8694-1728818d1442",
                                "sense_id": "38a5f984-90fb-3466-804f-ecac5ffccd4c",
                                "text": "There is in euery place of the street exchangers of mony, by them called Xaraffos, which are all christian Iewes."
                            },
                            {
                                "example_id": "ada111ea-62f6-48f6-9ccf-6de5b8227d31",
                                "sense_id": "38a5f984-90fb-3466-804f-ecac5ffccd4c",
                                "text": "He sent us to receive the money from his Saraf, or banker."
                            },
                            {
                                "example_id": "60e68f42-cf69-4864-92d4-f49d0d85b235",
                                "sense_id": "38a5f984-90fb-3466-804f-ecac5ffccd4c",
                                "text": "The mâmour... till the recent reform appointing a Controller-General of Receipts, received the taxes from the saraffs."
                            },
                            {
                                "example_id": "8ce9d2c8-969e-4e40-9f1a-079b1d02dea0",
                                "sense_id": "38a5f984-90fb-3466-804f-ecac5ffccd4c",
                                "text": "They [Armenians] prospered as our ‘Sarrafs’."
                            }
                        ]
                    }
