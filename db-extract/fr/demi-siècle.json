                                "target_senses": [
                                    {
                                        "sense_id": "6e2650c7-faf6-31e6-aebc-dc30ee38d884",
                                        "entry_id": "ec95ca6b-9a63-3f7d-a9f8-d349346e835e",
                                        "glosses": [
                                            "A period of fifty years, half of a century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c0f348-1e45-4c54-9c2f-50e9084407d3",
                                                "sense_id": "6e2650c7-faf6-31e6-aebc-dc30ee38d884",
                                                "text": "The Dutch population has grown rapidly in the last half-century and its increase has been matched by an expansion of industry, with the result that the same period has seen the Netherlands develop from a mainly agricultural to an industrial country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d7ff38-3fb8-341c-81ad-e2e7cf6b4811",
                                        "entry_id": "ec95ca6b-9a63-3f7d-a9f8-d349346e835e",
                                        "glosses": [
                                            "A score of 50 runs by a single batsman in one innings"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17fd66e8-3ce7-40e1-bf97-c641073df0ae",
                                                "sense_id": "c7d7ff38-3fb8-341c-81ad-e2e7cf6b4811",
                                                "text": "He brought up his half-century with a powerful drive past offspinner Dan Cullen, whose seven overs cost 0-52."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8ee4a33-7ea2-3f16-8520-c0eead1fb60a",
                                        "entry_id": "ec95ca6b-9a63-3f7d-a9f8-d349346e835e",
                                        "glosses": [
                                            "A score of 50 points in a single game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b5504b-cd56-4473-9910-495fc4d11797",
                                                "sense_id": "f8ee4a33-7ea2-3f16-8520-c0eead1fb60a",
                                                "text": "Selby's charge continued with a half-century in the 30th frame and a fluked red set him on the way to winning the 31st frame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
