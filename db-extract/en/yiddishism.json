                                    {
                                        "sense_id": "d6b1ce7c-ef72-33ec-bba7-90eaa15b7647",
                                        "entry_id": "93337cab-2e23-310e-8dbe-27cb576a619a",
                                        "glosses": [
                                            "Sprachbewegung zugunsten des Jiddischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c20882-cade-4596-bb8c-58b5121e25b5",
                                                "sense_id": "d6b1ce7c-ef72-33ec-bba7-90eaa15b7647",
                                                "text": "„Chaim Schitlowsky, den wir schon früher getroffen haben, war der große Theoretiker der ‚jiddischkejt‘, auch Jiddischismus oder Jiddische Sprachbewegung genannt.“"
                                            },
                                            {
                                                "example_id": "31ffd98d-fe6d-49b0-82d1-d3708f5064af",
                                                "sense_id": "d6b1ce7c-ef72-33ec-bba7-90eaa15b7647",
                                                "text": "„Träger des Jiddischismus waren vornehmlich sozialistische und linksbürgerliche Kreise wie der ‚Bund‘ (1897) und die ‚Poale Zion‘ (1903), seine Führer Männer wie Nathan Birnbaum, Abraham Reisen und vor allem Slomo Niger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e05c22-8c2f-4d35-9a4a-3d422f3fc3b1",
                        "source_entry_id": "21473845-ebbb-324a-b4e1-8e8a9cdd1839",
                        "source_sense_id": "d0f927d3-ef7f-39e2-857d-72a0346b1c37",
