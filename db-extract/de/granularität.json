                ],
                "senses": [
                    {
                        "sense_id": "90f9f36e-7cbb-39a9-8c29-8112657b5532",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "allgemein: Maß für die Feinkörnigkeit eines Systems, Anzahl der Untergliederungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3341153-3ae5-4f31-bcd1-8d5443122c93",
                                "sense_id": "90f9f36e-7cbb-39a9-8c29-8112657b5532",
                                "text": "Die Granularität kann sich je nach Zielsetzung stark unterscheiden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "36d7e7c0-9362-35a2-99da-76833e339df8",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "Körnigkeit eines Bildes"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
                                "example_id": "8db17a61-021b-4c03-8496-f4a113f980da",
                                "sense_id": "36d7e7c0-9362-35a2-99da-76833e339df8",
                                "text": "„Der Halbton eines solchen Films zeigt, wie auch Nepela und Nitka [5] durch Baden von Filmen in Lösungen von Pinakryptol Grün unabhängig gefunden haben, eine bei Expositionen mit harter Strahlung stark verringerte Granularität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "da4a352d-151d-3bd1-96ad-d70023276347",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "Semantische Schärfe eines sprachlichen Ausdruckes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514e0979-0309-4321-9c46-9d7575bdd301",
                                "sense_id": "da4a352d-151d-3bd1-96ad-d70023276347",
                                "text": "„Wenn sich Granularität nun auf (Nicht-)Episodizität zurückführen ließe, dann bedeutete dies, daß Granularität eine Aspektfunktion wäre. D.h., Grobheit wäre dann wie Nichtepisodizität."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "a6566fb7-1d0d-37d2-a9d1-4d463b98c2ce",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "Anzahl oder Maß der Differenzierung der Ebenen einer (hierarchischen) Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52bce251-bba6-4ac0-ac4e-5dff82809861",
                                "sense_id": "a6566fb7-1d0d-37d2-a9d1-4d463b98c2ce",
                                "text": "„Die Hierarchieebene unverdichteter Dimensionsknoten weist in einer Hierarchie die größte Granularität auf und bildet den Ausgangspunkt für die Festlegung der Granularität übergeordneter Hierarchieebenen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "721f1f4b-9a93-34a3-b33c-a0ed9719087f",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "„Passgenauigkeit“ von Informationen aus Empfängersicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3612d1f1-74f6-4463-91e6-cc15eec8c0cc",
                                "sense_id": "721f1f4b-9a93-34a3-b33c-a0ed9719087f",
                                "text": "Die Granularität der Informationen im Dokument entspricht nicht der Granularität der Informationen, die von der Ontologie für die Annotationen gefordert wird."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "dc01f8d2-dd4e-371b-bce7-990b09ee13c3",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "Verhältnis von Klein- und Großkrediten in einem Kreditportfolio"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "154025a3-1178-4702-b69f-908bff0086fe",
                                "sense_id": "dc01f8d2-dd4e-371b-bce7-990b09ee13c3",
                                "text": "Die Granularität der bereits gewährten Kredite ist wichtig bei der Abschätzung eines Kreditrisikos."
                            }
                        ],
                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "6cbcf6b0-50de-3467-bba1-56c283150ac4",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "die Feinkörnigkeit eines Stoffes oder Stoffgemisches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "752c1d89-39a6-4607-bb06-ef4d04992e9b",
                                "sense_id": "6cbcf6b0-50de-3467-bba1-56c283150ac4",
                                "text": "Es war ein rosa Pulver, das von seiner Granularität an feinsten Sand erinnerte."
                            }
                        ],
                        "sense_index_json": "\"7\""
                    },
                    {
                        "sense_id": "9e3aa782-4c0c-395b-b5d4-d28fb685dded",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "Kennzeichen für die hierarchische Zerlegbarkeit eines Datenstroms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c9bb16d-a97f-476f-b03f-4ad31e55b90e",
                                "sense_id": "9e3aa782-4c0c-395b-b5d4-d28fb685dded",
                                "text": "Die Granularität einer Datenübertragung hängt auch von der Größe der einzelnen Datenpakete ab."
                            }
                        ],
                        "sense_index_json": "\"8\""
                    },
                    {
                        "sense_id": "d97171ae-ca8b-35e0-b334-3a2dfdb3a8f7",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "Grad der Verdichtung von Daten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60dd7e43-3847-426a-8454-dcc3d7ea8b40",
                                "sense_id": "d97171ae-ca8b-35e0-b334-3a2dfdb3a8f7",
                                "text": "Umsatzzahlen können mit unterschiedlicher Granularität präsentiert werden, nachdem die feingranularen Umsatzzahlen auf Filialebene zu grobgranularen Umsatzzahlen auf Landesebene verdichtet wurden."
                            }
                        ],
                        "sense_index_json": "\"9\""
                    },
                    {
                        "sense_id": "73b2fd8d-50d5-35ef-a949-4eb4cf27be7a",
                        "entry_id": "f8a3febf-bfa8-3f0b-816f-0b2e3b684864",
                        "glosses": [
                            "Auflösung einer Suchmaschine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "719427fb-2cb7-4d61-a1fd-e8b3a6990818",
                                "sense_id": "73b2fd8d-50d5-35ef-a949-4eb4cf27be7a",
                                "text": "Suche ich den Begriff „Granum“ und bekomme ein Dokument mit 100 Seiten angezeigt, ist die Granularität dieser Antwort höher als wenn ich einen Absatz innerhalb eines Dokumentes angezeigt bekomme, in dem das Wort „Granum“ steht."
                            }
                        ],
                        "sense_index_json": "\"10\""
                    }
                ],
