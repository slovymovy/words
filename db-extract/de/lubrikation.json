                "senses": [
                    {
                        "sense_id": "84c0e099-a0e0-3e94-bf49-e1a1e3e15d1a",
                        "entry_id": "087d5548-b83a-3512-ab93-99eb579f6d87",
                        "glosses": [
                            "Sekretion einer Gleitsubstanz in die weibliche Scheide bei sexueller Erregung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "878e7889-9d94-4adc-aa21-01a156d99901",
                                "sense_id": "84c0e099-a0e0-3e94-bf49-e1a1e3e15d1a",
                                "text": "Um den Intimverkehr mit ihrem Partner als angenehm zu empfinden, muss die Scheide einer Frau durch Lubrikation ausreichend feucht werden."
                            },
                            {
                                "example_id": "f0f3edf9-4dbc-4105-820c-a55454fcd2ab",
                                "sense_id": "84c0e099-a0e0-3e94-bf49-e1a1e3e15d1a",
                                "text": "Körperlich muss zunächst einmal überhaupt ein grundsätzliches sexuelles Verlangen vorhanden sein, um die Lubrikation anzuregen."
                            },
                            {
                                "example_id": "fbc43212-f70e-4830-8a5c-16c4d2b96f14",
                                "sense_id": "84c0e099-a0e0-3e94-bf49-e1a1e3e15d1a",
                                "text": "Eine häufige Störung der Erregung bei der Frau ist die mangelnde Lubrikation, die neben psychischen diverse organische Ursachen hat; …"
                            },
                            {
                                "example_id": "d81f30a0-784a-45d1-bc98-188fe26b29af",
                                "sense_id": "84c0e099-a0e0-3e94-bf49-e1a1e3e15d1a",
                                "text": "Bei Frauen wird die Haut von Vulva und Scheide nach den Wechseljahren etwas dünner und empfindlicher und die Lubrikation wird u.U. schwächer."
                            },
                            {
                                "example_id": "1a81b869-d7ac-45cc-9a98-c261aa7b31d6",
                                "sense_id": "84c0e099-a0e0-3e94-bf49-e1a1e3e15d1a",
                                "text": "Eine Laborstudie zur Lubrikation belegt, dass die Vagina von jüngeren, prämenopausalen Frauen in sexuell nicht erregtem Zustand feuchter ist als die von älteren, peri- oder postmenopausalen Frauen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
