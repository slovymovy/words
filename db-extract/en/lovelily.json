                "senses": [
                    {
                        "sense_id": "975bfb9d-d627-3e89-9208-ef15b4aabf09",
                        "entry_id": "7bfd2cd9-48f0-33b8-9133-3b90add86d15",
                        "glosses": [
                            "In a lovely way.",
                            "In a manner to excite or inspire admiration or love; admirably, beautifully, wonderfully."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2af2e3e9-40a7-405a-81de-453bf070867b",
                                "sense_id": "975bfb9d-d627-3e89-9208-ef15b4aabf09",
                                "text": "By continually doing the part of Sacrificers, and eſpecially by turning all the Good Things of Earth into Sacrifices, a Converſation in Heaven vvill be moſt Lovelily Exemplifyed."
                            },
                            {
                                "example_id": "8c6ec20f-949b-4924-91d6-3f5b0bab7819",
                                "sense_id": "975bfb9d-d627-3e89-9208-ef15b4aabf09",
                                "text": "Courage, a Youth of royal race, / Lovelily ſtern, poſſeſs'd a place / On her left-hand, and on her right, / Sat Honour, cloath'd vvith robes of Light; […]"
                            },
                            {
                                "example_id": "81513fc5-2f9a-411b-b81d-a565617b92f6",
                                "sense_id": "975bfb9d-d627-3e89-9208-ef15b4aabf09",
                                "text": "So lovelily the morning shone, / That—let the old and weary sleep— / I could not; […]"
                            },
                            {
                                "example_id": "bd1b14cb-e256-4383-886e-d97b11cb93aa",
                                "sense_id": "975bfb9d-d627-3e89-9208-ef15b4aabf09",
                                "text": "Whatso looks lovelily / Is but the rainbow on life's weeping rain. / Why have we longings of immortal pain, / And all we long for mortal?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8e2223f-b7b0-3016-bbb0-8eaebe49436c",
                        "entry_id": "7bfd2cd9-48f0-33b8-9133-3b90add86d15",
                        "glosses": [
                            "In a lovely way.",
                            "In a friendly or pleasant manner; amiably, kindly, pleasantly."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3f302f3e-e9ca-49cb-8183-ee24219dbe81",
                                "sense_id": "f8e2223f-b7b0-3016-bbb0-8eaebe49436c",
                                "text": "Moreover hovv lovelily do the Graces cling to one another! Hovv vvell does their garment become them, being not girt to them vvith any girdle, the skirts of it vvaving to and fro at liberty."
                            }
                        ]
                    }
