                "translations": [
                    {
                        "translation_id": "71280c28-2a18-4ae0-8d22-69a581de3ccc",
                        "source_entry_id": "d9d30286-3482-3342-906e-614447b38edf",
                        "source_sense_id": "82bf8e72-bbd9-3d9d-a537-130536da9a12",
                        "source_sense_description": "Psychologie: behavioristisch, Verhaltens-",
                        "target_lang_word": "behavioristisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "behavioristisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74503ee1-f497-330b-a431-da32388acfa5",
                                        "entry_id": "96bac8c5-d0e1-3aa6-be98-a03810d79b08",
                                        "glosses": [
                                            "Linguistik, auf den Behaviorismus bezogen, dem Behaviorismus entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a80c9aa-276a-4db7-8ca4-aedf013e623d",
                                                "sense_id": "74503ee1-f497-330b-a431-da32388acfa5",
                                                "text": "„Nach behavioristischen Konzeptionen ist Bedeutung das Resultat des kommunikativen Verhaltens beim Empfang von Zeichen, sie ist das Resultat des Reizes und der Reaktion.“"
                                            },
                                            {
                                                "example_id": "80453eca-5eb7-4d8e-9cc9-878bac924f1e",
                                                "sense_id": "74503ee1-f497-330b-a431-da32388acfa5",
                                                "text": "„Während der behavioristische Ansatz den Spracherwerb als stimulus-kontrolliert und dadurch auch der Außensteuerung ausgesetzt ansieht, geht der nativistische Ansatz davon aus, daß der Spracherwerb nicht ein Erwerb von Habits, sondern die Entfaltung angeborener linguistischer Fähigkeiten ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bce5250f-7a1c-4e56-82cf-8c0e041d95ed",
                        "source_entry_id": "d9d30286-3482-3342-906e-614447b38edf",
                        "source_sense_id": "82bf8e72-bbd9-3d9d-a537-130536da9a12",
                        "source_sense_description": "Psychologie: behavioristisch, Verhaltens-",
                        "target_lang_word": "Verhalten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhalten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                        "entry_id": "4fba04ca-10bd-32f3-9bd7-68eec0c3c4f0",
                                        "glosses": [
                                            "das, was jemand tut oder lässt und auf welche Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b355be6e-f974-4f51-97cc-8d5f35ad83c8",
                                                "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                                "text": "Mit deinem jetzigen Verhalten wirst du keinen Erfolg haben."
                                            },
                                            {
                                                "example_id": "3a99b828-99d7-47cd-9bdd-69615e214a7d",
                                                "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                                "text": "„Der Unterschied zwischen ober- und untergärigem Bier liegt im Verhalten der Hefe beim Brauvorgang.“"
                                            },
                                            {
                                                "example_id": "d4ddff7b-839d-4396-8e12-43cd15fb2c84",
                                                "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                                "text": "„Der Streit über die Frage, ob der Mensch in seinem Verhalten frei ist oder der freie Wille nur pure Einbildung, dauert nun schon Jahrhunderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc86fd55-abe2-31dd-8a29-dff079ce3798",
                                        "entry_id": "4fba04ca-10bd-32f3-9bd7-68eec0c3c4f0",
                                        "glosses": [
                                            "Gesamtheit aller von außen beobachtbaren Äußerungen eines Lebewesens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82f5003-7908-4e5f-bccd-ec8b7d9861df",
                                                "sense_id": "bc86fd55-abe2-31dd-8a29-dff079ce3798",
                                                "text": "Anders als offenes Verhalten kann verdecktes Verhalten (Denken, Vorstellen, Erinnern usw.) nicht direkt beobachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
