                        "source_entry_id": "774aed27-02fc-37e4-b1bc-85f9bd3334a8",
                        "source_sense_id": "e617e98a-608c-3f37-9386-c2a601488c8d",
                        "source_sense_description": "van een persoon dat deze zich goed houdt aan de (toneel)rol die hij speelt",
                        "target_lang_word": "letter-perfect",
                        "target_lang_code": "en",
