{
    "word_family": [
        "stagnate",
        "stagnation",
        "stagnancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8515eb4d-4b3e-38ec-96bc-10732b7b2966",
                    "sense_definition": "Without progress, activity, or change; stale and inactive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inactive_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying new policies to boost the <w>stagnant</w> economy.",
                            "target_lang_translations": {
                                "ru": "Правительство пробует новые меры для стимулирования <w>застойной</w> экономики."
                            }
                        },
                        {
                            "text": "He felt trapped in a <w>stagnant</w> career with no opportunities for promotion.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя в ловушке на <w>застойной</w> работе без каких-либо возможностей для продвижения."
                            }
                        }
                    ],
                    "antonyms": [
                        "dynamic",
                        "active",
                        "growing"
                    ],
                    "common_phrases": [
                        "stagnant economy",
                        "stagnant wages",
                        "stagnant career"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без прогресса, активности или изменений; застойный и неактивный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застойный",
                                "target_lang_sense_clarification": "о развитии, экономике, карьере"
                            },
                            {
                                "target_lang_word": "стагнирующий",
                                "target_lang_sense_clarification": "об экономике или процессах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed771414-42ce-3c19-8924-19b7b5cdd89d",
                    "sense_definition": "Lacking freshness, motion, or flow; dirty and smelly from standing still.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inactive_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mosquitoes often breed in pools of <w>stagnant</w> water.",
                            "target_lang_translations": {
                                "ru": "Комары часто размножаются в лужах со <w>стоячей</w> водой."
                            }
                        },
                        {
                            "text": "The air in the abandoned house was thick and <w>stagnant</w>.",
                            "target_lang_translations": {
                                "ru": "Воздух в заброшенном доме был густым и <w>застоявшимся</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "standing"
                    ],
                    "antonyms": [
                        "flowing",
                        "running",
                        "fresh"
                    ],
                    "common_phrases": [
                        "stagnant water",
                        "stagnant pool",
                        "stagnant air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный свежести, движения или течения; грязный и с неприятным запахом из-за неподвижности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стоячий",
                                "target_lang_sense_clarification": "о воде"
                            },
                            {
                                "target_lang_word": "застоявшийся",
                                "target_lang_sense_clarification": "о воде или воздухе"
                            },
                            {
                                "target_lang_word": "спертый",
                                "target_lang_sense_clarification": "о воздухе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}