{
    "word_family": [
        "mediocrity",
        "mediocrely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe27560c-c47b-3081-83c1-e3bf04c1ba47",
                    "sense_definition": "Of only moderate quality; not very good and often disappointing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant received a <w>mediocre</w> review because the food was bland and the service was slow.",
                            "target_lang_translations": {
                                "ru": "Ресторан получил <w>посредственный</w> отзыв, потому что еда была безвкусной, а обслуживание — медленным."
                            }
                        },
                        {
                            "text": "I am pretty good at tennis but only <w>mediocre</w> at racquetball.",
                            "target_lang_translations": {
                                "ru": "Я довольно хорошо играю в теннис, но в ракетболе я лишь <w>посредственность</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "average",
                        "commonplace",
                        "indifferent",
                        "lackluster",
                        "middling",
                        "ordinary",
                        "pedestrian",
                        "so-so",
                        "unexceptional",
                        "uninspiring"
                    ],
                    "antonyms": [
                        "excellent",
                        "exceptional",
                        "great",
                        "outstanding",
                        "remarkable"
                    ],
                    "common_phrases": [
                        "mediocre",
                        "mediocre performance",
                        "mediocre results",
                        "mediocre quality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишь среднего качества; не очень хороший и часто разочаровывающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посредственный",
                                "target_lang_sense_clarification": "не обладающий выдающимися качествами"
                            },
                            {
                                "target_lang_word": "заурядный",
                                "target_lang_sense_clarification": "обычный, ничем не примечательный"
                            },
                            {
                                "target_lang_word": "средний",
                                "target_lang_sense_clarification": "неплохой, но и не хороший"
                            },
                            {
                                "target_lang_word": "неважный",
                                "target_lang_sense_clarification": "довольно плохого качества"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5507ec9c-f061-3b3f-8a9e-6f1e23adc499",
                    "sense_definition": "A person of minor significance or accomplishment; an undistinguished individual.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic argued that the gallery was filled with works by <w>mediocres</w> rather than true masters.",
                            "target_lang_translations": {
                                "ru": "Критик утверждал, что галерея заполнена работами <w>посредственностей</w>, а не истинных мастеров."
                            }
                        },
                        {
                            "text": "In a world of geniuses, he felt like one of the <w>mediocres</w> who would never be remembered.",
                            "target_lang_translations": {
                                "ru": "В мире гениев он чувствовал себя одним из <w>заурядностей</w>, о которых никто никогда не вспомнит."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек незначительный или не имеющий особых достижений; ничем не примечательная личность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посредственность",
                                "target_lang_sense_clarification": "о человеке без талантов"
                            },
                            {
                                "target_lang_word": "заурядность",
                                "target_lang_sense_clarification": "обычный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf8b8f9c-fa3f-3e5c-880d-58d0f29bc05b",
                    "sense_definition": "A member of a socioeconomic class between the upper ranks of society and the agricultural workers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical records describe the <w>mediocres</w> as a rising class of merchants and skilled tradesmen.",
                            "target_lang_translations": {
                                "ru": "Исторические записи описывают <w>средний класс</w> как растущее сословие купцов и квалифицированных ремесленников."
                            }
                        },
                        {
                            "text": "The social hierarchy of the time placed the <w>mediocres</w> above the peasantry but below the nobility.",
                            "target_lang_translations": {
                                "ru": "Социальная иерархия того времени ставила <w>средние слои</w> выше крестьянства, но ниже знати."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in historical or sociological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель социально-экономического класса между высшими слоями общества и сельскохозяйственными рабочими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средний класс",
                                "target_lang_sense_clarification": "в историческом контексте"
                            },
                            {
                                "target_lang_word": "мещанин",
                                "target_lang_sense_clarification": "в социологическом смысле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}