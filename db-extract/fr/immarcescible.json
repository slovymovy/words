                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d381be0d-1b25-4ef1-bb2e-6b10ad372615",
                                                "sense_id": "552e7a29-5f0a-3504-a754-86ef6886ae0b",
                                                "text": "I did not think to see them once again, / For what could bring into an old woman's dream / Canova's immarcescible marble lovers?"
                                            }
