                "senses": [
                    {
                        "sense_id": "a97de122-78cb-3c7c-a2d6-4949d9d6d0bf",
                        "entry_id": "cc45138b-6b20-36a2-b08a-888791e61035",
                        "glosses": [
                            "door wormen aangevreten en bedorven (met name van hout en vruchten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ca4517-47db-40ae-978e-0a61ac10564c",
                                "sense_id": "a97de122-78cb-3c7c-a2d6-4949d9d6d0bf",
                                "text": "Gelukkig stonden er in een achterafzaaltje, ver van alle nieuwe media, een paar luie, wormstekige jarenvijftigstoelen voor een dito televisiemeubel. Je kon er niets anders doen dan onderuit zakken in de tijd en een halve eeuw sporthoogtepunten bekijken. Gewoon, op een klein schermpje, met een koptelefoon."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d3c8f02-1b56-3e4b-8277-184f84a48776",
                        "entry_id": "cc45138b-6b20-36a2-b08a-888791e61035",
                        "glosses": [
                            "oud en vergaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e7e4c5-edce-4d90-954d-b5dc928b056f",
                                "sense_id": "4d3c8f02-1b56-3e4b-8277-184f84a48776",
                                "text": "Pijnlijke zaak, nu Wagnerianen uit heel de wereld toestromen voor de Bayreuther Festspiele, de jaarlijkse hoogmis van de Wagneropera. Bondskanselier Angela Merkel schuifelt incognito rond. Tussen blote galajurken beweegt zich ook Beierse en Japanse klederdracht. In Bayreuth verzamelt zich de crème de la crème en om te voorkomen dat die een stuk puin op het hoofd krijgt, is de wormstekige façade voorlopig in de steigers gezet. Doek eromheen, print van het originele Beierse vakwerk erop - klaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f940b36c-2dc3-421f-8ebb-999e3fec9a2e",
                        "source_entry_id": "cc45138b-6b20-36a2-b08a-888791e61035",
                        "source_sense_id": "a97de122-78cb-3c7c-a2d6-4949d9d6d0bf",
