                "senses": [
                    {
                        "sense_id": "565d0d0d-efa4-3714-b458-b0980bc5506b",
                        "entry_id": "145e535e-8784-3495-bcd7-052da5506ddc",
                        "glosses": [
                            "Arbre aux feuilles digitées qui produisent des petites fleurs malodorantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf5d703-3384-4fc5-83e7-06f7d18d5bc2",
                                "sense_id": "565d0d0d-efa4-3714-b458-b0980bc5506b",
                                "text": "Je les ai vus, les bois précieux couchés sur l’eau, les grands sterculiers d’argent aimé des rapaces, les dragonniers et les bois de rose tout ensanglantés qui vers les estuaires allaient former des continents, des archipels, radeaux poussés comme des draperies par les hommes silhouettés en noir sur le fleuve."
                            },
                            {
                                "example_id": "770b97c5-17db-4f80-9d76-9e73cb63ee08",
                                "sense_id": "565d0d0d-efa4-3714-b458-b0980bc5506b",
                                "text": "Quant à l’attitude noble d’une grue, à l’air féroce de l’aigle, à la libre allure du saule ou du sterculier, à la silhouette dépouillée du sapin ou du thuya, la peinture est là pour les figurer, les animant de l’esprit même de la Création, les offrant, tel un vrai paysage, à la contemplation des hommes."
                            },
                            {
                                "example_id": "0a0c0b02-c610-4c0e-a9b7-526b2bfcc2f6",
                                "sense_id": "565d0d0d-efa4-3714-b458-b0980bc5506b",
                                "text": "Le sterculier fétide est un arbre aux feuilles digitées qui produisent des petites fleurs malodorantes, d’où son nom et ses variantes."
                            }
                        ]
                    }
                ],
