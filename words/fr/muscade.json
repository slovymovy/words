                    "frequency": "Middle",
                    "semantic_group_id": "epice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ajoutez une pincée de <w>muscade</w> dans la sauce béchamel pour rehausser son goût."
                        },
                        {
                            "text": "Elle râpe un peu de <w>muscade</w> sur le gratin de pommes de terre."
                        }
                    ],
                    "common_phrases": [
