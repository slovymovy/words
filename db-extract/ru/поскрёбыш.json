                        "glosses": [
                            "рег. остатки продуктов питания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b94ca2-e045-4e8e-b1f0-732ed44c5d3e",
                                "sense_id": "15e6e191-79c6-3500-96d9-3a57e3312b34",
                                "text": "Если без этих игр, то менять район может пятую часть гречи, сахара в натуроплату, поскрёбыши муки и мяса — не позавидуешь пришедшим не идеи блюсти, а карточки отоваривать."
                            }
                        ]
                    }
