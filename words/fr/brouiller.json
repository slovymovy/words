                },
                {
                    "sense_id": "5ed60043-6097-3021-b362-9b2bcf3be5bd",
                    "sense_definition": "Mettre en désordre ou confondre des éléments ou des idées de façon obscure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces informations contradictoires finissent par lui <w>brouiller</w> l'esprit.",
                            "target_lang_translations": {
                                "en": "All this conflicting information ends up <w>muddling</w> his mind.",
                                "ru": "Вся эта противоречивая информация в итоге <w>путает</w> ему мысли.",
                                "de": "Am Ende <w>verwirren</w> ihn all diese widersprüchlichen Informationen.",
                                "es": "Al final, toda esta información contradictoria le <w>confunde</w> la mente.",
                                "zh": "这些相互矛盾的信息最终<w>搅乱</w>了他的思绪。"
                            }
                        },
                        {
                            "text": "Le candidat évite de répondre clairement et tente de <w>brouiller</w> le message.",
                            "target_lang_translations": {
                                "en": "The candidate avoids giving a clear answer and tries to <w>obscure</w> the message.",
                                "ru": "Кандидат избегает чёткого ответа и пытается <w>затемнить</w> смысл сообщения.",
                                "de": "Der Kandidat vermeidet eine klare Antwort und versucht, die Botschaft zu <w>verschleiern</w>.",
                                "es": "El candidato evita responder con claridad e intenta <w>oscurecer</w> el mensaje.",
                                "zh": "候选人回避明确回答，还试图<w>混淆</w>视听。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confondre",
                        "embrouiller"
                    ],
                    "antonyms": [
                        "clarifier",
                        "ordonner"
                    ],
                    "common_phrases": [
                        "brouiller les cartes",
                        "brouiller le message"
                    ],
                    "target_lang_definitions": {
                        "en": "To confuse ideas, information or a message by mixing up or obscuring its parts.",
                        "ru": "Перепутывать или запутывать идеи, сведения либо смысл сообщения.",
                        "de": "Ideen, Informationen oder eine Botschaft durcheinanderbringen oder unklar machen.",
                        "es": "Confundir ideas o información, o hacer confuso el sentido de un mensaje.",
                        "zh": "把想法、信息或事情弄乱，使人难以理解或分辨。"
                    },
                    "translations": {
