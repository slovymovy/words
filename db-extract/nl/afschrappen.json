                                "target_senses": [
                                    {
                                        "sense_id": "a68dc089-19b0-343e-8702-9a26765e6cd5",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To draw (an object, especially a sharp or angular one), along (something) while exerting pressure."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f284067b-e0b1-445c-b305-474539a0b5df",
                                                "sense_id": "a68dc089-19b0-343e-8702-9a26765e6cd5",
                                                "text": "She scraped the wooden plate with her fingernails."
                                            },
                                            {
                                                "example_id": "1e795561-94b2-43dc-866a-feee200fbd01",
                                                "sense_id": "a68dc089-19b0-343e-8702-9a26765e6cd5",
                                                "text": "That car often scrapes the shallowest of humps because of its low ground clearance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf26a88-081e-3f69-b8fa-18349795190a",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To remove (something) by drawing an object along in this manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8166112-22c2-455a-a70c-9e1369bd562c",
                                                "sense_id": "7cf26a88-081e-3f69-b8fa-18349795190a",
                                                "text": "Scrape the chewing gum off with a knife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d74e2ed-75c6-3d8e-9043-bd006fc4ddc2",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To injure or damage by rubbing across a surface."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e64daa-5598-4c78-9d8d-d40e5a01831d",
                                                "sense_id": "9d74e2ed-75c6-3d8e-9043-bd006fc4ddc2",
                                                "text": "She tripped on a rock and scraped her knee."
                                            },
                                            {
                                                "example_id": "8f9914be-f150-4d5a-8db7-0301a4aa47f0",
                                                "sense_id": "9d74e2ed-75c6-3d8e-9043-bd006fc4ddc2",
                                                "text": "We went tip-toeing along a path amongst the trees back towards the end of the widow's garden, stooping down so as the branches wouldn't scrape our heads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56851258-37ea-3236-ba21-47c886fccd37",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To barely manage to achieve or attain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8deb9c32-c291-492b-b5dd-1641e530b87f",
                                                "sense_id": "56851258-37ea-3236-ba21-47c886fccd37",
                                                "text": "I scraped a pass in the exam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29567f55-ed60-30ae-99d6-5939d15420da",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To collect or gather, especially without regard to the quality of what is chosen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bdedb62-99e2-49ff-b70d-e15685d91b79",
                                                "sense_id": "29567f55-ed60-30ae-99d6-5939d15420da",
                                                "text": "Just use whatever you can scrape together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9dbf5ec-0979-3a6e-b9ee-fceb203f28f8",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To extract data by automated means from a format not intended to be machine-readable, such as a screenshot or a formatted web page."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60906646-976b-4991-a63c-c0f713b5e994",
                                                "sense_id": "d9dbf5ec-0979-3a6e-b9ee-fceb203f28f8",
                                                "text": "They didn't provide an API, so I simply scraped their website."
                                            },
                                            {
                                                "example_id": "cc7431db-d160-45ed-b681-f2c98d348c78",
                                                "sense_id": "d9dbf5ec-0979-3a6e-b9ee-fceb203f28f8",
                                                "text": "The threat of the impending axe horrified Scott. He and his supporters hastily “scraped” as many Geocities^([sic]) pages as they could, creating a 641-gigabyte archive that initially circulated on file-sharing networks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0675bc23-2dfe-3a44-9e66-a7836df513b5",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To occupy oneself with getting laboriously."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51243625-3dc7-4f83-bf9f-1ba7f7417449",
                                                "sense_id": "0675bc23-2dfe-3a44-9e66-a7836df513b5",
                                                "text": "He scraped and saved until he became rich."
                                            },
                                            {
                                                "example_id": "3f5c0235-47fd-4b3a-8660-712ec4cc6564",
                                                "sense_id": "0675bc23-2dfe-3a44-9e66-a7836df513b5",
                                                "text": "And he shall spend mine honour with his shame, As thriftless sons their scraping fathers' gold"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa33f88-4bf3-32b4-bf3f-eac2a27cf848",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To play awkwardly and inharmoniously on a violin or similar instrument."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a923ad-0b71-4c75-96d8-a14b2d73f63e",
                                                "sense_id": "1fa33f88-4bf3-32b4-bf3f-eac2a27cf848",
                                                "text": "Some people covered their ears when he started to scrape his violin."
                                            },
                                            {
                                                "example_id": "c7e960bc-a4b2-4595-8fe2-3f5189bb84f6",
                                                "sense_id": "1fa33f88-4bf3-32b4-bf3f-eac2a27cf848",
                                                "text": "At that time the Grand Duke had only two occupations. One was to scrape the violin, the other to train spaniels for hunting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b64df09-2c06-388c-929d-97b85a1ac6f2",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To draw back the right foot along the ground or floor when making a bow."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36b85331-a749-4561-8b5a-4072311aa0dd",
                                                "sense_id": "3b64df09-2c06-388c-929d-97b85a1ac6f2",
                                                "text": "Yossarian went along in Milo Minderbinder's speeding M & M staff car to police headquarters to meet a swarthy, untidy police commissioner with a narrow black mustache and unbuttoned tunic who was fiddling with a stout woman with warts and two chins when they entered his office and who greeted Milo with warm surprise and bowed and scraped in obscene servility as though Milo were some elegant marquis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be54a28f-e4ed-3ee8-837e-e3fa646f0e6d",
                                        "entry_id": "f6d5d519-c623-3478-9e9b-d17511b958f2",
                                        "glosses": [
                                            "To express disapprobation of (a play, etc.) or to silence (a speaker) by drawing the feet back and forth upon the floor; usually with down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d8e701-6b8c-4d0c-ac05-12914092ca87",
                                                "sense_id": "be54a28f-e4ed-3ee8-837e-e3fa646f0e6d",
                                                "text": "When the debate was resumed, the tide ran so strongly against the accused that his friends were coughed and scraped down."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scrape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2e22377-67c5-367c-a9ab-dc94ef529c9a",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "A broad, shallow injury left by scraping (rather than a cut or a scratch)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a941ef4-e068-45fc-9c49-658506a7f379",
                                                "sense_id": "a2e22377-67c5-367c-a9ab-dc94ef529c9a",
                                                "text": "He fell on the sidewalk and got a scrape on his knee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354c6e2b-450b-3edb-a7da-843b707f82d5",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "The sound or action of something being scraped."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5537ef-d8eb-4cd2-8851-7b1d9def28da",
                                                "sense_id": "354c6e2b-450b-3edb-a7da-843b707f82d5",
                                                "text": "For a long while, the only sounds in the café were the scrapes of forks against old white plates and occasional slurps from coffee mugs."
                                            },
                                            {
                                                "example_id": "6733ed66-735d-40d6-b2f0-002fa24a9214",
                                                "sense_id": "354c6e2b-450b-3edb-a7da-843b707f82d5",
                                                "text": "The scrape of the plate against the stone woke him, and he looked across to find Isocrates there, replacing the food."
                                            },
                                            {
                                                "example_id": "fc447932-6f79-49bb-b141-a73ca10c1cbc",
                                                "sense_id": "354c6e2b-450b-3edb-a7da-843b707f82d5",
                                                "text": "I summon all my strength to make the shapes. Letter by painful letter we scrawl together. My mum follows each scrape of the pen with rapt anticipation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51949e1-0a07-3d2b-9656-5599dc3c009c",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "Something removed by being scraped; a thin layer of something such as butter on bread."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed9235c-66dd-41a8-b641-54620d820f3a",
                                                "sense_id": "a51949e1-0a07-3d2b-9656-5599dc3c009c",
                                                "text": "A little solace came at tea time, in the shape of a double ration of bread—a whole, instead of a half-slice—with the delicious addition of a thin scrape of butter: […]"
                                            },
                                            {
                                                "example_id": "e3500e1c-4f78-49ff-895b-c3e128b21d93",
                                                "sense_id": "a51949e1-0a07-3d2b-9656-5599dc3c009c",
                                                "text": "Or I could make a cup of tea and sit on the toilet with it – now we’re talking! And what about some toast and that last scrape of Marmite I hid…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9343e5-1088-302d-88a5-1dbc657eed64",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "A fight, especially a fistfight without weapons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39358ee1-f79d-4fc5-a3a9-7cc0c485c431",
                                                "sense_id": "ac9343e5-1088-302d-88a5-1dbc657eed64",
                                                "text": "He got in a scrape with the school bully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c16ccd-7704-3171-8d11-49594a745dff",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "An awkward set of circumstances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b60bf2a-c584-4cf5-ace7-53a969b2b764",
                                                "sense_id": "54c16ccd-7704-3171-8d11-49594a745dff",
                                                "text": "I'm in a bit of a scrape — I've no money to buy my wife a birthday present."
                                            },
                                            {
                                                "example_id": "2486e06b-59b3-4d08-a6c4-b102d572ffc4",
                                                "sense_id": "54c16ccd-7704-3171-8d11-49594a745dff",
                                                "text": "Stuart made us all laugh - his mischievous stories were told throughout his career and in later days featured some very senior politicians and railway managers. He certainly got into many scrapes over the years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d05ea19-36d8-3492-9574-a7dc4bb1d7a2",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "A D and C or abortion; or, a miscarriage."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dee1c153-33b3-4318-999b-c5b62ddf56e1",
                                                "sense_id": "6d05ea19-36d8-3492-9574-a7dc4bb1d7a2",
                                                "text": "1972, in U.S. Senate Subcommittee to Investigate the Administration of the Internal Security Act and Other Internal Security Laws, Abuse of psychiatry for political repression in the Soviet Union. Hearing, Ninety-second Congress, second session, United States Government Printing Office, page 127,\nIt’s quite possible, in view of the diagnosis ‘danger of miscarriage’, that they might drag me off, give me a scrape and then say that the miscarriage began itself."
                                            },
                                            {
                                                "example_id": "1d3b3f08-ffc5-4015-b8ea-220ca12e0e4b",
                                                "sense_id": "6d05ea19-36d8-3492-9574-a7dc4bb1d7a2",
                                                "text": "In expert hands abortion nowadays is almost the same as having a scrape (D & C) and due to improved techniques such as suction termination, and improved lighter anaesthetic, most women feel no worse than having a tooth out."
                                            },
                                            {
                                                "example_id": "1420b387-ebb0-41b7-8134-48667cbe9fb4",
                                                "sense_id": "6d05ea19-36d8-3492-9574-a7dc4bb1d7a2",
                                                "text": "The loss is significant to the woman and will be stated as such by her. For her it is not “nothing,” “just a scrape,” or “not a life.” It is the beginning of a baby. Years later, she may recall it not just as a miscarriage but also as a baby that was lost."
                                            },
                                            {
                                                "example_id": "67be2b6b-b508-4fb8-9771-7ff522a3f782",
                                                "sense_id": "6d05ea19-36d8-3492-9574-a7dc4bb1d7a2",
                                                "text": "17.Have you had a scrape or curettage recently?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3239cdb1-d875-366d-877e-5e6084aae650",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "A shallow depression used by ground birds as a nest; a nest scrape."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a9a0f4-78d4-4a1e-86fb-35823ff0e183",
                                                "sense_id": "3239cdb1-d875-366d-877e-5e6084aae650",
                                                "text": "We knew from U. Weidmann’s work (1956) that Black-headed Gulls could be prevented from laying by offering them eggs on the empty scrape veil before […]"
                                            },
                                            {
                                                "example_id": "5e78eb18-dac3-4434-be97-564302d3a20e",
                                                "sense_id": "3239cdb1-d875-366d-877e-5e6084aae650",
                                                "text": "The plover lays its eggs in a scrape on the ground. ¶ […] ¶ Birds’ nests can be little more than a scrape in the ground or a delicate structure of plant material, mud, and saliva."
                                            },
                                            {
                                                "example_id": "fc5898ac-8bbe-42f8-83e4-e07bff6c54aa",
                                                "sense_id": "3239cdb1-d875-366d-877e-5e6084aae650",
                                                "text": "Turkey females place their eggs in a shallow scrape in a hidden spot on the ground. Young are born ready to leave the nest and feed themselves (eating insects for their first few weeks)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969343c4-5f8b-396e-a092-9449ba8ab774",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "A shallow pit dug as a hideout."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113ab127-fe3c-4b33-a9f6-ad1efdec049c",
                                                "sense_id": "969343c4-5f8b-396e-a092-9449ba8ab774",
                                                "text": "In between rounds, he dug a scrape for himself with his entrenching tool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de8d6c6-e218-35ce-91ed-453deef3db3f",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "A shave."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cdd7bf2-1971-40e9-8086-d18f3c4fe6c7",
                                                "sense_id": "1de8d6c6-e218-35ce-91ed-453deef3db3f",
                                                "text": "A'm goin to the barber's for a scrape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b3bb0ad-ba16-3ef6-9ca8-e2c7d42b74b7",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "Cheap butter."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "690d8498-f8a9-322d-9b82-e2091c2e2d89",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
                                            "Butter laid on bread in the thinnest possible manner, as though laid on and scraped off again."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d14f82-726e-4370-901b-1a16b35b8ca9",
                                                "sense_id": "690d8498-f8a9-322d-9b82-e2091c2e2d89",
                                                "text": "“Got a nice bit of haddock for tonight. Thought I might do it with a poached egg, bit of pepper, bread and scrape”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac10979-91f3-389b-9421-f2cf41caf2fc",
                                        "entry_id": "6aa56d3b-b995-3c43-be1f-c3424b0c5507",
                                        "glosses": [
