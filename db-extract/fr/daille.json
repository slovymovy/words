                        "glosses": [
                            "Variante féminine de dail, sorte de faux à manche court."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c318d750-35bb-4e29-9f42-0e1afb33eefa",
                                "sense_id": "bdb43f59-7b58-35d4-b475-77862917a66a",
                                "text": "Va chercher la daille, on va aller couper l’herbe derrière la maison."
                            },
                            {
                                "example_id": "2cc689b0-996f-4e81-8556-5b0b182273f9",
                                "sense_id": "bdb43f59-7b58-35d4-b475-77862917a66a",
                                "text": "Pour mon regard neuf, chaque détail de mon univers était source d'étonnements, de l'intensité du bleu du ciel aux herbes de notre courette deux fois plus hautes que moi. Munie d'une daille, ma mère leur coupait à ras le pied l'envie de s'étendre. Avec un râteau, elle en faisait ensuite un tas qu'elle poussait jusqu'au bord de la route."
                            }
                        ]
                    }
                ],
