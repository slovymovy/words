                    {
                        "sense_id": "155f11d1-f764-3aa4-9fc9-ce5445c9aeab",
                        "entry_id": "b6aa4d65-d0bc-3a3c-a733-ef4d598e66e5",
                        "glosses": [
                            "Trop, de trop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4548c57d-04a6-478c-aaf5-fb382b0fba00",
                                "sense_id": "155f11d1-f764-3aa4-9fc9-ce5445c9aeab",
                                "text": "It is a little remarkable, that—though disinclined to talk overmuch of myself and my affairs at the fireside, and to my personal friends—an autobiographical impulse should twice in my life have taken possession of me, in addressing the public. (The Scarlet Letter - Nathaniel Hawthorne)"
                            }
                        ]
                    }
