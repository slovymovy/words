                {
                    "sense_id": "c711852b-432f-33db-bee4-def3bbb75395",
                    "sense_definition": "Gefühle oder Gedanken wie Hoffnung, Zweifel oder Verdacht wachhalten, unterstützen oder verstärken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrakt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine widersprüchlichen Aussagen <w>nährten</w> den Verdacht der Ermittler nur noch weiter."
                        },
                        {
                            "text": "Die ersten Erfolge bei den Verhandlungen <w>nähren</w> die Hoffnung auf einen baldigen Frieden."
                        }
                    ],
                    "synonyms": [
                        "fördern",
                        "schüren",
                        "verstärken"
                    ],
                    "antonyms": [
                        "zerstreuen"
                    ],
                    "common_phrases": [
                        "die Hoffnung nähren",
                        "den Verdacht nähren",
                        "Zweifel nähren"
                    ]
                },
                {
                    "sense_id": "d4d6a663-daa3-313e-82b8-0d108e705c46",
                    "sense_definition": "jemandem oder einem Tier Nahrung geben und mit lebensnotwendigen Stoffen versorgen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nahrungsaufnahme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Vogeleltern <w>nähren</w> ihre Jungen unermüdlich vom frühen Morgen bis zum späten Abend."
                        },
                        {
                            "text": "Im strengen Winter <w>nährt</w> der Bauer das Vieh im Stall mit getrocknetem Heu."
                        }
                    ],
                    "synonyms": [
                        "ernähren",
                        "füttern"
                    ]
                },
                {
