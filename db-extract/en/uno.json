                                                "example_id": "c7759634-b946-494d-90aa-f8bd784ea335",
                                                "sense_id": "634ddf43-2152-35d5-aea6-0e344770e267",
                                                "text": "Malgré ce succès « so french », le top des jeux les plus vendus reste marqué par les mêmes titres depuis des décennies : Monopoly, Scrabble, Cluedo, Uno…"
                                            },
                                            {
                                                "example_id": "53e997e3-88cf-4fe0-b7ea-54c13d607045",
                                                "sense_id": "634ddf43-2152-35d5-aea6-0e344770e267",
                                                "text": "Grand classique des jeux de cartes, le Uno s’adapte aux petits comme aux grands."
                                            },
                                            {
                                                "example_id": "1bd984c4-faf7-4895-9f75-77f1c641401f",
                                                "sense_id": "634ddf43-2152-35d5-aea6-0e344770e267",
                                                "text": "Le Uno est un jeu de société que l’on retrouve dans toutes les familles de par sa simplicité et son côté ludique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
