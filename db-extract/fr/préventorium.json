                        ],
                        "form": "préventoriums"
                    },
                    {
                        "form_id": "13223abd-3d29-495c-8bcb-accec4132312",
                        "entry_id": "c9774b39-7a96-3bfa-9b40-5a9ef6e7d837",
                        "tags": [],
                        "form": "preventorium"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25691296-6c59-3c20-b455-51c070c87e0d",
                        "entry_id": "c9774b39-7a96-3bfa-9b40-5a9ef6e7d837",
                        "glosses": [
                            "Institution pour des patients (principalement des enfants) infectés par la tuberculose qui n’ont pas encore la forme active de la maladie, et depuis les années 1990 aussi pour des patients atteints d’obésité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a21e734-4256-4de3-b853-19eda907f1b6",
                                "sense_id": "25691296-6c59-3c20-b455-51c070c87e0d",
                                "text": "Avant le sana, j’étais fille de cuisine dans un préventorium d’enfants, du côté d’Hyères, dans le midi."
                            },
                            {
                                "example_id": "0f75bba9-2ab4-456e-83f0-6b75725e3820",
                                "sense_id": "25691296-6c59-3c20-b455-51c070c87e0d",
                                "text": "Le Préventorium marin est un centre médical pédiatrique qui s’est spécialisé des années durant dans les soins aux maladies pulmonaires chroniques. Le traitement de l’obésité juvénile est venu s’y ajouter en 1994"
                            },
                            {
                                "example_id": "3d7a21af-6fe2-4e1c-919a-e9fca24428bd",
                                "sense_id": "25691296-6c59-3c20-b455-51c070c87e0d",
                                "text": "De Wever reversera les bénéfices de la vente du livre au préventorium du Coq, qui fait office d’institut précurseur dans le traitement de l’obésité des enfants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9441cf02-5383-4ec2-bd12-78284942dc52",
                        "source_entry_id": "c9774b39-7a96-3bfa-9b40-5a9ef6e7d837",
                        "source_sense_id": "25691296-6c59-3c20-b455-51c070c87e0d",
                        "target_lang_word": "preventorium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preventorium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "332921a5-27cd-3d74-9baa-29660cc9d7a8",
                                        "entry_id": "4046cf7a-2433-3365-9943-4044a015db1b",
                                        "glosses": [
                                            "An institution or building for the isolation of patients infected with tuberculosis who did not yet have an active form of the disease."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac6b16f-8629-498f-a595-eb07fbf08639",
                                                "sense_id": "332921a5-27cd-3d74-9baa-29660cc9d7a8",
                                                "text": "The preventorium, located on the west slope of the Tucson Mountains, began at a former Civilian Conservation Corps Camp Papago in 1934 and remained in operation until 1945. The preventorium served as a refuge for children in danger of contracting tuberculosis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
