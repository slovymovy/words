                        ]
                    },
                    {
                        "translation_id": "37ab31ec-8911-4432-8ef9-80f39f06d806",
                        "source_entry_id": "74d16a3f-3cad-3918-a402-b73810d77eb4",
                        "source_sense_id": "ccbdccd5-c0e6-39c1-a05b-ad1a705034ed",
                        "target_lang_word": "кувшинка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кувшинка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4db88d1a-9bae-3d0b-9271-32c22c7cebc1",
                                        "entry_id": "7987c8b3-9730-3582-9000-ea1b39f2aa72",
                                        "glosses": [
                                            "ботан. водное травянистое растение с крупными плавающими листьями, развитыми корневищами и одиночными цветками на длинных цветоножках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b90b7c91-136e-4008-bae2-2b10e5c5aa5d",
                                                "sense_id": "4db88d1a-9bae-3d0b-9271-32c22c7cebc1",
                                                "text": "В реке росло множество кувшинок; их широкие зелёные листья плавали по поверхности воды."
                                            },
                                            {
                                                "example_id": "c68dd4ef-890a-4487-a99a-246f78e9dd12",
                                                "sense_id": "4db88d1a-9bae-3d0b-9271-32c22c7cebc1",
                                                "text": ".. в старом парке господ Заусайловых был большой пруд, густо заросший кувшинками."
                                            },
                                            {
                                                "example_id": "37411bd4-e9af-4602-9156-69c68e627082",
                                                "sense_id": "4db88d1a-9bae-3d0b-9271-32c22c7cebc1",
                                                "text": "Представьте себе озеро, всё поросшее кувшинками с их белыми венчиками и жёлтыми тычинками, и кругом большие зелёные листья."
                                            },
                                            {
                                                "example_id": "bdb0f9be-6f8b-4d63-98af-0e0e7ed2fa2e",
                                                "sense_id": "4db88d1a-9bae-3d0b-9271-32c22c7cebc1",
                                                "text": "Замедление течения в реке тотчас сказалось на растительности. Появились лилии, кувшинки, курослеп, водяной орех и т. д."
                                            },
                                            {
                                                "example_id": "376ff62a-b710-4fd9-b8c6-ae4a7770b035",
                                                "sense_id": "4db88d1a-9bae-3d0b-9271-32c22c7cebc1",
                                                "text": "Река Оредеж. Тёмная, торфяная вода, пиявки у берега, множество кувшинок. Не кувшинок — водяных лилий. Белые, душистые, с ярко-жёлтыми, шафранными сердцевинами."
                                            },
                                            {
                                                "example_id": "5aeb7267-0462-407a-a95d-4ad79d22b687",
                                                "sense_id": "4db88d1a-9bae-3d0b-9271-32c22c7cebc1",
                                                "text": "В дикой природе насчитывается с полсотни видов водяных лилий, или кувшинок (по-научному — нимфей). Их цветки отличаются большим многообразием — при диаметре от 2 до 30 см они могут иметь практически любую окраску."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
