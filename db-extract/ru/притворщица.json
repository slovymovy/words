                        "examples": [
                            {
                                "example_id": "626673dc-9c13-48bd-949f-e9721f97110a",
                                "sense_id": "263a0b81-c965-3058-bd37-06648ca3ba10",
                                "text": "И на платье никаких следов крови. Притворщица! А я-то поверил, что она умерла!"
                            },
                            {
                                "example_id": "b759475c-77d0-43d2-bf4d-19550467f842",
                                "sense_id": "263a0b81-c965-3058-bd37-06648ca3ba10",
                                "text": "И никакая она не больная, твоя мамаша, а просто притворщица."
                            }
                        ]
                    }
