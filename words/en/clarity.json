                {
                    "sense_id": "0b0d77c9-dd32-3dbb-b0fb-84899c5b234c",
                    "sense_definition": "The ability to think clearly, rationally, and without confusion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meditation helps him achieve a state of mental <w>clarity</w> and focus.",
                            "target_lang_translations": {
                                "ru": "Медитация помогает ему достичь состояния <w>ясности</w> ума и сосредоточенности.",
                                "pl": "Medytacja pomaga mu osiągnąć stan <w>jasności</w> umysłu i skupienia."
                            }
                        },
                        {
                            "text": "In a sudden moment of <w>clarity</w>, she realized exactly what she needed to do.",
                            "target_lang_translations": {
                                "ru": "В момент внезапной <w>ясности</w> она поняла, что именно ей нужно сделать.",
                                "pl": "W nagłym momencie <w>jasności</w> zrozumiała dokładnie, co musi zrobić."
                            }
                        }
