                                "example_id": "64a07164-ad5e-42df-ae9d-8ff2110c54f3",
                                "sense_id": "6854e8b9-bddd-39f5-8e4b-4466ebb85def",
                                "text": "В 1991 году в Югославии было 23,5 миллиона жителей.",
