                        "examples": [
                            {
                                "example_id": "0eef5879-dcde-4123-9c70-2de488450d76",
                                "sense_id": "e21491fb-e4c0-3781-b4e4-c32454606d64",
                                "text": "That in the cale where the Teind was set separately from the Stock, the Duty was commonly far above the true Value of what was paid for the Teind"
                            },
                            {
                                "example_id": "5bc4e216-36a9-4b17-9830-e1d657629bcf",
                                "sense_id": "e21491fb-e4c0-3781-b4e4-c32454606d64",
                                "text": "What have I been paying stipend and teind parsonage and vicarage for, ever sin' the aughty-nine, an' I canna get a spell of a prayer for't, the only time I ever asked for ane in my life?"
                            }
                        ]
                    }
