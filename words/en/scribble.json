{
    "word_family": [
        "scribbler",
        "scribbly",
        "scribbling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "068ace5a-02ab-36a4-bebe-7df6346a8349",
                    "sense_definition": "To write or draw something quickly and carelessly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing_carelessly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I suddenly remembered I needed to buy bleach, so <w>scribbled</w> it down on my shopping list.",
                            "target_lang_translations": {
                                "ru": "Я вдруг вспомнил, что мне нужно купить отбеливатель, и быстро <w>записал</w> это в список покупок."
                            }
                        },
                        {
                            "text": "He had to <w>scribble</w> a note before leaving the house.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>черкнуть</w> записку перед выходом из дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrawl"
                    ],
                    "common_phrases": [
                        "scribble a note",
                        "scribble down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать или рисовать что-либо быстро и небрежно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черкнуть",
                                "target_lang_sense_clarification": "написать быстро"
                            },
                            {
                                "target_lang_word": "нацарапать",
                                "target_lang_sense_clarification": "написать небрежно"
                            },
                            {
                                "target_lang_word": "записать",
                                "target_lang_sense_clarification": "быстро набросать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3aa0dfa-3714-38b4-9af7-1ced17263bfa",
                    "sense_definition": "To make meaningless marks or simple drawings, often while thinking about something else.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "doodling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student began to <w>scribble</w> in the margins of his notebook during the long lecture.",
                            "target_lang_translations": {
                                "ru": "Во время долгой лекции студент начал <w>рисовать каракули</w> на полях своей тетради."
                            }
                        },
                        {
                            "text": "Children love to <w>scribble</w> on any piece of paper they can find.",
                            "target_lang_translations": {
                                "ru": "Дети обожают <w>калякать</w> на любом клочке бумаги, который смогут найти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scribble in margins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать бессмысленные пометки или простые рисунки, часто отвлекаясь на другие мысли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марать бумагу",
                                "target_lang_sense_clarification": "рисовать каракули"
                            },
                            {
                                "target_lang_word": "рисовать каракули",
                                "target_lang_sense_clarification": "бессмысленные рисунки"
                            },
                            {
                                "target_lang_word": "черкаться",
                                "target_lang_sense_clarification": "делать пометки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a28e1e08-06c4-3917-b0a9-009547e174ba",
                    "sense_definition": "To write poorly or to work as an unskilled or unimportant author or journalist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his years <w>scribbling</w> for local tabloids without ever gaining recognition.",
                            "target_lang_translations": {
                                "ru": "Он годами <w>писакал</w> для местных таблоидов, так и не добившись признания."
                            }
                        },
                        {
                            "text": "Many critics dismissed him as a man who would simply <w>scribble</w> for whoever paid him.",
                            "target_lang_translations": {
                                "ru": "Многие критики пренебрежительно называли его человеком, который просто <w>марал бумагу</w> для любого, кто платил."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать плохо или работать неквалифицированным, малозначимым автором или журналистом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марать бумагу",
                                "target_lang_sense_clarification": "писать плохие тексты"
                            },
                            {
                                "target_lang_word": "писакать",
                                "target_lang_sense_clarification": "пренебрежительно о писательстве"
                            },
                            {
                                "target_lang_word": "строчить",
                                "target_lang_sense_clarification": "писать много и некачественно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61ecb06e-edc8-395b-b087-0180f66a8380",
                    "sense_definition": "To card or tease wool coarsely before spinning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory workers would <w>scribble</w> the raw wool to prepare it for the next stage.",
                            "target_lang_translations": {
                                "ru": "Рабочие фабрики <w>чесали</w> сырую шерсть, чтобы подготовить её к следующему этапу."
                            }
                        },
                        {
                            "text": "It is necessary to <w>scribble</w> the fibers thoroughly to ensure a smooth yarn.",
                            "target_lang_translations": {
                                "ru": "Необходимо тщательно <w>трепать</w> волокна, чтобы обеспечить гладкость пряжи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубо чесать или разрыхлять шерсть перед прядением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесать",
                                "target_lang_sense_clarification": "шерсть"
                            },
                            {
                                "target_lang_word": "трепать",
                                "target_lang_sense_clarification": "волокна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cb3350e-6611-32fc-860e-ac1de621ebe0",
                    "sense_definition": "A piece of careless, hasty writing or a simple, messy drawing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing_carelessly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could barely read the messy <w>scribble</w> at the bottom of the page.",
                            "target_lang_translations": {
                                "ru": "Я едва мог разобрать небрежные <w>каракули</w> внизу страницы."
                            }
                        },
                        {
                            "text": "The toddler's drawing was just a colorful <w>scribble</w> on the wall.",
                            "target_lang_translations": {
                                "ru": "Рисунок малыша был просто разноцветной <w>мазнёй</w> на стене."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrawl"
                    ],
                    "common_phrases": [
                        "messy scribble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небрежная, поспешная запись или простой, беспорядочный рисунок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каракули",
                                "target_lang_sense_clarification": "неразборчивое письмо"
                            },
                            {
                                "target_lang_word": "закорючка",
                                "target_lang_sense_clarification": "небрежный знак"
                            },
                            {
                                "target_lang_word": "мазня",
                                "target_lang_sense_clarification": "небрежный рисунок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}