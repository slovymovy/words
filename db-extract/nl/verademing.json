            {
                "entry_id": "94894018-65a1-32b9-b12c-1665ed26f9f7",
                "word": "verademing",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "52a0fd44-6324-4544-a035-ab87dee83f05",
                        "entry_id": "94894018-65a1-32b9-b12c-1665ed26f9f7",
