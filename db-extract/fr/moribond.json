                    {
                        "sense_id": "78d400d4-9a7b-37c7-a265-50541fc1fca9",
                        "entry_id": "8ebf6531-920f-3569-9e22-4e20211213a0",
                        "glosses": [
                            "Qui va mourir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d3bd79-e528-430d-85de-2085503052aa",
                                "sense_id": "78d400d4-9a7b-37c7-a265-50541fc1fca9",
                                "text": "Du feu moribond ne subsistait qu'un banc de cendres grises."
                            },
                            {
                                "example_id": "2285c315-6a82-4d15-92c7-32c8e5b9e659",
                                "sense_id": "78d400d4-9a7b-37c7-a265-50541fc1fca9",
                                "text": "Il estimait que la Compagnie noire et l'assaut du château noir pouvaient grandement contribuer à guérir un corps social moribond."
                            },
                            {
                                "example_id": "7015359e-b1b7-4864-b73f-692c32341337",
                                "sense_id": "78d400d4-9a7b-37c7-a265-50541fc1fca9",
                                "text": "Donald Trump répète constamment qu’il a hérité d’une économie moribonde et en a fait la meilleure économie de tous les temps avant que la pandémie y mette un frein."
                            }
                        ]
                    }
