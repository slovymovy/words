                                            {
                                                "example_id": "e3ca7de0-c1c6-4f53-8ad2-f0e22916256f",
                                                "sense_id": "6e62bea5-e84a-36e9-bb73-7db4d2700ea2",
                                                "text": "baseline wander in ECG signals"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79c12e22-a90d-441a-8925-ffdd24494f03",
                        "source_entry_id": "353f8181-2fd9-30c8-b71f-d48efcbaa27d",
                        "source_sense_id": "8f8a79fc-f481-3636-a35c-33cb30333e21",
                        "target_lang_word": "roam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be1b83c-ea22-38b7-b9d3-dd5ce1927897",
                                        "entry_id": "c36ed5aa-f2b9-35e2-b47b-0247b89f5130",
                                        "glosses": [
                                            "To wander or travel freely and with no specific destination."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c87c2ba-3a71-4986-8425-80c0afd1e706",
                                                "sense_id": "8be1b83c-ea22-38b7-b9d3-dd5ce1927897",
                                                "text": "Henceforth, wherever thou may’st roam,\n⁠My blessing, like a line of light,\n⁠Is on the waters day and night,\nAnd like a beacon guards thee home."
                                            },
                                            {
                                                "example_id": "3a7a83de-8074-4b1d-832c-abfe20e0055d",
                                                "sense_id": "8be1b83c-ea22-38b7-b9d3-dd5ce1927897",
                                                "text": "Oh, never will I roam / Now I know my place is home / Where the ocean meets the sky / I'll be sailin'"
                                            },
                                            {
                                                "example_id": "e37cff6b-1956-48a8-844d-a4c58f318041",
                                                "sense_id": "8be1b83c-ea22-38b7-b9d3-dd5ce1927897",
                                                "text": "Wilshere had started as a left-footed right-winger, coming in off the flank, but he and Özil both had the licence to roam. Tomas Rosicky was not tied down to one spot either and, with Ramsey breaking forward as well as Olivier Giroud's considerable presence, Marseille were overwhelmed from the moment Bacary Sagna's first touch of the night sent Wilshere running clear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bdab699-2122-3655-b98f-3ecbe27eddb5",
                                        "entry_id": "c36ed5aa-f2b9-35e2-b47b-0247b89f5130",
                                        "glosses": [
                                            "To range or wander over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0689f8f8-ec4b-458d-bfc6-b30794bbe9a6",
                                                "sense_id": "0bdab699-2122-3655-b98f-3ecbe27eddb5",
                                                "text": "Gangs of thugs roamed the streets."
                                            },
                                            {
                                                "example_id": "a891fc99-0f57-468c-8273-f4f8816d5fcd",
                                                "sense_id": "0bdab699-2122-3655-b98f-3ecbe27eddb5",
                                                "text": "And now wild beasts came forth the woods to roam."
                                            },
                                            {
                                                "example_id": "1f9e7546-2566-4fc5-a546-9a6a2dad73af",
                                                "sense_id": "0bdab699-2122-3655-b98f-3ecbe27eddb5",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9673e045-db40-3d91-ab5f-cf8613b9ae0e",
                                        "entry_id": "c36ed5aa-f2b9-35e2-b47b-0247b89f5130",
                                        "glosses": [
                                            "To use a network or service from different locations or devices."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d403cfbc-e615-3d27-a841-121d374ca0cb",
                                        "entry_id": "c36ed5aa-f2b9-35e2-b47b-0247b89f5130",
                                        "glosses": [
                                            "To transmit (resources) between different locations or devices, to allow comparable usage from any of them."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f394493a-4f37-45ab-b954-415a8b127cfd",
                                                "sense_id": "d403cfbc-e615-3d27-a841-121d374ca0cb",
                                                "text": "At first, it seemed counterintuitive to me to roam settings between computers, but my problem at the time was that every example I was considering was a setting that only made sense for a single computer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f658c8-8a21-3af7-ac8c-c3ce1c0741a8",
                                        "entry_id": "a82a7f00-55a4-3510-9e63-b4ccd38b1bbb",
                                        "glosses": [
                                            "The act of roaming; a wander; a travel without aim or destination"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7519aab7-93f2-4293-9dd4-c82b74c68c13",
                                                "sense_id": "c6f658c8-8a21-3af7-ac8c-c3ce1c0741a8",
                                                "text": "Glass in hand, he set off on a roam of the first floor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
