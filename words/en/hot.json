                {
                    "sense_id": "07e5c159-1082-397f-b683-df80ab61d3aa",
                    "sense_definition": "Of great current interest; provoking debate or controversy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Climate change remains a <w>hot</w> topic in international politics today.",
                            "target_lang_translations": {
                                "ru": "Изменение климата остается <w>горячей</w> темой в международной политике сегодня."
                            }
                        },
                        {
                            "text": "The news was <w>hot</w> off the press and everyone was talking about it.",
                            "target_lang_translations": {
                                "ru": "Новости были только что <w>из печати</w>, и все о них говорили."
                            }
                        }
                    ],
                    "synonyms": [
                        "current",
                        "controversial"
