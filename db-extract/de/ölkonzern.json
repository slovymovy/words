                "senses": [
                    {
                        "sense_id": "483a27d3-17e9-3085-92ca-4defb22f0518",
                        "entry_id": "04aa832b-a62d-31dd-9a6d-84fc3df460c6",
                        "glosses": [
                            "Großunternehmen, das Erdöl fördert, verarbeitet und mit Erdöl und Erdölprodukten handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba10785-f71a-45d7-abc3-fd07273e44b2",
                                "sense_id": "483a27d3-17e9-3085-92ca-4defb22f0518",
                                "text": "„Der Ölkonzern Exxon Mobil wusste intern bereits seit den 1970er-Jahren, dass fossile Brennstoffe das Klima aufheizen.“"
                            },
                            {
                                "example_id": "e966bdb8-751b-4e3a-941b-82197bc90d97",
                                "sense_id": "483a27d3-17e9-3085-92ca-4defb22f0518",
                                "text": "Der Ölkonzern geriet nach einer Panne bei der Förderung in die Kritik."
                            },
                            {
                                "example_id": "ea427af2-e51f-46d2-96d1-0bfee3bd2764",
                                "sense_id": "483a27d3-17e9-3085-92ca-4defb22f0518",
                                "text": "„Neben dem Unijob schreibt Sticco hydrologische Gutachten für Ölkonzerne.“"
                            },
                            {
                                "example_id": "c23f0b97-ace0-4705-b5a9-58505ec4df87",
                                "sense_id": "483a27d3-17e9-3085-92ca-4defb22f0518",
                                "text": "„Die Menschenrechtsorganisation Amnesty International hat dem Ölkonzern Shell vorgeworfen, die Ursachen für Öllecks in Nigeria zu verschleiern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
