                                "target_senses": [
                                    {
                                        "sense_id": "62453628-d941-375c-9b44-c7c82d4d76e2",
                                        "entry_id": "fcfc9c01-d3a2-3d9c-ab46-a52460b3c0a4",
                                        "glosses": [
                                            "psychologický směr zaměřující se na záznam závislostí mezi podněty a reakcemi a považující za základ výzkumu psychických procesů chování"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b00360b-acdf-4ac8-a814-62dd2a8675a7",
                        "source_entry_id": "554bc762-252e-3b3b-a2b0-c24cc8f2906d",
                        "source_sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                        "target_lang_word": "béhaviorisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béhaviorisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0ab7ac-827a-3bed-87e5-eb900a420707",
                                        "entry_id": "1f43caf6-a829-3695-a36e-e60f5a849d8b",
                                        "glosses": [
                                            "Étude du comportement, rejetant l’introspection, ramenant les conduites à une chaîne de stimulus et de réponses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f529033c-96c8-4a0b-bfea-1c127291b7b8",
                                                "sense_id": "1c0ab7ac-827a-3bed-87e5-eb900a420707",
                                                "text": "Le béhaviorisme s’est développé en réaction aux approches dites « mentalistes »."
                                            },
                                            {
                                                "example_id": "aeb33c5c-4260-4819-9beb-fffa27bfcd93",
                                                "sense_id": "1c0ab7ac-827a-3bed-87e5-eb900a420707",
                                                "text": "L’opposition entre le béhaviorisme et le cognitivisme fera l’objet de notre première sous-section."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7724c1b-0086-4c9b-9321-ed86dd473d9a",
                        "source_entry_id": "554bc762-252e-3b3b-a2b0-c24cc8f2906d",
                        "source_sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                        "target_lang_word": "comportementalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comportementalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4524c4fc-72b6-3bc2-b738-38134a0b12ec",
                                        "entry_id": "d44d46f6-9e81-3709-ae4a-b9ed7843e507",
                                        "glosses": [
                                            "Étude du comportement, rejetant l’introspection, ramenant les conduites à une chaîne de stimulus et de réponses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b55f8e6-9a61-47fc-a1f1-5f92b7902b95",
                                                "sense_id": "4524c4fc-72b6-3bc2-b738-38134a0b12ec",
                                                "text": "Le comportementalisme pragmatique a fait faire un bond en avant dans l’approche thérapeutique des maladies fonctionnelles et psychosomatiques, et particulièrement dans le domaine de la sexologie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdd68c36-41df-483e-a30c-2123576e7a66",
                        "source_entry_id": "554bc762-252e-3b3b-a2b0-c24cc8f2906d",
                        "source_sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                        "target_lang_word": "conductismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conductismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0198ccd2-e999-31a4-94ae-17ab6f731174",
                                        "entry_id": "d4348384-1ae2-3c42-87b6-47281fbaa975",
                                        "glosses": [
                                            "Es la filosofía de la psicología como ciencia del comportamiento, entendido éste como la interacción entre el individuo y su contexto físico, biológico y social, cubriendo así un amplio rango de fenómenos psicológicos en los planos lingüístico-cognitivo, emotivo-motivacional y motor-sensorial. El conductismo se basa en la proposición que establece que todas las cosas que un organismo hace incluyendo acciones, pensamientos y sentimientos pueden y deben ser consideradas comportamientos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0588dba-f224-4e07-87d4-dfcd6e369325",
                        "source_entry_id": "554bc762-252e-3b3b-a2b0-c24cc8f2906d",
                        "source_sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                        "target_lang_word": "Behaviorismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Behaviorismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e65cc526-be00-39a3-ac95-ffb3b39ddc9d",
                                        "entry_id": "eec1da93-c543-3a87-8830-dc4447192457",
                                        "glosses": [
                                            "Richtung der Psychologie, die nur das beobachtbare Verhalten untersucht und Introspektion/Selbstbeobachtung oder Sinnverstehen als unwissenschaftlich ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ea2f50-52e2-46a6-9b3c-37a0a6f4acc2",
                                                "sense_id": "e65cc526-be00-39a3-ac95-ffb3b39ddc9d",
                                                "text": "„Der Behaviorismus entstand im Anfang unseres Jahrhunderts in den USA als Forschungsrichtung der Psychologie, die, sich auf Pragmatismus, Positivismus und die Arbeiten I. P. Pavlovs über das erste und zweite Signalsystem stützend, als einzig objektive Methode die Beobachtung des Verhaltens zuläßt und die Kategorien Bewußtsein, Wille, Empfindung, Aufmerksamkeit usw. aus der Forschung als ‚mentalistisch‘ ausschließt.“"
                                            },
                                            {
                                                "example_id": "ac334b57-93c2-459a-be51-ecc0eb3fabf2",
                                                "sense_id": "e65cc526-be00-39a3-ac95-ffb3b39ddc9d",
                                                "text": "„Der auf Watson (1924) zurückgehende klassische Behaviorismus sieht beim Lernen eine Verknüpfung von einem Stimulus mit einem Response durch Konditionierung.“"
                                            },
                                            {
                                                "example_id": "77e77cfd-3879-41b7-b168-b0b55003694a",
                                                "sense_id": "e65cc526-be00-39a3-ac95-ffb3b39ddc9d",
                                                "text": "Im Behaviorismus wird Verhalten in Form von Reiz-Reaktions-Modellen beschrieben."
                                            },
                                            {
