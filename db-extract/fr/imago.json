                                                "sense_id": "f3593a72-9f90-31db-bf12-ff030af6740f",
                                                "text": "Ich habe eine schlechte Imago von dieser Person."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54278bf3-5925-4744-9dae-27999fb714e2",
                        "source_entry_id": "28519bae-a267-3c13-b6cc-c1404888e2c8",
                        "source_sense_id": "cd373cc1-5580-3da4-a539-47b6a3cef074",
                        "source_sense_description": "Forme adulte de l’insecte",
                        "target_lang_word": "imago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imago",
