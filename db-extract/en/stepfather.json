                                    {
                                        "sense_id": "226629dc-fcb7-33e3-93eb-d389adb1dfc2",
                                        "entry_id": "6aa6d9b6-14ff-3472-9f69-08f1051d43e2",
                                        "glosses": [
                                            "Beau-père, nouvel époux (ou compagnon) de la mère ou du père par rapport aux enfants de la première union."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce123c7-54e7-4745-9590-8a938c92ccbe",
                                                "sense_id": "226629dc-fcb7-33e3-93eb-d389adb1dfc2",
                                                "text": "S’il arrive de temps à autre que des enfants aient à se plaindre des traitements d’un parâtre ou d’une marâtre, ou seulement de certaines préférences, il n’en est pas moins vrai, […], les secondes noces, au lieu d’être un mal pour eux, leurs sont incontestablement avantageuses."
                                            },
                                            {
                                                "example_id": "83e3ee4c-9079-41af-9b56-f7d8e7dd96cd",
                                                "sense_id": "226629dc-fcb7-33e3-93eb-d389adb1dfc2",
                                                "text": "Pour reparler du conseil, je vais vous dire : ceux qui en seront vont vite se demander pourquoi vous voilà, vous, le parâtre, si fort incrusté auprès de jeunes filles qui ne vous sont rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d65e1d0d-1144-30e8-a7a2-b3abfed0a91e",
                                        "entry_id": "6aa6d9b6-14ff-3472-9f69-08f1051d43e2",
                                        "glosses": [
                                            "Mauvais père."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ea87a24-a7c8-4892-a52e-9148b35ed44e",
                        "source_entry_id": "2f6bbf37-609a-3329-930a-717771739709",
                        "source_sense_description": "husband of one's biological mother, other than one's biological father",
                        "target_lang_word": "Stiefvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                        "entry_id": "69b5ee0d-3122-3224-b605-88f1d9e34246",
                                        "glosses": [
                                            "der nach einer Wiederverheiratung der Mutter (infolge von Tod oder Scheidung) neue Ehemann der Mutter, der mit seinem Stiefkind (Stieftochter, Stiefsohn) nicht leiblich verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb013db-d4c2-48bc-878c-5ca990980073",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "Ich verstehe mich mit meinem Stiefvater sehr gut."
                                            },
                                            {
                                                "example_id": "b45e97df-a572-4b9e-83e0-a6e9b8ad7f5c",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Der Stiefvater wusste, dass der Oberst ein Theaterliebhaber war und hatte ihm von dem Theaterinteresse seines Stiefsohnes erzählt.“"
                                            },
                                            {
                                                "example_id": "a85c7a71-419d-41d2-a37d-f0b6a5997424",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Damals bekam Lea fast gleichzeitig mit einer Adoptivschwester auch einen Stiefvater.“"
                                            },
                                            {
                                                "example_id": "6a13b6a1-cf1d-402c-a5a8-24e184bf7338",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Dass sein Stiefvater Ingvald sich noch mehr über seine Besuche freute und sie als Ritterschlag wertete, ahnte der Junge nicht.“"
                                            },
                                            {
                                                "example_id": "dc389e1b-1fc2-4a43-82a7-fb9a943bf339",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Der Stiefvater zuckt die Achseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ab269b8-5de2-4e88-a683-da6d1b1630d2",
                        "source_entry_id": "2f6bbf37-609a-3329-930a-717771739709",
