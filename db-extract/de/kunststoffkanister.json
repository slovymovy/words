                "senses": [
                    {
                        "sense_id": "07e46240-3562-3674-9fb3-b560d3a7a2db",
                        "entry_id": "fd55383a-a979-3763-a3d7-17d8d52c9300",
                        "glosses": [
                            "verschließbarer, eckiger Kunststoffbehälter, der zum Transport und Aufbewahren von Flüssigkeiten (Wasser, Öl, Treibstoff) benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc1fd84-23fd-4ea0-8c07-25ed3ea584b8",
                                "sense_id": "07e46240-3562-3674-9fb3-b560d3a7a2db",
                                "text": "„Die Kunststoffkanister der Premium Serie (5L, 10L, 15L, 20L, 25L und 30L) werden aus umweltfreundlichem, hochmolekularem Niederdruck-Polyethylen hergestellt.“"
                            },
                            {
                                "example_id": "7f1b9740-5c41-4434-bcb9-a6d73f712c1e",
                                "sense_id": "07e46240-3562-3674-9fb3-b560d3a7a2db",
                                "text": "„Erfüllen Ihre Kunststoffkanister nicht die angegeben Maße, sprechen Sie uns bitte an.“"
                            },
                            {
                                "example_id": "4a0edf3f-4625-45c7-aed4-eb11c17837d5",
                                "sense_id": "07e46240-3562-3674-9fb3-b560d3a7a2db",
                                "text": "„Verwenden Sie vorzugsweise lichtundurchlässige Kunststoffkanister.“"
                            },
                            {
                                "example_id": "f37f85e1-ab81-4394-9e6b-f272b942064b",
                                "sense_id": "07e46240-3562-3674-9fb3-b560d3a7a2db",
                                "text": "„Die Mauser-Gruppe, Hersteller von Industrieverpackungen mit Sitz in Brühl, baut ihre Fertigungskapazitäten für Kunststoffkanister im Werk Hamburg-Harburg aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
