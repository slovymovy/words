                        "examples": [
                            {
                                "example_id": "7bbb515d-77a7-433b-bb72-043fc352a031",
                                "sense_id": "92d3e788-b293-30f2-ba24-ede6785757b0",
                                "text": "Er werden bloemen gebracht en Désiree hield een slottoespraak."
                            },
                            {
                                "example_id": "d0b97aca-c34c-4ffb-a8d4-76da64ec7dd2",
                                "sense_id": "92d3e788-b293-30f2-ba24-ede6785757b0",
                                "text": "Premier David Cameron heeft de Britse kiezers een aanzienlijke belastingverlaging in het vooruitzicht gesteld als ze hem volgend jaar herkiezen. Cameron deed de belofte in zijn slottoespraak op het congres van de Conservatieve Partij in Birmingham."
                            },
                            {
                                "example_id": "b0a09dc4-cf4c-405a-b465-178f2f5e64a3",
                                "sense_id": "92d3e788-b293-30f2-ba24-ede6785757b0",
                                "text": "De leider van de Britse sociaal-democraten, Jeremy Corbyn, wil een zachte brexit. In zijn slottoespraak op het Labour-congres in Liverpool zei hij dat premier Theresa May alleen op zijn steun kan rekenen als ze haar 'Chequers'-plan intrekt of grondig afzwakt."
                            }
                        ]
                    }
