                        "sense_id": "e0bd5110-b9a5-3fe2-8093-7565908822b7",
                        "entry_id": "0e37e6d9-3309-36e6-ade2-ea8652720962",
                        "glosses": [
                            "Bereich, der stark vom Vorhandensein von Trümmern geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ce143f2-1092-48fe-9f3f-20cc13fafdac",
                                "sense_id": "e0bd5110-b9a5-3fe2-8093-7565908822b7",
                                "text": "„Schutt war das Einzige, was es mehr als reichlich gab in der Trümmerwelt, die der Krieg hinterlassen hatte: rund 400 Millionen Kubikmeter.“"
                            },
                            {
                                "example_id": "5dfff796-0017-4be9-996a-7659d2c11870",
                                "sense_id": "e0bd5110-b9a5-3fe2-8093-7565908822b7",
                                "text": "„Über den zugeschütteten Grundstücken und den durch die Trümmerwelt verwischten Straßenzügen ziehen sich nach einigen Tagen Trampelpfade, die auf legere Weise an frühere Wegverbindungen anknüpfen.“"
                            }
                        ],
