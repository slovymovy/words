                "senses": [
                    {
                        "sense_id": "47c6c0b4-6699-39ef-8141-575b1f4e4c28",
                        "entry_id": "625ada1f-f166-3494-8345-3f54adc7d1fc",
                        "glosses": [
                            "Streit, bei dem es um die Aufteilung einer Erbschaft geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "666b6292-54a4-4e3d-9051-fe7268928b7f",
                                "sense_id": "47c6c0b4-6699-39ef-8141-575b1f4e4c28",
                                "text": "„Die Familie Stieg Larssons sucht im Erbschaftsstreit nach einem Kompromiss: Sie will die Lebensgefährtin abfinden, die um einen größeren Anteil am Millionen-Erbe des verstorbenen Bestseller-Autors kämpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd762a5d-356d-4b07-8b95-fdfc7023421f",
                        "source_entry_id": "625ada1f-f166-3494-8345-3f54adc7d1fc",
                        "source_sense_id": "47c6c0b4-6699-39ef-8141-575b1f4e4c28",
                        "source_sense_description": "Streit, bei dem es um die Aufteilung einer Erbschaft geht",
                        "target_lang_word": "torpedo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torpedo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "772c89d4-106a-3db9-9d17-dae489fa22e9",
                                        "entry_id": "0425cee7-93b9-3aac-a30c-86d34d60c8a0",
                                        "glosses": [
                                            "An electric ray of the genus Torpedo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430105d8-e4d5-4e65-9ed1-0f02f834e750",
                                                "sense_id": "772c89d4-106a-3db9-9d17-dae489fa22e9",
                                                "text": "Faire Queene, forbeare to angle for the fiſh, / Which being caught, ſtrikes him that takes it dead, / I meane that vile Torpedo, Gaueſton, / That now I hope flotes on the Iriſh Seas"
                                            },
                                            {
                                                "example_id": "6a40cb56-c918-4d5b-8e32-f5b4fb08e5f4",
                                                "sense_id": "772c89d4-106a-3db9-9d17-dae489fa22e9",
                                                "text": "The man has been changed into an artificial monster by the station in which he is born, and the consequent homage that benumbed his faculties like the torpedo's touch […]."
                                            },
                                            {
                                                "example_id": "64ce98da-db5b-4410-bd4e-e33012b9032f",
                                                "sense_id": "772c89d4-106a-3db9-9d17-dae489fa22e9",
                                                "text": "\"A childhood Misadventure with a Torpedo,\" Dixon, with a brief move of his head toward Mason, confides, \"— thus his Sensitivity at all References to the,\"— whispering,— \"electrickal!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494c9b6f-246c-342e-9ffb-5a8e14b80eaa",
                                        "entry_id": "0425cee7-93b9-3aac-a30c-86d34d60c8a0",
                                        "glosses": [
                                            "A cylindrical explosive projectile that can travel underwater and is used as a weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a0c1c92-3dfc-42e6-933c-9a78ce31a50e",
                                                "sense_id": "494c9b6f-246c-342e-9ffb-5a8e14b80eaa",
                                                "text": "I stood rigid, spellbound, watching the white wake of the torpedo. It struck us on the starboard side almost amidships. The vessel rocked as though the sea beneath it had been uptorn by a mighty volcano."
                                            },
                                            {
                                                "example_id": "1399d390-e13d-468c-8822-ba2e444f8795",
                                                "sense_id": "494c9b6f-246c-342e-9ffb-5a8e14b80eaa",
                                                "text": "Four Japanese torpedo boats launch an attack on the Suvorov. Despite burning steadily for several hours and now taking a torpedo to the stern, the ship still lashes out at its attackers with a few remaining guns. With no pressing need to continue the attack to closer range, the torpedo boats fall back, noting the position for a night attack if Suvorov survives that long."
                                            },
                                            {
                                                "example_id": "582e6ae1-bf82-4f1d-88be-2525969de607",
                                                "sense_id": "494c9b6f-246c-342e-9ffb-5a8e14b80eaa",
                                                "text": "And if fate should turn her back on them, or turn away from them, leaving them to their own devices, and should they find themselves be sore afraid, then they would simply sail away to the other side of the world. They would ride like the wind. They would sail once more into the breach and damn the torpedos! God save the Queen! And the devil take the hindmost!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0eafa0c-193d-3f98-8c34-883d398d747e",
                                        "entry_id": "0425cee7-93b9-3aac-a30c-86d34d60c8a0",
                                        "glosses": [
                                            "A cylindrical explosive projectile that can travel underwater and is used as a weapon.",
                                            "A similar projectile that can travel through space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bec89a4d-579c-3f0d-b8fa-6b401831422f",
                                        "entry_id": "0425cee7-93b9-3aac-a30c-86d34d60c8a0",
                                        "glosses": [
