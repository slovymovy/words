                    {
                        "translation_id": "29172a02-4c2c-474f-a5c7-c25d81ba997b",
                        "source_entry_id": "dae3600a-a47d-3d2b-8dff-4f5142612f77",
                        "source_sense_id": "82e21231-f124-3d6f-8159-fd00489bea21",
                        "source_sense_description": "tegen",
                        "target_lang_word": "anti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4da32aa-5baf-3a6f-ac9b-62fc042a4455",
                                        "entry_id": "e12b3bf2-661a-3951-90b1-d3bf3ef86859",
                                        "glosses": [
                                            "Opposed to something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "879df96c-7d0d-3dac-9ddd-fe4245d5ee4a",
                                        "entry_id": "e12b3bf2-661a-3951-90b1-d3bf3ef86859",
                                        "glosses": [
                                            "That has a torsion angle between 90° and 180°"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "anti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81dc5055-a6f0-3772-93a2-2008cd373d90",
                                        "entry_id": "7b45a910-8038-3881-a675-5297b16322a2",
                                        "glosses": [
                                            "A person opposed to a concept or principle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b6d0a20-a4eb-4631-a123-03270947d48b",
                                                "sense_id": "81dc5055-a6f0-3772-93a2-2008cd373d90",
                                                "text": "On one occasion, franchise supporters accused antis of dumping lemons, wet sponges, rolls of ticker tape, bags of water, and garbage pails on innocent suffrage supporters parading outside the anti-suffrage offices."
                                            },
                                            {
                                                "example_id": "ae770505-e8b8-4a17-aaa2-417d07f6d223",
                                                "sense_id": "81dc5055-a6f0-3772-93a2-2008cd373d90",
                                                "text": "Antis jumped on this announcement, calling it vote buying and indicative of the hypocrisy of prohibitionists who talked incessantly in the first election about the immorality of the antis' vote-buying efforts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4325b6a7-cb08-363a-9b89-420af49906af",
                                        "entry_id": "7b45a910-8038-3881-a675-5297b16322a2",
                                        "glosses": [
                                            "A fan who objects to a particular creator, franchise, fandom, character, ship, etc., especially on moral or sociopolitical grounds."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8091b9a9-e1bc-4acb-86cf-616afaa62a6d",
                                                "sense_id": "4325b6a7-cb08-363a-9b89-420af49906af",
                                                "text": "While I did not directly analyze how the antis define feminism, it appears that they believe Sarah J Maas as an author is a white feminist and therefore unable to write anything feminist."
                                            },
                                            {
                                                "example_id": "4024abba-3994-4a24-9f08-bd298fb3bd75",
                                                "sense_id": "4325b6a7-cb08-363a-9b89-420af49906af",
                                                "text": "Other fans or viewers are thus not coded as fans but instead positioned as either homophobic, angry \"antis\" (even if they ship Johnlock or other queer ships) or as the outsider \"casuals\" who aren't dedicated or smart or invested enough to properly interpret Sherlock."
                                            },
                                            {
                                                "example_id": "0c866f51-367c-4aca-ae46-f9dd310fe8d5",
                                                "sense_id": "4325b6a7-cb08-363a-9b89-420af49906af",
                                                "text": "The VLD fandom especially has cultivated a definition of antis as ones against a moral or societal ill (e.g., pedophilia, incest)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3477422f-5990-33b3-bfd2-db7ae600e326",
                                        "entry_id": "b3c487cc-1458-3045-9b89-2a2047ab858c",
                                        "glosses": [
                                            "Alternative form of anti-."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9857b874-bbbf-4e46-ab75-580a59ae0b8c",
                                                "sense_id": "3477422f-5990-33b3-bfd2-db7ae600e326",
                                                "text": "I do not consider myself either a twitcher or an expert. Neither am I anti twitching."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a209745-8c02-48ed-9340-82bdbea62974",
                        "source_entry_id": "dae3600a-a47d-3d2b-8dff-4f5142612f77",
                        "source_sense_id": "82e21231-f124-3d6f-8159-fd00489bea21",
                        "source_sense_description": "tegen",
                        "target_lang_word": "anti",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                        "entry_id": "0f2e1b53-508f-3370-b61a-6ad5e6eb52e2",
                                        "glosses": [
                                            "Personne opposée ou hostile à un projet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a29bc74-4c3a-483a-8c98-c235cd96d00b",
                                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                                "text": "On ne soumet pas la liberté à l’épreuve ; celui qui a l’impression de ne pas être libre, celui qui croit qu’il n’est pas libre, celui-là est un anti."
                                            },
                                            {
                                                "example_id": "edeb77e0-df2b-4a45-bf3a-a36840c67eda",
                                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                                "text": "Sur le non-cumul, pro et anti jouent la surenchère"
                                            },
                                            {
                                                "example_id": "b3a898be-85bc-4e8b-a407-78f2f5d50180",
                                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                                "text": "Mariage homo : les arguments des pros et des antis devant les Sages"
                                            },
                                            {
                                                "example_id": "ad187464-245b-4501-b2c7-3b78e9ca5e4e",
                                                "sense_id": "148ccb8e-b2cd-33aa-9405-9083831fbe22",
                                                "text": "Mariage gay : la mobilisation des antis ne faiblit pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d201e14d-10df-3d47-bc65-15fb6c3d37a6",
                                        "entry_id": "6439dcb9-eaeb-3384-a9d4-715d9a856478",
                                        "glosses": [
                                            "Opposé à, contre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d0b2232-585c-4495-bd92-f665359337c5",
                                                "sense_id": "d201e14d-10df-3d47-bc65-15fb6c3d37a6",
                                                "text": "Un anti mariage pour tous condamné."
                                            },
                                            {
                                                "example_id": "371a7cea-2863-49ee-b3ad-d637142e3abc",
                                                "sense_id": "d201e14d-10df-3d47-bc65-15fb6c3d37a6",
                                                "text": "Syrie: la France a livré des traitements anti gaz sarin"
                                            },
                                            {
                                                "example_id": "c4988d07-d3ce-4c8b-a623-02ab9b6acd54",
                                                "sense_id": "d201e14d-10df-3d47-bc65-15fb6c3d37a6",
                                                "text": "Contrairement à ce que vous dites, je suis loin d’être anti tout."
                                            },
                                            {
                                                "example_id": "5a811d71-ac78-4154-b19e-e587de61e9b7",
                                                "sense_id": "d201e14d-10df-3d47-bc65-15fb6c3d37a6",
                                                "text": "Bons plans anti football"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
