        "fr-extract.jsonl": [
            {
                "entry_id": "a3202789-7c1c-32d4-a106-995b48d8c912",
                "word": "d’occasion",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2fdac954-9a65-386a-a76e-4c536d278f7e",
                        "entry_id": "a3202789-7c1c-32d4-a106-995b48d8c912",
                        "glosses": [
                            "Qualifie une personne qui œuvre par suite de circonstances fortuites et sans y être suffisamment préparée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "da5ccbaf-778f-4c98-8f61-8c2f3aea5286",
                                "sense_id": "2fdac954-9a65-386a-a76e-4c536d278f7e",
                                "text": "Ce sont les plaies faites maladroitement, par les barbiers d’occasion, à l'aide de mauvais rasoirs, voire même de couteaux, plus ou moins bien affilés, qui créent des portes d'entrée à la contamination."
                            },
                            {
                                "example_id": "95d337ef-2e73-4a11-adff-b07efcc4d642",
                                "sense_id": "2fdac954-9a65-386a-a76e-4c536d278f7e",
                                "text": "Mélie pareil : quatre ou cinq ans pour offrir à son Alphonse, qui est mécanicien de son métier et maquereautin d'occasion, les moyens d'ouvrir un atelier de vélocipèdes ou de bicyclettes."
                            },
                            {
                                "example_id": "5913a984-6b8c-4ffb-8c00-14ae894f6e18",
                                "sense_id": "2fdac954-9a65-386a-a76e-4c536d278f7e",
                                "text": "Cette année-là, il n'y avait pas encore de plaisanciers dans notre port. Les plaisanciers, ils allaient ailleurs. Ce n'est pas un port pour des marins d’occasion ; pour y entrer il vaut mieux en avoir envie ou besoin ; en plus, il ne faut pas être manchot : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2d00a07-a5be-340a-82e1-c34c30397be7",
                        "entry_id": "a3202789-7c1c-32d4-a106-995b48d8c912",
                        "glosses": [
                            "Qualifie une chose qui n'est pas neuve."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fd034ab7-4feb-4517-aed8-34168830bfcf",
                                "sense_id": "a2d00a07-a5be-340a-82e1-c34c30397be7",
                                "text": "Barboter des voitures la nuit, on n’y perd pas son temps, quoique à r’vendre une bonne bagnole neuve d’occasion, t’en tire rien."
                            },
                            {
                                "example_id": "1a1f444f-740e-40c6-b9d5-7f6027a9c36d",
                                "sense_id": "a2d00a07-a5be-340a-82e1-c34c30397be7",
                                "text": "En mettant ce personnage sur écoutes, les policiers colombiens et américains mirent au jour une affaire de voitures d’occasion dirigée par un de ses associés. Elle faisait un chiffre d'affaires bien trop important par rapport aux voitures qu'elle vendait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "812e41d8-d461-4ce7-8372-a712ee31626d",
                        "source_entry_id": "a3202789-7c1c-32d4-a106-995b48d8c912",
                        "source_sense_id": "a2d00a07-a5be-340a-82e1-c34c30397be7",
                        "source_sense_description": "(Sens figuré) Qui n'est pas neuf.",
