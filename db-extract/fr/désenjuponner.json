                ],
                "senses": [
                    {
                        "sense_id": "5edb1b05-eabb-3311-9780-6d6f949e25f4",
                        "entry_id": "e430274d-9da3-3e8d-91bd-2606ee9a4dad",
                        "glosses": [
                            "Enlever son jupon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e1fafd7-66f0-4d8b-ad8e-7c226d6e4839",
                                "sense_id": "5edb1b05-eabb-3311-9780-6d6f949e25f4",
                                "text": "Dès qu’il eut pris possession de son royal dépôt, Villeroy se mit en devoir de le « désenjuponner »."
                            },
                            {
                                "example_id": "0697993e-45ba-4504-8b17-ffb489c9704f",
                                "sense_id": "5edb1b05-eabb-3311-9780-6d6f949e25f4",
                                "text": "Ils vont vous dévêtir, vous délacer, vous désenjuponner, vous mettre dans le simple appareil d’une beauté qui se prépare aux joies de l’amour."
                            },
                            {
                                "example_id": "faafdc8e-2a25-42f1-9935-d078c7751385",
                                "sense_id": "5edb1b05-eabb-3311-9780-6d6f949e25f4",
                                "text": "Pas un à désenjuponner l’Autrichienne pour lui flanquer une belle fessée."
                            }
                        ]
                    }
                ],
