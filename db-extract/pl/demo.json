                "word": "demo",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fbb89e3b-4945-35d7-8175-bc04a322a03f",
                        "entry_id": "f51027e4-3a96-3459-a15d-694d4543c43e",
                        "glosses": [
                            "wersja demonstracyjna, np. gry komputerowej, utworu, programu"
                        ],
