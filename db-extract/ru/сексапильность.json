                        "source_entry_id": "e17242e1-e0f7-3896-98c5-8ba427901029",
                        "source_sense_id": "982b173c-c481-381d-82d6-97d624084372",
                        "target_lang_word": "sex appeal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sex appeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                        "entry_id": "89369fda-0d68-364b-8d91-0a9fb151cd7b",
                                        "glosses": [
                                            "Sexual attractiveness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "906821db-fd1e-4802-b023-38fa3a16bf93",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "He may be as thick as a plank, but he sure has some sex appeal."
                                            },
                                            {
                                                "example_id": "3c962f6f-3045-4368-b9bc-af0ead397a6c",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "But when she goes on to remark that “it is the height of folly to say that woman, who has been taught by the uncounted ages that her strongest hold on man is because of her sex, can throw off or disregard the knowledge that her sex appeal is the strongest weapon she has” then I am appalled at the extreme illogic of the lady!"
                                            },
                                            {
                                                "example_id": "9dcd28d6-23b9-4616-a172-bf6dbebb2f22",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "\"I can't talk to you when you're in a daze of admiration over your own sex appeal.\""
                                            },
                                            {
                                                "example_id": "01ff49d9-257a-49dd-8e4d-84e03d859463",
                                                "sense_id": "35516796-d4f5-33c4-b477-b53044106b07",
                                                "text": "Samara: She impresses with sophistication and sex appeal. Then she strikes. The hunt interests her as much as the conquest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
