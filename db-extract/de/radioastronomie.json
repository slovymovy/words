                "senses": [
                    {
                        "sense_id": "77b69c26-8c2f-37a0-a53f-4e32604b2b53",
                        "entry_id": "0171375e-3386-3d23-9696-8f37fae1cc21",
                        "glosses": [
                            "Teilgebiet der Astronomie, das sich mit der Erforschung der von astronomischen Objekten ausgesendeten elektromagnetischen Strahlung befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c106a94-3091-4c32-8b08-b7103d517f7f",
                                "sense_id": "77b69c26-8c2f-37a0-a53f-4e32604b2b53",
                                "text": "„Die Radioastronomie hat in den vergangenen Jahrzehnten wesentlich zum Verständnis des Universums beigetragen.“"
                            },
                            {
                                "example_id": "cc0000ad-f86d-4d47-9c2b-a879e3a5ad46",
                                "sense_id": "77b69c26-8c2f-37a0-a53f-4e32604b2b53",
                                "text": "„Ionosphärische Störungen können die Satellitennavigation, die Kommunikation und die Radioastronomie beeinträchtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
