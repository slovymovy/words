            {
                "entry_id": "ec0cd8e6-61e8-36a9-9ba7-eb6c5f30e5c1",
                "word": "Navajo",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f47fd3a-6f86-3854-8063-b05d0359910f",
                        "entry_id": "ec0cd8e6-61e8-36a9-9ba7-eb6c5f30e5c1",
                        "glosses": [
                            "taal die het zuidwesten van de Verenigde Staten wordt gesproken door 170 duizend Navajo's'"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e5ef58a3-e851-43cb-98cd-f70a8069d4df",
                                "sense_id": "5f47fd3a-6f86-3854-8063-b05d0359910f",
                                "text": "Tot dan toe was elke codetaal door de Japanners gekraakt. Maar het Navajo, waarvan niets op schrift stond, werd gezien als zo complex, dat het een kans maakte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7debb99a-c746-4724-99db-63f174ea596b",
                        "source_entry_id": "ec0cd8e6-61e8-36a9-9ba7-eb6c5f30e5c1",
                        "source_sense_id": "5f47fd3a-6f86-3854-8063-b05d0359910f",
                        "source_sense_description": "taal die het zuidwesten van de Verenigde Staten wordt gesproken door 170 duizend Navajo's",
                        "target_lang_word": "纳瓦伙语",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6e0a421f-5e91-4a40-a277-7b59ed483211",
                        "source_entry_id": "ec0cd8e6-61e8-36a9-9ba7-eb6c5f30e5c1",
                        "source_sense_id": "5f47fd3a-6f86-3854-8063-b05d0359910f",
                        "source_sense_description": "taal die het zuidwesten van de Verenigde Staten wordt gesproken door 170 duizend Navajo's",
                        "target_lang_word": "Navajo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Navajo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63019949-0949-3999-b709-5c35072affe2",
                                        "entry_id": "8ae8ce35-d634-3dbb-8339-74c158f73c50",
                                        "glosses": [
                                            "die größte indigene nordamerikanische Sprache, die im Südwesten der USA gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13242efa-e830-4ade-a455-161e70d95943",
                                                "sense_id": "63019949-0949-3999-b709-5c35072affe2",
                                                "text": "„Navajo hat ungewöhnlich viele Verben, aber kaum Substantive.“"
                                            },
                                            {
                                                "example_id": "066a854c-5909-4d4e-a4d8-6a92774002f1",
                                                "sense_id": "63019949-0949-3999-b709-5c35072affe2",
                                                "text": "„Leonhard spricht Englisch, Navajo und ein wenig Spanisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Navajo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2af2a34e-4c6f-3cfb-ba24-f1fa29b6c4c6",
                                        "entry_id": "3fa9c851-10ef-3c7a-9e78-f539eda90e8e",
                                        "glosses": [
                                            "Angehöriger eines nordamerikanischen Indianervolks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5f359f-ad75-4745-a95e-9bc31303ac17",
                                                "sense_id": "2af2a34e-4c6f-3cfb-ba24-f1fa29b6c4c6",
                                                "text": "\"Anasazi\" nennen sie die Nachbarn der Utes, die Navajo, und dieser Name ist heute der geläufigste, auch wenn er wenig schmeichelhaft \"alte Feinde\" bedeutet."
                                            },
                                            {
                                                "example_id": "f38a8b1e-0b77-4f3f-a71d-a7c692b865ae",
                                                "sense_id": "2af2a34e-4c6f-3cfb-ba24-f1fa29b6c4c6",
                                                "text": "In den USA leben heute rund 300.000 Navajo."
                                            },
                                            {
                                                "example_id": "855bb4ee-758d-4d17-97ff-f513b511cc64",
                                                "sense_id": "2af2a34e-4c6f-3cfb-ba24-f1fa29b6c4c6",
                                                "text": "„Doch die Navajo kamen erst in die Region, als Chaco Canyon bereits über 200 Jahre lang verlassen war.“"
                                            },
                                            {
                                                "example_id": "f500bc0f-246a-4660-a28d-50b37a81182e",
                                                "sense_id": "2af2a34e-4c6f-3cfb-ba24-f1fa29b6c4c6",
                                                "text": "„Auch Navajo wurden in großer Zahl abgelehnt – weil sie kein Englisch sprachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Navajo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                        "entry_id": "3387016b-d018-32df-ac26-af89dccc03ad",
                                        "glosses": [
                                            "Angehörige eines nordamerikanischen Indianervolks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39daa4a9-3812-46fa-80b0-2ff8bd51a696",
                                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                                "text": "„Wie eng die Realisierung all dieser Pläne von der Politik abhängt, wurde mir klar, als ich mit Dr. Robert A. Roessel, Jr., dem Kanzler des College, sprach, dessen Frau, Ruth Roessel, eine Navajo, die Leiterin der Navajo Studies ist.“"
                                            },
                                            {
                                                "example_id": "9524bcb7-ef39-45f5-a8f9-d9e84fd6c95e",
                                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                                "text": "„Meine Mum war eine Navajo, und ich hatte ihre dunkle Hautfarbe und das schwarze Haar.“"
                                            },
                                            {
                                                "example_id": "0452e5f9-376b-451d-a28e-cd927881baea",
                                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                                "text": "„Aber die Familie erwartete, daß ich wieder ganz eine Navajo sein würde.“"
                                            },
                                            {
                                                "example_id": "9217bb3f-42ec-4b28-8f48-fdcdb1510e06",
                                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                                "text": "„Mary Landon würde keine Navajo werden.“"
                                            },
                                            {
                                                "example_id": "5127d12b-06fc-48b0-99ca-f3d84879182a",
                                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                                "text": "„Erst Mitte 1977 wurde eine Navajo, Georgia Briggs, in die gleiche Stellung eingewiesen, obwohl sie von ihren Freunden gewarnt worden war.“"
                                            },
                                            {
                                                "example_id": "e7c18796-c6a4-4855-b432-e2abba482855",
                                                "sense_id": "a0aabe60-0dfc-3d9c-9c1a-9008187d9e4b",
                                                "text": "„‚Aber ich bin eine Navajo‘, rief sie aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d74759a3-79f3-4e5e-bfb0-c106b789a2ae",
                        "source_entry_id": "ec0cd8e6-61e8-36a9-9ba7-eb6c5f30e5c1",
                        "source_sense_id": "5f47fd3a-6f86-3854-8063-b05d0359910f",
                        "source_sense_description": "taal die het zuidwesten van de Verenigde Staten wordt gesproken door 170 duizend Navajo's",
                        "target_lang_word": "Navajo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Navajo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72dbf652-7008-3e85-a87a-4787094d49d3",
                                        "entry_id": "f8e6adb0-15eb-35e6-9c16-26a83f66bca0",
                                        "glosses": [
                                            "A member of the Navajo people, currently the largest Native American tribe in North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f8e9d86-27ae-4925-a640-2a95c734176d",
                                                "sense_id": "72dbf652-7008-3e85-a87a-4787094d49d3",
                                                "text": "As a code talker, Newman was one of a group of Navajos who learned a secret, unbreakable language that was used to send information on tactics, troop movements and orders over the radio and telephone during WWII."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Navajo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d193f4be-dcd6-3dc5-b35d-b3ac563373f9",
                                        "entry_id": "432e022f-96e9-3108-81eb-2bad295d08e6",
                                        "glosses": [
                                            "An Apachean (Southern Athabaskan) language of the Athabascan language family belonging to the Na-Dené phylum. It is spoken by 149,000 people in the American Southwest (Arizona, New Mexico, Utah, and Colorado)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13334a69-7c0a-41b3-a45e-74818d9f6d49",
                                                "sense_id": "d193f4be-dcd6-3dc5-b35d-b3ac563373f9",
                                                "text": "Endangered language communities would be thrilled with and proud of that kind of exposure for their language, like when Star Wars was dubbed into Navajo and Ojibwe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9797bc2-fa00-3112-b826-2abef02c0af6",
                                        "entry_id": "432e022f-96e9-3108-81eb-2bad295d08e6",
                                        "glosses": [
                                            "An Amerindian people who traditionally speak the Navajo language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7157d1b7-2e6b-4321-a859-f1b47925693c",
                                                "sense_id": "d9797bc2-fa00-3112-b826-2abef02c0af6",
                                                "text": "One of the last remaining members of the Navajo Code Talkers, who used their difficult-to-learn language to form an indecipherable code that helped the Allies win World War II, has died."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
