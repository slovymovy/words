                        "glosses": [
                            "trui die gedragen wordt door de leider van het bergklassement in een wielerronde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d737b0a-08d5-4c85-b647-55dd56e6372e",
                                "sense_id": "2ec9cd7c-8877-35e1-9405-489fe449b506",
                                "text": "Jetse Bol genoot van de ploegentijdrit in Utrecht voor eigen publiek. Maar stiekem zit hij met zijn hoofd al bij de strijd om de bergtrui, zaterdag op de Amerongse Berg."
                            },
                            {
                                "example_id": "bb1fefb0-0df3-4bd9-995f-05ac71504551",
                                "sense_id": "2ec9cd7c-8877-35e1-9405-489fe449b506",
                                "text": "\"Het is een enorme teleurstelling, want we kwamen juist op mijn favoriete terrein, de bergen. Het is mijn eerste Tour de France en het is jammer dat hij zo eindigt\", zei de teleurgestelde Bouchard, die in 2019 de bergtrui in de Vuelta veroverde en vorig jaar als eerste eindigde in het bergklassement van de Giro."
                            }
                        ]
