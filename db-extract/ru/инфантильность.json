                    },
                    {
                        "translation_id": "4478c178-24f8-4229-b298-ed1e6bcb2b88",
                        "source_entry_id": "be500878-675b-32de-9c34-9fa520c10900",
                        "source_sense_id": "7ec9d724-38ee-31b5-acb8-3f626bd4e2d2",
                        "target_lang_word": "Infantilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Infantilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7102a9b-1e1b-3a46-8356-15f992d4b4b5",
                                        "entry_id": "7ba7c545-2301-3753-bb93-41da6cbaf8d6",
                                        "glosses": [
                                            "kindisches Wesen, Unreife"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c30d13-4a45-466c-a965-9c425f1213eb",
                                                "sense_id": "b7102a9b-1e1b-3a46-8356-15f992d4b4b5",
                                                "text": "Seine Infantilität geht mir zunehmend auf die Nerven. Ich denke, er drückt sich damit vor Verantwortung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "551be1d1-714f-3e02-91bc-3fc5d9817dd8",
                                        "entry_id": "7ba7c545-2301-3753-bb93-41da6cbaf8d6",
                                        "glosses": [
                                            "kindliches Wesen, Kindlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a264aa-e8e0-4c16-a5ac-28ef9dea437a",
                                                "sense_id": "551be1d1-714f-3e02-91bc-3fc5d9817dd8",
                                                "text": "Wenn man zu lange in der kindlichen Infantilität verharrt, wenn man eigentlich aus ihr herauswachsen sollte, dann beginnen die Probleme."
                                            },
                                            {
                                                "example_id": "bcbb1acb-99c8-4b3f-bd47-dbe18c79f93c",
                                                "sense_id": "551be1d1-714f-3e02-91bc-3fc5d9817dd8",
                                                "text": "„Die Infantilität kann ein belebendes und ein lähmendes Gift sein; sie erhält jung, oder sie läßt nie reif werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c53bbe8f-023b-4701-8352-54434b41edc1",
                        "source_entry_id": "be500878-675b-32de-9c34-9fa520c10900",
                        "source_sense_id": "7ec9d724-38ee-31b5-acb8-3f626bd4e2d2",
                        "target_lang_word": "puérilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puérilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0d6c57-9c34-3ca0-9617-79ac090c3dc6",
                                        "entry_id": "e586b9f3-8b5c-38c7-8b66-d7441bfffd9a",
                                        "glosses": [
                                            "Caractère de ce qui est frivole et qui conviendrait à un enfant, soit dans le raisonnement, soit dans les actions ; il ne se dit qu’en parlant des personnes qui ont passé l’âge de l’enfance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181d6a2b-d4a8-44ee-9f86-fbfb1da03078",
                                                "sense_id": "8a0d6c57-9c34-3ca0-9617-79ac090c3dc6",
                                                "text": "[Il] avait une longue face flamande, où des yeux vides riaient avec une puérilité d’enfant."
                                            },
                                            {
                                                "example_id": "b8fc40e1-709c-4551-a619-b89cbe15884a",
                                                "sense_id": "8a0d6c57-9c34-3ca0-9617-79ac090c3dc6",
                                                "text": "C’est vrai que j’allais à l’église pour être heureuse. Le malheur était que je ne pouvais pas croire : je voulais trop comprendre, leurs dogmes révoltaient ma raison, leur paradis me semblait une puérilité invraisemblable…"
                                            },
                                            {
                                                "example_id": "27b2703c-1169-4d1b-913b-03c6ba39032d",
                                                "sense_id": "8a0d6c57-9c34-3ca0-9617-79ac090c3dc6",
                                                "text": "Du même âge qu’elle, il était cependant d’une étonnante puérilité, et Okané, tout en étant reconnaissante de sa gentillesse, s’amusait parfois de son comportement timide et gauche."
                                            },
                                            {
                                                "example_id": "0c57be6a-d444-46ae-9cf4-399896dd7590",
                                                "sense_id": "8a0d6c57-9c34-3ca0-9617-79ac090c3dc6",
                                                "text": "Il y a de la puérilité dans ce raisonnement, dans ce discours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9afeb499-5cd5-3d03-b685-4face37aa0a6",
                                        "entry_id": "e586b9f3-8b5c-38c7-8b66-d7441bfffd9a",
                                        "glosses": [
                                            "Actions, des discours qui offrent ce caractère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a677e9-e0ef-4927-9f28-df9875fd4ad9",
                                                "sense_id": "9afeb499-5cd5-3d03-b685-4face37aa0a6",
                                                "text": "Il ne dit que des puérilités."
                                            },
                                            {
                                                "example_id": "c3dab77c-06e9-40a9-878c-62e0c1cd06ec",
                                                "sense_id": "9afeb499-5cd5-3d03-b685-4face37aa0a6",
                                                "text": "Ce que vous faites là est une puérilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28263bdd-910a-48af-bc7e-1497e4b755d7",
                        "source_entry_id": "be500878-675b-32de-9c34-9fa520c10900",
                        "source_sense_id": "7ec9d724-38ee-31b5-acb8-3f626bd4e2d2",
                        "target_lang_word": "infantilisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infantilisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f49c0a4-767f-3f71-aa32-6c4902fa580d",
                                        "entry_id": "6e404c22-83ba-307d-a90f-64cdd86d2d9a",
                                        "glosses": [
                                            "Persistance chez l’adulte de certains caractères de l’enfance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c5c5a8-259b-4bba-8d64-e2be1c5ec556",
                                                "sense_id": "1f49c0a4-767f-3f71-aa32-6c4902fa580d",
                                                "text": "À l’étude de l’infantilisme on a récemment joint celle du puérilisme, du féminisme, du masculinisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c377d0a-b98e-36c4-9fd5-af6c7f93991a",
                                        "entry_id": "6e404c22-83ba-307d-a90f-64cdd86d2d9a",
                                        "glosses": [
                                            "Nature infantile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57283fb4-1792-4e38-a2ad-dcfe2f0a05fc",
                                                "sense_id": "3c377d0a-b98e-36c4-9fd5-af6c7f93991a",
                                                "text": "Un écrivain de second ordre peut faire un scénariste génial, alors qu'un Bunuel, un Eisenstein ou un Walt Disney, dans la littérature, ne feraient pas illusion une minute : leur infantilisme éclaterait aussitôt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
