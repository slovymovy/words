                        "sense_id": "df9eda12-4cc9-3e08-a657-b9ac2b5a8e5a",
                        "entry_id": "228e3fe8-e8a7-3d72-8d9b-a61fff304751",
                        "glosses": [
                            "handliches Gerät mit elektronisch gespeichertem Text, der als Führer durch ein Museum, eine Stadt oder dergleichen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef8253f-dc40-43bc-89cb-09d0201cd1e2",
                                "sense_id": "df9eda12-4cc9-3e08-a657-b9ac2b5a8e5a",
                                "text": "„Das sehenswerte Museum erzählt mit Audioguides die Geschichte der Färöer von der Wikingerzeit bis ins ausgehende 16. Jahrhundert auf ungewöhnliche Weise in historisch begründeten, mitunter gruseligen und abenteuerlichen Geschichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
