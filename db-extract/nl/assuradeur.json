                    {
                        "sense_id": "983cf363-dbc2-366c-a6b7-8296b2f3b11b",
                        "entry_id": "c1ad5690-10b0-3a1e-8867-0cf9edcf1cfd",
                        "glosses": [
                            "een onderneming die verzekeringen afsluit, verzekeraar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b888157-07b2-4e04-bc59-399b4ce179ae",
                                "sense_id": "983cf363-dbc2-366c-a6b7-8296b2f3b11b",
                                "text": "De assuradeur weigerde de verzekering af te sluiten."
                            }
                        ]
                    },
                    {
                        "sense_id": "4883a65c-ea6b-3d92-97ff-5ca757d3e7cb",
                        "entry_id": "c1ad5690-10b0-3a1e-8867-0cf9edcf1cfd",
                        "glosses": [
                            "een tussenpersoon met de bevoegdheid van een verzekeraar"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "227a08c6-f259-4869-b889-2f44e6014e63",
                        "source_entry_id": "c1ad5690-10b0-3a1e-8867-0cf9edcf1cfd",
                        "source_sense_id": "983cf363-dbc2-366c-a6b7-8296b2f3b11b",
                        "source_sense_description": "een onderneming die verzekeringen afsluit",
                        "target_lang_word": "insurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insurer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                        "entry_id": "13afc843-730e-3e89-bbd2-e5b19e862cf7",
                                        "glosses": [
                                            "One who insures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acf44d0a-fdcf-49b1-ba5e-1e783cfccd8f",
                                                "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                                "text": "After the accident I contacted the insurer who paid for the repairs."
                                            },
                                            {
                                                "example_id": "84e4577f-d1be-4f54-9b04-311c1a391c19",
                                                "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                                "text": "Federal law mandates that at least one nongroup insurer in your state must provide coverage to everyone, regardless of health issues."
                                            },
                                            {
                                                "example_id": "1ee762ab-9aa3-4e54-9899-9f736fa42dc6",
                                                "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3719ab0a-237a-4e72-a94a-569231d917a2",
                        "source_entry_id": "c1ad5690-10b0-3a1e-8867-0cf9edcf1cfd",
                        "source_sense_id": "983cf363-dbc2-366c-a6b7-8296b2f3b11b",
                        "source_sense_description": "een onderneming die verzekeringen afsluit",
                        "target_lang_word": "assureur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assureur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d43501e-1e29-3c48-b299-921c974cfd99",
                                        "entry_id": "959524d7-c5c1-371c-b99c-6f355032f7f9",
                                        "glosses": [
                                            "Personne qui assure un dommage, un risque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8f62e8-caae-473a-ac0b-19124ed7b181",
                                                "sense_id": "2d43501e-1e29-3c48-b299-921c974cfd99",
                                                "text": "J'en ai parlé avec mon assureur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82dc0985-fb93-36ba-9a47-dac7ea5e9028",
                                        "entry_id": "959524d7-c5c1-371c-b99c-6f355032f7f9",
                                        "glosses": [
                                            "Compagnie qui propose des contrats d'assurances."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b305bbfb-44ee-38af-9c4f-3cc1fcde626b",
                                        "entry_id": "959524d7-c5c1-371c-b99c-6f355032f7f9",
                                        "glosses": [
                                            "Individu qui assure un grimpeur, qui le retient par une corde d'escalade (équivalent féminin : assureuse)."
                                        ],
                                        "tags": [
                                            "Escalade"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "assureur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1a1b52-1c8f-348f-b33b-53a80d52b712",
                                        "entry_id": "8a80fda8-48e1-32e5-8711-dae98627b87d",
                                        "glosses": [
                                            "Qui procure une assurance, œuvre dans le domaine des assurances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182fb73c-23fe-4d5b-b5b6-5a70f9007c21",
                                                "sense_id": "7a1a1b52-1c8f-348f-b33b-53a80d52b712",
                                                "text": "Dans ce dernier cas, la contribution supérieure ainsi exigée, est bien une prime de risque que l’établissement assuré verse à l'établissement assureur."
                                            },
                                            {
                                                "example_id": "be731b7c-bfaf-4966-944f-4c87b76f818f",
                                                "sense_id": "7a1a1b52-1c8f-348f-b33b-53a80d52b712",
                                                "text": "L’Angleterre commerçante, transporteuse, banquière, assureuse, a véritablement mis le monde en forme pour la collaboration économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77294ad8-3c57-46d5-8f1b-27727c91cd66",
                        "source_entry_id": "c1ad5690-10b0-3a1e-8867-0cf9edcf1cfd",
                        "source_sense_id": "983cf363-dbc2-366c-a6b7-8296b2f3b11b",
                        "source_sense_description": "een onderneming die verzekeringen afsluit",
                        "target_lang_word": "assureuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assureuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "994eb7ea-aaa9-303d-8933-5a720465778e",
                                        "entry_id": "7bf8a822-5438-32f5-863b-0b1b26243cbc",
                                        "glosses": [
                                            "Femme qui travaille dans le domaine des assurances."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30d77218-b404-4873-bea3-10d209a892c6",
                                                "sense_id": "994eb7ea-aaa9-303d-8933-5a720465778e",
                                                "text": "C’est alors que la complice était intervenue. Au téléphone, elle s’était fait passer pour une assureuse jointe par son client, et avait persuadé l’octogénaire de verser 1 300 euros en guise de « réparation »."
                                            },
                                            {
                                                "example_id": "4913bf6a-d365-4dfc-ac8d-8bbbf7cf8cf8",
                                                "sense_id": "994eb7ea-aaa9-303d-8933-5a720465778e",
                                                "text": "Deuxièmement, si les inconditionnels d’«autrice» sont logiques avec eux-mêmes, ils doivent également s’attaquer à tous les autres féminins illogiques. Or, j’aimerais bien voir s’ils sont tout aussi prêts à dire «une assureuse», «une défenseuse», «une entrepreneuse», «une gouverneuse», «une metteuse en scène», «une procureuse», «une réviseuse», «une superviseuse», «une vainqueuse». Parce qu’en français, lorsqu’un nom est dérivé d’un verbe, c’est la terminaison en «euse» et non en «eure» qui est logique. Préférer «assureure» ou «réviseure», c’est se ranger du même côté que ceux qui préfèrent «auteure»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54e57fa0-bef8-31e6-a8c7-4f76349b67ed",
                                        "entry_id": "7bf8a822-5438-32f5-863b-0b1b26243cbc",
                                        "glosses": [
                                            "Femme qui assure un grimpeur ou une grimpeuse, qui le ou la retient par une corde d'escalade."
                                        ],
                                        "tags": [
                                            "Escalade"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2cb6c8-e2bb-4f50-9350-9e0875cbec0d",
                                                "sense_id": "54e57fa0-bef8-31e6-a8c7-4f76349b67ed",
                                                "text": "Je cherche et sens mes bras se gonfler d’acide. Puis je commence à entendre la voie de mon assureuse. Je dois me rapprocher ! Je donne tout pour sortir des ce maudit dévers. Maintenant il reste 4 longueurs. Et on va le faire !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "assureuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4f8cbb2-fd67-3dcd-9c79-b49f5003992a",
                                        "entry_id": "50ae1747-302c-3a47-98f8-b5294d25e2bd",
                                        "glosses": [
                                            "Féminin singulier de assureur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab86eae1-087c-4a70-9fb8-e80fadd2e9fe",
                                                "sense_id": "d4f8cbb2-fd67-3dcd-9c79-b49f5003992a",
                                                "text": "L’Angleterre commerçante, transporteuse, banquière, assureuse, a véritablement mis le monde en forme pour la collaboration économique."
                                            }
                                        ]
