                                        "sense_id": "a5122fc5-b5e7-31ee-b168-2ff1a318d5ac",
                                        "entry_id": "e9e0180c-d502-3a30-9263-6ca57572daaa",
                                        "glosses": [
                                            "Visceral leishmaniasis."
                                        ],
