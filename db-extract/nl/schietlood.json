                    },
                    {
                        "translation_id": "7e68b4c2-292f-461b-9e1a-5e114bebb202",
                        "source_entry_id": "9185d17d-b3ce-3275-86c0-3d2f4cc846d5",
                        "source_sense_id": "c74e9991-aa45-309f-8c66-ed3ff397fa7d",
                        "source_sense_description": "een draad met loden balletje om de loodrechte stand van iets te onderzoeken",
                        "target_lang_word": "Senkblei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Senkblei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f4ca092-3d8e-3ff5-8e2f-c78a9d080e76",
                                        "entry_id": "02937667-6e1e-37c6-9097-09b48bda16f8",
                                        "glosses": [
                                            "Gerät, mit dem der senkrechte Verlauf einer Kante gemessen und geprüft wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7747e2f3-7fcb-4d94-b316-3cdd98d3ef9d",
                                                "sense_id": "3f4ca092-3d8e-3ff5-8e2f-c78a9d080e76",
                                                "text": "„Tinius selbst kennt den Spruch für die Rückverwandlung nicht und muß ihn nicht kennen, weil er wie Senkblei auf dem fruchtbaren Grund der Geschichten ausharrt.“"
                                            },
                                            {
                                                "example_id": "f4753b79-abb1-4430-ae82-23dff79bfedc",
                                                "sense_id": "3f4ca092-3d8e-3ff5-8e2f-c78a9d080e76",
                                                "text": "„In der Antike wurde als Setzwaage ein gleichschenkliges Dreieck verwendet, in das ein Lot (Senkblei) aufgehängt wurde. Das Senkblei zeigt auf die Mitte der Grundseite des Dreiecks, wenn diese in der Waage ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b54844b4-4585-4fc5-a0c8-bc2076bc219b",
                        "source_entry_id": "9185d17d-b3ce-3275-86c0-3d2f4cc846d5",
                        "source_sense_id": "c74e9991-aa45-309f-8c66-ed3ff397fa7d",
                        "source_sense_description": "een draad met loden balletje om de loodrechte stand van iets te onderzoeken",
                        "target_lang_word": "plummet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plummet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16f02aa2-7077-3e0c-8cc0-3e64522ef264",
                                        "entry_id": "1cf78348-a7b7-31c4-b1f0-b2b042942e8a",
                                        "glosses": [
                                            "A piece of lead attached to a line, used in sounding the depth of water; a plumb bob or a plumb line."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aea992bb-76b4-4496-b1cf-d8cfa6757988",
                                                "sense_id": "16f02aa2-7077-3e0c-8cc0-3e64522ef264",
                                                "text": "I'le ſeeke him deeper than ere plummet ſounded, / And with him there lye mudded."
                                            },
                                            {
                                                "example_id": "d3974db3-2554-400c-aa63-cf0ce3819edb",
                                                "sense_id": "16f02aa2-7077-3e0c-8cc0-3e64522ef264",
                                                "text": "Iudgement also will I lay to the line, and righteousnesse to the plummet: and the haile shall sweepe away the refuge of lyes, and the waters shall ouerflow the hiding place."
                                            },
                                            {
                                                "example_id": "bac559f4-7414-49a3-ac0e-0ec0383889b3",
                                                "sense_id": "16f02aa2-7077-3e0c-8cc0-3e64522ef264",
                                                "text": "Each long black hair upon his head hung down as straight as any plummet line; […]"
                                            },
                                            {
                                                "example_id": "8ee02b7b-14a4-431e-8887-b1d9590acdf1",
                                                "sense_id": "16f02aa2-7077-3e0c-8cc0-3e64522ef264",
                                                "text": "And love was the plummet dropped down into the deeps of him where like had never gone."
                                            },
                                            {
                                                "example_id": "dd2c58d3-f457-46db-9d50-3f82f2acd08b",
                                                "sense_id": "16f02aa2-7077-3e0c-8cc0-3e64522ef264",
                                                "text": "He told her then of his life since he had returned to the jungle—of how he had dropped like a plummet from a civilized Parisian to a savage Waziri warrior, and from there back to the brute that he had been raised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c17d912-0c3c-35cf-9e3a-214bace5d3f0",
                                        "entry_id": "1cf78348-a7b7-31c4-b1f0-b2b042942e8a",
                                        "glosses": [
                                            "Hence, any weight."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a770c13f-0fe6-48b3-843d-c10539511a33",
                                                "sense_id": "7c17d912-0c3c-35cf-9e3a-214bace5d3f0",
                                                "text": "His parachute was shot half away, and if he'd jumped he would have fallen like a plummet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741b70dc-17bd-3937-8ce7-236886ba5396",
                                        "entry_id": "1cf78348-a7b7-31c4-b1f0-b2b042942e8a",
                                        "glosses": [
                                            "A piece of lead formerly used by schoolchildren to rule paper for writing (that is, to mark with rules, with lines)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "131cdb8c-93d9-369b-a58f-00e9d89717a5",
                                        "entry_id": "1cf78348-a7b7-31c4-b1f0-b2b042942e8a",
                                        "glosses": [
                                            "A violent or dramatic fall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "257a6e9e-23e9-3421-8fcf-7f6d3af7c5a1",
                                        "entry_id": "1cf78348-a7b7-31c4-b1f0-b2b042942e8a",
                                        "glosses": [
                                            "A decline; a fall; a drop."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b81c63-5aac-44d0-a1f5-d4b5abac3da6",
                                                "sense_id": "257a6e9e-23e9-3421-8fcf-7f6d3af7c5a1",
                                                "text": "Yet another seriously under-par performance is unlikely to provide any real answers to their remarkable plummet in form - but it proves they can at least churn out a much-needed result."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plummet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "155667ff-2078-378a-9a2d-65783e3cf62b",
                                        "entry_id": "bcab4fe0-5684-3592-9b1b-03890d148a60",
                                        "glosses": [
                                            "To drop swiftly, in a direct manner; to fall quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9305e5c5-9345-436d-9266-3738a95989ad",
                                                "sense_id": "155667ff-2078-378a-9a2d-65783e3cf62b",
                                                "text": "After its ascent, the arrow plummeted to earth."
                                            },
                                            {
                                                "example_id": "fbf1d39f-b9f4-44d4-9201-b7403a029167",
                                                "sense_id": "155667ff-2078-378a-9a2d-65783e3cf62b",
                                                "text": "The switchback road to Diabaig - pronounced 'Jer-vague' - passes through some of the most exhilarating scenery in Scotland. […] With a final swoop, the road plummets down into Diabaig, where cottages are dotted across the slopes of a rocky semi-circle."
                                            },
                                            {
                                                "example_id": "6786847d-cd2e-4521-b0ce-cf0dce27caa5",
                                                "sense_id": "155667ff-2078-378a-9a2d-65783e3cf62b",
                                                "text": "Some speculated Twitter’s stock would plummet, while another said the company would not have to be owned by “a moron,” using an expletive to refer to Mr. Musk."
                                            },
                                            {
                                                "example_id": "b9a552dd-b37d-4a19-8022-761ebd9c8709",
                                                "sense_id": "155667ff-2078-378a-9a2d-65783e3cf62b",
                                                "text": "Passenger numbers had been rising sharply. But the replacement of the services by buses, which take far longer because of the number of stations in out-of-the-way villages on the route, will ensure they plummet again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
