                "senses": [
                    {
                        "sense_id": "534dffc3-8b7b-3373-a86b-309199a168c2",
                        "entry_id": "e544806a-4f02-3163-ac65-a21045881c9a",
                        "glosses": [
                            "Danser la polka."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28079a8-7f96-4130-9511-ea87dcbefee6",
                                "sense_id": "534dffc3-8b7b-3373-a86b-309199a168c2",
                                "text": "Je valsai, je polkai, et je jouai à Ferdinand le tour innocent de l’engager à valser en brayant devant lui."
                            },
                            {
                                "example_id": "48b587d7-3d65-4cf9-abfe-a6b873e78657",
                                "sense_id": "534dffc3-8b7b-3373-a86b-309199a168c2",
                                "text": "Mais j’aime peu voir, Muse, ô reine des poèmes,\nDont la toison nimbée a l’air d’un ostensoir,\nUn poète qui polke avec un habit noir."
                            },
                            {
                                "example_id": "a48788ff-53ae-4033-a5c6-792838f3029f",
                                "sense_id": "534dffc3-8b7b-3373-a86b-309199a168c2",
                                "text": "Les Américaines dansent le cake-walk : Coco polkera et elle mazurkera, et elle quadrillera, si la danse ne lui donne pas de palpitations."
                            }
                        ]
                    }
