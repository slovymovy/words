                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2bdee25-e727-468b-a553-8d0ffffafa5c",
                                                "sense_id": "a8fbbba3-cbbe-3688-bcf8-234d0770a633",
                                                "text": "The numbers thin out the further we get from London, so I don't feel guilty when I remove my mask momentarily to scoff some of the snacks I'd bought at Marylebone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94797502-0b12-3bb8-a445-cdf8b66787c5",
                                        "entry_id": "ada9d929-c002-3600-8a1c-cc8e7ddccc0b",
