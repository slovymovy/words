                                                "example_id": "ffaaedf0-0ea1-45f0-bab7-d7bf166e0266",
                                                "sense_id": "b4d02511-47ed-3c48-9494-9ac0e12d9cd8",
                                                "text": "Die Gesellschaft zögerte die Einleitung des Konkursverfahrens hinaus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "03cef6e6-e35c-3d9d-b15d-be428246edbb",
                                        "entry_id": "973a7667-84e5-33fe-ab16-1006d39c2fb7",
                                        "glosses": [
