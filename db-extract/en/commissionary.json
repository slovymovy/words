                        "examples": [
                            {
                                "example_id": "8b818659-9ac6-4d94-b217-8b2c8cd76523",
                                "sense_id": "1cde9036-9915-3790-b5c1-008f62ec1487",
                                "text": "After the death of king Philip; Charles Counte de Valois, his brother, begun criminally to purſue M. Enguerrant before certaine commiſſionaries of the ſaid court, delegated for that purpoſe."
                            },
                            {
                                "example_id": "c924c3ab-b0d8-4e3c-803d-be0d253e258d",
                                "sense_id": "1cde9036-9915-3790-b5c1-008f62ec1487",
                                "text": "Besides these re-organisations at the districts level, the Tirhut district of the last century has been virtually divided into three commissionaries of North Bihar within one hundred year viz. the Tirhut Commissionary, comprising the districts of Muzaffarpur, Sitamarhi, Vaisali, Sonepur, etc."
                            },
                            {
                                "example_id": "e66bcc34-418e-4f8e-8e13-dafc4a51f3ec",
                                "sense_id": "1cde9036-9915-3790-b5c1-008f62ec1487",
                                "text": "The observance of this multitude of rules was the task of officials of the Labour Inspectorate, namely the so-called recruitment commissionaries (wervingscommissarissen).[…]In 1910 the commissionaries were given the authority to detect and report penal offences."
                            }
                        ]
