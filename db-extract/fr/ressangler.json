                ],
                "senses": [
                    {
                        "sense_id": "042dcb36-417f-3f84-b100-95976943e48d",
                        "entry_id": "c72607d0-6e1b-3525-ab9c-04609e217d93",
                        "glosses": [
                            "Sangler de nouveau un cheval ou une autre bête de somme à qui on a ôté la sangle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df1b66bd-ba4c-4281-9c30-173182c305fd",
                                "sense_id": "042dcb36-417f-3f84-b100-95976943e48d",
                                "text": "Mais si vous pouvez glisser deux ou trois doigts, mieux vaut ressangler tout de suite."
                            },
                            {
                                "example_id": "16c99b09-bb07-4b4f-a864-bd95a78c47ce",
                                "sense_id": "042dcb36-417f-3f84-b100-95976943e48d",
                                "text": "Posément le uhlan avait replié sa carte, ressanglé, puis enfourché sa bête. Il disparut."
                            },
                            {
                                "example_id": "d6958984-0fc9-466e-a248-5308c62d857c",
                                "sense_id": "042dcb36-417f-3f84-b100-95976943e48d",
                                "text": "Si vous restez longtemps à cheval, ne craignez pas de ressangler vos chevaux, celui de l'amazone surtout."
                            },
                            {
                                "example_id": "2e7494d3-915d-404b-aeb0-67f9a455e0ff",
                                "sense_id": "042dcb36-417f-3f84-b100-95976943e48d",
                                "text": "Le roi fit ressangler son cheval, et choisit lui-même sa lance avec le plus grand soin."
                            }
                        ]
                    }
                ],
