                "senses": [
                    {
                        "sense_id": "19182345-6913-3a2e-acd1-c9bd8c1dffc3",
                        "entry_id": "92c497bf-fd33-376e-8978-c14b0c7a9625",
                        "glosses": [
                            "западно-европейское женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d08e52ae-a209-4648-aa9b-66fa2a59dc30",
                                "sense_id": "19182345-6913-3a2e-acd1-c9bd8c1dffc3",
                                "text": "Расплавленные капли солнца, упав на рыжую Селесту, превратились в веснушки."
                            },
                            {
                                "example_id": "c3cea7cb-539b-4b20-b8cd-64b53a3e1696",
                                "sense_id": "19182345-6913-3a2e-acd1-c9bd8c1dffc3",
                                "text": "Селеста уселась на краешке фонтана и смотрела на Жиля, повернувшего к ней загорелое лицо, унизанное блестящими капельками воды."
                            }
                        ]
                    }
