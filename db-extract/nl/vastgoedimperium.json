                        "examples": [
                            {
                                "example_id": "8bcdef83-a3cf-4036-a891-b59f069fc9c2",
                                "sense_id": "abe20646-cb84-3b01-a91e-802ed1b74d1a",
                                "text": "Het was de tweede keer dit jaar dat er brand uitbrak in de Trump Tower, het kroonjuweel van het vastgoedimperium van de Amerikaanse president. Begin januari vatte een klimaatinstallatie op het dak vlam. Twee mensen raakten toen gewond."
                            },
                            {
                                "example_id": "884b53aa-3904-43a3-baad-881316e2af1b",
                                "sense_id": "abe20646-cb84-3b01-a91e-802ed1b74d1a",
                                "text": "Voordat Trump president werd en formeel verhuisde naar het Witte Huis woonde hij sinds 1983 in het penthouse van zijn eigen Trump Tower nabij Central Park, op een van de duurste plekken van New York. In de stad waar hij werd geboren bouwde hij zijn vastgoedimperium uit."
                            }
                        ]
                    }
