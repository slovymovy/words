                ],
                "senses": [
                    {
                        "sense_id": "7bc298ad-62d4-3cc1-91c9-3eda83dcb3d9",
                        "entry_id": "ec4f5620-3c92-3de1-ad14-4f8ec2a98f9e",
                        "glosses": [
                            "Femme musulmane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c9eeb60-074c-4ccc-9f53-a6530f6a95c6",
                                "sense_id": "7bc298ad-62d4-3cc1-91c9-3eda83dcb3d9",
                                "text": "On leur parle de roumis ennemis. Ennemis ? Les musulmanes des douars kabyles n'ont jamais vu de roumis. Comment pourraient-elles les haïr ? On leur dit qu'après le départ des roumis l'Algérie renaîtra, la terre sera aux musulmans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bfb2c30-57b1-42ef-9e14-ad62e0f3e6e6",
                        "source_entry_id": "ec4f5620-3c92-3de1-ad14-4f8ec2a98f9e",
                        "source_sense_id": "7bc298ad-62d4-3cc1-91c9-3eda83dcb3d9",
                        "target_lang_word": "Muslimin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muslimin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7683645d-91a4-341e-bb1b-55529053c2b2",
                                        "entry_id": "a8f27984-dd64-30af-8873-f595e6352d13",
                                        "glosses": [
                                            "Anhängerin des islamischen Glaubens"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eac30c8-bba9-4e1a-bfeb-f42f6d6fab33",
                                                "sense_id": "7683645d-91a4-341e-bb1b-55529053c2b2",
                                                "text": "Nicht jede Muslimin trägt ein Kopftuch."
                                            },
                                            {
                                                "example_id": "3b56d722-308f-45fd-aa7b-87fa27d85c1f",
                                                "sense_id": "7683645d-91a4-341e-bb1b-55529053c2b2",
                                                "text": "„Derartige Improvisationen gehören an der Notenkraker-Schule zum Alltag. Da sitzt das äthiopische Flüchtlingskind neben dem marokkanischen Gastarbeiterjungen, die türkische Muslimin neben dem Hindumädchen aus Surinam. Und wenn es im Kosovo so weitergeht, werden wir bald die ersten Kinder von dort hier in der Schule haben.“"
                                            },
                                            {
                                                "example_id": "a49f4e83-5969-419e-8ce4-182ef0b133f3",
                                                "sense_id": "7683645d-91a4-341e-bb1b-55529053c2b2",
                                                "text": "„Die Teilnahme am Ramadan ist freiwillig und für bestimme Personen wie Kinder grundsätzlich nicht erlaubt, sagte Asyie Sağlam, Muslimin aus Landshut.“"
                                            },
                                            {
                                                "example_id": "37570847-0f7f-4a53-9fd5-6e535a43ae28",
                                                "sense_id": "7683645d-91a4-341e-bb1b-55529053c2b2",
                                                "text": "„Ich bin erstens keine Muslimin, und zweitens lebe ich nicht in einer muslimischen Gesellschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47580fc6-d79f-442e-a513-23096466dbc6",
                        "source_entry_id": "ec4f5620-3c92-3de1-ad14-4f8ec2a98f9e",
