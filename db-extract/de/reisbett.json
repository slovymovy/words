                "senses": [
                    {
                        "sense_id": "2c7b702b-0356-3ebe-a32e-745fd8d72d5d",
                        "entry_id": "ad4ea9d6-dc25-3616-b33e-23573c2860eb",
                        "glosses": [
                            "eine dekorative Unterlage auf einem angerichteten Teller"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f063f622-252e-49d5-80b0-67c3ceb9b760",
                                "sense_id": "2c7b702b-0356-3ebe-a32e-745fd8d72d5d",
                                "text": "„Das Bibimbap ist ein Eintopf mit verschiedenen Gemüsen und einem Spiegelei, die auf ein Reisbett sortiert, dann mit scharfer Gochujang Chilipaste und einer klaren Brühe überschüttet, anschließend vermengt und wechselweise mit Stäbchen und einem Löffel verspeist werden.“"
                            },
                            {
                                "example_id": "6ea7e787-828e-419a-8663-d1c4ba39f2b4",
                                "sense_id": "2c7b702b-0356-3ebe-a32e-745fd8d72d5d",
                                "text": "„Das Küchengarn entfernen und die Hähnchen nach Belieben tranchieren oder auf einem Reisbett anrichten und warm servieren.“"
                            },
                            {
                                "example_id": "406bd84d-5094-4e37-ad66-286bd8ea2ea7",
                                "sense_id": "2c7b702b-0356-3ebe-a32e-745fd8d72d5d",
                                "text": "„Auf Tellern auf einem Reisbett anrichten und die Soße darüberträufeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
