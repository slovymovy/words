                        "form": "den Tanzlehrer"
                    },
                    {
                        "form_id": "ec3b886d-1d46-49c3-a43f-adb660a44512",
                        "entry_id": "5dbc52ab-9dd8-3ac3-b546-cd078632cd1a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tanzlehrer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0832ca80-db7e-3933-8acf-7ed4e9297ab1",
                        "entry_id": "5dbc52ab-9dd8-3ac3-b546-cd078632cd1a",
                        "glosses": [
                            "Lehrer, der Unterricht im Tanzen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1653bddf-f6ba-4494-a617-01c66e1b7863",
                                "sense_id": "0832ca80-db7e-3933-8acf-7ed4e9297ab1",
                                "text": "„Reich werde man als Tanzlehrer zwar nicht, meint Franzen, doch man könne damit ganz gut über die Runden kommen.“"
                            },
                            {
                                "example_id": "7ac219e9-5716-41da-b36d-ae86ecffc810",
                                "sense_id": "0832ca80-db7e-3933-8acf-7ed4e9297ab1",
                                "text": "„Gut eine Stunde lang lassen sie sich vom Takt der Musik treiben und üben Choreographien ein, die ihnen Tanzlehrer Johannes Plehn zeigt.“"
                            },
                            {
                                "example_id": "968bd4fd-099f-4cc7-be4e-f6cb78ab04e7",
                                "sense_id": "0832ca80-db7e-3933-8acf-7ed4e9297ab1",
                                "text": "„Er riet mir, mit dem Ballettmeister Dupré zu sprechen, ihn als Tanzlehrer zu engagieren und ihn dafür zu bezahlen, daß er sie während des Karnevals irgendwo in einem Paartanz auftreten lasse.“"
                            },
                            {
                                "example_id": "dfcd7ab2-1353-411f-8b2b-ccb0a82a6868",
                                "sense_id": "0832ca80-db7e-3933-8acf-7ed4e9297ab1",
                                "text": "„Normalerweise ist es an dem Fürsten (König, Herzog, was immer), den heranwachsenden Sohn, der bisher sein Leben mit Haus-, Fecht- und Tanzlehrern verbracht hat (und mit der Jagd), langsam an die Regierungsgeschäfte heranzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
