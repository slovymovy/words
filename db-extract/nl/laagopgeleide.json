                        "examples": [
                            {
                                "example_id": "8fcb4c4e-d199-4600-9e7e-2558d053b51f",
                                "sense_id": "0bdd7ca1-a395-36c4-9cd5-c7ed74977bb7",
                                "text": "Het aantal rokers in Nederland neemt af, maar er is een groot verschil tussen mensen met een hoog of laag opleidingsniveau. Dat blijkt uit cijfers van het CBS, in samenwerking met het RIVM en het Trimbos-instituut. Het aandeel rokers onder hoogopgeleide mensen is bijna gehalveerd, onder laagopgeleiden is de daling veel lager."
                            }
                        ]
