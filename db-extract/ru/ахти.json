                                        "sense_id": "a807d88c-11ce-34ad-8737-9bb23439a3b9",
                                        "entry_id": "7cf9689b-587f-3bc1-960a-e0f90b4a06ba",
                                        "glosses": [
                                            "An expression of lamentation; alas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea8b911-350e-449c-8daf-c6648dee5f8b",
                                                "sense_id": "a807d88c-11ce-34ad-8737-9bb23439a3b9",
                                                "text": "Ah me, ah me! No other ghost has haunted the boy’s room, my friends, since I have occupied it, than the ghost of my own childhood, the ghost of my own innocence, the ghost of my own airy belief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b4f6fa3-9500-4ce4-9969-6d18f52dd7a5",
                        "source_entry_id": "44c84079-802f-3fbc-b9da-0eeeda0b40af",
                        "source_sense_id": "e8757219-f24d-3f43-886f-16ca829376fa",
                        "target_lang_word": "dear me",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dear me",
                                "target_lang_code": "en",
