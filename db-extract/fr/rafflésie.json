                    {
                        "sense_id": "b486f5ae-4178-35aa-a989-2f59dd73bdd5",
                        "entry_id": "57ad1a80-dace-3195-bb24-c7058f6fe0dc",
                        "glosses": [
                            "Plante holoparasite, sans tige, sans feuille, sans vraie racine, du genre Rafflesia poussant en Asie du Sud-Est et ayant l’une des plus grosses fleurs au monde fixée par un haustorium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "112bdca7-8216-4707-8cb6-7f1f9216da1d",
                                "sense_id": "b486f5ae-4178-35aa-a989-2f59dd73bdd5",
                                "text": "L’odeur de cadavre émise par la fleur de rafflésie attire des mouches qui assurent la pollinisation."
                            },
                            {
                                "example_id": "763caf78-3e3c-4e87-a333-ba8eb088989f",
                                "sense_id": "b486f5ae-4178-35aa-a989-2f59dd73bdd5",
                                "text": "L’odeur de la rafflésie est insupportable, et peut presque vous faire tourner de l’œil."
                            },
                            {
                                "example_id": "eac8f0bc-7909-4195-8cc4-86d3f579c4a7",
                                "sense_id": "b486f5ae-4178-35aa-a989-2f59dd73bdd5",
                                "text": "La rafflésie est la plus grande fleur du monde avec un diamètre pouvant atteindre un mètre, et un poids de sept kilos."
                            }
                        ]
                    }
                ],
