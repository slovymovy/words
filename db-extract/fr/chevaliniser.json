                "senses": [
                    {
                        "sense_id": "8bbc7698-cf98-361a-87ee-84dfc31ce6b1",
                        "entry_id": "222742a6-178a-36a3-9562-b20d80b7b269",
                        "glosses": [
                            "Donner un caractère chevalin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193e24ca-a1e0-499d-ba85-5578dc930817",
                                "sense_id": "8bbc7698-cf98-361a-87ee-84dfc31ce6b1",
                                "text": "Mon inspiration pour chevaliniser la créature."
                            },
                            {
                                "example_id": "54e93870-20e8-4c41-81f7-d079eb2ab603",
                                "sense_id": "8bbc7698-cf98-361a-87ee-84dfc31ce6b1",
                                "text": "je pense que c'est la tête qu'il faudrait davantage chevaliniser, après peut être qu'en ajoutant des crins ça passerait mieux aussi oui"
                            },
                            {
                                "example_id": "864e140c-6da9-43f9-a3ac-2f7b4ca5b450",
                                "sense_id": "8bbc7698-cf98-361a-87ee-84dfc31ce6b1",
                                "text": "Pour échapper à cet inconscient, à ses pulsions meurtrières et à ses peurs, l'homme ne peut que se « chevaliniser », choisir de devenir l'être le plus proche à la fois de sa condition d'homme et de l'animal domestiqué, au moment de ces instants de révolte et de fuite."
                            }
                        ]
                    }
