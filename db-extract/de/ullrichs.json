                ],
                "senses": [
                    {
                        "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                        "entry_id": "782728ad-b79d-3a5c-bee5-fa58330c925b",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd10d3d7-3654-4b5b-82e3-009d734a1510",
                                "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                                "text": "Frau Ullrichs ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6756fbaa-d36d-420b-b347-53fb5f4e73de",
                                "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                                "text": "Herr Ullrichs wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d3b51eb1-2ca7-4ba9-affa-c4f14b39a71a",
                                "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                                "text": "Die Ullrichens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7008582b-976d-46e8-8cdc-0890116d9f9f",
                                "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                                "text": "Der Ullrichs trägt nie die Schals, die die Ullrichs ihm strickt."
                            },
                            {
                                "example_id": "8b0602af-1425-45c8-a5ea-9401261b6da1",
                                "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ullrichs kommt, geht der Herr Ullrichs.“"
                            },
                            {
                                "example_id": "b9f15229-3c62-4258-9c06-d7244e1c453f",
                                "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                                "text": "Ullrichs kommt und geht."
                            },
                            {
                                "example_id": "7dd96dc8-d07c-447f-a14f-fcd50e5cc78e",
                                "sense_id": "4f62ee39-c978-3981-8213-8c9ff872f996",
                                "text": "Ullrichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
