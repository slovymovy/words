        "fr-extract.jsonl": [
            {
                "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                "word": "marbrure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aa10a0d1-be90-4184-95fb-d4c04713d2d9",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "tags": [
                            "plural"
                        ],
                        "form": "marbrures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b59ebd31-4d4a-3011-a7d5-bae05bd63b8d",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "glosses": [
                            "Imitation du marbre sur du papier, ou, sur la tranche, sur la couverture d’un livre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd9bac9-c1b6-4d99-bd99-e127d95dc5e6",
                                "sense_id": "b59ebd31-4d4a-3011-a7d5-bae05bd63b8d",
                                "text": "Une belle marbrure."
                            },
                            {
                                "example_id": "a6db0f8b-4aca-43f5-bec0-4e6f5acf23d5",
                                "sense_id": "b59ebd31-4d4a-3011-a7d5-bae05bd63b8d",
                                "text": "— Comment résister aux délices du bortsch, la soupe nationale, sorte de pot-au-feu, additionné de chou rouge et de crème fraîche, dont les marbrures glacées de rose et de blanc rappellent la page de garde d'un vieux bouquin."
                            }
                        ]
                    },
                    {
                        "sense_id": "27ce9e3c-e058-3e7d-a884-8f357788ceab",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "glosses": [
                            "Peinture que l’on met sur les boiseries, lorsqu’elle imite le marbre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a208b4b0-f9c9-3792-b6b5-1a67aa2f8a58",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "glosses": [
                            "Marques semblables aux veines du marbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f4ab693-5544-4f89-8b2a-9353b02d0f93",
                                "sense_id": "a208b4b0-f9c9-3792-b6b5-1a67aa2f8a58",
                                "text": "Les larges berges pavées faisaient deux longues routes grises que tachait çà et là la marbrure d’une file de tonneaux, d’un chariot attelé, d’un bateau de bois ou de charbon vidé à terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "91acf4f5-c9af-3427-a35d-f730b853d2a5",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "glosses": [
                            "Marques semblables aux veines du marbre qui se voient sur la peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40693ad8-a311-49f6-8047-66ebf42c64b9",
                                "sense_id": "91acf4f5-c9af-3427-a35d-f730b853d2a5",
                                "text": "Le froid produit des marbrures."
                            },
                            {
                                "example_id": "a9f84641-08ab-44bc-a351-f027b2da3127",
                                "sense_id": "91acf4f5-c9af-3427-a35d-f730b853d2a5",
                                "text": "Des oppressions, de la toux, une fièvre continuelle et des marbrures aux pommettes décelaient quelque affection profonde."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6ed6d23-2de3-3f5b-9145-9e9d06db54d2",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "glosses": [
                            "Disposition de différentes couleurs que l’on remarque sur le plumage de certains oiseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48931303-c4e6-462c-a5fe-c5df34c9f712",
                                "sense_id": "c6ed6d23-2de3-3f5b-9145-9e9d06db54d2",
                                "text": "Une marbrure jaune et grise."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0a268f4-0f60-31f2-95f7-5b0bde49d5a8",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "glosses": [
                            "Figure formée de bandes radiales d’apparence sombre, visible sur les anneaux de Saturne et tournant avec eux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "802f49fc-6f6d-3150-9c53-89279ae5688c",
                        "entry_id": "2fce2cbf-88f7-36a2-b8a7-7028e91d448f",
                        "glosses": [
