{
    "word_family": [
        "plunderer",
        "plundering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f606b8e-8a45-3214-bfd6-f525695b9c5c",
                    "sense_definition": "To steal goods from a place or person by force, especially during a war or riot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stealing by force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invading army began to <w>plunder</w> the city after the walls were breached.",
                            "target_lang_translations": {
                                "ru": "Вторгшаяся армия начала <w>разграблять</w> город после того, как стены были проломлены."
                            }
                        },
                        {
                            "text": "History books describe how soldiers would <w>plunder</w> villages for food and gold.",
                            "target_lang_translations": {
                                "ru": "В учебниках истории описывается, как солдаты <w>грабили</w> деревни в поисках еды и золота."
                            }
                        }
                    ],
                    "synonyms": [
                        "pillage",
                        "sack",
                        "loot"
                    ],
                    "common_phrases": [
                        "plunder the city",
                        "plunder the village"
                    ],
                    "target_lang_definitions": {
                        "ru": "Похищать товары или имущество из места или у человека с применением силы, особенно во время войны или беспорядков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грабить",
                                "target_lang_sense_clarification": "отнимать силой"
                            },
                            {
                                "target_lang_word": "разграблять",
                                "target_lang_sense_clarification": "опустошать место"
                            },
                            {
                                "target_lang_word": "мародёрствовать",
                                "target_lang_sense_clarification": "во время войны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86d130c9-267e-341e-90a5-14496d7ec0d5",
                    "sense_definition": "To use or exploit a resource in an excessive or wrongful way, as if by stealing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exploitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Corporations continue to <w>plunder</w> natural resources without regard for the environment.",
                            "target_lang_translations": {
                                "ru": "Корпорации продолжают <w>расхищать</w> природные ресурсы, не заботясь об окружающей среде."
                            }
                        },
                        {
                            "text": "The corrupt officials were caught trying to <w>plunder</w> the national treasury.",
                            "target_lang_translations": {
                                "ru": "Коррумпированные чиновники были пойманы при попытке <w>разграбить</w> государственную казну."
                            }
                        }
                    ],
                    "synonyms": [
                        "pillage",
                        "loot"
                    ],
                    "common_phrases": [
                        "plunder natural resources",
                        "plunder the treasury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать или эксплуатировать ресурс чрезмерным или незаконным образом, как если бы это было воровство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разграблять",
                                "target_lang_sense_clarification": "природные ресурсы или казну"
                            },
                            {
                                "target_lang_word": "расхищать",
                                "target_lang_sense_clarification": "государственное имущество"
                            },
                            {
                                "target_lang_word": "эксплуатировать",
                                "target_lang_sense_clarification": "чрезмерно использовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebe91caa-4b84-3102-b3a1-c00ff8ca83bc",
                    "sense_definition": "Goods or property that have been stolen or taken by force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stolen goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirates divided the <w>plunder</w> equally among the crew members.",
                            "target_lang_translations": {
                                "ru": "Пираты поровну разделили <w>добычу</w> между членами команды."
                            }
                        },
                        {
                            "text": "The soldiers hid their <w>plunder</w> in a secret cave near the coast.",
                            "target_lang_translations": {
                                "ru": "Солдаты спрятали <w>награбленное</w> в секретной пещере у побережья."
                            }
                        }
                    ],
                    "synonyms": [
                        "loot",
                        "booty",
                        "spoils",
                        "haul",
                        "swag"
                    ],
                    "common_phrases": [
                        "divide the plunder",
                        "stolen plunder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Товары или имущество, которые были украдены или захвачены силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добыча",
                                "target_lang_sense_clarification": "захваченное силой"
                            },
                            {
                                "target_lang_word": "награбленное добро",
                                "target_lang_sense_clarification": "украденные вещи"
                            },
                            {
                                "target_lang_word": "трофеи",
                                "target_lang_sense_clarification": "военная добыча"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84222fcd-09ac-3cd5-8440-1c6c0e8b14f3",
                    "sense_definition": "The act or an instance of stealing goods by force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "act of stealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The widespread <w>plunder</w> of the capital lasted for three days.",
                            "target_lang_translations": {
                                "ru": "Массовое <w>разграбление</w> столицы продолжалось три дня."
                            }
                        },
                        {
                            "text": "The museum was left in ruins after the systematic <w>plunder</w> of its galleries.",
                            "target_lang_translations": {
                                "ru": "Музей остался в руинах после систематического <w>разграбления</w> его галерей."
                            }
                        }
                    ],
                    "synonyms": [
                        "pillage",
                        "sack"
                    ],
                    "common_phrases": [
                        "systematic plunder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай кражи товаров силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разграбление",
                                "target_lang_sense_clarification": "процесс или результат"
                            },
                            {
                                "target_lang_word": "грабёж",
                                "target_lang_sense_clarification": "открытое хищение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bd45d72-de31-3ea4-bb0d-8158b129ddb8",
                    "sense_definition": "Personal belongings, baggage, or luggage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "belongings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler asked the boy to help him carry his <w>plunder</w> to the station.",
                            "target_lang_translations": {
                                "ru": "Путешественник попросил мальчика помочь ему донести его <w>пожитки</w> до станции."
                            }
                        },
                        {
                            "text": "He packed all his <w>plunder</w> into the wagon before starting the journey.",
                            "target_lang_translations": {
                                "ru": "Он упаковал весь свой <w>скарб</w> в повозку перед началом пути."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carry his plunder"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US dialectal"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "archaic usage for baggage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личные вещи, багаж или кладь (устаревшее или диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожитки",
                                "target_lang_sense_clarification": "мелкое имущество"
                            },
                            {
                                "target_lang_word": "скарб",
                                "target_lang_sense_clarification": "домашние вещи"
                            },
                            {
                                "target_lang_word": "багаж",
                                "target_lang_sense_clarification": "вещи в дорогу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}