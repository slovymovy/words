                "senses": [
                    {
                        "sense_id": "5945f345-8c2c-3e84-a226-1d8d57692485",
                        "entry_id": "127a23f1-155c-3b06-a3cf-52d5159c109b",
                        "glosses": [
                            "спец. свойство по значению прилагательного вариабельный; изменчивость, способность существовать в разных вариантах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc637f77-efce-41d8-b11c-71684ab99e84",
                                "sense_id": "5945f345-8c2c-3e84-a226-1d8d57692485",
                                "text": "Единство мнений ослабляет, не дает вариабельности поведения."
                            },
                            {
                                "example_id": "8bf1ff22-90ea-4a68-8d36-8dd01d2862a6",
                                "sense_id": "5945f345-8c2c-3e84-a226-1d8d57692485",
                                "text": "Вариабельность генома породила еще одно направление геномики, которое обычно называют этногеномикой."
                            }
                        ]
                    }
