                ],
                "senses": [
                    {
                        "sense_id": "76b9e0b8-dd45-3c10-8521-d7a00fbb0814",
                        "entry_id": "513e848d-dacf-3810-be5e-e3ab06354280",
                        "glosses": [
                            "fortschreitende Entstehung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2565916-acf1-41da-aa25-48160333e9f3",
                                "sense_id": "76b9e0b8-dd45-3c10-8521-d7a00fbb0814",
                                "text": "„‚[…] Dieser Faden brachte Völker zusammen.‘, schreibt die NZZ vom 15. August 1953 und beschreibt den Entwicklungsvorgang vom dreissig Gramm schweren Seidensamen zum drei Kilometer langen Seidenfaden.“"
                            },
                            {
                                "example_id": "9f77e3c8-90e9-4947-a478-77f6df717bfc",
                                "sense_id": "76b9e0b8-dd45-3c10-8521-d7a00fbb0814",
                                "text": "„Der Entwicklungsvorgang des Virus in den mit JUDR behandelten Zellen beschränkte sich auf die Bildung ausgezackter, nackter, strukturell unvollständiger, nichtinfektiöser Teilchen.“"
                            },
                            {
                                "example_id": "0852c2d9-29cf-4cb3-ba4a-c97b501f0375",
                                "sense_id": "76b9e0b8-dd45-3c10-8521-d7a00fbb0814",
                                "text": "„Der Entwicklungsvorgang des kleinsten Bandwurmes erfordert 2 Wirtswechsel.“"
                            },
                            {
                                "example_id": "479cf4dc-ca00-463b-bc19-0c91d2f20be9",
                                "sense_id": "76b9e0b8-dd45-3c10-8521-d7a00fbb0814",
                                "text": "„Die dazwischenliegenden Vorgänge der Ausbildung können sich darum beim menschlichen Ei nicht wesentlich anders abspielen), zumal auch die weiteren Entwicklungsvorgänge beim menschlichen Keim mit denen vieler anderer Säugetiere durchaus übereinstimmen.“"
                            },
                            {
                                "example_id": "5e553015-54bf-404d-9046-55d822e900d5",
                                "sense_id": "76b9e0b8-dd45-3c10-8521-d7a00fbb0814",
                                "text": "„Schon dieses anatomische Verhalten in Verbindung mit dem Entwicklungsvorgange der Theile giebt einen hinreichenden Grund ab, das Felsenbein ganz von dem Schläfenbein zu trennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "784df34c-30ca-3b32-bbed-6a3d2ac5277a",
                        "entry_id": "513e848d-dacf-3810-be5e-e3ab06354280",
                        "glosses": [
                            "Prozess, ein Bildmaterial zu festigen und sichtbar zu machen"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
                                "example_id": "22599ea3-00f1-4c4b-9ead-53204c02c809",
                                "sense_id": "784df34c-30ca-3b32-bbed-6a3d2ac5277a",
                                "text": "„Bei dem neuen Schwarzweiß-Film von Ilford wird -- in einer zusätzlichen Stufe des Entwicklungsvorgangs -- der Silberanteil in den Negativen durch einen Farbstoff von noch geheimer chemischer Zusammensetzung ersetzt.“"
                            },
                            {
                                "example_id": "79da4849-6270-41ba-9aea-6127aa452348",
                                "sense_id": "784df34c-30ca-3b32-bbed-6a3d2ac5277a",
                                "text": "„Beim Entwicklungsvorgang wird der Entwickler oxidiert, das heißt, er gibt Elektronen ab, welche von den Silberionen aufgenommen werden.“"
                            },
                            {
                                "example_id": "f8ad2b2b-16c0-438d-9ae5-3300d0814b1f",
                                "sense_id": "784df34c-30ca-3b32-bbed-6a3d2ac5277a",
                                "text": "„Das gleiche gilt, wie gezeigt, für die herkömmliche Fotografie mit ihrem langen Entwicklungsvorgang gegenüber dem Polaroid-Foto.“"
                            },
                            {
                                "example_id": "bd740d84-e59d-475a-b9c7-377990642c1d",
                                "sense_id": "784df34c-30ca-3b32-bbed-6a3d2ac5277a",
                                "text": "„Während des Entwicklungsvorgangs schwenkte er das Foto mit einer Hand. Es hatte etwa die Größe eines normalen Briefumschlags. Er wartete höchstens zwanzig bis fünfundzwanzig Sekunden, ehe er das Deckblatt abzog.“"
                            },
                            {
                                "example_id": "65834bda-3546-4c5a-ba2c-b4d5e3df03cd",
                                "sense_id": "784df34c-30ca-3b32-bbed-6a3d2ac5277a",
                                "text": "„Obwohl die chemische Zusammensetzung grundsätzlich den Charakter und die Arbeitsweise eines Entwicklers bestimmt, kann der Entwicklungsvorgang noch durch die Konzentration und Temperatur des Entwicklers, Dauer der Entwicklung und Häufigkeit der Bewegung beeinflußt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
