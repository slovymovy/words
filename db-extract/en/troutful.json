                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e26d63-1263-43f2-8a65-1d113f4b3154",
                                "sense_id": "250ea45e-c8be-33a4-b45a-fcd50322c35c",
                                "text": "I sit, as I write, beside the very troutful River Test, and on a stretch of it perhaps troutful above all others."
                            },
                            {
                                "example_id": "7dbb36cf-5955-4144-959a-18379ee1d540",
                                "sense_id": "250ea45e-c8be-33a4-b45a-fcd50322c35c",
                                "text": "The stream had been described 30 years before as \"a once troutful tributary.\" Perhaps it was now less troutful, its trout smaller. But to me it teemed, and its inhabitants were leviathans."
                            }
                        ]
