                    },
                    {
                        "translation_id": "a4552373-4dba-4072-9a85-4253c1dbf93d",
                        "source_entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                        "source_sense_description": "former country in the Balkans",
                        "target_lang_word": "Yougoslavie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yougoslavie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                        "entry_id": "2a4a7891-f835-3b4a-ba8a-e221609c3c8d",
                                        "glosses": [
                                            "Ancien pays slave qui était composé des actuels Croatie, Kosovo, Serbie, Monténégro, Bosnie-Herzégovine, Slovénie et Macédoine."
                                        ],
                                        "tags": [
                                            "Yougoslavie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20de53a8-24bf-4874-bfad-ecf808a27cbc",
                                                "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                                "text": "La Yougoslavie est un État indépendant depuis 1918, mais elle n'a été connue sous ce nom qu'à partir de 1929."
                                            },
                                            {
                                                "example_id": "1dd5081d-c1f7-489e-9783-a4774c493ed9",
                                                "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                                "text": "Le cinéaste Rajko Grlič, interviewé au festival du film de La Rochelle, l’été 1985, disait en substance qu’en Yougoslavie, tout change tous les cinq kilomètres : les gens, la langue, la religion, le paysage…"
                                            },
                                            {
                                                "example_id": "024c8740-98af-4fb0-9660-03991d8140cf",
                                                "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                                "text": "Et que serait-il arrivé si Faruk n’avait pas raté le pénalty ? Oui, ce pénalty-là, le dernier pénalty de la Yougoslavie, le rideau qui tombe sur la fin de la pièce. Ça n’aurait rien changé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69ba32bf-7165-41a8-90c7-642ee8f93bfb",
                        "source_entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                        "source_sense_description": "former country in the Balkans",
                        "target_lang_word": "Jugoslawien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jugoslawien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cdcce8d-07ab-3c4d-a7d4-c9b784d2c9cb",
                                        "entry_id": "830102be-7297-3747-af94-06e8b89019ea",
                                        "glosses": [
                                            "ehemaliger Staat (zwischen 1918 und 2006) in Südosteuropa"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987acadd-736e-4e4a-a93f-415714a5de37",
                                                "sense_id": "9cdcce8d-07ab-3c4d-a7d4-c9b784d2c9cb",
                                                "text": "„Jugoslawien hatte 1991 rund 23,5 Millionen Einwohner, es gab 19 Städte mit jeweils mehr als 100.000 Einwohnern.“"
                                            },
                                            {
                                                "example_id": "467a77e6-5b93-460d-a661-8e8d84c0c2a2",
                                                "sense_id": "9cdcce8d-07ab-3c4d-a7d4-c9b784d2c9cb",
                                                "text": "„Mit dem Partisanenführer Tito, der bereits große Teile Jugoslawiens beherrschte, hatte der sowjetische Diktator verabredet, daß die Rote Armee zu ihm und dann gemeinsam weiter westwärts durchstoßen werde.“"
                                            },
                                            {
                                                "example_id": "24635c09-b914-4753-abe4-e5ec7983be1e",
                                                "sense_id": "9cdcce8d-07ab-3c4d-a7d4-c9b784d2c9cb",
                                                "text": "„Streit gab es weiter über Jugoslawien, das die Westmächte zu 99 Prozent unter sowjetischer Kuratel sahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
