                "senses": [
                    {
                        "sense_id": "ec5373c0-95f5-3357-ba2e-62191982b4b1",
                        "entry_id": "0ad400ac-1737-3c23-b4fd-cbe89f708ee5",
                        "glosses": [
                            "Sorte d’ascenseur destiné au transport de personnes, mais qui sert à faire monter ou descendre des charges dans une usine ou dans une maison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fffe26b-2ff4-403f-b6b9-62214ac9cdfd",
                                "sense_id": "ec5373c0-95f5-3357-ba2e-62191982b4b1",
                                "text": "À un appel de sonnette on plaçait les plats et tout ce qui était nécessaire sur un monte-charge qui s'élevait jusqu’à la salle à manger et redescendait aussitôt."
                            }
                        ]
                    },
                    {
                        "sense_id": "452589a1-0130-3459-9c87-10dbf0c5e7fe",
                        "entry_id": "0ad400ac-1737-3c23-b4fd-cbe89f708ee5",
                        "glosses": [
                            "Ascenseur doté d’une cabine de grandes dimensions et équipé pour recevoir non seulement des personnes, mais aussi des charges volumineuses."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f96ca0d3-d06a-4ae7-9506-49f9394c01da",
                        "source_entry_id": "0ad400ac-1737-3c23-b4fd-cbe89f708ee5",
                        "target_lang_word": "Lastenaufzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lastenaufzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52f86e5b-2a4b-3403-b3d5-dca6799b9746",
                                        "entry_id": "65a3b39c-be7e-3ed8-9d99-22ad6e6fb5f8",
                                        "glosses": [
                                            "Aufzug, mit dem Lasten befördert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43ec0a06-a3ce-4b93-9a1e-c8f9700f60d1",
                                                "sense_id": "52f86e5b-2a4b-3403-b3d5-dca6799b9746",
                                                "text": "„Ich nahm den Lastenaufzug zur Tiefgarage, stieg in meinen Wagen und suchte das Weite.“"
                                            },
                                            {
                                                "example_id": "71fb5557-f590-4563-ac4f-53c5398ddb25",
                                                "sense_id": "52f86e5b-2a4b-3403-b3d5-dca6799b9746",
                                                "text": "„Inmitten seiner Eskorte in Polizeiblau ging Perkins langsamen Schrittes zu dem Lastenaufzug an der hinteren Wand des Trading Room.“"
                                            },
                                            {
                                                "example_id": "70cf86aa-939b-4ab0-b844-3573a6ad3fd1",
                                                "sense_id": "52f86e5b-2a4b-3403-b3d5-dca6799b9746",
                                                "text": "„Gegenüber von Court befand sich der hölzerne Zugang zu einem Lastenaufzug, daneben ein schmales Treppenhaus ohne Tür.“"
                                            },
                                            {
                                                "example_id": "70a8d119-2a9f-4471-86f3-126cdd7e01b9",
                                                "sense_id": "52f86e5b-2a4b-3403-b3d5-dca6799b9746",
                                                "text": "„Einer der drei großen Lastenaufzüge funktionierte noch, obwohl Kurtz ihn nie benutzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eee73da-a416-415a-8be6-291b7cb3650e",
