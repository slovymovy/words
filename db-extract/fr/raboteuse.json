                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a8f09a6-d0a9-3a07-87a5-fb7dbf13a8c6",
                        "entry_id": "781699b0-341e-3066-ac12-c3c10a6c7dbc",
                        "glosses": [
                            "Machine destinée à raboter le bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "708cbc3c-c1c6-41be-83bc-2362bdf4ca23",
                                "sense_id": "9a8f09a6-d0a9-3a07-87a5-fb7dbf13a8c6",
                                "text": "L'ensemble des matériaux et de l'équipement nécessaires (ce qui incluait le bois, une scie circulaire et son support, des perceuses-visseuses, forets et vis, une raboteuse électrique, de la peinture, des piquets, etc.) fut offert aux rangers par l'intermédiaire des deux acteurs non-aborigènes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "337a7dc1-ddb6-4142-9664-8e5843adbb08",
                        "source_entry_id": "781699b0-341e-3066-ac12-c3c10a6c7dbc",
                        "source_sense_id": "9a8f09a6-d0a9-3a07-87a5-fb7dbf13a8c6",
                        "target_lang_word": "planer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a76951f5-ff1e-3e15-b2cb-4a8f3469a33a",
                                        "entry_id": "5c1b099b-7689-3a19-a605-ed9be777de94",
                                        "glosses": [
                                            "A tool which smooths a surface or makes one surface of a workpiece parallel to the tool's bed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a88c230c-eb84-3157-b27a-0374cd612557",
                                        "entry_id": "5c1b099b-7689-3a19-a605-ed9be777de94",
                                        "glosses": [
                                            "A person employed to use this kind of woodworking tool."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52fdd753-93cb-36a1-848e-db2844d7678e",
                                        "entry_id": "5c1b099b-7689-3a19-a605-ed9be777de94",
                                        "glosses": [
                                            "A large machine tool in which the workpiece is traversed linearly (by means of a reciprocating bed) beneath a single-point cutting tool. (Analogous to a shaper but larger and with the workpiece moving instead of the tool.) Planers can generate various shapes, but were most especially used to generate large, accurate flat surfaces. The planer is nowadays obsolescent, having been mostly superseded by large milling machines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1da7e2-381e-4598-bd64-f1a49564a2ee",
                                                "sense_id": "52fdd753-93cb-36a1-848e-db2844d7678e",
                                                "text": "Besides the usual run of machines, planers, millers, automatics, centre lathes, cranes, etc., there were several power stations, the rolling mills for strip material and for 60 ft. rails, and all the steel furnaces with their complicated systems of flues. If variety is the spice of life, then there was plenty here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25784372-4017-3f7d-ae22-27af14675bcd",
                                        "entry_id": "5c1b099b-7689-3a19-a605-ed9be777de94",
                                        "glosses": [
                                            "A wooden block used for forcing down the type in a form, and making the surface even."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "946468be-7ad9-4c1f-bd8c-cdeae3d55999",
                                                "sense_id": "25784372-4017-3f7d-ae22-27af14675bcd",
                                                "text": "the compositor \"planes down\" the \"forme,\" to make a the surface of the type stand flat and even, by blows of the mallet upon a piece of smooth wood laid upon the pages, called, from its use, \"a planer;\" and it is then ready for the pressman"
                                            }
                                        ]
                                    }
                                ]
                            },
