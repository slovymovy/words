                                            {
                                                "example_id": "269da868-8b93-4f74-8af7-3be34a77c7d5",
                                                "sense_id": "d9e3c1be-c62a-38dd-89f4-e500ec2b10cf",
                                                "text": "Deux cents s’écrit CC en chiffres romains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a96c5b-992a-3359-8428-a80f2d06f033",
                                        "entry_id": "0af2e868-3f74-3749-b5b1-3f58777f6b93",
                                        "glosses": [
                                            "Objet numéroté 200."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27200388-424a-3734-8285-2374d155eacc",
                                        "entry_id": "0af2e868-3f74-3749-b5b1-3f58777f6b93",
                                        "glosses": [
                                            "À la belote, carré de valets, annonce qui rapporte 200 points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3acc8e3c-53c0-4b55-b6fa-6d76b2806398",
                                                "sense_id": "27200388-424a-3734-8285-2374d155eacc",
                                                "text": "Il dit qu’à propos de belote, avant-guerre, il en faisait une un soir avec des copains et l’un d’eux avait annoncé un cent cinquante de neufs, mais son partenaire à lui, Riton, avait un deux cents de valets et tout le monde s’était marré dans le bistro …."
                                            },
                                            {
                                                "example_id": "d9ba9d03-1409-48b4-9a19-075ba2fc9fa6",
                                                "sense_id": "27200388-424a-3734-8285-2374d155eacc",
                                                "text": "Je vous parie un deux cents de valets contre un valet de chambre qu’on peut, d’ici, presque lire ce que le bonhomme écrit."
                                            },
                                            {
                                                "example_id": "c631f596-e7e7-4ecb-98c2-97e5a2084850",
                                                "sense_id": "27200388-424a-3734-8285-2374d155eacc",
                                                "text": "Si tu gagnes par un deux cents de valet, le mec te paye quatre cents balles et quelques plumes des autres points."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deux cents",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5956f7c-543e-3e68-9f9a-4be15eb0b64e",
                                        "entry_id": "1cad95e9-be02-3772-a21f-4a52d4e310ea",
                                        "glosses": [
                                            "Adjectif numéral cardinal correspondant au nombre 200."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81910fe4-a7ed-4155-8a50-66fcb834c272",
                                                "sense_id": "a5956f7c-543e-3e68-9f9a-4be15eb0b64e",
                                                "text": "Fernando de Noronha étant le bagne brésilien de l’État de Pernambuco, nous obtenons du directeur du pénitencier que deux cents forçats soient mis à notre disposition."
                                            },
                                            {
                                                "example_id": "665f575d-b7bd-42e8-83ee-18b364efd735",
                                                "sense_id": "a5956f7c-543e-3e68-9f9a-4be15eb0b64e",
                                                "text": "Le passage du fleuve, large en ce point de deux cents mètres, se fait au moyen d’embarcations plates de six à dix mètres de long."
                                            },
                                            {
                                                "example_id": "9c324533-49be-4046-9a5f-8be13831b53a",
                                                "sense_id": "a5956f7c-543e-3e68-9f9a-4be15eb0b64e",
                                                "text": "Les Versaillais balayèrent place Blanche une barricade défendue par deux cents femmes suivant l’exemple de Louise Michel, une des dirigeantes de la Commune. Puis ils nettoyèrent au canon la place de Clichy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
