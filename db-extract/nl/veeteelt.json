                                        "examples": [
                                            {
                                                "example_id": "a2ff267a-0ad4-48d6-a019-f521a2267f9d",
                                                "sense_id": "d4df30ea-b9ba-3471-88c6-af4da700275d",
                                                "text": "„Dort wird auf fruchtbarem Boden zum Beispiel Kaffee angebaut, also Land-, auch Viehwirtschaft betrieben.“"
                                            }
