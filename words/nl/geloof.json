                                "en": "I have every <w>faith</w> that the project will succeed.",
                                "pl": "Mam głęboką <w>wiarę</w> w to, że ten projekt się powiedzie.",
                                "de": "Ich habe volles <w>Vertrauen</w> darauf, dass das Projekt gelingen wird.",
                                "fr": "J'ai toute <w>confiance</w> dans la réussite du projet.",
                                "it": "Ho piena <w>fiducia</w> che il progetto avrà successo.",
                                "cs": "Pevně <w>věřím</w>, že projekt uspěje.",
                                "tr": "Projenin başarılı olacağına dair tam bir <w>inancım</w> var.",
                                "es": "Tengo plena <w>fe</w> en que el proyecto tendrá éxito."
                            }
                        },
                        {
                            "text": "Je moet niet te veel <w>geloof</w> hechten aan die geruchten.",
                            "target_lang_translations": {
                                "ru": "Не стоит принимать эти слухи на <w>веру</w>.",
                                "en": "You shouldn't put too much <w>faith</w> in those rumors.",
                                "pl": "Nie powinieneś dawać zbyt dużej <w>wiary</w> tym plotkom.",
                                "de": "Man sollte diesen Gerüchten nicht allzu viel <w>Glauben</w> schenken.",
                                "fr": "Il ne faut pas accorder trop de <w>crédit</w> à ces rumeurs.",
                                "it": "Non dovresti dare troppo <w>credito</w> a quelle voci.",
                                "cs": "Těmto fámám bys neměl přikládat přílišnou <w>váhu</w>.",
                                "tr": "Bu söylentilere çok fazla <w>itimat</w> etmemelisin.",
                                "es": "No deberías dar demasiado <w>crédito</w> a esos rumores."
                            }
                        }
