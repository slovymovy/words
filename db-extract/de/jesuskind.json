                "senses": [
                    {
                        "sense_id": "62054f93-81f2-35ba-a2fa-ac1760419ca0",
                        "entry_id": "96fe8e2c-26ff-3670-94d8-e881bb0d084d",
                        "glosses": [
                            "Jesus als Kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e7958d-ecda-4027-aa4c-96eb1bb1dbf6",
                                "sense_id": "62054f93-81f2-35ba-a2fa-ac1760419ca0",
                                "text": "„Bevor ich nach Aranjuez gefahren war, hatte ich in Madrid das Bild der Heiligen Jungfrau mit dem Jesuskind an der Brust gesehen.“"
                            },
                            {
                                "example_id": "ac2bcfd0-8d8e-44b7-b1a3-95efcfa5d716",
                                "sense_id": "62054f93-81f2-35ba-a2fa-ac1760419ca0",
                                "text": "„Müßig ruhten aller Hände im Schoß, keine hielt das Jesuskind im Arm.“"
                            },
                            {
                                "example_id": "26d8d6e9-fe37-48c6-9a5a-9a4a99ea7b0c",
                                "sense_id": "62054f93-81f2-35ba-a2fa-ac1760419ca0",
                                "text": "„Auch das Jesuskind, das sie auf der Hand hielt, hatte ein schwarzes Gesicht und schwarze Haare und ein goldenes Gewand, nur ohne Gürtel.“"
                            },
                            {
                                "example_id": "dcd70bd7-7ab6-41ab-adfa-bed1d50bead5",
                                "sense_id": "62054f93-81f2-35ba-a2fa-ac1760419ca0",
                                "text": "„Aber überall gehörte zum Kernbestand des Personals der heilige Christopherus, der auch im Cranachbild im Mittelpunkt steht, das Jesuskind auf der Schulter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
