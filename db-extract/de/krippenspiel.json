                                "example_id": "a7786be2-25b5-4890-be56-fbb1118e0f6d",
                                "sense_id": "99073132-6b97-311d-b04b-35f787f8dfa9",
                                "text": "„Gerade in Deutschland ist das Krippenspiel von Kindern am Heiligen Abend populär. “"
                            }
                        ],
