        "de-extract.jsonl": [
            {
                "entry_id": "e55aa6fc-2cc9-3381-91e7-e9a8939db56c",
                "word": "DDT",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b6170969-1f07-3d46-ae15-c078708010eb",
                        "entry_id": "e55aa6fc-2cc9-3381-91e7-e9a8939db56c",
                        "glosses": [
                            "Abkürzung von DichlorDiphenylTrichlorethan – ein Insektizid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7fada05-c866-44ad-bed4-f49e60a4cc35",
                                "sense_id": "b6170969-1f07-3d46-ae15-c078708010eb",
                                "text": "„Neben dem DDT ist noch eine ganze Reihe weiterer Stoffe in den Verdacht geraten, Krebsauslöser oder zumindest Krebspromotoren zu sein. Die meisten zählen zur Gruppe der Organochloride, zu denen außer dem DDT auch das PCB und das Dioxin gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "012c7647-8de6-4dad-92a7-c837b7973db6",
                        "source_entry_id": "e55aa6fc-2cc9-3381-91e7-e9a8939db56c",
                        "source_sense_id": "b6170969-1f07-3d46-ae15-c078708010eb",
                        "source_sense_description": "Abkürzung von „DichlorDiphenylTrichlorethan“",
                        "target_lang_word": "DDT",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "DDT",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ec3140-86b1-3a6d-a449-095957961fd3",
                                        "entry_id": "c0c01988-ed9d-3486-8bb5-17cee8f7e2f2",
                                        "glosses": [
                                            "Dichlorodiphényltrichloroéthane, insecticide de contact neurotoxique de la famille des organochlorés, dont le nom scientifique est 1,1,1-trichloro-2,2-bis(4-chlorophényl)-éthane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff57c2c-2cbc-4be3-af55-47dff5f32bc4",
                                                "sense_id": "e1ec3140-86b1-3a6d-a449-095957961fd3",
                                                "text": "On pourra donc traiter soit en pulvérisation, avec une émulsion de DDT dans l'huile minérale, à la dose de 1 %, soit en poudrage avec une poudre de DDT à 5 % seulement […]."
                                            },
                                            {
                                                "example_id": "e2a33a17-150a-4fbd-b501-35799a7d9299",
                                                "sense_id": "e1ec3140-86b1-3a6d-a449-095957961fd3",
                                                "text": "C'est le développement de l'industrie chimique de synthèse qui a permis à la phytopharmacie de faire un bond décisif. En 1938, le suisse Paul Muller, prix Nobel 1939, découvre les propriétés insecticides du dichloro-diphényltrichloroéthane ou DDT pourtant synthétisé depuis 1874 par l'autrichien Zeidler."
                                            },
                                            {
                                                "example_id": "5f7d05bf-6124-4c94-9108-3e60fc25d82b",
                                                "sense_id": "e1ec3140-86b1-3a6d-a449-095957961fd3",
                                                "text": "Les résidus d'insecticides les plus couramment rencontrés dans ces deux retenues sont le DDE, le DDD, le DDT et la dieldrine."
                                            },
                                            {
                                                "example_id": "e6f24119-e3d6-4971-b598-96a874cf34ae",
                                                "sense_id": "e1ec3140-86b1-3a6d-a449-095957961fd3",
                                                "text": "Il se montrait très exigeant en matière de propreté. Il poussait Amei à balayer et à épousseter, allait même jusqu'à acheter du DDT américain et à le pulvériser dans nos chambres pour tuer tous les moustiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "DDT",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc18a6e4-7a4e-3b01-8ba6-6ed4232c3c36",
                                        "entry_id": "611f33c7-9d76-335d-86df-0c9656885332",
                                        "glosses": [
                                            "En France, direction chargée de mettre en œuvre les politiques d’aménagement et de développement des territoires dans chaque département."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22843c83-d8c2-4fd4-9146-223b109bab8b",
                                                "sense_id": "cc18a6e4-7a4e-3b01-8ba6-6ed4232c3c36",
                                                "text": "Les agents de l’Onema (Office national de l’eau et des milieux aquatiques) et de la DDT (Direction départementale des territoires) sont habilités à effectuer des contrôles chez l’habitant et à appliquer les éventuelles sanctions."
                                            },
                                            {
                                                "example_id": "76f9116d-c0e4-4a75-a575-8000b7686660",
                                                "sense_id": "cc18a6e4-7a4e-3b01-8ba6-6ed4232c3c36",
                                                "text": "Les services de la DDT sont ouverts au public du lundi au vendredi de 8H30 à 12H et de 14H à 17H."
                                            },
                                            {
                                                "example_id": "5ca9488f-e81b-4e35-a586-ab7520803312",
                                                "sense_id": "cc18a6e4-7a4e-3b01-8ba6-6ed4232c3c36",
                                                "text": "La Direction Départementale des Territoires (DDT) du Loiret est chargée de mettre en œuvre les politiques d’aménagement et de développement durables des territoires, tant urbains que ruraux, par le biais des politiques agricole, d’aménagement, d’urbanisme, de logements, de risques, de construction publique, d'environnement, de protection et de gestion durable de l’eau ou encore de transports."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
