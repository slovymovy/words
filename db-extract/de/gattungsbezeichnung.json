                "senses": [
                    {
                        "sense_id": "a221a76b-6c1d-3d50-a303-f4a2bf8fd369",
                        "entry_id": "42b85fd1-6589-34a7-b995-73d80b8a0fec",
                        "glosses": [
                            "Bezeichnung für eine Klasse von Personen, Tieren, Pflanzen oder Gegenständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650a308c-068b-4152-bbb2-5a4c55481724",
                                "sense_id": "a221a76b-6c1d-3d50-a303-f4a2bf8fd369",
                                "text": "„Kind“ ist eine Gattungsbezeichnung, „Inge“ ein Eigenname."
                            },
                            {
                                "example_id": "dfeb064f-2d6a-4d35-97fe-f460f618435c",
                                "sense_id": "a221a76b-6c1d-3d50-a303-f4a2bf8fd369",
                                "text": "Gattungsbezeichnungen kann man für eine Menge von Individuen oder Gegenständen verwenden."
                            },
                            {
                                "example_id": "16d7cecc-bc44-452e-8a62-f2212dac08cc",
                                "sense_id": "a221a76b-6c1d-3d50-a303-f4a2bf8fd369",
                                "text": "„Eine Hervorhebung des Personennamens ist nicht zu empfehlen, wenn die Zusammensetzung zu einer Gattungsbezeichnung geworden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
