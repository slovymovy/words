                                        "entry_id": "5b31e77f-d0fd-3bb9-873d-3a89fb6e3faa",
                                        "glosses": [
                                            "eine gravitativ gebundene Ansammlung mehrerer Galaxienhaufen im Weltall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6b1212-9297-4455-a4e4-20fb2fd29c79",
                                                "sense_id": "284189c8-2f8a-3c0d-8be3-24433e213cb0",
                                                "text": "Der Virgo-Superhaufen besteht aus etwa 100–200 Galaxienhaufen; die Milchstraße ist ein kleiner Teil davon."
                                            },
                                            {
                                                "example_id": "5c9e3373-afd4-400f-b0f4-a1f59337f4a1",
                                                "sense_id": "284189c8-2f8a-3c0d-8be3-24433e213cb0",
                                                "text": "„Sie sind die größten Materieansammlungen im Kosmos: Superhaufen enthalten zehntausende von Galaxien und erstrecken sich über gewaltige Entfernungen hinweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
