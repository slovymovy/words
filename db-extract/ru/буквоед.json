                    },
                    {
                        "translation_id": "122905db-3831-4a62-ac5c-f30b4dd51796",
                        "source_entry_id": "6b91c8db-4054-309a-9a11-08ee1795c93f",
                        "source_sense_id": "78818be4-1ba3-34f3-b766-77b5395255db",
                        "target_lang_word": "pédant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pédant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd08b474-6e38-3504-9042-85d8bbeb7b58",
                                        "entry_id": "6db57ee3-9290-3781-8a56-49d6ea0874e5",
                                        "glosses": [
                                            "Qui fait étalage de son savoir de manière prétentieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403700ca-c8f0-4717-abf0-03748f597fab",
                                                "sense_id": "cd08b474-6e38-3504-9042-85d8bbeb7b58",
                                                "text": "Nous avions un savant à Beaucaire ; il est instruit, mais outrageusement pédant ; il nous disait qu’il a compté en provençal trois mille mots qui ne sont pas d’origine latine."
                                            },
                                            {
                                                "example_id": "9a321eac-8928-4c20-a5bd-5ec9bc797384",
                                                "sense_id": "cd08b474-6e38-3504-9042-85d8bbeb7b58",
                                                "text": "C’est toujours le même peuple de pantins pédants, c’est toujours le même angle droit à chaque mouvement, et sur le visage la même suffisance glacée et stéréotypée."
                                            },
                                            {
                                                "example_id": "fe879636-f92d-483e-a5d9-3db92ac54d56",
                                                "sense_id": "cd08b474-6e38-3504-9042-85d8bbeb7b58",
                                                "text": "« Il y aura toujours chez lui du précepteur et du parvenu. Il sera pédant et en sueur, comme tous les gens qui n’ont pour eux que le vouloir et qui n’arrivent que par le travail. J’aime mieux des dons d’esprit ou de la naissance, ou, faute de cela, j’aime mieux rien. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pédant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc92b7b-f34a-3bd6-8c64-b8da86e03373",
                                        "entry_id": "ac460a51-7dc1-3c36-ab6f-50b704cb38c2",
                                        "glosses": [
                                            "Éducateur, maître d’école."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2bb2c33-35bd-47f8-af94-0710cdd45d48",
                                                "sense_id": "dfc92b7b-f34a-3bd6-8c64-b8da86e03373",
                                                "text": "Les pédants ont gâté cet enfant."
                                            },
                                            {
                                                "example_id": "96dfc843-301b-4db1-8315-9c8c45d0a3ae",
                                                "sense_id": "dfc92b7b-f34a-3bd6-8c64-b8da86e03373",
                                                "text": "On ne s’imagine Platon et Aristote qu’avec de grandes robes de pédants ; c’étaient des gens honnêtes et, comme les autres, riant avec leurs amis."
                                            },
                                            {
                                                "example_id": "da78c21a-9e76-4bed-9d89-0882ff8664e1",
                                                "sense_id": "dfc92b7b-f34a-3bd6-8c64-b8da86e03373",
                                                "text": "Un pédant de collège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be0cf970-3a07-3326-9213-8adb348077a0",
                                        "entry_id": "ac460a51-7dc1-3c36-ab6f-50b704cb38c2",
                                        "glosses": [
                                            "Celui qui fait étalage de son savoir et qui parle doctoralement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98702508-0340-48af-b8ae-0c2d6dae4a58",
                                                "sense_id": "be0cf970-3a07-3326-9213-8adb348077a0",
                                                "text": "Là-dessus arrivèrent les savants, les grammairiens, les pédants, et particulièrement Robert Estienne, avec son dictionnaire de 1540. Robert Estienne était féru de latinité et d’étymologie. Il voulut calquer la langue française sur la latine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47dd25a-f4cf-3bdd-bd6c-e5936e8ce0c2",
                                        "entry_id": "ac460a51-7dc1-3c36-ab6f-50b704cb38c2",
                                        "glosses": [
                                            "Celui qui affecte de faire la leçon à tout le monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48025528-4fa1-4d7d-bc78-20060ed61f10",
                                                "sense_id": "b47dd25a-f4cf-3bdd-bd6c-e5936e8ce0c2",
                                                "text": "C’est un pédant insupportable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
