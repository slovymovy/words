                "senses": [
                    {
                        "sense_id": "5b1783ed-e493-309e-82b3-2eb88bbce4bd",
                        "entry_id": "67b9fe37-6f28-36af-93b6-b7c3526f5396",
                        "glosses": [
                            "разг. схитрить, сказать неправду, обмануть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67dc93f4-13d0-49c4-93bb-5990ef262c35",
                                "sense_id": "5b1783ed-e493-309e-82b3-2eb88bbce4bd",
                                "text": "Вчера я написал, что не знаю, отчего все переменилось, но я слукавил, ― я знаю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcec30c8-f763-41d3-9a2a-076a734a03c1",
