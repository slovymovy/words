                            "target_lang_translations": {
                                "en": "The children like to play in the <w>playground</w> of the old school."
                            }
                        },
                        {
                            "text": "Onze kamers keken uit op een gezellige, met planten versierde <w>cour</w>.",
                            "target_lang_translations": {
                                "en": "Our rooms looked out onto a cozy <w>courtyard</w> decorated with plants."
                            }
