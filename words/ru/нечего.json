{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "475bb30c-f334-3006-87ff-0df3b8175835",
                    "sense_definition": "отсутствие чего-либо для совершения действия",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "отсутствие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне сегодня <w>нечего</w> делать.",
                            "target_lang_translations": {
                                "en": "I have <w>nothing</w> to do today."
                            }
                        },
                        {
                            "text": "В холодильнике пусто, <w>нечего</w> есть.",
                            "target_lang_translations": {
                                "en": "The fridge is empty, there is <w>nothing</w> to eat."
                            }
                        }
                    ],
                    "common_phrases": [
                        "нечего делать",
                        "нечего есть"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate that there is nothing available to perform a specific action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nothing to",
                                "target_lang_sense_clarification": "Used with a verb to express lack of resources or options."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "478af7f0-4a7e-360f-9a0c-0ede54a89f0d",
                    "sense_definition": "отсутствие необходимости или смысла что-либо делать",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "отсутствие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Нечего</w> жаловаться на погоду, мы сами выбрали этот день.",
                            "target_lang_translations": {
                                "en": "There is <w>no point</w> in complaining about the weather; we chose this day ourselves."
                            }
                        },
                        {
                            "text": "Там <w>нечего</w> обсуждать, решение уже принято.",
                            "target_lang_translations": {
                                "en": "There is <w>nothing</w> to discuss there; the decision has already been made."
                            }
                        }
                    ],
                    "synonyms": [
                        "не́фиг",
                        "не́хер"
                    ],
                    "common_phrases": [
                        "нечего жаловаться",
                        "нечего обсуждать"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express that there is no point, reason, or necessity to do something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "no point in",
                                "target_lang_sense_clarification": "Used to suggest that an action is futile or unnecessary."
                            },
                            {
                                "target_lang_word": "no reason to",
                                "target_lang_sense_clarification": "Used to state that there is no justification for an action."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "39ff9ca7-4fb4-3923-b8ae-8392040f7693",
                    "sense_definition": "отсутствие смысла или необходимости",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "отсутствие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туда идти <w>незачем</w>, магазин уже закрыт.",
                            "target_lang_translations": {
                                "en": "There is <w>no need</w> to go there; the store is already closed."
                            }
                        },
                        {
                            "text": "Спорить об этом <w>незачем</w>.",
                            "target_lang_translations": {
                                "en": "There is <w>no point</w> in arguing about this."
                            }
                        }
                    ],
                    "synonyms": [
                        "незачем"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate that an action is pointless or lacks a valid purpose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "no need to",
                                "target_lang_sense_clarification": "Used to indicate that an action is not required."
                            },
                            {
                                "target_lang_word": "no point in",
                                "target_lang_sense_clarification": "Used to indicate that an action is useless."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}