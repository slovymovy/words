    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "915b89e0-152b-327c-bf11-0f6b30fc9d0a",
                "word": "permanence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "40942e2d-1df7-413c-bce0-80bfc24d249c",
                        "entry_id": "915b89e0-152b-327c-bf11-0f6b30fc9d0a",
                        "tags": [
                            "plural"
                        ],
                        "form": "permanences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02e12989-a118-3d24-a32c-e1b889b5deda",
                        "entry_id": "915b89e0-152b-327c-bf11-0f6b30fc9d0a",
                        "glosses": [
                            "The state of being permanent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8047e179-93ad-4fc3-a39e-96ebcd815423",
                                "sense_id": "02e12989-a118-3d24-a32c-e1b889b5deda",
                                "text": "To foreigners we often seem guileless and overchatty, an impression which is dispersed when they find that much of our friendliness is just the ebullition of the moment and does not carry with it any permanence of devotion."
                            },
                            {
                                "example_id": "126fac52-f89c-4634-a9dc-155e70b18f11",
                                "sense_id": "02e12989-a118-3d24-a32c-e1b889b5deda",
                                "text": "Transport Scotland acknowledges that the permanence of the new fares regime could be the clincher in persuading people to \"travel more often and make long-term choices with certainty, helping people to leave the car at home\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1fa5d21-2eae-39ae-a2f0-5e2a61385b18",
                        "entry_id": "915b89e0-152b-327c-bf11-0f6b30fc9d0a",
                        "glosses": [
                            "The reciprocal of magnetic inductance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63fc51af-0f40-4a0e-8caa-a9d0f2b26832",
                        "source_entry_id": "915b89e0-152b-327c-bf11-0f6b30fc9d0a",
                        "source_sense_description": "the state of being permanent",
                        "target_lang_word": "permanence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permanence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "293f921d-5017-30e8-bf8d-1388763ecc72",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "Durée constante de quelque chose, état de ce qui est permanent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512c367c-53bb-4cd6-89d2-16d80537dab1",
                                                "sense_id": "293f921d-5017-30e8-bf8d-1388763ecc72",
                                                "text": "Le tragique est que là, devant moi, le passé reste mort en sa permanence et permanent en son dessèchement, tache ineffaçable ou parfum irretrouvable."
                                            },
                                            {
                                                "example_id": "e08e560a-5380-4c18-bd86-ccda400785f1",
                                                "sense_id": "293f921d-5017-30e8-bf8d-1388763ecc72",
                                                "text": "Une tradition, une erreur, dont on constate la permanence."
                                            },
                                            {
                                                "example_id": "8456197d-458f-4e65-b958-f3d1e706caa6",
                                                "sense_id": "293f921d-5017-30e8-bf8d-1388763ecc72",
                                                "text": "Un emploi dont la permanence n’est pas assurée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee51d842-1086-3be9-8f59-9b30ebfb7005",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "État de celui qui reste, qui demeure longtemps dans le même lieu, en parlant des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072f4fba-8e2b-409e-9f75-f55b3216bf41",
                                                "sense_id": "ee51d842-1086-3be9-8f59-9b30ebfb7005",
                                                "text": "Vous me trouverez à mon bureau à toute heure : j’y reste en permanence."
                                            },
                                            {
                                                "example_id": "1f165bf7-8b51-4827-b91d-c07596db8a35",
                                                "sense_id": "ee51d842-1086-3be9-8f59-9b30ebfb7005",
                                                "text": "Je suis resté là en permanence à vous attendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dc4a029-1bd8-34d2-a0c7-5f0e27114166",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "État d'un groupe qui ne se sépare pas, qu’elle reste en séance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ec7ae3-c68a-447a-b58f-01003c8bfaac",
                                                "sense_id": "7dc4a029-1bd8-34d2-a0c7-5f0e27114166",
                                                "text": "L’assemblée s’est déclarée en permanence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1be1da-8212-315a-b3c7-97bc3ef140df",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "État d'une personne qui assure la continuité d'un service public durant les congés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f5249a-1e31-4ab5-a5e3-9813a1faab13",
                                                "sense_id": "af1be1da-8212-315a-b3c7-97bc3ef140df",
                                                "text": "Le 28 mai, jeudi de l'Ascension, Charasse est de permanence à l'Élysée, dans l'appartement dédié à cet effet, lequel comprend un salon-salle à manger et une chambre à coucher. Ce soir-là, Gaston Defferre, le puissant patron de la fédération des Bouches-du-Rhône nommé ministre de l'Intérieur est seul place Beauveau ; Charasse l'invite à dîner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fbd337d-682c-3be2-90a1-4450e227a005",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "Principe, admis par les chrétiens, de la présence continuée du corps de Jésus-Christ dans l’eucharistie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6350c924-5d21-4705-b388-75b87052c24d",
                                                "sense_id": "5fbd337d-682c-3be2-90a1-4450e227a005",
                                                "text": "La permanence du corps de Jésus-Christ dans l’hostie consacrée,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bebfd817-0e7d-3c2d-b255-b3e08361e67a",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "Local dans lequel se tiennent constamment certaines personnes chargées d’un service public ou privé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "526aa1fd-d34b-4ac6-a038-19a35e0792b7",
                                                "sense_id": "bebfd817-0e7d-3c2d-b255-b3e08361e67a",
                                                "text": "Aude Amadou, députée En Marche de Nantes-Rezé, vient d’installer son bureau dans le quartier de Pont-Rousseau, à Rezé. […] La permanence sera ouverte tous les jours, tenue par une assistante parlementaire recrutée en ce début d’année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430ab445-da02-370d-b69e-37c938d94c02",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "Temps et lieu d’ouverture au public d’un service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e270530-efa1-4eda-9a1e-83b8316aead0",
                                                "sense_id": "430ab445-da02-370d-b69e-37c938d94c02",
                                                "text": "Les étudiants qui souhaitent voir leur copie sont invités à se présenter à la permanence de consultation des copies organisée pour chaque UE."
                                            },
                                            {
                                                "example_id": "ded99e02-e587-4cec-9d2a-9dbe066e3835",
                                                "sense_id": "430ab445-da02-370d-b69e-37c938d94c02",
                                                "text": "La responsable locale est joignable dans le local situé Sente du Paradis à Erquy, par téléphone au 02 96 65 89 70 pendant les horaires de permanence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "438dd1d6-fe6d-3812-ad05-f575e3d1091c",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "Heure sans cours dans l’emploi du temps d’un élève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380cdaaa-600e-48ce-a6af-3a857ad30f7c",
                                                "sense_id": "438dd1d6-fe6d-3812-ad05-f575e3d1091c",
                                                "text": "J’ai deux heures de permanence, je vais aller faire un tour au foyer !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "485e800b-ebd9-3f1c-9acc-60a9109d253a",
                                        "entry_id": "bfdb4054-7c88-39db-accf-e430050cc391",
                                        "glosses": [
                                            "Salle de classe spécialement aménagée pour accueillir les élèves lorsqu’ils ont un trou dans leur emploi du temps, lors de l’absence d’un professeur, lors d’une exclusion, lors d’un devoir surveillé ou après les cours en étude ou en retenue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7e27d8-4992-4cd9-86cc-fc2759992d09",
                                                "sense_id": "485e800b-ebd9-3f1c-9acc-60a9109d253a",
                                                "text": "Monsieur, la permanence est fermée ; ça veut dire qu’on peut rentrer chez nous ?\n— Non sûrement pas, on va vous trouver une autre salle."
                                            },
                                            {
                                                "example_id": "d4bfda30-0566-4179-a46f-bd5819817f19",
                                                "sense_id": "485e800b-ebd9-3f1c-9acc-60a9109d253a",
                                                "text": "Ton professeur de physique n’est pas là, va en permanence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bf17023-dbad-4cad-846d-a157643674fa",
