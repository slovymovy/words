                ],
                "senses": [
                    {
                        "sense_id": "bb4054ae-8fd4-37bd-8d40-2531e95c118b",
                        "entry_id": "824061b7-5da9-3bee-b089-c8adc23a0ef4",
                        "glosses": [
                            "het moeilijk hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f14630-94fa-46b3-b9b9-ef98ace3ca50",
                                "sense_id": "bb4054ae-8fd4-37bd-8d40-2531e95c118b",
                                "text": "Granman Forster (de belangrijkste traditionele leider van de bosnegers) heeft vanuit Apatou in Frans-Guyana laten weten dat Nederland 'desnoods' Suriname moet terugnemen om zijn Mensen, die pinaren (bet moeilijk hebben en pijn lijden), te helpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "15828bf3-1242-3c17-bb2a-879cca8fd304",
                        "entry_id": "824061b7-5da9-3bee-b089-c8adc23a0ef4",
                        "glosses": [
                            "arm zijn, gebrek lijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702dce37-15bf-4243-8adf-fee0ba373c40",
                                "sense_id": "15828bf3-1242-3c17-bb2a-879cca8fd304",
                                "text": "„Ik heb zelf op Commewijne gewoond. Niemand hoeft mij te komen vertellen wat pinaren, armoede lijden, is”, zegt hij een jaar na de door hem geleide sergeantencoup van 1980."
                            }
                        ]
                    }
                ],
