                        "form": "die Wanderarbeiter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48c626ee-13f5-3519-a4d7-62835a561f46",
                        "entry_id": "2d498948-61c4-3fd6-8857-6a08457d9f65",
                        "glosses": [
                            "von Verdienstmöglichkeiten angelockte, land- und häufig auch obdachlose männliche Arbeitskraft, deren Wirkstätte weit entfernt des Heimatortes liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b27994-6869-41d6-a4db-a15073ee908c",
                                "sense_id": "48c626ee-13f5-3519-a4d7-62835a561f46",
                                "text": "Die Zahl der Wanderarbeiter, die vom Land in Chinas boomende Städte sowie in die Küstenregionen ziehen, ist seit 1980 von zwei Millionen auf rund 200 Millionen gestiegen."
                            },
                            {
                                "example_id": "bde73a3f-08c3-49bb-b64f-1880f2e9ae35",
                                "sense_id": "48c626ee-13f5-3519-a4d7-62835a561f46",
                                "text": "In Thailand arbeiten mehrere tausend illegale Wanderarbeiter aus Myanmar, weil die Lebensverhältnisse in Myanmar so schlecht sind, dass sie die sehr geringe Bezahlung für harte Arbeit in der thailändischen Bauindustrie, auf Fischkuttern oder Plantagen gerne in Kauf nehmen […]."
                            },
                            {
                                "example_id": "2cf7665f-70b0-47ba-befa-f94913b99657",
                                "sense_id": "48c626ee-13f5-3519-a4d7-62835a561f46",
                                "text": "„Unser Lieblingsobdachloser ist der Hobo, der Wanderarbeiter.“"
                            },
                            {
                                "example_id": "807cd6ca-62cc-4c36-8d9f-b9b6ba5fdd15",
                                "sense_id": "48c626ee-13f5-3519-a4d7-62835a561f46",
                                "text": "„Da ist beispielsweise viel über Zigarrendreher, Leineweber, Stockmacher oder Wanderarbeiter zu erfahren.“"
                            },
                            {
                                "example_id": "d8afb5ba-e7f2-46d6-9468-6c2bda734d67",
                                "sense_id": "48c626ee-13f5-3519-a4d7-62835a561f46",
                                "text": "„Wanderarbeiter, die in China bei der Obsternte helfen, verdienen umgerechnet ca. 3 Euro für 12 Stunden harte Arbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "259c654a-a7b7-4e61-916e-667f599a17d4",
                        "source_entry_id": "2d498948-61c4-3fd6-8857-6a08457d9f65",
                        "source_sense_id": "48c626ee-13f5-3519-a4d7-62835a561f46",
