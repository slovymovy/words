                ],
                "senses": [
                    {
                        "sense_id": "2091adee-df1a-3f52-a79b-00d5af543c47",
                        "entry_id": "a09e81b1-42a0-3413-bc49-379e6d52bd90",
                        "glosses": [
                            "im Team ausgeführte schöpferische Tätigkeit zur Bewältigung einer anspruchsvollen komplexen Aufgabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06b039cc-bf40-42cf-90f4-233a0fa504a6",
                                "sense_id": "2091adee-df1a-3f52-a79b-00d5af543c47",
                                "text": "„Einerseits heißt es, modernere Unterrichtsmethoden und Gruppen- oder Projektunterricht haben wider Erwarten nicht zu mehr Selbstständigkeit und Kritikfähigkeit der Schüler geführt, stattdessen haben sich die Konsumentenhaltung der Jugendlichen und ihr passiver Widerstand gegen die Schule eher noch verstärkt, andererseits bietet Klippert den Lehrern an, Methoden des Unterrichtens zu lernen, in denen Teamfähigkeit (= Gruppenarbeit) und selbstständiges Lernen (= Projektarbeit’) im Mittelpunkt stehen sollen.“"
                            },
                            {
                                "example_id": "96801f0d-356a-45c4-881a-3df7038d27de",
                                "sense_id": "2091adee-df1a-3f52-a79b-00d5af543c47",
                                "text": "„Soweit die Projektarbeit auf ein Produkt oder eine Fertigkeit ausgerichtet ist, wird jeder Fortschritt für alle Beteiligten unmittelbar faßbar.“"
                            },
                            {
                                "example_id": "53781b66-f8a1-4acf-ba13-2ef7d6a9b56a",
                                "sense_id": "2091adee-df1a-3f52-a79b-00d5af543c47",
                                "text": "„Insofern liegt dieser Ansatz, als Lernprojekt konstruiert, methodisch zwischen Fallstudien- und Projektarbeit, der die Möglichkeiten verschiedener Lernorganisationen offen lässt.“"
                            },
                            {
                                "example_id": "b9578410-c0bc-4b53-8509-2d0215f694e2",
                                "sense_id": "2091adee-df1a-3f52-a79b-00d5af543c47",
                                "text": "„Solch interdisziplinäre Projekte funktionieren allerdings an jeder Schule, die sich Zeit nimmt für Projektarbeit – auch ohne eigenes Fach Wirtschaft.“"
                            },
                            {
                                "example_id": "478b69a9-4894-424f-ab6b-4b1f7aa9a96d",
                                "sense_id": "2091adee-df1a-3f52-a79b-00d5af543c47",
                                "text": "„Projektarbeit war fest verankert im Stundenplan.“"
                            },
                            {
                                "example_id": "f8092e41-4e2a-4c27-8767-f6ad895c5c89",
                                "sense_id": "2091adee-df1a-3f52-a79b-00d5af543c47",
                                "text": "„Griechenland hatte einmal 150 Millionen Euro für ein digitales EU-Katasterprojekt erhalten, aber nach zwei Jahren Projektarbeit fiel der damaligen Regierung nichts Besseres ein, als das Projekt – bei Rückzahlung von nur 60 Millionen Euro – unerledigt an die EU zurückzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
