                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e062464d-5ea0-3b1a-a679-026121f3e2bf",
                                        "entry_id": "a7944044-f302-33a7-b781-cb34ee8624a6",
                                        "glosses": [
                                            "de hoofdstad van de provincie Zuid-Holland en tevens de stad waar de Nederlandse regering zetelt"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc56a61d-6599-498c-8756-74de67bf68c0",
                                                "sense_id": "e062464d-5ea0-3b1a-a679-026121f3e2bf",
                                                "text": "Den Haag is sinds 1248 vrijwel onafgebroken het regeringscentrum geweest van Holland."
                                            },
                                            {
                                                "example_id": "57470640-7dc1-40bc-95c3-c79aa5cf59aa",
                                                "sense_id": "e062464d-5ea0-3b1a-a679-026121f3e2bf",
                                                "text": "Den Haag is de eerste stad in Nederland die zo'n verbod invoerde. Sinds 1 januari zijn er geen fossiele reclames in bushokjes of op straat meer te zien. Het gaat bijvoorbeeld om reclames voor vliegreizen en cruisevakanties. De reisbranche was het niet eens met het verbod en spande een kort geding aan, schrijft Omroep West."
                                            },
                                            {
                                                "example_id": "a4b329a5-57a2-4da6-a325-0c1a45d2c8c0",
                                                "sense_id": "e062464d-5ea0-3b1a-a679-026121f3e2bf",
                                                "text": "\"Een zwarte dag voor de horeca\", zegt chef-kok Rik van de Laar over het overlijden van Boer. Hij begon op 16-jarige leeftijd in De Librije, het eerste en bekendste restaurant van Boer, werkte er zeven jaar en runt inmiddels twee restaurants in Den Haag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c16a340-0ac1-3900-b191-eeac5c180862",
                                        "entry_id": "a7944044-f302-33a7-b781-cb34ee8624a6",
                                        "glosses": [
                                            "de in [1] zetelende Nederlandse regering"
                                        ],
                                        "tags": [
                                            "metonymisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8960d0-51f9-41f7-af63-0144f207a339",
                                                "sense_id": "0c16a340-0ac1-3900-b191-eeac5c180862",
                                                "text": "Toen het besluit van Den Haag eindelijk rond was, was er ondertussen weer een nieuwe Antilliaanse regering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
