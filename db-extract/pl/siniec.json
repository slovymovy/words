                "translations": [
                    {
                        "translation_id": "b9d0d7d0-aefc-46e9-b262-5c8c1edf0aa6",
                        "source_entry_id": "976eac6a-0ecd-3612-b96b-74c9e801cc5a",
                        "source_sense_id": "a97c27f1-5203-3672-b495-91cb064e94cb",
                        "target_lang_word": "bruise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "123798cc-d79d-3b5f-b74d-76a8f98e3fe3",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To strike (a person), originally with something flat or heavy, but now specifically in such a way as to discolour the skin without breaking it; to contuse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06be5bf7-d099-47df-bee0-b55586859ca3",
                                                "sense_id": "123798cc-d79d-3b5f-b74d-76a8f98e3fe3",
                                                "text": "It is as I have spoken: the testing first, next the bruising, and in the last bout the breaking and killing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885549ec-24d8-3af6-9189-a9f5e9d9a7ae",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To damage the skin of (fruit or vegetables), in an analogous way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5439d270-48eb-3e47-a0fe-c31ed93cda89",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "Of fruit or vegetables, to gain bruises through being handled roughly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2898ba-fef0-4d85-b2b6-ebb0adf3f856",
                                                "sense_id": "5439d270-48eb-3e47-a0fe-c31ed93cda89",
                                                "text": "Bananas bruise easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a39094fc-161d-3367-8bd6-0b8485268761",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To become bruised."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11bf9ef2-2d26-4adb-9c11-789578e0de14",
                                                "sense_id": "a39094fc-161d-3367-8bd6-0b8485268761",
                                                "text": "I bruise easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "244f563a-31f6-372d-8fc7-9c52f947d85c",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To fight with the fists; to box."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14c5acf-1d2b-4adf-80ed-649d0ec36f4f",
                                                "sense_id": "244f563a-31f6-372d-8fc7-9c52f947d85c",
                                                "text": "Bruising was considered a fine, manly, old English custom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8615596-3ff6-32d1-90cf-bace09779cbc",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To harm or injure somebody's feelings or self-esteem."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ab372e-1736-4afc-a771-af9025da54a5",
                                                "sense_id": "c8615596-3ff6-32d1-90cf-bace09779cbc",
                                                "text": "Her thoughtless remarks bruised my ego."
                                            },
                                            {
                                                "example_id": "0b903e47-1efb-4a2a-af9e-2056e8a3d410",
                                                "sense_id": "c8615596-3ff6-32d1-90cf-bace09779cbc",
                                                "text": "I was bruised by such wanton criticism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ef009a4-0aff-3d97-a95c-e3b8cb3ea419",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To impair (gin) by shaking rather than stirring."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
