                        "glosses": [
                            "een kerkelijk, meestal verhoogd, meubelstuk waarvanaf de voorganger in de dienst zijn preek uitspreekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2103eb96-46c7-4b61-896d-c66a27f543cd",
                                "sense_id": "e879d82d-78ec-3731-9696-af1747988c15",
