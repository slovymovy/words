                        "target_lang_word": "motet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd66b3e-d8e5-36ea-8278-2fc0e6b4c710",
                                        "entry_id": "4e519bc2-a44f-36a2-b1e7-d1e0fc13bb95",
                                        "glosses": [
                                            "A composition adapted to sacred words in the elaborate polyphonic church style; an anthem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "027ac279-8103-4c3d-a6e6-bb817dae4dad",
                                                "sense_id": "9cd66b3e-d8e5-36ea-8278-2fc0e6b4c710",
                                                "text": "Singing their holiday concert from memory, the group sounded confident and expressive in pieces ranging from a medley of Barry Manilow songs to renaissance motets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5779fb42-c84e-46f1-8811-b91a09147f07",
                        "source_entry_id": "0ede24ff-9895-3d08-a381-c0d7beb9ec5b",
                        "source_sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                        "source_sense_description": "mehrstimmiger geistlicher oder weltlicher Chorgesang",
                        "target_lang_word": "motet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                        "entry_id": "75bd150d-f7b9-3cbb-8efa-51a777f615a7",
                                        "glosses": [
                                            "Psaume ou autres paroles latines mises en musique pour être chantées à l’église et qui ne font pas partie de l’office divin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5298e6-f6ba-4e1d-a2f3-e832493e206e",
                                                "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                                "text": "Il était passionné de musique; on conserve de lui des chansons émues et mélodieuses, des motets bien construits."
                                            },
                                            {
                                                "example_id": "8a616234-b07e-4c4d-b038-b3064229a46e",
                                                "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                                "text": "Toute la nuit, couché une dernière fois sur son lit dans sa cellule de Saint-Cosme, Zénon se joua et se rejoua un certain motet de Roland de Lassus, mêlé à ses projets d'avenir."
                                            },
                                            {
                                                "example_id": "113ee8c8-3c32-4a2b-9417-1fa227abe057",
                                                "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                                "text": "Faire, composer, chanter, exécuter un motet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
