                    {
                        "translation_id": "1a0a04a4-08c6-44b9-89d8-f4cb8f26c1fc",
                        "source_entry_id": "473f7e2e-9d0d-3de2-96dc-e40358710e38",
                        "source_sense_id": "690ea4a7-02f5-3931-abf6-9eb7fbc5e8b6",
                        "source_sense_description": "übertragen: vorwärtstreibendes, beschleunigendes, gärendes Element",
                        "target_lang_word": "leaven",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leaven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a2a0902-46fd-3747-b78d-bddfaf1c4930",
                                        "entry_id": "39e72db8-5cf4-3b68-9ad5-2381169ccbbe",
                                        "glosses": [
                                            "Any agent used to make dough rise or to have a similar effect on baked goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f98be610-20a0-39d5-9d94-f0c48e342a7f",
                                        "entry_id": "39e72db8-5cf4-3b68-9ad5-2381169ccbbe",
                                        "glosses": [
                                            "Anything that induces change, especially a corrupting or vitiating change."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb89bca-77c4-46fa-93f7-bc46e8093e70",
                                                "sense_id": "f98be610-20a0-39d5-9d94-f0c48e342a7f",
                                                "text": "Take heed, beware of the leaven of the Pharisees, and of the leaven of Herod."
                                            },
                                            {
                                                "example_id": "17df70df-82f9-42a7-9114-3b9dd0dff9fa",
                                                "sense_id": "f98be610-20a0-39d5-9d94-f0c48e342a7f",
                                                "text": "On the far side was reflected a single red and meteoric cloud, which had treasured one last crimson ray from the sunset, or perhaps nursed within it the fiery leaven."
                                            },
                                            {
                                                "example_id": "9d7e38f2-4c7b-45a8-828a-1874ba3fd91a",
                                                "sense_id": "f98be610-20a0-39d5-9d94-f0c48e342a7f",
                                                "text": "The leaven of insincerity worked through all the fibres of his being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d98a171-47c2-3c4f-be25-51320b968577",
                                        "entry_id": "39e72db8-5cf4-3b68-9ad5-2381169ccbbe",
                                        "glosses": [
                                            "Chametz."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bacfcb45-e6c1-431e-bf1a-c3e0fe9e0d14",
                                                "sense_id": "3d98a171-47c2-3c4f-be25-51320b968577",
                                                "text": "On the fourteenth day of Nisan men search for leaven by candlelight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leaven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c791a4-aba6-332f-bc07-20d923d7b822",
                                        "entry_id": "04bb3b2d-27f2-3a72-8b15-53aee5d1b831",
                                        "glosses": [
                                            "To add a leavening agent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c02707-62e4-4029-93c1-9d2b6f8cbf40",
                                                "sense_id": "e4c791a4-aba6-332f-bc07-20d923d7b822",
                                                "text": "Yeast is used to leaven bread, making it rise during baking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c6faae1-a307-3e3a-9ce4-82bcf4fd5ff5",
                                        "entry_id": "04bb3b2d-27f2-3a72-8b15-53aee5d1b831",
                                        "glosses": [
                                            "To cause to rise by fermentation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f54f49d9-fee0-333a-bb61-4b4918b622b9",
                                        "entry_id": "04bb3b2d-27f2-3a72-8b15-53aee5d1b831",
                                        "glosses": [
                                            "To temper an action, decision, attitude, characteristic, etc."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58a2d1bc-e796-4736-aa02-4b74327d20c5",
                                                "sense_id": "f54f49d9-fee0-333a-bb61-4b4918b622b9",
                                                "text": "Duke. No more euasion:\nWe haue with a leauen'd, and prepared choice\nProceeded to you; therefore take your honors:[...]"
                                            },
                                            {
                                                "example_id": "189cc67d-7fda-4062-acb9-65d835c4eb85",
                                                "sense_id": "f54f49d9-fee0-333a-bb61-4b4918b622b9",
                                                "text": "“A tinge of Jewish blood is not a bad thing. It leavens the”—she looked at him—“stolid stupidity of the ordinary Englishman.”"
                                            },
                                            {
                                                "example_id": "e7273159-249c-47f1-8e67-650372bb352b",
                                                "sense_id": "f54f49d9-fee0-333a-bb61-4b4918b622b9",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ada2c72-2eff-3ff5-9d5b-fab27288859e",
                                        "entry_id": "04bb3b2d-27f2-3a72-8b15-53aee5d1b831",
                                        "glosses": [
                                            "To imbue; to infect; to vitiate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c0e351-01b8-4421-b04f-57b1eea64941",
                                                "sense_id": "2ada2c72-2eff-3ff5-9d5b-fab27288859e",
                                                "text": "The comedian's jokes helped leaven the atmosphere during the serious meeting."
                                            },
                                            {
                                                "example_id": "a33be480-527e-4238-973a-30f0b244676e",
                                                "sense_id": "2ada2c72-2eff-3ff5-9d5b-fab27288859e",
                                                "text": "Her optimism seemed to leaven the otherwise tense environment."
                                            },
                                            {
                                                "example_id": "a381227d-b365-4ca1-83a8-07048b3e3bda",
                                                "sense_id": "2ada2c72-2eff-3ff5-9d5b-fab27288859e",
                                                "text": "With these and the like deceivable doctrines, he levens also his prayer."
                                            },
                                            {
                                                "example_id": "881e5b58-837b-476d-a7ad-f9ae3d3d349e",
                                                "sense_id": "2ada2c72-2eff-3ff5-9d5b-fab27288859e",
                                                "text": "[…] pursue virtue virtuously: leven not good actions, nor render virtues disputable. Stain not fair acts with foul intentions […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca96e49-d8d0-39a6-8ec2-62c41061ecf3",
                                        "entry_id": "04bb3b2d-27f2-3a72-8b15-53aee5d1b831",
                                        "glosses": [
                                            "To rise or become larger; to prove."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
