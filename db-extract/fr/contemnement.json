                "senses": [
                    {
                        "sense_id": "b070c1bf-3af1-3858-a946-463cf283e219",
                        "entry_id": "341c6701-f1be-3fa7-a37b-538d95223c19",
                        "glosses": [
                            "Mépris, dégoût."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5b1454ec-9be1-44ea-8460-c3db65a19e3a",
                                "sense_id": "b070c1bf-3af1-3858-a946-463cf283e219",
                                "text": "Le commencement donc de noſtre ſalut eſt la crainte de noſtre Seigneur : car par icelle l’on acquiert & le commencement de la conuerſion , & la garde de la vertu. Apres cette crainte a penetré l’eſprit de l’homme , il engendre vn meſpris et & contemnement de toutes choſes, & l’horreur du monde : & par le contemnement & priuation de tous biens,s’acquiert la vraye humilité …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7201e77-fda2-40e5-8283-1e1af02e4370",
                        "source_entry_id": "341c6701-f1be-3fa7-a37b-538d95223c19",
                        "source_sense_id": "b070c1bf-3af1-3858-a946-463cf283e219",
                        "target_lang_word": "Verachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                        "entry_id": "656a1801-2aca-3136-926d-aeb4b9ac2d7f",
                                        "glosses": [
                                            "ein Zustand der Missachtung, der Abscheu, der Geringschätzung, der nachdrücklichen Beurteilung jemandes oder etwas als schlecht, minderwertig oder abscheulich, der Ignoranz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebfc4734-7705-4838-9d85-16f5019724c2",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "So ein Verhalten kann nur mit Verachtung gestraft werden."
                                            },
                                            {
                                                "example_id": "091ece7f-cdca-4c02-b54b-b238f3b75175",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„So stark war seine Verachtung der Journaille, so stark seine Achtung vor formaler Pressefreiheit.“"
                                            },
                                            {
                                                "example_id": "8b11891a-50a7-43e8-bcc1-04e3b4df74a1",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„Manche zeigen ihre Verachtung auch ganz offen, um vor ihren Leuten nicht den Verdacht zu erwecken, sie würden sich mit der deutschen Polizei gemein machen.“"
                                            },
                                            {
                                                "example_id": "83b5c0a5-28ef-4b5e-bffe-482dfdd83434",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„Stets hatte sie auf die Familie ihres Mannes mit Verachtung herabgesehen.“"
                                            },
                                            {
                                                "example_id": "ac3a1be5-bbee-429e-bfc3-ff0dea66d79b",
                                                "sense_id": "5b130cc6-136f-321c-a86e-8576defd6efa",
                                                "text": "„Zugleich offenbaren sie, mit welcher Verachtung die Buren auf alle Menschen anderer Hautfarbe blicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eb05612-262b-46b9-a237-46ca92364fa5",
                        "source_entry_id": "341c6701-f1be-3fa7-a37b-538d95223c19",
                        "source_sense_id": "b070c1bf-3af1-3858-a946-463cf283e219",
                        "target_lang_word": "contempt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contempt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "The state or act of contemning; the feeling or attitude of regarding someone or something as inferior, base, or worthless; scorn, disdain."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508c7113-2a50-47af-84d9-24237ef1585a",
                                                "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them."
                                            },
                                            {
                                                "example_id": "674737d0-5f75-4ffc-ad09-2448db4917b7",
                                                "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                                "text": "Transport Minister Marples, meanwhile, used arrogant rhetoric and showed his personal contempt for railways when confirming in Parliament that a third of the network was to be closed even before the survey results were known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfe7a73-2c05-3eb9-a648-ae875f94dadb",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "The state of being despised or dishonored; disgrace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "Open disrespect or willful disobedience of the authority of a court of law or legislative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3711ef46-e0c9-40fe-800a-a27ae8c7ec47",
                                                "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                                "text": "The panel voted unanimously on Tuesday to recommend charging Mr. [Stephen K.] Bannon with criminal contempt of Congress for defying its subpoena, sending the issue to the House."
                                            },
                                            {
                                                "example_id": "5e01cf06-27c9-41fe-8456-9aa0b1297006",
                                                "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                                "text": "Justice Merchan has yet to issue a ruling on whether to find Mr. Trump in contempt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c713316-f579-3e52-b97f-7fa263b932bd",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "Ellipsis of contempt factor."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
