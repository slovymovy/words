        "nl-extract.jsonl": [
            {
                "entry_id": "4c7b41a3-e18b-3017-a14f-294796b13051",
                "word": "korrelhagel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c227ba4-f8c8-3ccb-8b88-6bbedf11457f",
                        "entry_id": "4c7b41a3-e18b-3017-a14f-294796b13051",
                        "glosses": [
                            "neerslag die bestaat uit vlokjes korrelsneeuw met een ijslaagje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68aa6469-b412-4e70-87dc-871d5a9b62e7",
                                "sense_id": "6c227ba4-f8c8-3ccb-8b88-6bbedf11457f",
                                "text": "Korrelhagel daarentegen bestaat uit halfdoorzichtige, ronde, soms kegelvormige korrels met 2 tot 5 mm. doorsnede, die een kern van korrelsneeuw bezitten, welke echter bedekt is met een dun ijslaagje."
                            },
                            {
                                "example_id": "9046d040-5af1-455b-afa5-213068d22414",
                                "sense_id": "6c227ba4-f8c8-3ccb-8b88-6bbedf11457f",
                                "text": "Korrelhagel wordt gevormd in buien bij koud weer, meestal in het winterhalfjaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3cef555-74e9-46b6-a749-95212737802c",
                        "source_entry_id": "4c7b41a3-e18b-3017-a14f-294796b13051",
                        "source_sense_id": "6c227ba4-f8c8-3ccb-8b88-6bbedf11457f",
                        "target_lang_word": "Graupel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Graupel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                        "entry_id": "99b76176-ec55-366c-b3b0-77a0aebc6921",
                                        "glosses": [
                                            "Form von Niederschlag, bei dem Schneekristalle durch angefrorene Wassertröpfchen zu kleinen Kügelchen verklumpt werden"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f4614c8-8ba0-491e-9983-d6458fe647be",
                                                "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                                "text": "„Graupel und Hagelschlag stürzten aus grauen Wolkenbergen. Zuerst dachte er: Wie kann man in diesem schrecklichen Land fotografieren?“"
                                            },
                                            {
                                                "example_id": "83f7993a-7baf-4067-b2f7-f282e128640a",
                                                "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                                "text": "„Er brachte Eis und gefrierende Graupel und machte die Straßen spiegelglatt.“"
                                            },
                                            {
                                                "example_id": "8c22e718-444c-4f7a-8309-759ec63c4566",
                                                "sense_id": "e35e2d11-4ba1-38d4-b6dc-a094e9b63657",
                                                "text": "„Es war ein klarer, kalter Tag, der Boden mit Graupeln bedeckt, die gefroren waren, sodass es schien, als seien all die kahlen Bäume, die Büsche, die Reisighaufen, das Gras und die nackte Erde mit einer Eisschicht überzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce00f797-c3a4-454e-8544-8790f1992b96",
                        "source_entry_id": "4c7b41a3-e18b-3017-a14f-294796b13051",
                        "source_sense_id": "6c227ba4-f8c8-3ccb-8b88-6bbedf11457f",
                        "target_lang_word": "graupel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graupel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14536659-94c4-3b28-828e-df65a47e3afc",
                                        "entry_id": "e561842e-0aa1-39fb-b965-7032fcf79c1a",
                                        "glosses": [
                                            "A precipitation that forms when supercooled droplets of water condense on a snowflake."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21508fe2-15d6-4950-8954-12d102374066",
                                                "sense_id": "14536659-94c4-3b28-828e-df65a47e3afc",
                                                "text": "Is it desirable in giving the falls of hail to draw a distinction between \"graupel\" and true hail?"
                                            },
                                            {
                                                "example_id": "9a2fb913-2b31-4c12-aee2-daf6e34cd17c",
                                                "sense_id": "14536659-94c4-3b28-828e-df65a47e3afc",
                                                "text": "November.— […] Smart shower of graupel (i.e. frozen snow in pellets), with snow at 9 p.m. on 10th."
                                            },
                                            {
                                                "example_id": "7ce379ab-0086-4c74-a3ef-479ab551e082",
                                                "sense_id": "14536659-94c4-3b28-828e-df65a47e3afc",
                                                "text": "In a paper in this month's Petermann's Mittheilungen Prof. H. Fritz treats of the Geographical Distribution of Hail. […] [B]alls of true hail hav[e] an icy structure, whereas the balls of graupel are only small pellets of snow. […] With increase in latitude and in height the fall of graupel increases and that of hail decreases, while hailstones of large size are most frequent towards the equator."
                                            },
                                            {
                                                "example_id": "0b9e91b3-ac18-4c8d-8caf-16c03b36c5fb",
                                                "sense_id": "14536659-94c4-3b28-828e-df65a47e3afc",
                                                "text": "The steam of the horses and their breath came back in turbid clouds, and the snow, or soft hail (now known as graupel), cut white streaks through them into travellers' eyes, and danced on the roof like lozenges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5269e807-4bed-3c70-a365-e5e0b99ce15d",
                                        "entry_id": "e561842e-0aa1-39fb-b965-7032fcf79c1a",
                                        "glosses": [
                                            "A small ball of rime resulting from this process."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c748c692-698e-475a-a25a-c2c194d9c535",
                                                "sense_id": "5269e807-4bed-3c70-a365-e5e0b99ce15d",
                                                "text": "It is established that graupels and hailstones are cone-shaped with rounded apexes and that they become egg-shaped as a result of growth during descent."
                                            },
                                            {
                                                "example_id": "e2f63bf3-f4d9-4d3b-9b03-613fbb3603ad",
                                                "sense_id": "5269e807-4bed-3c70-a365-e5e0b99ce15d",
                                                "text": "[W]hen an ice or snow crystal collides with supercooled droplets, the droplets will freeze on the surface of the crystal to form rime. […] [C]ontinued riming will eventually produce a particle that is completely covered by rimes such that the original crystal shape can no longer be recognized. The particle now becomes a graupel (sometimes also called a soft hail or snow pellet). […] By convention, a graupel should be smaller than 5 mm in diameter. If it becomes greater than 5 mm in diameter (2.5 mm in radius) it will be called hail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28b0ae89-a281-450a-9667-5d9a18b488d0",
                        "source_entry_id": "4c7b41a3-e18b-3017-a14f-294796b13051",
                        "source_sense_id": "6c227ba4-f8c8-3ccb-8b88-6bbedf11457f",
                        "target_lang_word": "neige roulée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neige roulée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5899961-9571-3f23-b362-e26a99c4a453",
                                        "entry_id": "69f03c1c-7fe7-33c2-873f-6f6dbdd2973c",
                                        "glosses": [
                                            "Précipitation de particules de glace blanche et opaque qui tombent d’un nuage et qui sont en général coniques ou arrondies et dont le diamètre peut atteindre 5 mm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a85cbe0f-dded-4b43-8185-41a40eee131c",
                                                "sense_id": "c5899961-9571-3f23-b362-e26a99c4a453",
                                                "text": "La neige roulée est formée de grains cassants et facilement écrasables. S’ils tombent sur un sol dur, ils rebondissent et se brisent aisément. Ils apparaissent principalement par température voisine de 0 °C et presque toujours sur le continent, souvent avant ou en même temps que la neige ordinaire."
                                            },
                                            {
                                                "example_id": "6381afd7-ce4f-44e4-b26d-d1fd50e938cb",
                                                "sense_id": "c5899961-9571-3f23-b362-e26a99c4a453",
                                                "text": "La neige de surface repose sur une couche de 1 cm de neige roulée."
                                            },
                                            {
                                                "example_id": "93fbfda2-99b7-4ca2-a56a-87cc3ae7f142",
                                                "sense_id": "c5899961-9571-3f23-b362-e26a99c4a453",
                                                "text": "On trouve une couche de 1 cm de neige roulée juste sous la surface."
                                            },
                                            {
                                                "example_id": "06a9f834-24db-4990-b579-f7e408e30046",
                                                "sense_id": "c5899961-9571-3f23-b362-e26a99c4a453",
                                                "text": "Ne pas confondre neige roulée et grésil. Ce dernier est une précipitation de particules de glace transparentes ou translucides, de forme sphérique ou irrégulière, rarement conique et dont le diamètre est de 5 mm ou moins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
