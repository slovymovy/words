                                            {
                                                "example_id": "29e7f8b5-1fc6-4df8-89ee-482a412536d2",
                                                "sense_id": "d9ec84f0-07c5-312f-bd35-516a9104d596",
                                                "text": "Examples of emergency power supplies include a storage battery or group of batteries, a generator driven by a fuel-supplied prime mover, or an uninterruptible power supply (UPS) […]."
                                            },
                                            {
                                                "example_id": "b54d345e-cd75-4380-aa7b-44d13167895c",
                                                "sense_id": "d9ec84f0-07c5-312f-bd35-516a9104d596",
                                                "text": "This upgrade comes after the installation of a $50,000 uninterruptible power supply system to compliment the facilities independent power supply."
                                            }
