    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f2573682-5109-38e3-ba08-d5f314a2b1ed",
                    "sense_definition": "ondeugend of baldadig",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>rekels</w> kind haalde voortdurend streken uit met de klasgenoten.",
                            "target_lang_translations": {
                                "fr": "L'enfant <w>espiègle</w> ne cessait de faire des farces à ses camarades de classe."
                            }
                        },
                        {
                            "text": "Met een <w>rekels</w> lachje rende de jongen weg na zijn grapje.",
                            "target_lang_translations": {
                                "fr": "Avec un rire <w>malicieux</w>, le garçon s'est enfui après sa blague."
                            }
                        }
                    ],
                    "synonyms": [
                        "rekelachtig"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui fait des bêtises, espiègle ou malicieux"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "espiègle",
                                "target_lang_sense_clarification": "qui aime faire des farces"
                            },
                            {
                                "target_lang_word": "malicieux",
                                "target_lang_sense_clarification": "qui a un côté espiègle ou taquin"
                            },
                            {
                                "target_lang_word": "coquin",
                                "target_lang_sense_clarification": "qui fait des bêtises avec malice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f874bd7f-9834-3b96-bf74-8aa8a1f1d87e",
                    "sense_definition": "vervloekt of verdomd",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "versterking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vader is het <w>rekels</w> wangedrag van zoonlief helemaal zat.",
                            "target_lang_translations": {
                                "fr": "Le père en a assez du <w>fichu</w> comportement de son fils."
                            }
                        },
                        {
                            "text": "Hij kon die <w>rekels</w> deur maar niet open krijgen met zijn sleutel.",
                            "target_lang_translations": {
                                "fr": "Il n'arrivait pas à ouvrir cette <w>fichue</w> porte avec sa clé."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "wordt gebruikt als versterkend scheldwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "maudit, sacré ou fichu (utilisé pour renforcer une expression négative)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fichu",
                                "target_lang_sense_clarification": "familier, exprime l'agacement"
                            },
                            {
                                "target_lang_word": "sacré",
                                "target_lang_sense_clarification": "utilisé pour renforcer un adjectif péjoratif"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9b8d047-2362-3f7d-92fc-d8b4631f0fed",
                    "sense_definition": "betrekking hebbend op een rekel",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>rekels</w> eigenschappen van de vos waren duidelijk zichtbaar in zijn gedrag.",
                            "target_lang_translations": {
                                "fr": "Les caractéristiques <w>de renard</w> étaient clairement visibles dans son comportement."
                            }
                        },
                        {
                            "text": "Biologen bestudeerden de <w>rekels</w> kenmerken van het mannelijke dier.",
                            "target_lang_translations": {
                                "fr": "Les biologistes ont étudié les caractéristiques <w>de renard</w> de l'animal mâle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd gebruik in biologische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "relatif au renard mâle"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de renard",
                                "target_lang_sense_clarification": "relatif à l'animal"
                            }
                        ]
                    }
                }
            ]
        },
        {
