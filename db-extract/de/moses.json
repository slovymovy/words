                    {
                        "translation_id": "0a735095-6035-4eb8-af03-3e33c6e64e28",
                        "source_entry_id": "03085883-8628-3b52-8a5e-bbcc46800bff",
                        "source_sense_id": "9d699108-2443-32c9-8392-8138ec4b6fa3",
                        "source_sense_description": "zentrale Figur im Pentateuch",
                        "target_lang_word": "Moïse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moïse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05e4545d-7400-3c7c-85b9-4c866d9b97b8",
                                        "entry_id": "d94f0c3d-4aa1-39c6-b75e-2f9c610010f2",
                                        "glosses": [
                                            "Personnage de la Bible qui conduisit les Hébreux hors d’Égypte et reçut le décalogue."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ac2f40-00d0-4493-b00d-904a572bf7f9",
                                                "sense_id": "05e4545d-7400-3c7c-85b9-4c866d9b97b8",
                                                "text": "Madame de Staël voulut arracher Louis Lambert à l’Empereur et à l’Église, pour le rendre à la noble destinée qui, disait-elle, l’attendait ; car elle en faisait déjà quelque nouveau Moïse sauvé des eaux."
                                            },
                                            {
                                                "example_id": "3c1e3444-920c-426b-88ee-be0504a95880",
                                                "sense_id": "05e4545d-7400-3c7c-85b9-4c866d9b97b8",
                                                "text": "Sa théologie aussi semble tributaire de traditions retardataires : binitarisme, monarchianisme, gématrie du nom d’Adam, étymologie de celui de Moïse."
                                            },
                                            {
                                                "example_id": "6fd10ceb-d02a-4fa0-be00-4c32d6b7c87c",
                                                "sense_id": "05e4545d-7400-3c7c-85b9-4c866d9b97b8",
                                                "text": "– Moïse, d’abord ?\n– Un garçon formidable, éduqué chez des aristocrates égyptiens, lettré, volontaire, actif, doté d’un autorité naturelle, un meneur d’hommes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Moïse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "638883af-d0c0-3c98-bb88-1b8b014bfeda",
                                        "entry_id": "fa7bf989-4502-3250-9520-46840da82511",
                                        "glosses": [
                                            "Prénom français masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f752744-c7fa-47b4-b458-62b54314816b",
                                                "sense_id": "638883af-d0c0-3c98-bb88-1b8b014bfeda",
                                                "text": "Pépère Moïse, mémère Agnès\n C’était dans le temps de leur vieillesse\n La vie s’achève doucement\n Pour les grand-pères, les grand-mamans\n On les entoure de tendresse\n On fait comme si de rien n’était\n Mais c’est autour d’eux qu’on s’empresse\n Y seront p’t-être pas là l’an prochain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
