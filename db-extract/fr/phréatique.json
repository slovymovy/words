                "translations": [
                    {
                        "translation_id": "4a0cffa2-5e8b-4a66-9f2e-72d9726a02fc",
                        "source_entry_id": "a81557b1-5283-3c18-94d5-820b16699e92",
                        "source_sense_id": "5c23b94d-ce04-389f-b93e-8d3c6789e801",
                        "target_lang_word": "phreatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phreatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5696c36-4234-3278-9fcc-7fd3141d5004",
                                        "entry_id": "2ca07011-85b2-34d8-b527-5a57c7622d06",
                                        "glosses": [
                                            "Of or pertaining to ground water; (volcanology) involving explosively rapid heating of ground water by magma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47cf00f3-07ca-4659-9e83-dd38d039a825",
                                                "sense_id": "f5696c36-4234-3278-9fcc-7fd3141d5004",
                                                "text": "1979 [McGraw-Hill], Jacob Bear, Hydraulics of Groundwater, 2007, Dover, page 76,\nBoth ϕ and q vary from point to point within a phreatic aquifer."
                                            },
                                            {
                                                "example_id": "7ac5dcd0-4957-4fa1-aac9-e0c9bfd8d1e8",
                                                "sense_id": "f5696c36-4234-3278-9fcc-7fd3141d5004",
                                                "text": "1981, Peter W. Lipman, James G. Moore, Donald A. Swanson, Bulging of the North Flank Before the May 18 Eruption—Geodetic Data, Peter W. Lipman, Donal R. Mullineaux (editors), The 1980 Eruptions of Mount St. Helens, Washington, U.S. Geological Survey, page 143,\nThese results contributed to assessments by USGS personnel in late April and early May that Mount St. Helens remained highly dangerous despite the seemingly mild small-scale phreatic eruptions that were then the most conspicuous activity."
                                            },
                                            {
                                                "example_id": "ceef3621-c72f-47c9-80f5-676b5c9faeb6",
                                                "sense_id": "f5696c36-4234-3278-9fcc-7fd3141d5004",
                                                "text": "Gradually, infiltrating waters gather in underground rivers or phreatic conduits well integrated in the karst drainage system, which leads the underground waters to the outlets."
                                            },
                                            {
                                                "example_id": "cd630829-63e0-4e34-bfb7-ec05731bceef",
                                                "sense_id": "f5696c36-4234-3278-9fcc-7fd3141d5004",
                                                "text": "“Phreatic” (or steam-blast) eruptions are driven by explosive expanding steam resulting from cold ground or surface water coming into contact with hot rock or magma. The distinguishing feature of phreatic explosions is that they only blast out fragments of preexisting solid rock from the volcanic conduit; no new magma is erupted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
