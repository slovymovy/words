                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Kochbuch"
                    },
                    {
                        "form_id": "83ec9382-9d9c-498d-96c8-1a726175a2b4",
                        "entry_id": "9c047bc1-1d4f-3cee-b0ef-6442735eb14d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kochbücher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53e0b600-9583-3ab3-b16f-f8edc78adbff",
                        "entry_id": "9c047bc1-1d4f-3cee-b0ef-6442735eb14d",
                        "glosses": [
                            "gedrucktes Werk, das Kochrezepte enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e5dbbed-fc8e-44d0-9879-bc9b07c9732b",
                                "sense_id": "53e0b600-9583-3ab3-b16f-f8edc78adbff",
                                "text": "Ich habe mir ein neues Kochbuch gekauft."
                            },
                            {
                                "example_id": "c72a33b7-a2a0-405f-9186-7ea8b19d2d8b",
                                "sense_id": "53e0b600-9583-3ab3-b16f-f8edc78adbff",
                                "text": "Obwohl ich das Gericht schon sehr oft gekocht habe, muss ich immer noch ins Kochbuch schauen."
                            },
                            {
                                "example_id": "9460b2d3-b60b-43a1-b635-2475a83c6b22",
                                "sense_id": "53e0b600-9583-3ab3-b16f-f8edc78adbff",
                                "text": "„Meine Laune besserte sich erst ein wenig, als ich bei einem Bauernhaus jenseits des Flusses haltmachte und ein Kochbuch verkaufte.“"
                            },
                            {
                                "example_id": "16f93951-cbb0-468b-b8fc-08aa577ba39d",
                                "sense_id": "53e0b600-9583-3ab3-b16f-f8edc78adbff",
                                "text": "„Ich bekomme immer wieder Kochbücher von ihnen geschenkt.“"
                            },
                            {
                                "example_id": "23d0833f-d8ea-4fba-8f0c-42582c0dc5e0",
                                "sense_id": "53e0b600-9583-3ab3-b16f-f8edc78adbff",
                                "text": "„Aus solchem Kochbuch spricht die kulturelle Gesamtsituation, ihr Vorzug und ihre Gefahr.“"
                            },
                            {
                                "example_id": "499559d5-e6af-4509-98e3-df2cca74c2d7",
                                "sense_id": "53e0b600-9583-3ab3-b16f-f8edc78adbff",
                                "text": "„Fast jeder deutsche Haushalt besitzt neben Bibel und Kochbuch auch eine Ausgabe der Werke Wilhelm Buschs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
