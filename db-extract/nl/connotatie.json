                        "examples": [
                            {
                                "example_id": "8452dbfc-1719-4ad3-b51d-c5b4826d9f97",
                                "sense_id": "f6fb13dd-6efd-3bcc-a98a-614e91a84967",
                                "text": "De connotatie van het woord \"thuis\" kan warmte en gezelligheid oproepen.",
                                "translation": "The connotation of the word \"home\" can evoke warmth and coziness.",
                                "english": "The connotation of the word \"home\" can evoke warmth and coziness."
                            },
                            {
                                "example_id": "34581c04-e333-4f48-bd0b-f968272c6046",
                                "sense_id": "f6fb13dd-6efd-3bcc-a98a-614e91a84967",
                                "text": "In de poëzie worden vaak woorden gekozen vanwege hun specifieke connotaties en emotionele betekenissen.",
                                "translation": "In poetry, words are often chosen for their specific connotations and emotional meanings.",
                                "english": "In poetry, words are often chosen for their specific connotations and emotional meanings."
                            },
                            {
                                "example_id": "a0b63190-bcb2-4ad6-b413-19f00481f0d5",
                                "sense_id": "f6fb13dd-6efd-3bcc-a98a-614e91a84967",
                                "text": "De term heeft zowel positieve als negatieve connotaties, afhankelijk van de context waarin het wordt gebruikt.",
                                "translation": "The term has both positive and negative connotations, depending on the context in which it is used.",
                                "english": "The term has both positive and negative connotations, depending on the context in which it is used."
                            }
                        ]
