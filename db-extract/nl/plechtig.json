                                    {
                                        "sense_id": "9d32ba88-3cda-374c-b895-24199d547220",
                                        "entry_id": "b32bed58-c95e-3106-ba19-e9e8d393d093",
                                        "glosses": [
                                            "Characterized by or performed with appropriate or great ceremony or formality."
