                                        "entry_id": "53233f1c-f319-3376-aeb6-d5c661a8b892",
                                        "glosses": [
                                            "Teilgebiet der Agronomie, das landwirtschaftliche Betriebs- und Marktlehre sowie Agrarpolitik umfasst"
                                        ],
