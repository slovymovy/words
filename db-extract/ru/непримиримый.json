                                    {
                                        "sense_id": "10773277-489e-3c64-a9a6-a7042c0adca7",
                                        "entry_id": "095f8bcc-2922-3611-8516-c290662fe990",
                                        "glosses": [
                                            "Que no transige."
                                        ],
                                        "tags": [],
