        "fr-extract.jsonl": [
            {
                "entry_id": "c1e07547-77fe-3a68-a4b9-a1b74225fc64",
                "word": "innocemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                        "entry_id": "c1e07547-77fe-3a68-a4b9-a1b74225fc64",
                        "glosses": [
                            "Avec innocence, sans dessein de mal faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "108cc65c-657d-460e-aa9b-8a4187896255",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "Vous en êtes la cause encor qu’innocemment."
                            },
                            {
                                "example_id": "db0d1116-c85a-42a2-a48d-164df56b8bcc",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "Ses erreurs, ses écarts [de Louis XIII] vinrent d’un mauvais choix Dont il fut trop longtemps innocemment complice."
                            },
                            {
                                "example_id": "c1403fe8-c8c3-405a-8047-af179c5fbb73",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "Tandis qu’innocemment, sans malice, comme un pauvre mouton."
                            },
                            {
                                "example_id": "0f772215-118c-42ab-a443-84719b144d2c",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "Notre P. Bauny a bien appris aux valets à rendre tous ces devoirs-là [les services dans toutes sortes d’intrigues] innocemment à leurs maîtres, en faisant qu’ils portent leur intention, non pas au péché dont ils sont les entremetteurs, mais seulement au gain qui leur en revient."
                            },
                            {
                                "example_id": "82fc4003-56bb-4ae9-902b-6a2c2dea0cde",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "La simplicité d’une vie particulière qui goûte doucement et innocemment ce peu de biens que la nature nous donne."
                            },
                            {
                                "example_id": "913a0a7b-8356-495f-a2c8-844169e00f64",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "Présentement que je vois qu’il ne sert de rien de vivre innocemment et de son mieux ; que les méchants n'ont qu’à inventer pour être crus, bien qu’on connaisse et leur noirceur et leur mauvaise foi."
                            },
                            {
                                "example_id": "d057dc70-702e-46f4-98c4-a1b13280d194",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "L’ignorance d’une fille est cause qu’elle s’ennuie, et qu’elle ne sait à quoi s’occuper innocemment."
                            },
                            {
                                "example_id": "fdb08462-7415-4604-838a-ce125b96893c",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "Ils jouent innocemment et aussi lestement que de petits chats."
                            },
                            {
                                "example_id": "734809e2-cf13-447d-abef-24b2b74dd65d",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "L'amour innocemment est entré dans mon cœur."
                            },
                            {
                                "example_id": "59258942-245e-4cc1-bc13-e336c2ecb358",
                                "sense_id": "839e4f7d-fda2-3dce-aacd-4383ba090240",
                                "text": "Il n'a jamais su rire innocemment."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d4d2f07-5aa7-3149-9111-bf9715699a46",
                        "entry_id": "c1e07547-77fe-3a68-a4b9-a1b74225fc64",
                        "glosses": [
                            "Niaisement, sottement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0c2f76-cc48-4e4b-8079-dd72b72196b2",
                                "sense_id": "0d4d2f07-5aa7-3149-9111-bf9715699a46",
                                "text": "Il tombe encore innocemment dans la même faute […] aussi est-ce un bon homme."
                            },
                            {
                                "example_id": "96fc22c9-2824-4c3b-a381-bc2587a49239",
                                "sense_id": "0d4d2f07-5aa7-3149-9111-bf9715699a46",
                                "text": "Ici un vieillard tuberculeux tisonnant un poêle et prolongeant son agonie tout en criblant innocemment de ses bacilles les tout petits confiés à sa garde."
                            }
                        ]
                    }
                ],
                "translations": [
