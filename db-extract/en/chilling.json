                                        "entry_id": "94dd4f84-dcbf-3746-8faf-096a2f395e92",
                                        "glosses": [
                                            "eine niedrige Temperatur habend; von/mit niedriger Temperatur; nicht (mehr) heiß"
                                        ],
                                        "tags": [
                                            "von Speisen",
