                    },
                    {
                        "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                        "entry_id": "dc035d42-1719-37a3-be24-982a657f25dc",
                        "glosses": [
                            "volk in Europa en Azië dat traditioneel een zwervend bestaan leidt"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "b5ef2424-3e48-46dd-9a04-396276a95aee",
                                "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                                "text": "De Roma zijn in de meeste landen van Europa, maar ook in Amerika te vinden."
                            },
                            {
                                "example_id": "d5ec15b9-4b3f-4b4c-919d-6646810f572e",
                                "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                                "text": "Volgens de aanklacht zijn Thaçi en de anderen verantwoordelijk voor de dood van bijna honderd mensen, onder wie Kosovaren, Albanezen, Serviërs en Roma."
                            },
                            {
                                "example_id": "06cfba85-3f0c-4005-bb7a-d4489bd6b6e1",
                                "sense_id": "72e5de66-f43c-3305-a620-e58502e364ce",
                                "text": "Van de bijna 250 Sinti en Roma op het transport overleven dertig de concentratiekampen. Zoni Weisz ziet zijn familie nooit meer terug. Herinneringscentrum kamp Westerbork herdenkt zondag dat het zogenoemde zigeunertransport 75 jaar geleden vertrok."
                            }
                        ]
                    }
