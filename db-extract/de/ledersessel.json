                        "examples": [
                            {
                                "example_id": "5c2671ef-971c-4c39-9c2d-b832de980020",
                                "sense_id": "48d303ef-1e45-328e-b783-59a3162cc7ef",
                                "text": "„Eigil klopfte auf die Lehne des Ledersessels und fragte, ob er ihn nicht bitten wolle, Platz zu nehmen.“"
                            },
                            {
                                "example_id": "1d9f8fcd-1efd-45b3-9097-029513c7dba7",
                                "sense_id": "48d303ef-1e45-328e-b783-59a3162cc7ef",
                                "text": "„Große Ledersessel standen umher.“"
                            },
                            {
                                "example_id": "b0f9695a-1ed8-404f-bfbd-699b74d437a4",
                                "sense_id": "48d303ef-1e45-328e-b783-59a3162cc7ef",
                                "text": "„Eiríkur bat sie, auf schwarzen Ledersesseln ohne Armlehnen PLatz zu nehmen, und setze sich selbst auf das Sofa gegenüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
