                "senses": [
                    {
                        "sense_id": "486002af-6ec8-356d-801d-164c7dea5d6f",
                        "entry_id": "8d99d1f9-d8de-3f2b-9246-02ca8047ba5e",
                        "glosses": [
                            "Qualificatif donné aux Églises métropolitaines non soumises directement à l’autorité d’un patriarcat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f96edd-4939-49ca-8544-59f522d606c2",
                                "sense_id": "486002af-6ec8-356d-801d-164c7dea5d6f",
                                "text": "Ainsi L’Église serbe a déclaré son autonomie en 1832 ; en 1879 elle s’est déclarée autocéphale"
                            },
                            {
                                "example_id": "ae36aa79-29b2-412f-9cf5-bebc9924b2fd",
                                "sense_id": "486002af-6ec8-356d-801d-164c7dea5d6f",
                                "text": "Commencèrent les lentes litanies de l'office des morts de l'Église géorgienne autocéphale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce12af82-742b-4e70-8525-7c9190a08437",
                        "source_entry_id": "8d99d1f9-d8de-3f2b-9246-02ca8047ba5e",
                        "source_sense_id": "486002af-6ec8-356d-801d-164c7dea5d6f",
                        "target_lang_word": "autokephal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autokephal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecee2a5a-bc85-33c9-b001-d3c1b8878094",
                                        "entry_id": "653f3e5f-7324-37d6-96b9-0611dba4f428",
                                        "glosses": [
                                            "mit selbst gegebenem Oberhaupt und unabhängig gegenüber externen Patriarchen oder Erzbischöfen"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eced131-1ba7-4b0a-a2a0-b6825ab599af",
                                                "sense_id": "ecee2a5a-bc85-33c9-b001-d3c1b8878094",
                                                "text": "„Nach dem mißlungenen Einigungsversuch entbrannte der Kampf zwischen der autonomen und der autokephalen Kirche mit neuer Kraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "009bb40b-8c72-405e-bd60-d7275cb9e370",
                        "source_entry_id": "8d99d1f9-d8de-3f2b-9246-02ca8047ba5e",
                        "source_sense_id": "486002af-6ec8-356d-801d-164c7dea5d6f",
                        "target_lang_word": "autocephalous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocephalous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41486148-68ed-3d4c-a01c-57c3b13c0956",
                                        "entry_id": "a311da1a-6496-32b3-9bd1-29c3dba67f87",
                                        "glosses": [
                                            "Fully independent of the authority of any other church."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba8fc75-e9c0-4306-a711-e7c15a781854",
                                                "sense_id": "41486148-68ed-3d4c-a01c-57c3b13c0956",
                                                "text": "The defenders of Anglican independence maintain that there were anciently Churches autocephalous, dependent on no patriarch, and refer to the Churches of Cyprus as thus constituted, and allege that the British Churches enjoyed the same right of self-government and ordained their own prelates."
                                            },
                                            {
                                                "example_id": "305e7495-f07d-4680-8526-a5301638849a",
                                                "sense_id": "41486148-68ed-3d4c-a01c-57c3b13c0956",
                                                "text": "Poroshenko's speech was viscerally anti-Russian, and his loudest applause line came when he vowed to establish an autocephalous (independent from Moscow) Ukrainian Orthodox Church patriarchate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a34cd9e-8029-338a-a2f6-990887a38dca",
                                        "entry_id": "a311da1a-6496-32b3-9bd1-29c3dba67f87",
                                        "glosses": [
                                            "Presiding over an autocephalous church."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3715ee1-6d40-3d56-ae95-15335d810bb1",
                                        "entry_id": "a311da1a-6496-32b3-9bd1-29c3dba67f87",
                                        "glosses": [
                                            "Independent; not governed by others."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acd15b31-eb3e-4d1b-be0b-f5c0575e44db",
                                                "sense_id": "a3715ee1-6d40-3d56-ae95-15335d810bb1",
                                                "text": "This is the Weberian continuum which stretches between the poles of “autocephalous” (self-organized and managing) and “heterocephalous” (organized and managed by others) occupations. […]In the more autocephalous occupations—the professions; the arts; independent accountants, draftsmen, and the like; independent small and medium businessmen in merchandising, manufacturing, artisanry, and the service trades—effective organization is less feasible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
