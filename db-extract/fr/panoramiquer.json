                "senses": [
                    {
                        "sense_id": "8dba124e-48e9-3110-9991-d76e66137b2d",
                        "entry_id": "4142337b-f5f6-3f49-9b23-b4d65b035584",
                        "glosses": [
                            "Faire un panoramique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3bc0384-f64b-43d7-a0cc-98002df8dc94",
                                "sense_id": "8dba124e-48e9-3110-9991-d76e66137b2d",
                                "text": "Il choisit un autre angle, photographie encore et encore. Puis il « panoramique », saisit la pente qui descend vers la cabane, la perspective du vallon encaissé."
                            },
                            {
                                "example_id": "100fa315-db80-455d-a1b7-ede088b27fe5",
                                "sense_id": "8dba124e-48e9-3110-9991-d76e66137b2d",
                                "text": "Je panoramique, en pensée."
                            },
                            {
                                "example_id": "193f7cee-24db-4dab-ab6e-8900994290ac",
                                "sense_id": "8dba124e-48e9-3110-9991-d76e66137b2d",
                                "text": "D’un gros point noir, je situai Pyongyang, prononçant le mot et panoramiquant d’un ample mouvement du bras sur tout ce qui nous entourait."
                            }
                        ]
                    }
                ],
