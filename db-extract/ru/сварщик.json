                                        "sense_id": "5e4572b2-1dd0-384c-9efd-238727897a04",
                                        "entry_id": "bfe789d0-d9b8-34a9-b7d0-dbd27bc04c45",
                                        "glosses": [
                                            "Celui qui soude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6614b184-33df-4c06-a7b6-2d126fc3e3c8",
                                                "sense_id": "5e4572b2-1dd0-384c-9efd-238727897a04",
                                                "text": "Derrière ses lunettes de soudeur, le Lotois a redressé la barre du navire tricolore."
                                            },
                                            {
                                                "example_id": "fa0af906-fcd1-4a29-bcc6-8427f17da881",
                                                "sense_id": "5e4572b2-1dd0-384c-9efd-238727897a04",
                                                "text": "Il n'est en effet pas question de remplacer les soudeurs, puisque leur savoir-faire manque à l'industrie !"
                                            },
                                            {
                                                "example_id": "b450bbac-9d93-492a-b7df-607fad958756",
                                                "sense_id": "5e4572b2-1dd0-384c-9efd-238727897a04",
                                                "text": "C’est dur d’avoir des machinistes en région, des soudeurs en région, ça fait que plus on est automatisés, robotisés, plus l’accessibilité au travail est facile"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
