                        "entry_id": "79478fc3-b784-33dd-ba03-c448d0d1a98b",
                        "glosses": [
                            "Insecte lépidoptère (papillon) du genre vanesse, de la famille des nymphalidés, migrateur, très répandu, dont les ailes sont de couleurs vives."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "98d21dc9-8391-4e33-b5f7-2723391cf587",
                                "sense_id": "76403358-8a9b-3f3d-b5c9-d670bc76b8b9",
                                "text": "La chenille de la belle-dame se nourrit sur des chardons, des bardanes, des orties."
                            }
                        ]
