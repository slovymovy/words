                ],
                "translations": [
                    {
                        "translation_id": "b86dc5e4-e1fc-4dbf-aa59-cd46287eaf3a",
                        "source_entry_id": "b1f8519d-e5dd-3408-b1c4-2428de774c24",
                        "source_sense_id": "00710880-9424-337a-ad85-41a397ff1fd3",
                        "target_lang_word": "Lagerraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lagerraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d90755e4-7ebe-30fc-b2c8-47ce6150d79e",
                                        "entry_id": "26972340-dd98-3091-a3cf-3686414caccd",
                                        "glosses": [
                                            "Gebäudeteil, in dem branchenbezogen Gegenstände zur Weiterverwendung, zum Verkauf oder zur Archivierung aufbewahrt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e1b79e-c27c-48fd-929f-a3c161eab429",
                                                "sense_id": "d90755e4-7ebe-30fc-b2c8-47ce6150d79e",
                                                "text": "Im hinteren Teil des Geschäftes befindet sich ein Lagerraum."
                                            },
                                            {
                                                "example_id": "705ef561-4c7c-4111-bf6f-e85479479d09",
                                                "sense_id": "d90755e4-7ebe-30fc-b2c8-47ce6150d79e",
                                                "text": "„In jenem Winkel des Lagerraums war es dunkel, und noch mal so dunkel war es im Inneren des Kartons.“"
                                            },
                                            {
                                                "example_id": "ace4f67c-3acf-43de-925a-8232a4163928",
                                                "sense_id": "d90755e4-7ebe-30fc-b2c8-47ce6150d79e",
                                                "text": "„Wir treten in das hintere Gebäude, das sich in Lagerräume und eine Probierstube teilt.“"
                                            },
                                            {
                                                "example_id": "5182377c-5d9f-4d2d-b8bd-c2cd944677a8",
                                                "sense_id": "d90755e4-7ebe-30fc-b2c8-47ce6150d79e",
                                                "text": "„Ich hörte Gepäckstücke rollen und krachen, als lägen sie schlecht verwahrt im Lagerraum eines vom Meer geschüttelten Schiffes.“"
                                            },
                                            {
                                                "example_id": "117f2a35-68fa-44f7-8a27-ac44a49e6c08",
                                                "sense_id": "d90755e4-7ebe-30fc-b2c8-47ce6150d79e",
                                                "text": "„In den Lagerräumen war es auf jeden Fall wärmer als unter freiem Himmel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "685e0d03-e0c9-49d3-b700-8a69913e2a21",
                        "source_entry_id": "b1f8519d-e5dd-3408-b1c4-2428de774c24",
