                "senses": [
                    {
                        "sense_id": "1322d992-147e-3e53-a5f2-ff99d7ed555c",
                        "entry_id": "edf2e019-18a1-3b10-ab1b-dace0a3b1860",
                        "glosses": [
                            "Devenir roussâtre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ca46a2f3-622c-478d-8708-72bafe9d6791",
                                "sense_id": "1322d992-147e-3e53-a5f2-ff99d7ed555c",
                                "text": "Et par ainsi le vray temps de moissonner le blé, est quand le grain commence à chãger de couleur, & à roussoyer, & qu’il n’est encores entierement dur."
                            },
                            {
                                "example_id": "521aedfc-4955-45eb-96d0-b158e3707c0c",
                                "sense_id": "1322d992-147e-3e53-a5f2-ff99d7ed555c",
                                "text": "Diane se lassait de courir sur les airs\nSes moureaux harassés retournaient voir les mers,\nDe ceux qui sont là-bas sous le pôle Antartique\nL’étoile avant-courière à l’aurore Delphique\nSemblait ja roussoyer d’un argentin brandon,\nAnnonçant aux mortels du beau jour le guidon,\nQui ne voulait encor déciller sa paupière,\nEndormi dans les bras de Thétis marinière […]"
                            }
                        ]
                    },
