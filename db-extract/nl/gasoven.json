                        "examples": [
                            {
                                "example_id": "1aac4200-4450-4af0-8952-5492526e5581",
                                "sense_id": "1f2b65f9-d058-3c91-88a5-1b1c5d2827c0",
                                "text": "De meeste huishoudelijke ovens waren vroeger gasovens maar tegenwoordig zijn het meestal elektrische ovens"
                            },
                            {
                                "example_id": "a4c8a7f3-6a3b-48b3-8eb1-a82a2133c25f",
                                "sense_id": "1f2b65f9-d058-3c91-88a5-1b1c5d2827c0",
                                "text": "Alles zal alleen nog maar erger worden: zijn in braille uitgevoerde studieboeken (zoals de gebloemleesde Tachtigers die al enkele meters gangruimte beslaan) worden meegenomen door een in oud-papierhandelende zwerver, bij het aansteken van de gasoven in de keuken van zijn verlaten studentenflat verschroeit hij zijn wimpers en voortdurend is hij van alles kwijt."
                            }
                        ]
                    }
