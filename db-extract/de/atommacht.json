                ],
                "senses": [
                    {
                        "sense_id": "8cb4468c-a7f0-35c3-bf64-acd5c0868d0f",
                        "entry_id": "a9c19ae2-74f5-3037-ab37-703f84cc318d",
                        "glosses": [
                            "Staat, der einsatzbereite Atomwaffen besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce91151-bbc4-4ae4-8f92-8cb2be5cdbfd",
                                "sense_id": "8cb4468c-a7f0-35c3-bf64-acd5c0868d0f",
                                "text": "„Nach 34 Jahren internationaler Isolation im Nuklearbereich ist Indien de facto als Atommacht anerkannt worden.“"
                            },
                            {
                                "example_id": "36eff55f-0010-4713-9051-a2ff9b1eabd3",
                                "sense_id": "8cb4468c-a7f0-35c3-bf64-acd5c0868d0f",
                                "text": "„Mit Blick auf die Atommächte der Welt berichtet das Institut über ein Gesamtarsenal von gut 25'000 nuklearen Sprengköpfen, von denen mehr als 10'000 sofort auf Raketen oder Flugzeugen eingesetzt werden könnten.“"
                            },
                            {
                                "example_id": "856450fd-fd47-4d68-a0a9-db5c1ceb4783",
                                "sense_id": "8cb4468c-a7f0-35c3-bf64-acd5c0868d0f",
                                "text": "„Im Jahre 2005 gibt es nicht nur die fünf Atommächte der nuklearen Frühzeit: Amerika, Russland, England, Frankreich und China.“"
                            },
                            {
                                "example_id": "895bb6f1-dd05-4cd9-b716-5eb7410302d7",
                                "sense_id": "8cb4468c-a7f0-35c3-bf64-acd5c0868d0f",
                                "text": "„Die Tatsache, dass sich Indien und Pakistan heute als Atommächte gegenüberstehen, lässt die Tragödie der Teilung in neuem Licht erscheinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
