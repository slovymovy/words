                "forms": [],
                "senses": [
                    {
                        "sense_id": "0933ed02-a9df-3251-9aa8-36577019ee92",
                        "entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "glosses": [
                            "w starożytnym Rzymie: dowódca wojskowy"
                        ],
                        "tags": [],
