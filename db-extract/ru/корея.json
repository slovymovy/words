                "senses": [
                    {
                        "sense_id": "61cc3fa8-3fb0-36f9-b38f-14bc1d9ccb08",
                        "entry_id": "22c71f94-cf84-3c93-a3f2-c78f81b83b7c",
                        "glosses": [
                            "геогр. полуостров на востоке Азии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5449cbce-0082-4159-92de-254d277ecbcb",
                                "sense_id": "61cc3fa8-3fb0-36f9-b38f-14bc1d9ccb08",
                                "text": "Поделили пополам Корею."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f545982-06cd-3a4e-89bc-3c9d0220d96c",
                        "entry_id": "22c71f94-cf84-3c93-a3f2-c78f81b83b7c",
                        "glosses": [
                            "одно из двух государств, расположенных на этом полуострове"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53779857-bba8-4df4-86e5-4ed301f83242",
                                "sense_id": "3f545982-06cd-3a4e-89bc-3c9d0220d96c",
                                "text": "А тебе, правящему эту статью, какая Корея больше нравится?"
                            },
                            {
                                "example_id": "6b3cb71a-7b82-4f33-948d-76d5af6dfc74",
                                "sense_id": "3f545982-06cd-3a4e-89bc-3c9d0220d96c",
                                "text": "Мне больше нравится нравится вариант единой Кореи, но увы такого не случится."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30106c49-d123-4923-85bd-193c6c674c8f",
                        "source_entry_id": "22c71f94-cf84-3c93-a3f2-c78f81b83b7c",
                        "target_lang_word": "Korea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c62a8c2-b9f5-30be-a7c7-97b8e26ae30a",
                                        "entry_id": "6b0153ad-4dc3-34e9-8500-45ca528eda9d",
                                        "glosses": [
                                            "A geographic region consisting of two countries in East Asia, commonly known as South Korea and North Korea; formerly a single country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecac6632-aeb1-4b10-b8ae-055a03165e2a",
                                                "sense_id": "8c62a8c2-b9f5-30be-a7c7-97b8e26ae30a",
                                                "text": "After the death of the empreſs Papûſha he had been baniſhed into Korea, from whence he was removed to Quey-lin Fû, the capital of Quang-ſi."
                                            },
                                            {
                                                "example_id": "1f7c27bf-3129-421b-8e19-cbf7c8028e4b",
                                                "sense_id": "8c62a8c2-b9f5-30be-a7c7-97b8e26ae30a",
                                                "text": "Then I told the delegates of the trip which I had taken with my wife, Jane, into Korea on the previous Thanksgiving, and of how I had celebrated my seventy-fourth birthday on the snowy mountains of Korea, eating from a mess kit with the men in uniform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e19a70-1b07-3b79-aa35-f92f61a165e0",
                                        "entry_id": "6b0153ad-4dc3-34e9-8500-45ca528eda9d",
                                        "glosses": [
                                            "A geographic region consisting of two countries in East Asia, commonly known as South Korea and North Korea; formerly a single country.",
                                            "South Korea: A country in East Asia, comprising the southern part of the Korean Peninsula."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4218ef9e-67eb-398e-8b99-8a27729e9fd2",
                                        "entry_id": "6b0153ad-4dc3-34e9-8500-45ca528eda9d",
                                        "glosses": [
                                            "A geographic region consisting of two countries in East Asia, commonly known as South Korea and North Korea; formerly a single country.",
                                            "North Korea: A country in East Asia, whose territory consists of the northern part of Korea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
