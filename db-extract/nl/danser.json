                                            {
                                                "example_id": "4abcc4aa-16cc-451e-a536-742ba76ed25e",
                                                "sense_id": "e29b72ca-8f25-378b-9c4a-c4078d63f64a",
                                                "text": "I'm a terrible dancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0871ef45-3f5b-336c-b9b3-377b4ec83222",
                                        "entry_id": "c637387e-f2c0-3716-9166-89f9e4201485",
                                        "glosses": [
                                            "A stripper."
                                        ],
                                        "tags": [
