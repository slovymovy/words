                        "cross_references": [
                            {
                                "target_word": "pâte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8aa685-be37-36b8-b5c9-1b5631b61152",
                                        "entry_id": "0b571710-69df-3667-85dc-4fea68f7606b",
                                        "glosses": [
                                            "Préparation culinaire à base de farine consommée après cuisson sous forme de pain, tarte, gâteau, friandise, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16e7253-d915-4c94-af19-c94784ff4f45",
                                                "sense_id": "fa8aa685-be37-36b8-b5c9-1b5631b61152",
                                                "text": "Faites une pâte à koulibiac, puis garnissez l'intérieur de tranches de saumon épluché et débarrassé des arêtes."
                                            },
                                            {
                                                "example_id": "cbeaa7af-0e2b-45e7-a5d4-5b6640cf3906",
                                                "sense_id": "fa8aa685-be37-36b8-b5c9-1b5631b61152",
                                                "text": "— […], je fus amené à goûter tous les mets étranges qui constituaient le repas. Il y avait […] du kaku, un mets délicieux qui est fait de la pâte de fruit à pain cuite dans du lait de coco, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c8b155-da7c-3608-88d5-065125fec1fc",
                                        "entry_id": "0b571710-69df-3667-85dc-4fea68f7606b",
                                        "glosses": [
                                            "Pâte alimentaire, aliment fait de petits morceaux de farine de blé dur, de blé tendre ou de riz, et parfois d’œuf et de sel, détrempée, pétrie, précuite et découpée sous diverses formes et tailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bed7920-e5b7-4d21-b1cc-b47e6a87d4af",
                                                "sense_id": "24c8b155-da7c-3608-88d5-065125fec1fc",
                                                "text": "Il nous a fait une délicieuse recette de pâtes."
                                            },
                                            {
                                                "example_id": "8b4c7e4a-b033-4591-b710-58eeee8d94ef",
                                                "sense_id": "24c8b155-da7c-3608-88d5-065125fec1fc",
                                                "text": "La nouille est une pâte alsacienne; le spaghetti est une pâte italienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693f128b-1405-3492-beee-e52c4e221d40",
                                        "entry_id": "0b571710-69df-3667-85dc-4fea68f7606b",
                                        "glosses": [
                                            "Substance ou mélange, plus ou moins mou, de divers ingrédients."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d7d6d07-8321-45db-987b-17d956cf9c4d",
                                                "sense_id": "693f128b-1405-3492-beee-e52c4e221d40",
                                                "text": "Pâte dentifrice, pâte à papier, pâte à modeler, pâte de verre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baaba909-e1b9-39ae-9e9e-769209fc8cf6",
                                        "entry_id": "0b571710-69df-3667-85dc-4fea68f7606b",
                                        "glosses": [
                                            "Substance ou mélange, plus ou moins mou, de divers ingrédients.",
                                            "Masse de couleurs fraîches préparées sur la palette pour être posées sur la toile."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72b366e7-4e3a-488d-8b7f-e44c04909b2e",
                                                "sense_id": "baaba909-e1b9-39ae-9e9e-769209fc8cf6",
                                                "text": "Peindre en pleine pâte, charger sa toile d’une épaisseur de pâte qu’on modèle et étend quand elle est encore fraîche, ce qui permet des modelés plus souples et des tons plus fondus que ne pourraient faire des touches superposées."
                                            },
                                            {
                                                "example_id": "b319ffc5-ea9d-422c-aa51-6740ce8e36aa",
                                                "sense_id": "baaba909-e1b9-39ae-9e9e-769209fc8cf6",
                                                "text": "Les grands coloristes ont peint dans la pâte parce que ce moyen permet plus de richesse dans l’exécution et plus d’imprévu dans les modèles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57104bb7-dc65-3c5a-be86-e408e6f39826",
                                        "entry_id": "0b571710-69df-3667-85dc-4fea68f7606b",
                                        "glosses": [
                                            "Personne au caractère facile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d85f7f1-8bcd-46da-8f35-b280d7e77419",
                                                "sense_id": "57104bb7-dc65-3c5a-be86-e408e6f39826",
                                                "text": "Une bonne pâte."
                                            },
                                            {
                                                "example_id": "8b47eb59-1d8f-4d38-8e31-6780a94ca611",
                                                "sense_id": "57104bb7-dc65-3c5a-be86-e408e6f39826",
                                                "text": "C’est la meilleure pâte d’homme que l’on connaisse."
                                            },
                                            {
                                                "example_id": "3a63dca8-e290-40aa-9709-e57cc7a375f7",
                                                "sense_id": "57104bb7-dc65-3c5a-be86-e408e6f39826",
                                                "text": "En cherchant bien dans la cave, [du bois], il y en a toujours : une bûche dans un coin, des broutilles dans un autre... D'ailleurs, le petit va me conduire chez ce brave M. Labbé, une âme d'élite, et quelle excellente pâte d'homme ! Ah ! Celui-là m'en fournirait bien pour deux mille francs, si je le lui demandais !"
                                            }
                                        ]
                                    }
                                ]
                            },
