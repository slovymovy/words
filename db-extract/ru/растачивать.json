                "senses": [
                    {
                        "sense_id": "c5ffa816-ea26-3421-a16c-228e123dc25d",
                        "entry_id": "1c5f143a-a7d4-334d-8bae-d899809953fc",
                        "glosses": [
                            "расширять, углублять и т.п. вытачиванием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67698603-5db9-402c-926d-ef95eb5880eb",
                                "sense_id": "c5ffa816-ea26-3421-a16c-228e123dc25d",
                                "text": "Цилиндры растачивают с 92 до 93 мм."
                            },
                            {
                                "example_id": "6d3d1df6-d2a6-4392-aeaf-2970207dd4e8",
                                "sense_id": "c5ffa816-ea26-3421-a16c-228e123dc25d",
                                "text": "Отверстие растачиваем изнутри с помощью ножа с узким лезвием."
                            },
                            {
                                "example_id": "91bf1e77-c416-4b20-9b0b-c2153fa07837",
                                "sense_id": "c5ffa816-ea26-3421-a16c-228e123dc25d",
                                "text": "Но я не предполагал, что он примчится с набором инструментов и электрической дрелью, дабы пыточного вида сверлом яростно растачивать вентили в смесителях."
                            },
                            {
                                "example_id": "e02a2cac-f50f-4257-88f3-6217d87e283f",
                                "sense_id": "c5ffa816-ea26-3421-a16c-228e123dc25d",
                                "text": "Хорошо, должно быть, работать там, внутри завода, у станка и растачивать острыми резцами твердое железо!"
                            }
                        ]
                    },
