                "senses": [
                    {
                        "sense_id": "43520aad-a7f4-3829-8d4a-cc14cd2a8a10",
                        "entry_id": "84f337c8-8b32-3f27-b6ad-e8afa76e1844",
                        "glosses": [
                            "Imiter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da6a92e-8dc4-46be-b24e-d8e4690da49b",
                                "sense_id": "43520aad-a7f4-3829-8d4a-cc14cd2a8a10",
                                "text": "Car, si imiter c'est avoir bien observé, re-imiter' c'est déjà presque préméditer ; mimer devant quelqu’un c'est déjà raconter, presque parler, presque penser."
                            },
                            {
                                "example_id": "afad6f71-8744-4690-b72e-e310729b3f9b",
                                "sense_id": "43520aad-a7f4-3829-8d4a-cc14cd2a8a10",
                                "text": "vs voulez simplement le mettre en peinture, essayez de rayer aux endroits avec une brosse métallique, histoire de re-imiter le veinage."
                            },
                            {
                                "example_id": "ab3e093b-e649-4ec8-9efc-e454683ae51a",
                                "sense_id": "43520aad-a7f4-3829-8d4a-cc14cd2a8a10",
                                "text": "Pourquoi tout d'un coup re-imiter un modèle grec (et sur une face seulement! le cheval restant bel et bien celtique)?"
                            }
                        ]
                    }
                ],
