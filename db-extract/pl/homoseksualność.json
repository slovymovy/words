                        "source_sense_id": "d6b82ce1-9e35-3080-ba8f-3cd1f043fa65",
                        "target_lang_word": "гомосексуальность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гомосексуальность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11dda9d8-0e70-3a83-8f9d-27aa87065d68",
                                        "entry_id": "982f8d65-217b-3ef4-b63c-4a416eb3d831",
                                        "glosses": [
                                            "свойство по значению прилагательного гомосексуальный; предпочтение представителей своего пола (или гендера) в качестве объекта любовных отношений, эротического влечения и/или сексуального партнёра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a6f093-28d7-4f2e-82e7-6a60322d10e5",
                                                "sense_id": "11dda9d8-0e70-3a83-8f9d-27aa87065d68",
                                                "text": "Почему у человека так много способов быть друг с другом — гетеросексуальность, аутосексуальность, гомосексуальность, бисексуальность, просто вдвоём или в группе?"
                                            },
                                            {
                                                "example_id": "824c08aa-602c-47da-8aa0-355154ca6f01",
                                                "sense_id": "11dda9d8-0e70-3a83-8f9d-27aa87065d68",
                                                "text": "Отвечая на вопросы, связанные с гомосексуальностью, я имею в виду эти проявления как у мужчин, так и у женщин, ибо гомосексуальность — это зачастую практически непреодолимое влечение к своему полу, обусловленное многими причинами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
