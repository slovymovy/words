                        "entry_id": "6638b8a0-7e96-3f61-857a-63b0fd215001",
                        "glosses": [
                            "samoczynne rozsiewanie diaspor przez roślinę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c7bcef-d2fa-4c6d-8964-4bb91b453d38",
                                "sense_id": "16900579-0394-328f-b718-1965ac441fca",
                                "text": "Oddalenie się diaspor od rośliny macierzystej jest stosunkowo niewielkie, autochoria ma więc znaczenie głównie jako czynnik zwiększający zagęszczenie populacji w danym biotopie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
