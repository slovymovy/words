                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wolf</w> mijn eten naar binnen omdat ik haast heb.",
                            "target_lang_translations": {
                                "en": "I <w>wolf</w> down my food because I am in a hurry.",
                                "ru": "Я жадно <w>заглатываю</w> еду, потому что спешу.",
                                "pl": "Szybko <w>pożeram</w> jedzenie, ponieważ się spieszę.",
                                "de": "Ich <w>schlinge</w> mein Essen hinunter, weil ich es eilig habe.",
