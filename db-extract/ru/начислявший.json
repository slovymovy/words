                "senses": [
                    {
                        "sense_id": "0681f419-1e9e-3112-b625-197efa51d325",
                        "entry_id": "9ce703a9-fa4c-3475-980b-54282df79c75",
                        "glosses": [
                            "действ. прич. прош. вр. от начислять"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "b50f8678-71a4-4884-86bd-2e5d52937e8c",
                                "sense_id": "0681f419-1e9e-3112-b625-197efa51d325",
                                "text": "Россия была единственной страной в мире, неограниченно принимавшей вклады в принадлежавшие государству банки и начислявшая по ним проценты и сложные проценты."
                            },
                            {
                                "example_id": "d510fb39-9d73-4021-b10a-c6b54fb4d2e6",
                                "sense_id": "0681f419-1e9e-3112-b625-197efa51d325",
                                "text": "По всему маршруту были расставлены судьи, начислявшие штрафные баллы за нарушения."
                            }
                        ]
                    }
