                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9403375f-7d14-3482-92cf-b87a03617a64",
                                        "entry_id": "c057be9d-b231-30ab-9e72-a1fe935f4b13",
                                        "glosses": [
                                            "anarchisme, dat zich het vormen van een communistische samenleving ten doel stelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8123e300-394f-4d00-8a23-f2aa35caf36e",
                                                "sense_id": "9403375f-7d14-3482-92cf-b87a03617a64",
                                                "text": "Peter Kropotkin heeft het anarchocommunisme gepopulariseerd. Het anarchocommunisme streeft naar een staatloze samenleving gebaseerd op gemeenschappelijk bezit van de productiemiddelen, waarbij de geproduceerde goederen verdeeld worden naar ieders behoefte. Kropotkin wilde dat de Staat vervangen zou worden door een federatie van communes. De geproduceerde goederen worden naar behoefte gedistribueerd onder alle leden van de federatie van communes. Overvloedige producten kunnen genomen worden naar ieders behoefte, terwijl schaarse goederen gerantsoeneerd worden verdeeld onder diegene die er behoefte aan hebben"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
