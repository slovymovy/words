    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d6890fe-d194-3782-ade7-b2a121646e5f",
                    "sense_definition": "Donner une autre forme, changer l'aspect ou la nature de quelque chose ou de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous voulons <w>transformer</w> cette ancienne grange en une belle maison familiale."
                        },
                        {
                            "text": "Cette nouvelle coiffure va complètement <w>transformer</w> ton visage et ton allure."
                        }
                    ],
                    "synonyms": [
                        "changer",
                        "métamorphoser"
                    ],
                    "common_phrases": [
                        "transformer en"
                    ]
                },
                {
                    "sense_id": "036acc49-febb-3aaa-bb7b-0a2e71207473",
                    "sense_definition": "Changer de forme ou de nature pour devenir différent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec le temps, leur amitié d'enfance s'est <w>transformée</w> en un amour sincère."
                        },
                        {
                            "text": "La chenille commence à se <w>transformer</w> en papillon à l'intérieur de son cocon."
                        }
                    ],
                    "synonyms": [
                        "changer",
                        "métamorphoser"
                    ],
                    "common_phrases": [
                        "se transformer en"
                    ]
                },
                {
                    "sense_id": "f1aed243-a616-36e7-8ec0-4a6239f03e2a",
                    "sense_definition": "Modifier la forme d'une expression ou d'une équation sans en altérer la valeur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous montre comment <w>transformer</w> cette équation complexe en une formule simple."
                        },
                        {
                            "text": "Il faut <w>transformer</w> cette fraction avant de pouvoir résoudre le problème."
                        }
                    ],
                    "synonyms": [
                        "changer"
                    ]
                },
                {
                    "sense_id": "d661133a-5fd3-3e93-9780-b78852deed23",
                    "sense_definition": "Au rugby, réussir le tir au but consécutif à un essai pour marquer deux points supplémentaires.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rugby",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a réussi à <w>transformer</w> l'essai juste avant le coup de sifflet final."
                        },
                        {
                            "text": "L'ouvreur espère <w>transformer</w> cet essai difficile pour donner la victoire à son équipe."
                        }
                    ],
                    "common_phrases": [
                        "transformer un essai"
                    ]
                }
            ]
        }
    ]
