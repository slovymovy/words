                {
                    "sense_id": "7ccc7322-34cc-3fc5-b506-b1b081daebb9",
                    "sense_definition": "Dont la force, la vitalité ou la sensibilité a été affaiblie par l'âge ou les épreuves.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "affaibli",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après quarante ans de dur labeur à l'usine, il a le corps <w>usé</w> par la fatigue.",
                            "target_lang_translations": {
                                "en": "After forty years of hard labour at the factory, his body is <w>worn down</w> by fatigue.",
                                "ru": "После сорока лет тяжёлого труда на заводе его тело <w>изнурено</w> усталостью.",
                                "nl": "Na veertig jaar zware arbeid in de fabriek is zijn lichaam <w>afgeleefd</w> door vermoeidheid.",
                                "pl": "Po czterdziestu latach ciężkiej pracy w fabryce jego ciało jest <w>wyczerpane</w> zmęczeniem.",
                                "it": "Dopo quarant'anni di duro lavoro in fabbrica, ha il corpo <w>logorato</w> dalla fatica.",
                                "cs": "Po čtyřiceti letech tvrdé dřiny v továrně má tělo <w>vysílené</w> únavou.",
                                "tr": "Fabrikada kırk yıl ağır işte çalıştıktan sonra vücudu yorgunluktan <w>yıpranmış</w>.",
                                "es": "Tras cuarenta años de duro trabajo en la fábrica, tiene el cuerpo <w>desgastado</w> por el cansancio.",
                                "zh": "他在工厂里做了四十年的重活，身体已经<w>疲惫</w>不堪。",
                                "de": "Nach vierzig Jahren harter Arbeit in der Fabrik ist sein Körper von der Müdigkeit <w>erschöpft</w>."
                            }
                        },
                        {
                            "text": "Cet artisan paraît bien plus vieux que son âge, complètement <w>usé</w> par les soucis quotidiens.",
                            "target_lang_translations": {
                                "en": "This craftsman looks much older than his age, completely <w>worn down</w> by daily worries.",
                                "ru": "Этот ремесленник выглядит гораздо старше своих лет, совсем <w>измотанный</w> повседневными заботами.",
                                "nl": "Deze ambachtsman lijkt veel ouder dan zijn leeftijd, helemaal <w>afgeleefd</w> door de dagelijkse zorgen.",
                                "pl": "Ten rzemieślnik wygląda na znacznie starszego, niż wskazuje jego wiek, całkowicie <w>sfatygowany</w> codziennymi troskami.",
                                "it": "Questo artigiano sembra molto più vecchio della sua età, del tutto <w>provato</w> dalle preoccupazioni quotidiane.",
                                "cs": "Tento řemeslník vypadá mnohem starší, než odpovídá jeho věku, a je úplně <w>vysílený</w> každodenními starostmi.",
                                "tr": "Bu zanaatkâr yaşından çok daha yaşlı görünüyor; günlük kaygılar yüzünden tamamen <w>bitkin</w> durumda.",
                                "es": "Este artesano parece mucho mayor de lo que es, completamente <w>agotado</w> por las preocupaciones diarias.",
                                "zh": "这位手艺人看上去比实际年龄老得多，被日常的烦恼折磨得十分<w>憔悴</w>。",
                                "de": "Dieser Handwerker wirkt viel älter, als es seinem Alter entspricht, und ist von den täglichen Sorgen völlig <w>erschöpft</w>."
                            }
                        }
                    ],
