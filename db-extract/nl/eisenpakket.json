                        "examples": [
                            {
                                "example_id": "c3dacc6d-4e39-4e4d-9c1d-276b4444c203",
                                "sense_id": "9a79a65c-ae18-32c4-9d24-345b0b53d14d",
                                "text": "techniek van het opstellen van een eisenpakket — technique de définition du 'cahier des charges'"
                            },
                            {
                                "example_id": "40d97523-4861-443d-8769-9f3acf08fb75",
                                "sense_id": "9a79a65c-ae18-32c4-9d24-345b0b53d14d",
                                "text": "Omdat met de draaistroomtechniek een brede draaimomenten toerentalband beheerst kan worden, is het eisenpakket voor deze nieuwe ontwikkeling qua verlanglijstje breed neergezet. — La technique du courant triphasé permettant de maîtriser une large bande de couples et de tours-minutes, le cahier des charges relatif à cette nouvelle conception contient une liste conséquente de desiderata."
                            }
                        ]
