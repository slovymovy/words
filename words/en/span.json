{
    "word_family": [
        "lifespan",
        "wingspan",
        "handspan",
        "spanner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                    "sense_definition": "A specific portion of time that something lasts or requires.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small children often have a very short attention <w>span</w>.",
                            "target_lang_translations": {
                                "ru": "У маленьких детей часто очень короткий <w>период</w> концентрации внимания.",
                                "zh": "小孩子的注意力<w>持续时间</w>往往很短。"
                            }
                        },
                        {
                            "text": "The project was completed within a <w>span</w> of three months.",
                            "target_lang_translations": {
                                "ru": "Проект был завершен за <w>промежуток</w> времени в три месяца.",
                                "zh": "这个项目在三个月的<w>时间跨度</w>内完成了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "duration",
                        "period",
                        "term"
                    ],
                    "common_phrases": [
                        "attention span",
                        "time span",
                        "life span",
                        "short span"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный отрезок времени, который что-либо длится или требуется для чего-либо.",
                        "zh": "某事持续或完成所需要的一段特定时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "отрезок времени"
                            },
                            {
                                "target_lang_word": "период",
                                "target_lang_sense_clarification": "длительность"
                            },
                            {
                                "target_lang_word": "интервал",
                                "target_lang_sense_clarification": "временной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "持续时间",
                                "target_lang_sense_clarification": "指某事持续的一段时间"
                            },
                            {
                                "target_lang_word": "时间跨度",
                                "target_lang_sense_clarification": "一段时间的长度"
                            },
                            {
                                "target_lang_word": "时段",
                                "target_lang_sense_clarification": "较通用的时间段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ca33cca-68de-3a48-8100-6db8f0f72315",
                    "sense_definition": "The full extent of something from end to end, or the distance between two supports of a structure like a bridge or arch.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "distance_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The central <w>span</w> of the bridge collapsed during the severe storm.",
                            "target_lang_translations": {
                                "ru": "Центральный <w>пролёт</w> моста обрушился во время сильного шторма.",
                                "zh": "那座桥的中央<w>桥跨</w>在猛烈的暴风雨中坍塌了。"
                            }
                        },
                        {
                            "text": "The eagle has an impressive wing <w>span</w> of over two meters.",
                            "target_lang_translations": {
                                "ru": "У орла внушительный <w>размах</w> крыльев — более двух метров.",
                                "zh": "那只老鹰的<w>翼展</w>超过两米，十分惊人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "width",
                        "breadth",
                        "reach",
                        "extent"
                    ],
                    "common_phrases": [
                        "wing span",
                        "bridge span",
                        "clear span"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полная протяженность чего-либо от края до края или расстояние между двумя опорами конструкции, например моста или арки.",
                        "zh": "某物从一端到另一端的全部长度，或桥梁、拱等结构两个支撑点之间的距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролёт",
                                "target_lang_sense_clarification": "моста или конструкции"
                            },
                            {
                                "target_lang_word": "размах",
                                "target_lang_sense_clarification": "крыльев или рук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桥跨",
                                "target_lang_sense_clarification": "桥梁、拱形结构等两端支撑之间的部分"
                            },
                            {
                                "target_lang_word": "跨度",
                                "target_lang_sense_clarification": "从一端到另一端的宽度或距离"
                            },
                            {
                                "target_lang_word": "翼展",
                                "target_lang_sense_clarification": "专指翅膀展开时两端之间的距离"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "214dfdd9-ed5c-3937-a9ac-2f3c0cd437af",
                    "sense_definition": "The width of an open hand from the tip of the thumb to the tip of the little finger, used as a rough unit of measurement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distance_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He estimated the length of the fish to be about one <w>span</w>.",
                            "target_lang_translations": {
                                "ru": "Он оценил длину рыбы примерно в одну <w>пядь</w>.",
                                "zh": "他估计那条鱼大约有一<w>拃</w>长。"
                            }
                        },
                        {
                            "text": "The table was only a <w>span</w> wide, making it useless for dinner.",
                            "target_lang_translations": {
                                "ru": "Стол был шириной всего в <w>пядь</w>, что делало его бесполезным для обеда.",
                                "zh": "这张桌子只有一<w>拃</w>宽，根本没法用来吃饭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "measurement unit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ширина раскрытой ладони от кончика большого пальца до кончика мизинца, используемая как приблизительная мера длины.",
                        "zh": "张开手掌时，从拇指尖到小指尖的宽度，用作一种粗略的长度单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пядь",
                                "target_lang_sense_clarification": "старинная мера длины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拃",
                                "target_lang_sense_clarification": "张开手掌时从拇指尖到小指尖的大致长度单位，较旧或口语化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da4b0cfd-ab47-387e-9ff4-a34a9f770299",
                    "sense_definition": "The set of all linear combinations of vectors within a specific set.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>span</w> of these two vectors forms a plane in three-dimensional space.",
                            "target_lang_translations": {
                                "ru": "<w>Линейная оболочка</w> этих двух векторов образует плоскость в трехмерном пространстве.",
                                "zh": "这两个向量的<w>张成</w>在三维空间中构成一个平面。"
                            }
                        },
                        {
                            "text": "Students learned how to calculate the linear <w>span</w> of the set.",
                            "target_lang_translations": {
                                "ru": "Студенты учились вычислять линейную <w>оболочку</w> множества.",
                                "zh": "学生们学习了如何计算这个集合的线性<w>张成</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество всех линейных комбинаций векторов из определенного набора.",
                        "zh": "数学上指由某组向量的所有线性组合构成的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линейная оболочка",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张成",
                                "target_lang_sense_clarification": "数学中指一组向量所有线性组合构成的集合"
                            },
                            {
                                "target_lang_word": "线性张成",
                                "target_lang_sense_clarification": "更完整的数学说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f65ad101-a229-330b-9017-93878fa94f3a",
                    "sense_definition": "To extend across a distance or connect two sides of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "space_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A magnificent suspension bridge <w>spans</w> the river near the city.",
                            "target_lang_translations": {
                                "ru": "Великолепный подвесной мост <w>пересекает</w> реку недалеко от города.",
                                "zh": "一座宏伟的悬索桥<w>横跨</w>城市附近的河流。"
                            }
                        },
                        {
                            "text": "Her influence <w>spanned</w> the globe during the height of her career.",
                            "target_lang_translations": {
                                "ru": "Ее влияние <w>охватывало</w> весь земной шар в разгар ее карьеры.",
                                "zh": "在她事业的巅峰时期，她的影响力<w>遍及</w>全球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cross",
                        "bridge",
                        "traverse"
                    ],
                    "common_phrases": [
                        "span the river",
                        "span the globe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простираться на определенное расстояние или соединять две стороны чего-либо.",
                        "zh": "跨越一段距离，或把某物的两边连接起来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "проходить через пространство"
                            },
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "берега или стороны"
                            },
                            {
                                "target_lang_word": "охватывать",
                                "target_lang_sense_clarification": "распространяться на территорию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "横跨",
                                "target_lang_sense_clarification": "跨过河流、道路等"
                            },
                            {
                                "target_lang_word": "跨越",
                                "target_lang_sense_clarification": "从一边延伸到另一边"
                            },
                            {
                                "target_lang_word": "遍及",
                                "target_lang_sense_clarification": "范围覆盖很广时用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0cf531f-e579-33a0-9d1e-f676e92cd461",
                    "sense_definition": "To last or continue for a particular period of time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history of this ancient civilization <w>spans</w> three thousand years.",
                            "target_lang_translations": {
                                "ru": "История этой древней цивилизации <w>насчитывает</w> три тысячи лет.",
                                "zh": "这个古代文明的历史<w>长达</w>三千年。"
                            }
                        },
                        {
                            "text": "Their professional partnership has <w>spanned</w> decades of innovation.",
                            "target_lang_translations": {
                                "ru": "Их профессиональное партнерство <w>охватывало</w> десятилетия инноваций.",
                                "zh": "他们的职业合作<w>持续</w>了数十年的创新历程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "last",
                        "cover",
                        "endure"
                    ],
                    "common_phrases": [
                        "span decades",
                        "span generations",
                        "span a lifetime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длиться или продолжаться в течение определенного периода времени.",
                        "zh": "持续或延续一段特定的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охватывать",
                                "target_lang_sense_clarification": "период времени"
                            },
                            {
                                "target_lang_word": "продолжаться",
                                "target_lang_sense_clarification": "длиться"
                            },
                            {
                                "target_lang_word": "насчитывать",
                                "target_lang_sense_clarification": "о количестве лет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长达",
                                "target_lang_sense_clarification": "强调时间长度达到某个数字"
                            },
                            {
                                "target_lang_word": "持续",
                                "target_lang_sense_clarification": "强调延续下去"
                            },
                            {
                                "target_lang_word": "跨越",
                                "target_lang_sense_clarification": "强调跨过较长时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1e18076-95c1-394c-9f05-c80e3a5f8080",
                    "sense_definition": "To generate an entire space by means of linear combinations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These two vectors <w>span</w> the entire plane.",
                            "target_lang_translations": {
                                "ru": "Эти два вектора <w>порождают</w> всю плоскость.",
                                "zh": "这两个向量<w>张成</w>整个平面。"
                            }
                        },
                        {
                            "text": "We need to find a set of vectors that <w>span</w> the subspace.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти набор векторов, которые <w>порождают</w> подпространство.",
                                "zh": "我们需要找到一组能够<w>张成</w>该子空间的向量。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Порождать все пространство посредством линейных комбинаций.",
                        "zh": "数学上指通过线性组合生成整个空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "пространство (о векторах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张成",
                                "target_lang_sense_clarification": "数学中指由一些向量生成某个空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c4f517d-d9f1-3c8e-856c-bd9c8e18c766",
                    "sense_definition": "A past tense form of <w>spin</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old tale, the woman sat by the fire and <w>span</w> wool all evening.",
                            "target_lang_translations": {
                                "ru": "В старой сказке женщина сидела у огня и весь вечер <w>пряла</w> шерсть.",
                                "zh": "在那个古老的故事里，那个女人坐在火边，整晚都在<w>纺</w>羊毛。"
                            }
                        },
                        {
                            "text": "The wheel <w>span</w> faster and faster until it was a blur.",
                            "target_lang_translations": {
                                "ru": "Колесо <w>крутилось</w> все быстрее и быстрее, пока не слилось в пятно.",
                                "zh": "轮子<w>旋转</w>得越来越快，直到看起来一片模糊。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "past tense of spin"
                        },
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени глагола spin (прясть, крутиться).",
                        "zh": "spin 的过去式形式，古旧用法，可表示“纺”或“旋转”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прял",
                                "target_lang_sense_clarification": "прошедшее время от 'прясть'"
                            },
                            {
                                "target_lang_word": "крутился",
                                "target_lang_sense_clarification": "прошедшее время от 'крутиться'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纺",
                                "target_lang_sense_clarification": "表示 spin 在“纺”这一义项上的过去式用法"
                            },
                            {
                                "target_lang_word": "旋转",
                                "target_lang_sense_clarification": "表示 spin 在“旋转”这一义项上的过去式用法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
