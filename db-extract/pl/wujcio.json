                "senses": [
                    {
                        "sense_id": "31f9e904-15e1-36c2-a270-f7ef02bde11c",
                        "entry_id": "061d93f2-e5ee-3285-9432-5b05067225dd",
                        "glosses": [
                            "wuj"
                        ],
                        "tags": [
                            "colloquial",
                            "endearing"
                        ],
                        "examples": [
                            {
                                "example_id": "86ac0061-3680-4b32-b274-2f7673d0d85f",
                                "sense_id": "31f9e904-15e1-36c2-a270-f7ef02bde11c",
                                "text": "Wujcio zawsze przynosił cukierki i opowiadał ciekawe historie."
                            },
                            {
                                "example_id": "a2423125-5b91-4949-9b14-9513ff8d83d0",
                                "sense_id": "31f9e904-15e1-36c2-a270-f7ef02bde11c",
                                "text": "Wezmę, wujciu… ale wujcio zaczeka na mnie… sam nie odejdzie… – szlochała dziewczynka całując jego ręce."
                            },
                            {
                                "example_id": "9138269c-5afb-47e9-b59e-9436b08bc353",
                                "sense_id": "31f9e904-15e1-36c2-a270-f7ef02bde11c",
                                "text": "Przyjdź do mnie jutro o wpół do dziewiątej, ale – wujciowi nie mów nic…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
