                "senses": [
                    {
                        "sense_id": "0b75dc69-9db5-3cde-a178-1f280487020d",
                        "entry_id": "1732a22e-8175-3cb8-8579-26fd4a98c1e8",
                        "glosses": [
                            "Capable of being assimilated; susceptible to assimilation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b52583d-cdd8-43e8-a091-41b5cc7b6c43",
                                "sense_id": "0b75dc69-9db5-3cde-a178-1f280487020d",
                                "text": "1654, Walter Charleton, Physiologia Epicuro-Gassendo-Charltoniana, or, A Fabrick of Science Natural, London: Thomas Heath, Book 3, Chapter 15, Section 3, p. 381,\n[…] very deep and large wounds are many times soon healed of themselves; i. e. meerly by the goodness of Nature it self, which being vigorous, and of our own provision furnished with convenient means, wholesom and assimilable Blood, doth every moment freshly apply it to the part that hath suffered solution of Continuity, and thereby redintegrate the same:"
                            },
                            {
                                "example_id": "cbfd2847-57bd-4a1a-98e1-a4f17f7e038f",
                                "sense_id": "0b75dc69-9db5-3cde-a178-1f280487020d",
                                "text": "He was not like other teachers, a mere vehicle of text-books. He made his teaching personal, he himself was the source of it, and therefore it was made of life stuff, easily assimilable by the living human nature."
                            },
                            {
                                "example_id": "17a14a55-1b14-45bd-83e2-69088a936298",
                                "sense_id": "0b75dc69-9db5-3cde-a178-1f280487020d",
                                "text": "Sometimes there are such bizarre experiences that the dream seems not at all assimilable to anything that happened in the remembered life, but may have some deeper meaning that we don’t know, as Freud conjectured."
                            },
                            {
                                "example_id": "19a5f453-ccbd-47da-b1af-6844abc2825a",
                                "sense_id": "0b75dc69-9db5-3cde-a178-1f280487020d",
                                "text": "British postwar immigration policy deliberately excluded Jews (and non-white immigrants) because it didn’t consider them assimilable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85cf980e-8b62-44a7-acbd-15b6d6abb6cb",
                        "source_entry_id": "1732a22e-8175-3cb8-8579-26fd4a98c1e8",
                        "source_sense_id": "0b75dc69-9db5-3cde-a178-1f280487020d",
                        "source_sense_description": "assimilable",
