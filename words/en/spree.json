{
    "word_family": [
        "spreeing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "325d4aa4-0380-3261-9a38-3b68693d0c79",
                    "sense_definition": "A period of intense, uninhibited activity, often involving spending or consumption.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopper went on a wild spending <w>spree</w> during the holiday sales.",
                            "target_lang_translations": {
                                "cs": "Nakupující propadl během svátečních výprodejů divoké nákupní <w>horečce</w>."
                            }
                        },
                        {
                            "text": "The company went on a hiring <w>spree</w> to expand its engineering department.",
                            "target_lang_translations": {
                                "cs": "Společnost zahájila náborovou <w>horečku</w>, aby rozšířila své inženýrské oddělení."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spending spree",
                        "hiring spree"
                    ],
                    "target_lang_definitions": {
                        "cs": "Období intenzivní, nespoutané aktivity, často zahrnující utrácení nebo konzumaci."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "horečka",
                                "target_lang_sense_clarification": "ve smyslu nákupní nebo jiné intenzivní aktivity"
                            },
                            {
                                "target_lang_word": "výstřelek",
                                "target_lang_sense_clarification": "ve smyslu nespoutaného chování"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "802069ce-1645-3d36-8b0a-69fc136e1b1e",
                    "sense_definition": "A period of merry, unrestrained behavior, particularly involving excessive drinking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long work week, the group went on a wild <w>spree</w> at the local pub.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém pracovním týdnu se skupina vydala na divoký <w>flám</w> do místní hospody."
                            }
                        },
                        {
                            "text": "He regretted the reckless <w>spree</w> he had engaged in the night before.",
                            "target_lang_translations": {
                                "cs": "Litoval toho bezhlavého <w>flámu</w>, kterého se předešlou noc zúčastnil."
                            }
                        }
                    ],
                    "synonyms": [
                        "carousal"
                    ],
                    "target_lang_definitions": {
                        "cs": "Období veselého, nespoutaného chování, zejména zahrnující nadměrné pití."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "flám",
                                "target_lang_sense_clarification": "noční tah, bujará zábava"
                            },
                            {
                                "target_lang_word": "pijatyka",
                                "target_lang_sense_clarification": "ve smyslu nadměrného pití"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c247d49-9575-3e6b-8439-eafe14859375",
                    "sense_definition": "To participate in a period of unrestrained, merry, or excessive activity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>spree</w> all night to celebrate the end of their exams.",
                            "target_lang_translations": {
                                "cs": "Rozhodli se celou noc <w>flámovat</w>, aby oslavili konec zkoušek."
                            }
                        },
                        {
                            "text": "He used to <w>spree</w> with his friends every weekend during his youth.",
                            "target_lang_translations": {
                                "cs": "V mládí každý víkend <w>flámoval</w> se svými přáteli."
                            }
                        }
                    ],
                    "synonyms": [
                        "carouse"
                    ],
                    "target_lang_definitions": {
                        "cs": "Účastnit se období nespoutané, veselé nebo nadměrné aktivity."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "flámovat",
                                "target_lang_sense_clarification": "bavit se, pít, ponocovat"
                            },
                            {
                                "target_lang_word": "táhnout to",
                                "target_lang_sense_clarification": "hovorově o bujaré zábavě"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8c207a61-75ce-39bc-8eea-42814df7b1cc",
                    "sense_definition": "A river in Germany flowing through Lusatia and Berlin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Spree</w> river winds beautifully through the center of Berlin.",
                            "target_lang_translations": {
                                "cs": "Řeka <w>Spréva</w> se krásně vine centrem Berlína."
                            }
                        },
                        {
                            "text": "Many historic buildings are located along the banks of the <w>Spree</w>.",
                            "target_lang_translations": {
                                "cs": "Podél břehů <w>Sprévy</w> se nachází mnoho historických budov."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Řeka v Německu protékající Lužicí a Berlínem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Spréva",
                                "target_lang_sense_clarification": "vlastní jméno řeky"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}