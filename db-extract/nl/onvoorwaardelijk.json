                        "examples": [
                            {
                                "example_id": "92756712-0bc0-42be-8439-afeae12804f3",
                                "sense_id": "0d901b20-b1c2-3722-840d-afe63d96215a",
                                "text": "Hij gaf haar zijn onvoorwaardelijke liefde.",
                                "translation": "He gave her his unconditional love.",
                                "english": "He gave her his unconditional love."
                            },
                            {
                                "example_id": "76b24aab-cf54-4dcd-9c05-63732e834057",
                                "sense_id": "0d901b20-b1c2-3722-840d-afe63d96215a",
                                "text": "De hulpverlener bood haar onvoorwaardelijke steun.",
                                "translation": "The caregiver offered her unconditional support.",
                                "english": "The caregiver offered her unconditional support."
                            },
                            {
                                "example_id": "d9f7f6c0-571e-47f0-9c50-143c70fc7c5d",
                                "sense_id": "0d901b20-b1c2-3722-840d-afe63d96215a",
                                "text": "De atleet had een onvoorwaardelijke toewijding aan zijn sport.",
                                "translation": "The athlete had an unconditional dedication to his sport.",
                                "english": "The athlete had an unconditional dedication to his sport."
                            }
                        ]
                    }
