                    },
                    {
                        "translation_id": "de5c2ad9-126c-41a4-b19f-bf3dee1f5bd6",
                        "source_entry_id": "6743aa21-0d2f-37cd-8c5d-242f12fe33f9",
                        "source_sense_description": "disease",
                        "target_lang_word": "malaria",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malaria",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "974dddf1-5393-3dad-95a7-5de0247944c4",
                                        "entry_id": "8e4d73d5-a1ee-36f9-9f8f-b65111042927",
                                        "glosses": [
                                            "infectieziekte die veroorzaakt wordt door eencellige parasieten van het geslacht Plasmodium, op mensen overgebracht door malariamuggen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a421768a-f189-4c3e-8268-381badcf5b20",
                                                "sense_id": "974dddf1-5393-3dad-95a7-5de0247944c4",
                                                "text": "Aantal doden door malaria sterk gedaald. Vorig jaar overleden 'slechts' ongeveer 584.000 mensen aan de ziekte!"
                                            },
                                            {
                                                "example_id": "0bc2b1bb-e32a-4cbe-b77b-64a43535a465",
                                                "sense_id": "974dddf1-5393-3dad-95a7-5de0247944c4",
                                                "text": "Het was een medicijn tegen malaria, een van de boosaardigste ziektes van Afrika."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d53df81-3e40-4ca6-bb6b-38d55f38ff8f",
                        "source_entry_id": "6743aa21-0d2f-37cd-8c5d-242f12fe33f9",
                        "source_sense_description": "disease",
                        "target_lang_word": "paludisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paludisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0dd8011-ac0e-3325-befe-8ae798ccaaa9",
                                        "entry_id": "3dd50660-ee43-3777-a596-a7a607c60ee3",
                                        "glosses": [
                                            "Maladie parasitaire provoquée par la présence dans le sang d'un hématozoaire nommé plasmodium. Cette maladie se transmet par les piqûres de moustiques eux-mêmes contaminés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33be7f77-1df0-4a5d-855f-e1a26b8683d1",
                                                "sense_id": "a0dd8011-ac0e-3325-befe-8ae798ccaaa9",
                                                "text": "Beaucoup d’observateurs admettent l’existence de plusieurs espèces d’hématozoaires du paludisme : hématozoaires des fièvres tropicales, de la tierce et de la quarte. Je pense qu’il s’agit de simples variétés d’une même espèce polymorphe."
                                            },
                                            {
                                                "example_id": "3f77758d-9515-49fb-aed8-32f01ecd9fb4",
                                                "sense_id": "a0dd8011-ac0e-3325-befe-8ae798ccaaa9",
                                                "text": "Malgré ces avertissements, Patrick Brontë ne voulut pas retirer ses deux autres filles, et il fallut qu’une épidémie de paludisme frappât quarante élèves de Cowan Bridge pour l’y contraindre."
                                            },
                                            {
                                                "example_id": "9a85a814-3cd1-4e5e-a5d5-2d5231f8d484",
                                                "sense_id": "a0dd8011-ac0e-3325-befe-8ae798ccaaa9",
                                                "text": "Cette fièvre, il l’avait eue toute la soirée, au point qu’il avait cru devoir parler de paludisme."
                                            },
                                            {
                                                "example_id": "d2aedf43-6649-4f02-9091-767e72d09d4f",
                                                "sense_id": "a0dd8011-ac0e-3325-befe-8ae798ccaaa9",
                                                "text": "\"Traditionnellement, on a plus tenté de découvrir des médicaments qui guérissent du paludisme\", poursuit-elle, que des médicaments qui tuent les parasites avant qu'ils ne provoquent le paludisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87bd650c-f26f-4a66-b2e0-a5b339dbff34",
                        "source_entry_id": "6743aa21-0d2f-37cd-8c5d-242f12fe33f9",
                        "source_sense_description": "disease",
                        "target_lang_word": "malaria",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malaria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3ef3cb-d6ae-3387-b60c-6b6f861becc0",
                                        "entry_id": "6581b3a3-bb5e-30dd-9eb2-fe8ba541bb1a",
                                        "glosses": [
                                            "Air vicié, pestilence provenant des marécages, qu’on croyait être cause des accès de fièvre dont souffraient périodiquement les habitants de certaines régions."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33b6c190-b9c3-45c6-aa7d-218247f2e9f7",
                                                "sense_id": "7c3ef3cb-d6ae-3387-b60c-6b6f861becc0",
                                                "text": "La mère et la fille semblaient vivre de la même vie et dépérir du même mal. La maison a l’air d’une maison abandonnée ; on y respire un souffle de malaria."
                                            },
                                            {
                                                "example_id": "49762e91-a549-467f-8122-f23f234c477b",
                                                "sense_id": "7c3ef3cb-d6ae-3387-b60c-6b6f861becc0",
                                                "text": "Des tourbillons de moustiques nous enveloppent, et nous respirons cette malaria spéciale qui donne la fièvre des bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82379e2d-a855-3df8-87d2-dd2dabcfeacc",
                                        "entry_id": "6581b3a3-bb5e-30dd-9eb2-fe8ba541bb1a",
                                        "glosses": [
                                            "Paludisme transmis par l’anophèle, qui se manifeste par des accès de fièvre survenant à des intervalles réguliers."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac400be-7ac3-421b-b12c-15d16928ee70",
                                                "sense_id": "82379e2d-a855-3df8-87d2-dd2dabcfeacc",
                                                "text": "La malaria, aussi appelée paludisme, est une maladie causée par un parasite du genre Plasmodium, essentiellement transmis à l’humain par les moustiques anophèles femelles. Elle touche une centaine de pays dans le monde, en particulier les zones tropicales défavorisées d’Afrique, d’Asie et d’Amérique Latine."
                                            },
                                            {
                                                "example_id": "4d70d1b6-f439-4198-84d2-e71b436b14c8",
                                                "sense_id": "82379e2d-a855-3df8-87d2-dd2dabcfeacc",
                                                "text": "La malaria s’était emparée de la région des marais Pontins."
                                            },
                                            {
                                                "example_id": "24dfa5c0-bcfc-4328-8873-c93c7248135c",
                                                "sense_id": "82379e2d-a855-3df8-87d2-dd2dabcfeacc",
                                                "text": "Il recommandait à sa fille de prendre garde à la malaria car son oncle avait eu une vieillesse empoisonnée par cette maladie."
                                            },
                                            {
                                                "example_id": "a3d23b78-20b3-4f84-9f35-4010cd5e24e2",
                                                "sense_id": "82379e2d-a855-3df8-87d2-dd2dabcfeacc",
                                                "text": "Nous nous reposions, moi, mes guides et leurs mules, sur la route de Sciacca à Girgenti, dans une auberge du pauvre village de Monte-Allegro, dont les habitants, consumés par la malaria, grelottent au soleil."
                                            },
                                            {
                                                "example_id": "e16b844a-bdba-49ea-8e80-a1b46ca84d5d",
                                                "sense_id": "82379e2d-a855-3df8-87d2-dd2dabcfeacc",
                                                "text": "Rollner m’expliqua que Tellegen souffrait des séquelles d’une ancienne malaria et que cela risquait de compromettre le film."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad1a5006-a157-4779-b5c9-e3829c50f407",
                        "source_entry_id": "6743aa21-0d2f-37cd-8c5d-242f12fe33f9",
                        "source_sense_description": "disease",
                        "target_lang_word": "Malaria",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Malaria",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e3a7baa-576d-35ea-bd3e-589529534e9f",
                                        "entry_id": "7a742075-25bb-35af-8716-58c78650409c",
                                        "glosses": [
                                            "fieberhafte, durch wiederkehrende, oft periodische Schübe gekennzeichnete Infektionskrankheit, hervorgerufen durch einzellige Sporentierchen (Protozoen der Gattung Plasmodium), die vor allem durch Übertragung durch Stechmücken ins Blut gelangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38303b4b-abdb-4d36-ae47-cfd362f46420",
                                                "sense_id": "9e3a7baa-576d-35ea-bd3e-589529534e9f",
                                                "text": "Nach Angaben des Robert-Koch-Instituts in Berlin sterben weltweit jährlich 1,5 bis 2,7 Millionen Menschen an Malaria."
                                            },
                                            {
                                                "example_id": "04aca274-115b-4027-abae-922c0c9ba53b",
                                                "sense_id": "9e3a7baa-576d-35ea-bd3e-589529534e9f",
                                                "text": "„Wir wollen nicht wahrnehmen, dass jedes Jahr etwa 400 000 Kinder an Malaria sterben.“"
                                            },
                                            {
                                                "example_id": "5a057f24-9d49-4427-a97d-ff5ea499237d",
                                                "sense_id": "9e3a7baa-576d-35ea-bd3e-589529534e9f",
                                                "text": "„Bevor wir ins Bett gehen, sprüht Falk sich, seinen Schlafsack und das gesamte Zimmer mit einem Spray voll, das ihm Malaria übertragende Mücken vom Leib halten soll.“"
                                            },
                                            {
                                                "example_id": "d939f68a-4e8a-4a25-a290-ec48a437699b",
                                                "sense_id": "9e3a7baa-576d-35ea-bd3e-589529534e9f",
                                                "text": "„Die Opfer wussten nicht einmal, wie ihnen geschah, denn die Ursache der Malaria war noch unbekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d4a6adc-e480-40f2-8f43-34c98804df38",
