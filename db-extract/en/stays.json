                "senses": [
                    {
                        "sense_id": "3386f36d-a12b-389e-9b2d-0d6564e46de7",
                        "entry_id": "5cd733bb-7b81-3683-8f7a-7c9972d853b9",
                        "glosses": [
                            "A corset."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "293cdfa6-f147-4102-be40-8037a0cba891",
                                "sense_id": "3386f36d-a12b-389e-9b2d-0d6564e46de7",
                                "text": "Her face was whiter than snow, and her heart was throbbing through her stays."
                            },
                            {
                                "example_id": "70d194ba-fbee-4480-913b-df87a3ba53a2",
                                "sense_id": "3386f36d-a12b-389e-9b2d-0d6564e46de7",
                                "text": "“Listen! I see it all — down, down even to the stays! Such stays! Six-eight a pair, Polly, with red flannel — or list is it? — that they put into the tops of those fearful things. I can draw you a picture of them.”"
                            },
                            {
                                "example_id": "2522db01-f519-476c-a78b-d8fea2191766",
                                "sense_id": "3386f36d-a12b-389e-9b2d-0d6564e46de7",
                                "text": "Her throat was contracted, her breasts strove against the enlacement of her stays, she was about to weep."
                            }
                        ]
                    }
                ],
