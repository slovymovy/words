                "senses": [
                    {
                        "sense_id": "0a973ab5-7c21-3faf-80ea-5b855a187596",
                        "entry_id": "6494ff8f-defd-343c-b954-1195bccba9dd",
                        "glosses": [
                            "Variante einer Schürze, welche durch einen Latz in Brusthöhe auch die Oberbekleidung des Trägers schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c684345b-8ff8-40b7-9b36-0659d6f1790d",
                                "sense_id": "0a973ab5-7c21-3faf-80ea-5b855a187596",
                                "text": "Während die Mutter dem Kleinkind die Windel wechselte, trug sie eine Latzschürze."
                            },
                            {
                                "example_id": "952676c2-23d2-4edf-8cf8-1c04bdcecc8c",
                                "sense_id": "0a973ab5-7c21-3faf-80ea-5b855a187596",
                                "text": "Bei der Hausarbeit ist das Tragen einer Latzschürze empfehlenswert."
                            },
                            {
                                "example_id": "b66ccb08-ddb7-4d28-887d-b19bab572b60",
                                "sense_id": "0a973ab5-7c21-3faf-80ea-5b855a187596",
                                "text": "Diese Latzschürze für Damen ist mit Stickereien, Rüschen und Spitzen am Saum verziert."
                            },
                            {
                                "example_id": "a8b58489-2e38-40bb-8c11-20f7a9cd2332",
                                "sense_id": "0a973ab5-7c21-3faf-80ea-5b855a187596",
                                "text": "Wenn Kleinkinder noch nicht richtig essen können, kann man ihnen - um die ganze Kleidung zu schützen - eine Latzschürze anlegen."
                            },
                            {
                                "example_id": "8b802b50-d263-404b-9a9f-5dd8e99dd100",
                                "sense_id": "0a973ab5-7c21-3faf-80ea-5b855a187596",
                                "text": "Gekleidet in weißer Latzschürze und schwarzer Bluse reinigt das Zimmermädchen das Gästezimmer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
