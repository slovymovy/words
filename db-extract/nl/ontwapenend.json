                        "glosses": [
                            "zo vriendelijk en onschuldig dat alle boosheid verdwijnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d3ab9b6-1aa4-4370-a2f4-2cde237f1e40",
                                "sense_id": "2353161c-beda-3ac9-ba4f-867e8ef00dcb",
                                "text": "Hoe anders was het vanavond. Poldervaart is de ontwapenende trainer van een fris Excelsior, Buijs zag de steun voor hem alsmaar meer afbrokkelen."
                            },
                            {
                                "example_id": "39c852c2-db1b-44fb-87c6-22b863b5e0ac",
                                "sense_id": "2353161c-beda-3ac9-ba4f-867e8ef00dcb",
                                "text": "Britt Dekker heeft vandaag de taak om de genomineerden en genodigden op te vangen op de rode loper voor de deur van het Amsterdamse AFAS Live. De ontwapenende blondine presenteert De rode lopershow met Frits Sissing, die het gala in 2006 en 2007 presenteerde."
                            },
                            {
                                "example_id": "fe34a548-fdd9-4e5f-9c84-92f7ee9a1cfa",
                                "sense_id": "2353161c-beda-3ac9-ba4f-867e8ef00dcb",
                                "text": "Stephens stal in New York de harten van het Amerikaanse sportpubliek door haar ontwapenende en humoristische optredens rond de partijen."
                            }
                        ]
                    }
