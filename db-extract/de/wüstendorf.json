                "senses": [
                    {
                        "sense_id": "d04343c1-9097-3c47-a62c-31202618d2fc",
                        "entry_id": "e9e3c108-211e-348b-a0e3-54524da8e7f5",
                        "glosses": [
                            "kleine Siedlung, die in einer Wüste liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92771344-863d-4d43-a9fb-f2b7290cc711",
                                "sense_id": "d04343c1-9097-3c47-a62c-31202618d2fc",
                                "text": "„Die Feier findet in drei Tagen im Wüstendorf statt.“"
                            },
                            {
                                "example_id": "cdadb00e-e74a-489b-8026-35038affde43",
                                "sense_id": "d04343c1-9097-3c47-a62c-31202618d2fc",
                                "text": "„Gegen Mittag erreichen sie das Wüstendorf am Fuß des steilen Bergs.“"
                            },
                            {
                                "example_id": "34222c62-b900-4862-86f5-059dbe64a87b",
                                "sense_id": "d04343c1-9097-3c47-a62c-31202618d2fc",
                                "text": "„Aufgeschreckt sammelten sich die Bewohner des Wüstendorfes beim Brunnen.“"
                            },
                            {
                                "example_id": "16bf010c-fd72-4e6a-9eb2-0476a8ead859",
                                "sense_id": "d04343c1-9097-3c47-a62c-31202618d2fc",
                                "text": "„Er ist einigermaßen schattig und man erlebt ein bisschen das Flair eines wirklichen Wüstendorfes.“"
                            },
                            {
                                "example_id": "e895e5bc-8505-4ec3-8ca4-82b0f6ee2508",
                                "sense_id": "d04343c1-9097-3c47-a62c-31202618d2fc",
                                "text": "„Alles in allem wirkte der Ort ruhig und versprühte den typischen Charme eines Wüstendorfes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
