                        "examples": [
                            {
                                "example_id": "5becc48b-8e78-4c85-8ad6-439bbd4e7f48",
                                "sense_id": "4d399844-b804-36ee-96fe-795362efae2c",
                                "text": "First, second and third base magnetiferous strips 70, 72 and 74 may be magnets. However, the inventor has found it more convenient to form these base magnetiferous strips of material that conducts magnetism and place between these strips two magnets 80, 82."
                            }
                        ]
