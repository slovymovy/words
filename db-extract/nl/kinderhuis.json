                        "examples": [
                            {
                                "example_id": "789d309d-fc19-4876-8c55-b6cfab5883f2",
                                "sense_id": "34792766-0e43-344e-ba2a-e1587c5a7c1a",
                                "text": "Vasja's zussen Aljonka en Arisjka zaten volgens onbevestigde berichten in een kinderhuis in een ander district."
                            },
                            {
                                "example_id": "6bc698d0-e1bf-4a91-8d60-8e58423ddd62",
                                "sense_id": "34792766-0e43-344e-ba2a-e1587c5a7c1a",
                                "text": "Regelmatig was het nodig te pauzeren voor een kop koffie. Zo gruwelijk zijn soms de feiten. Margot van Kooten las de dossiers van politiemannen uit Den Haag die een Joods kinderhuis leeghaalden. De kinderen werd geen tijd gegund. \"Een Nederlandse politieman schopte ze soms letterlijk de wagen in.\""
                            }
