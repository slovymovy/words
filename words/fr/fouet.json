                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle utilise un <w>fouet</w> pour monter les blancs d'œufs en neige très ferme."
                        },
                        {
                            "text": "Montez la crème chantilly au <w>fouet</w> jusqu'à obtenir une texture bien onctueuse."
                        }
                    ],
                    "common_phrases": [
