                "senses": [
                    {
                        "sense_id": "0b44394d-4efa-367b-bf77-abd8034fb7e6",
                        "entry_id": "f2b2ae18-0a08-3c0b-a2bc-d51ba2f15ad3",
                        "glosses": [
                            "Agitation légère et irrégulière à la surface de l’eau, causée par l’interaction entre les vagues, la houle et tout ce qui émerge de l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f6ff50-096d-4d66-be45-ca9a57f03051",
                                "sense_id": "0b44394d-4efa-367b-bf77-abd8034fb7e6",
                                "text": "Kyrie, eleïson, répéta la foule avec ce murmure qui court sur toutes les têtes comme le clapotement d’une mer agitée."
                            },
                            {
                                "example_id": "59d8c225-1ac2-4073-a963-d18582940a6b",
                                "sense_id": "0b44394d-4efa-367b-bf77-abd8034fb7e6",
                                "text": "— Quel est ce bruit? — Rien, sans doute le clapotement des flots qui monte et descend une marche des escaliers de la Giudecca."
                            },
                            {
                                "example_id": "02ce62e0-90b0-497d-93b4-d97a10a8f071",
                                "sense_id": "0b44394d-4efa-367b-bf77-abd8034fb7e6",
                                "text": "Dans les clapotements furieux des marées,\nMoi, l’autre hiver, plus sourd que les cerveaux d’enfants,\nJe courus !"
                            }
                        ]
                    }
                ],
