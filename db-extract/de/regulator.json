                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f5bb95e-62c8-3b50-b9ef-c7c488259c03",
                        "entry_id": "24ce4cb9-1668-3a0f-9afd-36b42e1ef63b",
                        "glosses": [
                            "Uhr mit einstellbarem Pendel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8311ea2a-c7a0-4c91-9e56-87f686845613",
                                "sense_id": "3f5bb95e-62c8-3b50-b9ef-c7c488259c03",
                                "text": "„Sie warf einen Blick auf den blitzenden Regulator an der Wand und fragte: »Wirst du's noch bis zu deiner Schicht schaffen?«.“"
                            },
                            {
                                "example_id": "8c0afd28-ef08-4deb-b053-4da909f0d261",
                                "sense_id": "3f5bb95e-62c8-3b50-b9ef-c7c488259c03",
                                "text": "„Der Regulator zerhackt mit seinem Perpendikel die Zeit in hörbare Teilchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8f52dab8-6a1a-3e49-a15f-de406606eeab",
                        "entry_id": "24ce4cb9-1668-3a0f-9afd-36b42e1ef63b",
                        "glosses": [
                            "Aufsichtsbehörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f928a1c8-5c17-48e5-b3e0-1e9911f42bab",
                                "sense_id": "8f52dab8-6a1a-3e49-a15f-de406606eeab",
                                "text": "„Der Beschaffungsaufwand entspricht der vom Regulator verfügten Abgeltung an die Übertragungsnetzeigentümer für die Betriebs- und Kapitalkosten des Übertragungsnetzes.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
