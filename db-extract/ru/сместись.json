                "senses": [
                    {
                        "sense_id": "7a7c8e6b-2048-3382-8d71-bfb71f80c237",
                        "entry_id": "8016186d-a541-30c2-b220-d8e341e5fbdf",
                        "glosses": [
                            "страд. к смести"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "b4a2059c-fa7c-49aa-9900-300abca43abf",
                                "sense_id": "7a7c8e6b-2048-3382-8d71-bfb71f80c237",
                                "text": "Все смелось: былое отчуждение — // Кто ты есть, артельный или нет? — // В этот час иных страстей виденья // И сердец иные тень и свет."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e3dd7b-2c36-347a-87c0-7cf7cf514adf",
                        "entry_id": "8016186d-a541-30c2-b220-d8e341e5fbdf",
                        "glosses": [
                            "устар. сосчитать, затраты денег и труда; составить смету"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6666203a-e6d7-49dc-ae95-7395ae43565d",
                                "sense_id": "83e3dd7b-2c36-347a-87c0-7cf7cf514adf",
                                "text": "Стрельцы предложили земским бурмистрам «сместись», то есть сосчитать, затраты денег и труда (в рабочих днях), сделанные военнослужащими и мирскими людьми."
                            }
                        ]
                    }
