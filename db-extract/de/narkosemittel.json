                "senses": [
                    {
                        "sense_id": "c8a81cbf-8034-3faa-8584-72e47e54a14b",
                        "entry_id": "dadf159a-90c7-3245-8bab-7c0e91e51eda",
                        "glosses": [
                            "Substanz, die bei Verabreichung eine Narkose hervorruft; Mittel, das bewusstlos macht und betäubt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce622a7-6610-46ba-bf89-4eb9bec02274",
                                "sense_id": "c8a81cbf-8034-3faa-8584-72e47e54a14b",
                                "text": "Ein altes Narkosemittel ist Chloroform."
                            },
                            {
                                "example_id": "96171f37-39fb-40e3-8b49-bf3399c1b9c9",
                                "sense_id": "c8a81cbf-8034-3faa-8584-72e47e54a14b",
                                "text": "„Die Staatsanwaltschaft Linz ermittelt nun konkret gegen zwei Ärzte eines oberösterreichischen Spitals, die schuld daran sein sollen, dass eine 17-Jährige im künstlichen Tiefschlaf an einem überdosierten Narkosemittel starb.“"
                            },
                            {
                                "example_id": "7277af02-9e5b-4c1b-aa87-8a0d0337f790",
                                "sense_id": "c8a81cbf-8034-3faa-8584-72e47e54a14b",
                                "text": "„Vielleicht betäubte man mich gerade mit Narkosemittel, um mich in den Operationssaal zu schieben und eine verheimlichte Blutung abzusaugen.“"
                            },
                            {
                                "example_id": "23cfd872-a49e-4109-ab58-fc1cba557a52",
                                "sense_id": "c8a81cbf-8034-3faa-8584-72e47e54a14b",
                                "text": "„Das Narkosemittel hatte eine schmerzhafte Verstopfung bewirkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
