                        ],
                        "examples": [
                            {
                                "example_id": "e8975618-8de4-454c-ae16-a827fe2fbbc4",
                                "sense_id": "0587f685-7a75-35ba-b2c3-5f7c6b675110",
                                "text": "De aristocraat woonde in een groot herenhuis in de stad.",
                                "translation": "The aristocrat lived in a grand mansion in the city.",
                                "english": "The aristocrat lived in a grand mansion in the city."
                            },
                            {
                                "example_id": "7bfe4a57-08ba-4f90-8e66-0aac3d0009b1",
                                "sense_id": "0587f685-7a75-35ba-b2c3-5f7c6b675110",
                                "text": "Elke aristocraat had bepaalde privileges in het koninkrijk.",
                                "translation": "Every aristocrat had certain privileges in the kingdom.",
                                "english": "Every aristocrat had certain privileges in the kingdom."
                            },
                            {
                                "example_id": "542ac5ab-5ea3-4ee1-a663-4a8f7f064a4f",
                                "sense_id": "0587f685-7a75-35ba-b2c3-5f7c6b675110",
                                "text": "Hij werd geboren als een simpele boer, maar stierf als een aristocraat.",
                                "translation": "He was born a simple farmer but died an aristocrat.",
                                "english": "He was born a simple farmer but died an aristocrat."
                            }
                        ]
                    },
