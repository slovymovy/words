                "senses": [
                    {
                        "sense_id": "8a3ce237-9010-3ec5-8f52-a10b8bcd9543",
                        "entry_id": "1ffdf68a-b88c-31f7-a2bd-732ef578192d",
                        "glosses": [
                            "Angehöriger der gleichnamigen Bevölkerungsgruppe im Osten Siebenbürgens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b7e412f-cf98-4a92-9196-296056864e7e",
                                "sense_id": "8a3ce237-9010-3ec5-8f52-a10b8bcd9543",
                                "text": "„Vom Mittelalter an verlief im Szeklerland die Grenze des ungarischen Königreichs. Die Szekler wurden von den Königen als Grenzschützer angesiedelt.“"
                            },
                            {
                                "example_id": "348833e7-c314-40c0-a0c0-cd238ad1d002",
                                "sense_id": "8a3ce237-9010-3ec5-8f52-a10b8bcd9543",
                                "text": "„Auch heute noch stellen die Szekler die Bevölkerungsmehrheit in der Region, dem so genannten Szeklerland.“"
                            },
                            {
                                "example_id": "67294cb1-70c8-4b8a-8a45-07f8461ef04e",
                                "sense_id": "8a3ce237-9010-3ec5-8f52-a10b8bcd9543",
                                "text": "„Als die Tataren alles verheerten, zogen sich die Szekler auf die Burg Balvanyos im Haromßeker Lande zurück, vergrößerten sie, stärkten sie durch neue Schutzwälle, und bargen dort ihre Familien und Schätze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
