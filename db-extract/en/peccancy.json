                    {
                        "sense_id": "63eb6f30-31c7-34d3-bcb0-7b9e2612cdcd",
                        "entry_id": "c3958ad1-1217-3282-a60b-caaa00372544",
                        "glosses": [
                            "A sin or moral transgression."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "442d2da7-3711-4f2d-acaf-ae69b40e6e74",
                                "sense_id": "63eb6f30-31c7-34d3-bcb0-7b9e2612cdcd",
                                "text": "[T]his distorting of equivocall words, which passeth commonly for a triviall peccancy, if it be well examined, will be found a very dangerous admission; for me thinks this may be termed a verbal adultery, as it vitiateth and corrupts the property of another, which would have remained innocent without that sollicitation, and therefore seemeth much a souler fault, than a single incontinency of our own words."
                            },
                            {
                                "example_id": "55a115ce-812e-4ab8-8968-b64ef0f4e1de",
                                "sense_id": "63eb6f30-31c7-34d3-bcb0-7b9e2612cdcd",
                                "text": "For it is then as if our tears broke through an inveterate inner dam, and let all sorts of ancient peccancies and moral stagnancies drain away, leaving us now washed and soft of heart and open to every nobler leaning."
                            }
                        ]
                    },
