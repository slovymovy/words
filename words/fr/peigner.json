            "senses": [
                {
                    "sense_id": "d50bc301-1199-3634-9124-9563c90e527d",
                    "sense_definition": "Démêler et arranger les cheveux ou la barbe au moyen d'un peigne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "soin_capillaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle passe plusieurs minutes devant le miroir à se <w>peigner</w> avant de sortir."
                        },
                        {
                            "text": "Il <w>peigne</w> soigneusement sa barbe chaque matin pour rester élégant."
                        }
                    ],
                    "synonyms": [
                        "démêler",
                        "coiffer",
                        "brosser"
                    ],
                    "antonyms": [
                        "décoiffer",
                        "ébouriffer"
                    ],
                    "common_phrases": [
                        "se peigner les cheveux",
                        "peigner la barbe"
                    ]
                },
                {
                    "sense_id": "601a4bf4-180d-3ecb-950b-186806c18cd8",
                    "sense_definition": "Démêler les poils, la crinière ou le pelage d'un animal.",
