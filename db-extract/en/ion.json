                    {
                        "translation_id": "4bdfd0a5-7392-4d10-8e83-033989bf51ca",
                        "source_entry_id": "39252cc8-7a2c-3074-86f7-c5500fd6fd7b",
                        "source_sense_id": "8022cc5d-74b3-351c-a95c-c1f5af519eb3",
                        "source_sense_description": "atom or group of atoms bearing an electrical charge",
                        "target_lang_word": "ио́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ио́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                        "entry_id": "d13b4ead-8c55-3dd7-99fd-ea5d6f31f16e",
                                        "glosses": [
                                            "хим., эл.-техн. электрически заряженная частица (атом, молекула), образующаяся в результате потери или присоединения одного или нескольких электронов атомами или молекулами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ad5922d-7b76-41d0-8c4d-a60dd075bf7c",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                                "text": "«Нейтральные» планетки ― газовые молекулы, ― утратив электрон, становились «позитивным ионом»."
                                            },
                                            {
                                                "example_id": "3ff3bf9d-82b1-461a-b727-59981c2c546d",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                                "text": "Испускаемые радием альфа-частицы оказались положительно заряженными ионами гелия."
                                            },
                                            {
                                                "example_id": "2b1fb302-0b73-42ae-b888-891a4f6ee880",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                                "text": "Ионы газа, ударяясь о катод, также выбивают дополнительные электроны."
                                            },
                                            {
                                                "example_id": "d80ff281-7b2c-48b6-acff-3c3d4cdcb00e",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                                "text": "Под действием постоянного тока ионы «расходятся» в противоположные стороны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
