        "fr-extract.jsonl": [
            {
                "entry_id": "b77d188f-55e6-3b11-ac61-cec3fb7d1141",
                "word": "cafardeux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "619127e0-2701-4f4b-b871-e2fbe37e6957",
                        "entry_id": "b77d188f-55e6-3b11-ac61-cec3fb7d1141",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "cafardeuse"
                    },
                    {
                        "form_id": "476abe81-f568-4dec-a222-7ad2cbf988f3",
                        "entry_id": "b77d188f-55e6-3b11-ac61-cec3fb7d1141",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "cafardeuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd44b410-4779-3b36-b05f-a0c3e631d27c",
                        "entry_id": "b77d188f-55e6-3b11-ac61-cec3fb7d1141",
                        "glosses": [
                            "Qui est sujet au cafard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a77efd5-f1e1-4ee6-8d95-1df25d018c33",
                                "sense_id": "bd44b410-4779-3b36-b05f-a0c3e631d27c",
                                "text": "Je me suis senti cafardeux tout cette semaine."
                            },
                            {
                                "example_id": "0a8263f8-6c0c-43a8-8970-b34aba996572",
                                "sense_id": "bd44b410-4779-3b36-b05f-a0c3e631d27c",
                                "text": "« Il paraît que vous mangez trop peu ? – Cet été j’étais cafardeuse. Je n’avais pas le courage de manger. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "93819091-3bac-304f-a506-ebb141f82fa6",
                        "entry_id": "b77d188f-55e6-3b11-ac61-cec3fb7d1141",
                        "glosses": [
                            "Qui suscite le cafard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed25e6ff-f5ae-457e-a9f4-bd6cffde5a85",
                                "sense_id": "93819091-3bac-304f-a506-ebb141f82fa6",
                                "text": "Elle vivait chichement dans neuf mètres carrés\nUn meublé cafardeux dans un quartier paumé,\nLui, il avait vingt ans et faisait son sapin\nDans la plate Sologne, près de Romorantin."
                            },
                            {
                                "example_id": "b04cd6b1-d7b1-44d8-bb47-6c83048a4dc0",
                                "sense_id": "93819091-3bac-304f-a506-ebb141f82fa6",
                                "text": "Si ma prose parle en rimes,\nC'est pour la difficulté\nDe mettre les mots ensemble\nSur le ton du quotidien\nSans que la syntaxe semble\nNouée de ces nœuds gordiens\nPar quoi le sens s'embellit de\nCafardeuse étrangeté…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b6d698d-7e1d-428c-a698-ba0cb10b173b",
                        "source_entry_id": "b77d188f-55e6-3b11-ac61-cec3fb7d1141",
                        "source_sense_description": "À trier selon le sens…",
                        "target_lang_word": "trübsinnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trübsinnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b5dbe3e-2777-37b0-a089-d7225fadd11e",
                                        "entry_id": "160be4dc-47e1-3187-b6bb-3ea5ab6600cf",
