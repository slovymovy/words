                "senses": [
                    {
                        "sense_id": "acbfe2c1-93ea-3c1f-9d57-8d1ac469911b",
                        "entry_id": "2b2cc984-3f5c-3be3-9b90-f23eeeed6551",
                        "glosses": [
                            "Donner un caractère sexologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b5ef42-b15c-4d15-997f-72280e1d86f3",
                                "sense_id": "acbfe2c1-93ea-3c1f-9d57-8d1ac469911b",
                                "text": "Ceci conduit de plus en plus de Médecins, non sexologues, à «sexologiser» leur culture médicale."
                            },
                            {
                                "example_id": "dfc5a437-b934-482e-8c0d-ea630c358957",
                                "sense_id": "acbfe2c1-93ea-3c1f-9d57-8d1ac469911b",
                                "text": "Mais l'originalité et l'efficacité de la thérapie sexofonctionnelle est de « sexologiser » la sexologie !"
                            },
                            {
                                "example_id": "8e87518c-b7a8-4a09-a7ca-ef34e21dc0dd",
                                "sense_id": "acbfe2c1-93ea-3c1f-9d57-8d1ac469911b",
                                "text": "Cessez de sexologiser tout comportement, cessez de toujours ramener à la sexualité active dans chaque acte de la vie."
                            }
                        ]
                    }
