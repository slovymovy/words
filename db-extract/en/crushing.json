                                            {
                                                "example_id": "7c9b822e-8a31-43b6-80ab-cb9f420faf65",
                                                "sense_id": "a03d02e4-c895-3878-915a-0c20d90d39e7",
                                                "text": "Une charge écrasante."
                                            },
                                            {
                                                "example_id": "e6c3bd80-014a-4a6c-809f-ce0753147488",
                                                "sense_id": "a03d02e4-c895-3878-915a-0c20d90d39e7",
                                                "text": "— Une preuve écrasante. - Le poids écrasant des affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21006b2f-05d7-3131-80a5-5a0ff7915bb9",
                                        "entry_id": "61bfb32c-e1de-3777-a2d4-167d590029fb",
                                        "glosses": [
                                            "Qualifie des forces militaires contre lesquelles tout effort est impuissant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33776f22-7088-4726-a769-d54008d63cca",
                                                "sense_id": "21006b2f-05d7-3131-80a5-5a0ff7915bb9",
                                                "text": "La supériorité militaire écrasante de l’hyperpuissance américaine lui permet certes d’organiser ses expéditions sans l’aide de personne. Mais ces opérations punitives ne peuvent fonder un nouvel ordre du monde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écrasant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f9d62f-00c5-3eba-8102-f6611bc745d4",
                                        "entry_id": "1afe1e89-1634-3064-a4eb-ad0c4d285348",
                                        "glosses": [
                                            "Participe présent de écraser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27dd57d-759b-43ec-89fc-926c7fbfd11b",
                                                "sense_id": "d2f9d62f-00c5-3eba-8102-f6611bc745d4",
                                                "text": "Oui, je me suis laissée tomber ainsi qu’un paquet, lui écrasant les jambes de tout mon poids, pour qu’il ne les remuât plus."
                                            },
                                            {
                                                "example_id": "fb46c2f8-c0e3-46ee-877c-fa16d2b5ac57",
                                                "sense_id": "d2f9d62f-00c5-3eba-8102-f6611bc745d4",
                                                "text": "Il pesa de tout son poids sur le bambou, le plus fort qu’il le pût, écrasant la trachée du Yab."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
