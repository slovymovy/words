                            {
                                "example_id": "b74705ae-b544-4932-b7c0-2293a60374e3",
                                "sense_id": "9d1b1b4b-7def-35d5-aab6-d948179a5157",
                                "text": "Passe voir un peu le kilbus, Vingt Centimes. Il lui désignait le litre de vin hors de portée de sa main."
                            },
                            {
                                "example_id": "61da6b10-cd6a-4c72-b312-3cb6cb362105",
                                "sense_id": "9d1b1b4b-7def-35d5-aab6-d948179a5157",
                                "text": "Ils refourguaient les kilbus en faisant la culbute pour se dédommager de leurs six bornes à travers champs et des risques de se faire bordurer du crachatorium."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d98f10f-8150-303b-8f6d-5080938df222",
                        "entry_id": "5b0a00b8-df47-36a3-9da2-5e5c77c2909b",
                        "glosses": [
