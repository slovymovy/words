                ],
                "translations": [
                    {
                        "translation_id": "5188bbdb-ae9f-4e16-a477-017064f5f7ac",
                        "source_entry_id": "205a4428-cee8-3f5b-987d-acfff27c279b",
                        "source_sense_id": "c5db83c1-b3ad-3e50-b6dd-a421e5356532",
                        "target_lang_word": "beach",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55ec4fbb-c826-38fb-a069-1714723380b5",
                                        "entry_id": "62265652-d016-3336-a2e1-0385fceecad0",
                                        "glosses": [
                                            "The shore of a body of water, especially when sandy or pebbly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd355f97-c1e3-4b19-aa98-f9eeab069549",
                                                "sense_id": "55ec4fbb-c826-38fb-a069-1714723380b5",
                                                "text": "Pretty soon I struck into a sort of path[…]. It twisted and turned,[…]and opened out into a big clear space like a lawn. And, back of the lawn, was a big, old-fashioned house, with piazzas stretching in front of it, and all blazing with lights. 'Twas the house I'd seen the roof of from the beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36452ea4-ccb4-386a-aa35-0d53675e0aa5",
                                        "entry_id": "62265652-d016-3336-a2e1-0385fceecad0",
                                        "glosses": [
                                            "A horizontal strip of land, usually sandy, adjoining water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f416a3d-f3ce-4421-8ccf-d8046d094ba3",
                                                "sense_id": "36452ea4-ccb4-386a-aa35-0d53675e0aa5",
                                                "text": "Up and down, the beach lay empty for miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de22f0ec-ddba-322e-ae06-5b269a777a53",
                                        "entry_id": "62265652-d016-3336-a2e1-0385fceecad0",
                                        "glosses": [
                                            "The loose pebbles of the seashore, especially worn by waves; shingle."
                                        ],
                                        "tags": [
                                            "Kent",
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "245ba9ef-9725-3bc6-9083-cd81aac29be5",
                                        "entry_id": "62265652-d016-3336-a2e1-0385fceecad0",
                                        "glosses": [
                                            "Synonym of gravel trap."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd407cb0-14c2-3b1f-beab-230db6325ca2",
                                        "entry_id": "62265652-d016-3336-a2e1-0385fceecad0",
                                        "glosses": [
                                            "A dry, dusty pitch or situation, as though playing on sand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a89755c8-130d-4ded-8845-b5ee28e75275",
                                                "sense_id": "bd407cb0-14c2-3b1f-beab-230db6325ca2",
                                                "text": "I never realised Lincoln was a seaside town. BRIAN LAWS Scunthorpe manager, after losing on a liberally sanded beach of a pitch"
                                            },
                                            {
                                                "example_id": "89fa73d5-e882-428c-932c-77dfc63af3cd",
                                                "sense_id": "bd407cb0-14c2-3b1f-beab-230db6325ca2",
                                                "text": "The series was brought to an ironic conclusion when England became hoist by their own petard, as they lost the deciding final Test on a 'beach' of a wicket. Neither side batted well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd9e01d-dd4f-3f59-9548-967c4cdfd190",
                                        "entry_id": "62265652-d016-3336-a2e1-0385fceecad0",
                                        "glosses": [
                                            "Euphemistic form of bitch (taboo swear word)."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c94c817c-82df-47d2-aa97-95757b7f2592",
                                                "sense_id": "1bd9e01d-dd4f-3f59-9548-967c4cdfd190",
                                                "text": "That beach should be punished!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7094671-dede-3082-92d1-e7f8e3fd1e08",
                                        "entry_id": "100d5559-f7e8-3a11-85ad-3dddfe2f2e0f",
                                        "glosses": [
                                            "To run aground on a beach."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eba8cb5a-5aa3-4206-aaae-9147cfd3ae01",
                                                "sense_id": "b7094671-dede-3082-92d1-e7f8e3fd1e08",
                                                "text": "When we finally beached, the land was scarcely less wet than the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c84d1cc-bccb-35f0-b5be-b9e203f081df",
                                        "entry_id": "100d5559-f7e8-3a11-85ad-3dddfe2f2e0f",
                                        "glosses": [
                                            "To run (something) aground on a beach."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac5ae95-9e68-4ea0-8b55-c946629a20fe",
                                                "sense_id": "3c84d1cc-bccb-35f0-b5be-b9e203f081df",
                                                "text": "It seems that some honest mariners of Dover, or Sandwich, or some one of the Cinque Ports, had after a hard chase succeeded in killing and beaching a fine whale which they had originally descried afar off from the shore."
                                            },
                                            {
                                                "example_id": "f662dda2-be0b-49f6-92e2-fc4c33dca084",
                                                "sense_id": "3c84d1cc-bccb-35f0-b5be-b9e203f081df",
                                                "text": "Great Aías led twelve ships from Sálamis\nand beached them where Athenians formed for battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f162cd61-cfa5-3934-a5c8-68a12a0ac0d7",
                                        "entry_id": "100d5559-f7e8-3a11-85ad-3dddfe2f2e0f",
                                        "glosses": [
                                            "To run into an obstacle or rough or soft ground, so that the floor of the vehicle rests on the ground and the wheels cannot gain traction."
                                        ],
                                        "tags": [
                                            "of a vehicle"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
