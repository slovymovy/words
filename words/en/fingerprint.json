{
    "word_family": [
        "fingerprinting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9fd16da-5a4c-3c23-adf8-873a83eb464b",
                    "sense_definition": "The patterns left on surfaces where uncovered fingertips have touched, especially as used to identify the person who touched the surface.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "biometric_identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective carefully searched the glass for any visible <w>fingerprints</w>.",
                            "target_lang_translations": {
                                "ru": "Детектив внимательно осмотрел стакан в поисках видимых <w>отпечатков пальцев</w>."
                            }
                        },
                        {
                            "text": "He tried to <w>leave</w> <w>fingerprints</w> on the handle to prove he had been there.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>оставить</w> <w>отпечатки</w> на ручке, чтобы доказать, что он там был."
                            }
                        }
                    ],
                    "synonyms": [
                        "finger mark"
                    ],
                    "common_phrases": [
                        "leave fingerprints",
                        "latent fingerprints",
                        "dust for fingerprints"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следы, оставляемые на поверхностях при прикосновении кончиков пальцев, используемые для идентификации личности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечатки пальцев",
                                "target_lang_sense_clarification": "множественное число, следы на поверхности"
                            },
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "след от надавливания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f935a43-a5c2-3afe-9e74-20d178dddd02",
                    "sense_definition": "The natural pattern of ridges on the tips of human fingers, unique to each individual.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biometric_identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every human being has a unique <w>fingerprint</w> that never changes over time.",
                            "target_lang_translations": {
                                "ru": "У каждого человека есть уникальный <w>отпечаток пальца</w>, который не меняется со временем."
                            }
                        },
                        {
                            "text": "Modern smartphones use a <w>fingerprint</w> <w>scanner</w> to unlock the device securely.",
                            "target_lang_translations": {
                                "ru": "Современные смартфоны используют <w>сканер</w> <w>отпечатков</w> для безопасной разблокировки устройства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fingerprint scanner",
                        "unique fingerprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уникальный для каждого человека кожный узор на кончиках пальцев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечаток пальца",
                                "target_lang_sense_clarification": "биологический узор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6785b726-0cc5-3d70-a592-17dcd9773503",
                    "sense_definition": "A unique combination of features that serves as an identification of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unique_identifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists can identify the source of the oil spill by its chemical <w>fingerprint</w>.",
                            "target_lang_translations": {
                                "ru": "Ученые могут определить источник разлива нефти по его химическому <w>отпечатку</w>."
                            }
                        },
                        {
                            "text": "The <w>digital</w> <w>fingerprint</w> of the file ensures that it has not been altered.",
                            "target_lang_translations": {
                                "ru": "<w>Цифровой</w> <w>отпечаток</w> файла гарантирует, что он не был изменен."
                            }
                        }
                    ],
                    "synonyms": [
                        "signature",
                        "profile"
                    ],
                    "common_phrases": [
                        "digital fingerprint",
                        "chemical fingerprint",
                        "acoustic fingerprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уникальное сочетание характеристик, служащее для идентификации чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "уникальный идентификатор"
                            },
                            {
                                "target_lang_word": "сигнатура",
                                "target_lang_sense_clarification": "характерный признак"
                            },
                            {
                                "target_lang_word": "профиль",
                                "target_lang_sense_clarification": "совокупность данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b579cf7-185c-3ca9-b644-82c0cc0a28e5",
                    "sense_definition": "A trace that gives evidence of someone's involvement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unique_identifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect's <w>fingerprint</w> is visible in every detail of the building's design.",
                            "target_lang_translations": {
                                "ru": "<w>Отпечаток</w> стиля архитектора виден в каждой детали дизайна здания."
                            }
                        },
                        {
                            "text": "Critics argued that the <w>fingerprint</w> <w>of</w> the government was all over the new policy.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что <w>след</w> правительства отчетливо виден в новой политике."
                            }
                        }
                    ],
                    "synonyms": [
                        "mark",
                        "trace"
                    ],
                    "common_phrases": [
                        "fingerprint of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used metaphorically to describe influence or presence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "След или признак, свидетельствующий о чьем-либо участии или влиянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "результат влияния"
                            },
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "признак присутствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3769b12e-6ffd-31df-81bc-4a923732cf6d",
                    "sense_definition": "A unique identification for a public key in asymmetric cryptography.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unique_identifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should verify the <w>key</w> <w>fingerprint</w> before trusting the encrypted connection.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить <w>отпечаток</w> <w>ключа</w>, прежде чем доверять зашифрованному соединению."
                            }
                        },
                        {
                            "text": "The software displays a hexadecimal <w>fingerprint</w> to represent the long security key.",
                            "target_lang_translations": {
                                "ru": "Программа отображает шестнадцатеричный <w>отпечаток</w> для представления длинного ключа безопасности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "key fingerprint",
                        "public key fingerprint"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical term in computing and cryptography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уникальный идентификатор открытого ключа в асимметричном шифровании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечаток ключа",
                                "target_lang_sense_clarification": "криптографический термин"
                            },
                            {
                                "target_lang_word": "фингерпринт",
                                "target_lang_sense_clarification": "технический жаргон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d69528bf-d193-39e3-bf39-1eb98ab3248d",
                    "sense_definition": "To take somebody's fingerprints.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "identification_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police will <w>fingerprint</w> the suspect as part of the booking process.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>снимет отпечатки пальцев</w> у подозреваемого в рамках процедуры оформления."
                            }
                        },
                        {
                            "text": "It is standard procedure to <w>fingerprint</w> <w>inmates</w> when they arrive at the facility.",
                            "target_lang_translations": {
                                "ru": "Это стандартная процедура — <w>дактилоскопировать</w> <w>заключенных</w> по прибытии в учреждение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fingerprint inmates",
                        "fingerprint a suspect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снимать у кого-либо отпечатки пальцев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать отпечатки пальцев",
                                "target_lang_sense_clarification": "процесс идентификации"
                            },
                            {
                                "target_lang_word": "дактилоскопировать",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3816c63e-f299-3677-8631-8f385b2a0123",
                    "sense_definition": "To identify something uniquely by a combination of measurements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "identification_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers are working to <w>fingerprint</w> <w>DNA</w> samples from various plant species.",
                            "target_lang_translations": {
                                "ru": "Исследователи работают над тем, чтобы <w>идентифицировать</w> образцы <w>ДНК</w> различных видов растений."
                            }
                        },
                        {
                            "text": "The lab was able to <w>fingerprint</w> the substance using advanced mass spectrometry.",
                            "target_lang_translations": {
                                "ru": "Лаборатория смогла <w>определить характеристики</w> вещества с помощью современной масс-спектрометрии."
                            }
                        }
                    ],
                    "synonyms": [
                        "identify",
                        "characterize"
                    ],
                    "common_phrases": [
                        "fingerprint DNA"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Scientific or technical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уникально идентифицировать объект с помощью набора измерений или характеристик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идентифицировать",
                                "target_lang_sense_clarification": "по уникальным признакам"
                            },
                            {
                                "target_lang_word": "составлять профиль",
                                "target_lang_sense_clarification": "на основе данных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}