                        "entry_id": "15b833b0-fbd7-39f8-aafb-a3402f56fb27",
                        "glosses": [
                            "Boire de petites quantités, mais fréquemment."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b4585200-1551-33af-845d-c8ae409b6465",
                        "entry_id": "15b833b0-fbd7-39f8-aafb-a3402f56fb27",
                        "glosses": [
                            "Aimer à faire bombance, ripaille."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6bcbd37c-8bad-4b37-a013-74a16beba028",
                                "sense_id": "b4585200-1551-33af-845d-c8ae409b6465",
                                "text": "Il y a aussi ceux qui ont gobelotté tandis qu'ils étaient jeunes, laissant leurs enfants vagabonder et prendre de mauvaise habitudes."
                            },
                            {
                                "example_id": "ca16855b-e2d4-4f06-b777-73b78aed4fbf",
                                "sense_id": "b4585200-1551-33af-845d-c8ae409b6465",
                                "text": "Ils gobelottaient par groupes, avec leurs compagnes débraillées, à quelques pas du catafalque, sous l’œil bienveillant des gardiens de la paix."
                            }
                        ]
                    }
