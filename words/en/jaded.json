{
    "word_family": [
        "jade"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f654855-31e0-347f-bf53-6e79942ebdbc",
                    "sense_definition": "Bored or lacking enthusiasm due to having experienced too much of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boredom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of traveling, the <w>jaded</w> tourist no longer felt excited by new cities.",
                            "target_lang_translations": {
                                "cs": "Po letech cestování už <w>přesycený</w> turista necítil nadšení z nových měst.",
                                "ru": "После многих лет путешествий <w>пресыщенный</w> турист больше не испытывал восторга от новых городов."
                            }
                        },
                        {
                            "text": "The <w>jaded</w> audience was unimpressed by the magician's repetitive tricks.",
                            "target_lang_translations": {
                                "cs": "<w>Otupělé</w> publikum nebylo ohromeno kouzelníkovými opakujícími se triky.",
                                "ru": "<w>Пресыщенная</w> публика осталась равнодушна к повторяющимся трюкам фокусника."
                            }
                        }
                    ],
                    "synonyms": [
                        "blasé",
                        "world-weary"
                    ],
                    "common_phrases": [
                        "jaded outlook",
                        "jaded perspective"
                    ],
                    "target_lang_definitions": {
                        "cs": "Znuděný nebo postrádající nadšení kvůli tomu, že něčeho zažil příliš mnoho.",
                        "ru": "Испытывающий скуку или утративший энтузиазм из-за избытка впечатлений или пресыщения чем-либо."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přesycený",
                                "target_lang_sense_clarification": "pocit nasycení zážitky vedoucí k nudě"
                            },
                            {
                                "target_lang_word": "otupělý",
                                "target_lang_sense_clarification": "ztráta citlivosti nebo zájmu v důsledku opakování"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пресыщенный",
                                "target_lang_sense_clarification": "утративший интерес и восторг из-за избытка впечатлений"
                            },
                            {
                                "target_lang_word": "пресытившийся",
                                "target_lang_sense_clarification": "сытый чем-либо по горло, утративший энтузиазм"
                            },
                            {
                                "target_lang_word": "притупившийся",
                                "target_lang_sense_clarification": "с ослабленным восприятием или эмоциями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f63ab31-9dc2-3366-9266-ca21d54a46eb",
                    "sense_definition": "Feeling physically or mentally exhausted and worn out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhaustion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jaded</w> athlete finally collapsed after the long marathon.",
                            "target_lang_translations": {
                                "cs": "<w>Vyčerpaný</w> sportovec po dlouhém maratonu konečně zkolaboval.",
                                "ru": "<w>Обессиленный</w> атлет наконец упал без сил после длинного марафона."
                            }
                        },
                        {
                            "text": "She felt <w>jaded</w> after working a double shift at the hospital.",
                            "target_lang_translations": {
                                "cs": "Po dvanáctihodinové směně v nemocnici se cítila <w>znavená</w>.",
                                "ru": "Она чувствовала себя совершенно <w>изнурённой</w> после двойной смены в больнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhausted",
                        "fatigued",
                        "weary"
                    ],
                    "common_phrases": [
                        "jaded traveler"
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzicky nebo duševně vyčerpaný a unavený.",
                        "ru": "Физически или эмоционально истощённый, изнурённый тяжёлым трудом или нагрузкой."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyčerpaný",
                                "target_lang_sense_clarification": "celková únava po námaze"
                            },
                            {
                                "target_lang_word": "znavený",
                                "target_lang_sense_clarification": "pocit únavy po dlouhém úsilí"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "изнурённый",
                                "target_lang_sense_clarification": "доведённый до крайнего утомления"
                            },
                            {
                                "target_lang_word": "измученный",
                                "target_lang_sense_clarification": "сильно уставший от нагрузки или напряжения"
                            },
                            {
                                "target_lang_word": "обессиленный",
                                "target_lang_sense_clarification": "полностью лишившийся сил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7f43448-d840-3fb0-97ff-e24c4b5ecd29",
                    "sense_definition": "Becoming cynical or insensitive as a result of past experiences.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cynicism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of working in politics left him <w>jaded</w> about the possibility of real change.",
                            "target_lang_translations": {
                                "cs": "Léta práce v politice ho učinila <w>cynickým</w> ohledně možnosti skutečné změny.",
                                "ru": "Годы работы в политике сделали его <w>циничным</w> в отношении возможности реальных перемен."
                            }
                        },
                        {
                            "text": "The detective had become <w>jaded</w> by the constant exposure to crime.",
                            "target_lang_translations": {
                                "cs": "Detektiv se kvůli neustálému kontaktu se zločinem stal <w>otupělým</w>.",
                                "ru": "Из-за постоянного столкновения с преступностью детектив совсем <w>очерствел</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cynical"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stát se cynickým nebo necitlivým v důsledku minulých zkušeností.",
                        "ru": "Ставший циничным, недоверчивым или черствым под влиянием пережитого жизненного опыта."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cynický",
                                "target_lang_sense_clarification": "ztráta víry v dobré úmysly"
                            },
                            {
                                "target_lang_word": "skeptický",
                                "target_lang_sense_clarification": "nedůvěřivý k možnostem změny"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "циничный",
                                "target_lang_sense_clarification": "утративший веру в искренность и идеалы"
                            },
                            {
                                "target_lang_word": "разочарованный",
                                "target_lang_sense_clarification": "потерявший оптимизм из-за негативного опыта"
                            },
                            {
                                "target_lang_word": "очерствевший",
                                "target_lang_sense_clarification": "ставший равнодушным и нечувствительным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6aaa13ec-f7db-38f1-9ebe-9023609bbfc2",
                    "sense_definition": "Past tense and past participle of <w>jade</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exhaustion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long journey <w>jaded</w> the horses.",
                            "target_lang_translations": {
                                "cs": "Dlouhá cesta koně <w>vyčerpala</w>.",
                                "ru": "Долгий путь <w>изнурил</w> лошадей."
                            }
                        },
                        {
                            "text": "The constant noise <w>jaded</w> his spirit.",
                            "target_lang_translations": {
                                "cs": "Neustálý hluk <w>unavil</w> jeho ducha.",
                                "ru": "Постоянный шум <w>утомил</w> его душу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa 'jade' (unavit, vyčerpat).",
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола «jade» (изнурять, утомлять, пресыщать)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "unavil",
                                "target_lang_sense_clarification": "způsobil únavu"
                            },
                            {
                                "target_lang_word": "vyčerpal",
                                "target_lang_sense_clarification": "zbavil sil"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "изнурил",
                                "target_lang_sense_clarification": "довёл до истощения сил"
                            },
                            {
                                "target_lang_word": "утомил",
                                "target_lang_sense_clarification": "вызвал сильную усталость"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}