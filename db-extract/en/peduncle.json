                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6c95e8-6bb2-47c1-8959-184867c52397",
                                                "sense_id": "df69e926-a782-3cdf-a1c4-6ab3558970ab",
                                                "text": "Der Stiel der Gardenie hat einen Knick bekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c37555fc-e55a-3643-8230-b5c270e27f7f",
                                        "entry_id": "4e99be8a-4ebd-3b3e-974a-f47c4d455655",
