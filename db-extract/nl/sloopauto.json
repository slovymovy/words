                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c61c07-64f8-4e66-b18d-6021bac8cfff",
                                                "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                                "text": "He wandered away from his study group toward the computer lab where he saw that his friend Gary Partoyan—a former squid but not a total car wreck of an individual—had been cast off as well."
                                            },
                                            {
                                                "example_id": "51020ee1-c4a0-4532-ab75-56d71d5d1990",
                                                "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                                "text": "For me, each performance was a car wreck. At the end of each one I had no clear memory of what had happened."
                                            },
                                            {
                                                "example_id": "96ce9ad2-a50c-4a1b-ba6f-5524c06809b3",
                                                "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                                "text": "Her life was a total car wreck with no one there to help her fix it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
