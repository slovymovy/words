                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "689f7cf6-9904-41e9-97d4-14865c731bb9",
                                "sense_id": "8915a108-07df-3b07-ac0b-2949607e70a5",
                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                            }
                        ]
                    },
                    {
                        "sense_id": "68178c3c-2ac9-3998-83ce-532ef1b79253",
