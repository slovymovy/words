                    {
                        "translation_id": "16c43daa-d447-4149-b803-c46880be50a1",
                        "source_entry_id": "d7d95b94-5c25-34f5-a888-eda957d25a72",
                        "source_sense_id": "167fe235-5198-350d-a16e-a60bd1a561d7",
                        "source_sense_description": "Gesamtheit der langen Kopfhaare eines männlichen Löwen",
                        "target_lang_word": "crinière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crinière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "133b7f55-62de-3dee-9b75-31191fe1bfcc",
                                        "entry_id": "7a52aedf-c087-38c8-8742-7ba793c7fcc4",
                                        "glosses": [
                                            "Ensemble des crins qui garnissent le cou de certains animaux, comme le cheval ou le lion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0965556-20b4-4cdf-9fc4-36ec655bfd5f",
                                                "sense_id": "133b7f55-62de-3dee-9b75-31191fe1bfcc",
                                                "text": "C’est un étalon barbe, pas grand, mais bien formé et bien musclé, un alezan étoile de blanc au front, dont la robe dorée, la queue et la crinière blondes, longues et fournies, reluisent au soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507baab4-879c-3c7e-8fa3-0a8b42df619e",
                                        "entry_id": "7a52aedf-c087-38c8-8742-7ba793c7fcc4",
                                        "glosses": [
                                            "Amas de poils sur certains animaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b19235a-2215-482b-b8ad-1285d8dfa353",
                                                "sense_id": "507baab4-879c-3c7e-8fa3-0a8b42df619e",
                                                "text": "Quelques soies, prothoraciques et des premiers segments tergaux, sont semi-érigées, sans pour autant que l’on puise parler de “crinière”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d80782e2-4adc-3035-ab97-e8da95d3cf5f",
                                        "entry_id": "7a52aedf-c087-38c8-8742-7ba793c7fcc4",
                                        "glosses": [
                                            "Touffe de crins tombante qui garnit le cimier d’un casque et flotte par-derrière."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0c39ada-8bf5-3a29-a744-176fca1b044c",
                                        "entry_id": "7a52aedf-c087-38c8-8742-7ba793c7fcc4",
                                        "glosses": [
                                            "Chevelure abondante."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0f964c-fccb-4bfd-a0ac-738c0d1ff2ee",
                                                "sense_id": "c0c39ada-8bf5-3a29-a744-176fca1b044c",
                                                "text": "C’était un vieux sculpteur à crinière blanche, qui avait donné des leçons à la dame, au temps où elle sculptait."
                                            },
                                            {
                                                "example_id": "20ccfc58-2f18-40e9-b336-e14b906d2a70",
                                                "sense_id": "c0c39ada-8bf5-3a29-a744-176fca1b044c",
                                                "text": "Mais Françoise ne l'écoutait plus, elle avait sorti le grand jeu : crinière rejetée en arrière, regard de serial fuckeuse, et doigt tapotant négligemment une joue fardée à la truelle."
                                            },
                                            {
                                                "example_id": "6b0e5c1c-dc2a-4aac-8af3-8f6273ecd7d3",
                                                "sense_id": "c0c39ada-8bf5-3a29-a744-176fca1b044c",
                                                "text": "Une crinière poivre et sel lui couvrait les oreilles et lui mangeait le front."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crinière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2446f003-a7a0-3729-b69b-f8ef5a5a5976",
                                        "entry_id": "f4cdbf73-5bec-35f0-81e3-8b79e07bb709",
                                        "glosses": [
                                            "Femme qui travaille, qui apprête le crin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
