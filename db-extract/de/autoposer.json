                "senses": [
                    {
                        "sense_id": "eaf24a31-3308-33c4-a664-fcf7103d9e4a",
                        "entry_id": "6d9a8e8d-37e5-3dd6-8dca-c032c2c3fe75",
                        "glosses": [
                            "Person, die im Stadtverkehr auffallend prahlerisch mit einem leistungsstarken oder unzulässig getunten Auto unnötig Runden dreht und eine erhebliche Lärmbelästigung verursacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf83a06-7be8-4368-83d5-6fe0d61b74a9",
                                "sense_id": "eaf24a31-3308-33c4-a664-fcf7103d9e4a",
                                "text": "„Als Autoposer werden grundsätzlich Menschen bezeichnet, die mit ihren Fahrzeugen auffallen wollen.“"
                            },
                            {
                                "example_id": "5ddfd4b6-c5d8-4a40-9bd1-590fc96813f4",
                                "sense_id": "eaf24a31-3308-33c4-a664-fcf7103d9e4a",
                                "text": "„Gemäss Wirz sei die Wortkreation ‚Autoposer‘ durch einen Verkehrspolizisten aus Winterthur entstanden. Der Polizist habe ‚nach einem treffenden Wort im Netz gegoogelt‘ und sei in Deutschland fündig geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
