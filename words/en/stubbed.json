{
    "word_family": [
        "stub",
        "stubby"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e244a7d6-d7b8-383b-978d-164a8551d286",
                    "sense_definition": "Short and thick, like something truncated; blunt; obtuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a <w>stubbed</w> pencil to create bold lines.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>обрубленный</w> карандаш, чтобы создавать жирные линии."
                            }
                        },
                        {
                            "text": "He had <w>stubbed</w> fingers that were not suited for delicate work.",
                            "target_lang_translations": {
                                "ru": "У него были <w>коренастые</w> пальцы, которые не подходили для тонкой работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunt",
                        "stumpy"
                    ],
                    "antonyms": [
                        "pointed",
                        "sharp"
                    ],
                    "common_phrases": [
                        "stubbed fingers",
                        "stubbed pencil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий и толстый, обрубленный; тупой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрубленный",
                                "target_lang_sense_clarification": "о предмете, который выглядит укороченным"
                            },
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "о форме предмета, не имеющего острого кончика"
                            },
                            {
                                "target_lang_word": "коренастый",
                                "target_lang_sense_clarification": "о пальцах или конечностях, которые выглядят короткими и толстыми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0235b00e-1042-3f21-9295-9e386dcce5e3",
                    "sense_definition": "Abounding in stubs; stubby.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiker struggled across the <w>stubbed</w> field where trees had been cut down.",
                            "target_lang_translations": {
                                "ru": "Туристу было трудно идти по <w>покрытому пнями</w> полю, где были вырублены деревья."
                            }
                        },
                        {
                            "text": "Walking through the <w>stubbed</w> ground was difficult after the harvest.",
                            "target_lang_translations": {
                                "ru": "Ходить по <w>стерневому</w> полю после жатвы было тяжело."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stubbed ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый пнями или остатками стеблей после вырубки или жатвы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрытый пнями",
                                "target_lang_sense_clarification": "о местности, где остались пни после вырубки деревьев"
                            },
                            {
                                "target_lang_word": "стерневой",
                                "target_lang_sense_clarification": "о поле, покрытом остатками стеблей злаков после жатвы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bb2694b-7cd9-368f-9302-4335f1b7d2c6",
                    "sense_definition": "Not delicate; hardy, rugged.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pioneers possessed <w>stubbed</w> constitutions capable of enduring harsh winters.",
                            "target_lang_translations": {
                                "ru": "Пионеры обладали <w>выносливым</w> телосложением, способным пережить суровые зимы."
                            }
                        },
                        {
                            "text": "His <w>stubbed</w> nature allowed him to survive in the wilderness.",
                            "target_lang_translations": {
                                "ru": "Его <w>суровый</w> характер позволил ему выжить в дикой природе."
                            }
                        }
                    ],
                    "synonyms": [
                        "rugged",
                        "hardy"
                    ],
                    "antonyms": [
                        "delicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не утонченный; выносливый, суровый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выносливый",
                                "target_lang_sense_clarification": "о человеке, способном переносить трудности"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о характере, закаленном тяжелыми условиями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0baff664-b00b-3d35-b828-5a22b2dfef87",
                    "sense_definition": "Simple past and past participle of <w>stub</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>stubbed</w> my toe on the heavy wooden chair.",
                            "target_lang_translations": {
                                "ru": "Я <w>ударился</w> пальцем ноги о тяжелый деревянный стул."
                            }
                        },
                        {
                            "text": "He had <w>stubbed</w> out his cigarette before entering the building.",
                            "target_lang_translations": {
                                "ru": "Он <w>потушил</w> сигарету перед тем, как войти в здание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stubbed toe",
                        "stubbed out"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола «удариться» (обычно пальцем ноги) или «потушить» (сигарету)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударился",
                                "target_lang_sense_clarification": "о случайном ударе пальцем ноги о предмет"
                            },
                            {
                                "target_lang_word": "потушил",
                                "target_lang_sense_clarification": "о процессе тушения сигареты о поверхность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
