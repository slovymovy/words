                "senses": [
                    {
                        "sense_id": "7999d7dd-43e6-3730-b2a8-009dc483654f",
                        "entry_id": "2256cbfa-0bb4-3194-ab47-9dd104a459dc",
                        "glosses": [
                            "lokalisierbarer Platz eines Vorfalls, bei dem Sachen oder Menschen zu schaden kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b56337f-d29f-421f-b649-05b698fa4c6a",
                                "sense_id": "7999d7dd-43e6-3730-b2a8-009dc483654f",
                                "text": "Die Polizei traf zehn Minuten später an der Unfallstelle ein."
                            },
                            {
                                "example_id": "0ce1ca73-928a-4038-b33b-fd991dbac2fa",
                                "sense_id": "7999d7dd-43e6-3730-b2a8-009dc483654f",
                                "text": "„Die unbekannte Beifahrerin war noch an der Unfallstelle ihren Verletzungen erlegen, wie es im üblichen Zeitungsdeutsch hieß.“"
                            },
                            {
                                "example_id": "8e6a9dac-86e4-443b-8321-7667ae88882f",
                                "sense_id": "7999d7dd-43e6-3730-b2a8-009dc483654f",
                                "text": "„Die Polizei erscheint an der Unfallstelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
