                    },
                    {
                        "form_id": "8218a9b3-63ee-4f51-a954-c7e444b03f98",
                        "entry_id": "1e6121b5-2b1e-3dd5-9c60-e42c8f8b4a78",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "efficientes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "032576d6-154c-312d-98f1-a54c68bc5524",
                        "entry_id": "1e6121b5-2b1e-3dd5-9c60-e42c8f8b4a78",
                        "glosses": [
                            "Qui produit un effet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c89e36-cdd7-4f5e-8350-a811e9499e51",
                                "sense_id": "032576d6-154c-312d-98f1-a54c68bc5524",
                                "text": "Cause efficiente, à distinguer de la cause finale, finalité."
                            },
                            {
                                "example_id": "d682081e-5070-493b-bd78-0a1e0dacc725",
                                "sense_id": "032576d6-154c-312d-98f1-a54c68bc5524",
                                "text": "Qui produit certains effets. N’est guère usité que dans cette locut. philosophique : cause efficiente. À la différence de la cause efficace, la cause efficiente se transforme en son effet, en partie ou en totalité, et ne subsiste pas telle qu’elle était auparavant."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7f88091-693b-3701-bd78-33a1931087cf",
                        "entry_id": "1e6121b5-2b1e-3dd5-9c60-e42c8f8b4a78",
                        "glosses": [
                            "Efficace avec un effort réduit, un coût réduit ou une consommation réduite."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "2dac6672-3688-49b8-a9bd-a55215181a26",
                                "sense_id": "b7f88091-693b-3701-bd78-33a1931087cf",
                                "text": "Ce procédé de fabrication est efficient ; nous n’avons rien trouvé de mieux sur le marché pour ce qui est du rendement."
                            },
                            {
                                "example_id": "e6724f42-e2e4-4d23-81b6-73a116cd2df1",
                                "sense_id": "b7f88091-693b-3701-bd78-33a1931087cf",
                                "text": "Ce technicien est efficient : tâchons de le conserver."
                            },
                            {
                                "example_id": "4bcf9c52-109d-4273-a6c2-5d7c3a235e0c",
                                "sense_id": "b7f88091-693b-3701-bd78-33a1931087cf",
                                "text": "Cet employé est efficient : il est donc rentable."
                            },
                            {
                                "example_id": "71e2987f-b42d-497e-9244-d45a8d555051",
                                "sense_id": "b7f88091-693b-3701-bd78-33a1931087cf",
                                "text": "Ce collaborateur est très efficient : il est très productif comme nous le demandons."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c3157fe-7c17-3c2a-9d57-e6239ce0d200",
                        "entry_id": "1e6121b5-2b1e-3dd5-9c60-e42c8f8b4a78",
                        "glosses": [
                            "Efficace (sans nuances)."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "060b663a-8d26-4e59-894b-5b9a207889c0",
                                "sense_id": "5c3157fe-7c17-3c2a-9d57-e6239ce0d200",
                                "text": "Que signifie une telle attitude en politique ? Et d'abord est-elle efficace ? Il faut répondre sans hésiter qu'elle est seule à l'être aujourd'hui. Il y a deux sortes d'efficacité, celle du typhon et celle de la sève. L'absolutisme historique n'est pas efficace, il est efficient ; il a pris et conservé le pouvoir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "500b1030-bd84-4328-981f-fc92794650de",
                        "source_entry_id": "1e6121b5-2b1e-3dd5-9c60-e42c8f8b4a78",
                        "target_lang_word": "effizient",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effizient",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbad1d9-b3ea-3619-984a-ed10b2b1bfa8",
                                        "entry_id": "bb08c0c6-6398-3a04-94f2-eb698a80ec36",
                                        "glosses": [
                                            "fähig, viel Leistung in Relation zum Aufwand zu erbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb521d0d-b258-4c0d-931f-76fdc37fe906",
                                                "sense_id": "6bbad1d9-b3ea-3619-984a-ed10b2b1bfa8",
                                                "text": "Mit dieser effizienten Methode erreichte er schnell das Ziel."
                                            },
                                            {
                                                "example_id": "029a3f12-77e4-4ebb-9e9f-eab17cc0deb9",
                                                "sense_id": "6bbad1d9-b3ea-3619-984a-ed10b2b1bfa8",
                                                "text": "„Eine Flasche Champagner auf eine umgestürzte Kerze zu gießen, ist effektiv, denn das Feuer ist danach gelöscht. Effizient ist es hingegen nicht, denn ein Glas Wasser hätte es auch getan.“"
                                            },
                                            {
                                                "example_id": "d6331473-422c-4794-b074-2663e7958c9c",
                                                "sense_id": "6bbad1d9-b3ea-3619-984a-ed10b2b1bfa8",
                                                "text": "„Effizient seien die Märkte zudem, erklärten ihnen die Professoren, perfekt ausbalanciert durch Konkurrenz, Angebot und Nachfrage.“"
                                            },
                                            {
                                                "example_id": "9d6d8503-79c1-4c8b-9503-eea6edbd0c22",
                                                "sense_id": "6bbad1d9-b3ea-3619-984a-ed10b2b1bfa8",
                                                "text": "„Sie prägen eigene Münzen, übernehmen aber die Gesetze der Franken, den Lebensstil der Einheimischen, deren christliche Religion und romanische Sprache und erschaffen ein effizient verwaltetes Fürstentum, das zur Basis weiterer Eroberungen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d75b8803-f19e-4b1b-b210-45ab71355f9a",
                        "source_entry_id": "1e6121b5-2b1e-3dd5-9c60-e42c8f8b4a78",
                        "target_lang_word": "efficient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Making good, thorough, or careful use of resources; not consuming extra. Especially, making good use of time or energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5e514b-4139-4f78-97ec-7a88019a11b4",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "An efficient process would automate all the routine work."
                                            },
                                            {
                                                "example_id": "4a701c63-fe41-4fe1-89e5-d43dde80c8af",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "Our cleaners are almost too efficient: they throw away anything left out on a desk."
                                            },
                                            {
                                                "example_id": "66c5afe3-d585-466f-962c-6865cc5c1e81",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic[…]real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d3e1b8-ef45-3839-a19c-68f1ed5d3715",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Expressing the proportion of consumed energy that was successfully used in a process; the ratio of useful output to total input."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc42af8-09fc-4f24-ac1a-61fb26cbb7a4",
                                                "sense_id": "f6d3e1b8-ef45-3839-a19c-68f1ed5d3715",
                                                "text": "The motor is only 20% efficient at that temperature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Causing effects, producing results; bringing into being; initiating change (rare except in philosophical and legal expression efficient cause = causative factor or agent)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e14d528-4abf-416a-b9d0-bcb7976e94b8",
                                                "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                                "text": "Ownership, maintenance, or use of the automobile need not be the direct and efficient cause of the injury sustained"
                                            },
                                            {
                                                "example_id": "a50a1016-f640-4ed6-81b6-bed8354cd4b0",
                                                "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                                "text": "It was well said of Plotinus, that the stars were significant, but not efficient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "effective, efficacious"
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddfbec1c-65bd-48e5-964b-821a2e8156e1",
                                                "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                                "text": "Ye wake no more to anguish;‥ ye have borne\nThe Chosen, the Destroyer!‥ soon his hand\nShall strike the efficient blow;\nSoon shaking off your penal forms, shall ye,\nWith songs of joy, amid the Eden groves,\nHymn the Deliverer’s praise!"
                                            },
                                            {
                                                "example_id": "bc8942a4-614a-4fce-99b1-35305c32284b",
                                                "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                                "text": "The Efficient Cause is that from which emanates the force that produces the Effect"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "efficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                        "entry_id": "dec2f9e4-f053-37f5-aaa8-448ccfe10554",
                                        "glosses": [
                                            "A cause; something that causes an effect."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c361c7-e3ba-45f5-bdb2-c369b0ee0655",
                                                "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                                "text": "Some are without efficient, as God; others without matter, as Angels […]."
                                            },
                                            {
                                                "example_id": "83e1d88c-3398-49e1-ba75-58f0e8b3079d",
                                                "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                                "text": "This implies, that something happens without a cause. If it should be said, that motive in this case is not the efficient of the action or doing — this is granted; but at the same time, for reasons already given, it is denied, that the man himself is the efficient cause of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72650c80-b763-4460-96a4-fe567f7b6edd",
                        "source_entry_id": "1e6121b5-2b1e-3dd5-9c60-e42c8f8b4a78",
                        "target_lang_word": "effective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92f6bc92-7f40-390a-af22-7d74a6ae81b9",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Having the power to produce a required effect or effects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0d2105-c319-4d02-8f87-df8558bf288e",
                                                "sense_id": "92f6bc92-7f40-390a-af22-7d74a6ae81b9",
                                                "text": "The pill is an effective method of birth control."
                                            },
                                            {
                                                "example_id": "5bf3f7f7-547e-4ea8-8cae-54d388b14feb",
                                                "sense_id": "92f6bc92-7f40-390a-af22-7d74a6ae81b9",
                                                "text": "Fire ants circumvented the problem of an ineffective sting by having an unusual and highly effective venom that when daubed or sprayed on other ants penetrates their waxy protective integumental barrier and kills or disables them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Producing a decided or decisive effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d340ef83-97ad-41e2-ac46-bf0a046e7d98",
                                                "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                                "text": "The president delivered an effective speech!"
                                            },
                                            {
                                                "example_id": "9e7874d0-b8ae-4fae-b345-a9436ea9a616",
                                                "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                                "text": "Whosoever is an effective, real cause of doing his neighbour wrong, is criminal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Efficient, serviceable, or operative, available for useful work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03884e67-bda6-4cac-a6cc-675bf35dcbbb",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "How long does it take to make a bunch of civilians an effective military force?"
                                            },
                                            {
                                                "example_id": "cd0b53c0-6a07-4d45-bd1b-a33709e21a07",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "My effective income after taxes and child support is $500 a month."
                                            },
                                            {
                                                "example_id": "f5bfddbf-0512-4471-9c6a-4f7da1dec171",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "The effective radiated power is determined by multiplying the transmitter power output with the antenna gain."
                                            },
                                            {
                                                "example_id": "065ffb7e-cf61-44e2-86c3-e031e92e4214",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "The effective voltage of an alternating current is 0.7 times its peak voltage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Actually in effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c70d38c5-299a-442c-a116-55b98878150d",
                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "effective immediately"
                                            },
                                            {
                                                "example_id": "e2a3dbee-98cf-4d48-9fc3-6cc9b9b931ce",
                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "The curfew is effective at midnight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9576b30d-3f51-3ce5-b03a-72594d4008f8",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Having no negative coefficients."
                                        ],
                                        "tags": [
                                            "of a cycle or divisor"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0636d0b3-9ee3-3eb9-a4de-824261a73174",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
