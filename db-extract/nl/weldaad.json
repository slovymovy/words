                                "target_senses": [
                                    {
                                        "sense_id": "5ff60a83-f006-3329-9eed-d93a637da7a3",
                                        "entry_id": "0aa3872c-c35c-3ff9-b4c1-8376ff2017e6",
                                        "glosses": [
                                            "An act of doing good; a benefit, a blessing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bff6bb8-b474-4230-9f12-1c22df38453f",
                                                "sense_id": "5ff60a83-f006-3329-9eed-d93a637da7a3",
                                                "text": "We all feel that sleep is a benefaction [translating Wohlthat] to our psychical life, and the obscure awareness of the popular mind is clearly unwilling to be robbed of its prejudice that the dream is one of the ways in which sleep confers its benefactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5d71ab-7575-3280-a467-672997147dfe",
                                        "entry_id": "0aa3872c-c35c-3ff9-b4c1-8376ff2017e6",
                                        "glosses": [
                                            "An act of charity; almsgiving."
                                        ],
