                "senses": [
                    {
                        "sense_id": "77d900bb-b1f2-329f-badf-145c546931e1",
                        "entry_id": "36d0ed97-a6ea-326d-bd02-a1ebc38b3d30",
                        "glosses": [
                            "Franciser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b5b8fa8-1cb1-4623-aaa5-600e73da93d5",
                                "sense_id": "77d900bb-b1f2-329f-badf-145c546931e1",
                                "text": "Je me suis déjà “amusé” à refranciser un site créé par un template package anglais."
                            },
                            {
                                "example_id": "627f8e5c-abaf-4b5a-98de-2e5bece76a45",
                                "sense_id": "77d900bb-b1f2-329f-badf-145c546931e1",
                                "text": "Notre pays est défiguré par la colonisation migratoire et notre société est gangrénée par une islamisation qui contamine tout, des clubs sportifs jusqu’aux cours de récréation, sous la surveillance des services de police et de gendarmerie mais sans aucune volonté politique d’y mettre un terme. Notre travail est de faire en sorte que les Français restent maîtres chez eux, c’est-à-dire qu’ils restent des Français et que chez eux cela reste la France ! Refranciser la France est donc une priorité."
                            }
                        ]
                    }
