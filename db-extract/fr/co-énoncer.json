                "senses": [
                    {
                        "sense_id": "780d3a63-9e6e-3fc4-9731-2184eb57c9dc",
                        "entry_id": "c2cf2769-c1a2-3dae-87b6-f3eed41e75b7",
                        "glosses": [
                            "Énoncer avec quelqu’un d'autre (soit à la suite l’un de l’autre, soit en considérant quelqu’un d’autre dans ce qu’on énonce)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309e8193-cd45-49f6-8527-e6f6684ee639",
                                "sense_id": "780d3a63-9e6e-3fc4-9731-2184eb57c9dc",
                                "text": "Parler, c'est peu ou prou co-énoncer; c'est pourquoi, complémentairement, le sujet d'énonciation n'est pas normalement en situation d'expression."
                            },
                            {
                                "example_id": "1602fa16-f209-42c9-aa6b-68de264a5e00",
                                "sense_id": "780d3a63-9e6e-3fc4-9731-2184eb57c9dc",
                                "text": "D'autres échanges du corpus reflètent cet aspect de la compétence lexicale où la propriété syntaxique des mots intervient pour co-énoncer l'explication."
                            }
                        ]
                    }
