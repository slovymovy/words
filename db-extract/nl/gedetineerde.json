            {
                "entry_id": "29daa201-7fbd-3c3b-9ad9-506ed7786de9",
                "word": "gedetineerde",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "09e6dc2f-90a4-4f13-ad68-a0086eb2d394",
                        "entry_id": "29daa201-7fbd-3c3b-9ad9-506ed7786de9",
                        "tags": [
                            "plural"
                        ],
                        "form": "gedetineerden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "588824d9-7b4d-3079-bcf5-bbe8e78079e7",
                        "entry_id": "29daa201-7fbd-3c3b-9ad9-506ed7786de9",
                        "glosses": [
                            "iemand die door de staat van zijn vrijheid beroofd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7338f96-b25b-476b-a1d1-532783b00903",
                                "sense_id": "588824d9-7b4d-3079-bcf5-bbe8e78079e7",
                                "text": "De gedetineerden kwamen in opstand tegen de slechte behandeling in de gevangenis."
                            },
                            {
                                "example_id": "4a67e1b0-fab2-4c27-a596-bd9e439625d6",
                                "sense_id": "588824d9-7b4d-3079-bcf5-bbe8e78079e7",
                                "text": "Een jeugdige bajesklant (18) heeft in de gevangenis van Wuppertal-Ronsdorf een twee jaar oudere medegedetineerde gewurgd. De twee vlogen elkaar tijdens een potje kaarten in de haren wegens een kleine speelschuld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86a4ece7-0b83-4d42-ad38-7d09619d58da",
                        "source_entry_id": "29daa201-7fbd-3c3b-9ad9-506ed7786de9",
                        "source_sense_id": "588824d9-7b4d-3079-bcf5-bbe8e78079e7",
                        "source_sense_description": "iemand die door de staat van zijn vrijheid beroofd is",
                        "target_lang_word": "Häftling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Häftling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                        "entry_id": "f1010de4-0697-3f98-835d-3944f8fc16bd",
                                        "glosses": [
                                            "Person, die in Haft ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71dac14-0249-4cd1-be79-9d1b78dee98e",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "Der Häftling muss seine Besitztümer abgeben."
                                            },
                                            {
                                                "example_id": "a8ec0fea-ce53-4260-922e-242f54751794",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "Die Häftlinge werden in ein anderes Gefängnis verlegt."
                                            },
                                            {
                                                "example_id": "0f8b0448-ed30-4c72-ae61-b924ad41848e",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "Władysław Bartoszewski ist tot. Der Auschwitz-Häftling und ehemalige polnische Außenminister engagierte sich über Jahrzehnte für die deutsch-polnische Versöhnung."
                                            },
                                            {
                                                "example_id": "a08e64ba-e21b-4834-bc10-a4ee34ae5ae9",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "200 Häftlinge seien [aus der Haftanstalt] ausgebrochen, nur zehn habe man bislang wieder dingfest machen können, berichteten Polizei und Justiz in der Stadt Minna in Zentralnigeria."
                                            },
                                            {
                                                "example_id": "0242a2b0-8eaf-4cf8-924a-72fad6313b75",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Die anderen Häftlinge starrten ihn mit eisiger Miene an.“"
                                            },
                                            {
                                                "example_id": "46c35574-62b3-4c9c-a1e7-3c5dd2eef46a",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Unser Häftling war vollkommen eingeschüchtert.“"
                                            },
                                            {
                                                "example_id": "728cbf0a-f497-47d2-9fbf-442e2698fa92",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Als Schülerin demonstrierte ich gegen den Golfkrieg, während meines Psychologiestudiums probte ich mit Häftlingen ein Theaterstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf1ca0cd-fe7c-449a-848c-45bcabcf0413",
                        "source_entry_id": "29daa201-7fbd-3c3b-9ad9-506ed7786de9",
                        "source_sense_id": "588824d9-7b4d-3079-bcf5-bbe8e78079e7",
                        "source_sense_description": "iemand die door de staat van zijn vrijheid beroofd is",
                        "target_lang_word": "prisoner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prisoner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person incarcerated in a prison, while on trial or serving a sentence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f9c94c-e1e7-45d9-9bda-a7d925cc66c2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "Two other prisoners were staying in the same cell as him."
                                            },
                                            {
                                                "example_id": "ecff8481-0a8a-4356-b99c-a0587a2c82a2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "The evidence disclosed that the three prisoners were in a public-house together with the prosecutor, Abraham Rhodes, and that in concert with the other two prisoners, the prisoner John Dewhirst placed a pencase on the table in the room where they were assembled, and left the room to get writing-paper."
                                            },
                                            {
                                                "example_id": "8a897d78-9989-460d-b0ce-d4b047eff474",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "American journalist Evan Gershkovich and former US Marine Paul Whelan were among the 24 detainees released as part of a complex prisoner swap between Russia, the US and other Western nations. […] Krasikov, a former high-ranking FSB colonel serving a life sentence in a German prison, was on the top of Moscow’s list of Russian prisoners it wanted to exchange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "Any person held against their will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed10d49-3a6d-461c-93e6-211ea5090a5f",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "And gainſt the General we will lift our ſwords / And either lanch his greedie thirſting throat, / Or take him priſoner, and his chaine ſhall ſerue / For Manackles, till he be ranſom’d home."
                                            },
                                            {
                                                "example_id": "27825753-244a-408d-8e27-06acaa6eed23",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person who is or feels confined or trapped by a situation or a set of circumstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6eabbee-6245-4ea3-b0b6-07ce02fdda7d",
                                                "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                                "text": "I am no longer a prisoner to fear, for I am a child of God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ea6068e-0246-4e0a-ada6-eef5b8046cb7",
