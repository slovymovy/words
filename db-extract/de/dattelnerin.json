                "senses": [
                    {
                        "sense_id": "ad17e29f-e591-3cf4-beef-45503aba2734",
                        "entry_id": "56a16ad6-9942-3362-826a-5772840522e6",
                        "glosses": [
                            "Einwohnerin von Datteln"
