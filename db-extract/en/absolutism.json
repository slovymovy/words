                    {
                        "translation_id": "a7bab0de-2e21-43ab-b5a2-c5a69b7d2427",
                        "source_entry_id": "416f7c03-5ec0-3f71-8412-0a440796a2bd",
                        "source_sense_description": "political science: absolute or arbitrary government; despotism",
                        "target_lang_word": "alleenheerschappij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alleenheerschappij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "878a58e3-e561-316c-978e-eaf37bf56cf4",
                                        "entry_id": "629a7bda-2d07-3c3a-9471-b0c811b82006",
                                        "glosses": [
                                            "volstrekte heerschappij van één persoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b69ef6-76a8-4caa-aa47-4a838bedcfb5",
                                                "sense_id": "878a58e3-e561-316c-978e-eaf37bf56cf4",
