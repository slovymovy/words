                        "source_entry_id": "40d96a4f-9be1-3163-a347-0cedf307f073",
                        "source_sense_id": "a56e9b59-a599-3917-8d0d-122d085f6464",
                        "target_lang_word": "humilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52979396-333e-396f-b092-a2d6c81673ed",
                                        "entry_id": "918f5223-01eb-3295-80e7-517c82f2ec92",
                                        "glosses": [
                                            "Vertu qui nous donne le sentiment de notre faiblesse, qui réprime en nous les mouvements de l’orgueil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c1fe9f-a325-441e-896f-385b5ead43e6",
                                                "sense_id": "52979396-333e-396f-b092-a2d6c81673ed",
                                                "text": "[…] ; cette précaution prise, il revint à sa place, sans humilité comme sans orgueil, convaincu que, perdît-il le prix, il l’avait disputé assez longtemps pour n’avoir pas de honte à le voir passer aux mains d’un autre."
                                            },
                                            {
                                                "example_id": "b72429d9-0996-4477-88d6-76bf5af77e05",
                                                "sense_id": "52979396-333e-396f-b092-a2d6c81673ed",
                                                "text": "Un visage vêtu d’humilité, dit Dante. Mais l’humilité, qui est la position que tout homme réfléchi adopte en présence de sa vie, est plus qu’un vêtement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e3a44d-9bea-324f-8f05-f7cb13ebc5ae",
                                        "entry_id": "918f5223-01eb-3295-80e7-517c82f2ec92",
                                        "glosses": [
                                            "Déférence, soumission, abaissement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25888e0f-2f3d-40b8-838a-25e1bb60b13e",
                                                "sense_id": "88e3a44d-9bea-324f-8f05-f7cb13ebc5ae",
                                                "text": "L’homme argue de son droit avec une suffisance presque impertinente, une humilité feinte qui voile une ironie bien claire : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca23fed-1f32-3481-919a-c60c6b2f142f",
                                        "entry_id": "918f5223-01eb-3295-80e7-517c82f2ec92",
                                        "glosses": [
                                            "Qualité de ce qui est humble."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc3bc61-f4e2-421e-87a4-a89b4b0386ba",
                                                "sense_id": "3ca23fed-1f32-3481-919a-c60c6b2f142f",
                                                "text": "L’humilité des enchères encouragea la troupe des petits brocanteurs, qui se mêlèrent à nous et devinrent familiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e85489-4d9d-3dd1-b74a-7f0d4a311f4c",
                                        "entry_id": "918f5223-01eb-3295-80e7-517c82f2ec92",
                                        "glosses": [
                                            "Sentiment personnel de peu d’importance ; modestie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b890b888-610c-4671-9efa-35b7c4d9c742",
                                                "sense_id": "d1e85489-4d9d-3dd1-b74a-7f0d4a311f4c",
                                                "text": "Malgré son écrasante réussite, elle se comportait toujours avec une grande humilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
