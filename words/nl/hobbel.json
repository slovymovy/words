{
    "word_family": [
        "hobbelen",
        "hobbellig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc735d30-1daa-331a-998d-dbec2f6a4ca8",
                    "sense_definition": "Kleine, onregelmatige verhoging op een oppervlak of in de weg.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "verhoging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op voor de <w>hobbel</w> in de weg, want je kunt erover struikelen.",
                            "target_lang_translations": {
                                "en": "Watch out for the <w>bump</w> in the road, because you could trip over it."
                            }
                        },
                        {
                            "text": "Door de steile <w>hobbel</w> op het pad moest de fietser hard remmen.",
                            "target_lang_translations": {
                                "en": "Because of the steep <w>bump</w> on the path, the cyclist had to brake hard."
                            }
                        }
                    ],
                    "synonyms": [
                        "bult",
                        "oneffenheid"
                    ],
                    "common_phrases": [
                        "steile hobbel",
                        "hobbel in de weg"
                    ],
                    "target_lang_definitions": {
                        "en": "Small, irregular elevation on a surface or in the road."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bump",
                                "target_lang_sense_clarification": "a protuberance or unevenness on a road or surface"
                            },
                            {
                                "target_lang_word": "hump",
                                "target_lang_sense_clarification": "a rounded elevation or raised surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e19857a5-46e0-3934-ac0f-75d75d7a96fb",
                    "sense_definition": "Een obstakel of moeilijkheid die men moet overwinnen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstakel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het geld was de laatste <w>hobbel</w> die we moesten nemen voor het project.",
                            "target_lang_translations": {
                                "en": "The money was the final <w>obstacle</w> we had to overcome for the project."
                            }
                        },
                        {
                            "text": "We moeten nog een <w>hobbel</w> nemen voordat we het contract kunnen ondertekenen.",
                            "target_lang_translations": {
                                "en": "We still have to clear one more <w>hurdle</w> before we can sign the contract."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstakel",
                        "hindernis",
                        "belemmering"
                    ],
                    "common_phrases": [
                        "een hobbel nemen",
                        "laatste hobbel"
                    ],
                    "target_lang_definitions": {
                        "en": "An obstacle or difficulty that one must overcome."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obstacle",
                                "target_lang_sense_clarification": "a difficulty or barrier to progress"
                            },
                            {
                                "target_lang_word": "bump",
                                "target_lang_sense_clarification": "a minor problem or hitch (as in 'a bump in the road')"
                            },
                            {
                                "target_lang_word": "hurdle",
                                "target_lang_sense_clarification": "a problem or difficulty to overcome"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7cb4002d-d70e-3207-889d-0b27f15b905c",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>hobbelen</w>.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>hobbel</w> rustig op mijn oude fiets naar de winkel.",
                            "target_lang_translations": {
                                "en": "I leisurely <w>bump along</w> on my old bicycle to the shop."
                            }
                        },
                        {
                            "text": "Als ik achter de bus aan ren, <w>hobbel</w> ik over de straatstenen.",
                            "target_lang_translations": {
                                "en": "When I run after the bus, I <w>jolt</w> across the cobblestones."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'hobbelen' (to jog along, bump along)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bump along",
                                "target_lang_sense_clarification": "to move unevenly over a rough surface (first person: I bump along)"
                            },
                            {
                                "target_lang_word": "jolt",
                                "target_lang_sense_clarification": "to move with sudden bumps or jerks (first person: I jolt)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}