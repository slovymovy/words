                                                "example_id": "1d3ee94c-bb16-467d-8c7d-72d4d5d86ad0",
                                                "sense_id": "86486118-6d59-3c68-a601-e48f418ed67c",
                                                "text": "„Auch sonst war das Quartär, etwas großzügig definiert, eine tektonisch ausgesprochen unruhige Zeit.“"
                                            },
