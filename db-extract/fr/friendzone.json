                ],
                "senses": [
                    {
                        "sense_id": "1bda26ef-9bd5-3922-9f35-c29ed806e3f3",
                        "entry_id": "5889d076-0d9f-3e53-8c54-52beba65e85e",
                        "glosses": [
                            "Situation sociale où une personne désire avoir une relation romantique avec une autre, qui ne souhaite entretenir qu’une relation amicale."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c9fdd525-a067-4086-a9a0-42d1d9776a83",
                                "sense_id": "1bda26ef-9bd5-3922-9f35-c29ed806e3f3",
                                "text": "L’application de rencontre Happn s’est penchée sur les nouvelles tendances de dating et il en ressort que les utilisateurs de l’appli veulent créer une base amicale avant de se mettre en couple. Mais il semblerait que la friendzone ne soit plus un territoire interdit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64d07c9e-51b2-412a-8eae-1595a0377cd1",
                        "source_entry_id": "5889d076-0d9f-3e53-8c54-52beba65e85e",
                        "source_sense_id": "1bda26ef-9bd5-3922-9f35-c29ed806e3f3",
                        "target_lang_word": "friend zone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friend zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1a30dd0-bfbe-300d-b3f9-d3903d6ba925",
                                        "entry_id": "8abc5828-5682-3da4-ae38-c71836eb1b65",
                                        "glosses": [
                                            "The situation in which one is viewed by a potential partner as a platonic friend, which complicates the initiation of a romantic relationship."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fcc2a4d-4e2c-42a1-836f-21a5948f3dcb",
                                                "sense_id": "e1a30dd0-bfbe-300d-b3f9-d3903d6ba925",
                                                "text": "Once in a while, you will find yourself stuck in the friend zone. Don't panic, you are not alone."
                                            },
                                            {
                                                "example_id": "7c7c0c83-d92b-4e97-9aed-74a92f17d82e",
                                                "sense_id": "e1a30dd0-bfbe-300d-b3f9-d3903d6ba925",
                                                "text": "“Stuck in the Friend Zone,” said Sasha wisely, although I don't think she's dipped a toe in the Friend Zone in her life."
                                            },
                                            {
                                                "example_id": "e8a9685e-0250-42c0-a9db-6fa2679de594",
                                                "sense_id": "e1a30dd0-bfbe-300d-b3f9-d3903d6ba925",
                                                "text": "Every platonic friend I got is some woman I was tryin' to fuck, I made a wrong turn somewhere, and ended up in the friend zone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "friend zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4b08fd0-0436-3870-9b4b-5d2d40e6127c",
                                        "entry_id": "e252f585-2cd0-3052-847b-c15ad13e537e",
                                        "glosses": [
                                            "To classify (someone) as a friend, without any possibility of a romantic relationship."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "069acefa-3dcc-4d9a-a9c8-101fb017acbf",
                                                "sense_id": "c4b08fd0-0436-3870-9b4b-5d2d40e6127c",
                                                "text": "The bloke tries to get her attention back, but I've friendzoned him. Poor guy. I do feel bad for the ones who have to try so hard."
                                            },
                                            {
                                                "example_id": "30cdd01c-3332-4849-b6e3-2fb0a1fbfa77",
                                                "sense_id": "c4b08fd0-0436-3870-9b4b-5d2d40e6127c",
                                                "text": "While being friendzoned is not a problem, what can be a problem is if it's not clear to both people that ONLY friendship and nothing more is on offer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
