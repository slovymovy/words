                                                "example_id": "4ce9a799-7822-48f9-a893-88c8663c1935",
                                                "sense_id": "077f8942-dc10-3479-83dc-b0c35be4bcd8",
                                                "text": "He plays tennis poorly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2dbce81-bdb3-3c75-b3e5-7e9b92523466",
                                        "entry_id": "6802cbe1-c6c2-31b4-a49a-0c198763a771",
                                        "glosses": [
                                            "In a negative manner; with disapproval; unfavorably."
