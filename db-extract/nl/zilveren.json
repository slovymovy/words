                                                "sense_id": "33836293-0d41-3e06-961d-8ab272cf6f0e",
                                                "text": "I'll need some mayonnaise and a silver tin of sardines, a banana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e40701f1-3384-3257-a43a-801b52e084c6",
                                        "entry_id": "b4ec4e71-cd5e-3117-8695-f062bcd331a6",
                                        "glosses": [
                                            "a silver medal"
