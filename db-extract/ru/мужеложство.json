                    {
                        "translation_id": "e6c361fb-0f12-48ba-bf9d-a2a155927c8d",
                        "source_entry_id": "17fd6731-0393-3b05-9ff3-4041962f15d9",
                        "source_sense_id": "eafde8c4-fcf2-347e-830b-d1485cfa1f37",
                        "target_lang_word": "sodomy",
                        "target_lang_code": "en",
