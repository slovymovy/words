                        "examples": [
                            {
                                "example_id": "d6ed6d1a-bf10-49a0-a34a-81f623e61132",
                                "sense_id": "0eb25f99-c1b2-3384-b005-401584f342d8",
                                "text": "Le Jockey-Club avait poussé très loin l'art de... (comment dire ?) mettons de l'accueil engueulatoire, inventé par Bruant, au cabaret du Mirliton."
                            },
                            {
                                "example_id": "33f14653-9647-4287-b274-618ac569818e",
                                "sense_id": "0eb25f99-c1b2-3384-b005-401584f342d8",
                                "text": "Il sauta avec joie sur mes quatrains et prenant prétexte de mon « baptême aux Quat’z’Arts » où je venais de débuter, il jeta à sa clientèle mon nom et mes quatrains engueulatoires."
                            },
                            {
                                "example_id": "8cf05fb7-83ef-47af-bb51-dd12088f85c3",
                                "sense_id": "0eb25f99-c1b2-3384-b005-401584f342d8",
                                "text": "Je n'envisage, en ce moment, que le cas des cochers de fiacres, omnibus et, plus généralement, de toute sorte de véhicules, parce que ces braves gens composent la corporation la plus véhémentement engueulatoire de Paris."
                            }
                        ]
                    }
