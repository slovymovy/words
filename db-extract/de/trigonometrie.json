                    },
                    {
                        "form_id": "0c73194f-d9a5-4d2b-955c-7e482872ae8e",
                        "entry_id": "b883e2ad-1802-374f-a970-76e2c950aa0d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Trigonometrie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                        "entry_id": "b883e2ad-1802-374f-a970-76e2c950aa0d",
                        "glosses": [
                            "Teilgebiet, das sich mit der Berechnung und Bestimmung der fehlenden unbekannten Größen (Winkel, Seitenlängen) eines gegebenen Dreiecks beschäftigt"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "b787eec3-e378-4b5c-bd25-83c5195815b9",
                                "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                "text": "Während die klassische Geometrie mit algebraischen Funktionen operiert, arbeitet die Trigonometrie mit transzendenten Funktionen."
                            },
                            {
                                "example_id": "cae3c0ea-8c42-4c6c-b1a3-966de457b636",
                                "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                "text": "in der (Anwendung der) Trigonometrie benutzte man in den sechziger Jahren noch Tabellenwerke anstelle der heute üblichen Taschenrechner mit trigonometrischen Funktionen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3329cdae-f8cf-41d7-a88e-f709dc65bb48",
                        "source_entry_id": "b883e2ad-1802-374f-a970-76e2c950aa0d",
                        "source_sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                        "target_lang_word": "trigonometry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trigonometry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                        "entry_id": "6a02ba25-ce00-3152-ba34-142b06cf4d91",
                                        "glosses": [
                                            "The branch of mathematics that deals with the relationships between the sides and angles of (in particular) right-angled triangles, as represented by the trigonometric functions, and with calculations based on said relationships."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697890a5-4329-4f95-b1aa-07586ba6f3fd",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "Trigonometry emerged in the Hellenistic world during the 3rd century BCE from applications of geometry to astronomy; the Greeks focused on the calculation of chords, while mathematicians in India created the earliest known tables of values for trigonometric functions such as sine."
                                            },
                                            {
                                                "example_id": "23a0eae5-8c56-4325-a014-3e6aa10a3e87",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "Historically, trigonometry has been applied in areas such as geodesy, surveying, celestial mechanics and navigation."
                                            },
                                            {
                                                "example_id": "d7ef3c78-235c-4075-9fad-76d4c8cd809a",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "Trigonometry was originally the science which treated only of the sides and angles of plane and spherical triangles; but it has been recently extended so as to include the analytic treatment of all theorems involving the consideration of angular magnitudes."
                                            },
                                            {
                                                "example_id": "554e51d5-ae11-4876-a5b1-b5227b0b2fc4",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "In fact, the earliest practical uses of trigonometry were in the fields of astronomy and hence navigation."
                                            },
                                            {
                                                "example_id": "8a106a54-6cf1-468e-98fb-75a476e4ad96",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "The properties of these new trigonometries and identities flowing from the definitions are then developed.\nThe trigonometries derived from these generalizations will be jointly termed \"The Fractional Trigonometry.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5a94452-1ed7-485e-b68b-2f49ed8fde73",
                        "source_entry_id": "b883e2ad-1802-374f-a970-76e2c950aa0d",
                        "source_sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                        "target_lang_word": "trigonométrie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trigonométrie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                        "entry_id": "e7b2e0a1-c3fb-3035-8d26-c58400fa05c7",
                                        "glosses": [
                                            "Méthode de calcul relative aux éléments du triangle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4228c0e-5f07-4cb3-b3a5-31233b305923",
                                                "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                                "text": "Trigonométrie rectiligne, celle qui est relative aux triangles rectilignes."
                                            },
                                            {
                                                "example_id": "a077efba-773c-4106-8f04-3d74ee092461",
                                                "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                                "text": "Trigonométrie sphérique, celle qui enseigne à calculer les triangles sphériques."
                                            },
                                            {
                                                "example_id": "83d2bc43-eeaa-4f06-94df-edb5463f011a",
                                                "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                                "text": "La trigonométrie est de la plus grande nécessité dans la pratique ; c’est par son secours qu’on vient à bout de la plûpart des opérations de la géométrie pratique, & de l’astronomie. Sans cette science nous ignorerions encore la circonférence de la terre, les distances & les mouvemens des astres ; nous ne pourrions point prédire leurs éclipses, &c."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "189e231b-a5b1-4d95-b951-18a0dd14d478",
                        "source_entry_id": "b883e2ad-1802-374f-a970-76e2c950aa0d",
