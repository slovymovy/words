            "senses": [
                {
                    "sense_id": "a7918bf9-b827-32af-b17a-bb5197f4cab4",
                    "sense_definition": "Immobilisé ou bloqué dans un espace étroit ou dans une position dont on ne peut sortir aisément.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "blocage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La clé est restée <w>coincée</w> dans la serrure de la porte d'entrée.",
                            "target_lang_translations": {
                                "en": "The key got <w>stuck</w> in the lock of the front door.",
                                "ru": "Ключ <w>застрял</w> в замке входной двери.",
                                "de": "Der Schlüssel ist im Schloss der Haustür <w>steckengeblieben</w>.",
                                "es": "La llave se quedó <w>atascada</w> en la cerradura de la puerta de entrada.",
                                "zh": "钥匙在前门的锁孔里<w>卡住</w>了。"
                            }
                        },
                        {
                            "text": "Nous sommes restés <w>coincés</w> dans l'ascenseur pendant plus d'une heure.",
                            "target_lang_translations": {
                                "en": "We were <w>stuck</w> in the lift for more than an hour.",
                                "ru": "Мы <w>застряли</w> в лифте больше часа.",
                                "de": "Wir sind mehr als eine Stunde im Aufzug <w>festgesessen</w>.",
                                "es": "Nos quedamos <w>atrapados</w> en el ascensor durante más de una hora.",
                                "zh": "我们在电梯里被<w>卡住</w>了一个多小时。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rester coincé"
                    ],
                    "target_lang_definitions": {
                        "en": "Immobilised or blocked in a tight space or in a position from which one cannot easily get out.",
                        "ru": "Застрявший или заблокированный в тесном месте или в положении, из которого трудно выбраться.",
                        "de": "So eingeengt oder blockiert, dass man sich nur schwer befreien kann.",
                        "es": "Inmovilizado o bloqueado en un espacio estrecho o en una posición de la que no se puede salir fácilmente.",
                        "zh": "被卡在狭窄的空间里，或处于难以脱身的位置。"
                    },
                    "translations": {
