                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1341b6ce-0c38-4311-9a07-afbe0fe46ca1",
                                "sense_id": "9520c674-2af2-3044-8967-a8a83b46b269",
                                "text": "„Das Lachen, das unter der makellos ausgebürsteten Hutkrempe hervordrang, war durchtränkt von Ironie.“"
                            },
                            {
                                "example_id": "d1633100-89a2-46c1-bee2-8dcd6348986e",
                                "sense_id": "9520c674-2af2-3044-8967-a8a83b46b269",
                                "text": "„Die nasse Hutkrempe hing ihm bis zu den Schultern, vorne war sie zurückgesteckt.“"
                            },
                            {
                                "example_id": "c7feab7c-abf7-4334-9d85-f186e4f0073b",
                                "sense_id": "9520c674-2af2-3044-8967-a8a83b46b269",
                                "text": "„Zum Abschied tippte ich an meine Hutkrempe und machte mich auf den Weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
