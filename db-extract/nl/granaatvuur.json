                "senses": [
                    {
                        "sense_id": "53b42a16-b2d3-3061-9e6f-c82368da624e",
                        "entry_id": "2e260937-c659-3768-94a1-6152d0496cf9",
                        "glosses": [
                            "beschieting met granaten"
