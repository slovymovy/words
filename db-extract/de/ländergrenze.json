                        "examples": [
                            {
                                "example_id": "5ad04de5-159a-41ba-b153-c0c401d8bfa1",
                                "sense_id": "f42b2c94-46ca-3e73-93e5-838c3f33d2ff",
                                "text": "„In den Friedensverträgen wurden Ländergrenzen radikal neu gezogen.“"
                            },
                            {
                                "example_id": "fe0ce0e8-cdc1-4682-9794-72b5840c6148",
                                "sense_id": "f42b2c94-46ca-3e73-93e5-838c3f33d2ff",
                                "text": "„In Untersuchungen stellten Forscher fest, dass über alle Ländergrenzen und Kulturkreise hinweg die Menschen Leichengeruch als unangenehm empfinden.“"
                            },
                            {
                                "example_id": "18a96276-2f1c-4a19-a25d-0519abe350fd",
                                "sense_id": "f42b2c94-46ca-3e73-93e5-838c3f33d2ff",
                                "text": "„Um Ländergrenzen haben sich die Samen nie groß gekümmert.“"
                            }
                        ],
