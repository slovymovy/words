                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71ec3234-824e-4024-b571-0f146dbe9fc8",
                                "sense_id": "8c41f86c-a0b9-3005-aae0-5ab0e3f569e7",
                                "text": "Leise wie auf Gummisohlen kam er den Gang entlang geschlichen."
                            },
                            {
                                "example_id": "7eeec382-db84-4bae-b73f-19a4d48e73e1",
                                "sense_id": "8c41f86c-a0b9-3005-aae0-5ab0e3f569e7",
                                "text": "„Er mußte auf Gummisohlen herangekommen sein.“"
                            },
                            {
                                "example_id": "a68886cf-3f9d-4248-b1d9-bb654156b5b4",
                                "sense_id": "8c41f86c-a0b9-3005-aae0-5ab0e3f569e7",
                                "text": "„Deshalb kaufte Azhar einen wärmeren Blazer, eine wollene Dockers-Hose mit Bügelfalten, ein weißes Hemd und ein paar feste Schuhe mit Gummisohlen, die man sowohl in der Stadt als auch draußen im Gelände tragen konnte.“"
                            }
                        ],
