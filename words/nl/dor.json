                {
                    "sense_id": "283d918c-c336-331c-9542-d117aff68156",
                    "sense_definition": "Uitgedroogd door een gebrek aan water of vocht, vaak met betrekking tot planten of landschappen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "droogte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>dorre</w> bladeren ritselden zachtjes in de herfstwind.",
                            "target_lang_translations": {
                                "en": "The <w>withered</w> leaves rustled gently in the autumn wind."
                            }
                        },
                        {
                            "text": "Na maanden zonder regen veranderde het groene grasland in een <w>dorre</w> vlakte.",
                            "target_lang_translations": {
                                "en": "After months without rain, the green grassland turned into an <w>arid</w> plain."
                            }
                        }
                    ],
