                "translations": [
                    {
                        "translation_id": "6f32fd12-d072-4f42-92f9-eb852aad453b",
                        "source_entry_id": "83a60ab9-51bc-305b-9968-f9f2475a19e8",
                        "source_sense_id": "3c581325-0f48-33d2-86d9-8d8e5ef13923",
                        "target_lang_word": "couple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56357a6e-128d-344a-ba87-ca7cf2830941",
                                        "entry_id": "0259f4ea-a947-370a-b0bd-bbeb700bdbc4",
                                        "glosses": [
                                            "Two of the same kind connected or considered together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b7b23c-3659-4010-aae7-782a8cfcfa2a",
                                                "sense_id": "56357a6e-128d-344a-ba87-ca7cf2830941",
                                                "text": "A couple of police officers appeared at the door."
                                            },
                                            {
                                                "example_id": "53ca2d09-0fa0-4935-b098-0a79a130d184",
                                                "sense_id": "56357a6e-128d-344a-ba87-ca7cf2830941",
                                                "text": "'Tis in some sort with Friends (Pardon the Coarseness of the illustration) as it is with Dogs in Couples. They should be of the same Size; and Humour; and That which Pleases the One should Please the Other"
                                            },
                                            {
                                                "example_id": "3f98cc5a-165a-48e1-81ab-cb7263833e60",
                                                "sense_id": "56357a6e-128d-344a-ba87-ca7cf2830941",
                                                "text": "[…]couple of tables; one of which bore some preparations for supper; while, on the other […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6176bd59-7e8b-35cd-9cee-6925c3a48a00",
                                        "entry_id": "0259f4ea-a947-370a-b0bd-bbeb700bdbc4",
                                        "glosses": [
                                            "Two partners in a romantic or sexual relationship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9e02ab-9aec-44ed-862b-949258b402b0",
                                                "sense_id": "6176bd59-7e8b-35cd-9cee-6925c3a48a00",
                                                "text": "The number of Souls in the Kingdom being uſually reckon'd one Million and a half, Of theſe I calculate there may be about tvvo hundred thouſand Couple vvhoſe VVives are Breeders, from vvhich Number I Subſtract thirty Thouſand Couples, vvho are able to maintain their ovvn Children, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "628cab0d-10d5-3db8-af81-6e2f9a5895e5",
                                        "entry_id": "0259f4ea-a947-370a-b0bd-bbeb700bdbc4",
                                        "glosses": [
                                            "A small number."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668786b8-e88d-448b-8afb-2d4eecead8df",
                                                "sense_id": "628cab0d-10d5-3db8-af81-6e2f9a5895e5",
                                                "text": "A couple of billiard balls, all mud and dirt, two battered hats, a champagne bottle […]"
                                            },
                                            {
                                                "example_id": "5a1830be-979f-47f3-a87a-78e7317cff85",
                                                "sense_id": "628cab0d-10d5-3db8-af81-6e2f9a5895e5",
                                                "text": "‘Oh, merely a couple of hundred a year, but the work is slight, and it need not interfere very much with one’s other occupations.’"
                                            },
                                            {
                                                "example_id": "400f2c12-d4ee-4328-b93a-190ad41a95fd",
                                                "sense_id": "628cab0d-10d5-3db8-af81-6e2f9a5895e5",
                                                "text": "When we got on board again after a couple of hours on shore[…]"
                                            },
                                            {
                                                "example_id": "77e67b53-9dec-4750-8fee-decc20d01234",
                                                "sense_id": "628cab0d-10d5-3db8-af81-6e2f9a5895e5",
                                                "text": "Thinks I to myself, “Sol, you're run off your course again. This is a rich man's summer ‘cottage’[…].” So I started to back away again into the bushes. But I hadn't backed more'n a couple of yards when I see something so amazing that I couldn't help scooching down behind the bayberries and looking at it."
                                            },
                                            {
                                                "example_id": "638eae0c-b105-46b1-a958-0a6a38af1e08",
                                                "sense_id": "628cab0d-10d5-3db8-af81-6e2f9a5895e5",
                                                "text": "And no use for anyone to tell Charles that this was because the Family was in mourning for Mr Granville Darracott […]: Charles might only have been second footman at Darracott Place for a couple of months when that disaster occurred, but no one could gammon him into thinking that my lord cared a spangle for his heir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ab6e80a-a8bc-38e8-9074-2cbed68a256e",
                                        "entry_id": "0259f4ea-a947-370a-b0bd-bbeb700bdbc4",
                                        "glosses": [
                                            "One of the pairs of plates of two metals which compose a voltaic battery, called a voltaic couple or galvanic couple."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86279044-986d-3ec6-a936-2c76e56e7c36",
                                        "entry_id": "0259f4ea-a947-370a-b0bd-bbeb700bdbc4",
                                        "glosses": [
                                            "A turning effect created by forces that produce a non-zero external torque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1ad873a-ee14-3854-b936-98fa98d70181",
                                        "entry_id": "0259f4ea-a947-370a-b0bd-bbeb700bdbc4",
                                        "glosses": [
                                            "A couple-close."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eed3e99-0aab-3b5f-83df-375268c87a62",
                                        "entry_id": "0259f4ea-a947-370a-b0bd-bbeb700bdbc4",
                                        "glosses": [
                                            "That which joins or links two things together; a bond or tie; a coupler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "262105b3-78e5-43d1-9b41-3b0f90749944",
                                                "sense_id": "6eed3e99-0aab-3b5f-83df-375268c87a62",
                                                "text": "I’ll keep my stables where / I lodge my wife; I’ll go in couples with her;"
                                            },
                                            {
                                                "example_id": "3cf9f84c-adc8-4849-b957-169c9a42ca6e",
                                                "sense_id": "6eed3e99-0aab-3b5f-83df-375268c87a62",
                                                "text": "As we passed the deserted mountain-dairy, we must have crossed the fresh track of a hare, because the hounds became rather uneasy in the couples."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6c4441-9242-318a-92f2-53856e964d97",
                                        "entry_id": "6c2dd06d-bf5a-30be-bbd9-631aa9ba7ac3",
                                        "glosses": [
                                            "Two or (a) small number of."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61fa19f-a49b-414c-897c-1a999247bea2",
                                                "sense_id": "7d6c4441-9242-318a-92f2-53856e964d97",
                                                "text": "Put any couple guys in a tricked out car and a couple of bandannas […]\" He trailed off."
                                            },
                                            {
                                                "example_id": "57fdbdbd-a301-4331-b71b-264be6da19e5",
                                                "sense_id": "7d6c4441-9242-318a-92f2-53856e964d97",
                                                "text": "Since we were now living so close, at least those couple hours of talking together helped boost our spirits."
                                            },
                                            {
                                                "example_id": "93655bc7-5269-4fab-b775-0f98c0f3447f",
                                                "sense_id": "7d6c4441-9242-318a-92f2-53856e964d97",
                                                "text": "Apparently, Ann in particular liked these couple pages of the character thing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63f2dbba-7d3e-31dc-bbbf-b0a9b51b039e",
                                        "entry_id": "ca646a65-8705-3dbd-9f37-6918b90d54de",
                                        "glosses": [
                                            "Two or a few, a small number of."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c0dcad-46e3-469c-b996-881237a97437",
                                                "sense_id": "63f2dbba-7d3e-31dc-bbbf-b0a9b51b039e",
                                                "text": "A couple fewer people show up every week."
                                            },
                                            {
                                                "example_id": "77b7c6b2-903c-4cc5-97b4-47d84e0299bc",
                                                "sense_id": "63f2dbba-7d3e-31dc-bbbf-b0a9b51b039e",
                                                "text": "I'll be there in a couple minutes."
                                            },
                                            {
                                                "example_id": "928c0c96-0fc1-4be4-a747-b56ee4441480",
                                                "sense_id": "63f2dbba-7d3e-31dc-bbbf-b0a9b51b039e",
                                                "text": "Q. (Mr. Feldman, atty) You say you lived upstairs? A. (Emma Moore) I lived upstairs. Q. Until when? A. About couple months we lived upstairs. Q. Up until couple months ago? A. No, couple months after we moved in there because the down stairs was not finished."
                                            },
                                            {
                                                "example_id": "df07b356-81c5-42ab-8f12-150a00bca09b",
                                                "sense_id": "63f2dbba-7d3e-31dc-bbbf-b0a9b51b039e",
                                                "text": "Couple boys from way downcountry come for a summer in the woods. Isaac Cole talked to em."
                                            },
                                            {
                                                "example_id": "c91407de-b33a-490a-ae03-3f516f49131c",
                                                "sense_id": "63f2dbba-7d3e-31dc-bbbf-b0a9b51b039e",
                                                "text": "[At a pizza parlor] \"Couple slices would be great. […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "212e22d1-b19c-3b63-877a-a63345697844",
                                        "entry_id": "31740a2a-92f1-377c-8728-f547ed7b66a1",
                                        "glosses": [
                                            "To join (two things) together, or (one thing) to (another)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04bce736-849c-4710-9e47-9733c995a19d",
                                                "sense_id": "212e22d1-b19c-3b63-877a-a63345697844",
                                                "text": "Now the conductor will couple the train cars."
                                            },
                                            {
                                                "example_id": "8457618d-76a9-4816-be58-b753984da210",
                                                "sense_id": "212e22d1-b19c-3b63-877a-a63345697844",
                                                "text": "I've coupled our system to theirs."
                                            },
                                            {
                                                "example_id": "25df7729-bfa5-488f-b868-60ba1177f1ac",
                                                "sense_id": "212e22d1-b19c-3b63-877a-a63345697844",
                                                "text": "Some gritty defence at the death, coupled with some key big moments from individual players at critical times helped secure the win as the All Blacks fought with 14 men for a big chunk of the final after a red card to captain Sam Cane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c56e1e-7d06-342f-a1b7-b22e64a667ab",
                                        "entry_id": "31740a2a-92f1-377c-8728-f547ed7b66a1",
                                        "glosses": [
                                            "To join in wedlock; to marry."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06737b21-aca2-464d-884d-bb5869a2b669",
                                                "sense_id": "f1c56e1e-7d06-342f-a1b7-b22e64a667ab",
                                                "text": "I am just going to perform a very good office, it is to assist with the archbishop, in degrading a parson who couples all our beggars"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f17dec18-6d98-3e7b-b190-f73a83d1461b",
                                        "entry_id": "31740a2a-92f1-377c-8728-f547ed7b66a1",
                                        "glosses": [
                                            "To join in sexual intercourse; to copulate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e689a820-9d95-4cb8-a9ec-b11bbea84de6",
                                                "sense_id": "f17dec18-6d98-3e7b-b190-f73a83d1461b",
                                                "text": "On their wedding night they coupled nine times."
                                            },
                                            {
                                                "example_id": "43e3cd47-41e3-47d9-b48b-8fae93107417",
                                                "sense_id": "f17dec18-6d98-3e7b-b190-f73a83d1461b",
                                                "text": "She had the brilliant inventor and craftsman Daedalus construct her an artificial cow, in which she hid and induced the bull to couple with her […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "075c93be-77cd-3fce-a7a1-190a234a5556",
                                        "entry_id": "31740a2a-92f1-377c-8728-f547ed7b66a1",
                                        "glosses": [
                                            "To cause (two animals) to copulate, to bring (two animals) together for mating."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "558cbc66-f10e-49f5-a638-bb4be4f07243",
                                                "sense_id": "075c93be-77cd-3fce-a7a1-190a234a5556",
                                                "text": "The Parilia was generally considered to be the best time for coupling the rams and the ewes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93fe8632-7b39-321f-bf52-a2d7b82511ff",
                                        "entry_id": "31740a2a-92f1-377c-8728-f547ed7b66a1",
                                        "glosses": [
                                            "To enter (multiple horses with the same owner) into a race so that a single bet can be placed on any of them winning."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
