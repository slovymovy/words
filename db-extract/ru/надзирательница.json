                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d69df0-b225-491a-829b-99bb2d7937a4",
                                "sense_id": "226109d7-7bb3-37de-8408-89cf8d3c03bb",
                                "text": "Надзиратели и надзирательницы отдѣленій внимательно наблюдаютъ за поведеніемъ каждаго изъ людей...",
                                "translation": "Надзиратели и надзирательницы отделений внимательно наблюдают за поведением каждого из людей..."
                            },
                            {
                                "example_id": "af92ea30-0a7a-40c2-8ad6-15c666ac237d",
                                "sense_id": "226109d7-7bb3-37de-8408-89cf8d3c03bb",
                                "text": "Я не выдержала, подбежала к двери и стала в нее колотить. Прибежала надзирательница: «Что такое?!» А я говорю: «Переведите в другую камеру!»"
                            }
                        ]
                    }
