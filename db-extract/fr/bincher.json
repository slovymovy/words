                "senses": [
                    {
                        "sense_id": "19cdd320-8188-3356-822c-94188ce7a1d9",
                        "entry_id": "37a147a4-eef8-321d-b05c-8adcc112ed42",
                        "glosses": [
                            "Boire de la bière."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c46d7881-9adc-4930-875a-727af108bf0f",
                                "sense_id": "19cdd320-8188-3356-822c-94188ce7a1d9",
                                "text": "Quand tu arrives au TD, vers 22-23h, que fais-tu en premier ?\n♦) J’y ai été une fois l’année dernière et je ne sais plus de trop.. grhihihihi\n♥) Je vais bincher un coup avec les potes !"
                            },
                            {
                                "example_id": "81fdb7ec-d091-47d0-ace4-b3187d128279",
                                "sense_id": "19cdd320-8188-3356-822c-94188ce7a1d9",
                                "text": "Mais v’la, au moins deux d’entre nous étaient dans la même galère, alors tant qu’à poiroter, autant bincher à plein!"
                            },
                            {
                                "example_id": "2c866365-3677-4a5c-9cd7-1dd64f0b033f",
                                "sense_id": "19cdd320-8188-3356-822c-94188ce7a1d9",
                                "text": "Étant passé par hasard pour finir la soirée simplement pour bincher (nous n'avons pas mangé là-bas), ce lieu fût finalement une excellente surprise."
                            }
                        ]
                    }
