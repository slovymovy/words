                                    }
                                ]
                            },
                            {
                                "target_word": "ecclesiastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "963ee07e-e016-378a-b0f4-11c2439f73d4",
                                        "entry_id": "b3e1e674-5855-3528-97a0-1e42b3cbd84d",
                                        "glosses": [
                                            "A cleric, especially one in a Christian church."
                                        ],
                                        "tags": [],
