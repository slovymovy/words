                        "examples": [
                            {
                                "example_id": "802f9a68-0b13-449d-a179-99468dddbee0",
                                "sense_id": "68e6103b-6d50-3c60-b9c7-9fc5dc533a4b",
                                "text": "Ze staken een weg over die afgesloten was geweest maar nu zo goed als uitgestorven was en liepen via een goederenspoorwegovergang naar iets wat op een vleesmarkt leek."
                            }
                        ]
