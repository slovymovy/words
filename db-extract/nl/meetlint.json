                "senses": [
                    {
                        "sense_id": "ed6d5fd0-54c5-3894-b59d-874da6d13751",
                        "entry_id": "d77aad53-d63a-3590-b510-388858a1b536",
                        "glosses": [
                            "een band met een schaalverdeling zodat men een afstand kan bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5460010a-5847-450b-be02-6b1811f03b15",
                                "sense_id": "ed6d5fd0-54c5-3894-b59d-874da6d13751",
                                "text": "Ik huilde en vervolgens had niemand het er meer over, de gemeente schrapte het plan dat in een la verdween, de buren legden hun brochures weg, pakten een meetlint en kibbelden met elkaar over hoe ver de heg van de ander wel niet op hun grond stond; ik geloof niet dat mijn gehuil enige invloed heeft gehad op het verloop van deze kwestie."
                            },
                            {
                                "example_id": "5075adcc-9ec7-4d1e-b243-1f1be51b0190",
                                "sense_id": "ed6d5fd0-54c5-3894-b59d-874da6d13751",
                                "text": "Acteur Frank Lammers kan zich er niet veel bij voorstellen. \"Ik denk dat ik de social distance manager heel snel van de set af zou bonjouren. Iemand met een meetlint die tegen mij gaat zeggen dat ik anderhalve meter weg moet blijven of te dicht bij sta, die bijt ik zijn hoofd eraf, denk ik.\""
                            }
                        ]
                    }
                ],
