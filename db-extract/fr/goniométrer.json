                "senses": [
                    {
                        "sense_id": "4780117a-2df0-37dc-9faf-cea73a1ddd6a",
                        "entry_id": "86cbd38d-6a23-3b43-b2b2-941d20174998",
                        "glosses": [
                            "Mesurer un angle avec un goniomètre ou un radiogoniomètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096761d7-0a1a-4bb3-b0e2-a1ff3c7e8ac2",
                                "sense_id": "4780117a-2df0-37dc-9faf-cea73a1ddd6a",
                                "text": "Un radiocompas ou radiogoniomètre est un récepteur radio embarqué à bord d’un navire ou d’un avion lui permettant de recevoir et de goniométrer (mesurer l’angle d’arrivée de l’émission radio) de balises radio ou de radiophares."
                            },
                            {
                                "example_id": "9713c40d-4159-4fab-8350-daddf47a29f3",
                                "sense_id": "4780117a-2df0-37dc-9faf-cea73a1ddd6a",
                                "text": "Brave Marc, il allait essayer de goniométrer pour m’aider à corriger mon estime."
                            }
                        ]
                    }
