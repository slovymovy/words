                "senses": [
                    {
                        "sense_id": "d617c4da-77de-3b23-97e5-024c21def2bd",
                        "entry_id": "d9ed892c-83bb-33b8-aff2-58859314f3d8",
                        "glosses": [
                            "Bein, das zusammen mit dem Darmbein und dem Schambein das Hüftbein bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012b3483-dbd0-4056-aa9b-40bbe8742a24",
                                "sense_id": "d617c4da-77de-3b23-97e5-024c21def2bd",
                                "text": "„Der Auswärtszieher ist ein länglich viereckiger Muskel, der mit dem inneren Theile des kleinen Gesässmuskels verschmolzen ist, an den Dornfortsätzen des Kreuzbeins, am Kreuzsitzbeinbande und am Sitzbeine entspringt und sich von der Kniescheibe an bis zum Ursprunge der Achillessehne befestigt. der“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b40b8ab-6e0c-48e8-b4a2-c9669bbcc377",
                        "source_entry_id": "d9ed892c-83bb-33b8-aff2-58859314f3d8",
                        "source_sense_id": "d617c4da-77de-3b23-97e5-024c21def2bd",
                        "source_sense_description": "Bein",
                        "target_lang_word": "ischium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ischium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc67ac1f-0fe5-3656-8f98-a59f2b5c1890",
                                        "entry_id": "937baf99-b256-3980-9ee2-1302baa25266",
                                        "glosses": [
                                            "The lowest of the three bones that make up each side of the pelvis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9575fb2-b2f0-4838-acee-f1d0a8b50d18",
                                                "sense_id": "bc67ac1f-0fe5-3656-8f98-a59f2b5c1890",
                                                "text": "And he still carried, after five or six years, and though he dressed it in a mirror night and morning, on his right ischium a running sore of traumatic origin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
