                "senses": [
                    {
                        "sense_id": "4b5e5bfe-2b70-315f-98ed-5ad0e59c6f7a",
                        "entry_id": "0c66746c-3c88-3db4-a1f3-697a11566045",
                        "glosses": [
                            "Wiedergabegerät für Schallplatten mit Schalltrichter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b2ad35-b52c-4fe6-b82a-324f7f81b9d6",
                                "sense_id": "4b5e5bfe-2b70-315f-98ed-5ad0e59c6f7a",
                                "text": "„Der Tonarm des Grammofons wirkte zerbrechlich in seinen kräftigen Händen.“"
                            },
                            {
                                "example_id": "aa0746d1-70c0-4757-98fc-4aed47dad804",
                                "sense_id": "4b5e5bfe-2b70-315f-98ed-5ad0e59c6f7a",
                                "text": "„Das Grammofon war in Decken gehüllt wegen der Kälte.“"
                            },
                            {
                                "example_id": "d109f12a-7428-43ec-9254-99aa66fb990d",
                                "sense_id": "4b5e5bfe-2b70-315f-98ed-5ad0e59c6f7a",
                                "text": "„Aus einem Grammofon krächzte Richard Tauber und übertönte den Ehekrach vom Tiefparterre.“"
                            },
                            {
                                "example_id": "d0d65c6b-df26-44ac-b9b8-2652bb110dc9",
                                "sense_id": "4b5e5bfe-2b70-315f-98ed-5ad0e59c6f7a",
                                "text": "„Bens Augen folgten mir, als ich zu einem Beistelltisch mit einem alten Grammofon darauf ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
