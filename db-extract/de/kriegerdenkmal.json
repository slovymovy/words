                ],
                "senses": [
                    {
                        "sense_id": "579b9376-cd12-375a-8e46-0cd5b75f50be",
                        "entry_id": "c4253e4a-cf2a-3622-b35c-9d86b8cb803d",
                        "glosses": [
                            "Denkmal, das (normalerweise in glorifizierender Weise) an Krieger erinnern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c07675-d8fa-4e2a-8ddc-3549887e8bce",
                                "sense_id": "579b9376-cd12-375a-8e46-0cd5b75f50be",
                                "text": "„Neben der Hauptpost stand das Kriegerdenkmal der 90er.“"
                            },
                            {
                                "example_id": "0eb550d2-7dc4-4134-8ae7-2e5e4f5e6958",
                                "sense_id": "579b9376-cd12-375a-8e46-0cd5b75f50be",
                                "text": "„Paule Nagorkan sitzt halb und liegt halb im Graben beim Kriegerdenkmal und hat sich seinen Rucksack mit der Grubenlampe als Genickstütze untergeschoben.“"
                            },
                            {
                                "example_id": "70c0f936-17b3-44f3-b5da-8cfda0a33f2d",
                                "sense_id": "579b9376-cd12-375a-8e46-0cd5b75f50be",
                                "text": "Kriegerdenkmale stellen dann ein ethisches Problem dar, wenn der im Bezug stehende Krieg von Teilen der Bevölkerung als falsch oder verwerflich angesehen wird."
                            },
                            {
                                "example_id": "30c26827-e579-4f7d-9e8e-5849c929e030",
                                "sense_id": "579b9376-cd12-375a-8e46-0cd5b75f50be",
                                "text": "„Hinter ihm schimmert der Sandsteinlöwe, den er für ein Kriegerdenkmalzurechthaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
