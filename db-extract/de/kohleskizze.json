                "senses": [
                    {
                        "sense_id": "b29f9e28-cfbb-3642-bb4e-23bcd367baf2",
                        "entry_id": "ed2c6375-c686-3fb7-85cb-0b03c3c534da",
                        "glosses": [
                            "mit einem Kohlestift gezeichnete Skizze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed46609a-049b-44a5-ad6e-6e10d1ff1a1f",
                                "sense_id": "b29f9e28-cfbb-3642-bb4e-23bcd367baf2",
                                "text": "„Er nahm das Fernglas aus dem Wagen und suchte die Ebene dort unten ab, wo sich im Grau der Umriss einer Stadt erhob wie eine auf die Einöde geworfene Kohleskizze.“"
                            },
                            {
                                "example_id": "3d75fc15-0d04-400d-93f5-bcbc034ce6aa",
                                "sense_id": "b29f9e28-cfbb-3642-bb4e-23bcd367baf2",
                                "text": "„Junge Künstler - namenlose Künstler - saßen in ihrem Atelier und malten eine perfekte Miniatur. Oder grundierten den Aufkleber mit weißer Farbe und zeichneten eine Kohleskizze darauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
