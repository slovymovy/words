                        "examples": [
                            {
                                "example_id": "2f8a72d7-d35d-4808-a8ba-ab3deeb028bc",
                                "sense_id": "f58d9520-1289-316f-b320-ce7909625fde",
                                "text": "« Override pour le reculon » : y en a-tu de vous autres qui avez by-passé ça ?? J’imagine que les autres marques ont le même principe."
                            },
                            {
                                "example_id": "ea8d9ef1-c3d1-4beb-9c11-4281ab0673ad",
                                "sense_id": "f58d9520-1289-316f-b320-ce7909625fde",
                                "text": "Lorsque j’embraye la 1ère vitesse ou le reculon, la voiture se met à vibrer 3-4 coups lorsque j'atteins le point de friction avec la clutch. À froid, elle ne vibre pas et à chaud, l’embrayage est saccadé seulement lorsque je relâche la clutch et que je suis en première vitesse ou à reculon"
                            }
                        ]
