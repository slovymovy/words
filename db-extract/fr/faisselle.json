            {
                "entry_id": "368c6fd9-a14b-3f9e-ae55-b24231fe0bcb",
                "word": "faisselle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "58b47a53-999c-4808-a643-8e7e400ee9c3",
                        "entry_id": "368c6fd9-a14b-3f9e-ae55-b24231fe0bcb",
                        "tags": [
                            "plural"
                        ],
                        "form": "faisselles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf133b9a-e57c-3477-9dcb-7b63a42992f9",
                        "entry_id": "368c6fd9-a14b-3f9e-ae55-b24231fe0bcb",
                        "glosses": [
                            "Récipient à parois percées de trous dans lequel on fait égoutter le fromage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1260cc71-6565-420b-bec6-b6d83fe6c270",
                                "sense_id": "cf133b9a-e57c-3477-9dcb-7b63a42992f9",
                                "text": "Elle rejeta la longue cuiller de buis avec laquelle elle s’appliquait à presser les fromages dans les faisselles."
                            },
                            {
                                "example_id": "d55e3988-f23b-409e-b22b-a6154a7fe6c4",
                                "sense_id": "cf133b9a-e57c-3477-9dcb-7b63a42992f9",
                                "text": "Pour ne pas perdre de temps, elle démoule de petits fromages de pays, puis se met à rincer les faisselles."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cba5cde-e14b-3c8f-bc41-14d2ab22e00c",
                        "entry_id": "368c6fd9-a14b-3f9e-ae55-b24231fe0bcb",
                        "glosses": [
                            "Fromage à pâte fraîche à base de lait de vache, de chèvre, ou de brebis, d'un poids moyen de 150 g à 1 kg dont l’affinage est seulement de quelques jours."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "7539d52c-aeb8-48f2-ab52-be13e1fdfd76",
                                "sense_id": "0cba5cde-e14b-3c8f-bc41-14d2ab22e00c",
                                "text": "La faisselle s’accompagne souvent de sel, de poivre, de ciboulette ou de sucre, de miel comme dessert."
                            }
                        ]
                    },
                    {
                        "sense_id": "55c93103-12fb-3603-a14d-5c4c0f62940d",
                        "entry_id": "368c6fd9-a14b-3f9e-ae55-b24231fe0bcb",
                        "glosses": [
                            "Table sur laquelle on presse le marc de pomme pour le faire égoutter."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "6eb863e0-2f49-48e8-8bed-49b1e6481a0f",
                                "sense_id": "55c93103-12fb-3603-a14d-5c4c0f62940d",
                                "text": "Pressurage des pommes. Le marc étant encore sur la faisselle, on le débite en galettes."
                            }
                        ]
                    }
                ],
