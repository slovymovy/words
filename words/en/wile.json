{
    "word_family": [
        "wily",
        "wiliness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af083585-fcb1-3861-8391-8335436ff39e",
                    "sense_definition": "A trick, stratagem, or sly artifice used to deceive or entice someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to see through her seductive <w>wiles</w> before making a foolish decision.",
                            "target_lang_translations": {
                                "ru": "Ему удалось разгадать её соблазнительные <w>уловки</w>, прежде чем он совершил глупость."
                            }
                        },
                        {
                            "text": "The politician used every clever <w>wile</w> he knew to defeat his rivals.",
                            "target_lang_translations": {
                                "ru": "Политик пустил в ход все известные ему хитрые <w>ухищрения</w>, чтобы одолеть соперников."
                            }
                        }
                    ],
                    "synonyms": [
                        "beguilement",
                        "allurement"
                    ],
                    "common_phrases": [
                        "feminine wiles",
                        "cunning wiles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хитрость, коварная уловка или ухищрение, используемые для обмана или соблазнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый приём"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "коварный или хитрый поступок"
                            },
                            {
                                "target_lang_word": "ухищрение",
                                "target_lang_sense_clarification": "изобретательный приём, уловка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82f9b60e-ec61-3e6a-9733-8529061043a6",
                    "sense_definition": "To entice, lure, or beguile someone using clever or deceptive charms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest salesman tried to <w>wile</w> customers into buying useless warranties.",
                            "target_lang_translations": {
                                "ru": "Нечестный продавец пытался <w>заманить</w> покупателей в приобретение бесполезных гарантий."
                            }
                        },
                        {
                            "text": "With his smooth voice, he could easily <w>wile</w> listeners into believing his stories.",
                            "target_lang_translations": {
                                "ru": "Своим бархатным голосом он мог легко <w>обольстить</w> слушателей, заставив их поверить в свои россказни."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often literary or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завлекать, заманивать или очаровывать кого-либо с помощью хитрости или обманчивых чар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завлекать",
                                "target_lang_sense_clarification": "приманивать хитростью"
                            },
                            {
                                "target_lang_word": "обольщать",
                                "target_lang_sense_clarification": "соблазнять, прельщать"
                            },
                            {
                                "target_lang_word": "заманивать",
                                "target_lang_sense_clarification": "склонять к чему-либо хитростью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92dc3289-9527-34ea-bf3e-e71197bb7d54",
                    "sense_definition": "Misspelling of <w>while</w> (“to pass the time”).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat on the porch to <w>wile</w> away the lazy summer afternoon.",
                            "target_lang_translations": {
                                "ru": "Они сидели на крыльце, чтобы <w>скоротать</w> ленивый летний полдень."
                            }
                        },
                        {
                            "text": "He played quiet music just to <w>wile</w> away the remaining hours.",
                            "target_lang_translations": {
                                "ru": "Он включил тихую музыку лишь для того, чтобы <w>скоротать</w> оставшиеся часы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wile away"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочное написание глагола while в значении «проводить, коротать время»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коротать",
                                "target_lang_sense_clarification": "проводить время (в фразе wile away)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9205faa7-339c-30f2-8bc1-8f3c960f0585",
                    "sense_definition": "A male given name transferred from the surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "His grandfather was named <w>Wile</w>, after an ancestor from the old country.",
                            "target_lang_translations": {
                                "ru": "Его дедушку звали <w>Уайл</w> — в честь предка со старой родины."
                            }
                        },
                        {
                            "text": "Young <w>Wile</w> walked proudly across the stage to receive his diploma.",
                            "target_lang_translations": {
                                "ru": "Юный <w>Уайл</w> с гордостью прошёл по сцене, чтобы получить диплом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя, образованное от фамилии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уайл",
                                "target_lang_sense_clarification": "мужское имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcfe9f01-8f08-3a8c-9d28-9f8f2750cb59",
                    "sense_definition": "A surname transferred from the nickname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Wile</w> published several influential papers on historical linguistics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Уайл</w> опубликовал несколько влиятельных работ по исторической лингвистике."
                            }
                        },
                        {
                            "text": "The local library was named in honor of the prominent <w>Wile</w> family.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь известной семьи <w>Уайл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "transferred from nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, изначально возникшая как прозвище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уайл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
