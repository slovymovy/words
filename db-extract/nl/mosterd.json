                                    },
                                    {
                                        "sense_id": "442267e2-8133-32f0-ad6f-e48a0eed5267",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "Energy, power (when throwing a baseball)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861aad07-d9f5-433d-a62a-f42b3acf051c",
                                                "sense_id": "442267e2-8133-32f0-ad6f-e48a0eed5267",
                                                "text": "He's left-handed and in his adulthood didn't have a baseball glove to call his own. He borrowed one of mine and just out of the car, still wearing his lab coat having worked an overnight shift, he taught himself to throw right-handed and put plenty of mustard on it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mustard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e80dfb31-1bdb-3a3d-86af-6d4eef013bb2",
                                        "entry_id": "dfb79e20-677a-34f7-b94d-869242819ee6",
                                        "glosses": [
                                            "Of a dark yellow colour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f7b297a-bee1-4572-a119-f70e39d25db7",
                                                "sense_id": "e80dfb31-1bdb-3a3d-86af-6d4eef013bb2",
                                                "text": "Everything about her year-old restaurant, from the minimalist menu (about a dozen items) with refreshingly drivel-free descriptions to the decor (unadorned warm mustard walls, unclothed bistro tables), reflects her love of bringing people to the table for good, simple food that's not eclipsed by bells and whistles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0a27041-41aa-3c40-b0f8-484adf3ed33d",
                                        "entry_id": "dfb79e20-677a-34f7-b94d-869242819ee6",
                                        "glosses": [
                                            "Very good, or very skilled."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de4a984-da8e-42be-87c6-ee6666dcc8c8",
                                                "sense_id": "a0a27041-41aa-3c40-b0f8-484adf3ed33d",
                                                "text": "My expectations of public services were nil, so any time within a month was fine by me. They did it in less than a week, which was mustard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "665c6c8d-3ab3-4f56-9d72-a1f2102a0247",
                        "source_entry_id": "b8b7cf02-0c29-3ac5-af14-55af2af8d263",
