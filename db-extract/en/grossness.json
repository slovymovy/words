                    {
                        "translation_id": "59c8f4ec-b159-4dba-9eb3-b694558de2f9",
                        "source_entry_id": "dc6b30e5-685f-3820-80b7-dc4f941219ca",
                        "source_sense_id": "8a5bb1bd-336e-35cf-ae47-ae5e2ebab660",
                        "source_sense_description": "Grobheit, Rohheit, Rüpelhaftigkeit",
                        "target_lang_word": "Grobheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grobheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9039bee-2472-311c-b3c2-a86df776c277",
                                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                                        "glosses": [
                                            "grobe, ruppige, wenig feinfühlige Art"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0acdf27-673b-46f6-a56f-e26847bee8cf",
                                                "sense_id": "b9039bee-2472-311c-b3c2-a86df776c277",
                                                "text": "Seine Grobheit erregte immer wieder Abscheu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                                        "glosses": [
                                            "Verhalten, sich grob zu äußern oder grob zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6388195d-774f-4716-a9a3-8e5046cecb66",
                                                "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                                "text": "„Auf dem Heimweg brabbelt er allerlei sexuelle Grobheiten vor sich hin.“"
                                            },
                                            {
                                                "example_id": "bebb6783-735c-4b1f-8b4b-ecf1b9c7c117",
                                                "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                                "text": "„Mochten sich die einen an Luthers Schriften begeistern, andere sich über sie empören, wieder andere sich kopfschüttelnd über seine Grobheiten amüsieren – gleichgültig ließen sie niemanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e5ba6207-6ee8-3f54-a9d6-084ecc8c99d5",
                                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                                        "glosses": [
                                            "Eigenschaft eines groben, rauen Materials; Eigenschaft, sich grob/rau anzufühlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751abf1b-028a-4f66-9a64-4e1a31faa2af",
                                                "sense_id": "e5ba6207-6ee8-3f54-a9d6-084ecc8c99d5",
                                                "text": "Ein Tuch von solcher Grobheit schien uns in diesem Fall nicht passend zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57ad335a-bed3-4bf4-ba28-9ca284c5143e",
                        "source_entry_id": "dc6b30e5-685f-3820-80b7-dc4f941219ca",
                        "source_sense_id": "8a5bb1bd-336e-35cf-ae47-ae5e2ebab660",
                        "source_sense_description": "Grobheit, Rohheit, Rüpelhaftigkeit",
                        "target_lang_word": "Rohheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rohheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9cca9dc-7093-3f56-b1b3-f7f74e50fd7e",
                                        "entry_id": "fe49f3ab-60ac-35de-93d4-017715b47f86",
                                        "glosses": [
                                            "Eigenschaft, grob und gewalttätig zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87dbeaf9-dc6e-4ce9-8cdc-91116a5c8cfe",
                                                "sense_id": "f9cca9dc-7093-3f56-b1b3-f7f74e50fd7e",
                                                "text": "„Ihre Rohheit, ihre obszöne Lasterhaftigkeit formte den Knaben ebenso wie die naturalistische Auffassung der Dorfmädchen von Liebesdingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "488b48b6-46a6-31c5-a655-203c648303e7",
                                        "entry_id": "fe49f3ab-60ac-35de-93d4-017715b47f86",
                                        "glosses": [
                                            "grobes Verhalten, grobe und gefühllose Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94fc92ed-196e-4686-b6e0-a8d5c0cf7a6a",
                                                "sense_id": "488b48b6-46a6-31c5-a655-203c648303e7",
                                                "text": "„Es wirkte ein System, das sich die Rohheit der Zeit zunutze machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
