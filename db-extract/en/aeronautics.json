                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e47bed42-610d-3a3a-8c31-65e8eb21d581",
                        "entry_id": "5538bd47-3d1c-3173-abef-9ada977d5138",
                        "glosses": [
                            "The design, construction, mathematics and mechanics of aircraft and other flying objects"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bc48f3ce-88e8-30a4-a814-cd1ef0fafe76",
                        "entry_id": "5538bd47-3d1c-3173-abef-9ada977d5138",
                        "glosses": [
                            "The theory and practice of aircraft navigation"
                        ],
                        "tags": [
                            "uncountable"
                        ],
