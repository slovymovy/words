                    ]
                },
                {
                    "sense_id": "b0115214-9771-37a4-9aaf-b051937ac5da",
                    "sense_definition": "D'une façon privilégiée, au-dessus de tout et préférablement à toute autre chose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette correspondance classique, l'auteur affirme qu'il l'aime <w>uniquement</w>."
                        },
                        {
                            "text": "Cette cause honorable lui tenait <w>uniquement</w> au cœur jusqu'à la fin de ses jours."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "tournure classique et vieillie"
                        }
                    ]
                },
                {
                    "sense_id": "d05f8566-6566-3ca9-b185-e9d1eeb12f9d",
                    "sense_definition": "D'une façon excellente ou parfaite.",
