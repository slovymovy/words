                "senses": [
                    {
                        "sense_id": "2a94017e-173a-31b6-be09-1d740f7f170d",
                        "entry_id": "031a45e7-9117-3fc9-a621-5bb6078a9df4",
                        "glosses": [
                            "dünnes, meist dreikantiges Element aus Kunststoff, das beim Kunststoffschweißen benötigt wird, schmilzt und eine Kunststoffschweißnaht bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "926afa00-068d-4da6-ab36-dbf5f81ad0cb",
                                "sense_id": "2a94017e-173a-31b6-be09-1d740f7f170d",
                                "text": "Einen Zentimeter über den Torfmull stelle ich einen selbstgefertigten Kunststoffrost aus durchsichtigem Kunststoffschweißdraht (3 mm 0 )."
                            },
                            {
                                "example_id": "78e5c203-d611-4211-9a6f-0dd7a7545381",
                                "sense_id": "2a94017e-173a-31b6-be09-1d740f7f170d",
                                "text": "Sie erhalten hier Kunststoffschweißdrähte für PE, PP, PS, ABS und PC."
                            },
                            {
                                "example_id": "5ef2d160-8781-4b03-b7fe-32c88bbaf71d",
                                "sense_id": "2a94017e-173a-31b6-be09-1d740f7f170d",
                                "text": "Am Institut wurde ein neuartiges System zur Faserfixierung entwickelt, das handelsübliche Kunststoffschweißdrähte aufschmilzt und durch eine Düse unter die abzulegenden Rovings fördert."
                            },
                            {
                                "example_id": "67f88a1a-6654-40e5-a077-1ee462eeb1b8",
                                "sense_id": "2a94017e-173a-31b6-be09-1d740f7f170d",
                                "text": "Bei allen bekannten Handextruderschweißgeräten stellt das Verdrillen des eingezogenen Kunststoffschweißdrahtes ein Problem dar, da durch die Drehung der Extruderschnecke der Kunststoffschweißdraht entlang seiner Längsachse zusätzlich zu der ohnehin bereits vorhandenen Verdrillung durch das Abwickeln von einer Abrollvorrichtung verdrillt wird."
                            },
                            {
                                "example_id": "aea235f1-2f00-441c-b2a1-731a1a38a46a",
                                "sense_id": "2a94017e-173a-31b6-be09-1d740f7f170d",
                                "text": "Beim Verschweißen mit Hilfe von Kunststoffschweißdraht ist darauf zu achten, ob es sich um Hart- oder Weich-PVC handelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
