                    {
                        "translation_id": "0a383c06-4b0b-4b65-86ec-62b7956f9cc5",
                        "source_entry_id": "62957175-b615-3ed8-ae79-4a5e2efdbe6a",
                        "source_sense_id": "58b9aff5-272a-3876-9705-b6cdcfaf9c66",
                        "source_sense_description": "Serendipität",
                        "target_lang_word": "Entdeckung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entdeckung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f6ff1ca-3eb2-38c6-a215-eb1d4bbeeb2b",
                                        "entry_id": "2ae09ef6-82d8-3468-b537-5e3915b10672",
                                        "glosses": [
                                            "Auffindung von etwas bisher Unbekanntem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abce5806-344b-4e11-b80a-6e00edee5714",
                                                "sense_id": "4f6ff1ca-3eb2-38c6-a215-eb1d4bbeeb2b",
                                                "text": "„Der Amerikaner, der den Kolumbus zuerst entdeckte, machte eine böse Entdeckung.“"
                                            },
                                            {
                                                "example_id": "be7fc899-5e91-482e-8207-9b6cba8b2c28",
                                                "sense_id": "4f6ff1ca-3eb2-38c6-a215-eb1d4bbeeb2b",
                                                "text": "„Die Entdeckung 2003 elektrisierte nicht nur Fachleute.“"
                                            },
                                            {
                                                "example_id": "e6199a2b-c425-4fef-98cf-14d794026829",
                                                "sense_id": "4f6ff1ca-3eb2-38c6-a215-eb1d4bbeeb2b",
                                                "text": "„Die Untersuchung von Holzkohle aus vorgeschichtlichen Feuerstellen erfaßt die Veränderungen der Vegetation ungefähr während der letzten 500000 Jahre – seit der Mensch nach Entdeckung des Feuers erste Feuerstellen anlegte.“"
                                            },
                                            {
                                                "example_id": "537f3029-4ad6-4fd1-a4f7-345989a4b951",
                                                "sense_id": "4f6ff1ca-3eb2-38c6-a215-eb1d4bbeeb2b",
                                                "text": "„Mit der Entdeckung des Streptomycins im Jahre 1943 in den USA begann eine neue Ära in der Tuberkulosebehandlung.“"
                                            },
                                            {
                                                "example_id": "9d873b4a-3122-4bcc-9d25-af9fd04835aa",
                                                "sense_id": "4f6ff1ca-3eb2-38c6-a215-eb1d4bbeeb2b",
                                                "text": "„Vielmehr binden sie bevorzugt mit dem Kunstgriff der »Personalisierung«, das heißt einer betonten Herausstellung der menschlichen Seiten, ihren eigentlichen, belehrenden Stoff an Forschergestalten und deren Schicksale, an den konkreten Hergang von Entdeckungen, Forschungsarbeiten oder Erfindungen, an interessante Begleitumstände und dergleichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "faf8518e-6e29-3e91-a342-ad9b1d93b8af",
                                        "entry_id": "2ae09ef6-82d8-3468-b537-5e3915b10672",
                                        "glosses": [
                                            "etwas, das entdeckt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e23758b-56bd-403e-8a6e-c6472fdeebd9",
                                                "sense_id": "faf8518e-6e29-3e91-a342-ad9b1d93b8af",
                                                "text": "„Es war die erste aus einer Reihe von Entdeckungen gewesen, die ihm noch gelingen sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
