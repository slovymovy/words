                            "singular"
                        ],
                        "form": "das Trauerspiel"
                    },
                    {
                        "form_id": "02520e59-98e3-4a58-93cf-2f576a285409",
                        "entry_id": "6ae8d8ef-7123-3d7f-a392-a988794da30d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Trauerspiele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "334a9109-2fe8-3e46-bfa5-6bac16c81b05",
                        "entry_id": "6ae8d8ef-7123-3d7f-a392-a988794da30d",
                        "glosses": [
                            "Literaturgattung, dem Drama zugehörig; Schauspiel mit tragischem Ausgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8aedb9-69b5-4320-86c5-0dc8f5fe5202",
                                "sense_id": "334a9109-2fe8-3e46-bfa5-6bac16c81b05",
                                "text": "„Der junge Regisseur Martin Pfaff, der zuletzt den Liederabend D-Mission inszeniert hatte, zeigt Goethes Trauerspiel von 1774 als die Geschichte eines höchst modernen Karrieristen.“"
                            },
                            {
                                "example_id": "90d6abbf-b9e0-4ee8-8158-7a747923699b",
                                "sense_id": "334a9109-2fe8-3e46-bfa5-6bac16c81b05",
                                "text": "„In einer klaren und einfachen Ästhetik hat er zumeist bürgerliche Trauerspiele auf ihren existenziellen Gehalt untersucht.“"
                            },
                            {
                                "example_id": "d4d135d1-68f4-4873-a48c-a645b6a419a7",
                                "sense_id": "334a9109-2fe8-3e46-bfa5-6bac16c81b05",
                                "text": "„Ich habe mein Stück ‚Der Stellvertreter’ als christliches Trauerspiel angelegt.“"
                            },
                            {
                                "example_id": "67edccde-df3d-41b0-8dc6-5f0e3e46b401",
                                "sense_id": "334a9109-2fe8-3e46-bfa5-6bac16c81b05",
                                "text": "„1887 - In Kopenhagen wird August Strindbergs Trauerspiel in drei Akten ‚Der Vater’ uraufgeführt.“"
                            },
                            {
                                "example_id": "4988489f-db61-4093-9c69-809edf29e6c4",
                                "sense_id": "334a9109-2fe8-3e46-bfa5-6bac16c81b05",
                                "text": "„Das bürgerliche Trauerspiel, Schillers Kabale und Liebe etwa, ging gegen Günstlingswirtschaft und Mätressenwesen vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "34ac76ec-e04a-32bc-83f5-6cddce98d3c9",
                        "entry_id": "6ae8d8ef-7123-3d7f-a392-a988794da30d",
                        "glosses": [
                            "bedauerliches, beklagenswertes Ereignis"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "33b43494-c005-4ffa-ba5f-5c975c9e920e",
                                "sense_id": "34ac76ec-e04a-32bc-83f5-6cddce98d3c9",
                                "text": "„Wenn man noch einmal das Spiegel -Interview mit Emmanuel Macron sowie seine Europa-Rede in der Sorbonne nachliest und das mit dem Trauerspiel der Jamaika-Sondierungen hierzulande und der fast völligen Abwesenheit von Angela Merkel in der Öffentlichkeit vergleicht, kann man wehmütig werden.“"
                            },
                            {
                                "example_id": "d0b3a05d-1aba-49df-9429-104749b63d29",
                                "sense_id": "34ac76ec-e04a-32bc-83f5-6cddce98d3c9",
                                "text": "„Einer jungen Generation kann man die Geschichte nicht als Trauerspiel nahebringen.“"
                            },
                            {
                                "example_id": "b7e8d25b-67d0-4694-8e4a-efb1dc15418a",
                                "sense_id": "34ac76ec-e04a-32bc-83f5-6cddce98d3c9",
                                "text": "„Die Richter entschieden, dass die Vorinstanz befangen wirke, und beendeten das Trauerspiel.“"
                            },
                            {
                                "example_id": "537f8560-0cb9-4b5d-a0c0-b53a1cef2fc3",
                                "sense_id": "34ac76ec-e04a-32bc-83f5-6cddce98d3c9",
                                "text": "„Es ist ein Trauerspiel, dass Deutschland von einer Kanzlerin regiert wird, die in vielen Bereichen großen Schaden angerichtet hat, und trotzdem, sollte sie wieder antreten, beste Chancen hat, auch nach 2017 Kanzlerin zu bleiben, sagte Wagenknecht der Deutschen Presse-Agentur in Berlin.“"
                            },
                            {
                                "example_id": "e6cfe075-56c2-448a-8811-1d1e8f76d50e",
                                "sense_id": "34ac76ec-e04a-32bc-83f5-6cddce98d3c9",
                                "text": "„Es ist ein Trauerspiel, dass deutsche Unternehmer nicht mehr in der Lage sind, ohne ausländisches Kapital Firmen oder erfolgreiche Verlage wie den Berliner Verlag zu führen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
