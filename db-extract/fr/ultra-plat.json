                "senses": [
                    {
                        "sense_id": "3b1be5e9-8924-31b3-b446-bfc23ec874bc",
                        "entry_id": "ccf6123a-84d7-342e-81ef-ff06321ee379",
                        "glosses": [
                            "Extrêmement plat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e84579d-4b7a-4707-b2f1-f3248ae06196",
                                "sense_id": "3b1be5e9-8924-31b3-b446-bfc23ec874bc",
                                "text": "Victime à l’envers du syndrome de Paris, je m’étais convaincu que la bureautique au Japon devait être total high-tech : ordinateurs ultra-fins et écrans géants ultra-plats, ambiance générale pastel avec reflets fluo."
                            },
                            {
                                "example_id": "b44dc0a9-3852-4531-aa42-8b086b113da0",
                                "sense_id": "3b1be5e9-8924-31b3-b446-bfc23ec874bc",
                                "text": "Régler le clavier, une sorte d’écran ultra-plat trouvé dans un autre carton, un module de saisie - anciennement la souris -, mettre en phase les fréquences de liaison entre ces différents éléments."
                            },
                            {
                                "example_id": "7076d985-63fa-49eb-a63d-58d25656cb29",
                                "sense_id": "3b1be5e9-8924-31b3-b446-bfc23ec874bc",
                                "text": "Les claviers jouent désormais la carte séduction : outre l’aspect design du clavier, compact, plat ou ultra-plat, la disposition des touches droite ou incurvée, en arc de cercle ou en forme de vague est totalement une affaire de goût."
                            }
                        ]
                    }
