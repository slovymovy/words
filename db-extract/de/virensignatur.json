                        "glosses": [
                            "Signatur, die zu Identifizierung von Computerviren genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd8f17b-b23c-4abf-a818-4b5708335465",
                                "sense_id": "8d562c51-a16e-39e5-9efc-4d00f6ef49af",
                                "text": "Die Virensignaturen sollten täglich auf den neuesten Stand gebracht werden."
                            },
                            {
                                "example_id": "a74ceefe-59f0-40a9-9528-b0036c237548",
                                "sense_id": "8d562c51-a16e-39e5-9efc-4d00f6ef49af",
                                "text": "„Die Aktualisierung von Virensignaturen ist - genauso wie auch das regelmäßige Einspielen von Sicherheitsupdates des Betriebssystems - unbedingt erforderlich, da Viren und Würmer ständig in neuen Variationen auftreten.“"
                            }
                        ],
