{
    "word_family": [
        "zeerheid",
        "bezeren",
        "zeerdoen"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8fda2686-d3f1-336e-90f5-50cd06575d70",
                    "sense_definition": "in hoge mate of intensiteit",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is vandaag <w>zeer</w> koud buiten.",
                            "target_lang_translations": {
                                "en": "It is <w>very</w> cold outside today.",
                                "ru": "Сегодня на улице <w>очень</w> холодно."
                            }
                        },
                        {
                            "text": "Zijn antwoord op de vraag was <w>zeer</w> goed.",
                            "target_lang_translations": {
                                "en": "His answer to the question was <w>very</w> good.",
                                "ru": "Его ответ на вопрос был <w>очень</w> хорошим."
                            }
                        }
                    ],
                    "antonyms": [
                        "weinig"
                    ],
                    "common_phrases": [
                        "zeer goed",
                        "zeer waarschijnlijk"
                    ],
                    "target_lang_definitions": {
                        "en": "to a high degree or intensity",
                        "ru": "в высокой степени или интенсивности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "very",
                                "target_lang_sense_clarification": "to a great extent or degree"
                            },
                            {
                                "target_lang_word": "greatly",
                                "target_lang_sense_clarification": "to a great extent, often used with verbs"
                            },
                            {
                                "target_lang_word": "highly",
                                "target_lang_sense_clarification": "to a high level or degree"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "в большой степени"
                            },
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "в чрезвычайной степени"
                            },
                            {
                                "target_lang_word": "весьма",
                                "target_lang_sense_clarification": "в значительной степени, более формально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6dfeeb0-c84e-3e64-9d22-6232c78e04c4",
                    "sense_definition": "op een pijnlijke manier, vooral gebruikt in de uitdrukking 'zeer doen'",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn knie doet <w>zeer</w> na de val.",
                            "target_lang_translations": {
                                "en": "My knee <w>hurts</w> after the fall.",
                                "ru": "Мое колено <w>болит</w> после падения."
                            }
                        },
                        {
                            "text": "Die opmerking kan iemand erg <w>zeer</w> doen.",
                            "target_lang_translations": {
                                "en": "That remark can <w>hurt</w> someone a lot.",
                                "ru": "Это замечание может сделать человеку очень <w>больно</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zeer doen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a painful manner, especially used in the expression 'to hurt'",
                        "ru": "болезненным образом, особенно в выражении «причинять боль»"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurt",
                                "target_lang_sense_clarification": "to cause or feel physical pain"
                            },
                            {
                                "target_lang_word": "painful",
                                "target_lang_sense_clarification": "causing physical discomfort or suffering"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "больно",
                                "target_lang_sense_clarification": "ощущение физической боли"
                            },
                            {
                                "target_lang_word": "болеть",
                                "target_lang_sense_clarification": "в составе выражения 'zeer doen' (болеть/причинять боль)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c10caeed-2f0e-3bc0-9530-cd72b3dfc2cf",
                    "sense_definition": "lichamelijk pijnlijk of gevoelig",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft een <w>zere</w> keel door de verkoudheid.",
                            "target_lang_translations": {
                                "en": "He has a <w>sore</w> throat because of the cold.",
                                "ru": "У него <w>больное</w> горло из-за простуды."
                            }
                        },
                        {
                            "text": "Ik kan niet lopen met die <w>zere</w> voet.",
                            "target_lang_translations": {
                                "en": "I cannot walk with that <w>sore</w> foot.",
                                "ru": "Я не могу ходить с этой <w>больной</w> ногой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zere keel",
                        "zere plek"
                    ],
                    "target_lang_definitions": {
                        "en": "physically painful or sensitive",
                        "ru": "физически болезненный или чувствительный"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sore",
                                "target_lang_sense_clarification": "painful or aching, often due to injury or infection"
                            },
                            {
                                "target_lang_word": "painful",
                                "target_lang_sense_clarification": "affected by pain"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "больной",
                                "target_lang_sense_clarification": "вызывающий боль или воспаленный"
                            },
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "чувствительный к прикосновению или движению"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07234933-814f-3139-931e-6f0cd6f68ef6",
                    "sense_definition": "een lichamelijke pijn of kwetsuur",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>zeer</w> in zijn rug werd steeds erger.",
                            "target_lang_translations": {
                                "en": "The <w>pain</w> in his back became increasingly worse.",
                                "ru": "<w>Боль</w> в его спине становилась всё сильнее."
                            }
                        },
                        {
                            "text": "Zij klaagde over een aanhoudend <w>zeer</w> in haar zij.",
                            "target_lang_translations": {
                                "en": "She complained about a persistent <w>ache</w> in her side.",
                                "ru": "Она жаловалась на постоянную <w>боль</w> в боку."
                            }
                        }
                    ],
                    "synonyms": [
                        "pijn",
                        "kwetsuur"
                    ],
                    "target_lang_definitions": {
                        "en": "a physical pain or injury",
                        "ru": "физическая боль или травма"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pain",
                                "target_lang_sense_clarification": "physical suffering or discomfort"
                            },
                            {
                                "target_lang_word": "ache",
                                "target_lang_sense_clarification": "a continuous or prolonged dull pain"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "боль",
                                "target_lang_sense_clarification": "физическое страдание"
                            },
                            {
                                "target_lang_word": "рана",
                                "target_lang_sense_clarification": "повреждение тканей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08144ee7-8a8a-3cce-84ce-3c5fd7f3e5a5",
                    "sense_definition": "geestelijk lijden of verdriet",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het verlies van zijn hond deed hem veel <w>zeer</w>.",
                            "target_lang_translations": {
                                "en": "The loss of his dog caused him much <w>sorrow</w>.",
                                "ru": "Потеря собаки причинила ему много <w>боли</w>."
                            }
                        },
                        {
                            "text": "Zij probeerde haar innerlijke <w>zeer</w> te verbergen voor de anderen.",
                            "target_lang_translations": {
                                "en": "She tried to hide her inner <w>pain</w> from the others.",
                                "ru": "Она пыталась скрыть свою внутреннюю <w>боль</w> от других."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "mental suffering or grief",
                        "ru": "душевное страдание или горе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "a feeling of deep distress caused by loss or disappointment"
                            },
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "intense sorrow, especially caused by someone's death"
                            },
                            {
                                "target_lang_word": "pain",
                                "target_lang_sense_clarification": "emotional or mental distress"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "боль",
                                "target_lang_sense_clarification": "эмоциональное страдание"
                            },
                            {
                                "target_lang_word": "горе",
                                "target_lang_sense_clarification": "глубокая печаль"
                            },
                            {
                                "target_lang_word": "страдание",
                                "target_lang_sense_clarification": "мучительное переживание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
