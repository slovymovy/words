                ],
                "senses": [
                    {
                        "sense_id": "d61da2ef-f5c0-3ec2-b425-db0896473bcb",
                        "entry_id": "ca6dea15-a4a7-378d-b4ad-14e9011c76cb",
                        "glosses": [
                            "Provoquer des traumatismes multiples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf8bf0e-9a39-43fd-8c16-ce7eace41c7c",
                                "sense_id": "d61da2ef-f5c0-3ec2-b425-db0896473bcb",
                                "text": "Je n'ai jamais trop compris le plaisir qu'on peut ressentir à se polytraumatiser le corps en courant comme ça, surtout si c'est pour aller d'un point au même point."
                            },
                            {
                                "example_id": "0373492e-4076-470e-89d2-d9c930b27a69",
                                "sense_id": "d61da2ef-f5c0-3ec2-b425-db0896473bcb",
                                "text": "A tel point que je m’interrogeais, piteuse après cet échec, sur la nécessité de me polytraumatiser afin qu’il daigne poser sur moi ses mains d’interne d’ortho en premier semestre."
                            },
                            {
                                "example_id": "f3e57518-ce5f-4f70-b3a4-3ec17e650806",
                                "sense_id": "d61da2ef-f5c0-3ec2-b425-db0896473bcb",
                                "text": "Voici donc 38 questions qui ont pour but de raviver les souvenirs, de susciter la curiosité et éventuellement de polytraumatiser les amateurs de Robert Altman."
                            },
                            {
                                "example_id": "d2741d05-22ef-463f-b415-c9a208335880",
                                "sense_id": "d61da2ef-f5c0-3ec2-b425-db0896473bcb",
                                "text": "Les ardillons écrasés permettent donc une meilleure décroche mais du coup risquent également de polytraumatiser la truite si celle-ci est vive...."
                            }
                        ]
                    }
                ],
