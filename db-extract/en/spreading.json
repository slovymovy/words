                                "target_senses": [
                                    {
                                        "sense_id": "c9a6ef78-3df4-343e-8661-82987daed958",
                                        "entry_id": "5512200e-b3d2-3b54-b73f-237fa8c0d558",
                                        "glosses": [
                                            "Vorgang des Verteilens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca128ffb-d91d-4b45-93ed-967387b9a0ac",
                                                "sense_id": "c9a6ef78-3df4-343e-8661-82987daed958",
                                                "text": "Es wird langsam Zeit für die Verteilung der Prospekte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dae9c0a5-1066-3193-a92e-adf5812b0d57",
                                        "entry_id": "5512200e-b3d2-3b54-b73f-237fa8c0d558",
                                        "glosses": [
                                            "Ergebnis des Verteilens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f726782a-ad1b-4c97-936b-b7c673cf1978",
                                                "sense_id": "dae9c0a5-1066-3193-a92e-adf5812b0d57",
                                                "text": "In der Bundesrepublik gibt es eine sehr ungleiche Verteilung der Vermögen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                        "entry_id": "5512200e-b3d2-3b54-b73f-237fa8c0d558",
                                        "glosses": [
                                            "Anordnung der Gegenstände eines Gegenstandsbereichs entsprechend einem bestimmten Prinzip"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4171a011-9239-40cf-8524-21cdc6e77ef1",
                                                "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                                "text": "„Eine weitere Größe einer jeden Verteilung ist die sogenannte Streuung.“"
                                            },
                                            {
                                                "example_id": "cc6c36f0-0432-4985-904d-f4fba6988288",
                                                "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                                "text": "„Im vorhergehenden Abschnitt wurde dargestellt, daß ein Überblick über eine Verteilung durch den Mittelwert und die Streuung erhalten werden kann.“"
                                            },
                                            {
                                                "example_id": "947c0479-52b2-4cea-adde-246cfbe2c5d6",
                                                "sense_id": "9560fcbd-7068-3fe3-b3ea-823adb7f2099",
                                                "text": "„Man kann Verteilungen nicht nur für rhythmische Erscheinungen aufstellen, sondern für alles, was variabel ist, und daher ergibt sich hier ein breites Forschungsfeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a34629de-a6c0-4849-8af9-541430ed9211",
                        "source_entry_id": "01785eaa-863e-3efd-aaee-98584d484a24",
                        "source_sense_id": "6b6777bf-5469-3789-9c2d-d5e34a83e26a",
                        "source_sense_description": "act by which something is spread",
                        "target_lang_word": "Verbreiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbreiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7072fe2b-60aa-37ae-a7fc-aebaa13ce737",
                                        "entry_id": "c70b6009-6984-39ee-9786-2c24bc6eaa8b",
                                        "glosses": [
                                            "das Verteilen (unter vielen Menschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488aa7b8-b5e5-463a-9ff8-6ef923aa40a7",
                                                "sense_id": "7072fe2b-60aa-37ae-a7fc-aebaa13ce737",
                                                "text": "„Für das Verbreiten von Fotos ist dagegen auf die Regelungen des KUG zurückzugreifen (siehe oben II.1.2).“"
                                            },
                                            {
                                                "example_id": "46a271aa-d973-41e1-a5ae-7387457e4d2b",
                                                "sense_id": "7072fe2b-60aa-37ae-a7fc-aebaa13ce737",
                                                "text": "„Das Verbreiten des Schreckens zählt zu den Mitteln römischer Selbsterhaltung; denn es dämpft die Kampfleidenschaft der Barbaren und bricht ihren wilden Mut.“"
                                            },
                                            {
                                                "example_id": "a8e28628-e4f7-40ee-9e31-414acaca4c69",
                                                "sense_id": "7072fe2b-60aa-37ae-a7fc-aebaa13ce737",
                                                "text": "„Ein Verbreiten der Seuche durch Zusammenhalten der Tiere findet erfahrungsgemäß nicht statt, deshalb kann die Ansteckung auch nicht durch Inhalation erfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7b5c4d7-5e27-4104-926f-47aa709d8ae2",
                        "source_entry_id": "01785eaa-863e-3efd-aaee-98584d484a24",
                        "source_sense_id": "6b6777bf-5469-3789-9c2d-d5e34a83e26a",
                        "source_sense_description": "act by which something is spread",
                        "target_lang_word": "Verbreitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbreitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                        "entry_id": "0b27632f-26b6-3fb4-9329-d2e12f1fbdf0",
                                        "glosses": [
                                            "die (bewusste oder unbewusste) Handlung des Verbreitens; eine Sache weitergeben und somit vervielfachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b4f0b6-5c79-4bf6-9b79-f0df5951eafe",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "Die Verbreitung von pornographischen Dateien ist nicht erlaubt."
                                            },
                                            {
                                                "example_id": "e97490e3-4348-4b0d-8bee-7e689898a1d6",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "Die Verbreitung der Krankheit muss schnellstmöglich verhindert werden."
                                            },
                                            {
                                                "example_id": "1c624f3f-8a1b-4753-920e-3eb7459a874f",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Ein CIA-Spion, der schon zwanzig Jahre dabei war, hatte mitgeholfen, die Verbreitung von Massenvernichtungswaffen zu verhindern.“"
                                            },
                                            {
                                                "example_id": "de144ce8-1e0c-47c1-b6b5-8c0f2794023e",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                                            },
                                            {
                                                "example_id": "a337cf52-53c4-4431-b443-bc46cc98fa7b",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Doch mit Zensur und Zeitungsverboten konnte die Verbreitung der Nachrichten aus Österreich natürlich nicht unterbunden werden.“"
                                            },
                                            {
                                                "example_id": "c561c365-20e5-417d-ac2a-117e69668242",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Flächendeckende Verbreitung erfuhr es dann durch die Pornoindustrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                        "entry_id": "0b27632f-26b6-3fb4-9329-d2e12f1fbdf0",
                                        "glosses": [
                                            "der Zustand, in einem bestimmtem Raum oder in einem gewissen Maße verbreitet zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a506a9-1007-4e97-b0f7-a141b186b735",
                                                "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                                "text": "„Bei einer so weiten Verbreitung ist es kein Wunder, dass auch Prominente betroffen sind.“"
                                            },
                                            {
                                                "example_id": "c0a20a7a-d07e-432c-9cd7-faad5c4ba546",
                                                "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                                "text": "„Die Verbreitung von Cannabis ist in den Niederlanden sogar geringer als in Ländern, die eine repressive Drogenpolitik verfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
