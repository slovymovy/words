                    },
                    {
                        "sense_id": "a2942011-2b9a-3e7b-b1e1-a051eed070bb",
                        "entry_id": "f56f4425-bec3-383e-aa28-d4c2aaeedecd",
                        "glosses": [
                            "Not having a term."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "88d208c2-52bd-4deb-86df-1fbd28d10d9a",
                                "sense_id": "a2942011-2b9a-3e7b-b1e1-a051eed070bb",
                                "text": "This is not a contradiction since an uninhabited type has no complete terms and a probability distribution over an empty type is ill defined anyway."
                            },
                            {
                                "example_id": "0a6a5e90-1c93-429c-9234-e50628225b15",
                                "sense_id": "a2942011-2b9a-3e7b-b1e1-a051eed070bb",
                                "text": "Unlike Null, Nothing has no instances. We say the type is uninhabited."
                            }
                        ]
                    }
                ],
