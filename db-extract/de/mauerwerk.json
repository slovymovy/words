                                                "sense_id": "b898872f-b78c-3de3-95f3-c25fd8096428",
                                                "text": "The masonry was exquisite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6c27fc6-9415-3a45-b7f1-c5fe5ababcc8",
                                        "entry_id": "3660ccc8-0e93-37bf-bec7-7fdd0e3080e8",
                                        "glosses": [
                                            "That which is built by a mason; anything constructed of the materials used by masons, such as stone, brick, tiles, or the like."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5587b11-862e-41f0-bb8d-c9ffafd26c22",
                                                "sense_id": "b6c27fc6-9415-3a45-b7f1-c5fe5ababcc8",
                                                "text": "The masonry was cracked."
                                            },
                                            {
                                                "example_id": "0a993c56-faf0-49f2-8461-4d663d68a5be",
                                                "sense_id": "b6c27fc6-9415-3a45-b7f1-c5fe5ababcc8",
                                                "text": "Many houses built between the Civil War and 1940 have masonry walls, usually of brick, with the inside surfaces covered by a layer of plaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c315329-dfa2-3ec5-8343-33bbd106e5cd",
