    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ffb6a53f-5ab0-30dd-898c-33f71eeef528",
                "word": "citified",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ec6af7b9-3076-4437-9285-e52af1709550",
                        "entry_id": "ffb6a53f-5ab0-30dd-898c-33f71eeef528",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more citified"
                    },
                    {
                        "form_id": "546f7127-40ef-4183-a638-d6052b62e367",
                        "entry_id": "ffb6a53f-5ab0-30dd-898c-33f71eeef528",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most citified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                        "entry_id": "ffb6a53f-5ab0-30dd-898c-33f71eeef528",
                        "glosses": [
                            "Characteristic of the sophisticated customs or dress associated with city life."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11170f4-90e8-4b62-bc51-09a9cddf814e",
                                "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                                "text": "1794, quoted in 2009, Gordon S. Wood, Empire of Liberty: A History of the Early Republic, 1789-1815,\nNew York is less citified than Philadelphia."
                            },
                            {
                                "example_id": "75bfe73f-b291-4468-896e-4f32c9166c99",
                                "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                                "text": "It was not much more citified than it was countrified."
                            },
                            {
                                "example_id": "2d633165-4a10-490c-9bf1-c03886a34c39",
                                "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                                "text": "Isn't he handsome? Isn't he a man of the world? Isn't he citified?"
                            },
                            {
                                "example_id": "c1368ed1-a932-4fa4-b804-84301f3cb16b",
                                "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                                "text": "As the countryside becomes more and more citified and farming more and more specialized, motorized and businesslike, I suppose that the farmer's mental scope and habits will become more like mine."
                            },
                            {
                                "example_id": "8037e7a1-aba5-43de-806b-082719d87d10",
                                "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                                "text": "But he's citified and holds his cup just right and never has to think about it."
                            },
                            {
                                "example_id": "dbf5f3b9-33ee-42e6-baa5-2a504aa5dcfe",
                                "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                                "text": "The people in this city call me country / Because of how I walk and talk and smile / Well, I don't mind them laughing in the city / But the country folks all say I'm citified"
                            },
                            {
                                "example_id": "6ec040bb-1bb0-4c8e-a995-5a6c405a75ea",
                                "sense_id": "65a3fd76-f6b2-305d-a976-d46c4cb5ff5e",
                                "text": "She is a citified young woman, and the more citified people are the more difficult it is to ask and get answers to personal questions."
                            }
                        ]
                    }
                ],
