                "translations": [
                    {
                        "translation_id": "0e418350-41de-42c4-ba13-bf7ddec252bd",
                        "source_entry_id": "fe7490c9-1b5b-3366-b65e-da09f1bad0f9",
                        "source_sense_id": "d2ac69ae-f995-3b71-866a-72a482cbd15c",
                        "source_sense_description": "Person, die unter der Vormundschaft eines gesetzlich eingesetzten Pflegers steht",
                        "target_lang_word": "ward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a797ccb9-f6c6-3515-b5ca-c160647ddbd9",
                                        "entry_id": "d7344f4a-809c-3cc6-b8b3-dd3608196c98",
                                        "glosses": [
                                            "A warden; a guard; a guardian or watchman."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff05fe7d-04c4-4b57-9f04-40f8b5090f04",
                                                "sense_id": "a797ccb9-f6c6-3515-b5ca-c160647ddbd9",
                                                "text": "th'aſſieged Caſtles ward\nTheir ſtedfaſt ſtonds did mightily maintaine"
                                            },
                                            {
                                                "example_id": "f09652fe-71d0-4ba7-bdfd-39dfdd58bd09",
                                                "sense_id": "a797ccb9-f6c6-3515-b5ca-c160647ddbd9",
                                                "text": "no gate they found, them to withhold,\n Nor ward to wait at morne and euening late […]."
                                            },
                                            {
                                                "example_id": "5a1bfa33-882c-43b0-b23c-d198ffc4c003",
                                                "sense_id": "a797ccb9-f6c6-3515-b5ca-c160647ddbd9",
                                                "text": "there is remuneration for the best ward of mine"
                                            },
                                            {
                                                "example_id": "ad0040fa-9515-4fff-9f7e-5f8351dcc54e",
                                                "sense_id": "a797ccb9-f6c6-3515-b5ca-c160647ddbd9",
                                                "text": "For want of other ward,\nHe lifted up his hand, his front to guard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33bdfe95-326e-31e4-987d-582ae4b2c657",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "Protection, defence.",
                                            "The action of a watchman; monitoring, surveillance (usually in phrases keep ward etc.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31078a55-99bd-463b-a68d-6d866019b490",
                                                "sense_id": "33bdfe95-326e-31e4-987d-582ae4b2c657",
                                                "text": "Before the dore ſat ſelfe-conſuming Care,\nDay and night keeping wary watch and ward,\nFor feare leaſt Force or Fraud ſhould vnaware\nBreake in[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9aa4250-e8ae-3ece-9b44-9034d6b3d208",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "Protection, defence.",
                                            "Guardianship, especially of a child or prisoner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357c18d6-4857-4cf1-938a-cfd91380ea98",
                                                "sense_id": "d9aa4250-e8ae-3ece-9b44-9034d6b3d208",
                                                "text": "So forth the presoners were brought before Arthure, and he commaunded hem into kepyng of the conestabyls warde, surely to be kepte as noble presoners."
                                            },
                                            {
                                                "example_id": "f23bd1af-a39d-4321-a5b7-db853af6fe1e",
                                                "sense_id": "d9aa4250-e8ae-3ece-9b44-9034d6b3d208",
                                                "text": "I must attend his majesty's command, to whom I am now in ward."
                                            },
                                            {
                                                "example_id": "2b727d68-2695-4848-bbf2-ffd852464a5d",
                                                "sense_id": "d9aa4250-e8ae-3ece-9b44-9034d6b3d208",
                                                "text": "It is also inconvenient, in Ireland, that the wards and marriages of gentlemen's children should be in the disposal of any of those lords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7efcf893-7fc6-3d1e-9a43-0fee1b50c0ac",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "Protection, defence.",
                                            "An enchantment or spell placed over a designated area or social unit, that prevents any tresspasser from entering; approaching; or even being able to locate said protected premises or demographic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10e65b09-9588-3933-80b9-d8c7a16dc7d5",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "Protection, defence.",
                                            "A guarding or defensive motion or position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81170b06-4496-4893-ab6e-3257f71ae4f9",
                                                "sense_id": "10e65b09-9588-3933-80b9-d8c7a16dc7d5",
                                                "text": "Thou knowest my old ward; here I lay, and thus I bore my point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "186cf50e-8761-37f0-9421-645772bc90fa",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "Protection, defence.",
                                            "Land tenure through military service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea921cb0-e3dc-35eb-8158-d409baf4900d",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A protected place, and by extension, a type of subdivision.",
                                            "An area of a castle, corresponding to a circuit of the walls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f293320c-d29c-4006-ad9d-7855ef03feb6",
                                                "sense_id": "ea921cb0-e3dc-35eb-8158-d409baf4900d",
                                                "text": "Diocletian[…]must certainly have derived some consolation from the grandeur of Aspalaton, the great arcaded wall it turned to the Adriatic, its four separate wards, each town size, and its seventeen watch-towers[…]."
                                            },
                                            {
                                                "example_id": "e03e2038-4d39-4581-a36d-258d562be9eb",
                                                "sense_id": "ea921cb0-e3dc-35eb-8158-d409baf4900d",
                                                "text": "With the castle so crowded, the outer ward had been given over to guests to raise their tents and pavilions, leaving only the smaller inner yards for training."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159ff142-32d8-39dc-817f-121c9e18c56c",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A protected place, and by extension, a type of subdivision.",
                                            "A section or subdivision of a prison."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97529a41-5af1-3dbb-9fc9-a5193fb62432",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A protected place, and by extension, a type of subdivision.",
                                            "An administrative division of a borough, city or council."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e91b75a-7aff-456d-9acd-6138df1e9265",
                                                "sense_id": "97529a41-5af1-3dbb-9fc9-a5193fb62432",
                                                "text": "On our last visit to Tokyo, we went to Chiyoda ward and visited the Emperor's palace."
                                            },
                                            {
                                                "example_id": "7b1de3bd-64d5-4931-94a5-ac8ce955ef2b",
                                                "sense_id": "97529a41-5af1-3dbb-9fc9-a5193fb62432",
                                                "text": "Throughout the trembling city placed a guard,\nDealing an equal share to every ward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c3c797b-6e10-35d1-8a57-d2233effd27e",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A protected place, and by extension, a type of subdivision.",
                                            "A division of a forest."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45adec7b-b2d8-3bae-ba51-5c8ecb4a5ef1",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A protected place, and by extension, a type of subdivision.",
                                            "A subdivision of the LDS Church, smaller than and part of a stake, but larger than a branch."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d67b387-b791-3909-a367-131819cb29cd",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A protected place, and by extension, a type of subdivision.",
                                            "A part of a hospital, with beds, where patients reside."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fccd7f2a-1fc5-49c4-90f1-57910de7d2b7",
                                                "sense_id": "9d67b387-b791-3909-a367-131819cb29cd",
                                                "text": "Since sick people were apt to be present, he could not always depend on a lively young crowd in the same ward with him, and the entertainment was not always good."
                                            },
                                            {
                                                "example_id": "94f31a7d-2db1-46a8-a38e-fd65dc6f6bbb",
                                                "sense_id": "9d67b387-b791-3909-a367-131819cb29cd",
                                                "text": "Many hospitals have not taken simple steps to lessen the distress and confusion which dementia sufferers' often feel on being somewhere so unfamiliar – such as making signs large and easy to read, using colour schemes to help patients find their way around unfamiliar wards and not putting family mementoes such as photographs nearby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6fde35c-e34b-319a-80cb-2d8ff1d5ba63",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A person under guardianship.",
                                            "A minor looked after by a guardian."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "650c769f-065e-4f36-b79b-25bf31e10765",
                                                "sense_id": "b6fde35c-e34b-319a-80cb-2d8ff1d5ba63",
                                                "text": "After the trial, little Robert was declared a ward of the state."
                                            },
                                            {
                                                "example_id": "d2c78514-b5ce-4210-ab7c-7728d7842b43",
                                                "sense_id": "b6fde35c-e34b-319a-80cb-2d8ff1d5ba63",
                                                "text": "Not unnaturally, “Auntie” took this communication in bad part. Thus outraged, she showed herself to be a bold as well as a furious virago. Next day she found her way to their lodgings and tried to recover her ward by the hair of the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e282d53-1d72-3a60-821d-5af8820b17fe",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "A person under guardianship.",
                                            "An underage orphan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24712ba6-dda9-3173-a060-7f01f33d1d2e",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "An object used for guarding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b806a6a-d98c-3497-a559-97ca1ecaf783",
                                        "entry_id": "f04a76e5-1850-3940-b2ec-37d92a218249",
                                        "glosses": [
                                            "An object used for guarding.",
                                            "The ridges on the inside of a lock, or the incisions on a key."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a36415c-8072-4dcc-a0ec-62f999884556",
                                                "sense_id": "7b806a6a-d98c-3497-a559-97ca1ecaf783",
                                                "text": "A man muſt thorowly ſound himſelfe, and dive into his heart, and there ſee by what wards or ſprings the motions ſtirre."
                                            },
                                            {
                                                "example_id": "a37aec0b-0a57-4f5a-bcdf-3da03f69fc14",
                                                "sense_id": "7b806a6a-d98c-3497-a559-97ca1ecaf783",
                                                "text": "1852–1854, Charles Tomlinson, Cyclopaedia of Useful Arts and Manufactures\nThe lock is made […] more secure by attaching wards to the front, as well as to the back, plate of the lock, in which case the key must be furnished with corresponding notches."
                                            },
                                            {
                                                "example_id": "280e558d-b523-4298-a2b5-39c1720892b5",
                                                "sense_id": "7b806a6a-d98c-3497-a559-97ca1ecaf783",
                                                "text": "With the help of a wire, however, they forced round the key. Even without the lens you will perceive, by the scratches on this ward, where the pressure was applied."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e240cd59-9269-3333-ae64-e5b01c5754bb",
                                        "entry_id": "dc718f46-0b59-3421-b0b2-0432d85c02ba",
                                        "glosses": [
                                            "To keep in safety, to watch over, to guard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3437c20-f35b-4c2e-ad77-a13d503610b5",
                                                "sense_id": "e240cd59-9269-3333-ae64-e5b01c5754bb",
                                                "text": "Whoſe gates he found faſt ſhut, ne liuing wight\nTo ward the ſame, nor anſwere commers call"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86890b03-f8e5-3708-af16-39c4c7f9284c",
                                        "entry_id": "dc718f46-0b59-3421-b0b2-0432d85c02ba",
                                        "glosses": [
                                            "To defend, to protect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d91f4bd-1e19-4447-b90b-50093536ec66",
                                                "sense_id": "86890b03-f8e5-3708-af16-39c4c7f9284c",
                                                "text": "Tell him it was a hand that warded him\nFrom a thousand dangers."
                                            },
                                            {
                                                "example_id": "ef12d103-b273-4afb-929a-b2790afe48f9",
                                                "sense_id": "86890b03-f8e5-3708-af16-39c4c7f9284c",
                                                "text": "they went to ſeeke their owne death, and ruſhed amidſt the thickeſt of their enemies, with an intention, rather to ſtrike, than to ward themſelves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8803d14f-846a-347d-a752-b2d473beab4b",
                                        "entry_id": "dc718f46-0b59-3421-b0b2-0432d85c02ba",
                                        "glosses": [
                                            "To fend off, to repel, to turn aside, as anything mischievous that approaches. (usually followed by off)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "320f54c7-0691-4dbc-9a1b-379b203b1a18",
                                                "sense_id": "8803d14f-846a-347d-a752-b2d473beab4b",
                                                "text": "Draw forth thy ſword, thou mightie man at armes,\nIntending but to raiſe my charmed ſkin:\nAnd Ioue himſelfe will ſtretch his hand from heauen,\nTo ward the blow, and ſhield me ſafe from harme, […]"
                                            },
                                            {
                                                "example_id": "37a613fa-4b17-4f77-8724-4a041afff8ea",
                                                "sense_id": "8803d14f-846a-347d-a752-b2d473beab4b",
                                                "text": "Now wards a felling blow, now strikes again."
                                            },
                                            {
                                                "example_id": "0b2bcb21-5350-4406-abaf-9ff8117ac617",
                                                "sense_id": "8803d14f-846a-347d-a752-b2d473beab4b",
                                                "text": "The pointed javelin warded off his rage."
                                            },
                                            {
                                                "example_id": "7c79ed70-b7c1-41fd-acf9-797d22263c16",
                                                "sense_id": "8803d14f-846a-347d-a752-b2d473beab4b",
                                                "text": "It instructs the scholar in the various methods of warding off the force of objections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e35d7c5e-5801-304d-985e-6aa0f409becb",
                                        "entry_id": "dc718f46-0b59-3421-b0b2-0432d85c02ba",
                                        "glosses": [
                                            "To be vigilant; to keep guard."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eda7dc40-7c94-4045-ae84-223821444be9",
                                                "sense_id": "e35d7c5e-5801-304d-985e-6aa0f409becb",
                                                "text": "They for vs fight, they watch and dewly ward,\nAnd their bright Squadrons round about vs plant […]"
                                            },
                                            {
                                                "example_id": "5853e6a4-f0e1-4327-be09-32baf3d0df4a",
                                                "sense_id": "e35d7c5e-5801-304d-985e-6aa0f409becb",
                                                "text": "Having slapped into middle age, where thoughts of one’s general infallibility are tempered by the realisation that those creaky, achy complaints are signs of certain decrepitude, I have decided to ward against further gravitational decline by hauling my saggy, sorry self to the gym."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5c4a65b-3e55-39cf-87a0-acc3d14ccb87",
                                        "entry_id": "dc718f46-0b59-3421-b0b2-0432d85c02ba",
                                        "glosses": [
                                            "To act on the defensive with a weapon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
