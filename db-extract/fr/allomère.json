                                        "entry_id": "11369a07-ed45-3641-83ac-6c5579853cb0",
                                        "glosses": [
                                            "A human or other creature that provides some maternal care for the young born of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c5854fc-5aa8-4060-9516-85848c2bdaf1",
                                                "sense_id": "86f29c33-9cca-3580-964d-f2a6ba6a8d13",
                                                "text": "Within hours of birth, baby langurs are spirited away from their mothers. They spend up to 50 percent of daylight hours passed from allomother to allomother"
                                            },
                                            {
                                                "example_id": "f0f8981b-39fd-4fa4-8306-f6493ca702a7",
                                                "sense_id": "86f29c33-9cca-3580-964d-f2a6ba6a8d13",
                                                "text": "Among the !Kung foragers of the Kalahari, babies are held by a father, grandmother, older sibling or some other allomother maybe 25 percent of the time."
                                            }
                                        ]
                                    }
