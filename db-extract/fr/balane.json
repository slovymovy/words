                "senses": [
                    {
                        "sense_id": "8371bc53-b13d-3ae2-ac4e-19ce368e09f8",
                        "entry_id": "7d58f2a4-d66e-3c1c-9860-98678302de4e",
                        "glosses": [
                            "Petit crustacé qui se fixe habituellement sur les rochers ou les coquillages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc42618-2184-49f3-b36f-9f0709e4a1b6",
                                "sense_id": "8371bc53-b13d-3ae2-ac4e-19ce368e09f8",
                                "text": "Les turbo, les buccins à la teinte brune ou blanchâtre, les rissoa à la petite coquille roulée en cornet, les balanes au test pyramidal, couvraient le dehors des rochers."
                            },
                            {
                                "example_id": "a81d1d3b-da1a-406b-95c3-64489506a731",
                                "sense_id": "8371bc53-b13d-3ae2-ac4e-19ce368e09f8",
                                "text": "On trouve en Bretagne des anatifes cramponnés en colonies serrées au bas des à-pics rocheux sans cesse battus par les vagues. Ces étranges crustacés cirripèdes sont de lointains cousins des minuscules balanes."
                            },
                            {
                                "example_id": "1d1806c0-5cf8-4d41-9d4a-706bc6df5016",
                                "sense_id": "8371bc53-b13d-3ae2-ac4e-19ce368e09f8",
                                "text": "Il pourrait également s’agir d’une nouvelle espèce d’éponge marine, de corail ou de balane du Pacifique, une sorte de petit crustacé."
                            }
                        ]
                    }
                ],
