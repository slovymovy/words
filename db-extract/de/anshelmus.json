                        "examples": [
                            {
                                "example_id": "ef961c4b-1a63-4fb5-b3d2-f20eb8cdf9e7",
                                "sense_id": "5c878484-5eda-3aa1-837f-8022b4eee963",
                                "text": "„Eine Urkunde von 1127 nennt einen Anshelmus de Tannicka als Besitzer oder Verwalter; deshalb wird der Anfang des 12. Jahrhunderts als Erbauungszeit der Burg vermutet.“"
                            },
                            {
                                "example_id": "47f2c353-d3ee-451c-b7dd-872799be2735",
                                "sense_id": "5c878484-5eda-3aa1-837f-8022b4eee963",
                                "text": "„Wohl auf gütlichem Wege, wie es die Circumskriptionsurkunde von 1243 zunächst bestimmte […] hatte sich Anshelmus mit dem Orden über seinen Antheil geeinigt;“"
                            },
                            {
                                "example_id": "42fc0b48-fcea-469d-bb6b-02ae3f7a5f13",
                                "sense_id": "5c878484-5eda-3aa1-837f-8022b4eee963",
                                "text": "„Anshelmus gab hierauf einen Mittler zwischen den beyden Brüdern ab, und brachte auch wůrklich einen Frieden zuwege […].“ (1749)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
