                        ],
                        "examples": [
                            {
                                "example_id": "fb047458-f163-4249-ac5a-5f0d94a1a502",
                                "sense_id": "19be527b-7af0-3034-b45b-07a5078edd56",
                                "text": "I gave them account of what I had seen of the case, of my opinion concerning the irreducibility of the rupture, and that it had no share in the present complaint; at the same time desiring my colleague to examine for himself."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8f353d2-e8db-3fe0-96e6-8f159ddc8ee2",
                        "entry_id": "deb55863-117d-3ad0-9627-9fdbab8adc34",
                        "glosses": [
                            "Something that is irreducible."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ee99b463-133e-4431-a7a4-29956486a551",
                                "sense_id": "d8f353d2-e8db-3fe0-96e6-8f159ddc8ee2",
                                "text": "There is plebs in bodies, in souls, in individuals, in the proletariat, in the bourgeoisie, but everywhere in a diversity of forms and extensions, of energies and irreducibilities."
                            }
                        ]
                    }
