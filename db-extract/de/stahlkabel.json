                        "examples": [
                            {
                                "example_id": "514c759e-2c1a-4552-ad29-67d36b555907",
                                "sense_id": "c4077f10-405d-3725-80a4-bec1d9ef356d",
                                "text": "„Das dicke Stahlkabel ächzte, bis der Mercedes gut fünf Meter über dem Boden schwebte und auf die Müllpresse zuschwebte.“"
                            },
                            {
                                "example_id": "a6a4e05c-8925-4862-b6a2-007a48e01cb3",
                                "sense_id": "c4077f10-405d-3725-80a4-bec1d9ef356d",
                                "text": "„›Es war unter Wasser am Boden befestigt. Und es ist ein Stahlkabel, das können sie unmöglich durchgeschnitten haben.‹“"
                            },
                            {
                                "example_id": "35836971-a6c3-4758-9501-4b0e5f98614d",
                                "sense_id": "c4077f10-405d-3725-80a4-bec1d9ef356d",
                                "text": "„Aus der Nähe wirkten die Stahlkabel, die er vorher nur von Weitem gesehen hatte, noch dünner und instabiler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
