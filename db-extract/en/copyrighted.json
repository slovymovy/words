                "translations": [
                    {
                        "translation_id": "fcc68aff-1a76-4923-bfd6-89d576350fad",
                        "source_entry_id": "c34d844b-58eb-310e-9463-b0fd9b84be98",
                        "source_sense_id": "96f71c53-b0ed-37f0-a58f-7b4d3c3be869",
                        "target_lang_word": "urheberrechtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urheberrechtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "feb1e1e3-4b08-3869-ab3f-81959c33e5e7",
                                        "entry_id": "15c40b24-141b-3174-ab1f-2993df196d18",
                                        "glosses": [
                                            "das Urheberrecht betreffend; sich auf das Urheberrecht beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25760e01-9980-453c-aa0a-1152cc0785fc",
                                                "sense_id": "feb1e1e3-4b08-3869-ab3f-81959c33e5e7",
                                                "text": "„Künftig sind YouTube und Facebook voll haftbar, wenn ihre Mitglieder zum Beispiel ein urheberrechtlich geschütztes Video ins Netz stellen.“"
                                            },
                                            {
                                                "example_id": "a356dbd5-12e0-4a06-924b-11fe7c25b31c",
                                                "sense_id": "feb1e1e3-4b08-3869-ab3f-81959c33e5e7",
                                                "text": "„Illegal ist ihr Angebot, weil die, die heraufladen (die Uploader), ohne Erlaubnis urheberrechtlich geschützte Werke anbieten.“"
                                            },
                                            {
                                                "example_id": "be1d9bcd-dd4b-4a18-ae03-b656c8efaca1",
                                                "sense_id": "feb1e1e3-4b08-3869-ab3f-81959c33e5e7",
                                                "text": "„Der Europäische Gerichtshof sagt: Auch wer urheberrechtlich geschützte Filme und Serien auf dubiosen Seiten anschaut, verstößt gegen Recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4b368e6-63c6-465c-9427-71d5224d7ebf",
                        "source_entry_id": "c34d844b-58eb-310e-9463-b0fd9b84be98",
                        "source_sense_id": "96f71c53-b0ed-37f0-a58f-7b4d3c3be869",
                        "target_lang_word": "geschützt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geschützt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                        "entry_id": "7f210399-f4a5-3e65-b367-5931f3b3b136",
                                        "glosses": [
                                            "gefeit, immun, nicht anfällig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7435c61e-0418-4961-b6b9-e3f2ab64b50c",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Aber die polizeilich und gerichtlich geschützte Ehre deutscher Politiker blieb unangetastet.“"
                                            },
                                            {
                                                "example_id": "116aff08-9ee5-4bf6-8c0d-5dd2e41dd7af",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Schmidt spricht als Mitglied einer privilegierten und geschützten Klasse, der er aufgrund seiner Verdienste mit Recht angehört.“"
                                            },
                                            {
                                                "example_id": "3c0d0fa3-c8fb-4d2d-856b-a2eb0e87169a",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Man sucht einen geschützten Platz auf dem Deck, wo man möglichst lange Nacht und Meer geniessen kann.“"
                                            },
                                            {
                                                "example_id": "6c2d4291-24e8-4e7e-aca9-f5e4e1610e9a",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Die Stiftung für Konsumentenschutz hebt insbesonders hervor, dass die meisten Geräte, gerade im Geschäftsbereich, kaum je für Kopien urheberrechtlich geschützter Werke gebraucht werden.“"
                                            },
                                            {
                                                "example_id": "b3f00429-1e76-4bfe-88c4-2990c89aee15",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Die Rade de Brest ist ein relativ geschützter Einschnitt in die Küste der Bretagne, der nur durch eine schmale Zufahrt, den „Goulet de Brest“, mit dem übrigen Atlantik verbunden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
