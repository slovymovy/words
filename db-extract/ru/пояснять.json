                "senses": [
                    {
                        "sense_id": "94c452ff-6950-31f0-9fa7-0b18e1af75d9",
                        "entry_id": "a19f4dc6-ee7e-3582-b606-c6ed0a177c20",
                        "glosses": [
                            "делать более ясным, понятным; объяснять, растолковывать"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1275d86b-ec4a-4d95-99e9-76d39ebadad7",
                        "source_entry_id": "a19f4dc6-ee7e-3582-b606-c6ed0a177c20",
                        "source_sense_id": "94c452ff-6950-31f0-9fa7-0b18e1af75d9",
                        "target_lang_word": "explain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To make plain, manifest, or intelligible; to clear of obscurity; to illustrate the meaning of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67686e4f-b7e9-4517-9d83-269b594f98e7",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "The issue was explained to the governor in detail."
                                            },
                                            {
                                                "example_id": "405eb740-21ad-489c-b4a8-83d6ad58db82",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "The boy became volubly friendly and bubbling over with unexpected humour and high spirits. He tried to persuade Cicely to stay away from the ball-room for a fourth dance. Nobody would miss them, he explained."
                                            },
                                            {
                                                "example_id": "030c7e56-d7e6-44b2-8aa6-bcae2130334a",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            },
                                            {
                                                "example_id": "21a6438a-0267-41f1-b010-80a30b16b456",
                                                "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                                                "text": "He concisely explains that Whig histories tend to \"praise revolutions [for history of science, we could read novelties, ideas or individuals] provided they have been successful, emphasise certain principles of progress in the past and produce a story which is the ratification if not the glorification of the present\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c47708-73d2-3bb8-b353-c567eec57c92",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To give the reason for, justification for, or cause of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30b82073-8666-4039-b664-804fe4701f5f",
                                                "sense_id": "e8c47708-73d2-3bb8-b353-c567eec57c92",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af93fad-a6cc-3555-b4ea-75360622fc15",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To make flat, smooth out."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46c94989-b5f9-397b-a6a7-58bbb709752e",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To unfold or make visible."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d27ff4-a8a6-442f-9270-f2b996998079",
                                                "sense_id": "46c94989-b5f9-397b-a6a7-58bbb709752e",
                                                "text": "April 14, 1684, John Evelyn, a letter sent to the Royal Society concerning the damage done to his gardens by the preceding winter\nThe horse-chestnut is […] ready to explain its leaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                        "entry_id": "c9a50e9c-c876-3fc7-8a51-b38ad311f302",
                                        "glosses": [
                                            "To make something plain or intelligible."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9fec27-33d2-49a5-9001-0b07b3ba6ebb",
                                                "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                                "text": "She tried to explain but he wouldn’t listen."
                                            },
                                            {
                                                "example_id": "264eb55e-2870-46fb-a780-d233a2a83ce3",
                                                "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                                "text": "It is easy to modify the account to take this into account, by explaining not just in terms of a set of reasons but in terms of a set of reason–weight pairs."
                                            },
                                            {
                                                "example_id": "e2ea84d3-fdff-4959-8a2f-1726841142db",
                                                "sense_id": "0bf226a9-34a0-36a0-9afb-3413c5555daa",
                                                "text": "Like their Western counterparts, local media engages in shorthand - it reports rather than explains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2510b49-09ce-4a5d-b91c-61425f638a26",
                        "source_entry_id": "a19f4dc6-ee7e-3582-b606-c6ed0a177c20",
                        "source_sense_id": "94c452ff-6950-31f0-9fa7-0b18e1af75d9",
                        "target_lang_word": "elucidate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elucidate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f9ac14-8f5c-389d-96d8-8c77565e7cb3",
                                        "entry_id": "de6ef5e8-3f37-321a-9c61-6b569c5dc8ec",
                                        "glosses": [
                                            "To make (something) lucid (“bright, luminous; also, clear, transparent”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                        "entry_id": "de6ef5e8-3f37-321a-9c61-6b569c5dc8ec",
                                        "glosses": [
                                            "To make (something) clear and understandable; to clarify, to illuminate, to shed light on."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70a18f34-16e1-4ebe-a33b-20ebcbaf3daa",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "Let me hear vvhat your ovvn conceptions are of the matter, if they tend to elucidate or reconcile."
                                            },
                                            {
                                                "example_id": "f586a6c1-50fc-49ea-83f2-48841230cb2e",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "Dining at Mr. [Samuel] Pepys's, Dr. Slayer shewed us an experiment of a wonderful nature, […] This matter or phosphorus was made out of human blood and urine, elucidating the vital flame or heate in animal bodys."
                                            },
                                            {
                                                "example_id": "317eab69-745f-48c1-8979-88a0bcd7dc85",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "The antiquities of France have been elucidated by a learned and ingenious people: […]"
                                            },
                                            {
                                                "example_id": "741b9d4f-a5e6-424c-9ae0-faeba1805066",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "The business however, though not perfectly elucidated by this speech, soon ceased to be a puzzle."
                                            },
                                            {
                                                "example_id": "82bfec96-6082-44c7-9424-305f243db189",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "Peter elucidateth the Frauds in Literature by a Smock Race."
                                            },
                                            {
                                                "example_id": "ed9b0ccd-0062-4f38-9358-ce63202fbe30",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "His notes abound with interesting quotations, and have the rare merit of really elucidating the text."
                                            },
                                            {
                                                "example_id": "a8176a03-2784-4f38-b923-212d61ee00f1",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "[W]e find no need of, and no use for, the peculiar technical terminology which he and his masters the Germans have introduced into philosophy, […] which this language, in our judgment, serves not to elucidate, but to disguise and obscure."
                                            },
                                            {
                                                "example_id": "a45e80fd-404e-47e8-8f00-e897b13981e0",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "[A]s it is known that he [Guillaume Duchenne de Boulogne] was eminently successful in elucidating the physiology of the muscles of the hand by the aid of electricity, it is probably that he is generally in the right about the muscles of the face."
                                            },
                                            {
                                                "example_id": "f3455f19-71b6-4651-9be4-44906f1704dc",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "[P]hysicians at the annual meeting of the American Academy of General Practice were fascinated by a 3-ft. model showing the brain's components in 20 layers of translucent plastic, and wired for colored lights to elucidate some of its workings."
                                            },
                                            {
                                                "example_id": "c994a927-bd9b-4363-81fb-5b4ae7558717",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "Another appendix elucidates the S.E.C.R. headcode system."
                                            },
                                            {
                                                "example_id": "2b4d4e46-0d8b-4925-8d13-38796292850f",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "The new Sopranos volume has 17 essays that examine the television show and elucidate concepts from classical philosophers, including Aristotle, [Niccolò] Machiavelli, [Friedrich] Nietzsche, Sun Tzu and Plato."
                                            },
                                            {
                                                "example_id": "780e0169-de94-4bbb-b3ea-99ab6885b59f",
                                                "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                                                "text": "O Lord! somewhere Thou elucidatest the traits of song and sound and somewhere Thou art the treasure of dancing and painting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elucidate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "218d2a81-f1dd-3a1d-9255-63c044acd91d",
                                        "entry_id": "02bd91c9-3f38-3542-9550-b6b4c2562622",
                                        "glosses": [
                                            "Clear, understandable."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d797b442-24a3-4f81-a2a5-d09dcd3ba2e4",
                                                "sense_id": "218d2a81-f1dd-3a1d-9255-63c044acd91d",
                                                "text": "There vvas not a greater Maſter of Perſpicuity, and elucidate Diſtinctions; vvhich look'd the better in his [John Williams'] Engliſh, that ran ſvveet upon his Tongue, eſpecially being ſet out vvith a graceful Facetiouſneſs, that hit the joint of the Matter: For his VVit, and his Judgment, never parted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
