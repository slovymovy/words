                                        "entry_id": "ed47da60-fa69-3374-9d0a-843226e66ea4",
                                        "glosses": [
                                            "Arabe, noir ou immigré."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
