                        "entry_id": "fc81ce84-3ff5-3f61-ae0d-e355ed3eeea4",
                        "glosses": [
                            "Artiste qui dessine, peint ou sculpte les bêtes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b2a2c7-25e0-4069-913d-08ca329812bb",
                                "sense_id": "a03baf99-ab92-39a7-8769-f831285d3222",
                                "text": "Peintre animalier."
                            },
                            {
                                "example_id": "9d46b1ba-a5f2-4b93-b972-6822042ad368",
                                "sense_id": "a03baf99-ab92-39a7-8769-f831285d3222",
                                "text": "Paysagistes et animaliers ont fait merveille à cette exposition."
                            },
                            {
                                "example_id": "42f58dbf-d17f-49b1-bfc9-afe2f63079c0",
                                "sense_id": "a03baf99-ab92-39a7-8769-f831285d3222",
                                "text": "Les taureaux et les chevaux, bien que parfois d’une forme un peu fabuleuse, ont une vie et un jet qui manquent bien souvent aux bêtes des animaliers de profession."
                            }
                        ]
                    },
                    {
                        "sense_id": "4742e98c-0180-38e7-a895-d3aceaf97b00",
                        "entry_id": "fc81ce84-3ff5-3f61-ae0d-e355ed3eeea4",
                        "glosses": [
                            "Personne chargée de s'occuper des animaux dans une animalerie, un établissement zoologique."
                        ],
                        "tags": [],
                        "examples": [
