                "translations": [
                    {
                        "translation_id": "9b12204f-cada-4074-8de2-d832a8c71618",
                        "source_entry_id": "2740f6eb-430c-3898-b97c-374699f29cfc",
                        "source_sense_description": "fur of a mole",
                        "target_lang_word": "Maulwurfsfell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maulwurfsfell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e2ba0f-1a82-3425-8af0-a238383c35c1",
                                        "entry_id": "371f731e-0b39-3247-b34b-05f2cbbc421d",
                                        "glosses": [
                                            "(abgezogenes) Fell eines Maulwurfs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35cf2282-9290-454e-a839-1c0325436b30",
                                                "sense_id": "84e2ba0f-1a82-3425-8af0-a238383c35c1",
                                                "text": "„Damals in den Jahren nach dem Ersten Weltkrieg hatte der Maulwurf eine schlechte Zeit. Es wurde ihm überall mit Fallen nachgestellt. Ein Maulwurfsfell kostete damals bis zu fünfzig Groschen.“"
                                            },
                                            {
                                                "example_id": "14547f90-3f8e-449c-a511-c04f67caa802",
                                                "sense_id": "84e2ba0f-1a82-3425-8af0-a238383c35c1",
                                                "text": "„Trotzdem trug man Maulwurfspelze schon im Altertum und Mittelalter, und in den zwanziger Jahren unseres Jahrhunderts wurden gefärbte Maulwurfsfelle sogar große Mode.“"
                                            },
                                            {
                                                "example_id": "b9f470f0-cae3-466d-84e1-7b533ba91aad",
                                                "sense_id": "84e2ba0f-1a82-3425-8af0-a238383c35c1",
                                                "text": "„Er trug ein rotes Samtkäppchen mit grüner Hahnenfeder, einen Schlafrock von Maulwurfsfellen, eine hirschlederne Hose und spitze Pantoffeln von Krokodilshaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b66d697-d8e4-4b38-9c3a-51ac1364e0e8",
                        "source_entry_id": "2740f6eb-430c-3898-b97c-374699f29cfc",
                        "source_sense_description": "fur of a mole",
                        "target_lang_word": "krecia skórka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2b8bdb05-9415-46a6-821b-7616132a3a6a",
                        "source_entry_id": "2740f6eb-430c-3898-b97c-374699f29cfc",
                        "source_sense_description": "fabric",
                        "target_lang_word": "moleskine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moleskine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61450611-1ff0-3de4-b448-51ecb1c925b3",
                                        "entry_id": "3a4c1098-3680-32c0-b3a8-e81a1d668526",
                                        "glosses": [
                                            "Étoffe de coton, lustrée, qui sert à doubler les vêtements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                        "entry_id": "3a4c1098-3680-32c0-b3a8-e81a1d668526",
                                        "glosses": [
                                            "Toile vernie imitant le cuir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb7433d-f073-4cbc-8b3b-8546664302d8",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "C’est ce rond de cuir qui l’a perdu. Il se trouvait si bien dessus, sa place était si bien faite sur ce coussinet de moleskine, qu’il a mieux aimé devenir Prussien que de bouger de là."
                                            },
                                            {
                                                "example_id": "7a9a9c61-5086-441f-876e-6e25d5e98816",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "La salle étroite et noire, avec ses banquettes de moleskine, ses chaises, sa fenêtre, ses glaces ternies, sa clientèle de buveurs préoccupés, lui serrait le coeur."
                                            },
                                            {
                                                "example_id": "8223a7d7-340c-48f8-8727-c3901343e82b",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "Par une double porte, capitonnée de moleskine, nous pénétrâmes dans une pièce carrelée, aux murs blancs à encadrements rouges, et que les habitués appellent « la chapelle »."
                                            },
                                            {
                                                "example_id": "0191bc6b-689f-4659-8e99-25010bab5dfe",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "Vous croyez donc que les bandits se tiennent à plaisir dans ces caves vermineuses et dans ces pièces ouvertes à la pluie et au vent ? Soyez certain qu'ils préfèrent quelque chaude taverne, avec de bonnes banquettes de moleskine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63c8e244-98f3-3ff8-baa9-0223c2bacf90",
                                        "entry_id": "3a4c1098-3680-32c0-b3a8-e81a1d668526",
                                        "glosses": [
                                            "Couverture de petit carnet faite dans cette toile vernie."
                                        ],
                                        "tags": [
                                            "Papeterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f92e363-6b0b-4b56-b20f-c2e371c22a27",
                                                "sense_id": "63c8e244-98f3-3ff8-baa9-0223c2bacf90",
                                                "text": "Il sortit de l’une des poches de sa veste un stylo bille et le carnet de moleskine noire qu’il gardait toujours sur lui depuis qu’il avait commencé son livre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d02f7f20-e9c4-4e39-b652-f1b835ff3dca",
                        "source_entry_id": "2740f6eb-430c-3898-b97c-374699f29cfc",
