                "senses": [
                    {
                        "sense_id": "1c2c7104-a026-342d-98bb-256dd207b35c",
                        "entry_id": "771ed826-8dc6-3bd0-a277-3dd26a76cc18",
                        "glosses": [
                            "A small northern state of ancient China."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dcd77e6c-f58c-3715-af91-680913f4be62",
                        "entry_id": "771ed826-8dc6-3bd0-a277-3dd26a76cc18",
                        "glosses": [
                            "Various other kingdoms and princely appenages of imperial China named for the ancient state."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "62f565f6-4062-3aca-aadd-d4094334e37e",
                        "entry_id": "771ed826-8dc6-3bd0-a277-3dd26a76cc18",
                        "glosses": [
                            "A prefecture of Shanxi under imperial China."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9b8db642-900a-38a6-ae28-6c22c5dca3be",
                        "entry_id": "771ed826-8dc6-3bd0-a277-3dd26a76cc18",
                        "glosses": [
                            "A county of Xinzhou Prefecture in Shanxi, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e3d2a8-afec-4e7e-b88e-d02f66336c1c",
                                "sense_id": "9b8db642-900a-38a6-ae28-6c22c5dca3be",
                                "text": "Tian Yongsheng from Shanxi province is desperate to find a way to relieve the chest pain which has haunted him for years.[…]\nHe is well aware what will happen if he is not treated. Many of his neighbours in Dai county - all coal miners - have died of the disease after suffering great pain.\n'In the five villages [in Dai county] that I knew, all men from 18 to 50 suffer pneumoconiosis,' said Mr Tian. 'Among 100 coal miners, 100 have pneumoconiosis."
                            },
                            {
                                "example_id": "d95b60b8-e50d-4570-bc86-227a1049e42c",
                                "sense_id": "9b8db642-900a-38a6-ae28-6c22c5dca3be",
                                "text": "One of the most remarkable features of the redemptive societies was their continuing ability to draw members of the CCP and the Youth League into their ranks. In 1950 in Shanxi, 18 percent of the 3,000 Communists in Dai County were members of the Yiguandao, which had affiliates in 74 percent of rural Party branches."
                            },
                            {
                                "example_id": "bd2fe649-368d-42c2-8aca-7f49843054c0",
                                "sense_id": "9b8db642-900a-38a6-ae28-6c22c5dca3be",
                                "text": "A northern section of the Great Wall of China collapsed after a period of heavy rain last month, with many blaming poor-quality renovations for the deterioration of the iconic landmark.\nThe damaged section of the historical wall is located near Yanmen Pass, in Dai County, in the Shanxi province."
                            }
                        ]
                    }
                ],
