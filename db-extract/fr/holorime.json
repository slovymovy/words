                "senses": [
                    {
                        "sense_id": "7106e2b6-b926-3131-a8de-2eb0fc76440f",
                        "entry_id": "7758ad29-5e53-3f09-b355-3c9a53a48f81",
                        "glosses": [
                            "Homophone syllabe pour syllabe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243381a3-5f26-494a-9c36-2fdf2795bc1d",
                                "sense_id": "7106e2b6-b926-3131-a8de-2eb0fc76440f",
                                "text": "« Un vieil armagnac » et « un vieillard maniaque » sont parfaitement holorimes."
                            },
                            {
                                "example_id": "ba5596bf-5a8f-4810-9466-20d4719bdb8d",
                                "sense_id": "7106e2b6-b926-3131-a8de-2eb0fc76440f",
                                "text": "Eh bien ! j’ai écrit des vers. Et, pour répondre au défi de mon ami Allais, j’ai composé des vers holorimes, c’est-à-dire qui riment d’un bout à l’autre. Les voici :\n Alphonse Allais de l’âme erre et se f… à l’eau.\n Ah ! l’ fond salé de la mer ! Hé ! ce fou ! Hallo !\n Car il faut vous dire que, la semaine dernière, ce pauvre Allais, apprenant que sa maîtresse le trompait avec un architecte, a tenté de se noyer."
                            },
                            {
                                "example_id": "6a9ea89b-4230-4b3a-8a62-1fd429db1bdd",
                                "sense_id": "7106e2b6-b926-3131-a8de-2eb0fc76440f",
                                "text": "Il est l'auteur du fameux distique holorime suivant :\"Gal, amant de la Reine, alla, tour magnanime, / Galamment de l'arène à la Tour Magne, à Nîmes\"."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
