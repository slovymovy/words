                ],
                "senses": [
                    {
                        "sense_id": "bddb1a64-3adb-3274-815b-b219dd0f28e0",
                        "entry_id": "e2f29892-a3b2-3afb-a44c-8404104bd303",
                        "glosses": [
                            "архит. ряд одинаковых арок, опирающихся на колонны или столбы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcdc8ab5-37b0-4bf4-9571-79c2a7a97c66",
                                "sense_id": "bddb1a64-3adb-3274-815b-b219dd0f28e0",
                                "text": "Лёгкая аркада на тонких колоннах окружала двор."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec3aee0d-b100-34e6-af16-6b6a2b96da79",
                        "entry_id": "e2f29892-a3b2-3afb-a44c-8404104bd303",
                        "glosses": [
                            "жанр компьютерных игр с игровым процессом, типичным для игр в игровых автоматах, требующим от игрока в первую очередь быстроты и реакции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f66d7d1b-2f8a-4263-93cb-c9468226cae0",
                                "sense_id": "ec3aee0d-b100-34e6-af16-6b6a2b96da79",
                                "text": "Pong была простой аркадой, в которой две тарелочки, управляемые игроками (или человеком и компьютером), отбивают мячик, стараясь удержать его на игровом поле. Игра наделала много шума; по сей день бывалые игроки благоговейно вздыхают при упоминании её названия. Линейку коммерческих аркад продолжили менее эпохальные, но достаточно известные Odyssey, выпущенная Magnavox и Tank от Kee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6e5dd67-c837-4425-b95a-48ce79ff3b39",
                        "source_entry_id": "e2f29892-a3b2-3afb-a44c-8404104bd303",
                        "target_lang_word": "arcade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90e79b14-2d03-353f-823c-683c9d67fd9c",
                                        "entry_id": "313cfb4f-d265-395c-a389-89cb34d315f5",
                                        "glosses": [
                                            "A row of arches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ca1e338-094a-4583-802b-5a3d13769646",
                                                "sense_id": "90e79b14-2d03-353f-823c-683c9d67fd9c",
                                                "text": "The walk down to the Underground station is equally easy, as you pass through the restored undercroft along an arcade of two-way spanning 'quadripartite' arches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5a8a968-09ab-3d2d-b6b6-8e26c323e14c",
                                        "entry_id": "313cfb4f-d265-395c-a389-89cb34d315f5",
                                        "glosses": [
                                            "A covered passage, usually with shops on both sides."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b001f4f-78cd-3e5a-a331-30e05456a3e3",
                                        "entry_id": "313cfb4f-d265-395c-a389-89cb34d315f5",
                                        "glosses": [
                                            "Synonym of amusement arcade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arcade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aceb2a7-d579-3b9f-b442-2318a039a8b7",
                                        "entry_id": "c059b4b5-d438-3713-b6fb-60e10040f352",
                                        "glosses": [
                                            "To cover (something) as with a series of arches."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a21688f-2f04-41ef-9efc-08b2b1060e33",
                                                "sense_id": "2aceb2a7-d579-3b9f-b442-2318a039a8b7",
                                                "text": "[…] its trottoirs brick-paved and shaded by trees of almost tropical foliage—conspicuous among them the odoriferous magnolia, and the melia azedarach, or “Pride of China”—these in places completely arcading the streets—the town of Nachitoches offered the aspect of a rus in urbe, or urbs in rure, whichever way you may wish it."
                                            }
                                        ]
                                    }
                                ]
                            }
