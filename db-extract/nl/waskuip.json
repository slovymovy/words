                                                "example_id": "d3db8976-265a-4f1c-99c8-afe2374940e1",
                                                "sense_id": "39c4a8b0-3cc3-37ca-ab39-e8552ba1bfde",
                                                "text": "Donald tells him to be more realistic. Take those two girls over there, for example. One's a zitface and the other's a tub, so they'd be perfect for them."
                                            }
