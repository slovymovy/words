                                        "entry_id": "9a4f6c3d-57b2-35ff-a0bf-d302cc081ef7",
                                        "glosses": [
                                            "The uncomfortable sympathetic feeling experienced while watching someone else embarrass themselves."
                                        ],
                                        "tags": [
                                            "countable",
