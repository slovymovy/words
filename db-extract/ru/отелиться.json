                                            },
                                            {
                                                "example_id": "0788b9fa-245f-4157-9e1b-cdf09cd7469f",
                                                "sense_id": "8179dd86-890a-3d6e-a090-40e5145a609f",
                                                "text": "„Anders nomadische Wölfe mit heller Fellfarbe: Sie begleiten riesige Karibuherden. Deren Wintereinstand liegt im Taigawald, im Sommer kalben sie 2000 Kilometer nördlich in der offenen Tundra.“"
                                            },
                                            {
                                                "example_id": "612bcd73-caff-47ac-bf9c-a3701751e869",
                                                "sense_id": "8179dd86-890a-3d6e-a090-40e5145a609f",
                                                "text": "„Rosas sagt, dass solche Kühe weniger Milch geben und weniger Nachwuchs bekommen, dass auf einer guten Weide 90 von 100 Kühen kalben, auf einer mittelmäßigen aber nur 70 und auf einer schlechten 40.“"
                                            },
                                            {
                                                "example_id": "7982827a-e9a0-41d6-a4be-72f61111db0b",
                                                "sense_id": "8179dd86-890a-3d6e-a090-40e5145a609f",
                                                "text": "„Es gibt genügend alternative Offshore-Standorte, an denen kein Schweinswal kalbt und kein Prachttaucher fischt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19345b76-7dc9-3d4f-83d7-0dfba7205552",
                                        "entry_id": "e758a3bf-d1cb-37fc-91d2-2daeefa3a6b8",
                                        "glosses": [
                                            "abbrechen großer Eismassen (von einem Gletscher oder einer Inlandeismasse), die als Eisberge in das Meer oder ein Binnengewässer stürzen"
                                        ],
                                        "tags": [
                                            "intransitiv, Geographie, Glaziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d43adc12-5d26-4fd3-bd6d-ee913a03925d",
                                                "sense_id": "19345b76-7dc9-3d4f-83d7-0dfba7205552",
                                                "text": "„Vor den Fronten des Hubbard-Gletschers in Alaska und des Perito-Merino-Gletschers in Patagonien hat der Photograph Bernhard Edmaier geduldig ausgeharrt bis zu den spektakulären Augenblicken, in denen die weißen Giganten kalben.“"
                                            },
                                            {
                                                "example_id": "9883ae1b-4a2c-41c7-bf6b-fcb3dda11bde",
                                                "sense_id": "19345b76-7dc9-3d4f-83d7-0dfba7205552",
                                                "text": "„Wenige Minuten später: Ein Knall, ein Donnern, ein Splittern. Dann zischte es, schlug eine Welle. Und schäumend verschwand der Eisturm in der blauen Tiefe. Der Gletscher kalbte.“"
                                            },
                                            {
                                                "example_id": "00bba221-d529-4c8b-8de9-0af45f282552",
                                                "sense_id": "19345b76-7dc9-3d4f-83d7-0dfba7205552",
                                                "text": "„Wir gehen folglich einer CO2-Katastrophe entgegen, welche die Gletscher kalben läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ac12a510-4f86-35b5-a3de-dd2c5acbd226",
                                        "entry_id": "e758a3bf-d1cb-37fc-91d2-2daeefa3a6b8",
                                        "glosses": [
                                            "ein Kind gebären"
                                        ],
                                        "tags": [
