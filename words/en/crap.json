                    "sense_definition": "Feces; solid waste excreted from the body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feces_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to step in the dog <w>crap</w> on the sidewalk.",
