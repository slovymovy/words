                "senses": [
                    {
                        "sense_id": "872bf27f-c50b-3954-a3b6-4c7a68cf29f1",
                        "entry_id": "554280ba-d56e-34df-bb54-f641988d1633",
                        "glosses": [
                            "das gleichzeitige Einsetzen zweier neuer Personen (vor allem im Mannschaftssport während eines Spiels)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36cdbcba-5fca-4c72-9afb-87725bff88ec",
                                "sense_id": "872bf27f-c50b-3954-a3b6-4c7a68cf29f1",
                                "text": "„Arsenal rannte lange an, gut 20 Minuten vor dem Abpfiff brachte Arsène Wenger mit Ramsey und Giroud neue Impulse und entschied mit diesem Doppelwechsel das Spiel.“"
                            },
                            {
                                "example_id": "1d51dabe-f602-46fd-9742-263bd634c1f8",
                                "sense_id": "872bf27f-c50b-3954-a3b6-4c7a68cf29f1",
                                "text": "„Drei Minuten nach der Halbzeit verordnete Tedesco einen Doppelwechsel der Torschütze und Max Meyer verließen den Platz, wohl weil beide in der ersten Hälfte eine gelbe Karte gesehen hatten.“"
                            }
                        ],
