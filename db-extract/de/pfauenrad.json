                "senses": [
                    {
                        "sense_id": "d6f62647-9afa-3594-a34c-8789453409d9",
                        "entry_id": "914299cd-76a2-3741-9101-930b0c3504c5",
                        "glosses": [
                            "aufgestellte Schleppe des Pfauenhahns während der Balz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9d501ca-269e-4476-a82b-ba7cc44d7dc0",
                                "sense_id": "d6f62647-9afa-3594-a34c-8789453409d9",
                                "text": "„Hier spielen auffallende und unwahrscheinliche Farben und Formen eine Rolle, die wir - man denke an das Pfauenrad und die Schmetterlingsflügel - nur als schön bezeichnen können.“"
                            },
                            {
                                "example_id": "3da74811-fb2d-4411-9694-82eac96a63d5",
                                "sense_id": "d6f62647-9afa-3594-a34c-8789453409d9",
                                "text": "„Tiere sind stolz wie ein Pfau, und sie haben Grund dazu, weil ihr prächtiges Pfauenrad wirklich werbemäßig beim anderen Geschlecht viel hermacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
