                                                "example_id": "ddb371f2-799d-4aba-a758-ecef48a1501d",
                                                "sense_id": "8cc4c51b-34b7-3212-9a2a-d3f05c76f62d",
                                                "text": "Het is algemeen bekend dat hij een nietsnut is."
