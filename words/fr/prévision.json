                    "frequency": "High",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons acheté du bois de chauffage en <w>prévision</w> d'un hiver particulièrement froid."
                        },
                        {
                            "text": "Toutes les <w>prévisions</w> indiquent une hausse importante des températures pour la saison prochaine."
                        }
                    ],
