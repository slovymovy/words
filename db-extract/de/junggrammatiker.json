                                        "glosses": [
                                            "Membre de cette école."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28330f77-0c8b-4d90-9923-319f3e9c1771",
                                                "sense_id": "a93c75bf-857e-3f76-a9d6-3dbc6048c736",
                                                "text": "Les néogrammariens ont érigé la régularité des lois phonétiques en axiome de la linguistique comparée."
