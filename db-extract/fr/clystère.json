        "fr-extract.jsonl": [
            {
                "entry_id": "358769b9-2d59-3ef0-a456-8722f260ecde",
                "word": "clystère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b758394-5432-4665-81ae-301c9d4f596d",
                        "entry_id": "358769b9-2d59-3ef0-a456-8722f260ecde",
                        "tags": [
                            "plural"
                        ],
                        "form": "clystères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f605019-4a47-3073-bbfc-74bdc810e059",
                        "entry_id": "358769b9-2d59-3ef0-a456-8722f260ecde",
                        "glosses": [
                            "Lavement d’eau parfois complétée avec du sel ou des médicaments. Cette eau est ainsi introduite dans le corps par l’anus, à l’aide d’une seringue ou d’un clysopompe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93b24f1-0aee-4c51-b3c1-bb0b27d73f22",
                                "sense_id": "3f605019-4a47-3073-bbfc-74bdc810e059",
                                "text": "Argan : \"Plus, du vingt-quatrième, un petit clystère insinuatif, préparatif et rémollient, pour amollir, humecter et rafraichir les entrailles de monsieur ?\" Ce qui me plait de monsieur Fleurant, mon apothicaire, c’est que ses parties sont toujours fort civiles."
                            },
                            {
                                "example_id": "5dc372c4-3420-478e-bb3a-c4443ce0c163",
                                "sense_id": "3f605019-4a47-3073-bbfc-74bdc810e059",
                                "text": "Escortée d’un énorme chauffeur, qui la portait de salon en salon, et d’une vieille secrétaire humiliée qui lui donnait ses clystères et timbrait sa correspondance, elle courait l’Europe, pour grignoter et décorer toutes les célébrités."
                            },
                            {
                                "example_id": "bedada68-d1c8-4bf5-883c-512d7f6e9917",
                                "sense_id": "3f605019-4a47-3073-bbfc-74bdc810e059",
                                "text": "Prendre un clystère."
                            },
                            {
                                "example_id": "63e401cc-37a3-4b5f-b5fd-28f6ef3b4485",
                                "sense_id": "3f605019-4a47-3073-bbfc-74bdc810e059",
                                "text": "Donner un clystère."
                            },
                            {
                                "example_id": "e7792659-9471-421c-96ab-dad37ea7952e",
                                "sense_id": "3f605019-4a47-3073-bbfc-74bdc810e059",
                                "text": "Rendre un clystère."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cfca6f2-b2c9-3293-9aff-7d1f122aa753",
                        "entry_id": "358769b9-2d59-3ef0-a456-8722f260ecde",
                        "glosses": [
                            "Instrument servant à administrer un lavement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f78ce94a-9afb-4dea-9364-26692279125c",
                                "sense_id": "4cfca6f2-b2c9-3293-9aff-7d1f122aa753",
                                "text": "Son provincial, il va le cuisiner aux petits oignons : en le faisant poursuivre par des médecins complètement givrés, armés de clystères, en répandant le bruit qu’il est criblé de dettes, en l’accusant de polygamie, avec comparution devant un faux juge, etc."
                            },
                            {
                                "example_id": "ecdf850f-3f78-4a42-9b58-b41f474a200f",
                                "sense_id": "4cfca6f2-b2c9-3293-9aff-7d1f122aa753",
                                "text": "Une foule de gens et de gamins suivait en tumulte le train des musiciens et la marche était fermée par un pizzicarolo, célèbre à Rome pour ses embonpoints, brandissant un clystère haut comme un clocher."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b2d2d4a-8b7d-444d-898b-c2d4c27e5954",
                        "source_entry_id": "358769b9-2d59-3ef0-a456-8722f260ecde",
                        "target_lang_word": "Einlauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einlauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f262687f-34c1-345c-accc-f08eed76a426",
                                        "entry_id": "68ab8add-9cdd-3060-8dcc-6e1ef9c61e58",
                                        "glosses": [
                                            "Methode, bei der eine Flüssigkeit über den After in den Darm eingeleitet wird, um den Enddarm von Kot zu säubern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138975f6-a255-4568-9b77-3d3c595bdc05",
                                                "sense_id": "f262687f-34c1-345c-accc-f08eed76a426",
                                                "text": "Vor einer Darmspiegelung muss der Patient einen Einlauf über sich ergehen lassen."
                                            },
                                            {
                                                "example_id": "d2fc71d2-6132-4def-828b-97fbe55a8d62",
                                                "sense_id": "f262687f-34c1-345c-accc-f08eed76a426",
                                                "text": "Ein Einlauf wird unter anderem bei Verstopfung verordnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4384166-bd76-3bbb-8564-967dd022b916",
                                        "entry_id": "68ab8add-9cdd-3060-8dcc-6e1ef9c61e58",
                                        "glosses": [
                                            "zu [1] benutzte Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09848bc4-9a09-4f80-adc1-696eeb3fa5b9",
                                                "sense_id": "a4384166-bd76-3bbb-8564-967dd022b916",
                                                "text": "Ein Einlauf wird unter anderem bei Verstopfung verordnet."
                                            },
                                            {
                                                "example_id": "7f0d9226-0f2d-42ca-866d-c94d5fe1b34b",
                                                "sense_id": "a4384166-bd76-3bbb-8564-967dd022b916",
                                                "text": "Ein Einlauf sollte nie zu kalt sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "605f1954-412a-383d-88cf-7a50d1ee7e9a",
                                        "entry_id": "68ab8add-9cdd-3060-8dcc-6e1ef9c61e58",
                                        "glosses": [
                                            "Ankunft von zum Beispiel Läufern oder Pferden im Ziel bei einem Rennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f9dcc7-5133-4ce6-8e63-f96ff066e8d1",
                                                "sense_id": "605f1954-412a-383d-88cf-7a50d1ee7e9a",
                                                "text": "Beim Einlauf war zur allgemeinen Überraschung Fjury in Führung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f8e52a58-b48b-3ed6-a74b-2b22ab45cee8",
                                        "entry_id": "68ab8add-9cdd-3060-8dcc-6e1ef9c61e58",
                                        "glosses": [
                                            "Stelle, an der eine Flüssigkeit in eine Anlage hineinläuft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ca0efe-e08b-4867-80a8-7b50313b79bc",
                                                "sense_id": "f8e52a58-b48b-3ed6-a74b-2b22ab45cee8",
                                                "text": "Der Durchfluss am Einlauf beträgt fünf Kubikmeter pro Sekunde."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ee3711e5-fad4-3df9-921c-fc13652a2c9b",
                                        "entry_id": "68ab8add-9cdd-3060-8dcc-6e1ef9c61e58",
                                        "glosses": [
                                            "Kritik, auf ein Fehlverhalten gelenkte Aufmerksamkeit"
                                        ],
                                        "tags": [
                                            "Umgangssprache",
                                            "in festen Wendungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebdce60b-ebd1-4c03-a3d0-8c1a14532ccf",
                                                "sense_id": "ee3711e5-fad4-3df9-921c-fc13652a2c9b",
                                                "text": "Abends wurde ihm dann von seinem Kumpel auch noch ein Einlauf verpasst."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
