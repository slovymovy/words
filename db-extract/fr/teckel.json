                                        "glosses": [
                                            "plemeno loveckých psů s dlouhým tělem a krátkýma nohama užívané k vyhánění zvěře z nor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800dae9d-b131-4179-baf1-e8fff5349936",
                                                "sense_id": "80e0c619-33ce-3398-80a1-4bdffc863910",
                                                "text": "A ještě se drží při životě směšný a udatný jezevčík, řečený též dakl nebo valdík;"
                                            },
                                            {
                                                "example_id": "1070aa0a-4179-4bd9-9a5f-9ea9f672695b",
                                                "sense_id": "80e0c619-33ce-3398-80a1-4bdffc863910",
                                                "text": "Jakmile člověk překročí určitou věkovou hranici, přidělí mu stát jezevčíka, aby s ním dotyčný mohl chodit po venku a navazovat kontakty s jinými starými lidmi s jezevčíky."
                                            }
