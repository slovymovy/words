                        "glosses": [
                            "The state or characteristic of being incommensurable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e57d1c34-1c43-418b-a5f1-23e55da03fff",
                                "sense_id": "5544d122-d10d-315f-b0b7-398d19e48e10",
                                "text": "[…] I therefore think, Sarah, that the incommensurability of the crime with the effect, completely warrants the supersaliency of this noctivagant delinquent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c360c7f-2f96-4c57-b1d2-3afe568a6488",
