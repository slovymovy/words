                        "target_lang_word": "hématocrite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hématocrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69120ac4-cba4-33bf-8871-32d03223e2fb",
                                        "entry_id": "e1083ca6-46e9-3801-98d8-3a69d2d3efcd",
                                        "glosses": [
                                            "Désigne le pourcentage relatif du volume des cellules circulant du sang par rapport au volume total du sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb72b9c-95d6-4263-9dcc-630a1e39b373",
                                                "sense_id": "69120ac4-cba4-33bf-8871-32d03223e2fb",
                                                "text": "L'hémorragie aiguë entraîne une perte brutale proportionnelle de plasma et d'éléments figurés du sang. Bien qu'ici le sang total perdu atteigne 2,5 l, soit environ la moitié de la volémie d'un adulte, l’hématocrite reste initialement stable (t1)."
                                            },
                                            {
                                                "example_id": "554d1574-f786-40db-aef4-ea3d681eb83d",
                                                "sense_id": "69120ac4-cba4-33bf-8871-32d03223e2fb",
                                                "text": "Nous venons de trouver, ici, à La Rinconada, ville la plus haute du monde à 5 300 mètres d’altitude, 85 % de taux d’hématocrite dans le sang d’un travailleur de la mine, c’est hallucinant !"
                                            },
                                            {
                                                "example_id": "d14737db-3000-407f-8233-e1c20503292e",
                                                "sense_id": "69120ac4-cba4-33bf-8871-32d03223e2fb",
                                                "text": "Les chambres des coureurs s’apparentaient à des laboratoires médicaux avec pharmacie, poches de sang et micro-centrifugeuses pour tester le niveau de l’hématocrite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
