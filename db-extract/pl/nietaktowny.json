                        "examples": [
                            {
                                "example_id": "5c925492-acc8-46c7-964c-c594d658ba26",
                                "sense_id": "be414ac4-e9db-3165-89f8-a7142f57651f",
                                "text": "Sekretna dyplomacja (…) w XVIII w. była niezręczna i nietaktowna, sprowadzała się do intryg, zrywania sejmów i „dyplomacji pieniądza”"
