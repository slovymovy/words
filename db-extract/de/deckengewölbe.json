                                    },
                                    {
                                        "sense_id": "6eae11e2-a668-3537-ae6b-16aa7c44b044",
                                        "entry_id": "89003c08-844d-36a7-8e36-18d698220e95",
                                        "glosses": [
                                            "To remove (an item, character, etc.) from a video game in an update."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fffc9d59-c849-446c-b2ef-3a8f3a2907c1",
                                                "sense_id": "6eae11e2-a668-3537-ae6b-16aa7c44b044",
                                                "text": "In future updates, most likely in season six, more items will get vaulted."
                                            },
                                            {
                                                "example_id": "97d0963d-159e-4b1b-bea1-8a061233b790",
                                                "sense_id": "6eae11e2-a668-3537-ae6b-16aa7c44b044",
                                                "text": "While vaulting some old content may turn off a few players, Bungie seems intent on bringing as many players under its tent as possible first."
                                            },
                                            {
                                                "example_id": "917be6b5-96e6-4efe-bcc5-7f80fee1e486",
                                                "sense_id": "6eae11e2-a668-3537-ae6b-16aa7c44b044",
                                                "text": "Blizzard will vault the gorgeous Hanamura and other Assault maps from Overwatch's competitive mode when 'Overwatch 2' arrives."
                                            },
                                            {
                                                "example_id": "b76456de-38d9-46ed-8b8c-012af47d0314",
                                                "sense_id": "6eae11e2-a668-3537-ae6b-16aa7c44b044",
                                                "text": "While some mistakes have resulted in Riot pulling Agents in the past, those changes were always temporary. If Riot is set on having only seven maps in the \"Valorant,\" that likely means Split isn't coming back and more maps will get vaulted in the future."
                                            }
                                        ]
                                    }
                                ]
