                        "source_entry_id": "71df58a9-27ed-391e-8bbb-967596d38c95",
                        "source_sense_id": "745c8f0e-1074-3e7f-a222-0ccf2db0eb3f",
                        "target_lang_word": "redundant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redundant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Superfluous; exceeding what is necessary, no longer needed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b269985e-d035-4e8a-bd33-548c0c4e1f4e",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "It is allowed, that Senates and great Councils are often troubled with redundant, ebullient, and other peccant Humours, with many Diſeaſes of the Head and more of the Heart; […]"
                                            },
                                            {
                                                "example_id": "b170f0bf-9d7f-4e5f-926e-9539f96aa817",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "In the living state, the body is observed to receive aliment; to assimilate a part; to evacuate what is redundant or useless; […]"
                                            },
                                            {
                                                "example_id": "49aebc92-5c47-4716-9d3c-c41b0791d367",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "A key driver has been the approval of a new housing and employment development called Fawley Waterside, with 1,500 homes planned on the site of a redundant power station on the edge of Southampton Water."
                                            },
                                            {
                                                "example_id": "56cd5a4f-1c3b-4aaa-8d23-d31ba71534ce",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "Two entrants shared this award for their work on two quite different stations, but with the same purpose of bringing a redundant station building back into use for the benefit of the community, with the added result of conserving an historic building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca3e228-cb5a-3481-a425-0a29dd911d54",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Repetitive or needlessly wordy."
                                        ],
                                        "tags": [
                                            "of words"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98b30eed-fc5f-3032-8c7f-db349ec9e3c1",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Dismissed from employment because no longer needed."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51be796d-ce58-427f-ab03-88d881331eee",
                                                "sense_id": "98b30eed-fc5f-3032-8c7f-db349ec9e3c1",
                                                "text": "Four employees were made redundant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e945cdda-d2fb-3ddc-a0b6-86de8f828cdf",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Duplicating or able to duplicate the function of another component of a system, providing backup in the event the other component fails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c827dde0-d222-4fa2-bc6a-d70825a58c86",
                                                "sense_id": "e945cdda-d2fb-3ddc-a0b6-86de8f828cdf",
                                                "text": "The two lines are mainly used for redundant and therefore fault-tolerant message transmission, but they can also transmit different messages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f24c9b-583c-346f-965c-d40331d78301",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Containing duplicate pathways to send a message."
                                        ],
                                        "tags": [
                                            "of topology"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
