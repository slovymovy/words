                ],
                "translations": [
                    {
                        "translation_id": "5632ef17-43a8-4be0-bbc6-fdd142ed227e",
                        "source_entry_id": "f1755f9b-b5f8-3951-b8f0-32e622cbf437",
                        "source_sense_id": "1e937827-b3ea-39bf-a9ca-a8132618fb48",
                        "target_lang_word": "violence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abad3659-1012-304a-b995-5f44e62e2476",
                                        "entry_id": "62f148fd-c55f-3ead-a420-2253e4370e45",
                                        "glosses": [
                                            "Extreme force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d961f97-dce7-4bdb-9da1-9f909d2cc8ea",
                                                "sense_id": "abad3659-1012-304a-b995-5f44e62e2476",
                                                "text": "The violence of the storm, fortunately, was more awesome than destructive."
                                            },
                                            {
                                                "example_id": "1b84fdea-c2ca-4d9a-88f8-e42fbdbb6467",
                                                "sense_id": "abad3659-1012-304a-b995-5f44e62e2476",
                                                "text": "Some others get a rotten wheele, all worne and cast aside,\nWhich covered round about with strawe, and tow, they closely hide:\nAnd caryed to some mountaines top, being all with fire light,\nThey hurle it down with violence, when darke appeares the night"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba5ef35-8bbc-34ee-bbf0-d5f335fcd031",
                                        "entry_id": "62f148fd-c55f-3ead-a420-2253e4370e45",
                                        "glosses": [
                                            "Physical action which causes destruction, harm, pain, or suffering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9056165f-a237-4052-8b4a-34f131dd82a8",
                                                "sense_id": "8ba5ef35-8bbc-34ee-bbf0-d5f335fcd031",
                                                "text": "We try to avoid violence in resolving conflicts."
                                            },
                                            {
                                                "example_id": "b2f58e2b-d5da-4de0-b648-228044078aa5",
                                                "sense_id": "8ba5ef35-8bbc-34ee-bbf0-d5f335fcd031",
                                                "text": "There is nothing unique or magical about the Middle East; it shares xenophobias and violences with all the rest of the world!"
                                            },
                                            {
                                                "example_id": "c5bb52c1-1af7-4fe8-b255-0dfe8c9ce3e7",
                                                "sense_id": "8ba5ef35-8bbc-34ee-bbf0-d5f335fcd031",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f118b47-f90e-319d-93f9-d93fbf7f8775",
                                        "entry_id": "62f148fd-c55f-3ead-a420-2253e4370e45",
                                        "glosses": [
                                            "Widespread fighting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d766e24-4f57-4bde-88ad-b8b22d0d75a8",
                                                "sense_id": "5f118b47-f90e-319d-93f9-d93fbf7f8775",
                                                "text": "Violence between the government and the rebels continues."
                                            },
                                            {
                                                "example_id": "e0dd3a41-25e7-487d-9217-68a1cfc19db4",
                                                "sense_id": "5f118b47-f90e-319d-93f9-d93fbf7f8775",
                                                "text": "But by the early 2000s, we were seeing fewer games like DOOM that dealt in the fantasia of ultraviolence and more games that tried to replicate the everyday violence of military encounters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7fd918a-9397-3aae-b5e7-54d277592e3f",
                                        "entry_id": "62f148fd-c55f-3ead-a420-2253e4370e45",
                                        "glosses": [
                                            "Injustice, wrong."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "736f710d-963d-4357-a95c-c935b846d794",
                                                "sense_id": "c7fd918a-9397-3aae-b5e7-54d277592e3f",
                                                "text": "The translation does violence to the original novel."
                                            },
                                            {
                                                "example_id": "8b963768-fdee-46e3-b9b3-546dab146f06",
                                                "sense_id": "c7fd918a-9397-3aae-b5e7-54d277592e3f",
                                                "text": "Racism, classism, sexism, ethnocentrism, and heterosexism are also wicked problems of structural violence […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "violence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fbfa05e-653e-39d8-a9a7-f605534cb08d",
                                        "entry_id": "b5fa4f27-0858-3750-8f3c-95c300a708e2",
                                        "glosses": [
                                            "To subject to violence."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0aa2c95-af99-467b-9f03-a55eda68f4da",
                                                "sense_id": "1fbfa05e-653e-39d8-a9a7-f605534cb08d",
                                                "text": "The key general point is that the idea of the agendered, asexual, aviolenced worker is a fiction; workers and organizational members do not exist in social abstraction; they are gendered, sexualed and violenced, partly by their position ..."
                                            },
                                            {
                                                "example_id": "a9a28c60-fe2b-4817-b944-580875490bff",
                                                "sense_id": "1fbfa05e-653e-39d8-a9a7-f605534cb08d",
                                                "text": "And the triad is made complete by she who is violenced by him."
                                            },
                                            {
                                                "example_id": "cd5ae773-2320-43c3-a68f-d5b1c9cae1a8",
                                                "sense_id": "1fbfa05e-653e-39d8-a9a7-f605534cb08d",
                                                "text": "He physically violenced my mother, physically violenced me and my brothers, and was sexually abusive to me until I was in second grade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4374d3b6-eed0-4058-b168-472966f24106",
                        "source_entry_id": "f1755f9b-b5f8-3951-b8f0-32e622cbf437",
                        "source_sense_id": "1e937827-b3ea-39bf-a9ca-a8132618fb48",
                        "target_lang_word": "unrestrainedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrestrainedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08cea00c-6eee-31de-a0f7-47591f265670",
                                        "entry_id": "64d6d9b7-3126-3699-93ca-cd905e619532",
                                        "glosses": [
                                            "The state of being unrestrained."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1a8b4d5-c018-4471-a4db-ee4f60d8ecbb",
                        "source_entry_id": "f1755f9b-b5f8-3951-b8f0-32e622cbf437",
                        "source_sense_id": "1e937827-b3ea-39bf-a9ca-a8132618fb48",
                        "target_lang_word": "violence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6508e66-00a3-3af7-b95d-7011785151b3",
                                        "entry_id": "305ed697-00a2-3235-8ff3-f760bf0cbc89",
                                        "glosses": [
                                            "Impétuosité ; force non contenue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89da7590-fa62-4910-ab87-a6accba86c6a",
                                                "sense_id": "d6508e66-00a3-3af7-b95d-7011785151b3",
                                                "text": "Si elle tenait encore debout, c’était bien par miracle, car la violence du feu concentré dans l’intérieur du bâtiment l’avait trouée par places, comme auraient pu le faire des boulets de canon."
                                            },
                                            {
                                                "example_id": "fd35bd91-d2d0-4d23-a48f-8d205231428f",
                                                "sense_id": "d6508e66-00a3-3af7-b95d-7011785151b3",
                                                "text": "Se venger, les tuer ! La violence naturelle à son tempérament sanguin lui dicta les pires conseils."
                                            },
                                            {
                                                "example_id": "908fbf07-982b-4d9a-b2a7-82bcda1d02b7",
                                                "sense_id": "d6508e66-00a3-3af7-b95d-7011785151b3",
                                                "text": "Les rafales d’une violence inouïe, accès de colère de Wottan ou de Thor, tombent des hauteurs en sifflant et soulèvent des tourbillons d’embruns qui sillonnent la mer."
                                            },
                                            {
                                                "example_id": "0e5824e7-3eb9-45bc-b4ff-0c27db9fa30b",
                                                "sense_id": "d6508e66-00a3-3af7-b95d-7011785151b3",
                                                "text": "Sans parler de Vessières, de Piédesclop, de tous les braillards. D’Amélie Lagueyte, la Soiffarde aux violences d’aliénée."
                                            },
                                            {
                                                "example_id": "66c96092-1740-48bc-a1bb-3dbca84bef35",
                                                "sense_id": "d6508e66-00a3-3af7-b95d-7011785151b3",
                                                "text": "Tout n’aura été que violence. Violence contre les médias. Violence contre ses adversaires politiques. Violence contre les Français. Violence entre les Français. Le meeting de Zemmour aura montré ce qu’il est : la haine, la division, le désordre et la violence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14343c34-94fe-30c3-b5a6-f383e941b50c",
                                        "entry_id": "305ed697-00a2-3235-8ff3-f760bf0cbc89",
                                        "glosses": [
                                            "Force dont on use contre le droit commun, contre les lois, contre la liberté publique."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9490c1f2-49b2-316d-b5a7-fe4c8dde11fa",
                                        "entry_id": "305ed697-00a2-3235-8ff3-f760bf0cbc89",
                                        "glosses": [
                                            "Force que l’on use dans la contestation sociale ou dans la répression des conflits sociaux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf7d5d6-b352-48db-9092-890f5e348568",
                                                "sense_id": "9490c1f2-49b2-316d-b5a7-fe4c8dde11fa",
                                                "text": "La violence prolétarienne change l’aspect de tous les conflits au cours desquels on l’observe ; car elle nie la force organisée par la bourgeoisie, et prétend supprimer l’État qui en forme le noyau central."
                                            },
                                            {
                                                "example_id": "dc9a5f7c-10c4-48e5-a0dc-f1221f36b57c",
                                                "sense_id": "9490c1f2-49b2-316d-b5a7-fe4c8dde11fa",
                                                "text": "La fonction du philosophe consiste exclusivement dans la profanation des idées. Aucune violence n’égale par ses effets la violence théorique. Plus tard, l’action vient…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbafb629-36c9-3188-80bf-6179894d298d",
                                        "entry_id": "305ed697-00a2-3235-8ff3-f760bf0cbc89",
                                        "glosses": [
                                            "Action physique ou psychologique accomplie pour obliger autrui à faire ou ne pas faire quelque chose, pour exprimer sa colère ou son désaccord, ou uniquement pour faire du mal."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e166ad6-a5d1-4ec7-afc4-7604c1809cc5",
                                                "sense_id": "cbafb629-36c9-3188-80bf-6179894d298d",
                                                "text": "Nous entendrons ici par violence l’ensemble des actes et des attitudes hostiles et agressifs entre individus, y compris l’usage de la contrainte et de la force pour obtenir quelque chose contre le gré d’autrui ou pour porter atteinte à son intégrité physique ou mentale. La violence est souvent utilisée par les humains et les animaux pour obtenir de la nourriture, pour se reproduire, pour se défendre, pour conquérir un territoire ou le protéger, pour affirmer son autorité ou son rang hiérarchique. On peut également nuire considérablement à autrui en le torturant mentalement et en lui rendant la vie insupportable sans pour autant avoir recours à la violence physique."
                                            },
                                            {
                                                "example_id": "6b323397-45df-4968-82cc-aca3e41ed9d0",
                                                "sense_id": "cbafb629-36c9-3188-80bf-6179894d298d",
                                                "text": "La violence déversée est assimilable à une poche de pus, une tumeur, un sac de détritus dont on s’est débarrassé sur l’autre, dans un jeu de patate chaude que l’on repasse à celui qui n’est pas armé pour la refuser, qui n’est pas en situation de la refuser ou qui ne comprend pas et qui reste sidéré par ce qu’on lui fait."
                                            },
                                            {
                                                "example_id": "edeb7af0-530c-4bbd-941d-d331b8a15198",
                                                "sense_id": "cbafb629-36c9-3188-80bf-6179894d298d",
                                                "text": "Acte de justice –\nSuite au délit de violence\npsychologique et émotionnelle\nen parole,\nvous allez verser\nun dédommagement\nà votre\n…\nassistant personnel virtuel."
                                            },
                                            {
                                                "example_id": "8e120dd0-89bd-417d-b342-6649b9b9cb88",
                                                "sense_id": "cbafb629-36c9-3188-80bf-6179894d298d",
                                                "text": "La violence, y compris lorsqu’elle est commise par le sexe, est un acte de négation par la personne qui le commet de l’altérité et de la légitimité de la personne qu’elle agresse. La violence est un instrument de domination incompatible avec la relation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
