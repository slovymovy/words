{
    "word_family": [
        "disability",
        "disabled",
        "disablement",
        "enabler",
        "enablement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a88b1ea2-4b21-3b57-bd3e-993790361e5e",
                    "sense_definition": "To deactivate or make a function of an electronic or mechanical device inoperational.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deactivate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot had to <w>disable</w> the autopilot of his airplane during the emergency.",
                            "target_lang_translations": {
                                "ru": "Пилоту пришлось <w>отключить</w> автопилот самолета во время чрезвычайной ситуации."
                            }
                        },
                        {
                            "text": "You can <w>disable</w> notifications in the settings menu if they become too distracting.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>выключить</w> уведомления в меню настроек, если они слишком отвлекают."
                            }
                        }
                    ],
                    "synonyms": [
                        "deactivate"
                    ],
                    "antonyms": [
                        "enable",
                        "re-enable"
                    ],
                    "common_phrases": [
                        "disable notifications",
                        "disable the alarm",
                        "disable a feature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деактивировать или сделать функцию электронного или механического устройства неработоспособной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отключать",
                                "target_lang_sense_clarification": "прерывать действие или связь в сети"
                            },
                            {
                                "target_lang_word": "выключать",
                                "target_lang_sense_clarification": "прерывать работу механизма или устройства"
                            },
                            {
                                "target_lang_word": "деактивировать",
                                "target_lang_sense_clarification": "делать неактивным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ac8a925-3c62-34ff-bcc4-541e596ae4f6",
                    "sense_definition": "To cause a serious or permanent injury that impairs someone's physical or mental abilities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A severe injury to his spine could <w>disable</w> him for the rest of his life.",
                            "target_lang_translations": {
                                "ru": "Серьезная травма позвоночника могла бы <w>покалечить</w> его на всю оставшуюся жизнь."
                            }
                        },
                        {
                            "text": "The goal of the martial art is to <w>disable</w> an attacker as quickly as possible.",
                            "target_lang_translations": {
                                "ru": "Цель этого боевого искусства — как можно быстрее <w>вывести из строя</w> нападающего."
                            }
                        }
                    ],
                    "synonyms": [
                        "cripple",
                        "incapacitate"
                    ],
                    "antonyms": [
                        "capacitate"
                    ],
                    "common_phrases": [
                        "permanently disable",
                        "disable an opponent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанести серьезную или необратимую травму, которая нарушает физические или умственные способности человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалечить",
                                "target_lang_sense_clarification": "сделать калекой, изувечить"
                            },
                            {
                                "target_lang_word": "калечить",
                                "target_lang_sense_clarification": "наносить увечье, делать неспособным"
                            },
                            {
                                "target_lang_word": "выводить из строя",
                                "target_lang_sense_clarification": "лишать возможности действовать или сражаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03f12ec8-a314-3db1-9291-d8a29e68a0f0",
                    "sense_definition": "To render someone or something unable to perform a specific task or function.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy snowstorm managed to <w>disable</w> the entire city's transport network.",
                            "target_lang_translations": {
                                "ru": "Сильная метель сумела <w>парализовать</w> всю транспортную сеть города."
                            }
                        },
                        {
                            "text": "The virus was designed to <w>disable</w> the security protocols of the main server.",
                            "target_lang_translations": {
                                "ru": "Вирус был разработан для того, чтобы <w>заблокировать</w> протоколы безопасности главного сервера."
                            }
                        }
                    ],
                    "synonyms": [
                        "disenable"
                    ],
                    "antonyms": [
                        "enable"
                    ],
                    "common_phrases": [
                        "disable the system",
                        "disable the engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо или что-либо неспособным выполнять определенную задачу или функцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить из строя",
                                "target_lang_sense_clarification": "делать неработоспособным"
                            },
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "прекращать доступ или функционирование"
                            },
                            {
                                "target_lang_word": "парализовать",
                                "target_lang_sense_clarification": "делать невозможным нормальную деятельность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9ba682eb-16ba-3056-a920-d6e91e7a8766",
                    "sense_definition": "Lacking the necessary ability or power; being <w>unable</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incapacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general lamented his <w>disable</w> and unactive force during the long winter siege.",
                            "target_lang_translations": {
                                "ru": "Генерал сетовал на свои <w>бессильные</w> и бездействующие войска во время долгой зимней осады."
                            }
                        },
                        {
                            "text": "In those days, a <w>disable</w> limb often meant a life of extreme poverty.",
                            "target_lang_translations": {
                                "ru": "В те времена <w>увечная</w> конечность часто означала жизнь в крайней нищете."
                            }
                        }
                    ],
                    "synonyms": [
                        "unable"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This adjectival use is rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный необходимых способностей или силы; неспособный (устаревшее использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспособный",
                                "target_lang_sense_clarification": "не имеющий возможности что-либо сделать"
                            },
                            {
                                "target_lang_word": "бессильный",
                                "target_lang_sense_clarification": "лишенный сил или власти"
                            },
                            {
                                "target_lang_word": "увечный",
                                "target_lang_sense_clarification": "имеющий физический недостаток"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}