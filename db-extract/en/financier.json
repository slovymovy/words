                                        "glosses": [
                                            "vermögender Geldgeber, der bestimmte Dinge finanziert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df273378-109d-4462-a52a-0079545a4d38",
                                                "sense_id": "48b2ebc5-240b-36e2-bf88-c205c33b8c87",
                                                "text": "Financier Johann Hansmann ist an zahlreichen österreichischen Start-ups beteiligt."
                                            },
                                            {
                                                "example_id": "88d143ef-6a20-4ffb-9f4b-b1023e120ab2",
                                                "sense_id": "48b2ebc5-240b-36e2-bf88-c205c33b8c87",
                                                "text": "Im Kosovo ist laut der Tageszeitung Zeri ein Financier des Terrornetzwerks \"Islamischer Staat\" (IS) festgenommen worden."
                                            },
                                            {
                                                "example_id": "9cf9c6a3-910d-4185-acd9-b37eaf22fac2",
                                                "sense_id": "48b2ebc5-240b-36e2-bf88-c205c33b8c87",
                                                "text": "Der italienische Financier Roberto Colaninno hat am Montag mitgeteilt, dass seine börsenkotierte Beteiligungsfirma Immsi derzeit in Verhandlungen um den Erwerb einer Kontrollbeteiligung am traditionsreichen Motorradhersteller Piaggio stehe."
                                            },
                                            {
                                                "example_id": "3b69f675-0fa4-4e20-94d0-c52cb4e2e61a",
                                                "sense_id": "48b2ebc5-240b-36e2-bf88-c205c33b8c87",
                                                "text": "Schwankend im Fond erhob sich der Financier, Officiere öffneten den Schlag."
                                            },
                                            {
                                                "example_id": "ab00fa4f-14c3-474e-9ddf-15e5d07dff30",
                                                "sense_id": "48b2ebc5-240b-36e2-bf88-c205c33b8c87",
                                                "text": "Bald wurde er zu verschiedenen wichtigen Geschäften auf den ersten Handelsplätzen des Continents, in Berlin, Kopenhagen, Brüssel und dem Haag verwendet, wo er mit großem Geschicke bedeutende Finanzprojecte in’s Werk setzte und sich bald als ein gewiegter Financier bewährte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
