{
    "word_family": [
        "craft",
        "crafty",
        "craftsmanship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01c3f47e-d900-3941-849f-23cf27430645",
                    "sense_definition": "Someone who is highly skilled at their trade",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skilled_worker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master <w>craftsperson</w> spent years perfecting the delicate technique of glass blowing.",
                            "target_lang_translations": {
                                "ru": "Мастер-<w>ремесленник</w> потратил годы на совершенствование тонкой техники выдувания стекла."
                            }
                        },
                        {
                            "text": "Every piece of furniture in the shop was handmade by a dedicated <w>craftsperson</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый предмет мебели в магазине был изготовлен вручную преданным своему делу <w>мастером</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "artificer",
                        "artisan"
                    ],
                    "common_phrases": [
                        "skilled craftsperson"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий высоким мастерством в своем ремесле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "квалифицированный специалист в какой-либо области"
                            },
                            {
                                "target_lang_word": "ремесленник",
                                "target_lang_sense_clarification": "человек, занимающийся изготовлением изделий ручного труда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c987c818-3b27-3c64-aa0c-c2a0fbe14cc3",
                    "sense_definition": "A person who produces arts and crafts",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skilled_worker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>craftsperson</w> sold handmade pottery at the weekend market.",
                            "target_lang_translations": {
                                "ru": "Местный <w>ремесленник</w> продавал керамику ручной работы на рынке выходного дня."
                            }
                        },
                        {
                            "text": "She is a talented <w>craftsperson</w> who creates beautiful jewelry from recycled materials.",
                            "target_lang_translations": {
                                "ru": "Она талантливый <w>мастер</w>, который создает красивые украшения из переработанных материалов."
                            }
                        }
                    ],
                    "synonyms": [
                        "artist"
                    ],
                    "common_phrases": [
                        "local craftsperson"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который создает предметы декоративно-прикладного искусства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастер прикладного искусства",
                                "target_lang_sense_clarification": "специалист по созданию художественных изделий"
                            },
                            {
                                "target_lang_word": "ремесленник",
                                "target_lang_sense_clarification": "тот, кто создает изделия ручной работы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}