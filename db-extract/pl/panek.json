                        "sense_id": "4f7931f1-04f6-3c20-8480-da140429ca7e",
                        "entry_id": "a609dcb6-f3ff-3c4b-a429-ca620cd79106",
                        "glosses": [
                            "allzu eingebildeter Mann; Bürschchen, Wichtigtuer"
                        ],
                        "tags": [
                            "ironisch"
                        ],
                        "examples": [],
