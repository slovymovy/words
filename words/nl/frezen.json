                    "frequency": "Middle",
                    "semantic_group_id": "werktuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de werkplaats liggen verschillende soorten <w>frezen</w> voor de metaalbewerking.",
                            "target_lang_translations": {
