                                "target_senses": [
                                    {
                                        "sense_id": "7e1f9ef0-32b2-3ade-b44d-ace49bc8af5b",
                                        "entry_id": "01de846c-c0b1-3253-80b6-5cf58effa65d",
                                        "glosses": [
                                            "Musikinstrument, bei dem der Ton mit Hilfe von verschieden großen, auf einer Achse, die durch einen Fußantrieb gedreht wird, ineinandergeschobenen Glasglocken erzeugt wird. Der Spieler berührt mit nassen Fingern oder mit einem Bogen die Glasglocken und erzeugt so die Töne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922f2d55-8b3e-40a1-99ce-332f7d8d85ae",
                                                "sense_id": "7e1f9ef0-32b2-3ade-b44d-ace49bc8af5b",
                                                "text": "Der Tonumfang der Glasharmonika beträgt zweieinhalb bis vier Oktaven und ist chromatisch gestimmt."
                                            },
                                            {
                                                "example_id": "f3f95c63-7f74-4464-88c9-4da8059e8b8a",
                                                "sense_id": "7e1f9ef0-32b2-3ade-b44d-ace49bc8af5b",
                                                "text": "\"Für die Salons der gehobenen Gesellschaft\" hatte Benjamin Franklin \"die Glasharmonika gedacht, ein aus 37 Glaszylindern unterschiedlichen Durchmessers bestehendes Instrument, über das der \"Pianist\" seine angefeuchteten Fingerkuppen gleiten ließ und ihm so wahre Sphärenklänge von vollendeter Lieblichkeit entlockte. Wolfgang Amadeus Mozart komponierte Stücke für die Glasharmonika, …\""
                                            },
                                            {
                                                "example_id": "80207758-f11d-4727-b4ce-03b6129b89b9",
                                                "sense_id": "7e1f9ef0-32b2-3ade-b44d-ace49bc8af5b",
                                                "text": "„Hamann legt die Scherbe oben auf die Glasharmonika, streicht noch einmal die Noten glatt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
