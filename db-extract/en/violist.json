                                        "entry_id": "5e1d9345-a479-3fff-bf9b-4e5a7028965d",
                                        "glosses": [
                                            "Celui, celle qui joue de l’alto (instrument à cordes, saxophone ou clarinette alto)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd0ab37-6d50-4fe0-a6d9-da005fb97f84",
                                                "sense_id": "a1830c38-2a03-3e8b-a578-0fe0941f716e",
                                                "text": "Marisa est une altiste pleine de fougue et de sensibilité."
                                            },
                                            {
                                                "example_id": "f339d6e0-726b-4fbb-909e-3caaf6786232",
                                                "sense_id": "a1830c38-2a03-3e8b-a578-0fe0941f716e",
