                                    {
                                        "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                        "entry_id": "16bff036-7cca-3423-ad4f-d3a77a67580a",
                                        "glosses": [
                                            "(meist mit negativer Konnotation) sehr lang und oft zu lang in Bezug auf Menge oder Zeit: sehr viel, lang dauernd"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8154e2-6141-4cf8-abfb-0c992c56ae17",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Bei dem ellenlangen Vortrag bin ich fast eingeschlafen."
                                            },
                                            {
                                                "example_id": "caab0a4e-f172-4449-af79-c7a1310d804a",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Seine ellenlangen Emails sind sehr anstrengend."
                                            },
                                            {
                                                "example_id": "ca1af3a4-bc1e-45cb-8c0a-87e79a9e8a09",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Es dauert ewig, diese ellenlangen Inventurlisten abzuarbeiten."
                                            },
                                            {
                                                "example_id": "39b472ab-3721-46ed-b0ef-753f153eab98",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Diese ellenlangen IBAN-Nummern für sein Bankkonto kann sich kein Mensch merken."
                                            },
                                            {
                                                "example_id": "eb5e189d-2505-48f3-9588-5b6a5220e59b",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Eineinhalb Jahre nach seiner Eröffnung hat sich der Witwenball etabliert als Weinlokal für Kenner. Die Karte ist nicht ellenlang, aber spannend sortiert."
                                            },
                                            {
                                                "example_id": "0346362b-52e5-4a09-a6d0-e2908f1e83d4",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Das Open-Air-Künstlerareal Odonien stritt mit der Stadt ellenlang über dessen Rettung."
                                            },
                                            {
                                                "example_id": "a8ef6a39-f734-42ae-bcb0-6e62f717457a",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Ellenlang ist die Schlange vor dem Eingang, bevor es losgeht. Und pickepackevoll ist schließlich der Saal des SO 36 in Berlin-Kreuzberg."
                                            },
                                            {
                                                "example_id": "566e3e81-6c9f-410e-9e4e-542bce355a98",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Auch wenn die Diagnose, dass das Kind sterben muss, vorliegt, ist doch der Krankheitsverlauf oft unberechenbar, kann sich ellenlang hinziehen."
                                            },
                                            {
                                                "example_id": "e532df3a-21a2-4f5d-b1ae-8df171e1523c",
                                                "sense_id": "6a77df92-e9c6-3758-9b76-05257709d9b9",
                                                "text": "Nun müsse definiert werden, wie viel Bürokratie wann sein muss - oder eben nicht: \"Die Gemeinden sind ja auch froh, wenn sie solche Anträge nicht oft und nicht so ellenlang bearbeiten müssen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
