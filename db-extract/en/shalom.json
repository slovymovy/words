                    {
                        "sense_id": "4f53266c-8c45-3219-a173-a28e6a79e1bf",
                        "entry_id": "0957ad51-190a-38bf-ad05-40b5f32b1616",
                        "glosses": [
                            "The traditional Jewish greeting of \\\"shalom\\\"."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a8eb279-2b46-4592-8960-77f873cc41c7",
                                "sense_id": "4f53266c-8c45-3219-a173-a28e6a79e1bf",
                                "text": "He exchanged shaloms with a group of young people coming out of the synagogue and turned left toward a corner."
                            }
                        ]
                    },
                    {
                        "sense_id": "36f91ebb-47b2-3732-a0b2-e6d13148ffef",
                        "entry_id": "0957ad51-190a-38bf-ad05-40b5f32b1616",
                        "glosses": [
                            "Peace."
                        ],
                        "tags": [
                            "Judaism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "75a7cd3d-c3b8-4223-9c8e-30479fd05d13",
                                "sense_id": "36f91ebb-47b2-3732-a0b2-e6d13148ffef",
                                "text": "In Hebrew, bonai shalom means “builders of peace,” and the congregation welcomes both Jews and non-Jews to participate in all aspects of the community."
                            }
                        ]
                    }
