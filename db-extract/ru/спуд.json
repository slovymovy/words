                ],
                "senses": [
                    {
                        "sense_id": "918470dd-c164-3272-8d71-4e14681c1e7f",
                        "entry_id": "c913e95b-fa1d-382f-b9c9-574de867c26c",
                        "glosses": [
                            "устар. тайник, хранилище"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ce2446-bcbc-4d45-9def-084bde04752e",
                                "sense_id": "918470dd-c164-3272-8d71-4e14681c1e7f",
                                "text": "— Дожили мы до нежданного чуда: Вынул епископ добро из-под спуда."
                            },
                            {
                                "example_id": "5f022f05-24d6-4eb0-b3cb-bd5ec467a88f",
                                "sense_id": "918470dd-c164-3272-8d71-4e14681c1e7f",
                                "text": "Девки сыплют изумруд В кладовые, да под спуд. Пушкин А. С., Сказка о царе Салтане."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac033f86-981a-3c63-bb16-aaf66ebf689d",
                        "entry_id": "c913e95b-fa1d-382f-b9c9-574de867c26c",
                        "glosses": [
                            "устар. тяжесть, груз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3d55eb-13ec-4438-a762-1425a66ebf75",
                                "sense_id": "ac033f86-981a-3c63-bb16-aaf66ebf689d",
                                "text": "Утром поздно, уже переспав два раза срок, путешественник вдруг освобождает с трудом голову из-под спуда подушек."
                            },
                            {
                                "example_id": "191aafca-ba35-433e-8d90-6398bc75419f",
                                "sense_id": "ac033f86-981a-3c63-bb16-aaf66ebf689d",
                                "text": "Все четыре колеса очутились вверху, а я с Роськой и со всею нашею провизиею явились под спудом."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f3bf0c8-5c9f-3653-bb1e-1297ce2eb08b",
                        "entry_id": "c913e95b-fa1d-382f-b9c9-574de867c26c",
                        "glosses": [
                            "устар., перен. бремя, гнёт"
                        ],
