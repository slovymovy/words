                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a686dbc-71a3-4d90-905e-d885d52872db",
                        "source_entry_id": "031960be-0ada-35cb-b2fc-9958f82e12f7",
                        "source_sense_id": "a342fc86-3b1b-3c1b-8c18-1fb0fb83b086",
                        "target_lang_word": "nasiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nasiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fda70227-047c-3077-87e8-e0ad75f112b2",
                                        "entry_id": "64051a3d-8149-34ce-b6e2-f58c0952da8c",
                                        "glosses": [
                                            "Parler du nez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ddfef8-44a6-429e-84af-ebe69e3837e7",
                                                "sense_id": "fda70227-047c-3077-87e8-e0ad75f112b2",
                                                "text": "Ce qu’elle chantait – ah ! la fatale et maudite chanson ! –, c’était une vieille romance larmoyante et tendre, pareille à celles que les aveugles nasillent dans les rues."
                                            },
                                            {
                                                "example_id": "da251a60-7df1-4fd5-bf9c-4dce0350d360",
                                                "sense_id": "fda70227-047c-3077-87e8-e0ad75f112b2",
                                                "text": "Pas plus qu'un dieu ne regarde sa servante, je ne prêtais d'attention à cette vieille fille toujours nasillant des histoires de cuisine et de métairie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6243e40c-4409-386a-b117-1dfb38b6def3",
                                        "entry_id": "64051a3d-8149-34ce-b6e2-f58c0952da8c",
                                        "glosses": [
                                            "Produire un son nasillard."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c40ed6c-a46d-4db0-959e-fcdc68704714",
                                                "sense_id": "6243e40c-4409-386a-b117-1dfb38b6def3",
                                                "text": "Le phonographe nasillait une chanson du répertoire des Derviches du Désert !"
                                            },
                                            {
                                                "example_id": "c1671e97-ba21-45e6-8dd0-e1b0b124e785",
                                                "sense_id": "6243e40c-4409-386a-b117-1dfb38b6def3",
                                                "text": "Le palais des papes est à nous ! Les petits hommes turbulents du XXᵉ siècle font, en ces jours d’exposition, nasiller leurs gramophones sous la majesté de ces murailles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dd4a474-52a7-4624-a49d-cbbd17132830",
                        "source_entry_id": "031960be-0ada-35cb-b2fc-9958f82e12f7",
                        "source_sense_id": "a342fc86-3b1b-3c1b-8c18-1fb0fb83b086",
                        "target_lang_word": "parler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "886a8b6c-4d26-3cad-9594-38be5a85ee84",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "User de la faculté du langage ; proférer, prononcer, articuler des mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6411d27-1954-41d2-9c42-d55439e22369",
                                                "sense_id": "886a8b6c-4d26-3cad-9594-38be5a85ee84",
                                                "text": "Tout en procédant à sa toilette, elle parle toute seule, bavarde, gaie, animée, à cause qu’on est encore au printemps de la journée."
                                            },
                                            {
                                                "example_id": "93c32eff-8874-4bf0-8595-4ee5d000dcfb",
                                                "sense_id": "886a8b6c-4d26-3cad-9594-38be5a85ee84",
                                                "text": "Les deux travailleurs essuyèrent leurs visages trempés, […], puis se parlèrent et se comportèrent comme des hommes qui se congratulent d’une matinée bien employée."
                                            },
                                            {
                                                "example_id": "31e28244-ebd8-422d-9303-8c8f382f3404",
                                                "sense_id": "886a8b6c-4d26-3cad-9594-38be5a85ee84",
                                                "text": "Le café quasi désert ne comptait que son Guy de propriétaire plus un vieux pousse-mégot qui parlait à voix basse au fond de la pièce adjacente, […]."
                                            },
                                            {
                                                "example_id": "913a8181-0871-47ae-9d9c-3dac3671bbad",
                                                "sense_id": "886a8b6c-4d26-3cad-9594-38be5a85ee84",
                                                "text": "Parler du nez, de la gorge. Parler à l’oreille de quelqu’un. Parler avec peine. Il parle toujours entre ses dents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "715ec1b0-e30d-387a-b577-502ddf54a29d",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Imiter le langage de l’homme, en parlant de certains oiseaux comme les perroquets, les sansonnets, les geais, les pies, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da542b4a-1218-47f1-be15-588051f24456",
                                                "sense_id": "715ec1b0-e30d-387a-b577-502ddf54a29d",
                                                "text": "Apprendre à parler à un perroquet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b369f78a-351a-3bc3-80ee-7000151c749b",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Exprimer sa pensée en articulant les mots d’une langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aecee1e-d88f-4005-93fe-281d8f861669",
                                                "sense_id": "b369f78a-351a-3bc3-80ee-7000151c749b",
                                                "text": "La population de Saint-David m’intéressait fort par ses mœurs simples et naïves et parlait un curieux patois anglais plein d’expressions maritimes."
                                            },
                                            {
                                                "example_id": "769b0030-38eb-4edc-a2ae-95a938a6bf9f",
                                                "sense_id": "b369f78a-351a-3bc3-80ee-7000151c749b",
                                                "text": "Le philosophe doit éviter les ambiguïtés ou les plurivocités, et décider du langage qu'il entend au juste parler. Dans le cas contraire, les portes sont grandes ouvertes aux malentendus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3056095e-a8d6-34d8-80f1-0ead47ff47fa",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "S’exprimer sur certains sujets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdec7dbe-fd18-4ebe-9e6f-e2ca5da65a83",
                                                "sense_id": "3056095e-a8d6-34d8-80f1-0ead47ff47fa",
                                                "text": "Après le dîner, pendant lequel on n’avoit parlé que de politique, il fit la lecture de ses extraits."
                                            },
                                            {
                                                "example_id": "3d74b718-da40-4eb9-997c-5053c542c0d8",
                                                "sense_id": "3056095e-a8d6-34d8-80f1-0ead47ff47fa",
                                                "text": "Comme tous ceux qui écrivent beaucoup, Balzac parlait peu... Mais, dès qu’il parlait, le charme opérait. Il y avait, dans sa parole, une telle autorité, une telle séduction, qu’on oubliait très vite ses disgrâces physiques."
                                            },
                                            {
                                                "example_id": "46015b50-fdf0-4bca-8e9d-85573dfbce7d",
                                                "sense_id": "3056095e-a8d6-34d8-80f1-0ead47ff47fa",
                                                "text": "On ne peut parler que lorsqu’on a un lieu sûr où livrer cette parole."
                                            },
                                            {
                                                "example_id": "baf3610e-94a3-410f-b14e-2391110f07be",
                                                "sense_id": "3056095e-a8d6-34d8-80f1-0ead47ff47fa",
                                                "text": "Je n’ai jamais entendu parler de cette affaire. Toute la ville en parle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "216c62da-4e2e-3fdb-921a-f7fcff3f8df5",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Adresser la parole, avoir un entretien, converser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ab9b14-2366-4f5e-a46f-26850087557a",
                                                "sense_id": "216c62da-4e2e-3fdb-921a-f7fcff3f8df5",
                                                "text": "Parler avec quelqu’un. Parler à quelqu’un. Moi qui vous parle. C’est à vous que je parle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb29ef70-1849-358a-8f1d-039a0773ac20",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "S’entretenir de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad64937-4951-4592-838c-b7280dae49a2",
                                                "sense_id": "eb29ef70-1849-358a-8f1d-039a0773ac20",
                                                "text": "De quoi parlez-vous tous les deux ? Nous parlons de vos affaires. Nous en parlerons tantôt ensemble."
                                            },
                                            {
                                                "example_id": "ec4b87b9-52eb-41d0-b125-a72ab0f9d1f1",
                                                "sense_id": "eb29ef70-1849-358a-8f1d-039a0773ac20",
                                                "text": "Je vous parlerai de quelque chose qui vous regarde. Parlez de moi au ministre. Je les ai laissés qui parlaient d’affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83e49d1e-c698-3f6b-8b0f-63fa3b63eefc",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Révéler, dévoiler quelque chose."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "471d8fe1-aad5-4fe9-9e7f-e3439d4c5c57",
                                                "sense_id": "83e49d1e-c698-3f6b-8b0f-63fa3b63eefc",
                                                "text": "[…] il me touchait presque et hurlait: « Tu vas parler ! Tout le monde doit parler ici ! On a fait la guerre en Indochine, ça nous a servi pour vous connaître. Ici, c’est la Gestapo ! Tu connais la Gestapo ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "628b72bb-4b87-39f3-aa98-0f9757a80b85",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Expliquer ses sentiments, sa pensée, déclarer son intention, sa volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9325bc44-4442-48e2-b972-63c474515330",
                                                "sense_id": "628b72bb-4b87-39f3-aa98-0f9757a80b85",
                                                "text": "Une peste de psychologue, que mes parents m’avaient emmené voir sur le conseil d’une prof complètement tarée, avait parlé de « nonchaloir oriental » pour expliquer ces accès de paresse."
                                            },
                                            {
                                                "example_id": "98b7f068-1a3a-4220-9e34-4ff820e8d720",
                                                "sense_id": "628b72bb-4b87-39f3-aa98-0f9757a80b85",
                                                "text": "C’est un homme qui ne veut pas parler nettement. On a fait ce qu’on a pu pour le faire parler, mais il n’y a pas eu moyen d’en venir à bout."
                                            },
                                            {
                                                "example_id": "e0272cc6-a3f5-42c7-b5fa-a55bbeac5c7d",
                                                "sense_id": "628b72bb-4b87-39f3-aa98-0f9757a80b85",
                                                "text": "Je saurai bien le faire parler. Expliquez-vous mieux, ce n’est pas là parler. Parler au nom de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619c2488-5095-32f8-a93f-b4fabd1b032a",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Intervenir, prendre la parole pour ou contre quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bceb62ba-5ccd-449b-b99d-8b0e7b6c0b1e",
                                                "sense_id": "619c2488-5095-32f8-a93f-b4fabd1b032a",
                                                "text": "Ce député a parlé contre le projet de loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0108a63a-67a4-3cab-b099-6bff47ea331a",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Prononcer un discours, prendre la parole en public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfdd722e-3eb1-48bc-95b2-f6585c2e0608",
                                                "sense_id": "0108a63a-67a4-3cab-b099-6bff47ea331a",
                                                "text": "L’art de parler. Parler à son tour. Quand ce fut à lui de parler…. Parler sans préparation, sans être préparé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddc60252-fa15-383a-88c0-a07b408ec99b",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Expliquer sa pensée par écrit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594853d6-c8c3-470c-96f0-fb8797dddf0c",
                                                "sense_id": "ddc60252-fa15-383a-88c0-a07b408ec99b",
                                                "text": "Cette terrible histoire des Vaudois, dois-je en parler ou m’en taire ? En parler ? Elle est trop cruelle ; personne ne la racontera sans que la plume n’hésite, et que l’encre, en écrivant, ne blanchisse de larmes."
                                            },
                                            {
                                                "example_id": "5eb9eba7-ec81-4bff-9a85-e3fe3591e19a",
                                                "sense_id": "ddc60252-fa15-383a-88c0-a07b408ec99b",
                                                "text": "Le malgracieux mais spirituel Scarron écrivait jadis au cardinal de Retz dont il allait parler dans une préface : « Tenez-vous bien, monseigneur, je m'en vais vous peindre. »"
                                            },
                                            {
                                                "example_id": "527207eb-6340-4fcb-bb42-fdfb64c4b95b",
                                                "sense_id": "ddc60252-fa15-383a-88c0-a07b408ec99b",
                                                "text": "La loi est formelle là-dessus et parle très clairement. Le contrat ne parle point de cette clause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82b19d06-6074-3208-9680-bbb84f1b113a",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Manifester ses sentiments, ses pensées par un autre moyen que celui de la parole."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f5f81d-1dcb-439c-9d43-39e300c1b382",
                                                "sense_id": "82b19d06-6074-3208-9680-bbb84f1b113a",
                                                "text": "Les muets parlent par signes. Il me parlait des yeux et du geste. Chaque mouvement de cet habile pantomime parlait aux yeux des spectateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eac5af9c-cb5b-3f4f-83af-e56665d04abc",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Provoquer des émotions, des sentiments en parlant des choses qui ont ou qui semblent avoir une sorte de langage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e113bc18-4c3c-47d0-b4df-a997dd8bb395",
                                                "sense_id": "eac5af9c-cb5b-3f4f-83af-e56665d04abc",
                                                "text": "Ensuite c’est à chacun de voir en quoi cela l’intéresse, le concerne, lui parle. Il n’y a strictement aucune prétention comminatoire du genre : si vous ne passez pas par là, vous êtes fichu."
                                            },
                                            {
                                                "example_id": "9710057f-42fc-4e46-8e9d-2093a26754f8",
                                                "sense_id": "eac5af9c-cb5b-3f4f-83af-e56665d04abc",
                                                "text": "La peinture parle aux yeux. Ses yeux parlent. Son visage parle."
                                            },
                                            {
                                                "example_id": "e2f0d271-85af-41a5-b211-519c64c0ab97",
                                                "sense_id": "eac5af9c-cb5b-3f4f-83af-e56665d04abc",
                                                "text": "La nature, le sang a parlé, quand il a revu son fils malheureux. En votre absence, tout ici nous parlait de vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20a2eb0-79b1-3b4b-92e6-146be0afa35f",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Démontrer ou confirmer ses qualités."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927f3185-5eb3-4f34-92d9-3b487106c291",
                                                "sense_id": "a20a2eb0-79b1-3b4b-92e6-146be0afa35f",
                                                "text": "Pas de surprise lors du dernier tiercé : le favori l’a emporté de dix longueurs, sa classe a parlé."
                                            },
                                            {
                                                "example_id": "a282f672-2a0f-40c1-b3c5-c4315493aed5",
                                                "sense_id": "a20a2eb0-79b1-3b4b-92e6-146be0afa35f",
                                                "text": "Lors du championnat du monde des mi-lourds à mi-combat le champion en titre mène largement aux points, c’est le métier qui parle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37a4f94-3485-3645-88b8-5edb0ed0e7cf",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Se servir d’un langage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67056bc5-70b2-4fa5-b084-43aa10e157df",
                                                "sense_id": "e37a4f94-3485-3645-88b8-5edb0ed0e7cf",
                                                "text": "Parler une langue. Parler français, italien, allemand, etc. La langue française se parle, est parlée dans tous les pays du monde."
                                            },
                                            {
                                                "example_id": "53f49473-fbda-4ef9-932c-47062aa5269b",
                                                "sense_id": "e37a4f94-3485-3645-88b8-5edb0ed0e7cf",
                                                "text": "Il parle plusieurs langues. Le langage que parlaient nos pères."
                                            },
                                            {
                                                "example_id": "3a8bbde3-17ba-42a8-b541-f1fda4610b06",
                                                "sense_id": "e37a4f94-3485-3645-88b8-5edb0ed0e7cf",
                                                "text": "Ce poète dramatique, ce romancier fait parler à chacun son langage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f2b8cab-a032-3f79-9cc5-a5d67b19cbea",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "S’entretenir de quelque chose, en raisonner, en discourir."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "note": "dans ce cas on ne met jamais l’article devant le nom",
                                        "examples": [
                                            {
                                                "example_id": "583a9cfe-b7a2-4004-b62f-46ecb7a6dadd",
                                                "sense_id": "8f2b8cab-a032-3f79-9cc5-a5d67b19cbea",
                                                "text": "Parler géométrie, musique, peinture, politique, etc. Parler affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1500fdae-f89a-31d1-8a9e-e1cbd9a8b499",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Être sceptique sur le sujet."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "transitive"
                                        ],
                                        "note": "forme transitive de tu parles",
                                        "examples": [
                                            {
                                                "example_id": "c5339ff1-4249-4028-8498-d45ee5f4be9e",
                                                "sense_id": "1500fdae-f89a-31d1-8a9e-e1cbd9a8b499",
                                                "text": "« En vingt minutes à peine, ils nous ont dit : “Merci vous pouvez rentrer chez vous” », lance dans un calme paradoxal, Frédéric, vingt-deux ans d’ancienneté sur le site de La Roche-sur-Yon. « Vous parlez d’un modèle social ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb7dc2c-14e1-35d6-98a1-7fda5005ad71",
                                        "entry_id": "3fd91c90-3d36-3dfb-ab5a-d2183bd504e7",
                                        "glosses": [
                                            "Mettre en mots ou en récit un psychotraumatisme de façon à en alerter autrui et/ou à en réduire les séquelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53fd19c1-e0bf-41b1-8161-7a4de61ecd8c",
                                                "sense_id": "dbb7dc2c-14e1-35d6-98a1-7fda5005ad71",
                                                "text": "Parler, parvenir à se dégager de l’impact de la violence subie n’est pas si simple. Et il est bien illusoire de penser que, parce que l’enfant est convoqué tel jour à telle heure pour une évaluation, une audition ou une expertise, il pourra parler et mettre des mots sur ce qu’il a subi. Il est tout aussi illusoire de penser que parler libérera magiquement l’enfant de toute sa souffrance, de sa honte, de sa peur et de sa culpabilité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                        "entry_id": "0eb6a947-cbee-3ca6-8042-861058969546",
                                        "glosses": [
                                            "Forme de langage particulière à une catégorie sociale, une profession, une région…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7164d76-97dc-42b2-8910-b9127a2bbe08",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "Pourtant un juge sévère aurait pu lui reprocher une délicatesse outrée et un mépris trop absolu pour le parler haut et l’impudence de nos jeunes hommes à succès."
                                            },
                                            {
                                                "example_id": "a4e92f2f-19ef-473d-9df4-84fca9dd2545",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "M. de Pontlevé avait ce parler long et figuré des gens diserts du temps de Louis XVI, qui passait alors pour de l’esprit."
                                            },
                                            {
                                                "example_id": "71033b45-cf90-41f0-ab04-1353dcba0f44",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "Il n’est possible de caractériser avec précision les parlers du Bas-Maine qu’en les comparant aux parlers voisins."
                                            },
                                            {
                                                "example_id": "cb0dd340-1abe-4247-9ad2-e1e365ea91b1",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "Les Bretons, ces émigrants celtiques venus de Grande-Bretagne au Vᵉ siècle de notre ère, avaient ramené en Armorique une langue très analogue à ce parler gaulois que d'ailleurs employait encore à cette époque, la population d'Auvergne."
                                            },
                                            {
                                                "example_id": "482a7d4f-3a00-422a-bc21-f4a97b485cc2",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "J’essayai de l’excuser par l’exemple de tant de bons artisans du parler maternel qui tenaient pour leurs maîtres en langage les forts du port au foin et les vieilles lavandières."
                                            },
                                            {
                                                "example_id": "cf570075-0ae8-467d-94b5-47318ad88cb6",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "Le succès de ce type de langage en marge du français académique chez les adultes, entraîne au niveau de la jeunesse déscolarisée des années 1980, la création d’un parler similaire : le nouchi."
                                            },
                                            {
                                                "example_id": "a8f397a4-48d4-43bb-9450-9132dc2cbf7d",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "Quant aux mots arabes entrés dans le français de France, ils ont transité par un parler désormais éteint du fait du départ des Français, le pataouète, parler des quartiers populaires d’Alger."
                                            },
                                            {
                                                "example_id": "3291d811-9ff9-4157-8e0b-f31bb666093d",
                                                "sense_id": "9e7da99a-6bc9-3bc6-8a48-01d7280d719a",
                                                "text": "— Qu’adviendrons-nous demain ? se demandait à haute voix le vieux banquier dont le parler conservait les mauvaises tournures de ses origines plébéiennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
