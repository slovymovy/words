                                        "entry_id": "e44899cb-5bb8-34a2-a4b1-bd1fa7ea44be",
                                        "glosses": [
                                            "van een eerdere datum zijn"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe5cc59-c5a1-4f0c-a9f1-fc8bebec118c",
                                                "sense_id": "4a4ea0e4-e2b2-31f1-9bef-fe17a724ec99",
                                                "text": "Het vrij verkeer van personen antedateert het ontstaan van de verzorgingsstaat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d43547e4-240d-3c4a-9d87-997a2c8d0152",
                                        "entry_id": "e44899cb-5bb8-34a2-a4b1-bd1fa7ea44be",
                                        "glosses": [
                                            "een eerdere datum op een document schrijven dan die van de huidige dag"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f70fee-bcb5-4dfe-9926-0da275cdd0f0",
                                                "sense_id": "d43547e4-240d-3c4a-9d87-997a2c8d0152",
                                                "text": "De deurwaarder, die een dagvaarding antedateert, handelt onrechtmatig."
                                            },
                                            {
                                                "example_id": "5ba1adf5-fc82-4510-81bc-97c519b09193",
                                                "sense_id": "d43547e4-240d-3c4a-9d87-997a2c8d0152",
                                                "text": "Er volgde nog meer tegenslag voor Bernoulli toen zijn vader, Johann, zijn werk probeerde te stelen door een eigen, later geschreven manuscript te antedateren, om zo de indruk te wekken dat hij zijn zoon vóór was geweest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1c6a894-3ef2-450f-b4a6-25650ea4b6a0",
                        "source_entry_id": "9ac7f977-476a-36f3-bfeb-80a0f916142d",
                        "source_sense_description": "To assign a date earlier than the actual date; to backdate",
                        "target_lang_word": "antidater",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidater",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcf27e6e-f066-365a-a675-8d935ad0862f",
                                        "entry_id": "2aa74ed9-b324-3d14-963a-0432629a2229",
                                        "glosses": [
                                            "Marquer d’une date antérieure à la véritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d8e51c-9acd-412c-b7c5-dad6eeabfbb8",
                                                "sense_id": "fcf27e6e-f066-365a-a675-8d935ad0862f",
                                                "text": "Pourquoi aura-t-elle antidaté son journal intime ?"
                                            },
                                            {
                                                "example_id": "70b80e54-0bcf-455e-8185-32c233228744",
                                                "sense_id": "fcf27e6e-f066-365a-a675-8d935ad0862f",
                                                "text": "J’y vois un château à tourelles qui, comme il arrive souvent dans les Pays-Bas, paraît antidater d’un siècle l’époque où il fut bâti : les maçons du lieu retardaient sur ceux de la France."
                                            },
                                            {
                                                "example_id": "a0208211-4582-4a0b-94b6-b263e0dde4f4",
                                                "sense_id": "fcf27e6e-f066-365a-a675-8d935ad0862f",
                                                "text": "Mais antidater une pièce n’est-ce pas faire un faux ?"
                                            },
                                            {
                                                "example_id": "a18afbee-464d-4069-aadc-98c9ef51fbee",
                                                "sense_id": "fcf27e6e-f066-365a-a675-8d935ad0862f",
                                                "text": "Les policiers de Saint-Quentin multiplient également les mesquineries en antidatant des courriers qu’ils envoient à Clément, ce qui lui fait manquer des rendez-vous au commissariat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
