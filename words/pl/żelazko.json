                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Doktor <w>Żelazko</w> przyjmuje pacjentów w każdy poniedziałek i czwartek.",
                            "target_lang_translations": {
                                "ru": "Доктор <w>Желязко</w> принимает пациентов каждый понедельник и четверг."
                            }
                        },
                        {
                            "text": "Wczoraj spotkałem pana <w>Żelazkę</w>, z którym pracowałem w zeszłym roku.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил господина <w>Желязко</w>, с которым работал в прошлом году."
