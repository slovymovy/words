                                                "text": "a premature birth"
                                            },
                                            {
                                                "example_id": "ddc96215-e1ed-4e67-9d63-fdeadba9f247",
                                                "sense_id": "5405ee80-6f37-397b-95ff-00183fa867e5",
                                                "text": "premature reports of the singer's death"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba47216-7856-3e5a-a877-f68d6fc390f5",
                                        "entry_id": "e427c60c-117f-30bf-ac0d-a3cc75652016",
                                        "glosses": [
                                            "Taking place earlier than anticipated, prepared for, or desired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0894d039-9350-4a63-83b3-9a49e1d8873d",
                                                "sense_id": "8ba47216-7856-3e5a-a877-f68d6fc390f5",
                                                "text": "I was lost in reveries of death, and the idea of premature burial held continual possession of my brain."
                                            }
                                        ]
                                    },
