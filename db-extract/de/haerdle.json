                "senses": [
                    {
                        "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                        "entry_id": "33a4b36e-4631-389d-ac54-80aa5414f3ed",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225403e5-3263-4902-b6c4-d3c7150c9993",
                                "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                                "text": "Frau Haerdle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "31d38a80-f5ce-4ee5-9cf5-11c35a9bcc5d",
                                "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                                "text": "Herr Haerdle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ea0227e0-8797-4363-96d7-4925f301f1c9",
                                "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                                "text": "Die Haerdles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9c8ba7ee-c693-4bc9-b66c-c393a026d0e3",
                                "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                                "text": "Der Haerdle trägt nie die Schals, die die Haerdle ihm strickt."
                            },
                            {
                                "example_id": "fa435fc2-6303-461c-99f0-cfa00465a9b4",
                                "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haerdle kommt, geht der Herr Haerdle.“"
                            },
                            {
                                "example_id": "76860c24-ba9e-4dae-9237-3b94f41575ab",
                                "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                                "text": "Haerdle kommt und geht."
                            },
                            {
                                "example_id": "d0235556-a67d-4df6-8512-fc2bbf44f022",
                                "sense_id": "b36d2c63-abb3-3188-9fbf-9558443c8778",
                                "text": "Haerdles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
