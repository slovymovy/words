                    "frequency": "Middle",
                    "semantic_group_id": "person_living_abroad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>expatriates</w> enjoy the cultural experience of living in a foreign city."
                        },
                        {
                            "text": "The company provides support for <w>expatriates</w> moving to new international offices."
                        }
                    ],
                    "synonyms": [
                        "expat",
                        "emigrant"
                    ],
                    "common_phrases": [
