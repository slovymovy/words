                ],
                "senses": [
                    {
                        "sense_id": "5ccd5e4e-5745-3515-a267-ca20cbf46ff0",
                        "entry_id": "06d27291-1fd2-3d7d-9d99-2b9e1aaa9369",
                        "glosses": [
                            "Qui frémit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1f7e50-706b-48ce-9729-838f43ca616a",
                                "sense_id": "5ccd5e4e-5745-3515-a267-ca20cbf46ff0",
                                "text": "Marguerite fouilla vivement dans le coffre ouvert, et d’une main frémissante prit l’une après l’autre une douzaine de lettres […]."
                            },
                            {
                                "example_id": "01fad529-b52b-432b-930a-c0216e371560",
                                "sense_id": "5ccd5e4e-5745-3515-a267-ca20cbf46ff0",
                                "text": "Jean Valjean était entré au bagne sanglotant et frémissant ; il en sortit impassible."
                            },
                            {
                                "example_id": "70be9c4f-5a57-4456-848f-7e26d7d5a240",
                                "sense_id": "5ccd5e4e-5745-3515-a267-ca20cbf46ff0",
                                "text": "Le spasme la raidit, la tint frémissante... Puis la tête retomba et je serrai le petit corps tout faible contre moi."
                            },
                            {
                                "example_id": "642e7afe-8ea0-45d5-b051-4789e6daeade",
                                "sense_id": "5ccd5e4e-5745-3515-a267-ca20cbf46ff0",
                                "text": "Une ardeur frémissante. — Une jeunesse frémissante."
                            }
                        ]
                    },
                    {
                        "sense_id": "39bcfa8d-799f-32fe-bd33-e78408c621ea",
                        "entry_id": "06d27291-1fd2-3d7d-9d99-2b9e1aaa9369",
                        "glosses": [
                            "Qualifie de l'eau chaude qui commence, à peine, à bouillir."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6148e88e-2f23-453a-abff-d6d5c18bc816",
                                "sense_id": "39bcfa8d-799f-32fe-bd33-e78408c621ea",
                                "text": "— Ce n'était pas elle qui en avait acheté mais sa colocatrice, une théière frémissante toujours à la main, du temps où les deux étudiantes partageaient un appartement."
                            }
                        ]
                    }
