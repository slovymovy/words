                                                "sense_id": "a66b5b90-a26a-3493-b11f-2362afeff710",
                                                "text": "mustard flour"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc1d7b39-8dcc-3c19-9557-4ac1e3a13878",
                                        "entry_id": "8af7f714-31e2-3150-bf06-e7742b36b618",
                                        "glosses": [
                                            "Obsolete form of flower."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete",
