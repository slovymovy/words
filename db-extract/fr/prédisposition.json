        "fr-extract.jsonl": [
            {
                "entry_id": "96e30646-a21e-3d18-a689-e9da8d5da48d",
                "word": "prédisposition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "23f8b82d-05c8-4734-8fad-0f97beaef9c6",
                        "entry_id": "96e30646-a21e-3d18-a689-e9da8d5da48d",
                        "tags": [
                            "plural"
                        ],
                        "form": "prédispositions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f5b2163-48ca-347e-8f3b-f6a24124fee1",
                        "entry_id": "96e30646-a21e-3d18-a689-e9da8d5da48d",
                        "glosses": [
                            "Mise en dispositions favorables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7e8f157-dcee-4a59-b32e-35ef25ec97e3",
                                "sense_id": "3f5b2163-48ca-347e-8f3b-f6a24124fee1",
                                "text": "Au cours des dernières années, les affaires avaient marché cahin-caha, avec une prédisposition romanesque à l’insécurité, dans une petite échoppe délabrée ouvrant sur la Grand’Rue."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                        "entry_id": "96e30646-a21e-3d18-a689-e9da8d5da48d",
                        "glosses": [
                            "Ensemble de dispositions favorables existant d'emblée, avant l'événement qu'ils favoriseront."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7936e7ea-27bb-47f3-9798-a32e2bce6f92",
                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                "text": "Une circonstance remarquable de l’hérédité, c’est la concentration, la mise en réserve, si nous pouvons nous exprimer ainsi, de certaines prédispositions qui passent sans se manifester sur une, deux ou trois générations pour apparaître ensuite sur un sujet donné."
                            },
                            {
                                "example_id": "ffc91239-41d6-404d-97d1-3f210a434c00",
                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                "text": "La génétique a révélé que nous avons des prédispositions innées à de nombreuses maladies."
                            },
                            {
                                "example_id": "8d4d8fd2-c88b-4def-b935-4dd203c9e935",
                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                "text": "Cette prédisposition est liée à une fragilité de la trame collagénique contenue dans le disque."
                            },
                            {
                                "example_id": "5dd85610-4a3b-4f9c-bad4-7bf8b50ce339",
                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                "text": "Toutefois, cette tentative audacieuse de remplacer les humains par les mathématiques a mal calculé l’incalculable: la prédisposition de l'humanité à s'immiscer dans le processus, à le modifier, à le spolier, à le manipuler et à s'y immiscer"
                            }
                        ]
                    }
                ],
