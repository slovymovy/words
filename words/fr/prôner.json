                    "frequency": "High",
                    "semantic_group_id": "recommandation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association écologiste <w>prône</w> un mode de vie plus respectueux de la nature."
                        },
                        {
                            "text": "Pour résoudre cette crise politique, le gouvernement préfère <w>prôner</w> le dialogue plutôt que la force."
                        }
                    ],
                    "synonyms": [
