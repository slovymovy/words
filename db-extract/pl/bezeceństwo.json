                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5fb70b2-f9f4-3bb3-93c8-cb412f444a98",
                        "entry_id": "a44bcb8c-9bcd-301e-9cf7-d15e0983e815",
                        "glosses": [
                            "cecha tego, co bezecne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c8cfda7-945c-4a97-be24-8daa74f8fd34",
                                "sense_id": "d5fb70b2-f9f4-3bb3-93c8-cb412f444a98",
                                "text": "Bezeceństwo jego postępowania wzbudzało powszechną dezaprobatę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3c10faae-88b9-3945-ab0d-71424bc9676c",
                        "entry_id": "a44bcb8c-9bcd-301e-9cf7-d15e0983e815",
                        "glosses": [
                            "coś odrażającego i haniebnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b3466c3-1935-4652-929c-ba85ac954ff9",
                                "sense_id": "3c10faae-88b9-3945-ab0d-71424bc9676c",
                                "text": "Przestańcie oglądać te bezeceństwa w internecie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53c8aed8-88bb-4dd5-824f-b95e631ba999",
                        "source_entry_id": "a44bcb8c-9bcd-301e-9cf7-d15e0983e815",
                        "source_sense_id": "d5fb70b2-f9f4-3bb3-93c8-cb412f444a98",
                        "target_lang_word": "бессты́дство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бессты́дство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "65f873b2-ebba-35c3-b1dd-341a42ac66c9",
                                        "entry_id": "2b831285-943e-37b0-a3fd-37359740ffd8",
                                        "glosses": [
                                            "свойство по значению прилагательного бесстыдный; отсутствие стыда, стыдливости у кого-либо, пренебрежение к правилам приличия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3eff79b-68b9-4929-ad3a-89b93d3fc901",
                                                "sense_id": "65f873b2-ebba-35c3-b1dd-341a42ac66c9",
                                                "text": "Невыразимо грубое бесстыдство бесед о женщинах, окружая юношу душным, жарким облаком, угнетало его до отупения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c1e49fc-dc2a-35c8-be8e-1f20332cf24e",
                                        "entry_id": "2b831285-943e-37b0-a3fd-37359740ffd8",
                                        "glosses": [
                                            "что-либо бесстыдное, непристойное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba89956-b87c-4fea-92af-bbeafa17cbdb",
                                                "sense_id": "4c1e49fc-dc2a-35c8-be8e-1f20332cf24e",
                                                "text": "Вопр[ос]. Какие суть подлые души пятого рода? ¶ Отв[ет]. Те, кои имеют бесстыдство за свои прислуги принимать воздаяния, принадлежащие одним заслугам."
                                            },
                                            {
                                                "example_id": "7ce65ef7-e5ab-4b0c-9c31-6aba0728354e",
                                                "sense_id": "4c1e49fc-dc2a-35c8-be8e-1f20332cf24e",
                                                "text": "Правда, молодым девушкам очень пристало иногда задумываться, но думать — никогда: это ремесло прилично только тем низкорождённым людям, которые не могут обойтись без своей головы и которые имеют бесстыдство не различать нас с обезьянами."
                                            },
                                            {
                                                "example_id": "b9e731ca-b4e2-44af-b871-cb7eb2da078c",
                                                "sense_id": "4c1e49fc-dc2a-35c8-be8e-1f20332cf24e",
                                                "text": "Фаустин, несмотря на бесстыдство своё, замешался; но скоро опять ободрился и сказал: «Я не разумею вас, принцесса!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceb9c15a-b021-4a1e-97dd-1a5f11abd87b",
                        "source_entry_id": "a44bcb8c-9bcd-301e-9cf7-d15e0983e815",
                        "source_sense_id": "3c10faae-88b9-3945-ab0d-71424bc9676c",
