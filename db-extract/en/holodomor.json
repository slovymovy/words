        "de-extract.jsonl": [
            {
                "entry_id": "f5a0021d-a99c-39b8-909f-f411836f402d",
                "word": "Holodomor",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d4aaede1-acbd-33aa-8493-7d123f4711a3",
                        "entry_id": "f5a0021d-a99c-39b8-909f-f411836f402d",
                        "glosses": [
                            "Holodomor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36b7fec-4336-4910-83f6-d009efccf4a2",
                                "sense_id": "d4aaede1-acbd-33aa-8493-7d123f4711a3",
                                "text": "„The Holodomor (Ukrainian: Голодомор, \"Extermination by hunger\" or \"Hunger-extermination\"; derived from 'Морити голодом', \"Killing by Starvation\") was a man-made famine in the Ukrainian SSR and adjacent Cossack territories in 1932 and 1933. During the famine, which is also known as the \"Terror-Famine in Ukraine\" and \"Famine-Genocide in Ukraine\", millions of Ukrainians and Cossacks died of starvation in a peacetime catastrophe unprecedented in the history of Ukraine. Since 2006, the Holodomor has been recognized in Ukraine and some other countries as genocide of Ukrainians.“"
                            }
