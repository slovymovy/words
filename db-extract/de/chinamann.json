                "senses": [
                    {
                        "sense_id": "e58c3f88-76e5-394b-9932-58f5b965f7a4",
                        "entry_id": "5e004a33-3ede-3187-966c-81c0a9b6f20c",
                        "glosses": [
                            "männlicher Einwohner Chinas; männliche Person chinesischer Abstammung; Person aus (Süd-)Ostasien"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fd7f6e83-ab4f-4385-9a78-68f8d398f3cf",
                                "sense_id": "e58c3f88-76e5-394b-9932-58f5b965f7a4",
                                "text": "„Was ein braver Chinamann ist, der mogelt nicht.“"
                            },
                            {
                                "example_id": "2ca8ae0b-6099-41f9-9f17-0a7cbc1b0f9e",
                                "sense_id": "e58c3f88-76e5-394b-9932-58f5b965f7a4",
                                "text": "„Am späten Nachmittag war sie für etwa zwei Stunden weggenickt, hatte was vom Chinamann zu Abend gegessen und darauf geachtet, dass sie den Alkohol halbwegs unter Kontrolle hielt.“"
                            },
                            {
                                "example_id": "d42ec053-d4c0-43b1-95e6-84e5101add01",
                                "sense_id": "e58c3f88-76e5-394b-9932-58f5b965f7a4",
                                "text": "„Muntok ist ein sehr hübsches Dorf. Die Häuser, die meistentheils Chinamännern gehören, sind nett gebaut und gut angestrichen.“ [1869]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
