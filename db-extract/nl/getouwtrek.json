                                        "glosses": [
                                            "Jeu sportif entre deux personnes qui empoignent chacun le poignet de l’autre et forcent chacun vers la main non utilisée pour lui faire toucher la table."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e0ee4e3-2bb0-3660-a668-bb50ff28af50",
