                    {
                        "sense_id": "14bd368a-b50e-3826-9a8c-ca9b4c28e1c9",
                        "entry_id": "692a7fda-cfd4-3a86-9eb0-e7f12b443476",
                        "glosses": [
                            "eine häufig reich verzierte Spange am Chormantel, die das Gewand zusammenhält"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "cb50b7b7-242b-412b-835b-c87cea13588b",
                                "sense_id": "14bd368a-b50e-3826-9a8c-ca9b4c28e1c9",
                                "text": "„Schließlich hatten sie es auf das goldene Pektorale abgesehen, das fest mit der Brust Tutanchamuns verklebt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ecb154e-dc02-3953-bb69-1d4c7f3f9cb0",
                        "entry_id": "692a7fda-cfd4-3a86-9eb0-e7f12b443476",
                        "glosses": [
                            "Brustschmuck eines Bischofs in Form eines Kreuzes oder eines Brustschildes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14dd71f7-a4bb-444d-8b72-8b6e3859bf82",
                                "sense_id": "3ecb154e-dc02-3953-bb69-1d4c7f3f9cb0",
                                "text": "„Das Brustkreuz (Pektorale) wird an einer Schnur oder einer Kette um den Hals getragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
