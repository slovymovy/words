                        "entry_id": "5217d689-960b-3b7a-87e7-39a25a88ef28",
                        "glosses": [
                            "palliumähnliches oder kragenartiges Schulterkleid mit Behängen, das über das Messgewand angelegt wird; liturgischer Schulterschmuck einiger Bischöfe"
                        ],
                        "tags": [
                            "katholische Religion",
                            "Ritus"
                        ],
                        "examples": [
                            {
                                "example_id": "e5b3c90e-50d3-45eb-81fa-76960207ec58",
                                "sense_id": "59867251-760c-3a36-a439-0a6737949a53",
                                "text": "Im Mittelalter war das Rationale Ehrenschmuck besonders der deutschen Bischöfe."
                            },
                            {
                                "example_id": "25a7e53e-23d9-4506-92be-c3cf81bdde66",
                                "sense_id": "59867251-760c-3a36-a439-0a6737949a53",
                                "text": "„Die Verschiedenheit der Form des Rationale machen die in der Domkirche zu Eichstätt neben einander angebrachten Grabsteine des Bischofs Conrad II. († 1305) und Johann II. († 1429) anschaulich, wie nicht minder ein Glasgemälde daselbst, auf welchem letzterer abgebildet ist.“"
                            }
                        ],
