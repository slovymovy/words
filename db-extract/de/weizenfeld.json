                            {
                                "example_id": "c2f8aa0f-ae17-4bd5-a6da-7c5c6a430645",
                                "sense_id": "9178fe5d-f395-3cdf-ac09-a3efcef6eb0e",
                                "text": "Der Landwirt machte sich auf den Weg zu seinen Weizenfeldern."
                            },
                            {
                                "example_id": "63ccec22-0d13-499f-81d1-15e9842fa719",
                                "sense_id": "9178fe5d-f395-3cdf-ac09-a3efcef6eb0e",
                                "text": "„Sie verließ die Stadt, ging die bewaldete Anhöhe hinauf und zwischen Weizenfeldern und Wiesen nach Velda.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
