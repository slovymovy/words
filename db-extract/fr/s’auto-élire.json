                        "examples": [
                            {
                                "example_id": "7b252629-91dc-4fe7-9742-72c4a3e29005",
                                "sense_id": "b71269d1-dc51-32da-8818-ab9e3a3a2ae9",
                                "text": "On a ainsi une situation où le Conseil d’administration pourra se maintenir en place en recueillant auprès des actionnaires suffisamment de procurations pour s’auto-élire;"
                            },
                            {
                                "example_id": "9c15faa4-6631-45bb-b036-c46cfe276092",
                                "sense_id": "b71269d1-dc51-32da-8818-ab9e3a3a2ae9",
                                "text": "Si l’on est en droit de s’auto-élire membre de la République des lettres en adoptant ses us et coutumes, on ne peut pourtant accéder à une pleine citoyenneté sans passer par le stade de la consécration collective."
                            }
