                        "examples": [
                            {
                                "example_id": "88c7b1c2-2680-4c94-a2d2-ccb7dc32eeca",
                                "sense_id": "8b2c1d3d-52c5-337d-beb6-c44e262f0009",
                                "text": "De mannen beginnen hun allroundtoernooi pas op zaterdag en ook de sprintsters komen dan voor het eerst in actie."
                            },
                            {
                                "example_id": "8357148e-99eb-49fa-8fcf-8527b579109b",
                                "sense_id": "8b2c1d3d-52c5-337d-beb6-c44e262f0009",
                                "text": "De Vries kon niet precies uitleggen waarom het zo goed ging dit weekend. \"Het kwam gewoon allemaal precies goed uit. Ik rijd namelijk nooit goede afstanden in een allroundtoernooi, maar nu valt het allemaal op z'n plek. Dit is echt super!\""
                            },
                            {
                                "example_id": "aab208bc-c7a3-4d72-8603-70ce943ddca5",
                                "sense_id": "8b2c1d3d-52c5-337d-beb6-c44e262f0009",
                                "text": "De Laat eindigde als tweede, maar dat was niet genoeg om zijn allroundtoernooi te redden met een medaille. Op de achtervolging veroverde De Laat even later wel het goud met de Nederlandse ploeg."
                            }
                        ]
                    }
