                        "glosses": [
                            "Recette, argent gagné, compté afin de se mettre en règle, par exemple dans un contexte de prostitution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef43a25-9dae-4f67-a182-a555ada5237a",
                                "sense_id": "91e72252-8627-373a-b01c-ec42214e0264",
                                "text": "La comptée permet de savoir, quotidiennement, sur quel montant se fera le prélèvement fiscal."
                            },
                            {
                                "example_id": "d185bf46-2f6c-4057-8f1c-20fc31cebd07",
                                "sense_id": "91e72252-8627-373a-b01c-ec42214e0264",
                                "text": "Certains vont jusqu’à se faire remettre « la comptée » après chaque client et en tout cas à plusieurs reprises dans la journée."
                            },
                            {
                                "example_id": "b80e3b89-9bd4-49dd-b5d4-f08bf452d339",
                                "sense_id": "91e72252-8627-373a-b01c-ec42214e0264",
                                "text": "Et il laissait libre de décider. À condition que la comptée soit bonne."
                            }
                        ]
                    }
