                        "examples": [
                            {
                                "example_id": "8d0e3158-0bd0-430e-b6e2-248be8fc1ec6",
                                "sense_id": "cec315f4-3d1e-3ddd-88a5-eaa33e0eb983",
                                "text": "Par opposition aux concours ek tôn politôn, comme la pyrrhique, l’euandrie ou la lampadéphorie, qui mettent aux prises des groupes politiquement définis (ainsi la tribu) pour des récompenses collectives."
                            },
                            {
                                "example_id": "74319d0a-760d-42ef-9775-e496d9e889f3",
                                "sense_id": "cec315f4-3d1e-3ddd-88a5-eaa33e0eb983",
                                "text": "Les lampadédromies (λαμπαδηδρομία) ou lampadéphories (λαμπαδηφορία) sont des courses aux flambeaux qui faisaient partie du programme de certaines festivités de l’Antiquité grecque."
                            }
                        ]
                    }
