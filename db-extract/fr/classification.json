        "fr-extract.jsonl": [
            {
                "entry_id": "db511221-4d63-3c15-9313-b2e6f77afc37",
                "word": "classification",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c24646b7-9ce2-47f4-8af6-7122e5c3c4fb",
                        "entry_id": "db511221-4d63-3c15-9313-b2e6f77afc37",
                        "tags": [
                            "plural"
                        ],
                        "form": "classifications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0de9325c-bd37-34eb-941c-ac2ff69fb6ef",
                        "entry_id": "db511221-4d63-3c15-9313-b2e6f77afc37",
                        "glosses": [
                            "Action de classer méthodiquement ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bbf1dcd-636d-4bbb-9ae3-a672edf8f6e0",
                                "sense_id": "0de9325c-bd37-34eb-941c-ac2ff69fb6ef",
                                "text": "Nous avons enfin à examiner des valeurs qui échappent à la classification de Nietzsche et qui ont trait aux rapports civils."
                            },
                            {
                                "example_id": "7019a1a1-6f40-4587-8bd6-e6501df612c6",
                                "sense_id": "0de9325c-bd37-34eb-941c-ac2ff69fb6ef",
                                "text": "Une limite plus que sérieuse est la faible heuristicité d’une procédure de classification post-festum."
                            },
                            {
                                "example_id": "a84b3043-d8b0-4ca6-8443-8c0d974808af",
                                "sense_id": "0de9325c-bd37-34eb-941c-ac2ff69fb6ef",
                                "text": "Les astrologues ont développé une typologie des caractères en association avec les signes du zodiaque. Les Capricorne sont comme ceci ou comme cela, les Verseau, etc. Il s’agit peut-être du premier essai de classification des comportements."
                            },
                            {
                                "example_id": "b9a66953-f5a1-4011-a924-a56f562b4847",
                                "sense_id": "0de9325c-bd37-34eb-941c-ac2ff69fb6ef",
                                "text": "En fait, Jean-Martin Charcot (1825-1893) est confronté à un fouillis de symptômes mal définis échappant aux classifications nosographiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "32260e3f-3af5-3674-8737-d7a4988a8a19",
                        "entry_id": "db511221-4d63-3c15-9313-b2e6f77afc37",
                        "glosses": [
                            "Distribution d'une collection d'êtres, d'objets, de choses, de quelque nature qu'ils soient, en classes, ordres, genres, espèces et variétés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcb8671-0aac-4805-94b2-203618f80592",
                                "sense_id": "32260e3f-3af5-3674-8737-d7a4988a8a19",
                                "text": "Classifications naturelles ou méthodes, celles qui sont fondées sur l'ensemble des caractères."
                            },
                            {
                                "example_id": "9691848f-6f3b-41f4-b54a-4a15a0084966",
                                "sense_id": "32260e3f-3af5-3674-8737-d7a4988a8a19",
                                "text": "Classifications artificielles ou systèmes, celles qui sont fondées sur la considération d'un seul caractère."
                            },
                            {
                                "example_id": "4071ea30-06c6-4b7a-bab5-82d88805b0d7",
                                "sense_id": "32260e3f-3af5-3674-8737-d7a4988a8a19",
                                "text": "Classification décimale, mode de classement fondé sur la numérotation décimale."
                            },
                            {
                                "example_id": "a8493c93-1432-4eac-8279-fbde1a5062cd",
                                "sense_id": "32260e3f-3af5-3674-8737-d7a4988a8a19",
                                "text": "Classification décimale universelle, répartition des connaissances humaines en dix classes comprenant des divisions et des subdivisions."
                            }
                        ]
                    },
                    {
                        "sense_id": "af2b49bd-60e1-33aa-a9c6-d4b5c54f058e",
                        "entry_id": "db511221-4d63-3c15-9313-b2e6f77afc37",
                        "glosses": [
                            "Détermination par une autorité administrative du degré de secret avec lequel doit être conservée une information."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "86c5a17a-e1d2-417f-b8ff-5d67c0bd563f",
                                "sense_id": "af2b49bd-60e1-33aa-a9c6-d4b5c54f058e",
                                "text": "Seuls peuvent faire l'objet d'une classification au titre du secret de la défense nationale les lieux auxquels il ne peut être accédé sans que, à raison des installations ou des activités qu'ils abritent, cet accès donne par lui-même connaissance d'un secret de la défense nationale.\nLa décision de classification est prise pour une durée de cinq ans par arrêté du Premier ministre, publié au Journal officiel, après avis de la Commission consultative du secret de la défense nationale.\nLes conditions d'application du présent article, notamment les conditions de classification des lieux, sont déterminées par décret en Conseil d'État."
                            }
                        ]
                    },
                    {
                        "sense_id": "a696e0e5-40da-3551-aa2b-f5a1024ffa72",
                        "entry_id": "db511221-4d63-3c15-9313-b2e6f77afc37",
                        "glosses": [
                            "Système d’identification permettant la répartition des pièces d’une collection entre diverses séries, en fonction de critères déterminés."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84fde906-a278-4429-a294-e159ee54b2e8",
                        "source_entry_id": "db511221-4d63-3c15-9313-b2e6f77afc37",
                        "target_lang_word": "Klassifizierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klassifizierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "342a409b-0a6f-3823-bcb1-7c96fe413c94",
                                        "entry_id": "8209691b-cd44-3b5a-8513-f500c7815a12",
                                        "glosses": [
                                            "Einordnung, Zuordnung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71ccc49-517d-4438-aaa3-bae7447b970d",
                                                "sense_id": "342a409b-0a6f-3823-bcb1-7c96fe413c94",
                                                "text": "Die Klassifizierung beliebiger Gegenstände erfolgt nach bestimmten Kriterien."
                                            },
                                            {
                                                "example_id": "68c3670e-3384-4464-83dd-0bbdd80214ff",
                                                "sense_id": "342a409b-0a6f-3823-bcb1-7c96fe413c94",
                                                "text": "„In der Frühzeit der modernen Psychiatrie wurde Forschung fast ausschließlich in Anstalten betrieben und befasste sich vor allem mit der Klassifizierung von Patienten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8622ab8f-1133-30e1-8580-542067a9aac9",
                                        "entry_id": "8209691b-cd44-3b5a-8513-f500c7815a12",
                                        "glosses": [
                                            "Analyseverfahren des Taxonomischen Strukturalismus: Zuordnung eines Segments zu einer Einheit des Sprachsystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b9a0347-1e48-4873-9527-94fb6d18a786",
                                                "sense_id": "8622ab8f-1133-30e1-8580-542067a9aac9",
                                                "text": "Durch Klassifizierung der Morphe „-est“ (z.B. in „rechn-est“) und „-st“ (z.B. in „geh-st“), die beide die grammatische Funktion (Bedeutung) \"2. Person Singular\" bei Verben ausdrücken, erkennt man zwei Formen dieses grammatischen Morphems."
                                            },
                                            {
                                                "example_id": "598c415f-fe8b-4952-8f1e-b35486923b20",
                                                "sense_id": "8622ab8f-1133-30e1-8580-542067a9aac9",
                                                "text": "Kriterien der Klassifizierung sind gleiche oder wenigstens ähnliche Bedeutung (Funktion) und gleiche oder ähnliche Form der Segmente. Nur bei der Klassifizierung der Flexive wird von der Bedingung der gleichen oder ähnlichen Form von vielen Linguisten abgesehen."
                                            },
                                            {
                                                "example_id": "efb958a8-3fde-4192-b7be-3862a3c845b5",
                                                "sense_id": "8622ab8f-1133-30e1-8580-542067a9aac9",
                                                "text": "„Die Klassifizierung der Morpheme erfolgt unter dem Gesichtspunkt ihrer Distribution, das heißt ihrer Zugehörigkeit zu bestimmten Formklassen und ihrem Vorkommen in bestimmten syntaktischen Konstruktionen.“"
                                            },
                                            {
                                                "example_id": "4837a91f-194a-48e2-be9e-266f61b4b636",
                                                "sense_id": "8622ab8f-1133-30e1-8580-542067a9aac9",
                                                "text": "„…denn die Aneignung eines solchen Systems wird möglich lediglich auf Grund der Beherrschung von zwei Typen von Operationen, nämlich der Segmentierung sprachlicher Äußerungen (auf verschiedenen Ebenen) und der Klassifizierung der durch die Segmentierung ermittelten Einheiten.“"
                                            },
                                            {
                                                "example_id": "77d30522-e32b-4015-ad24-8676b3b051d7",
                                                "sense_id": "8622ab8f-1133-30e1-8580-542067a9aac9",
                                                "text": "„Zahlreiche amerikanische Arbeiten der frühen sechziger Jahre orientieren sich zunächst an den Methoden des klassischen Strukturalismus, in dem distributionelle Regularitäten durch Segmentierung und Klassifizierung ausfindig gemacht wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e19da0f8-95e5-4f3e-9dd8-3f4f76625073",
