                "senses": [
                    {
                        "sense_id": "84924336-a9a3-34d7-ac21-659bf0517b67",
                        "entry_id": "538f0462-557f-3c34-b456-1d1de9747040",
                        "glosses": [
                            "(männliche^☆) Person, zu der während der Jugendzeit eine freundschaftliche Beziehung bestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b87a9f8-275b-40c5-97ec-3634311460d1",
                                "sense_id": "84924336-a9a3-34d7-ac21-659bf0517b67",
                                "text": "Nach mehr als zwanzig Jahren gab es ein überraschendes Wiedersehen der beiden Jugendfreunde."
                            },
                            {
                                "example_id": "bc7411e7-4034-4624-a7fd-49460c9d520d",
                                "sense_id": "84924336-a9a3-34d7-ac21-659bf0517b67",
                                "text": "„Von Anfang bis Ende war die Beziehung zu Erich Bachmann von der unkomplizierten Selbstverständlichkeit, wie sie wohl am ehesten bei Jugendfreunden möglich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "600d419a-b953-37f3-ab32-13051f539563",
                        "entry_id": "538f0462-557f-3c34-b456-1d1de9747040",
                        "glosses": [
                            "Mitglied der Freien Deutschen Jugend; offizielle Anrede für einen Jugendlichen ; umgangssprachlich/ironisch auch im Sinne von „Schlingel“"
                        ],
                        "tags": [
