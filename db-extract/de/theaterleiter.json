                "senses": [
                    {
                        "sense_id": "8b2e7fad-38c5-304c-9cab-e173e89d5bbe",
                        "entry_id": "222c2fc8-6ac8-324d-8a7b-4a723fe7976a",
                        "glosses": [
                            "Person, deren Aufgabe die Leitung eines Theaters ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11f525f-03f3-418d-b88d-6bb8bce3953b",
                                "sense_id": "8b2e7fad-38c5-304c-9cab-e173e89d5bbe",
                                "text": "„Meisterhaft beherrschte der Theaterleiter Molière die Klaviatur einer effektsicheren Bühnendynamik und die Zeichnung lebensechter Figuren wie der des Argan im »Eingebildeten Kranken«, der auch nach drei Jahrhunderten noch höchst publikumswirksam und zudem eine Paraderolle für jeden Schauspieler ist.“"
                            },
                            {
                                "example_id": "3002be02-a018-4bf4-9033-e886d7de45ff",
                                "sense_id": "8b2e7fad-38c5-304c-9cab-e173e89d5bbe",
                                "text": "„Seine größten Erfolge als Theaterleiter sollte er allerdings erst dreißig Jahre später erleben; sie gehören zu den letzten Blättern eines Schicksalweges, der jede Vorstellungskraft übersteigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
