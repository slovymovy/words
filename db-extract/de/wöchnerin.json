                ],
                "senses": [
                    {
                        "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                        "entry_id": "bd343718-f7e6-35d2-8bda-e7b18ec692ff",
                        "glosses": [
                            "eine Frau in den ersten sechs bis acht Wochen nach der Geburt, in denen sich die Geschlechtsorgane (mit Ausnahme der Brüste) auf ihren Zustand vor der Schwangerschaft zurückbilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a412bba-705e-4769-96fb-c9229918fd4a",
                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                "text": "„Im allgemeinen hält sie sich für sich selber und geht davon nur ab, wenn sie helfen kann, sei es, daß es sich um eine Wöchnerin handelt, die zu arm ist, um die rechte Pflege haben zu können, oder um kranke oder anderswie unglückliche Menschen.“"
                            },
                            {
                                "example_id": "71f86b2c-80b1-4159-bfb9-be6541b69bb0",
                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                "text": "„Aber am Lager der Wöchnerin mit dem Kind im Arm halten Erzengel Wache.“"
                            },
                            {
                                "example_id": "5862a63d-ea3a-464a-87b1-6d9fe9339989",
                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                "text": "„Nach Bogutscharowo hatte er auf eigene Kosten eine gelernte Hebamme kommen lassen, um den Wöchnerinnen zur Hand zu gehen, und gegen ein regelmässiges Gehalt lehrte der Geistliche die Kinder der Bauern und Hofesleute Lesen und Schreiben.“"
                            },
                            {
                                "example_id": "4c9f27d7-fb62-467b-be1c-0d89021b80ff",
                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                "text": "„Die Wöchnerin wollte davon nichts wissen, denn sie konnte das Militär nicht leiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cc2321c-2061-404b-a86a-5d4c5edf40d2",
                        "source_entry_id": "bd343718-f7e6-35d2-8bda-e7b18ec692ff",
                        "source_sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                        "target_lang_word": "accouchée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accouchée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                        "entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                                        "glosses": [
                                            "Femme qui vient de mettre au monde un enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af2239a4-8f65-4c07-952f-a6b7f0ffd435",
                                                "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                                "text": "Au milieu d’un cercle affairé de commères accourues pour donner soi-disant leurs soins à l’accouchée, la sage-femme triomphante brandit un petit être rougeaud, gigotant, qui braillait d’une voix obstinée et sonore."
                                            },
                                            {
                                                "example_id": "623a482b-cbc6-42af-bc4c-5a48a67b957d",
                                                "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                                "text": "Je me sentais léger et creux comme une accouchée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accouchée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1726890b-d129-3b33-ba90-2bad6495c37f",
                                        "entry_id": "d9803acb-5115-37d6-97fa-90fd26c6d490",
                                        "glosses": [
                                            "Participe passé féminin singulier du verbe accoucher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606c2541-f7f5-4e8b-be94-7d63b6b556bd",
                                                "sense_id": "1726890b-d129-3b33-ba90-2bad6495c37f",
                                                "text": "Celle-ci habitait à huit kilomètres de chez lui ; mais l’accouchement s'étant fait promptement, à mi-route un commissionnaire vint le déconvier et lui annoncer que la femme était accouchée d’un garçon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
