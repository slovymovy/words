                    "frequency": "High",
                    "semantic_group_id": "achat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai passé une <w>commande</w> de livres sur Internet ce matin."
                        },
                        {
                            "text": "Le serveur arrive avec notre <w>commande</w> de café et de croissants."
                        }
                    ],
                    "common_phrases": [
                        "passer une commande",
                        "bon de commande",
                        "numéro de commande"
                    ]
                },
                {
                    "sense_id": "bf69ca45-f867-3fff-bfc1-44af595ee258",
                    "sense_definition": "Mécanisme ou dispositif qui permet d'actionner, de diriger ou de régler le fonctionnement d'un appareil, d'une machine ou d'un véhicule.",
