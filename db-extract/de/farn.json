                    },
                    {
                        "form_id": "f4832d6c-6c70-41ef-8a12-b1deb476861c",
                        "entry_id": "0803c03e-f075-355a-9dfb-aa2056dde2b8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Farne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                        "entry_id": "0803c03e-f075-355a-9dfb-aa2056dde2b8",
                        "glosses": [
                            "Vertreter einer arten- und formenreichen Gruppe sporenbildender Gefäßpflanzen, oft mit gefiederten Blättern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00be0a1-3304-4ade-9938-b83d3e41e4c9",
                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                "text": "Abgesehen von dem ein oder anderen Farn war der Waldboden nahezu kahl."
                            },
                            {
                                "example_id": "4400d2aa-1329-4dc7-9ea7-da2220448fba",
                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                "text": "Farne werden hauptsächlich als Zierpflanzen, aber nur wenig als Heilpflanzen oder als Nahrungsmittel genutzt."
                            },
                            {
                                "example_id": "9f97df91-e697-42ce-8cbb-370fad7e9bc7",
                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                "text": "Farne und Moose werden in der Botanik zu den sogenannten Sporenpflanzen oder Kryptogamen zusammengefasst."
                            },
                            {
                                "example_id": "5e55dc2f-9b10-4a18-985e-27d14cc51db0",
                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                "text": "„Hohe Farne und Bananenstauden säumen den Weg.“"
                            },
                            {
                                "example_id": "6262b1eb-ad1a-402e-b6f7-5ae91acba9b2",
                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                "text": "„Sie wohnen in drei Zimmern ohne Gardinen an den Fenstern und haben Palmen, Farne, Zypergras und Bogenhanf und schöne alte Stühle, die aber aus dem Leim sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e903666f-1353-4908-a618-0d54d93ab275",
                        "source_entry_id": "0803c03e-f075-355a-9dfb-aa2056dde2b8",
                        "source_sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                        "source_sense_description": "Vertreter einer arten- und formenreichen Gruppe sporenbildender Gefäßpflanzen",
                        "target_lang_word": "fern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc578861-d6cf-35c9-90cb-1c0819dc20f7",
                                        "entry_id": "626b342f-a67d-3980-904b-7743da464cf4",
                                        "glosses": [
                                            "Any of a group of some twenty thousand species of vascular plants classified in the division Pteridophyta that lack seeds and reproduce by shedding spores to initiate an alternation of generations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cabc637-4697-4053-a099-0e29e0d6bfac",
                        "source_entry_id": "0803c03e-f075-355a-9dfb-aa2056dde2b8",
                        "source_sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                        "source_sense_description": "Vertreter einer arten- und formenreichen Gruppe sporenbildender Gefäßpflanzen",
                        "target_lang_word": "fougère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fougère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c170643-a365-3c1a-b080-45a9903e998b",
                                        "entry_id": "60aff906-a6c1-35a5-9f5d-584b025b8b44",
                                        "glosses": [
                                            "Plante aux grandes feuilles, dont les très nombreuses espèces constituent la classe des filicinées, la plus importante classe des cryptogames vasculaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f9e3df9-5894-4e4d-829c-3e88e9ff5042",
                                                "sense_id": "7c170643-a365-3c1a-b080-45a9903e998b",
                                                "text": "Déchues de leur rôle de dominatrices, les Fougères se sont réfugiées à l'ombre des grands Phanérogames; elles vivent sous bois et n'y brillent pas."
                                            },
                                            {
                                                "example_id": "e62edf59-e4b6-46dc-9388-d6959b6d8c00",
                                                "sense_id": "7c170643-a365-3c1a-b080-45a9903e998b",
                                                "text": "Les travaux des femmes y sont légers : effeuiller la vigne pour laisser passer le soleil, éclaircir les grappes en détachant les grains avariés, couper le fruit sans le défleurer, et, lorsque vient le moment de la vente, préparer la fougère qui doit envelopper et parfumer le raisin?"
                                            },
                                            {
                                                "example_id": "7172d206-4bbf-41ea-bebe-e6ff8ec48426",
                                                "sense_id": "7c170643-a365-3c1a-b080-45a9903e998b",
                                                "text": "Un sac tenait lieu d’oreiller.\n« Vous savez, la fougère est fraîche, dit Rosalie, on ne mettrait pas quelqu’un qui arrive, coucher sur de la vieille fougère ; ce n’est pas à faire quoiqu’on raconte que dans les hôtels, les vrais, on ne se gêne pas. »"
                                            },
                                            {
                                                "example_id": "eda938a5-56f6-4b45-b746-e714b6fdc8db",
                                                "sense_id": "7c170643-a365-3c1a-b080-45a9903e998b",
                                                "text": "Les Fougères se disséminent par des spores. Les appareils sporifères forment des amas de formes variables à la surface inférieure des feuilles."
                                            },
                                            {
                                                "example_id": "ea5ff9f0-4762-4fbd-bdf1-62207fd8d604",
                                                "sense_id": "7c170643-a365-3c1a-b080-45a9903e998b",
                                                "text": "Il saisit Héloïse, l'enlève entre ses bras comme une balle de fougère, une sachée de linaigrettes floconneuses, et la transporte doucement, parmi les couvertures qu'il rabat sur elle."
                                            },
                                            {
                                                "example_id": "521279b2-e747-4e75-bbcf-e052c40e1be1",
                                                "sense_id": "7c170643-a365-3c1a-b080-45a9903e998b",
                                                "text": "Les fougères m’étaient ennemies parce qu’on m’avait appris dès l’enfance qu’elles contenaient de l’acide prussique. J’abattais les têtes des plus orgueilleuses et parfois je me jetais dans leur foule pressée et respirais l’odeur de leur sève empoisonnée comme si c’était du sang que j’eusse répandu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8d54501-dd63-4ce0-b387-dad515cd38d6",
                        "source_entry_id": "0803c03e-f075-355a-9dfb-aa2056dde2b8",
