                        "entry_id": "430688b7-0fad-35dc-9a6d-f5e36fe42b05",
                        "glosses": [
                            "ein mit Haken zum Aufhängen von Schlüsseln versehenes Brett, meist an der Wand im Flur hinter der Haus- bzw. Wohnungstür befestigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc812ed5-c053-495e-97f0-8eddfde07eff",
                                "sense_id": "0e8044aa-dff6-3530-b2d5-c2ad9f235b20",
                                "text": "Es hingen viele Schlüssel am Schlüsselbrett, aber der Gesuchte war nicht darunter."
                            },
                            {
                                "example_id": "d8af2ce4-47f6-4014-9b4f-d101603d45ce",
                                "sense_id": "0e8044aa-dff6-3530-b2d5-c2ad9f235b20",
                                "text": "„Meukoff ging zum Schlüsselbrett.“"
                            },
                            {
                                "example_id": "49a59cbf-9f3e-4f71-93df-b9a4570468d6",
                                "sense_id": "0e8044aa-dff6-3530-b2d5-c2ad9f235b20",
                                "text": "„Der Wirt tritt von einem Bein aufs andre vorm Schlüsselbrett und malt mit Kreide Kreuze hinter die Zimmernummern.“"
                            }
                        ],
