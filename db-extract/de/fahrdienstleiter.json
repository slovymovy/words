                ],
                "senses": [
                    {
                        "sense_id": "0de5c9fe-925c-3920-b223-b19cb1d36026",
                        "entry_id": "98fc5e51-2afa-34c4-be69-fa9fdbd146cb",
                        "glosses": [
                            "Mitarbeiter eines Eisenbahninfrastrukturunternehmens, dem in einem bestimmten Bereich eigenverantwortlich die Zulassung der Zugfahrten obliegt"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "de3f312d-1ac2-41e6-af16-30dede7e3a54",
                                "sense_id": "0de5c9fe-925c-3920-b223-b19cb1d36026",
                                "text": "Keine Zugfahrt darf ohne Zustimmung des zuständigen Fahrdienstleiters durchgeführt werden."
                            },
                            {
                                "example_id": "e3e729c5-ad58-4f79-a361-ea506e1448e4",
                                "sense_id": "0de5c9fe-925c-3920-b223-b19cb1d36026",
                                "text": "„Fahrdienstleiter steuern den Zugverkehr und sorgen für einen sicheren Bahnbetrieb.“"
                            },
                            {
                                "example_id": "02ca1d43-8041-474e-b9ba-d6298407bc6c",
                                "sense_id": "0de5c9fe-925c-3920-b223-b19cb1d36026",
                                "text": "„Pausch, einst selbst Fahrdienstleiter, verantwortet seit 2005 einen Zentralisierungsprozess, der die Arbeit der Fahrdienstleiter konzentrieren soll.“"
                            },
                            {
                                "example_id": "1bfb859d-7029-44eb-8ab9-02d8fa424c89",
                                "sense_id": "0de5c9fe-925c-3920-b223-b19cb1d36026",
                                "text": "„Der Fahrdienstleiter hatte – vom verbotenen Handyspielen abgelenkt – Signale falsch gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
