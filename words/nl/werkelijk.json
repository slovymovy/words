                            }
                        },
                        {
                            "text": "Het was <w>werkelijk</w> prachtig om de zon in de zee te zien zakken.",
                            "target_lang_translations": {
                                "en": "It was <w>truly</w> beautiful to see the sun sink into the sea."
                            }
                        }
                    ],
                    "synonyms": [
                        "heus",
                        "waar",
                        "echt"
                    ],
                    "common_phrases": [
