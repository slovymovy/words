                        "glosses": [
                            "Concert public donné en plein air, alliant concert et promenade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e52fc5ed-bb21-4776-8e33-b3eaeaaae40a",
                                "sense_id": "67cdf577-18fa-34cc-b407-d8bf8ab7ceee",
                                "text": "Parfois je rentrais au bout d’une heure, d’autres fois plus tard si j’étais allé au concert-promenade installé sur les Quinconces durant les mois d’été, mais le plus souvent je me contentais d’une glace au café de la Comédie, ou en dépit des moustiques j’allais errer sur la terrasse du Jardin Public, loin de la foule agglutinée autour de la fanfare du 57ᵉ."
                            },
                            {
                                "example_id": "2670a432-9ec0-47ca-a873-8d6fb0ab0d81",
                                "sense_id": "67cdf577-18fa-34cc-b407-d8bf8ab7ceee",
                                "text": "Des concerts-promenades au musée sont aussi de la partie pour faire découvrir aux enfants des instruments, des expositions ou des artistes dans un environnement inhabituel."
                            }
                        ]
                    }
