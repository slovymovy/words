                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train est bondé et chaque <w>passager</w> cherche une place assise."
                        },
                        {
                            "text": "Le pilote demande à chaque <w>passagère</w> d'attacher sa ceinture avant le décollage."
                        }
                    ],
                    "synonyms": [
