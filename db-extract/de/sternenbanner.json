                                ]
                            },
                            {
                                "target_word": "Star-Spangled Banner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bae7f38-0482-3972-8a00-bfe864299800",
                                        "entry_id": "9dcc3644-b6bd-312d-854f-9e4d01838078",
                                        "glosses": [
                                            "The national anthem of the United States of America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82752c5d-94b6-49ff-a9b2-3a4508ba6b0a",
                                                "sense_id": "0bae7f38-0482-3972-8a00-bfe864299800",
                                                "text": "In the course of a single lifetime, the average fan will be forced to hear 1,500 fiendishly unattractive women ... take four and a half minutes to butcher “The Star-Spangled Banner”[.]"
                                            },
                                            {
                                                "example_id": "14e37b49-784d-4507-95c2-0fad94d25c5b",
                                                "sense_id": "0bae7f38-0482-3972-8a00-bfe864299800",
                                                "text": "On Monday, February 21, 1972, as a Chinese military band played “The Star-Spangled Banner,” Nixon became the first American president to visit China while in office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff9607cc-243b-456c-89c7-925f7a35b311",
                        "source_entry_id": "8d75f365-17c2-35e1-a1e6-4f8f57fc5b89",
                        "source_sense_id": "3531765a-a9d1-3eb6-8ae0-ed8341f3c512",
                        "source_sense_description": "Nationalflagge der Vereinigten Staaten von Amerika",
                        "target_lang_word": "bannière étoilée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bannière étoilée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c7e6d26-0696-3333-9fc1-633d6a9ef52b",
                                        "entry_id": "7f114641-bc51-3de9-b6d6-f1faa3385bf3",
                                        "glosses": [
                                            "Drapeau des États-Unis d’Amérique, qui a cinquante étoiles représentant les cinquante États depuis 1960."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5befa455-10c3-45c5-bdf6-aae72fce0e04",
                                                "sense_id": "9c7e6d26-0696-3333-9fc1-633d6a9ef52b",
                                                "text": "Mais la sélection à la bannière étoilée ne l’entend pas de cette oreille et aspire elle aussi à retrouver les huitièmes de finale qu’elle n’avait plus atteinte depuis 2002."
                                            }
                                        ]
                                    }
                                ]
                            }
