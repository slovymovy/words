                                    },
                                    {
                                        "sense_id": "75c4a341-146f-3d34-b175-8832df982b53",
                                        "entry_id": "3754bf37-b65f-3abf-867b-9004b46f94fb",
                                        "glosses": [
                                            "A body of troops or army vehicles, usually strung out along a road."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23b41306-5b61-3a89-ba76-15a9a97d2574",
                                        "entry_id": "3754bf37-b65f-3abf-867b-9004b46f94fb",
                                        "glosses": [
                                            "A body of text meant to be read line by line, especially in printed material that has multiple adjacent such on a single page."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4166ef-7805-44b9-bb61-4389734c8550",
                                                "sense_id": "23b41306-5b61-3a89-ba76-15a9a97d2574",
                                                "text": "It was too hard to read the text across the whole page, so I split it into two columns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab16828d-8832-375d-85d8-1f7f0065eadc",
                                        "entry_id": "3754bf37-b65f-3abf-867b-9004b46f94fb",
                                        "glosses": [
                                            "A unit of width, especially of advertisements, in a periodical, equivalent to the width of a usual column of text."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f5351b-d688-492e-adbb-3c7f7ec2ff4e",
                                                "sense_id": "ab16828d-8832-375d-85d8-1f7f0065eadc",
                                                "text": "Each column inch costs $300 a week; this ad is four columns by three inches, so will run $3600 a week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4252042-e95c-3636-8fac-0aaa1bce043d",
                                        "entry_id": "3754bf37-b65f-3abf-867b-9004b46f94fb",
                                        "glosses": [
                                            "A recurring feature in a periodical, especially an opinion piece, especially by a single author or small rotating group of authors, or on a single theme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26eb56fe-8a49-4c48-a7c7-22d9d95e2ebe",
                                                "sense_id": "b4252042-e95c-3636-8fac-0aaa1bce043d",
                                                "text": "His initial foray into print media was as the author of a weekly column in his elementary-school newspaper."
                                            },
                                            {
                                                "example_id": "45b845fb-cf89-4c73-9c14-352d1a48fc45",
                                                "sense_id": "b4252042-e95c-3636-8fac-0aaa1bce043d",
                                                "text": "I have always argued that despite my opposition to rail privatisation, I should be grateful that John Major won the 1992 election on a platform to sell off the railways, as otherwise my column would have disappeared given the paucity of things to write about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "522a6d55-b6be-38ac-8cc0-f477f03b215c",
                                        "entry_id": "3754bf37-b65f-3abf-867b-9004b46f94fb",
                                        "glosses": [
                                            "Something having similar vertical form or structure to the things mentioned above, such as a spinal column."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b84228-1e21-429a-9599-fefbef2f71f0",
                                                "sense_id": "522a6d55-b6be-38ac-8cc0-f477f03b215c",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom. Whirling wreaths and columns of burning wind, rushed around and over them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb40442e-2a9e-3fae-85b0-9fb38200b147",
                                        "entry_id": "3754bf37-b65f-3abf-867b-9004b46f94fb",
                                        "glosses": [
                                            "The gynostemium"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f18015a-489b-3a4d-9bb8-405502f8dd9c",
                                        "entry_id": "3754bf37-b65f-3abf-867b-9004b46f94fb",
                                        "glosses": [
                                            "An instrument used to separate the different components of a liquid or to purify chemical compounds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
