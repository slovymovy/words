                "senses": [
                    {
                        "sense_id": "ee17505c-0a4f-3270-a501-7fc977812b68",
                        "entry_id": "67ff87b6-8c25-3c07-9d7d-62a21d59f216",
                        "glosses": [
                            "iemand die neigt tot mopperen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87be95b1-cce5-47d0-8d76-cb84a47587f9",
                                "sense_id": "ee17505c-0a4f-3270-a501-7fc977812b68",
                                "text": "Wat een iezegrim is dat, zeg!"
                            },
                            {
                                "example_id": "85becc44-d0c4-407a-9e3f-74d5eb7b35df",
                                "sense_id": "ee17505c-0a4f-3270-a501-7fc977812b68",
                                "text": "Hij wordt een echte iezegrim. Voor de kooplui maakt dat niet uit. Die laten hem gewoon links liggen. Maar de klanten doen dat op den duur ook."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1391ab61-3b97-4055-8c25-476cb66f36d0",
                        "source_entry_id": "67ff87b6-8c25-3c07-9d7d-62a21d59f216",
                        "source_sense_id": "ee17505c-0a4f-3270-a501-7fc977812b68",
                        "source_sense_description": "iemand die neigt tot mopperen",
                        "target_lang_word": "curmudgeon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curmudgeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff181bc-7aa8-32b7-b927-5593a0efe868",
                                        "entry_id": "7e52f612-8252-3bfb-afb4-1bf93914f849",
                                        "glosses": [
                                            "An ill-tempered person full of stubborn ideas or opinions, often an older man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6257ed5b-8654-442e-a249-dcaecf2419f4",
                                                "sense_id": "4ff181bc-7aa8-32b7-b927-5593a0efe868",
                                                "text": "Near-synonyms: crank, grump; grumpy pants (often childish)"
                                            },
                                            {
                                                "example_id": "17b83d9a-744e-4f03-b5f2-06c6c90247a5",
                                                "sense_id": "4ff181bc-7aa8-32b7-b927-5593a0efe868",
                                                "text": "There's a cranky curmudgeon working at the hospital who gives all the patients and other doctors flak."
                                            },
                                            {
                                                "example_id": "17fcbef0-29a0-445a-849b-182583f6f79c",
                                                "sense_id": "4ff181bc-7aa8-32b7-b927-5593a0efe868",
                                                "text": "John Doe's old age and stubborn aversion to new ideas make him a curmudgeon of a candidate."
                                            },
                                            {
                                                "example_id": "5aa15da1-8aec-4d97-a072-be7b14795ce4",
                                                "sense_id": "4ff181bc-7aa8-32b7-b927-5593a0efe868",
                                                "text": "After a while, as cultural debates became more polarized, the editorial tone of the New Criterion went from being charmingly curmudgeon to being bitterly shrill."
                                            },
                                            {
                                                "example_id": "75ef1248-02cf-4a18-bc28-4e7fd67417b6",
                                                "sense_id": "4ff181bc-7aa8-32b7-b927-5593a0efe868",
                                                "text": "How to Be a Curmudgeon on the Internet"
                                            },
                                            {
                                                "example_id": "ea125247-6aac-4789-ab79-6073f5d38259",
                                                "sense_id": "4ff181bc-7aa8-32b7-b927-5593a0efe868",
                                                "text": "How should I respond, without appearing to be a curmudgeon?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b1c0a19-f7fc-3ac7-8c3a-26fa1294ef25",
                                        "entry_id": "7e52f612-8252-3bfb-afb4-1bf93914f849",
                                        "glosses": [
                                            "A miser."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
