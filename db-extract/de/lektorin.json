                    {
                        "sense_id": "2a14d88f-9ad0-3ca3-8047-633ee06ceef7",
                        "entry_id": "28a81d9e-c9c7-3e40-98c7-a315fb565962",
                        "glosses": [
                            "Dozentin, die für die Vermittlung bestimmter Fertigkeiten zuständig ist"
                        ],
                        "tags": [
                            "Universität"
                        ],
                        "examples": [
                            {
                                "example_id": "55af7871-610e-48d3-9d57-c1a6dc9e358b",
                                "sense_id": "2a14d88f-9ad0-3ca3-8047-633ee06ceef7",
                                "text": "Für den Unterricht in Altschwedisch war eine deutsche Lektorin zuständig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "25c55394-3b04-3421-8744-1edd456df5fa",
                        "entry_id": "28a81d9e-c9c7-3e40-98c7-a315fb565962",
                        "glosses": [
                            "weibliche Person, die eingereichte Manuskripte überprüft und gegebenenfalls mit den Autoren zusammen überarbeitet"
                        ],
                        "tags": [
                            "Verlagswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "6115a8fd-692f-4f11-8034-51c6c427f626",
                                "sense_id": "25c55394-3b04-3421-8744-1edd456df5fa",
                                "text": "„Am Tag vor unserer Veranstaltung treffe ich Monika Held das erste Mal, sie ist mit ihrer Lektorin angereist, und ich liebe beide vom ersten Augenblick an.“"
                            },
                            {
                                "example_id": "757c657f-21f1-45b9-a75c-91763dbf0ad5",
                                "sense_id": "25c55394-3b04-3421-8744-1edd456df5fa",
                                "text": "„Auch Karin Koenicke leistet sich längst eine externe Lektorin und Grafikerin.“"
                            },
                            {
                                "example_id": "389ce821-c1e9-40aa-84ea-35a657b71c5f",
                                "sense_id": "25c55394-3b04-3421-8744-1edd456df5fa",
                                "text": "„Kate Seaver – ich habe ein solches Glück, dass du meine Lektorin bist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "31f6c36c-f8c7-3d6d-bad6-9662fa6d96c8",
                        "entry_id": "28a81d9e-c9c7-3e40-98c7-a315fb565962",
                        "glosses": [
                            "Vortragende der Lesungen im Gottesdienst"
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "ac0e59e9-9f96-4507-80b5-b955ae90bef7",
                                "sense_id": "31f6c36c-f8c7-3d6d-bad6-9662fa6d96c8",
                                "text": "Die Lektorin hatte diesmal nur einen relativ kurzen Text vorzutragen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
