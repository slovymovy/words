                ],
                "senses": [
                    {
                        "sense_id": "35bff9d6-6e3d-38c6-8894-6f6075a69b93",
                        "entry_id": "06e7e4e8-47ac-3637-aa5b-209154abddde",
                        "glosses": [
                            "Mauer, die eine Festung sichert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5deec2da-f052-4a98-bc5a-9ebd558683bf",
                                "sense_id": "35bff9d6-6e3d-38c6-8894-6f6075a69b93",
                                "text": "„Die Bewohner von Smolensk, die Frauen, Kinder und alten Leute vertrauten darauf, dass ihre Stadt wegen der hohen Festungsmauern uneinnehmbar sei.“"
                            },
                            {
                                "example_id": "9977d504-0c2f-461a-b267-4f78002dc00e",
                                "sense_id": "35bff9d6-6e3d-38c6-8894-6f6075a69b93",
                                "text": "„Gemeinhin bestanden diese Fürstensitze aus einer Festungsmauer, innerhalb derer sich größere Fachwerkhäuser befanden, in denen wohl der Hochadel wohnte.“"
                            },
                            {
                                "example_id": "aa7f8638-db27-4594-8df3-509dab45bed8",
                                "sense_id": "35bff9d6-6e3d-38c6-8894-6f6075a69b93",
                                "text": "„Die senkrecht abfallende, blendendweiße Klippe, hier und da von Kieselerde schwarz durchädert, verlief wie die Krümmung einer Festungsmauer von fünf Meilen Länge gegen den Horizont.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
