                                                "example_id": "799791eb-733c-48da-baab-f1f12368d0e7",
                                                "sense_id": "fff9916d-0630-396c-9886-ff2a70e17d6e",
                                                "text": "„Immer dann, wenn es darum geht irgendetwas zu vergleichen, findet häufig der Begriff der Effizienz Verwendung.“"
                                            },
                                            {
                                                "example_id": "4376ed95-6279-4543-8670-bc6eaefb1b16",
                                                "sense_id": "fff9916d-0630-396c-9886-ff2a70e17d6e",
                                                "text": "„Zusätzliche Heizkörper oder eine Fußbodenheizung senken die nötige Vorlauftemperatur und erhöhen so die Effizienz der Wärmepumpe.“"
                                            },
                                            {
                                                "example_id": "7e615e98-3984-4e2e-b5a2-c7339c98d5b1",
                                                "sense_id": "fff9916d-0630-396c-9886-ff2a70e17d6e",
                                                "text": "Bei der Frage nach der Effizienz geht es oftmals darum, die relative Vorteilhaftigkeit eines Verfahrens gegenüber einem anderen Verfahren zu ermitteln."
                                            },
                                            {
                                                "example_id": "258a5932-45e0-4a5f-bb0e-fc7fa23d3e65",
                                                "sense_id": "fff9916d-0630-396c-9886-ff2a70e17d6e",
                                                "text": "Effizienz vergleicht das Verhältnis von Aufwand zu Ergebnis, zum Beispiel durch die Frage: wo wird das Ergebnis bei gleichem Aufwand besser?"
                                            },
                                            {
                                                "example_id": "4b1dc51c-90a6-4079-a1cf-384535649d17",
                                                "sense_id": "fff9916d-0630-396c-9886-ff2a70e17d6e",
                                                "text": "„Offenbar existiert ein tiefes Bedürfnis, sich in der Welt der Effizienz mal eine Zeitlang einer anstrengenden Nutzlosigkeit zu widmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
