                ],
                "translations": [
                    {
                        "translation_id": "590a39de-3b5d-4d9f-9c6c-04e57aba4946",
                        "source_entry_id": "e00f73a0-c4b7-3497-a78c-51e9a615fbee",
                        "source_sense_description": "the act of despairing or becoming desperate; a giving up of hope",
                        "target_lang_word": "désespoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désespoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81fbef43-969c-3c48-916b-478cd8d22851",
                                        "entry_id": "77d33435-2ba5-3d6f-8555-c495c88a3624",
                                        "glosses": [
                                            "Perte d’espérance ; état d’une personne qui a perdu toute espérance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d447e10-3ade-492f-8194-425a3ae10a70",
                                                "sense_id": "81fbef43-969c-3c48-916b-478cd8d22851",
                                                "text": "Cuba n’était pas encore colonisée et servait de refuge aux malheureux Indiens que le désespoir chassait d’Hispaniola ; les forêts en étaient remplies, et plus d'une fois ils attaquèrent les naufragés."
                                            },
                                            {
                                                "example_id": "15e0fdde-3f06-4426-9028-4cd1cb948fad",
                                                "sense_id": "81fbef43-969c-3c48-916b-478cd8d22851",
                                                "text": "L'artiste, le poète et le touriste se réjouissent ici d'un pittoresque qui fait le désespoir de l'agriculteur."
                                            },
                                            {
                                                "example_id": "a54c3d34-b7f3-4cc4-8002-8e4984dd5e2b",
                                                "sense_id": "81fbef43-969c-3c48-916b-478cd8d22851",
                                                "text": "J’essaie de donner mauvaise conscience à mon désespoir."
                                            },
                                            {
                                                "example_id": "42ed7f0d-826b-494d-a953-197cf1962d64",
                                                "sense_id": "81fbef43-969c-3c48-916b-478cd8d22851",
                                                "text": "D'ailleurs, de tous nos généraux, Wimpffen reste le seul à parler encore d'une percée vers l'est. Au reste, même à ses yeux, ce n'est plus désormais qu'une solution de désespoir, un moyen de sauver, sinon l'armée, du moins son honneur."
                                            },
                                            {
                                                "example_id": "716c471a-b7a7-43cd-8418-2ac3e7cd39cc",
                                                "sense_id": "81fbef43-969c-3c48-916b-478cd8d22851",
                                                "text": "Chacun mourait un peu du lourd désespoir dominical qui menaçait la campagne vide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3ed7179-0617-3c98-9682-fbee3a2fa8f0",
                                        "entry_id": "77d33435-2ba5-3d6f-8555-c495c88a3624",
                                        "glosses": [
                                            "État violent de l’âme causé par une affliction qu’on ne cherche pas à surmonter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a4e0483-3d30-4a8b-a1a5-0a18f955c56b",
                                                "sense_id": "c3ed7179-0617-3c98-9682-fbee3a2fa8f0",
                                                "text": "Peu à peu, après le grand désespoir de la première heure, la paix s'est faite dans le cœur de Jacques."
                                            },
                                            {
                                                "example_id": "c8fe33f0-bd8b-47c0-be16-36e18b1bed07",
                                                "sense_id": "c3ed7179-0617-3c98-9682-fbee3a2fa8f0",
                                                "text": "Bientôt tes appels ne seront plus que rauquements de plus en plus sourds, beuglements de désespoir si fatigués qu'ils ne dépasseront plus ta gorge, étranglée de terreur."
                                            },
                                            {
                                                "example_id": "ba036f16-d946-4e2d-80e6-ff8ea3c85f70",
                                                "sense_id": "c3ed7179-0617-3c98-9682-fbee3a2fa8f0",
                                                "text": "— Quand j'atteignais un rat d'un bon coup de fouet, le ronge-maille sifflait avec fureur, hérissait tous ses poils et s'élançait avec désespoir contre le fouet lui-même, instrument de sa torture."
                                            },
                                            {
                                                "example_id": "42027b0e-f29c-4249-95bd-f802be08a12a",
                                                "sense_id": "c3ed7179-0617-3c98-9682-fbee3a2fa8f0",
                                                "text": "En général, la vue se heurte à des rochers serrés, à des amoncellements de prisons. Cette concentration trahit un désespoir paralysant comme une crampe : une sorte d’agoraphobie caractérise ces gravures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1afa9442-9ca8-3597-afaa-3df81ac20447",
                                        "entry_id": "77d33435-2ba5-3d6f-8555-c495c88a3624",
                                        "glosses": [
                                            "Contrariété, souci."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d148a01-3759-47bd-b8f0-024b6b873fe4",
                                                "sense_id": "1afa9442-9ca8-3597-afaa-3df81ac20447",
                                                "text": "Je suis sûr que j'ai rencontré depuis deux jours dans les rues les philosophes les plus illustres et les fonctionnaires les plus influents. C'est mon désespoir de ne pas les connaître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "024bb208-781b-3d64-90a8-a1466a303bfe",
                                        "entry_id": "77d33435-2ba5-3d6f-8555-c495c88a3624",
                                        "glosses": [
                                            "Ce qui désespère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df710ac8-8871-48c1-8ac1-45cec1fb896c",
                                                "sense_id": "024bb208-781b-3d64-90a8-a1466a303bfe",
                                                "text": "La conduite de ce jeune homme est le désespoir de ses parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc13d3fe-073d-3ba4-98f2-77405a401f7c",
                                        "entry_id": "77d33435-2ba5-3d6f-8555-c495c88a3624",
                                        "glosses": [
                                            "Jalousie ou envie de ce qui semble inaccessible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05eed61-78cb-4794-baff-74f32951fcae",
                                                "sense_id": "fc13d3fe-073d-3ba4-98f2-77405a401f7c",
                                                "text": "Pour le désespoir des femmes, sa toilette était irréprochable, et toutes lui envièrent une coupe de robe, une forme de corsage dont l'effet fut attribué généralement à quelque génie de couturière inconnue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e69d2e2-deee-325a-a63d-cb5e101a764a",
                                        "entry_id": "77d33435-2ba5-3d6f-8555-c495c88a3624",
                                        "glosses": [
                                            "Chose qui est en un si haut degré d’excellence qu’elle passe pour inimitable."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d5ca5d-c573-4f20-a418-c33d05c112cf",
                                                "sense_id": "5e69d2e2-deee-325a-a63d-cb5e101a764a",
                                                "text": "\"L’Iliade \" d’Homère est le désespoir, fait le désespoir de tous les poètes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34059f86-1f47-4b02-8c1a-7fb4f395197c",
                        "source_entry_id": "e00f73a0-c4b7-3497-a78c-51e9a615fbee",
                        "source_sense_description": "the act of despairing or becoming desperate; a giving up of hope",
                        "target_lang_word": "Verzweiflung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verzweiflung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24d7103b-8f8f-316a-bf05-d1d71d7f1142",
                                        "entry_id": "e17092f0-14af-3068-9b8a-ec6b9d20fdcd",
                                        "glosses": [
                                            "Zustand, in dem jemand keine Hoffnung mehr hat"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6fc4c4c-eacb-430f-95ee-7a1cb1ea2b2e",
                                                "sense_id": "24d7103b-8f8f-316a-bf05-d1d71d7f1142",
                                                "text": "Man konnte ihm die Verzweiflung am Gesicht ablesen."
                                            },
                                            {
                                                "example_id": "ad7764ab-5dc1-4937-b600-f086772116ac",
                                                "sense_id": "24d7103b-8f8f-316a-bf05-d1d71d7f1142",
                                                "text": "„Der Leser kann sich auch so vorstellen, welche Verzweiflung und Wut mich erfaßten, als man mich gefesselt ins Gefängnis zurückbrachte und in eine Zelle einschloß.“"
                                            },
                                            {
                                                "example_id": "9ecfa8c5-5cd3-4719-a4da-e7d44f29bc46",
                                                "sense_id": "24d7103b-8f8f-316a-bf05-d1d71d7f1142",
                                                "text": "„Halder fuhr sich mit einer Geste der Verzweiflung durch die Haare.“"
                                            },
                                            {
                                                "example_id": "fa7e4a3a-c90c-4842-b693-7d0376b561f7",
                                                "sense_id": "24d7103b-8f8f-316a-bf05-d1d71d7f1142",
                                                "text": "„So erwartete ich in Verzweiflung den Morgen.“"
                                            },
                                            {
                                                "example_id": "18c50f93-6b09-40ce-a022-f097e8962dec",
                                                "sense_id": "24d7103b-8f8f-316a-bf05-d1d71d7f1142",
                                                "text": "„In meiner Verzweiflung ging ich bis ans Dorfende und brach dort in Tränen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efa647ae-7096-4b23-abfc-6e7c93718556",
                        "source_entry_id": "e00f73a0-c4b7-3497-a78c-51e9a615fbee",
