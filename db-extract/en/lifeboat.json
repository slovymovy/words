                    {
                        "sense_id": "b33af908-1505-3433-90bb-ac4aecba11c3",
                        "entry_id": "719665d9-7bd7-38fc-afbc-9b0029b55b9b",
                        "glosses": [
                            "A boat especially designed for saving the lives of shipwrecked people or people in distress at sea (either launched from the shore with a crew, or else carried on board a larger ship)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770ef031-64e5-4a1c-a283-9f6d94aaea8b",
                                "sense_id": "b33af908-1505-3433-90bb-ac4aecba11c3",
                                "text": "I've got a watch that turns into a lifeboat"
                            },
                            {
                                "example_id": "ce9158d8-2ceb-48ee-ae50-29ac1cbe4011",
                                "sense_id": "b33af908-1505-3433-90bb-ac4aecba11c3",
                                "text": "In a corner of the churchyard, where old headstones mark the graves of many mariners, is a striking white statue of a lifeboatman, erected as a memorial to three members of the local lifeboat crew who lost their lives in 1916 while trying to reach a ship in distress."
                            }
                        ]
                    },
                    {
                        "sense_id": "16a675ae-1616-3496-81b3-66d595359c37",
                        "entry_id": "719665d9-7bd7-38fc-afbc-9b0029b55b9b",
                        "glosses": [
                            "An emergency vehicle carried aboard a spaceship."
                        ],
