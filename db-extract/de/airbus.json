                    {
                        "sense_id": "9bd3dd0a-39c6-3ed1-95ba-8cb4121c31e2",
                        "entry_id": "c4a42e6d-1f4a-3a71-ac6b-76a994d87653",
                        "glosses": [
                            "großer europäischer Flugzeughersteller"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "69d270f7-cfaa-4c7d-8e00-dc05246e87f0",
                                "sense_id": "9bd3dd0a-39c6-3ed1-95ba-8cb4121c31e2",
                                "text": "Das Emirat Dubai will offenbar seine Großbestellungen bei Airbus und Boeing umschichten."
                            },
                            {
                                "example_id": "dbbdb445-6b9a-47c3-a301-9af311698617",
                                "sense_id": "9bd3dd0a-39c6-3ed1-95ba-8cb4121c31e2",
                                "text": "„Sie arbeitet bei Airbus, die Rente ist nah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                        "entry_id": "c4a42e6d-1f4a-3a71-ac6b-76a994d87653",
                        "glosses": [
                            "ein einzelnes Flugzeug des Herstellers Airbus^([1])"
                        ],
                        "tags": [
                            "Singular -usses und Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "15bfa4cd-ef6d-48c7-b80d-cf0a00bbb019",
                                "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                                "text": "Umgerüstet zum Privatjet ist der Airbus A380 (Superjumbo) heute das größte mobile Statussymbol der Welt."
                            },
                            {
                                "example_id": "ad9e2c3b-aee6-44df-9e99-16a881ef12a2",
                                "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                                "text": "Die Blackbox des abgestürzten Airbus konnte bislang nicht gefunden werden."
                            },
                            {
                                "example_id": "4d9f6585-9092-44d4-bbc3-8e1d2fa1465c",
                                "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                                "text": "„In einer Zeit, da ein Mittelklassewagen wie der andere aussieht und sich auch moderne Verkehrsflugzeuge im Design nur unwesentlich voneinander unterscheiden, ist der Airbus A 380 eben ein besonderes Fluggerät.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
