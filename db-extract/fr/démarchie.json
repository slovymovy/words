                                        "entry_id": "2e02f2c4-175e-31ae-a1b7-1de346d36953",
                                        "glosses": [
                                            "Government by decision-makers who have been randomly selected by sortition (lot) from a pool of eligible citizens."
                                        ],
                                        "tags": [
                                            "countable",
