                ],
                "senses": [
                    {
                        "sense_id": "ce49fbbc-f23d-379b-adc2-d69d8af87026",
                        "entry_id": "c7c35586-2b38-3a91-87c3-bf44cb561eef",
                        "glosses": [
                            "Sorte de pèlerine ou de garniture qui s’ajoute à un corsage d’ordinaire décolleté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f091697-19c0-46aa-b151-13dc01d331c0",
                                "sense_id": "ce49fbbc-f23d-379b-adc2-d69d8af87026",
                                "text": "Et avez-vous des berthes en point à l’aiguille ? demanda la comtesse à Deloche. Faites voir, je vous prie."
                            }
                        ]
                    },
                    {
                        "sense_id": "08658def-d950-34c3-a6cb-e9e7f0da0480",
                        "entry_id": "c7c35586-2b38-3a91-87c3-bf44cb561eef",
                        "glosses": [
                            "L’un des noms vulgaires du grèbe, et plus spécialement du grèbe huppé (Podiceps cristatus)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "42aafafa-6580-3cb9-8817-130179ffab73",
                        "entry_id": "c7c35586-2b38-3a91-87c3-bf44cb561eef",
                        "glosses": [
                            "Bidon servant au transport du lait."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "5596d7fd-55a3-43bd-b354-99b3bb609b85",
                                "sense_id": "42aafafa-6580-3cb9-8817-130179ffab73",
                                "text": "Ce matin-là, je lui ai promis de tenir l’oreille ouverte : la Range Rover de la Croix-Rouge suédoise doit lui livrer une berthe de lait frais, une gamelle de pommes de terre tièdes, du cochon bouilli et un biscuit de soldat à la mie serrée."
                            },
                            {
                                "example_id": "73d55447-2890-49e4-bc1a-0e4729a9fd43",
                                "sense_id": "42aafafa-6580-3cb9-8817-130179ffab73",
                                "text": "Tous les jours, actuellement, l’étable fournit 250 à 300 litres de lait. Recueilli dans de vastes « berthes » brillantes il est remis au service de la stérilisation qui occupe la partie droite de la vacherie."
                            }
                        ]
                    }
