                ],
                "senses": [
                    {
                        "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                        "entry_id": "b2b4a6f1-17a6-3ce2-a3cd-ca9e0728efdc",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4914a5ce-9a09-4d15-9ec6-4030ce052e5e",
                                "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                                "text": "Frau Blomberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f6f91fad-0a00-440e-ba8d-64a4835ba914",
                                "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                                "text": "Herr Blomberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c8c463de-ae3d-43ce-b680-ee97503c91ed",
                                "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                                "text": "Die Blombergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "dedf30c3-30c0-4fe0-9bfc-7f494c4953e9",
                                "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                                "text": "Der Blomberg trägt nie die Schals, die die Blomberg ihm strickt."
                            },
                            {
                                "example_id": "8f95d83b-bc4d-448e-8251-34e5d4923eb2",
                                "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Blomberg kommt, geht der Herr Blomberg.“"
                            },
                            {
                                "example_id": "e502b589-42e3-4e1c-b8f0-d8c9e0c72887",
                                "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                                "text": "Blomberg kommt und geht."
                            },
                            {
                                "example_id": "ac27cd3f-e3a8-412f-811d-b0386c26a2ab",
                                "sense_id": "aa14887f-391b-3c62-a2d4-e9ddfef72f1f",
                                "text": "Blombergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
