                },
                {
                    "sense_id": "2046d5e8-6135-3c37-a8d2-fa14ba12f944",
                    "sense_definition": "Verleden tijd enkelvoud van <w>verdenken</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar <w>verdacht</w> de leerling van spieken tijdens de toets.",
                            "target_lang_translations": {
                                "en": "The teacher <w>suspected</w> the student of cheating during the test.",
                                "ru": "Учитель <w>подозревал</w> ученика в списывании во время теста.",
                                "it": "L'insegnante <w>sospettava</w> che lo studente copiasse durante il test."
                            }
                        },
                        {
                            "text": "Niemand <w>verdacht</w> haar, omdat ze altijd zo eerlijk leek.",
                            "target_lang_translations": {
                                "en": "No one <w>suspected</w> her, because she always seemed so honest.",
                                "ru": "Никто не <w>подозревал</w> ее, так как она всегда казалась такой честной.",
                                "it": "Nessuno la <w>sospettava</w>, perché sembrava sempre così onesta."
                            }
                        }
                    ],
