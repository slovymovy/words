                "senses": [
                    {
                        "sense_id": "f574838a-ca44-3c83-94bb-975949682c67",
                        "entry_id": "5efef552-1164-3b2a-85c5-0d0872c49f26",
                        "glosses": [
                            "geometrische Figur mit hundert Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "b65e5f1b-ac53-407a-9c41-b671da9aeea3",
                                "sense_id": "f574838a-ca44-3c83-94bb-975949682c67",
                                "text": "„So kann z.B. ein Kreis durch ein umschriebenes Acht-, Zwölf- oder Hunderteck immer genauer angenähert werden, ohne dass die Kurve jemals wirklich rund wird.“"
                            },
                            {
                                "example_id": "5889b78c-7954-46c4-800e-96be6331e8d0",
                                "sense_id": "f574838a-ca44-3c83-94bb-975949682c67",
                                "text": "„Bei einem Hunderteck, das einem Kreis mit Radius 11 m eingeschrieben ist, würden, von gegenüberliegenden Spitzen aus gezählt, die jeweils zwölften Ecken ein Rechteck von 1402 zu 1695 cm definieren, das gerade innerhalb der oben geforderten ±5 cm-Toleranz läge.“"
                            },
                            {
                                "example_id": "a5cd76d7-cd58-4972-b633-1691632c145c",
                                "sense_id": "f574838a-ca44-3c83-94bb-975949682c67",
                                "text": "„Dinge, die wir als einfach sehen, können physikalisch weiter zerlegt werden, ein Hunderteck erscheint uns, ebenso wie ein Tausendeck, als physikalischer Kreis, Fixsterne sehen wir als konturlose Punkte, […]“"
                            },
                            {
                                "example_id": "547a58b6-4b1c-40b5-b58c-fa4cdfcac174",
                                "sense_id": "f574838a-ca44-3c83-94bb-975949682c67",
                                "text": "„Der Cusaner veranschaulicht an der Gegensätzlichkeit von Vieleck und Kreis: sie bleibt bei aller Vervielfachung der Ecken Viereck, Fünfeck, Hunderteck, verschwindet aber und wird Identität beim unendlichen Eck.“"
                            },
                            {
                                "example_id": "36133a37-d2d9-4fdd-a9e0-27988c3b8a84",
                                "sense_id": "f574838a-ca44-3c83-94bb-975949682c67",
                                "text": "„Dann fragte unser Lehrer nach der Zahl beim Hunderteck, und wir mußten verzagt die Ohnmacht unserer Bemühung einsehen, hier noch mit der Zeichnung durchzukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
