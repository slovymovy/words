                "senses": [
                    {
                        "sense_id": "6c211d09-7e39-3060-9c4b-e31119411ce3",
                        "entry_id": "479072d3-d4fd-3563-afd0-1afe5a67ff05",
                        "glosses": [
                            "Limonade, die aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "292b724f-12f7-43ad-a452-f0bd9bb19555",
                                "sense_id": "6c211d09-7e39-3060-9c4b-e31119411ce3",
                                "text": "„Um die Zeit zu überbrücken, bis ihnen die Gerichte ausgehändigt wurden, tranken sie eine Biolimonade.“"
                            },
                            {
                                "example_id": "848a00a8-0bb4-4d09-8098-9f3769aa0677",
                                "sense_id": "6c211d09-7e39-3060-9c4b-e31119411ce3",
                                "text": "„Er hatte sich eine Flasche Biolimonade unter den linken Arm geklemmt und trug außerdem drei von Isabellas feinen Schnörkelgläsern.“"
                            },
                            {
                                "example_id": "940b4121-344f-4972-8892-5679684b00f8",
                                "sense_id": "6c211d09-7e39-3060-9c4b-e31119411ce3",
                                "text": "„Sie verteilte frisch gezapftes Pils das griechische Busfahrerquartett und versorgte die Studentinnen mit Biolimonade.“"
                            },
                            {
                                "example_id": "fc76715e-a5c4-4df2-8a8f-95f4127f7793",
                                "sense_id": "6c211d09-7e39-3060-9c4b-e31119411ce3",
                                "text": "„Aus ihrem Wohnwagen serviert sie unglaublich leckeren Kaffee, Tee, Biolimonaden und im Winter heiße Schokolade.“"
                            },
                            {
                                "example_id": "43587415-bad2-4901-aff2-15d59642cefd",
                                "sense_id": "6c211d09-7e39-3060-9c4b-e31119411ce3",
                                "text": "„Du willst einfach nur eine Fanta, und sie geben dir eine Biolimonade aus Frankreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
