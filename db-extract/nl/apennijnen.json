                "senses": [
                    {
                        "sense_id": "dc7b0733-1d74-36f8-ac7b-46d57fa2745f",
                        "entry_id": "53836538-ecce-3d84-94cf-f5b844047882",
                        "glosses": [
                            "gebergte in Italië dat zich uitstrekt over de lengte van het Italiaans schiereiland, van Ligurië tot Calabrië en daarna wordt voortgezet op het eiland Sicilië"
                        ],
                        "tags": [
                            "toponiem: gebergte"
                        ],
                        "examples": [
                            {
                                "example_id": "3d0f8b2a-0552-4b9f-aa6f-7b48bd1b2aa4",
                                "sense_id": "dc7b0733-1d74-36f8-ac7b-46d57fa2745f",
                                "text": "In feite is het natuurlijk Joy's schuld dat wij hier zonder gids in de Siciliaanse Apennijnen ronddolen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaed46d0-bf4d-42c7-8e30-edc480a0934d",
                        "source_entry_id": "53836538-ecce-3d84-94cf-f5b844047882",
                        "source_sense_id": "dc7b0733-1d74-36f8-ac7b-46d57fa2745f",
                        "source_sense_description": "gebergte",
                        "target_lang_word": "Apennines",
