                "senses": [
                    {
                        "sense_id": "4b990ea6-291d-3a29-bdab-23fced33b010",
                        "entry_id": "f5d2143e-5cea-37a9-8cc3-e45781821d79",
                        "glosses": [
                            "Accompagner, dans la langue des signes, une musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53684a4-c56a-4205-b7e8-afac470ada0a",
                                "sense_id": "4b990ea6-291d-3a29-bdab-23fced33b010",
                                "text": "Co-produit par l’association Made In Terranéen qu’il a créée, ce spectacle inédit de David Lion verra se côtoyer sur scène des danseurs, chanteurs, musiciens, une chorale et deux interprètes diplômées de Langue des Signes Française, qui « chansigneront » les textes en temps réel."
                            },
                            {
                                "example_id": "6db69a3a-7098-48fb-ae14-1df50759c6d8",
                                "sense_id": "4b990ea6-291d-3a29-bdab-23fced33b010",
                                "text": "« Nous avons chacune nos instruments, moi la voix, elle ses mains. » C'est ainsi que Colombe Barsacq décrit la prestation qu'elle a mise en scène avec Isabelle Voizeux. Elle, chante, celle qui l'accompagne, chansigne."
                            },
                            {
                                "example_id": "a767aecb-625b-4940-98b5-2a44fb596097",
                                "sense_id": "4b990ea6-291d-3a29-bdab-23fced33b010",
                                "text": "L'idée était que les élèves chansignent la chanson « Je bois » de Boris Vian devant les personnes âgées de la maison de retraite."
                            }
                        ]
                    }
                ],
