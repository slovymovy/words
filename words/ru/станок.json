                            {
                                "target_lang_word": "rig",
                                "target_lang_sense_clarification": "drilling"
                            },
                            {
                                "target_lang_word": "drilling rig",
                                "target_lang_sense_clarification": "full term"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wiertnica",
                                "target_lang_sense_clarification": "maszyna wiertnicza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0ba1349-6bc4-3bdd-a044-a70b3a6c3efd",
                    "sense_definition": "Узкое огороженное место в конюшне или хлеву для содержания или фиксации одного животного.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ветеринар попросил завести лошадь в <w>станок</w> для осмотра.",
                            "target_lang_translations": {
                                "en": "The veterinarian asked to lead the horse into the <w>stall</w> for examination.",
                                "pl": "Weterynarz poprosił o wprowadzenie konia do <w>poskromu</w> na badanie."
                            }
                        },
                        {
                            "text": "Животные спокойно стояли в своих <w>станках</w> в ожидании корма.",
                            "target_lang_translations": {
                                "en": "The animals stood quietly in their <w>stalls</w> waiting for feed.",
                                "pl": "Zwierzęta stały spokojnie na swoich <w>stanowiskach</w>, czekając na paszę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "стойловый станок"
                    ],
                    "target_lang_definitions": {
                        "en": "A narrow enclosed space in a stable or barn for keeping or restraining a single animal.",
                        "pl": "Wydzielone stanowisko w stajni lub oborze dla jednego zwierzęcia bądź poskrom do zabiegów weterynaryjnych."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stall",
                                "target_lang_sense_clarification": "enclosure"
                            },
                            {
                                "target_lang_word": "pen",
                                "target_lang_sense_clarification": "enclosure"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "stanowisko",
                                "target_lang_sense_clarification": "dla pojedynczego zwierzęcia"
                            },
                            {
                                "target_lang_word": "poskrom",
                                "target_lang_sense_clarification": "klatka do unieruchamiania zwierząt"
                            },
                            {
                                "target_lang_word": "boks",
                                "target_lang_sense_clarification": "w stajni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdb7facc-8c2d-3002-a30a-7c1630faed91",
                    "sense_definition": "Почтовая станция или небольшое поселение в Сибири, где меняли лошадей и отдыхали путники.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Уставшие путники надеялись добраться до ближайшего <w>станка</w> до темноты.",
                            "target_lang_translations": {
                                "en": "The tired travelers hoped to reach the nearest <w>post station</w> before dark.",
                                "pl": "Zmęczeni podróżni mieli nadzieję dotrzeć do najbliższej <w>stacji pocztowej</w> przed zmrokiem."
                            }
                        },
                        {
                            "text": "На этом <w>станке</w> всегда можно было найти горячий самовар и ночлег.",
                            "target_lang_translations": {
                                "en": "At this <w>station</w>, one could always find a hot samovar and a place to sleep.",
                                "pl": "Na tej <w>stacji</w> zawsze można było znaleźć gorący samowar i nocleg."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Сибирь"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A post station or small settlement in Siberia where travelers changed horses and rested.",
                        "pl": "Dawna stacja pocztowa lub mała osada na Syberii, gdzie zmieniano konie i odpoczywali podróżni."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "post station",
                                "target_lang_sense_clarification": "historical"
                            },
                            {
                                "target_lang_word": "way station",
                                "target_lang_sense_clarification": "travel"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "stacja pocztowa",
                                "target_lang_sense_clarification": "historycznie, stacja wymiany koni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f802e45-85c3-39e6-9c6f-7813bd496a1a",
                    "sense_definition": "Женская фигура или ягодицы.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Парни во дворе грубо обсуждали её <w>станок</w>.",
                            "target_lang_translations": {
                                "en": "The guys in the yard were rudely discussing her <w>body</w>.",
                                "pl": "Chłopaki na podwórku ordynarnie komentowali jej <w>figurę</w>."
                            }
                        },
                        {
                            "text": "Он не мог отвести взгляд от её шикарного <w>станка</w>.",
                            "target_lang_translations": {
                                "en": "He couldn't take his eyes off her gorgeous <w>figure</w>.",
                                "pl": "Nie mógł oderwać wzroku od jej zjawiskowej <w>figury</w>."
                            }
                        }
                    ],
