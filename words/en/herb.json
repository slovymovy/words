                },
                {
                    "sense_id": "65ae5fd2-8340-39df-9624-066909bd0d42",
                    "sense_definition": "Grass or vegetation eaten by grazing animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep wandered the hills, grazing on the tender <w>herb</w>.",
                            "target_lang_translations": {
                                "ru": "Овцы бродили по холмам, щипля нежную <w>траву</w>.",
                                "pl": "Owce wędrowały po wzgórzach, pasąc się na delikatnej <w>runi</w>."
                            }
                        },
                        {
                            "text": "In the old poem, the fields were rich with green <w>herb</w>.",
                            "target_lang_translations": {
                                "ru": "В старинной поэме поля были богаты зеленой <w>травой</w>.",
                                "pl": "W starym poemacie pola obfitowały w zielone <w>zioła</w>."
                            }
                        }
