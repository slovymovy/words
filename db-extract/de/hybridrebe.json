                "senses": [
                    {
                        "sense_id": "e6fa33e3-c4fa-3a2c-b7b8-27726099aa89",
                        "entry_id": "9646fb2e-c887-3f70-8f45-cad7036c7d87",
                        "glosses": [
                            "die Nachkommen zweier verschiedener Weinrebenspezies im Gegensatz zur Rebsorte, die eine Kreuzung zwischen zwei Sorten derselben Spezies darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af08ab70-845e-4464-a175-30538a574599",
                                "sense_id": "e6fa33e3-c4fa-3a2c-b7b8-27726099aa89",
                                "text": "„Muskat bleu“, Synonym „Aromato“: Diese Hybridrebe hat feste, große, längliche, dunkelblaue Beeren an sehr lockeren, langen Trauben. Sie schmecken fruchtig-aromatisch.“"
                            },
                            {
                                "example_id": "21caf7f8-20e9-4c54-bb5b-b9e877c17e0a",
                                "sense_id": "e6fa33e3-c4fa-3a2c-b7b8-27726099aa89",
                                "text": "„Es wird mit verschiedenen Neuzüchtungen wie der roten Regent-Traube expermientiert, die vor allem pilzresistenter sein sollen, jedoch lassen diese geschmacklich die Herkunft als Hybridrebe spüren."
                            },
                            {
                                "example_id": "66a563b3-0d07-4d47-8ecb-49c2ab9c5eb2",
                                "sense_id": "e6fa33e3-c4fa-3a2c-b7b8-27726099aa89",
                                "text": "„Da die französische Hybridrebe Acadie Blanc besonders gut in Nova Scotia gedeiht, wurde sie zum Markenzeichen der Provinz. Der daraus gekelterte, mittelschwere Weißwein schmeckt leicht nach Zitrusfrüchten […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
