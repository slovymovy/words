                    {
                        "translation_id": "45e2a78a-15e7-420f-9398-decf26659664",
                        "source_entry_id": "12316acd-0621-3e24-a2c8-c6cb262ddbeb",
                        "source_sense_description": "chemical element",
                        "target_lang_word": "fluor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
