    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f39712e-461d-31a7-b2d8-91c38a8c652f",
                    "sense_definition": "een situatie waarin een bepaalde ontwikkeling of een proces plotseling veel sneller gaat verlopen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "versnelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de uitvinding van de transistor raakte de ontwikkeling van de computer in een <w>stroomversnelling</w>.",
                            "target_lang_translations": {
                                "en": "Due to the invention of the transistor, the development of the computer <w>accelerated rapidly</w>."
                            }
                        },
                        {
                            "text": "De politieke onderhandelingen kwamen gisteren in een <w>stroomversnelling</w> na het nieuwe voorstel.",
                            "target_lang_translations": {
                                "en": "The political negotiations <w>gained momentum</w> yesterday after the new proposal."
                            }
                        }
                    ],
                    "synonyms": [
                        "versnelling",
                        "bespoediging"
                    ],
                    "antonyms": [
                        "vertraging",
                        "stagnatie"
                    ],
                    "common_phrases": [
                        "in een stroomversnelling raken",
                        "in een stroomversnelling komen"
                    ],
                    "target_lang_definitions": {
                        "en": "a situation in which a certain development or process suddenly starts to proceed much faster"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "acceleration",
                                "target_lang_sense_clarification": "of a process or development"
                            },
                            {
                                "target_lang_word": "rapid development",
                                "target_lang_sense_clarification": "sudden increase in speed"
                            },
                            {
                                "target_lang_word": "fast track",
                                "target_lang_sense_clarification": "metaphorical speed increase"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2de65fcc-8332-3a4d-896d-f5c58bd67c2c",
                    "sense_definition": "een gedeelte in een rivier waar het water sneller stroomt dan elders vanwege een verval of versmalling",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waterloop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kanoërs moesten goed opletten toen ze de gevaarlijke <w>stroomversnelling</w> naderden.",
                            "target_lang_translations": {
                                "en": "The canoeists had to pay close attention as they approached the dangerous <w>rapids</w>."
                            }
                        },
                        {
                            "text": "In deze bergrivier volgt de ene <w>stroomversnelling</w> op de andere.",
                            "target_lang_translations": {
                                "en": "In this mountain river, one <w>rapid</w> follows another."
                            }
                        }
                    ],
                    "synonyms": [
                        "stroomnaad",
                        "ritsel"
                    ],
                    "common_phrases": [
                        "gevaarlijke stroomversnelling"
                    ],
                    "target_lang_definitions": {
                        "en": "a part of a river where the water flows faster than elsewhere due to a drop or narrowing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rapids",
                                "target_lang_sense_clarification": "fast-flowing part of a river"
                            },
                            {
                                "target_lang_word": "whitewater",
                                "target_lang_sense_clarification": "turbulent water in a river"
                            }
                        ]
                    }
                }
            ]
        }
    ]
