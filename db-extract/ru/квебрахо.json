                                "target_senses": [
                                    {
                                        "sense_id": "ebd98adc-0a4e-37e1-a464-f30cd1de0460",
                                        "entry_id": "1f8bf690-640e-3593-8b15-fe3bc45d0e68",
                                        "glosses": [
                                            "Nom donné à des arbres d’Amérique du Sud, à bois très dur et riche en tanin, appartenant à la famille des apocynacées ou à celle des anacardiacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "707e5272-4b64-4ef5-aee8-5ed1fc92f001",
                                                "sense_id": "ebd98adc-0a4e-37e1-a464-f30cd1de0460",
                                                "text": "En France au même moment, deux entreprises transforment le bois de québracho en tan liquide ou sec."
                                            },
                                            {
                                                "example_id": "6a15b558-929d-49c5-b433-f3d12bd8402d",
                                                "sense_id": "ebd98adc-0a4e-37e1-a464-f30cd1de0460",
                                                "text": "La partie centrale, Est et Sud du Parc National, est constituée par une masse arborescente dans laquelle prédominent, entre autres, le québracho - blanc et coloré, guayacán, urunday, caroubier blanc, chañar et mistol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
