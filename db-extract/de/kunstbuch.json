                "senses": [
                    {
                        "sense_id": "2bf00a2b-2b34-3e88-86ce-161129f91321",
                        "entry_id": "a3654d05-7919-3298-b8dd-bb2cb528175c",
                        "glosses": [
                            "Buch, das als Thema die Bildende Kunst hat (als theoretisches Werk, Bildband oder Ähnliches)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1043ead4-9269-49bb-b64b-a0de28d85bbd",
                                "sense_id": "2bf00a2b-2b34-3e88-86ce-161129f91321",
                                "text": "„Die großformatigen Kunstbücher hatte sich mein Vater von seinem Genfer Verlegerfreund Skira abgeschaut, der damit ebenfalls Erfolge feierte.“"
                            },
                            {
                                "example_id": "c4f1250f-93d0-4860-b526-cc91211870f1",
                                "sense_id": "2bf00a2b-2b34-3e88-86ce-161129f91321",
                                "text": "„Bibliophile Klassikerausgaben waren seine Spezialität, daneben verlegte er Kunstbücher, aber auch zahlreiche moderne Autoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
