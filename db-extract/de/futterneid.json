                ],
                "senses": [
                    {
                        "sense_id": "803b8131-8b1e-3461-bee3-adbd97086ff3",
                        "entry_id": "15cb205f-0943-3d38-a96a-d939b55fcbf5",
                        "glosses": [
                            "vermutete Rivalität von Tieren um Futter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478949cd-027c-4120-8743-19a441ce5047",
                                "sense_id": "803b8131-8b1e-3461-bee3-adbd97086ff3",
                                "text": "Zwei Dutzend Geier sitzen und hüpfen um den toten Büffel herum, ein zänkischer Haufen, getriezt und getrieben von Futterneid."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0f64f5fb-baa5-34f8-8faf-7152e8444a83",
                        "entry_id": "15cb205f-0943-3d38-a96a-d939b55fcbf5",
                        "glosses": [
                            "Rivalität zwischen Personen um irgendwelche Vorteile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fded9132-a09f-48dc-a3c7-73cdddd4f9bc",
                                "sense_id": "0f64f5fb-baa5-34f8-8faf-7152e8444a83",
                                "text": "„Doch lassen sich die Titanenkämpfe der Epoche nicht trennen von literarischem Futterneid, persönlichen Animositäten und der schieren Lust an der Invektive.“"
                            },
                            {
                                "example_id": "b18c8a41-5318-4f39-af59-28d5c27a07ce",
                                "sense_id": "0f64f5fb-baa5-34f8-8faf-7152e8444a83",
                                "text": "Futterneid gibt’s auch unter Menschen, nämlich dann, wenn jemand anderes etwas hat, was man selbst gerne hätte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
