                "senses": [
                    {
                        "sense_id": "9c18a22c-765f-37e8-a178-eabd2cd2cbfb",
                        "entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "glosses": [
                            "een beeld dat ter versiering aangebracht werd op de voorsteven van een schip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f4488f-c40d-4486-b6ae-5e30973bf01b",
                                "sense_id": "9c18a22c-765f-37e8-a178-eabd2cd2cbfb",
                                "text": "Het schip had een zeemeermin als boegbeeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "96629dff-1236-3478-a054-e1ed86afcdda",
                        "entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "glosses": [
                            "een opvallend kenmerk van iets dat als voorbeeld, uithangbord of visitekaartje fungeert"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "97d6aee9-ea7d-426e-b2a7-a4b429d4ee72",
                                "sense_id": "96629dff-1236-3478-a054-e1ed86afcdda",
                                "text": "Dit merk is echt het boegbeeld van deze autofabrikant."
                            },
                            {
                                "example_id": "44242ef6-e710-4b76-9168-a0c900af9cc3",
                                "sense_id": "96629dff-1236-3478-a054-e1ed86afcdda",
                                "text": "Ze richtte haar pijlen onlangs op L'Oréal, dat Roberts als boegbeeld gebruikt om een antirimpelcrème te promoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "d26dd3a3-87c2-37b5-9a22-99a991f4d413",
                        "entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "glosses": [
                            "iemands neus, vooral als deze nogal groot is"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "24aea257-237b-4763-8e91-07fa8a46ef19",
                                "sense_id": "d26dd3a3-87c2-37b5-9a22-99a991f4d413",
                                "text": "Je zou toch met zo'n boegbeeld door het leven moeten!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfd33c63-e045-4cb4-98ad-4e2e8cc95782",
                        "source_entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "source_sense_id": "9c18a22c-765f-37e8-a178-eabd2cd2cbfb",
                        "source_sense_description": "een beeld dat ter versiering aangebracht werd op de voorsteven van een schip",
                        "target_lang_word": "Galionsfigur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galionsfigur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95f5dee6-58c5-35fb-8db9-8363c9691082",
                                        "entry_id": "eaf98096-b91c-3a43-985c-2e478be3fc1e",
                                        "glosses": [
                                            "meist weibliche Figur aus Holz am Bug (= an der Spitze) eines größeren Segelschiffes, befestigt unter dem Klüverbaum, am Bugspriet oder am Vordersteven"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd8108d5-28c0-4138-92d0-339f5775ee11",
                                                "sense_id": "95f5dee6-58c5-35fb-8db9-8363c9691082",
                                                "text": "„Im Aberglauben von Seeleuten soll die Galionsfigur den Kurs des Schiffes beobachten und es vor Unglück bewahren.“"
                                            },
                                            {
                                                "example_id": "b90945d4-2df7-42e2-8f32-afad695995fa",
                                                "sense_id": "95f5dee6-58c5-35fb-8db9-8363c9691082",
                                                "text": "„Viele Segelschiffe tragen am Bug eine so genannte Galionsfigur: Holzskulpturen, die zum Beispiel eine Frau, ein Tier oder ein Fabelwesen darstellen.“"
                                            },
                                            {
                                                "example_id": "80ef49d6-3b7a-420b-86da-fee681e23a73",
                                                "sense_id": "95f5dee6-58c5-35fb-8db9-8363c9691082",
                                                "text": "„Auch die vollbusige Meerjungfrau, die als Galionsfigur über das Wasser ragte, hatte schon bessere Tage gesehen.“"
                                            },
                                            {
                                                "example_id": "dfc02619-55f0-473c-821f-94d6353b6a17",
                                                "sense_id": "95f5dee6-58c5-35fb-8db9-8363c9691082",
                                                "text": "„Sie trippelte nicht, und sie hielt den Kopf hoch wie eine Galionsfigur an einem Schiff; das machte sie größer, als sie war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f332f2e6-250b-38b3-9cb5-e6be8988cd48",
                                        "entry_id": "eaf98096-b91c-3a43-985c-2e478be3fc1e",
                                        "glosses": [
                                            "beliebte / zugkräftige Person, die innerhalb einer Organisation (beispielsweise einer politischen Partei) in den Vordergrund gestellt wird"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd69eeb2-7738-4d7a-9ca9-768203a0f098",
                                                "sense_id": "f332f2e6-250b-38b3-9cb5-e6be8988cd48",
                                                "text": "„Die Omas gegen Rechts sind inzwischen zu den Galionsfiguren der Proteste gegen die konservativ/rechtspopulistische Regierung Österreichs geworden.“"
                                            },
                                            {
                                                "example_id": "6fbcc28c-dddc-4af8-a1f6-ed7b7cb41aff",
                                                "sense_id": "f332f2e6-250b-38b3-9cb5-e6be8988cd48",
                                                "text": "„Carles Puigdemont ist die Galionsfigur der katalanischen Unabhängigkeitsbewegung.“"
                                            },
                                            {
                                                "example_id": "ba57faf5-4d40-4c2b-8ac8-8742e1bb4b76",
                                                "sense_id": "f332f2e6-250b-38b3-9cb5-e6be8988cd48",
                                                "text": "„[Der Pastor und Bürgerrechtler Martin Luther] King ist eine Ikone und eine Galionsfigur für soziale Gerechtigkeit“, resümiert Amerikanistin [Sieglinde] Lemke."
                                            },
                                            {
                                                "example_id": "eae5be89-9954-41ea-9df8-703ea258c142",
                                                "sense_id": "f332f2e6-250b-38b3-9cb5-e6be8988cd48",
                                                "text": "„„MeToo“ verschaffte ihr Einladungen sämtlicher Fernsehsender – schnell wurde Linnéa Claeson eines der Gesichter der Debatte, manche sagen: die Galionsfigur.“"
                                            },
                                            {
                                                "example_id": "951dc723-23b4-498f-b903-2a8ecb30370d",
                                                "sense_id": "f332f2e6-250b-38b3-9cb5-e6be8988cd48",
                                                "text": "„Einst galt sie als Galionsfigur eines neuen weiblichen Schreibens. Die Schriftstellerin Judith Hermann wurde mit ihrem Erzählband „Sommerhaus, später“ berühmt.“"
                                            },
                                            {
                                                "example_id": "1779b396-5256-49a4-94e0-fa50461b3c68",
                                                "sense_id": "f332f2e6-250b-38b3-9cb5-e6be8988cd48",
                                                "text": "„In der ersten Runde der Präsidentschaftswahl [2017] erhielt Mélenchon fast 20 Prozent der Stimmen, jeder dritte junge Franzose wählte ihn. Wenn es auch für die Stichwahl nicht reichte, wurde Mélenchon mit diesem Ergebnis doch zu einer Art Galionsfigur der französischen Linken, die Sozialisten hatten nicht einmal sieben Prozent erreicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7403f48-a690-4165-81b6-a2889573dd19",
                        "source_entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "source_sense_id": "9c18a22c-765f-37e8-a178-eabd2cd2cbfb",
                        "source_sense_description": "een beeld dat ter versiering aangebracht werd op de voorsteven van een schip",
                        "target_lang_word": "figurehead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurehead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e207f1e0-a99e-3d4c-b4a4-90e9ce5b075e",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "A carved figure on the prow of a sailing ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "Someone in a nominal position of leadership who has little to no actual power."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f27d9ef-a9f8-45f0-8683-fc6b33dd9d2f",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Evidently he did not mean to be a mere figurehead, but to carry on the old tradition of Wilsthorpe's; and that was considered to be a good thing in itself and an augury for future prosperity."
                                            },
                                            {
                                                "example_id": "d37432da-8daa-4496-8643-7db23139b423",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Instead she played, largely impeccably, the part of a modern constitutional monarch, a symbolic figurehead with a right to be consulted and to advise and warn political leaders privately and to show herself publicly as a focus of national life, celebration and commemoration."
                                            },
                                            {
                                                "example_id": "fb9e707b-f047-4585-903a-8ec0d943d83e",
                                                "sense_id": "72800681-e128-39f0-b6da-8e203d607c77",
                                                "text": "Supporters of Wagenknecht, a controversial but prominent figurehead, are already hatching plans for a breakaway party to compete in the 2024 European elections, the German newspaper Taz reported this week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba44fb2a-a2e2-3fa0-a6d7-5ab563e8e211",
                                        "entry_id": "48c6ff78-3c7d-3707-b8ba-3faa39d0c869",
                                        "glosses": [
                                            "A person's face."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0a748f-587d-4680-8b00-e75ddf62b3ee",
                                                "sense_id": "ba44fb2a-a2e2-3fa0-a6d7-5ab563e8e211",
                                                "text": "HATCHET. Bring up, I say, or I'll spoil your figurehead. [Lifting his cudgel]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d16043cb-794e-47bf-a8eb-224ffd1c18b5",
                        "source_entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "source_sense_id": "9c18a22c-765f-37e8-a178-eabd2cd2cbfb",
                        "source_sense_description": "een beeld dat ter versiering aangebracht werd op de voorsteven van een schip",
                        "target_lang_word": "figure de proue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figure de proue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e91052-15e0-382c-8a62-1853c4554982",
                                        "entry_id": "ac7ea1e6-6b5d-3a1c-9849-fddd35e5bf92",
                                        "glosses": [
                                            "Sculpture de forme humaine, animale ou fantastique qui ornait la proue d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95de76c-3ee1-4a7d-b218-6499915881e2",
                                                "sense_id": "a6e91052-15e0-382c-8a62-1853c4554982",
                                                "text": "Alexis rêvait de monter une expédition en Nouvelle-Guinée pour ramener de ces lieux mythiques masques papous et figures de proues."
                                            },
                                            {
                                                "example_id": "d6376dee-969f-4783-bc9f-3795b53622b4",
                                                "sense_id": "a6e91052-15e0-382c-8a62-1853c4554982",
                                                "text": "Victor, qui lisait beaucoup de bandes dessinées, se dit qu’elle était comme la figure de proue d’un drakkar. Il se mit à rêver."
                                            },
                                            {
                                                "example_id": "5d6c7e4d-cc19-4e16-8e11-a99fc7597ba3",
                                                "sense_id": "a6e91052-15e0-382c-8a62-1853c4554982",
                                                "text": "Barques funèbres, avec en figures de proue des taureaux à têtes d’or et d’argent, elles avaient conduit les rois, les reines au Pays des ombres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                        "entry_id": "ac7ea1e6-6b5d-3a1c-9849-fddd35e5bf92",
                                        "glosses": [
                                            "Membre emblématique d’un groupe, celui qui est le plus en vue, chef de file d’un mouvement, d’un courant de pensée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae42ecc5-7494-4c48-870f-624d36dd5ce5",
                                                "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                                "text": "Il est une figure de proue du parti, mais ses hautes fonctions l’obligent à une certaine réserve."
                                            },
                                            {
                                                "example_id": "fdaac92a-71fe-4af1-9ddb-9ff3fd76d419",
                                                "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                                "text": "La figure de proue du groupe Boney M. était arrivée mercredi à Saint-Pétersbourg pour un événement d’entreprise […]"
                                            },
                                            {
                                                "example_id": "7003fb88-ab25-4043-b00b-ee08720b1dcb",
                                                "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                                "text": "De là on est passé aux rastas, avec leur tignasse réfractaire au peigne, symbole d'un ordre exécré. Les fils et filles d'esclaves se cherchent des héros, des modèles, des figures de proues et voilà que surgit cet empereur noir..."
                                            },
                                            {
                                                "example_id": "8db9ff02-4f5d-4b77-80ee-bb8070e6a6e2",
                                                "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                                "text": "La position géographique de la France, figure de proue de l’Europe tournée vers l’Atlantique, crée à nos ingénieurs une responsabilité… géographique."
                                            },
                                            {
                                                "example_id": "c2c1011f-2253-4892-b4b4-7aa6b55b5030",
                                                "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                                "text": "Pas de salut pour un couple hors de la direction unique. L’épouse en figure de proue et le mari à la barre."
                                            },
                                            {
                                                "example_id": "b5644780-9701-408e-a226-52cb49ebb733",
                                                "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                                "text": "La présence de Manet, surtout, figure de proue de la nouvelle peinture, justifie que la critique s’empresse de doter d’une étiquette un groupe qui n’a pas de réel programme, ni d’unité stylistique."
                                            },
                                            {
                                                "example_id": "fd8e06f1-c5a3-4eab-af8b-4ea2940cd627",
                                                "sense_id": "28b5ee2d-e31a-308c-9a3d-32966cc992ef",
                                                "text": "Dans le sillage de ces figures de proue que sont, par exemple, Hans Robert Jauss et ses défis historiques à la théorie littéraire ou encore Wolfgang Iser et sa Leerstelle, on trouve plusieurs autres voies navigables, inégalement fréquentées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dea6a04-79d2-4d78-b426-c8f9b407e353",
                        "source_entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "source_sense_id": "9c18a22c-765f-37e8-a178-eabd2cd2cbfb",
                        "source_sense_description": "een beeld dat ter versiering aangebracht werd op de voorsteven van een schip",
                        "target_lang_word": "mascarón de proa",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1ca30680-57f5-4425-88db-b34afff8b2e8",
                        "source_entry_id": "5e894b4d-4dd7-397c-9527-afb79dd3efa6",
                        "source_sense_id": "96629dff-1236-3478-a054-e1ed86afcdda",
                        "source_sense_description": "als voorbeeld, uithangbord of visitekaartje fungeren",
                        "target_lang_word": "égérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6156ffd8-5139-30be-b5a8-6164cc93566c",
                                        "entry_id": "82e99987-6503-341b-9ceb-cedfaa609fc0",
                                        "glosses": [
                                            "Femme qui est l’inspiratrice d’un homme, d’un écrivain, d’un artiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a48fc6f-b004-444e-ba9d-e7a65a837a8f",
                                                "sense_id": "6156ffd8-5139-30be-b5a8-6164cc93566c",
                                                "text": "Le tiers des lorettes, le quart des hommes d’État, la moitié des artistes consulte madame Fontaine, et l’on connaît un ministre à qui elle sert d’Égérie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab8654b1-d1e6-3475-8d05-cb77cf7e91b1",
                                        "entry_id": "82e99987-6503-341b-9ceb-cedfaa609fc0",
                                        "glosses": [
                                            "Personne ou animal représentant une marque, une société ou un produit en lui associant son image."
                                        ],
                                        "tags": [
                                            "Publicité",
                                            "Relation publique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f0af12-dc26-4e9a-afb5-f935d483ec0f",
                                                "sense_id": "ab8654b1-d1e6-3475-8d05-cb77cf7e91b1",
                                                "text": "Après M.I.A., designer d'une collection capsule pour la marque Versus de Versace, au tour de Lady Gaga de représenter la marque, dont elle sera l'égérie de la collection printemps-été 2014."
                                            },
                                            {
                                                "example_id": "480aa58d-9995-4c89-9c9d-ea0ce6d2a9d7",
                                                "sense_id": "ab8654b1-d1e6-3475-8d05-cb77cf7e91b1",
                                                "text": "S’en sont suivis des affrontements avec les forces de l’ordre, une inauguration du Salon retardée, une déambulation du président sous haute protection policière et une entrée empêchée pendant plusieurs heures pour le grand public désireux de visiter le hall 1, où se concentrent les animaux, dont l’égérie de l’événement : la vache Oreillette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f87e1e9-38a0-3e87-81bc-09d837bf5d01",
                                        "entry_id": "82e99987-6503-341b-9ceb-cedfaa609fc0",
                                        "glosses": [
                                            "Meneur ou personne représentative d’un mouvement, d’un groupe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec1d241f-52f1-41d6-8256-a0a977ba3698",
                                                "sense_id": "4f87e1e9-38a0-3e87-81bc-09d837bf5d01",
                                                "text": "Bernard Kouchner, un enfant de la banlieue devenu, un temps, l’égérie parisianiste d’une gauche caviar."
                                            },
                                            {
                                                "example_id": "41d8a4a1-d45d-4d16-b198-bcb265bd824a",
                                                "sense_id": "4f87e1e9-38a0-3e87-81bc-09d837bf5d01",
                                                "text": "L’égérie de la Révolution orange restera en prison."
                                            }
                                        ]
                                    }
                                ]
                            }
