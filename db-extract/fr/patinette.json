        "fr-extract.jsonl": [
            {
                "entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                "word": "patinette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32684c76-4305-4091-862a-a3b89485b10a",
                        "entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                        "tags": [
                            "plural"
                        ],
                        "form": "patinettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ae40587-5f11-3727-a5d2-1d800b4c9205",
                        "entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                        "glosses": [
                            "Jouet d’enfant muni d’un guidon et composé d’une planche portée par deux ou trois roues sur laquelle on pose un pied, l’autre étant utilisé pour la propulsion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba58c62-13d4-4858-b26e-6bee9d123259",
                                "sense_id": "6ae40587-5f11-3727-a5d2-1d800b4c9205",
                                "text": "Cette cour, aux larges pavés qui avaient, jadis, retenti sous les sabots des chevaux de race et où, maintenant, cahotait une patinette montée par un moutard glapissant, nous la traversâmes sans mot dire."
                            },
                            {
                                "example_id": "5fcb808b-ee9d-402a-bee7-0f83ae6cad53",
                                "sense_id": "6ae40587-5f11-3727-a5d2-1d800b4c9205",
                                "text": "Tout près, quelques enfants pas encore couchés faisaient des tours de patinette."
                            }
                        ]
                    },
                    {
                        "sense_id": "3547d2b7-80df-3afb-ab01-6e4f8bff9808",
                        "entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                        "glosses": [
                            "Engin de déplacement et de sport de conception identique au précédent mais prévu pour adultes. Spécifiquement conçue pour la vitesse, la patinette se caractérise par une roue avant de grande taille (650 à 700 mm). Certains modèles permettent d’atteler un chien de traîneau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91527d0d-adea-40d8-ac4e-39d92a95751e",
                                "sense_id": "3547d2b7-80df-3afb-ab01-6e4f8bff9808",
                                "text": "En août 2003, Alpo Kuusisto a parcouru Paris-Brest-Paris en quatre-vingt-cinq heures en patinette."
                            }
                        ]
                    },
                    {
                        "sense_id": "c53fe466-ccd5-3764-9219-312b8a6c2812",
                        "entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                        "glosses": [
                            "Skis très courts."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c182e48b-c588-3acb-bf32-513c6727e274",
                        "entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                        "glosses": [
                            "Sport pratiqué à l’aide de ces skis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "512f0577-e17e-3f41-8d08-eb0a3f529921",
                        "entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                        "glosses": [
                            "Carré de tissu à mettre sous ses pieds pour ne pas salir, ou, plus particulièrement, pour ne pas rayer le parquet."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fedc950e-6087-4c26-b1c0-83a74d3d6465",
                                "sense_id": "512f0577-e17e-3f41-8d08-eb0a3f529921",
                                "text": "Te penseras à mettre tes patinettes, je ne veux pas que te me rayes le parquet !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93cd500a-5214-4767-8d9e-a7b3e27f2e50",
                        "source_entry_id": "3762b90f-00ab-3905-b089-7d8c7c7c1637",
                        "source_sense_description": "Jouet d’enfant",
                        "target_lang_word": "Tretroller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
