                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e64a9400-2254-34d5-9572-4d2fe848f618",
                                        "entry_id": "4c608b44-1a58-32c6-9d87-8895edc470c5",
                                        "glosses": [
                                            "Overt, that is, disclosed."
                                        ],
