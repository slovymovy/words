                "senses": [
                    {
                        "sense_id": "5d97ebc1-071f-36fd-a089-0ebe22115998",
                        "entry_id": "ac1c8cab-8487-3c85-bf68-1150a3f334f7",
                        "glosses": [
                            "Lager, in dem Flüchtlinge, Vertriebene und Übersiedler zu Beginn ihres Aufenthaltes in der Bundesrepublik Deutschland vorübergehend betreut werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "293aa45a-a5e5-406f-9ffd-9a5520459105",
                                "sense_id": "5d97ebc1-071f-36fd-a089-0ebe22115998",
                                "text": "„Sie entschloss sich für die Aussiedlung und ein Güterzug brachte die Familie und andere Vertriebene ins Grenzdurchgangslager Friedland im südlichsten Zipfel Niedersachsens.“"
                            },
                            {
                                "example_id": "32c6ee9d-530c-4b5d-bd68-1814f4a317a0",
                                "sense_id": "5d97ebc1-071f-36fd-a089-0ebe22115998",
                                "text": "„Die meisten der ehemaligen deutschen Grenzdurchgangslager wurden 1945/46 in den damaligen militärischen Besatzungszonen Deutschlands eingerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
