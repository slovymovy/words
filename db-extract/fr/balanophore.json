                ],
                "senses": [
                    {
                        "sense_id": "5a228da0-ac21-32e7-9bbb-f870a31add8e",
                        "entry_id": "f6bacb53-0a6b-38ca-bda3-18aaf9ee71a7",
                        "glosses": [
                            "Genre de plantes charnues croissant en parasites sur les racines de certains arbres d’Asie et d’Océanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc0dccd-6d0f-47f2-8f25-6036a61140f9",
                                "sense_id": "5a228da0-ac21-32e7-9bbb-f870a31add8e",
                                "text": "Forster, qui a seul observé cette plante, n’a point vu son fruit ; il lui a donné le nom de Balanophore, c’est-à-dire porte-gland, d’après l’apparence du capitule de fleurs."
                            },
                            {
                                "example_id": "a3cbdf90-d490-46f1-be5c-2bfe362d6b06",
                                "sense_id": "5a228da0-ac21-32e7-9bbb-f870a31add8e",
                                "text": "Les balanophores sont des plantes de nature charnue, fongiformes, parasites, blanchâtres, croissant sur les racines des figuiers dans les îles de l’Asie tropicale, au moyen de leurs tubercules charnus et radicants ; …."
                            },
                            {
                                "example_id": "40038463-d55a-4ea7-8d17-65b704147cac",
                                "sense_id": "5a228da0-ac21-32e7-9bbb-f870a31add8e",
                                "text": "Souo-yang (Cynomorium coccineum L.) appartient à la famille des balanophoracées qui comprend le genre balanophore (parasites sur les racines de divers arbres de Chine)."
                            }
                        ]
                    }
