                "senses": [
                    {
                        "sense_id": "a5f0ebf2-21d3-362b-b36d-0f0688efae55",
                        "entry_id": "01c77bcc-2798-3f15-bbdb-82c4494ac6ac",
                        "glosses": [
                            "Teil einer größeren Einheit, der bewohnt wird/werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08cb1886-5e04-408e-a049-b3e66a622af2",
                                "sense_id": "a5f0ebf2-21d3-362b-b36d-0f0688efae55",
                                "text": "„Diesmal gehorchte Garlinda der Mutter und stieg in den Achterruff, den Wohnbereich des Schiffes.“"
                            },
                            {
                                "example_id": "94c54c7e-f6ee-405d-8e65-edda6359a3e8",
                                "sense_id": "a5f0ebf2-21d3-362b-b36d-0f0688efae55",
                                "text": "„Der doppelstöckige Wohnbereich und die Zentrale sind elastisch gelagert und aufgehängt, um Schallbrücken zum Druckkörper zu vermeiden und eine höhere Sicherheit bei Schockbelastung zu erreichen.“"
                            },
                            {
                                "example_id": "9e4cf70e-deb2-40fb-8e7c-d10a3bf07e0f",
                                "sense_id": "a5f0ebf2-21d3-362b-b36d-0f0688efae55",
                                "text": "Im Trend liegen jetzt große Glasflächen in der Hausfassade selbst, die eine Außenwand komplett transparent machen, einen Giebel von Kopf bis Fuß durchsichtig werden lassen oder dem Wohnbereich mit Galerie eine Lichtinsel verschaffen."
                            },
                            {
                                "example_id": "5aac7dfc-25e3-40dd-8704-fc495c97906a",
                                "sense_id": "a5f0ebf2-21d3-362b-b36d-0f0688efae55",
                                "text": "„Sie blieb mit ihren drei strotzend gesunden und leider auch lauten Jungen und der immer hüstelnden Christiana Auguste Henriette im unteren Wohnbereich zurück, während er auf der Himmelsleiter allmorgendlich hinaufstieg und die lästige Erdenschwere zurückließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
