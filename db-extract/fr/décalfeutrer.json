                ],
                "senses": [
                    {
                        "sense_id": "e1e53416-26fd-318f-a159-b493bdf0d1cf",
                        "entry_id": "b4c3dbec-c996-3601-b85d-7600e51c165f",
                        "glosses": [
                            "Enlever ce qui calfeutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e504f7-92c8-4d40-b7e0-b0bc5c2fd08d",
                                "sense_id": "e1e53416-26fd-318f-a159-b493bdf0d1cf",
                                "text": "C’est « décalfeutrer » une France confite dans des certitudes héritées des Trente Glorieuses."
                            },
                            {
                                "example_id": "5b6d56f4-706f-493b-9ad4-75adf8730fd9",
                                "sense_id": "e1e53416-26fd-318f-a159-b493bdf0d1cf",
                                "text": "Le vent de décembre, à moins que ce ne fût le souffle de l’Esprit, s’engouffrait par une fenêtre que l’on avait pris soin de décalfeutrer."
                            },
                            {
                                "example_id": "5a17dfc9-7226-4374-aa07-a483a9c41c3b",
                                "sense_id": "e1e53416-26fd-318f-a159-b493bdf0d1cf",
                                "text": "Il m’a refusé tantôt de se décalfeutrer."
                            }
                        ]
                    }
                ],
