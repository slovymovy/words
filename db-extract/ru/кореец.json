                                "target_senses": [
                                    {
                                        "sense_id": "605b89c8-9c15-32b1-a81a-11de59f555df",
                                        "entry_id": "4f7787f8-bef7-35cf-b245-5e6ceada8e58",
                                        "glosses": [
                                            "A native or resident in North Korea or South Korea, or a person of Korean descent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4320b9-9765-4b57-abac-8e7e26369293",
                                                "sense_id": "605b89c8-9c15-32b1-a81a-11de59f555df",
                                                "text": "The legacy of the Korean independence movement remains today: nearly two million ethnic Koreans live in China, half of them in the Yenpien Korean Autonomous District in southeast Manchuria."
                                            },
                                            {
                                                "example_id": "e56cd413-b02a-495a-a816-8dba54fa3f57",
                                                "sense_id": "605b89c8-9c15-32b1-a81a-11de59f555df",
                                                "text": "All Koreans to become one or even two years younger under int'l system"
                                            }
                                        ]
