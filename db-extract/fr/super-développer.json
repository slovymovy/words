                ],
                "senses": [
                    {
                        "sense_id": "c21a9a89-f518-3952-b9cf-0748abb9ba12",
                        "entry_id": "3e3481bd-9cce-3b70-b39e-e81229bd6d03",
                        "glosses": [
                            "Développer de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1c7bc4-6249-4b8a-95f8-450f91168f44",
                                "sense_id": "c21a9a89-f518-3952-b9cf-0748abb9ba12",
                                "text": "Et on retenait cette leçon : il fallait super-développer quelque chose en soi, et pas tellement au détriment du reste parce qu’il s’avérait rare qu’une première en ceci fût dernière en cela."
                            },
                            {
                                "example_id": "eaf26a52-f06e-42e6-9165-99d63cc04e06",
                                "sense_id": "c21a9a89-f518-3952-b9cf-0748abb9ba12",
                                "text": "Comment super-développer certaines qualités essentielles."
                            },
                            {
                                "example_id": "2ca9f5ca-5eb5-4876-b828-badd963f9032",
                                "sense_id": "c21a9a89-f518-3952-b9cf-0748abb9ba12",
                                "text": "D'habitude et toujours, nous écrivons sur le Bas-Congo, une province en R.D.Congo, qui, à notre avis, doit facilement se super-développer grâce à ses dispositions naturelles."
                            }
                        ]
                    }
