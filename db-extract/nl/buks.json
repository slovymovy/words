                "senses": [
                    {
                        "sense_id": "188ae91a-1292-38f3-9187-77d01218b6b5",
                        "entry_id": "6e7dba0f-6417-3802-b694-e0d3f4afa9c7",
                        "glosses": [
                            "zwaar soort geweer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8737eac6-cb90-48cf-9850-3ead717d4a37",
                                "sense_id": "188ae91a-1292-38f3-9187-77d01218b6b5",
                                "text": "In de schietsport wordt nog wel met buksen geschoten."
                            },
                            {
                                "example_id": "ebaf233b-d9f2-44e2-a0a8-7b7c56f14fa9",
                                "sense_id": "188ae91a-1292-38f3-9187-77d01218b6b5",
                                "text": "Van zijn spaargeld kocht hij een 6-mm buks en achter de stallen oefende hij eindeloos om scherp te leren schieten."
                            },
                            {
                                "example_id": "df94e985-1e81-4b09-ba08-ea2190622e54",
                                "sense_id": "188ae91a-1292-38f3-9187-77d01218b6b5",
                                "text": "Tijdens het feest nemen schutterijen het tegen elkaar op in marcheren, met muziek en het schieten met een lange buks op een houten vogel op een paal."
                            }
                        ]
                    }
