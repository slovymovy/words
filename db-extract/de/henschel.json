                ],
                "senses": [
                    {
                        "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                        "entry_id": "590443d5-e467-3df8-b050-46169980b24f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1a4867-bbf5-4db5-afb4-69a10376fcb9",
                                "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                                "text": "Frau Henschel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f949d94a-c6b5-4e0e-a3e6-9f06e0ab5cb8",
                                "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                                "text": "Herr Henschel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fb41d02c-92e3-4c63-b24d-d5cbfbbe9ad8",
                                "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                                "text": "Die Henschels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f347cdf7-2b61-49eb-a6c3-21048df412d6",
                                "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                                "text": "Der Henschel trägt nie die Schals, die die Henschel ihm strickt."
                            },
                            {
                                "example_id": "3ea64397-1f99-4822-8ee3-8efcaa83a616",
                                "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Henschel kommt, geht der Herr Henschel.“"
                            },
                            {
                                "example_id": "1b59277a-effe-411d-b7c9-b3984a1f54d2",
                                "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                                "text": "Henschel kommt und geht."
                            },
                            {
                                "example_id": "efc262e4-f5c9-4a87-a0b6-5b865e2e07e0",
                                "sense_id": "cbe8ee7b-4f8e-326d-9500-6759acaeea47",
                                "text": "Henschels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
