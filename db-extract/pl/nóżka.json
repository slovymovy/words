                                    {
                                        "sense_id": "17b23db2-e8f6-3951-9411-69de5926aa0a",
                                        "entry_id": "439b856c-1c6f-3410-8c4c-c1a5a54d29a1",
                                        "glosses": [
                                            "noha"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef7400c8-b803-346b-8fea-061de2ae7b1c",
                                        "entry_id": "439b856c-1c6f-3410-8c4c-c1a5a54d29a1",
                                        "glosses": [
                                            "párek, resp. polovina párku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a169ddc1-fbea-4126-8906-9e0f0aa9ca4f",
                                                "sense_id": "ef7400c8-b803-346b-8fea-061de2ae7b1c",
                                                "text": "Veřejnost rozděluje otázka, jestli „párek“ znamená dvě nožičky, což se jeví jako etymologicky průhledné, nebo jestli se tak dnes říká i – nebo pouze – jedné nožičce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f466441b-ff99-46d3-b0ad-4c668c198a36",
                        "source_entry_id": "eaf5f3e5-5917-3110-9b13-469d1659c93a",
                        "source_sense_id": "24d0a50f-b810-38bf-95d2-51ea21bac464",
                        "target_lang_word": "ножка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ножка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "уменьш.-ласк. к нога"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b425fa-0c48-4cbf-b13f-1627b0c53b7b",
                                                "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                                "text": "И по ковру скользит, плывет // Ее божественная ножка; // И улыбается она, // Веселья детского полна."
                                            },
                                            {
                                                "example_id": "4a182cbb-b858-40cc-a3ae-c49d4cd59f73",
                                                "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                                "text": "Чьей лёгкой ножки при реке // Следы остались на песке?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380c4b37-9999-39da-b67d-f042c22a5530",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "лапка насекомого"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19870c21-8075-3051-83b2-e5aa7ce2ecdd",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "опора, стойка (мебели, утвари); черенок бокала, рюмки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189c0c48-a9bb-4533-96a7-24a3dd0cad85",
                                                "sense_id": "19870c21-8075-3051-83b2-e5aa7ce2ecdd",
                                                "text": "Ножка дивана, стола, стула, самовара."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8c96afe-3600-38d4-918b-3c02f74a55cd",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "спец., уменьш. вывод радиодетали"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fdc4f0-94c3-48b3-a389-3f5fe89ae255",
                                                "sense_id": "c8c96afe-3600-38d4-918b-3c02f74a55cd",
                                                "text": "Для осуществления такой запитки припаивайте провод к 16-й ножке микросхемы и выводите его из корпуса разъёма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc683ae2-d013-3967-b10b-e9c41c1b74e5",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "биол. у гриба — нижняя часть, на которой сидит шляпка; стебель цветка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b000bf7e-4c87-4617-bab6-ad8447f6702a",
                                                "sense_id": "bc683ae2-d013-3967-b10b-e9c41c1b74e5",
                                                "text": "Не на стебле при дорожках // Неподвижно — одинок — // Нет, на двух летучих ножках.// Вьётся резвый тот цветок."
                                            }
                                        ]
                                    },
                                    {
