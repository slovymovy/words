                "senses": [
                    {
                        "sense_id": "05980ee9-79d1-37d9-8aac-c3c411646ad6",
                        "entry_id": "ef8da256-1668-393d-a204-90748c8ce087",
                        "glosses": [
                            "wielokąt mający cztery boki; do czworokątów należą m.in. trapezy, deltoidy, romby, kwadraty, prostokąty, równoległoboki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9bf177-60fe-4a80-8112-4dc0a238c7ec",
                                "sense_id": "05980ee9-79d1-37d9-8aac-c3c411646ad6",
                                "text": "W dowolnym czworokącie wpisanym w okrąg iloczyn długości przekątnych równy jest sumie iloczynów długości przeciwległych boków."
                            },
                            {
                                "example_id": "039cf36e-7e10-4504-b61f-a8123a354bea",
                                "sense_id": "05980ee9-79d1-37d9-8aac-c3c411646ad6",
                                "text": "Czworokąt z tak wpisanymi trójkątami jest obrazem kręgu ziemskiego we wszechświecie, dwunastu domów zodiaku, bóstw, które w nich mieszkają i całego bytu, treści wszystkich rzeczy, przeszłości, teraźniejszości i przyszłości."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
