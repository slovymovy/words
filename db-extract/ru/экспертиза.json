                    },
                    {
                        "translation_id": "f4eeb959-2538-4c15-ad70-cc1fd157d21d",
                        "source_entry_id": "b83e87c1-777c-33c4-8884-4b2e0f50a768",
                        "source_sense_description": "рассмотрение, исследование",
                        "target_lang_word": "Begutachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begutachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9dcefad-9a6c-3c77-86fc-b4d26742feee",
                                        "entry_id": "dadc496a-2934-3f1f-a13d-e00acb8d0a9f",
                                        "glosses": [
                                            "Abgabe einer fachmännischen Beurteilung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ceb3e6-65c1-469a-900c-e2248fdc8bae",
                                                "sense_id": "e9dcefad-9a6c-3c77-86fc-b4d26742feee",
                                                "text": "„Für die Wissenschaftler war die Antragstellung ein anspruchsvoller und harter Prozess mit mehrstufiger internationaler Begutachtung.“"
                                            },
                                            {
                                                "example_id": "bd2e5ac4-08b0-449c-9bd3-08c777b872cf",
                                                "sense_id": "e9dcefad-9a6c-3c77-86fc-b4d26742feee",
                                                "text": "„Neben einer persönlichen Begutachtung helfen der offizielle Mietspiegel der Stadt, Informationen von Vermieterverbänden und vergleichbare Mietgesuche und Immobilienanzeigen in Zeitungen und im Internet.“"
                                            },
                                            {
                                                "example_id": "76f1612c-feff-4afa-8eef-acfdfaef1e1f",
                                                "sense_id": "e9dcefad-9a6c-3c77-86fc-b4d26742feee",
                                                "text": "„Unsere Arbeitsaufteilung war jedenfalls klar: Ich würde mich um die Begutachtung und Schätzung der für uns relevanten Gegenstände kümmern und Amalia sich ums Verhandeln, Vergraulen der Konkurrenz und Knüpfen von Kontakten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "738d08b6-036d-3190-8590-1aa1dd023fb8",
                                        "entry_id": "dadc496a-2934-3f1f-a13d-e00acb8d0a9f",
                                        "glosses": [
                                            "Gutachten"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e91daf4-b206-4d7e-9720-60abc32a0e3f",
                        "source_entry_id": "b83e87c1-777c-33c4-8884-4b2e0f50a768",
                        "source_sense_description": "рассмотрение, исследование",
                        "target_lang_word": "Expertise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Expertise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5040782f-8163-32dc-8bd1-305a918c7400",
                                        "entry_id": "9eaf0340-58d7-30cf-8bba-afa39bb402cf",
                                        "glosses": [
                                            "Eigenschaften, Fähigkeiten oder Wissen, das eine Person zu einem Experten auf einem Gebiet macht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b89f8e1-21ed-41ed-8f4c-c85b64251ef1",
                                                "sense_id": "5040782f-8163-32dc-8bd1-305a918c7400",
                                                "text": "Nach der jahrelangen Ausbildung verfügt er über die nötige Expertise, um ein solches Vorhaben durchzuführen."
                                            },
                                            {
                                                "example_id": "15df3d45-4e58-4e29-81b1-a2d7cf953364",
                                                "sense_id": "5040782f-8163-32dc-8bd1-305a918c7400",
                                                "text": "„Zudem scheint die Expertise derer, die am meisten mit dem Thema befasst sind, nicht gefragt zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cc08cd2-5d6a-3046-8608-11416ba03919",
                                        "entry_id": "9eaf0340-58d7-30cf-8bba-afa39bb402cf",
                                        "glosses": [
                                            "(schriftliches) Gutachten eines Fachmanns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "444dae33-1b3f-4dcb-b55d-a1e161690637",
                                                "sense_id": "8cc08cd2-5d6a-3046-8608-11416ba03919",
                                                "text": "Eine Expertise kann nur ein vereidigter Sachverständiger erstellen."
                                            },
                                            {
                                                "example_id": "c4aabadb-aeb2-4902-8c23-5b4f171b9b38",
                                                "sense_id": "8cc08cd2-5d6a-3046-8608-11416ba03919",
                                                "text": "„Rudolf Schmengers Expertise in Steuerstrafsachen ist nach wie vor gefragt, wenn auch nicht gerade von der hessischen Landesregierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f29b6a4-704a-46fe-8b3c-6ff24609040d",
                        "source_entry_id": "b83e87c1-777c-33c4-8884-4b2e0f50a768",
