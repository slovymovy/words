                    {
                        "translation_id": "62c64fe7-bd32-4d45-b374-c6e6a5c505f2",
                        "source_entry_id": "ec74de6b-4cf0-3003-9ac1-8d29a3e0f20e",
                        "source_sense_id": "dffafad4-3d2c-3e4d-a757-81763671a508",
