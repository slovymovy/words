                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33ec73ea-1835-3a30-a214-df25d6cf3251",
                                        "entry_id": "c01d4411-54c2-34c3-9907-9cee4ece39fc",
                                        "glosses": [
                                            "A steepled platform upon which the three competitors with the best results may stand when being handed their medals or prize."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5937fad-a126-3e2b-b5ea-95c5de99946d",
                                        "entry_id": "c01d4411-54c2-34c3-9907-9cee4ece39fc",
                                        "glosses": [
                                            "A result amongst the best three at a competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1455f1e2-558b-4e80-8099-823c405c5bfe",
                                                "sense_id": "d5937fad-a126-3e2b-b5ea-95c5de99946d",
                                                "text": "Red Bull's Thai-British driver Alex Albon took a maiden podium in third."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c904b698-6771-3eaa-bcba-29940a230dc9",
                                        "entry_id": "c01d4411-54c2-34c3-9907-9cee4ece39fc",
                                        "glosses": [
                                            "A low wall, serving as a foundation, a substructure, or a terrace wall.",
                                            "The dwarf wall surrounding the arena of an amphitheatre, from the top of which the seats began."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
