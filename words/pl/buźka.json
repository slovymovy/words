{
    "word_family": [
        "buzia",
        "buziaczek",
        "buziak"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b876c0e2-ee77-3002-8b47-2d801d0d41dc",
                    "sense_definition": "zdrobnienie od słowa <w>buzia</w>; mała twarz, zwłaszcza dziecka",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "twarz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Małe dziecko miało umorusaną czekoladą <w>buźkę</w>, ale uśmiechało się radośnie.",
                            "target_lang_translations": {
                                "ru": "У маленького ребёнка было испачканное шоколадом <w>личико</w>, но он радостно улыбался."
                            }
                        },
                        {
                            "text": "Przemyj mu rano <w>buźkę</w> ciepłą wodą, żeby szybciej się obudził.",
                            "target_lang_translations": {
                                "ru": "Умой ему утром <w>мордашку</w> тёплой водой, чтобы он быстрее проснулся."
                            }
                        }
                    ],
                    "synonyms": [
                        "buziaczek",
                        "buzieczka"
                    ],
                    "common_phrases": [
                        "uśmiechnięta buźka",
                        "słodka buźka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "pieszczotliwe określenie twarzy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ласкательное к buzia; маленькое личико, мордашка (обычно ребёнка)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "личико",
                                "target_lang_sense_clarification": "маленькое, милое лицо (обычно ребёнка)"
                            },
                            {
                                "target_lang_word": "мордашка",
                                "target_lang_sense_clarification": "разговорное ласкательное обозначение лица"
                            },
                            {
                                "target_lang_word": "рожица",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c92c33ec-4637-3e8d-a46a-e617a4119bc0",
                    "sense_definition": "symbol graficzny przedstawiający twarz, wyrażający emocje w komunikacji elektronicznej; emotikon",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na końcu każdej wiadomości tekstowej dodawał wesołą <w>buźkę</w>.",
                            "target_lang_translations": {
                                "ru": "В конце каждого текстового сообщения он добавлял весёлый <w>смайлик</w>."
                            }
                        },
                        {
                            "text": "Wysłała mi żółtą <w>buźkę</w> z serduszkami zamiast oczu.",
                            "target_lang_translations": {
                                "ru": "Она прислала мне жёлтый <w>смайлик</w> с сердечками вместо глаз."
                            }
                        }
                    ],
                    "synonyms": [
                        "emotikon",
                        "emotikona",
                        "emoji"
                    ],
                    "common_phrases": [
                        "uśmiechnięta buźka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "popularne określenie emotikona"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "графический символ в виде лица, выражающий эмоции в электронных сообщениях; смайлик"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смайлик",
                                "target_lang_sense_clarification": "эмотикон, символ эмоции"
                            },
                            {
                                "target_lang_word": "эмодзи",
                                "target_lang_sense_clarification": "графический значок лица"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a2954cc3-4349-30c0-833f-6ab57a0f3f8a",
                    "sense_definition": "potoczne pożegnanie lub pozdrowienie kierowane do bliskiej osoby, oznaczające przesłanie pocałunku",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pozdrowienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę już kończyć rozmowę, do zobaczenia jutro i <w>buźka</w>!",
                            "target_lang_translations": {
                                "ru": "Мне уже пора заканчивать разговор, до завтра и <w>целую</w>!"
                            }
                        },
                        {
                            "text": "Dziękuję za miłe spotkanie, trzymaj się ciepło, pa, <w>buźka</w>!",
                            "target_lang_translations": {
                                "ru": "Спасибо за приятную встречу, береги себя, пока, <w>чмоки</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "całusy",
                        "buziaczki"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w nieformalnej komunikacji"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разговорное прощание или приветствие близкому человеку, выражающее воздушный поцелуй"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целую",
                                "target_lang_sense_clarification": "при прощании с близким человеком"
                            },
                            {
                                "target_lang_word": "чмоки",
                                "target_lang_sense_clarification": "разговорно-шутливое прощание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}