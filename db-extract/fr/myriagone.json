                                        "entry_id": "03c4a8f8-9046-33d7-a203-08f69782407f",
                                        "glosses": [
                                            "A polygon with 10,000 sides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5493f294-cc6c-462c-9622-b5bd93bc83ef",
                                                "sense_id": "8e59bfc9-5290-3c7c-9b18-ac8cb7ac259c",
                                                "text": "For it differs in no way from the representation I should form if I were thinking of a myriagon, or any figure with very many sides."
                                            }
                                        ]
