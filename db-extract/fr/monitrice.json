                "senses": [
                    {
                        "sense_id": "bf2c07b1-fa14-3ce2-bc93-d74e3999bba9",
                        "entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "glosses": [
                            "Celle qui est chargée de répéter, dans certains corps de troupes, dans certaines organisations sociales, etc., les leçons des officiers, des maîtres."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0d7a2b71-41e0-3d37-af5f-da566dc66437",
                        "entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "glosses": [
                            "Étudiante chargée d’enseigner sous forme de travaux dirigés, de cours pratiques sous l’autorité d’un ou d’une enseignante."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9bf73c8e-e1a3-305a-951e-bdb645d25ee2",
                        "entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "glosses": [
                            "Celle qui est chargée d’enseigner la pratique de certains sports."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8899d1c1-4076-3320-8b79-a0f9b4f8a8f8",
                        "entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "glosses": [
                            "Celle qui est chargée d’encadrer des enfants lors de pratiques extra-scolaires. Animatrice de centre de vacances, familièrement mono(s)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "37ffb46c-cb0a-3c3b-b7b1-3476b268f144",
                        "entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "glosses": [
                            "Celle qui enseigne une technique de loisir, une activité, la conduite dans une auto-école, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "dd7a4ca8-2c6a-4e42-aec9-d09b2210bd5c",
                                "sense_id": "37ffb46c-cb0a-3c3b-b7b1-3476b268f144",
                                "text": "Pour nombre de Saujonnais, Jeannette Grenon restera cette monitrice d’auto-école, connue pour sa grande gentillesse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff0b809c-40f0-4680-9f9d-6b19c0664997",
                        "source_entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "target_lang_word": "monitrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monitrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c929c33d-97dd-3d58-ba24-fde7c8e82e81",
                                        "entry_id": "268b1b7b-d7ea-3b23-8aff-89d4b5d06c29",
                                        "glosses": [
                                            "A female monitor; a monitress."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d17c381-48dc-4d77-946c-5fa2ecb04977",
                        "source_entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "target_lang_word": "monitress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monitress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "685268ea-8ce5-3a68-a7d4-f1961b912742",
                                        "entry_id": "a6812966-0fab-3c7c-a887-e4928f899eae",
                                        "glosses": [
                                            "A female mentor or advisor; a female observer."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f44f302-e2d8-4e04-ba2f-ddb61c1e4342",
                                                "sense_id": "685268ea-8ce5-3a68-a7d4-f1961b912742",
                                                "text": "Diana filled up all his heart: he felt as if by his union with her he had received a new and better soul. She was his monitress as he learned what were the true ends of life."
                                            },
                                            {
                                                "example_id": "713d16a5-59f3-405f-86de-6d85e51e9891",
                                                "sense_id": "685268ea-8ce5-3a68-a7d4-f1961b912742",
                                                "text": "Maisie could feel his monitress stiffen almost with anguish against the increase of his spell and then hurl herself as a desperate defence from it into the quite confessed poorness of violence, of iteration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4126c5-337f-388c-b7b7-128f9cad685c",
                                        "entry_id": "a6812966-0fab-3c7c-a887-e4928f899eae",
                                        "glosses": [
                                            "A female monitor, or school leader."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcc44821-1b3c-4bfa-877a-876efa04da20",
                                                "sense_id": "4b4126c5-337f-388c-b7b7-128f9cad685c",
                                                "text": "Miss Mitchell would certainly be most relieved to have a monitress who was capable of organising the juniors at games."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25039b87-6083-460d-a2a7-565e5c365d08",
                        "source_entry_id": "5730cb5b-7290-3016-a623-25e8f5fa0daa",
                        "target_lang_word": "monitor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "387def4c-f3b6-38df-b2cc-ea9460287ab6",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "Someone who watches over something; a person in charge of something or someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6681a425-f36f-4faf-84bb-e407a9d1c631",
                                                "sense_id": "387def4c-f3b6-38df-b2cc-ea9460287ab6",
                                                "text": "The camp monitors look after the children during the night, when the teachers are asleep."
                                            },
                                            {
                                                "example_id": "d04611ee-3674-4bc4-806e-94d8f5d77fa6",
                                                "sense_id": "387def4c-f3b6-38df-b2cc-ea9460287ab6",
                                                "text": "And oft, mild friend, to me thou art\nA monitor, though still;\nThou speak'st a lesson to my heart,\nBeyond the preacher's skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2add6537-234e-3c79-9bbc-328b550a5407",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A device that detects and informs on the presence, quantity, etc., of something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3b80d14-da0e-3e97-ad9d-be6151dfd010",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A device similar to a television set used as to give a graphical display of the output from a computer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae34032-16f1-4193-aa14-3fadebd399b9",
                                                "sense_id": "a3b80d14-da0e-3e97-ad9d-be6151dfd010",
                                                "text": "The information flashed up on the monitor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d376650-8689-37e6-8878-515223d476ca",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A studio monitor or loudspeaker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae6b0485-2523-352f-82e9-c911d6b73b55",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A program for viewing and editing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ccb8c9-fc1b-450f-aeda-9f9c07e0811c",
                                                "sense_id": "ae6b0485-2523-352f-82e9-c911d6b73b55",
                                                "text": "a machine code monitor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c54dfaba-b287-31f9-b8b6-d31cedd40271",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "The command line interface of an operating system."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a78db58e-5cc3-3c80-abae-87a4a2b9338e",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A student leader in a class."
                                        ],
                                        "tags": [
                                            "Hong-Kong",
                                            "Singapore",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cac326d2-e9ef-4193-8fc6-c15dd02fd574",
                                                "sense_id": "a78db58e-5cc3-3c80-abae-87a4a2b9338e",
                                                "text": "So, as she did not like the masters to be prying about the play-ground out of school, she chose from among the biggest and most trustworthy of her pupils five monitors, who had authority over the rest of the Boys, and kept the unruly ones in order."
                                            },
                                            {
                                                "example_id": "96e811fd-baa3-4aed-af05-fab3875f6d53",
                                                "sense_id": "a78db58e-5cc3-3c80-abae-87a4a2b9338e",
                                                "text": "But it was not so—at least, not always—for though they fell out among themselves, they united their forces against the common enemy—the monitors!"
                                            },
                                            {
                                                "example_id": "5dc612b3-379e-48b2-b8e8-d4b5fb469a16",
                                                "sense_id": "a78db58e-5cc3-3c80-abae-87a4a2b9338e",
                                                "text": "He learned that a monitor should assist the teachers in distributing worksheets, maintaining class discipline, helping classmates in need and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e141d555-776a-3105-8540-6ede8d9f5d6d",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A relatively small armored warship with only one or two turrets (but often carrying unusually large guns for a warship of its size), usually designed for shore bombardment or riverine warfare rather than open-ocean combat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09f2602f-4eeb-3770-89e5-350a9adcdfa5",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A monitor lizard (Varanus spp. and extinct relatives in family Varanidae)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "202b1d6f-2759-3b85-8bc1-0ce7f513d458",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A tool holder, as for a lathe, shaped like a low turret, and capable of being revolved on a vertical pivot so as to bring several tools successively into position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1bac08b7-9c71-367a-aba6-c097610e8a79",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "A monitor nozzle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f803d68-cf18-3dfa-afa6-f85ff8250643",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "One who admonishes; one who warns of faults, informs of duty, or gives advice and instruction by way of reproof or caution."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f78ec092-8168-4457-b14d-c05029673d12",
                                                "sense_id": "0f803d68-cf18-3dfa-afa6-f85ff8250643",
                                                "text": "c. 1620, Francis Bacon, letter of advice to Sir George Villiers\nYou need not be a monitor to your gracious master the king."
                                            },
                                            {
                                                "example_id": "9fb4502a-a68a-458b-9a36-34e52cdafe03",
                                                "sense_id": "0f803d68-cf18-3dfa-afa6-f85ff8250643",
                                                "text": "There has been no lack of other monitors — a ticklish haysel, a flooded harvest all through the north […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e68c3a-1b00-3351-8f7d-a83f71231286",
                                        "entry_id": "ebea630f-323c-333e-acb0-d348ccac9cd1",
                                        "glosses": [
                                            "An ironclad."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "monitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "506565b8-af04-33b8-842d-44f78b229b10",
                                        "entry_id": "310d0a84-b855-3b17-a31a-0aec6201cdf0",
                                        "glosses": [
                                            "To watch over; to guard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94bc0995-519e-45da-862f-bb903be698a6",
                                                "sense_id": "506565b8-af04-33b8-842d-44f78b229b10",
                                                "text": "Monitoring refers to keeping a watch over patients to ensure that they are practising what they have learnt about disability prevention correctly."
                                            },
                                            {
                                                "example_id": "e1f60c17-edef-477d-a2cf-d627f5f47ede",
                                                "sense_id": "506565b8-af04-33b8-842d-44f78b229b10",
                                                "text": "During July 1989-February 1990 ambient SO₂, was monitored using a mobile station in the residential-commercial neighborhood of Copacabana."
                                            },
                                            {
                                                "example_id": "331062f7-1d06-4309-9bbc-73b5a60c2cb0",
                                                "sense_id": "506565b8-af04-33b8-842d-44f78b229b10",
                                                "text": "2002, Mark Baker, Garry Smith, GridRM: A Resource Monitoring Architecture for the Grid, in Manish Parashar (editor), Grid Computing - GRID 2002: Third International Workshop, Springer, LNCS 2536, page 268,\nA wide-area distributed system such as a Grid requires that a broad range of data be monitored and collected for a variety of tasks such as fault detection and performance monitoring, analysis, prediction and tuning."
                                            },
                                            {
                                                "example_id": "281d2aa6-b113-4d1e-b1c1-b8b25debafb8",
                                                "sense_id": "506565b8-af04-33b8-842d-44f78b229b10",
                                                "text": "The NOAA monitors global temperatures and records on a monthly and an annual basis, not daily. […] Various parts of the world have been experiencing heatwaves and on Thursday the EU’s climate monitoring service said the world had experienced its hottest June on record last month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
