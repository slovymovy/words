                            {
                                "target_word": "panic attack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81937102-3eee-328d-bfc2-6ab443a09731",
                                        "entry_id": "ed5a213e-0ca8-3cb6-af12-3332d7a689a8",
                                        "glosses": [
                                            "A sudden period of intense anxiety, mounting physiological arousal, fear, stomach problems and discomfort that are associated with a variety of somatic and cognitive symptoms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e4b13ab-6828-45f8-8a49-9117bd02cef1",
                                                "sense_id": "81937102-3eee-328d-bfc2-6ab443a09731",
                                                "text": "There was a client who was critical of me a few weeks back and it set off a panic attack."
                                            },
                                            {
                                                "example_id": "9c478271-87e5-43fc-a3b3-f1ecccbdae66",
                                                "sense_id": "81937102-3eee-328d-bfc2-6ab443a09731",
                                                "text": "I think I had a panic attack last night, a sense of rising panic and impending doom – chest tight, short of breath, shaking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
