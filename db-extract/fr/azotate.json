                "forms": [
                    {
                        "form_id": "f3befff2-22d6-40ca-8af2-8c018c3390fb",
                        "entry_id": "693a7658-f53d-398a-a8f0-6024e8037dc7",
                        "tags": [
                            "plural"
                        ],
                        "form": "azotates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4896bdfc-c775-3128-a018-ca40375f3c53",
                        "entry_id": "693a7658-f53d-398a-a8f0-6024e8037dc7",
                        "glosses": [
                            "Combinaison de l’acide azotique (ou acide nitrique) avec une base."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3e324697-8240-4345-8dc1-a021bc053a55",
                                "sense_id": "4896bdfc-c775-3128-a018-ca40375f3c53",
                                "text": "Avec sa végétation exubérante de tiges et de feuilles, elle épuise fortement le sol: elle exige de bonnes fumures, et parmi les engrais chimiques réclame surtout l’azotate de soude, le chlorure de sodium et la chaux."
                            },
                            {
                                "example_id": "7176dc36-5efe-4c3e-9da9-f6e4de9c5ecc",
                                "sense_id": "4896bdfc-c775-3128-a018-ca40375f3c53",
                                "text": "[…]; l’acide azotique agissant sur les produits secs les colore en jaune, l’azotate mercurique les colore en rouge à chaud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1891eab9-5ecc-42dc-a392-7e17446d9d53",
                        "source_entry_id": "693a7658-f53d-398a-a8f0-6024e8037dc7",
                        "source_sense_id": "4896bdfc-c775-3128-a018-ca40375f3c53",
                        "target_lang_word": "nitrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2f82002-bb96-3ab9-ad43-e43f2dc42a13",
                                        "entry_id": "a4468d5d-495a-37ab-a38b-43f4113688b0",
                                        "glosses": [
                                            "Any salt or ester of nitric acid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926f0b92-4cfa-4443-a94b-a3baecc906c3",
                                                "sense_id": "c2f82002-bb96-3ab9-ad43-e43f2dc42a13",
                                                "text": "Nitrates are most commonly used in fertilizers, especially sodium and potassium nitrates. Numerous water wells have had to be abandoned because of the lack of a way to deal with the problem."
                                            },
                                            {
                                                "example_id": "f09daecd-240b-4016-8932-cbe2a0d784ab",
                                                "sense_id": "c2f82002-bb96-3ab9-ad43-e43f2dc42a13",
                                                "text": "The underground water which feeds Britain's springs and rivers and provides a third of its drinking water is becoming seriously polluted with nitrates, causing a threat to wildlife and landing consumers with a big purification bill."
                                            },
                                            {
                                                "example_id": "ba0d8b89-ba9d-4066-ab37-89e2c147d88a",
                                                "sense_id": "c2f82002-bb96-3ab9-ad43-e43f2dc42a13",
                                                "text": "The pinkness of bacon – or cooked ham, or salami – is a sign that it has been treated with chemicals, more specifically with nitrates and nitrites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nitrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80672084-3711-3734-88f9-568620b54387",
                                        "entry_id": "c9dcc0cb-cc91-3374-8dac-3409df291006",
                                        "glosses": [
                                            "To treat, or react, with nitric acid or a nitrate"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
