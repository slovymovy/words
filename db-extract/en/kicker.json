                    },
                    {
                        "sense_id": "e9c084cd-ee61-3da2-bd19-a96f2867adec",
                        "entry_id": "b1ae4c3a-663f-3236-a695-bf86a4ed1c0d",
                        "glosses": [
                            "Small text above a headline that indicates the topic of the story."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69563815-01a2-4130-a1f6-f8b3fa2d9b62",
                                "sense_id": "e9c084cd-ee61-3da2-bd19-a96f2867adec",
                                "text": "Hammers are, in essence, reverse kickers. Instead of being set in smaller type like kickers, hammers are set in larger type than headlines."
