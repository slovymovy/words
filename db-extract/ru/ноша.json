                "translations": [
                    {
                        "translation_id": "8946539a-0bf2-4918-8a23-cc92abf975df",
                        "source_entry_id": "b0e358ff-5bd7-3529-b8eb-840195e84343",
                        "source_sense_id": "e9a8c637-2635-37e1-8e95-2f59ad2364a4",
                        "target_lang_word": "burden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be8404f-3454-33be-afdc-154dfcf97469",
                                        "entry_id": "f77d0007-9e49-3b66-8d71-07d02a096396",
                                        "glosses": [
                                            "A heavy load."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4aca14f-56e6-45a2-8cfc-7438624648e6",
                                                "sense_id": "7be8404f-3454-33be-afdc-154dfcf97469",
                                                "text": "I know that this was Life,—the track\n⁠Whereon with equal feet we fared;\n⁠And then, as now, the day prepared\nThe daily burden for the back."
                                            },
                                            {
                                                "example_id": "e03243d7-2aeb-4db3-8f39-9fa91285ec32",
                                                "sense_id": "7be8404f-3454-33be-afdc-154dfcf97469",
                                                "text": "There were four or five men in the vault already, and I could hear more coming down the passage, and guessed from their heavy footsteps that they were carrying burdens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5579cbbb-27bc-3702-a8c2-b250942fa477",
                                        "entry_id": "f77d0007-9e49-3b66-8d71-07d02a096396",
                                        "glosses": [
                                            "A responsibility, onus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cea3381-6f52-3d40-bd86-a25ff96dc533",
                                        "entry_id": "f77d0007-9e49-3b66-8d71-07d02a096396",
                                        "glosses": [
                                            "A cause of worry; that which is grievous, wearisome, or oppressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bfa97d0-de05-4976-a90d-80780709d73c",
                                                "sense_id": "9cea3381-6f52-3d40-bd86-a25ff96dc533",
                                                "text": "c. 1710-1730, Jonathan Swift, The Dean's Complaint Translated and Answered\nDeaf, giddy, helpless, left alone, / To all my friends a burden grown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13fe85f4-08f9-3e2f-b4df-72c0d3f3c476",
                                        "entry_id": "f77d0007-9e49-3b66-8d71-07d02a096396",
                                        "glosses": [
                                            "The capacity of a vessel, or the weight of cargo that she will carry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501ce507-6e3e-48d1-996f-0a894e1c39e5",
                                                "sense_id": "13fe85f4-08f9-3e2f-b4df-72c0d3f3c476",
                                                "text": "a ship of a hundred tons burden"
                                            },
                                            {
                                                "example_id": "9825b9f0-f217-4102-bb11-cf4c9546e78d",
                                                "sense_id": "13fe85f4-08f9-3e2f-b4df-72c0d3f3c476",
                                                "text": "\"[…] The quay is upwards of 1,000 feet in length, and capable of accommodating more than 100 sail of traders; and there are generally a considerable number of vessels of from 40 to 300 tons burden, from various parts of the world, waiting to receive their cargoes.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dceee75-6ddd-39f4-940d-1cbd5e819e43",
                                        "entry_id": "f77d0007-9e49-3b66-8d71-07d02a096396",
                                        "glosses": [
                                            "The tops or heads of stream-work which lie over the stream of tin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c672c6cb-a546-35cc-9e27-c1051b19cfee",
                                        "entry_id": "f77d0007-9e49-3b66-8d71-07d02a096396",
                                        "glosses": [
                                            "The proportion of ore and flux to fuel, in the charge of a blast furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a6479e8-2f44-3446-8d00-4934c7beebdf",
                                        "entry_id": "f77d0007-9e49-3b66-8d71-07d02a096396",
                                        "glosses": [
                                            "A fixed quantity of certain commodities."
                                        ],
