                ],
                "senses": [
                    {
                        "sense_id": "8e3a7c7c-34e1-3a41-9c7f-f2dc55b419fa",
                        "entry_id": "ccbe7c47-2eee-34ac-b98b-3d42112408e2",
                        "glosses": [
                            "Angehöriger einer jüdischen Gruppierung aus dem 2. – 1. Jahrhundert vor Christus, welcher die baldige Ankunft des Messias erwartete"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "be34e276-9ff3-4fea-b46a-8b70fb7ee5cf",
                                "sense_id": "8e3a7c7c-34e1-3a41-9c7f-f2dc55b419fa",
                                "text": "„Dort, wo Johannes predigte und taufte, zum Beispiel am Toten Meer, war auch der Orden der Essener zuhause, Menschen die den Idealen der Armut und Askese folgten, um sich auf die baldige Ankunft eines Messias vorzubereiten.“"
                            },
                            {
                                "example_id": "d3f0a26e-194f-47cc-8dc4-7d54bdab27e5",
                                "sense_id": "8e3a7c7c-34e1-3a41-9c7f-f2dc55b419fa",
                                "text": "„Asketisch orientiert waren auch die Essener, eine Gruppe frommer Juden, die auf persönlichen Besitz verzichteten und ein einfaches, genügsames Leben mit Gütergemeinschaft führten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
