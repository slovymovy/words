                "senses": [
                    {
                        "sense_id": "d8b148db-3460-366a-8545-098687d85d9e",
                        "entry_id": "007b8031-f641-3f41-b5e3-874e4fef7b6e",
                        "glosses": [
                            "Angehöriger eines im Alten Testament erwähnten räuberischen Nomadenvolks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7155d455-0e29-4670-9be1-c80ce2c740ac",
                                "sense_id": "d8b148db-3460-366a-8545-098687d85d9e",
                                "text": "„Andere befürworteten terroristische Gegengewalt. Unter Berufung auf die Bibel vertraten sie die Auffassung, die traditionelle jüdische Ethik rechtfertige Rache durchaus. Schließlich stünde geschrieben, dass den Israeliten befohlen wurde, ihre Feinde, die Amalekiter, auszulöschen, obwohl es sicherlich auch unter ihnen Unschuldige gegeben habe.“"
                            },
                            {
                                "example_id": "f5167c45-69d4-489d-8401-71494cb86906",
                                "sense_id": "d8b148db-3460-366a-8545-098687d85d9e",
                                "text": "„Für mich sind dieser Rabbi und seine Freunde herzlose religiöse Eiferer, die einen anderen Gott anbeten und sich zu einem rassistischen jüdischen Glauben bekennen. Meiner Ansicht nach sind sie beschnittene Amalekiter, denen wir Einhalt gebieten müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
