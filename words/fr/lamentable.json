                },
                {
                    "sense_id": "d965c19f-5fe4-3e94-8ce0-d4baaa0c720f",
                    "sense_definition": "Qui tient de la lamentation, qui exprime la douleur ou le gémissement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé poussait des cris <w>lamentables</w> en attendant l'arrivée des secours."
                        },
                        {
                            "text": "Elle a prononcé ces quelques mots d'une voix <w>lamentable</w> qui a ému l'assemblée."
                        }
                    ],
                    "common_phrases": [
                        "cris lamentables"
                    ]
                }
            ]
        },
