                                                "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                                "text": "Sie bilden eine untrennbare Einheit."
                                            },
                                            {
                                                "example_id": "74e8808e-275e-4f27-bbad-886c644b56b7",
                                                "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                                "text": "„Gegen Ende des 19. Jahrhunderts war die Degenerationslehre in Westeuropa (und teilweise in Nordamerika) untrennbar verknüpft mit dem Sozialdarwinismus.“"
                                            }
                                        ],
