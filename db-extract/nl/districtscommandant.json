                        "examples": [
                            {
                                "example_id": "a01f5707-64ae-4f8d-b398-1bbc6837374b",
                                "sense_id": "22915e8f-b172-3f32-bf60-71b18c97bc3a",
                                "text": "Louis Bontes, die 57 is, werkte eerder geruime tijd bij de politie in Rotterdam, onder andere als districtscommandant in de haven. In 2009 kwam hij voor de PVV in het Europees Parlement, een jaar later stapte hij over naar de Tweede Kamer. Hij hield zich daar onder meer bezig met politie en terrorismebestrijding."
                            },
                            {
                                "example_id": "fd0b028c-3b06-49e7-ae94-6358d475273f",
                                "sense_id": "22915e8f-b172-3f32-bf60-71b18c97bc3a",
                                "text": "Bontes begon als politieagent in de oude wijken van Rotterdam. Hij werkte zich op tot Districtscommandant Haven in de Veiligheidsregio Rotterdam-Rijnmond. Eerder was hij onder meer medewerker en voorman op scheepswerven in het Rijnmondgebied."
                            }
                        ]
                    }
