                                "sense_id": "40014112-f40d-3fab-8520-0f42b161352f",
                                "text": "Other teaers […]"
                            },
                            {
                                "example_id": "5d460475-5b18-42c6-8d13-4e178b8ffcbb",
                                "sense_id": "40014112-f40d-3fab-8520-0f42b161352f",
                                "text": "That the memory of Dr. Johnson and tea may not perish from the earth forever, some members of the Boswell Club of Chicago formed a group known as \"THE JOHNSONIAN TEAERS\"."
                            },
                            {
                                "example_id": "5b369bac-7d0c-4685-9c22-98fbb771dfd9",
                                "sense_id": "40014112-f40d-3fab-8520-0f42b161352f",
                                "text": "You can often divide a roomful of people into coffee- and tea-drinkers. Some people are coffee potty, while others are total-teaers."
                            }
                        ]
