                        "examples": [
                            {
                                "example_id": "a5f26efb-9824-4c99-90af-333cd2c5f348",
                                "sense_id": "95df9dfd-bf8c-33ea-85e6-c172e54274c1",
                                "text": "Het is de bedoeling dat het een paar weken werkt in zijn medische uitwerking, maar de keren dat ik het gebruikt heb duurde het maanden voordat het psychische effect was weggeëbd. Voortdurend had ik het gevoel dat ik van alles moest. Gepresseerd, zoals dat heet. De hele tijd. Je omgeving wordt gek van je en zou je het liefst een kurk in je smoel duwen."
                            },
                            {
                                "example_id": "85ef1f84-017f-4317-b4bc-0031f734160c",
                                "sense_id": "95df9dfd-bf8c-33ea-85e6-c172e54274c1",
                                "text": "Niemand van de circa 100 bewoners heeft hier haast. Ik denk dat een verpleegtehuis dé plek is voor ultieme onthaasting. Van bovenstaande handelingen maak je hier alleen het vallen, opstaan en doorgaan mee, al dan niet met een gebroken heup. Niemand is hier gepresseerd."
                            }
                        ]
                    }
