                "translations": [
                    {
                        "translation_id": "5e901b94-98d5-4af8-b99f-befbd2426416",
                        "source_entry_id": "0ed15837-da00-3ede-a254-c1c70c61e3c5",
                        "source_sense_id": "31ceae41-24e5-3447-b36e-0bd54834b265",
                        "target_lang_word": "anemograph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anemograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4fae965-9e93-3d96-a717-8e4fb07c0a2d",
                                        "entry_id": "f581345b-c476-3b3d-a577-2984cd8894ed",
                                        "glosses": [
                                            "An anemometer that makes a graphical recording."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0ab4e76-9385-4bf5-b667-93d4c0a55a37",
                                                "sense_id": "e4fae965-9e93-3d96-a717-8e4fb07c0a2d",
                                                "text": "Other examples of the application of electricity, are the Anemograph of Dumoncel, an instrument for measuring the direction, elevation, and force of the winds; a heat regulator for hot-houses and drying chambers; and a system of electric communication between railroad trains."
                                            },
                                            {
                                                "example_id": "6445c708-e863-434d-a5fe-7f9fdf43803d",
                                                "sense_id": "e4fae965-9e93-3d96-a717-8e4fb07c0a2d",
                                                "text": "Two days later, Madigan's anemograph recorded winds of 100 miles per hour for the first time."
                                            },
                                            {
                                                "example_id": "4ab60392-a5ae-474e-9183-fcb7dd91b3b6",
                                                "sense_id": "e4fae965-9e93-3d96-a717-8e4fb07c0a2d",
                                                "text": "Almost as bad was the status of the wind data: of his six meteorographs, only one (\"Hergesell 104\") had a working anemometer, and that instrument lasted only five flights in summer 1907 before it was lost when a cable parted; it functioned principally to help him calibrate his procedure for estimating wind velocity aloft without an anemograph."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d983517a-8443-425f-b61b-7582b6dbd68a",
                        "source_entry_id": "0ed15837-da00-3ede-a254-c1c70c61e3c5",
                        "source_sense_id": "31ceae41-24e5-3447-b36e-0bd54834b265",
                        "target_lang_word": "anémographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anémographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff05add-d48a-3bd4-9915-a2addcabcdb5",
                                        "entry_id": "8ce1ce3d-b7b8-3819-a72e-7aeb46f843bb",
                                        "glosses": [
                                            "Instrument qui indique la marche des vents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f283bbb9-af5a-4e62-9a67-136bb290c260",
                                                "sense_id": "4ff05add-d48a-3bd4-9915-a2addcabcdb5",
                                                "text": "Cet anémographe spectral [de M. de Parville] nous semble avantageux, en ce que l’opérateur peut conserver la trace du vent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
