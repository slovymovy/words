                                    {
                                        "sense_id": "e26855ec-8dc2-3cfe-90b5-5577bee5ace3",
                                        "entry_id": "d9a9a43b-bc48-304b-aa79-8c05b4059740",
                                        "glosses": [
                                            "A collection containing a variety of miscellaneous things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb59be4-2342-48a3-9a70-2c18f135f051",
                                                "sense_id": "e26855ec-8dc2-3cfe-90b5-5577bee5ace3",
                                                "text": "As for Mr. Pynchon’s conjuring of millennial New York, it’s a total mishmash."
                                            },
                                            {
                                                "example_id": "f11ab628-e256-4dce-baec-029ceb71e8f8",
                                                "sense_id": "e26855ec-8dc2-3cfe-90b5-5577bee5ace3",
                                                "text": "He cites 'on-seat charging facilities', which he describes as pregviously^([sic]) being a \"mishmash of some having them and not having them\"."
                                            }
                                        ]
                                    }
                                ]
