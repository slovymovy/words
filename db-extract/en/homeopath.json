                        "examples": [
                            {
                                "example_id": "8a9fbfad-d28d-435f-bc35-f22b6d7652b1",
                                "sense_id": "fdd5342f-5817-3db8-ac82-8efc6621431c",
                                "text": "Amanda works as a child play therapist, treating children with mental health issues and Annie is a homeopath.",
                                "translation": "Amanda travaille en tant que thérapeute de jeu pour enfants, traitant des enfants atteints de troubles mentaux et Annie est une homéopathe."
                            },
                            {
                                "example_id": "79ce853f-b779-4175-a23f-9a187625d3b6",
                                "sense_id": "fdd5342f-5817-3db8-ac82-8efc6621431c",
                                "text": "Homeopaths based their system on lengthy diagnoses of symptoms and highly diluted substances, claiming these trigger bodily and psychological healing.",
                                "translation": "Les homéopathes ont basé leur système sur de longs diagnostiques des symptomes et des substances fortement diluées, assurant qu’elles déclenchent une guérison corporelle et physiologique."
                            }
                        ]
                    }
