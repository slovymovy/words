                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bcac4a2-1ffd-4da7-99e1-e133c09f1a0b",
                                                "sense_id": "ca8b01c9-4020-3b5a-85df-8ca809f750ee",
                                                "text": "Die Immigration ist in vielen Ländern ein großes Problem."
                                            }
                                        ],
