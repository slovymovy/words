                                "target_senses": [
                                    {
                                        "sense_id": "4db94d56-5e7f-34ed-afde-97154ecdf7b2",
                                        "entry_id": "3bf873fb-0aec-33c8-a415-c224927f63b3",
                                        "glosses": [
                                            "Agent noun of pick; one who picks."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc69d119-57b0-48b2-8533-015c6cac085e",
                                                "sense_id": "4db94d56-5e7f-34ed-afde-97154ecdf7b2",
                                                "text": "The apple picker climbed the tree."
                                            },
                                            {
                                                "example_id": "2a917b62-dff5-4b93-bbeb-1628523da722",
                                                "sense_id": "4db94d56-5e7f-34ed-afde-97154ecdf7b2",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            },
                                            {
                                                "example_id": "1b9c5c79-4cf1-4bf3-a3a0-b6ea5b548c07",
                                                "sense_id": "4db94d56-5e7f-34ed-afde-97154ecdf7b2",
                                                "text": "I have observed that there are only two types of eaters in this world - pickers and wolfers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0e23919-7998-3dfa-8c94-3fb070134710",
                                        "entry_id": "3bf873fb-0aec-33c8-a415-c224927f63b3",
                                        "glosses": [
                                            "Agent noun of pick; one who picks.",
                                            "A worker responsible for picking or retrieving ordered items, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e30e2c09-e320-45c2-a3b0-0db245b8014c",
                                                "sense_id": "e0e23919-7998-3dfa-8c94-3fb070134710",
                                                "text": "Already at Amazon warehouses, ‘pickers’—the workers who locate purchased items and transport them to the shipping station within the warehouse—are issued a hand-held device that tracks their every move."
                                            },
                                            {
                                                "example_id": "a76f1bdc-e5f5-45ab-92eb-c82bf714250e",
                                                "sense_id": "e0e23919-7998-3dfa-8c94-3fb070134710",
                                                "text": "\"Farmers can't get sufficient fruit pickers,\" he said. \"It is the same pool of labour, agency staff [who are] largely eastern European [and] a huge number of them Polish.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a72590d-6b9e-330c-837e-f0cfe74f1c1e",
                                        "entry_id": "3bf873fb-0aec-33c8-a415-c224927f63b3",
                                        "glosses": [
                                            "Any user interface control that selects something."
                                        ],
                                        "tags": [],
                                        "examples": [
