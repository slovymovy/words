                                "target_senses": [
                                    {
                                        "sense_id": "e4ebb77d-4292-30f2-a3f8-ee39c308e6f2",
                                        "entry_id": "16f42025-88b0-31aa-9d64-d82fc4cd92f0",
                                        "glosses": [
                                            "To strike (a ship) with one or more torpedoes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e8fb58a-53ec-3639-a8a1-ad51a779797a",
                                        "entry_id": "16f42025-88b0-31aa-9d64-d82fc4cd92f0",
                                        "glosses": [
                                            "To sink (a ship) with one or more torpedoes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93d6d4d2-dadc-4d9d-b0b5-0edec0832a14",
                                                "sense_id": "8e8fb58a-53ec-3639-a8a1-ad51a779797a",
                                                "text": "The anti-German riots which erupted simultaneously in many countries in response to the torpedoing of the Lusitania by a German U-boat in 1915 reflected shifts in the status of minorities in multi-ethnic societies at a time of escalating nationalist emotions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec757931-df3e-357e-9cf8-5de051b776b3",
                                        "entry_id": "16f42025-88b0-31aa-9d64-d82fc4cd92f0",
                                        "glosses": [
                                            "To undermine or destroy any endeavor with a powerful attack."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "528f5d42-7f97-4a45-98a6-069eb45ba44d",
                                                "sense_id": "ec757931-df3e-357e-9cf8-5de051b776b3",
                                                "text": "The left-back had been a selection concern because of an injury niggle but his first goal since last March swung this derby decisively in United’s favour, extending their club record unbeaten run away from home in the Premier League to 22 games and torpedoing City’s sequence of 21 straight wins in all competitions."
                                            },
                                            {
                                                "example_id": "d04abb05-4ccc-4011-b785-adc6d36a4e6b",
                                                "sense_id": "ec757931-df3e-357e-9cf8-5de051b776b3",
                                                "text": "The Toronto-based company[…] promised a certain fantasy, particularly aimed at men: a list of women ready and willing to have an affair; a secret good time outside the bounds of one’s partnership; self-proclaimed extensive security measures to prevent torpedoing one’s domestic life."
                                            },
                                            {
                                                "example_id": "59845d60-2252-429f-b029-d3ba79d6b0a9",
                                                "sense_id": "ec757931-df3e-357e-9cf8-5de051b776b3",
                                                "text": "The decision (5-4) by the nine-member bench has torpedoed Srettha’s troubled government, which has failed to gain support in parliament and among the Thai public."
                                            },
                                            {
                                                "example_id": "3617c55e-a4c0-44cf-a87c-a1d3ef6c3257",
                                                "sense_id": "ec757931-df3e-357e-9cf8-5de051b776b3",
                                                "text": "“It was really like a festering sore for quite some time,” said Michael Kugelman, director of the South Asia Institute at the Wilson Center in Washington, DC, who said the disagreement over Khalistan “has really torpedoed the relationship.”"
                                            }
                                        ]
                                    }
                                ]
