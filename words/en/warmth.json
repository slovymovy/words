                            },
                            {
                                "target_lang_word": "calidez",
                                "target_lang_sense_clarification": "sensación agradable de temperatura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee6a3841-b827-3e03-9463-99aba2c3a462",
                    "sense_definition": "Friendliness, kindness, or affection.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was greeted with great <w>warmth</w> by his old friends at the airport.",
                            "target_lang_translations": {
                                "ru": "Старые друзья встретили его в аэропорту с большой <w>теплотой</w>.",
                                "zh": "他在机场受到了老朋友们非常<w>热情</w>的迎接。",
                                "es": "Fue recibido con gran <w>calidez</w> por sus viejos amigos en el aeropuerto."
                            }
                        },
                        {
                            "text": "Her smile was full of <w>warmth</w> and understanding.",
                            "target_lang_translations": {
                                "ru": "Её улыбка была полна <w>тепла</w> и понимания.",
                                "zh": "她的笑容里充满了<w>亲切</w>与理解。",
                                "es": "Su sonrisa estaba llena de <w>calidez</w> y comprensión."
                            }
                        }
                    ],
                    "synonyms": [
                        "friendliness",
                        "kindness",
                        "affection",
                        "cordiality"
                    ],
                    "antonyms": [
                        "coldness",
                        "hostility",
                        "indifference"
                    ],
                    "common_phrases": [
