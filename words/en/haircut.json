                                "target_lang_word": "урезать",
                                "target_lang_sense_clarification": "стоимость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减记",
                                "target_lang_sense_clarification": "降低资产估值"
                            },
                            {
                                "target_lang_word": "折价",
                                "target_lang_sense_clarification": "对资产进行折价处理"
                            }
                        ]
                    }
                }
            ]
        }
    ]
