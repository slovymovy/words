                        ]
                    },
                    {
                        "sense_id": "f1782ec7-185b-3484-9631-e49a7a4df6c7",
                        "entry_id": "457b40f9-e68b-385a-b134-1f257e83b392",
                        "glosses": [
                            "Fleuve et vallée de Colombie."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "aeec94de-3a48-4ee0-b3e0-0531b05becc6",
                                "sense_id": "f1782ec7-185b-3484-9631-e49a7a4df6c7",
                                "text": "Le rio Patia est un des fleuves les plus étranges et les plus pittoresques du monde. Il sort des flancs du volcan de Sotarà, dans la Cordillère centrale, et se précipite d’une roche escarpée, dès son origine, sous la forme d’une élégante cascade."
                            }
                        ]
                    }
