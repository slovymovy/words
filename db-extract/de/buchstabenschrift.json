                        "form": "die Buchstabenschriften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e047ae08-6d00-30b5-90ae-db98081dfe09",
                        "entry_id": "858e92c5-4161-3a2f-9425-32f7a93eb0b6",
                        "glosses": [
                            "Schrift, deren einzelne Schriftzeichen aus den Buchstaben eines Alphabets bestehen und die Laute der Wörter mehr oder weniger genau wiedergeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb5542e-8b15-444d-bbc0-b3c6501f8999",
                                "sense_id": "e047ae08-6d00-30b5-90ae-db98081dfe09",
                                "text": "„Ein anderes Beispiel ist die tibetische Buchstabenschrift, die aus der indischen Davanagari-Schrift entwickelt wurde.“"
                            },
                            {
                                "example_id": "33fb0e48-dd53-4306-83ff-d77d4f80085a",
                                "sense_id": "e047ae08-6d00-30b5-90ae-db98081dfe09",
                                "text": "„Und nun läge der Schluß nahe, daß mit der vollendeten Buchstabenschrift die Entwicklung der Schrift überhaupt abgeschlossen und ein weiterer Fortschritt kaum mehr denkbar sei.“"
                            },
                            {
                                "example_id": "8859dfc2-036e-4677-85cd-2a8aad59fc4e",
                                "sense_id": "e047ae08-6d00-30b5-90ae-db98081dfe09",
                                "text": "„Man denkt unwillkürlich an die Phönizier, und von diesen ist die erste Buchstabenschrift in der Tat ausgegangen.“"
                            },
                            {
                                "example_id": "162ea540-772b-4ecc-9d08-d3db7f7f7081",
                                "sense_id": "e047ae08-6d00-30b5-90ae-db98081dfe09",
                                "text": "„Die meisten heutigen Laut- oder Buchstabenschriften und ihre Buchstabennamen lassen sich auf das Alphabet der Phönizier, eines alten Handelsvolkes, zurückführen.“"
                            },
                            {
                                "example_id": "40cb765d-8585-4206-82f5-349ab5934810",
                                "sense_id": "e047ae08-6d00-30b5-90ae-db98081dfe09",
                                "text": "„Es gibt eine Theorie, nach welcher die Phönizier die Erfinder der Buchstabenschrift sein sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
