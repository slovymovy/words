            {
                "entry_id": "90d5419c-dc73-3f24-a102-4038bc9bee4e",
                "word": "uru",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e764fc4f-8210-4978-9967-ae64d79f2c2f",
                        "entry_id": "90d5419c-dc73-3f24-a102-4038bc9bee4e",
                        "tags": [
                            "plural"
                        ],
                        "form": "urus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10554e06-b8c6-354d-9f45-90d80b0f5420",
                        "entry_id": "90d5419c-dc73-3f24-a102-4038bc9bee4e",
                        "glosses": [
                            "Fruit à pain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23b1322f-56fd-4f81-a9df-0a29f712b6d1",
                                "sense_id": "10554e06-b8c6-354d-9f45-90d80b0f5420",
                                "text": "Dimanche, au déjeuner, nous avons mangé un des plats traditionnels de la Polynésie : un uru cuit sur la braise."
                            },
                            {
                                "example_id": "c67d7ed9-49c8-4cf3-9fdf-edc73970eb0c",
                                "sense_id": "10554e06-b8c6-354d-9f45-90d80b0f5420",
                                "text": "Les fruits poussent à profusion à terre, et nous nous voyons offrir par les habitants des urus (fruit de l’arbre à pain), citrons, pamplemousses, et mangues."
                            },
                            {
                                "example_id": "1ba36aa5-73e3-4a10-8ef7-3767562409e5",
                                "sense_id": "10554e06-b8c6-354d-9f45-90d80b0f5420",
                                "text": "Aujourd’hui, le uru possède encore une place dans la nourriture des Polynésiens, mais il a moins d’importance qu’auparavant."
                            },
                            {
                                "example_id": "d9aae423-f8cd-46a5-ad99-23c7f9c0ece4",
                                "sense_id": "10554e06-b8c6-354d-9f45-90d80b0f5420",
                                "text": "A l’apéritif ou en accompagnement, les frites de uru sont délicieuses. Il est nécessaire de pré-cuire le uru, sur la flamme, les braises ou au four."
                            }
                        ]
                    }
                ],
