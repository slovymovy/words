                    {
                        "form_id": "d6cdad62-1a20-40f0-9e04-69f9d1f638b2",
                        "entry_id": "81a8bd72-4734-3371-8299-b98aa0a0f8c2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schuhsohlen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f091c3d-0f58-34b5-bcfc-2d026f22cd41",
                        "entry_id": "81a8bd72-4734-3371-8299-b98aa0a0f8c2",
                        "glosses": [
                            "die Lauffläche (Sohle) eines Schuhs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a005f4-cb9e-4cc2-8e0d-842061b899d9",
                                "sense_id": "7f091c3d-0f58-34b5-bcfc-2d026f22cd41",
                                "text": "„Matsch heftete sich an seine Schuhsohlen, aber er lief weiter.“"
                            },
                            {
                                "example_id": "7a35654d-f3ad-40a5-a269-1d2763c80966",
                                "sense_id": "7f091c3d-0f58-34b5-bcfc-2d026f22cd41",
                                "text": "„Almuth drückt die halbgerauchte Zigarette an ihrer Schuhsohle aus, zündet sofort eine neue an.“"
                            },
                            {
                                "example_id": "74ca541b-a3ca-4fc1-87f2-1735fa6b0953",
                                "sense_id": "7f091c3d-0f58-34b5-bcfc-2d026f22cd41",
                                "text": "„Kaum war's gesprochen, da verlor Goldlotos, ehe man sich dessen versah, infolge der Glätte des Schaukelbrettes und ihrer hohen Schuhsohlen den Halt und glitt klatschend aus.“"
                            },
                            {
                                "example_id": "b4c7965c-2bda-4e36-8a95-c2c275443bf5",
                                "sense_id": "7f091c3d-0f58-34b5-bcfc-2d026f22cd41",
                                "text": "„Eleni erklärt mir, dass es sich um einen Brauch handelt: Bevor die Braut das Haus verlässt, werden die Namen ihrer unverheirateten Freundinnen auf ihre Schuhsohlen geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec47dee3-e475-44dc-986c-4f4614aa1d67",
                        "source_entry_id": "81a8bd72-4734-3371-8299-b98aa0a0f8c2",
                        "source_sense_id": "7f091c3d-0f58-34b5-bcfc-2d026f22cd41",
                        "source_sense_description": "die Lauffläche (Sohle) eines Schuhs",
                        "target_lang_word": "sole of a shoe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3cc0d088-9264-453c-81ca-f59a79fd51b0",
                        "source_entry_id": "81a8bd72-4734-3371-8299-b98aa0a0f8c2",
                        "source_sense_id": "7f091c3d-0f58-34b5-bcfc-2d026f22cd41",
                        "source_sense_description": "die Lauffläche (Sohle) eines Schuhs",
                        "target_lang_word": "semelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de cuir, de caoutchouc, qui fait le dessous d’une chaussure, d’une botte, d’une pantoufle."
                                        ],
                                        "tags": [
                                            "Cordonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af9459f8-97c9-4ad9-adeb-0ceab94fad48",
                                                "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                                "text": "A ses pieds, on fixa des semelles de sandales qui s'attachaient à ses jambes brunes par des lanières de cuir croisées."
                                            },
                                            {
                                                "example_id": "9d0ee837-30d4-4ee4-930c-53e7fa9a0a7a",
                                                "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                                "text": "Il pressentait que l'eau triompherait des semelles sans résistance, et, sournoisement, s'infiltrerait jusqu'aux chevilles."
                                            },
                                            {
                                                "example_id": "43c63619-eed7-45f3-83c2-5afb536c8d96",
                                                "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                                "text": "Marcher sur le sable sans se faire mal, voilà justement pourquoi les Egyptiens ont imaginé ces drôles de sandales (alors une simple semelle rigide en papyrus tressé et dotée de lanières de cuir) 3 500 ans avant JC. Les impératrices romaines leur ont emboîté le pas avec des semelles moulées en or. Quant aux Indiens et aux Perses, ils sculptaient des semelles de bois avec des entredoigts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d39ee0-37ad-3684-a137-1dd1950c7704",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de cuir, de caoutchouc, qui fait le dessous d’une chaussure, d’une botte, d’une pantoufle.",
                                            "Morceau de liège, de feutre taillés en semelle, qu’on met dans les souliers pour garantir les pieds de l’humidité, du froid."
                                        ],
                                        "tags": [
                                            "Cordonnerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "876b8997-e02b-3571-ba58-256dba4e42f9",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de cuir, de caoutchouc, qui fait le dessous d’une chaussure, d’une botte, d’une pantoufle.",
                                            "Morceau d’étoffe dont on garnit le pied d’un bas."
                                        ],
                                        "tags": [
                                            "Cordonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de00c127-4d54-4188-8696-5970c0702e31",
                                                "sense_id": "876b8997-e02b-3571-ba58-256dba4e42f9",
                                                "text": "Mettre des semelles à des bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a3a1574-0a64-3ebd-ba9a-5dd44bcf7fcf",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pied, longueur d’un pied."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00c17af0-3410-4535-a0e3-977ab546ebee",
                                                "sense_id": "1a3a1574-0a64-3ebd-ba9a-5dd44bcf7fcf",
                                                "text": "Ne pas reculer d’une semelle."
                                            },
                                            {
                                                "example_id": "8d880c3c-ac1f-4f29-b350-94148e202743",
                                                "sense_id": "1a3a1574-0a64-3ebd-ba9a-5dd44bcf7fcf",
                                                "text": "Rompre la semelle, reculer de la longueur du pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae54b90-75fe-3647-805e-9c178ee65d44",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de bois couchée horizontalement sous le pied d’un étai, ou servant d’entrait dans un comble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e1ae4df-cb36-4dfe-923d-19046b148947",
                                                "sense_id": "aae54b90-75fe-3647-805e-9c178ee65d44",
                                                "text": "Semelle d’étai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffba2a10-e9cc-3a03-a165-df8cf91dccc3",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièces de bois plates qu’on met sous un corps pesant pour servir à le faire glisser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fbab903-4175-39b4-abbe-e5771f60d0c9",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Plateau de bois très épais, qui se place entre les deux flasques d’un affût, et sur lequel le canon repose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a14a211d-67e6-340a-a424-4b358fb9de4e",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Viande très dure à mâcher ou trop cuite."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acae3d0e-3697-4b52-a94c-79729d7f9b21",
                                                "sense_id": "a14a211d-67e6-340a-a424-4b358fb9de4e",
                                                "text": "Quel chemin, en à peine plus d'un siècle, pour ce casse-dalle de va-nu-pieds, importé aux Etats-Unis par des immigrés allemands ! Ce sont eux qui ont apporté d'Hambourg (d'où le nom...) cette simple semelle de viande hachée servie entre deux tranches de pain, avec un peu d'oignon. Tout juste le vendait-on à la sauvette, alors, devant les usines ou les foires."
                                            },
                                            {
                                                "example_id": "48d55e93-90f9-41eb-b40d-600cf8ff5a14",
                                                "sense_id": "a14a211d-67e6-340a-a424-4b358fb9de4e",
                                                "text": "Adieu semelle, gîte à la noix, macreuse et jumeau; bonjour steak, escalope ou rôti trois étoiles. A partir de la semaine prochaine, les noms anatomiques des morceaux de boeuf, de veau, d'agneau et de brebis vont disparaître des étiquettes des barquettes en vente au rayon libre-service des grandes et moyennes surfaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d257c681-632a-31d7-88f6-16eb95f9a921",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Partie lisse d'un ski en contact avec la neige pour faciliter son glissement."
                                        ],
                                        "tags": [
                                            "Ski"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94549d0-f1be-4b33-8c21-377e8f36387d",
                                                "sense_id": "d257c681-632a-31d7-88f6-16eb95f9a921",
                                                "text": "Si vous optez pour le style alternatif, sorte de prolongement de la marche rapide, vous suivez des rails tracés dans la neige sur des planches à la semelle dotée d'écailles. Le skating, option plus technique sur semelles lisses, peut être franchement casse-gueule : il s'agit de patiner en balançant son poids d'une jambe sur l'autre pour former de grands V avec ses skis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4168b20e-9b19-3098-bd35-5bf93eb51533",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Jeu d’enfants consistant à toucher alternativement avec la plante du pied, la terre puis le pied de son partenaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2298ba5b-e680-437a-bf19-6704e457e020",
                                                "sense_id": "4168b20e-9b19-3098-bd35-5bf93eb51533",
                                                "text": "– Allez rejoindre vos camarades, et jouer comme tout le monde…\nAux barres, à chat perché, aux quatre coins, à la semelle ? C’étaient là les seuls divertissements admis, encore qu’on demandât aux élèves de refréner leur enthousiasme, afin de ménager l’uniforme et les fausses manches, propriété sacrée de l’État."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
