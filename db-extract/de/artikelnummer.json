                ],
                "senses": [
                    {
                        "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                        "entry_id": "a33b722c-22a8-3e29-af51-7bc8ae27a1d2",
                        "glosses": [
                            "aus Ziffern und/oder Buchstaben bestehende Kennung zur eindeutigen Festlegung einer Ware in einem Unternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff643caa-88d8-44b4-9ac6-1900c7161fec",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "Ich bestelle von der Artikelnummer L640020.20, Schachtel für Pralinen (Marzipan), fünf Paletten, das entspricht 10.000 Stück."
                            },
                            {
                                "example_id": "d02931b2-c3a2-47c7-8393-18115fe8ace4",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "Nur mit der Artikelnummer findet man in einem Lager einen bestimmte Ware wieder."
                            },
                            {
                                "example_id": "a9c90008-b397-4ccd-ba4f-8279995f9f1d",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "„Die Produkte mit den Artikelnummern 8527648, 8527647, 8527651 und 8527652 sollten deshalb nicht weiter verwendet werden und in einer Filiale zurückzugeben werden.“"
                            },
                            {
                                "example_id": "97fd2dfe-7fc1-4cc7-a1d7-fd5503531e39",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "„Es handelt sich dabei um Etiketten, die nur gelesen werden können, ohne zusätzliche Daten. Das Etikett ist nicht mit der Artikelnummer, der Größe oder der Farbe des Artikels verknüpft.“"
                            },
                            {
                                "example_id": "bfa7478e-dc10-43a3-af7b-4407566bdd67",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "„Um hier eventuellen Verwechslungen vorzubeugen, muss auf jedem Kanban-Behälter das mit dem Behälter zu transportierende Material z. B. über eine Artikelnummer vermerkt sein.“"
                            },
                            {
                                "example_id": "3730cc5a-0225-44b9-a93b-e2985ea5062d",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "„Die Minimierung des Erfassungaufwands beim Verkaufsvorgang erfordert, daß sich die Artikelnummer auf der Packung befindet und maschinell lesbar ist (z. B. EAN-Code).“"
                            },
                            {
                                "example_id": "376cf35c-cb59-4866-a652-8dd5b4dacc6d",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "„Alle anderen mit der Artikelnummer zusammenhängenden Informationen, wie Artikelbezeichnung, Verkaufspreis und Lagerbestand sind im Artikelstamm gespeichert und werden über die Artikelnummer verkettet.“"
                            },
                            {
                                "example_id": "9f0df688-f27d-4fd9-b5d0-a97eba40bd34",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "„Der BUND bietet mit Unterstützung des Umweltbundesamtes ein Online-Formular an, das dem Verbraucher die Suche abnimmt. Dort reicht es, die Artikelnummer (unter dem Strichcode), den Produktname und die eigenen Kontaktdaten einzugeben.“"
                            },
                            {
                                "example_id": "33040131-c872-4e4a-81fb-0fbdfa20927a",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "Es gibt heute kein Warenwirtschaftssystem ohne Artikelnummern."
                            },
                            {
                                "example_id": "aa7c8fc1-e254-4293-96a9-4dc86cec5a08",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "Für die Anlage des Artikelstamms ist es hilfreich, bereits im Vorfeld einige Punkte zu klären, insbesondere: Wie viele Stellen soll die Artikelnummer maximal haben?"
                            },
                            {
                                "example_id": "697c190e-360d-4908-ae76-54fee6f0197f",
                                "sense_id": "edda3587-6698-334f-a120-aa721ad7874a",
                                "text": "„Gerade für die Artikelnummer gibt es in den einzelnen Firmen unterschiedlichste Vorgaben, welche Informationen bereits in der Nummer verschlüsselt werden. So beginnt die Artikelnummer häufig mit den Ziffern der Warengruppe, dann folgt die Artikeluntergruppe und anschließend eine fortlaufende Nummer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
