                        ],
                        "examples": [
                            {
                                "example_id": "cc86ba84-7dc1-453b-9f64-57473937fb7b",
                                "sense_id": "b8e3d96b-dfa4-3057-a838-04f90a8898c7",
                                "text": "[…] the wretched creature went to the police for help; she was versed in the law, and perhaps had spared no pains to keep on good terms with the local constabulary."
                            },
                            {
                                "example_id": "3309add6-bd42-477c-8fa6-5e0b4e2beb07",
                                "sense_id": "b8e3d96b-dfa4-3057-a838-04f90a8898c7",
                                "text": "As Hiro is entering their neighborhood, he sees men running down the undulating pontoon bridge that serves as the main street, carrying guns and knives. The local constabulary."
                            }
                        ]
                    }
                ],
