                    },
                    {
                        "form_id": "c1832b29-ba2f-48af-a3fe-3938772b844e",
                        "entry_id": "8e8a9551-152c-346e-a041-641a1d186000",
                        "tags": [],
                        "form": "co-location"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b509ce1a-6478-3d61-b87d-e66ae0793594",
                        "entry_id": "8e8a9551-152c-346e-a041-641a1d186000",
                        "glosses": [
                            "Location faite par plusieurs personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b35c02c-83c9-43d1-8876-4a511496c9d2",
                                "sense_id": "b509ce1a-6478-3d61-b87d-e66ae0793594",
                                "text": "Trois top-modèles vivaient en colocation dans l'appartement prêté par un couturier en vogue.\nUne quatrième débarqua de sa Russie natale, une longue liane de 180 cm, belle, de naturel parée."
                            },
                            {
                                "example_id": "1fb453cb-6239-4790-9319-c678a73166f9",
                                "sense_id": "b509ce1a-6478-3d61-b87d-e66ae0793594",
                                "text": "Sept pourcent seulement des étudiants vivent en colocation. Celle-ci se développe très lentement en France."
                            },
                            {
                                "example_id": "ee502653-92c9-45b1-b957-c0a831fd1197",
                                "sense_id": "b509ce1a-6478-3d61-b87d-e66ae0793594",
                                "text": "Il demeure de nombreux obstacles à la colocation qu'il convient de lever."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a808897d-2cd3-4909-9137-82b6c85629c4",
                        "source_entry_id": "8e8a9551-152c-346e-a041-641a1d186000",
                        "source_sense_id": "b509ce1a-6478-3d61-b87d-e66ae0793594",
                        "target_lang_word": "Wohngemeinschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohngemeinschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96327d0d-533a-39ff-9eb7-0f00722dfbb4",
                                        "entry_id": "daef5fe2-0bbc-3013-a32d-0be3a2c28f60",
                                        "glosses": [
                                            "Wohnung, die sich mehrere Personen teilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863d918d-e3fc-4023-b8ba-77ac6ff0c36c",
                                                "sense_id": "96327d0d-533a-39ff-9eb7-0f00722dfbb4",
                                                "text": "Der Student lebte mit zwei guten Freundinnen in einer Wohngemeinschaft."
                                            },
                                            {
                                                "example_id": "817bd9d7-3ed2-4d89-8f69-b6ba9c1139f6",
                                                "sense_id": "96327d0d-533a-39ff-9eb7-0f00722dfbb4",
                                                "text": "„Dann hörte ich von einer Wohngemeinschaft, wo die Vermieterin toleranter war, dort wohnten noch andere wie ich, und wir könnten beieinander übernachten, wenn wir nur diskret waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                        "entry_id": "daef5fe2-0bbc-3013-a32d-0be3a2c28f60",
                                        "glosses": [
                                            "Gemeinschaft von Personen (Mitbewohner), die sich eine Wohnung teilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2979d58-cf4c-4473-9738-e086b5a5cf9b",
                                                "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                                "text": "Unsere Wohngemeinschaft macht morgen einen Spieleabend."
                                            },
                                            {
                                                "example_id": "36789389-2e15-4bf1-a079-bed91bcff9c5",
                                                "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                                "text": "„Wer jedoch die Stadt in Richtung Norden verließ, der konnte in einem stattlichen Haus an den Hängen des Montmartre eine kleine Wohngemeinschaft antreffen, die entschlossen schien, der Stimmung in der Stadt zu trotzen.“"
                                            },
                                            {
                                                "example_id": "3bb7879d-f706-4f15-9e19-3646d3f27ce5",
                                                "sense_id": "7c6d18fc-7b43-3264-93f3-82d7ad02e7be",
                                                "text": "„In einem ihrer Kölner Häuser hatten ihm seine Eltern eine Fünf-Zimmer-Wohnung überlassen, die Arnfried unverzüglich in eine Wohngemeinschaft, eine WG, umfunktionierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76901c28-a0f1-459c-9c14-7f9c65253406",
                        "source_entry_id": "8e8a9551-152c-346e-a041-641a1d186000",
                        "source_sense_id": "b509ce1a-6478-3d61-b87d-e66ae0793594",
                        "target_lang_word": "WG",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "WG",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5425c830-735d-3ca7-847a-53638da4ace8",
                                        "entry_id": "57844b23-82b1-344c-88ea-968d198e1a98",
                                        "glosses": [
                                            "Wohngemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c200a63c-ed64-4030-ae5d-7d9eff475662",
                                                "sense_id": "5425c830-735d-3ca7-847a-53638da4ace8",
                                                "text": "Nicht nur Studenten leben in WGs."
                                            },
                                            {
                                                "example_id": "05d56257-2a1e-4996-9c69-9c05704d0671",
                                                "sense_id": "5425c830-735d-3ca7-847a-53638da4ace8",
                                                "text": "Zu Beginn ihres Studiums hat sie mit ihrer besten Freundin eine WG gegründet."
                                            },
                                            {
                                                "example_id": "d0b8e8d7-5485-4483-a8fc-4c357f0e7eab",
                                                "sense_id": "5425c830-735d-3ca7-847a-53638da4ace8",
                                                "text": "Da Tom mit seinen Mitbewohnern nicht zurechtgekommen war, ist er aus der WG ausgezogen."
                                            },
                                            {
                                                "example_id": "88865443-d372-41ba-bc83-2c9347f5d31b",
                                                "sense_id": "5425c830-735d-3ca7-847a-53638da4ace8",
                                                "text": "„In einem ihrer Kölner Häuser hatten ihm seine Eltern eine Fünf-Zimmer-Wohnung überlassen, die Arnfried unverzüglich in eine Wohngemeinschaft, eine WG, umfunktionierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
