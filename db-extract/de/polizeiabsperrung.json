                "senses": [
                    {
                        "sense_id": "1425751b-a533-3a7c-a836-dbe9b75d8d3b",
                        "entry_id": "bc7dbd4c-94e8-3939-be42-8c7df86ea455",
                        "glosses": [
                            "von der Polizei aufgestellte Absperrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dac92d84-7b1a-443e-9c59-f50ad025204c",
                                "sense_id": "1425751b-a533-3a7c-a836-dbe9b75d8d3b",
                                "text": "„Die Angehörigen der Opfer gingen trotz der Polizeiabsperrung auf ihn los und versuchten ihn zu packen.“"
                            },
                            {
                                "example_id": "954f7380-f2af-4edb-9eca-51baf8247580",
                                "sense_id": "1425751b-a533-3a7c-a836-dbe9b75d8d3b",
                                "text": "„Bill Wagner, der CIA-Resident, der sich durch die Polizeiabsperrungen in das Chaos begab, das die Bombe angerichtet hatte, fuhr entsetzt zurück, als er im Rinnstein, durch den Blut wie Regenwasser floss, die abgetrennte Hand eines Kindes sah.“"
                            },
                            {
                                "example_id": "1896ad67-8658-40a2-89f3-578d7e9dbd64",
                                "sense_id": "1425751b-a533-3a7c-a836-dbe9b75d8d3b",
                                "text": "„Ein Nebeneffekt der Polizeiabsperrung war, dass sie für Sicherheit sorgte, obwohl kaum jemand bei Alphabet Capital verstand, wie wichtig das war.“"
                            },
                            {
                                "example_id": "08de1ed5-52a7-48ac-9467-21c95988ebbb",
                                "sense_id": "1425751b-a533-3a7c-a836-dbe9b75d8d3b",
                                "text": "„Er überfuhr die Polizeiabsperrung, kam im Vorgarten zum Stehen und kippte aus dem Auto.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
