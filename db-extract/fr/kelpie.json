                                        "sense_id": "d4e95b63-8ebc-3bda-87dc-595ca37c2ec1",
                                        "entry_id": "e8145f8b-e571-3810-bed0-bd2b8f085ff3",
                                        "glosses": [
                                            "A malevolent shapeshifting spirit, most often in the form of a horse, believed to haunt the rivers and lochs of Scotland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb813ba1-47c3-4fa2-a9b1-6c30bf853851",
                                                "sense_id": "d4e95b63-8ebc-3bda-87dc-595ca37c2ec1",
                                                "text": "He was a boy in form, and an antediluvian in feature. Some thought he was a mule, between a Jew and an ape; some a wizard, some a kelpie, or a fairy, but most of all, that he was really and truly a Brownie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc6c813e-db9f-3b12-985a-d1998e2c7cd1",
                                        "entry_id": "e8145f8b-e571-3810-bed0-bd2b8f085ff3",
                                        "glosses": [
                                            "An Australian breed of sheepdog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8b6f9e1-1bf6-42df-9d47-6fff2762fefa",
                                                "sense_id": "dc6c813e-db9f-3b12-985a-d1998e2c7cd1",
                                                "text": "There was no sound but the endless noise of forest and river, and the sleep-whimper of his kelpie."
                                            },
                                            {
                                                "example_id": "45289ff3-deb1-48b9-9e5f-98dc818fae29",
                                                "sense_id": "dc6c813e-db9f-3b12-985a-d1998e2c7cd1",
                                                "text": "Gulls scatter before the blur of my insane kelpie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
