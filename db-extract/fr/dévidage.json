                ],
                "senses": [
                    {
                        "sense_id": "d7203914-158c-3362-b4f4-c6b12d082937",
                        "entry_id": "0bd3a727-ed07-30a5-8a46-945b32f333f1",
                        "glosses": [
                            "Action de dévider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ebd6a11-9177-48aa-b758-5562c034fdb8",
                                "sense_id": "d7203914-158c-3362-b4f4-c6b12d082937",
                                "text": "Or les écheveaux à numéroter à Tourcoing sont généralement d'un dévidage difficile, contrairement à ce qui se passe à Roubaix."
                            },
                            {
                                "example_id": "081501c3-ecd6-4355-9805-d08e415a1b98",
                                "sense_id": "d7203914-158c-3362-b4f4-c6b12d082937",
                                "text": "Avant, comme après la teinture, on opère plusieurs trancanages ou dévidages afin d'émonder la soie et de la rendre propre aux diverses opérations de la fabrication."
                            },
                            {
                                "example_id": "0c2af169-3710-44f8-9be7-f512e6bfe823",
                                "sense_id": "d7203914-158c-3362-b4f4-c6b12d082937",
                                "text": "C’est un produit riche en protéines, facile à digérer. Une fois la chrysalide échaudée, suit le dévidage qui demande beaucoup de travail et occupe des villages entiers dans la région."
                            }
                        ]
                    }
                ],
