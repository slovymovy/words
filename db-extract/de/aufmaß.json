                "senses": [
                    {
                        "sense_id": "3ea6357a-14a8-3d39-8ec5-8b83f0fb458f",
                        "entry_id": "928b97d5-3887-3d2c-afd7-2e5feb3f474d",
                        "glosses": [
                            "Vermessung, Auszählung und Bewertung des für einen Auftrag erforderlichen oder eingebauten Materials"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cbc596d-7d96-47ca-a21c-fed75c4d72df",
                                "sense_id": "3ea6357a-14a8-3d39-8ec5-8b83f0fb458f",
                                "text": "„Anhand des Aufmaßes wird die tatsächlich erbrachte Bauleistung nach der Fertigstellung erfaßt und der Endabrechnung zugrunde gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6295e566-d1aa-464a-8b30-45bf22d472ae",
                        "source_entry_id": "928b97d5-3887-3d2c-afd7-2e5feb3f474d",
                        "source_sense_id": "3ea6357a-14a8-3d39-8ec5-8b83f0fb458f",
                        "source_sense_description": "Vermessung, Auszählung und Bewertung des für einen Auftrag erforderlichen oder eingebauten Materials",
                        "target_lang_word": "mesure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e8ad1e3-4474-310d-85d9-2d56eaba7950",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd193653-31f6-4a7a-a267-de3008a94e0d",
                                                "sense_id": "9e8ad1e3-4474-310d-85d9-2d56eaba7950",
                                                "text": "Prendre les mesures d’une colonne, d’un bâtiment."
                                            },
                                            {
                                                "example_id": "231c8cb7-304b-44b5-b123-815c7a0990d0",
                                                "sense_id": "9e8ad1e3-4474-310d-85d9-2d56eaba7950",
                                                "text": "Deux grandeurs qui ont une commune mesure sont commensurables entre elles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "444227a2-91d3-346b-a6bf-8a681f275b3a",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Étalon, grandeur prise comme terme de comparaison pour évaluer la durée, l’étendue, la quantité, le poids, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7abe5e20-3dba-4061-91ed-99102953e1cc",
                                                "sense_id": "444227a2-91d3-346b-a6bf-8a681f275b3a",
                                                "text": "Les mesures agraires de Quarré, avant la Révolution (elles persistent aujourd'hui), n'avaient pas de base fixe. Un journal de champ, une « soiture » de pré oscillaient entre vingt-deux et trente-cinq ares de nos mesures métriques."
                                            },
                                            {
                                                "example_id": "1a77f6d9-ba45-481e-976e-98df0a6d97d6",
                                                "sense_id": "444227a2-91d3-346b-a6bf-8a681f275b3a",
                                                "text": "Les mesures de toute espèce ont été assujetties au système décimal et ont reçu de nouvelles dénominations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63dd1abd-8083-3ff9-b46f-20eff0969dbe",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "916b3a38-ca38-4af5-8bb5-97acf9bb62ea",
                                                "sense_id": "63dd1abd-8083-3ff9-b46f-20eff0969dbe",
                                                "text": "Une mesure de sel, d’avoine, d’huile."
                                            },
                                            {
                                                "example_id": "e42c4b25-a03c-43e0-9d25-062ce10b293a",
                                                "sense_id": "63dd1abd-8083-3ff9-b46f-20eff0969dbe",
                                                "text": "Acheter deux mesures d’avoine à son cheval."
                                            },
                                            {
                                                "example_id": "a3a186e2-e893-45aa-9edc-de31d79b3b65",
                                                "sense_id": "63dd1abd-8083-3ff9-b46f-20eff0969dbe",
                                                "text": "La bonne femme Tranchet s’avança vers moi, me caressa et me promit une bonne mesure d’avoine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "228baa76-f9cf-3f85-8d14-7fcb9a5c9bd9",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Action d’évaluer une grandeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424bc19a-4472-44b6-85fa-88c0b9f117d1",
                                                "sense_id": "228baa76-f9cf-3f85-8d14-7fcb9a5c9bd9",
                                                "text": "La mesure d’une surface."
                                            },
                                            {
                                                "example_id": "a42ae2e1-9a36-48f2-a44e-6993bae63377",
                                                "sense_id": "228baa76-f9cf-3f85-8d14-7fcb9a5c9bd9",
                                                "text": "La mesure du kilomètre comparée au mètre est égale à mille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea8d985-20fc-3e5c-a34c-74196cdab615",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Processus consistant à obtenir expérimentalement une ou plusieurs valeurs que l’on peut raisonnablement attribuer à une grandeur : mesurage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f391866-25c8-3a08-8d38-1b872cfae756",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Nombre de pieds ou de syllabes, propres à chaque espèce de vers."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "416105e5-9ae9-4b3e-aad0-35c3a3fd2183",
                                                "sense_id": "8f391866-25c8-3a08-8d38-1b872cfae756",
                                                "text": "La mesure de l’hexamètre latin est de six pieds, dont les deux derniers sont un dactyle et un spondée."
                                            },
                                            {
                                                "example_id": "63840dfd-32f6-4ae3-95a9-8cac452dd792",
                                                "sense_id": "8f391866-25c8-3a08-8d38-1b872cfae756",
                                                "text": "La mesure de l’alexandrin français classique est de douze syllabes, avec un repos nommé césure entre la sixième et la septième syllabe."
                                            },
                                            {
                                                "example_id": "136d0f81-526b-4254-bfd3-677149c2184e",
                                                "sense_id": "8f391866-25c8-3a08-8d38-1b872cfae756",
                                                "text": "On retient plus facilement les vers que la prose, à cause de la mesure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1101a049-2d77-35f1-90de-9c8f6f0e3ee5",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Rythme divisant la durée d’une phrase musicale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d55822-ce61-44f4-95db-24146a7f24c2",
                                                "sense_id": "1101a049-2d77-35f1-90de-9c8f6f0e3ee5",
                                                "text": "Battre la mesure."
                                            },
                                            {
                                                "example_id": "904000e7-e6e1-4b35-9cdb-73e88e77d08e",
                                                "sense_id": "1101a049-2d77-35f1-90de-9c8f6f0e3ee5",
                                                "text": "Hâter, presser, ralentir la mesure."
                                            },
                                            {
                                                "example_id": "7f92ade0-5495-485a-9158-b771288d47c7",
                                                "sense_id": "1101a049-2d77-35f1-90de-9c8f6f0e3ee5",
                                                "text": "Chanter, danser, jouer en mesure, observer exactement la mesure dans le chant, dans la danse, ou en jouant de quelque instrument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a4d41f8-3d28-33e6-a371-f9ed79b3e77d",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Chacune des parties égales d’une phrase musicale, division des portées dans une partition de durée égale aux autres divisions et délimitée par deux barres de mesures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae84280-9217-4b2f-a1db-8379ae7b9a6e",
                                                "sense_id": "9a4d41f8-3d28-33e6-a371-f9ed79b3e77d",
                                                "text": "Chaque mesure de ce morceau se bat à deux, trois, quatre temps."
                                            },
                                            {
                                                "example_id": "1dbfdae2-a8bc-40b8-a81f-a2dd4fbff8b1",
                                                "sense_id": "9a4d41f8-3d28-33e6-a371-f9ed79b3e77d",
                                                "text": "Mesure à deux temps, à trois temps, à quatre temps, à six temps, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f613451a-0270-3de5-af55-5f59d8f25291",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Décision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48cb6b6-8630-4028-8ced-7fb596231386",
                                                "sense_id": "f613451a-0270-3de5-af55-5f59d8f25291",
                                                "text": "Je suis passé dans la clandestinité pour ne pas être arrêté, car je savais que je faisais l'objet d'une mesure d'internement."
                                            },
                                            {
                                                "example_id": "3fb5366f-f486-4b4c-9b85-f2deb42ad2d3",
                                                "sense_id": "f613451a-0270-3de5-af55-5f59d8f25291",
                                                "text": "L’expression vise tour à tour la circulation alternée ou différenciée et la vignette Crit’Air, les mesures antidiesel, la piétonnisation des berges de Seine ou l’extension des pistes cyclables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d01812-ff24-35c1-8c89-498396066f24",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Modération, retenue, sentiment et observation des bienséances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef79719-6a2c-44c9-8f6e-ae7bb295a4b0",
                                                "sense_id": "d7d01812-ff24-35c1-8c89-498396066f24",
                                                "text": "Il lui a écrit, il lui a parlé avec beaucoup de mesure."
                                            },
                                            {
                                                "example_id": "0bac8cbc-f688-4716-8ce4-a18f4686460b",
                                                "sense_id": "d7d01812-ff24-35c1-8c89-498396066f24",
                                                "text": "Être sans mesure, sans règle ni mesure."
                                            },
                                            {
                                                "example_id": "c098960e-575d-4a5c-a663-b3d1e4b0592a",
                                                "sense_id": "d7d01812-ff24-35c1-8c89-498396066f24",
                                                "text": "Être toujours dans la mesure."
                                            },
                                            {
                                                "example_id": "1705a8a7-3da4-4f79-98aa-1a8f6ca04aaa",
                                                "sense_id": "d7d01812-ff24-35c1-8c89-498396066f24",
                                                "text": "Ce que vous lui avez dit est hors de toute mesure, passe toute mesure."
                                            },
                                            {
                                                "example_id": "79ce58f7-b3f4-4782-8a0c-29543e163bd8",
                                                "sense_id": "d7d01812-ff24-35c1-8c89-498396066f24",
                                                "text": "En Normandie et plus tard en Alsace, il avait obtenu, dans ce genre, des succès qui passaient toute mesure, sans avoir éprouvé jamais un seul échec."
                                            },
                                            {
                                                "example_id": "701e5a88-d3c7-464d-949a-226df84db20c",
                                                "sense_id": "d7d01812-ff24-35c1-8c89-498396066f24",
                                                "text": "Il y a eu ici, je t’en réponds, en fait de scandales et de provocations, des choses qui passaient la mesure, et non pas drôlement, Aldo, gravement, oui, gravement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85b1f93a-c108-3f7c-b7bd-5a845be49946",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Une base de comparaison."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a893fbf9-5c3f-4cf1-8ff1-671261f41a0d",
                                                "sense_id": "85b1f93a-c108-3f7c-b7bd-5a845be49946",
                                                "text": "Il s’agit d’un changement de paradigme dont on a encore du mal à prendre toute la mesure."
                                            },
                                            {
                                                "example_id": "19bd50b7-d84b-47cb-a1f6-2eefc7f0c003",
                                                "sense_id": "85b1f93a-c108-3f7c-b7bd-5a845be49946",
                                                "text": "La mesure d'un homme est la somme de ses expériences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0ca555f-ce42-327d-85cd-4ff13ffb11d4",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Précaution ; disposition ; moyen qu’on prend pour arriver au but qu’on se propose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92acd4aa-226c-452c-b26b-3930c9f5ba65",
                                                "sense_id": "e0ca555f-ce42-327d-85cd-4ff13ffb11d4",
                                                "text": "La première édition, à l’été 2020, avait pris des airs de guinguette améliorée à cause des mesures sanitaires post-confinement."
                                            },
                                            {
                                                "example_id": "ad7a3c80-9600-428f-94ec-e24ca2615cd5",
                                                "sense_id": "e0ca555f-ce42-327d-85cd-4ff13ffb11d4",
                                                "text": "[…] ; quand les cléricaux sont les plus faibles dans un pays, il ne manquent jamais de recommander des mesures de sévère réglementation pour se venger de patrons francs-maçons."
                                            },
                                            {
                                                "example_id": "e1a0f435-e59a-40be-860e-8769b4518f98",
                                                "sense_id": "e0ca555f-ce42-327d-85cd-4ff13ffb11d4",
                                                "text": "La ministre de l’Écologie Delphine Batho a annoncé, lors de sa visite à l’entreprise MPO, en Mayenne, le 7 janvier, une série de mesures destinées à aider la filière photovoltaïque."
                                            },
                                            {
                                                "example_id": "a44ec41b-b362-48de-91fb-626137a08af2",
                                                "sense_id": "e0ca555f-ce42-327d-85cd-4ff13ffb11d4",
                                                "text": "Il est convaincu que la peste est un fléau endémique et non contagieux et que les seules mesures pour s'en préserver sont des mesures d'hygiène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8544c53b-6212-303c-8092-f5fb71a9e7e4",
                                        "entry_id": "083e89ae-7fff-3ea4-bcf3-3269ae2e6fa2",
                                        "glosses": [
                                            "Bornes, limites, capacité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef8d55c-a0fc-4b64-8e25-28bb3ee0bdcc",
                                                "sense_id": "8544c53b-6212-303c-8092-f5fb71a9e7e4",
                                                "text": "Régler ses pensées selon la mesure du sens commun, de la raison."
                                            },
                                            {
                                                "example_id": "dbddaf07-be07-4e6a-875b-ef1773423207",
                                                "sense_id": "8544c53b-6212-303c-8092-f5fb71a9e7e4",
                                                "text": "Nos vrais besoins sont la mesure naturelle du nécessaire."
                                            },
                                            {
                                                "example_id": "6ace1100-148b-4752-9812-08c71ae7d18f",
                                                "sense_id": "8544c53b-6212-303c-8092-f5fb71a9e7e4",
                                                "text": "Comme les vrais ivrognes, ceux pour lesquels la médecine ne peut rien, elle connaissait sa mesure et entretenait, chez elle, un état déterminé, cette sorte d’indifférence somnambulesque qui intriguait à première vue."
                                            },
                                            {
                                                "example_id": "eb9e864f-a1f6-41c8-a799-14727420b871",
                                                "sense_id": "8544c53b-6212-303c-8092-f5fb71a9e7e4",
                                                "text": "Il restera donc dans cette maison où il ne peut donner toute sa mesure, hélas!"
