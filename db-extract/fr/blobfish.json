                "senses": [
                    {
                        "sense_id": "b14563b9-cded-31b3-abba-3dc991e3cbb5",
                        "entry_id": "54142fae-3386-3d86-af13-a0b1163c11bc",
                        "glosses": [
                            "Espèce de poisson abyssal que l’on peut trouver au large des côtes australiennes et tasmaniennes, caractérisé par sa chair molle et gélatineuse qui lui permet de supporter la pression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a0b8d5b-b07c-4ce2-a354-7464c953ad53",
                                "sense_id": "b14563b9-cded-31b3-abba-3dc991e3cbb5",
                                "text": "Le blobfish est une espèce de poissons abyssaux, vivant à des profondeurs comprises entre 600 et 1.200 mètres."
                            },
                            {
                                "example_id": "78d7dce5-3008-4415-b187-81b7e1d18af3",
                                "sense_id": "b14563b9-cded-31b3-abba-3dc991e3cbb5",
                                "text": "S’il n’est pas dévoré dans les premiers mois de sa vie, le blobfish est rapidement confronté à la pression écrasante du fond."
                            },
                            {
                                "example_id": "1afca1cd-528d-40e4-b2ac-0e2193316e40",
                                "sense_id": "b14563b9-cded-31b3-abba-3dc991e3cbb5",
                                "text": "Le blobfish a été découvert en 2003 par l'écologiste marin Kerryn Parkinson lors d'une expédition au large de la Nouvelle-Zélande."
                            }
                        ]
                    }
                ],
