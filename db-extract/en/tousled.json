                "senses": [
                    {
                        "sense_id": "477b224a-dfe4-37cb-8c34-065242f99acd",
                        "entry_id": "c4245ffc-bf16-3d88-b5fb-66af86bf5e7f",
                        "glosses": [
                            "Of hair: in disarray, dishevelled, or unkempt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600fd44d-5299-4632-a499-bf2cc9d82f47",
                                "sense_id": "477b224a-dfe4-37cb-8c34-065242f99acd",
                                "text": "His shoes were covered with mud, and he was looking very rough and touzled; but then he had never been a very smart man, the Badger, at the best of times."
                            },
                            {
                                "example_id": "9771b5ac-a68a-479e-afec-ec52d81c9449",
                                "sense_id": "477b224a-dfe4-37cb-8c34-065242f99acd",
                                "text": "An instant later the maid, who looked as tousled and bewildered as if she had that instant been aroused from the deepest sleep, appeared with a card upon a tray."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
