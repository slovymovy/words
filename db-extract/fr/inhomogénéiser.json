                "senses": [
                    {
                        "sense_id": "1dd41757-80a4-33ad-8e15-aa84443cd1a3",
                        "entry_id": "b69d1eb7-abd0-3bc2-b133-304b0972ab09",
                        "glosses": [
                            "Donner un caractère inhomogène à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d5f69d-fff9-4d21-ae55-727dd46f29a0",
                                "sense_id": "1dd41757-80a4-33ad-8e15-aa84443cd1a3",
                                "text": "L’ischémie altère à la fois la distensibilité intrinsèque et extrinsèque du ventricule gauche, et retarde et inhomogénéise la relaxation ;"
                            },
                            {
                                "example_id": "01f2625a-f3cc-4a29-9eec-efba0da764b1",
                                "sense_id": "1dd41757-80a4-33ad-8e15-aa84443cd1a3",
                                "text": "Par conséquent, les modes d'interaction se développant à l’interface entre les roues sont susceptibles d’inhomogénéiser l’écoulement jusqu’en amont du rouet."
                            },
                            {
                                "example_id": "53a88e12-fce7-4af9-a47a-db80d2baa3f3",
                                "sense_id": "1dd41757-80a4-33ad-8e15-aa84443cd1a3",
                                "text": "Elle a tendance a inhomogénéiser la matière."
                            }
                        ]
                    }
