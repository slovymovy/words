                    {
                        "translation_id": "94cfb67d-a366-461f-8712-050dce125f0f",
                        "source_entry_id": "7525caeb-e99b-36d3-93c8-5b612cbc4b3f",
                        "source_sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                        "source_sense_description": "unregelmäßige, zufällige Veränderung, Schwankung",
                        "target_lang_word": "変動",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "変動",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "a366deaa-cc76-3a2f-9b44-78f01e305411",
                                        "entry_id": "d15b2af0-7a7d-36d5-b53e-17cda2eee2fe",
                                        "glosses": [
                                            "状態が、動き、変わること。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14985ae-d1c0-409a-9440-6573c77e7443",
                                                "sense_id": "a366deaa-cc76-3a2f-9b44-78f01e305411",
                                                "text": "変動相場制"
                                            },
                                            {
                                                "example_id": "352204b2-a733-45e9-a0f1-1998b86fa60c",
                                                "sense_id": "a366deaa-cc76-3a2f-9b44-78f01e305411",
                                                "text": "不動産の価格も多数の価格形成要因の相互因果関係の組合せの流れである変動の過程において形成されるものである。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bab2f9e3-6fac-3835-8283-fa63ab153602",
                                        "entry_id": "d15b2af0-7a7d-36d5-b53e-17cda2eee2fe",
                                        "glosses": [
                                            "事態の大きな変化。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f3b526-4063-4b0a-942e-b05038b6d5f3",
                                                "sense_id": "bab2f9e3-6fac-3835-8283-fa63ab153602",
                                                "text": "平岡の一身上に急劇な変化のあったのは争うべからざる事実である。代助はその時はっと思った。それで、逢（あ）うや否（いな）やこの変動の一部始終を聞こうと待設けていたのだが、不幸にして話が外（そ）れて容易に其所（そこ）へ戻って来ない。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
