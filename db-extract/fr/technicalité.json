                "entry_id": "79930acf-48e2-39b8-9c85-5debb90b0f03",
                "word": "technicalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45bcbde5-83a6-44f4-a8f8-8c281592b22c",
                        "entry_id": "79930acf-48e2-39b8-9c85-5debb90b0f03",
                        "tags": [
                            "plural"
                        ],
                        "form": "technicalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4b5a107-eb20-3e1c-8324-a9ddc428150a",
                        "entry_id": "79930acf-48e2-39b8-9c85-5debb90b0f03",
                        "glosses": [
                            "Détail technique, simple formalité, considération d’ordre technique, point de détail."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b787b1b8-78da-4a99-9c04-a9f21160eaf2",
                                "sense_id": "f4b5a107-eb20-3e1c-8324-a9ddc428150a",
                                "text": "… on a invoqué une technicalité qui a froissé des enquêteurs de police …. — (« Le gouvernement Charest sabote l’UPAC, soupçonne le PQ », CyberPresse.ca, 14 septembre 2011)"
                            },
                            {
                                "example_id": "dc38c7a8-b8a2-4426-98b7-852a05ab2a35",
                                "sense_id": "f4b5a107-eb20-3e1c-8324-a9ddc428150a",
                                "text": "Le porte-parole du Parti québécois en matière de Transports, Stéphane Bergeron, se demandait mercredi avant-midi si le recours à un concours d’entrée constituait une « technicalité » mise de l’avant « pour empêcher que les choses puissent se faire correctement »."
                            },
                            {
                                "example_id": "487dd0e5-2a56-4ce8-8206-5ebd4a54370c",
                                "sense_id": "f4b5a107-eb20-3e1c-8324-a9ddc428150a",
                                "text": "«C’est assez étrange de constater qu’en quelques heures, on est partis de motifs en lien avec une enquête de réputation, pour en arriver à une technicalité à propos des prix trop compétitifs», a lancé la porte-parole de la compagnie, Odette Côté."
                            }
                        ]
                    },
                    {
                        "sense_id": "38a297bd-2655-32cb-bb5c-32e8bdfb1153",
                        "entry_id": "79930acf-48e2-39b8-9c85-5debb90b0f03",
                        "glosses": [
                            "Qualité ou caractère de ce qui est technique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "d9fe1e33-cced-48d3-af80-be8ba23a8acf",
                                "sense_id": "38a297bd-2655-32cb-bb5c-32e8bdfb1153",
                                "text": "La technicalité de la rédaction des objectifs précise les critères qui permettent à l’enseignant d’observer si, oui ou non, ses élèves ont atteint cet objectif."
                            },
                            {
                                "example_id": "30a4b9dc-6f92-4170-a307-f000606e84d8",
                                "sense_id": "38a297bd-2655-32cb-bb5c-32e8bdfb1153",
                                "text": "Et si l’on ajoute le niveau de technicalité élevé des débats et la diversité des langages utilisés dans les groupes de travail […], il est facile de comprendre pourquoi les groupes tendent à adopter une attitude réactive vis-à-vis de l’agenda de la Commission."
                            },
                            {
                                "example_id": "ff961aa4-7b34-437c-abb3-39f835bf2659",
                                "sense_id": "38a297bd-2655-32cb-bb5c-32e8bdfb1153",
                                "text": "Trop souvent enfin les traités sur la géologie l’on rendue stérile autant que prétentieuse, par une nomeclature incohérente et une technicalité superflue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f1425da-ef08-4357-b903-6520d964e0e5",
                        "source_entry_id": "79930acf-48e2-39b8-9c85-5debb90b0f03",
                        "target_lang_word": "technicality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technicality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a33f2e27-3601-3fb9-b7a5-78aba988109b",
                                        "entry_id": "1fdf5c2b-f48e-3e5a-aaf6-d9a4bb0aa633",
                                        "glosses": [
                                            "The quality or state of being technical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c1a994-2623-4e66-a8bb-1754238ce654",
                                                "sense_id": "a33f2e27-3601-3fb9-b7a5-78aba988109b",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            },
                                            {
                                                "example_id": "d01107db-a1da-44d0-a4a8-704111725e15",
                                                "sense_id": "a33f2e27-3601-3fb9-b7a5-78aba988109b",
                                                "text": "Ha and Hyland suggest that technicality is not binary and it is not always possible to say that a word is technical or not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "204050c7-114e-3834-b782-8d5c78c1f4af",
                                        "entry_id": "1fdf5c2b-f48e-3e5a-aaf6-d9a4bb0aa633",
                                        "glosses": [
                                            "That which is technical, or peculiar to any trade, profession, sect, or the like."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70259ace-0031-4e68-96e4-5ebc4cc093e9",
                                                "sense_id": "204050c7-114e-3834-b782-8d5c78c1f4af",
                                                "text": "the technicalities of the sect"
                                            },
                                            {
                                                "example_id": "0d3ba0b8-0036-4e06-a5aa-0b7fe4c49c44",
                                                "sense_id": "204050c7-114e-3834-b782-8d5c78c1f4af",
                                                "text": "[T]he names of places and horses and slangy technicalities of the turf, had interlarded the poor girl's brain-sick babble; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f078094c-43e9-3b5d-bf52-fe4ad002141b",
                                        "entry_id": "1fdf5c2b-f48e-3e5a-aaf6-d9a4bb0aa633",
                                        "glosses": [
                                            "A minor detail, rule, law, etc., seemingly insignificant to a non-specialist but which has significant consequences in larger matters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75821961-c8ca-46ec-9b7e-a426ad156f7c",
                                                "sense_id": "f078094c-43e9-3b5d-bf52-fe4ad002141b",
                                                "text": "legal technicality"
                                            },
                                            {
                                                "example_id": "bf2f0a4e-fa59-4e53-b717-ccc0bce1379e",
                                                "sense_id": "f078094c-43e9-3b5d-bf52-fe4ad002141b",
                                                "text": "These are some of the \"Reversible Errors\" on which a new trial can be had and are often spoken of by misinformed business men as \"technicalities,\" as when they say a certain gangster \"got off on a technicality\" or \"got a new trial on a technicality.\""
                                            },
                                            {
                                                "example_id": "3f33c443-fd8c-46d8-8fee-1d8fcf4e7884",
                                                "sense_id": "f078094c-43e9-3b5d-bf52-fe4ad002141b",
                                                "text": "Mommsen believed that Claudius had been an augur who was ordered by a chief pontiff Metellus to inaugurate Sulpicius son of Servius as a priest, that Claudius declined on grounds of a religious technicality, that Claudius was subsequently fined by the chief pontiff, and that Claudius appealed the fine."
                                            },
                                            {
                                                "example_id": "b144499d-0500-4933-94bd-41ed68337f18",
                                                "sense_id": "f078094c-43e9-3b5d-bf52-fe4ad002141b",
                                                "text": "Benjamin Gonzales is a suspect in Dondi Johnson's murder - the only suspect we've ever had and the only suspect we ever will have. But at present we don't have a fileable case because of a legal technicality."
                                            },
                                            {
                                                "example_id": "8bd04668-3955-48db-8017-40c6192dd984",
                                                "sense_id": "f078094c-43e9-3b5d-bf52-fe4ad002141b",
                                                "text": "How often do we hear about someone who “got away” with committing a crime or who “got off on a technicality”? This type of remark is common when discussions arise about the shortcomings of the U.S. legal system."
                                            },
                                            {
                                                "example_id": "bbfb4899-7843-4e81-9155-c55c2fa98b67",
                                                "sense_id": "f078094c-43e9-3b5d-bf52-fe4ad002141b",
                                                "text": "In 2021, Pennsylvania’s highest court threw out the sexual assault conviction of Bill Cosby on a legal technicality, after discovering an agreement with a previous prosecutor prevented the actor from being charged in the case."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4c2a2c2-9e56-488a-9d63-d1210b3611f6",
                        "source_entry_id": "79930acf-48e2-39b8-9c85-5debb90b0f03",
                        "target_lang_word": "technicalness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technicalness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f028e3-bbba-302f-a206-e7b581c591e9",
                                        "entry_id": "7e3a4d3c-130a-3d27-8844-5f03795365fb",
                                        "glosses": [
                                            "The quality or state of being technical; technicality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9c2c42-8039-4514-8dad-8aebfa960948",
                                                "sense_id": "a6f028e3-bbba-302f-a206-e7b581c591e9",
                                                "text": "Because this is incredibly technical […] any examples I do will take up roughly a page, and another page of incredible technicalness will no doubt cause you all to flee screaming into the night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
