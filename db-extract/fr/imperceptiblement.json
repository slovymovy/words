        "fr-extract.jsonl": [
            {
                "entry_id": "0adf800f-78f3-320b-af80-4c5fe4117f04",
                "word": "imperceptiblement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "34d9fcc5-6abf-32c9-89ea-720acf9549a1",
                        "entry_id": "0adf800f-78f3-320b-af80-4c5fe4117f04",
                        "glosses": [
                            "D’une manière imperceptible, peu à peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1175294a-26b8-4201-b8bb-4f6f11ed6962",
                                "sense_id": "34d9fcc5-6abf-32c9-89ea-720acf9549a1",
                                "text": "De même, dit ce Père [saint Bernard], que le reptile s’insinue et se roule subtilement, aussi le péché se glisse-t-il comme imperceptiblement dans une conscience où la passion et l’erreur lui donnent entrée."
                            },
                            {
                                "example_id": "7cc75ed9-f895-4fdd-bab9-d7d0a023328d",
                                "sense_id": "34d9fcc5-6abf-32c9-89ea-720acf9549a1",
                                "text": "Une jeune princesse qui croît en taille à vue d’œil, et imperceptiblement en mérite."
                            },
                            {
                                "example_id": "aaa35247-49df-4dd7-8975-be9c523642a9",
                                "sense_id": "34d9fcc5-6abf-32c9-89ea-720acf9549a1",
                                "text": "Avec une souplesse de couleuvre, lentement, imperceptiblement, elle se coula sur la descente de lit, et devant l’absence de réactions de Georges, repta doucement jusqu’à la porte."
                            },
                            {
                                "example_id": "7eef68fe-0f09-47d5-bf5f-440514109b9b",
                                "sense_id": "34d9fcc5-6abf-32c9-89ea-720acf9549a1",
                                "text": "Alors ils se taisent. Ils font défiler en secret, derrière leur mine impassible, la fragile armée des ombres que forment les femmes qu’ils ont aimées. Et peut-être que l’un d’entre eux commence lentement, imperceptiblement, à sourire, imité ensuite par les deux autres.\nIls oublient de parler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15f255f1-70a5-4ab7-9e66-365d6aa78d2a",
                        "source_entry_id": "0adf800f-78f3-320b-af80-4c5fe4117f04",
                        "source_sense_id": "34d9fcc5-6abf-32c9-89ea-720acf9549a1",
                        "target_lang_word": "imperceptibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperceptibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                        "entry_id": "394599ed-d4f6-357f-a8d9-a677679cbecd",
                                        "glosses": [
                                            "Not noticeably; such that it cannot be detected, through being too small or too fast, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8662868a-cf7d-41a0-abfe-76d6b9caf7a9",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "No one noticed that he had moved imperceptibly backwards."
                                            },
                                            {
                                                "example_id": "674d77cb-a296-4197-9731-6c161b39ed2e",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "It often happens that the most important results in the natural world are brought about by causes which operate silently, if not imperceptibly."
                                            },
                                            {
                                                "example_id": "f12bc0fb-c7e2-4b50-b40a-918a19a5f68b",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "The moon moved imperceptibly towards setting."
                                            },
                                            {
                                                "example_id": "b855e3c0-a64a-474d-b68e-a8c1b3964cb0",
                                                "sense_id": "81a77a1c-1846-3905-9f8c-b7deb16a7d99",
                                                "text": "Which means that at the moment Raven entered her, a very small hypodermic needle slipped imperceptibly into the engorged frontal vein of his penis, automatically shooting a cocktail of powerful narcotics and depressants into his bloodstream."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a3d580c-6b1a-4904-a3d1-8cac04a287ba",
                        "source_entry_id": "0adf800f-78f3-320b-af80-4c5fe4117f04",
