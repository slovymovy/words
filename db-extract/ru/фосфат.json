                        "examples": [
                            {
                                "example_id": "ba7bc62e-f7e9-4632-b44a-f3d5f619b2b4",
                                "sense_id": "0951125a-d427-3f1e-a904-1a2d2a4bfbb8",
                                "text": "Фосфаты широко используются в синтетических моющих средствах для связывания ионов кальция и магния."
                            }
                        ]
                    },
                    {
                        "sense_id": "6edb41c1-d188-30c1-a055-473ba20602b5",
                        "entry_id": "4d4f9e76-be86-354c-ae97-539ee0619ab6",
                        "glosses": [
