    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "98b9649d-a21f-3619-9e83-4c9975a722fd",
                "word": "feedstock",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f1c9202c-9cac-4693-b7d7-75a9604788c0",
                        "entry_id": "98b9649d-a21f-3619-9e83-4c9975a722fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "feedstocks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                        "entry_id": "98b9649d-a21f-3619-9e83-4c9975a722fd",
                        "glosses": [
                            "Any bulk raw material constituting the principal input for an industrial process."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0651bfe6-90b5-48b4-9184-a0eb04679102",
                                "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                                "text": "Bio-materials may be substituted for petrochemical feedstocks as petroleum prices rise."
                            },
                            {
                                "example_id": "c75c5455-19e9-4743-988e-dba1d7f6018b",
                                "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                                "text": "The filtered extract of the mash is the feedstock for the fermenter."
                            },
                            {
                                "example_id": "7bb6c217-3c19-4d96-9bcd-2dcfd8c8f2b2",
                                "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                                "text": "In 2006, about 6 percent of the world's crude oil production was used in non-energy applications, primarily as a petrochemical feedstock."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9bfc098-9f2c-435c-a314-c127bf890065",
                        "source_entry_id": "98b9649d-a21f-3619-9e83-4c9975a722fd",
                        "source_sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                        "source_sense_description": "raw material constituting the principal input for an industrial process",
                        "target_lang_word": "Rohstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rohstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                        "entry_id": "0f4336b6-4f6c-38bb-b5af-1c44d2e5f883",
                                        "glosses": [
                                            "zur Verarbeitung bestimmter Ausgangsstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d07d39-27ba-4a46-9892-7f4aba014537",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "Kohle, Stein und Eisen sind Rohstoffe für die Industrie."
                                            },
                                            {
                                                "example_id": "5f4703a1-74a8-4f09-9254-466fa688ed02",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Auf der Suche nach neuen Rohstoffen und Energieträgern nutzen Forscher Prinzipien der Katalyse, um bisher wenig brauchbare Stoffe in nützliche umzuwandeln.“"
                                            },
                                            {
                                                "example_id": "7333ab86-ea7d-4c39-8c34-e7f31b4f3507",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Politiker aller Couleur palavern ständig, dass der einzige Rohstoff unseres Landes in den Köpfen unserer Kinder liege.“"
                                            },
                                            {
                                                "example_id": "c1b1bd5a-c101-4278-87c0-cc5d94599071",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Strenge Vorschriften hinsichtlich der Lagerung der wertvollen Rohstoffe, der bereits damals vorgeschriebenen Banderole und der Steuerkontrolle ließen sich unter der Kuppel der großen Moschee gut realisieren.“"
                                            },
                                            {
                                                "example_id": "63a6dcd0-7e80-4c1d-bdbb-031a2fe869e0",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Der so gewonnene Rohstoff wurde in großen Öfen geschmolzen und zu Barren gegossen, die mithilfe von Elefanten und Eisenbahn zur Küste transportiert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0aab2b95-0d2e-44af-b076-9d60272ee85e",
                        "source_entry_id": "98b9649d-a21f-3619-9e83-4c9975a722fd",
