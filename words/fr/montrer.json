{
    "word_family": [
        "montre",
        "montreur",
        "remontrer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "879a6a66-a5e6-36e0-b28a-f40e324f2023",
                    "sense_definition": "Faire voir quelque chose à quelqu'un, l'exposer aux regards.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception_visuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu me <w>montrer</w> tes nouvelles photos de vacances ?"
                        },
                        {
                            "text": "Le guide nous <w>montre</w> le plus célèbre tableau du musée."
                        }
                    ],
                    "synonyms": [
                        "exposer"
                    ],
                    "common_phrases": [
                        "montrer une photo",
                        "montrer ses papiers"
                    ],
                    "antonyms": [
                        "cacher"
                    ]
                },
                {
                    "sense_id": "426d11f2-1273-3748-beda-2f91129b717a",
                    "sense_definition": "Désigner ou faire remarquer quelqu'un ou quelque chose par un geste ou par la parole.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant <w>montre</w> du doigt les animaux dans le parc zoologique."
                        },
                        {
                            "text": "Elle a gentiment accepté de me <w>montrer</w> le chemin de la gare."
                        }
                    ],
                    "synonyms": [
                        "désigner",
                        "indiquer",
                        "pointer",
                        "pointer du doigt"
                    ],
                    "common_phrases": [
                        "montrer du doigt",
                        "montrer le chemin"
                    ]
                },
                {
                    "sense_id": "641de61c-7fe4-3ae1-9078-d1093e10f1e2",
                    "sense_definition": "Faire connaître, établir la réalité de quelque chose par des preuves ou des explications.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demonstration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette étude récente <w>montre</w> clairement les bienfaits d'une bonne alimentation."
                        },
                        {
                            "text": "Les faits vont bientôt <w>montrer</w> qu'il avait parfaitement raison dès le début."
                        }
                    ],
                    "synonyms": [
                        "démontrer",
                        "mettre en évidence",
                        "prouver"
                    ]
                },
                {
                    "sense_id": "f2338ba9-71da-3e02-9c03-6edc94636357",
                    "sense_definition": "Témoigner d'une qualité, d'un sentiment ou d'un trait de caractère par ses actes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pompier a su <w>montrer</w> son courage lors de l'incendie hier soir."
                        },
                        {
                            "text": "Nous devons <w>montrer</w> de la patience envers les personnes âgées."
                        }
                    ],
                    "synonyms": [
                        "manifester"
                    ],
                    "common_phrases": [
                        "montrer son courage",
                        "montrer de la patience"
                    ]
                },
                {
                    "sense_id": "6a28c810-81d3-32db-ae13-a0b3f96f79e4",
                    "sense_definition": "Enseigner à quelqu'un comment faire quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enseignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon père m'a <w>montré</w> comment nager dans cette petite rivière quand j'étais enfant."
                        },
                        {
                            "text": "Peux-tu me <w>montrer</w> comment fonctionne ce logiciel de traitement de texte ?"
                        }
                    ],
                    "common_phrases": [
                        "montrer à nager",
                        "montrer comment faire"
                    ]
                },
                {
                    "sense_id": "9bfb6535-812e-3b81-a2c4-636d1c311404",
                    "sense_definition": "Se faire voir ou adopter une attitude particulière face aux autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les difficultés de l'entreprise, elle a su se <w>montrer</w> optimiste et déterminée."
                        },
                        {
                            "text": "L'acteur hésite encore à se <w>montrer</w> en public après cette controverse."
                        }
                    ],
                    "common_phrases": [
                        "se montrer bienveillant",
                        "se montrer prudent"
                    ]
                }
            ]
        }
    ]
}