                            {
                                "target_lang_word": "piyasaya sürmek",
                                "target_lang_sense_clarification": "ürün veya film"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f2e90d4-3457-3d68-ab46-a5866deee521",
                    "sense_definition": "Перестать держать что-либо в руках; разжать пальцы, позволяя предмету упасть или освободиться.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "release_grip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От неожиданности она могла случайно <выпустить> чашку из рук.",
                            "target_lang_translations": {
                                "en": "Out of surprise, she could accidentally <drop> the cup from her hands.",
                                "tr": "Şaşkınlıktan fincanı elinden kazara <düşürebilirdi>."
                            }
