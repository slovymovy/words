                                        "sense_id": "da2eb4bd-f619-3f9e-bc67-26e91f66f6b5",
                                        "entry_id": "1bd266ae-5c53-3b66-9453-cc285667ff67",
                                        "glosses": [
                                            "Insincere or obsequious assent; hypocritical or pretended concurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7cdea4-3a36-471e-8474-42c7e5b4b003",
                                                "sense_id": "da2eb4bd-f619-3f9e-bc67-26e91f66f6b5",
                                                "text": "August 10, 1749 Philip Stanhope, 4th Earl of Chesterfield, letter to his son\nAbject flattery and indiscriminate assentation degrade as much as indiscriminate contradiction and noisy debate disgust."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4150646b-d7c6-49d1-8ccd-b74b3c1f3025",
