                                "target_senses": [
                                    {
                                        "sense_id": "b701978e-d1dd-328c-af8e-1d7420f55057",
                                        "entry_id": "f0830e74-5c82-3da3-a2f2-e4004be98419",
                                        "glosses": [
                                            "To make lean."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
