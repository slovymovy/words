                                "example_id": "aab74f73-795a-40ac-9f96-0afe0b48b422",
                                "sense_id": "5a555111-5ead-3581-87b6-fce62f853f0b",
                                "text": "Budowa bałtyckiego gazociągu wywołała sprzeciw nie tylko ekologów."
                            },
                            {
                                "example_id": "a08ca430-ac45-4493-8ca0-8e8331845d69",
                                "sense_id": "5a555111-5ead-3581-87b6-fce62f853f0b",
                                "text": "Znany polityk został oskarżony o podżeganie swoich zwolenników do sprzeciwu wobec zwycięstwa swojego rywala."
                            }
