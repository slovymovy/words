                    {
                        "sense_id": "e875e256-fdf5-303d-bd45-0e6ce2842ac7",
                        "entry_id": "8d4d3cbd-caef-31f9-a092-929dfcc5a852",
                        "glosses": [
                            "To treat as, transform into, or create nonsense, whether intentionally or unintentionally."
                        ],
                        "tags": [
                            "intransitive",
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ffaa32-f02a-4638-97d3-97cd8825e050",
                                "sense_id": "e875e256-fdf5-303d-bd45-0e6ce2842ac7",
                                "text": "Turnbull again obscures and nonsensifies by misprinting \"works\" for \"words.\""
                            },
                            {
                                "example_id": "f01d89b9-6f51-42a7-a17f-b2beb4d8bf78",
                                "sense_id": "e875e256-fdf5-303d-bd45-0e6ce2842ac7",
                                "text": "The artist, generalizing from the facts of experience, combines concrete symbols absurdly so as to nonsensify pragmatic reality."
                            },
                            {
                                "example_id": "27fdf6e0-1a0a-431c-bce6-f5c045964c60",
                                "sense_id": "e875e256-fdf5-303d-bd45-0e6ce2842ac7",
                                "text": "But Swift will have none of this. He nonsensifies Collins."
                            },
                            {
                                "example_id": "8d7a994f-b8de-46d1-983f-025ba2c40864",
                                "sense_id": "e875e256-fdf5-303d-bd45-0e6ce2842ac7",
                                "text": "The Dutchman, taking the 16th stage of the Tour de France after a solo effort which nonsensified all known laws of human endurance, smiled."
                            }
                        ]
                    }
