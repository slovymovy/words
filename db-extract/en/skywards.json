                "entry_id": "5f80db52-f5d8-3685-a57d-f37ac1ad1db5",
                "word": "skywards",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a838136-5568-35df-8f48-f17408c7d024",
                        "entry_id": "5f80db52-f5d8-3685-a57d-f37ac1ad1db5",
                        "glosses": [
                            "In the direction of the sky; upwards."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f8689e6e-39e4-4085-b3bb-8bbd9dfca300",
                                "sense_id": "4a838136-5568-35df-8f48-f17408c7d024",
                                "text": "The explosion sent him skywards."
                            },
                            {
                                "example_id": "19d196f0-d97c-47c1-bb66-e5893ee721cf",
                                "sense_id": "4a838136-5568-35df-8f48-f17408c7d024",
                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. [...] He halted opposite the Privy Gardens, and, with his face turned skywards, listened until the sound of the Tower guns smote again on the ear and dispelled his doubts."
                            },
                            {
                                "example_id": "acbeaeb3-d205-46f3-946c-ab52c0a79617",
                                "sense_id": "4a838136-5568-35df-8f48-f17408c7d024",
                                "text": "The lights of Luluabourg disappeared, and we were in the blackness of the African night, which was continuously pierced by the showers of red sparks ejected skywards and red hot ashes deposited on the track as the fireman rocked his fire."
                            },
                            {
                                "example_id": "3b342487-7553-4844-8671-3755a1bd81c2",
                                "sense_id": "4a838136-5568-35df-8f48-f17408c7d024",
                                "text": "[I]f your neighbour is not exploiting their potential to go skywards, you can buy it off them and make your building even taller. It seems fitting that in the cut-throat capital of capitalism, even the air is for sale."
                            }
                        ]
                    }
                ],
