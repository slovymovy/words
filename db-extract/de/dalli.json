                                    {
                                        "sense_id": "f737017e-c30f-348e-8a66-991702e40f83",
                                        "entry_id": "a7a007a5-b57c-34cf-84ea-003a262a5ccb",
                                        "glosses": [
                                            "먼저 혹은 짧은 시간에."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82813e76-d8b8-4824-9b35-1e52fe0aca99",
                                                "sense_id": "f737017e-c30f-348e-8a66-991702e40f83",
                                                "text": "네가 한 잘못을 빨리 실토하지 못하겠니."
                                            },
                                            {
                                                "example_id": "a5537330-e8fe-4e79-9528-1aed4875a4a4",
                                                "sense_id": "f737017e-c30f-348e-8a66-991702e40f83",
                                                "text": "일을 빨리 끝내고 친구를 만나러 가야겠다."
                                            },
                                            {
                                                "example_id": "0807aef0-1269-465c-bf24-712c8965142a",
                                                "sense_id": "f737017e-c30f-348e-8a66-991702e40f83",
                                                "text": "동사: 빨리하다"
                                            },
                                            {
                                                "example_id": "032a726a-823a-42bf-9e15-5ae55378a0a6",
                                                "sense_id": "f737017e-c30f-348e-8a66-991702e40f83",
                                                "text": "형용사: 빠르다"
                                            }
                                        ]
