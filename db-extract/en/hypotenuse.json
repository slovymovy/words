                                    {
                                        "sense_id": "befce991-4611-355d-8a87-f873076a51cd",
                                        "entry_id": "ae1f2197-9ee1-38f9-9855-16f95d2b00eb",
                                        "glosses": [
                                            "Côté opposé à l’angle droit dans un triangle rectangle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aaa78fc-aebd-469c-9d48-4cf40a30601c",
                                                "sense_id": "befce991-4611-355d-8a87-f873076a51cd",
                                                "text": "Si dans un triangle rectangle on abaisse une perpendiculaire du sommet de l'angle droit sur l’hypoténuse, le rapport d'un segment d’hypoténuse à la longueur de l’hypoténuse est égal au carré du cosinus de l'angle adjacent au segment."
                                            },
                                            {
                                                "example_id": "28c3b349-f80e-4c81-a153-d5240d2e8212",
                                                "sense_id": "befce991-4611-355d-8a87-f873076a51cd",
                                                "text": "Le carré de l’hypoténuse\nEst égal, si je ne m’abuse,\nÀ la somme des carrés\nConstruits sur les autres côtés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
