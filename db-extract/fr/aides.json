        "fr-extract.jsonl": [
            {
                "entry_id": "54045747-cc1d-3161-9311-b6fa9b5fda9b",
                "word": "aides",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98e9ec1d-fee1-3482-9fbc-6f73df1d8f7a",
                        "entry_id": "54045747-cc1d-3161-9311-b6fa9b5fda9b",
                        "glosses": [
                            "Impôts levés sur les denrées et marchandises qui se vendaient et se transportaient dans toute l’étendue du royaume."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "10a5772e-a613-4fb7-be1c-beb29e3bc645",
                                "sense_id": "98e9ec1d-fee1-3482-9fbc-6f73df1d8f7a",
                                "text": "Bourgeois et manants acquittaient la taille, la capitation, les vingtièmes, les aides."
                            },
                            {
                                "example_id": "0e20aa0e-4248-4cd1-81b0-289eb03eed75",
                                "sense_id": "98e9ec1d-fee1-3482-9fbc-6f73df1d8f7a",
                                "text": "Les aides rapportaient beaucoup d'argent."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb915bd9-0ec1-3a3e-b234-2fe8c63413c5",
                        "entry_id": "54045747-cc1d-3161-9311-b6fa9b5fda9b",
                        "glosses": [
                            "Moyens que le cavalier emploie pour bien manier un cheval, et plus particulièrement des mains et des jambes dans leur action sur le cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "371c723c-2d42-43fe-bb8f-7faa0895c8db",
                                "sense_id": "bb915bd9-0ec1-3a3e-b234-2fe8c63413c5",
                                "text": "Ce cheval connaît les aides."
                            },
                            {
                                "example_id": "452d9472-cde8-4c28-b710-f515ef8bb4ef",
                                "sense_id": "bb915bd9-0ec1-3a3e-b234-2fe8c63413c5",
                                "text": "Il donner des aides extrêmement fines: il manie le cheval à propos et lui faire marquer avec beaucoup de justesse ses temps et ses mouvements."
                            }
                        ]
                    },
                    {
                        "sense_id": "68a8f2e3-1947-3566-b91e-1d4ef7a071b2",
                        "entry_id": "54045747-cc1d-3161-9311-b6fa9b5fda9b",
                        "glosses": [
                            "Petites pièces ménagées près des grandes pièces d’apparat ou de service qui ont besoin de dégagement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
