                                    {
                                        "sense_id": "c4dd7a33-1972-34da-a7bb-b96c749a6c93",
                                        "entry_id": "924de3be-fb00-3b87-bf31-433b51b482a9",
                                        "glosses": [
                                            "Reentering; pointing inward."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89260a9e-485f-38d8-9ae4-220c353198e3",
                                        "entry_id": "924de3be-fb00-3b87-bf31-433b51b482a9",
                                        "glosses": [
                                            "Such that the corresponding lock can be reacquired by the locking thread."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b31030c-ef1e-4033-836f-0ef07f242e9e",
                                                "sense_id": "89260a9e-485f-38d8-9ae4-220c353198e3",
                                                "text": "The global interpreter lock of the embedded scripting engine is not reentrant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74761e35-cd81-35c3-bee5-16cb1b8c4fd8",
                                        "entry_id": "924de3be-fb00-3b87-bf31-433b51b482a9",
                                        "glosses": [
                                            "That may be executed more than once at a time either by different threads, or because of recursion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1cb62c2-6b0d-4be0-aa74-9869a1a9c5da",
                                                "sense_id": "74761e35-cd81-35c3-bee5-16cb1b8c4fd8",
                                                "text": "Global variables must not be altered by reentrant code."
                                            },
                                            {
                                                "example_id": "4cb55c5b-6016-4885-92b0-114b3dd89757",
                                                "sense_id": "74761e35-cd81-35c3-bee5-16cb1b8c4fd8",
                                                "text": "Actor serialization […]might even lead to possible deadlock. To mitigate that risk, there's an important exception to actor serialization: actors are reentrant. This means that when an actor itself says await, then while the actor's code is waiting, its members can be accessed from outside the actor using await."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e03adc14-f338-30db-ae23-6011776ee64e",
                                        "entry_id": "924de3be-fb00-3b87-bf31-433b51b482a9",
                                        "glosses": [
                                            "Designed to return to the Earth's atmosphere."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "332b6469-0ec8-3c26-9141-b3cff0229baa",
                                        "entry_id": "924de3be-fb00-3b87-bf31-433b51b482a9",
                                        "glosses": [
                                            "Of or pertaining to reentry (in the heart)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6871a55b-4fd1-3d0a-8474-9d08e7e9ebeb",
                                        "entry_id": "924de3be-fb00-3b87-bf31-433b51b482a9",
                                        "glosses": [
                                            "Having the strings not ordered according to pitch (having a re-entry)."
                                        ],
                                        "tags": [
