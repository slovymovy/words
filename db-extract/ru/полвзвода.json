                        "examples": [
                            {
                                "example_id": "36dcf8c9-39b5-4cd2-8d46-3f9ea57ff0f5",
                                "sense_id": "1c1ebabc-1ee8-3ab2-a879-b56876887041",
                                "text": "При таком превосходстве в силах противника за две немецкие атаки потерять в огневой линии всего полвзвода..."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b82b97e-c238-3e0c-ac9a-11f590dce661",
                        "entry_id": "123f59a2-a8b6-3330-994b-f96cfb8c0af8",
                        "glosses": [
                            "шутл. около 10-25 человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3e9692-47bb-4ea3-961a-5a6debf8a1c9",
                                "sense_id": "9b82b97e-c238-3e0c-ac9a-11f590dce661",
                                "text": "Если понадобится драться, я могу выставить полвзвода моих родственников, каждый из которых готов умереть за меня, как и я за них."
                            }
                        ]
                    }
