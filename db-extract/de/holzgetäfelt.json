                ],
                "senses": [
                    {
                        "sense_id": "962a87c1-1568-3430-8df7-490d412859cd",
                        "entry_id": "caa61151-4f4a-3bd9-b587-3106adb52a97",
                        "glosses": [
                            "mit einer Holztäfelung versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c873a977-f61b-4414-afe6-df7a91e949de",
                                "sense_id": "962a87c1-1568-3430-8df7-490d412859cd",
                                "text": "„Von der Richterbank aus herrschte Elsbeth Bothe, so weit ihr Blick reichte, und das war gegenwärtig ein aus der nordwestlichen Ecke des reich geschmückten Gebäudes herausgemeißelter holzgetäfelter Gerichtssaal mit einer hohen Decke und Porträts schon längst verstorbener Richter an den Wänden, die streng auf die Anwesenden herabstarrten.“"
                            },
                            {
                                "example_id": "10435fb0-f4f4-4aee-b271-9dc74c1085f1",
                                "sense_id": "962a87c1-1568-3430-8df7-490d412859cd",
                                "text": "„Dann wanderten sie endlose holzgetäfelte Gänge entlang.“"
                            },
                            {
                                "example_id": "4f7b565c-e7c8-4d5e-892a-cf95c83683da",
                                "sense_id": "962a87c1-1568-3430-8df7-490d412859cd",
                                "text": "„Nur um das festzuhalten: Omi Wilmot sitzt mit ihren alten Spezis vor der großen Uhr im holzgetäfelten Nebenraum des Foyers und spielt Bridge.“"
                            },
                            {
                                "example_id": "7650f4d7-f5a2-4be0-850e-8df5a0b9a7fa",
                                "sense_id": "962a87c1-1568-3430-8df7-490d412859cd",
                                "text": "„Wir gingen im Gänsemarsch in ein luftiges, holzgetäfeltes Esszimmer.“"
                            }
