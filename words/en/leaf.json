{
    "word_family": [
        "leafy",
        "leafless",
        "leaflet",
        "leaved"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9ba30db-2b3d-3ef5-91b4-b7c38df00e16",
                    "sense_definition": "The flat, green part of a plant that grows from a stem or branch, used to absorb sunlight.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plant_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large green <w>leaf</w> fell slowly from the tall tree.",
                            "target_lang_translations": {
                                "ru": "Большой зеленый <w>лист</w> медленно падал с высокого дерева.",
                                "zh": "那片巨大的绿色<w>叶子</w>从高大的树上缓缓落下。"
                            }
                        },
                        {
                            "text": "In the autumn, the <w>leaves</w> change color from green to red and gold.",
                            "target_lang_translations": {
                                "ru": "Осенью <w>листья</w> меняют цвет с зеленого на красный и золотой.",
                                "zh": "秋天时，<w>叶子</w>的颜色会从绿色变成红色和金色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "green leaf",
                        "autumn leaves",
                        "oak leaf",
                        "fallen leaves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская зеленая часть растения, растущая из стебля или ветви, используемая для поглощения солнечного света.",
                        "zh": "植物长在茎或枝上，用于吸收阳光的扁平绿色部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "часть растения"
                            },
                            {
                                "target_lang_word": "листва",
                                "target_lang_sense_clarification": "совокупность листьев"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叶子",
                                "target_lang_sense_clarification": "植物的叶片"
                            },
                            {
                                "target_lang_word": "叶",
                                "target_lang_sense_clarification": "植物的叶片"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae5e7f2-e7e2-3707-9b2e-a56c9af6591e",
                    "sense_definition": "The dried leaves of the tea plant, used to make the beverage tea.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers to brew her drink using loose <w>leaf</w> tea instead of bags.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает заваривать крупно<w>листовой</w> чай вместо пакетированного.",
                                "zh": "她更喜欢用散装<w>茶叶</w>冲泡，而不是用茶包。"
                            }
                        },
                        {
                            "text": "The fortune teller claimed she could read the future in the tea <w>leaves</w>.",
                            "target_lang_translations": {
                                "ru": "Гадалка утверждала, что может предсказать будущее по чайным <w>листьям</w>.",
                                "zh": "算命师声称她能通过<w>茶叶</w>占卜未来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tea leaf",
                        "loose leaf tea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высушенные листья чайного куста, используемые для приготовления напитка чай.",
                        "zh": "用于制作茶饮料的干茶叶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "чайный"
                            },
                            {
                                "target_lang_word": "заварка",
                                "target_lang_sense_clarification": "сухой чай"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "茶叶",
                                "target_lang_sense_clarification": "制成茶的干叶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82e58b66-47c2-31cb-aeac-ae31b05cdbbc",
                    "sense_definition": "A single sheet of paper in a book or magazine, consisting of two pages (one on each side).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "flat_sheet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old book was missing a <w>leaf</w> near the end of the first chapter.",
                            "target_lang_translations": {
                                "ru": "В старой книге не хватало одного <w>листа</w> в конце первой главы.",
                                "zh": "那本旧书第一章末尾少了一<w>页</w>。"
                            }
                        },
                        {
                            "text": "Please turn the <w>leaf</w> carefully so you do not tear the fragile paper.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, переворачивай <w>лист</w> осторожно, чтобы не порвать хрупкую бумагу.",
                                "zh": "请小心翻<w>页</w>，以免撕破脆弱的纸张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "folio"
                    ],
                    "common_phrases": [
                        "loose leaf",
                        "turn over a new leaf",
                        "fly leaf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один лист бумаги в книге или журнале, состоящий из двух страниц (по одной с каждой стороны).",
                        "zh": "书或杂志中由两面组成的一张纸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "бумаги, книги"
                            },
                            {
                                "target_lang_word": "страница",
                                "target_lang_sense_clarification": "разг. часть книги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "页",
                                "target_lang_sense_clarification": "书页"
                            },
                            {
                                "target_lang_word": "张",
                                "target_lang_sense_clarification": "纸张"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f84a095-5228-34b7-8e1d-a0741c789080",
                    "sense_definition": "A flat panel that can be inserted into a table to extend its size.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "furniture_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to add the extra <w>leaf</w> to the dining table to seat all the guests.",
                            "target_lang_translations": {
                                "ru": "Нам нужно вставить дополнительную <w>секцию</w> в обеденный стол, чтобы рассадить всех гостей.",
                                "zh": "我们需要给餐桌加一块<w>桌板</w>，才能坐下所有的客人。"
                            }
                        },
                        {
                            "text": "The antique table has a drop <w>leaf</w> on each side to save space when not in use.",
                            "target_lang_translations": {
                                "ru": "У антикварного стола есть откидная <w>доска</w> с каждой стороны для экономии места, когда он не используется.",
                                "zh": "这张古董桌两侧各有一个折叠<w>桌板</w>，不用时可以节省空间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "table leaf",
                        "drop leaf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская панель, которую можно вставить в стол для увеличения его размера.",
                        "zh": "可以插入桌子以增加其尺寸的扁平板。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставка",
                                "target_lang_sense_clarification": "для стола"
                            },
                            {
                                "target_lang_word": "откидная доска",
                                "target_lang_sense_clarification": "часть стола"
                            },
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桌板",
                                "target_lang_sense_clarification": "桌子的扩展部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc4ec29-cedd-3ff5-bdef-5de75b4d4659",
                    "sense_definition": "A very thin sheet of metal, such as gold or silver, used for decoration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flat_sheet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist covered the picture frame in real gold <w>leaf</w>.",
                            "target_lang_translations": {
                                "ru": "Художник покрыл раму настоящим сусальным <w>золотом</w>.",
                                "zh": "艺术家用真金<w>箔</w>覆盖了相框。"
                            }
                        },
                        {
                            "text": "This expensive dessert is decorated with a small piece of edible silver <w>leaf</w>.",
                            "target_lang_translations": {
                                "ru": "Этот дорогой десерт украшен маленьким кусочком съедобного сусального <w>серебра</w>.",
                                "zh": "这款昂贵的甜点装饰着一小片可食用的银<w>箔</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gold leaf",
                        "silver leaf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень тонкий слой металла, например золота или серебра, используемый для украшения.",
                        "zh": "用于装饰的极薄金属片，如金箔或银箔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "тонкий слой металла"
                            },
                            {
                                "target_lang_word": "сусаль",
                                "target_lang_sense_clarification": "сусальное золото/серебро"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "箔",
                                "target_lang_sense_clarification": "金属薄片"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3854224e-a019-36ee-b7d1-38ac25836f44",
                    "sense_definition": "A node in a data structure tree that has no children or further branches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The search algorithm stops processing when it reaches a <w>leaf</w> in the tree.",
                            "target_lang_translations": {
                                "ru": "Алгоритм поиска прекращает обработку, когда достигает <w>листа</w> дерева.",
                                "zh": "当搜索算法到达树的<w>叶节点</w>时，处理就会停止。"
                            }
                        },
                        {
                            "text": "Each <w>leaf</w> represents a final outcome in the decision process.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>лист</w> представляет собой конечный результат в процессе принятия решений.",
                                "zh": "每一个<w>叶节点</w>都代表决策过程中的最终结果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leaf node"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical (computing)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узел в древовидной структуре данных, не имеющий потомков или дальнейших ветвей.",
                        "zh": "数据结构树中没有子节点或分支的节点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "в графе/дереве"
                            },
                            {
                                "target_lang_word": "листовой узел",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叶节点",
                                "target_lang_sense_clarification": "计算机科学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ef09eb0-d7a6-3ab4-8a00-4f4958428bec",
                    "sense_definition": "A slang term for cannabis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer found a small bag of <w>leaf</w> in the suspect's pocket.",
                            "target_lang_translations": {
                                "ru": "Полицейский нашел маленький пакетик <w>травки</w> в кармане подозреваемого.",
                                "zh": "警察在嫌疑人的口袋里发现了一小袋<w>大麻</w>。"
                            }
                        },
                        {
                            "text": "He was caught smoking <w>leaf</w> behind the school building.",
                            "target_lang_translations": {
                                "ru": "Его поймали за курением <w>травки</w> за зданием школы.",
                                "zh": "他被抓到在教学楼后抽<w>大麻</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название марихуаны.",
                        "zh": "大麻的俚语称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травка",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "зелень",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大麻",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4ebb517-6591-3a33-b7ac-47da8417b0db",
                    "sense_definition": "To produce or grow leaves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plant_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trees began to <w>leaf</w> out early this year due to the warm spring.",
                            "target_lang_translations": {
                                "ru": "Деревья начали <w>распускаться</w> рано в этом году из-за теплой весны.",
                                "zh": "由于今年春天温暖，树木很早就开始<w>长叶</w>了。"
                            }
                        },
                        {
                            "text": "Most oak trees <w>leaf</w> later than other types of trees in this forest.",
                            "target_lang_translations": {
                                "ru": "Большинство дубов <w>покрываются листвой</w> позже, чем другие виды деревьев в этом лесу.",
                                "zh": "森林里大多数橡树比其他种类的树<w>长叶</w>得晚。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leaf out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпускать или отращивать листья.",
                        "zh": "植物长出叶子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распускаться",
                                "target_lang_sense_clarification": "о листьях/деревьях"
                            },
                            {
                                "target_lang_word": "покрываться листвой",
                                "target_lang_sense_clarification": "о деревьях"
                            },
                            {
                                "target_lang_word": "зеленеть",
                                "target_lang_sense_clarification": "становиться зеленым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长叶",
                                "target_lang_sense_clarification": "植物生长"
                            },
                            {
                                "target_lang_word": "发芽",
                                "target_lang_sense_clarification": "植物生长"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "89d320ac-0db5-35a3-a684-170872da3dfe",
                    "sense_definition": "A surname of Old English origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Leaf</w> has lived in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Лиф</w> живет в этом районе уже более сорока лет.",
                                "zh": "<w>利夫</w>先生在这个社区已经住了四十多年了。"
                            }
                        },
                        {
                            "text": "The <w>Leaf</w> family is hosting a reunion next weekend.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Лиф</w> устраивает встречу в следующие выходные.",
                                "zh": "<w>利夫</w>一家下周末要举办聚会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия древнеанглийского происхождения.",
                        "zh": "源自古英语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лиф",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利夫",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3785db54-a1b9-3a07-8a1c-8112e28b46f8",
                    "sense_definition": "A member, player, or supporter of the Toronto Maple Leafs ice hockey team.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Every true <w>Leaf</w> fan hopes they will win the championship this year.",
                            "target_lang_translations": {
                                "ru": "Каждый настоящий болельщик «<w>Лифс</w>» надеется, что они выиграют чемпионат в этом году.",
                                "zh": "每一位真正的<w>枫叶队</w>球迷都希望他们今年能赢得冠军。"
                            }
                        },
                        {
                            "text": "The star player has been a <w>Leaf</w> for his entire professional career.",
                            "target_lang_translations": {
                                "ru": "Звездный игрок был в составе «<w>Лифс</w>» на протяжении всей своей профессиональной карьеры.",
                                "zh": "这位明星球员整个职业生涯都是<w>枫叶队</w>的一员。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрок или болельщик хоккейной команды «Торонто Мейпл Лифс».",
                        "zh": "多伦多枫叶冰球队的成员、球员或支持者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лифс",
                                "target_lang_sense_clarification": "команда/игрок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "枫叶队",
                                "target_lang_sense_clarification": "球队名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fdd6d24-b5f0-3c7f-a883-858dfed8e0d0",
                    "sense_definition": "A specific model of electric car manufactured by Nissan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "They decided to buy a Nissan <w>Leaf</w> to save money on gasoline.",
                            "target_lang_translations": {
                                "ru": "Они решили купить Nissan <w>Leaf</w>, чтобы сэкономить на бензине.",
                                "zh": "他们决定买一辆日产<w>聆风</w>以节省汽油费。"
                            }
                        },
                        {
                            "text": "The new <w>Leaf</w> has a longer driving range than the previous model.",
                            "target_lang_translations": {
                                "ru": "У нового <w>Leaf</w> запас хода больше, чем у предыдущей модели.",
                                "zh": "新款<w>聆风</w>的续航里程比上一代车型更长。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Модель электромобиля производства Nissan.",
                        "zh": "日产生产的电动汽车型号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лиф",
                                "target_lang_sense_clarification": "модель автомобиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聆风",
                                "target_lang_sense_clarification": "汽车型号"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}