                "senses": [
                    {
                        "sense_id": "317556a0-916e-3701-b369-25cf7547f9cd",
                        "entry_id": "b1829f95-74ab-318c-a391-8ec99a8a014d",
                        "glosses": [
                            "Skelett eines Tiers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5cf70d7-8c6c-4fe6-9de6-9b4bb52d66a5",
                                "sense_id": "317556a0-916e-3701-b369-25cf7547f9cd",
                                "text": "„Ich kehrte mit einer Lampe in diesen unterirdischen Korridor zurück und verließ ihn erst, als ich keinen Zweifel mehr daran hegte, dass es sich bei den Knochen um Tierskelette handelte.“"
                            },
                            {
                                "example_id": "bcdf9ed9-eefb-486c-8531-38a2d8316e7f",
                                "sense_id": "317556a0-916e-3701-b369-25cf7547f9cd",
                                "text": "„Die wilden Tiere des Ngong hatten ganze Arbeit geleistet, der Körper des Mannes sah eher aus wie ein Tierskelett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
