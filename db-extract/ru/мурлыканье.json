                "translations": [
                    {
                        "translation_id": "4008af62-7560-4921-b7b6-fb94f0120d8b",
                        "source_entry_id": "00e11239-9b69-3395-883c-e6fa24ad9570",
                        "source_sense_description": "действие по значению гл. мурлыкать",
                        "target_lang_word": "purr",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb210a7-6ad3-3da3-a989-302b57b80143",
                                        "entry_id": "f49660b9-1551-376a-801e-cb6290a37e3b",
                                        "glosses": [
                                            "To make a vibrating sound in its throat when contented or in certain other conditions."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95b17524-7003-460e-868f-3daeb2ed84ef",
                                                "sense_id": "6cb210a7-6ad3-3da3-a989-302b57b80143",
                                                "text": "There was no one at home but a black cat, who was sitting quite content and purring on the hearth[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61336e13-4aad-3bd6-af73-ca666b731f57",
                                        "entry_id": "f49660b9-1551-376a-801e-cb6290a37e3b",
                                        "glosses": [
                                            "To say (something) in a throaty, seductive manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd5c6d3-155a-4cbe-aaa6-5ec0786f0888",
                                                "sense_id": "61336e13-4aad-3bd6-af73-ca666b731f57",
                                                "text": "\"This is Cindy,\" she purred again, flashing a smile of perfect white teeth surrounded by full red lips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e5a159c-b0f6-3910-82c9-60e1dae7b093",
                                        "entry_id": "f49660b9-1551-376a-801e-cb6290a37e3b",
                                        "glosses": [
                                            "To make a vibrating throaty sound, as from pleasure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca43dedf-d090-4b93-802a-e6b26d0b839e",
                                                "sense_id": "8e5a159c-b0f6-3910-82c9-60e1dae7b093",
                                                "text": "He purred like a kitten when she massaged his neck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5db934e-bdc3-3c0a-87e4-8ea108f88b00",
                                        "entry_id": "f49660b9-1551-376a-801e-cb6290a37e3b",
                                        "glosses": [
                                            "To spend time enjoying and expressing pleasure (over something); to coo; to enthuse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4d49a57-ab2e-4ecf-bed8-e5dacdfcc931",
                                                "sense_id": "f5db934e-bdc3-3c0a-87e4-8ea108f88b00",
                                                "text": "No woman receiving her first mink would ever put it directly into storage. She would try it on and purr over it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b967339c-3464-3a3e-8494-a9780d41aa1d",
                                        "entry_id": "f49660b9-1551-376a-801e-cb6290a37e3b",
                                        "glosses": [
                                            "To make a low and consistent rumbling sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332e1a2b-272e-4dfd-926a-9aee3abbc61a",
                                                "sense_id": "b967339c-3464-3a3e-8494-a9780d41aa1d",
                                                "text": "Beverly passed the city limits sign with the Porsche's motor purring contentedly after its two hundred and fifty-mile romp."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "purr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74fdbf0f-b685-3d3a-b910-ddd707df0438",
                                        "entry_id": "196268bc-6be1-3979-892a-0a662a0e0b4d",
                                        "glosses": [
                                            "The vibrating sound made by a cat in its throat when contented."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53906222-9856-4cb6-83a2-fdf6a3ec9feb",
                                                "sense_id": "74fdbf0f-b685-3d3a-b910-ddd707df0438",
                                                "text": "Instead, the tiger looked around, and gave a purr, and then a growl. What did that mean? The man could not tell. Then the tiger just flung upon the man some of the sand from the side of the hollow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bfd52f3-037e-3ed1-a5ee-25e6de155e2a",
                                        "entry_id": "196268bc-6be1-3979-892a-0a662a0e0b4d",
                                        "glosses": [
                                            "A throaty, seductive sound of pleasure made by a person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8cf7f75-65c7-492d-a49a-3e942fc3db29",
                                                "sense_id": "4bfd52f3-037e-3ed1-a5ee-25e6de155e2a",
                                                "text": "The trill of her purr echoed inside his mouth when he kissed her again. Clutching at his shirt, her fingers traveled the muscles in his back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "712548f7-bd3f-3c6f-a488-6b5293901600",
                                        "entry_id": "196268bc-6be1-3979-892a-0a662a0e0b4d",
                                        "glosses": [
                                            "The low consistent rumble made by an engine at slow speed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd2218c-35b2-4f16-b987-8749e5e4ce95",
                                                "sense_id": "712548f7-bd3f-3c6f-a488-6b5293901600",
                                                "text": "I sat still in the car and listened to the soft purr of the engine and my beating heart. Then slowly, and as silently as possible, I drove the car back to camp."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "purr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f39f998-64fa-36e5-a241-75292c602662",
                                        "entry_id": "4c9688a1-9cfe-3f38-bc73-186f56e3a3a6",
                                        "glosses": [
                                            "Vibrating sound made by a cat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
