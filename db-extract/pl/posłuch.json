                    },
                    {
                        "translation_id": "43838790-738e-44f8-8ccc-184166c4630d",
                        "source_entry_id": "cebad64e-315f-3a19-b249-d20d61f18872",
                        "source_sense_id": "c63ab535-2221-3b35-a31f-c95fac80b87a",
                        "target_lang_word": "authority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Power or right to make or enforce rules, give orders, or impose obligation; or a position having such power or right."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "122e035c-f985-4641-85b5-4be46bedaaa5",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "I have the authority to penalise the staff in my department, but not the authority to sack them."
                                            },
                                            {
                                                "example_id": "ac512b06-bbdb-4e6e-8482-149367433433",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "Vigilantes may have the power to nab criminals, but they lack the authority."
                                            },
                                            {
                                                "example_id": "9d15c18e-86e6-441d-bdaa-dc3831650964",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "She lost all respect and authority after turning up drunk at the meeting."
                                            },
                                            {
                                                "example_id": "d5ee1772-4bd8-4f6e-8a54-78a0cdf704a1",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "Respect my authority!"
                                            },
                                            {
                                                "example_id": "5de18f12-9ad1-448e-ad9c-ce284c313e9d",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "SIR PETER. Very well! ma'am very well! so a husband is to have no influence, no authority?\nLADY TEAZLE. Authority! no, to be sure—if you wanted authority over me, you should have adopted me and not married me[:] I am sure you were old enough."
                                            },
                                            {
                                                "example_id": "c0c13936-755b-4d1f-9a07-42c628108815",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "But in the meantime Robin Hood and his band lived quietly in Sherwood Forest, without showing their faces abroad, for Robin knew that it would not be wise for him to be seen in the neighborhood of Nottingham, those in authority being very wroth with him."
                                            },
                                            {
                                                "example_id": "f1e7da73-eafc-4494-8000-d16dad21cd70",
                                                "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                                                "text": "It was widely seen as an attempt to deflect attention from the Comey controversy and re-establish some authority at the briefing room podium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Persons, regarded collectively, who occupy official positions of power; police or law enforcement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dcc383b-2dd4-49e7-9fd1-667e33e45f00",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "Authorities say the suspect fled on foot."
                                            },
                                            {
                                                "example_id": "d37199d6-3d6d-4fb1-9e40-baa9a3fb504d",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            },
                                            {
                                                "example_id": "35ff4359-2ad6-4af5-a7bb-9baa89a10ccb",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "No sooner has a [synthetic] drug been blacklisted than chemists adjust their recipe and start churning out a subtly different one. These “legal highs” are sold for the few months it takes the authorities to identify and ban them, and then the cycle begins again."
                                            },
                                            {
                                                "example_id": "b9c77408-838d-4110-a500-2df52bce10df",
                                                "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                                                "text": "In China, authorities said they might soon shoot down an unidentified flying object over waters near the northern city of Rizhao, The South China Morning Post reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "A reliable, definitive source of information on a subject."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54ea73c-b27b-42ff-8958-6100c17d89ce",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "the world's foremost authority on orangutans"
                                            },
                                            {
                                                "example_id": "b0c07a43-84ed-44cc-9d7f-4a5c846f9a41",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "My cheap dictionary is not the authority on word derivations."
                                            },
                                            {
                                                "example_id": "66d14ab2-eddc-4125-90a6-072e77f6d5cc",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "To punish me for my contempt of authority, Fate has made me an authority myself."
                                            },
                                            {
                                                "example_id": "56a0fbbd-cc58-4bcb-b553-d77f1a311345",
                                                "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                                                "text": "The Egyptian crux ansata, common on Egyptian monuments and other memorials, is considered by some authorities as a triple phallus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72046ea2-1aff-3c0c-8c72-2415d404fa81",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Status as a trustworthy source of information, reputation for mastery or expertise; or claim to such status or reputation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43fe1cf8-53d6-4da3-99c7-dc72c9b390cc",
                                                "sense_id": "72046ea2-1aff-3c0c-8c72-2415d404fa81",
                                                "text": "Due to being inadequate for the deductive method of reasoning, the argument from authority is considered a logical fallacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e87c8dcc-0337-3c8d-b71c-0edc3ccda5dc",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "Official permission; authorisation to act in some capacity on behalf of a ruling entity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db9a7a38-8bed-46cb-bbda-b4dd8cdf03be",
                                                "sense_id": "e87c8dcc-0337-3c8d-b71c-0edc3ccda5dc",
                                                "text": "Authority to construct eight carriages, to test the new design in public service, had already been given; but of course complete working drawings had first to be prepared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef03008-1ff5-3c24-a979-673016a1c01d",
                                        "entry_id": "7b5d12c4-e1c5-3cf9-accb-92c9b645af7d",
                                        "glosses": [
                                            "A government-owned agency that runs a revenue-generating activity for public benefit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b8e181-3ac2-41fc-95e8-0be4c36b65b6",
                                                "sense_id": "fef03008-1ff5-3c24-a979-673016a1c01d",
