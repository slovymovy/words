                ],
                "senses": [
                    {
                        "sense_id": "95a44771-1cce-389a-99d1-8948321d8759",
                        "entry_id": "a8bbf6d2-86ae-3c7e-80dc-fd38a212e105",
                        "glosses": [
                            "licht van bewegingen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e13ece16-330b-4295-94b6-5851f2e60a99",
                                "sense_id": "95a44771-1cce-389a-99d1-8948321d8759",
                                "text": "De wufte vogels fladderden door de lentehemel."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a83a3ca-de06-3aab-91e9-c21e44eca994",
                        "entry_id": "a8bbf6d2-86ae-3c7e-80dc-fd38a212e105",
                        "glosses": [
                            "licht en oppervlakkig in overtuigingen en gedragingen, wispelturig"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "43c81f2f-2dc2-4dda-88c1-d58f08b843a8",
                                "sense_id": "3a83a3ca-de06-3aab-91e9-c21e44eca994",
                                "text": "Zoo is het wuft geslacht der zwakke stervelingen, wier hoogmoed zich verbeeldt den loop van 't lot te dwingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d21d7beb-84ae-321f-ae14-81e52570e2be",
                        "entry_id": "a8bbf6d2-86ae-3c7e-80dc-fd38a212e105",
                        "glosses": [
                            "zeer verfijnd, decadent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d467384-a2f2-4090-952b-cfa24691db76",
                                "sense_id": "d21d7beb-84ae-321f-ae14-81e52570e2be",
                                "text": "Ik liep naar de achterkamer en liet mij achterovervallen op het wufte hemelbed. Het veerde uitbundig mee, zoals alleen hotelbed den meeveren."
                            }
                        ]
                    }
                ],
