        "fr-extract.jsonl": [
            {
                "entry_id": "eaaabae1-d92b-36de-8aa4-5b5334f4f831",
                "word": "immondice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4e44356d-ce13-415a-a534-5921ad7dfaeb",
                        "entry_id": "eaaabae1-d92b-36de-8aa4-5b5334f4f831",
                        "tags": [
                            "plural"
                        ],
                        "form": "immondices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9df4056d-882c-331f-8c01-fea18db25ea8",
                        "entry_id": "eaaabae1-d92b-36de-8aa4-5b5334f4f831",
                        "glosses": [
                            "Ordure ; se dit surtout au pluriel et désigne les ordures ménagères déposées dans les rues pour y être enlevées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f0fe42f-4955-4857-97bf-67772e23e28b",
                                "sense_id": "9df4056d-882c-331f-8c01-fea18db25ea8",
                                "text": "nous eûmes beaucoup de peine à obtenir qu’on nous ouvrît la porte d’une hôtellerie, si tant est qu’on puisse appeler de ce nom un hangar ouvert de tous côtés, sans lit, sans meubles et couvert d’immondices à 20 centimètres de hauteur."
                            },
                            {
                                "example_id": "fdc8b60a-98bb-4741-985b-55ee90f9ff0b",
                                "sense_id": "9df4056d-882c-331f-8c01-fea18db25ea8",
                                "text": "Longtemps ces ruines ont été abandonnées aux habitants de la cité, qui ne se faisaient pas faute […] de se servir des tours comme de dépôts d’immondices."
                            },
                            {
                                "example_id": "317c0069-8d68-4a8e-91f0-fa0990dcfde9",
                                "sense_id": "9df4056d-882c-331f-8c01-fea18db25ea8",
                                "text": "De toute la grande ville de toile blanche, il ne reste plus maintenant qu’une vaste tache noire : toute la fange et toutes les immondices accumulées en soixante-dix jours par environ seize mille hommes et autant de bêtes."
                            }
                        ]
                    },
                    {
                        "sense_id": "877517be-b786-3c6e-832d-9c36b30265bc",
                        "entry_id": "eaaabae1-d92b-36de-8aa4-5b5334f4f831",
                        "glosses": [
                            "Dans la Bible, impureté dans laquelle les juifs tombaient, lorsqu’il leur était arrivé de toucher quelque chose d’immonde."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21504ead-af74-457f-9021-f7b3f5a75bb4",
                        "source_entry_id": "eaaabae1-d92b-36de-8aa4-5b5334f4f831",
                        "target_lang_word": "Unrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01ae3d83-c865-3e1c-950a-cab335f711a0",
                                        "entry_id": "24b180ff-6012-3a00-8233-88485a85216f",
                                        "glosses": [
                                            "Menge von Gegenständen, die zu nichts mehr verwendet werden können und den Ort, an dem sie sich befinden, verschandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3eb5a0-1344-498e-b019-310eda0eb2e1",
                                                "sense_id": "01ae3d83-c865-3e1c-950a-cab335f711a0",
                                                "text": "Wir müssen mal den Unrat von der Straße entfernen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81700e12-19b1-4fd3-a7ba-920858cff891",
                        "source_entry_id": "eaaabae1-d92b-36de-8aa4-5b5334f4f831",
                        "target_lang_word": "Abfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "der bei der Verwendung oder Verarbeitung übrig gebliebene Rest (auch im übertragenen Sinn)"
                                        ],
                                        "tags": [
                                            "Hauswirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93943d77-c0d7-454d-b396-f8f42d6c1a04",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "Kannst du bitte den Abfall nach unten bringen?"
                                            },
                                            {
                                                "example_id": "9d3b9198-1d85-446d-ae80-79daf8c8a4a7",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "Nach manchem Abfall werden wir uns recken, um Wertstoffe zu entdecken, wenn die Rohstoffe verrecken."
                                            },
                                            {
                                                "example_id": "6bb20a75-4d71-4bb5-83a2-aebc0c8469fe",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "„Die sogenannten banalen Abfälle sind mit den Haushaltsabfällen zu vergleichen, kommen jedoch aus der Industrie.“"
                                            },
                                            {
                                                "example_id": "b0f3a476-9202-4023-8b70-979afd83904c",
                                                "sense_id": "70b4cb8e-9cb6-35f5-825f-6655b3603118",
                                                "text": "„Zwischen den 1950er und 80er Jahren wurde nuklearer Abfall als günstige und einfache Lösung im Ozean verklappt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e608bef-2f29-3a93-9a4b-30a3856af408",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "das (unauffällige) Schwinden der Verbindung zu – oder die (ausdrückliche) Lossagung von – einer Lehre, Religion, politischen Partei oder Richtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5efaceb8-8939-4e0a-b96e-6340da318d0a",
                                                "sense_id": "1e608bef-2f29-3a93-9a4b-30a3856af408",
                                                "text": "Sein Meinungswandel kam einem Abfall von seinem Glauben gleich."
                                            },
                                            {
                                                "example_id": "75a630b8-28d4-47a4-97e4-f6c2c93341f3",
                                                "sense_id": "1e608bef-2f29-3a93-9a4b-30a3856af408",
                                                "text": "„O Gott, halt uns bei dieser Lehr, dem Irrtum und dem Abfall wehr!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "86fd8edc-c770-3564-9bad-2b4990e5188f",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "starke abfallende Neigung im Geländeprofil"
                                        ],
                                        "tags": [
                                            "Geländeform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94674c32-be1a-4264-bc29-7bc478aba2c0",
                                                "sense_id": "86fd8edc-c770-3564-9bad-2b4990e5188f",
                                                "text": "Dann folgt ein steiler Abfall im Gelände."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a4ad8254-f6c1-3b1f-9fc9-693c011faf50",
                                        "entry_id": "c4d2097e-0cda-3c44-848a-caaf9fc25566",
                                        "glosses": [
                                            "die Abnahme, das Geringerwerden eines Wertes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0a99d78-7d53-4f53-861f-7252aab61d16",
                                                "sense_id": "a4ad8254-f6c1-3b1f-9fc9-693c011faf50",
                                                "text": "Mit diesem Abfall der Turbinenleistung hat der Hersteller nicht gerechnet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84cd8590-06ef-43d8-9843-4ae14f2af784",
                        "source_entry_id": "eaaabae1-d92b-36de-8aa4-5b5334f4f831",
                        "target_lang_word": "Müll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                        "entry_id": "eb4bb5b2-1f7a-3ac4-9654-5a7862ab831e",
                                        "glosses": [
                                            "gemischte Abfälle, wertlose Abfallmischung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58439a12-b349-44b6-bfdb-39e1a06bb57c",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "Müll entsteht erst dadurch, dass verschiedene Abfälle zusammengeworfen werden und dann wegen ihrer gegenseitigen Verschmutzung nur noch schwer verwertbar sind."
                                            },
                                            {
                                                "example_id": "ddc0e66b-f6fd-46c7-8ae9-f444a43d5ad2",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "„Wirklich sah ich sie, schon halb von Müll bedeckt, im Ascheneimer liegen, und dieser Anblick flößte mir Unbehagen ein.“"
                                            },
                                            {
                                                "example_id": "c6d53f62-7b42-4130-a985-e2d5fb54f893",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "„Ich habe zum Beispiel wie andere Kinder auch im Park meinen Müll einfach in die Gegend geworfen.“"
                                            },
                                            {
                                                "example_id": "ec616455-671b-45d3-9e8a-333334bedc53",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "„Er roch immer noch nach Müll, den er bis kurz davor aus den Mülldeponien des Ortes entfernt hatte, aber das schien ihn nicht zu stören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de660a3b-8505-3547-959d-97a6e24ebe1e",
                                        "entry_id": "eb4bb5b2-1f7a-3ac4-9654-5a7862ab831e",
                                        "glosses": [
                                            "Unsinn"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745faee3-8460-418c-998d-70447bc658f0",
                                                "sense_id": "de660a3b-8505-3547-959d-97a6e24ebe1e",
                                                "text": "Er redet nur noch Müll."
                                            },
                                            {
                                                "example_id": "a44dd9d1-623c-43bb-9660-6c00f3413a8b",
                                                "sense_id": "de660a3b-8505-3547-959d-97a6e24ebe1e",
                                                "text": "Sein Posteingang ist voller Müll."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
