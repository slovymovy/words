                "senses": [
                    {
                        "sense_id": "1010b0c0-8252-3d36-951f-105e18e1ee9a",
                        "entry_id": "22336ba5-cbcb-3252-bf17-6d99d598fce0",
                        "glosses": [
                            "Geldbetrag, der gemäß dem Erneuerbare-Energien-Gesetz von Stromverbrauchern gezahlt werden muss"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "906848d5-0e5e-4022-9c67-205e94902c4f",
                                "sense_id": "1010b0c0-8252-3d36-951f-105e18e1ee9a",
                                "text": "„FDP-Fraktionschef Christian Dürr sprach sich dafür aus, die so genannte EEG-Umlage bis zum Herbst einzustellen.“"
                            },
                            {
                                "example_id": "2ce02d9d-dfc5-4026-b815-ca14aea5c366",
                                "sense_id": "1010b0c0-8252-3d36-951f-105e18e1ee9a",
                                "text": "„Die EEG-Umlage soll mit Mitteln aus der CO2-Abgabe deutlich gesenkt und Strom günstiger werden.“"
                            },
                            {
                                "example_id": "cf5186ea-0a5e-4677-8daf-385b4bdc8d92",
                                "sense_id": "1010b0c0-8252-3d36-951f-105e18e1ee9a",
                                "text": "„Finanziell wäre die Abschaffung des Zuschlags für Ökostrom, die EEG-Umlage, schon jetzt ohne Probleme möglich.“"
                            },
                            {
                                "example_id": "cdbdf63f-3878-42de-b489-80d62ccace7c",
                                "sense_id": "1010b0c0-8252-3d36-951f-105e18e1ee9a",
                                "text": "„Dazu soll die EEG-Umlage auch 2023 und 2024 mit Mitteln aus dem Bundeshaushalt stabilisiert werden, wie die Verhandlungsführer von Union und SPD am Donnerstag der Deutschen Presse-Agentur mitteilten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
