                                    }
                                ]
                            },
                            {
                                "target_word": "romain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8627e977-9694-30db-9b47-1ebcc39e5274",
                                        "entry_id": "73c69dec-a80d-3887-a689-a768b9178cfb",
                                        "glosses": [
                                            "Race de très gros pigeons, originaires de France (Île-de-France) ou d’Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733ca341-ff5a-408a-af03-4ab08bc07a68",
                                                "sense_id": "8627e977-9694-30db-9b47-1ebcc39e5274",
                                                "text": "Qu’est-ce qu’un romain ? C’est le plus grand pigeon au monde, 1,25 kg, 55 à 60 cm de long et plus d’un mètre d’envergure."
                                            },
                                            {
                                                "example_id": "3dfef52f-8acc-4ab0-82cf-2b0a85305dde",
                                                "sense_id": "8627e977-9694-30db-9b47-1ebcc39e5274",
                                                "text": "Le romain est la plus grande race de pigeons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
