        "fr-extract.jsonl": [
            {
                "entry_id": "b69f569d-070a-3acb-a5b8-5545d36aec5e",
                "word": "lentisque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "24c2479b-1bb0-414e-af7d-6e8ef68d4918",
                        "entry_id": "b69f569d-070a-3acb-a5b8-5545d36aec5e",
                        "tags": [
                            "plural"
                        ],
                        "form": "lentisques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
                        "entry_id": "b69f569d-070a-3acb-a5b8-5545d36aec5e",
                        "glosses": [
                            "Arbrisseau qui croît dans le Midi et en Italie et dont on tire la résine connue sous le nom de mastic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f5e441-3be4-416e-9fec-e2b0bf11fb75",
                                "sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
                                "text": "Entre les hauts-plateaux et les massifs montagneux de l'intérieur et le sahel côtier, où les steppes de palmiers nains alternaient avec de vastes maquis de lentisques, de jujubiers, de myrtes et de genêts, les plaines subatlantiques déployaient leur immense paillasson poussiéreux, […]."
                            },
                            {
                                "example_id": "a694d28b-fe98-4e05-9c07-ab59e0ae94fc",
                                "sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
                                "text": "Le lentisque ou pistachier lentisque ou arbre au mastic a des feuilles persistantes."
                            },
                            {
                                "example_id": "7a38e920-8a14-4442-a7ef-9eb004622de6",
                                "sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
                                "text": "[…] le voyageur qui demande son chemin, et ne sollicite qu’un verre d’eau mais cache peut-être sous des habits poussiéreux, imbibés de l’odeur âcre des lentisques, les blessures du fuyard."
                            },
                            {
                                "example_id": "abbdef01-e935-481c-b0c9-d2561077425b",
                                "sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
                                "text": "Comme j’étais bien là-haut, couché dans une niche de rocher, au milieu des genévriers et des lentisques, plantes maigres et rabougries des sommets, — seul, bien loin des hommes, à l’extrême pointe de la plus haute montagne de Baozich."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2c7e905-8b51-4a63-87a7-01a1ace1ce6b",
                        "source_entry_id": "b69f569d-070a-3acb-a5b8-5545d36aec5e",
                        "source_sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
                        "target_lang_word": "Mastixstrauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c0e11663-ba74-4227-a65e-7b0f261fe724",
                        "source_entry_id": "b69f569d-070a-3acb-a5b8-5545d36aec5e",
                        "source_sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
                        "target_lang_word": "mastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c29a477-717e-3222-ad04-38253a5878f4",
                                        "entry_id": "e14901d8-cda1-3e5b-96ec-5da5b87430e9",
                                        "glosses": [
                                            "An evergreen shrub or small tree, Pistacia lentiscus (mastic tree), native to the Mediterranean."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b414c93-6459-4f51-8b9a-7602ac0d0a79",
                                                "sense_id": "4c29a477-717e-3222-ad04-38253a5878f4",
                                                "text": "The island of Scio is now called by the Greeks Kio [Χιο], the antient Greek name of it was Chios [Χιος]; it was first called Ætalia in very antient times, and also Mastic, on account of the great number of mastic trees that were in this island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f4694a3-cbf6-373f-9c12-ebfb0274bb57",
                                        "entry_id": "e14901d8-cda1-3e5b-96ec-5da5b87430e9",
                                        "glosses": [
                                            "A hard, brittle, aromatic and transparent resin produced by this tree and used to make varnishes and chewing gum, and as a flavouring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fcd1969-bc59-4dca-b307-5f6f212105fe",
                                                "sense_id": "5f4694a3-cbf6-373f-9c12-ebfb0274bb57",
                                                "text": "The mastic, of which the people of Scio gather every year an incredible quantity, is a very rich gum, made use of in medicines, which distils from a shrub called, in Latin, Lentiscus."
                                            },
                                            {
                                                "example_id": "4c58012d-b1a7-40a0-94e3-2f62e7fc6b7e",
                                                "sense_id": "5f4694a3-cbf6-373f-9c12-ebfb0274bb57",
                                                "text": "Having taken upon me to order the repast, and knowing that Lord Byron, for the last two days, had done nothing towards sustenance, beyond eating a few biscuits and (to appease appetite) chewing mastic, I desired that we should have a good supply of, at least, two kinds of fish."
                                            },
                                            {
                                                "example_id": "c2a50c74-7106-49ee-9cbf-6d5aea4c1a04",
                                                "sense_id": "5f4694a3-cbf6-373f-9c12-ebfb0274bb57",
                                                "text": "1834, James Augustus St. John, Egypt and Mohammed Ali, or Travels in the Valley of the Nile, London: Longman, Rees, Orme, Brown, Green & Longman, Volume I, Chapter 132, pp. 322-323,\n[…] in many harems, the women are in the habit of burning mastic on a small chaffing-dish, and holding the mouth of the jars over the smoke; by which means they communicate to them a scent which perfumes the water for eight or ten days, at the expiration of which the operation must be repeated."
                                            },
                                            {
                                                "example_id": "3193376d-91c1-4ed9-ab91-3897cb0db0d5",
                                                "sense_id": "5f4694a3-cbf6-373f-9c12-ebfb0274bb57",
                                                "text": "Aromatics were used, too, especially in necromancy, and an old recipe of that sort comprises Musk, Myrrh, Frankincense, Red Storax, Mastick, Olibanum, Saffron, Benzoin and Labdanum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021cf68f-1c94-3d90-97c0-964d7e4ac9fd",
                                        "entry_id": "e14901d8-cda1-3e5b-96ec-5da5b87430e9",
                                        "glosses": [
                                            "An alcoholic liquor flavoured with this resin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7edc21ba-3888-428e-a9b8-6d255097dd54",
                                                "sense_id": "021cf68f-1c94-3d90-97c0-964d7e4ac9fd",
                                                "text": "He took a list from the desk and read aloud Fatima’s offerings:— […] four bottles of rare mastic from Scio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05175fc-d3ee-3158-92f0-7ae3a0bd7879",
                                        "entry_id": "e14901d8-cda1-3e5b-96ec-5da5b87430e9",
                                        "glosses": [
                                            "Any of various cements, usually flexible and waterproof, used as an adhesive, sealant, caulk, or filler."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "English",
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa1bb03-f498-4fad-8334-774eabd0b624",
                                                "sense_id": "d05175fc-d3ee-3158-92f0-7ae3a0bd7879",
                                                "text": "‘They have a few holes here and there. A few. Tiny tiny.’ ‘We could fix those up easy. Mastic cement. Not expensive, boss.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b419d328-0dcb-4196-9082-6acf55929c21",
                        "source_entry_id": "b69f569d-070a-3acb-a5b8-5545d36aec5e",
                        "source_sense_id": "30069970-d548-3213-a2eb-3cadd803d13e",
