                    },
                    {
                        "sense_id": "baebdb4d-298d-3250-95c7-70d14c4fa183",
                        "entry_id": "9e255368-4791-3741-b6cb-b8c8f13b3807",
                        "glosses": [
                            "Qui élimine les effets indésirables des rebonds mécaniques se produisant au sein des interrupteurs, commutateurs, relais, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf84b99-feea-4e65-96e8-0c2617ac1fbe",
                                "sense_id": "baebdb4d-298d-3250-95c7-70d14c4fa183",
                                "text": "Les franchissements du faisceau IR sont enregistrés et comptés par un microcalculateur au moyen d'une carte interface TOR munie d'un système antirebond."
                            },
                            {
                                "example_id": "3484eff2-0f07-4d1f-8a90-ecf9bfd6cdff",
                                "sense_id": "baebdb4d-298d-3250-95c7-70d14c4fa183",
                                "text": "Les interrupteurs pourront être de deux natures, les plus simples se contentant du rustique contact mécanique, mais il sera souvent nécessaire de disposer d’interrupteurs antirebonds qui n'envoient qu'une impulsion par mouvement de la partie mécanique […]."
                            }
                        ]
                    }
