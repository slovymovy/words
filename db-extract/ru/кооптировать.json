                "senses": [
                    {
                        "sense_id": "21a8cb15-84cc-3a4c-b58d-698e55c7e4f2",
                        "entry_id": "3b1c9213-745b-35dd-a4d9-4c21d90e7597",
                        "glosses": [
                            "книжн. производить (произвести) кооптацию, включать (включить) кого-либо куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88734321-46d7-4c49-aa5c-6ddd25b0f31f",
                                "sense_id": "21a8cb15-84cc-3a4c-b58d-698e55c7e4f2",
                                "text": "Кооптировать ещё двух членов в президиум."
                            },
                            {
                                "example_id": "b3f4b688-cf01-45b6-8762-19ca3d946751",
                                "sense_id": "21a8cb15-84cc-3a4c-b58d-698e55c7e4f2",
                                "text": "Через четыре месяца после приезда из России Ленин высоко оценил его деятельность, Троцкий, по его предложению, был кооптирован в редакцию «Искры»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29e2f2b3-6af9-4456-9a2b-d4ae9639a88b",
