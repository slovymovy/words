                "senses": [
                    {
                        "sense_id": "b432c9d7-7dd3-334d-9556-e57efa7bc2a1",
                        "entry_id": "8ee2768f-11b9-38ad-817a-022b85de8a06",
                        "glosses": [
                            "związany z pirotechniką, dotyczący pirotechniki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe17b5c-1bed-450c-b6ac-1e9088cc41ee",
                                "sense_id": "b432c9d7-7dd3-334d-9556-e57efa7bc2a1",
                                "text": "Sylwester za pasem, już teraz jak grzyby po deszczu wyrastają sklepy i stragany z petardami, w pogoni za zyskiem handlowcy zapominają o obowiązującym zakazie sprzedaży artykułów pirotechnicznych nieletnim […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eeeb705-8e92-47ff-ade8-a841b62f6d5d",
                        "source_entry_id": "8ee2768f-11b9-38ad-817a-022b85de8a06",
                        "source_sense_id": "b432c9d7-7dd3-334d-9556-e57efa7bc2a1",
                        "target_lang_word": "pyrotechnic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrotechnic",
