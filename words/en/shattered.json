                {
                    "sense_id": "e27919a2-3fe1-3fbf-83dc-49b8e91857c6",
                    "sense_definition": "Extremely tired or exhausted.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tired",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was completely <w>shattered</w> after working for twelve hours straight.",
