                "translations": [
                    {
                        "translation_id": "4978a53a-969c-456f-bd7d-a692fcb474b9",
                        "source_entry_id": "67938bf3-bb4e-33d6-8f58-0141b7322655",
                        "source_sense_id": "cd063235-48f8-3d40-a432-7673ea281fe2",
                        "target_lang_word": "scrooge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d159afbc-2f2e-3c41-af6a-701436de023f",
                                        "entry_id": "d374e040-2de6-3684-884f-97b06e09dce7",
                                        "glosses": [
                                            "A miserly person; a person with an excessive dislike of spending money or other resources."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a197ea4-ba44-33ab-ade4-54ed3b3b1ec6",
                                        "entry_id": "d374e040-2de6-3684-884f-97b06e09dce7",
                                        "glosses": [
                                            "A person who is grumpy about the Christmas holidays."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                        "entry_id": "fa2491b8-0f5c-3b0c-98b2-fdc47cf54954",
                                        "glosses": [
                                            "To behave in a greedy or miserly way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf0513e-f302-408d-a1ba-d793b84ebeb2",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "Mr. Chairman, $6 million is 15 times more than what the President earns and 30 times more than what a Cabinet Secretary earns. The Christmas Eve announcement of these bonuses was greeted by one commentator by saying the taxpayers got scrooged."
                                            },
                                            {
                                                "example_id": "14cbf64c-3689-4642-9799-8bbe915484a8",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "He went back to live in Clayton with dad and tearfully explained to him about Aunt Eliza and her mean, scrooging ways."
                                            },
                                            {
                                                "example_id": "7182cde4-01c7-472d-8c3e-59b1042e80c7",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "[…]corporations scrooging their way out of paying taxes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d94771af-9e61-37fb-a879-d17fe27c4b8b",
                                        "entry_id": "bad5880a-df74-32fa-a721-d97e7a706008",
                                        "glosses": [
                                            "To crush or press; to squeeze (past, into, together, etc.)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9549be-0ea4-419b-9a8c-f9c779cf31a5",
                                                "sense_id": "d94771af-9e61-37fb-a879-d17fe27c4b8b",
                                                "text": "So he scraped and scratched and scrabbled and scrooged, then he scrooged again[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "889e26c6-16a6-4791-87d1-097b154e6cc1",
                        "source_entry_id": "67938bf3-bb4e-33d6-8f58-0141b7322655",
                        "source_sense_id": "cd063235-48f8-3d40-a432-7673ea281fe2",
                        "target_lang_word": "miser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A person who hoards money rather than spending it; one who is cheap or extremely parsimonious."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822ca7c1-2233-43c6-b926-ba32d3eb82e0",
                                                "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                                "text": "Scrooge was a typical miser: spending nothing he could save, nor enjoying his wealth."
                                            },
                                            {
                                                "example_id": "c8cef956-1b71-4309-9b58-15d22c55db0e",
                                                "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                                                "text": "[…] foꝛ it was many times notoꝛious vnto al mẽ, yͭ he did eate in his houſe no other fleſh by the ſpace of iii. dayes, but on Hare, whiche was ſent him. He was ſuch a miſer to ſpend, ⁊ ſo deſirous to hooꝛd and lay vp money, yͭ had it not béene foꝛ ſome dayes of ſacrifices, oꝛ his bidden gueſts, not a moꝛsel of fleſh was eaten in his houſe: but only fed of his pꝛouiſion from his garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fe9fbe5-d866-326e-a440-e65ccbd84f65",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A person who is wretched or despicable; a wretch."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea836c9-a3a7-4657-988d-934f44bcb219",
                                                "sense_id": "0fe9fbe5-d866-326e-a440-e65ccbd84f65",
                                                "text": "[…] a poore virgin ſir, an il-fauor’d thing ſir, but mine owne, a poore humour of mine ſir, to take that that no man elſe will: rich honeſtie dwels like a miſer ſir, in a poore houſe, as your Pearle in your foule oyſter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e32750-4847-395e-aa4a-abf1e8921556",
                                        "entry_id": "4bbb441a-159c-3f44-9c0d-854e8ea78102",
                                        "glosses": [
                                            "A kind of earth auger, typically large-bored and often hand-operated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fca5b979-ffa1-491d-9dd7-54abb3761a89",
                        "source_entry_id": "67938bf3-bb4e-33d6-8f58-0141b7322655",
                        "source_sense_id": "cd063235-48f8-3d40-a432-7673ea281fe2",
                        "target_lang_word": "harpagon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harpagon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ded1549-8af5-3ecb-b4bb-104f5a495f17",
                                        "entry_id": "d333c14a-6dac-304c-883c-fada67f4b00d",
                                        "glosses": [
                                            "Avare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c66703-3a84-46ea-97ac-c97ec0ad1aea",
                                                "sense_id": "5ded1549-8af5-3ecb-b4bb-104f5a495f17",
                                                "text": "Les liasses d’assignats grossissaient dans les malles, et, comme tous ceux à qui échoit ce don terrible, il avait commencé à devenir ennuyeux, inaccessible à tout, l’or mis à part, un harpagon sans rime ni raison, un accumulateur dénué de scrupule, et on le voyait déjà prêt à devenir l’un de ces êtres étranges qui sont si nombreux dans notre monde insensible, et lequel provoquent^([sic]) l’horreur de l’homme au cœur vivant, lequel les voit comme des tombes de marbre ambulantes avec un cadavre à la place du cœur."
                                            },
                                            {
                                                "example_id": "83d92b3a-b269-46e0-ae03-2c8491ade6a1",
                                                "sense_id": "5ded1549-8af5-3ecb-b4bb-104f5a495f17",
                                                "text": "C'est ainsi qu'on peut dire encore que les gauchistes, qui en principe ou en apparence s'éloignent du Seigneur de l'univers sont avec leurs efforts pour servir les classes ouvrières dans le besoin d'une aide, plus près de Dieu que ces harpagons qui ne pensent qu'à augmenter leurs fortunes."
                                            },
                                            {
                                                "example_id": "98ca9ce6-e565-47f6-b03a-dceb6d72c4ac",
                                                "sense_id": "5ded1549-8af5-3ecb-b4bb-104f5a495f17",
                                                "text": "Les calculs de réserves en fin de parcours sont faits par des harpagons, quelle misère, quelques tonnes à NYC, il suffit d'un peu de mauvais temps et d'un peu trop de trafic vers l'aéroport de dégagement pour que ça devienne tangent […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0619270e-928e-44a3-940e-08c1ebb03fc7",
                        "source_entry_id": "67938bf3-bb4e-33d6-8f58-0141b7322655",
                        "source_sense_id": "cd063235-48f8-3d40-a432-7673ea281fe2",
                        "target_lang_word": "Geizhals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geizhals",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                        "entry_id": "f0115770-e4cc-38df-a492-9d420a10d5d7",
                                        "glosses": [
                                            "sehr geizige Person; jemand, der sehr wenig Neigung hat, anderen etwas zu geben oder überhaupt etwas auszugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c71237f-fb21-4ec1-abb2-66ad11217301",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "Dieser Geizhals hat uns in unserer Notlage nicht mal 50 Cent zum Telefonieren gegeben!"
                                            },
                                            {
                                                "example_id": "4b5e09e8-e354-4715-aa58-d97aad856730",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Beinahe wöchentlich stand der Gerichtsvollzieher vor der Tür, um etwas zu pfänden, immer wieder drohte der Rauswurf aus den Wohnungen – vielleicht mit ein Grund, warum mein Vater zeitlebens so erpicht darauf war, Reichtümer anzuhäufen und dennoch lebte wie ein Geizhals, der sich nur das Nötigste gönnte.“"
                                            },
                                            {
                                                "example_id": "4bd5820d-b94f-4edc-82e9-86637af32d68",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Alles ist hier schön an seinem Ort, Hoffmann führt Regie, und wir spüren, daß es ihm sehr viel leichter fällt, einen Maler einen alten Geizhals prellen zu lassen, als einer vornehmen französischen Dame eine Moralpredigt in den Mund zu legen.“"
                                            },
                                            {
                                                "example_id": "d6625696-6dbe-4bf1-8516-ad4165a1de90",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Der Sohn eines Geizhalses ist verschwenderisch, der Sohn eines Verschwenders ist geizig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
