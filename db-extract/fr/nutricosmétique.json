                    {
                        "sense_id": "26e03166-2328-3d5a-9933-f6a1c88680f3",
                        "entry_id": "0bc1a78f-ed2a-312d-846e-0920a5d0fd76",
                        "glosses": [
                            "Fait de nourrir son corps de l'intérieur en ingérant des aliments riches en nutriments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee08d9f7-b566-4474-ac04-28d03114f3fc",
                                "sense_id": "26e03166-2328-3d5a-9933-f6a1c88680f3",
                                "text": "La nutricosmétique tente de nous convaincre : la beauté passe aussi par l'assiette !"
                            },
                            {
                                "example_id": "f17c84c4-274b-49aa-9cfb-155f75a2107b",
                                "sense_id": "26e03166-2328-3d5a-9933-f6a1c88680f3",
                                "text": "Merci à Marie-Josée Deck, créatrice de Maison d’Or, formatrice et intervenante en nutricosmétique et aromathérapie, auprès de qui je me fais un plaisir d’enrichir mes connaissances."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24d772bd-d5eb-42a8-8bc3-74a4cf59b02b",
                        "source_entry_id": "0bc1a78f-ed2a-312d-846e-0920a5d0fd76",
                        "source_sense_id": "26e03166-2328-3d5a-9933-f6a1c88680f3",
                        "target_lang_word": "nutricosmetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutricosmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "669b556c-4de9-3956-ba84-337868be3c6c",
                                        "entry_id": "a5ceb279-500d-3e89-8b91-9a04f328860d",
                                        "glosses": [
                                            "A dietary supplement, food or beverage with additives that are marketed as having medical benefits that enhance appearance, especially skin, nails, and hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8866ac0-c382-4c9b-ae0b-c996139c0919",
                                                "sense_id": "669b556c-4de9-3956-ba84-337868be3c6c",
                                                "text": "Before rushing out to buy nutricosmetics, though, don't forget that the first place a food supplement goes is into your stomach, which is loaded with strong acid and enzymes to digest protein and dissolve fats."
                                            },
                                            {
                                                "example_id": "5143b407-03c8-4a5b-8fc4-8b9b6445db3a",
                                                "sense_id": "669b556c-4de9-3956-ba84-337868be3c6c",
                                                "text": "Incorporating marine proteoglycans as a nutricosmetic in skin capsules is said to boost collagen, help strengthen cell cohesion, and improve skin density, creating firmer skin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nutricosmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54e64715-ce9d-397b-a6dc-e65ce872c27d",
                                        "entry_id": "8ca27e2f-2e81-3878-9047-4f2b1799c8b7",
                                        "glosses": [
                                            "Of or pertaining to nutricosmetics."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cd7f8d4-d8f7-4573-a5db-2de9ef492870",
                                                "sense_id": "54e64715-ce9d-397b-a6dc-e65ce872c27d",
                                                "text": "However, many nutricosmetic products are considered effective due to the historical use and word of mouth. Comprehensive analysis of the global nutricosmetics market is conducted considering form, end-user applications, and some product components such as collagen, peptides, proteins, vitamins, carotenes, minerals, and omega-3 fatty acid are reported."
                                            }
                                        ]
                                    }
                                ]
                            }
