                "senses": [
                    {
                        "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                        "entry_id": "b7b462d7-45de-311f-b712-0ab4a3a40d7f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74300289-203d-4b84-91ff-5f96d7528f7a",
                                "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                                "text": "Frau Spohn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5412a5e7-65d2-4745-875e-f4de99565e98",
                                "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                                "text": "Herr Spohn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5ffa7c63-5772-4f22-84ec-7060d46e01a3",
                                "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                                "text": "Die Spohn fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d2a29e71-0bbf-41ab-baec-c1dcd171793e",
                                "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                                "text": "Der Spohn trägt nie die Schals, die die Spohn ihm strickt."
                            },
                            {
                                "example_id": "f009e33f-fa20-4991-90b6-6adfd6c4ec57",
                                "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Spohn kommt, geht der Herr Spohn.“"
                            },
                            {
                                "example_id": "191562e0-c640-4e39-b476-a7a924da5822",
                                "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                                "text": "Spohn kommt und geht."
                            },
                            {
                                "example_id": "5eb2b0fb-cca7-4e82-83ca-7b7eb0451f56",
                                "sense_id": "e4ead6bb-d50d-3b2f-942a-1d309fbf4150",
                                "text": "Spohn kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
