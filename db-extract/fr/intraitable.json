                "word": "intraitable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63b2810c-5770-406f-8d69-9fd31f1c2cf1",
                        "entry_id": "6ec36910-fb79-3fb5-8f02-a0be50046e95",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "intraitables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b604352b-7972-3c3d-8af0-64b13ff01fa8",
                        "entry_id": "6ec36910-fb79-3fb5-8f02-a0be50046e95",
                        "glosses": [
                            "Que l'on ne peut pas traiter."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "f36a65e2-b129-415d-9de2-2028b3e31a0a",
                                "sense_id": "b604352b-7972-3c3d-8af0-64b13ff01fa8",
                                "text": "La fusion de l'acier pour qu'il ait les qualités qu'on recherche ne peut se faire avec un flux où il entre des matières charbonneuses; celles-ci dans la fusion le rendent intraitable."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9ee3817-43ec-3a88-87f8-b6e52ebf38d4",
                        "entry_id": "6ec36910-fb79-3fb5-8f02-a0be50046e95",
                        "glosses": [
                            "Caractéristique d'une personne avec laquelle il est impossible de négocier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1d1a0b7-b417-45ef-a069-dec5ef6a61e7",
                                "sense_id": "d9ee3817-43ec-3a88-87f8-b6e52ebf38d4",
                                "text": "Le percepteur est un homme vraiment intraitable dans l'exercice de ses ponctions."
                            },
                            {
                                "example_id": "9ba808ce-f357-4ee7-abe1-04ad5b251f33",
                                "sense_id": "d9ee3817-43ec-3a88-87f8-b6e52ebf38d4",
                                "text": "[…] elle avait été provisoirement habillée par une des femmes de chambre de madame de Noailles, cette dame d’honneur intraitable que la dauphine appelait madame l’Étiquette."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d94e6e5-8ca4-39bf-826e-6e0addb9f7d1",
                        "entry_id": "6ec36910-fb79-3fb5-8f02-a0be50046e95",
                        "glosses": [
                            "À qui on ne peut faire entendre raison sur quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4cb306-cec8-4ee2-a709-9ad3c76c3098",
                                "sense_id": "6d94e6e5-8ca4-39bf-826e-6e0addb9f7d1",
                                "text": "Il est intraitable sur ce point."
                            }
                        ]
                    },
                    {
                        "sense_id": "36844605-872a-35e7-b0da-25c3d6a94787",
                        "entry_id": "6ec36910-fb79-3fb5-8f02-a0be50046e95",
                        "glosses": [
                            "Qui semble se refuser de se plier à la volonté humaine."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a2547e88-5b4e-4a69-84b0-6044e2418c10",
                                "sense_id": "36844605-872a-35e7-b0da-25c3d6a94787",
                                "text": "Il revoit cet adolescent aux lunettes démodées, aux cheveux intraitables, aux dents grotesques, à qui presque personne ne parlait …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed0e0f8b-64c0-42b4-afe3-f75d7d78f947",
                        "source_entry_id": "6ec36910-fb79-3fb5-8f02-a0be50046e95",
