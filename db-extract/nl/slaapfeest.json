                        "entry_id": "f18dad38-f756-3fbd-84c2-50bf0ba4dbeb",
                        "glosses": [
                            "feestelijke bijeenkomst waarbij de feestvierders blijven overnachten op de plaats van het feest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a7b49c-257a-457e-b118-ad1d147dbed0",
                                "sense_id": "c4b735ad-8901-3c09-b5c3-75fc6e6300f6",
                                "text": "Ik ben vanavond alleen met hem, want Caroline heeft haar langverwachte slaapfeestje met de meisjes uit haar klas en is niet thuis."
                            },
                            {
                                "example_id": "37be14e9-184e-435c-ac5b-273d49ce8c9f",
                                "sense_id": "c4b735ad-8901-3c09-b5c3-75fc6e6300f6",
                                "text": "Ik passeer de woning waar Caroline haar slaapfeestje viert."
                            },
                            {
                                "example_id": "4bcac711-1f56-4853-baeb-7e25dffebb45",
                                "sense_id": "c4b735ad-8901-3c09-b5c3-75fc6e6300f6",
                                "text": "Daarom meldde ik me ook als vrijwilliger om het slaapfeestje van Caroline en haar vriendinnen op Hoeve Bonnet te organiseren."
                            }
                        ]
                    }
