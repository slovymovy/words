                    },
                    {
                        "translation_id": "128d89a7-c8cc-4939-90f7-80fea712f01b",
                        "source_entry_id": "cd79e27d-4b25-3a4b-bcc3-88f793cbf969",
                        "source_sense_id": "5e7a1a2d-6fc4-3d04-8d86-7b0aff26556c",
                        "source_sense_description": "het vriendelijk en gastvrij zijn",
                        "target_lang_word": "tenderness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenderness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A tendency to express warm, compassionate feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00d6ff4-4459-4112-9015-bd7211d76a3b",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "When the lovers were together, their cold indifference gave way to love and tenderness."
                                            },
                                            {
                                                "example_id": "d2b3be4e-dbac-4f9f-a68a-7c1c5ddca360",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "I had known him jealous, suspicious; I had seen about him certain tendernesses, fitfulnesses—a softness which came like a warm air, and a ruth which passed like early dew, dried in the heat of his irritabilities: this was all I had seen."
                                            },
                                            {
                                                "example_id": "1b8b6812-4d12-404a-bc6b-813fbeec3c94",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "Love me, try to be understanding / Tenderness is all that I'm asking / Don't feel like I'm making conditions / I want to overcome my inhibitions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A concern for the feelings or welfare of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c4063b-7cf4-47f6-b543-2c383550d5cb",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "When they saw the poor orphans, they were overwhelmed with tenderness for them."
                                            },
                                            {
                                                "example_id": "e414184b-6466-4038-a4d3-88bcac8bd1e6",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Everybody needs a little tenderness sometimes."
                                            },
                                            {
                                                "example_id": "28b2fa57-649a-483c-800d-1ed4add66bbe",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Quiet people too, for I think that about this time a sort of remorseful tenderness comes over the bullies and the nagsters, so that they go about gently and deprecatingly, hoping by one day's record sweetness to outface the year's blusterings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A pain or discomfort when an affected area is touched."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84d9696-ee46-4e78-9355-6b630d3836ca",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "He noted her extreme tenderness when he touched the bruise on her thigh."
                                            },
                                            {
                                                "example_id": "d84c563c-bca3-4ab2-80ce-6ac815af45fb",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "Amies Oelschlager said in a statement that oral contraceptives that contain estrogen may cause side effects such as headaches, nausea, and breast tenderness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e6a031b-a00d-422c-81d3-2326ec9a5f2f",
                        "source_entry_id": "cd79e27d-4b25-3a4b-bcc3-88f793cbf969",
                        "source_sense_id": "5e7a1a2d-6fc4-3d04-8d86-7b0aff26556c",
                        "source_sense_description": "het vriendelijk en gastvrij zijn",
                        "target_lang_word": "hospitality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospitality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The act or service of welcoming, receiving, hosting, or entertaining guests; an appropriate attitude of openness, respect, and generosity toward guests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "199fb305-dccb-4a5a-abd2-988bd8fd5a1e",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "Please thank our hosts for their hospitality during the week that we stayed."
                                            },
                                            {
                                                "example_id": "60075b7c-1227-4f68-b1fa-491e92318fea",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "\"Quarrels!\" said Charles; \"do not use so disagreeable a word. I am thinking of nothing but the thanks I owe Lord Avonleigh for his hospitality\"—Lord Avonleigh bent to the very edge of the table—\"and the favours I am about to ask.\""
                                            },
                                            {
                                                "example_id": "02d94b7c-4fae-457d-90d5-8e622c6acfa3",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "In Ancient Times, as Story tells, / The Saints would often leave their Cells, / And ſtrole about, but hide their Quality, / To try good Peoples Hoſpitality."
                                            },
                                            {
                                                "example_id": "48ae4569-51bb-4d8e-a22d-bb9beb762db3",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "Mr Venus, reminded of the duties of hospitality, produced some rum."
                                            },
                                            {
                                                "example_id": "91c88941-3df6-4ac8-85f8-8e134cffdd46",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "We were over the border here, into Northern Ireland, and the post office had a very English atmosphere. It was pleasant, too, much as we enjoyed the hospitality of the Republic, to be buying stamps with the Queen's head on them, and to be posting our cards in a red pillar-box, instead of a green one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bc7237-395f-3d82-a39a-1dd6627df7bf",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The business of providing catering, lodging and entertainment service; the industry which includes the operation of hotels, restaurants, and similar enterprises."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "371af1a1-fab0-4f66-9d1f-7b221636cbaa",
                                                "sense_id": "43bc7237-395f-3d82-a39a-1dd6627df7bf",
                                                "text": "After graduating from college, she found a job in hospitality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36342425-22c3-37f5-8837-ef17c6e80314",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The food, drink, and entertainment given to customers by a company or organization or provided to visitors by a private host."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
