                        "examples": [
                            {
                                "example_id": "b9e31419-286d-4f25-8d70-0d55ab70040a",
                                "sense_id": "5ad5d32a-fc45-3e79-ba6e-953da0bb1787",
                                "text": "Moi dziadkowie uczestniczyli w przedwojennym ruchu spółdzielczym."
                            }
