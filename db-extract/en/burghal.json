                        "glosses": [
                            "Relating to a burgh or borough."
                        ],
                        "tags": [
                            "UK",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f30b46f3-88bf-492a-a9fe-4d6c53fea47a",
                                "sense_id": "7024b6cb-c28a-3eb5-a644-e3bdfe04cc17",
                                "text": "In Scotland, parishes are either burghal, i.e. those comprised wholly within a burgh royal; landward, those forming a rural district; or mixed, i.e. a burgh with a rural district attached."
                            },
                            {
                                "example_id": "fd22f0ba-ca73-4400-a20e-533e486957d6",
                                "sense_id": "7024b6cb-c28a-3eb5-a644-e3bdfe04cc17",
                                "text": "There is a pleasant smell of cooking about, and a hum of compact and contented life. Add the excitement of an election, and you have that busy burghal hive which is the basis of all human society—a snug little commune intent on its own affairs, a world which for the moment owes allegiance to no other."
                            },
                            {
                                "example_id": "0487253a-9e53-4b80-9a13-2a7bd138edde",
                                "sense_id": "7024b6cb-c28a-3eb5-a644-e3bdfe04cc17",
                                "text": "It is true that Frome is not called a borough, nor are burgesses recorded for it, but the payment of the ‘third penny’ suggests burghal status […]"
                            }
                        ]
                    }
