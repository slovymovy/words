{
    "word_family": [
        "hearthstone",
        "hearthside"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2dc7eb1-9480-33b9-8933-3e067399cc8f",
                    "sense_definition": "Home or family life, representing the warmth and security of the household.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "home_and_family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of traveling abroad, he was finally happy to return to his own <w>hearth</w> and family.",
                            "target_lang_translations": {
                                "ru": "После долгих лет путешествий за границей он был наконец счастлив вернуться к своему собственному <w>очагу</w> и семье."
                            }
                        },
                        {
                            "text": "They gathered around the <w>hearth</w> to share stories and enjoy each other's company during the cold winter evening.",
                            "target_lang_translations": {
                                "ru": "Они собрались вокруг <w>очага</w>, чтобы поделиться историями и насладиться обществом друг друга холодным зимним вечером."
                            }
                        }
                    ],
                    "synonyms": [
                        "home",
                        "fireside",
                        "household"
                    ],
                    "common_phrases": [
                        "hearth and home"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in literary or slightly traditional contexts to evoke a sense of home."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дом или семейная жизнь, олицетворяющие тепло и безопасность домашнего хозяйства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домашний очаг",
                                "target_lang_sense_clarification": "символ дома и уюта"
                            },
                            {
                                "target_lang_word": "семейный очаг",
                                "target_lang_sense_clarification": "символ семейного тепла"
                            },
                            {
                                "target_lang_word": "очаг",
                                "target_lang_sense_clarification": "в переносном значении: родной дом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05f86bd9-58e1-3e4e-964c-97ac81f0e254",
                    "sense_definition": "A fireplace or the brick or stone area in front of it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fireplace_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat curled up on the warm stone <w>hearth</w> to sleep near the crackling fire.",
                            "target_lang_translations": {
                                "ru": "Кошка свернулась клубком на теплом каменном <w>поду</w> камина, чтобы поспать возле потрескивающего огня."
                            }
                        },
                        {
                            "text": "We sat on the rug by the <w>hearth</w> while the snow fell outside.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на ковре у <w>камина</w>, пока на улице шел снег."
                            }
                        }
                    ],
                    "synonyms": [
                        "fireplace",
                        "hearthstone"
                    ],
                    "common_phrases": [
                        "open hearth",
                        "stone hearth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Камин или кирпичная/каменная площадка перед ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаг",
                                "target_lang_sense_clarification": "место для разведения огня"
                            },
                            {
                                "target_lang_word": "камин",
                                "target_lang_sense_clarification": "домашний открытый очаг"
                            },
                            {
                                "target_lang_word": "под",
                                "target_lang_sense_clarification": "площадка перед камином или дно печи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2750e361-eee9-339b-8bd0-a3a6e7d576a9",
                    "sense_definition": "The lowest part of a metallurgical furnace where the molten metal collects.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "industrial_furnace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The molten iron accumulated at the bottom of the furnace on the refractory <w>hearth</w>.",
                            "target_lang_translations": {
                                "ru": "Расплавленный чугун скапливался в нижней части печи на огнеупорном <w>поду</w>."
                            }
                        },
                        {
                            "text": "Workers carefully monitored the temperature of the furnace <w>hearth</w> to prevent any structural failure.",
                            "target_lang_translations": {
                                "ru": "Рабочие тщательно следили за температурой <w>подины</w> печи, чтобы предотвратить любые повреждения конструкции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "furnace hearth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть металлургической печи, где собирается расплавленный металл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под",
                                "target_lang_sense_clarification": "нижняя поверхность плавильной печи"
                            },
                            {
                                "target_lang_word": "подина",
                                "target_lang_sense_clarification": "массивная плита в плавильной печи"
                            },
                            {
                                "target_lang_word": "лещадь",
                                "target_lang_sense_clarification": "дно горна доменной печи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b834c10-be80-3ca8-a0a4-e190e9e9dbea",
                    "sense_definition": "A local worship group or household community within modern Heathenry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Members of the local <w>hearth</w> gathered to celebrate the winter solstice together.",
                            "target_lang_translations": {
                                "ru": "Члены местной <w>общины</w> собрались вместе, чтобы отпраздновать зимнее солнцестояние."
                            }
                        },
                        {
                            "text": "Each pagan <w>hearth</w> operates independently while sharing common beliefs with others.",
                            "target_lang_translations": {
                                "ru": "Каждый языческий <w>очаг</w> действует независимо, разделяя при этом общие верования с другими."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Местная религиозная община или домашнее сообщество в современном язычестве (хитрени)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "община",
                                "target_lang_sense_clarification": "местная языческая группа"
                            },
                            {
                                "target_lang_word": "очаг",
                                "target_lang_sense_clarification": "домашняя религиозная община в язычестве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}