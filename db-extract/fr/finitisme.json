                        "source_entry_id": "e370101a-7927-382a-bbf7-4f0613ac6ab5",
                        "source_sense_id": "f83eca72-526f-34bd-a107-c121026e3474",
                        "target_lang_word": "finitism",
                        "target_lang_code": "en",
