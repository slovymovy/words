                "translations": [
                    {
                        "translation_id": "6905a4bd-58cd-4883-bcbf-2ac64ef6cb8b",
                        "source_entry_id": "f1138bf5-7235-3384-8b8f-846754b61978",
                        "source_sense_id": "c8c34883-03e4-3d05-a357-6e08c14b092d",
                        "source_sense_description": "Amt eines Notars",
                        "target_lang_word": "notaryship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notaryship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84916020-6106-38f1-b8aa-5b537694de5f",
                                        "entry_id": "87287b1d-db36-3d78-92c0-1bb4831d7fa3",
                                        "glosses": [
                                            "The state of being a notary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c24a354-44c4-4c6e-89b0-ea47a8ffc242",
                                                "sense_id": "84916020-6106-38f1-b8aa-5b537694de5f",
                                                "text": "Horace had come to Rome after the battle of Philippi, and obtained, probably by purchase, out of the wreck of his fortunes, a public notaryship."
                                            },
                                            {
                                                "example_id": "4fdd1cf3-f4f5-4026-a937-ee2d9034ba53",
                                                "sense_id": "84916020-6106-38f1-b8aa-5b537694de5f",
                                                "text": "All the gathered documents, copied from archives and books of the Cabildo, regarding the auction and final bid of the notaryship in 1600, along with the acts of the local authorities in 1607 confirming the claims of Silvestre de Balboa, were prepared to serve as documental evidence ina legal claims process that Balboa is obliged to initiate in order not to lose his notaryship, due to the period of time for royal confirmation having transpired."
                                            },
                                            {
                                                "example_id": "c9f070a6-26f1-4f3f-9b23-72e942fc6ad4",
                                                "sense_id": "84916020-6106-38f1-b8aa-5b537694de5f",
                                                "text": "The best times had passed for the notaryship, since the Prussian ancestral estate law had been passed and new mortgages slowed to a trickle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
