    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c0505bff-477b-3b53-97d8-dc52c127ab68",
                "word": "purportedly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "366ff164-6c15-3f5a-97a5-47d6a3199819",
                        "entry_id": "c0505bff-477b-3b53-97d8-dc52c127ab68",
                        "glosses": [
                            "As appears to be true or is stated or accepted to be (though might not be so)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d5ca34c-dde2-4f9f-bf04-715805a72964",
                                "sense_id": "366ff164-6c15-3f5a-97a5-47d6a3199819",
                                "text": "Near-synonyms: reportedly, reputedly, putatively, rumoredly, supposedly, allegedly, ostensibly, possibly, probably, likely, plausibly"
                            },
                            {
                                "example_id": "f0050201-8d44-4726-83a3-8c8717a8ff8b",
                                "sense_id": "366ff164-6c15-3f5a-97a5-47d6a3199819",
                                "text": "In addition, none of the purportedly more common terms of these pairs appear to be especially frequent in modern Indian English."
                            },
                            {
                                "example_id": "2e15bb9a-9ed9-4a76-862d-a9fc51ed8345",
                                "sense_id": "366ff164-6c15-3f5a-97a5-47d6a3199819",
                                "text": "After several years Philip Rigoli left the property, describing his family as ‘strange and toxic’, but father Virgilio and brother Joe continued to develop their nation, maintaining that it was the only valid response to a government purportedly discriminating against ‘Christians, white Anglo-Saxons and capitalists’."
                            },
                            {
                                "example_id": "736262cb-b98d-4284-b178-98b9412a6963",
                                "sense_id": "366ff164-6c15-3f5a-97a5-47d6a3199819",
                                "text": "Australia is working to verify the authenticity of a video that purportedly shows one of its nationals captured by Russian forces while fighting in Ukraine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2798878-8f90-4d4d-bc23-92c30fc0a7a9",
                        "source_entry_id": "c0505bff-477b-3b53-97d8-dc52c127ab68",
                        "source_sense_id": "366ff164-6c15-3f5a-97a5-47d6a3199819",
                        "source_sense_description": "as appears or is said to be true",
                        "target_lang_word": "angeblich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angeblich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                        "entry_id": "f5fe3373-5405-3a78-aea9-1e9c165427ca",
                                        "glosses": [
                                            "wie ohne Gewähr angegeben, behauptet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a216768-f3ec-4646-b8bf-de7af95cd3f9",
                                                "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                                "text": "Angeblich trifft er einen prominenten Gast."
                                            },
                                            {
                                                "example_id": "aae10024-e27e-4996-9c86-88b3f2ba0476",
                                                "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                                "text": "„Die Anleger hatten Geld in sogenannte Bermuda-Versicherungen gesteckt, spezielle »Lebensversicherungen«, mit denen sich Schwarzgeld angeblich risikolos reinwaschen ließ.“"
                                            },
                                            {
                                                "example_id": "6c2bff3b-c267-4263-8817-2890c910c504",
                                                "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                                "text": "„Angeblich waren die Wiedervereinigung und der Niedergang der DDR durch Weingenuss beschleunigt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20581040-5e7c-4f9e-812e-225a545b98c5",
                        "source_entry_id": "c0505bff-477b-3b53-97d8-dc52c127ab68",
                        "source_sense_id": "366ff164-6c15-3f5a-97a5-47d6a3199819",
                        "source_sense_description": "as appears or is said to be true",
                        "target_lang_word": "vermeintlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermeintlich",
