                                        "glosses": [
                                            "The practising of something which is to be performed before an audience, usually to test or improve the interaction between several participating people, or to allow technical adjustments with respect to staging to be done."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a999570-5c2a-4f1c-9af3-6bcf26917527",
                                                "sense_id": "97fb3995-384e-37df-99b3-ba84b7395460",
                                                "text": "After modifications had been effected by the builders, a rehearsal of electric operation was held on September 17. A complete day's timetable was run through and apparently all went well, except for insulator trouble with the overhead wires near Anniesland; a further rehearsal was held on the following Sunday."
                                            }
                                        ]
                                    },
