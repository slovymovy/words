                "senses": [
                    {
                        "sense_id": "05747c6c-2f90-32ce-b664-b8e236ad9c84",
                        "entry_id": "162a8727-9eff-3d62-88d0-124a75aa3d18",
                        "glosses": [
                            "Rougeur pathologique de la peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ff8ba0-ac02-47ba-b0ee-1f64696b02d0",
                                "sense_id": "05747c6c-2f90-32ce-b664-b8e236ad9c84",
                                "text": "L’érythrose faciale est une affection très commune, qui s’observe surtout chez la femme jeune."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ff20e72-8e9b-376c-be52-1048e3e431ca",
                        "entry_id": "162a8727-9eff-3d62-88d0-124a75aa3d18",
                        "glosses": [
                            "Aldose à quatre atomes de carbone. Matière colorante rouge extraite de la rhubarbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b1a41ba-e835-47dd-8545-d3ad1ef12566",
                                "sense_id": "1ff20e72-8e9b-376c-be52-1048e3e431ca",
                                "text": "Les différentes rhubarbes ne fournissent pas non plus la même quantité d’érythrose, celle qui en donne le plus est la rhubarbe de Moscovie, puis celle de Chine, et enfin la rhubarbe indigène."
                            },
                            {
                                "example_id": "4a2ccd77-dd5b-4296-aa07-8a43d8f787e2",
                                "sense_id": "1ff20e72-8e9b-376c-be52-1048e3e431ca",
                                "text": "Il existe deux isomères de l’érythrose : le L-érythrose et celui qui est prépondérant dans la nature, le D-érythrose."
                            }
                        ]
                    }
                ],
