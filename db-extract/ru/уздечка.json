                                "target_senses": [
                                    {
                                        "sense_id": "731ba25e-8aa7-3221-84a2-dacfce1af070",
                                        "entry_id": "21faa947-4eb3-373a-9457-397d888dab68",
                                        "glosses": [
                                            "The headgear with which a horse is directed and which carries a bit and reins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb2e693-087c-4208-baee-d9129a376f3f",
                                                "sense_id": "731ba25e-8aa7-3221-84a2-dacfce1af070",
                                                "text": "[…] the horseman, who is the user of bridles and knows their use"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b852b84-6cb3-39d6-ba37-9f21a439f18f",
                                        "entry_id": "21faa947-4eb3-373a-9457-397d888dab68",
                                        "glosses": [
                                            "A restraint; a curb; a check."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d11cfe-c644-46a0-8161-84de3e08b76b",
                                                "sense_id": "9b852b84-6cb3-39d6-ba37-9f21a439f18f",
                                                "text": "Let wisdom put a bridle on them before they are grown head-strong and unruly"
                                            }
                                        ]
                                    },
                                    {
