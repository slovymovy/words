                "senses": [
                    {
                        "sense_id": "3f0066c3-21bc-3ab2-9cf8-4090872e5c18",
                        "entry_id": "b1804124-8236-3527-905a-d36fabc2a604",
                        "glosses": [
                            "Solarkraftwerk, das gewölbte Spiegel verwendet um das einfallende Sonnenlicht auf ein in der Brennlinie verlaufendes Absorberrohr zu bündeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656c17ab-566f-426c-9792-4f6ca55ae881",
                                "sense_id": "3f0066c3-21bc-3ab2-9cf8-4090872e5c18",
                                "text": "„Zur Bündelung der Sonnenstrahlung wird die Sonnenenergie in diesem Parabolrinnenkraftwerk in rinnenförmigen Spiegeln eingefangen, wo sie ein Wärmeträgermedium erhitzt.“"
                            },
                            {
                                "example_id": "9a5c2691-92a0-4191-96b3-30c5e8cf89bd",
                                "sense_id": "3f0066c3-21bc-3ab2-9cf8-4090872e5c18",
                                "text": "„Damit sich ein Parabolrinnenkraftwerk lohnt, ist eine intensive, ausdauernde Sonneneinstrahlung nötig, und die gibt es in Spanien - im Schnitt 2 300 Stunden im Jahr, 900 sind es in Deutschland.“"
                            },
                            {
                                "example_id": "76ffce4f-67a9-4a8a-8815-6ac42103c43a",
                                "sense_id": "3f0066c3-21bc-3ab2-9cf8-4090872e5c18",
                                "text": "„Der Ingenieur baut das erste solarthermische Parabolrinnenkraftwerk Deutschlands.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
