                        "sense_id": "6cc2d585-cef5-3ea7-8601-917ec4dc5199",
                        "entry_id": "e8dcfccc-06fe-3728-abd4-b924cf7f69e0",
                        "glosses": [
                            "een prins die in een monarchie de eerste is die de rechtmatige vorst opvolgt bij aftreden of overlijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742cd705-f5bc-4a14-9044-5826fe2d825e",
                                "sense_id": "6cc2d585-cef5-3ea7-8601-917ec4dc5199",
                                "text": "En daardoor waren de voorwaarden voor een normale en vriendschappelijke relatie tussen de Noren en de Duitsers zo goed als vernietigd. Koning Haakon en de kroonprins, zijn oude zeilvriend Olav, zaten nu samen met de gevluchte Noorse regering in Londen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4337031-c7bb-4429-8454-2e55cac04272",
                        "source_entry_id": "e8dcfccc-06fe-3728-abd4-b924cf7f69e0",
                        "source_sense_id": "6cc2d585-cef5-3ea7-8601-917ec4dc5199",
                        "source_sense_description": "een prins die in een monarchie de eerste is die de rechtmatige vorst opvolgt bij aftreden of overlijden",
                        "target_lang_word": "Kronprinz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kronprinz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                        "entry_id": "597512f1-baad-3b38-b50f-98e5c62d9fc6",
                                        "glosses": [
                                            "nachfolgeberechtigter Sohn oder Enkel eines Königs oder Kaisers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8362249a-b636-42a0-8d0a-59bd37214b41",
                                                "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                                "text": "„Mit der Thronbesteigung seines Vaters Wilhelm I. avancierte Friedrich Wilhelm 1861 zum preußischen Kronprinzen.“"
                                            },
                                            {
                                                "example_id": "d362d0a8-48d5-4fa9-9bbf-b543a5b0e1cf",
                                                "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                                "text": "„Der begeisterte sich schon als Kronprinz für die Rheinromantik, und darum gefiel er den Rheinländern.“"
                                            },
                                            {
                                                "example_id": "805ae063-b676-405a-ac4f-e8e5ba92bec5",
                                                "sense_id": "4dec7fb4-e199-3db4-a50f-3a26f43ad70f",
                                                "text": "„Es war mitten im Sommer, Mama und Papa waren verreist, in England drängten sich die Leute auf den Straßen, sie schwenkten Fähnchen und johlten und freuten sich, denn endlich hatte der Kronprinz eine gefunden, die er heiraten wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
