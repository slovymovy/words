                    }
                ],
                "translations": [
                    {
                        "translation_id": "b918b603-f2f6-4e94-bd12-adabd23f0fe7",
                        "source_entry_id": "1b07ba1f-94e6-3d21-93ca-b737d1bc4d52",
                        "source_sense_id": "e356d13d-6f9f-3c14-94c3-4274e01e4846",
                        "source_sense_description": "veraltet, sonst dichterisch: männliche Person, die Samenkörner über ein Feld ausstreut",
