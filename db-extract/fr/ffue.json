                "senses": [
                    {
                        "sense_id": "2f295e42-7034-311e-9a76-115d30ffd879",
                        "entry_id": "e5b8043e-4abd-312a-835d-d4a301500359",
                        "glosses": [
                            "Bruit de souffle sur quelque chose ou sur quelqu'un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4da77ac-f5bd-42c2-9d6f-2657d325f3bf",
                                "sense_id": "2f295e42-7034-311e-9a76-115d30ffd879",
                                "text": "Ribadier. — Elle va dormir comme ça pendant mon absence et quand je reviendrai, ffue ! je souffle dessus, elle s’éveille, et ni vu ni connu."
                            },
                            {
                                "example_id": "c8caf016-4455-4ae9-bc0e-a4a9096d2fab",
                                "sense_id": "2f295e42-7034-311e-9a76-115d30ffd879",
                                "text": "Thommereux. — Je souffle dessus, elle se réveille et ni vu ni connu. Le voilà le moyen : Souffler. Eh bien ! je vais faire comme il a dit, je vais lui souffler sa femme. (Il souffle sur le front d’Angèle.) Ffue ! Ffue ! Angèle ! Ffue !"
                            }
                        ]
                    },
                    {
                        "sense_id": "911b812e-d584-311c-bfb7-6f015a459a92",
                        "entry_id": "e5b8043e-4abd-312a-835d-d4a301500359",
                        "glosses": [
                            "Bruit produit par un sifflotement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7d2895-2649-4642-aa18-ba2713e240d6",
                                "sense_id": "911b812e-d584-311c-bfb7-6f015a459a92",
                                "text": "Thommereux. — À la grâce de Dieu !… ffue ! ffue ! flue ffue ! ffue ! ffue ! ffue ! Il sort en sifflotant par le fond."
                            }
                        ]
                    }
