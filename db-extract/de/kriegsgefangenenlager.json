                        "form": "die Kriegsgefangenenlager"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7c37ccc-d397-346b-aeb2-d7401fd104b8",
                        "entry_id": "7fb650c9-4ef9-388c-aa86-165b71cd9252",
                        "glosses": [
                            "vorübergehendes Gefängnis oder Arbeitslager für gefangene gegnerische Soldaten im Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40d2c38-0bf0-4405-8bc5-7a9655deffce",
                                "sense_id": "a7c37ccc-d397-346b-aeb2-d7401fd104b8",
                                "text": "Noch Jahre nach dem Krieg litten die Soldaten in den Kriegsgefangenenlagern der Gegner."
                            },
                            {
                                "example_id": "40138097-6615-4e2f-b91d-97d72c70660b",
                                "sense_id": "a7c37ccc-d397-346b-aeb2-d7401fd104b8",
                                "text": "„Polnische Historiker haben alle bis heute bekannten Akten gesichtet und bestätigen, dass im ehemaligen Kriegsgefangenenlager überwiegend unschuldige Menschen interniert wurden.“"
                            },
                            {
                                "example_id": "74c4d913-26f2-43b2-bf01-ee2df7467390",
                                "sense_id": "a7c37ccc-d397-346b-aeb2-d7401fd104b8",
                                "text": "„Nach zweieinhalb Monaten intensiver Behandlung konnte er das Krankenhaus verlassen und wurde in ein normales Kriegsgefangenenlager überstellt, wo er bis 1945 blieb.“"
                            },
                            {
                                "example_id": "08505814-7733-4f8f-9ba8-737d7dd730e0",
                                "sense_id": "a7c37ccc-d397-346b-aeb2-d7401fd104b8",
                                "text": "„In der Zeitung hatte er gelesen, daß ich in Berlin sei, und er hoffte, ich könne etwas für seinen Vater tun, einen Mann weit über die fünfzig, der immer noch in einem Kriegsgefangenenlager in Frankreich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
