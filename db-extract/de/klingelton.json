                    {
                        "sense_id": "90f4b28d-ec31-3e67-9904-17aee2b5ffb3",
                        "entry_id": "d8e4cdbe-8e24-36de-a917-c229d59ddc77",
                        "glosses": [
                            "Signal, durch das bei Telefon und Mobiltelefon ein eingehender Anruf oder eine Kurznachricht gemeldet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01258cea-12d8-4666-b9ba-378e86639229",
                                "sense_id": "90f4b28d-ec31-3e67-9904-17aee2b5ffb3",
                                "text": "Ich habe einen neuen Klingelton."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20ae4181-b279-4630-a7cc-1f82921fa348",
                        "source_entry_id": "d8e4cdbe-8e24-36de-a917-c229d59ddc77",
                        "source_sense_id": "90f4b28d-ec31-3e67-9904-17aee2b5ffb3",
                        "source_sense_description": "Signal, durch das bei Telefon und Mobiltelefon ein eingehender Anruf oder eine Kurznachricht gemeldet wird",
                        "target_lang_word": "ringtone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ringtone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "874e9933-4443-36f2-8061-229815949fd6",
                                        "entry_id": "1a903b06-7e2e-3dff-8b67-2ada381ed4cb",
                                        "glosses": [
                                            "The sound made by a telephone when ringing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18593b9e-b6c9-4c8b-974f-1cbbbbb8eccd",
                                                "sense_id": "874e9933-4443-36f2-8061-229815949fd6",
                                                "text": "voltage generator ringtone for installation in terminal stations of telephone communication systems for carrier wave"
                                            },
                                            {
                                                "example_id": "7a51da21-1238-450e-964f-0dc0216899d8",
                                                "sense_id": "874e9933-4443-36f2-8061-229815949fd6",
                                                "text": "The transducers used to measure cavity dynamic pressure and reed dynamic displacement are calibrated before each test, the ringtone oscillator assembly produces a sinusoidal driving pressure, with at most, a few small harmonics."
                                            },
                                            {
                                                "example_id": "92cf8fed-3eb7-4034-84bd-12f1d8476ca3",
                                                "sense_id": "874e9933-4443-36f2-8061-229815949fd6",
                                                "text": "Introduces LT1684, a ringtone-generator integrated circuit (IC) for telephone systems from Linear Technology in California. Elimination of need for optoisolators; Function of active multipole filter within the IC; Adjustment of cadence, frequency and amplitude information;"
                                            },
                                            {
                                                "example_id": "734e3939-ac06-4c8d-bd53-98cf900ae71e",
                                                "sense_id": "874e9933-4443-36f2-8061-229815949fd6",
                                                "text": "The source and destination nodes may be equipped with ringtone-generation engines to generate ringtones. Each of the ringtones includes at least one audible tone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8610a2-1b18-3bed-a0a3-2d9be4e1e4bd",
                                        "entry_id": "1a903b06-7e2e-3dff-8b67-2ada381ed4cb",
                                        "glosses": [
                                            "A customizable tone used to indicate an incoming call on a telephone, especially a mobile phone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8cb054-d9be-4eae-b1e9-9f54ab61a0ce",
                                                "sense_id": "fb8610a2-1b18-3bed-a0a3-2d9be4e1e4bd",
                                                "text": "I set my favorite song as my ringtone."
                                            },
                                            {
                                                "example_id": "7f732a17-10c8-4197-856a-90dd6943f4a8",
                                                "sense_id": "fb8610a2-1b18-3bed-a0a3-2d9be4e1e4bd",
                                                "text": "So even if the primary purpose of a ringtone is to notify the user of an incoming call, the effect of a ringtone played in public cannot be ignored if the reason users choose ringtones is, in part, in order to impress others ."
                                            },
                                            {
                                                "example_id": "44841f3a-9cbf-4cb6-aaa0-1f55b51d3501",
                                                "sense_id": "fb8610a2-1b18-3bed-a0a3-2d9be4e1e4bd",
                                                "text": "This actually downloads the ringtone onto your handheld and displays a screen allowing you to save it, shown in Figure 8.12."
                                            },
                                            {
                                                "example_id": "0b50dc4d-3cdf-4399-9e0f-1ccb560d603b",
                                                "sense_id": "fb8610a2-1b18-3bed-a0a3-2d9be4e1e4bd",
                                                "text": "There's only music so that there's new ringtones"
                                            },
                                            {
                                                "example_id": "ac913215-4dfa-4a73-b6e2-6b7c817ffb41",
                                                "sense_id": "fb8610a2-1b18-3bed-a0a3-2d9be4e1e4bd",
                                                "text": "Using simple audio tools in the iTunes program, you could buy a song for $1, choose a 30-second chunk, pay $1 more for the ringtone, and sync the result to your iPhone."
                                            },
                                            {
                                                "example_id": "d61ab155-fa13-48db-a6fe-e27a9913e6d4",
                                                "sense_id": "fb8610a2-1b18-3bed-a0a3-2d9be4e1e4bd",
                                                "text": "My boy's got his own ringtone / It's the only one I know, it's the only one I know"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ringtone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fb3ca72-2871-3ac8-a46b-ed18e6fa9057",
                                        "entry_id": "7f604cc6-da94-3ec2-92ac-00091d839347",
                                        "glosses": [
                                            "Of a telephone: to play a ringtone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49db45f6-dce3-4068-a72e-9f5e86b08408",
                                                "sense_id": "1fb3ca72-2871-3ac8-a46b-ed18e6fa9057",
                                                "text": "My handheld ringtoned “Happy Days are Here Again.” I withdrew into a quieter corner of Mahogany Bar and stuck a finger in my other ear."
                                            },
                                            {
                                                "example_id": "4cd1e967-b009-4422-a429-59d4ad32af50",
                                                "sense_id": "1fb3ca72-2871-3ac8-a46b-ed18e6fa9057",
                                                "text": "The cell reception is less than zero here, but my phone was ringtoning away. I did not like the sound of that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
