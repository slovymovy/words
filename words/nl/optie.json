            "senses": [
                {
                    "sense_id": "09e9bbef-ad88-3afe-858d-b1a2fb3a834e",
                    "sense_definition": "Een van de mogelijkheden waaruit men kan kiezen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aftreden is voor de minister op dit moment geen <w>optie</w>.",
                            "target_lang_translations": {
                                "ru": "Отставка для министра на данный момент — не <w>вариант</w>.",
                                "en": "Resigning is not an <w>option</w> for the minister at this moment.",
                                "zh": "对部长来说，辞职目前不是一个<w>选项</w>。",
                                "it": "Dimettersi non è un'<w>opzione</w> per il ministro in questo momento."
                            }
                        },
                        {
                            "text": "We hebben verschillende <w>opties</w> bekeken voor onze zomervakantie.",
                            "target_lang_translations": {
                                "ru": "Мы рассмотрели различные <w>варианты</w> для нашего летнего отпуска.",
                                "en": "We looked at different <w>options</w> for our summer holiday.",
                                "zh": "我们为暑假考虑了几个不同的<w>方案</w>。",
                                "it": "Abbiamo esaminato diverse <w>opzioni</w> per le nostre vacanze estive."
                            }
                        }
                    ],
                    "synonyms": [
                        "keuze",
                        "mogelijkheid",
                        "alternatief"
                    ],
                    "common_phrases": [
                        "geen optie zijn",
                        "meerdere opties",
                        "opties openhouden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из возможностей, из которых можно выбирать.",
                        "en": "One of the possibilities from which one can choose.",
                        "zh": "可供选择的多种可能性之一。",
                        "it": "Una delle possibilità tra cui si può scegliere."
                    },
