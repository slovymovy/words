                            {
                                "example_id": "0ddbc357-6ee3-4f0e-9cff-ddfee68b2140",
                                "sense_id": "8c2ea814-6669-3fd6-8c02-65dd5cb4a902",
                                "text": "Évitons le pinaillage, allons à l'essentiel."
                            },
