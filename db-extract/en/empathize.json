                    },
                    {
                        "translation_id": "c59833f9-7278-40c9-8aa8-185f18570c78",
                        "source_entry_id": "d380f747-8ced-3441-bf2f-0d3b2eb75626",
                        "source_sense_id": "7c4d7afa-22bf-32a1-8377-3fc8b3d9730d",
                        "source_sense_description": "to feel empathy for another person",
                        "target_lang_word": "mitempfinden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitempfinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "016fd664-be92-34c9-98e5-d648685982de",
                                        "entry_id": "b91016bf-5edf-3e3b-853e-c358f13e222c",
                                        "glosses": [
                                            "sich in ein anderes Lebewesen hineinversetzen, Empathie zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7ff372-849b-4aa1-951c-292867794d42",
                                                "sense_id": "016fd664-be92-34c9-98e5-d648685982de",
                                                "text": "„Und in der Tat sind die Definitionen von Empathie im Arztberuf vielleicht noch im Fluss – sie sollten mehr berücksichtigen als nur »die Fähigkeit, die Gefühle eines anderen zu verstehen und mitzuempfinden«.“"
                                            },
                                            {
                                                "example_id": "b09ceef9-d19b-4ace-9f57-6d8dd916761d",
                                                "sense_id": "016fd664-be92-34c9-98e5-d648685982de",
                                                "text": "„Ich kenne ja Dein Herz, das alle Leiden der Menschheit mitempfindet, über nichts spottet, was den Mut des schwachern Bruders erschüttert, das sich mit den Fröhlichen freut und mit den Weinenden weint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
