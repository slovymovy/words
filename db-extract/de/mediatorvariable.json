                        "glosses": [
                            "Variable, die den Zusammenhang einer unabhängigen auf die abhängige Variable vermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a303cfa-02be-4bdf-8cc7-da8c705d5c42",
                                "sense_id": "b0621f45-9945-3a2d-a687-4f4dba9722ab",
                                "text": "„Der vermutete Effekt der Wahrnehmung eines starken Medieneinflusses auf die Befürwortung einer Einschränkung eben dieses Einflusses ist dort zum einen auf direktem Wege berücksichtigt, zum anderen auf indirektem Weg über die negative Bewertung des Einflusses als Mediatorvariable.“"
                            }
                        ],
