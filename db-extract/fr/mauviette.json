                                    {
                                        "sense_id": "099d1972-69e7-3083-bdc6-0930fa7d9238",
                                        "entry_id": "e09cd946-802d-3c72-af68-d263e0dbaade",
                                        "glosses": [
                                            "Person mit vergleichsweise geringer körperlicher oder charakterlicher/psychischer Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
