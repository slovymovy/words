                                        "examples": [
                                            {
                                                "example_id": "244f8241-fdce-48b1-ab03-cd49ae6a7850",
                                                "sense_id": "2d9fb2e8-2614-3562-a300-0fe4aca1afa7",
                                                "text": "Damascus is een stad met een oude geschiedenis."
                                            },
                                            {
                                                "example_id": "3039c2b6-977d-4d37-93ad-04771f8c02c6",
                                                "sense_id": "2d9fb2e8-2614-3562-a300-0fe4aca1afa7",
                                                "text": "Bij de nieuwe Israëlische bombardementen op doelwitten in en nabij de Syrische hoofdstad Damascus zijn elf soldaten, onder wie zeven buitenlanders, omgekomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48637c01-de60-4640-8485-00e0dcee38f9",
                        "source_entry_id": "8dbd397a-620a-3822-825d-f1f07364d346",
                        "source_sense_id": "aba7c1cb-2e56-315b-bda0-f00efc471073",
                        "source_sense_description": "the capital city of Syria",
                        "target_lang_word": "Damas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Damas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bba922c1-3bcc-31dc-9c2f-f168e0d46088",
                                        "entry_id": "bd29d634-5f01-3ed3-b18d-7405fe017c39",
                                        "glosses": [
                                            "Capitale et principale ville de Syrie."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd0c147c-d00c-40c2-b946-070c3143d577",
                                                "sense_id": "bba922c1-3bcc-31dc-9c2f-f168e0d46088",
                                                "text": "Pourtant, avant de rentrer à Alexandrie, il lui faut encore aller à Damas, à Jérusalem et aussi à Gaza, et enfin à Jéricho !"
                                            },
                                            {
                                                "example_id": "f7091ff5-11de-4841-93ad-da26eb27e6de",
                                                "sense_id": "bba922c1-3bcc-31dc-9c2f-f168e0d46088",
                                                "text": "Seuls les croisés n’ont pu en forcer les portes ; aussi Damas est-elle restée de ce chef l’une des villes saintes de l’islam."
                                            },
                                            {
                                                "example_id": "2a6da956-5c4c-4674-8440-3f607cf86213",
                                                "sense_id": "bba922c1-3bcc-31dc-9c2f-f168e0d46088",
                                                "text": "Avant que le califat omeyyade de Damas n’eût cédé la place aux Abbassides de Bagdad, en 750, les conquêtes arabes avaient unifié politiquement une grande partie du monde, de l’Espagne à l'Inde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Damas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fad897e-f605-38e6-b158-3637c39cce8f",
                                        "entry_id": "342e7428-5bc9-32cc-9639-a4f235fabf3d",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47fc392-20d5-440b-b453-8c7553832886",
                                                "sense_id": "3fad897e-f605-38e6-b158-3637c39cce8f",
                                                "text": "Damas, tu parles d’un prénom."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Damas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffcbf53-3783-34b0-b63c-7f7173d495b6",
                                        "entry_id": "aeba42b6-5d2b-3094-91aa-3f7d913a5efd",
                                        "glosses": [
                                            "Fusil dont le canon est en acier de Damas."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fef98ffe-ee2b-433d-ba8a-8a868076a903",
                                                "sense_id": "1ffcbf53-3783-34b0-b63c-7f7173d495b6",
                                                "text": "M. Rezeau remit une cartouche de 7 dans le canon droit de son vieux Damas."
                                            }
