        "fr-extract.jsonl": [
            {
                "entry_id": "c5aa2e06-6117-36e1-a257-158f66b82c01",
                "word": "organométallique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd0bc032-f3c7-4c58-8690-fecac48fc052",
                        "entry_id": "c5aa2e06-6117-36e1-a257-158f66b82c01",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "organométalliques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7353b57b-5468-3d04-a51d-977d407235fb",
                        "entry_id": "c5aa2e06-6117-36e1-a257-158f66b82c01",
                        "glosses": [
                            "Qualifie un composé chimique dans lequel un atome de carbone au moins est lié à un métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c84301ac-a1c6-4c10-83a1-dc392b37ae72",
                                "sense_id": "7353b57b-5468-3d04-a51d-977d407235fb",
                                "text": "Les doses d'emploi ont varié de 15 à 40 kg de cuivre par hectare et par an jusqu'à l'apparition d’anticryptogamiques organiques ou organométalliques, soit pendant 3/4 de siècle."
                            },
                            {
                                "example_id": "ce7423f1-c72d-4d2a-b1d0-bcd09b554b69",
                                "sense_id": "7353b57b-5468-3d04-a51d-977d407235fb",
                                "text": "Les complexes qui mettent en jeu de faibles degrés d'oxydation par exemple les complexes organométalliques, sont en général inertes."
                            },
                            {
                                "example_id": "0d1477b4-71b3-45c4-ba8d-16027bec54b4",
                                "sense_id": "7353b57b-5468-3d04-a51d-977d407235fb",
                                "text": "Nous ne détaillons pas les applications des composés organométalliques des groupes principaux en synthèse organique, mais des références appropriées sont données à la fin du chapitre."
                            },
                            {
                                "example_id": "598e21db-dce4-4223-8b70-f8962e9e17c7",
                                "sense_id": "7353b57b-5468-3d04-a51d-977d407235fb",
                                "text": "Un très grand nombre de métaux peuvent former des dérivés organométalliques (Li, Na, Mg, Ca, Al, Sn, Zn, Cd, Hg, Cu...). La polarisation de la liaison se fait dans le sens Cᵟ⁻ — Mᵟ⁺, cette liaison aura un caractère d'autant plus polaire que le métal sera plus électropositif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6969f32-338f-456e-a159-d5c8e88c7083",
                        "source_entry_id": "c5aa2e06-6117-36e1-a257-158f66b82c01",
