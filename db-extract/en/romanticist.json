                        "translation_id": "3e3dd538-110c-4d5e-906b-866f76d55370",
                        "source_entry_id": "74422055-9937-3b9e-a705-ba067dad37b5",
                        "source_sense_id": "8234c541-2f28-33ca-b86f-0b5981e68ee3",
                        "source_sense_description": "advocate or follower of romanticism",
                        "target_lang_word": "Romantiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romantiker",
