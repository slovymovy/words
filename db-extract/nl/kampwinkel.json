                "translations": [
                    {
                        "translation_id": "bc5ed15b-8854-48f0-8a76-95bcfc6ea577",
                        "source_entry_id": "50e24eb2-6062-3245-8f90-39a874127bc9",
                        "source_sense_id": "455758d9-20e5-3a93-8d14-dcf18d0d7bb5",
                        "source_sense_description": "een winkel op een kamp of een kampeerterrein",
                        "target_lang_word": "Laden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16603c85-b3d6-3ad5-bd05-2711b9e08a61",
                                        "entry_id": "a4d7ca28-f3ea-356c-889a-4ed8969b361d",
                                        "glosses": [
                                            "Geschäft, also Räumlichkeit, in der Waren oder Dienstleistungen zum Verkauf angeboten werden"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0152d91-2f1e-4959-b516-470e7aee3fb7",
                                                "sense_id": "16603c85-b3d6-3ad5-bd05-2711b9e08a61",
                                                "text": "Beiderseits der Hauptstraße gibt es viele Läden."
                                            },
                                            {
                                                "example_id": "416fb392-1f29-4524-b100-1ef4d94acb9a",
                                                "sense_id": "16603c85-b3d6-3ad5-bd05-2711b9e08a61",
                                                "text": "„Über den Läden und hinter den Läden aber sind Wohnungen, hinten kommen noch Höfe, Seitengebäude, Quergebäude, Hinterhäuser, Gartenhäuser.“"
                                            },
                                            {
                                                "example_id": "63c5a000-d691-475b-ba0e-106883a99204",
                                                "sense_id": "16603c85-b3d6-3ad5-bd05-2711b9e08a61",
                                                "text": "„Genau wie Sungs Laden waren auch diese Läden Familienbetriebe und Warenarchive, Orte für Schwätzchen, Paketannahmestelle, letzte Hoffnung am Abend auf Backpulver, Ventile, Glühbirnen und Grußkarten.“"
                                            },
                                            {
                                                "example_id": "da3d9fee-91e8-4a64-bac4-e89c1f1e036e",
                                                "sense_id": "16603c85-b3d6-3ad5-bd05-2711b9e08a61",
                                                "text": "„Es ist schon dunkel, und sie fahren durch die Straßen, an Läden vorbei, die bis in den Abend hinein geöffnet sind, die Schaufenster erleuchtet.“"
                                            },
                                            {
                                                "example_id": "613e713d-b441-4a62-adb7-05fb3e7b902d",
                                                "sense_id": "16603c85-b3d6-3ad5-bd05-2711b9e08a61",
                                                "text": "„Wir landeten in der Nähe eines großen Ladens, und als wir durch ein Fenster blickten, sahen wir einen Mann mit einem Gewehr in der Armbeuge im Sitzen schlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10e2094a-63fc-31ef-9a90-20411b9fdf71",
                                        "entry_id": "a4d7ca28-f3ea-356c-889a-4ed8969b361d",
                                        "glosses": [
                                            "Fensterverschluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d134e97-3270-436a-84ef-ff0510c367d3",
                                                "sense_id": "10e2094a-63fc-31ef-9a90-20411b9fdf71",
                                                "text": "Öffne die Läden und lass das Licht herein!"
                                            },
                                            {
                                                "example_id": "3d84c590-f713-4001-b2be-4f1bd11fc666",
                                                "sense_id": "10e2094a-63fc-31ef-9a90-20411b9fdf71",
                                                "text": "„Nach einer Weile wurden die Vorhänge zurückgeschoben, die Läden aufgeklappt.“"
                                            },
                                            {
                                                "example_id": "f47546b2-3b79-45b5-a788-019e7081cbb6",
                                                "sense_id": "10e2094a-63fc-31ef-9a90-20411b9fdf71",
                                                "text": "„Durch den hervorspringenden Felsabbruch an der Mercymündung waren die Fensterlöcher einigermaßen vor den Seewinden geschützt, aber der Ingenieur ließ die Öffnungen einstweilen durch provisorische Läden verschließen.“"
                                            },
                                            {
                                                "example_id": "799d50ad-0a18-437b-89fd-17fb38063ed2",
                                                "sense_id": "10e2094a-63fc-31ef-9a90-20411b9fdf71",
                                                "text": "„Die morgendliche Julisonne stach sie in den Rücken, als Sylvia die Tür zu ihrer Buchhandlung aufschloss und die Läden vor den beiden großen Schaufenstern beiseiteklappte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d8ef41f2-bf01-36d3-8c3e-dc248ef588fa",
                                        "entry_id": "a4d7ca28-f3ea-356c-889a-4ed8969b361d",
                                        "glosses": [
                                            "Sache, Angelegenheit"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06eb3e1b-8737-4203-8ffc-f80ac424a794",
                                                "sense_id": "d8ef41f2-bf01-36d3-8c3e-dc248ef588fa",
                                                "text": "Angesichts der mangelnden Unterstützung sah er sich gezwungen, den Laden hinzuschmeißen."
                                            },
                                            {
                                                "example_id": "344dc85b-fb20-4309-927e-4ab2d92cd288",
                                                "sense_id": "d8ef41f2-bf01-36d3-8c3e-dc248ef588fa",
                                                "text": "Er war so gut, dass er den ganzen Laden alleine schmeißen konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Laden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09832a01-24d0-3c35-8a59-5cd091d5523f",
