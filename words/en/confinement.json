                            }
                        ]
                    }
                },
                {
                    "sense_id": "881de503-4053-39db-9aec-29e25a362889",
                    "sense_definition": "A state of restricted movement or activity imposed as a security or safety measure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was placed under total <w>confinement</w> to prevent the spread of the virus.",
                            "target_lang_translations": {
                                "de": "Über die Stadt wurde ein vollständiger <w>Lockdown</w> verhängt, um die Ausbreitung des Virus zu verhindern."
                            }
                        },
                        {
                            "text": "During the <w>confinement</w> period, all non-essential businesses remained closed.",
                            "target_lang_translations": {
                                "de": "Während des <w>Lockdowns</w> blieben alle nicht lebensnotwendigen Geschäfte geschlossen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strict confinement",
                        "period of confinement"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand eingeschränkter Bewegungsfreiheit oder Aktivität als Sicherheits- oder Schutzmaßnahme."
                    },
                    "translations": {
