                "translations": [
                    {
                        "translation_id": "02f1af47-e483-4b5e-bff9-988a655f4b9c",
                        "source_entry_id": "a2586396-2e56-38f5-b0fe-adcf97903e27",
                        "source_sense_id": "79c24692-ebc5-33cc-8626-d8f7c50303d4",
                        "target_lang_word": "pastis",
