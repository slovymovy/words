                                    {
                                        "sense_id": "585a895c-98a6-358f-8a62-232de18b203a",
                                        "entry_id": "ef4e0754-b498-325b-b079-00f93f0f4e01",
                                        "glosses": [
                                            "Forma verbal de caracter impersonal utilizada para expresar acciones de carácter progresivo. Se distingue por utilizar las terminaciones -ando, -iendo y -yendo, y generalmente se utiliza en oraciones con un carácter adverbial."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4bf44fa-628a-481f-909c-1abd948f8809",
                        "source_entry_id": "a35bfddd-6f73-307e-a9e4-0162d3bde925",
                        "source_sense_id": "469139dd-5ab8-35ad-848a-be12bc80e142",
                        "target_lang_word": "gerundio",
