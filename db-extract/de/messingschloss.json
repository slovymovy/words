                "senses": [
                    {
                        "sense_id": "cbfe4d25-f9fe-39e6-9655-b4168ef6e893",
                        "entry_id": "34a90fc8-42eb-3f5a-ad96-10fd678cf3c8",
                        "glosses": [
                            "Verriegelungsvorrichtung aus Messing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa47d46-f876-4ce7-ab15-f5f1faa68d3f",
                                "sense_id": "cbfe4d25-f9fe-39e6-9655-b4168ef6e893",
                                "text": "„Der dicke Ledereinband mit dem Messingschloss stach ihm sofort ins Auge, und der Preis war, wie gesagt, lächerlich niedrig.“"
                            },
                            {
                                "example_id": "08a5cba6-0d0a-488b-9ef3-2c3008c9fa87",
                                "sense_id": "cbfe4d25-f9fe-39e6-9655-b4168ef6e893",
                                "text": "„Die Reichtümer, die sie anhäuften, schienen ihm nichts zu bedeuten; immerhin öffnete er täglich das Messingschloss, mit dem die aus Holz und Leder bestehende Truhe in seinem Quartier gesichert war, hob den Deckel und kippte ganze Säcke mit Wertsachen aus; die Truhe barg bereits Tausende von Dollar in Gold und Silber, außerdem Juwelen, Uhren, Revolver, gediegenes Gold in kleinen Lederbehältern, Silberbarren, Messer, Tafelsilber, Geschirr und Zahngold.“"
                            },
                            {
                                "example_id": "4bdc1e8c-bae8-4c38-b1ae-ba0967487071",
                                "sense_id": "cbfe4d25-f9fe-39e6-9655-b4168ef6e893",
                                "text": "„Das Tagebuch, das rote Leder voller Risse, ist mit einem kleinen Messingschloss verschließbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
