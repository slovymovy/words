                "senses": [
                    {
                        "sense_id": "89894fe3-4f54-31cb-96f1-e999c22ab9db",
                        "entry_id": "0d65d0ee-5803-3d55-b6a2-f76dc3cb7757",
                        "glosses": [
                            "besonders geschnittenes Kleid, das zum Reiten geeignet ist"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6118e101-8ff0-4f61-a56f-2aa407bbcafd",
                                "sense_id": "89894fe3-4f54-31cb-96f1-e999c22ab9db",
                                "text": "„Das Kaminfeuer trocknete die Schmutzspritzer auf ihrem Reitkleid und an ihren Stiefeln.“"
                            },
                            {
                                "example_id": "21238b4e-092e-4d90-bba4-99b63f89c520",
                                "sense_id": "89894fe3-4f54-31cb-96f1-e999c22ab9db",
                                "text": "„Mrs. Dayton hatte indessen, von Nancy unterstützt, ihr Reitkleid abgelegt, saß nachdenklich da und schickte ab und zu einen prüfenden Blick zu ihrer Schwester.“"
                            },
                            {
                                "example_id": "7796a29e-8b38-4fd0-9168-4dcbf25d2d91",
                                "sense_id": "89894fe3-4f54-31cb-96f1-e999c22ab9db",
                                "text": "„Jene junge Dame, die im Auto an Adam vorübergefahren war, kam in Federhut, Reitkleid und wehendem Mantel die Freitreppe herunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
