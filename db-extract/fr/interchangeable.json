                        "cross_references": [
                            {
                                "target_word": "interchangeable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd268f45-2f60-3e50-9683-635c1e40541f",
                                        "entry_id": "da52bcf2-df57-3b3c-aa3d-16f49a41a1ac",
                                        "glosses": [
                                            "Freely substitutable; that may be swapped at will."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1bff6a8-720a-4c10-bfe0-9a0ab222fab6",
                                                "sense_id": "dd268f45-2f60-3e50-9683-635c1e40541f",
                                                "text": "Eli Whitney's development of interchangeable parts was a breakthrough for modern manufacturing. Prior to that, each part had to be made custom."
                                            },
                                            {
                                                "example_id": "12d11957-ff7d-477e-9915-55f2c07189e4",
                                                "sense_id": "dd268f45-2f60-3e50-9683-635c1e40541f",
                                                "text": "Sometimes the same words mean opposite things. Sometimes the opposite is true. Shock absorbers are called shocks. Slow down and slow up are interchangeable."
                                            },
                                            {
                                                "example_id": "2c5cffef-e95b-48dd-b01d-5b4d2051b2e6",
                                                "sense_id": "dd268f45-2f60-3e50-9683-635c1e40541f",
                                                "text": "The English, until relatively recently, seem to have imagined “English” and “British” to be interchangeable, as if Britain was just a bigger England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95ed6b38-3a57-32e0-a179-63bd4eeab5a0",
                                        "entry_id": "da52bcf2-df57-3b3c-aa3d-16f49a41a1ac",
                                        "glosses": [
                                            "Following each other in alternate succession; alternating."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
