                        "sense_id": "4f96c732-b0ae-3b47-94f6-d57944afc1ec",
                        "entry_id": "9cdcb972-5bc6-36ce-8bac-d95428f6aa56",
                        "glosses": [
                            "phonologische Einheit, die den regelmäßigen phonologischen Wechsel zwischen den Allomorphen ein und desselben Morphems darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e17accc9-7076-40b8-baf7-eb9657a738b1",
                                "sense_id": "4f96c732-b0ae-3b47-94f6-d57944afc1ec",
                                "text": "Der Wechsel zwischen [t] und [d] bei den Allomorphen des Wortes \"Kind\" [kɪnt] (in: Kind) und [kɪnd]- (in: Kindes) ist ein Beispiel für ein Morphophonem im Deutschen; Notierweise: \"t : d\" oder \"D\". Die Form [kɪnD] mit dem Morphophonem \"D\" würde dann für beide Allomorphe des Wortes \"Kind\" stehen."
                            }
                        ],
