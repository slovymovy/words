                            {
                                "target_lang_word": "sailor",
                                "target_lang_sense_clarification": "A person whose occupation is navigating ships."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3858ba70-2270-33f0-a494-14dd0490cdb9",
                    "sense_definition": "iemand die meereist op een schip",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>schipper</w> genoot van het uitzicht vanaf het dek tijdens de overtocht.",
                            "target_lang_translations": {
