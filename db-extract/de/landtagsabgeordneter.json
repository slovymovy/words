                ],
                "senses": [
                    {
                        "sense_id": "55a108ed-d812-395c-a519-8752b91957ac",
                        "entry_id": "f13a5500-d9ef-3612-a580-3a6e403071cc",
                        "glosses": [
                            "gewählter Vertreter in einen Landtag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e3b09e-ca4c-4fac-9a3e-af47054abc9c",
                                "sense_id": "55a108ed-d812-395c-a519-8752b91957ac",
                                "text": "„Vor einigen Wochen war bekannt geworden, dass bayerische Landtagsabgeordnete Verwandte beschäftigen, obwohl dies per Gesetz verboten ist.“"
                            },
                            {
                                "example_id": "371a7850-e340-4877-a49a-26eccb57b42d",
                                "sense_id": "55a108ed-d812-395c-a519-8752b91957ac",
                                "text": "„Am 11. Dezember 2001 erließ die Steiermärkische Landesregierung einen Feststellungsbescheid über die Kürzung des dem Beschwerdeführer aus seiner Funktion als ehemaliger Landtagsabgeordneter zustehenden Ruhebezuges auf S 17.608,80.“"
                            },
                            {
                                "example_id": "fdb43ba3-de66-4677-8051-f61c4cac31ae",
                                "sense_id": "55a108ed-d812-395c-a519-8752b91957ac",
                                "text": "„Herr Castrup war Landtagsabgeordneter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
