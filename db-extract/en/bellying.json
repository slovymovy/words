    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ebfb25a3-bfda-3814-b534-f76b945dcb8f",
                "word": "bellying",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8909bc62-7291-34be-8b90-1415a02a7c2f",
                        "entry_id": "ebfb25a3-bfda-3814-b534-f76b945dcb8f",
                        "glosses": [
                            "Bulging or billowing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3cec83f2-baf8-496b-9b64-154e617e7421",
                                "sense_id": "8909bc62-7291-34be-8b90-1415a02a7c2f",
                                "text": "Did it change into the cry of the wind, plaintive at first, angrily shrill as it freshened, rising to a tearing whistle, sinking to a musical trickle of air from the leech of the bellying sail?"
                            },
                            {
                                "example_id": "434c89b6-08e8-4309-bfce-fb664b777145",
                                "sense_id": "8909bc62-7291-34be-8b90-1415a02a7c2f",
                                "text": "And the light mounts over the faces of all the tall blind houses, slides through a chink and paints the lustrous bellying crimson curtains […]"
                            },
                            {
                                "example_id": "cc90e6d6-a4e6-4dd6-9f6c-b62e8ce05479",
                                "sense_id": "8909bc62-7291-34be-8b90-1415a02a7c2f",
                                "text": "He looked at the stout bellying occupant of the other chair, his mouth open, his snores reverberant."
                            },
                            {
                                "example_id": "de426792-00ef-4d37-87eb-ea418c80f363",
                                "sense_id": "8909bc62-7291-34be-8b90-1415a02a7c2f",
                                "text": "As he swept out of the room with a bellying sweep of his gown and a toss of his silver hair, his old heart was beating madly."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "443127d2-d78f-3768-80ee-10fab76fef9f",
                "word": "bellying",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f0e4778e-f62c-4d5e-9459-e27fa2ea0979",
                        "entry_id": "443127d2-d78f-3768-80ee-10fab76fef9f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bellyings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d96ebb4c-decf-3cc6-a136-3275baffb1c0",
                        "entry_id": "443127d2-d78f-3768-80ee-10fab76fef9f",
                        "glosses": [
                            "A bulging, swelling or billowing shape; the act or state of bulging, swelling or billowing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa709ec9-347a-4a86-8667-bed16070a0ea",
                                "sense_id": "d96ebb4c-decf-3cc6-a136-3275baffb1c0",
                                "text": "1693, Simon de la Loubère, A New Historical Relation of the Kingdom of Siam, translated by A.P., London: Tho. Horne, Part II, Chapter II. Of the Houses of the Siamese, and of their Architecture in Publick Buildings, page 32,\nBut the Principal Ornament of the Pagodes, is to be accompanied, as generally they are, with several Pyramids of Lime and Brick […] Some there are which diminish and grow thick again four or five times in their heighth, so that the Profile of them goes waving: But these Bellyings out are smaller as they are in a higher part of the Pyramid."
                            },
                            {
                                "example_id": "2026284f-85bf-4065-9b1d-a3f6280fbd00",
                                "sense_id": "d96ebb4c-decf-3cc6-a136-3275baffb1c0",
                                "text": "1873, Gerard Manley Hopkins, “Sunset,” Diary entry dated 3 November, 1873, in The Dublin Review, July, August, September, 1920, p. 64,\nA few minutes later the brightness over; one great dull rope coiling overhead sidelong from the sunset, its dewlaps and bellyings painted with a maddery campion-colour that seemed to stoop and drop like sopped cake;"
                            },
                            {
                                "example_id": "5a2b845c-ed5f-414f-8e41-5b118335e709",
                                "sense_id": "d96ebb4c-decf-3cc6-a136-3275baffb1c0",
                                "text": "One may picture, too, the sudden shifting of the attention, the swiftly spreading coils and bellyings of that blackness advancing headlong, towering heavenward, turning the twilight to a palpable darkness […]"
                            },
                            {
                                "example_id": "09801ba7-d299-4342-8120-61a4eae71ea2",
                                "sense_id": "d96ebb4c-decf-3cc6-a136-3275baffb1c0",
                                "text": "The room into which I was ushered, with its leering volutes and hideous bellyings of brown mahogany, intimately reminded me of a Beardsley drawing."
                            }
                        ]
                    }
                ],
