    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2575d192-6515-37b8-ac77-36b71568e788",
                    "sense_definition": "In a metaphorical manner; not literally; by means of metaphor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>metaphorically</w> described the city as a living, breathing organism."
                        },
                        {
                            "text": "She <w>metaphorically</w> opened the door to new opportunities by learning a second language."
                        }
                    ],
                    "synonyms": [
                        "figuratively"
                    ],
                    "antonyms": [
                        "literally"
                    ],
                    "common_phrases": [
                        "metaphorically speaking"
                    ]
                },
                {
                    "sense_id": "a13a835f-d810-336e-8c97-042fe98c568c",
                    "sense_definition": "Used to draw attention that what follows is a metaphor, not to be taken literally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Metaphorically</w>, the weight of the world rested on his tired shoulders."
                        },
                        {
                            "text": "He was, <w>metaphorically</w>, burning bridges with his former colleagues after the argument."
                        }
                    ],
                    "synonyms": [
                        "figuratively"
                    ],
                    "antonyms": [
                        "literally"
                    ]
                }
            ]
        }
    ]
