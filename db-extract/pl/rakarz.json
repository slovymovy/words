                ],
                "senses": [
                    {
                        "sense_id": "81e1d250-0cac-3fb9-9495-e1ea9f59b9f9",
                        "entry_id": "674cf4e0-0a7c-3112-b765-20d1be37b12a",
                        "glosses": [
                            "osoba, która łapie bezpańskie psy"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1030e08d-7a9d-4498-aef1-a95286b0fa1b",
                        "source_entry_id": "674cf4e0-0a7c-3112-b765-20d1be37b12a",
                        "source_sense_id": "81e1d250-0cac-3fb9-9495-e1ea9f59b9f9",
                        "target_lang_word": "Schinder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schinder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ba07f99-bb2e-3ad4-a5a2-a7555d9c014e",
                                        "entry_id": "f8e9e4f6-cb06-338e-8fde-e8955eec6c3f",
                                        "glosses": [
                                            "eine Tätigkeitsbezeichnung beziehungsweise eine Person, die altersschwache oder kranke Haustiere und Vieh wegschafft oder tötet, diese nach der Verendung verwertet und die Reste beseitigt, sowie darüber hinaus freilaufende Hunde einfängt und Abfallgruben, Abfallhaufen und Kloaken reinigt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f46b6581-eaf9-40b8-bc1a-822822a42c8e",
                                                "sense_id": "7ba07f99-bb2e-3ad4-a5a2-a7555d9c014e",
                                                "text": "Man rief nach dem Schinder, weil niemand sonst die Frau abschneiden wollte, die sich selber erhängt hatte."
                                            },
                                            {
                                                "example_id": "50e877e1-6993-45ee-854c-0adb41186bb5",
                                                "sense_id": "7ba07f99-bb2e-3ad4-a5a2-a7555d9c014e",
                                                "text": "Aufgabe des Schinders war es, sich um die Verwertung toter Tiere zu kümmern."
                                            },
                                            {
                                                "example_id": "f9a53219-cffa-4b8d-b5bc-a5b73594d764",
                                                "sense_id": "7ba07f99-bb2e-3ad4-a5a2-a7555d9c014e",
                                                "text": "„Von links machen sich schon die Schinder zu schaffen, die blitzenden Messer mit fast zärtlicher Behutsamkeit ansetzend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7d750fc-9441-370c-8e7e-b46a35018188",
                                        "entry_id": "f8e9e4f6-cb06-338e-8fde-e8955eec6c3f",
                                        "glosses": [
                                            "eine Person, die Menschen quält, misshandelt oder ausbeutet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e508bf-5ef0-45d1-882d-5c9832c6abcb",
                                                "sense_id": "d7d750fc-9441-370c-8e7e-b46a35018188",
                                                "text": "Als Turnlehrer war er der reine Schinder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c867074f-05e0-3583-b354-39e8641da8da",
                                        "entry_id": "f8e9e4f6-cb06-338e-8fde-e8955eec6c3f",
                                        "glosses": [
                                            "minderwertiges Pferd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47defed-a937-4618-98d6-630c9fa60604",
                                                "sense_id": "c867074f-05e0-3583-b354-39e8641da8da",
                                                "text": "„Plötzlich erkenne ich sie wieder, es sind die uralten Schinder unseres versoffenen Gastwirts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "40f13b69-6710-39dd-b481-dd6812f1d18b",
                                        "entry_id": "f8e9e4f6-cb06-338e-8fde-e8955eec6c3f",
                                        "glosses": [
                                            "Hobel zur Bearbeitung von Holz, insbesondere zum Bearbeiten stark geschwungener Formen"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8426a8d-e10b-4bc4-afdf-667f717b556a",
                                                "sense_id": "40f13b69-6710-39dd-b481-dd6812f1d18b",
                                                "text": "Wesentlich ist vielleicht noch der Hinweis, daß man als wichtigstes Gerät im Tecklenburgischen das Zugmesser und in Gladbeck den Schinder angab."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
