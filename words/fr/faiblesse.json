                    ]
                },
                {
                    "sense_id": "04f56804-20d3-3a3f-a09b-6b896282c1dc",
                    "sense_definition": "Malaise passager caractérisé par une perte soudaine d'énergie physique ou un évanouissement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pris d'une soudaine <w>faiblesse</w>, le voyageur a dû s'asseoir sur un banc du quai."
