{
    "word_family": [
        "занятие",
        "занятость",
        "занятой",
        "занимательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f3ba1dc-c01c-3fe7-b571-44f2434280e2",
                    "sense_definition": "Тратить время на какое-либо дело, совершать какие-либо действия, работать над чем-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат начал серьезно <заниматься> спортом.",
                            "target_lang_translations": {
                                "en": "My brother started seriously <doing> sports.",
                                "zh": "我弟弟开始认真<w>从事</w>体育运动了。"
                            }
                        },
                        {
                            "text": "В выходные я планирую <заниматься> домашними делами.",
                            "target_lang_translations": {
                                "en": "On the weekend I plan to <do> household chores.",
                                "zh": "周末我打算<w>忙于</w>家务事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "заниматься спортом",
                        "заниматься бизнесом",
                        "заниматься делами",
                        "заниматься вопросом",
                        "заниматься любовью"
                    ],
                    "target_lang_definitions": {
                        "en": "To spend time on a task, perform actions, or work on something.",
                        "zh": "花费时间做某事，进行某项活动或处理某项工作。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "do",
                                "target_lang_sense_clarification": "general activities, sports, or chores"
                            },
                            {
                                "target_lang_word": "be engaged in",
                                "target_lang_sense_clarification": "formal work, business, or activities"
                            },
                            {
                                "target_lang_word": "deal with",
                                "target_lang_sense_clarification": "handling issues or matters"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "从事",
                                "target_lang_sense_clarification": "用于职业、事业或长期活动"
                            },
                            {
                                "target_lang_word": "忙于",
                                "target_lang_sense_clarification": "用于日常事务或家务"
                            },
                            {
                                "target_lang_word": "处理",
                                "target_lang_sense_clarification": "用于解决问题或事务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d7f55df-730e-3ca7-ac0c-006ec872598b",
                    "sense_definition": "Усваивать знания, изучать какой-либо предмет или быть учеником учебного заведения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты должны много <заниматься>, чтобы сдать экзамены.",
                            "target_lang_translations": {
                                "en": "Students must <study> a lot to pass exams.",
                                "zh": "学生们必须努力<w>学习</w>才能通过考试。"
                            }
                        },
                        {
                            "text": "Она <занимается> русским языком с частным преподавателем.",
                            "target_lang_translations": {
                                "en": "She <studies> Russian with a private tutor.",
                                "zh": "她正在跟一位私人老师<w>学习</w>俄语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "учи́ться"
                    ],
                    "common_phrases": [
                        "заниматься в школе",
                        "заниматься музыкой",
                        "заниматься с репетитором",
                        "заниматься в библиотеке"
                    ],
                    "target_lang_definitions": {
                        "en": "To acquire knowledge, learn a subject, or attend an educational institution.",
                        "zh": "获取知识，学习某门学科或在学校接受教育。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "study",
                                "target_lang_sense_clarification": "academic context or learning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学习",
                                "target_lang_sense_clarification": "指获取知识或技能的活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f96392b1-77c0-3a51-8718-ad71153a52d1",
                    "sense_definition": "Страдательный залог к глаголу <w>занимать</w> (брать в долг или заполнять место).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лучшие места в зале <занимаются> задолго до начала концерта.",
                            "target_lang_translations": {
                                "en": "The best seats in the hall <are taken> long before the concert starts.",
                                "zh": "音乐会开始前很久，最好的座位就已经<w>被占用</w>了。"
                            }
                        },
                        {
                            "text": "Деньги обычно <занимаются> у друзей или родственников.",
                            "target_lang_translations": {
                                "en": "Money is usually <borrowed> from friends or relatives.",
                                "zh": "钱通常是向朋友或亲戚<w>借入</w>的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "passive voice"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive form of 'occupy' (take up space) or 'borrow' (take money on loan).",
                        "zh": "动词“占用”或“借入”的被动形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be taken",
                                "target_lang_sense_clarification": "regarding seats or places"
                            },
                            {
                                "target_lang_word": "be occupied",
                                "target_lang_sense_clarification": "regarding seats or places"
                            },
                            {
                                "target_lang_word": "be borrowed",
                                "target_lang_sense_clarification": "regarding money"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被占用",
                                "target_lang_sense_clarification": "指座位或空间被占据"
                            },
                            {
                                "target_lang_word": "被借入",
                                "target_lang_sense_clarification": "指钱财被借走"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4de8184e-5fc7-3095-ba97-53178d8e6eef",
                    "sense_definition": "Начинать гореть (об огне) или светать (о заре, рассвете).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На востоке медленно <занималась> ранняя заря.",
                            "target_lang_translations": {
                                "en": "In the east, the early dawn was slowly <breaking>.",
                                "zh": "东方正慢慢<w>破晓</w>。"
                            }
                        },
                        {
                            "text": "От брошенной спички мгновенно <занимается> сухая трава.",
                            "target_lang_translations": {
                                "en": "Dry grass instantly <catches fire> from a thrown match.",
                                "zh": "干草被扔掉的火柴瞬间点燃而<w>着火</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "заря занимается",
                        "пожар занимается",
                        "огонь занимается"
                    ],
                    "target_lang_definitions": {
                        "en": "To start burning (fire) or to appear (dawn).",
                        "zh": "指火开始燃烧，或指黎明出现。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "of dawn or day"
                            },
                            {
                                "target_lang_word": "catch fire",
                                "target_lang_sense_clarification": "of fire or flames"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "着火",
                                "target_lang_sense_clarification": "指物体开始燃烧"
                            },
                            {
                                "target_lang_word": "破晓",
                                "target_lang_sense_clarification": "指黎明到来"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}