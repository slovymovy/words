    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "01b43638-27ea-3c97-9739-26a99d4ebe00",
                    "sense_definition": "Qui arrive à un mauvais moment, inopportun ou déplacé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inopportun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa remarque était particulièrement <w>malvenue</w> lors de cette réunion importante."
                        },
                        {
                            "text": "Cette interruption imprévue est <w>malvenue</w> au milieu de notre discussion sérieuse."
                        }
                    ],
                    "synonyms": [
                        "inopportun",
                        "déplacé",
                        "fâcheux"
                    ],
                    "antonyms": [
                        "bienvenu"
                    ],
                    "common_phrases": [
                        "remarque malvenue",
                        "intervention malvenue"
                    ]
                },
                {
                    "sense_id": "8fad9cdc-9286-38eb-9ab8-fa965bcfbcb8",
                    "sense_definition": "Qui n'a pas de légitimité, de droit ou de raison valable pour faire ou dire une chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illégitime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu es bien <w>malvenu</w> de critiquer ses méthodes après tes propres erreurs."
                        },
                        {
                            "text": "Le responsable serait <w>malvenu</w> de refuser cette demande tout à fait légitime."
                        }
                    ],
                    "synonyms": [
                        "illégitime",
                        "infondé"
                    ],
                    "common_phrases": [
                        "être malvenu de"
                    ]
                },
                {
                    "sense_id": "e276a6cd-8d75-3f9a-8f50-dc2dcae92a86",
                    "sense_definition": "Qui ne s'est pas développé normalement, en parlant d'un végétal ou d'un être vivant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "développement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette terre aride ne pousse qu'un arbuste chétif et <w>malvenu</w>."
                        },
                        {
                            "text": "Les récoltes ont souffert de la sécheresse, donnant des fruits petits et <w>malvenus</w>."
                        }
                    ],
                    "synonyms": [
                        "chétif",
                        "rabougri",
                        "étriolé"
                    ],
                    "common_phrases": [
                        "arbre malvenu"
                    ]
                }
            ]
        }
    ]
