                    {
                        "translation_id": "7fd2580e-7043-4922-a6fa-d3ce91245379",
                        "source_entry_id": "81957685-cb8c-3f32-bba3-73c5ff60cc81",
                        "source_sense_id": "0f6cf8bb-1544-34c7-a523-d76efcc150e8",
                        "target_lang_word": "Grazie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grazie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cad1d5f-c0c7-3b73-82ef-ea27f04d82c9",
                                        "entry_id": "4343fa99-4b46-30e8-b33a-0d739abb8a64",
                                        "glosses": [
                                            "Schönheit der Bewegung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "000fe77e-d1aa-461b-bbe1-3c623b8e65b4",
                                                "sense_id": "3cad1d5f-c0c7-3b73-82ef-ea27f04d82c9",
                                                "text": "\"Anmut und Grazie bestimmten den Nachmittag, zauberhaft präsentiert von diesen kleinen Tanzelfen.\""
                                            },
                                            {
                                                "example_id": "5b8798db-5840-47eb-ab5f-87a2567bdeea",
                                                "sense_id": "3cad1d5f-c0c7-3b73-82ef-ea27f04d82c9",
                                                "text": "\"Die Körperhaltung, die Grazie und die Ausdrucksstärke der Mädchen nötigen Respekt ab und zeigen den großen Aufwand, den die Mädchen leisten müssen, hatte Guido Schöneboom bei einem Empfang zum Bundesfinale am Freitag gesagt.\""
                                            },
                                            {
                                                "example_id": "b149feaf-f430-414f-81ce-5b962e184da6",
                                                "sense_id": "3cad1d5f-c0c7-3b73-82ef-ea27f04d82c9",
                                                "text": "\"Mit ausgeprägtem Spürsinn für tonmalerische Elemente und einer stimmigen Balance zwischen Farbdetail und großem Bogen widmeten sich die Instrumentalisten diesen zwischen Eingängigkeit und höfischer Grazie angesiedelten Kompositionen und ließen sie zu anregenden Klangerlebnissen werden.\""
                                            },
                                            {
                                                "example_id": "7c9cd79e-d1f1-426f-aa26-98e3a73e9110",
                                                "sense_id": "3cad1d5f-c0c7-3b73-82ef-ea27f04d82c9",
                                                "text": "Sie ist gertenschlank, dunkelhaarig und überzeugte mit ihrer Grazie sämtliche Juroren: Vanessa ist \"Germany's next Topmodel\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "684717f0-5bd7-3195-87ef-b4d9c10040a2",
                                        "entry_id": "4343fa99-4b46-30e8-b33a-0d739abb8a64",
                                        "glosses": [
                                            "eine der drei Göttinnen der Anmut und Schönheit"
                                        ],
                                        "tags": [
                                            "römische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5154d040-8f25-4b51-8605-d80e376b99c6",
                                                "sense_id": "684717f0-5bd7-3195-87ef-b4d9c10040a2",
                                                "text": "\"Bevor der Besucher zum Saal der Paolina gelangt, empfangen ihn im Atrium Grazien, Nymphen und Göttinnen von unvergleichlicher Schönheit.\""
                                            },
                                            {
                                                "example_id": "7e14d5f6-24b7-4342-902d-738e23ff08f0",
                                                "sense_id": "684717f0-5bd7-3195-87ef-b4d9c10040a2",
                                                "text": "\"Bei Raffael wurden die drei Kharites dann zu den drei Grazien, die Édith Carron nun in einer Spezialanfertigung für unsere Crowdfunding-Aktion neu interpretiert.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3b5fb39e-c988-3c96-87a7-601628b86b41",
                                        "entry_id": "4343fa99-4b46-30e8-b33a-0d739abb8a64",
                                        "glosses": [
                                            "schöne, junge Frau"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01b27c1b-934d-416a-ba69-10efe0ffb130",
                                                "sense_id": "3b5fb39e-c988-3c96-87a7-601628b86b41",
                                                "text": "„Die Krone von allem, Victoria, saß auf dem Divan im weißen Hauskleide, schön wie eine Grazie.“"
                                            },
                                            {
                                                "example_id": "aec5aa50-85c5-4d74-8a3c-2c754254365a",
                                                "sense_id": "3b5fb39e-c988-3c96-87a7-601628b86b41",
                                                "text": "„Anders als die zierlichen Grazien in ihrer Begleitung wirkte sie ungewöhnlich athletisch, dabei aber noch immer sehr feminin.“"
                                            },
                                            {
                                                "example_id": "0c4d874b-f184-4b5e-8f80-4dd9db9da6a0",
                                                "sense_id": "3b5fb39e-c988-3c96-87a7-601628b86b41",
                                                "text": "\"Was also denkt sich der weißhäutige Besucher des Starnberger Strandbads, wenn er abends erst in sein welkes Portemonnaie und dann auf den See schaut, wo gerade ein sonnengegerbter Altstar mit wehendem Haar und drei Grazien im Schlepptau auf seiner hölzernen Motoryacht gen Hafen fährt?\""
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
