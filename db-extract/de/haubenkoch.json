                "senses": [
                    {
                        "sense_id": "7aa55033-9b27-329f-93e2-a77d0ed13d5b",
                        "entry_id": "46bca488-6b3c-3658-9000-db5917a4d123",
                        "glosses": [
                            "Koch, der mit einer oder mehreren Hauben ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8003ca4-0ab7-441f-af2c-3ad52968f6c6",
                                "sense_id": "7aa55033-9b27-329f-93e2-a77d0ed13d5b",
                                "text": "„Man kennt ihn aus der ORF-Show ‚Wild Cooking‘: Haubenkoch Bernie Rieder, soeben in seiner neuen Arbeitsstätte ‚Freiraum 117‘ gelandet, macht derzeit in einer Kooperation mit Absolut Wodka von sich reden.“"
                            },
                            {
                                "example_id": "57364770-8d87-44b3-8798-f72aa86c6039",
                                "sense_id": "7aa55033-9b27-329f-93e2-a77d0ed13d5b",
                                "text": "„Der junge Haubenkoch im Kleinwalsertal ist jedoch nicht nur kreativ in der Küche – mit Leidenschaft forscht er in über 100 Jahre alten Rezeptbüchern.“"
                            },
                            {
                                "example_id": "d28e5af7-f71c-4d89-9d1a-d449d06a20a3",
                                "sense_id": "7aa55033-9b27-329f-93e2-a77d0ed13d5b",
                                "text": "„Dort sollte seit neuestem ein Haubenkoch zugange sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
