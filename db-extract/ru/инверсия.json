                                        "examples": [
                                            {
                                                "example_id": "825f39ab-8944-46fd-a26a-f4c209092fc6",
                                                "sense_id": "2567a79c-ef5d-3554-b1c2-2a272b05d984",
                                                "text": "We can seldom, therefore, congratulate ourselves on the success of any \"cure\" of inversion."
                                            },
                                            {
                                                "example_id": "72e5fda0-be0f-4c76-901f-0047048a5f9c",
                                                "sense_id": "2567a79c-ef5d-3554-b1c2-2a272b05d984",
                                                "text": "My father, León Fuertes, was a fag three years; […] He put on all the trappings of inversion: the twittered mouthings, the hyper-feminine moues, the languid mincings."
                                            }
                                        ]
