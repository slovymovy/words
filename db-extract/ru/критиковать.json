                ],
                "translations": [
                    {
                        "translation_id": "c6755eb9-6289-413e-aad9-27cf57854998",
                        "source_entry_id": "4c11a5e2-9189-32f0-8985-71e23bd71de0",
                        "target_lang_word": "criticize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criticize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a91c157-712d-34ae-acf7-4ca0a1ece144",
                                        "entry_id": "2fb78c55-da95-3ecd-aa46-6233a00e489b",
                                        "glosses": [
                                            "To find fault (with something)."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6eed10b-7686-487f-9ce6-e2699ec2da61",
                                                "sense_id": "9a91c157-712d-34ae-acf7-4ca0a1ece144",
                                                "text": "Since when is it a hanging offense to criticize someone who's not doing the job he's paid generously to do?"
                                            },
                                            {
                                                "example_id": "25245fd7-8fd0-45b4-acac-eb4892f2b8ab",
                                                "sense_id": "9a91c157-712d-34ae-acf7-4ca0a1ece144",
                                                "text": "They criticized him for endangering people's lives."
                                            },
                                            {
                                                "example_id": "c6000925-22bb-40ba-b783-ac1be2f2252f",
                                                "sense_id": "9a91c157-712d-34ae-acf7-4ca0a1ece144",
                                                "text": "Homophobia is based on criticizing any sexual expression outside of procreational sex."
                                            },
                                            {
                                                "example_id": "1ab96167-9bdb-426a-a280-c2d3824f8a9a",
                                                "sense_id": "9a91c157-712d-34ae-acf7-4ca0a1ece144",
                                                "text": "But far from being naïve Scandinavist ideologists, Blix et al. continually criticizes the utopian Scandinavists' talk of brotherhood and 'one culture', but also—and perhaps most importantly—made cultural separatism and provincialism, particularly in Norway, the object of crass satire."
                                            },
                                            {
                                                "example_id": "abc68023-75dd-4098-89c3-20dfbf69b7bf",
                                                "sense_id": "9a91c157-712d-34ae-acf7-4ca0a1ece144",
                                                "text": "Then Federal Minister of Environment Antonin Vavrougek had strongly criticized the entire project while working at the Czechoslovak Academy of Sciences in Prague, taking a more limitationist view about the possibilities of generating electricity and a more alarmist view about the effect on drinking water supplies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d803ecc-a849-31b1-9fed-c368a5699b9b",
                                        "entry_id": "2fb78c55-da95-3ecd-aa46-6233a00e489b",
                                        "glosses": [
                                            "To evaluate (something), assessing its merits and faults."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
