                "translations": [
                    {
                        "translation_id": "d604f631-cfe7-4be9-b780-5376242c1fc0",
                        "source_entry_id": "ea62570a-e29b-3e90-b87f-e3962ee9e0fd",
                        "source_sense_id": "f1a0791b-1340-37bb-b0bc-9f0cb2e9d8a7",
                        "target_lang_word": "government",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "government",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The body with the power to make and/or enforce laws to control a country, land area, people or organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "901f95ca-22f6-4612-b55c-0dd046c00a24",
                                                "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                                "text": "British government has historically centred exclusively on London."
                                            },
                                            {
                                                "example_id": "c7162a78-4781-405a-8d6f-b54bbd68c996",
                                                "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                                "text": "[…]and that government of the people, by the people, for the people, shall not perish from the earth."
                                            },
                                            {
                                                "example_id": "7c962d50-f2b0-412a-b3ce-041d2a4a1aaa",
                                                "sense_id": "1af638f7-02e2-3681-be25-b18be74da387",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a34b48-5e6b-3f58-895d-47b0273e3ea5",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The relationship between a word and its dependents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The state and its administration viewed as the ruling political power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd64ec1-5cc2-4c8c-ac53-823a6c221af7",
                                                "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                                "text": "Near-synonyms: state, administration"
                                            },
                                            {
                                                "example_id": "718ce41a-aa52-47ad-84e1-83b843f34b00",
                                                "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                                "text": "If the citizens must follow the law, then the government must follow the constitution."
                                            },
                                            {
                                                "example_id": "07a310fc-77c6-441c-b938-062a235a25e9",
                                                "sense_id": "87120746-e4a9-3d6d-864a-7b5b2b963902",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The management or control of a system."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9811273b-a1bd-4a6f-94d4-c7c0b01d235a",
                                                "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                                "text": "The government of the Church is maintained without material alteration in a settled hierarchical form."
                                            },
                                            {
                                                "example_id": "9821cbca-4d13-4952-bf9a-a4802611cd72",
                                                "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                                "text": "Whereas it is expedient to amend the law relating to the government of Her Majesty's Navy, whereon, under the good Providence of God, the wealth, safety and strength of the Kingdom so much depend:"
                                            },
                                            {
                                                "example_id": "e7772250-6079-4468-a62b-783f6bc64ea9",
                                                "sense_id": "909c1986-31af-3ce3-bf03-b3270a114ee7",
                                                "text": "Ainsi, dans une société donnée, l’autorité de l’homme sur l’homme est en raison inverse du développement intellectuel auquel cette société est parvenue, et la durée probable de cette autorité peut être calculée sur le désir plus ou moins général d’un gouvernement vrai, c’est-à-dire, d’un gouvernement selon la science."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254bcfe7-58ac-3899-9fe4-d3f8b26b3264",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The tenure of a head of government; the ministry or administration led by a specified individual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4e4092-7171-4eef-8c66-255302a22463",
                                                "sense_id": "254bcfe7-58ac-3899-9fe4-d3f8b26b3264",
                                                "text": "The Sunak government announced plans to stem the flow of migrants coming into Great Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32393519-3581-386c-94ac-ac501c35c943",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "In a parliamentary system, the political party or coalition in power; its condition of being in power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c74b74a6-f570-34d5-9723-54ff9f51010a",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "The team tasked with presenting and speaking in favour of a resolution, as opposed to the opposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03da3cee-5ba0-3d0a-bc05-9ba402bc69cf",
                                        "entry_id": "642372bf-d99d-3531-8d29-0f1dfe17f837",
                                        "glosses": [
                                            "Ellipsis of government name, one's legal name according to a government."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "702bd10e-2b54-4c7e-9e68-e13ae181a286",
                        "source_entry_id": "ea62570a-e29b-3e90-b87f-e3962ee9e0fd",
                        "source_sense_id": "f1a0791b-1340-37bb-b0bc-9f0cb2e9d8a7",
                        "target_lang_word": "cabinet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabinet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41c3017a-3940-3467-ab8d-7a24ad588c1f",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A storage closet either separate from, or built into, a wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "007bbc95-17aa-33ad-bf56-0f4392d5dd39",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A cupboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ae1518-fa91-4946-bef5-369f49eb52cc",
                                                "sense_id": "007bbc95-17aa-33ad-bf56-0f4392d5dd39",
                                                "text": "‘[…] There's every Staffordshire crime-piece ever made in this cabinet, and that's unique. The Van Hoyer Museum in New York hasn't that very rare second version of Maria Marten's Red Barn over there, nor the little Frederick George Manning—he was the criminal Dickens saw hanged on the roof of the gaol in Horsemonger Lane, by the way—’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915d72ca-51e2-374f-b11d-a05c08ebbab0",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A source of valuable things; a storehouse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da862cc1-525c-4a32-bda5-ab09545a1880",
                                                "sense_id": "915d72ca-51e2-374f-b11d-a05c08ebbab0",
                                                "text": "It is a perfect cabinet of faithful, valuable, and extensive information; and it ought to have a place on the shelves of the most select and compact library, and be in the possession of every private family, as a work both of valuable reference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae7d9f87-d1bd-3780-a91f-691f3ac27122",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "The upright assembly that houses a coin-operated arcade game, a cab."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "317c18ea-383a-3e09-9625-ade230214552",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A size of photograph, specifically one measuring 3⅞\\\" by 5½\\\"."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885f5a19-4664-4d16-855c-93515ef2bd15",
                                                "sense_id": "317c18ea-383a-3e09-9625-ade230214552",
                                                "text": "Holmes took a note of it. “One other question,” said he. “Was the photograph a cabinet?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1acd9061-9b6c-3b49-989a-0af57cd26aff",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A group of advisors to a government or business entity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0be5cc8c-d60e-3009-b92e-9d59ee0767f1",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "In parliamentary and some other systems of government, the group of ministers responsible for creating government policy and for overseeing the departments comprising the executive branch."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a9c73dd-c810-4828-a05d-05821275b6f1",
                                                "sense_id": "0be5cc8c-d60e-3009-b92e-9d59ee0767f1",
                                                "text": "Lincoln had a great deal of trouble with his Cabinet because some of them got it into their heads that they, and not the President, were the policy-makers. James K. Polk had the same difficulty with his Cabinet. Franklin Roosevelt never had any difficulty with his Cabinet for the simple reason that he himself, in my opinion, spent too much time doing the work that should have been delegated to the Cabinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4059893e-7089-3828-8e61-ade246a9e0ee",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "In parliamentary and some other systems of government, the group of ministers responsible for creating government policy and for overseeing the departments comprising the executive branch.",
                                            "A cabinet-level agency in the executive branch; that is, an agency headed by a member of the governor's cabinet."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13dba8fe-ddf6-4ce1-923d-d35867cfd61a",
                                                "sense_id": "4059893e-7089-3828-8e61-ade246a9e0ee",
                                                "text": "The executive branch of Kentucky state government is structured on a program cabinet system consisting of 14 program cabinets, each headed by a secretary, who is appointed by the Governor. The program cabinets listed below and the agencies within each cabinet are designated in the statutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f929cc6f-891d-3b0f-9921-a4fc521ef6f8",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A small chamber or private room."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f323536b-be58-488c-84ef-e2a95bb37a7b",
                                                "sense_id": "f929cc6f-891d-3b0f-9921-a4fc521ef6f8",
                                                "text": "Philip passed some hours every day in his father's cabinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d0bd4a2-2d06-37ff-857f-309963d777b9",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A collection of art or ethnographic objects."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecbd9691-a2f7-3123-9dad-f0d1ad5755b2",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "Milkshake."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa4b6e29-bd14-4e8f-8457-270dc17e88cf",
                                                "sense_id": "ecbd9691-a2f7-3123-9dad-f0d1ad5755b2",
                                                "text": "One of Rhode Island's most famous beverages is the Awful Awful, an enormous 32-ounce, rich, creamy milk shake sold at the Newport Creamery stores, a soda fountain and casual restaurant chain. This ultra-thick cabinet is \"awful big and awful good,\" thus the name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "399cebd0-5e3c-3bc1-8056-bb601fea7ebd",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
                                        "glosses": [
                                            "A hut; a cottage; a small house."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9270984-bde5-4e8a-875e-89fa4882319f",
                                                "sense_id": "399cebd0-5e3c-3bc1-8056-bb601fea7ebd",
                                                "text": "Hearken a while from thy green cabinet, / The rural song of careful Colinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e8665b-dc1b-33c7-a0ca-2ed977c0ffce",
                                        "entry_id": "586eed20-f0c0-3446-9485-debf9008cce7",
