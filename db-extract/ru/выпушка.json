                                        "entry_id": "87b49bb3-8822-33b0-a143-80db911f5a85",
                                        "glosses": [
                                            "High-pitched."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5f5d2c-8d90-42ad-a58d-45a25f13d1bb",
                                                "sense_id": "755ab3b5-5aa8-30bd-8e1b-02d14834046d",
                                                "text": "His piping voice could be heard above the hubbub."
                                            },
                                            {
                                                "example_id": "7a5c855f-4d41-4b0a-9b85-d6b37a7aad30",
                                                "sense_id": "755ab3b5-5aa8-30bd-8e1b-02d14834046d",
                                                "text": "The princess had made occasional wartime radio broadcasts, her piping, stilted voice, speaking in cut-glass tones to the children of the empire, but it was at the time of her 21st birthday in 1947 that she made perhaps the most significant radio address of her career, at the end of a royal tour of South Africa, laying out the guidelines that would govern her throughout her reign:"
                                            }
                                        ]
