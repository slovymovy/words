                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c65b5e-63c0-4f3e-9c45-288a66ea7997",
                                "sense_id": "c9f09880-1d62-36b5-ab60-dfd2f781972f",
                                "text": "Z powodu uszkodzenia światłowodów szkolne łącze straciło większą część przepustowości."
                            },
                            {
                                "example_id": "f01b2019-8e4d-442f-8d19-b6bb71171754",
                                "sense_id": "c9f09880-1d62-36b5-ab60-dfd2f781972f",
                                "text": "Szacuje się, że zbudowany na przełomie XX i XXI wieku Most Sundzki, łączący do tej pory Kopenhagę z Malmö, osiągnie swoją maksymalną przepustowość za kilkanaście lat."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
