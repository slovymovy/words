                "senses": [
                    {
                        "sense_id": "f70a0516-90e1-34cd-9ea2-73929940096b",
                        "entry_id": "49d33e72-2f34-36a7-96f8-ca6a4426276d",
                        "glosses": [
                            "allmähliche Verminderung des Tageslichts nach Sonnenuntergang; Zeitraum zwischen Sonnenuntergang und Eintritt der Dunkelheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ce9f9c2-bac0-4a9a-b338-ad28ebba04c9",
                                "sense_id": "f70a0516-90e1-34cd-9ea2-73929940096b",
                                "text": "„Und weich wie die Luft lag auch das erste Abenddämmern auf der Gegend; die harten, unvermittelten Töne der winterlichen Tagesbeleuchtung erloschen zu einem einzigen milden Grau, aus welchem bereits da und dort das Lampenlicht vereinzelter Dorfhäuser auftauchte.“"
                            },
                            {
                                "example_id": "ffa8d421-dcee-4f7b-9be1-1d12fbfc44e7",
                                "sense_id": "f70a0516-90e1-34cd-9ea2-73929940096b",
                                "text": "„Die Springbrunnen plätscherten traumhaft, und im leisen Abenddämmern schwebten die großglockigen Blumen, die Blüthendolden der Pflanzenfremdlinge wie breitbeschwingte Falter um das Laubdickicht.“"
                            },
                            {
                                "example_id": "0558231e-d3b2-4bf0-b11b-7f3be0661406",
                                "sense_id": "f70a0516-90e1-34cd-9ea2-73929940096b",
                                "text": "„Und zwischen Morgengrauen und Abenddämmern marschieren die Massen durchs magische Königreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
