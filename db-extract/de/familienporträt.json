                "senses": [
                    {
                        "sense_id": "517a751e-f60e-3e52-9765-3c7711ccd336",
                        "entry_id": "9ad308c2-1b5e-3b8b-b4ac-53fe6aef103c",
                        "glosses": [
                            "Porträt, das Mitglieder einer Familie darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264311a9-3b23-4e66-a7ca-e89a0ac3a98e",
                                "sense_id": "517a751e-f60e-3e52-9765-3c7711ccd336",
                                "text": "„Die Jermyns schienen schon immer irgendwie seltsam auszusehen - irgendetwas schien zu fehlen, doch bei Arthur war es am schlimmsten, denn die alten Familienporträts im Haus der Jermyns, die aus der Zeit vor Sir Wade stammten, zeigten durchaus auch edle Gesichter.“"
                            },
                            {
                                "example_id": "3ac7e3fc-32e0-4bd3-9f66-b8dcbe880469",
                                "sense_id": "517a751e-f60e-3e52-9765-3c7711ccd336",
                                "text": "„Aufgeschlitzte Familienporträts würden auf ihre von zerbrochenen Statuen festgenagelten Leichen herabblicken.“"
                            },
                            {
                                "example_id": "bcc984cd-da97-4455-8390-33aee15dd5d7",
                                "sense_id": "517a751e-f60e-3e52-9765-3c7711ccd336",
                                "text": "„An den Wänden hingen großformatige Familienporträts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
