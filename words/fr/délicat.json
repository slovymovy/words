                        "sujet délicat"
                    ]
                },
                {
                    "sense_id": "d49b4e9b-9290-3747-8512-d814f0bad6e0",
                    "sense_definition": "Qui est fait avec une grande finesse, une grande subtilité ou une texture douce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce rideau est tissé dans une soie particulièrement <w>délicate</w>."
                        },
                        {
                            "text": "Le peintre a représenté les traits de son visage avec un pinceau très <w>délicat</w>."
                        }
                    ],
                    "synonyms": [
                        "fin"
                    ],
                    "antonyms": [
                        "grossier"
                    ],
                    "common_phrases": [
