                                        "sense_id": "dfe82d0c-7a43-3073-9859-df53ad5ba86c",
                                        "entry_id": "c9e91905-533e-376f-814b-056d234f39f3",
                                        "glosses": [
                                            "A narrow squeak."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04cbed24-2941-4c0e-90e7-4e451ef306cf",
                                                "sense_id": "dfe82d0c-7a43-3073-9859-df53ad5ba86c",
                                                "text": "\"I had the very devil of a squeak for it,\" he went on. \"I did the hurdles over two or three garden-walls, but so did the flyer who was on my tracks, and he drove me back into the straight and down to High Street like any lamplighter. […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squeak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36260d89-fd7d-37e7-ba05-141dcee2069c",
                                        "entry_id": "da32caab-c953-3aa3-849a-f87f9dd30191",
                                        "glosses": [
                                            "To emit a short, high-pitched sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "083e5d89-daff-4e7e-9af2-598810a4b78f",
                                                "sense_id": "36260d89-fd7d-37e7-ba05-141dcee2069c",
                                                "text": "But I must warn you that chipboard floors are always likely to squeak. The material is still being used in new-builds, but developers now use adhesive to bed and joint it, rather than screws or nails. I suspect the adhesive will eventually embrittle and crack, resulting in the same squeaking problems as before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f664276-5d5d-3235-96f8-693d0769a806",
                                        "entry_id": "da32caab-c953-3aa3-849a-f87f9dd30191",
                                        "glosses": [
                                            "To inform, to squeal."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ad3e3c4-a993-4037-a606-0d381085a973",
                                                "sense_id": "1f664276-5d5d-3235-96f8-693d0769a806",
                                                "text": "If he be obstinate, put a civil question to him upon the rack, and he squeaks, I warrant him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7f068c-4aa7-36e3-acd4-cc35aa557524",
                                        "entry_id": "da32caab-c953-3aa3-849a-f87f9dd30191",
                                        "glosses": [
                                            "To speak or sound in a high-pitched manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac1d8bd-5ca2-38d9-a9bb-bfcb26bf07a7",
                                        "entry_id": "da32caab-c953-3aa3-849a-f87f9dd30191",
                                        "glosses": [
                                            "To empty the pile of 13 cards a player deals to oneself in the card game of the same name."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9884e6f1-6d9c-3342-b27f-4267e9064f93",
                                        "entry_id": "da32caab-c953-3aa3-849a-f87f9dd30191",
                                        "glosses": [
                                            "To win or progress by a narrow margin."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e741f836-5f61-4328-b794-b40b591d45f6",
                                                "sense_id": "9884e6f1-6d9c-3342-b27f-4267e9064f93",
                                                "text": "[…] allowing Parkinson to squeak into the final by a half-point margin."
                                            },
                                            {
                                                "example_id": "eb7e654a-e2a2-4490-850e-3d2d8ea66b2e",
                                                "sense_id": "9884e6f1-6d9c-3342-b27f-4267e9064f93",
                                                "text": "France were transformed from the feeble, divided unit that had squeaked past Wales in the semi-final, their half-backs finding the corners with beautifully judged kicks from hand, the forwards making yards with every drive and a reorganised Kiwi line-out beginning to malfunction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
