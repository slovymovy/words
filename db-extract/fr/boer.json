                    {
                        "sense_id": "967f0973-6192-3af7-9831-3c42b50588ce",
                        "entry_id": "2b0dbe56-8259-3b16-9e2e-babf5332a3ab",
                        "glosses": [
                            "Policier chargé de contrôler les taxis et assimilés."
                        ],
                        "tags": [
