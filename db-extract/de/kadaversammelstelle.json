                "senses": [
                    {
                        "sense_id": "24c45764-efca-39bf-a8cd-90bec9eac2d4",
                        "entry_id": "9e652c48-05e0-3172-88de-c483f2d21dcb",
                        "glosses": [
                            "Sammelstelle an dem Kadaver zentral eingesammelt und entsorgt werden"
                        ],
                        "tags": [
                            "Fachsprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "cb08c819-39e1-419d-ac93-793757dd0688",
                                "sense_id": "24c45764-efca-39bf-a8cd-90bec9eac2d4",
                                "text": "„Jede Anlieferung in der Kadaversammelstelle muss in der aufgelegten Selbstdeklarationskontrolle eingetragen werden. Entgegengenommen werden Kadaver von Vögeln, Nagern, Katzen, kleinen, mittelgrossen und grossen Hunden, Lämmern, Ferkeln, Schafen, Ziegen, Schweinen, Kälbern und Fohlen.“"
                            },
                            {
                                "example_id": "6d761a65-fe02-47d7-9ff9-42867a3a1983",
                                "sense_id": "24c45764-efca-39bf-a8cd-90bec9eac2d4",
                                "text": "„Tier- und Schlachtabfälle müssen nach gesetzlichen Vorgaben entsorgt werden. Der Betrieb der Kadaversammelstelle in der ARA Merenschwand, wird durch die angeschlossenen Gemeinden sichergestellt.“"
                            },
                            {
                                "example_id": "ae510a94-6ca8-4029-a575-332553d5f2e5",
                                "sense_id": "24c45764-efca-39bf-a8cd-90bec9eac2d4",
                                "text": "„Die Kadaversammelstelle Thun befindet sich an der Uttigenstrasse im Lerchenfeld (nächst Schlachthof).“"
                            },
                            {
                                "example_id": "01328685-d197-45d0-b727-102d908176a2",
                                "sense_id": "24c45764-efca-39bf-a8cd-90bec9eac2d4",
                                "text": "„Tier- und Schlachtabfälle müssen nach gesetzlichen Vorgaben entsorgt werden. Der Betrieb der Kadaversammelstelle in der ARA Bünzen, wird durch die angeschlossenen Gemeinden sichergestellt.“"
                            },
                            {
                                "example_id": "b8fb3ef5-2035-4ead-bd5e-c1ca7d47c075",
                                "sense_id": "24c45764-efca-39bf-a8cd-90bec9eac2d4",
                                "text": "„Jede Anlieferung in der Kadaversammelstelle muss in der aufgelegten Selbstdeklarationskontrolle eingetragen werden.“"
                            }
                        ],
