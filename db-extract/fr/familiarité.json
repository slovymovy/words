                        ]
                    },
                    {
                        "translation_id": "fba83e24-adb0-4f14-adc2-a87d8c47fddc",
                        "source_entry_id": "1ae3e996-bba7-3532-851d-51c68b2c0a74",
                        "target_lang_word": "familiaridade",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiaridade",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "48cc9e5c-c7a0-3047-8d28-f40617fc1186",
                                        "entry_id": "acda7b77-81ea-387b-a003-db5dd9a739f0",
                                        "glosses": [
                                            "conhecimento sobre algo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33827a04-78d2-4f2e-8ea8-56135bad443b",
                                                "sense_id": "48cc9e5c-c7a0-3047-8d28-f40617fc1186",
                                                "text": "Chávez é um político famoso no Irã, que, como todo país asiático, costuma cultivar pouca familiaridade com a América Latina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0566b83c-d49e-3b6e-bd9a-c7f3a3449571",
                                        "entry_id": "acda7b77-81ea-387b-a003-db5dd9a739f0",
                                        "glosses": [
                                            "intimidade"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb92b694-df86-49c1-9f4c-c7f9922bfa7a",
                        "source_entry_id": "1ae3e996-bba7-3532-851d-51c68b2c0a74",
                        "target_lang_word": "фамильярность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фамильярность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fa20c64d-e3e5-3d43-a14d-c3ad524e4b21",
                                        "entry_id": "f00d9f73-dd36-31bd-bcb1-009d87a5e962",
                                        "glosses": [
                                            "неисч. свойство по значению прилагательного фамильярный; неуместная развязность, чрезмерная непринуждённость в общении с кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e6bc9e-3238-46c9-96e9-96bc6de0e67f",
                                                "sense_id": "fa20c64d-e3e5-3d43-a14d-c3ad524e4b21",
                                                "text": "― Болезнь всей страны? ― пробормотал тайный советник, уже не обижаясь на фамильярность этого рыжего типа."
                                            },
                                            {
                                                "example_id": "26b981e4-1a63-4777-8cc4-df1e8bd61908",
                                                "sense_id": "fa20c64d-e3e5-3d43-a14d-c3ad524e4b21",
                                                "text": "Он демократичен, но без панибратства и фамильярности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a21bdf-25e3-30a7-a46d-61564396b79a",
                                        "entry_id": "f00d9f73-dd36-31bd-bcb1-009d87a5e962",
                                        "glosses": [
                                            "исч. фамильярный поступок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7694b0-1e9d-4da7-8fda-857b7dfef14a",
                                                "sense_id": "f0a21bdf-25e3-30a7-a46d-61564396b79a",
                                                "text": "― Как вас звать-величать, молодой человек? // ― Дмитрием, Дмитрием Юрьевичем. // ― Значит, Ми́тей, ― удовлетворенно кивнув, сказал человек в годах и спросил меня, не сочту ли я за фамильярность, если он будет называть меня столь по-свойски."
                                            },
                                            {
                                                "example_id": "e07e98fa-5baa-4ef9-9126-e6fa67726558",
                                                "sense_id": "f0a21bdf-25e3-30a7-a46d-61564396b79a",
                                                "text": "Он любит хохмить, позволяет своему окружению всякие фамильярности и высказывания в свой адрес, но неожиданно может прикрикнуть на сопровождающих и взглянуть так жестко, что это всех осаживает в мгновение ока и демонстрирует его могущество."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
