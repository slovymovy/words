{
    "word_family": [
        "bitchy",
        "bitchiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffcc7ebc-8cc2-3b55-bdb0-94ae19ad6c8b",
                    "sense_definition": "A female dog or other canine animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "canine_literal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeder decided to keep the <w>bitch</w> for another litter of puppies.",
                            "target_lang_translations": {
                                "ru": "Заводчик решил оставить <w>суку</w> для следующего помёта щенков.",
                                "zh": "繁育者决定留下这只<w>母狗</w>再产一窝幼崽。"
                            }
                        },
                        {
                            "text": "My <w>bitch</w> just had puppies; they are so cute!",
                            "target_lang_translations": {
                                "ru": "Моя <w>сука</w> только что ощенилась; они такие милые!",
                                "zh": "我的<w>母狗</w>刚生了小狗，它们太可爱了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "female"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самка собаки или другого животного семейства псовых.",
                        "zh": "母狗或犬科动物的雌性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сука",
                                "target_lang_sense_clarification": "самка собаки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "母狗",
                                "target_lang_sense_clarification": "雌性犬只"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63c41c13-8067-31de-a4d5-b1375de98c6b",
                    "sense_definition": "A malicious, unpleasant, or selfish person, usually a woman.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "insult_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She acts like such a <w>bitch</w> when she does not get her way.",
                            "target_lang_translations": {
                                "ru": "Она ведёт себя как настоящая <w>стерва</w>, когда не получает желаемого.",
                                "zh": "当事情不如意时，她表现得像个<w>泼妇</w>。"
                            }
                        },
                        {
                            "text": "Don't be a <w>bitch</w> to your sister just because you are angry.",
                            "target_lang_translations": {
                                "ru": "Не будь <w>сукой</w> по отношению к сестре только из-за того, что ты злишься.",
                                "zh": "别因为你生气就对你妹妹像个<w>泼妇</w>一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrew"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "offensive, vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злобная, неприятная или эгоистичная личность, обычно женщина.",
                        "zh": "指恶意、令人不快或自私的人，通常指女性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стерва",
                                "target_lang_sense_clarification": "сварливая женщина"
                            },
                            {
                                "target_lang_word": "сука",
                                "target_lang_sense_clarification": "подлая женщина (груб.)"
                            },
                            {
                                "target_lang_word": "мегера",
                                "target_lang_sense_clarification": "злая женщина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泼妇",
                                "target_lang_sense_clarification": "蛮横无理的女性"
                            },
                            {
                                "target_lang_word": "贱人",
                                "target_lang_sense_clarification": "对女性的粗俗辱骂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d78b5419-4992-32b3-ac78-3dc3b9971053",
                    "sense_definition": "A difficult, unpleasant, or complicated situation or problem.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "difficult_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fixing this old engine is going to be a real <w>bitch</w>.",
                            "target_lang_translations": {
                                "ru": "Починка этого старого двигателя будет настоящим <w>геморроем</w>.",
                                "zh": "修理这台旧引擎会是一件非常<w>麻烦</w>的事。"
                            }
                        },
                        {
                            "text": "Karma is a <w>bitch</w>.",
                            "target_lang_translations": {
                                "ru": "Карма — <w>сука</w>.",
                                "zh": "因果报应真是件<w>麻烦事</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toughie",
                        "stinker",
                        "pain in the ass"
                    ],
                    "common_phrases": [
                        "life's a bitch",
                        "son of a bitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная, неприятная или запутанная ситуация или проблема.",
                        "zh": "指困难、令人不快或复杂的处境或问题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "геморрой",
                                "target_lang_sense_clarification": "сложная задача (сленг)"
                            },
                            {
                                "target_lang_word": "сука",
                                "target_lang_sense_clarification": "неприятность"
                            },
                            {
                                "target_lang_word": "зараза",
                                "target_lang_sense_clarification": "надоедливое дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "麻烦事",
                                "target_lang_sense_clarification": "棘手的问题"
                            },
                            {
                                "target_lang_word": "烂摊子",
                                "target_lang_sense_clarification": "难以处理的局面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a20fd26-9727-315b-abd4-d5ef7c028e34",
                    "sense_definition": "A person who is submissive or subservient to another; a weak or cowardly man.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "submissive_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He does whatever his boss says like he is his <w>bitch</w>.",
                            "target_lang_translations": {
                                "ru": "Он делает всё, что говорит начальник, будто он его <w>шестёрка</w>.",
                                "zh": "他对他老板言听计从，就像个<w>走狗</w>一样。"
                            }
                        },
                        {
                            "text": "Stand up for yourself and don't be a <w>bitch</w>.",
                            "target_lang_translations": {
                                "ru": "Постой за себя и не будь <w>тряпкой</w>.",
                                "zh": "勇敢一点，别做个<w>软蛋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doormat",
                        "slave"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "offensive, vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который подчиняется другому; слабый или трусливый мужчина.",
                        "zh": "指顺从他人的人；懦弱或胆小的男性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестёрка",
                                "target_lang_sense_clarification": "прислужник"
                            },
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "слабовольный человек"
                            },
                            {
                                "target_lang_word": "сучка",
                                "target_lang_sense_clarification": "уничижительно о мужчине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走狗",
                                "target_lang_sense_clarification": "依附权势的奴才"
                            },
                            {
                                "target_lang_word": "软蛋",
                                "target_lang_sense_clarification": "懦弱的男性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9f20c38-58e4-352e-822d-d8a606b3ab57",
                    "sense_definition": "A woman or a female partner.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "woman_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is always talking about his money and his <w>bitches</w>.",
                            "target_lang_translations": {
                                "ru": "Он вечно болтает о своих деньгах и <w>тёлках</w>.",
                                "zh": "他总是吹嘘自己的钱和身边的<w>妞</w>。"
                            }
                        },
                        {
                            "text": "They went to the club to meet some <w>bitches</w>.",
                            "target_lang_translations": {
                                "ru": "Они пошли в клуб, чтобы подцепить каких-нибудь <w>тёлок</w>.",
                                "zh": "他们去夜店是为了结识一些<w>妞</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often offensive or AAVE"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина или партнёрша (на сленге).",
                        "zh": "指女性或女性伴侣（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тёлка",
                                "target_lang_sense_clarification": "девушка (груб.)"
                            },
                            {
                                "target_lang_word": "сучка",
                                "target_lang_sense_clarification": "женщина (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妞",
                                "target_lang_sense_clarification": "对女性的粗俗称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edb31a15-1c17-3a82-922b-f625e0493c0e",
                    "sense_definition": "A term of address for a friend or close acquaintance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "friend_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>bitch</w>, are we going shopping today?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>сучка</w>, мы идём сегодня по магазинам?",
                                "zh": "嘿<w>姐妹</w>，我们今天去逛街吗？"
                            }
                        },
                        {
                            "text": "I missed you, <w>bitch</w>!",
                            "target_lang_translations": {
                                "ru": "Я скучала по тебе, <w>зараза</w>!",
                                "zh": "我想死你了，<w>姐妹</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "friend"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "reclaimed, usually affectionate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращение к подруге или близкой знакомой (обычно ироничное).",
                        "zh": "对女性朋友或熟人的称呼（通常带有戏谑或亲昵意味）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сучка",
                                "target_lang_sense_clarification": "дружеское обращение"
                            },
                            {
                                "target_lang_word": "коза",
                                "target_lang_sense_clarification": "шутливое обращение"
                            },
                            {
                                "target_lang_word": "зараза",
                                "target_lang_sense_clarification": "ласковое ругательство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "姐妹",
                                "target_lang_sense_clarification": "亲密的女性朋友"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab41c683-54cb-3f74-a398-0e245fe0db6c",
                    "sense_definition": "To complain or criticize spitefully and excessively.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "complain_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>bitching</w> about the weather and enjoy the walk.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>ныть</w> из-за погоды и наслаждайся прогулкой.",
                                "zh": "别再<w>抱怨</w>天气了，好好享受散步吧。"
                            }
                        },
                        {
                            "text": "All he does is <w>bitch</w> about his job.",
                            "target_lang_translations": {
                                "ru": "Всё, что он делает, — это <w>скулит</w> по поводу своей работы.",
                                "zh": "他整天只会<w>发牢骚</w>抱怨他的工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snipe"
                    ],
                    "common_phrases": [
                        "bitch and moan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злобно и много жаловаться или критиковать.",
                        "zh": "指恶意且过度地抱怨或批评。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "надоедливо жаловаться"
                            },
                            {
                                "target_lang_word": "скулить",
                                "target_lang_sense_clarification": "жаловаться, плакаться"
                            },
                            {
                                "target_lang_word": "пиздеть",
                                "target_lang_sense_clarification": "болтать, жаловаться (неценз.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "表达不满"
                            },
                            {
                                "target_lang_word": "发牢骚",
                                "target_lang_sense_clarification": "不断地抱怨"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}