                        "glosses": [
                            "plaats waar goederen van het ene naar het andere vervoersmiddel worden overgeladen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4dca3f9-78e3-4a8f-ae96-0f6033390706",
                                "sense_id": "e46f3bd3-9ca6-3e43-8cfc-2fafda050f4a",
                                "text": "Zuiveringsinstallatie, onderstation, industriegebied, tankstations, de geluidswanden van het ICE-traject en de magazijnen van een overslagcentrum verenigden zich in een antilandschap van gefrustreerde willekeur."
                            },
                            {
                                "example_id": "8ec2526c-f703-41a4-bae7-b08189d01e93",
                                "sense_id": "e46f3bd3-9ca6-3e43-8cfc-2fafda050f4a",
                                "text": "Voor de haven van Rotterdamse heeft dat ingrijpende gevolgen. Het zou namelijk een knip betekenen tussen de zeescheepvaart en de binnenvaart. Daar moet de haven, als overslagcentrum, dan wel een oplossing voor zien te vinden. Het Havenbedrijf heeft overigens ook meegedacht over de scenario's."
                            }
                        ]
