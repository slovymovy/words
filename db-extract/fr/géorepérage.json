                        "entry_id": "f93190f1-2dc7-3b41-ae1d-11f876aea5ed",
                        "glosses": [
                            "Détermination de la présence d’une personne ou d’un objet mobile dans une zone donnée, à partir de la géolocalisation par satellite et d’autres moyens de radiocommunication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9dfc78-df5e-4f42-849e-a5a802677eeb",
                                "sense_id": "566e34cd-21fd-3cd1-a761-92c9f114783e",
                                "text": "Le géorepérage du véhicule était hors fonction, certainement pour ne pas être suivi par les systèmes de la milice de Cerniak."
                            }
                        ]
                    }
                ],
