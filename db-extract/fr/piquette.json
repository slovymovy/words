                                    {
                                        "sense_id": "29b6ba18-e2d1-36a3-92a8-831f403d4d33",
                                        "entry_id": "0702e830-ddb8-3b14-ba32-729231029402",
                                        "glosses": [
                                            "Hinterhalt"
                                        ],
                                        "tags": [
                                            "meist in Wendungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69599da-8d40-4aa0-bd16-64cb042c8bb7",
                                                "sense_id": "29b6ba18-e2d1-36a3-92a8-831f403d4d33",
                                                "text": "Räuber legen sich oft hinter Büschen auf die Lauer und warten auf Opfer."
                                            },
                                            {
                                                "example_id": "f1977813-8f1a-4b25-85e7-d95e1151cc80",
                                                "sense_id": "29b6ba18-e2d1-36a3-92a8-831f403d4d33",
                                                "text": "„Gerhard Gröschel hat sich mit seiner Ausrüstung im Österreichischen Knittelfeld auf die Lauer gelegt und den dortigen UFO-Hotspot seit 2008 unter Dauerüberwachung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "716b721e-cb9e-3e66-bc6d-c51370271586",
                                        "entry_id": "f9dc8263-df16-3b7c-bf15-c72bd6cd33f2",
                                        "glosses": [
                                            "Namensbestandteil des ehemaligen, jetzt im Nordteil des Cospudener Sees gelegenen Gutes (Rittergutes) Lauer, das im Zuge des Braunkohlebergbaus verlorenging, und des Waldsees Lauer"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6947c2a5-0620-4156-9c1a-60c3b7fd4a34",
                                                "sense_id": "716b721e-cb9e-3e66-bc6d-c51370271586",
                                                "text": "Nach Lauer führten viele Wege."
                                            },
                                            {
                                                "example_id": "c1d72a5a-f2ac-4c4c-8075-21b8ffcc55ad",
                                                "sense_id": "716b721e-cb9e-3e66-bc6d-c51370271586",
                                                "text": "Lauer lag auf der Nordhalbkugel."
                                            },
                                            {
                                                "example_id": "63fd064f-d852-4fa8-b113-824b59cdddd9",
                                                "sense_id": "716b721e-cb9e-3e66-bc6d-c51370271586",
                                                "text": "Das Lauer des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                        "entry_id": "e13f2364-7752-33ba-a6c1-3c434b828d3f",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3f87ec-e775-431b-a2c4-12d115fdefef",
                                                "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lauer kommt, geht der Herr Lauer.“"
                                            },
                                            {
                                                "example_id": "4f15e6bc-0429-4df7-bb6e-4b3771e66bec",
                                                "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                                "text": "Lauer kommt und geht."
                                            },
                                            {
                                                "example_id": "5b3accc4-3acb-43cd-8bb5-c51ba0213657",
                                                "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                                "text": "Lauers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "075f7779-0db0-48a4-b2e4-0e0b6d36ea92",
                                                "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                                "text": "Frau Lauer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a7551480-3da7-4a85-b102-893a6db2e783",
                                                "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                                "text": "Herr Lauer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "29589a74-b706-4b70-a46b-ae391d91039a",
                                                "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                                "text": "Die Lauers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "653cebb2-96ab-46e0-a81b-7905bec7e707",
                                                "sense_id": "db5bada1-d18d-3059-9ec1-1e5f2a19e163",
                                                "text": "Der Lauer trägt nie die Schals, die die Lauer ihm strickt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
