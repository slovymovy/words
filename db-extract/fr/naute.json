                        "entry_id": "0bf19820-9bcf-395e-8b57-6294673f82b9",
                        "glosses": [
                            "Batelier de la Gaule romaine."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "052af281-1033-4538-9b34-af59b7f9a688",
                                "sense_id": "61cca7c5-c2d3-39ba-a820-0dc5cd573e58",
                                "text": "J’entrai dans la capitale des Parisii par le pont du septentrion […] je n’y remarquai qu’un seul monument : c’étoit un autel élevé à Jupiter par la compagnie des nautes."
                            },
                            {
                                "example_id": "954732cc-80b3-4685-91b2-84f8b185490b",
                                "sense_id": "61cca7c5-c2d3-39ba-a820-0dc5cd573e58",
                                "text": "Alors, sur les fleuves et les rivières, des lignes se créèrent ; des corporations de bateliers se fondèrent, les nautes […] La vitalité de cette batellerie devait d’ailleurs se poursuivre bien après l’occupation romaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "70a63206-6ada-3046-8e96-8520f645319c",
                        "entry_id": "0bf19820-9bcf-395e-8b57-6294673f82b9",
                        "glosses": [
                            "Marin, matelot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68feae90-389b-431e-9d4d-6de432aef222",
                                "sense_id": "70a63206-6ada-3046-8e96-8520f645319c",
                                "text": "Il attend donc que la nasse se remplisse, tel un naute à la pêche."
                            },
                            {
                                "example_id": "8719a945-e5e4-4e15-b332-377a60ec62f6",
                                "sense_id": "70a63206-6ada-3046-8e96-8520f645319c",
                                "text": "J’étais comme un naute qui, oyant le chant d’une sirène au loin, veut changer de cap pour voir à quoi ressemble l’ensorcelante créature !"
                            }
                        ]
                    }
