                                "sense_id": "13058a69-1ec9-333f-a171-a2de3f414975",
                                "text": "Rauchen schadet den Bronchien."
                            },
                            {
                                "example_id": "7564c933-1063-47ca-8d07-bd3cd217efec",
                                "sense_id": "13058a69-1ec9-333f-a171-a2de3f414975",
