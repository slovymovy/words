{
    "word_family": [
        "одобрение",
        "одобрительный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c9e5c40-bf9b-336e-a229-5c50cb45413c",
                    "sense_definition": "Признавать что-либо хорошим, правильным или достойным поддержки.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Родители полностью <w>одобряют</w> мой выбор профессии.",
                            "target_lang_translations": {
                                "en": "My parents fully <w>approve of</w> my career choice."
                            }
                        },
                        {
                            "text": "Большинство коллег <w>одобряют</w> этот новый проект.",
                            "target_lang_translations": {
                                "en": "Most of my colleagues <w>approve of</w> this new project."
                            }
                        }
                    ],
                    "synonyms": [
                        "поддерживать"
                    ],
                    "antonyms": [
                        "осуждать",
                        "отвергать"
                    ],
                    "common_phrases": [
                        "полностью одобрять",
                        "одобрять выбор"
                    ],
                    "target_lang_definitions": {
                        "en": "To regard something as good, correct, or worthy of support."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approve",
                                "target_lang_sense_clarification": "To think well of or regard as good."
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "To express agreement or encouragement for something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3b67969-30cf-3a20-b716-bdc62b4a79aa",
                    "sense_definition": "Давать официальное согласие на что-либо, разрешать.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор должен <w>одобрять</w> все финансовые отчеты компании.",
                            "target_lang_translations": {
                                "en": "The director must <w>approve</w> all of the company's financial reports."
                            }
                        },
                        {
                            "text": "Комитет решил <w>одобрять</w> только проверенные заявки.",
                            "target_lang_translations": {
                                "en": "The committee decided to <w>approve</w> only verified applications."
                            }
                        }
                    ],
                    "synonyms": [
                        "разрешать",
                        "санкционировать"
                    ],
                    "antonyms": [
                        "отвергать"
                    ],
                    "common_phrases": [
                        "одобрять заявку",
                        "одобрять план"
                    ],
                    "target_lang_definitions": {
                        "en": "To give official consent to something; to authorize or permit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approve",
                                "target_lang_sense_clarification": "To officially sanction or ratify."
                            },
                            {
                                "target_lang_word": "authorize",
                                "target_lang_sense_clarification": "To give official permission for something."
                            },
                            {
                                "target_lang_word": "sanction",
                                "target_lang_sense_clarification": "To give official permission or approval."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}