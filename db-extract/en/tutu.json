                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a437a46-a8dc-4908-87f9-557e86069124",
                        "source_entry_id": "2e309b63-8bd1-3d96-8456-1c998388c023",
                        "source_sense_id": "ecbc2287-78e1-3d7d-a252-6adbaac500fd",
                        "source_sense_description": "ballet skirt",
                        "target_lang_word": "tutu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tutu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc7946b-d746-3a87-a30e-8c4436c3208a",
                                        "entry_id": "4b726af9-dd50-36c6-980c-3df79dfcab23",
                                        "glosses": [
                                            "Cul, derrière, fesses."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02845e40-c138-41f7-8188-132f27b4a484",
                                                "sense_id": "7fc7946b-d746-3a87-a30e-8c4436c3208a",
                                                "text": "Kiki [un chien] se lèche sans cesse le tutu."
                                            },
                                            {
                                                "example_id": "65eb7a2a-b9dd-4ada-a46d-0abe7ab62748",
                                                "sense_id": "7fc7946b-d746-3a87-a30e-8c4436c3208a",
                                                "text": "Faire panpan-tutu, donner une fessée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                        "entry_id": "4b726af9-dd50-36c6-980c-3df79dfcab23",
                                        "glosses": [
                                            "Jupe de gaze, tulle, tarlatane ou mousseline, courte et évasée, que portent les danseuses de ballet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06a9c40c-31d1-4b94-8bd1-ee9899f397b9",
                                                "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                                "text": "Une danseuse en tutu."
                                            },
                                            {
                                                "example_id": "81094794-5196-47df-9325-83af3c946573",
                                                "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                                "text": "Évocations romantiques sur des airs de Chopin et de Weber, les longs tutus blancs à la Taglioni des Sylphides."
                                            },
                                            {
                                                "example_id": "0b9e54d1-ba0d-4bef-80c7-5d0c30078a6e",
                                                "sense_id": "84b88c87-fe23-3de3-a46a-b495f17e00e1",
                                                "text": "La légèreté transparente des tutus, entourant la fermeté rose des jambes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tutu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                        "entry_id": "40597f76-7434-31f3-8938-1f392f8a4547",
                                        "glosses": [
                                            "Vin rouge."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae08b631-a18b-4bc7-82ae-45ed5eff2d37",
                                                "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                                "text": "On le laisse fumer en douce et boire un coup ou deux quand il a trouvé le moyen de se procurer du « tutu ». – Du « tutu » ? – Oui, du pinard !"
                                            },
                                            {
                                                "example_id": "ccae7f18-4058-457b-8cae-af252222cb74",
                                                "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                                "text": "Ils s’attardent les deux potes, clapant au rythme mesuré du gourmet pour qui chaque bouchée compte ; chaque gorgée de tutu suspend la fuite du temps."
                                            },
                                            {
                                                "example_id": "0ede55b2-24c3-4c96-b1ee-51e724385617",
                                                "sense_id": "e4e1c5bd-d987-3ae3-a83a-74cb579e8f48",
                                                "text": "Ça donne qu’en l’an 2000 on s’envoie plus que du tutu chinois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tutu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7922b09-14bb-31bd-a3da-c9ea903a052a",
                                        "entry_id": "a7c6d270-a1ed-3eb2-bed6-051627e8b6c4",
                                        "glosses": [
                                            "Appareil qui produit un son strident."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a5e0a88-3bc7-450e-89bd-51fb5113fd80",
                                                "sense_id": "f7922b09-14bb-31bd-a3da-c9ea903a052a",
                                                "text": "Va-t-il pas bientôt la fermer, le grand zouave y nous casse les oreilles avec son tutu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87f8042d-df7a-4f59-80cc-53f71c7c1d65",
                        "source_entry_id": "2e309b63-8bd1-3d96-8456-1c998388c023",
                        "source_sense_id": "ecbc2287-78e1-3d7d-a252-6adbaac500fd",
                        "source_sense_description": "ballet skirt",
                        "target_lang_word": "Tutu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tutu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                        "entry_id": "cb9753f3-f0f7-36b3-bd26-437effac1726",
                                        "glosses": [
                                            "von Balletttänzerinnen getragener kurzer Rock, meist aus Tüll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b4f26d2-5e87-4cc8-a06e-e5b1812cd684",
                                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                                "text": "Das Tutu ist das Standardkostüm einer klassischen Ballerina"
                                            },
                                            {
                                                "example_id": "71bd91cd-bbb7-41ca-bfb4-3f4987bcaa7e",
                                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                                "text": "Ein Tutu ist am weit abstehenden Rock deutlich erkennbar."
                                            },
                                            {
                                                "example_id": "916c6a7b-808a-456b-ba8e-76a061983aa5",
                                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                                "text": "Das Tragen eines Tutus war zu Anfangszeiten noch höchst umstritten."
                                            },
                                            {
                                                "example_id": "cc7bc57f-8003-4843-99c0-954479833a32",
                                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                                "text": "„Tante Mary hatte ein Tutu, ein Ballettröckchen, weil sie früher Ballett getanzt hatte.“"
                                            },
                                            {
                                                "example_id": "da31d84e-2fb2-44a3-ae21-f4679472fdf6",
                                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                                "text": "„Der rosafarbene Stoff spannt jetzt schon am Bauch, das Tutu steht im Neunzig-Grad-Winkel von ihrem kleinen runden Körper ab.“"
                                            },
                                            {
                                                "example_id": "863b3b46-06f6-4300-b29b-ea432145cbf3",
                                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                                "text": "„Helen schien jedenfalls auf ein Leben voller Leidenschaft zuzusteuern; sie und eine Freundin nahmen Ballettunterricht, und wenn Roth nachmittags von der Universität nach Hause kam, führten die beiden Mädchen ihm im Wohnzimmer ihre Tanzschritte vor, was gewöhnlich damit endete, dass Helen im Trikot und Tutu auf seinem Schoß landete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b62e8bf-79f9-4705-9e92-0dbf0ca87ff2",
                        "source_entry_id": "2e309b63-8bd1-3d96-8456-1c998388c023",
