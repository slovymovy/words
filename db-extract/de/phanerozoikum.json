                "senses": [
                    {
                        "sense_id": "22e61b2a-40b9-32b6-883b-bca6617d34ff",
                        "entry_id": "79fb8db9-4bd5-3a20-b31f-924033276f45",
                        "glosses": [
                            "der letzte und aktuelle geologische Äon der Erde von etwa 542 Millionen Jahren bis zur Jetzt-Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59dec5a2-4e3c-4880-8ff3-347b91947753",
                                "sense_id": "22e61b2a-40b9-32b6-883b-bca6617d34ff",
                                "text": "„Die Entstehung des Begriffs Phanerozoikum ist darin begründet, dass ab dem Kambrium - der untersten (=frühesten) Periode des Paläozoikums - erstmals in großer Anzahl makroskopisch sichtbare Fossilreste auftreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a1532ee-dd72-4a5b-81d4-07acce05fc31",
                        "source_entry_id": "79fb8db9-4bd5-3a20-b31f-924033276f45",
                        "source_sense_id": "22e61b2a-40b9-32b6-883b-bca6617d34ff",
                        "target_lang_word": "fanerozoik",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanerozoik",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "73306e82-da00-3988-9110-48b5dc761f74",
                                        "entry_id": "61aee836-a023-3d7e-9078-90484da4e48f",
                                        "glosses": [
                                            "najmłodszy eon, który trwa od około 540 milionów lat temu do dziś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae949dad-30e4-4fe2-8f83-20abc4ff7a16",
                                                "sense_id": "73306e82-da00-3988-9110-48b5dc761f74",
                                                "text": "Podczas fanerozoiku doszło do eksplozji życia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f1afb1e-c0db-49c9-9317-b88ddb3cf18d",
                        "source_entry_id": "79fb8db9-4bd5-3a20-b31f-924033276f45",
                        "source_sense_id": "22e61b2a-40b9-32b6-883b-bca6617d34ff",
                        "target_lang_word": "фанерозой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фанерозой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0035838e-7f00-3ddf-b0f1-6a113d83457c",
                                        "entry_id": "dd514c11-2ecd-3155-a3fe-494d60879288",
                                        "glosses": [
                                            "геол. крупнейший этап геологической истории Земли длительностью 541 ± 1 млн лет, в течение которого сформировались толщи горных пород палеозоя, мезозоя и кайнозоя, характеризующиеся наличием в них органических остатков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8088a69b-0712-4cb3-a7ac-7d068b9e8ec8",
                                                "sense_id": "0035838e-7f00-3ddf-b0f1-6a113d83457c",
                                                "text": "Почему в течение более 2 млрд лет совокупность живых организмов на Земле ограничивалась прокариотами, затем спустя 2.5 млрд лет появились эвкариоты, далее Metazoa, а затем около 600 млн лет назад произошла вспышка жизни: появилась эдиакарская фауна мягкотелых беспозвоночных, а ещё через 0.5 млн лет ― новая вспышка, приведшая к возникновению всего разнообразия фауны фанерозоя?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e331b4-8722-30df-81e5-fb7138a81f2e",
                                        "entry_id": "dd514c11-2ecd-3155-a3fe-494d60879288",
                                        "glosses": [
                                            "геол. совокупность палеозойской, мезозойской и кайнозойской групп"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d65057-944c-40ae-9f70-7dbbdc3101b2",
                                                "sense_id": "23e331b4-8722-30df-81e5-fb7138a81f2e",
                                                "text": "В строении фанерозоя принимают участие все системы, кроме каменноугольной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
