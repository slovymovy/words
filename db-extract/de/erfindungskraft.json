                "senses": [
                    {
                        "sense_id": "26adc16e-8397-3675-b758-2642c622211d",
                        "entry_id": "e2eb279a-261b-3693-8ed0-97ffb1c01be7",
                        "glosses": [
                            "persönliche Gabe oder Fähigkeit, innovativ zu denken und Erfindungen machen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd74768b-8bb3-45b9-8362-c10156ccaa91",
                                "sense_id": "26adc16e-8397-3675-b758-2642c622211d",
                                "text": "„Die Wahl dieser oder jener Konstruktion verlangt meist etwas Erfindungskraft.“"
                            },
                            {
                                "example_id": "83213372-db73-4026-9019-8bff058421a4",
                                "sense_id": "26adc16e-8397-3675-b758-2642c622211d",
                                "text": "„Die Erfindungskraft wird wach gehalten, und der Geist kann nicht in jene Schläfrigkeit und Dummheit versinken, welche in einer civilisirten Gesellschaft den Verstand der unteren Volksklassen betäubt.“"
                            },
                            {
                                "example_id": "b8b6601a-0190-42ec-a131-9e1d0857048b",
                                "sense_id": "26adc16e-8397-3675-b758-2642c622211d",
                                "text": "„Die Quelle seiner Erfindungskraft kann aber der Maler nirgend reicher strömen lassen, als indem er sich mit dem Holzschnitt in Verbindung jett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
