                "senses": [
                    {
                        "sense_id": "8297d4d8-e7c6-3653-bfe2-641425bda233",
                        "entry_id": "6926a5d2-b7d3-378b-96f4-3c76d2cf6aae",
                        "glosses": [
                            "Rennfahrer, der eigene Sponsoren hat, die er in ein Team mitbringt"
                        ],
                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "ac2911a3-d4dc-46a9-9b24-577837b50fe8",
                                "sense_id": "8297d4d8-e7c6-3653-bfe2-641425bda233",
                                "text": "„Bezahlfahrer gibt es in der Formel 1 seit Jahrzehnten. Sie haben meist potente Sponsoren, die sie dann zu ihrem Arbeitgeber mitbringen. Häufig würden diese Paydriver wohl kein Cockpit bekommen, wenn sie ohne finanzielle Unterstützung wären.“"
                            },
                            {
                                "example_id": "05c74989-5c2e-4438-9c05-d8b7083f368c",
                                "sense_id": "8297d4d8-e7c6-3653-bfe2-641425bda233",
                                "text": "„Ex-Sauber-Pilot Adrian Sutil beschwert sich über die gezahlten Summen der Paydriver.“"
                            },
                            {
                                "example_id": "4e1eb6b2-e951-41e6-9fe1-96e2f9f1c4e2",
                                "sense_id": "8297d4d8-e7c6-3653-bfe2-641425bda233",
                                "text": "„Dass der angesprochene Nasr von Sauber verpflichtet wurde, ist nicht zuletzt den finanziellen Problemen des schweizerischen Privatteams geschuldet, das das zweite Cockpit mit Marcus Ericssson ebenfalls einem Paydriver zusprach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
