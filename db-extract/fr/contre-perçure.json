                        "glosses": [
                            "Extrémité d’un trou de fer à cheval située du côté du sabot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90cc9b65-cf12-4829-b4e0-1ff0ed03ac14",
                                "sense_id": "335b1da9-badf-3a92-936d-1211b8c99857",
                                "text": "Les fers sont percés de trous destinés à permettre le passage des clous. L’extrémité du trou située vers le sol est appelée étampure, celle dirigée vers le sabot est appelée contre-perçure."
                            },
                            {
                                "example_id": "28ed6a30-cd6e-41b7-98f3-e2e1218b286a",
                                "sense_id": "335b1da9-badf-3a92-936d-1211b8c99857",
                                "text": "Une fois & demie cette même mesure, plus l’épaisseur du fer, égalera la distance de l’angle externe de l’éponge au bord postérieur de la première contre-perçure, soit de la branche de dedans, soit la branche du dehors."
                            }
                        ]
                    }
