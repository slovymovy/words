                "senses": [
                    {
                        "sense_id": "6ef97c5f-23dc-3350-9b65-c7f507bc3795",
                        "entry_id": "374a087c-8768-3627-ad35-293e3379c120",
                        "glosses": [
                            "A sports drink sold by The Gatorade Company."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "21536b22-638b-4273-896d-ee7c7a38d324",
                                "sense_id": "6ef97c5f-23dc-3350-9b65-c7f507bc3795",
                                "text": "While Brown distracted the usually hyperfocused Mangini, safety Kerry Rhodes and linebackers Eric Barton and Jonathan Vilma grabbed a cooler of Gatorade and surreptitiously assumed their positions according to plan."
                            },
                            {
                                "example_id": "c44ad44a-3657-4f33-adf8-1aabe14e2f49",
                                "sense_id": "6ef97c5f-23dc-3350-9b65-c7f507bc3795",
                                "text": "I may also recommend that they take Peltier Electrolytes from Crayhon Research, which is kind of like glorified Gatorade, but which works well to replenish some of the cell's missing elements."
                            },
                            {
                                "example_id": "d0361435-57af-4625-a7ef-8e4d140a6d48",
                                "sense_id": "6ef97c5f-23dc-3350-9b65-c7f507bc3795",
                                "text": "I like to say it's Gatorade for the soul.” Phoebe turned to Lucy."
                            },
                            {
                                "example_id": "865ab467-22ad-4ebb-a3aa-cf8ac5e59edf",
                                "sense_id": "6ef97c5f-23dc-3350-9b65-c7f507bc3795",
                                "text": "I've got a thirst, baby, and you smell like my Gatorade."
                            }
                        ]
                    },
                    {
                        "sense_id": "c701b7bb-14fd-36ef-94dd-5bf2e168e286",
                        "entry_id": "374a087c-8768-3627-ad35-293e3379c120",
                        "glosses": [
                            "Any sports drink resembling or based on Gatorade."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a8eb53c-643a-4cd5-a8c4-9b17815bd8cf",
                                "sense_id": "c701b7bb-14fd-36ef-94dd-5bf2e168e286",
                                "text": "The beverage selection is a unique feature of Ole Cafe, with a variety of canned gatorades, assorted fruit drinks and \"slushies\" on the line."
                            },
                            {
                                "example_id": "0cd5e5f6-d4c7-435b-a55c-51f71e1f5a3b",
                                "sense_id": "c701b7bb-14fd-36ef-94dd-5bf2e168e286",
                                "text": "We figure that we save nearly $200 a year in mixing our own Gatorade,” she boasts."
                            },
                            {
                                "example_id": "25385518-e037-49f2-9407-edb296b0b9ab",
                                "sense_id": "c701b7bb-14fd-36ef-94dd-5bf2e168e286",
                                "text": "I had lots of homemade Gatorade, two big burgers and a few minutes later I was cruising like the machine again."
                            },
                            {
                                "example_id": "41e7df4a-bd3f-4df5-b9e9-23e8fa0c6b7a",
                                "sense_id": "c701b7bb-14fd-36ef-94dd-5bf2e168e286",
                                "text": "Add a splash of lemon or lime and a hefty pinch of a high quality sea salt and you've just created a homemade Gatorade without all the extra sugars, neon colors, or added ingredients."
                            },
                            {
                                "example_id": "e56ec965-e628-4b8a-bcb2-c2f4375d3191",
                                "sense_id": "c701b7bb-14fd-36ef-94dd-5bf2e168e286",
                                "text": "Well, there's water, and then there's quarter-waters. Ghetto Gatorade."
                            }
                        ]
                    }
                ],
