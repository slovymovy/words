                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3d061e74-c787-3dcd-b101-82d0001583c0",
                                        "entry_id": "84b52e1b-9dc1-35fa-8e98-f0dbcd752192",
                                        "glosses": [
                                            "laatste deel van een muziekstuk of geluidopname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b1f470-3888-4897-8a86-93d2fffaee28",
                                                "sense_id": "3d061e74-c787-3dcd-b101-82d0001583c0",
                                                "text": "Ook het kleinere Amerikaanse bedrijf Hit Songs Deconstructed analyseert de Amerikaanse hitlijsten op alle mogelijke manieren: waar gaan de liedjes over, welk instrument speelt de hoofdrol, wanneer begint het refrein en hoe lang duurt het outro. Via betaalde abonnementen kunnen platenbazen en artiesten zien wat de trends zijn en hoe ze er het beste op kunnen inspelen."
                                            },
                                            {
                                                "example_id": "070cf26e-310f-4b0c-bda6-a6be4eb2a44a",
                                                "sense_id": "3d061e74-c787-3dcd-b101-82d0001583c0",
                                                "text": "Het mag dit jaar dan wel exact een halve eeuw geleden zijn dat The Beatles dit nummer op plaat uitbrachten, aan kracht heeft het niets ingeboet. De heerlijke outro is door iedereen mee te blèren, zelfs voor de feestgangers die nog nooit van dit nummer hebben gehoord (bestaan die überhaupt?)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "491d1e34-33c9-39af-91a3-83b98bb41de1",
                                        "entry_id": "84b52e1b-9dc1-35fa-8e98-f0dbcd752192",
                                        "glosses": [
                                            "kort filmpje of geluidsfragment dat uitgezonden wordt wanneer respectievelijk de televisie- of radio-uitzending ten einde is"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c897aebd-44aa-4272-9bde-8342adeb7366",
                                                "sense_id": "491d1e34-33c9-39af-91a3-83b98bb41de1",
                                                "text": "Sommige podcastopname-apps hebben direct edit-tools zodat je na afloop eventuele ‘eeeehs’ en versprekingen eruit kunt halen, en een intro of outro - al dan niet met een themamuziekje - kunt toevoegen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
