                "senses": [
                    {
                        "sense_id": "02f448ae-4fae-3174-9e68-1ca89215b7ac",
                        "entry_id": "2f1da88f-b78d-3e06-be1a-47079157d46d",
                        "glosses": [
                            "Alternative spelling of hearken: to hear, to listen, to have regard."
                        ],
                        "tags": [
                            "US",
                            "alt-of",
                            "alternative",
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4ef106e0-b97c-4155-bca7-2b389360fee2",
                                "sense_id": "02f448ae-4fae-3174-9e68-1ca89215b7ac",
                                "text": "Ev'n from the depths of Hell the Damn'd advance, / Th' Infernal Manſions nodding ſeem to dance; / The gaping three-mouth'd Dog forgets to ſnarl, / The Furies harken, and their Snakes uncurl."
                            },
                            {
                                "example_id": "67f0b34c-5cf9-4d5a-9105-48e58b6072eb",
                                "sense_id": "02f448ae-4fae-3174-9e68-1ca89215b7ac",
                                "text": "How, then, am I mad? Harken! and observe how healthily—how calmly I can tell you the whole story."
                            },
                            {
                                "example_id": "d8c10f7b-6c2f-41e8-b801-b7bec6ac2da0",
                                "sense_id": "02f448ae-4fae-3174-9e68-1ca89215b7ac",
                                "text": "[T]he mother who had shaped him if any had toward the man he almost was, [...] whom he had revered and harkened to and loved and lost and grieved: [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7b355206-2ea0-3a17-9963-5fa9a168be4b",
                        "entry_id": "2f1da88f-b78d-3e06-be1a-47079157d46d",
                        "glosses": [
                            "To hark back, to return or revert (to a subject, etc.), to allude to, to evoke, to long or pine for (a past event or era)."
                        ],
                        "tags": [
                            "US",
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ccc7f0a7-c03f-4013-b4ee-4ef1e5ba2c13",
                                "sense_id": "7b355206-2ea0-3a17-9963-5fa9a168be4b",
                                "text": "Bell argued that the manual approach was \"backwards,\" and harkened to a primitive age where humans used gesture and pantomime."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
