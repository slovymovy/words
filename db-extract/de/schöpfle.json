                "senses": [
                    {
                        "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                        "entry_id": "9c805249-02c7-3423-8272-4331820bfe71",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a9e3fab-e472-4575-a918-275163b6d689",
                                "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                                "text": "Frau Schöpfle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "be5dd4fc-5e59-4375-b9be-ac0840da9a12",
                                "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                                "text": "Herr Schöpfle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dd55a3d0-c1a5-4adf-85c9-680eddcbbc36",
                                "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                                "text": "Die Schöpfles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2ae9e676-b8fe-41e8-86c4-3d31e319d685",
                                "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                                "text": "Der Schöpfle trägt nie die Schals, die die Schöpfle ihm strickt."
                            },
                            {
                                "example_id": "14a04b50-80fa-4ccd-9002-9eeb2ad62142",
                                "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schöpfle kommt, geht der Herr Schöpfle.“"
                            },
                            {
                                "example_id": "4690642c-050f-4eba-b022-b92cea6a7696",
                                "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                                "text": "Schöpfle kommt und geht."
                            },
                            {
                                "example_id": "2ee1b499-26d4-415c-ba7a-21fb4e9c25b1",
                                "sense_id": "7046c9e1-467f-364f-b71c-1ae8e0a92a2e",
                                "text": "Schöpfles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
