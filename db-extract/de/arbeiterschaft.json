                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "f82660c1-d38c-4367-9014-bd4759d648da",
                                "sense_id": "ccf8768b-63f0-3f12-bd8b-f3eec9effea7",
                                "text": "»Vereinigt Euch!« ruft Wilhelm Pieck allen Sozialdemokraten und Kommunisten im übrigen Deutschland zu. Das sei die wichtigste Aufgabe der Arbeiterschaft für 1947."
                            }
                        ]
                    }
