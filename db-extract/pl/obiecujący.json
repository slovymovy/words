                                    {
                                        "sense_id": "5e6b04fe-300a-3291-84bc-e00d0a0b84ac",
                                        "entry_id": "054e328d-f8d3-3771-9e6a-d33460dd6bfc",
                                        "glosses": [
                                            "mit Aussicht/Hoffnung auf Erfolg oder Gelingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de8d065-d60e-4207-9e82-35bb5bf8e8db",
                                                "sense_id": "5e6b04fe-300a-3291-84bc-e00d0a0b84ac",
                                                "text": "Ist das wirklich eine aussichtsreiche Strategie zur Reduzierung von Lohnkosten?"
                                            },
                                            {
                                                "example_id": "e0a992ef-68a0-4b17-a5d7-9855dfe63105",
                                                "sense_id": "5e6b04fe-300a-3291-84bc-e00d0a0b84ac",
                                                "text": "„Auch zehn Minuten vor dem Ende scheiterte der für RB Salzburg stürmende Adeyemi aus aussichtsreicher halblinker Position an Keeper Costa.“"
                                            },
                                            {
                                                "example_id": "b1631902-4043-47b3-b13e-c31f1b5fe56a",
                                                "sense_id": "5e6b04fe-300a-3291-84bc-e00d0a0b84ac",
                                                "text": "„Trump gilt bei der im November anstehenden Präsidentschaftswahl als aussichtsreichster Bewerber der Republikaner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f6df55b-bdca-34fe-b1c1-9cd9939ed274",
                                        "entry_id": "054e328d-f8d3-3771-9e6a-d33460dd6bfc",
