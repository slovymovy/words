                "senses": [
                    {
                        "sense_id": "2a944e6c-bd55-3403-b60a-e95bb44c00ed",
                        "entry_id": "f1c2766a-8a9b-33e5-bc31-1bb827296763",
                        "glosses": [
                            "stellvertretender Regierungschef"
