                "senses": [
                    {
                        "sense_id": "65c10234-098f-3810-b641-43b854e13d9f",
                        "entry_id": "9b878b30-91fd-3337-bf3f-2b2fdcdb7d7a",
                        "glosses": [
                            "künstlerische Veranstaltung, die vormittags stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd01864c-9764-415c-ac2a-78a27978679a",
                                "sense_id": "65c10234-098f-3810-b641-43b854e13d9f",
                                "text": "Die Matinee wurde von vielen Interessenten besucht."
                            },
                            {
                                "example_id": "9e9885af-ce03-4d97-b2ea-35607ea3a6db",
                                "sense_id": "65c10234-098f-3810-b641-43b854e13d9f",
                                "text": "„Während der Probenpause, in der sie Rauchgier und Essverlangen befriedigten, ging Almuth kurz auf die Matinee ein.“"
                            },
                            {
                                "example_id": "89a6dfb5-bc92-4867-a12a-8e0433176ef8",
                                "sense_id": "65c10234-098f-3810-b641-43b854e13d9f",
                                "text": "„Jahre später traf ich eines Tages Joyce, der sich auf dem Boulevard Saint-Germain erging, nachdem er allein eine Matinee besucht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c170b675-915c-48f8-825c-8a88cce7d698",
                        "source_entry_id": "9b878b30-91fd-3337-bf3f-2b2fdcdb7d7a",
                        "source_sense_id": "65c10234-098f-3810-b641-43b854e13d9f",
                        "source_sense_description": "künstlerische Veranstaltung, die vormittags stattfindet",
                        "target_lang_word": "matinee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matinee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef19fc87-412d-3bd0-af26-c3b33988fc90",
                                        "entry_id": "a466dd78-d5a8-309c-b411-77462d3945dc",
                                        "glosses": [
                                            "A showing of a movie, sporting event, or theatrical performance in the morning or afternoon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d71c64d-b8dd-4264-ab2b-b68e4ac7a67b",
                                                "sense_id": "ef19fc87-412d-3bd0-af26-c3b33988fc90",
                                                "text": "59 sneak in some red Smuggle a bottle of wine, two glasses, and a corkscrew into a long matinee. Red wine is rich in life-extending antioxidants, and the caper will add zest even to a bad movie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfa0d44-073a-3e8b-b5e6-9c0e2ab33c79",
                                        "entry_id": "a466dd78-d5a8-309c-b411-77462d3945dc",
                                        "glosses": [
                                            "A woman's dress to be worn in the morning or before dinner."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878e2b33-ad27-4062-a9a3-f7cc62eb27ea",
                                                "sense_id": "abfa0d44-073a-3e8b-b5e6-9c0e2ab33c79",
                                                "text": "Empire matinees in lingerie stuffs with trimmings of lace and embroidery are shown in great variety."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matinee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae4d467-c0c0-3309-9628-3ae7396b4373",
                                        "entry_id": "80969b18-64f4-37e9-8085-b7e5bcc01b5b",
                                        "glosses": [
                                            "To put on a matinee performance (of)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81e0a766-af03-4210-94cc-9dcd553e5b2a",
                        "source_entry_id": "9b878b30-91fd-3337-bf3f-2b2fdcdb7d7a",
                        "source_sense_id": "65c10234-098f-3810-b641-43b854e13d9f",
                        "source_sense_description": "künstlerische Veranstaltung, die vormittags stattfindet",
                        "target_lang_word": "matinée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matinée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fabd6213-4ef7-33e4-8325-88f277dbb568",
                                        "entry_id": "de1ba53f-cccc-3238-af04-5367f0339ca5",
                                        "glosses": [
                                            "Partie du matin qui s’écoule depuis le point du jour jusqu’à midi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8677987-7475-447e-bc4a-627ef2fb9a08",
                                                "sense_id": "fabd6213-4ef7-33e4-8325-88f277dbb568",
                                                "text": "Les deux travailleurs essuyèrent leurs visages trempés, […], puis se parlèrent et se comportèrent comme des hommes qui se congratulent d’une matinée bien employée."
                                            },
                                            {
                                                "example_id": "36f4c23e-2edb-4673-9fb4-3d8d1eecbb09",
                                                "sense_id": "fabd6213-4ef7-33e4-8325-88f277dbb568",
                                                "text": "Le baromètre a baissé terriblement pendant la nuit et la matinée. Je m’attends à du gros temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c9e0fc-d2f4-3312-9927-76e629a7bf26",
                                        "entry_id": "de1ba53f-cccc-3238-af04-5367f0339ca5",
                                        "glosses": [
                                            "Représentation, spectacle qui a lieu l’après-midi, par opposition à la soirée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f7c5d9a-6a58-4b13-9973-a066630359bb",
                                                "sense_id": "88c9e0fc-d2f4-3312-9927-76e629a7bf26",
                                                "text": "Je continuais à regarder le journal, mais bien que ce ne fût que pour me donner une contenance et me faire gagner du temps, tout en ne faisant que semblant de lire, je comprenais tout de même le sens des mots qui étaient sous mes yeux, et ceux-ci me frappaient : « Au programme de la matinée que nous avons annoncée et qui sera donnée cet après-midi dans la salle des fêtes du Trocadéro, il faut ajouter le nom de Mlle Léa qui a accepté d'y paraître dans Les Fourberies de Nérine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                        "entry_id": "de1ba53f-cccc-3238-af04-5367f0339ca5",
                                        "glosses": [
                                            "Vêtement d’intérieur porté le matin par les femmes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6296fa04-b23c-490a-bda9-a69ea43efb80",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "Elle en obtint des matinées, des chemises, des peignoirs à désespérer les peintres par leur diaphanéïté neigeuse."
                                            },
                                            {
                                                "example_id": "c6890756-7471-451c-8f7a-f14261b380b0",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "Il s’était emparé, ostensiblement d’ailleurs, d’un mannequin recouvert d’une matinée blanche."
                                            },
                                            {
                                                "example_id": "b38560d0-fe29-4ee1-932c-4fa861013adf",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "En matinée de foulard blanc, sale et fripée, les cheveux retenus sur le haut de la tête par un peigne mis de travers, les coudes sur la table, Gabrielle fumait une cigarette et sirotait un verre de chartreuse."
                                            },
                                            {
                                                "example_id": "867b4812-038f-49ae-b1d4-581e90ba58d6",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "Elles ont fait toilette, abandonnant pour une fois les peignoirs, matinées, robes de chambre et autres vêtements d’intérieur dans lesquels elles vivent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
