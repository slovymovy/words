                                        "sense_id": "1f4459a0-e3b1-3bee-9532-ae1704075071",
                                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                                        "glosses": [
                                            "A designer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b2a7c29-733d-3aa5-9cd7-3857434c1343",
                                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                                        "glosses": [
                                            "A hairdresser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e47dadb-66ea-3ba9-9aeb-7938c72eb950",
                                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                                        "glosses": [
                                            "A writer or speaker distinguished for excellence or individuality of style; one who cultivates, or is a master or critic of, literary style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef131de0-e868-4d12-9206-acb2948f7724",
                                                "sense_id": "5e47dadb-66ea-3ba9-9aeb-7938c72eb950",
                                                "text": "If Doctor Johnson, that stilted and accomplished stylist, had lacked the sacred Boswell, what should we have known of him?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b5bf793-c257-357e-9fcd-2007479326c3",
                                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                                        "glosses": [
                                            "An artist who has a particular distinctive style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6232f416-1df4-483d-aec8-8c875bc4518b",
                                                "sense_id": "9b5bf793-c257-357e-9fcd-2007479326c3",
                                                "text": "A plain, seemingly graceless stylist, his rather unpalatable movies, full of rabid, sloggingly orchestrated physical pain and psychic damage, picture crime as a monstrous, miasmal evil, divesting it of any glamour it ever had."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "690d80cd-b01c-4dae-9cbd-5b351cf96538",
                        "source_entry_id": "dca112ef-f74e-3f4d-b213-511314b9613c",
                        "target_lang_word": "styliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "styliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
                                        "entry_id": "dce50127-7b7d-3235-a413-78e12ecf94bb",
                                        "glosses": [
                                            "Professionnel chargé du stylisme."
                                        ],
                                        "tags": [
                                            "Tous domaines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e2d77b1-42ae-416f-955a-a4edfc316de5",
                                                "sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
                                                "text": "Dans l'insolite quartier de 12th Ave S, une ancienne styliste des drag-queens de New-York vend des perruques crépues, des santiags et des bolos (la cravate du cow-boy) artisanaux chez Katy K's Ranch Dressing (2407 12th Ave S)."
                                            },
                                            {
                                                "example_id": "f9d1b071-1f07-42d9-9612-bc04332395e9",
                                                "sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
                                                "text": "« On sait que les influenceuses d’aujourd’hui peuvent devenir les stars du cinéma de demain, même si elles rejoindront alors des marques plus connues que la mienne », précise le styliste Christophe Guillarmé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
