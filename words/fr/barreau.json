                {
                    "sense_id": "40b0dcbd-3652-3e59-8b84-865abafd670b",
                    "sense_definition": "Chacune des barres de métal ou de bois qui ferment une grille, une cage ou une fenêtre de prison.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prisonnier regardait tristement la cour extérieure à travers les <w>barreaux</w> de sa cellule."
                        },
                        {
                            "text": "Les propriétaires ont installé des <w>barreaux</w> aux fenêtres du rez-de-chaussée pour empêcher les cambriolages."
                        }
                    ],
                    "common_phrases": [
                        "derrière les barreaux"
                    ]
                },
                {
                    "sense_id": "64bed6a0-de21-3a6c-86e0-81866cf02d6c",
                    "sense_definition": "Ordre professionnel réunissant les avocats inscrits auprès d'un même tribunal, ou la profession d'avocat elle-même.",
