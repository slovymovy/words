                                "target_senses": [
                                    {
                                        "sense_id": "8b2a07b4-598f-3edb-b3b9-f6e784acc2a6",
                                        "entry_id": "d7f3aa65-355f-39b6-baf0-dbacf7dcfdfd",
                                        "glosses": [
                                            "The act of collaborating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1b3895-92aa-4c79-9fa1-646eefe4b226",
                                                "sense_id": "8b2a07b4-598f-3edb-b3b9-f6e784acc2a6",
                                                "text": "Collaboration can be a useful part of the creative process."
                                            },
                                            {
                                                "example_id": "cc7cdbc5-ad46-4904-98aa-068e4a360c51",
                                                "sense_id": "8b2a07b4-598f-3edb-b3b9-f6e784acc2a6",
                                                "text": "During the interwar period, fascists proposed class collaboration as a response to communist class struggle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a7d3fd-b92b-3e8b-852a-32a46687e0a6",
                                        "entry_id": "d7f3aa65-355f-39b6-baf0-dbacf7dcfdfd",
                                        "glosses": [
                                            "A production or creation made by collaborating."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e025e4-9df8-4745-9136-748c4cdf2e98",
                                                "sense_id": "d0a7d3fd-b92b-3e8b-852a-32a46687e0a6",
                                                "text": "The husband-and-wife artists will release their new collaboration in June this year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5918d34a-74e4-367a-8f30-53a2a4ba81d5",
                                        "entry_id": "d7f3aa65-355f-39b6-baf0-dbacf7dcfdfd",
                                        "glosses": [
                                            "Treasonous cooperation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712e3b28-f0be-48a5-a323-0bfec00ea69b",
                                                "sense_id": "5918d34a-74e4-367a-8f30-53a2a4ba81d5",
                                                "text": "He has been charged with collaboration."
                                            }
                                        ]
