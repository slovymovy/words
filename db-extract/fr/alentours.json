                    {
                        "translation_id": "efe717c4-7743-42b8-b9e7-0c636121e023",
                        "source_entry_id": "adb24b9b-35fb-3e24-9bf6-8bb787eb896d",
                        "target_lang_word": "omgeving",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omgeving",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a1c37540-db32-3d87-85b6-89c9b8299e26",
                                        "entry_id": "0220741a-cbb1-3672-83ee-2ce3974ca8d6",
                                        "glosses": [
                                            "de nabijheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1229f6a1-aad3-4c2b-9f11-b68000c11216",
                                                "sense_id": "a1c37540-db32-3d87-85b6-89c9b8299e26",
                                                "text": "Wij bevinden ons in de omgeving van Amstelveen."
                                            },
                                            {
                                                "example_id": "d5699c85-7d0b-465c-ab3a-f58f204615b6",
                                                "sense_id": "a1c37540-db32-3d87-85b6-89c9b8299e26",
                                                "text": "Tot nu toe werd de invloed van zwarte gaten alleen indirect gezien: door de straling die ze uitstoten wanneer ze te rommelig het materiaal in hun omgeving verorberen."
                                            },
                                            {
                                                "example_id": "3d8cb02e-175e-4072-8e38-d6a454c3f321",
                                                "sense_id": "a1c37540-db32-3d87-85b6-89c9b8299e26",
                                                "text": "Ondanks de prachtige omgeving keek ik bij elk geluid toch wat schichtig achterom."
                                            },
                                            {
                                                "example_id": "e7406974-f290-4c39-9d06-3b627c753b1e",
                                                "sense_id": "a1c37540-db32-3d87-85b6-89c9b8299e26",
                                                "text": "Toeters en vlaggen: Volgens de regionale omroep RTV Oost was het ook druk in de omgeving van het stadion van de club, De Adelaarshorst. Voorbijkomende auto's toeterden erop los en mensen hingen met vlaggen uit het raam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "924d0516-2a75-3097-a9c4-67503b48efd0",
                                        "entry_id": "0220741a-cbb1-3672-83ee-2ce3974ca8d6",
                                        "glosses": [
                                            "een personenkring waarin iemand zich bevindt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "043b4d73-1dc9-4f7d-b3ab-764c89a46010",
                                                "sense_id": "924d0516-2a75-3097-a9c4-67503b48efd0",
                                                "text": "Ik bevind me in een vertrouwde omgeving."
                                            },
                                            {
                                                "example_id": "93b7757a-35b3-4ece-9285-da17e3228117",
                                                "sense_id": "924d0516-2a75-3097-a9c4-67503b48efd0",
                                                "text": "Ook voerde ze aan dat kinderen hersenschade oplopen als ze uit hun omgeving worden weggehaald, zo bleek eerder uit onderzoek door deskundigen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
