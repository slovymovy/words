    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0fd67d49-908d-37ff-befa-3864b479c588",
                    "sense_definition": "Qui est d'une surface, d'un volume ou d'une étendue gigantesque.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont acheté une <w>immense</w> maison à la campagne avec un beau jardin."
                        },
                        {
                            "text": "Le navire avançait lentement sur cet <w>immense</w> océan sous un ciel bleu."
                        }
                    ],
                    "synonyms": [
                        "énorme"
                    ],
                    "antonyms": [
                        "minuscule",
                        "petit"
                    ]
                },
                {
                    "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                    "sense_definition": "Qui est extrêmement grand ou important par son intensité, sa quantité ou sa valeur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle a provoqué une <w>immense</w> joie dans toute la famille réunie."
                        },
                        {
                            "text": "Le concert de ce jeune artiste a rencontré un <w>immense</w> succès auprès du public."
                        }
                    ],
                    "synonyms": [
                        "énorme"
                    ],
                    "antonyms": [
                        "insignifiant",
                        "minime"
                    ],
                    "common_phrases": [
                        "un immense plaisir",
                        "un immense succès",
                        "une immense tristesse"
                    ]
                },
                {
                    "sense_id": "86b6a1a6-eae3-3fa6-9dbf-6d982a2e89ed",
                    "sense_definition": "Qui est sans borne, sans limite ou d'une grandeur infinie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "infini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les philosophes s'interrogent souvent sur la nature d'un univers <w>immense</w> et sans fin."
                        },
                        {
                            "text": "Pour de nombreux croyants, Dieu est un être <w>immense</w> qui dépasse l'entendement humain."
