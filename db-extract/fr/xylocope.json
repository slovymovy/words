                        ],
                        "form": "xylocopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d183c16-53da-3847-82bf-b4aceea027af",
                        "entry_id": "27852243-8b3c-3dd5-9621-996b8008a1df",
                        "glosses": [
                            "Qui coupe le bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584f3b5d-33aa-4841-82d9-ad17f1b7f87f",
                                "sense_id": "9d183c16-53da-3847-82bf-b4aceea027af",
                                "text": "Dans l'aubier altéré des troncs, notre inattendu bûcheron à tarière et à mandibules sculpte en silence des cellules. C'est héritage pour ses larves. Avec l'insecte xylocope, ermite parmi les abeilles, j'aimerais vivre en misanthrope sa discipline monacale."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "02265c61-6d35-32b5-8948-6bd82d8f96c3",
                "word": "xylocope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2dfe6898-f181-4c21-86e1-728eeabdec1e",
                        "entry_id": "02265c61-6d35-32b5-8948-6bd82d8f96c3",
                        "tags": [
                            "plural"
                        ],
                        "form": "xylocopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26d5c820-4149-3eec-affa-8f2046361fce",
                        "entry_id": "02265c61-6d35-32b5-8948-6bd82d8f96c3",
                        "glosses": [
                            "Abeille charpentière, hyménoptère de la famille des Apidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed023ee3-c590-4765-bb34-98750dd27697",
                                "sense_id": "26d5c820-4149-3eec-affa-8f2046361fce",
                                "text": "La femelle de xylocope violet (Xylocopa violacea), ou abeille perce-bois, possède un dard mais n'est absolument pas agressive."
                            },
                            {
                                "example_id": "92fb43bd-2e5b-450c-812d-d2201f9d4b7b",
                                "sense_id": "26d5c820-4149-3eec-affa-8f2046361fce",
                                "text": "Le xylocope vit en solitaire contrairement aux abeilles domestiques ou aux bourdons."
                            },
                            {
                                "example_id": "78a0c3a7-6435-49c6-96fa-e78ba949130f",
                                "sense_id": "26d5c820-4149-3eec-affa-8f2046361fce",
                                "text": "L'abeille charpentière est aussi appelée xylocope (Xylocopa violacea) et on peut la voir de mai à septembre dans les jardins. Elle est souvent nommée bourdon noir."
                            },
                            {
                                "example_id": "7278a761-d500-40e5-b17f-9120041db08c",
                                "sense_id": "26d5c820-4149-3eec-affa-8f2046361fce",
                                "text": "Les Xylocopes creusent leur nid au printemps dans le bois sec."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
