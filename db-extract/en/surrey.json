                "senses": [
                    {
                        "sense_id": "df52e5e0-dac5-3f9f-a590-cceeb3187731",
                        "entry_id": "453b46e4-9159-3f11-b59c-acf815ebfbd6",
                        "glosses": [
                            "A light horse-drawn carriage with forward-facing seats accommodating two or four people, popular in the United States; a motorized carriage of similar design."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "161b8694-84e4-45e8-b143-2543aa28f938",
                                "sense_id": "df52e5e0-dac5-3f9f-a590-cceeb3187731",
                                "text": "The Surrey must be looked upon as the spring novelty in the way of road-wagons."
                            },
                            {
                                "example_id": "a28418bc-da86-498f-a9d9-00a8f8045347",
                                "sense_id": "df52e5e0-dac5-3f9f-a590-cceeb3187731",
                                "text": "It suffered a wide verandah, one side of which led directly into the stables where, in former days, horses, surreys, and buggies had been kept, and where now two cars were housed— […]"
                            },
                            {
                                "example_id": "bb7611ce-7eb5-470d-8dfd-1136f4188d4c",
                                "sense_id": "df52e5e0-dac5-3f9f-a590-cceeb3187731",
                                "text": "When I take you out, tonight, with me, / Honey, here's the way it's goin' to be: / You will set behind a team of snow white horses, / In the slickest gig you ever see! // Chicks and ducks and geese better scurry / When I take you out in the surrey, / When I take you out in the surrey with the fringe on top!"
                            }
                        ]
                    }
                ],
