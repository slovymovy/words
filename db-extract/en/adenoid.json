                                        "glosses": [
                                            "eetbare pit van de amandelvrucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8ea3df-860c-4f4e-b2e9-c9baf0cd4502",
                                                "sense_id": "e92b7bf1-c375-3554-a837-fa5830dddf9d",
                                                "text": "Het vreemdst was misschien nog wel dat oom Sverre deze keer niet de amandel in de rijstebrij kreeg."
                                            },
                                            {
                                                "example_id": "f532126d-7015-4344-9794-15a20e518aee",
                                                "sense_id": "e92b7bf1-c375-3554-a837-fa5830dddf9d",
                                                "text": "Iets vergeten? Ja. De amandel voor de rijstebrij, ze zouden tenslotte kerst vieren in het huis van oudoom Sverre, hij die altijd de amandel in de rijstebrij kreeg, vermoedelijk door de bedienden te corrumperen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37ef2052-43fe-34c4-ae3c-4164a02d4e20",
                                        "entry_id": "d2849617-c7db-3ad7-861e-f48725e784df",
                                        "glosses": [
                                            "elk van de vier klieren in de neus-keelholte, die deel uitmaken van het afweersysteem"
                                        ],
                                        "tags": [],
                                        "examples": [
