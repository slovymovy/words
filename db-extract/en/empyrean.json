                                        "entry_id": "f4ff0c21-c55e-3054-b292-984342ab452c",
                                        "glosses": [
                                            "der höchste Teil des Himmels, in dem Gott und die Seligen wohnen und der von Licht erfüllt ist"
                                        ],
                                        "tags": [
                                            "Philosphie",
                                            "vor allem mittelalterlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19be4f35-e0bf-4702-a7a3-22f31703a443",
                                                "sense_id": "09e3d5d6-91cb-34fc-b67d-4da095401f98",
                                                "text": "In Dantes Göttlicher Komödie wird der Reisende am Ende durch das Empyreum geführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
