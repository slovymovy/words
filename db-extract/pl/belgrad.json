                    {
                        "translation_id": "93b62ad2-da46-40b5-9fc5-a0de29415b8c",
                        "source_entry_id": "d8617217-ad22-308d-8526-412e590c5c7a",
                        "source_sense_id": "cddbc965-8c73-3991-930b-4367ff3412df",
