                    "sense_definition": "Gebiedende wijs van <w>schandvlekken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schandvlek</w> onze goede naam niet door je zo te misdragen!",
                            "target_lang_translations": {
                                "en": "Do not <w>disgrace</w> our good name by misbehaving like that!"
                            }
                        },
                        {
                            "text": "Zwijg en <w>schandvlek</w> de nagedachtenis van je vader niet!",
                            "target_lang_translations": {
                                "en": "Be silent and do not <w>stain</w> the memory of your father!"
                            }
                        }
                    ],
