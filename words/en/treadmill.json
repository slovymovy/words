{
    "word_family": [
        "tread"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5260e641-c637-3fbd-af0d-5327e35d295e",
                    "sense_definition": "An exercise machine with a moving belt on which one can run or walk while remaining in one place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exercise machine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She runs on the <w>treadmill</w> at the gym for thirty minutes every morning."
                        },
                        {
                            "text": "He bought a folding <w>treadmill</w> to stay active while working from home."
                        }
                    ],
                    "common_phrases": [
                        "on the treadmill",
                        "running on a treadmill"
                    ]
                },
                {
                    "sense_id": "cd1c2911-db04-3c78-ba2d-4140c011c1b9",
                    "sense_definition": "A repetitive, tiring, or monotonous situation in which someone must continuously work hard without making real progress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "monotony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many workers feel trapped on the corporate <w>treadmill</w> with little hope of promotion."
                        },
                        {
                            "text": "She decided to leave her stressful job to escape the daily <w>treadmill</w>."
                        }
                    ],
                    "common_phrases": [
                        "corporate treadmill",
                        "hedonic treadmill"
                    ]
                },
                {
                    "sense_id": "145ffe15-eeab-3a12-8222-5dd718ffefc6",
                    "sense_definition": "A large wheel turned by prisoners treading on steps around its circumference, historically used as hard labor and punishment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mill mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the nineteenth century, convicts were often forced to spend long hours working the <w>treadmill</w>."
                        },
                        {
                            "text": "The prison <w>treadmill</w> was designed to be both physically exhausting and mentally demoralizing."
                        }
                    ],
                    "synonyms": [
                        "everlasting staircase"
                    ],
                    "common_phrases": [
                        "prison treadmill"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historic apparatus"
                        }
                    ]
                },
                {
                    "sense_id": "9ee1f2ce-afb8-37d9-a6db-2b5cb9f3b0f5",
                    "sense_definition": "A mechanism driven by working animals or people walking on an endless belt or wheel to grind grain or operate machinery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mill mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional farm used an animal-powered <w>treadmill</w> to grind corn into meal."
                        },
                        {
                            "text": "Horses were harnessed to turn the heavy wooden <w>treadmill</w> throughout the day."
                        }
                    ],
                    "synonyms": [
                        "mill"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historic machinery"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a14beeb6-3759-3134-b621-cff2d17498ee",
                    "sense_definition": "To run or exercise on a treadmill.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exercise machine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of running outside in the rain, she <w>treadmilled</w> for an hour indoors."
                        },
                        {
                            "text": "He usually <w>treadmills</w> while listening to his favorite audiobooks."
                        }
                    ]
                },
                {
                    "sense_id": "d408e7b7-db7d-3b3a-b394-a3eb3c3df15e",
                    "sense_definition": "To work or stay continuously busy without making any real forward progress.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "monotony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like he was merely <w>treadmilling</w> through fifty hours of paperwork each week."
                        },
                        {
                            "text": "After years of <w>treadmilling</w> in the same dead-end job, she finally chose to quit."
                        }
                    ]
                }
            ]
        }
    ]
}