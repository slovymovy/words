                        "entry_id": "abb4b865-2afd-3d5a-8fa0-5cdd14b3803b",
                        "glosses": [
                            "Action de canarder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6648714-6e06-4f76-aa74-d56ecd5a93cf",
                                "sense_id": "3d33e8e3-e67b-3949-b977-a7973ebd400a",
                                "text": "Le canardage des snipers a fait de nombreux morts."
                            },
                            {
                                "example_id": "7e25202a-81b3-4fe4-939e-dc68dd6d456f",
                                "sense_id": "3d33e8e3-e67b-3949-b977-a7973ebd400a",
                                "text": "Pour leur salut, les gardes, incapables de les voir, avaient tiré au hasard de toute part, à hauteur d’homme et les Witz, plaqués au sol pendant le canardage, n’avaient pas subi de perte."
                            }
                        ]
                    }
                ],
