                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf9a38c-093a-4198-ab60-b9f674437b00",
                                "sense_id": "12afa0ed-eaa3-3b43-9a02-2d05d4ab5090",
                                "text": "Avant d’entreprendre une peinture sur un fond pumicif, on aura soin d’enlever légèrement, au moyen d’un bouchon de papier, le plus gros de la ponce qui adhère à la surface ; si l’on négligeait cette précaution, on ne tarderait pas, en travaillant, à s’enlever jusqu’au sang l’épiderme du bout des doigts."
                            }
                        ]
