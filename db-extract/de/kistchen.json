                "senses": [
                    {
                        "sense_id": "284baf98-446c-3551-9258-522ac4292f59",
                        "entry_id": "afe8ed99-08bc-3f05-a34d-bef65f48c3ab",
                        "glosses": [
                            "kleine Kiste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c115be-8537-4d79-a96e-e628ddb6c24e",
                                "sense_id": "284baf98-446c-3551-9258-522ac4292f59",
                                "text": "„Er zog das offene Kistchen zu sich heran, nahm die Sachen heraus und legte sie auf den Tisch.“"
                            },
                            {
                                "example_id": "7a6f5e7f-5b21-42bb-adb0-185c636cc562",
                                "sense_id": "284baf98-446c-3551-9258-522ac4292f59",
                                "text": "„Er hält ein Kistchen appetitlicher Kieler Sprotten in der Hand und ißt sie schmatzend.“"
                            },
                            {
                                "example_id": "5564111e-caf2-4143-b38c-d390496d413f",
                                "sense_id": "284baf98-446c-3551-9258-522ac4292f59",
                                "text": "„Die Kellnerin hatte wirklich hinten im Zelt ein Kistchen Champagner.“"
                            },
                            {
                                "example_id": "29fc3c3f-6887-4fd1-a245-d2b10f05c12e",
                                "sense_id": "284baf98-446c-3551-9258-522ac4292f59",
                                "text": "„Er verfasst seine Briefe und steckt sie einige Tage später in das blaue Kistchen unter seinem Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
