        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ced94236-5ea8-3fbf-ae26-554d067d7696",
                "word": "fother",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b1d1a95e-77f7-4fa3-b72e-0b087e84acde",
                        "entry_id": "ced94236-5ea8-3fbf-ae26-554d067d7696",
                        "tags": [
                            "plural"
                        ],
                        "form": "fothers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "118b1be2-afb4-3941-92bd-daf1faf3bd15",
                        "entry_id": "ced94236-5ea8-3fbf-ae26-554d067d7696",
                        "glosses": [
                            "A load, a wagonload, especially any various English units of weight or volume based upon standardized cartloads of certain commodities."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8753a0d4-e3f8-46d7-81ae-47571f7038c1",
                                "sense_id": "118b1be2-afb4-3941-92bd-daf1faf3bd15",
                                "text": "Four fother of clod lime, and fifteen fothers of good manure, on each acre."
                            },
                            {
                                "example_id": "1c16fb2d-3b7e-439a-aa5c-f83bf7b0c442",
                                "sense_id": "118b1be2-afb4-3941-92bd-daf1faf3bd15",
                                "text": "20 fothers of additional thickness in clay were thrown in."
                            },
                            {
                                "example_id": "ed566ea3-1593-4413-bb5b-8dc1ea9a9425",
                                "sense_id": "118b1be2-afb4-3941-92bd-daf1faf3bd15",
                                "text": "Where the brass hez a' cum fra nebody can tell, / Some says yen thing and some says another - / But whe ever lent Grainger't aw knaw very well, / That they mun have at least had a fother."
                            },
                            {
                                "example_id": "cf84d2ae-f03b-4cd7-8310-ed51e449d7d7",
                                "sense_id": "118b1be2-afb4-3941-92bd-daf1faf3bd15",
                                "text": "Now measured by the old hundred, that is, 108 lbs. the charrus contains nearly 19½ hundreds, that is it corresponds to the fodder, or fother, of modern times."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7780a5e-6b59-3847-8faa-517d1e16e6d9",
                        "entry_id": "ced94236-5ea8-3fbf-ae26-554d067d7696",
                        "glosses": [
                            "Alternative form of fodder, food for animals."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "countable",
                            "dialectal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "542cddc7-0f56-4a0f-b063-d48c8b7c181a",
                                "sense_id": "c7780a5e-6b59-3847-8faa-517d1e16e6d9",
                                "text": "He ripp'd the womb up of his mother, / Dame Tellus, 'cause he wanted fother, / And provender, wherewith to feed / Himself and his less cruel steed."
                            }
                        ]
                    }
                ],
