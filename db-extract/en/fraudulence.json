                                                "example_id": "3add7809-c600-4f26-86fd-2ed3b1b77873",
                                                "sense_id": "f4fb762e-b15c-3c62-9ffe-df331043305d",
                                                "text": "Faire un contrat en fraude de ses créanciers."
                                            }
                                        ]
                                    },
                                    {
