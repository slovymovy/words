                        "form": "édits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6420a63-aeab-33ce-9952-143ca2e5ea2a",
                        "entry_id": "30c8b169-0863-3871-9d15-a2d2476be650",
                        "glosses": [
                            "Ordonnance d’un magistrat, d’un empereur."
                        ],
                        "tags": [
                            "Ancient-Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "ce28e3cd-ecb6-44e4-926e-908fea26f9c1",
                                "sense_id": "c6420a63-aeab-33ce-9952-143ca2e5ea2a",
                                "text": "L’édit d’un prêteur."
                            },
                            {
                                "example_id": "964557d4-d6f9-4667-8589-97f01fd93459",
                                "sense_id": "c6420a63-aeab-33ce-9952-143ca2e5ea2a",
                                "text": "Édit du prince."
                            },
                            {
                                "example_id": "2653e26d-3e7c-44fc-9177-954cbf4d917f",
                                "sense_id": "c6420a63-aeab-33ce-9952-143ca2e5ea2a",
                                "text": "Les édits des empereurs romains."
                            },
                            {
                                "example_id": "7049ef66-d79d-4edc-b705-3949db04c621",
                                "sense_id": "c6420a63-aeab-33ce-9952-143ca2e5ea2a",
                                "text": "Un édit de Justinien."
                            }
                        ]
                    },
                    {
                        "sense_id": "c00dc5e6-1930-3064-9c7a-dc4e20239524",
                        "entry_id": "30c8b169-0863-3871-9d15-a2d2476be650",
                        "glosses": [
                            "Ordonnance des rois de l’Ancien Régime, qui ne statuait que sur un seul point ou une seule matière."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "936fc82b-6e98-4add-a919-54b554d52ab1",
                                "sense_id": "c00dc5e6-1930-3064-9c7a-dc4e20239524",
                                "text": "C'est les Jésuites qui ont fait assassiner Henri IV ; c'est encore eux qui ont fait révoquer l’Édit de Nantes, à la suite de quoi tous les protestants ont été obligés de quitter la France."
                            },
                            {
                                "example_id": "e9014517-001e-43ba-98d9-a79041f806b0",
                                "sense_id": "c00dc5e6-1930-3064-9c7a-dc4e20239524",
                                "text": "Un édit alla jusqu'à prononcer la peine de mort contre les trafiquants."
                            },
                            {
                                "example_id": "bd23a6fc-6be6-43c7-ba5f-89339e18d291",
                                "sense_id": "c00dc5e6-1930-3064-9c7a-dc4e20239524",
                                "text": "Comme il avait payé son emplette avec une pièce de monnaie à l'effigie du duc Raymond de Toulouse, le doyen de Beaucaire le fit incarcérer, sous prétexte qu'il avait contrevenu à un édit royal interdisant l'emploi d'une monnaie autre que celle de Nîmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "081a2536-5852-4d40-b3eb-f3eebc543cb4",
                        "source_entry_id": "30c8b169-0863-3871-9d15-a2d2476be650",
                        "target_lang_word": "Edikt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edikt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abfb4a22-0078-3ea0-ac81-e6d3612ed2ec",
                                        "entry_id": "5640519a-3861-3b52-ad04-cd5350007a85",
                                        "glosses": [
                                            "Erlass, Verlautbarung (amtlich oder vom Kaiser, König)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e26cfe-4f49-449c-ab0b-e387870c2b38",
                                                "sense_id": "abfb4a22-0078-3ea0-ac81-e6d3612ed2ec",
                                                "text": "Der Kaiser erlässt ein Edikt, das den Bauern das Jagen verbietet."
                                            },
                                            {
                                                "example_id": "7a10a77e-1a17-4011-ac49-d6fd134a7858",
                                                "sense_id": "abfb4a22-0078-3ea0-ac81-e6d3612ed2ec",
                                                "text": "Die Kärntner Haftungen sind in dem Edikt noch mit 10,2 Milliarden Euro angegeben."
                                            },
                                            {
                                                "example_id": "8eb884b2-57a3-4056-90a9-2dd972b62905",
                                                "sense_id": "abfb4a22-0078-3ea0-ac81-e6d3612ed2ec",
                                                "text": "Das Edikt [der Einführung der allgemeinen Schulpflicht] von [Preussens König] Friedrich Wilhelm I. zeigt in der Praxis nur wenig Wirkung."
                                            },
                                            {
                                                "example_id": "0a4191f1-de45-4f6f-8206-fb0287b80363",
                                                "sense_id": "abfb4a22-0078-3ea0-ac81-e6d3612ed2ec",
                                                "text": "„Jedermann wußte, daß Galilei dieses Edikt vom Jahre 1616 als schweren Schlag, gegen sich selbst gerichtet, erlebt hatte.“"
                                            },
                                            {
                                                "example_id": "a353e5e6-c359-4d7c-9bef-316cf3b1acdf",
                                                "sense_id": "abfb4a22-0078-3ea0-ac81-e6d3612ed2ec",
                                                "text": "„Edikte gegen den Waffenbesitz der Bauern geben über diese Entwicklung Aufschluss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9644cee0-36c3-391d-a27b-60773dd19b5d",
                                        "entry_id": "5640519a-3861-3b52-ad04-cd5350007a85",
                                        "glosses": [
                                            "gerichtlicher Beschluss über die Eröffnung eines Konkursverfahrens"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82487e5f-9c8f-44c9-8dbc-60fe926a472b",
                                                "sense_id": "9644cee0-36c3-391d-a27b-60773dd19b5d",
                                                "text": "Die Eröffnung eines Insolvenzverfahrens wird durch Edikt öffentlich bekannt gemacht, wobei das Verfahren ausdrücklich entweder als Konkursverfahren oder als Sanierungsverfahren bezeichnet wird (außerdem erfolgt gegebenenfalls eine Eintragung ins Firmenbuch)."
                                            },
                                            {
                                                "example_id": "94ee86d7-bee8-492f-971b-0621091175a3",
                                                "sense_id": "9644cee0-36c3-391d-a27b-60773dd19b5d",
                                                "text": "Eine Ausfertigung des vorstehenden Beschlusses als Edikt wird an die Wiener Zeitung zur einmaligen Verlautbarung übersendet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8352a8c0-c09c-4ff7-b81e-80b2e4f54719",
                        "source_entry_id": "30c8b169-0863-3871-9d15-a2d2476be650",
                        "target_lang_word": "edict",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21db7e31-7271-374c-8f25-c0670ad0aedc",
                                        "entry_id": "dfa200af-3ce1-34e2-b620-e54e46fc38f0",
                                        "glosses": [
                                            "A proclamation of law or other authoritative command."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "156a4722-5670-4f95-a5c6-b0a6562a3f55",
                                                "sense_id": "21db7e31-7271-374c-8f25-c0670ad0aedc",
                                                "text": "By this time the edict had gone forth that the railways were to be nationalised on January 1, 1948."
                                            },
                                            {
                                                "example_id": "5fc85bce-c761-4f5e-8319-6b1862cc701b",
                                                "sense_id": "21db7e31-7271-374c-8f25-c0670ad0aedc",
                                                "text": "It was made clear in a pre-tournament referees' briefing that such grappling would be taken seriously and punished, so England have every right to ask why this edict was not carried out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f48a7f92-e9e6-4e15-8ff2-381657e5a7fd",
                        "source_entry_id": "30c8b169-0863-3871-9d15-a2d2476be650",
                        "target_lang_word": "edicto",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edicto",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3d5207b6-f724-31e9-a3b0-1317e74bc6d8",
                                        "entry_id": "55cc964e-05ff-3fff-83d9-78beb4565a5b",
                                        "glosses": [
                                            "Orden o decreto legal promulgado por un monarca o magistrado judicial."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071ac48a-5f65-483e-8d2e-78d9626ddff2",
                                                "sense_id": "3d5207b6-f724-31e9-a3b0-1317e74bc6d8",
                                                "text": "En el tiempo que Tarquino el superbo imperaba en Roma reinaba también en Egipto el rey Amasio, el cual mandó por edicto público que ninguno en todo su imperio se anduviese ocioso, ni osase de vivir de sudor ageno, so pena que al hombre que no quisiese trabajar, ni oficio aprender, le azotasen públicamente en la plaza, y le desterrasen después de su república."
                                            },
                                            {
                                                "example_id": "c92ea94f-40b6-48e6-9226-aa9b51181ac4",
                                                "sense_id": "3d5207b6-f724-31e9-a3b0-1317e74bc6d8",
                                                "text": "Los del Consejo real de Nauarra, que residen en la villa de Sanguessa, nos han scrito diziendo que en estos dias mas cerca pasados se ha seguido que, saliendose desse reyno Aragon seys hombres, vascos de naçion, cumpliendo el edicto que dizen ser fecho por nos para que todos los vassallos del rey de Francia saliessen dentro termino de xx dias de todos nuestros reynos y señorios, pasaron por el lugar de Casteliscar, que es en esse dicho reyno, en la frontera de Nauarra."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "626695fe-ed0f-3161-97a0-d34d9ddae2f7",
                                        "entry_id": "55cc964e-05ff-3fff-83d9-78beb4565a5b",
                                        "glosses": [
                                            "Cartel en que se publica o anuncia un edicto₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89672196-0898-4a5c-8494-324f2e4a07c5",
                                                "sense_id": "626695fe-ed0f-3161-97a0-d34d9ddae2f7",
                                                "text": "E estando aquellas bestias bien apartadas, se salió de entre ellas un caballo que había seído del adelantado Vasco Núñez de Balboa, e alta la cabeza, a paso tirado e sin pascer ni entenderse a dónde iba, después de haber andado más de cient pasos desde donde dejaba las otras bestias, llegó al poste, donde estaba el pregón o edicto afijado, e con los dientes asió del papel dos o tres veces e hízolo pedazos."
                                            },
                                            {
                                                "example_id": "bf9f146e-7710-456b-9db7-c8979c04f2e4",
                                                "sense_id": "626695fe-ed0f-3161-97a0-d34d9ddae2f7",
                                                "text": "Y para que venga a su noticia, mando que cuando las tales minas se hubieren de vender, se ponga un edicto en las puertas de las casas donde se hace audiencia, en que se manifieste cómo se venden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5dbac17a-74cd-3cb2-bd14-ee4a7e1768cc",
                                        "entry_id": "55cc964e-05ff-3fff-83d9-78beb4565a5b",
                                        "glosses": [
                                            "En particular, edicto₂ que se publica en sede judicial o a través de la prensa para notificar a los interesados de domicilio desconocido de una resolución del tribunal."
                                        ],
                                        "tags": [
                                            "Derecho"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08804be-a367-4f4c-bf3a-2c5faa8bbdf0",
                                                "sense_id": "5dbac17a-74cd-3cb2-bd14-ee4a7e1768cc",
                                                "text": "El juez del crimen, 8º turno, Carlos Ortiz Barrios, citó por edicto a un alto funcionario de un banco de plaza local que fue denunciado y procesado por la presunta sustracción de 1.400.000 dólares y que ahora se encontraría refugiado en la ciudad de Miami, Estado de Florida, EE.UU. Entre tanto, el magistrado solicitó ayuda de la INTERPOL para la ubicación y captura del fugitivo."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ed5d624-18e3-4bda-ade4-66ff6cbf3a64",
                        "source_entry_id": "30c8b169-0863-3871-9d15-a2d2476be650",
                        "target_lang_word": "διάταγμα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "διάταγμα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "6e7e6ad0-1921-34d6-be1d-9ff313980e15",
                                        "entry_id": "b11d1485-46ff-3ed8-ba59-f017c9dc4d56",
                                        "glosses": [
                                            "ονομασία γραπτών εντολών, από υψηλά ιστάμενη αρχή της εκτελεστικής εξουσίας, που έχει και νομοθετικό χαρακτήρα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d405f27-0cda-4c4c-84c6-f60fd5404d4f",
                                                "sense_id": "6e7e6ad0-1921-34d6-be1d-9ff313980e15",
                                                "text": "※ Ο Πάπας Φραγκίσκος υπέγραψε διάταγμα με το οποίο αναγνωρίζεται ένα δεύτερο θαύμα που αποδίδεται στη Μητέρα Τερέζα, ανοίγοντας το δρόμο για την αγιοποίηση το ερχόμενο έτος της γυναίκας που αφιέρωσε τη ζωή της στο να βοηθάει τους φτωχούς στην Ινδία και στον κόσμο, ανακοίνωσε την Παρασκευή το Βατικανό.",
                                                "translation": "Βατικανό: Ανοίγει ο δρόμος για την αγιοποίηση της Μητέρας Τερέζας, Η Καθημερινή, 18 Δεκεμβρίου 2015"
                                            },
                                            {
                                                "example_id": "969c623e-8522-417a-b54a-26060f76795b",
                                                "sense_id": "6e7e6ad0-1921-34d6-be1d-9ff313980e15",
                                                "text": "※ Με προεδρικό διάταγμα, το οποίο εκδίδεται μετά από πρόταση των Υπουργών Εσωτερικών, Αποκέντρωσης και Ηλεκτρονικής Διακυβέρνησης και Οικονομικών, ρυθμίζονται θέματα που αφορούν στη βεβαίωση εσόδων, στην ανάληψη υποχρεώσεων, στην έκδοση χρηματικών ενταλμάτων, στην ευθύνη και στον καταλογισμό σε βάρος των προσώπων που τα εκδίδουν και τα προσυπογράφουν, στη διαδικασία και το περιεχόμενο του ελέγχου των χρηματικών ενταλμάτων, στη χρηματική διαχείριση της ταμειακής υπηρεσίας, στη λογοδοσία των υπαλλήλων που ασκούν καθήκοντα ταμία (Νόμος 3852/2010, Άρθρο 268)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
