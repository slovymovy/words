                        {
                            "text": "Het bouwen van die toren bleek een <w>kostelijke</w> onderneming te zijn.",
                            "target_lang_translations": {
                                "fr": "La construction de cette tour s'est avérée être une entreprise <w>dispendieuse</w>."
                            }
