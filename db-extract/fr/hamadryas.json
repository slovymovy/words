                    {
                        "sense_id": "f944e59a-ec1f-3216-84eb-94c5c6bc3530",
                        "entry_id": "5304eb51-c2b6-361d-999f-13f0c0fa82f6",
                        "glosses": [
                            "Grand singe cynocéphale d'Afrique de l'Est et de la péninsule arabique dont les mâles ont un magnifique pelage argenté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bea48799-559c-485e-ab04-ac5126e0707a",
                                "sense_id": "f944e59a-ec1f-3216-84eb-94c5c6bc3530",
                                "text": "À l'exception des hamadryas, l'organisation sociale des babouins est de type matrilinéaire : les filles restent avec leur mère au sein de la troupe natale, alors que les mâles la quittent à l'adolescence."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9143054-366f-3393-9297-db98cd7a9e26",
                        "entry_id": "5304eb51-c2b6-361d-999f-13f0c0fa82f6",
                        "glosses": [
                            "Cobra royal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6cba754-fa63-41bb-95d7-16bef11493ca",
                                "sense_id": "f9143054-366f-3393-9297-db98cd7a9e26",
                                "text": "C'était un énorme serpent hamadryas, un mangeur, le géant de la race. Je le connais bien. Une ou deux fois déjà je l'ai affronté. Un monstre."
                            }
                        ]
                    }
