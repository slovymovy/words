                    },
                    {
                        "translation_id": "d9e0f7a3-981f-4ec4-9d21-e9c395b9a408",
                        "source_entry_id": "67716621-887e-3056-af23-9f054cdefa76",
                        "source_sense_id": "f7d1421a-ea5a-3fd8-bb36-bb97243c8638",
                        "source_sense_description": "hohe Geschwindigkeit, viel Schwung",
                        "target_lang_word": "à fond de train",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à fond de train",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5add78e-7bcc-302d-9283-255ddbdd2b85",
                                        "entry_id": "505212a7-cbbb-3434-961d-63ac6a0f1a0e",
                                        "glosses": [
                                            "À grande vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b2924a-3df4-453e-967c-9c9e3ab5df38",
                                                "sense_id": "b5add78e-7bcc-302d-9283-255ddbdd2b85",
                                                "text": "Et, enfonçant les éperons dans les flancs de sa monture qui hennit de douleur, il partit à fond de train."
                                            },
                                            {
                                                "example_id": "ce62b36e-3bea-4ba2-9cc9-c716fc40582d",
                                                "sense_id": "b5add78e-7bcc-302d-9283-255ddbdd2b85",
                                                "text": "Nous sommes découverts, et une douzaine de bédouins, criant et brandissant leurs longs fusils, sautent à cheval et viennent sur nous à fond de train, déployés en ligne comme à la fantasia."
                                            },
                                            {
                                                "example_id": "021bdf32-0104-48af-a636-4595efe11c65",
                                                "sense_id": "b5add78e-7bcc-302d-9283-255ddbdd2b85",
                                                "text": "Dans le même instant, elle est saisie, bâillonnée, emportée, jetée dans une voiture dont les chevaux s'élancent à fond de train."
                                            },
                                            {
                                                "example_id": "2052d5f1-1830-4c91-b55f-dc9b6de44ee9",
                                                "sense_id": "b5add78e-7bcc-302d-9283-255ddbdd2b85",
                                                "text": "Perceval - C’est après que ça se gâte.\n Père Blaise - Vous êtes pas arrivé en bas de la fosse ?\n Arthur - Ah si ! J’y suis même arrivé à fond de train puisqu’il a lâché la corde."
                                            },
                                            {
                                                "example_id": "22c5f4da-c109-4794-b966-755d39dff96e",
                                                "sense_id": "b5add78e-7bcc-302d-9283-255ddbdd2b85",
                                                "text": "Elle lui laissa le message, écrasa sa cigarette dans le cendrier tandis qu’un animal de la taille d’un chat à long poils traversait la route à fond de train, juste sous ses yeux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "à fond de train",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49466b75-aa01-338b-a03f-0aac167ab2a3",
                                        "entry_id": "29d1daa9-1eec-3aaa-8ca4-1b44a1c3c13e",
                                        "glosses": [
                                            "Vif, rapide, décidé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ccf5787-e7d7-4f19-ace2-a04eafe6c0a2",
                                                "sense_id": "49466b75-aa01-338b-a03f-0aac167ab2a3",
                                                "text": "Stanislas de La Rochefoucauld venait, quelques jours auparavant, de publier un article dont on disait, je crois, qu’il était une charge à fond de train contre les nobles et les cercleux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
