                ],
                "senses": [
                    {
                        "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                        "entry_id": "b738fcec-1cc1-3fbc-a9cb-f0ccb6ca9c69",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0211a9cd-f186-4679-9055-85f4f67ce78f",
                                "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                                "text": "Frau Schaeuffelen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6ad551c4-e576-4411-af87-3007a6226eba",
                                "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                                "text": "Herr Schaeuffelen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "543612ef-7e1b-4411-84e0-3ef7351faea3",
                                "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                                "text": "Die Schaeuffelens fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "322c65e4-78db-46ac-b0ad-79e6a5cb3e74",
                                "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                                "text": "Der Schaeuffelen trägt nie die Pullover, die die Schaeuffelen ihm strickt."
                            },
                            {
                                "example_id": "5b0f1e33-f15a-483a-9f0b-693b01191ec3",
                                "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schaeuffelen kommt, geht der Herr Schaeuffelen.“"
                            },
                            {
                                "example_id": "9478768f-c3d7-4699-857b-c2b144011e13",
                                "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                                "text": "Schaeuffelen kommt und geht."
                            },
                            {
                                "example_id": "ebd3a317-5d55-4295-b884-ea53699dbe8a",
                                "sense_id": "18b2583a-6ca5-3abc-b6d3-835cdb88b35f",
                                "text": "Schaeuffelens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
