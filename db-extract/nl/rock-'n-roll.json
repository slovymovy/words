                                    },
                                    {
                                        "sense_id": "1d9126bf-8cf4-3630-bd2f-a5adc9dcd862",
                                        "entry_id": "1c323ef1-b808-3996-aabf-7e1c5400c158",
                                        "glosses": [
                                            "To start, commence, begin, get moving; move along with a rocking, rolling motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e1fd9b-ba1c-41c6-9d0a-3508fb31bc4f",
                                                "sense_id": "1d9126bf-8cf4-3630-bd2f-a5adc9dcd862",
                                                "text": "Does everyone know what car they're going in? Then let's rock and roll!"
                                            },
                                            {
                                                "example_id": "1813d68c-3e04-4c0a-967c-5f15a5ba457d",
                                                "sense_id": "1d9126bf-8cf4-3630-bd2f-a5adc9dcd862",
                                                "text": "He puts the brakes on here and there down the next four miles of curves, but then opens her out so that she rocks and rolls through Totnes at a mile a minute for a flying start on the worst bank of the whole trip, five steep miles up to Rattery Box and four not so steep past Brent up to Wrangaton."
                                            },
                                            {
                                                "example_id": "76ac354d-243b-4a1e-8b66-c070ace96409",
                                                "sense_id": "1d9126bf-8cf4-3630-bd2f-a5adc9dcd862",
                                                "text": "Now we are ready to rock and roll."
                                            }
                                        ]
                                    }
