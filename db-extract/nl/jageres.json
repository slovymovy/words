                ],
                "senses": [
                    {
                        "sense_id": "530dafbf-b5aa-32bd-abd4-eb5328f5d27b",
                        "entry_id": "001f7b70-6f55-3b66-b64c-7da21ec148bf",
                        "glosses": [
                            "een vrouw die jaagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f4508e-26f8-4895-bd1d-9bf9ee22c527",
                                "sense_id": "530dafbf-b5aa-32bd-abd4-eb5328f5d27b",
                                "text": "Hij doet beroep op de beeldspraak van de dodelijke vechtkunsten van de Assassins als een dans tussen de jageres en haar prooi."
                            },
                            {
                                "example_id": "16fad77d-c0af-454e-adbc-7f369bf6e5e3",
                                "sense_id": "530dafbf-b5aa-32bd-abd4-eb5328f5d27b",
                                "text": "Rebecca Francis kwam deze week in het oog van de storm terecht toen komiek Ricky Gervais een oude foto op Twitter zette waarop ze poseert naast een giraf die ze doodschoot. De bekende jageres heeft echter geen spijt van haar daad. ‘Het beest ging toch sterven, en ik hielp de plaatselijke bevolking zo te overleven.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c969062-dc39-4232-8b79-5c3a6b2e7424",
                        "source_entry_id": "001f7b70-6f55-3b66-b64c-7da21ec148bf",
                        "source_sense_id": "530dafbf-b5aa-32bd-abd4-eb5328f5d27b",
                        "source_sense_description": "een vrouw die jaagt",
                        "target_lang_word": "huntress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huntress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                        "entry_id": "519c58d4-ada3-3ddf-9884-20b93e6e626a",
                                        "glosses": [
                                            "A female hunter."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77693f2c-47a6-402e-bddb-287ac02b086f",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "In those same woods ye well remember may / How that a noble hunteress did wonne [...]."
                                            },
                                            {
                                                "example_id": "7ddc2bb4-34b7-440d-a429-7f58e6c8cc90",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "Ashol-Pan, the daughter of a particularly celebrated hunter, may well be the country's only apprentice huntress."
                                            },
                                            {
                                                "example_id": "be6c18aa-dcfa-4118-8806-fe2c4ef696d0",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "Grief and fear cannot rule you;\nlet them be your faithful servants, protective of their mistress.\nLoss serves a huntress like fuel serves fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
