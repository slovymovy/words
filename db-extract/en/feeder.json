                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "001a3fcd-1b24-386d-9e66-fe5fd8c2846c",
                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                        "glosses": [
                            "The pitcher."
