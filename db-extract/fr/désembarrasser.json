                "senses": [
                    {
                        "sense_id": "7e87c01c-2445-36db-9802-5d5c19ff66d7",
                        "entry_id": "243f7478-a54f-385a-9168-ccbefb943489",
                        "glosses": [
                            "Délivrer de ce qui embarrasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d59f3a4c-f700-4f81-b7e3-b2fe8d8f487f",
                                "sense_id": "7e87c01c-2445-36db-9802-5d5c19ff66d7",
                                "text": "Attendez tant soit peu, vous le [le soleil] verrez désembarrassé de ce nuage, et luire aussi clair et net qu'il était auparavant"
                            },
                            {
                                "example_id": "7c61b1fb-29b6-444a-8518-9d5681544b69",
                                "sense_id": "7e87c01c-2445-36db-9802-5d5c19ff66d7",
                                "text": "Un esprit sans corps et désembarrassé de la matière n'agirait pas d'une autre façon"
                            },
                            {
                                "example_id": "3d6c968c-49c2-4ca3-a5a7-d56d852cd85f",
                                "sense_id": "7e87c01c-2445-36db-9802-5d5c19ff66d7",
                                "text": "Sitôt que je serai désembarrassé de visites importunes, je ne perdrai pas un moment"
                            }
                        ]
                    }
                ],
