                                "target_senses": [
                                    {
                                        "sense_id": "ff953970-8d96-3212-8e06-90e96f490aa8",
                                        "entry_id": "ed16e003-1fcb-336a-8907-e160532f3b68",
                                        "glosses": [
                                            "Großstadt in Arizona, USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46487fe9-5a47-4859-92da-ea4021626c58",
                                                "sense_id": "ff953970-8d96-3212-8e06-90e96f490aa8",
                                                "text": "„Driver verfrachteten sie zu Pflegeeltern nach Tucson.“"
                                            },
                                            {
                                                "example_id": "cd509037-9ee8-4bfb-baee-33652df690ab",
                                                "sense_id": "ff953970-8d96-3212-8e06-90e96f490aa8",
                                                "text": "„Der Täter hieß Robert John Bardo, ein arbeitsloser Neunzehnjähriger aus Tucson in Arizona, der zuletzt als Hausmeister in einem Imbiss gearbeitet hatte.“"
                                            },
                                            {
                                                "example_id": "c5f1805b-dac8-4812-a019-a47a63a7dcd9",
                                                "sense_id": "ff953970-8d96-3212-8e06-90e96f490aa8",
                                                "text": "„Am Vorabend hatte er sich in einem Hotel im Norden von Tucson das Gesicht glatt rasieren und die braunen Haare kurz schneiden und weißblond färben lassen.“"
                                            },
                                            {
                                                "example_id": "ce292127-7e0e-47c7-aa5a-a5992b3bbde5",
                                                "sense_id": "ff953970-8d96-3212-8e06-90e96f490aa8",
                                                "text": "„Nachdem die Gamboas abgeholt waren und ihn Gray Man aus dem versifften Bad befreit hatte, schloss Jerry Pfleger die Vorbereitungen mit weiteren Anrufen nach Nogales und Tucson ab und überredete alle Beteiligten mit großzügigen Versprechen zur Zusammenarbeit.“"
                                            },
                                            {
                                                "example_id": "1dc13497-45fd-4a14-98e4-7d058b58c55b",
                                                "sense_id": "ff953970-8d96-3212-8e06-90e96f490aa8",
                                                "text": "„In Tucson angekommen, hatte er sämtliche Münzen bis auf zwei Handvoll verkauft, und er checkte im Arizoan Inn ein, schaffte sämtliches Geld ins Zimmer, stapelte es auf der Kommode, teilte den Stapel nach Augenmaß in zwei gleich große Stapel, legte sie jeweils in eine leere Werkzeugtasche und schnallte die Riemen fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
