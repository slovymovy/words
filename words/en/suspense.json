{
    "word_family": [
        "suspend",
        "suspension",
        "suspensive",
        "suspenseful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a150fdfc-ea35-3fe7-8cc0-eea88baaeefa",
                    "sense_definition": "A feeling of excited or anxious uncertainty about what may happen, especially in a narrative work.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie built up the <w>suspense</w> so effectively that nobody in the cinema made a sound."
                        },
                        {
                            "text": "Don't keep me in <w>suspense</w>, tell me who won the competition!"
                        }
                    ],
                    "synonyms": [
                        "anticipation",
                        "tension"
                    ],
                    "common_phrases": [
                        "keep in suspense",
                        "build suspense"
                    ]
                },
                {
                    "sense_id": "16ad565e-1e64-3c90-8568-3feeff639628",
                    "sense_definition": "An unpleasant feeling of anxiety, apprehension, or indecision in an uncertain situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waiting for the medical test results kept the entire family in painful <w>suspense</w> for days."
                        },
                        {
                            "text": "She could not bear the terrible <w>suspense</w> of not knowing whether her application had been accepted."
                        }
                    ],
                    "synonyms": [
                        "anxiety",
                        "uncertainty",
                        "apprehension"
                    ],
                    "antonyms": [
                        "certainty"
                    ],
                    "common_phrases": [
                        "terrible suspense",
                        "prolong the suspense"
                    ]
                },
                {
                    "sense_id": "61e7d0b5-5a77-3bb1-9deb-ce079a577192",
                    "sense_definition": "A state of temporary cessation, pause, or delay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conflict came to a temporary <w>suspense</w> as both sides gathered to negotiate terms."
                        },
                        {
                            "text": "During the long winter, there was a quiet <w>suspense</w> of all regular construction work."
                        }
                    ],
                    "synonyms": [
                        "suspension",
                        "cessation",
                        "abeyance"
                    ],
                    "antonyms": [
                        "continuation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English compared to 'suspension'"
                        }
                    ]
                },
                {
                    "sense_id": "38f6fac0-af10-35c8-a645-b612cbe9118c",
                    "sense_definition": "The temporary cessation or extinguishment of a legal right or profit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under property law, the unity of possession caused a total <w>suspense</w> of the rent claim."
                        },
                        {
                            "text": "The debtor argued that there was a legal <w>suspense</w> of the creditor's enforcement rights."
                        }
                    ],
                    "synonyms": [
                        "suspension",
                        "abeyance"
                    ]
                },
                {
                    "sense_id": "386e27c2-7b95-3de8-85dc-40063ebe97de",
                    "sense_definition": "A deadline or specified completion date.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager assigned the report with a strict <w>suspense</w> of Friday afternoon."
                        },
                        {
                            "text": "Ensure that all documentation is submitted before the designated <w>suspense</w> expires."
                        }
                    ],
                    "synonyms": [
                        "deadline"
                    ],
                    "common_phrases": [
                        "suspense date"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73aaee35-2eeb-31a5-b909-714b1bad64ae",
                    "sense_definition": "Expressing, or proceeding from, suspense or uncertainty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He waited in silence with a <w>suspense</w> gaze fixed upon the courtroom doors."
                        },
                        {
                            "text": "The crowd held a <w>suspense</w> breath as the diver prepared to take the leap."
                        }
                    ],
                    "synonyms": [
                        "doubtful",
                        "hesitant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
