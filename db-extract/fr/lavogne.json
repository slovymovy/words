                "senses": [
                    {
                        "sense_id": "71a38776-dbe2-3c3a-8471-7aec0e63b5f6",
                        "entry_id": "5573511f-5163-363b-98f2-39583c78b66e",
                        "glosses": [
                            "Mare formée au fond d’une dépression naturelle (doline) ou aménagée, dans un causse, où les animaux d’élevage peuvent s’abreuver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "781d0501-91c7-40a9-9123-1d02573f242d",
                                "sense_id": "71a38776-dbe2-3c3a-8471-7aec0e63b5f6",
                                "text": "Lorsque la neige et la pluie ont été rares en hiver et au printemps, lorsque l’été a été sec, la citerne pour l’homme, la lavogne pour les bestiaux, se dessèchent, le Caussenard doit alors aller chercher au loin l’eau indispensable à sa famille et à ses bestiaux."
                            },
                            {
                                "example_id": "3d76293d-0733-4191-8126-76e15f53ed7f",
                                "sense_id": "71a38776-dbe2-3c3a-8471-7aec0e63b5f6",
                                "text": "Ma compagne pense à installer un élevage de volailles derrière, entre les pierrades et la lavogne, des volailles de plein air."
                            },
                            {
                                "example_id": "08101e09-0e9e-4004-b495-8165c312f5eb",
                                "sense_id": "71a38776-dbe2-3c3a-8471-7aec0e63b5f6",
                                "text": "En route pour ces paysages de forêts de pins et de chênes, de champs vert anis ou jaune doré selon les saisons, de lavognes, ces mares de forme ronde aménagées par l’homme où l’eau de pluie stockée sert à abreuver les troupeaux, et de buissières, ces sentiers creusés dans les buis pour se protéger du soleil."
                            }
                        ]
                    }
