                ],
                "senses": [
                    {
                        "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                        "entry_id": "fe7f7dc0-d85f-3434-b731-b3b304e8c74a",
                        "glosses": [
                            "grundlegende Umstellung der Straßen-, Flug-, Schiffs- und Schienenverkehre so, dass diese (nahezu) emissionsfrei werden"
                        ],
                        "tags": [
                            "Logistik",
                            "Umwelt",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "245353bc-3fb6-4628-97e9-49ed1fa297d9",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„Und genau das ist ein zentrales Ziel der Mobilitätswende. Der Verkehrssektor soll bis 2030 nur noch halb so viel CO₂ ausstoßen wie heute.“"
                            },
                            {
                                "example_id": "8a4a2cab-e951-4852-b8d9-4861a71172ec",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„»Was wir Mobilitätswende nennen, ist die Vermeidung, Verlagerung und Verbesserung von Verkehr.«“"
                            },
                            {
                                "example_id": "1196f25c-11f8-4d15-a57b-7637331b53f6",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„Technologien allein werden's nicht richten: Um das 1,5-Grad-Ziel zu erreichen, braucht es grundlegende Veränderungen unseres Verhaltens. Eine Energiewende, aber auch eine Mobilitätswende und eine Ernährungswende, erläutert Prof. Anita Engels von der Universität Hamburg.“"
                            },
                            {
                                "example_id": "aec999b3-2a3f-445a-bbf8-24006da80b25",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„Bei der Mobilitätswende auf dem Land geht es vor allem darum, vom privaten Pkw wegzukommen.“"
                            },
                            {
                                "example_id": "021b0683-434d-46df-9ee5-a827f0791e19",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„Eine Mobilitätswende hin zu sauberen Antriebsformen ist nach Einschätzung von Experten für das Erreichen der internationalen Klimaziele von entscheidender Bedeutung.“"
                            },
                            {
                                "example_id": "eb795f72-aba3-4f46-9d12-354b3a0c3669",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "Eine Maßnahme der Mobilitätswende ist vollkommen klar: Tschüss, Verbrenner!"
                            },
                            {
                                "example_id": "3e65d747-4a85-470e-be57-c5c884e9870b",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "Bei ca. 47,5 Millionen Verbrennern auf Deutschlands Straßen in 2022 sind wir von einer echten Mobilitätswende meilenweit entfernt."
                            },
                            {
                                "example_id": "3db0e507-2326-4d6b-a24c-34357877d0f7",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„Außerdem macht sich \"Fridays for Future\" für die Mobilitätswende stark und fordert einen sofortigen Neu- und Ausbaustopp für alle Autobahnen und Bundesstraßen.“"
                            },
                            {
                                "example_id": "6fa75ad8-7737-46a3-a740-f1d15fd00946",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "Das Tempo der Mobilitätswende ist einfach zu langsam."
                            },
                            {
                                "example_id": "cfa61515-3b47-405c-b618-13e7b023e5f4",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„Öffentliche Verkehrsmittel statt Individualverkehr: Fachleute und Politiker sprechen sich schon seit vielen Jahren für eine Mobilitätswende aus.“"
                            },
                            {
                                "example_id": "9a16993c-0084-4943-a0b0-8bf912a73087",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„»Die Politik in Berlin unterschätzt, dass eine Mobilitätswende eine gewisse Geschwindigkeit braucht. Man muss Ergebnisse sehen.«“"
                            },
                            {
                                "example_id": "6d76e774-9218-4856-9a83-2eda739931f9",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "[Schlagzeile:] „Radschnellwege: Hamburgs langer Weg zur Mobilitätswende“"
                            },
                            {
                                "example_id": "6dac0aa5-4c80-4216-960a-e4532452e1e0",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "[Schienenverkehr:] „Für eine ernstgemeinte Mobilitätswende braucht es mehr Personal.“"
                            },
                            {
                                "example_id": "61c678e6-20b2-4dba-b3af-3fd2b8da05a2",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„»Wir werden nicht drumherum kommen, dass die Mobilitätswende uns sehr viel Geld kosten wird,«“ […]."
                            },
                            {
                                "example_id": "16da1347-4852-446e-83b3-2b52dd012ef1",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "[Das Konzept S-Bahn 2.0] „umfasst zur Mobilitätswende eine Ausweitung des Fahrplantaktes und die (Wieder-)Inbetriebnahme verschiedener Strecken.“"
                            },
                            {
                                "example_id": "2d80a7ca-d4a1-4a9b-8719-e91a03d607e7",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "„Woher kommen die Rohstoffe für die Mobilitätswende?“"
                            },
                            {
                                "example_id": "96c18a9b-a14a-434d-af1d-e29b2ef1b888",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "74,4 km neue Bahnstrecken in 2022 sind ein nur ein sehr kleiner Beitrag zur Mobilitätswende in Deutschland."
                            },
                            {
                                "example_id": "187f9bbb-dcac-4ca8-aab2-3ccbe1c5f4a0",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "Der Flugverkehr wird bei Maßnahmen zur Mobilitätswende praktisch ignoriert."
                            },
                            {
                                "example_id": "c58cf06b-95a5-4d1b-8d6f-61a7bacd923d",
                                "sense_id": "656bd5fc-dc2b-31ff-ba0c-a7792b1027ab",
                                "text": "Beim internationalen Warenverkehr mit dreckigsten Containerschiffen gibt es keine Mobilitätswende."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
