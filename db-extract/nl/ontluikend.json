                                        "entry_id": "9d2536af-4e93-326b-bc75-14073e009464",
                                        "glosses": [
                                            "Beginning to develop."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f49985-e306-4d30-b074-1c71bbca394b",
                                                "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                                                "text": "He's a budding deejay."
                                            },
                                            {
                                                "example_id": "a06fd780-f35d-414d-a374-289a94e2e24c",
                                                "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                                                "text": "The most surprising thing was to discover that each job had its little tricks, peculiarities that had been learned in the experience of years, and one of the really pleasing features was the unlimited patience and kindliness of the chargehands and fitters, who would go to great lengths to teach the budding engineer all they themselves knew."
                                            },
                                            {
                                                "example_id": "eb9a734a-3be5-43aa-9ad4-3594f7f57af0",
                                                "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                                                "text": "Council's tip shops in Acacia Ridge and Geebung are treasure troves for everyone from budding home stylists to outdoor enthusiasts."
                                            }
                                        ]
                                    }
                                ]
                            },
