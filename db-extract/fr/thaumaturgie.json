                                "example_id": "25dab88d-6c47-496c-a830-c4dd72f3c461",
                                "sense_id": "f4dd3be6-abf2-3251-bcff-9dda512aa965",
                                "text": "Mr Merritt a toujours reconnu n’avoir rien vu de vraiment horrible à la ferme de Pawtuxet Road, mais il a déclaré que les titres des volumes traitant de thaumaturgie, d’alchimie et de théologie, avaient suffi à lui inspirer une véritable répulsion."
                            },
                            {
                                "example_id": "7844e240-409c-414f-892c-bfe457dfaaab",
                                "sense_id": "f4dd3be6-abf2-3251-bcff-9dda512aa965",
                                "text": "La thaumaturgie tenait une grande place dans les doctrines d’Apollonius de Tyane."
                            }
                        ]
