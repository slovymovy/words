                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4149e8d8-52e7-4409-8cda-b3a87a4b7857",
                                "sense_id": "34b2f4b4-41c1-3e91-a545-af06379e6b0d",
                                "text": "„Die Gründung von Neubrandenburg am 4. Januar 1248 durch Markgraf Johann I. von Brandenburg und die bald nach der Jahrhundertmitte erfolgte Ansiedlung des Franziskanerordens deuten auf eine besondere Bestimmung des Ortes unter den askanischen Markgrafen hin.“"
                            },
                            {
                                "example_id": "dd8444e7-f783-4ce2-bb85-98439601b633",
                                "sense_id": "34b2f4b4-41c1-3e91-a545-af06379e6b0d",
                                "text": "„Nach der Gründung der Stadt blieben die Bürger Neubrandenburgs für knapp sechs Jahre abgabenfrei und hatten verschiedene andere Vergünstigungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
