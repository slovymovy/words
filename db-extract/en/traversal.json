                                    {
                                        "sense_id": "bf8de148-3044-33d3-b8fb-14d4b5b6f991",
                                        "entry_id": "b1caa9b4-1ccd-3c50-b414-8f1501116085",
                                        "glosses": [
                                            "Fortbewegung/Weg quer durch/über ein Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdec402-c943-4cf5-b36f-763f741d400b",
                                                "sense_id": "bf8de148-3044-33d3-b8fb-14d4b5b6f991",
                                                "text": "„Doch die Querung der Sahara ist nur der Prolog zu den Strapazen, denen die Expedition in den fruchtbareren Regionen südlich der großen Wüste ausgesetzt sein wird, wo Barth endlich auf Pferden reisen kann.“"
                                            }
                                        ],
