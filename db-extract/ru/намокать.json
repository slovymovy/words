                ],
                "senses": [
                    {
                        "sense_id": "f605c5f1-3da3-34fb-844a-f68a8e5fd786",
                        "entry_id": "c7b7bfd6-12b7-3f10-a7df-f32decbdbd07",
                        "glosses": [
                            "пропитываться или покрываться водой, влагой, становиться мокрым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b52af21-4296-4456-b016-dbca61e24081",
                                "sense_id": "f605c5f1-3da3-34fb-844a-f68a8e5fd786",
                                "text": "Во время дождя порох намокал и не загорался от искр."
                            },
                            {
                                "example_id": "ab176635-b0ad-41c2-b318-f2784a3b447a",
                                "sense_id": "f605c5f1-3da3-34fb-844a-f68a8e5fd786",
                                "text": "А у этого, когда он поплачет, только краснел его носик да намокал платочек."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b8dd1a8-9013-4d92-8e19-b41f373ae2ad",
                        "source_entry_id": "c7b7bfd6-12b7-3f10-a7df-f32decbdbd07",
                        "source_sense_id": "f605c5f1-3da3-34fb-844a-f68a8e5fd786",
                        "target_lang_word": "empapar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empapar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "406bf2f2-fb8a-38cf-a574-cbbfbedaaa57",
                                        "entry_id": "d5f7a768-98b2-3b94-9b60-f1924a91c55c",
                                        "glosses": [
                                            "Impregnar bien de líquido algo; ponerlo mojado; saturarlo de líquido."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd1d693-c478-4b69-b6e1-46b84a789c86",
                                                "sense_id": "406bf2f2-fb8a-38cf-a574-cbbfbedaaa57",
                                                "text": "Pero si se trata de una quemadura grave, hay que empapar en aceite una gasa esterilizada, y ponerla sobre la herida"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3bd6e47-53ad-3ac7-a72a-3e307f02505e",
                                        "entry_id": "d5f7a768-98b2-3b94-9b60-f1924a91c55c",
                                        "glosses": [
                                            "Referido a un líquido, penetrar, permear, impregnar o calar los poros de un cuerpo."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d014432-9977-499b-a9d2-73cfa7dab6ab",
                                                "sense_id": "f3bd6e47-53ad-3ac7-a72a-3e307f02505e",
                                                "text": "El agua gélida del Wila la empapó, penetró en su nariz y su sabor amargo le empapó la lengua"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae28a140-dff1-3162-9924-f2c1620b8393",
                                        "entry_id": "d5f7a768-98b2-3b94-9b60-f1924a91c55c",
                                        "glosses": [
                                            "Pasar un cuerpo esponjoso o poroso (como un paño) sobre un líquido para absorberlo o chuparlo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87228076-9501-4430-ace0-a13666098abc",
                                                "sense_id": "ae28a140-dff1-3162-9924-f2c1620b8393",
                                                "text": "Probablemente le ordenaron que limpiara, así que empapó el trapo donde estaba más húmedo, secó un poco por aquí y un poco por allá, con cara de pocos amigos"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "223f391e-5390-3b51-8a37-f3b4b07a2773",
                                        "entry_id": "d5f7a768-98b2-3b94-9b60-f1924a91c55c",
                                        "glosses": [
                                            "Referido a una idea u otra cosa inmaterial, llenar o penetrar algo, en particular una época, un estado mental, una percepción, etc."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41024ab5-685d-49e9-a00e-8e544a0577e8",
                                                "sense_id": "223f391e-5390-3b51-8a37-f3b4b07a2773",
                                                "text": "Este doble proceso difiere por completo de la atmósfera cultural y del clima socio-político que empapó las décadas de la mitad de este siglo"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
