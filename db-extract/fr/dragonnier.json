                                        "entry_id": "b129fb72-e5a2-350b-9818-a493434b2db0",
                                        "glosses": [
                                            "Any of several trees, of the genus Dracaena, having a thick trunk, sword-shaped leaves and orange fruit, especially Dracaena draco, of the Canary Islands – a source of dragon's blood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1f0923-913b-4392-bd6f-a8bbe30e88d0",
                                                "sense_id": "3fd8277b-e9b8-3535-904e-f68cd0abe4af",
                                                "text": "Another ancient vegetable relic surviving in Macaronesia is the legendary dragon tree, whose sap, marketed as dragon’s blood, was in past times much prized as a medicine, as incense and as a dye."
                                            }
                                        ]
                                    }
                                ]
                            }
