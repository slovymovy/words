                        "sense_id": "c61aec6c-0d21-3f34-bd58-5ac5709b6e0c",
                        "entry_id": "89fd1d4b-0dfa-37f0-a078-0b70fa786b55",
                        "glosses": [
                            "Affluent de la rivière Ohio."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
