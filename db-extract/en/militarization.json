                                        "entry_id": "adc177cb-91c3-3316-b2a5-9aea891fdda0",
                                        "glosses": [
                                            "etwas oder jemanden in den Dienst des Militarismus stellen"
                                        ],
                                        "tags": [
                                            "Gesellschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7cf3c75-5716-435a-bbd8-eb0e5c1f7751",
                                                "sense_id": "05110f3a-efcf-3fc9-8882-59a272f495b1",
                                                "text": "Seine geistige Militarisierung war mit dem Eintritt in die Armee auch körperlich geworden."
                                            },
                                            {
                                                "example_id": "6f6f741f-472d-4005-8c9e-aa02ef36e6f2",
                                                "sense_id": "05110f3a-efcf-3fc9-8882-59a272f495b1",
                                                "text": "„Im Prozess der Militarisierung weiter Bevölkerungsschichten im Kaiserreich kam den Kriegsvereinen eine bedeutende Rolle zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c00b65cf-267a-312f-b8c4-67cac2537e4e",
