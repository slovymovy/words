                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feae3749-3255-4f3d-82ab-367d60ec374a",
                                "sense_id": "3963f6fe-ef2c-3c78-8e10-ac4b1cf722e8",
                                "text": "Il paraît qu’il s’amusait à orphéoniser les périodes, à noter les nuances de voix de chaque orateur, et, à ses collègues, il se plaisait à dire malicieusement : « Je vous ai écouté. Vous avez parlé en fa mineur ! »"
                            },
                            {
                                "example_id": "ea95f4ca-0a5e-41ab-a63f-8a1f395868e0",
                                "sense_id": "3963f6fe-ef2c-3c78-8e10-ac4b1cf722e8",
                                "text": "«Orphéoniser la Nation» ou les politiques musicales de l’État Nouveau portugais dans les années 30/40."
                            }
                        ]
                    }
