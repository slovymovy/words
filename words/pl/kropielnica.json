    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0fcc852d-bb14-3ea5-9f33-b36b3f80e7f6",
                    "sense_definition": "naczynie na wodę święconą, umieszczane zazwyczaj przy wejściu do kościoła",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "paramenty_liturgiczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wchodząc do kościoła, wierni zanurzają dłoń w kamiennej <w>kropielnicy</w> i czynią znak krzyża.",
                            "target_lang_translations": {
                                "en": "Upon entering the church, the faithful dip their hands into the stone <w>holy water font</w> and make the sign of the cross."
                            }
                        },
                        {
                            "text": "Zanurzyłam rękę, ale w <w>kropielnicy</w> nie było wody.",
                            "target_lang_translations": {
                                "en": "I dipped my hand in, but there was no water in the <w>stoup</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aspersorium"
                    ],
                    "common_phrases": [
                        "kamienna kropielnica",
                        "woda w kropielnicy"
                    ],
                    "target_lang_definitions": {
                        "en": "a basin or receptacle for holy water, typically placed near the entrance of a church"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stoup",
                                "target_lang_sense_clarification": "holy water basin"
                            },
                            {
                                "target_lang_word": "holy water font",
                                "target_lang_sense_clarification": "basin at a church entrance"
                            },
                            {
                                "target_lang_word": "holy water stoup",
                                "target_lang_sense_clarification": "basin at a church entrance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfe3eeed-4889-346d-9cab-d7bcf3d5e7bc",
                    "sense_definition": "przenośne naczynie w kształcie kociołka z pałąkiem, używane do noszenia wody święconej podczas ceremonii liturgicznych",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "paramenty_liturgiczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ceremoniarz podał diakonowi <w>kropielnicę</w> i kropidło.",
                            "target_lang_translations": {
                                "en": "The master of ceremonies handed the <w>holy water bucket</w> and the aspergillum to the deacon."
                            }
                        },
                        {
                            "text": "Ministrant niósł mosiężną <w>kropielnicę</w> przed idącym w procesji kapłanem.",
                            "target_lang_translations": {
                                "en": "The altar server carried the brass <w>aspersorium</w> ahead of the priest walking in the procession."
                            }
                        }
                    ],
                    "synonyms": [
                        "aspersorium"
                    ],
                    "common_phrases": [
                        "przenośna kropielnica"
                    ],
                    "target_lang_definitions": {
                        "en": "a portable bucket-like vessel with a handle used to hold holy water during liturgical ceremonies"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aspersorium",
                                "target_lang_sense_clarification": "portable holy water bucket"
                            },
                            {
                                "target_lang_word": "holy water bucket",
                                "target_lang_sense_clarification": "portable liturgical vessel"
                            },
                            {
                                "target_lang_word": "vat",
                                "target_lang_sense_clarification": "portable holy water vessel"
                            }
                        ]
                    }
                }
            ]
        }
