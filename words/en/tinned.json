{
    "word_family": [
        "tin",
        "tinny",
        "tinner",
        "tinplate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b3f0a1e-2099-3fc6-a15f-8e414f18aead",
                    "sense_definition": "Preserved and packed into a metal can.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought several cans of <w>tinned</w> tomatoes to make soup.",
                            "target_lang_translations": {
                                "ru": "Она купила несколько банок <w>консервированных</w> помидоров, чтобы сварить суп."
                            }
                        },
                        {
                            "text": "During emergencies, people rely heavily on <w>tinned</w> food for sustenance.",
                            "target_lang_translations": {
                                "ru": "Во время чрезвычайных ситуаций люди сильно зависят от <w>консервированной</w> еды."
                            }
                        }
                    ],
                    "synonyms": [
                        "canned"
                    ],
                    "antonyms": [
                        "dried"
                    ],
                    "common_phrases": [
                        "tinned food",
                        "tinned tomatoes",
                        "tinned fruit",
                        "tinned fish"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законсервированный и упакованный в жестяную банку (о продуктах питания)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервированный",
                                "target_lang_sense_clarification": "о пищевых продуктах в банках"
                            },
                            {
                                "target_lang_word": "баночный",
                                "target_lang_sense_clarification": "расфасованный в жестяные банки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40fc7854-7621-359c-b052-5622416947b8",
                    "sense_definition": "Coated or plated with a thin layer of tin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electronics technician used <w>tinned</w> copper wire to prevent corrosion.",
                            "target_lang_translations": {
                                "ru": "Техник-электронщик использовал <w>лужёный</w> медный провод для предотвращения коррозии."
                            }
                        },
                        {
                            "text": "He repaired the old kitchen pot by applying a layer of <w>tinned</w> metal inside.",
                            "target_lang_translations": {
                                "ru": "Он починил старую кухонную кастрюлю, нанеся слой <w>лужёного</w> металла внутри."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tinned copper wire",
                        "tinned iron"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый тонким слоем олова; подвергнутый лужению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лужёный",
                                "target_lang_sense_clarification": "покрытый полудой или оловом"
                            },
                            {
                                "target_lang_word": "залуженный",
                                "target_lang_sense_clarification": "обработанный оловом"
                            },
                            {
                                "target_lang_word": "покрытый оловом",
                                "target_lang_sense_clarification": "имеющий оловянное покрытие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a77bf2c-8141-3c6b-80b2-361094cef7c5",
                    "sense_definition": "Previously prepared or formulaic rather than spontaneous, fresh, or original.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unoriginal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian relied on <w>tinned</w> jokes that the audience had already heard many times.",
                            "target_lang_translations": {
                                "ru": "Комик полагался на <w>заезженные</w> шутки, которые зрители слышали уже много раз."
                            }
                        },
                        {
                            "text": "Critics dismissed the speech because of its <w>tinned</w> phrases and lack of genuine feeling.",
                            "target_lang_translations": {
                                "ru": "Критики раскритиковали речь за её <w>шаблонные</w> фразы и отсутствие искренних чувств."
                            }
                        }
                    ],
                    "synonyms": [
                        "canned"
                    ],
                    "common_phrases": [
                        "tinned laughter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заготовленный заранее, шаблонный или записанный на пленку, не спонтанный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблонный",
                                "target_lang_sense_clarification": "избитый, неоригинальный"
                            },
                            {
                                "target_lang_word": "записанный на плёнку",
                                "target_lang_sense_clarification": "фонограммный, например о смехе"
                            },
                            {
                                "target_lang_word": "дежурный",
                                "target_lang_sense_clarification": "заготовленный заранее, стандартный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "003bbf47-25e7-3faa-a589-f3814bd06b3f",
                    "sense_definition": "simple past and past participle of <w>tin</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>tinned</w> the surplus peaches so they would last throughout the long winter.",
                            "target_lang_translations": {
                                "ru": "Они <w>законсервировали</w> излишки персиков, чтобы их хватило на всю долгую зиму."
                            }
                        },
                        {
                            "text": "The metalworker carefully <w>tinned</w> the tip of the soldering iron before starting the repair.",
                            "target_lang_translations": {
                                "ru": "Мастер по металлу тщательно <w>залудил</w> жало паяльника перед началом ремонта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастия прошедшего времени глагола tin (консервировать; лудить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервировал",
                                "target_lang_sense_clarification": "закатывал в жестяные банки"
                            },
                            {
                                "target_lang_word": "лудил",
                                "target_lang_sense_clarification": "покрывал оловом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}