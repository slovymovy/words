                "senses": [
                    {
                        "sense_id": "08ee33df-6baf-3500-a344-4a5fd6e9d9e1",
                        "entry_id": "4a5962a7-83e9-300e-8e71-a0cf725c03e6",
                        "glosses": [
                            "Usage régulier d’au moins deux substances psychoactives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7689c674-0e6f-4b7b-a199-96bad02d8e31",
                                "sense_id": "08ee33df-6baf-3500-a344-4a5fd6e9d9e1",
                                "text": "Le polyusage est un phénomène observé assez massivement dans les espaces dédiés aux usagers de drogues (centres de soins, structures d’accueil…) et rapporté."
                            },
                            {
                                "example_id": "cf332b7f-cba2-4a67-868b-4d3b032dc526",
                                "sense_id": "08ee33df-6baf-3500-a344-4a5fd6e9d9e1",
                                "text": "Notamment, une bonne connaissance de la prise en charge de la douleur chronique et des risques de dépendance aux opiacés est requise pour prévenir les polyusages comprenant des opioïdes."
                            },
                            {
                                "example_id": "a033695e-ad24-4a5a-844c-01a182363ebb",
                                "sense_id": "08ee33df-6baf-3500-a344-4a5fd6e9d9e1",
                                "text": "La polyconsommation ou polyusage est, dans sa définition la plus simple, la consommation de 2 substances psychoactives (SPA) au moins, sans préjuger de l’existence ou non d’un mésusage."
                            }
                        ]
                    }
                ],
