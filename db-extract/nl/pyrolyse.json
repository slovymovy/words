                                "target_senses": [
                                    {
                                        "sense_id": "c0f04c10-c66a-39e6-af32-d83f87d05357",
                                        "entry_id": "810c78ca-65a1-3b9a-bbdf-e3e7db925a85",
                                        "glosses": [
                                            "Décomposition sans flamme d’un corps organique par la chaleur pour obtenir d'autres produits qu’il ne contenait pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629e2c5f-bf6f-418b-abc3-aa7bf59af21b",
                                                "sense_id": "c0f04c10-c66a-39e6-af32-d83f87d05357",
                                                "text": "Le biochar, charbon produit par pyrolyse et utilisé comme amendement, présente plusieurs avantages et s’avère une avenue prometteuse pour une agriculture durable."
                                            },
                                            {
                                                "example_id": "c2944ada-73bf-4233-8b05-e7109437c51a",
                                                "sense_id": "c0f04c10-c66a-39e6-af32-d83f87d05357",
                                                "text": "« La pyrolyse ne donne pas seulement du biochar, mais aussi un gaz de synthèse qui a l’avantage d’être renouvelable et potentiellement à faible empreinte carbone », indique Claire Chastrusse, directrice générale de cette société créée en 2021."
                                            }
                                        ]
                                    }
                                ]
