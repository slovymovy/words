                            "что"
                        ],
                        "examples": [
                            {
                                "example_id": "948c1736-a445-4810-bf29-42cf4b3dbcbf",
                                "sense_id": "336d3194-988a-3c00-8597-638166e33b97",
                                "text": "…Крестьяне получили возможность обработать трудно обрабатываемые в условиях индивидуального труда заброшенные земли и целину."
                            },
