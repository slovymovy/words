                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ecfefd-1b03-49dc-a282-b3494eec98bf",
                                "sense_id": "6627626c-1f0c-32d8-aa38-8eaae160b1b1",
                                "text": "Die Frau hat den Schrank geöffnet und hält uns ein Probierstück hin."
                            },
                            {
                                "example_id": "7db11865-f261-4c10-ac1f-4125e87106f0",
                                "sense_id": "6627626c-1f0c-32d8-aa38-8eaae160b1b1",
                                "text": "„Es waren Öffnungsversuche, Probierstücke, um die Partei auf Trab zu bringen.“"
                            },
                            {
                                "example_id": "d5fddebb-39f1-41ef-b8bc-f214dd77a551",
                                "sense_id": "6627626c-1f0c-32d8-aa38-8eaae160b1b1",
                                "text": "„Für solche Probierstücke wird es in Strombergs Theater die geeigneten Räume und Anlässe geben - nicht zuletzt dank eines gastronomischen Konzepts, in dem sich am augenfälligsten die Öffnung zur Stadt manifestiert.“"
                            }
                        ],
