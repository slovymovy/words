            "senses": [
                {
                    "sense_id": "79a80db1-6068-392b-acc4-e9475bb7663d",
                    "sense_definition": "present participle and gerund of <w>detour</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>detouring</w> through the countryside to avoid the heavy traffic on the highway.",
                            "target_lang_translations": {
                                "zh": "为了避开高速公路上的拥堵，我们正从乡村公路<w>绕道</w>而行。"
                            }
                        },
                        {
                            "text": "The pilot was <w>detouring</w> around the severe storm to ensure a safe flight.",
                            "target_lang_translations": {
                                "zh": "飞行员正<w>绕开</w>强风暴飞行以确保航行安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diverting",
                        "bypassing"
                    ],
                    "common_phrases": [
                        "detouring around",
                        "detouring through"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "detour的现在分词和动名词形式，指绕道、绕行"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绕道",
                                "target_lang_sense_clarification": "选择另一条迂回的路线行驶或行走"
                            },
                            {
                                "target_lang_word": "绕行",
                                "target_lang_sense_clarification": "避开障碍物或拥堵而绕路行走"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9130cf6d-5338-3c9c-ba55-495ede090ec2",
                    "sense_definition": "The act of taking a detour or indirect route.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After several unexpected <w>detourings</w> along the mountain path, they finally found the village.",
                            "target_lang_translations": {
                                "zh": "在山路上经历了几次意想不到的<w>绕道</w>后，他们终于找到了那个村庄。"
                            }
                        },
                        {
                            "text": "The repeated <w>detouring</w> delayed our arrival by more than two hours.",
                            "target_lang_translations": {
                                "zh": "接连不断的<w>绕行</w>使我们延误了两个多小时才到达。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deviation",
                        "diversion"
                    ],
                    "target_lang_definitions": {
                        "zh": "绕道、迂回的行为或过程"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绕道",
                                "target_lang_sense_clarification": "走迂回路线的行为"
                            },
                            {
                                "target_lang_word": "绕行",
                                "target_lang_sense_clarification": "绕开原本路线的行为"
                            },
                            {
                                "target_lang_word": "迂回",
                                "target_lang_sense_clarification": "绕远路的过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
