                            }
                        },
                        {
                            "text": "Zgubiłem portfel, w którym miałem wszystkie ważne <w>dokumenty</w> tożsamości.",
                            "target_lang_translations": {
                                "ru": "Я потерял кошелёк, в котором лежали все важные <w>документы</w>, удостоверяющие личность."
                            }
