                    {
                        "translation_id": "a0b0b907-c76f-44ca-b63b-3859eac76f0c",
                        "source_entry_id": "66a1d890-caa1-3bd7-94b0-ea21b078b12e",
                        "source_sense_id": "9b4615d5-853b-307b-9866-7415fb9265fa",
                        "source_sense_description": "create anew",
                        "target_lang_word": "recréer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recréer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "affd527e-c511-3577-8b20-90e7fe8851df",
                                        "entry_id": "7b9b4653-1728-3682-9f16-d64ab48f1f9d",
                                        "glosses": [
                                            "Donner une nouvelle existence, remettre sur pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49abaae9-2902-4d6b-b92d-b8b1aa776abb",
                                                "sense_id": "affd527e-c511-3577-8b20-90e7fe8851df",
                                                "text": "Ces faits, on les collectionne, on les interroge, on les classe, on les recrée même expérimentalement pour dégager les lois qui les régissent."
                                            },
                                            {
                                                "example_id": "38445e25-da8a-4e32-b3f4-dbb77a77d0c9",
                                                "sense_id": "affd527e-c511-3577-8b20-90e7fe8851df",
                                                "text": "Dans un silence épaissi par l’intérêt recréé, je fais basculer le coffret désigné, et quelque trois kilos de cailloux se répandent avec fracas au fond de la vitrine."
                                            },
                                            {
                                                "example_id": "4177fd46-be5a-4293-854e-57f29517b1a3",
                                                "sense_id": "affd527e-c511-3577-8b20-90e7fe8851df",
                                                "text": "Dans un cas, le sujet désendosse en quelque sorte sa personnalité : il se démet de toute intimité pour mieux se recréer, à savoir se configurer et se raconter au travers de modèles-types ou de formes-schèmes de récits romanesques on ne peut plus distinct du genre autobiographique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1218e014-9b8a-3c64-88cf-2c55b4c86f7f",
                                        "entry_id": "7b9b4653-1728-3682-9f16-d64ab48f1f9d",
                                        "glosses": [
                                            "Reconstituer (une atmosphère, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739cc70e-fc41-43e8-8fd5-2812baff31ff",
                                                "sense_id": "1218e014-9b8a-3c64-88cf-2c55b4c86f7f",
                                                "text": "Dans sa tente de l’Arabian nights de Lusail — où est recréée l’atmosphère d’un campement dans le désert — Didier Grande est aux anges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
