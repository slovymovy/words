                "senses": [
                    {
                        "sense_id": "0e20ff9b-b60c-307d-ac46-1eb242b93a3d",
                        "entry_id": "fa12b390-29af-3eaf-beda-8534d7b86172",
                        "glosses": [
                            "synonym of znak diakrytyczny (“diacritical mark”) (symbol)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8d2bd639-5cd3-47e1-b630-013e77aef642",
                                "sense_id": "0e20ff9b-b60c-307d-ac46-1eb242b93a3d",
                                "text": "W wypadku Matti Hautamäki i Gerhard Schröder, to wątpliwości nie ma, że należy używać germańskich diakrytów, bo te nazwiska występują w takiej pisowni.",
                                "translation": "In the case of Matti Hautamäki and Gerhard Schröder, there is no doubt, that Germanic diacritics have to be used, as the surnames exists in this spelling.",
                                "english": "In the case of Matti Hautamäki and Gerhard Schröder, there is no doubt, that Germanic diacritics have to be used, as the surnames exists in this spelling."
                            },
                            {
                                "example_id": "38effaa2-189d-4298-a194-6e7b6f21fc1c",
                                "sense_id": "0e20ff9b-b60c-307d-ac46-1eb242b93a3d",
                                "text": "Przerzucił kilka kartek. Ani znaki akcentuacyjne, ani inne francuskie diakryty i abrewiatury nigdzie nie były dopisane ręcznie.",
                                "translation": "He flipped a few pages. Neither accentuation marks, nor other French diacritics and abbreviations were manually written anywhere.",
                                "english": "He flipped a few pages. Neither accentuation marks, nor other French diacritics and abbreviations were manually written anywhere."
                            }
                        ]
                    }
                ],
