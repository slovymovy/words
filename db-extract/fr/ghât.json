                "senses": [
                    {
                        "sense_id": "4df99dbf-4730-3a84-afb2-0a6cccb91c71",
                        "entry_id": "01490ecd-6e06-38d0-b33a-b4b26b6ffe53",
                        "glosses": [
                            "En Inde, escalier qui descend dans le Gange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad493ec-8cdd-4232-9e4a-8acc39808438",
                                "sense_id": "4df99dbf-4730-3a84-afb2-0a6cccb91c71",
                                "text": "Sur le ghat (marche, degré) de Kon Hara, au bord du Gange et de la Gandak, c’est ce miracle que viennent célébrer chaque année les dizaines de milliers de pèlerins du Mela, en même temps qu’ils se purifient. Et l’on comprend mieux pourquoi, à Sonepur, l’éléphant victorieux est infiniment plus à sa place qu’aucun autre animal."
                            },
                            {
                                "example_id": "624f593c-9648-43d4-81d4-602070e25b63",
                                "sense_id": "4df99dbf-4730-3a84-afb2-0a6cccb91c71",
                                "text": "L’un des procédés les plus courants consistait à ce qu’un homme guette autour du ghât d’un village hostile et tue la première femme ou le premier enfant venant y puiser de l’eau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38fb0fa4-0bb9-4897-917e-9a43a61f0dbf",
                        "source_entry_id": "01490ecd-6e06-38d0-b33a-b4b26b6ffe53",
                        "source_sense_id": "4df99dbf-4730-3a84-afb2-0a6cccb91c71",
                        "target_lang_word": "Ghat",
