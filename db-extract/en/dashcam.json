                        "source_entry_id": "1f8b42d1-210a-38c5-9140-ceeade72e6cc",
                        "source_sense_id": "a167824c-bc71-31fe-a6ec-f1259ea18ab8",
                        "source_sense_description": "digital video recorder mounted on the dashboard of a vehicle or elsewhere inside the vehicle",
                        "target_lang_word": "dashcam",
                        "target_lang_code": "nl",
