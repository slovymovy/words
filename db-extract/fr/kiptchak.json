                                    {
                                        "sense_id": "277b1d25-b864-35ca-a977-f933f316c5d3",
                                        "entry_id": "c926dbed-d51e-3aef-94c1-9d50c378e2bc",
                                        "glosses": [
                                            "The lands of the Kipchak people"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12a4ebe7-b44a-4c1e-9855-e4e8d3c85944",
                                                "sense_id": "277b1d25-b864-35ca-a977-f933f316c5d3",
                                                "text": "Seljouk was the prime minister of Sultân Bighoû, sovereign of Kipjak; he established himself, with his tribe, in the countries of Samarcand and Bokhara, where they became converted to the religion of Islâm."
