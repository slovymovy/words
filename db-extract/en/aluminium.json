                    {
                        "translation_id": "086e07f7-6066-4c57-a741-ee773469c519",
                        "source_entry_id": "5dcd5855-e3ef-3db1-98ea-4aeafecebbdb",
                        "source_sense_description": "silvery metal",
                        "target_lang_word": "aluminium",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aluminium",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d067f7e6-381e-3f53-b924-7fc28d7c3eea",
                                        "entry_id": "b4eaa5bb-6b84-37f4-b4ac-7e14373fc8b4",
                                        "glosses": [
                                            "scheikundig element met symbool Al en atoomnummer 13. Het is een zilverwit hoofdgroepmetaal"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1d2799-4dd6-4c81-92ed-15f4686f093e",
                                                "sense_id": "d067f7e6-381e-3f53-b924-7fc28d7c3eea",
                                                "text": "De vervaardiging van aluminium, dat veel in bierblikjes toegepast wordt, kost erg veel energie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aluminium",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0fea53c6-48cf-3e39-8dda-16b0554fc021",
                                        "entry_id": "e3551f3d-3645-3787-912e-7eff8f687728",
                                        "glosses": [
                                            "van aluminium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee10045e-4112-43d2-8a00-5ad2ec5eef11",
                                                "sense_id": "0fea53c6-48cf-3e39-8dda-16b0554fc021",
                                                "text": "De lamp, die aan een lang snoer van het plafond bungelde had een platte aluminium kap en hing zo belachelijk laag dat hij alleen de handen en onderarmen zag die op tafel rustten, maar misschien herkende hij ze."
                                            },
                                            {
                                                "example_id": "6b49ec7b-54b0-4cd5-ac4b-4faaba3bc006",
                                                "sense_id": "0fea53c6-48cf-3e39-8dda-16b0554fc021",
                                                "text": "Hij kwam een halfuur later naar me toe, toen ik in het minuscule en rommelige keukentje de lege aluminium borden stond te stapelen en enige orde probeerde aan te brengen in de vrijgezellenchaos van Sam en Patrick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4955e471-d7a0-4f7c-a90f-a402a6cd979a",
                        "source_entry_id": "5dcd5855-e3ef-3db1-98ea-4aeafecebbdb",
                        "source_sense_description": "silvery metal",
                        "target_lang_word": "aluminium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aluminium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff164323-9041-3040-a9ea-d62bdfe44e39",
                                        "entry_id": "7d715ce0-6438-3f79-b0a2-e92b233435d7",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 13 et de symbole Al qui fait partie des métaux pauvres. Sa forme ionique en solution est le Al³⁺ (ou Al⁺⁺⁺) majoritairement."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22306cc-9566-4843-894c-e38e11207270",
                                                "sense_id": "ff164323-9041-3040-a9ea-d62bdfe44e39",
                                                "text": "Tout l’aluminium présent sur Terre et dans le système solaire est exclusivement du ²⁷Al."
                                            },
                                            {
                                                "example_id": "8b64177f-da08-478a-9725-07b5d5b660a7",
                                                "sense_id": "ff164323-9041-3040-a9ea-d62bdfe44e39",
                                                "text": "La difference avec l’iode, c’est que l’aluminium est un élement abondant dans l’Univers, et surtout dans les planètes."
                                            },
                                            {
                                                "example_id": "c36ae0f3-6632-4046-b0da-595e28f3d69b",
                                                "sense_id": "ff164323-9041-3040-a9ea-d62bdfe44e39",
                                                "text": "Le silicium et l’aluminium sont omniprésents dans la croûte terrestre (on parle de la couche Si-Al). En combinaison avec d’autres éléments, métalliques en particulier, ils réalisent des édifices chimiques en plaquettes, l'argile."
                                            },
                                            {
                                                "example_id": "bd661587-c29c-49f2-9b8d-f6e6d0f87645",
                                                "sense_id": "ff164323-9041-3040-a9ea-d62bdfe44e39",
                                                "text": "Malgré son hégémonie en microélectronique, il y a des domaines où le silicium doit s’incliner. C’est le cas de l’optoélectronique, où les propriétés optiques des alliages à base de gallium, d’aluminium et d’azote sont idéales pour fabriquer des diodes électroluminescentes (tandis que le silicium émet dans l’infrarouge, loin du spectre visible, et que son rendement est faible)."
                                            },
                                            {
                                                "example_id": "718a9447-5586-4004-aae0-8b7652666f78",
                                                "sense_id": "ff164323-9041-3040-a9ea-d62bdfe44e39",
                                                "text": "Les inclusions alumino-calciques sont dominées par des minéraux riches en aluminium et en calcium comme la diopside (CaMgSi₂O₆), la mélilite (Ca₂Al₂ₓMg₁ – xSi₂ – xO7, x variant continûment de 0 à 1) ou encore le spinelle (MgAl₂O₄)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "722cd0d9-c9ab-3ee8-baa4-fd287dee10d9",
                                        "entry_id": "7d715ce0-6438-3f79-b0a2-e92b233435d7",
                                        "glosses": [
                                            "Corps simple élémentaire ; métal argenté malléable, résistant et léger."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4682ec55-12ca-48b6-85c2-0e3d1736d112",
                                                "sense_id": "722cd0d9-c9ab-3ee8-baa4-fd287dee10d9",
                                                "text": "Au point de vue chimique l’aluminium est remarquable par son inaltérabilité."
                                            },
                                            {
                                                "example_id": "53b71343-2ad0-4e4c-a901-cf3ea3a21b46",
                                                "sense_id": "722cd0d9-c9ab-3ee8-baa4-fd287dee10d9",
                                                "text": "Il souleva le siège et le tint en équilibre sur son petit doigt.\n– C’est assez léger, hein ? Alliage d’aluminium et de magnésium, et on a fait le vide à l’intérieur."
                                            },
                                            {
                                                "example_id": "7f2b684a-5b42-41bf-97dd-ce18a273432f",
                                                "sense_id": "722cd0d9-c9ab-3ee8-baa4-fd287dee10d9",
                                                "text": "Au début du siècle, l’aluminium est encore un métal précieux produit en faible quantité."
                                            },
                                            {
                                                "example_id": "e0990732-5832-466d-b951-ba2b9de70d2b",
                                                "sense_id": "722cd0d9-c9ab-3ee8-baa4-fd287dee10d9",
                                                "text": "La découverte de nouveaux matériaux soulève en effet le problème de leur utilisation, qu’il s’agisse de l’aluminium en 1854 ou de la cellophane produite aux États-Unis dès 1924."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70582f60-9fdd-3ef2-bb39-e379ade61b01",
                                        "entry_id": "7d715ce0-6438-3f79-b0a2-e92b233435d7",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) d’aluminium."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5349bc20-015a-30f4-bbdb-78e98be0b9d1",
                                        "entry_id": "7d715ce0-6438-3f79-b0a2-e92b233435d7",
                                        "glosses": [
                                            "Alliage d’aluminium."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
