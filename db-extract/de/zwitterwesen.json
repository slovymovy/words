                "senses": [
                    {
                        "sense_id": "cc6124b2-052c-3318-b28b-2bc2e8e2b1a2",
                        "entry_id": "5b558098-ac8e-31e8-8d14-98eb8fe5c386",
                        "glosses": [
                            "menschliches oder tierisches Individuum, das weibliche und männliche Geschlechtsorgane aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f71b3c63-8a93-42c4-8ddf-1a9abcd6d0dd",
                                "sense_id": "cc6124b2-052c-3318-b28b-2bc2e8e2b1a2",
                                "text": "„Es werden auch Zwitterwesen geboren, welche wir Hermaphroditen nennen; früher wurden sie Androgyne genannt und zu den Wundern gerechnet, jetzt aber dienen sie dem Vergnügen.“"
                            },
                            {
                                "example_id": "40405c25-904d-442b-85de-901f76a002be",
                                "sense_id": "cc6124b2-052c-3318-b28b-2bc2e8e2b1a2",
                                "text": "„Nichtsdestoweniger hat man Grund zu glauben, daß bei allen Zwitterwesen zwei entweder gelegentlich oder gewohnheitsmäßig zur Fortpflanzung ihrer Art zusammenwirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4eb809e8-8eee-34e8-99d5-4436d515eb7d",
                        "entry_id": "5b558098-ac8e-31e8-8d14-98eb8fe5c386",
                        "glosses": [
                            "Mischwesen, insbesondere aus verschiedenen Spezies"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e27614-297e-4bee-b61f-66ffadb09237",
                                "sense_id": "4eb809e8-8eee-34e8-99d5-4436d515eb7d",
                                "text": "„Alfio war ein nacktes, missgestaltetes Zwitterwesen, weder Mensch noch Wolf, nur ein ... Ding.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "72abd189-1138-3ab5-936f-4b3fd5ecd6c5",
                        "entry_id": "5b558098-ac8e-31e8-8d14-98eb8fe5c386",
                        "glosses": [
                            "Eigenschaft, (geschlechtlich oder anderweit) gemischt zu sein"
                        ],
                        "tags": [
                            "Abstraktum"
                        ],
                        "examples": [
                            {
                                "example_id": "99f63e2e-8ffb-4042-89f7-274b00134b36",
                                "sense_id": "72abd189-1138-3ab5-936f-4b3fd5ecd6c5",
                                "text": "„Denn das ‚Hör-Buch' sei, erörtert Heinz Hiebler, ‚[a]ls Buch, das sich Gehör verschafft, […] auf den ersten Blick ein mediales Paradoxon, dessen Zwitterwesen zwischen sinnlich wahrnehmbarem Sound und abstrakt arbiträrem Zeichen in den phonozentristischen Auffassungen von Sprache und Schrift verwurzelt ist.‘“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
