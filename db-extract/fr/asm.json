                                "sense_id": "51bccc1a-3755-3502-8215-6d188874d223",
                                "text": "Dans la foulée, Volland a donné l’avantage à l’ASM, Veretout a égalisé avant le dernier coup franc brossé par Dimitri Payet sur la tête du Bosnien."
                            },
                            {
                                "example_id": "deca50ea-91c1-4e79-a8c6-196ddb3b4e91",
                                "sense_id": "51bccc1a-3755-3502-8215-6d188874d223",
                                "text": "L’AS Monaco, l’Association sportive Monaco Football Club, abrégée en ASM, est un club de football monégasque fondé le 23 août 1924."
                            },
                            {
                                "example_id": "4a2fdd54-6217-4fac-a653-043b3dd857d2",
                                "sense_id": "51bccc1a-3755-3502-8215-6d188874d223",
                                "text": "Avant la Coupe du monde, il peut continuer à faire du bon travail à l’ASM."
                            }
                        ]
                    }
