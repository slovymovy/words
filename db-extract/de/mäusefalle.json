                                        "entry_id": "12a1e577-7f76-3f15-a405-c2dc5f53d0c9",
                                        "glosses": [
                                            "To trap; to trick or fool (someone) into a bad situation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a094844-4bed-4b0a-8ad0-2d6ec86b5392",
                                                "sense_id": "53a0d592-e990-37a6-98b5-55c8eee5f4f5",
                                                "text": "He hoped to bring the rebels out of their trenches for a showdown battle somewhere south of the Wilderness, that gloomy expanse of scrub oaks and pines where Lee had mousetrapped Joe Hooker exactly a year earlier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4aed1a-4ed7-35ec-b0fb-4aa6badd554f",
                                        "entry_id": "12a1e577-7f76-3f15-a405-c2dc5f53d0c9",
                                        "glosses": [
                                            "To prevent (the user) from leaving a website by opening another copy when it is closed."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dda50eb-306f-41e8-8951-058518181afe",
                                                "sense_id": "7d4aed1a-4ed7-35ec-b0fb-4aa6badd554f",
                                                "text": "The scammer is paid for each new visitor directed to his site. There is nothing wrong except that the user finds it impossible to leave the site because he is mousetrapped."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e3bf5fc-6d0d-40c1-bc31-7f17e4ea40cb",
                        "source_entry_id": "30f2db41-e64b-3f1d-9ecf-404bfbfb2771",
