                        "examples": [
                            {
                                "example_id": "81790d33-cf76-4402-b7cb-358051518dfa",
                                "sense_id": "7bd06d43-ee3a-3af3-b6ef-795823eec796",
                                "text": "Le cerf dans les pays monteux, secs et chauds, tels que la Corse et la Sardaigne, a perdu la moitié de sa taille, et a pris un pelage brun avec un bois noirâtre […]"
                            },
                            {
                                "example_id": "d698b251-94e7-4e03-af0d-3765ec66002c",
                                "sense_id": "7bd06d43-ee3a-3af3-b6ef-795823eec796",
                                "text": "Les Galls se trouvaient trop pressés dans la région monteuse où ils avaient été repoussés ; aussi envoyèrent-ils au-dehors deux armées, ou deux colonnes militaires."
                            }
                        ]
                    }
                ],
