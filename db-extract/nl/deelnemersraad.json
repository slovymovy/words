                        "glosses": [
                            "overlegorgaan van personen die ergens aan deelnemen, met name een overlegorgaan van een pensioenfonds bestaande uit personen die premie betalen of een pensioen ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea29a038-5f95-410d-b086-356a7c3232ef",
                                "sense_id": "ef9973ad-4ee3-31b7-ad49-dd83d5e09647",
                                "text": "Het is niet-vakbondsleden gelukt om een plaats te krijgen in de deelnemersraad van een pensioenfonds. Bij het ambtenarenfonds ABP zijn na een verkiezing zeven mensen in de raad gekomen die niet verbonden zijn aan een vakbond."
                            },
                            {
                                "example_id": "56037c10-5b93-4027-aea4-b0dff3272801",
                                "sense_id": "ef9973ad-4ee3-31b7-ad49-dd83d5e09647",
                                "text": "Volgens het FD zijn in de kosten meegenomen de vergoedingen voor bestuurders voor het voorbereiden en bijwonen van vergaderingen. Bij sommige pensioenfondsen vallen ook de kosten voor de deelnemersraad en het verantwoordingsorgaan onder de bestuurskosten."
                            }
                        ]
