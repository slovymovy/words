                                    {
                                        "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "An agitated disturbance or a hubbub."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ccea11d-9845-4aef-8f7d-514f88bf72dc",
                                                "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                                "text": "It would seem as if calm were necessary to convulsion; for the tranquillity of the last few months was again to be disturbed by political commotion."
                                            },
                                            {
                                                "example_id": "50db1e12-5c7c-40f7-b23d-8aa572d32787",
                                                "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
