                        ],
                        "form": "dem Gewimmel"
                    },
                    {
                        "form_id": "48dd4cf7-05a0-4851-a9e8-4d9979b74e0b",
                        "entry_id": "76946b3e-1fec-3da4-a8a4-503198da15e3",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Gewimmel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                        "entry_id": "76946b3e-1fec-3da4-a8a4-503198da15e3",
                        "glosses": [
                            "Durcheinander sich kreuz und quer bewegender Fahrzeuge oder Lebewesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05bd0f9d-f47a-4605-8142-952e14b633e4",
                                "sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                                "text": "„Mitten in dem vergnügten Gewimmel der heimkehrenden Sportler standen drei Neger.“"
                            },
                            {
                                "example_id": "50eea2ad-e975-4ff8-8dfa-057cb7607d7b",
                                "sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                                "text": "„Der Broadway war ein einziges Gewimmel und Gewusel.“"
                            },
                            {
                                "example_id": "e3fc5605-d51c-452e-ba0b-ac70d67f12bc",
                                "sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                                "text": "„Ritterbach hat im Gewimmel hinter der Bühne seine Narrenkappe verloren.“"
                            },
                            {
                                "example_id": "76737058-e9bf-480b-95d4-1bee54665802",
                                "sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                                "text": "„Und dieses Gewimmel war in drei Minuten entstanden, gleichsam hinter meinem Rücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4686df94-604b-4bed-ace7-5f346f5ffd62",
                        "source_entry_id": "76946b3e-1fec-3da4-a8a4-503198da15e3",
                        "source_sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                        "source_sense_description": "Durcheinander sich kreuz und quer bewegender Fahrzeuge oder Lebewesen",
                        "target_lang_word": "толкотня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "толкотня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "16097c5a-d6f5-3f6a-9cfb-efcf37c33f4e",
                                        "entry_id": "313e9515-3540-3f5f-be27-6bf1618cb021",
                                        "glosses": [
                                            "разг. теснота, в которой люди толкают друг друга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280173d0-47e5-46a3-8352-036894b55423",
                                                "sense_id": "16097c5a-d6f5-3f6a-9cfb-efcf37c33f4e",
                                                "text": "И у самого берега началась настоящая давка и толкотня."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bbd2252-fc99-4048-a37e-fc003da93473",
                        "source_entry_id": "76946b3e-1fec-3da4-a8a4-503198da15e3",
                        "source_sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                        "source_sense_description": "Durcheinander sich kreuz und quer bewegender Fahrzeuge oder Lebewesen",
                        "target_lang_word": "толкучка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "толкучка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c070a5a7-2b6a-31f1-93e9-b574a91e6393",
                                        "entry_id": "7e84b232-e472-3ba9-80be-952d4a8f0e17",
                                        "glosses": [
                                            "толкотня, давка, также перен."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f81458c-336f-4416-8e99-afaf3d8f3578",
                                                "sense_id": "c070a5a7-2b6a-31f1-93e9-b574a91e6393",
                                                "text": "«Деньги» — вот самое верное среди продолжительнейшей сумятицы и толкучки противоречивых, а главное — почти всегда неопределённых явлений жизни, которые эта жизнь давала ему."
                                            },
                                            {
                                                "example_id": "217c25e1-d636-485a-aba3-bc8eedced315",
                                                "sense_id": "c070a5a7-2b6a-31f1-93e9-b574a91e6393",
                                                "text": "В первые, два дня около нашего дома буквально образовалась толкучка из больших и малых семинаристов, двадцать раз перечитывавших вывеску и заглядывавших во все окна и двери, постоянно вызывавших то меня, то брата для переговоров."
                                            },
                                            {
                                                "example_id": "43e37aea-722e-43fc-a853-5b7f11b27467",
                                                "sense_id": "c070a5a7-2b6a-31f1-93e9-b574a91e6393",
                                                "text": "Рим был толкучкою заимствованных богов и завоёванных народов, давкою в два яруса, на земле и на небе, свинством, захлестнувшимся вокруг себя тройным узлом, как заворот кишок."
                                            },
                                            {
                                                "example_id": "4d2c6506-83c4-42c0-9132-befdf2216248",
                                                "sense_id": "c070a5a7-2b6a-31f1-93e9-b574a91e6393",
                                                "text": "В дверях образовалась неуклюжая толкучка, чтобы не сказать пробка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083bc3b6-601b-320d-9ec2-cf58a64c9bba",
                                        "entry_id": "7e84b232-e472-3ba9-80be-952d4a8f0e17",
                                        "glosses": [
                                            "разг. то же, что блошиный рынок; место, где торгуют подержанными вещами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920a576c-9c4c-4001-8744-1b22e4d57ede",
                                                "sense_id": "083bc3b6-601b-320d-9ec2-cf58a64c9bba",
                                                "text": "Утром я пошёл на толкучку продавать шинель."
                                            },
                                            {
                                                "example_id": "88319763-e9e2-440e-9762-4631d287496c",
                                                "sense_id": "083bc3b6-601b-320d-9ec2-cf58a64c9bba",
                                                "text": "Бродили по толкучке, разглядывая товар, как вдруг Васька стал прицениваться к колоде карт."
                                            },
                                            {
                                                "example_id": "d5c2a87e-2af4-462a-8a55-d4b694fd9140",
                                                "sense_id": "083bc3b6-601b-320d-9ec2-cf58a64c9bba",
                                                "text": "Москвичи и ленинградцы, киевляне и одесситы, именитые деятели литературы и искусства чаще всего встречались на толкучке, где можно было всё продать и всё купить."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ddcd07d-e717-4bd4-b8b1-9b9a3e278baf",
                        "source_entry_id": "76946b3e-1fec-3da4-a8a4-503198da15e3",
                        "source_sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                        "source_sense_description": "Durcheinander sich kreuz und quer bewegender Fahrzeuge oder Lebewesen",
                        "target_lang_word": "кипиш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кипиш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "44e63e52-28c2-3fd8-a916-07ba887e67e7",
                                        "entry_id": "a7823bb9-ae2a-32ab-81c8-d49e4b31cdf3",
                                        "glosses": [
                                            "крим., жарг. крик, скандал, разборка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bc59946-4e6e-41cf-817b-49e546dd25a4",
                                                "sense_id": "44e63e52-28c2-3fd8-a916-07ba887e67e7",
                                                "text": "Из-за этих просмотров кипиш я и подняла."
                                            },
                                            {
                                                "example_id": "b5eaa468-3813-45d8-907e-2e0593e73f75",
                                                "sense_id": "44e63e52-28c2-3fd8-a916-07ba887e67e7",
                                                "text": "Из класса в класс переводила его мама, иногда договариваясь с учителями, иногда устраивая в школе грандиозный кипиш."
                                            },
                                            {
                                                "example_id": "e917d782-e785-4750-9d1b-5004cfa0a31c",
                                                "sense_id": "44e63e52-28c2-3fd8-a916-07ba887e67e7",
                                                "text": "Хотя мы и знали оба, какой кипиш и шмон начнётся на зоне после моего рывка и кто-то под пресс пойдёт, на этап, режим усилится, и пока это затихнет, многим достанется."
                                            },
                                            {
                                                "example_id": "1e275f09-4130-4c39-8cf2-a2d5b26b06e0",
                                                "sense_id": "44e63e52-28c2-3fd8-a916-07ba887e67e7",
                                                "text": "Тут же начнёт звать на помощь, поднимет кипиш… А этого им надо было меньше всего."
                                            },
                                            {
                                                "example_id": "bb0c31b3-5714-4975-9cb8-76e3c4d85829",
                                                "sense_id": "44e63e52-28c2-3fd8-a916-07ba887e67e7",
                                                "text": "Дело запахло дракой, но в это время конвоир тяжело постучал металлическим ключом в дверь и внятно произнёс, откинув намордник: отбой, кончай кипиш."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df266d0-c7e5-32d7-abe6-3d64e436d766",
                                        "entry_id": "a7823bb9-ae2a-32ab-81c8-d49e4b31cdf3",
                                        "glosses": [
                                            "разг. шум, суета, суматоха, переполох"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9608e2a-9279-4ab4-859a-ed2137824ce0",
                                                "sense_id": "9df266d0-c7e5-32d7-abe6-3d64e436d766",
                                                "text": "— Представляю, что сегодня будет за кипиш в вечерних новостях!"
                                            },
                                            {
                                                "example_id": "2e6e2e3a-8c79-4580-9ca2-6e62121219f2",
                                                "sense_id": "9df266d0-c7e5-32d7-abe6-3d64e436d766",
                                                "text": "К тому же он невероятно любопытен и, услыхав кошачьи вопли, предпочитает самолично разузнать, что за кипиш."
                                            },
                                            {
                                                "example_id": "c9478315-8bc0-4101-badf-75db97784c7e",
                                                "sense_id": "9df266d0-c7e5-32d7-abe6-3d64e436d766",
                                                "text": "Кипиш, конечно, поднялся нешуточный. У них же в этих компьютерах супер-пупер секретная информация."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fa8532b-f6c4-4541-bc52-86835a7556f5",
                        "source_entry_id": "76946b3e-1fec-3da4-a8a4-503198da15e3",
                        "source_sense_id": "ca7dc825-d597-3a91-b152-40fbcbc506a7",
                        "source_sense_description": "Durcheinander sich kreuz und quer bewegender Fahrzeuge oder Lebewesen",
                        "target_lang_word": "жопа",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жопа",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "груб. ягодицы, попа, задница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d1e4f97-235a-4904-9d32-57c274669b22",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Начиная с того, что я видел голую жопу Государыни (Екатерины II-ой, в день её смерти)."
                                            },
                                            {
                                                "example_id": "2507d448-49c0-4752-8827-45d30667f607",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Конечно, я мог бы называть жопу, например, ягодицами, задницей, окрестностями ануса, пятой точкой, седалищем, мягким местом, пониже спины."
                                            },
                                            {
                                                "example_id": "2b6d2e9b-889c-4983-a530-ee72f437b323",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Вторая половинка есть у мозга, жопы и таблетки. А я изначально целая."
                                            },
                                            {
                                                "example_id": "ca88ea53-9023-4f6a-a826-67029131b0aa",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Я сгорал от стыда, когда Фаина Георгиевна громко говорила мне «на ухо» о проходящей даме: 〈…〉 «С такой жопой надо сидеть дома!»"
                                            },
                                            {
                                                "example_id": "e122ad05-0607-4bba-8b15-b7f8433a7d60",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "— В Союзе больше не нашлось секретарш с толстой жопой?"
                                            },
                                            {
                                                "example_id": "278c062f-2acc-4b3c-a712-a5898d4b19d5",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "〈…〉 По спине похлопаю, // Поставлю кверху жопою."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "разг. задний проход; анус"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd5a80f-f61c-4ba7-ac58-8b771e5d1916",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "На шестнадцатом партсъезде // Были слышны голоса: // «Кто последний? Я за вами // Брить на жопе волоса!»"
                                            },
                                            {
                                                "example_id": "52eb07da-7e95-4b6c-99ad-8a92976f519a",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— А бумажки свои ты можешь в трубочку свернуть и засунуть себе в жопу!"
                                            },
                                            {
                                                "example_id": "2c441ba4-1bb1-48ff-953b-a71c50a736e8",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— А свой «Гербалайф» в жопу себе засунь."
                                            },
                                            {
                                                "example_id": "3d21c729-7769-48f7-ae55-20b97e7c4e5b",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— Страшно грустна моя жизнь. А вы хотите, чтобы я воткнула в жопу куст сирени и делала перед вами стриптиз. 〈…〉 — Каждый волен распоряжаться своей жопой, как ему хочется. Поэтому я свою поднимаю и уёбываю."
                                            },
                                            {
                                                "example_id": "4f3869c2-f38c-452a-bc80-33059f86afcc",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— Рви себе трусы под жопой! Под жопой рви, я сказал! Чтоб как юбка были!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., шутл. задняя часть чего-либо (обычно о транспортном средстве)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05666fa5-513e-4ed7-8cbd-bd057447e91e",
                                                "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                                "text": "— Чудак на «Жигулях» жопу автобусу протаранил."
                                            },
                                            {
                                                "example_id": "671d228c-d31d-4c3e-8e08-c1f39ab0b2a1",
                                                "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                                "text": "Раньше Антон служил на подводной лодке, о чём рассказывал так: … Лежим, не дышим, а закон там — вода, прокурор — акула. Мимо американские лодки скользят, а у нас сердце в пятки уходит. 〈…〉 И вот какая-то подводная блядь клюнула нас подлейшим образом в жопу, а мы отклюнуться не успели. Экранировка нарушилась, началось истечение радиации."
                                            },
                                            {
                                                "example_id": "10ed3eff-2ac0-47ef-b7e8-e0056886abb7",
                                                "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                                "text": "На второй день в Москве уступил пешеходу дорогу на своей машине — «я хотел, чтобы как в Вашингтоне!» — ему тут же в жопу въехали. Причём, двое сразу — восьмёра и Пежо какой-то!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d89e95e-39db-3f73-a8bd-eb71eeab8b07",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., уничиж., никчёмный, дурной, неприятный человек"
                                        ],
                                        "tags": [
                                            "тж. бран."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b6cf7d-e1f5-4036-bbe6-799f2e7b0fd9",
                                                "sense_id": "1d89e95e-39db-3f73-a8bd-eb71eeab8b07",
                                                "text": "[Б о р я (к Т а м а р о ч к е):] Больному приготовить сульфу, укол буду делать сам. [П р о х о р о в:] Что же поделаешь, Борис… Новичок… Бред правдоискательства, чувство ложно понятой чести и прочие атавизмы… [Б о р я:] А тебе бы лучше помолчать. Жопа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f42eb0-ee19-31c2-b109-29ea70721f35",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., груб., неодобр. удалённая местность; провинция, глубинка; чёрти где, у чёрта на куличках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28108b57-b431-4266-b183-38a15e12a742",
                                                "sense_id": "f9f42eb0-ee19-31c2-b109-29ea70721f35",
                                                "text": "— В какую же жопу мы забрели!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0746ef03-5111-3cd7-a84b-b3f171dd90e6",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., груб. неприятная ситуация, плохое положение дел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541db0f1-90d9-4b35-9ebe-6ea3c7b32d0b",
                                                "sense_id": "0746ef03-5111-3cd7-a84b-b3f171dd90e6",
                                                "text": "— Я в такую жопу попал!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bf81e86-f3f4-31a1-8b65-559d0ef690b1",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "предик. то же, что дрянь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0815f068-649c-4b79-bbc6-8a9225edd963",
                                                "sense_id": "8bf81e86-f3f4-31a1-8b65-559d0ef690b1",
                                                "text": "— Дело — жопа!"
                                            },
                                            {
                                                "example_id": "ce912c72-ba86-4cae-86aa-d1ed48b32790",
                                                "sense_id": "8bf81e86-f3f4-31a1-8b65-559d0ef690b1",
                                                "text": "Какие перспективы могут открыться? Полная жопа! И больше ничего!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
