                                    {
                                        "sense_id": "62ace369-1701-3c58-82fe-245dfdda2be5",
                                        "entry_id": "3c714676-088e-3340-8db5-6d76ddc4044f",
                                        "glosses": [
                                            "region historyczno-geograficzny położony na Wyżynie Tybetańskiej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82667117-a433-48f4-a842-0f86d1d29655",
                                                "sense_id": "62ace369-1701-3c58-82fe-245dfdda2be5",
                                                "text": "Tybet był zdominowany przez ludy pasterskie ze względu na panujący tam wybitnie kontynentalny klimat."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "945f6a77-f975-3dcd-a349-045fae25f181",
                                        "entry_id": "3c714676-088e-3340-8db5-6d76ddc4044f",
                                        "glosses": [
                                            "kraj na Wyżynie Tybetańskiej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05504380-3056-4d25-96b2-95219b761790",
                                                "sense_id": "945f6a77-f975-3dcd-a349-045fae25f181",
                                                "text": "Dalajlama, zwierzchnik polityczny Tybetu i religijny buddyzmu tybetańskiego, był od początku panowania wyznającej buddyzm dynastii mandżurskiej Qing także przywódcą religii państwowej Chin."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "d6ed147e-0bfe-3560-aab3-e8a99f4114e4",
                                        "entry_id": "3c714676-088e-3340-8db5-6d76ddc4044f",
                                        "glosses": [
                                            "jednostka administracyjna Chin, Tybetański Region Autonomiczny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929c23be-b5dd-4350-b6fa-52911ce4a687",
                                                "sense_id": "d6ed147e-0bfe-3560-aab3-e8a99f4114e4",
                                                "text": "Wiceminister kolei Chin Sun Yongfu powiedział dziennikarzom, że przez wiele lat przeszkody natury komunikacyjnej ograniczały rozwój gospodarki Qinghai i Tybetu, a zwłaszcza Tybetu, który był jedynym w Chinach administracyjnym regionem bez komunikacji kolejowej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
