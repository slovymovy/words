                                        "glosses": [
                                            "het slingeren, de zwaai"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56a5df2-f17a-4820-892e-0f02d5a62b01",
                                                "sense_id": "e0524660-7bcc-3437-8c30-c7311cedc949",
                                                "text": "Toen was het mijn beurt en ik bond een steen aan een lang stuk touw, hield de grote lussen in mijn linkerhand, gaf een harde slinger en liet los."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3c8c52-23de-3d9f-839c-e7ed4f789f85",
                                        "entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                                        "glosses": [
