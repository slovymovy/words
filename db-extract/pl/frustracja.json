                    {
                        "sense_id": "87fbc5f4-d54a-35b3-a03f-9c9966cbe01d",
                        "entry_id": "f8eec81b-f4cf-313d-bec2-5171ebb2ddef",
                        "glosses": [
                            "stan nieprzyjemnego napięcia emocjonalnego wynikły z niemożności zaspokojenia jakiejś potrzeby albo osiągnięcia danego celu"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "a9c3b37f-601b-4bb7-8564-7ed6abb44a9b",
                                "sense_id": "87fbc5f4-d54a-35b3-a03f-9c9966cbe01d",
                                "text": "Kolejną koncepcją agresji (…), jest ujęcie agresji jako reakcji na frustrację"
                            },
                            {
                                "example_id": "d5f1884d-4802-4d3f-886f-40a7ed1a23e0",
                                "sense_id": "87fbc5f4-d54a-35b3-a03f-9c9966cbe01d",
                                "text": "W rzeczywistości frustracja i głębokie zadowolenie są ze sobą ściśle związane; trudno sobie wyobrazić intensywną przyjemność bez jakiejś poprzedzającej jej frustracji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
