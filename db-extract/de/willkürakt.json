                        "entry_id": "9eb2f327-40c8-32a4-a260-40c57e2afed5",
                        "glosses": [
                            "eine Handlung oder Tätigkeit – ein Akt –, die willkürlich, also zufällig oder grundlos beziehungsweise ohne Zielsetzung, vollzogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a0daba7-0287-4ea1-b484-b400fe195b02",
                                "sense_id": "4797bb6a-b88f-3689-92eb-ca728d71d4dd",
                                "text": "Sie bezeichnete es vor Gericht als Willkürakt."
                            },
                            {
                                "example_id": "b18ba7a0-89fd-4f9b-8c5e-a1ed6c26da09",
                                "sense_id": "4797bb6a-b88f-3689-92eb-ca728d71d4dd",
                                "text": "Dass es ein Willkürakt war, ist nicht auszuschließen."
                            },
                            {
                                "example_id": "30197e2f-0b3c-4b2a-9c60-7e2e614374aa",
                                "sense_id": "4797bb6a-b88f-3689-92eb-ca728d71d4dd",
                                "text": "„Die von Tillich mit herbeigeführte Enteignung war selbst nach den Gesetzen der DDR rechtswidrig und stellte einen Willkürakt dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
