                    }
                ],
                "senses": [
                    {
                        "sense_id": "dabcdfd9-516c-3d58-a382-03bf404a390f",
                        "entry_id": "138227c9-d8f8-3858-ac85-7465fd3386b3",
                        "glosses": [
                            "spottende benaming voor een meisje of jonge vrouw in de puberteit of adolescentie wier gedrag nog niet van volwassenheid getuigt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ec9e6456-a296-47c5-b602-b4e39d771abb",
                                "sense_id": "dabcdfd9-516c-3d58-a382-03bf404a390f",
                                "text": "Juist die zorgeloosheid en de beschrijvingen van het dagelijks leven tijdens de Duitse bezetting maken dit dagboek boeiend. Op het eerste gezicht sleurt het je het Joop ter Heul-achtige bestaan binnen van een intellectuele bakvis, die met haar hartsvriendin Greetje onafgebroken wedijvert om de geheimzinnige, maar saaie Eldert. Maar het laat ook zien hoe leraren en leerlingen van een hoofdstedelijk gymnasium zich door de Duitse bezetter laten misleiden tot er geen uitweg meer mogelijk is."
                            }
                        ]
                    },
                    {
                        "sense_id": "56ace38a-de2c-3246-b3d5-70e97d61d706",
                        "entry_id": "138227c9-d8f8-3858-ac85-7465fd3386b3",
                        "glosses": [
                            "onrijpe, groene student"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10c6fd5e-3abd-32e6-830e-491b06d6612a",
                        "entry_id": "138227c9-d8f8-3858-ac85-7465fd3386b3",
                        "glosses": [
                            "een vis om te bakken (een te kleine vis die door vissers niet wordt teruggegooid, maar ook niet wordt verkocht; de vissers eten deze visjes zelf op)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98e05d74-0575-4874-ac0d-7e9f10fcbbd9",
                        "source_entry_id": "138227c9-d8f8-3858-ac85-7465fd3386b3",
                        "target_lang_word": "Backfisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Backfisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                        "entry_id": "5ebec1aa-8f7b-3ec3-99e9-2bfc84eff49b",
                                        "glosses": [
                                            "ein gebackener oder paniert gebratener Fisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a3d3f07-533f-4bab-adce-8ab07aad88cc",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "Nimm doch bitte den Backfisch aus dem Ofen."
                                            },
                                            {
                                                "example_id": "d767ea5f-ac19-467e-be72-6a2d9b5cd987",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "„‚Jetzt haben wir dich ertappt‘, sagte ein Bursche, dem die Nase von einem Faustschlag schraeg stand, aber, so sah es aus, nur momentan, sie musste gleich wieder richtig rucken, ‚du kaufst ja deine Backfische auf dem Markt.‘“"
                                            },
                                            {
                                                "example_id": "97b333e8-843a-4d3e-8635-97ff1e6d0978",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "„Heute gibt es Backfisch auf Weizenfladen.“"
                                            },
                                            {
                                                "example_id": "348fbea6-a6b4-4ba9-bdad-7e8ff4e5ebb3",
                                                "sense_id": "9bf34b9b-8d14-3ce7-8cd4-1abe51d12641",
                                                "text": "„Die Straßen Londons waren überlaufen von Kindern, die Orangen verkauften, und Jungen, die Backfisch klauten, und Frauen ohne Geld, die auf öffentlichen Plätzen schliefen, und Männern mit Geld, die vor geschlossenen Kneipen warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                        "entry_id": "5ebec1aa-8f7b-3ec3-99e9-2bfc84eff49b",
                                        "glosses": [
                                            "heranwachsendes (mitunter launisches) Mädchen etwa im Alter zwischen 13 und 17 Jahren"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a794e2f0-6b04-4dc4-b8d0-e461d8363463",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "Alle seine Freundinnen waren ohne Ausnahme Backfische."
                                            },
                                            {
                                                "example_id": "24acf5ad-50b4-4b0d-9180-5e6a40558f26",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Und ich in Beſitz des ſtrittigen Stuͤcks [Land], und druͤber den huͤbſch[es]ten Backfiſch im ganzen Dorf.“"
                                            },
                                            {
                                                "example_id": "59270301-2b3a-4091-9a4a-f8585dd00803",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Zum Glück kam ſein Unmut zu keinem Ausbruch, denn von dem, was ſeine Frau vermiſſen ließ, hatten ſeine Töchter deſto mehr, bildhübſche Backfiſche von vierzehn und dreizehn, die ganz nach dem Vater ſchlugen.“"
                                            },
                                            {
                                                "example_id": "99410928-92f3-4dcc-9e1f-215a65379b05",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Aber unser Aufenthalt erfuhr eine jähe Unterbrechung, veranlaßt durch einen Besuch in einem Mädchenpensionat, wo meine jüngste Schwester Mathilde als 17-jähriger Backfisch zur jungen Dame erzogen wurde.“"
                                            },
                                            {
                                                "example_id": "758bd407-d21a-4d38-a4e3-bc0a73debde3",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Sie war noch auf, als ich ankam, und ausgelassen lustig konnte sie sein, so dalberig, recht wie ein Backfisch.“"
                                            },
                                            {
                                                "example_id": "98fc58d1-c36f-4e40-9c52-b26b27c21349",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Ich suchte einen Backfisch auf, der mir einmal zu einer Liebesgabe einen naiven Brief an Unbekannt geschrieben hatte, was damals zu einer lustigen längeren Korrespondenz führte.“"
                                            },
                                            {
                                                "example_id": "0e4a73bb-a719-4e15-ae17-a686946a96bf",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Als Käthe, eine Lampe in der Hand, die Straße überquerte, fragte sie sich, warum sie und die beiden Thelen-Töchter sich auf dem Speicher wie Backfische benommen hatten, obwohl sie doch alle drei längst und in jeder Beziehung aus dem Backfischalter heraus waren.“"
                                            },
                                            {
                                                "example_id": "de89bf35-1c42-4724-bade-a9f506cc6d54",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Vor wenigen Jahren verschied nach längerem seelischen Leiden sanft der Backfisch, und es begann der Einmarsch der Teenager.“"
                                            },
                                            {
                                                "example_id": "ebded8b3-9af0-42dc-b42a-242b659ae7dd",
                                                "sense_id": "36297201-d087-3091-9cf3-ccc4d26a02da",
                                                "text": "„Andrew ist so unpraktisch und versponnen wie ein Backfisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b84e606-76aa-4494-bcd1-9efae924f665",
                        "source_entry_id": "138227c9-d8f8-3858-ac85-7465fd3386b3",
                        "target_lang_word": "flapper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flapper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b54ca0bb-3634-33d5-a7f0-a6db5a5322b7",
                                        "entry_id": "46eacd08-cc1a-3cb1-8997-a2ae0570c1ec",
                                        "glosses": [
                                            "A young girl usually between the ages of 15 and 18, especially one not \\\"out\\\" socially."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd0ecf5-a7dd-4bb4-9707-fefe27e0efc4",
                                                "sense_id": "b54ca0bb-3634-33d5-a7f0-a6db5a5322b7",
                                                "text": "Stud's eyes roved. Plenty of girls, most of them young flappers, Loretta's age. Only a couple of years ago they were kids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                        "entry_id": "46eacd08-cc1a-3cb1-8997-a2ae0570c1ec",
                                        "glosses": [
                                            "A young woman, especially when unconventional or without decorum or displaying daring freedom or boldness; now particularly associated with the Jazz Age of the 1920s."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee07403-dc28-4882-8c52-84e390d9eea3",
                                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                                "text": "I paid violent and unusual attention to a flapper all through the meal in order to make you jealous. She's probably in her cabin writing reams about me to a fellow-flapper at this very moment."
                                            },
                                            {
                                                "example_id": "2aa1f08e-0e50-4d5a-90d3-bc6b16b81cd2",
                                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                                "text": "\"Now,\" said the young man cheerfully to Ardita, who had witnessed this last scene in withering silence, \"if you will swear on your honor as a flapper—which probably isn't worth much—that you'll keep that spoiled little mouth of yours tight shut for forty-eight hours, you can row yourself ashore in our rowboat.\""
                                            },
                                            {
                                                "example_id": "444175df-f11e-42bf-8eeb-3222bfde3c68",
                                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                                "text": "Concern—and consternation—about the flapper are general. She disports herself flagrantly in the public eye, and there is no keeping her out of grown-up company or conversation."
                                            },
                                            {
                                                "example_id": "1e712b7b-7bd2-45d0-bd07-abb192cfcc40",
                                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                                "text": "F. Scott Fitzgerald is best known as a chronicler of the 1920s and as the writer who, more than any other, identified, delineated, and popularized the female representative of that era, the flapper. Though it is an overstatement to say that Fitzgerald created the flapper, he did, with considerable assistance from his wife Zelda, offer the public an image of a young woman who was spoiled, sexually liberated, self-centered, fun-loving, and magnetic. […] Although she is often seen now as a mere fashion of the bygone Jazz Age, the flapper should be regarded as one of the great authentic characters in American history."
                                            },
                                            {
                                                "example_id": "0fb7a6a0-5c17-470c-b898-689999288f92",
                                                "sense_id": "c96a64dd-d4b2-3c77-bbdd-ee29ea53083e",
                                                "text": "Among McPherson's most passionate and visible advocates were Southern California's young flappers, who turned out in droves to cheer on the evangelist. While most fundamentalists vehemently criticized flappers, viewing them as symbols of moral decay and the decline of Victorian gender identities, McPherson had embraced them. Critics of her Bible college identified the young female ministers with whom she surrounded herself not as holdouts to Victorianism, but as outright flappers. The press even dubbed one of McPherson's most successful young protégés the flapper evangelist."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flapper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ccc5361-8bf1-3ffd-8985-cb84ece11eff",
                                        "entry_id": "025918c5-2420-3708-ae19-0e34786b814b",
                                        "glosses": [
                                            "One who or that which flaps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07e85293-5325-499d-8d2e-0ca046a568ea",
                                                "sense_id": "1ccc5361-8bf1-3ffd-8985-cb84ece11eff",
                                                "text": "It seems the minds of these people are so taken up with intense speculations, that they neither can speak, nor attend to the discourses of others, without being roused by some external taction upon the organs of speech and hearing; for which reason, those persons who are able to afford it always keep a flapper (the original is climenole) in their family, as one of their domestics; nor ever walk abroad, or make visits, without him. And the business of this officer is, when two, three, or more persons are in company, gently to strike with his bladder the mouth of him who is to speak, and the right ear of him or them to whom the speaker addresses himself. This flapper is likewise employed diligently to attend his master in his walks, and upon occasion to give him a soft flap on his eyes; because he is always so wrapped up in cogitation, that he is in manifest danger of falling down every precipice, and bouncing his head against every post; and in the streets, of justling others, or being justled himself into the kennel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f336236d-b579-3254-b55d-80f04080011f",
                                        "entry_id": "025918c5-2420-3708-ae19-0e34786b814b",
                                        "glosses": [
                                            "A young game bird just able to fly, particularly a wild duck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f9dc281-e6a5-474c-82a5-93f760b988f9",
                                                "sense_id": "f336236d-b579-3254-b55d-80f04080011f",
                                                "text": "Small fish, and frog and fish spawn are also eaten, and the ducklings feed upon many species of animalculæ, flies, pollywogs and worms, etc., disturbed by heavy rains which wash the banks, while the young ducks are passing to the \"flapper\" stage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2d5d55-11e5-3374-874a-5cd29c477e44",
                                        "entry_id": "025918c5-2420-3708-ae19-0e34786b814b",
                                        "glosses": [
                                            "A flipper; a limb of a turtle, which functions as a flipper or paddle when swimming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331d3309-31f2-4e91-89b9-c79f03943ab1",
                                                "sense_id": "ab2d5d55-11e5-3374-874a-5cd29c477e44",
                                                "text": "the flapper of a porpoise"
                                            },
                                            {
                                                "example_id": "906975cb-5b18-4169-8284-2676c873d2b4",
                                                "sense_id": "ab2d5d55-11e5-3374-874a-5cd29c477e44",
                                                "text": "It was still too shallow for the turtle to swim, but it used its four flappers with so much effect against its two assailants, as to give them a thorough shower-bath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc22429-75b2-34f0-b5af-574354462989",
                                        "entry_id": "025918c5-2420-3708-ae19-0e34786b814b",
                                        "glosses": [
                                            "A flapper valve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3f9ae9-fed7-4916-bbc7-4487670810df",
                                                "sense_id": "6fc22429-75b2-34f0-b5af-574354462989",
                                                "text": "In this case, slide the collar of the flapper over the overflow tube until it seats against the bottom of the flush valve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4aa5080-9142-3140-b775-1b1f73e0b409",
                                        "entry_id": "025918c5-2420-3708-ae19-0e34786b814b",
                                        "glosses": [
                                            "The hand."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
