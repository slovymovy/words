                "senses": [
                    {
                        "sense_id": "ad25a402-3a2c-3db4-ad34-a68815ca00fe",
                        "entry_id": "59a8abb1-5c6a-3d3f-abe4-0b43c3e5f06a",
                        "glosses": [
                            "очень глубокий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "187baa51-e82f-456f-83ee-741e52fce1d4",
                                "sense_id": "ad25a402-3a2c-3db4-ad34-a68815ca00fe",
                                "text": "Дом, в коем находился, стоял в преглубоком овраге, покрытом деревьями, так что летом не скоро его и приметить можно."
                            },
                            {
                                "example_id": "db4ad9ec-a032-44e8-a55d-d32aebf920b7",
                                "sense_id": "ad25a402-3a2c-3db4-ad34-a68815ca00fe",
                                "text": "Сердце ― преглубокий колодезь: долго не дощупаешься дна."
                            },
                            {
                                "example_id": "abb219d6-0fe9-4144-b925-383f35b0dc05",
                                "sense_id": "ad25a402-3a2c-3db4-ad34-a68815ca00fe",
                                "text": "Я потому распространяюсь теперь о Гвоздилове, что о нем до сих пор у нас пишут преглубокие и прегуманные фразы."
                            }
                        ]
                    }
                ],
