                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c76c3058-380a-4d27-9fb5-0ef44ad4948b",
                                "sense_id": "bd4b38b9-12ae-31d1-95e6-d9cc86d8361d",
                                "text": "„Per Hubschrauber hatten Artenschützer zwischen 2011 und 2015 großflächig Giftköder auf der rund 3800 Quadratkilometer großen Insel verteilt.“"
                            },
                            {
                                "example_id": "a082f575-76d4-4f57-97d8-42c4b4002b91",
                                "sense_id": "bd4b38b9-12ae-31d1-95e6-d9cc86d8361d",
                                "text": "„Neben Katzen sollen auch Nagetiere und Vögel Giftköder geschluckt haben und daran gestorben sein.“"
                            }
                        ],
