                "senses": [
                    {
                        "sense_id": "1199e329-401c-3b5e-a1e5-febfa7ec7860",
                        "entry_id": "660d6aed-754c-331f-9d84-3f370b7f6a13",
                        "glosses": [
                            "Donner un caractère intuitif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120b45dc-a914-49eb-b3d5-ef69722eb5a5",
                                "sense_id": "1199e329-401c-3b5e-a1e5-febfa7ec7860",
                                "text": "En fin de compte, le mental s'intuitivise complètement et devient un simple canal passif de l'action supramentale ; mais cet état non plus n'est pas la condition idéale ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "8e706fae-29db-3dca-a943-49138e555ab9",
                        "entry_id": "660d6aed-754c-331f-9d84-3f370b7f6a13",
                        "glosses": [
                            "Se montrer intuitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2724d13f-3b18-48ed-b7ad-31ca95a194c3",
                                "sense_id": "8e706fae-29db-3dca-a943-49138e555ab9",
                                "text": "On peut apprendre à lire ou travailler vraiment vite, à être sympathique ou antipathique, etc. Tout dépend de ce que l'on permet à notre Inconscient d'intuitiviser."
                            }
                        ]
                    }
