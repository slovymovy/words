                        "entry_id": "5f8a7a50-3ac9-3252-864e-c82b03c3f33c",
                        "glosses": [
                            "Vorwurf an die eigene Person (= an sich selbst); negative Selbstbetrachtung der eigenen Handlungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55e22c5-ca60-4fc4-821b-69cca60119b8",
                                "sense_id": "01420dc5-b2c8-31b7-902a-ab20be8720d1",
                                "text": "Nach seiner Tat quälten ihn Selbstvorwürfe."
                            },
                            {
                                "example_id": "f06c8577-1f4e-42c6-b7e5-4923bdaf39a5",
                                "sense_id": "01420dc5-b2c8-31b7-902a-ab20be8720d1",
                                "text": "„Hinter diesen Sätzen steht der ihn ständig plagende Selbstvorwurf mangelnder Arbeitsdisziplin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
