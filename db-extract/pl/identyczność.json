                    {
                        "translation_id": "e43944d8-f1e3-4ccc-9977-bc5ef95f27f9",
                        "source_entry_id": "99257ddb-d517-333b-9c0d-0171a7656895",
                        "source_sense_id": "1c4af351-be66-33b0-a32e-cc5f0d9b1875",
                        "target_lang_word": "identity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identity",
