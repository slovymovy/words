                {
                    "sense_id": "f4df00b2-a08b-382e-90ba-e03aa7454ff9",
                    "sense_definition": "Faire, traiter ou conclure quelque chose rapidement, souvent sans grand soin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rapidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a voulu <w>expédier</w> son travail pour pouvoir partir plus tôt en week-end.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>rush</w> through his work so that he could leave earlier for the weekend.",
                                "ru": "Он хотел как можно быстрее <w>покончить</w> с работой, чтобы пораньше уехать на выходные.",
                                "de": "Er wollte seine Arbeit schnell <w>erledigen</w>, um am Wochenende früher gehen zu können.",
                                "es": "Quiso <w>despachar</w> su trabajo para poder marcharse antes el fin de semana.",
                                "zh": "他想把工作<w>草草完成</w>，好早点去过周末。"
                            }
                        },
                        {
                            "text": "Le ministre continue d'<w>expédier</w> les affaires courantes en attendant la nomination du gouvernement.",
                            "target_lang_translations": {
                                "en": "The minister continues to <w>dispatch</w> routine business while awaiting the appointment of the government.",
                                "ru": "Министр продолжает <w>решать</w> текущие дела до назначения правительства.",
                                "de": "Der Minister <w>erledigt</w> weiterhin die laufenden Geschäfte, bis die Regierung ernannt wird.",
                                "es": "El ministro sigue <w>despachando</w> los asuntos corrientes a la espera del nombramiento del Gobierno.",
                                "zh": "在新政府任命之前，部长仍在<w>处理</w>日常事务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bâcler",
                        "régler",
                        "liquider"
                    ],
                    "antonyms": [
                        "approfondir",
                        "fignoler"
                    ],
                    "common_phrases": [
                        "expédier les affaires courantes",
                        "expédier le travail"
                    ],
                    "target_lang_definitions": {
                        "en": "To do, handle or finish something quickly, often without much care.",
                        "ru": "Быстро сделать, выполнить или закончить что-либо, часто без особой тщательности.",
                        "de": "Etwas rasch und oft ohne große Sorgfalt erledigen oder zum Abschluss bringen.",
                        "es": "Hacer o terminar algo deprisa, a menudo sin demasiado cuidado.",
                        "zh": "匆忙地做完或处理某事，常常不太用心。"
                    },
                    "translations": {
