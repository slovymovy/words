                ],
                "senses": [
                    {
                        "sense_id": "63543ed1-d2ce-3cba-a126-5a19dafb15bb",
                        "entry_id": "793dece0-7b01-3f55-ac92-ec5dbfe6fbe1",
                        "glosses": [
                            "следить за сохранностью, безопасностью кого-либо, чего-либо, охранять кого-либо, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11fc88cf-bf9d-4359-a4e9-d108c40f82a8",
                                "sense_id": "63543ed1-d2ce-3cba-a126-5a19dafb15bb",
                                "text": "Если б я сказал, что наседка не так зорко стережёт своих птенцов от злого коршуна, я сделал бы неправильное заключение."
                            },
                            {
                                "example_id": "a7fe13a8-1759-482e-a130-f1d7e65e28d3",
                                "sense_id": "63543ed1-d2ce-3cba-a126-5a19dafb15bb",
                                "text": "Рассказывают, будто одна полуумная пастушка стерегла стадо свиней не далече от сего уединенного места."
                            }
                        ]
                    },
                    {
                        "sense_id": "6765d3fb-b5fc-3f19-8077-4af9db22ee25",
                        "entry_id": "793dece0-7b01-3f55-ac92-ec5dbfe6fbe1",
                        "glosses": [
                            "сторожить, караулить кого-либо, не давая уйти, убежать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "035bb007-5343-43f3-9b8f-a323fc95524e",
                                "sense_id": "6765d3fb-b5fc-3f19-8077-4af9db22ee25",
                                "text": "Невольника стерегли семеро турок (люди простые и в душе такие же разбойники, как и Кирджали); они уважали его, и с жадностию, общею всему Востоку, слушали его чудные рассказы."
                            },
                            {
                                "example_id": "4478e09c-9968-4885-8e9f-ea44cefbcde9",
                                "sense_id": "6765d3fb-b5fc-3f19-8077-4af9db22ee25",
                                "text": "Конвой стерёг нас, укрывшись под \"грибом \" — известным лагерным сооружением."
                            }
                        ]
                    },
                    {
                        "sense_id": "14698c89-4277-3813-b0d0-af2d99fdf207",
                        "entry_id": "793dece0-7b01-3f55-ac92-ec5dbfe6fbe1",
                        "glosses": [
                            "стоять на страже, нести охрану"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4784bb79-70a5-4d1a-be75-c30e6edddc75",
                                "sense_id": "14698c89-4277-3813-b0d0-af2d99fdf207",
                                "text": "Дорога с ходу втискивается в проход меж скал, но узкое место стерегут боевики."
                            },
                            {
                                "example_id": "63d058e1-4840-4523-b705-753be48d65ec",
                                "sense_id": "14698c89-4277-3813-b0d0-af2d99fdf207",
                                "text": "В селе у нас свадьба: священник выдает замуж поповну, и все наши туда отозваны, а меня, вишь, оставили стеречь дворец."
                            }
                        ]
                    },
                    {
                        "sense_id": "78464e1a-603e-3a84-96b6-faa633b53a69",
                        "entry_id": "793dece0-7b01-3f55-ac92-ec5dbfe6fbe1",
                        "glosses": [
                            "выжидать появления кого-либо, чего-либо, выслеживать, подстерегать кого-либо, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e02a84dc-1670-4052-947c-2f4b187126f8",
                                "sense_id": "78464e1a-603e-3a84-96b6-faa633b53a69",
                                "text": "Путеводитель его, Девлет-Гирей, умышленно вёл турков местами безводными, голодною пустынею, где кони и люди умирали от изнурения; где черкесы стерегли их в засадах и томных, полумёртвых брали в плен; где россияне могли бы совершенно истребить сие жалкое войско, если бы они не следовали правилу, что надобно давать волю бегущему неприятелю."
                            }
                        ]
                    }
