                "senses": [
                    {
                        "sense_id": "67bf5cf2-ed31-3370-8fb9-84fc22597234",
                        "entry_id": "d77dcb91-ac48-3acd-b97d-62f9c7a19847",
                        "glosses": [
                            "Flächenmaß, das der Fläche eines Quadrats mit der Seitenlänge eines Fußes^([4]) entspricht; etwa 0,1 Quadratmeter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67559b67-3d86-47c7-be92-5d3f4b6ce97f",
                                "sense_id": "67bf5cf2-ed31-3370-8fb9-84fc22597234",
                                "text": "„Leder wird in Quadratfuß gemessen.“"
                            },
                            {
                                "example_id": "1f70fef1-74fc-4854-835d-5e6bd325d579",
                                "sense_id": "67bf5cf2-ed31-3370-8fb9-84fc22597234",
                                "text": "„Der Quadratfaden hat 9 Quadratellen oder 36 Quadratfuß. Die Quadratelle 4 Quadratfuß oder 576 Quadratzoll.“"
                            },
                            {
                                "example_id": "f1d77857-6f90-4506-8d48-10197cf6af3d",
                                "sense_id": "67bf5cf2-ed31-3370-8fb9-84fc22597234",
                                "text": "„Fünfzig Schritt von dem Zimmer entfernt, in dem wir waren, gelangten wir, nachdem wir eine Flucht von fünf oder sechs weiteren Räumen durchquert hatten, in ein Kabinett, in dessen einer Ecke eine Öffnung von vier Quadratfuß war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6d1cdd3-d3ee-4f52-9207-ecd192d3656a",
                        "source_entry_id": "d77dcb91-ac48-3acd-b97d-62f9c7a19847",
                        "source_sense_id": "67bf5cf2-ed31-3370-8fb9-84fc22597234",
                        "target_lang_word": "square foot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "square foot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4cd2c5f-0ddd-3d00-9d9d-91945743e9b7",
                                        "entry_id": "53c2a03a-d820-3464-980b-c1a2e64a7759",
                                        "glosses": [
                                            "A unit of area, regardless of its shape, equal to the area of a square whose sides are one foot long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910c8f08-d308-42e7-8749-5d5b78fc3b53",
                                                "sense_id": "e4cd2c5f-0ddd-3d00-9d9d-91945743e9b7",
                                                "text": "In 1973, we built a new factory in Tahsi in Taoyuan County, which occupied an area of 600,000 square feet."
                                            },
                                            {
                                                "example_id": "a2ec4f29-2c36-4782-a56d-eb77340bbd60",
                                                "sense_id": "e4cd2c5f-0ddd-3d00-9d9d-91945743e9b7",
                                                "text": "At No. 3 Staunton Street in the city’s SoHo district, the roughly 1,300 square-foot ground floor was once used as a parking space for a Ferrari."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7370219-9e1a-4312-ae92-69cfd22f9384",
                        "source_entry_id": "d77dcb91-ac48-3acd-b97d-62f9c7a19847",
                        "source_sense_id": "67bf5cf2-ed31-3370-8fb9-84fc22597234",
