                "senses": [
                    {
                        "sense_id": "3d32b53a-2c4e-3fc6-8510-1839a00d00ea",
                        "entry_id": "78fe1131-7b59-39d3-8302-9fdf7eced53c",
                        "glosses": [
                            "Qui a un rapport aux hormones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf65c8ba-fc84-43da-bacf-31f147309905",
                                "sense_id": "3d32b53a-2c4e-3fc6-8510-1839a00d00ea",
                                "text": "L’ANPCEN, qui s'alarme en outre du boom des LED produisant une lumière très blanche, souligne l’impact environnemental et sanitaire de la pollution lumineuse, chez les animaux (orientation et reproduction perturbées) comme chez les hommes (dérèglement de l'horloge biologique, qui régule fonctions biologiques et hormonales)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0f63b9b-1315-4fc8-872a-a33c786b88fe",
                        "source_entry_id": "78fe1131-7b59-39d3-8302-9fdf7eced53c",
                        "source_sense_id": "3d32b53a-2c4e-3fc6-8510-1839a00d00ea",
                        "target_lang_word": "hormonell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hormonell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73affd13-d2a6-3ef6-8a78-9116dee08486",
                                        "entry_id": "15088a18-28ec-3fc4-b566-08f55c9675c9",
                                        "glosses": [
                                            "die Hormone betreffend; auf Hormonen beruhend; aus Hormonen bestehend"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a33a015-aee1-4a5c-ae4c-73c7262401f3",
                                                "sense_id": "73affd13-d2a6-3ef6-8a78-9116dee08486",
                                                "text": "Doch ob Sonnenschutzmittel, Zahnpasta oder Baby-Shampoo: Fast jedes dritte Kosmetikprodukt in Deutschland enthält hormonell wirksame Chemikalien."
                                            },
                                            {
                                                "example_id": "e6326893-4852-4d26-b613-f7ae2f74fb53",
                                                "sense_id": "73affd13-d2a6-3ef6-8a78-9116dee08486",
                                                "text": "Störungen des hormonellen Gleichgewichts während und nach den Wechseljahren können deshalb auch den Mund betreffen und zu Erkrankungen der Schleimhäute (Gingivitis) und des Zahnhalteapparates (Parodontitis) führen."
                                            },
                                            {
                                                "example_id": "c45829f8-5f8c-4e0d-b0c7-e630ff1fea65",
                                                "sense_id": "73affd13-d2a6-3ef6-8a78-9116dee08486",
                                                "text": "Die gute Nachricht: Die hormonelle Verhütung für den Mann funktioniert. Die schlechte: Sie ist wahrscheinlich mit deutlichen Nebenwirkungen verbunden."
                                            },
                                            {
                                                "example_id": "5ed046b8-9b8a-41d3-90b9-a8bcbc57b0b1",
                                                "sense_id": "73affd13-d2a6-3ef6-8a78-9116dee08486",
                                                "text": "Die hormonellen Veränderungen haben auch Auswirkungen auf die Psyche."
                                            },
                                            {
                                                "example_id": "49cd78d5-afde-4f15-9008-704532762a54",
                                                "sense_id": "73affd13-d2a6-3ef6-8a78-9116dee08486",
                                                "text": "In der naturheilkundlich ganzheitlichen Therapie geht es nun darum, die genauen Ursachen für hormonelle Beschwerden herauszufinden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
