                                "target_senses": [
                                    {
                                        "sense_id": "9371a0e2-fce5-3f71-b223-a8abb35e7074",
                                        "entry_id": "f42e8591-8240-3ee6-a8f3-8e6ca7d36ae4",
                                        "glosses": [
                                            "Pronunciation spelling of nigger."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated",
                                            "ethnic",
                                            "offensive",
