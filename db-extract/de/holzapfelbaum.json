                "senses": [
                    {
                        "sense_id": "92515732-68fb-3e54-8154-6f61aa6d6c30",
                        "entry_id": "464c9fc7-1cd9-3134-923f-c437185239d5",
                        "glosses": [
                            "Obstbaum, der Holzäpfel als Früchte trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81562db3-8f16-42b7-a50c-c19215461fbe",
                                "sense_id": "92515732-68fb-3e54-8154-6f61aa6d6c30",
                                "text": "„Er nahm das Gewehr, das er an einen Holzapfelbaum gelehnt hatte, ging seitlich am Haus entlang bis zu einer niedrigen Mauer aus Hohlblöcken und folgte ihr an der Wäscheleine und dem Kohlehaufen vorbei bis zu einer Stelle, von der aus er zum Fenster hineinschauen konnte.“"
                            },
                            {
                                "example_id": "2822c768-ea0f-42a2-bae3-e036ef2c1a33",
                                "sense_id": "92515732-68fb-3e54-8154-6f61aa6d6c30",
                                "text": "„Neben der Garage erkannte er seinen geliebten Bronco, auf Blöcken aufgebockt, unten halb vom Unkraut überwachsen und oben beschichtet mit den Resten all dessen, was vom Holzapfelbaum daneben in den letzten 20 Jahren auf ihn herabgefallen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
