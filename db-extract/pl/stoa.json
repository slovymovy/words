                                "target_senses": [
                                    {
                                        "sense_id": "1c32099b-b7fe-3a8b-91c2-fbf259f209f5",
                                        "entry_id": "dbae7d65-d514-35d5-b963-469eb97f8e2b",
                                        "glosses": [
                                            "дееприч. от стоить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94645d26-4232-470a-85c6-ca97bb0d685b",
                                                "sense_id": "1c32099b-b7fe-3a8b-91c2-fbf259f209f5",
                                                "text": "Вызванная этими разрушениями задержка противника, не стоя ни капли крови, позволила выиграть два месяца времени."
