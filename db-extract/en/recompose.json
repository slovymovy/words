                        "sense_id": "cb2edb55-47c4-3870-b592-24d5058a8f8f",
                        "entry_id": "34a288f3-16b0-38bd-b0c6-46b7799d01d0",
                        "glosses": [
                            "To compose or construct again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "07b69e1a-b16a-418f-88a0-ac3948ac4ae7",
                                "sense_id": "cb2edb55-47c4-3870-b592-24d5058a8f8f",
                                "text": "to dissolve and recompose a substance"
                            },
                            {
                                "example_id": "61314348-d88f-4233-a4cc-0facd269d250",
                                "sense_id": "cb2edb55-47c4-3870-b592-24d5058a8f8f",
                                "text": "So far as we can recompose, from the broken fragments of tradition, a picture of the religious and political condition of the Eleusinian people in the olden time"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8982ccc-3abe-391a-befb-b994eadc0327",
                        "entry_id": "34a288f3-16b0-38bd-b0c6-46b7799d01d0",
                        "glosses": [
                            "To bring (oneself) back to a state of calm."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "beb7f713-8735-45af-b2b9-25e176e1b04e",
                                "sense_id": "f8982ccc-3abe-391a-befb-b994eadc0327",
                                "text": "Mr Blifil, I am confident, understands himself better than to think of seeing my niece any more this morning, after what hath happened. Women are of a nice contexture; and our spirits, when disordered, are not to be recomposed in a moment."
                            }
                        ]
                    }
