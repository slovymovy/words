                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d45d038a-75a4-4565-9dac-70570ea29c6f",
                        "source_entry_id": "00f8fd52-ce39-3517-8d9a-ce163d82f073",
                        "source_sense_id": "a2c86ce1-d86f-3398-98e9-fdecc8dd99d9",
