                        "glosses": [
                            "Additionner d’alcool pour augmenter le degré alcoolique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee6a813-ea6b-45d3-aafa-91343fe2423a",
                                "sense_id": "bc80343f-de66-369d-bd6f-3597b4ca2f84",
                                "text": "Dans le texte admis, nous ne sommes pas armés pour poursuivre la mauvaise qualité de l'alcool qui sert à suralcooliser ces vins."
                            },
