                                "target_senses": [
                                    {
                                        "sense_id": "202cab8d-666d-3e2e-a6ff-8ebb82e8ffdc",
                                        "entry_id": "d02ab9c7-4077-3ad0-b996-8c0b2d865c41",
                                        "glosses": [
                                            "The action of competing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d839f6-6ce8-47c0-87ce-6da06ff0161c",
                                                "sense_id": "202cab8d-666d-3e2e-a6ff-8ebb82e8ffdc",
                                                "text": "The competition for this job is strong."
                                            },
                                            {
                                                "example_id": "e88702e2-c917-4813-b688-f06eca1ca8a6",
                                                "sense_id": "202cab8d-666d-3e2e-a6ff-8ebb82e8ffdc",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3527c88a-27aa-3e7b-9d6b-74503d94fc36",
                                        "entry_id": "d02ab9c7-4077-3ad0-b996-8c0b2d865c41",
                                        "glosses": [
                                            "A contest for a prize or award."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8379afb-3380-4061-bb78-6dff443b1029",
                                                "sense_id": "3527c88a-27aa-3e7b-9d6b-74503d94fc36",
                                                "text": "The newspaper is featuring a competition to win a car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97079ce5-afc0-394f-b53b-1529f30a28a4",
                                        "entry_id": "d02ab9c7-4077-3ad0-b996-8c0b2d865c41",
                                        "glosses": [
                                            "The competitors in such a contest."
                                        ],
                                        "tags": [
                                            "collective",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b19f1b4-d6a0-4f58-a1fd-66cbe2ba2044",
                                                "sense_id": "97079ce5-afc0-394f-b53b-1529f30a28a4",
                                                "text": "The new stain remover was ten times more effective than the competition."
                                            },
                                            {
                                                "example_id": "1092e299-b707-42fb-b1a6-836972b0ece6",
                                                "sense_id": "97079ce5-afc0-394f-b53b-1529f30a28a4",
                                                "text": "Japanese retail stores have strove to, and have succeeded in, fulfilling these severe demands, and in doing so, have constantly had to innovate both technologically and institutionally in order to keep up with the competition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "002cc739-6ac1-45ad-9695-6619d6ff7af4",
                        "source_entry_id": "832346fe-30f7-3a83-adbf-72de88964eea",
                        "source_sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                        "target_lang_word": "concurrence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concurrence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d927700c-07d5-3d9d-b643-4f29be547280",
                                        "entry_id": "168a0dec-f03b-3d51-8283-73d8dee98f1c",
                                        "glosses": [
                                            "Compétition de plusieurs personnes qui recherchent un même objet, une même chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ece1e4d8-f275-4434-8bd7-d557e7cd4a4d",
                                                "sense_id": "d927700c-07d5-3d9d-b643-4f29be547280",
                                                "text": "Nous voyons ainsi que la conviction se fonde sur la concurrence de communions, dont chacune se considère comme étant l’armée de la vérité ayant à combattre les armées du mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                        "entry_id": "168a0dec-f03b-3d51-8283-73d8dee98f1c",
                                        "glosses": [
                                            "Rivalité qui s’établit entre fabricants, marchands, entrepreneurs ou produits, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc1fe3b-e241-4367-921a-1d4ceeb3bc18",
                                                "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                                "text": "L'œuvre de l’Industriel français qui pousse à l’association des petits contre l’implacable et mortelle concurrence des monopoleurs n'en est pas moins fort encourageable."
                                            },
                                            {
                                                "example_id": "4c5d5966-01a6-4acc-9cf4-ce8d57c5db72",
                                                "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                                "text": "De toutes parts, on m'offre de la main-d'œuvre, brodeuses déjà habiles ou simples apprentières. Je découvre ainsi que ce métier, jadis excellent, a beaucoup perdu, la machine fait une concurrence acharnée, les salaires sont bien réduits."
                                            },
                                            {
                                                "example_id": "604fb937-28e8-4489-a43f-5a6d6ea5933e",
                                                "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                                "text": "Le dernier siècle a détruit, sans rien leur substituer, les corporations anciennes qui étaient pour eux une protection. Les sentiments religieux du passé ont disparu des lois et des institutions publiques et ainsi, peu à peu, les travailleurs isolés et sans défense se sont vu, avec le temps, livrer à la merci de maîtres inhumains et à la cupidité d'une concurrence effrénée. Une usure dévorante est venue accroître encore le mal."
                                            },
                                            {
                                                "example_id": "dcf2f495-5781-4941-bfba-6224e48c12b6",
                                                "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                                "text": "Les amis de Jaurès, les cléricaux et les démocrates placent leur idéal de l’avenir dans le Moyen Âge : ils voudraient que la concurrence fût tempérée, que la richesse fût limitée, que la pro­duction fût subordonnée aux besoins. Ce sont des rêveries que Marx regardait comme réactionnaires."
                                            },
                                            {
                                                "example_id": "b21114e0-95c7-42ec-ae87-31c96c7dfd16",
                                                "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                                "text": "Puis, en grosses lettres, cette phrase : « Plus il y aura d'acheteurs de blé, meuniers ou négociants, plus les agriculteurs vendront le leur facilement et cher. »\nIl est hors de contestation que, si des éléments de concurrence nouveaux devaient surgir, le cultivateur y trouverait son compte."
                                            },
                                            {
                                                "example_id": "8b9cdc35-81e5-4f94-ab35-182f88efebe0",
                                                "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                                "text": "Apple a construit son succès sur un écosystème fermé autour des iPhone et iPad dont il contrôle tous les paramètres, invoquant des impératifs de sécurité et le confort accru des utilisateurs — une philosophie en opposition frontale avec les règles européennes de concurrence."
                                            },
                                            {
                                                "example_id": "f7cf303d-e97b-464c-9fdc-c266c0b1db5a",
                                                "sense_id": "89aa7d02-de6f-36e4-b0a1-426b0c24127e",
                                                "text": "Depuis quelques années, cependant, l’yoghourt fait au képhir une sérieuse concurrence. Il se recommande aux estomacs délicats par sa très faible teneur en alcool, et, à la suite de l'identification de l'agent microbien qui le produit, on est arrivé à le préparer très facilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca95e581-3c44-32c5-a716-f79bb60ba23c",
                                        "entry_id": "168a0dec-f03b-3d51-8283-73d8dee98f1c",
                                        "glosses": [
                                            "Compétition entre animaux ou entre plantes, pour occuper une même niche écologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c99d059e-2e97-4f9a-8453-8998ce79fa3c",
                                                "sense_id": "ca95e581-3c44-32c5-a716-f79bb60ba23c",
                                                "text": "Ce graminicide, très sélectif pour le blé et le colza, agit par arrêt de la croissance des cellules déjà formées; la concurrence exercée par la culture entraîne alors la destruction de la mauvaise herbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bd2215e-2ed2-3ccf-a528-c0403324d0ef",
                                        "entry_id": "168a0dec-f03b-3d51-8283-73d8dee98f1c",
                                        "glosses": [
                                            "Égalité de droit, de privilège, d’hypothèque entre plusieurs personnes, sur une même chose."
                                        ],
                                        "tags": [
                                            "Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a96fdf5-e3d3-43f7-b16e-86089dd3bacc",
                                                "sense_id": "5bd2215e-2ed2-3ccf-a528-c0403324d0ef",
                                                "text": "Exercer une hypothèque en concurrence. — Venir en concurrence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9778ef16-53f1-39d4-a737-74879c6184ee",
                                        "entry_id": "168a0dec-f03b-3d51-8283-73d8dee98f1c",
                                        "glosses": [
                                            "Situation de deux fêtes religieuses dont les premières vêpres de l’une coïncident avec les secondes vêpres de l’autre."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c8def5-e582-4c0c-a067-085643e3ae32",
                                                "sense_id": "9778ef16-53f1-39d4-a737-74879c6184ee",
                                                "text": "Si le 8 décembre est un samedi, l’Immaculée conception et le deuxième dimanche de l’Avent sont en concurrence."
                                            },
                                            {
                                                "example_id": "3a7e496a-2536-4ace-bc79-a251412167d4",
                                                "sense_id": "9778ef16-53f1-39d4-a737-74879c6184ee",
                                                "text": "En cas de concurrence, les Vêpres du jour liturgique de classe supérieure l’emportent, et les autres sont commémorées ou non, selon les rubriques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd7af42-f8cd-388c-9c28-27f12a1639b2",
                                        "entry_id": "168a0dec-f03b-3d51-8283-73d8dee98f1c",
                                        "glosses": [
                                            "Exécution de plusieurs tâches ou fils d’exécution en parallèle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
