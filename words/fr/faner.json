            "senses": [
                {
                    "sense_id": "f0d045f2-808f-384d-8b64-56abac456fea",
                    "sense_definition": "Faire perdre ou perdre sa fraîcheur et sa vigueur, en parlant d'un végétal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans eau, les jolies roses du jardin vont vite se <w>faner</w>."
                        },
                        {
                            "text": "La chaleur intense de l'été a fini par <w>faner</w> toutes les plantes du balcon."
                        }
                    ],
                    "synonyms": [
                        "flétrir",
                        "défleurir"
                    ],
                    "common_phrases": [
                        "se faner"
                    ]
                },
                {
                    "sense_id": "360e094b-32fb-3a75-a689-d3ae2864629d",
                    "sense_definition": "Perdre son éclat, sa jeunesse ou sa vitalité au cours du temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "declin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec les années qui passent, l'éclat de sa jeunesse a commencé à se <w>faner</w>."
                        },
                        {
                            "text": "Même si certains souvenirs se <w>fanent</w>, cette belle histoire reste gravée dans son cœur."
                        }
                    ],
                    "synonyms": [
                        "défraîchir",
                        "passer"
                    ],
                    "common_phrases": [
                        "beauté qui se fane"
                    ]
                },
                {
                    "sense_id": "87067534-35ab-32b8-88bb-c357c09b5a5c",
                    "sense_definition": "Altérer ou faire perdre l'éclat d'une couleur ou la fraîcheur du teint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "declin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une exposition trop forte au soleil a complètement <w>fané</w> les rideaux du salon."
                        },
                        {
                            "text": "Les nuits blanches et la fatigue permanente risquent de lui <w>faner</w> le teint."
                        }
                    ],
                    "synonyms": [
                        "défraîchir"
                    ],
                    "common_phrases": [
                        "faner le teint"
                    ]
                },
                {
                    "sense_id": "a3942976-14da-31d9-aabb-f35dd0980438",
                    "sense_definition": "Retourner l'herbe fauchée pour la faire sécher et la transformer en foin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agriculteur profite de la belle météo pour <w>faner</w> l'herbe de son pré."
                        },
                        {
                            "text": "Dès le lever du jour, les ouvriers vont <w>faner</w> le foin dans la prairie."
                        }
                    ],
                    "common_phrases": [
