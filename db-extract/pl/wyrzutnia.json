                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8745f872-495e-459d-851a-2736d9084dde",
                        "source_entry_id": "30fa4e0c-d417-385d-acd6-c3d203518f9a",
