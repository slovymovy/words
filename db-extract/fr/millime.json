                "senses": [
                    {
                        "sense_id": "64f03b44-e60a-38cd-97f4-1420ee54fc9c",
                        "entry_id": "5ed5f643-0d71-3f82-ae92-ac682f448ca8",
                        "glosses": [
                            "Millième partie d’une monnaie, en particulier dans le cas du dinar tunisien."
                        ],
                        "tags": [
                            "Système monétaire"
                        ],
                        "examples": [
                            {
                                "example_id": "a1c6d563-4fd5-4eb4-b43a-cf70e67a20f5",
                                "sense_id": "64f03b44-e60a-38cd-97f4-1420ee54fc9c",
                                "text": "Et il lui offrit en location un coin de son jardin pour y cultiver des légumes, à raison de cinq francs par an, payables… par petites fractions tous les jours. Cela donnait la rente mirifique de treize centimes et quelques millimes par jour. Un capitaliste quoi !"
                            },
                            {
                                "example_id": "4de1f671-85a8-4abd-9bac-fc5aa250c730",
                                "sense_id": "64f03b44-e60a-38cd-97f4-1420ee54fc9c",
                                "text": "Quant au millime, il a été frappé en 1917 à l’époque du Sultan Hussein Kamel et son nom vient de France pour le mot français “Millième” qui signifie une partie de mille, la livre correspondait donc à 1000 millièmes."
                            },
                            {
                                "example_id": "063a0a2a-806d-46f8-8d02-6c187960706c",
                                "sense_id": "64f03b44-e60a-38cd-97f4-1420ee54fc9c",
                                "text": "231 dinar 296 millimes."
                            },
                            {
                                "example_id": "e2e6c2ad-618d-49ca-b926-a56daed57af2",
                                "sense_id": "64f03b44-e60a-38cd-97f4-1420ee54fc9c",
                                "text": "Un euro quatre cent cinquante neuf millimes, et par ellipse: Un euro quatre cent cinquante neuf."
                            }
                        ]
                    },
                    {
