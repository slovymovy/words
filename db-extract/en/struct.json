                                    {
                                        "sense_id": "9d23c4aa-dff7-3277-a8b1-30a392420c36",
                                        "entry_id": "8fbb9843-58e0-3585-b021-33addab5b9dc",
                                        "glosses": [
                                            "etwas Aufgebautes, aus mehreren Teilen bestehendes und von seinen Einzelteilen abhängiges Gefüge"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf70f9a-3f36-4f60-8225-6e9114794220",
                                                "sense_id": "9d23c4aa-dff7-3277-a8b1-30a392420c36",
                                                "text": "Das mittelgroße Unternehmen hat klare Strukturen und eine schriftlich festgehaltene Strategie."
                                            },
                                            {
                                                "example_id": "c8ebd6f7-6a30-4f5f-8adf-485624dad969",
                                                "sense_id": "9d23c4aa-dff7-3277-a8b1-30a392420c36",
                                                "text": "„Inzwischen hat sich die Struktur jedoch auch in der Geschichtswissenschaft als Schlüsselbegriff etabiert.“"
                                            },
                                            {
                                                "example_id": "cd247c82-84e9-4e5c-8599-3d6975876b3b",
                                                "sense_id": "9d23c4aa-dff7-3277-a8b1-30a392420c36",
                                                "text": "Lineare Gleichungen sind von besonders einfacher Struktur und deswegen leicht zu handhaben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98614e61-b59a-382c-aaa7-f8177e530fac",
                                        "entry_id": "8fbb9843-58e0-3585-b021-33addab5b9dc",
                                        "glosses": [
                                            "das Aussehen einer Sache, die Beschaffenheit einer Oberfläche oder Musterung, zum Beispiel bei Textilien sowie Tapeten"
                                        ],
                                        "tags": [
                                            "ohne Mehrzahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64f26df-919e-4c36-8a38-0beef5b3d4b6",
                                                "sense_id": "98614e61-b59a-382c-aaa7-f8177e530fac",
                                                "text": "Die Tapete hat eine interessante Struktur, das gefällt mir."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58aa156c-3241-3d22-8b4e-56dc9823882e",
                                        "entry_id": "8fbb9843-58e0-3585-b021-33addab5b9dc",
                                        "glosses": [
                                            "Menge mit bestimmten Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47def9ac-3361-4f00-9a09-7b1178a01d30",
                                                "sense_id": "58aa156c-3241-3d22-8b4e-56dc9823882e",
                                                "text": "Was ein Verband ist, kann man auf unterschiedliche Weisen definieren, nämlich als spezielle geordnete Menge oder als algebraische Struktur."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fdcb75a7-b996-3193-a0fe-3f80634fc45b",
                                        "entry_id": "8fbb9843-58e0-3585-b021-33addab5b9dc",
                                        "glosses": [
                                            "abstrakter innerer Aufbau einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c451f7-8aa8-4bee-9172-e854d437e096",
                                                "sense_id": "fdcb75a7-b996-3193-a0fe-3f80634fc45b",
                                                "text": "Die Struktur einer Sprache ist oftmals schwer nachzuvollziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0b342c5a-4de8-3a12-ace8-1ec433c34d5f",
                                        "entry_id": "8fbb9843-58e0-3585-b021-33addab5b9dc",
                                        "glosses": [
                                            "Art der Zusammensetzung eines Systems^([2]) aus Elementen und Menge der Relationen beziehungsweise Operationen, welche die Elemente miteinander verknüpfen"
                                        ],
                                        "tags": [
                                            "Systemtheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee78c1f-a91b-4198-8959-a7ad31698d94",
                                                "sense_id": "0b342c5a-4de8-3a12-ace8-1ec433c34d5f",
                                                "text": "Die Globalisierung führt zu einem unaufhörlichen Wandel wirtschaftlicher Strukturen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
