                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b0938b-4d05-4d81-956a-4ed876dee46a",
                                "sense_id": "d4aaaf27-e256-3550-8a1e-23c96969cac5",
                                "text": "Вышибить револьвер из рук бандита."
                            },
                            {
                                "example_id": "64fdbbcc-100a-4e02-acc7-3bdfb93c244d",
                                "sense_id": "d4aaaf27-e256-3550-8a1e-23c96969cac5",
                                "text": "Вышибить дверь."
                            },
                            {
                                "example_id": "19fa7259-7c11-44e8-95cc-9f2333cad363",
                                "sense_id": "d4aaaf27-e256-3550-8a1e-23c96969cac5",
                                "text": "Вышибить зуб, своротить скулу, раскровянить лицо чабану ― то же, что выкурить папиросу."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b4283be-0754-3086-b8b4-b1281e73f524",
                        "entry_id": "4ec5fb05-d27a-367a-b0bd-73475066a85a",
                        "glosses": [
                            "разг., вульг. грубо вытолкать, выгнать"
                        ],
                        "tags": [],
                        "examples": [
                            {
