                                                "sense_id": "45fb217a-ddd9-3e9a-a0bc-7b022679f75e",
                                                "text": "Eine Sonnenfinsternis ist im 21. Jahrhundert ein vorhersehbares Ereignis."
                                            },
                                            {
                                                "example_id": "ad56d483-15fb-4366-b729-2b15f0955095",
                                                "sense_id": "45fb217a-ddd9-3e9a-a0bc-7b022679f75e",
                                                "text": "Der Amoklauf des Familienvaters war nicht vorhersehbar."
                                            },
                                            {
                                                "example_id": "ca71314a-ea30-40c8-89bc-a85aa6c9fd6b",
                                                "sense_id": "45fb217a-ddd9-3e9a-a0bc-7b022679f75e",
                                                "text": "„Der Vorteil einer progressiven Kapitalsteuer liegt darin, mit den unterschiedlichsten Situationen auf flexible, konsistente, vorhersehbare Weise umgehen zu können, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
