                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7074ef2-206b-30e4-a0e8-32fd0ced9fed",
                        "entry_id": "aa042df3-2a2f-30a5-84de-73a812d748cc",
                        "glosses": [
                            "Aktion, bei der jemand Mut beweisen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e14948b2-bb12-4711-a1dd-5f9175732132",
                                "sense_id": "e7074ef2-206b-30e4-a0e8-32fd0ced9fed",
                                "text": "„Alles war schließlich darauf hinausgelaufen, Schefold in eine Mutprobe zu treiben.“"
                            },
                            {
                                "example_id": "c0095755-55d8-46c6-9620-b788aed000b8",
                                "sense_id": "e7074ef2-206b-30e4-a0e8-32fd0ced9fed",
                                "text": "„Ziel von Challenges ist Aufmerksamkeit, die von Mutproben Überwindung. Damit bilden Challenges anders als Mutproben nicht den Charakter, sondern höchstens Verletzungen und Fan-Community. Challenges brauche es Warwitz zufolge weniger (er nennt sie „Dummheiten“), Mutproben mehr.“"
                            },
                            {
                                "example_id": "06690f05-4edf-4f5f-9014-849e055b4ccc",
                                "sense_id": "e7074ef2-206b-30e4-a0e8-32fd0ced9fed",
                                "text": "„Die Folgen mancher Mutprobe ihres Kindes kann für Eltern eine teure Angelegenheit werden.“"
                            },
                            {
                                "example_id": "a7836fd4-2849-4406-8fc7-143cec182a6f",
                                "sense_id": "e7074ef2-206b-30e4-a0e8-32fd0ced9fed",
                                "text": "„Ein Protest gegen die Regierung von Nicolas Maduro soll eine lebensgefährliche Mutprobe sein.“"
                            },
                            {
                                "example_id": "d435373d-6d24-46b7-8a46-dcc889ac14f4",
                                "sense_id": "e7074ef2-206b-30e4-a0e8-32fd0ced9fed",
                                "text": "„Unsere Befragung erbrachte zahlreiche Beispiele dafür, dass sich Kinder und Jugendliche im Sog des Imponiergehabes in Banden und Cliquen häufig auf Mutproben einlassen, die sie eigentlich gar nicht verantworten können und wagen möchten.“"
                            },
                            {
                                "example_id": "db7ee5d8-0503-478f-9dee-777f30f12798",
                                "sense_id": "e7074ef2-206b-30e4-a0e8-32fd0ced9fed",
                                "text": "„Die Moderatoren, das waren Dietmar Schönherr und Vivi Bach: Sie mit Angst vor dem Millionenpublikum, er mit einem ordentlichen Schuss Provokation und beide mit überraschenden Ratespielen und Mutproben, zumeist von Kreativmeister André Heller ersonnen und von Michael Pfleghar (Klimbim) inszeniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
