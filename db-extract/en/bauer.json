                            {
                                "example_id": "f56b42dd-8b5a-43cf-9e80-ebbddd8e4724",
                                "sense_id": "b0c077d7-be40-361e-a746-300ac0b8b612",
                                "text": "University of Massachusetts epidemiologist Ann Bauer reviewed existing research in a paper published last month in the journal Environmental Health with Dr. Andrea Baccarelli, the dean of the Harvard T.H. Chan School of Public Health and researchers at the Icahn School of Medicine at Mount Sinai in New York City and the UCLA Fielding School of Public Health."
                            }
