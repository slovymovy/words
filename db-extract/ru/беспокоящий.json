                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a968c36-8024-34ae-8d09-0e65ab14288d",
                        "entry_id": "ae4ff9d7-a4b9-3257-97a7-53015c6ff89d",
                        "glosses": [
                            "действ. прич. наст. вр. от беспокоить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "b44b76d4-4a8f-4380-9a15-5a5e8c3f6d60",
                                "sense_id": "6a968c36-8024-34ae-8d09-0e65ab14288d",
                                "text": "В ней сделалась какая-то вызывающая красота, беспокоящая людей."
                            },
                            {
                                "example_id": "af2ea9b8-8f45-43d6-8f29-d701f8e127c1",
                                "sense_id": "6a968c36-8024-34ae-8d09-0e65ab14288d",
                                "text": "И когда в плоскости ленивой нашей мысли является что-то новое, беспокоящее, ― мы заботимся не о том, чтобы принять и доверчиво изучить новое а чтобы поскорее загнать его в темный угол души и похоронить там, ― пусть не мешает привычному прозябанию в бессильных надеждах, сереньких мечтах."
                            },
                            {
                                "example_id": "65d7ce5b-a75f-4cb6-86c2-00376e0843f9",
                                "sense_id": "6a968c36-8024-34ae-8d09-0e65ab14288d",
                                "text": "Музыка чувственная, незнакомая, беспокоящая."
                            },
                            {
                                "example_id": "6a8a29f2-b8c7-4b01-a03a-ea907a5fbded",
                                "sense_id": "6a968c36-8024-34ae-8d09-0e65ab14288d",
                                "text": "Беспокоящий его тесный воротничок как-то особенно подчеркивает вечную издерганность и встревоженность этого «человека воздуха»."
                            }
                        ]
                    }
                ],
