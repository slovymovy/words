    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e14f082-b258-3bf8-960c-5b99028f80ab",
                    "sense_definition": "Принимать горизонтальное положение на какой-либо поверхности.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я устал стоять и хочу <ложиться> на диван.",
                            "target_lang_translations": {
                                "en": "I am tired of standing and want to <lie down> on the sofa.",
                                "de": "Ich bin müde vom Stehen und möchte mich auf das Sofa <hinlegen>."
                            }
                        },
                        {
                            "text": "Собака медленно <ложится> на коврик у двери.",
                            "target_lang_translations": {
                                "en": "The dog slowly <lies down> on the mat by the door.",
                                "de": "Der Hund <legt> sich langsam auf die Matte an der Tür."
                            }
                        }
                    ],
                    "synonyms": [
                        "укладываться"
                    ],
                    "antonyms": [
                        "вставать"
                    ],
                    "common_phrases": [
                        "ложиться на пол",
                        "ложиться на спину",
                        "ложиться на живот"
                    ],
                    "target_lang_definitions": {
                        "en": "To assume a horizontal position on a surface.",
                        "de": "Eine horizontale Position auf einer Oberfläche einnehmen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lie down",
                                "target_lang_sense_clarification": "general physical action"
                            },
                            {
                                "target_lang_word": "lie",
                                "target_lang_sense_clarification": "short form"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich hinlegen",
                                "target_lang_sense_clarification": "allgemeine körperliche Handlung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "093c632f-7863-3cab-8f53-d24b53c37ab7",
                    "sense_definition": "Готовиться ко сну, занимать место в постели для сна.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Детям пора <ложиться> спать, потому что завтра рано вставать.",
                            "target_lang_translations": {
                                "en": "It is time for the children to <go to bed>, because they have to get up early tomorrow.",
                                "de": "Es ist Zeit für die Kinder, <schlafen zu gehen>, weil sie morgen früh aufstehen müssen."
                            }
                        },
                        {
                            "text": "Обычно я <ложусь> в одиннадцать часов вечера.",
                            "target_lang_translations": {
                                "en": "Usually I <go to bed> at eleven o'clock in the evening.",
                                "de": "Normalerweise <gehe> ich um elf Uhr abends <zu Bett>."
                            }
                        }
                    ],
                    "synonyms": [
                        "укладываться"
                    ],
                    "antonyms": [
                        "вставать"
                    ],
                    "common_phrases": [
                        "ложиться спать",
                        "ложиться рано",
                        "ложиться поздно"
                    ],
                    "target_lang_definitions": {
                        "en": "To get into bed in preparation for sleep.",
                        "de": "Sich zur Vorbereitung auf den Schlaf ins Bett begeben."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go to bed",
                                "target_lang_sense_clarification": "standard phrase"
                            },
                            {
                                "target_lang_word": "go to sleep",
                                "target_lang_sense_clarification": "focus on the act of sleeping"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zu Bett gehen",
                                "target_lang_sense_clarification": "Standardausdruck"
                            },
                            {
                                "target_lang_word": "schlafen gehen",
                                "target_lang_sense_clarification": "Fokus auf den Akt des Schlafens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a744888-a68c-3535-9f54-f1f7062100fb",
                    "sense_definition": "Поступать в стационарное лечебное заведение для лечения или обследования.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач сказал, что мне нужно <ложиться> в больницу на обследование.",
                            "target_lang_translations": {
                                "en": "The doctor said that I need to <be admitted> to the hospital for an examination.",
                                "de": "Der Arzt sagte, dass ich für eine Untersuchung ins Krankenhaus <gehen muss>."
                            }
                        },
                        {
                            "text": "Она не хотела <ложиться> в клинику перед праздниками.",
                            "target_lang_translations": {
                                "en": "She did not want to <go into> the clinic before the holidays.",
                                "de": "Sie wollte vor den Feiertagen nicht in die Klinik <gehen>."
                            }
                        }
                    ],
                    "antonyms": [
                        "выписываться"
                    ],
                    "common_phrases": [
                        "ложиться в больницу",
                        "ложиться на операцию",
                        "ложиться на обследование"
                    ],
                    "target_lang_definitions": {
                        "en": "To be admitted to a hospital or clinic for treatment.",
                        "de": "Zur Behandlung oder Untersuchung in ein Krankenhaus oder eine Klinik aufgenommen werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be admitted",
                                "target_lang_sense_clarification": "formal, passive voice"
                            },
                            {
                                "target_lang_word": "go into",
                                "target_lang_sense_clarification": "common usage"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ins Krankenhaus gehen",
                                "target_lang_sense_clarification": "allgemeiner Sprachgebrauch"
                            },
                            {
                                "target_lang_word": "stationär aufgenommen werden",
                                "target_lang_sense_clarification": "formeller, medizinischer Kontext"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93966dd1-31a6-3eb9-a839-b5df43fb54c3",
                    "sense_definition": "Покрывать собой поверхность (о снеге, тенях, краске, пыли).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Первый снег мягко <ложится> на холодную землю.",
                            "target_lang_translations": {
                                "en": "The first snow softly <falls> on the cold ground.",
                                "de": "Der erste Schnee <fällt> sanft auf die kalte Erde."
                            }
                        },
                        {
                            "text": "Длинные тени от деревьев <ложатся> на дорогу.",
                            "target_lang_translations": {
                                "en": "Long shadows from the trees <fall> on the road.",
                                "de": "Lange Schatten der Bäume <fallen> auf die Straße."
                            }
                        }
                    ],
                    "common_phrases": [
                        "снег ложится",
                        "тени ложатся",
                        "краска ложится"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover a surface or settle (of snow, shadows, paint, dust).",
                        "de": "Eine Oberfläche bedecken oder sich absetzen (von Schnee, Schatten, Farbe, Staub)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall",
                                "target_lang_sense_clarification": "snow, shadows"
                            },
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "dust, snow"
                            },
                            {
                                "target_lang_word": "go on",
                                "target_lang_sense_clarification": "paint, makeup"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fallen",
                                "target_lang_sense_clarification": "Schnee, Schatten"
                            },
                            {
                                "target_lang_word": "sich absetzen",
                                "target_lang_sense_clarification": "Staub, Schnee"
                            },
                            {
                                "target_lang_word": "auftragen",
                                "target_lang_sense_clarification": "Farbe, Make-up"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cebcefdc-73f5-31bf-bdba-c64ad03d0db8",
                    "sense_definition": "Становиться чьей-либо обязанностью, бременем или ответственностью.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся ответственность за этот проект <ложится> на руководителя.",
                            "target_lang_translations": {
                                "en": "All responsibility for this project <falls> on the manager.",
                                "de": "Die gesamte Verantwortung für dieses Projekt <fällt> auf den Leiter."
                            }
                        },
                        {
                            "text": "Забота о младших братьях <ложится> на её плечи.",
                            "target_lang_translations": {
                                "en": "The care of her younger brothers <falls> on her shoulders.",
                                "de": "Die Sorge um die jüngeren Brüder <lastet> auf ihren Schultern."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ложиться на плечи",
                        "ложиться бременем",
                        "ложиться на совесть"
                    ],
                    "target_lang_definitions": {
                        "en": "To become someone's duty, burden, or responsibility.",
                        "de": "Zur Pflicht, Last oder Verantwortung von jemandem werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall",
                                "target_lang_sense_clarification": "responsibility, blame"
                            },
                            {
                                "target_lang_word": "rest",
                                "target_lang_sense_clarification": "burden, weight"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fallen auf",
                                "target_lang_sense_clarification": "Verantwortung, Last"
                            },
                            {
                                "target_lang_word": "lasten auf",
                                "target_lang_sense_clarification": "Verantwortung, Bürde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d68d159e-a8f2-3421-86f2-0cf6bae102e7",
                    "sense_definition": "Принимать определённое направление движения (о судах, самолётах).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Корабль меняет направление и <ложится> на обратный курс.",
                            "target_lang_translations": {
                                "en": "The ship changes direction and <sets> a return course.",
                                "de": "Das Schiff ändert die Richtung und <schlägt> einen Rückkurs <ein>."
                            }
                        },
                        {
                            "text": "Во время шторма судно <ложится> в дрейф.",
                            "target_lang_translations": {
                                "en": "During the storm, the vessel <heaves> to.",
                                "de": "Während des Sturms <geht> das Schiff <in Drift>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ложиться на курс",
                        "ложиться в дрейф",
                        "ложиться на крыло"
                    ],
                    "target_lang_definitions": {
                        "en": "To take a specific direction or course (nautical/aviation).",
                        "de": "Eine bestimmte Richtung oder einen Kurs einschlagen (nautisch/luftfahrt)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "course"
                            },
                            {
                                "target_lang_word": "lie",
                                "target_lang_sense_clarification": "nautical term"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einschlagen",
                                "target_lang_sense_clarification": "Kurs festlegen"
                            },
                            {
                                "target_lang_word": "auf Kurs gehen",
                                "target_lang_sense_clarification": "nautischer Fachbegriff"
                            }
                        ]
                    }
                }
            ]
        }
    ]
