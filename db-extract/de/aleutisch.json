                "senses": [
                    {
                        "sense_id": "2c9f3c32-3a17-35a0-bc63-7bee9d5036f4",
                        "entry_id": "a766bc9b-a3c8-3e5d-abe2-514113d9722f",
                        "glosses": [
                            "Sprache, die unter anderem auf den Aleuten gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c028d594-b95e-4266-9f63-d1f21aa4d9ad",
                                "sense_id": "2c9f3c32-3a17-35a0-bc63-7bee9d5036f4",
                                "text": "„Knut Bergsland veröffentlichte 1994 ein komplettes Wörterbuch des Aleutischen.“"
                            },
                            {
                                "example_id": "6db82d0e-463a-4679-90ff-cf783ab80736",
                                "sense_id": "2c9f3c32-3a17-35a0-bc63-7bee9d5036f4",
                                "text": "„Indessen hatte unser Priester 92 der Insulaner auf ihren Wunsch und Bitte getauft, da er aber kein Aleutisch verstand, so konnte er sie freilich nicht gehörig unterweisen[.]“"
                            },
                            {
                                "example_id": "3a6b9ab1-0f33-4a9b-9332-c9ad694a360b",
                                "sense_id": "2c9f3c32-3a17-35a0-bc63-7bee9d5036f4",
                                "text": "„[…]die ursprüngliche eskimo-aleutische Ursprache zerfiel in Aleutisch und Eskimoisch, das heute weiter unterteilt wird in das westliche eigentliche Eskimoisch und das östliche Grönländisch[.]“"
                            },
                            {
                                "example_id": "ec66a966-ffc6-43be-a846-41b821cacf13",
                                "sense_id": "2c9f3c32-3a17-35a0-bc63-7bee9d5036f4",
                                "text": "„Die wenigen verbliebenen Bewohner der Aleutischen Inseln sprechen heute noch z. T. ein stark mit russischen Lehnworten versetztes Aleutisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
