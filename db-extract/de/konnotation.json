                        "form": "den Konnotationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a296eb1f-4299-3a07-ba59-9797e4e25ce6",
                        "entry_id": "924e619c-4f71-3dad-821f-bac87bf0930e",
                        "glosses": [
                            "Connotation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202ed266-b355-4b18-a4d9-b2895c14cb7b",
                                "sense_id": "a296eb1f-4299-3a07-ba59-9797e4e25ce6",
                                "text": "Konnotation wird in der Linguistik unter anderem als Gegenbegriff für Denotation verwendet. Mit \"Hund\" verbinden manche Menschen positive, andere negative Konnotationen. — La connotation en linguistique est, entre autres, le contraire de la dénotation. Avec le [mot] « chien », certaines personnes entendent des connotations positives, d’autres négatives."
                            }
                        ]
                    }
                ],
