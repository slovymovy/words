                    {
                        "sense_id": "7ebd7c6e-5adb-3701-aafc-80d910d080a4",
                        "entry_id": "bab681d9-ce7f-3e01-8e01-e764e42d2264",
                        "glosses": [
                            "A large wine bottle with the capacity of about 6 liters, equivalent to 8 standard bottles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ddc1c78d-009e-3f08-b2e1-a8a2b9bccea3",
                        "entry_id": "bab681d9-ce7f-3e01-8e01-e764e42d2264",
                        "glosses": [
                            "A small pattern that takes many generations to stabilize."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba74c36a-cbeb-4b2d-98a8-753336c955bf",
                                "sense_id": "ddc1c78d-009e-3f08-b2e1-a8a2b9bccea3",
                                "text": "The first known methuselah was the r pentomino, but even longer lasting ones have been found by enumerating and testing small patterns. The following, called \"rabbits,\" takes over 10000 generations to stabilize."
                            },
                            {
                                "example_id": "4ec3dc23-cc24-49b2-8e0c-3e482f3e045c",
                                "sense_id": "ddc1c78d-009e-3f08-b2e1-a8a2b9bccea3",
                                "text": "Is there somewhere a list of n-cell methuselah patterns in Conway's Life? (assuming some reasonable limits on the bounding box)"
                            },
                            {
                                "example_id": "740465a7-123b-4e46-aab5-5e494e5352b3",
                                "sense_id": "ddc1c78d-009e-3f08-b2e1-a8a2b9bccea3",
                                "text": "The pattern below seems to take about 30000 generations to stabilize. The initial population is 20. Is this methuselah a known one?"
                            }
                        ]
                    }
