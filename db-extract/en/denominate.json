                    {
                        "sense_id": "eb723420-1641-3a68-8bce-0688de267dd4",
                        "entry_id": "2508f3e9-0b3b-3ce4-b2e7-a242033cc51c",
                        "glosses": [
                            "Denomination, name, appellation."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b8f01e3a-4794-3026-9efe-684bdb6ac96d",
                        "entry_id": "2508f3e9-0b3b-3ce4-b2e7-a242033cc51c",
                        "glosses": [
                            "A noun derived from some other noun, a denominative."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "227f1704-f4fe-430a-b8a6-bbd30547c56e",
                                "sense_id": "b8f01e3a-4794-3026-9efe-684bdb6ac96d",
                                "text": "Aristotle […] thus […] writeth: Those [words] are called denominates, which haue the appellation of a name from some other […] as from Grammar, man is called a Grammarian."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
