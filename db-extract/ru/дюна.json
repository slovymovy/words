                        "glosses": [
                            "песчаный холм, перемещаемый ветрами, на берегу моря или в пустыне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4aaffa3-3137-4e8f-864f-5e7e588081f1",
                                "sense_id": "6b73042d-13aa-3773-b34b-5a0a2a0a9ba5",
                                "text": "Я увидал, что я иду по песку дюны."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83647128-e03d-42af-a7a9-d9923e27d1b5",
