                        "glosses": [
                            "Obscurité presque complète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51adfd8-e855-43e5-a94c-03f5647d33b0",
                                "sense_id": "d0344437-f1b3-3865-8999-23fd96ee900b",
                                "text": "Aucun goût commun, hors celui d'être ensemble durant ces après-midi où le feu du ciel assiège les hommes barricadés dans une demi-ténèbre."
                            },
                            {
                                "example_id": "3b47f368-7bac-4dba-b986-92e34695631d",
                                "sense_id": "d0344437-f1b3-3865-8999-23fd96ee900b",
                                "text": "C’était ce qui me défendait d’elle, tout en me permettant de jouir d’elle, comme s’il n’y avait eu pour moi d’autre jouissance imaginable que la contemplation dans cette demi-ténèbre enchantée de la librairie ; aucun problème sordide du dehors ne se posait que j’aurais été bien incapable de résoudre."
                            }
                        ]
                    }
