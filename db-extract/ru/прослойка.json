                ],
                "translations": [
                    {
                        "translation_id": "a581eafe-d664-48ad-b67a-7c008cccd97f",
                        "source_entry_id": "a3463c55-40cf-3163-a670-278dc9dd7980",
                        "target_lang_word": "layer",
