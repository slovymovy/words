                    {
                        "translation_id": "53b1a100-b781-4783-a015-b07391b65d2c",
                        "source_entry_id": "48d4ec4a-1ff8-3cd5-9e5a-96bcaa901e92",
                        "source_sense_description": "цепляя, навесить на что-либо, закрепить на чём-либо",
                        "target_lang_word": "aufhängen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufhängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2556081e-6fd8-3b23-8211-b68bd993d972",
                                        "entry_id": "f9dccb3d-5557-31c8-8f1d-f6c49f858d6c",
                                        "glosses": [
                                            "an eine bestimmte, dafür vorgesehene Stelle hängen (zum Beispiel an einen Haken)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "943d884d-0733-4274-863a-f7695fac25a4",
                                                "sense_id": "2556081e-6fd8-3b23-8211-b68bd993d972",
                                                "text": "Hier ist die Garderobe, wo ihr eure Sachen aufhängen könnt."
                                            },
                                            {
                                                "example_id": "d2de7dfe-ef72-47c5-af8c-219397a06ce1",
                                                "sense_id": "2556081e-6fd8-3b23-8211-b68bd993d972",
                                                "text": "Wo wollen wir das Bild aufhängen?"
                                            },
                                            {
                                                "example_id": "3f644b77-39ec-4f23-918a-eb79d3e51f23",
                                                "sense_id": "2556081e-6fd8-3b23-8211-b68bd993d972",
                                                "text": "[April 1945:] „So erkannte etwa der Kampfkommandant von Gotha, dass eine Verteidigung der Stadt gegen die anrückenden US-Truppen zwecklos wäre und ließ weiße Fahnen aufhängen.“"
                                            },
                                            {
                                                "example_id": "635e491c-78ed-4df8-9d88-2ec2f24cbc5b",
                                                "sense_id": "2556081e-6fd8-3b23-8211-b68bd993d972",
                                                "text": "„Mit Amuletten, die um den Hals getragen oder im Hause aufgehängt wurden, suchte man sich vor dem Zugriff der Geister zu schützen.“"
                                            },
                                            {
                                                "example_id": "6e1dd0a4-fed7-4213-ba10-1d6466a0d3da",
                                                "sense_id": "2556081e-6fd8-3b23-8211-b68bd993d972",
                                                "text": "„Matan Zangauker, 25, wurde gemeinsam mit seiner Freundin aus dem Kibbuz Nir Oz gekidnappt. Einmal wurde er Teil einer Hamas-Inszenierung. Die Terroristen hingen ein Foto von Zangauker auf und stellten eine Sanduhr daneben. Und den Schriftzug: «Die Zeit läuft ab.»“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d35cc32f-f78a-3d55-8511-47b15136a33c",
                                        "entry_id": "f9dccb3d-5557-31c8-8f1d-f6c49f858d6c",
                                        "glosses": [
                                            "sich oder jemanden erhängen, auch bildhaft übertragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e57819-632a-4b64-8ec6-cdeb9077e5fd",
                                                "sense_id": "d35cc32f-f78a-3d55-8511-47b15136a33c",
                                                "text": "Er war ein Strolch durch und durch und wurde am Ende aufgehängt."
                                            },
                                            {
                                                "example_id": "fb6f83d7-40ec-4be2-9802-87307cad97b3",
                                                "sense_id": "d35cc32f-f78a-3d55-8511-47b15136a33c",
                                                "text": "Wenn ich diesen Auftrag annehme, kann ich mich gleich aufhängen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b57f9252-fded-3f53-b957-437b7fe79374",
                                        "entry_id": "f9dccb3d-5557-31c8-8f1d-f6c49f858d6c",
                                        "glosses": [
                                            "ein Telefongespräch beenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423fbab2-d30e-47a0-9960-ac8a945838cf",
                                                "sense_id": "b57f9252-fded-3f53-b957-437b7fe79374",
                                                "text": "Ich rief ihn an, um mich zu entschuldigen, aber er hängte sofort auf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cab209ba-8421-3d7b-ac10-89d155ffb136",
                                        "entry_id": "f9dccb3d-5557-31c8-8f1d-f6c49f858d6c",
                                        "glosses": [
                                            "mit einer ungewünschten, ungeliebten Tätigkeit belasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2837deb9-711e-4b63-bb04-fd89d426bb12",
                                                "sense_id": "cab209ba-8421-3d7b-ac10-89d155ffb136",
                                                "text": "Jetzt haben sie Udo auch noch den Job als stellvertretender Vereinspräsident aufgehängt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "297a7fe5-65b0-3011-94f9-51ce6cf2cc22",
                                        "entry_id": "f9dccb3d-5557-31c8-8f1d-f6c49f858d6c",
                                        "glosses": [
                                            "an einer Grundidee (einem Aufhänger) festmachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7cd2948-cba3-4d7b-a2ba-452de3835700",
                                                "sense_id": "297a7fe5-65b0-3011-94f9-51ce6cf2cc22",
                                                "text": "Lassen Sie uns das ganz groß aufhängen, mit Preisverleihung und allem drum und dran."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
