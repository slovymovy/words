                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20ddba75-2846-4e91-9e8a-bb8dfca51f5d",
                                "sense_id": "0d0ab369-cc14-3bec-bba9-c9ccc50447f8",
                                "text": "C’est, je crois, trouble de l'âme qui est trop occupée de son être (chez des provinciaux arrivants), pour qu’elle puisse être sympathisante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
