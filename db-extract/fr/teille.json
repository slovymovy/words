                    {
                        "sense_id": "5f5c2208-2f03-3a5a-910a-17b928ee8096",
                        "entry_id": "6b95237b-67c8-3f46-9ca9-bc2c742530fc",
                        "glosses": [
                            "Variante de tille."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "41522394-4c9e-446e-9a43-b5bae9822407",
                                "sense_id": "5f5c2208-2f03-3a5a-910a-17b928ee8096",
                                "text": "Il est de fait que le bruit du bouchon de teille frottant ces peaux que le choléra avait rendues cartonneuses et sonores, tendues sur des corps aux chairs intérieurement calcinées, était assez difficile à supporter pour quelqu’un doué d’imagination."
                            },
                            {
                                "example_id": "651e0ceb-7584-42d5-8d73-aa4bc9a7ccb2",
                                "sense_id": "5f5c2208-2f03-3a5a-910a-17b928ee8096",
                                "text": "Un siècle avant, on – enfin les femmes – teillait le chanvre à la veillée, c'est-à-dire qu'on ôtait la teille ou écorce de la tige femelle préalablement débarrassée de la résine par le rouissage, pour ne garder que la filasse."
                            }
                        ]
                    }
