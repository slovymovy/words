                                    {
                                        "sense_id": "a9424c51-5760-3ffa-ae95-c2d4cb52585c",
                                        "entry_id": "b50a2d29-3a02-3b17-b502-628970a08ea3",
                                        "glosses": [
                                            "toe-eigenen, onrechtmatig in bezit nemen, zich aanmatigen"
                                        ],
                                        "tags": [],
