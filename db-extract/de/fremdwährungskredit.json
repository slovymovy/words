                "senses": [
                    {
                        "sense_id": "97403824-5958-3f28-8374-e83c048c360b",
                        "entry_id": "3a7615a9-87c6-3d6a-a582-40fb37423c12",
                        "glosses": [
                            "Kredit, der in einer anderen Währung als der eigenen Landeswährung aufgenommen wird"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "f6f3b15d-6d01-4e05-adf2-6eea7b04915c",
                                "sense_id": "97403824-5958-3f28-8374-e83c048c360b",
                                "text": "„Im Anlassfall ging es um einen endfälligen Fremdwährungskredit, den ein Ehepaar im Jahr 2005 aufgenommen hatte, um damit einen Reihenhausgenossenschaftsanteil zu erwerben.“"
                            },
                            {
                                "example_id": "e9bfe398-f5eb-476d-b9ad-138cfbf8b10b",
                                "sense_id": "97403824-5958-3f28-8374-e83c048c360b",
                                "text": "„Der Ursprung des Problems reicht Jahre zurück: Vor der Finanzkrise hatten sich viele Polen den Traum von den eigenen vier Wänden mit einem Fremdwährungskredit finanziert - zumeist in Schweizer Franken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
