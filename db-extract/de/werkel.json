                "senses": [
                    {
                        "sense_id": "363ba470-b4e4-3071-985c-8effc4a21d77",
                        "entry_id": "0cebdf12-b5aa-3ae3-b0c6-b41d984ae408",
                        "glosses": [
                            "Musikinstrument, dessen Mechanik von einem Werkelmann durch eine Kurbel in Bewegung gesetzt wird"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "eed8c527-5fad-4aee-a7d9-2580ce29c017",
                                "sense_id": "363ba470-b4e4-3071-985c-8effc4a21d77",
                                "text": "Allen entgegen dringt der Lärm des Wurstelpraters, und über dem Gewühl der Menge schlagen seine Wellen zusammen. Das Schreien der Ausrufer, gellendes Glockenklingeln, das Heulen der Werkel, schmetternde Fanfaren, dröhnende Paukenschläge."
                            },
                            {
                                "example_id": "89aca07d-3902-4e74-aa6b-cb9e1fd3f87d",
                                "sense_id": "363ba470-b4e4-3071-985c-8effc4a21d77",
                                "text": "Ferdinand Molzers „fahrbare Straßenorgel, auch „Werkel“ genannt, war besonders in Wien sehr populär.“"
                            },
                            {
                                "example_id": "85ddb54e-27c2-4ce5-8454-dd37c11da5f3",
                                "sense_id": "363ba470-b4e4-3071-985c-8effc4a21d77",
                                "text": "Als Musik gab`s keineswegs, wie später vor Einführung des Tonfilms, ganze Musikkapellen, sondern ein Werkel, das ein junger Bursch drehte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8e4e291f-6c76-3f10-a678-215d6b00e262",
                        "entry_id": "0cebdf12-b5aa-3ae3-b0c6-b41d984ae408",
                        "glosses": [
                            "etwas, das sich bewegt, etwas erzeugt oder bewirkt"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "19980249-1eb3-4619-a48d-d899f8790726",
                                "sense_id": "8e4e291f-6c76-3f10-a678-215d6b00e262",
                                "text": "„In dieser Phase könnte das Staatsoberhaupt eine Beamtenregierung einsetzen, mit Ministern, die als Spitzenbeamte auch jetzt schon das Werkel am Laufen halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b066b28-eb09-457c-bafc-5f9be085a7f6",
                        "source_entry_id": "0cebdf12-b5aa-3ae3-b0c6-b41d984ae408",
                        "source_sense_id": "363ba470-b4e4-3071-985c-8effc4a21d77",
