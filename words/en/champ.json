        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "695c719d-5051-3565-9413-cd27223fe128",
                    "sense_definition": "To bite or chew something, especially noisily or with impatience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_chew",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse began to <w>champ</w> on the bit before the race started.",
                            "target_lang_translations": {
                                "ru": "Лошадь начала <w>грызть</w> удила перед началом скачек.",
                                "zh": "比赛开始前，马儿开始<w>啃</w>咬马衔铁。",
                                "es": "El caballo comenzó a <w>mascar</w> el bocado antes de que empezara la carrera."
                            }
                        },
                        {
                            "text": "He sat in the corner <w>champing</w> on a cigar while he waited.",
                            "target_lang_translations": {
                                "ru": "Он сидел в углу, <w>жуя</w> сигару в ожидании.",
                                "zh": "他坐在角落里，一边等待一边<w>嚼</w>着雪茄。",
                                "es": "Se sentó en la esquina <w>masticando</w> un cigarro mientras esperaba."
                            }
                        }
                    ],
                    "common_phrases": [
                        "champ at the bit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусать или жевать что-либо, особенно шумно или с нетерпением.",
                        "zh": "咬或咀嚼某物，尤指发出响声或表现得不耐烦。",
                        "es": "Morder o masticar algo, especialmente de forma ruidosa o con impaciencia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чавкать",
                                "target_lang_sense_clarification": "громко жевать"
                            },
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "кусать (например, удила)"
                            },
                            {
                                "target_lang_word": "жевать",
                                "target_lang_sense_clarification": "процесс еды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嚼",
                                "target_lang_sense_clarification": "咀嚼动作"
                            },
                            {
                                "target_lang_word": "啃",
                                "target_lang_sense_clarification": "咬硬物"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "masticar",
                                "target_lang_sense_clarification": "acción de comer"
                            },
                            {
                                "target_lang_word": "mascar",
                                "target_lang_sense_clarification": "acción de morder repetidamente"
                            },
                            {
                                "target_lang_word": "chapotear",
                                "target_lang_sense_clarification": "hacer ruido al masticar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08363905-d8b0-3284-b159-db1dcff74a01",
                    "sense_definition": "To endure a difficult situation or to behave with resilience.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_endure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You just have to <w>champ</w> it out until the semester ends.",
                            "target_lang_translations": {
                                "ru": "Тебе просто нужно <w>перетерпеть</w> это, пока не закончится семестр.",
                                "zh": "你只需要<w>忍受</w>到学期结束就行了。",
                                "es": "Solo tienes que <w>aguantar</w> hasta que termine el semestre."
                            }
                        },
                        {
                            "text": "He decided to <w>champ</w> up and finish the difficult workout.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>собраться</w> и закончить эту тяжелую тренировку.",
                                "zh": "他决定<w>坚持</w>下去，完成那项艰苦的训练。",
                                "es": "Decidió <w>resistir</w> y terminar el difícil entrenamiento."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдерживать трудную ситуацию или проявлять стойкость.",
                        "zh": "忍受困难的处境或表现出坚韧。",
                        "es": "Soportar una situación difícil o comportarse con resiliencia."
                    },
                    "translations": {
