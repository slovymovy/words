                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e11fb0ac-316c-38e2-a843-db532b381d85",
                                        "entry_id": "39ea60fb-038b-3850-b61f-5c3b469a626b",
                                        "glosses": [
                                            "średniej wielkości ptak często spotykany w miastach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f63a94b-a7ab-4109-98b7-c0a24ee0c375",
                                                "sense_id": "e11fb0ac-316c-38e2-a843-db532b381d85",
                                                "text": "Gołębie, jako śmielsze, wnet zaczęły kuć dziobkami w polepę, kuropatwy zaś zbliżały się ostrożniej, spoglądając to na padające ziarno, to na księdza, to na liszkę, z którą opatrzyły się zresztą od dawna, bo schwytane jeszcze latem pisklętami i hodowane w domu od maleńkości, widywały ją codziennie"
                                            },
                                            {
                                                "example_id": "17b70e40-68d0-444b-a83c-1c6349c331f7",
                                                "sense_id": "e11fb0ac-316c-38e2-a843-db532b381d85",
                                                "text": "Więc mówiła mu o połowie ryb, o gołębiach, o zniknięciu pary najładniejszych bażantów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c018b80-641f-402e-9e90-f892a2a6103a",
