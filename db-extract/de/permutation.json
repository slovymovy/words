                                        "glosses": [
                                            "A one-to-one mapping from a finite set to itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea4369a-c6ec-4a14-b895-d4eb71b2de92",
                                                "sense_id": "6edd8f46-1f35-3e20-8cb0-f6dd4bb73cb8",
                                                "text": "This permutation takes each element to the one following it, with the last mapped back to the first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a72039e-e47b-3920-a407-5604ed5ab9d4",
                                        "entry_id": "c24360de-da45-385d-a906-3d24bc8cb405",
                                        "glosses": [
                                            "An ordering of a finite set of distinct elements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
