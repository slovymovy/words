                            },
                            {
                                "target_word": "Brandenburger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                        "entry_id": "3a49a064-9cab-399b-aec1-8deefa1bb998",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0dcba90-ac31-41c5-aef1-1eb2d9089d3f",
                                                "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                                "text": "Frau Brandenburger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "fcc6f2e4-14db-4682-8ef0-d9d23b5bd8ef",
                                                "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                                "text": "Herr Brandenburger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "9667ec5a-6bd2-44d6-a4a5-49e113492d04",
                                                "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                                "text": "Die Brandenburgers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "cdbe39cc-2fb9-4e94-8de7-eb726b3a7de3",
                                                "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                                "text": "Der Brandenburger trägt nie die Schals, die die Brandenburger ihm strickt."
                                            },
                                            {
                                                "example_id": "31144654-c528-4d9e-a743-30f62831d50d",
                                                "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brandenburger kommt, geht der Herr Brandenburger.“"
                                            },
                                            {
                                                "example_id": "7e42686e-391f-4c0c-bd12-f292eaf71f82",
                                                "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                                "text": "Brandenburger kommt und geht."
                                            },
                                            {
                                                "example_id": "ec664900-ec6f-4d06-816f-8d857c6219fd",
                                                "sense_id": "11f6a6df-54f1-3043-b628-8f0e3492e613",
                                                "text": "Brandenburgers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Brandenburger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7985cd-4286-3229-9629-cb8cbdd8e3ce",
                                        "entry_id": "357f5264-94ff-3aa8-8d45-835f29b968c9",
                                        "glosses": [
                                            "aus Brandenburg kommend, Brandenburg betreffend, zu Brandenburg gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc7f835-c6d1-4ca1-a604-8481a8a47a30",
                                                "sense_id": "cd7985cd-4286-3229-9629-cb8cbdd8e3ce",
                                                "text": "„Der Brandenburger Markgraf hatte mit der Lehnshoheit über Lenzen und mit dem unmittelbaren Besitz von Pritzwalk neben Havelberg einen beträchtlichen Machtbereich in der Prignitz erlangt, dessen Erweiterung das Ziel der markgräflichen Politik in den nächsten Jahrzehnten war.“"
                                            },
                                            {
                                                "example_id": "18344a87-848a-4811-8043-a3699573aeca",
                                                "sense_id": "cd7985cd-4286-3229-9629-cb8cbdd8e3ce",
                                                "text": "„Als wir im Brandenburger Umweltministerium Ende 1990 die Arbeit aufnahmen, hatten wir nicht mehr als ein Zimmer, ein Türschild, einen Staatssekretär und sechs Mitarbeiter, die sich ein einziges Telefon teilten.“"
                                            },
                                            {
                                                "example_id": "f84e69be-5118-41c9-ae10-27383e800064",
                                                "sense_id": "cd7985cd-4286-3229-9629-cb8cbdd8e3ce",
                                                "text": "[Dürre in Deutschland:] Immer mehr Brandenburger Landkreise schränken die Wasserentnahme aus Seen, Flüssen und Brunnen ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
