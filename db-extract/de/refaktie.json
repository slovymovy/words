                        "sense_id": "b238e9b1-2faf-3749-9e68-560653da6626",
                        "entry_id": "107dcc5a-1728-351d-8948-a21ef5a185bb",
                        "glosses": [
                            "Vergütung für fehlerhafte oder beschädigte Ware einer Lieferung durch Gewichts- oder Preisabzug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77189514-454c-4748-9ddf-ec7c31604e29",
                                "sense_id": "b238e9b1-2faf-3749-9e68-560653da6626",
                                "text": "§ 380 HGB (2): \"… ob und wie viel als Gutgewicht zu Gunsten des Käufers zu berechnen ist oder als Vergütung für schadhafte oder unbrauchbare Teile (Refaktie) gefordert werden kann, bestimmt sich nach dem Vertrag oder dem Handelsgebrauch des Ortes, an welchem der Verkäufer zu erfüllen hat.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc729f1c-8854-3019-8ab3-bbb64817f4c0",
                        "entry_id": "107dcc5a-1728-351d-8948-a21ef5a185bb",
                        "glosses": [
                            "Nachlass von Frachtkosten durch Rückvergütung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a662b62f-51c2-46d7-9e60-e86e7bf10d6d",
                                "sense_id": "fc729f1c-8854-3019-8ab3-bbb64817f4c0",
                                "text": "Die Refaktie ist im engeren Sinne ein geheimes Zugeständnis, durch das einem oder mehreren Absendern Preisermäßigung gegenüber den Tarifen zugestanden wird. Dies gilt für das Bahnwesen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
