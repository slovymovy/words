                "entry_id": "795d31f7-ca5e-3bcf-a4a4-5ed6ef81a30a",
                "word": "entrant",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0ca325a3-a20a-48a7-9503-984fc9dc965f",
                        "entry_id": "795d31f7-ca5e-3bcf-a4a4-5ed6ef81a30a",
                        "tags": [
                            "plural"
                        ],
                        "form": "entrants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1445cd2-18d6-31c7-aeb9-e17da15ab097",
                        "entry_id": "795d31f7-ca5e-3bcf-a4a4-5ed6ef81a30a",
                        "glosses": [
                            "A participant who enters something, such as a contest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10b22ba2-fcc1-4de3-873d-2cb4bfca0414",
                                "sense_id": "d1445cd2-18d6-31c7-aeb9-e17da15ab097",
                                "text": "Any attempt by an entrant to influence the result or subvert the contest will lead to immediate disqualification."
                            }
                        ]
                    },
                    {
                        "sense_id": "b98d200b-7886-36af-83ab-ebdd0e2ac772",
                        "entry_id": "795d31f7-ca5e-3bcf-a4a4-5ed6ef81a30a",
                        "glosses": [
                            "A newcomer."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ba91a76-48e4-4972-bd34-b8aa283e1ab7",
                        "source_entry_id": "795d31f7-ca5e-3bcf-a4a4-5ed6ef81a30a",
                        "source_sense_description": "participant",
                        "target_lang_word": "Teilnehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teilnehmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                        "entry_id": "2b1bd2ea-f4b8-36b6-83c0-44926828db5b",
                                        "glosses": [
                                            "Person oder Gruppe, die an einem Ereignis oder einer Veranstaltung beteiligt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3788fea1-d632-4e8c-a502-58b73cb883f6",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "Als Teilnehmer kommen alle in Frage, die das erste Semester mit Erfolg bestanden haben."
                                            },
                                            {
                                                "example_id": "21b1c2eb-24a2-41ca-9690-44bae2c75c98",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "Die Teilnehmer an der Tagung müssen einen Tagungsbeitrag leisten."
                                            },
                                            {
                                                "example_id": "dde23dcc-2219-4e82-9e0a-b671289b2724",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "„Alle zwölf Teilnehmer wussten von mindestens einem Fall von Gewalt in der Familie.“"
                                            },
                                            {
                                                "example_id": "184f3343-0c63-47d2-8e55-220e9181605e",
                                                "sense_id": "4a825dc0-dfc7-36cc-9370-684355ae05b6",
                                                "text": "„Die Teilnehmer setzten sich aus Männern und Matronen der älteren Behördenschaft zusammen, die mehr oder weniger maßgebliche Funktionen als Büroreferenten, Sachbearbeiter, Protokollführer und dergleichen ausübten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "898f1224-ed41-3af2-8707-135c52e980af",
                                        "entry_id": "2b1bd2ea-f4b8-36b6-83c0-44926828db5b",
                                        "glosses": [
                                            "Oberbegriff für Anstifter und Gehilfen"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e17fdf5-fa02-4461-86b7-a0bb4c5a39cf",
                                                "sense_id": "898f1224-ed41-3af2-8707-135c52e980af",
                                                "text": "Teilnehmer erfüllen den Tatbestand des in Frage stehenden Delikts im Gegensatz zum Täter nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7097e68e-772c-4327-93da-2f08fe8297d1",
                        "source_entry_id": "795d31f7-ca5e-3bcf-a4a4-5ed6ef81a30a",
                        "source_sense_description": "participant",
                        "target_lang_word": "уча́стник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "уча́стник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ed0f42a9-7474-37aa-9455-0a7835a2fe76",
                                        "entry_id": "ed050db3-b375-337a-a123-9595d0050615",
                                        "glosses": [
                                            "тот, кто участвует в чём-либо, то есть занимается чем-либо совместно с другими"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e05414-e512-4c64-980c-3437a57f0dff",
                                                "sense_id": "ed0f42a9-7474-37aa-9455-0a7835a2fe76",
                                                "text": "По сути «поле» здесь― такой же, если не более важный, субъект, участник игры, как и политические команды."
                                            }
                                        ]
                                    }
                                ]
