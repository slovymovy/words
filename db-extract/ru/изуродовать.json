                "senses": [
                    {
                        "sense_id": "f08a2341-c609-32e4-a22c-6b7dcba27223",
                        "entry_id": "7471d6eb-637a-375a-b616-682ba0dbea2e",
                        "glosses": [
                            "прям. и перен. сделать безобразным, исказить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7257d625-74ec-4c83-940c-924a58678fcd",
                                "sense_id": "f08a2341-c609-32e4-a22c-6b7dcba27223",
                                "text": "Шрам изуродовал лицо. Новостройки изуродовали облик старого города."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4d36d2e-d668-30de-811f-75cd5e17b85d",
                        "entry_id": "7471d6eb-637a-375a-b616-682ba0dbea2e",
                        "glosses": [
                            "искалечить, нанести увечье"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67ec198d-4210-42c0-9fcb-90a6b1ad58a8",
                        "source_entry_id": "7471d6eb-637a-375a-b616-682ba0dbea2e",
                        "target_lang_word": "entstellen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entstellen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ec600b6-1441-383f-8706-011054fa31a9",
                                        "entry_id": "543f1dd8-fed0-3085-9a19-068a5e4da514",
                                        "glosses": [
                                            "das Äußere negativ verändern, hässlich machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a5ebe4-10c1-40f1-9627-e1ee6fb1dae1",
                                                "sense_id": "3ec600b6-1441-383f-8706-011054fa31a9",
                                                "text": "„Es gelte den Fahrer, der betrunken den Autounfall verursacht und ihr Gesicht entstellt hat, zur Rechenschaft zu ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3a4e86f-0256-3030-b6c5-5355752249ee",
                                        "entry_id": "543f1dd8-fed0-3085-9a19-068a5e4da514",
                                        "glosses": [
                                            "falsch darstellen, den Sinn nicht korrekt wiedergeben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fcfb2de-87cf-4218-a38a-8f93a14b37ea",
                                                "sense_id": "a3a4e86f-0256-3030-b6c5-5355752249ee",
                                                "text": "„Sie können Tatsachen entstellen, um mit Hilfe der Lügen die öffentliche Meinung zu steuern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2f6d080-3a00-47db-babd-6374c8be92a1",
                        "source_entry_id": "7471d6eb-637a-375a-b616-682ba0dbea2e",
                        "target_lang_word": "verschandeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschandeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc890e4-f0b0-31e4-88a4-7f791b2c95fe",
                                        "entry_id": "be075083-65bb-39bb-97dd-0fda0126b5ce",
                                        "glosses": [
                                            "das Aussehen von etwas so verändern, dass es hässlich wird (und eine Schande)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0348c641-d693-44ef-a79a-9d3a62728726",
                                                "sense_id": "4cc890e4-f0b0-31e4-88a4-7f791b2c95fe",
                                                "text": "Das abgrundtief hässliche Riesengebäude verschandelt die Landschaft."
                                            },
                                            {
                                                "example_id": "90b970ad-9002-4cf6-8421-03e996057200",
                                                "sense_id": "4cc890e4-f0b0-31e4-88a4-7f791b2c95fe",
                                                "text": "„Mary Agnes hatte die Namen ihrer Kinder mit Bedacht gewählt und immer peinlich darauf geachtet, sie ganz auszusprechen und nicht durch Abkürzungen zu verschandeln.“"
                                            },
                                            {
                                                "example_id": "c6535338-5194-45ed-8470-ed2059e32251",
                                                "sense_id": "4cc890e4-f0b0-31e4-88a4-7f791b2c95fe",
                                                "text": "„Hass macht Menschen hässlich. Du verschandelst dich. Ist es das wert?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0c845b3-9c64-449d-a17d-fcfdef60ea9a",
                        "source_entry_id": "7471d6eb-637a-375a-b616-682ba0dbea2e",
                        "target_lang_word": "verunstalten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verunstalten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79a1c6eb-9102-3dba-9eea-c4a29c531a43",
                                        "entry_id": "a69a2db9-cff3-3e35-919d-7910fe0ca94a",
                                        "glosses": [
                                            "die Gestalt von etwas zum Schlechteren verändern, etwas unansehnlich oder hässlich machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f781afe-f86a-4c07-86cd-b94286c259e3",
                                                "sense_id": "79a1c6eb-9102-3dba-9eea-c4a29c531a43",
                                                "text": "Das neue Industriegebiet verunstaltet die ganze Landschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2eda46fb-5958-481b-a8c7-1c0575a8f11e",
                        "source_entry_id": "7471d6eb-637a-375a-b616-682ba0dbea2e",
                        "target_lang_word": "défigurer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défigurer",
