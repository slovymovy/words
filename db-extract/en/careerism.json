                                        "entry_id": "53b47b73-2f3e-3bd7-990a-b61c513f83f6",
                                        "glosses": [
                                            "Priorité donnée à sa carrière sur d’autres valeurs, sa famille, le bien de l’entreprise pour un employé, de la collectivité pour un homme politique, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a408a8d-94d9-4784-964c-ad2d8a98b1ec",
                                                "sense_id": "cd23ab4b-9e5a-3b6b-87fd-37966c66e4ee",
                                                "text": "En France, la loi de 2000 sur le cumul des mandats limite le carriérisme politique."
                                            },
                                            {
                                                "example_id": "7f27fdde-3f12-47b5-aa0c-9058243aad4c",
                                                "sense_id": "cd23ab4b-9e5a-3b6b-87fd-37966c66e4ee",
                                                "text": "Ces calculs politiques montrent que, pour certains dirigeants de l’opposition, dans la pratique même de leurs activités universitaires, le carriérisme prend le pas sur toute autre préoccupation."
                                            }
                                        ]
                                    }
                                ]
                            }
