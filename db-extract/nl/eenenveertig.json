                                "example_id": "5809963a-366b-4369-87c8-87cda5413fcc",
                                "sense_id": "8f163e41-e908-3088-8c5b-0eb25be7dc5e",
                                "text": "Het is weer de eenenveertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
