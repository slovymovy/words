            {
                "entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
                "word": "thunderclap",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "07d96706-d691-4665-a666-90125cbe7604",
                        "entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
                        "tags": [
                            "plural"
                        ],
                        "form": "thunderclaps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f09bc9a6-297f-363d-9dcb-11d298fe718b",
                        "entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
                        "glosses": [
                            "A sudden, loud thunder caused by a nearby lightning strike; a shock of thunder, as opposed to a reverberating rumble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d64b4c98-622c-49e8-ab1f-09e6ccc37f48",
                                "sense_id": "f09bc9a6-297f-363d-9dcb-11d298fe718b",
                                "text": "Thunderclaps that make them quake."
                            },
                            {
                                "example_id": "b6438815-e0a6-4475-bb49-d1219fe5aa65",
                                "sense_id": "f09bc9a6-297f-363d-9dcb-11d298fe718b",
                                "text": "Ile home, and ſtarue, this croſſe, this peeuiſh hap, / Strikes dead my ſpirits like a thunderclap."
                            },
                            {
                                "example_id": "1d06aa05-788f-455f-b5cb-cb0a19fd6190",
                                "sense_id": "f09bc9a6-297f-363d-9dcb-11d298fe718b",
                                "text": "When suddenly the thunderclap was heard."
                            }
                        ]
                    },
                    {
                        "sense_id": "80bd8c3f-6bca-30e2-9f8f-a61039f55c20",
                        "entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
                        "glosses": [
                            "A very loud fart."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7e7d422d-7c94-3ea2-81ef-078df75006eb",
                        "entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
                        "glosses": [
                            "Something that makes a big, dramatic impact."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bdb8ec37-22f2-45ac-8436-5f74fd0a0ab5",
                                "sense_id": "7e7d422d-7c94-3ea2-81ef-078df75006eb",
                                "text": "A 21-Valyrian steel dagger salute to Paddy Considine, who makes his exit from House Of The Dragon this week with a thunderclap of a performance. “The Lord of the Tides” is the swan song for his King Viserys I Targaryen, a well-intentioned but indecisive man who waited until the very last day of his life to flex his royal might."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e749280-f502-3ffa-9807-9ed1de3e52b3",
                        "entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
                        "glosses": [
                            "Synonym of thunder word."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0fc3117-236d-4c38-8390-279bdebe2bd2",
                                "sense_id": "8e749280-f502-3ffa-9807-9ed1de3e52b3",
                                "text": "[…] the thunderclaps, and advised Cage on their meaning. Cage considered composing new star-map music, in which microphones attached to the throats of the chorus members would make their singing of Joyce's verbal thunderclaps sound like […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0094f89-20bf-4a3f-8117-e7d75a559ed5",
                        "source_entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
                        "source_sense_description": "sudden thunder",
                        "target_lang_word": "coup de tonnerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coup de tonnerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db7473ee-563a-3841-8a96-948c04097744",
                                        "entry_id": "0f945a33-cde0-30ec-9d00-38897b5bc1ec",
                                        "glosses": [
                                            "Action de la foudre sur les corps qu’elle frappe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "705c8be5-9aba-4d0a-a48a-d2a35e6dbe4c",
                                                "sense_id": "db7473ee-563a-3841-8a96-948c04097744",
                                                "text": "L’atmosphère avait été lourde pendant toute la journée, et le soir un orage terrible se déclara. Les coups de tonnerre se succédaient sans interruption ; la pluie tombait, torrentielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "803d84be-ce34-3067-bd2b-706fd060eca3",
                                        "entry_id": "0f945a33-cde0-30ec-9d00-38897b5bc1ec",
                                        "glosses": [
                                            "Bruit qui accompagne ou suit un éclair."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9053bf-9d54-45c9-9824-3814aa5e3e0d",
                                                "sense_id": "803d84be-ce34-3067-bd2b-706fd060eca3",
                                                "text": "Tout un crépitement de coups de feu et d’éclatements de projectiles commença, et Bert vit autour de lui, l’enveloppant, l’engloutissant, le submergeant, une immense fulguration blanche accompagnée d’un coup de tonnerre semblable à l’explosion d’un monde."
                                            },
                                            {
                                                "example_id": "ad910229-707c-4768-838d-a2728dba0be6",
                                                "sense_id": "803d84be-ce34-3067-bd2b-706fd060eca3",
                                                "text": "L'haleine de la mousson d'été s'était faite moins chaude, quoique encore des éclairs lointains fulgurassent et illuminassent la mer, sans coups de tonnerre perceptibles, là-bas, vers la côte d'Asie."
                                            },
                                            {
                                                "example_id": "6014cab9-ed9a-4f48-b8fe-fb68b2334c3a",
                                                "sense_id": "803d84be-ce34-3067-bd2b-706fd060eca3",
                                                "text": "Les membres de l’ethnie minoritaire O Du célèbrent le Nouvel An lorsqu’ils entendent le premier coup de tonnerre. Il signale la nouvelle année ainsi que le temps de commencer une nouvelle récolte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc61d93-3744-3a65-96fe-e19b5a03f166",
                                        "entry_id": "0f945a33-cde0-30ec-9d00-38897b5bc1ec",
                                        "glosses": [
                                            "Chamboulement soudain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08404d0f-aef0-4376-8682-591bdfa85120",
                                                "sense_id": "bfc61d93-3744-3a65-96fe-e19b5a03f166",
                                                "text": "Loft Story fait un carton. Jean-Édouard pelote Loana dans la piscine de M6. C'est un coup de tonnerre dans l'imaginaire érotique des ménagères de moins de cinquante ans. Tout devient possible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b59a6142-e901-4055-8337-04edab3b8dde",
                        "source_entry_id": "ba344502-03af-33ce-a5a3-041e7e08718a",
