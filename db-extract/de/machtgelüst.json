                "senses": [
                    {
                        "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                        "entry_id": "cd0ffd05-866c-3630-96c7-0311a2e7b457",
                        "glosses": [
                            "starker Drang, Macht auszuüben"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "6858f605-aa77-498d-9c84-9de3d66f1ac8",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Die offensichtliche Schwäche der Zentralregierung steigerte seine Machtgelüste nur noch mehr.“"
                            },
                            {
                                "example_id": "7905e1f6-3a49-464b-9738-02f1ef7cc890",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Der darin beschriebene Idealstaat“ […] „war nicht nur geografisch weit entfernt von der korrupten Willkürherrschaft der englischen Monarchie, deren anfänglich humanistisches Antlitz alsbald infolge der Machtgelüste Heinrichs VIII. verdrängt wurde.“"
                            },
                            {
                                "example_id": "fbe96fed-1280-482f-b214-ff35a4acf6db",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Lear, beeindruckend verkörpert von Bariton Michael Kupfer-Radecky, gerät in einen Strudel der Machtgelüste.“"
                            },
                            {
                                "example_id": "6eb33db5-0f2a-4575-8e6a-e3c82bd84596",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„In einem letzten Aufwallen absolutistischer Machtgelüste verabredeten 1748 die beiden mecklenburgischen Regenten, Christian Ludwig II. und Adolf Friedrich III. in einem Geheimvertrag die Auflösung des mecklenburgischen Gesamtstaates.“"
                            },
                            {
                                "example_id": "a81ecf93-27cf-4cba-a8a2-bc641b050b56",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Selbst ihr Geliebter Andronico scheint nur noch an seine eigenen Machtgelüste zu denken.“"
                            },
                            {
                                "example_id": "b54aa1c2-77a1-4475-8e63-45587efbd4d1",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„»Mein Vater ist mit 18 in den Krieg gezogen und mit 25 rausgekommen. Auch die Soldaten in der Täternation sind am Ende Opfer der Machtgelüste einzelner.«“"
                            },
                            {
                                "example_id": "db2a2a95-754d-45d8-858b-07e03c487e53",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Natürlich war Ulbricht davon überzeugt, das alles zum Wohle der Weltrevolution zu tun. Persönliche Machtgelüste, Unaufrichtigkeit, gar Hinterhältigkeit, waren ihm fremd, wie alle seine Gefährtinnen bestätigen.“"
                            },
                            {
                                "example_id": "b833347c-ffa6-4eb1-8579-295020f12769",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "[Über Gamal Abdel Nasser in der Suez-Krise:] „Wir dürfen ihm daher keinen ersten Erfolg erlauben, denn dieser könnte bei ihm neue Machtgelüste auslösen.“"
                            },
                            {
                                "example_id": "46bc0799-9786-44f0-b2b2-5f323404f7b2",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "[Ecuador:] „Dämpfend auf die Machtgelüste des Militärs wirkt auch die schwere Wirtschaftskrise, die zu lösen es lieber in der Verantwortung der Zivilisten beläßt.“"
                            },
                            {
                                "example_id": "394abebe-0363-4f5e-9cf6-c6ee686bf6da",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Ab 2011 gelangen vertrauliche Dokumente aus dem Vatikan an die Öffentlichkeit. Bei dem \"Vatileaks\" genannten Skandal geht es um Korruption sowie Sex-, Geld- und Machtgelüste innerhalb der römischen Kurie.“"
                            },
                            {
                                "example_id": "3f5fe221-567e-4d00-a08d-9367c82c8851",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Die baltischen Staaten Estland, Lettland und Litauen waren immer Ziel russischer Machtgelüste.“"
                            },
                            {
                                "example_id": "a2b4b69a-a649-4f14-a862-f1d491e981fc",
                                "sense_id": "defc207f-5c72-326b-a229-11cfeff4934b",
                                "text": "„Nun“ […] „sucht die altehrwürdige KMK“ […] „eine Antwort auf die Machtgelüste von Höcke und seiner rechtsextremen Gesinnungsgenossen:“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
