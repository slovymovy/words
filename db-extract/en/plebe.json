                    },
                    {
                        "sense_id": "28aea0f4-3459-38a6-8b18-26808aaece78",
                        "entry_id": "8971a20b-acaa-3102-ab2d-f8ffb3a44e6a",
                        "glosses": [
                            "A freshman cadet at a military academy."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9526fe4a-07b7-4bc9-91d4-a1b8d1e25684",
                                "sense_id": "28aea0f4-3459-38a6-8b18-26808aaece78",
                                "text": "My drill master, a young stripling, told me I was not so ‘gross’ as most other pleibs, the name of all new cadets."
                            },
                            {
                                "example_id": "aa58a677-7ac8-400c-b3fe-aac534a44f38",
                                "sense_id": "28aea0f4-3459-38a6-8b18-26808aaece78",
                                "text": "\"But is a plebe forbidden to stroll here?\"\n\"If a plebe did have the brass to try it,\" replied Anstey slowly, \"I reckon he would have to fight the whole yearling class in turn.\""
                            },
                            {
                                "example_id": "99127ab1-5321-4013-a5cb-a37f54d8824a",
                                "sense_id": "28aea0f4-3459-38a6-8b18-26808aaece78",
                                "text": "Plebes spend their first summer at Cadet Basic Training — Beast Barracks — where they get soldierized."
                            },
                            {
                                "example_id": "816faf55-5fd8-422d-8ef8-cc7d34c8d802",
                                "sense_id": "28aea0f4-3459-38a6-8b18-26808aaece78",
                                "text": "“You went to The Citadel?” her mother chimed in. “I’ve heard so many great things about that institution. Did you go through a plebe year?” I told her I did and that we called it the knob year because freshman cadets had to shave their heads bald to resemble the butt end of a door knob and keep it that way for an entire ten months while going through the process of being broken down, only to be built back up."
                            }
                        ]
                    }
