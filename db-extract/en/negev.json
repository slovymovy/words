                    {
                        "translation_id": "e96a24a3-0da4-4711-be99-fcdba0ccc2f5",
                        "source_entry_id": "c5cabec6-b062-368e-ba63-073dd94864eb",
                        "source_sense_id": "9f625ed4-752d-333a-b82e-71c32529f1dc",
