                    }
                ],
                "translations": [
                    {
                        "translation_id": "e50a3dbb-8317-4e89-9880-2aa22541703c",
                        "source_entry_id": "d90a149d-995e-3962-b9b9-9149510b711c",
                        "source_sense_id": "fb3960d6-c330-3152-a939-f3f663b8aacc",
                        "target_lang_word": "tobacco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tobacco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b24d41c7-bad8-300a-ae9f-566b698cddbe",
                                        "entry_id": "e9bfef5a-af88-3ceb-84bf-30e90aad28c8",
                                        "glosses": [
                                            "To indulge in tobacco; to smoke."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b83741e-82cf-37ad-88d2-f0bbcef1edac",
                                        "entry_id": "e9bfef5a-af88-3ceb-84bf-30e90aad28c8",
                                        "glosses": [
                                            "To treat with tobacco."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "436661bc-8339-47a6-966b-0121d8efb655",
                                                "sense_id": "2b83741e-82cf-37ad-88d2-f0bbcef1edac",
                                                "text": "The most satisfactory method of tobaccoing houses is that of stitching the leaves on to a piece of cloth like a strip of matting, which is then laid on the floor. Powdered tobacco should be introduced into rat holes, which can then be firmly closed up with bricks and mortar. Experiments carried out in the City of Hyderabad seem to have been very satisfactory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tobacco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd16905c-903f-31db-a1d8-dbb82bfef9fc",
                                        "entry_id": "77f6ba56-3fee-3b2e-aa4e-dffbfc0414de",
                                        "glosses": [
                                            "Any plant of the genus Nicotiana."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                        "entry_id": "77f6ba56-3fee-3b2e-aa4e-dffbfc0414de",
                                        "glosses": [
                                            "Leaves of Nicotiana tabacum and some other species cultivated and harvested to make cigarettes, cigars, snuff, for smoking in pipes or for chewing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a5bdfd7-ac7a-4c00-abbc-b65819e243a0",
                                                "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                                "text": "Tobacco-settlement bonds are a tribute both to the inventiveness of bankers and the childlike impatience of politicians."
                                            },
                                            {
                                                "example_id": "677aaf05-438e-401a-94fb-7406dd2c3120",
                                                "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                                "text": "Tobacco and the plant valerian are also considered to be anaphrodisiac in their effects, diminishing sexual inclination."
                                            },
                                            {
                                                "example_id": "af56534d-0106-4e48-93fb-a1567807d43d",
                                                "sense_id": "882902ab-32be-3b25-93f3-5830cf13f57d",
                                                "text": "City councilors in Newton have approved a generational ban on tobacco and e-cigarette sales in the city that will prohibit purchases by anyone born after March 1, 2004, joining a growing number of Massachusetts communities that have passed measures to curb tobacco use among young people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caad91f2-f303-3b24-8d8d-28b313076c4a",
                                        "entry_id": "77f6ba56-3fee-3b2e-aa4e-dffbfc0414de",
                                        "glosses": [
                                            "A variety of tobacco."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6b461e-6951-4bab-9597-a414846f6ffd",
                                                "sense_id": "caad91f2-f303-3b24-8d8d-28b313076c4a",
                                                "text": "Tobaccos from the Connecticut Valley were used for wrapping cigars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e01bd20-a090-4ee8-a774-4e11ba0cea9c",
                        "source_entry_id": "d90a149d-995e-3962-b9b9-9149510b711c",
                        "source_sense_id": "fb3960d6-c330-3152-a939-f3f663b8aacc",
                        "target_lang_word": "tabákový",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tabákový",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "accd9e87-1e4a-33f4-8893-11c87e227d7f",
                                        "entry_id": "477adadb-4fef-3d74-9e1b-62f3bbe8b470",
                                        "glosses": [
                                            "související s tabákem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eef6941-3a4e-43f0-b773-da4b9886d605",
                                                "sense_id": "accd9e87-1e4a-33f4-8893-11c87e227d7f",
                                                "text": "Tabákové firmy se pod tlakem úřadů a protikuřáckých kampaní dostaly do fáze, kdy chtějí lidem pomáhat, aby přestali kouřit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95bcb899-0d4f-442a-ae7d-3cbc4681e43f",
                        "source_entry_id": "d90a149d-995e-3962-b9b9-9149510b711c",
                        "source_sense_id": "fb3960d6-c330-3152-a939-f3f663b8aacc",
                        "target_lang_word": "табачный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "табачный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8d18a4e6-ff8a-3b36-823c-bc541e21d4f8",
                                        "entry_id": "2b89e60e-910d-369d-a49e-b781bcd405f4",
                                        "glosses": [
                                            "относящийся к табаку, содержащий табак, сделанный, полученный из табака"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7cc26fc-ed0d-42c1-b550-816342c9216e",
                                                "sense_id": "8d18a4e6-ff8a-3b36-823c-bc541e21d4f8",
                                                "text": "В пепельнице остались табачные крошки, едва заметные следы пепла."
                                            },
                                            {
                                                "example_id": "4a9c843b-489a-4b7a-9b7f-f1c58f26d65c",
                                                "sense_id": "8d18a4e6-ff8a-3b36-823c-bc541e21d4f8",
                                                "text": "Между прочим, табачный дым содержит компоненты, образующие при реакции с цитохромами и легко проходящие через сигаретный фильтр."
                                            },
                                            {
                                                "example_id": "6beb9bcc-029d-4687-bc5d-b86f9a205638",
                                                "sense_id": "8d18a4e6-ff8a-3b36-823c-bc541e21d4f8",
                                                "text": "Не приближаясь к спящим детям, чтобы не дохнуть на них табачным смрадом, они послушают их сонные посапывания и бормотания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e7d3a8e-8569-3f62-8a0a-4f9bc6e8c0fd",
                                        "entry_id": "2b89e60e-910d-369d-a49e-b781bcd405f4",
                                        "glosses": [
                                            "относящийся к выращиванию, обработке табака, производству изделий из табака или к торговле табаком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5040a4ae-efbf-4d38-aa28-9b9669329dc7",
                                                "sense_id": "3e7d3a8e-8569-3f62-8a0a-4f9bc6e8c0fd",
                                                "text": "Прабабка смолоду служила на табачной фабрике, где, видно, и пристрастилась к курению…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ab297b1-36fc-3547-a97f-d210ecee14e0",
                                        "entry_id": "2b89e60e-910d-369d-a49e-b781bcd405f4",
                                        "glosses": [
                                            "похожий по цвету на табак, зеленовато-коричневый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4797eb4b-c7ac-4fc3-a410-e1d11a455282",
                                                "sense_id": "1ab297b1-36fc-3547-a97f-d210ecee14e0",
                                                "text": "К нему очень шла табачного цвета с отливом венгерка, или, лучше сказать, архалук без аграманта и кистей…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70642fab-382e-38c2-8c5e-ad57f9e8fac9",
                                        "entry_id": "2b89e60e-910d-369d-a49e-b781bcd405f4",
                                        "glosses": [
                                            "диал. и спец. трухлявый, гнилой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21097ec2-23e9-4766-bf23-a57185cd80aa",
                                                "sense_id": "70642fab-382e-38c2-8c5e-ad57f9e8fac9",
                                                "text": "В табачных сучках древесина почти полностью разрушена гнилью и представляет собой рыхлую массу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
