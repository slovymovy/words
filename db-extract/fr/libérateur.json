                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "освободитель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0323a629-5630-319e-a2b5-d1844dc9238f",
