                        "glosses": [
                            "Synonyme de troyen en particulier dans le département de la Meurthe."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "c373b000-336e-4152-b4cc-77096f7128c4",
                                "sense_id": "8b4e5fe2-92f8-35a5-bd69-7106c54f052a",
                                "text": "Les plants le plus généralement cultivés sont le pineau noir et le blanc, qui donnent le meilleur vin ; l’éricé noir, plus connu sous le nom de liverdun, et qu’on préfère ici au pineau ; l’éricé blanc, le gamet, le facan et la grosse race."
                            },
                            {
                                "example_id": "55b9e9b7-2cc6-4b4e-bd5e-6d8e8cab578b",
                                "sense_id": "8b4e5fe2-92f8-35a5-bd69-7106c54f052a",
                                "text": "On vante beaucoup, depuis quelques temps, l’éricé ou éricé noir, ou liverdum ^([sic]), variété qu’on cultive dans l’arrondissement de Château-Salins, département de la Meurthe, et qui paraît réunir beaucoup d’avantages et mériter la préférence."
                            }
                        ]
                    }
