                                                "sense_id": "b8d5334c-7f67-3796-8a1c-c1a94fcb0526",
                                                "text": "The letter \"G\" was found in volume 4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e79f085-50a6-30b2-a279-dc944a765975",
                                        "entry_id": "8f18d5d1-c102-38db-a5a5-498b47bc40d3",
                                        "glosses": [
