{
    "word_family": [
        "jouster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "097fdac0-d80e-3bea-bf30-3bb8b5abae23",
                    "sense_definition": "A mock combat between two mounted knights using lances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king watched the <w>joust</w> from his high balcony.",
                            "target_lang_translations": {
                                "pl": "Król obserwował <w>turniej rycerski</w> ze swojego wysokiego balkonu."
                            }
                        },
                        {
                            "text": "The knight prepared his lance for the upcoming <w>joust</w>.",
                            "target_lang_translations": {
                                "pl": "Rycerz przygotował swoją kopię do nadchodzącego <w>turnieju</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tilt"
                    ],
                    "target_lang_definitions": {
                        "pl": "Średniowieczne zawody rycerskie, w których dwóch konnych walczyło ze sobą za pomocą kopii."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "turniej rycerski",
                                "target_lang_sense_clarification": "zawody rycerskie"
                            },
                            {
                                "target_lang_word": "kopijnictwo",
                                "target_lang_sense_clarification": "walka na kopie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c82ada7-976a-353c-b3b5-435887f938d4",
                    "sense_definition": "To engage in mock combat on horseback.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two knights prepared to <w>joust</w> in the tournament.",
                            "target_lang_translations": {
                                "pl": "Dwaj rycerze przygotowywali się, by <w>stawać w szranki</w> podczas turnieju."
                            }
                        },
                        {
                            "text": "They learned how to <w>joust</w> during their training.",
                            "target_lang_translations": {
                                "pl": "Uczyli się, jak <w>pojedynkować się na kopie</w> podczas treningu."
                            }
                        }
                    ],
                    "synonyms": [
                        "tilt"
                    ],
                    "target_lang_definitions": {
                        "pl": "Brać udział w walce na kopie na koniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stawać w szranki",
                                "target_lang_sense_clarification": "brać udział w pojedynku"
                            },
                            {
                                "target_lang_word": "pojedynkować się",
                                "target_lang_sense_clarification": "walczyć na kopie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdcdf0f7-e21d-35f6-a3ea-6d72c315cca9",
                    "sense_definition": "To engage in verbal sparring or argument.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Politicians often <w>joust</w> with words during televised debates.",
                            "target_lang_translations": {
                                "pl": "Politycy często <w>ścinają się na słowa</w> podczas telewizyjnych debat."
                            }
                        },
                        {
                            "text": "The two lawyers continued to <w>joust</w> over the legal interpretation.",
                            "target_lang_translations": {
                                "pl": "Prawnicy kontynuowali <w>słowny spór</w> dotyczący interpretacji prawnej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verbally joust"
                    ],
                    "target_lang_definitions": {
                        "pl": "Toczyć słowny spór lub debatę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ścinać się",
                                "target_lang_sense_clarification": "kłócić się, spierać"
                            },
                            {
                                "target_lang_word": "wymieniać uszczypliwości",
                                "target_lang_sense_clarification": "prowadzić słowny pojedynek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}