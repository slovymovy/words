                "senses": [
                    {
                        "sense_id": "b4c506a2-9338-3cd9-a004-554beda6dd19",
                        "entry_id": "91b31bbd-0b36-3b12-afc8-f387093c7baf",
                        "glosses": [
                            "разг. пропускать работу по причине болезни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e11139-cb71-4a56-80d6-9bbec2a2614e",
                                "sense_id": "b4c506a2-9338-3cd9-a004-554beda6dd19",
                                "text": "Я, конечно, ругалась. Мне мол, бюллетенить некогда!"
                            },
                            {
                                "example_id": "0ac2f839-5d64-47e2-b305-974ab189b613",
                                "sense_id": "b4c506a2-9338-3cd9-a004-554beda6dd19",
                                "text": "Она у нас по два раза в месяц бюллетенит: мерцательная аритмия, стеноз…"
                            },
                            {
                                "example_id": "904b966c-504b-4e9e-bf5d-2e1885eacdba",
                                "sense_id": "b4c506a2-9338-3cd9-a004-554beda6dd19",
                                "text": "Султан Мамедов уже четвёртый день не работал: в драке с Бринько он повредил руку и бюллетенил."
                            }
                        ]
                    }
