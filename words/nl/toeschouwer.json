{
    "word_family": [
        "toeschouwen",
        "schouw",
        "schouwer",
        "toeschouwster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3d24543-a289-3665-9f04-dc6e584f5965",
                    "sense_definition": "een bezoeker van een wedstrijd, evenement of een voorstelling",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "publiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het stadion waren veel <w>toeschouwers</w> aanwezig om de finale te bekijken.",
                            "target_lang_translations": {
                                "en": "There were many <w>spectators</w> present in the stadium to watch the final."
                            }
                        },
                        {
                            "text": "De <w>toeschouwer</w> op de eerste rij had een prachtig zicht op het podium.",
                            "target_lang_translations": {
                                "en": "The <w>spectator</w> in the first row had a wonderful view of the stage."
                            }
                        }
                    ],
                    "synonyms": [
                        "kijker",
                        "publiek",
                        "aanwezige"
                    ],
                    "common_phrases": [
                        "enthousiaste toeschouwers",
                        "toeschouwers in het stadion"
                    ],
                    "target_lang_definitions": {
                        "en": "a visitor to a match, event, or performance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spectator",
                                "target_lang_sense_clarification": "someone watching a sporting event or public show"
                            },
                            {
                                "target_lang_word": "viewer",
                                "target_lang_sense_clarification": "someone watching a spectacle or exhibition"
                            },
                            {
                                "target_lang_word": "onlooker",
                                "target_lang_sense_clarification": "someone watching an event without participating"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aac021dd-5fe1-3ff2-b208-386de24c52fe",
                    "sense_definition": "iemand die naar een gebeurtenis kijkt zonder er zelf aan deel te nemen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarnemer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>toeschouwers</w> zagen hoe hij verdronk en belden direct het alarmnummer.",
                            "target_lang_translations": {
                                "en": "The <w>onlookers</w> saw him drowning and immediately called the emergency number."
                            }
                        },
                        {
                            "text": "Als passieve <w>toeschouwer</w> kon hij alleen maar toekijken hoe het ongeluk gebeurde.",
                            "target_lang_translations": {
                                "en": "As a passive <w>bystander</w>, he could only watch as the accident happened."
                            }
                        }
                    ],
                    "synonyms": [
                        "kijker",
                        "omstander"
                    ],
                    "common_phrases": [
                        "passieve toeschouwer",
                        "toeschouwer zijn van"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who watches an event without participating in it themselves"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bystander",
                                "target_lang_sense_clarification": "someone present at an event but not involved"
                            },
                            {
                                "target_lang_word": "onlooker",
                                "target_lang_sense_clarification": "someone who watches something happening"
                            },
                            {
                                "target_lang_word": "observer",
                                "target_lang_sense_clarification": "someone who notices or watches something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}