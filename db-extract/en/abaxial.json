                "senses": [
                    {
                        "sense_id": "05b6dd88-d77b-315b-a227-ddc2222920bb",
                        "entry_id": "8e1caad2-af51-3733-9da7-7ced0a4602dc",
                        "glosses": [
                            "Of a side that is facing away from the axis or central line, such as the underside of a leaf, or the back of an animal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f9c1755-57d3-467d-989b-0ba05816bdd8",
                                "sense_id": "05b6dd88-d77b-315b-a227-ddc2222920bb",
                                "text": "The lobule margins, furthermore, are arched away from the lobe, with the consequence that (when fully inflated) the abaxial leaf surface forms the interior lining of the lobule."
                            }
                        ]
                    },
                    {
                        "sense_id": "90d0a282-a342-37d8-986c-4c4751f64db9",
                        "entry_id": "8e1caad2-af51-3733-9da7-7ced0a4602dc",
                        "glosses": [
                            "Not in the axis. Applied to an embryo placed out of the axis of the seed."
                        ],
                        "tags": [
