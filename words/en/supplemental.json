                    ],
                    "synonyms": [
                        "addition",
                        "supplement",
                        "add-on"
                    ],
                    "antonyms": [
                        "core",
                        "essential"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или элемент, который добавляется к чему-либо другому для его улучшения или завершения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "то, что добавляется к чему-либо"
                            },
                            {
                                "target_lang_word": "добавка",
                                "target_lang_sense_clarification": "дополнительный элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "113e084d-a870-3617-acd7-e4f1a0ab00b4",
                    "sense_definition": "A formal request or legislative act that grants extra funding for a specific program or project.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The department submitted a <w>supplemental</w> to cover the unexpected costs of the infrastructure project.",
                            "target_lang_translations": {
                                "ru": "Департамент подал запрос на <w>дополнительные ассигнования</w>, чтобы покрыть непредвиденные расходы по инфраструктурному проекту."
                            }
                        },
                        {
                            "text": "Congress debated the budget <w>supplemental</w> for several hours before reaching a final decision.",
                            "target_lang_translations": {
                                "ru": "Конгресс несколько часов обсуждал <w>дополнительный бюджет</w>, прежде чем принять окончательное решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "appropriation"
                    ],
                    "common_phrases": [
                        "budget supplemental"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in government or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный запрос или законодательный акт, предоставляющий дополнительное финансирование для конкретной программы или проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительные ассигнования",
                                "target_lang_sense_clarification": "выделение добавочных средств"
                            },
                            {
                                "target_lang_word": "дополнительный бюджет",
                                "target_lang_sense_clarification": "сверх утвержденного бюджета"
                            }
                        ]
                    }
                }
            ]
        }
    ]
