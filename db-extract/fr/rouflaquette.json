        "fr-extract.jsonl": [
            {
                "entry_id": "2b454542-984a-3139-8485-877577ec4083",
                "word": "rouflaquette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "978ec677-f32a-4629-a074-ab32e1fca42b",
                        "entry_id": "2b454542-984a-3139-8485-877577ec4083",
                        "tags": [
                            "plural"
                        ],
                        "form": "rouflaquettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14f6f9cf-0b31-30b8-8529-b37f7d37f283",
                        "entry_id": "2b454542-984a-3139-8485-877577ec4083",
                        "glosses": [
                            "Favoris, patte de cheveux descendant sur les joues d'un homme."
                        ],
                        "tags": [
                            "Barbe"
                        ],
                        "examples": [
                            {
                                "example_id": "bd364654-f678-4728-a7fc-75da0f2a9df3",
                                "sense_id": "14f6f9cf-0b31-30b8-8529-b37f7d37f283",
                                "text": "Il n’avait rien des Fondaudège, ce fils de Marinette, ce garçon aux yeux de jais, aux cheveux plantés bas et ramenés sur les tempes comme des « rouflaquettes », disait Hubert."
                            },
                            {
                                "example_id": "8506f211-84d7-4876-b91b-ee01075c5d5a",
                                "sense_id": "14f6f9cf-0b31-30b8-8529-b37f7d37f283",
                                "text": "Il promenait une silhouette singulière, avec de rouflaquettes pointues qui lui descendaient jusqu’aux maxillaires, et il poussait des cris dans la rue, plus exactement il criait des mots."
                            },
                            {
                                "example_id": "42113ed3-f7d7-4748-b9d5-da5b49180dd4",
                                "sense_id": "14f6f9cf-0b31-30b8-8529-b37f7d37f283",
                                "text": "Il y a un siècle à peine, en France, seuls étaient glabres les hommes d’Église et les domestiques. Barbes fluviales des socialistes et des anarchistes, favoris des libéraux et des maitres d’hôtel, impériale des bonapartistes, rouflaquettes des apaches, les visages affichaient les convictions politiques et les conditions sociales."
                            },
                            {
                                "example_id": "99a11f02-f582-4007-9514-7411c213fe24",
                                "sense_id": "14f6f9cf-0b31-30b8-8529-b37f7d37f283",
                                "text": "Son père était un homme charpenté aux rouflaquettes si longues qu’elles rejoignaient sa moustache, formant un cercle autour des yeux et du nez. — (Gaël Faye, Petit Pays, Grasset, 2016, page 74)"
                            }
                        ]
                    },
                    {
                        "sense_id": "4c1ea731-e2a6-3900-8379-70edf03aed86",
                        "entry_id": "2b454542-984a-3139-8485-877577ec4083",
                        "glosses": [
                            "Mèche de cheveux roulée sur la tempe en forme d’accroche-cœur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7341bc83-6e99-4470-835a-9dd2b08343c1",
                                "sense_id": "4c1ea731-e2a6-3900-8379-70edf03aed86",
                                "text": "Accroche-cœur –\nAux larmes de cendre,\nelle regarda\nla rouflaquette de l’écrin,\nsouvenir\nd’une époque crépusculaire,\npeu avant le début\n…\nde sa chimiothérapie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f145f3e-cb23-4de8-8da8-9529f076f7b1",
                        "source_entry_id": "2b454542-984a-3139-8485-877577ec4083",
                        "source_sense_id": "14f6f9cf-0b31-30b8-8529-b37f7d37f283",
                        "source_sense_description": "Favoris, patte de cheveux",
                        "target_lang_word": "Koteletten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koteletten",
