                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f8e415b-c85c-484a-abeb-9104bae82185",
                        "source_entry_id": "07ea6311-6a7a-37e6-bda9-037e5cf9e3b4",
                        "source_sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                        "source_sense_description": "dreiste Art",
                        "target_lang_word": "audacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                        "entry_id": "0911a438-b25c-3dd5-bc39-f5a5d81dbc55",
                                        "glosses": [
                                            "Insolent boldness, especially when imprudent or unconventional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a23c6a9-68b7-414f-883a-7d4abe135475",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "The brash private had the audacity to criticize the general."
                                            },
                                            {
                                                "example_id": "eea964cd-dda4-4edc-b7ce-354016c22011",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "Somebody never pays his loans, yet he has the audacity to ask the bank for money."
                                            },
                                            {
                                                "example_id": "ae9751cc-9d03-4f39-8dce-1c948e3f52e3",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "“Oh?” she said. “So you have decided to revise my guest list for me? You have the nerve, the – the –” I saw she needed helping out. “Audacity,” I said, throwing her the line. “The audacity to dictate to me who I shall have in my house.” It should have been “whom”, but I let it go. “You have the –” “Crust.” “– the immortal rind,” she amended, and I had to admit it was stronger, “to tell me whom” – she got it right that time – “I may entertain at Brinkley Court and who” – wrong again – “I may not.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ddd532-8fd6-3fab-aaf0-77ba602d1943",
                                        "entry_id": "0911a438-b25c-3dd5-bc39-f5a5d81dbc55",
                                        "glosses": [
                                            "Fearlessness, intrepidity or daring, especially with confident disregard for personal safety, conventional thought, or other restrictions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da09c19a-1b6d-49bc-87fd-d313ecb0bc6c",
                        "source_entry_id": "07ea6311-6a7a-37e6-bda9-037e5cf9e3b4",
                        "source_sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                        "source_sense_description": "dreiste Art",
                        "target_lang_word": "effronterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effronterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                                        "glosses": [
                                            "Caractère, attitude de celui qui est effronté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e68b0ec-4f9d-4e50-8cfe-a8617cc77068",
                                                "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                                                "text": "… nous entendions la respiration des chèvres. Il y en eut même quelques-unes qui pénétrèrent dans notre logis et qui s’y installèrent malgré nous, avec l’effronterie drôle propre à leur espèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                                        "glosses": [
                                            "Manière d’agir, de parler de celui qui est effronté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d937d83-3eef-4a81-bdbe-411f80e49838",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "M. Clausel prit la parole, et il eut l’effronterie de déclarer qu’aussitôt que la Chambre serait prorogée, il imprimerait un Mémoire à ce sujet."
                                            },
                                            {
                                                "example_id": "fe79b30b-cdfb-4867-8a8f-a810a730e67f",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "(…) une vieille dame en chapeau jaune, à mine basse de pourvoyeuse, et deux mineures, deux fillettes de treize ou quatorze ans, déhanchées, d’une effronterie gênante."
                                            },
                                            {
                                                "example_id": "6ef282ee-21f9-4b8a-911a-6aac34ed815d",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "Culotté le corvidé ! qui n'hésitait pas à tirer les plumes de la queue du convive pour le forcer à s'éloigner. Vite lassé par tant d’effronterie, l'aigle noir s'est brutalement retourné, bec grand ouvert, ailes déployées, au comble de l'irritation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
