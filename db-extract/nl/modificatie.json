                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48a87c15-db0f-341b-9b87-e61b71ab177b",
                                        "entry_id": "daa4cda0-f9af-3e6c-8539-2ddf2679c205",
                                        "glosses": [
                                            "The form of existence belonging to a particular object, entity etc.; a mode of being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5d7d48-39e2-442b-bc30-0208d9e621d2",
                                                "sense_id": "48a87c15-db0f-341b-9b87-e61b71ab177b",
                                                "text": "Pleasure is the business of woman's life, according to the present modification of society […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9c6e2d-2028-34f1-aee3-c86c4226dbd4",
                                        "entry_id": "daa4cda0-f9af-3e6c-8539-2ddf2679c205",
                                        "glosses": [
                                            "the change undergone by a word when used in a construction (for instance am => 'm in I'm)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d1197e0-fc47-3bf8-8556-597524f88ac8",
                                        "entry_id": "daa4cda0-f9af-3e6c-8539-2ddf2679c205",
                                        "glosses": [
                                            "The result of modifying something; a new or changed form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e6a6af0-3315-31d7-9811-6dfd42629916",
                                        "entry_id": "daa4cda0-f9af-3e6c-8539-2ddf2679c205",
                                        "glosses": [
                                            "The act of making a change to something while keeping its essential character intact; an alteration or adjustment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c073946-c7cb-42c6-802f-b688106f8ef3",
                                                "sense_id": "6e6a6af0-3315-31d7-9811-6dfd42629916",
                                                "text": "behavior modification officer"
                                            },
                                            {
                                                "example_id": "3d849999-b0c4-4044-abd9-9247264af8d7",
                                                "sense_id": "6e6a6af0-3315-31d7-9811-6dfd42629916",
                                                "text": "Jim's modification to the radio's tuning resulted in clearer sound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d5a144-731f-3b8c-9799-5983d7460f8d",
                                        "entry_id": "daa4cda0-f9af-3e6c-8539-2ddf2679c205",
                                        "glosses": [
                                            "A change to an organism as a result of its environment that is not transmissable to offspring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a313c0b-6bcd-4651-8ba4-9eb9754162ba",
                                                "sense_id": "97d5a144-731f-3b8c-9799-5983d7460f8d",
                                                "text": "Due to his sunbathing, Jim's body experienced modifications: he got a tan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f56301e-7ade-3bad-bb34-022402916a0e",
                                        "entry_id": "daa4cda0-f9af-3e6c-8539-2ddf2679c205",
                                        "glosses": [
                                            "a change to a word when it is borrowed by another language"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a0519bf-c393-493b-9a2e-3a308ccdc320",
                                                "sense_id": "2f56301e-7ade-3bad-bb34-022402916a0e",
                                                "text": "The Chinese word \"kòu tóu\" had a modification made to become the English \"kowtow\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee0d06eb-80a4-42f4-b251-60f1dbf93354",
                        "source_entry_id": "1cf32fce-eb7b-3254-9165-ee4b79da9bca",
                        "target_lang_word": "modification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "172b6a88-097c-3ad7-b129-fee00b6da420",
                                        "entry_id": "ad4cef2c-1fc4-3f78-adb8-ea925e62bc0d",
                                        "glosses": [
                                            "Action de modifier, résultat de cette action."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475bc920-40ee-414e-9283-d43cade2852d",
                                                "sense_id": "172b6a88-097c-3ad7-b129-fee00b6da420",
                                                "text": "Nous avons cependant indiqué quelles modifications délicates et surtout quelles précautions prenaient les chasselatiers de la moyenne Garonne pour obtenir des produits d’une haute valeur commerciale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79b24dd4-b754-3ce6-b6f6-97c92d9ba9e8",
                                        "entry_id": "ad4cef2c-1fc4-3f78-adb8-ea925e62bc0d",
                                        "glosses": [
                                            "Changement qui s’opère dans une substance, une chose, un être."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30861219-b582-48f3-bd6e-b41a8badde9e",
                                                "sense_id": "79b24dd4-b754-3ce6-b6f6-97c92d9ba9e8",
                                                "text": "Les corps subissent différentes modifications suivant les milieux où ils se trouvent."
                                            },
                                            {
                                                "example_id": "ec73ccda-c258-4016-9644-eda133f16ced",
                                                "sense_id": "79b24dd4-b754-3ce6-b6f6-97c92d9ba9e8",
                                                "text": "Pour les assurances vie, les aggravations de risque se référant à une modification de l’état de santé en cours de contrat n’ont pas besoin d’être déclarées."
                                            },
                                            {
                                                "example_id": "eac015d0-2ad1-4435-a702-eb92017dc31f",
                                                "sense_id": "79b24dd4-b754-3ce6-b6f6-97c92d9ba9e8",
                                                "text": "Votre opinion est susceptible de beaucoup de modifications. Note : À cheval entre sens 2 et 3"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a00c263-165b-3a26-b450-8fc5e29d5c29",
                                        "entry_id": "ad4cef2c-1fc4-3f78-adb8-ea925e62bc0d",
                                        "glosses": [
                                            "Changement que l’on opère dans une chose quelconque."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9b1fbb6-cf7b-4b44-8f0f-4758ecfb1246",
                                                "sense_id": "0a00c263-165b-3a26-b450-8fc5e29d5c29",
                                                "text": "Parmi les modifications importantes, il faut encore citer la mise en place d'un système de réchauffage pour empêcher les carburateurs de givrer."
                                            },
                                            {
                                                "example_id": "ccd874f3-1cde-410b-8053-f118cb7abdda",
                                                "sense_id": "0a00c263-165b-3a26-b450-8fc5e29d5c29",
                                                "text": "Il faut apporter quelques modifications à ces arrangements."
                                            },
                                            {
                                                "example_id": "24939a3f-fd6c-4594-bf79-b8bf74bc9c76",
                                                "sense_id": "0a00c263-165b-3a26-b450-8fc5e29d5c29",
                                                "text": "J'ai fait des modifications à ton texte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a04ca586-562b-30ff-bd5f-e9bebcf8b733",
                                        "entry_id": "ad4cef2c-1fc4-3f78-adb8-ea925e62bc0d",
                                        "glosses": [
                                            "Changement effectué à dessein pour satisfaire à de nouvelles exigences."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6fd7156-9e7b-471a-8675-8cf8e47d0a60",
                                                "sense_id": "a04ca586-562b-30ff-bd5f-e9bebcf8b733",
                                                "text": "Modification – La révision de la capacité fonctionnelle d’un produit afin de satisfaire à de nouveaux critères d’acceptation. Les modifications sont généralement nécessaires pour intégrer des évolutions de conception qui peuvent être vérifiées par les plans, des ordres de modification, etc... Les modifications devraient être réalisées seulement quand elles sont spécifiquement autorisées et décrites en détail sur la documentation approuvée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
