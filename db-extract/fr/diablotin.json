                                "sense_id": "3278898a-7193-3262-8207-911fa3b5211b",
                                "text": "Le diablotin positiviste se réveille en moi […]."
                            },
                            {
                                "example_id": "af2ca63a-99a9-47eb-8632-ba8e891752f5",
                                "sense_id": "3278898a-7193-3262-8207-911fa3b5211b",
