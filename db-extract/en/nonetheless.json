                                        "glosses": [
                                            "(staví věty do protikladu) naproti tomu, bez ohledu na to"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6897d2d3-4db8-4473-8417-503714e48993",
                                                "sense_id": "2335b8cf-7d01-3346-9966-4f8eebeaefb0",
                                                "text": "Už jsem ti to vysvětloval mockrát, nicméně ty tomu pořád nerozumíš, takže ti to vysvětlím znovu."
                                            }
                                        ]
                                    },
                                    {
