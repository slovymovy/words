                "senses": [
                    {
                        "sense_id": "34ef926e-1360-31d8-9f78-870601f2937c",
                        "entry_id": "66dfd00c-e328-35af-a355-4fe529df25c3",
                        "glosses": [
                            "Provoquer le confinement de, confiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e199c2e9-02b5-445d-bee6-59e35eff6c89",
                                "sense_id": "34ef926e-1360-31d8-9f78-870601f2937c",
                                "text": "Qu'est ce que tu fais, toi, enconfiné que tu es, très cher voisin ?"
                            },
                            {
                                "example_id": "72e55b4d-9647-4e41-8ba0-85c824fb389c",
                                "sense_id": "34ef926e-1360-31d8-9f78-870601f2937c",
                                "text": "Un an et demi plus tard, enconfiné tout seul dans ma garçonnière prévue pour être accueillante (!…), je découvre par hasard !…"
                            },
                            {
                                "example_id": "e4185666-fcf0-4184-879f-6f90bc4ee7f5",
                                "sense_id": "34ef926e-1360-31d8-9f78-870601f2937c",
                                "text": "Le calendrier, l’horloge semblent ne plus avoir aucun sens, tandis que celui des mots fait clic-clac, se décalant au fur et à mesure que notre vie s’enconfine."
                            }
                        ]
                    }
