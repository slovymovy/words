                ],
                "senses": [
                    {
                        "sense_id": "d2957c43-e8e5-3420-b04b-a57aa9e6c1c2",
                        "entry_id": "0d3010fd-31cc-37eb-ba6c-8bcaacb19246",
                        "glosses": [
                            "Accouplement sexuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef72d866-0f18-4976-9215-44d1b1a4c4ec",
                                "sense_id": "d2957c43-e8e5-3420-b04b-a57aa9e6c1c2",
                                "text": "Les nouvelles mariées disent que le coït peut faire crier de douleur. […] On comprend que nombre de femmes n’aiment pas particulièrement le coït, car si le mari ne s’occupe guère de faire jouir sa compagne, c’est la douleur qui demeure la plus vive."
                            },
                            {
                                "example_id": "af2aac30-7e1d-4526-9b18-37ae11639613",
                                "sense_id": "d2957c43-e8e5-3420-b04b-a57aa9e6c1c2",
                                "text": "Jean Borie, en accord avec Sartre aussi bien qu’avec Foucault, souligne qu’un retournement s’était, à ce propos, opéré depuis le XVIIIᵉ siècle; le désir et la jouissance, que l’on cesse d'exalter en les associant à la génération, se trouvent relégués au nouveau statut d’instinct génésique; dès lors, le coït conjugal se trouve plus étroitement associé à la notion de devoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "95f354c2-6a01-3914-9b4d-a55280394ec1",
                        "entry_id": "0d3010fd-31cc-37eb-ba6c-8bcaacb19246",
                        "glosses": [
                            "Pratique sexuelle consistant à pénétrer le vagin ou l’anus avec le pénis."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e4fa2445-4e04-41e9-a777-65abac5a8f72",
                                "sense_id": "95f354c2-6a01-3914-9b4d-a55280394ec1",
                                "text": "Le coït homosexuel se fait debout ou assis (notamment en missionnaire) — ce qui était généralement le cas aussi en Grèce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ca97b25-b9d4-4902-a4c6-0ebe03794595",
                        "source_entry_id": "0d3010fd-31cc-37eb-ba6c-8bcaacb19246",
                        "target_lang_word": "Geschlechtsakt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschlechtsakt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a22e999-96ca-3633-8f9b-da233962cbd2",
                                        "entry_id": "84c36c1a-8deb-3aca-b789-d07c1fcc04fb",
                                        "glosses": [
                                            "sexuelle Vereinigung zweier oder mehrerer Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd45d4f5-fb3b-48c0-a39d-acaff81107d3",
                                                "sense_id": "9a22e999-96ca-3633-8f9b-da233962cbd2",
                                                "text": "Der Geschlechtsakt war schon nach wenigen Minuten wieder vorbei."
                                            },
                                            {
                                                "example_id": "bc404eed-ce8f-4cef-aa0c-e104c28effe7",
                                                "sense_id": "9a22e999-96ca-3633-8f9b-da233962cbd2",
                                                "text": "„Dort würde sich eine der Mägde mit einem Knecht treffen, sich ausziehen und vor den versammelten Kindern und Jugendlichen den Geschlechtsakt vorführen.“"
                                            },
                                            {
                                                "example_id": "f1404c71-78f0-4913-b4cd-8082ae4d3992",
                                                "sense_id": "9a22e999-96ca-3633-8f9b-da233962cbd2",
                                                "text": "„Sie war so besoffen, daß sie wahrscheinlich nur ausspuckte, was ihr zuvor ein Schriftsteller vor dem Geschlechtsakt erklärt hatte, damit sie sich ihm inbrünstiger hingäbe.“"
                                            },
                                            {
                                                "example_id": "84c0d5ae-82f8-44b7-b56b-7ca197e7a565",
                                                "sense_id": "9a22e999-96ca-3633-8f9b-da233962cbd2",
                                                "text": "„Der Geschlechtsakt ist zur körperlichen Verrichtung herabgesunken.“"
                                            },
                                            {
                                                "example_id": "9e29b52b-0ebb-4dce-aa05-2fc78a9f3282",
                                                "sense_id": "9a22e999-96ca-3633-8f9b-da233962cbd2",
                                                "text": "„Die Weltgesundheitsorganisation schätzt, dass sich tagaus, tagein etwa hundert Millionen Geschlechtsakte ereignen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
