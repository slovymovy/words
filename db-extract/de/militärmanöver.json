                        ],
                        "form": "die Militärmanöver"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45f18c3d-2572-33c6-ae3f-eb7fad6443d5",
                        "entry_id": "11b9cf58-54c9-37b4-9419-7eb014e37064",
                        "glosses": [
                            "militärische Übung, die Kriegssituationen simuliert, für den Fall eines Kriegs vorbereiten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc1ab91-1b64-4ce6-9a06-f2ccc07ec18c",
                                "sense_id": "45f18c3d-2572-33c6-ae3f-eb7fad6443d5",
                                "text": "„Mit meiner verstellten Stimme informierte ich ihn darüber hinaus, dass ein Militärmanöver stattfinde und es den Weisungen gemäß an ihm sei, die Universitätseinheit aufmarschieren zu lassen und durch den Park vorzurücken, um einen Überraschungsangriff auf das städtische Waffendepot zu führen.“"
                            },
                            {
                                "example_id": "dfc362a3-0b71-4ef6-998f-73a08bc94e88",
                                "sense_id": "45f18c3d-2572-33c6-ae3f-eb7fad6443d5",
                                "text": "„Im August 2012 überwachte Nasrallah persönlich das bis dahin größte Militärmanöver der Miliz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b7b5072-cc48-488a-bd08-ee09a6674772",
                        "source_entry_id": "11b9cf58-54c9-37b4-9419-7eb014e37064",
                        "source_sense_id": "45f18c3d-2572-33c6-ae3f-eb7fad6443d5",
                        "source_sense_description": "militärische Übung",
                        "target_lang_word": "maneuver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maneuver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c383afd-d597-38a1-93c4-92d87bdd332e",
                                        "entry_id": "df99b275-5fa9-3ffd-8277-14721e7749eb",
                                        "glosses": [
                                            "The planned movement of troops, vehicles etc.; a strategic repositioning; (later also) a large training field-exercise of fighting units."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45dfc5c-a9b8-43c9-8207-826d87d92548",
                                                "sense_id": "9c383afd-d597-38a1-93c4-92d87bdd332e",
                                                "text": "The army was on maneuvers."
                                            },
                                            {
                                                "example_id": "112b4316-1d83-48dd-bf2d-b5929f0cf2b8",
                                                "sense_id": "9c383afd-d597-38a1-93c4-92d87bdd332e",
                                                "text": "Joint NATO maneuvers are as much an exercise in diplomacy as in tactics and logistics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aacaef4-193f-32e9-adfe-9af300e3656b",
                                        "entry_id": "df99b275-5fa9-3ffd-8277-14721e7749eb",
                                        "glosses": [
                                            "Any strategic or cunning action; a stratagem."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e16371d-3b7c-4919-b3bb-6133448c422e",
                                                "sense_id": "7aacaef4-193f-32e9-adfe-9af300e3656b",
                                                "text": "“This,” cried he, “is a manœuvre I have been some time expecting: but Mr. Harrel, though artful and selfish, is by no means deep.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "350e9a25-45e0-34fd-b4d2-991a610dfc44",
                                        "entry_id": "df99b275-5fa9-3ffd-8277-14721e7749eb",
                                        "glosses": [
                                            "A movement of the body, or with an implement, instrument etc., especially one performed with skill or dexterity."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a6586da-745d-3d5e-a237-1f52539c4bdf",
                                        "entry_id": "df99b275-5fa9-3ffd-8277-14721e7749eb",
                                        "glosses": [
                                            "A specific medical or surgical movement, often eponymous, done with the doctor's hands or surgical instruments."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04d4c9db-bf5a-43ca-8a75-7ac8e8bfb38d",
                                                "sense_id": "8a6586da-745d-3d5e-a237-1f52539c4bdf",
                                                "text": "The otorhinolaryngologist performed an Epley maneuver and the patient was relieved of his vertigo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d48ee9-0370-3017-a144-afad957fe3b3",
                                        "entry_id": "df99b275-5fa9-3ffd-8277-14721e7749eb",
                                        "glosses": [
                                            "A controlled (especially skillful) movement taken while steering a vehicle."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4205e92-c532-48a0-8b89-aef877439011",
                                                "sense_id": "b4d48ee9-0370-3017-a144-afad957fe3b3",
                                                "text": "Parallel parking can be a difficult maneuver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maneuver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22b9450c-a27a-35c4-93f9-1bcf5027faba",
                                        "entry_id": "d99f1f14-ccc6-369c-ba52-377e83ad3f2e",
                                        "glosses": [
                                            "To move (something, or oneself) carefully, and often with difficulty, into a certain position."
                                        ],
                                        "tags": [
                                            "US",
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbbf2102-d022-397c-a417-1560eaaf26a1",
                                        "entry_id": "d99f1f14-ccc6-369c-ba52-377e83ad3f2e",
                                        "glosses": [
                                            "To guide, steer, manage purposefully"
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9b906e0-5843-3488-b4ef-dec4f432ea2b",
                                        "entry_id": "d99f1f14-ccc6-369c-ba52-377e83ad3f2e",
                                        "glosses": [
                                            "To intrigue, manipulate, plot, scheme"
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7344bc83-f922-4955-b43d-3aaff7df1033",
                                                "sense_id": "c9b906e0-5843-3488-b4ef-dec4f432ea2b",
                                                "text": "The patriarch maneuvered till his offspring occupied countless key posts"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2686e268-6e5f-4018-93d0-d8640061a36a",
                        "source_entry_id": "11b9cf58-54c9-37b4-9419-7eb014e37064",
                        "source_sense_id": "45f18c3d-2572-33c6-ae3f-eb7fad6443d5",
                        "source_sense_description": "militärische Übung",
                        "target_lang_word": "military exercise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "military exercise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45b04656-3f35-306d-9711-abb017456dc8",
                                        "entry_id": "fe5c3132-f00f-3684-9444-a52abe815b21",
                                        "glosses": [
                                            "A large-scale activity involving military forces from multiple countries or commands, designed to demonstrate the level of alliance between those forces and their ability to coordinate, as a signal to potential military adversaries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f505f8d-d86a-4420-a47a-6a93e1ad5662",
                                                "sense_id": "45b04656-3f35-306d-9711-abb017456dc8",
                                                "text": "Another major military exercise, codenamed Operation Intrinsic Action held in August 1992, involved the participation of 2400 US troops from the First Cavalry Division at Ford Hood, Texas and members of the Fifth Special Forces Group from Fort Campbell, Kentucky."
                                            },
                                            {
                                                "example_id": "791191db-9fef-4976-a220-ce0e359de2aa",
                                                "sense_id": "45b04656-3f35-306d-9711-abb017456dc8",
                                                "text": "In the first months of 1993 the situation worsened as the United States and South Korea resumed their annual Team Spirit military exercise (canceled in 1992) and North Korea announced its intention to withdraw from the International Atomic Energy Agency's (IAEA) Nuclear Nonproliferation Treaty."
                                            },
                                            {
                                                "example_id": "1f802269-6150-4a3e-aea1-acb4ea9abdac",
                                                "sense_id": "45b04656-3f35-306d-9711-abb017456dc8",
                                                "text": "In early November the United States and its NATO allies carried out an unusually extensive and high-level military exercise, called Able Archer 83, testing the command and communications procedures for the release and use of nuclear weapons in case of war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
