                "senses": [
                    {
                        "sense_id": "5c1f1452-6abc-3184-a6f0-fa2db1845853",
                        "entry_id": "533e1061-ed54-3ee9-a121-99620badf1b6",
                        "glosses": [
                            "durchschnittliche Temperatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "529dacda-cef5-4f5e-8a3d-9cb2e7974d6a",
                                "sense_id": "5c1f1452-6abc-3184-a6f0-fa2db1845853",
                                "text": "„Die Durchschnittstemperatur auf der Erde beträgt angenehme 14° C.“"
                            },
                            {
                                "example_id": "e0868be5-bb3c-4e07-914d-a177d51090cd",
                                "sense_id": "5c1f1452-6abc-3184-a6f0-fa2db1845853",
                                "text": "„Die Durchschnittstemperatur der Erdoberfläche ist seit dem Beginn der Industrialisierung um ein Grad gestiegen.“"
                            },
                            {
                                "example_id": "b980e677-3446-4b87-9733-f97974e62a22",
                                "sense_id": "5c1f1452-6abc-3184-a6f0-fa2db1845853",
                                "text": "[Juli 2021:] „Wie die US-Wetterbehörde NOAA am Freitag mitteilte, lag die Durchschnittstemperatur auf Land- und Ozeanflächen um 0,93 Grad über dem Durchschnittswert des 20. Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
