                                        "entry_id": "c4aa8486-f30e-3e1d-9092-3a6b28aeaa0a",
                                        "glosses": [
                                            "A complex black or dark-coloured borosilicate mineral, compounded with various chemical elements and considered a semi-precious stone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
