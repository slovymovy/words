        "pl-extract.jsonl": [
            {
                "entry_id": "f38952c6-70f7-3611-8602-b315e56619cc",
                "word": "normcore",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2396d83e-926e-312b-a8a1-9af0b11fce49",
                        "entry_id": "f38952c6-70f7-3611-8602-b315e56619cc",
                        "glosses": [
                            "trend w modzie polegający na ubieraniu się w sposób zwyczajny/normalny i bezpretensjonalny, określany często jako trend na bycie poza trendem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38a1836c-e4db-4be1-9c94-b0f77ef4d920",
                                "sense_id": "2396d83e-926e-312b-a8a1-9af0b11fce49",
                                "text": "Niektórzy normcore nazywają nawet antystylem i manifestem autentyczności"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26889828-3919-4248-9838-2348bf8ba97f",
                        "source_entry_id": "f38952c6-70f7-3611-8602-b315e56619cc",
                        "source_sense_id": "2396d83e-926e-312b-a8a1-9af0b11fce49",
                        "target_lang_word": "normcore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normcore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0ca221-06a6-3d4f-a4bc-d7d0125fe5b4",
                                        "entry_id": "0ad148b1-f8c1-3bbe-9844-428291c7297a",
                                        "glosses": [
                                            "A unisex fashion trend characterized by average-looking, unpretentious clothing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2d4e037-9f18-463a-8bc3-12d8118f87f3",
                                                "sense_id": "bf0ca221-06a6-3d4f-a4bc-d7d0125fe5b4",
                                                "text": "That means he's normcore. Dangerously regular. Dresses only in T-shirts an' jeans, uses slang appropriated from other sub cultures, but only 3 years after it's^([sic – meaning its]) first use, an' only after it's been used in a sitcom."
                                            },
                                            {
                                                "example_id": "c07ab981-1c76-40e6-9481-cfe855b4f226",
                                                "sense_id": "bf0ca221-06a6-3d4f-a4bc-d7d0125fe5b4",
                                                "text": "Clémence would say that his style was normcore before normcore became a thing. She had to admit that she still found him attractive."
                                            },
                                            {
                                                "example_id": "812ba8d3-90a2-4352-80f1-66db677238e0",
                                                "sense_id": "bf0ca221-06a6-3d4f-a4bc-d7d0125fe5b4",
                                                "text": "Normcore is gray sweatpants pretending to be trousers. Normcore is a seen-better-days faun-colored golf knit. Normcore is an unlogo'd sneaker. Normcore is the opposite of wearing a pair of white patent-leather bejeweled Versace assless chaps. Normcore is oblivious to Givenchy shaved-beaver man purses. Normcore knows nothing of fluorescent-studded Louboutin sneakers."
                                            },
                                            {
                                                "example_id": "4f331c74-1ddc-4b05-8c41-89babaab52e0",
                                                "sense_id": "bf0ca221-06a6-3d4f-a4bc-d7d0125fe5b4",
                                                "text": "Another part of her gift is that she's damn funny. Even if she'd come from the heart of normcore, her tale would be worth telling and well told. But she was raised in Crazytown, and the more foreign her territory, the more delightful—and somehow more relatable—her tale becomes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e5391e-d354-36b5-a744-3596f2a6cdd0",
                                        "entry_id": "0ad148b1-f8c1-3bbe-9844-428291c7297a",
                                        "glosses": [
                                            "Any style that is mainstream or unremarkable."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e86676-4003-49f8-9289-ea9125401821",
                                                "sense_id": "a3e5391e-d354-36b5-a744-3596f2a6cdd0",
                                                "text": "\"That's normcore painting, and that's what people are buying and trading now,\" [Deborah] Kass said, along with some slightly more colorful critique she opted to keep off the record."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
