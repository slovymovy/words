                    "frequency": "High",
                    "semantic_group_id": "antiquite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les légions marchaient sur la voie <w>romaine</w> pour défendre la frontière de la province."
                        },
                        {
                            "text": "Les élèves apprennent à lire les chiffres <w>romains</w> pendant le cours d'histoire ancienne."
                        }
                    ],
                    "common_phrases": [
