{
    "word_family": [
        "soulful",
        "soulless",
        "soulmate",
        "soulsick",
        "ensoul",
        "besoul"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e398c16-fc71-3ae0-9438-55bca4a5af46",
                    "sense_definition": "The spiritual part of a person, believed to contain their thoughts and personality and to exist after death.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people believe that the <w>soul</w> continues to exist in another world after the body dies.",
                            "target_lang_translations": {
                                "ru": "Многие люди верят, что <w>душа</w> продолжает существовать в ином мире после смерти тела."
                            }
                        },
                        {
                            "text": "She felt a deep sense of peace in her immortal <w>soul</w> after the long meditation session.",
                            "target_lang_translations": {
                                "ru": "После долгой медитации она почувствовала глубокое умиротворение в своей бессмертной <w>душе</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "immortal soul",
                        "body and soul",
                        "rest your soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Духовная часть человека, которая, как считается, содержит его мысли и личность и продолжает существовать после смерти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "бессмертное начало в человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb5ee420-9374-307c-bdc5-209b1b24a415",
                    "sense_definition": "A person, especially when considered as an individual among a group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was not a <w>soul</w> in the park early this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня рано утром в парке не было ни <w>души</w>."
                            }
                        },
                        {
                            "text": "The captain was responsible for the safety of every living <w>soul</w> on the ship.",
                            "target_lang_translations": {
                                "ru": "Капитан отвечал за безопасность каждой живой <w>души</w> на корабле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not a soul",
                        "living soul",
                        "poor soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, особенно когда он рассматривается как отдельная личность в группе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "человек (обычно в отрицании или при подсчете)"
                            },
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "личность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec694770-e2d0-32ec-bb14-2b8a3b38abaa",
                    "sense_definition": "The essential quality or spirit of something that gives it character or life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heart and <w>soul</w> of the city can be found in its vibrant street markets.",
                            "target_lang_translations": {
                                "ru": "Сердце и <w>душу</w> города можно найти на его оживленных уличных рынках."
                            }
                        },
                        {
                            "text": "Critics argued that the new modern building lacked the <w>soul</w> of the original historic structure.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что новому современному зданию не хватает <w>души</w> оригинального исторического строения."
                            }
                        }
                    ],
                    "synonyms": [
                        "crux",
                        "gist"
                    ],
                    "common_phrases": [
                        "heart and soul",
                        "soul of discretion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сущностное качество или дух чего-либо, придающий этому характер или жизнь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "суть или сердцевина чего-либо"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "атмосфера или характер"
                            },
                            {
                                "target_lang_word": "суть",
                                "target_lang_sense_clarification": "основное содержание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "490cdc19-42db-3e7d-95cd-df5a98a9b639",
                    "sense_definition": "A genre of popular music that originated in the African American community, characterized by emotional intensity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves listening to classic <w>soul</w> music from the nineteen sixties while she works.",
                            "target_lang_translations": {
                                "ru": "Она любит слушать классическую музыку <w>соул</w> шестидесятых годов во время работы."
                            }
                        },
                        {
                            "text": "The singer's powerful voice is perfect for performing traditional <w>soul</w> ballads.",
                            "target_lang_translations": {
                                "ru": "Мощный голос певца идеально подходит для исполнения традиционных баллад в стиле <w>соул</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soul music",
                        "soul singer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр популярной музыки, зародившийся в афроамериканской среде и отличающийся эмоциональной интенсивностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соул",
                                "target_lang_sense_clarification": "музыкальный жанр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f0b268e-4e8f-3714-87ba-b3ea3b835158",
                    "sense_definition": "Energy, vigor, or a strong feeling of life and enthusiasm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young dancer performed with such <w>soul</w> that the entire audience was moved to tears.",
                            "target_lang_translations": {
                                "ru": "Молодой танцор выступал с такой <w>душой</w>, что вся аудитория была растрогана до слез."
                            }
                        },
                        {
                            "text": "He put his whole <w>soul</w> into the project to ensure it would be a success.",
                            "target_lang_translations": {
                                "ru": "Он вложил всю <w>душу</w> в этот проект, чтобы гарантировать его успех."
                            }
                        }
                    ],
                    "common_phrases": [
                        "put your soul into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергия, бодрость или сильное чувство жизни и энтузиазма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "искренность и чувство в действии"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "энергия и воодушевление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0f8af4e-6998-3520-997e-6659c39dc0dd",
                    "sense_definition": "A specific type of submanifold used in the study of Riemannian geometry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician presented a new proof regarding the properties of the <w>soul</w> in non-negatively curved manifolds.",
                            "target_lang_translations": {
                                "ru": "Математик представил новое доказательство свойств <w>души</w> в многообразиях неотрицательной кривизны."
                            }
                        },
                        {
                            "text": "In geometry, the <w>soul</w> theorem provides deep insights into the structure of complete manifolds.",
                            "target_lang_translations": {
                                "ru": "В геометрии теорема о <w>душе</w> дает глубокое понимание структуры полных многообразий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soul theorem"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический тип подмногообразия, используемый в изучении римановой геометрии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "математический термин в геометрии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6176c79-149e-3724-8d68-489d5eca5f11",
                    "sense_definition": "To provide or endow something with a soul or a mind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "endow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that only a divine creator could truly <w>soul</w> a living being.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что только божественный творец может по-настоящему <w>одушевить</w> живое существо."
                            }
                        },
                        {
                            "text": "In the myth, the goddess used her breath to <w>soul</w> the clay statue and bring it to life.",
                            "target_lang_translations": {
                                "ru": "В мифе богиня своим дыханием <w>одушевила</w> глиняную статую и оживила ее."
                            }
                        }
                    ],
                    "synonyms": [
                        "besoul",
                        "ensoul"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or philosophical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наделять или одарять что-либо душой или разумом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одушевлять",
                                "target_lang_sense_clarification": "наделять душой"
                            },
                            {
                                "target_lang_word": "одухотворять",
                                "target_lang_sense_clarification": "наполнять духовным смыслом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb345bd4-7936-3745-8e6e-77505872e6f9",
                    "sense_definition": "To go from house to house begging for food or cakes on All Souls' Day.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old village, children would <w>soul</w> for cakes every November to remember the dead.",
                            "target_lang_translations": {
                                "ru": "В старой деревне дети каждый ноябрь <w>соулили</w> (совершали обряд поминовения), выпрашивая пироги в память об усопших."
                            }
                        },
                        {
                            "text": "The tradition of <w>souling</w> has mostly been replaced by modern holiday customs in this region.",
                            "target_lang_translations": {
                                "ru": "Традиция <w>соулинга</w> в этом регионе в основном была заменена современными праздничными обычаями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go souling"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British folklore"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical custom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить по домам и просить еду или пироги в День поминовения усопших."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соулинг",
                                "target_lang_sense_clarification": "обряд выпрашивания «пирогов души»"
                            },
                            {
                                "target_lang_word": "поминать",
                                "target_lang_sense_clarification": "совершать обряд в память об усопших"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2baf539a-e7f0-36c6-9afa-14b7d08703a9",
                    "sense_definition": "To provide nourishment or to feed someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler asked if he might <w>soul</w> a plate with the family during his long journey.",
                            "target_lang_translations": {
                                "ru": "Путешественник спросил, может ли он <w>разделить</w> <w>трапезу</w> (подкрепиться) с семьей во время своего долгого пути."
                            }
                        },
                        {
                            "text": "It was an old expression used to describe the act to <w>soul</w> and sustain the body with food.",
                            "target_lang_translations": {
                                "ru": "Это было старое выражение, описывающее действие, призванное <w>напитать</w> и поддержать тело пищей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soul a plate"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать питанием или кормить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "питать",
                                "target_lang_sense_clarification": "давать пищу (устар.)"
                            },
                            {
                                "target_lang_word": "кормить",
                                "target_lang_sense_clarification": "насыщать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}