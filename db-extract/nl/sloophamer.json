                            {
                                "example_id": "2e9ca6b0-f64c-4071-aba6-9a155e40cefd",
                                "sense_id": "51a27f2b-ae7f-3ba1-af2d-96cae87736b7",
                                "text": "Met een sloophamer wordt alles tegen de vlakte geslagen, bulldozers schrapen de aardkorst kaal en vreten zich een weg de diepte in totdat ze stuiten op miljoenen jaar oude, dikke lagen bruinkool."
                            }
                        ]
                    },
                    {
