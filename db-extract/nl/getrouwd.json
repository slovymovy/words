                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "married",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84202b40-9007-36e4-a702-e2f2c2bc27e2",
                                        "entry_id": "000f8609-a2d2-31b3-9efe-9c09a2436a16",
                                        "glosses": [
                                            "A married person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1238c84-374f-4e2a-b9bb-09ef2020fb9b",
                                                "sense_id": "84202b40-9007-36e4-a702-e2f2c2bc27e2",
                                                "text": "A perfect example is life insurance. Most people starting out don't need it; you should only insure what you can't afford to lose or replace, and singles or young marrieds without a lot of assets frequently don't require coverage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bfdba81-6b8b-40be-8eea-a3244b3431e7",
                        "source_entry_id": "69111c80-1520-37fa-bdb6-23889e2d86ad",
                        "source_sense_id": "dd290f45-a7df-3ab9-8469-2475685b5c02",
                        "source_sense_description": "voltooid deelwoord van trouwen",
                        "target_lang_word": "marié",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e18e4069-82d3-3785-be5c-f4c31e2e6023",
                                        "entry_id": "33080822-8e91-35fb-83c5-c3ac6a696322",
                                        "glosses": [
                                            "Qui s’est marié ; qui a un époux ou une épouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89136483-ab7b-4e58-ad7b-0c6913a997a2",
                                                "sense_id": "e18e4069-82d3-3785-be5c-f4c31e2e6023",
                                                "text": "Je ne suis pas mariée. Oui je suis demoiselle, et pourtant cet enfant, cet enfant, c’est à moi."
                                            },
                                            {
                                                "example_id": "91cc6a9c-8af3-4581-897a-be43b51df511",
                                                "sense_id": "e18e4069-82d3-3785-be5c-f4c31e2e6023",
                                                "text": "Désormais, pour continuer de se voir, il faut aux amants user de subterfuges. Après tout, il est prêtre, elle est mariée, tous deux savent ou devraient savoir que cela finira mal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bda9f12-6d6e-30b7-a4de-c2920873ce37",
                                        "entry_id": "23a27b06-60a2-3c0c-a592-49e48031eb1a",
                                        "glosses": [
                                            "Homme qui est unie à une autre personne selon les liens du mariage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46cf870b-bcb9-46d9-a960-811f78af8755",
                                                "sense_id": "8bda9f12-6d6e-30b7-a4de-c2920873ce37",
                                                "text": "Le jeune marié."
                                            },
                                            {
                                                "example_id": "ab4703a2-c9df-42a7-82e8-aa9dded2a6e6",
                                                "sense_id": "8bda9f12-6d6e-30b7-a4de-c2920873ce37",
                                                "text": "Voilà le marié."
                                            },
                                            {
                                                "example_id": "f73e6e5a-3ba0-411c-9de0-539b7e898e87",
                                                "sense_id": "8bda9f12-6d6e-30b7-a4de-c2920873ce37",
                                                "text": "Le père de la mariée, la mariée, sa sœur, le marié, un ami de ce dernier, la dame et le monsieur son mari, le jeune homme ont tous quelques vérités enfouies à révéler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18c5d705-4743-3be3-98d8-7ad266d83730",
                                        "entry_id": "23a27b06-60a2-3c0c-a592-49e48031eb1a",
                                        "glosses": [
                                            "Personne, homme ou femme, qui se marie ou qui s’est mariée le jour même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be5bbd4-05c2-454d-93d8-d4053c86332f",
                                                "sense_id": "18c5d705-4743-3be3-98d8-7ad266d83730",
                                                "text": "Nous sommes déjà de vieux mariés."
                                            },
                                            {
                                                "example_id": "8b2539e4-f664-4094-894c-528c95ce241b",
                                                "sense_id": "18c5d705-4743-3be3-98d8-7ad266d83730",
                                                "text": "Accueillons les jeunes mariés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "373383d7-00f9-3131-a4a4-2bd7b300ed97",
                                        "entry_id": "6a40527f-a2de-3973-bfc1-5f9bf3f9aad2",
                                        "glosses": [
                                            "Participe passé masculin singulier de marier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47493fe9-eefc-4f9b-8c1c-0b292b97ff47",
                                                "sense_id": "373383d7-00f9-3131-a4a4-2bd7b300ed97",
                                                "text": "Le légendaire astronaute américain Buzz Aldrin, dernier survivant de la mission « Apollo II » et deuxième être humain à avoir posé le pied sur la Lune en 1969, s’est marié."
                                            }
                                        ]
