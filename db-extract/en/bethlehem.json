            {
                "entry_id": "cab1d3ef-1efc-3f33-80be-542489f0f1db",
                "word": "Bethlehem",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "16c81450-b181-4b31-83f5-d13dfef5aa84",
                        "entry_id": "cab1d3ef-1efc-3f33-80be-542489f0f1db",
                        "tags": [
                            "plural"
                        ],
                        "form": "Bethlehems"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eac63c12-e455-39e9-a041-a5da510afadc",
                        "entry_id": "cab1d3ef-1efc-3f33-80be-542489f0f1db",
                        "glosses": [
                            "A lunatic asylum."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "915ea79a-a04e-3f27-acaf-fb4f4b1e79d5",
                        "entry_id": "cab1d3ef-1efc-3f33-80be-542489f0f1db",
                        "glosses": [
                            "In the Ethiopic church, a small building attached to a church edifice, in which the bread for the Eucharist is made."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe02087-d1a2-47e8-9050-2603cc9bc3ce",
                                "sense_id": "915ea79a-a04e-3f27-acaf-fb4f4b1e79d5",
                                "text": "[…] to the Hebrew and Arabic word “korban” as now used in the Abyssinian Church to denote the sacramental bread specially prepared in the “Bethlehem,” or “House of Bread.”"
                            },
                            {
                                "example_id": "29ed3d4c-b7cc-4e43-b55e-9f246f085408",
                                "sense_id": "915ea79a-a04e-3f27-acaf-fb4f4b1e79d5",
                                "text": "A small building, attached to Ethiopic churches, usually at the eastern end of the sacrarium, in which the deacon prepares and bakes the bread for use in the eucharist. This building is called the Bethlehem, or “house of bread.”"
                            },
                            {
                                "example_id": "37ff1ab1-dee4-432e-af12-43e7702a8122",
                                "sense_id": "915ea79a-a04e-3f27-acaf-fb4f4b1e79d5",
                                "text": "The deacon rings a bell when bread is brought from the bethlehem to the maqdas and at other liturgical times"
                            },
                            {
                                "example_id": "e2b25897-040d-4102-be3e-9f70b0971a94",
                                "sense_id": "915ea79a-a04e-3f27-acaf-fb4f4b1e79d5",
                                "text": "The priests and deacons assigned to the service wash their feet and hands, usually near the 'Bethlehem'."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
