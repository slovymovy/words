                "senses": [
                    {
                        "sense_id": "46459552-3404-37d0-9887-d1bd182bd4fa",
                        "entry_id": "1c7ce232-fbb1-343e-b1a1-96931b8f06d3",
                        "glosses": [
                            "niet passend in de tijdsvolgorde of in de periode waarin het wordt gepresenteerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c319776-3f34-4c56-850c-c5a010c8bb99",
                                "sense_id": "46459552-3404-37d0-9887-d1bd182bd4fa",
                                "text": "Het verhaal over de ontmoeting van Aristoteles en Archimedes is anachronistisch, want de eerste overleed meer dan 40 jaar voor de geboorte van de laatste."
                            },
                            {
                                "example_id": "40168495-9c4f-4bfd-b9b0-5a1b98b7ef3c",
                                "sense_id": "46459552-3404-37d0-9887-d1bd182bd4fa",
                                "text": "Het is anachronistisch om een middeleeuwse boer aardappels te laten eten, want die leerde Europa pas kennen na de ontdekking van Amerika."
                            },
                            {
                                "example_id": "ff93b833-51f5-4611-abcc-9b2220b9081d",
                                "sense_id": "46459552-3404-37d0-9887-d1bd182bd4fa",
                                "text": "Op de middelste pijler achter Maria is anachronistisch een kleine crucifix geschilderd. Het leven van het pasgeboren kind wordt hier samengevat van kribbe tot kruis."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0a8433c-a936-38a5-ac93-e2492ba025f5",
                        "entry_id": "1c7ce232-fbb1-343e-b1a1-96931b8f06d3",
                        "glosses": [
                            "niet passend in de huidige tijd, behorend tot het verleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b337b851-9083-4881-b20d-eeac8c262f39",
                                "sense_id": "c0a8433c-a936-38a5-ac93-e2492ba025f5",
                                "text": "Veel mensen vinden een erfelijk koningschap iets anachronistisch dat niet meer in de moderne tijd past, omdat de meeste landen tegenwoordig een president als staatshoofd hebben."
                            },
                            {
                                "example_id": "98020d85-6c6e-4674-80c8-a1c62d3013c8",
                                "sense_id": "c0a8433c-a936-38a5-ac93-e2492ba025f5",
                                "text": "Het is evident dat de televisie een steeds minder vanzelfsprekende avondbesteding is, in een land dat zich op lijkt te delen in bubbels met eigen gewoonten en overtuigingen – soms zelfs eigen waarheden. Eigen scherm eerst! Toch is de tv nog steeds meer dan een anachronistisch medium, een relikwie uit de twintigste eeuw."
                            },
                            {
                                "example_id": "2150ec05-455e-4d1b-a760-da8887501743",
                                "sense_id": "c0a8433c-a936-38a5-ac93-e2492ba025f5",
                                "text": "Hij was gevestigd in een mooie, oude houten villa in de wijk Kàbo in Uppsala, en alleen al te mogen vertoeven in zijn praktijk, donker en anachronistisch, was een troost voor de ziel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a4aa057-c2fa-4097-8d4d-c80ddb47d190",
                        "source_entry_id": "1c7ce232-fbb1-343e-b1a1-96931b8f06d3",
                        "source_sense_id": "46459552-3404-37d0-9887-d1bd182bd4fa",
                        "source_sense_description": "niet passend in de tijdsvolgorde of in de periode waarin het wordt gepresenteerd",
                        "target_lang_word": "anachronistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachronistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2afcc19-0636-3b86-a549-1175ddcfc4c5",
                                        "entry_id": "f80b3138-de7f-391e-90e9-02554589b39d",
                                        "glosses": [
                                            "überholt; nicht mehr zeitgemäß; nicht in einen bestimmten geschichtlichen Zeitraum, sondern in einen vorhergehenden passend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17619899-5cee-4a8b-a1c2-a9eb1f7589e5",
                                                "sense_id": "b2afcc19-0636-3b86-a549-1175ddcfc4c5",
                                                "text": "Manche Verwandtschaftsbezeichnungen wie Muhme oder Oheim wirken heutzutage anachronistisch."
                                            },
                                            {
                                                "example_id": "eb147992-56af-4523-b63b-f741323b4b76",
                                                "sense_id": "b2afcc19-0636-3b86-a549-1175ddcfc4c5",
                                                "text": "„Ist die Frage, ob der Herrscher nun Deutscher oder Franzose war, nicht völlig anachronistisch?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b45842a-34d3-3c32-8b7f-681a41ed5bf5",
                                        "entry_id": "f80b3138-de7f-391e-90e9-02554589b39d",
                                        "glosses": [
                                            "zeitlich falsch eingeordnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3dcf3f3-71db-431e-8ad5-0e711d69f404",
                                                "sense_id": "5b45842a-34d3-3c32-8b7f-681a41ed5bf5",
                                                "text": "Ein Auto in einem Historienfilm über die Römerzeit wäre anachronistisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62f0ea40-a908-48f0-9d55-b5cdcf658feb",
                        "source_entry_id": "1c7ce232-fbb1-343e-b1a1-96931b8f06d3",
                        "source_sense_id": "46459552-3404-37d0-9887-d1bd182bd4fa",
                        "source_sense_description": "niet passend in de tijdsvolgorde of in de periode waarin het wordt gepresenteerd",
                        "target_lang_word": "anachronistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachronistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                        "entry_id": "d31cb5ff-a39c-35d7-9a0d-4b0ca6051043",
                                        "glosses": [
                                            "Erroneous in date; containing an anachronism; in a wrong time; not applicable to or not appropriate for the time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f104793-ee25-43d6-9244-0a06505a1e1b",
                                                "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                                "text": "If you know where to look in the movie, you can spot an anachronistic wrist watch on one of the Roman soldiers."
                                            },
                                            {
                                                "example_id": "c748e336-f852-4185-9e4e-52784b9569ee",
                                                "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                                "text": "The impiety of the Ciceronian attitude was probably his major objection to the sect, yet the dialogue is mainly concerned with the more anachronistic and illogical aspects of attempting to write only as Cicero did."
                                            },
                                            {
                                                "example_id": "83305553-801b-47e3-a7d3-c538cd2b3445",
                                                "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                                "text": "What could be more anachronistic than imposing contemporary concern over fragmentation, i.e. diversity, of the present on the past so that no sources of patriarchal power or hierarchy can be held responsible for collective oppression in any time period?"
                                            },
                                            {
                                                "example_id": "a3cbdd10-6388-4501-9016-5b653ba32047",
                                                "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                                "text": "Among them, even the most lucid of 'one-nation' Tories had severe difficulties in seeing the anti-growth nature of some of the most anachronistic of traditional British institutions."
                                            },
                                            {
                                                "example_id": "691f42c3-07b1-44dc-b3cf-21b96c5646b4",
                                                "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                                "text": "The 'liberalism' issue that perplexed Catholics in the 1880s was by 1914 increasingly anachronistic, as political liberalism won resoundingly (in France), or lost resoundingly (in Austria), or became fragmented and divided (in Germany)."
                                            },
                                            {
                                                "example_id": "6f69aee1-63fa-409d-bcae-0bc1dc1b4280",
                                                "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                                "text": "In their daily practices, journalists often perpetuated ageing and increasingly anachronistic ideologies, but they were rarely, in fact, dominated by them."
                                            },
                                            {
                                                "example_id": "4f63e792-c8f4-45d3-aef1-4df0c22ef54d",
                                                "sense_id": "c7a9e72e-fb51-3a13-b00b-4d18571f1197",
                                                "text": "The coronation of a British ruler is, of course, a political ritual and a religious ceremony. But it is also, as the crowning of Queen Elizabeth II in 1953 established, a TV show. It’s an anachronistic assertion of divine right retooled to recognize that, in the electronic era, even hereditary rulers have to argue their relevance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f6ff22-0436-369d-ab23-beb6e2b8baf9",
                                        "entry_id": "d31cb5ff-a39c-35d7-9a0d-4b0ca6051043",
                                        "glosses": [
                                            "Having opinions from the past; preferring things or values of the past; behind the times; overly conservative."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef12a916-af5c-4139-90f9-c8d47879426e",
                        "source_entry_id": "1c7ce232-fbb1-343e-b1a1-96931b8f06d3",
