                "senses": [
                    {
                        "sense_id": "243c9fed-0697-3a91-b13f-dc08288dd07c",
                        "entry_id": "74a9ad5c-a06d-30c3-b05f-077a7ca4118f",
                        "glosses": [
                            "To systematize; to create a well-defined process for."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee41f6c-1c7b-43c8-80e7-236208f5de2a",
                                "sense_id": "243c9fed-0697-3a91-b13f-dc08288dd07c",
                                "text": "Consecrated effort to machinize humanity, to do its directing and thinking, is as old as time itself."
                            },
                            {
                                "example_id": "ce075ccb-5976-4ed4-8b09-b92b85afc086",
                                "sense_id": "243c9fed-0697-3a91-b13f-dc08288dd07c",
                                "text": "With the utmost respect for the findings of the committee, the Journal wonders if it is best to machinize all philanthropic impulse."
                            }
                        ]
                    },
                    {
                        "sense_id": "bad44b1e-8c92-3d3f-8f41-1ffd30a66f4b",
                        "entry_id": "74a9ad5c-a06d-30c3-b05f-077a7ca4118f",
                        "glosses": [
                            "To mechanize; to change so that (something) is done by machines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50cf0655-a512-438e-ae56-e53bb681ad53",
                                "sense_id": "bad44b1e-8c92-3d3f-8f41-1ffd30a66f4b",
                                "text": "Thus, some premises have been made to \"machinize\" the process of investigation, i.e., to computerize it, thus increasing the efficiency of investigation."
                            },
                            {
                                "example_id": "2de2b7b3-009c-405b-841e-7d1d7b5735ca",
                                "sense_id": "bad44b1e-8c92-3d3f-8f41-1ffd30a66f4b",
                                "text": "The Utility Stores Corporation with a provision of Rs 83.74 million plans to expand and machinize its net work of utility stores and warehouses through out the country."
                            }
                        ]
                    }
