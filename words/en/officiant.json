    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d8a9a9b-e565-3b65-b957-e1714ea3ed2a",
                    "sense_definition": "A person who leads or performs a religious ceremony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceremony_leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>officiant</w> led the congregation in prayer during the special service.",
                            "target_lang_translations": {
                                "pl": "<w>Celebrans</w> poprowadził zgromadzenie w modlitwie podczas specjalnego nabożeństwa."
                            }
                        },
                        {
                            "text": "The local priest served as the <w>officiant</w> for the baptismal ceremony.",
                            "target_lang_translations": {
                                "pl": "Miejscowy ksiądz pełnił funkcję <w>celebransa</w> podczas ceremonii chrztu."
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrant",
                        "minister",
                        "priest"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba prowadząca lub sprawująca ceremonię religijną."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "celebrans",
                                "target_lang_sense_clarification": "osoba przewodnicząca obrzędom religijnym"
                            },
                            {
                                "target_lang_word": "duchowny",
                                "target_lang_sense_clarification": "osoba duchowna prowadząca nabożeństwo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "013fc4ba-71cd-3d40-b6b3-d3a5eb24e460",
                    "sense_definition": "A person authorized to perform a civil wedding ceremony.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ceremony_leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hired a professional <w>officiant</w> to perform our wedding at the beach.",
                            "target_lang_translations": {
                                "pl": "Wynajęliśmy profesjonalnego <w>mistrza ceremonii</w>, aby udzielił nam ślubu na plaży."
                            }
                        },
                        {
                            "text": "The <w>officiant</w> asked the couple to exchange their rings and vows.",
                            "target_lang_translations": {
                                "pl": "<w>Urzędnik</w> poprosił parę o wymianę obrączek i złożenie przysięgi."
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrant"
                    ],
                    "common_phrases": [
                        "wedding officiant"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba upoważniona do udzielenia ślubu cywilnego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "urzędnik stanu cywilnego",
                                "target_lang_sense_clarification": "osoba prawnie uprawniona do zawarcia małżeństwa"
                            },
                            {
                                "target_lang_word": "mistrz ceremonii",
                                "target_lang_sense_clarification": "osoba prowadząca uroczystość ślubną"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}