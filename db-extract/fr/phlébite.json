                                        "sense_id": "a4c04b07-2d39-3c2c-adc8-81943074ecaa",
                                        "entry_id": "cf29f732-c632-324b-8fc7-74dfda47daa9",
                                        "glosses": [
                                            "Entzündung der Gefäßwand einer Vene, meist von Bakterien verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f263e49-d291-432a-b3f6-af5eee68af68",
                                                "sense_id": "a4c04b07-2d39-3c2c-adc8-81943074ecaa",
                                                "text": "„Fünf Tage lang liege ich hoch fiebernd mit der Venenentzündung im Bett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
