                                                "sense_id": "e8b77d12-7008-38a3-9af4-53979498d8f5",
                                                "text": "Stick a wedge under the door, will you? It keeps blowing shut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca7e88f1-497c-3123-acda-263c137df352",
