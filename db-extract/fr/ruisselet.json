        "fr-extract.jsonl": [
            {
                "entry_id": "4bda0501-a18e-31f0-ab9f-ce6e3a41df35",
                "word": "ruisselet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9834a2a2-f8a1-46d5-a9d4-e945129dd687",
                        "entry_id": "4bda0501-a18e-31f0-ab9f-ce6e3a41df35",
                        "tags": [
                            "plural"
                        ],
                        "form": "ruisselets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                        "entry_id": "4bda0501-a18e-31f0-ab9f-ce6e3a41df35",
                        "glosses": [
                            "Petit ruisseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d042a76-d3c5-4f08-a29a-2456ecb6affc",
                                "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                                "text": "La Ferté-Loupière, agreste village resserré entre deux collines couronnées de bois, assis en pente sur l'une d'elles, ayant à ses pieds une étroite prairie arrosée par le Vrin , ce ruisselet qui prend sa source au Buisson-Saint-Vrin , près de Merry-la-Vallée, pour aller bientôt se perdre dans l'Yonne à Césy, […]."
                            },
                            {
                                "example_id": "6faadeb3-db94-4208-a5b9-ac90582d8381",
                                "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                                "text": "Par intervalles, un hibou ricanait et, continus, en sourdine, susurraient le glouglou des ruisselets, la chanterelle des pisselottes, le chuchotis des goutelles."
                            },
                            {
                                "example_id": "a4aeab16-25a1-4b01-b193-f9f79a1380ec",
                                "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                                "text": "Trois couloirs de perspective s’ouvraient en éventail, chacun avec son groupe, ses jets et ses goulottes, ses descentes d’eau en ruisselets et cascades."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "690108d1-9f02-4ca2-9b39-e4533379c899",
                        "source_entry_id": "4bda0501-a18e-31f0-ab9f-ce6e3a41df35",
                        "source_sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                        "target_lang_word": "rivulet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rivulet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                        "entry_id": "bec49355-1b89-3f30-946e-acfb91c8ac72",
                                        "glosses": [
                                            "A small stream; a streamlet; a gill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "069adbd0-9239-4c76-b732-cf2df1c80836",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "A rivulet of tears ran down his face."
                                            },
                                            {
                                                "example_id": "f0c1662e-d1b7-44d2-966a-04afc9c465c3",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "Yes Madam I think you will like them—when you shall see in a beautiful Quarto Page how a neat rivulet of Text shall meander thro' a meadow of margin—'fore Gad, they will be the most elegant Things of their kind—"
                                            },
                                            {
                                                "example_id": "2fdde431-0dcd-4239-b448-779b58c56f60",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "The struggle with ways and means had recommenced, more difficult now a hundredfold than it had been before, because of their increasing needs. Their income disappeared as a little rivulet that is swallowed by the thirsty ground."
                                            },
                                            {
                                                "example_id": "1b782cbc-9ede-403d-9d6f-1dd35f50f8d1",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "Rills running down the steepest slopes develop into rivulets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f07d441d-f844-3c4b-8994-6387f569e59b",
                                        "entry_id": "bec49355-1b89-3f30-946e-acfb91c8ac72",
                                        "glosses": [
                                            "Perizoma affinitatum, a geometrid moth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "087cd843-cad0-4092-821b-7f4c6583742f",
                        "source_entry_id": "4bda0501-a18e-31f0-ab9f-ce6e3a41df35",
                        "source_sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                        "target_lang_word": "streamlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "streamlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                        "entry_id": "8d3b0113-20ef-3087-a315-02ea829466cc",
                                        "glosses": [
                                            "A small stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e22d4035-76b2-4a01-9514-ead16e1f3446",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "Then the river Medway, branching it selfe into five streamlets, is joyned with as many stone Bridges […]"
                                            },
                                            {
                                                "example_id": "b6b7ba32-96d8-466c-8fc4-7f2b00e819e5",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "[A] ſtreamlet inviting repoſe / Soft-murmuring vvanders avvay, […]"
                                            },
                                            {
                                                "example_id": "bb80ed02-f049-4a1b-b687-68a23a9f40dd",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "[…] the eye, after poring over the unbounded expanse of the ocean, is releaved and delighted by a streamlet and a dell."
                                            },
                                            {
                                                "example_id": "a12fabb7-9f72-46da-8122-5661046f12a2",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "I wanted to jog in leisurely fashion through the green fields and chestnut avenues, over the rushing bubbling streamlets, to join Sylvie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c28fdc8-ac05-4827-b0bd-57cc6b3238e6",
                        "source_entry_id": "4bda0501-a18e-31f0-ab9f-ce6e3a41df35",
                        "source_sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                        "target_lang_word": "runnel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "runnel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46f64e89-df6a-3fc0-80a2-5eb08f7f3363",
                                        "entry_id": "667746b2-2122-3b2f-9be3-63948e44cd6e",
                                        "glosses": [
                                            "A small stream, a rivulet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6550bd6-bbfd-472b-bd15-72743a2d91ff",
                                                "sense_id": "46f64e89-df6a-3fc0-80a2-5eb08f7f3363",
                                                "text": "Spring, is ye comen in, / Dappled larke singe, / Snow melteth, / Runnel pelteth, / Smelleth wind of newe buddinge."
                                            },
                                            {
                                                "example_id": "96d21dfb-3b33-44c5-bcd0-d384c03765c5",
                                                "sense_id": "46f64e89-df6a-3fc0-80a2-5eb08f7f3363",
                                                "text": "Every little runnel in the bay was astir, and yet the land around him was as dry as flax, and no drop of rain had fallen."
                                            },
                                            {
                                                "example_id": "1d1a4ed3-4a9d-45fc-a7c2-7b1f4a4cb90c",
                                                "sense_id": "46f64e89-df6a-3fc0-80a2-5eb08f7f3363",
                                                "text": "[…] great chambers in the rock where all sorts of plants were growing, under windows which had been cut to let in the sun, and glazed to adjust his warmth, and where runnels of water ran between fruit trees and seedlings, pumpkin plants and herbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0dd32fd-9068-37ab-af7c-00d4e0e0af64",
                                        "entry_id": "667746b2-2122-3b2f-9be3-63948e44cd6e",
                                        "glosses": [
                                            "A small artificial channel for water to flow in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c402dc1-b696-4001-b773-cb9474da7298",
                                                "sense_id": "c0dd32fd-9068-37ab-af7c-00d4e0e0af64",
                                                "text": "Still lower down the slope, on a staircase by the Eastern Bastion, there is an elaborate piece of hydraulic science for checking the flow of water. A stone runnel is made to descend the stairs in a series of parabolic curves which would subject the water to friction, and thus reduce its velocity and the consequent danger of a flood on the pavement below."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "runnel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a517d7c9-bf6d-385e-94a2-a83b9da481d3",
                                        "entry_id": "766d8db8-f24e-3e9b-8056-75950a1af067",
                                        "glosses": [
                                            "To create channels for directing the flow of liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62bf05a2-3353-49e4-a1a7-38a6f55b5db4",
                                                "sense_id": "a517d7c9-bf6d-385e-94a2-a83b9da481d3",
                                                "text": "Not all saltmarshes are suited to habitat modification, but where they are, runnelling provides long-term and cost-effective control with minor non-target impacts."
                                            },
                                            {
                                                "example_id": "86202c51-fe57-4cc3-9005-480957353ca0",
                                                "sense_id": "a517d7c9-bf6d-385e-94a2-a83b9da481d3",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nThe people who settled here weren’t farmers. They hunted. Yet they built a large amphitheater of mud, a platform carefully runneled to carry liquid—possibly blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
