                    {
                        "sense_id": "9dc61825-6cd7-3cc7-9693-44a700b4658a",
                        "entry_id": "50775f6a-f486-3672-b645-244937617d25",
                        "glosses": [
                            "A Jody call."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19ea2f33-ade4-4162-a747-596d022ceeae",
                                "sense_id": "9dc61825-6cd7-3cc7-9693-44a700b4658a",
                                "text": "I watched the formation move away and listened to the PT leader begin to call out a \"jody,\" an Army song to help units run in step in formation"
                            },
                            {
                                "example_id": "fe47f00a-2115-4ec1-b15d-741d665e738c",
                                "sense_id": "9dc61825-6cd7-3cc7-9693-44a700b4658a",
                                "text": "I walked back to the dorm as my team ran by in formation singing a jody about their last day."
                            }
                        ]
                    }
                ],
