                                "target_senses": [
                                    {
                                        "sense_id": "c09c7888-b580-3fe6-b2c0-49e12c7a4bcd",
                                        "entry_id": "5f0e12b8-d4f3-3b1c-90fa-1c851056ffca",
                                        "glosses": [
                                            "eine Erwartung haben; damit rechnen oder darauf hoffen, dass etwas eintrifft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c070a5-ac94-40f6-a54c-938547d5a103",
                                                "sense_id": "c09c7888-b580-3fe6-b2c0-49e12c7a4bcd",
                                                "text": "Sie hatte diesen alten Kerl geheiratet, weil sie spekulierte, dass er bald sterben und sie dann alles erben würde."
                                            },
                                            {
                                                "example_id": "d4827866-f85d-4e70-98ed-b0ad260b1fb5",
                                                "sense_id": "c09c7888-b580-3fe6-b2c0-49e12c7a4bcd",
                                                "text": "Man investierte in Werbung und Marketing und spekulierte auf einen Hit wie Seven Seconds, dem bislang einzigen Welterfolg des Sängers [Youssou N'Dour]. Doch der […] Erfolg blieb aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cbeb8230-f81d-35d0-a16a-637cefbab209",
                                        "entry_id": "5f0e12b8-d4f3-3b1c-90fa-1c851056ffca",
                                        "glosses": [
                                            "durch (oft risikoreiches) Kaufen und Verkaufen von Aktien, Rohstoffen und so weiter versuchen, Profite zu erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829da818-63c4-462f-b978-637a7022c04e",
                                                "sense_id": "cbeb8230-f81d-35d0-a16a-637cefbab209",
                                                "text": "Er spekulierte auf ein Fallen des Ölpreises."
                                            },
                                            {
                                                "example_id": "bc40801f-351e-4410-a9c8-deeaf398a772",
                                                "sense_id": "cbeb8230-f81d-35d0-a16a-637cefbab209",
                                                "text": "Dort [an der Pariser Börse] schaffte er [Stephan Sarter] als Börsenmakler einen kometenhaften Aufstieg. Er spekulierte um immer höhere Summen – und setzte schließlich mit einer Beteiligung am Suez-Kanal, der Verbindung zwischen Mittelmeer und Rotem Meer, auf ein Mammutprojekt mit unsicherem Ausgang."
                                            },
                                            {
                                                "example_id": "a4a891e0-b33e-4891-81e2-a59df4296bca",
                                                "sense_id": "cbeb8230-f81d-35d0-a16a-637cefbab209",
                                                "text": "[Es] lässt sich nicht unterscheiden, ob ein Investmentfonds auf steigende Weizenkurse spekuliert oder ob ein großer Viehzüchter nur seine Futtertanks auffüllen will."
                                            },
                                            {
                                                "example_id": "5a2bded9-72cd-4f18-9427-4a3c91384e0f",
                                                "sense_id": "cbeb8230-f81d-35d0-a16a-637cefbab209",
                                                "text": "Mit einer Optionsstrategie kann der Investor auf eine fallende, sich seitswärts bewegende oder steigende Entwicklung des Basiswerts (Underlying) spekulieren, oder darauf, dass die Volatilität des Basiswerts fällt oder steigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                        "entry_id": "5f0e12b8-d4f3-3b1c-90fa-1c851056ffca",
                                        "glosses": [
                                            "etwas vermuten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40890605-044f-4ca9-8931-63a306a04c01",
                                                "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                                "text": "Sie spekulierte über die Gründe, warum er sich von ihr getrennt hatte."
                                            },
                                            {
                                                "example_id": "d88a61fd-630a-4828-b28f-972e1db35bd2",
                                                "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                                "text": "„Ob die Ministerin wirklich glaubt, was sie öffentlich sagt, darüber kann man nur spekulieren.“"
                                            },
                                            {
                                                "example_id": "dacc3b3a-f356-4f36-a864-4d92bcdc0e13",
                                                "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                                "text": "„Wir brauchen gar nicht darüber spekulieren, ob das Haus toll ist: wir können es uns sowieso nicht leisten.“"
                                            },
                                            {
                                                "example_id": "1decad0a-960c-45ef-9013-0b374b852185",
                                                "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                                "text": "Über den Ausgang des Prozesses wird viel spekuliert."
                                            },
                                            {
                                                "example_id": "40a142f1-1a9b-49f4-8079-a54364f206e0",
                                                "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                                "text": "„Es ist zwecklos, über ihr unmögliches Verhalten zu spekulieren. Wir müssen sie fragen, was passiert ist.“"
                                            },
                                            {
                                                "example_id": "70423810-8650-429d-be87-a7a356996ff2",
                                                "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                                "text": "Lange wurde über den Umbau des Bahnhofs Zoo spekuliert, nun läuft er. In die einstigen „Terrassen am Zoo“ zieht [eine Burger-Kette]."
                                            },
                                            {
                                                "example_id": "3104a732-6359-49fc-b84d-0d69a3c808b5",
                                                "sense_id": "fcbd551a-9bac-359f-9d0c-561c6f92e298",
                                                "text": "Monatelang hat die Finanzwelt spekuliert: Erhöht die US-Notenbank Federal Reserve die Zinsen oder tut sie es nicht? Sie tut es."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
