                ],
                "senses": [
                    {
                        "sense_id": "95c23375-b553-3970-af83-bf841620c6f1",
                        "entry_id": "00c4934a-3415-3205-8689-e2e2ed6ae9d0",
                        "glosses": [
                            "gevoelsmatig geraakt zijn en dat ook tonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0211bbc-b35c-49b0-8c67-d88f4d0326ba",
                                "sense_id": "95c23375-b553-3970-af83-bf841620c6f1",
                                "text": "„Weet u, ik leef omdat een engel besloot om in een brandend trappenhuis omhoog te rennen” zegt ze zichtbaar geëmotioneerd. Het beeld van twee kinderen die bovenaan een trap hulpeloos staren naar een vuurzee grijpt me aan."
                            },
                            {
                                "example_id": "0a284353-1c76-4d19-a173-f915ac8c6b46",
                                "sense_id": "95c23375-b553-3970-af83-bf841620c6f1",
                                "text": "De koningin zelf had eind maart minder oog voor de politieke kant. Als moeder van een verliefde dochter vond zij de gang van zaken maar niets. Voordat het gezelschap op 28 maart bij Beel in Wassenaar bijeenkwam, noodde ze Beker 'nerveus' in Huis ten Bosch, waar een 'vreselijk geëmotioneerd' gesprek volgde. 'Gaat de politiek nou oordelen over het hart van mijn kind?' vroeg ze huilend, terwijl ze 'telkens weer riep \"Ik hóú zo van dat kind!'\"17"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f546b9a6-2ad5-49c6-8b54-96b983059092",
                        "source_entry_id": "00c4934a-3415-3205-8689-e2e2ed6ae9d0",
                        "source_sense_id": "95c23375-b553-3970-af83-bf841620c6f1",
                        "source_sense_description": "gevoelsmatig geraakt zijn en dat ook tonen",
                        "target_lang_word": "emotional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emotional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da38d6f7-5123-3d4e-8e63-46d2bda1966f",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Of or relating to the emotions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce0c9788-e6b9-4763-b133-2d43cac065fa",
                                                "sense_id": "da38d6f7-5123-3d4e-8e63-46d2bda1966f",
                                                "text": "emotional crisis"
                                            },
                                            {
                                                "example_id": "fe1bac62-448e-4dbe-90b7-2ae8eb48e939",
                                                "sense_id": "da38d6f7-5123-3d4e-8e63-46d2bda1966f",
                                                "text": "emotional lift"
                                            },
                                            {
                                                "example_id": "0b2a0b45-bc5a-42dd-a8a5-cadbae072f5e",
                                                "sense_id": "da38d6f7-5123-3d4e-8e63-46d2bda1966f",
                                                "text": "One of the biggest shifts is that much of the conversation about emotional labor has left its original sphere of the workplace and moved to the home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52d7f3a-c8e6-3ea9-919e-c1b842da33be",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Characterized by emotion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9a3d74-cd46-36fd-86f9-f3692a4add42",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Determined by strong emotion rather than purely logical reasoning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af2ff4c-a4db-481f-b58e-22aca402a5dc",
                                                "sense_id": "cb9a3d74-cd46-36fd-86f9-f3692a4add42",
                                                "text": "emotional decision"
                                            },
                                            {
                                                "example_id": "6fd32086-367e-435d-baa8-ba45cf42def5",
                                                "sense_id": "cb9a3d74-cd46-36fd-86f9-f3692a4add42",
                                                "text": "The 'movement' was simultaneously emotional and motoric, and essentially autonomous (thus distinguishing it from passive jerkings and other pathology)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3dc7630-fc5e-350a-954b-046ec83f5200",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Appealing to or arousing emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1ab35c-d290-4a61-b2ca-16328854d08a",
                                                "sense_id": "c3dc7630-fc5e-350a-954b-046ec83f5200",
                                                "text": "emotional speech"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e33b01c1-e135-3ab6-896b-908771457aef",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Easily affected by emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f152af1e-87f1-4226-a90e-4184b9f153c7",
                                                "sense_id": "e33b01c1-e135-3ab6-896b-908771457aef",
                                                "text": "She’s an emotional person."
                                            }
                                        ]
                                    },
                                    {
