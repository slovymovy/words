        "fr-extract.jsonl": [
            {
                "entry_id": "2877216c-f186-37ad-a61b-a198817e5e3b",
                "word": "subpoena",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9cc8fa4f-807d-4e30-b4e2-cb0090fca28d",
                        "entry_id": "2877216c-f186-37ad-a61b-a198817e5e3b",
                        "tags": [
                            "plural"
                        ],
                        "form": "subpoenas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97d44f48-bd58-3c08-8b11-fe772fb63c00",
                        "entry_id": "2877216c-f186-37ad-a61b-a198817e5e3b",
                        "glosses": [
                            "Convocation à témoigner devant une cour de justice."
                        ],
                        "tags": [
                            "États-Unis",
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "d6a59d95-a157-4e79-99cb-7e9af85862d6",
                                "sense_id": "97d44f48-bd58-3c08-8b11-fe772fb63c00",
                                "text": "Subpoena : Subpoena ou autre document délivré par un tribunal et enjoignant à une personne qui se trouve dans une province autre que la province qui délivre le subpoena de comparaître devant le tribunal d’origine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9643b26d-36cf-4bc6-bbc6-9b9e5bff7381",
                        "source_entry_id": "2877216c-f186-37ad-a61b-a198817e5e3b",
                        "source_sense_id": "97d44f48-bd58-3c08-8b11-fe772fb63c00",
                        "target_lang_word": "subpoena",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subpoena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "819af99c-afc3-3f91-b3a2-d22a7e8b843c",
                                        "entry_id": "72d4f5b9-47c4-30e9-87d7-8778b93a4527",
                                        "glosses": [
                                            "A writ (“written order”) requiring someone to appear in court, or at a deposition or some other legal proceeding, as a witness to give testimony (a subpoena ad testificandum) or to produce evidence (subpoena duces tecum), in default of which the person may be punished."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c2e6370-c851-4c8e-87b5-b5504d091349",
                                                "sense_id": "819af99c-afc3-3f91-b3a2-d22a7e8b843c",
                                                "text": "Nothing vnder a Sub-pœna can dravv him to London, and vvhen he is there, hee ſtickes faſt vppon euery Obiect, caſts his eyes avvay vppon gazing, and becomes the prey of euery cut-purſe."
                                            },
                                            {
                                                "example_id": "d6fb401c-007f-4ec3-92e2-cb9960ce82ed",
                                                "sense_id": "819af99c-afc3-3f91-b3a2-d22a7e8b843c",
                                                "text": "For the worthy magistrate, determined to omit no chance of doing Effie justice, and to leave her sister no apology for not giving the evidence which she was supposed to possess, had caused the ordinary citation, or sub-pœna, of the Scottish criminal court, to be served upon her by an officer during his conference with David."
                                            },
                                            {
                                                "example_id": "9739a64f-c0f7-4328-b262-526753441a38",
                                                "sense_id": "819af99c-afc3-3f91-b3a2-d22a7e8b843c",
                                                "text": "\"Samuel Weller?\" said Mr. Jackson, enquiringly. \"Vun o' the truest things as you've said for many a long year,\" replied Sam, in a most composed manner. \"Here's a subpœna for you, Mr. Weller,\" said Jackson. […] Mr. Jackson seemed rather puzzled by Sam's proceedings; but, as he had served the subpœnas, and had nothing more to say, he made a feint of putting on the one glove which he usually carried in his hand, for the sake of appearances; and returned to the office to report progress."
                                            },
                                            {
                                                "example_id": "fa99598e-2ef5-43e6-b18f-3c1f310451f6",
                                                "sense_id": "819af99c-afc3-3f91-b3a2-d22a7e8b843c",
                                                "text": "\"He won't be waging wars all the world – he'll be waging 'warsuits,'\" Noah said. \"Droning people with subpoenas all over the globe.\""
                                            },
                                            {
                                                "example_id": "f612b53d-5df4-49fd-9e76-c99fdffdffe0",
                                                "sense_id": "819af99c-afc3-3f91-b3a2-d22a7e8b843c",
                                                "text": "I hereby request that the committee hold the subpoena in abeyance and delay any vote on whether to recommend a citation of contempt for noncompliance with the subpoena, pending the president's determination of this question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae8d2b96-15b3-3359-af5c-eb65482b3734",
                                        "entry_id": "72d4f5b9-47c4-30e9-87d7-8778b93a4527",
                                        "glosses": [
                                            "A writ requiring a defendant to appear in court to answer a plaintiff's claim (a subpoena ad respondendum); in England and Wales, and Ireland, this writ was formerly issued by the Court of Chancery at the plaintiff's request to commence a suit, but the procedure was abolished in 1852."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427ae964-8440-43aa-8824-abc28089893c",
                                                "sense_id": "ae8d2b96-15b3-3359-af5c-eb65482b3734",
                                                "text": "No man to be called by Privy Seal or Subpœna to anſwer any matters but ſuch as have no remedy by the Common law, and that to appear ſo by the teſtimony of two Juſtices of either Bench, and by Indenture between them and the Plaintiff, which Plaintiff ſhall always appear in proper perſon, and find ſurety by recognizance to proſecute with effect the matters of the Bill only, and to anſwer dammages if the ſame fall out againſt the Plaintiff."
                                            },
                                            {
                                                "example_id": "4c97c877-cc64-485f-97c3-8788dfdf1e83",
                                                "sense_id": "ae8d2b96-15b3-3359-af5c-eb65482b3734",
                                                "text": "[I]f the defendant, on ſervice of the ſubpoena, does not appear vvithin the time limited by the rules of the court, and plead, demur, or anſvver to the bill, he is then ſaid to be in contempt; and the reſpective proceſſes of contempt are in ſucceſſive order avvarded againſt him."
                                            },
                                            {
                                                "example_id": "d8c5fcc5-1150-415d-bff8-c9cb73a08b7c",
                                                "sense_id": "ae8d2b96-15b3-3359-af5c-eb65482b3734",
                                                "text": "For to-day in this arena, / Summoned by a stern subpœna, / Edwin, sued by Angelina— / Shortly will appear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8618b091-14a2-3bbf-a49c-4f263fa5dc85",
                                        "entry_id": "72d4f5b9-47c4-30e9-87d7-8778b93a4527",
                                        "glosses": [
                                            "A motive or thing which can compel or demand something, or summon someone."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a9f8020-94a2-4602-aae9-fa21af2bb11b",
                                                "sense_id": "8618b091-14a2-3bbf-a49c-4f263fa5dc85",
                                                "text": "Your meetings cal'd the Ball, to vvhich appeare, / As to the Court of Pleaſure, all your gallants, / And Ladies thither bound by a Subpena / Of Venus, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subpoena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                        "entry_id": "cbc9a6c6-ec7c-3b94-9f2b-8fa909cec228",
                                        "glosses": [
                                            "To summon (someone) with a subpoena (noun sense 1) to appear in court, or at a deposition or some other legal proceeding, as a witness to give testimony or to produce evidence; to serve a subpoena on (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31ffcfd-118e-489c-943b-ced383a9fd0d",
                                                "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                                "text": "Poor Willy! he would not even subpœna any of his old friends as to his general character. But even if he had, what could the Court do since he pleaded guilty?"
                                            },
                                            {
                                                "example_id": "d46713ac-c275-46e6-9963-53f7a465454a",
                                                "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                                "text": "I am just reminded that the president, who is also transfer-agent, of the Black Rapids Coal Company, happens to be on board here, and, having been subpœnaed as witness in a stock case on the docket in Kentucky, has his transfer-book with him."
                                            },
                                            {
                                                "example_id": "211cdd14-800a-40d6-8da7-1a64630abf49",
                                                "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                                "text": "Witnesses, duly and in good faith, subpœnaed to attend any court, officer, commissioner, auditors or referees, or summoned to attend any judge, officer, or commissioner, in any cse where there attendance may, by law, be enforced by attachment or warrant, are exonerated from arrest in any civil suit, while going to the place where they are required to attend, while remaining in attendance as such witnesses, and while returning therefrom."
                                            },
                                            {
                                                "example_id": "5f37044d-fed6-475b-be22-7c823944aa60",
                                                "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                                "text": "Mr. Elgood and his daughter were both subpœnaed for the adjourned inquest."
                                            },
                                            {
                                                "example_id": "4d4d8a19-c6e3-4b54-9a4a-3534adb0fb9f",
                                                "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                                "text": "Volunteer no private information and express no opinion in public, especially in the Press, concerning medico-legal causes with which you are or are not personally concerned; otherwise you may be subpoenaed to support your published views without having seen previously the statements of claim or of defence."
                                            },
                                            {
                                                "example_id": "210a4bc9-3402-4ef3-8dc1-1a1130b83a83",
                                                "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                                "text": "[H]ave our juries at times not only to ensure the prolonged contentions of lawyers with their fees, but also the yet more perplexing strife of the medical experts with theirs? But why leave it to them? Why not subpoena as well the clerical proficients? Their vocation bringing them into peculiar contact with so many human beings, and sometimes in their least guarded hour, in interviews very much more confidential than those of physician and patient; this would seem to qualify them to know something about those intricacies involved in the question of moral responsibility; […]"
                                            },
                                            {
                                                "example_id": "e3052ac4-e5e7-46d8-a75b-db8331ad6de3",
                                                "sense_id": "5eefbb13-e9e0-3996-943d-6549ef18c763",
                                                "text": "The Federal Government subpœnaed over fifty witnesses, but many of these were relieved of testifying by the submission of documents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e07911-88e5-32ca-8a24-ef6da74d4925",
                                        "entry_id": "cbc9a6c6-ec7c-3b94-9f2b-8fa909cec228",
                                        "glosses": [
                                            "To require (a document or other evidence) to be produced before a court, or at a deposition or some other legal proceeding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215690ec-01a2-4462-8897-d0e62d74ef3d",
                                                "sense_id": "58e07911-88e5-32ca-8a24-ef6da74d4925",
                                                "text": "I have just recollected that you ought to have sub-pœnaᵈ in Goodwins & Thomass cases Goodwins comes on the second monday in October. You must send up for them."
                                            },
                                            {
                                                "example_id": "68995df6-0b71-475e-8b30-4b441fc04196",
                                                "sense_id": "58e07911-88e5-32ca-8a24-ef6da74d4925",
                                                "text": "In a letter to the House Judiciary Committee, the department accused Democrats of being unreasonable in subpoenaing that material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d34ac7b-6196-3b02-bbaa-1699ffd9e406",
                                        "entry_id": "cbc9a6c6-ec7c-3b94-9f2b-8fa909cec228",
                                        "glosses": [
                                            "To compel or summon (someone or something); to demand."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f551bd07-b528-4ab5-bff4-a9139f04a006",
                                                "sense_id": "2d34ac7b-6196-3b02-bbaa-1699ffd9e406",
                                                "text": "We wish to subpœna the public to our characters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
