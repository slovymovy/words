                                                "sense_id": "ff7e4499-03f3-38b3-8fb7-bb26c5df1b85",
                                                "text": "Many bold fonts are available on this computer."
                                            },
                                            {
                                                "example_id": "beeaa51c-6da7-45d9-8344-33fe131e223c",
                                                "sense_id": "ff7e4499-03f3-38b3-8fb7-bb26c5df1b85",
                                                "text": "In HTML, wrapping text in <b> and </b> tags produces bold text."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6b57716-a734-33c6-94b1-19f54576aef2",
                                        "entry_id": "932d6f1c-9a1f-3185-8cc9-55bb2309c075",
                                        "glosses": [
                                            "Presumptuous, forward or impudent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44972f1-2785-4676-9185-f77c360a0234",
                                                "sense_id": "a6b57716-a734-33c6-94b1-19f54576aef2",
                                                "text": "[…] even the boldeſt and moſt affirmative Philoſophy, which has ever attempted to impoſe its crude Dictates and Principles on Mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f2a920a-bd65-3653-9490-e794ebd020c1",
                                        "entry_id": "932d6f1c-9a1f-3185-8cc9-55bb2309c075",
                                        "glosses": [
                                            "Naughty; insolent; badly-behaved."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
