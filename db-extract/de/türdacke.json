                        "examples": [
                            {
                                "example_id": "5ca71bff-0439-4825-bb2c-f78a526614bd",
                                "sense_id": "0eb8aef3-a8ee-3b75-9a70-86d393d41b6b",
                                "text": "„Solche Leute sind mit einem Promillspiegel, wo unsereiner bereits auf der Türdacke liegt, noch zu allem fähig.“"
                            },
                            {
                                "example_id": "9c0dd5de-336b-4eac-8aa0-504c04b97cd4",
                                "sense_id": "0eb8aef3-a8ee-3b75-9a70-86d393d41b6b",
                                "text": "„Als Vertreter für Türdacken und solches Scheißzeug ist er ja nur gegangen, damit er bei der Krankenkassa und Pensionsversicherung angemeldet ist.“"
                            }
                        ],
