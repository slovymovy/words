                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23aac00a-e12e-419b-8706-286083848232",
                        "source_entry_id": "a6064d39-72d2-3e04-a119-e1b9d8bafeac",
                        "source_sense_description": "дикарь",
                        "target_lang_word": "savage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69aea821-8d03-36d8-8d8d-8901f00a4e15",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Wild; not cultivated or tamed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226f4bc8-0abc-4e13-8533-c666b314cd63",
                                                "sense_id": "69aea821-8d03-36d8-8d8d-8901f00a4e15",
                                                "text": "a savage wilderness"
                                            },
                                            {
                                                "example_id": "213c7d1e-6287-4357-b0eb-9bc570aeb908",
                                                "sense_id": "69aea821-8d03-36d8-8d8d-8901f00a4e15",
                                                "text": "a savage forest"
                                            },
                                            {
                                                "example_id": "1940fd75-5d4e-43e8-9467-0c1b8224c360",
                                                "sense_id": "69aea821-8d03-36d8-8d8d-8901f00a4e15",
                                                "text": "The Englishman had extracted the heavy spear from the body of the lion, so that when he went into the forest to hunt that morning he had a feeling of much greater security than at any time since they had been cast upon the savage shore."
                                            },
                                            {
                                                "example_id": "e8ff5b4f-f7b0-4cb3-bee1-f5b6d4fc541f",
                                                "sense_id": "69aea821-8d03-36d8-8d8d-8901f00a4e15",
                                                "text": "Tracing one warm line through a land so wild and savage / And make a Northwest Passage to the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7027f998-6209-3b6d-bbd5-a25ab1866f18",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Barbaric; not civilized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d66540c-fd36-4713-a72c-e828f5b3a8f9",
                                                "sense_id": "7027f998-6209-3b6d-bbd5-a25ab1866f18",
                                                "text": "savage manners"
                                            },
                                            {
                                                "example_id": "e01cb8ab-6369-42f1-9341-cc8fb8608eae",
                                                "sense_id": "7027f998-6209-3b6d-bbd5-a25ab1866f18",
                                                "text": "I obſerv'd a Place where there had been a Fire made, and a Circle dug in the Earth, like a Cockpit, where it is ſuppoſed the Savage Wretches had ſat down to their inhumane Feaſtings upon the Bodies of their Fellow-Creatures."
                                            },
                                            {
                                                "example_id": "d11a1906-77e0-4f1c-85cf-df14b6bf12e4",
                                                "sense_id": "7027f998-6209-3b6d-bbd5-a25ab1866f18",
                                                "text": "What nation since the commencement of the Christian era ever arose from savage to civilized without Christianity?"
                                            },
                                            {
                                                "example_id": "50f4ca29-e243-4242-ab08-0d459443f81e",
                                                "sense_id": "7027f998-6209-3b6d-bbd5-a25ab1866f18",
                                                "text": "It is so absurd to advance into the presence of savage royalty after the fashion of an Irishman driving a pig to market, for that is what we looked like, and the idea nearly made me burst out laughing then and there."
                                            },
                                            {
                                                "example_id": "cd3353f1-c4e1-4fb8-b1b9-fde81c650864",
                                                "sense_id": "7027f998-6209-3b6d-bbd5-a25ab1866f18",
                                                "text": "Her back was toward the jungle, and so she did not see the grasses part, or the savage face that peered from between. Little, bloodshot, close-set eyes scanned her intently, roving from time to time about the open beach for indications of the presence of others than herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf4f244-8177-3a2e-8e2e-a1aceef2c3cb",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Primitive; lacking complexity or sophistication."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5fcafd2-47e8-3e4d-98fd-bcf1ca7a5684",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Fierce and ferocious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e6dcfb-181e-45a0-8942-d5f002cb0d2c",
                                                "sense_id": "f5fcafd2-47e8-3e4d-98fd-bcf1ca7a5684",
                                                "text": "savage beasts"
                                            },
                                            {
                                                "example_id": "44d4a7b6-1706-4762-bae1-a1d086f54afc",
                                                "sense_id": "f5fcafd2-47e8-3e4d-98fd-bcf1ca7a5684",
                                                "text": "a savage spirit"
                                            },
                                            {
                                                "example_id": "68f1b4f7-c791-47ca-af87-94cc06150347",
                                                "sense_id": "f5fcafd2-47e8-3e4d-98fd-bcf1ca7a5684",
                                                "text": "Muſick has Charms to ſooth a ſavage Breaſt, / To ſoften Rocks, or bend a knotted Oak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dd632e-14c7-3040-9f57-622c86cc83fd",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Brutal, vicious, or merciless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7237541-cada-4580-aff5-480bf6ec653d",
                                                "sense_id": "60dd632e-14c7-3040-9f57-622c86cc83fd",
                                                "text": "He gave the dog a savage kick."
                                            },
                                            {
                                                "example_id": "b9b892b3-1758-4f80-b69a-0e47a9d803d2",
                                                "sense_id": "60dd632e-14c7-3040-9f57-622c86cc83fd",
                                                "text": "The woman was killed in a savage manner."
                                            },
                                            {
                                                "example_id": "fddd7513-b5a6-4323-96a4-ca7ef37539e7",
                                                "sense_id": "60dd632e-14c7-3040-9f57-622c86cc83fd",
                                                "text": "Fear of their cargo bred a savage cruelty into the crew. One captain, to strike terror into the rest, killed a slave and dividing heart, liver and entrails into 300 pieces made each of the slaves eat one, threatening those who refused with the same torture. Such incidents were not rare."
                                            },
                                            {
                                                "example_id": "89377ad6-afdc-4368-b79d-5111dbfbbdea",
                                                "sense_id": "60dd632e-14c7-3040-9f57-622c86cc83fd",
                                                "text": "Mr. Lightfoot, 31, returned to the witness stand for the second day and continued a harrowing, first-person account of the savage beating that he received in July 2012, when, Bronx prosecutors contend, the officers decided to teach him a lesson."
                                            },
                                            {
                                                "example_id": "4017050d-c502-49ef-80c1-bbb18fe12401",
                                                "sense_id": "60dd632e-14c7-3040-9f57-622c86cc83fd",
                                                "text": "The fight is not all one-sided. Lion is taking a savage beating as the two flagships trade body blows almost independent of the furious carronade going on behind them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Of an insult or person: disrespectful, audacious, and either blunt or sarcastic, in a hilarious way."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35ea9da6-a2f3-4cc4-911d-0ab6a0d54e40",
                                                "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                                                "text": "Wow, that was a savage burn. Absolutely no chill."
                                            },
                                            {
                                                "example_id": "d3f10f90-b112-4c5a-8b3f-6c0eb5754038",
                                                "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                                                "text": "'Oops, I did it again': Jocelyne Lamoureux-Davidson's deke was so savage it has a name"
                                            },
                                            {
                                                "example_id": "5408e709-0bc4-42c9-95ff-cdb57985ece8",
                                                "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                                                "text": "Stephen Colbert revealed a savage new campaign slogan for President Donald Trump on Wednesday ― and it came courtesy of Sen. Rand Paul (R-Ky.)."
                                            },
                                            {
                                                "example_id": "595b8afa-3f15-4ffc-a1ce-fad502d66790",
                                                "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                                                "text": "But now Gen Z is coming for them and it's absolutely savage. TikTok comment sections like this one have revealed the fact no one likes millennials and their endless Harry Potter references."
                                            },
                                            {
                                                "example_id": "1d5c0663-2bb6-4944-8606-c893064048a4",
                                                "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                                                "text": "This match continued the theme from last month as the two cousins started off with heated trash talk. Roman Reigns telling Jey Uso \"I will end you...\" in the same tone a parent tells their kid \"I'm warning you...\" was so savage."
                                            },
                                            {
                                                "example_id": "dc0d1b02-d32e-4405-9271-5ad19adaa3dc",
                                                "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                                                "text": "A savage new song by Shakira in which the Colombian star, philanthropist and committed believer in the veracity of hips ridicules her former partner Gerard Piqué has logged more than 63m YouTube views in 24 hours, making it the most watched new Latin song in the platform's history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96dfc4da-82ea-32d2-ba24-e2aa023a9535",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Unpleasant or unfair."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f32bc6-6699-41ae-8c32-a5daa10b6936",
                                                "sense_id": "96dfc4da-82ea-32d2-ba24-e2aa023a9535",
                                                "text": "– I'll see you in detention.\n– Ah, savage!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15b249fa-4a65-36f4-b625-c6be24ecb129",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Great, brilliant, amazing."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e3d85c6-49af-31ad-aa37-ee21f1870a96",
                                        "entry_id": "6a4c6ecd-495a-3e92-a21c-c70ff6ace25e",
                                        "glosses": [
                                            "Severe, rude, aggressive."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58e7a38b-483f-48c4-899b-e36fc46c4ab9",
                                                "sense_id": "2e3d85c6-49af-31ad-aa37-ee21f1870a96",
                                                "text": "– They were so savage to them!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "savage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f661d912-5ac7-3e76-956a-6d6150ee514f",
                                        "entry_id": "efdfcece-2f21-3c42-9532-762cd52430f3",
                                        "glosses": [
                                            "A person not living in a civilization; a barbarian."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdeebcfa-9b95-4b03-803c-eb297ced7920",
                                                "sense_id": "f661d912-5ac7-3e76-956a-6d6150ee514f",
                                                "text": "'Well, my lord, I don't know,' said Freeman with a sort of jolly sneer; 'we have been dining with the savages.'\n'They are not savages, Freeman.'\n'Well, my lord, they have not much more clothes, anyhow; and as for knives and forks, there is not such a thing known.'"
                                            },
                                            {
                                                "example_id": "66a293a8-4ea0-49f0-b7cd-908187f23a1f",
                                                "sense_id": "f661d912-5ac7-3e76-956a-6d6150ee514f",
                                                "text": "The glimpse of the steamboat had for some reason filled those savages with unrestrained grief."
                                            },
                                            {
                                                "example_id": "0782a802-7b18-4c04-8f5d-e307cce99461",
                                                "sense_id": "f661d912-5ac7-3e76-956a-6d6150ee514f",
                                                "text": "In the year 1879, when the Utes succeeded in getting some United States troops into what was afterwards known as Thornburg's \"rat hole,\" several mounted couriers succeeded in slipping through the circling line of savages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83fa6e3e-07a1-313f-a193-efa16b19a3c9",
                                        "entry_id": "efdfcece-2f21-3c42-9532-762cd52430f3",
                                        "glosses": [
                                            "An aggressively defiant person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d7143a-a290-4385-b84f-48161e447d63",
                                                "sense_id": "83fa6e3e-07a1-313f-a193-efa16b19a3c9",
                                                "text": "Their kids are little savages! One of them bit me the other day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a79c3738-0dfe-38b7-9e3a-5bfaffe6c612",
                                        "entry_id": "efdfcece-2f21-3c42-9532-762cd52430f3",
                                        "glosses": [
                                            "Someone who speaks in an audacious, hilarious, and often sarcastic manner."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29fc4546-4a28-4dfb-947a-9908bef3e5df",
                                                "sense_id": "a79c3738-0dfe-38b7-9e3a-5bfaffe6c612",
                                                "text": "It was on Dec. 29 that TikTok star Liv Pearsall posted a video titled \"7 Times Elmo Was an Absolute Savage,\" in which the star with more than 2.7 million followers lip-synced to various Elmo-ments."
                                            },
                                            {
                                                "example_id": "5899a191-deaf-476a-895a-5db2ae81fb74",
                                                "sense_id": "a79c3738-0dfe-38b7-9e3a-5bfaffe6c612",
                                                "text": "\"Sometimes they would stay up while she'd have a whole new guy in a relationship,\" she wrote in a comment. \"LMFAO she is a savage.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db69b99-ee3e-3810-9a09-dcbfbbc32faa",
                                        "entry_id": "efdfcece-2f21-3c42-9532-762cd52430f3",
                                        "glosses": [
                                            "A wild and ferocious beast."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d831660-4f5b-4939-b292-36d3fccea51b",
                                                "sense_id": "0db69b99-ee3e-3810-9a09-dcbfbbc32faa",
                                                "text": "The torch-eyed ſavage, with growl tremendous, riſing up, diſlocated at one blow the arched neck of Sadit's Arabian ſteed, and brought the unfortunate omrah to the duſt, expiring between his extended claws."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "savage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fd41538-8709-3373-b395-3c00b0ca3da5",
                                        "entry_id": "1161763c-3334-3101-a41e-23857c8a18a2",
                                        "glosses": [
                                            "To attack or assault someone or something ferociously or without restraint."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f91bfb16-baa8-4943-bc7a-1614738cc574",
                                                "sense_id": "7fd41538-8709-3373-b395-3c00b0ca3da5",
                                                "text": "No matter how anyone might savage me, I should stay strong."
                                            },
                                            {
                                                "example_id": "c0ffdad4-77e1-413d-b791-104698e32ba5",
                                                "sense_id": "7fd41538-8709-3373-b395-3c00b0ca3da5",
                                                "text": "But that was only the start, because the Fletchers - (obviously) carrying two torpedo launchers - were only launching half-salvos, so one full wave of torpedoes had driven off the cruisers after having savaged the destroyers, aaand then it was a case of, well, here come twenty-five destroyers, here comes^([sic]) two hundred and fifty torpedoes, hello Japanese battleships, dodge this!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b55404-1665-37cb-8750-497efe2fb825",
                                        "entry_id": "1161763c-3334-3101-a41e-23857c8a18a2",
                                        "glosses": [
                                            "To criticise vehemently."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c0871d0-15a5-4c66-9367-c854422540e6",
                                                "sense_id": "e7b55404-1665-37cb-8750-497efe2fb825",
                                                "text": "His latest film was savaged by most reviewers."
                                            },
                                            {
                                                "example_id": "92088204-b295-45b3-8e5d-09b48f8d1aa0",
                                                "sense_id": "e7b55404-1665-37cb-8750-497efe2fb825",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664c44c3-b3e4-393e-8bdb-ed9958af84a2",
                                        "entry_id": "1161763c-3334-3101-a41e-23857c8a18a2",
                                        "glosses": [
                                            "To attack with the teeth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e66a030-c095-3220-b410-480ee6e980d0",
                                        "entry_id": "1161763c-3334-3101-a41e-23857c8a18a2",
                                        "glosses": [
                                            "To make savage."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996905e8-8b2c-44e5-8d72-693f3a566845",
                                                "sense_id": "0e66a030-c095-3220-b410-480ee6e980d0",
                                                "text": "Its bloodhounds, savaged by a cross of wolf."
                                            }
                                        ]
                                    }
                                ]
