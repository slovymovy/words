                        ]
                    },
                    {
                        "translation_id": "4dcdd0cb-3106-4af8-a6ff-7cabe631594a",
                        "source_entry_id": "f1a26a08-af3b-305d-92a5-105d6e0f8024",
                        "source_sense_id": "d84b9be1-3b90-324d-bd5e-4f43263528fc",
                        "target_lang_word": "έκδοση",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "έκδοση",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "15602838-d5e5-3887-ad81-f3dc8262ef91",
                                        "entry_id": "6e344883-400b-3f6d-8d35-06c19aaf7255",
                                        "glosses": [
                                            "το σύνολο των ενεργειών που απαιτούνται για την εκτύπωση και τη διάθεση στη κυκλοφορία ενός εντύπου, βιβλίου, περιοδικού ή εφημερίδας."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7381a846-3132-4c8d-b3d3-f4cfd3f6fa55",
                                                "sense_id": "15602838-d5e5-3887-ad81-f3dc8262ef91",
                                                "text": "Η έκδοση του βιβλίου του συνάντησε την αδιαφορία του κοινού."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "119ee145-57e0-3856-babe-9224b2a62626",
                                        "entry_id": "6e344883-400b-3f6d-8d35-06c19aaf7255",
                                        "glosses": [
                                            "το σύνολο των αντιτύπων ενός βιβλίου που προέρχονται από την ίδια στοιχειοθεσία."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9adc06-9cc0-4e04-ad55-c44ae075ff3c",
                                                "sense_id": "119ee145-57e0-3856-babe-9224b2a62626",
                                                "text": "Η νεότερη έκδοση του βιβλίου με διορθώσεις και βελτιώσεις."
                                            },
                                            {
                                                "example_id": "9a6ffc54-717b-40f4-bcfa-6c7756c3c005",
                                                "sense_id": "119ee145-57e0-3856-babe-9224b2a62626",
                                                "text": "※ ποτέ οι πωλήσεις των βιβλίων μου δεν ξεπερνούσαν το φράγμα της πρώτης, άντε το πολύ της δεύτερης έκδοσης. «Μη στενοχωριέσαι. Είναι γιατί είσαι ιδιαίτερος συγγραφέας. Σε διαβάζουν λίγοι αλλά εκλεκτοί ... » Με τέτοια με παρηγορούσε ο μπαγάσας. Ήταν από τους δυο τρεις που έβγαινα για ποτό και που εμπιστευόμουν τα χειρόγραφα να ακούσω τη γνώμη τους. (Κώστας Ακριβός, Γάλα Μαγνησίας, εκδ. Μεταίχμιο, 2018)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "627493d6-9e30-3f33-91c9-7bf78715abbe",
                                        "entry_id": "6e344883-400b-3f6d-8d35-06c19aaf7255",
                                        "glosses": [
                                            "η κριτική εργασία που απαιτείται για να εκδοθεί το κείμενο αρχαίων συγγραφέων."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccb2e20-c2c3-40fd-a29d-b1a518c081ed",
                                                "sense_id": "627493d6-9e30-3f33-91c9-7bf78715abbe",
                                                "text": "Ο Αδαμάντιος Κοραής ασχολήθηκε με την έκδοση αρχαίων Ελλήνων συγγραφέων."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73d82196-be72-3523-a010-98c4d85b07b9",
                                        "entry_id": "6e344883-400b-3f6d-8d35-06c19aaf7255",
                                        "glosses": [
                                            ") εκδοτικός οίκος"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f214995-8a21-49b2-9671-b232fc362333",
                                                "sense_id": "73d82196-be72-3523-a010-98c4d85b07b9",
                                                "text": "Οι εκδόσεις Ίκαρος εξέδωσαν τα ποιήματα του Γ. Σεφέρη."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df07891d-1601-3828-b819-1b23353fe8dc",
                                        "entry_id": "6e344883-400b-3f6d-8d35-06c19aaf7255",
                                        "glosses": [
                                            "η σύνταξη, εκτύπωση και παράδοση στον δικαιούχο προσωπικών εγγράφων, π.χ. ταυτότητας, διαβατηρίου"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387110d3-7ac0-4635-b2c2-e0ccc738440c",
                                                "sense_id": "df07891d-1601-3828-b819-1b23353fe8dc",
                                                "text": "Οι αστυνομικές αρχές είναι υπεύθυνες για την έκδοση διαβατηρίων."
                                            },
                                            {
                                                "example_id": "72173112-a861-4bf1-b635-8ab3c211a700",
                                                "sense_id": "df07891d-1601-3828-b819-1b23353fe8dc",
                                                "text": "※ Με προεδρικό διάταγμα, το οποίο εκδίδεται μετά από πρόταση των Υπουργών Εσωτερικών, Αποκέντρωσης και Ηλεκτρονικής Διακυβέρνησης και Οικονομικών, ρυθμίζονται θέματα που αφορούν στη βεβαίωση εσόδων, στην ανάληψη υποχρεώσεων, στην έκδοση χρηματικών ενταλμάτων, στην ευθύνη και στον καταλογισμό σε βάρος των προσώπων που τα εκδίδουν και τα προσυπογράφουν, στη διαδικασία και το περιεχόμενο του ελέγχου των χρηματικών ενταλμάτων, στη χρηματική διαχείριση της ταμειακής υπηρεσίας, στη λογοδοσία των υπαλλήλων που ασκούν καθήκοντα ταμία (Νόμος 3852/2010, Άρθρο 268)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5663d48f-3664-381e-9a3c-372993a0bae7",
                                        "entry_id": "6e344883-400b-3f6d-8d35-06c19aaf7255",
                                        "glosses": [
                                            "η εκτύπωση και διάθεση στην κυκλοφορία χαρτονομισμάτων"
                                        ],
                                        "tags": [
                                            "οικονομία"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b584e2e1-7cc4-397d-9b3e-a126e51ed680",
                                        "entry_id": "6e344883-400b-3f6d-8d35-06c19aaf7255",
                                        "glosses": [
                                            "Η σύνταξη και ανακοίνωση μιας απόφασης."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29df2ee-e117-4bde-be37-e9e69226a13e",
                                                "sense_id": "b584e2e1-7cc4-397d-9b3e-a126e51ed680",
                                                "text": "Η έκδοση της απόφασης του δικαστηρίου θα καθυστερήσει."
