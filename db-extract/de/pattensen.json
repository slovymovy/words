                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75373f6b-ab84-4885-b6e6-9b5ef68a54a9",
                                "sense_id": "dbb6ee39-299d-33e1-aa18-1c5554afad87",
                                "text": "„Seit Oktober 2014 ist das Bistro im Hallen- und Freibad in Pattensen ohne Pächter.“"
                            },
                            {
                                "example_id": "e96f449a-f2ad-493b-abe9-6f6867f3de75",
                                "sense_id": "dbb6ee39-299d-33e1-aa18-1c5554afad87",
                                "text": "„Nach eineinhalb Jahren gibt es einen Nachnutzer für den ehemaligen Wal-Mart an der Kreuzung der Bundesstraßen 3 und 443 in Pattensen.“"
                            },
                            {
                                "example_id": "9ff274de-fcd5-4802-9caf-f030a87d537b",
                                "sense_id": "dbb6ee39-299d-33e1-aa18-1c5554afad87",
                                "text": "„Von den ursprünglich acht Burgmannshöfen in Pattensen ist nur noch einer erhalten geblieben: der Stichelsche Hof am Ende der Mauerstraße, auch bekannt als das „Rittergut Pattensen 1“ oder die sogenannte „Klaterburg“.“"
                            }
                        ],
