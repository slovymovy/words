    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8992cd67-8bd7-3d1e-a2d0-822dab66122b",
                    "sense_definition": "Iemand die afstamt van een bepaalde persoon of familie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afstamming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij ontdekte dat hij een directe <w>nazaat</w> was van een beroemde schilder.",
                            "target_lang_translations": {
                                "fr": "Il a découvert qu'il était un <w>descendant</w> direct d'un peintre célèbre."
                            }
                        },
                        {
                            "text": "Veel <w>nazaten</w> van de immigranten wonen nog steeds in dezelfde stad.",
                            "target_lang_translations": {
                                "fr": "De nombreux <w>descendants</w> des immigrés vivent toujours dans la même ville."
                            }
                        }
                    ],
                    "synonyms": [
                        "nakomeling"
                    ],
                    "antonyms": [
                        "voorzaat"
                    ],
                    "common_phrases": [
                        "directe nazaat",
                        "verre nazaat"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne issue d'une personne ou d'une lignée spécifique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "descendant",
                                "target_lang_sense_clarification": "personne issue d'un ancêtre"
                            },
                            {
                                "target_lang_word": "rejeton",
                                "target_lang_sense_clarification": "descendance, lignée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bf76bc9-7967-3de9-ab91-d9dc63722777",
                    "sense_definition": "Kind of jonge telg uit een familie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afstamming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De trotse ouders lieten hun jonge <w>nazaat</w> aan de hele familie zien.",
                            "target_lang_translations": {
                                "fr": "Les parents fiers ont présenté leur jeune <w>rejeton</w> à toute la famille."
                            }
                        },
                        {
                            "text": "Het familiewapen wordt met trots doorgegeven aan elke nieuwe <w>nazaat</w>.",
                            "target_lang_translations": {
                                "fr": "Les armoiries familiales sont transmises avec fierté à chaque nouveau <w>descendant</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kind",
                        "nakomeling"
                    ],
                    "target_lang_definitions": {
                        "fr": "Enfant ou jeune rejeton d'une famille."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rejeton",
                                "target_lang_sense_clarification": "enfant, membre de la jeune génération"
                            },
                            {
                                "target_lang_word": "progéniture",
                                "target_lang_sense_clarification": "enfant, descendance au sens familial"
                            },
                            {
                                "target_lang_word": "descendant",
                                "target_lang_sense_clarification": "fils, fille ou descendant direct"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19050334-6a17-36af-8405-2ae2b338b9d5",
                    "sense_definition": "Iemand die het werk of de traditie van een voorganger voortzet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als artistieke <w>nazaat</w> van de meester bouwde hij voort op diens ideeën.",
                            "target_lang_translations": {
                                "fr": "En tant qu'<w>héritier</w> artistique du maître, il a continué à développer ses idées."
                            }
                        },
                        {
                            "text": "De moderne schrijvers zagen zichzelf als de literaire <w>nazaten</w> van de romantici.",
                            "target_lang_translations": {
                                "fr": "Les écrivains modernes se considéraient comme les <w>héritiers</w> littéraires des romantiques."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui perpétue l'œuvre, le style ou la tradition d'un prédécesseur."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "héritier",
                                "target_lang_sense_clarification": "au sens spirituel ou artistique"
                            },
                            {
                                "target_lang_word": "successeur",
                                "target_lang_sense_clarification": "qui poursuit la tradition"
                            },
                            {
                                "target_lang_word": "continuateur",
                                "target_lang_sense_clarification": "qui prolonge une œuvre ou une idée"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}