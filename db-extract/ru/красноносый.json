                "senses": [
                    {
                        "sense_id": "68420f03-c6d5-3a64-8d55-1398524aeb4d",
                        "entry_id": "b47df1b5-39d4-36ae-88df-7ca84c58cb24",
                        "glosses": [
                            "имеющий красный нос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a697071b-86c7-4938-a882-a72606887076",
                                "sense_id": "68420f03-c6d5-3a64-8d55-1398524aeb4d",
                                "text": "Руневский попросил красноносого лакея, чтобы он теперь его оставил."
                            },
                            {
                                "example_id": "73a83ca0-77d0-44da-80a2-6e4041c69ccb",
                                "sense_id": "68420f03-c6d5-3a64-8d55-1398524aeb4d",
                                "text": "Красноносый скриба тут же записывал воина в список и ставил против его имени палочку ― первый денарий, полученный за кровь, проливаемую ради Рима."
                            }
                        ]
                    }
