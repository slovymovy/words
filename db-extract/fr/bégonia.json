                    {
                        "translation_id": "d1614e55-663d-4140-b008-5428aa04f5ef",
                        "source_entry_id": "74ba1497-1f87-3368-a7e7-535bc0f2904f",
                        "source_sense_id": "cb53cb9c-3d64-365c-bcad-be94b51d4260",
                        "target_lang_word": "秋海棠",
