                "translations": [
                    {
                        "translation_id": "e335314a-1cbf-4ef8-9bed-3f43a3b87877",
                        "source_entry_id": "2cc851a8-b1f2-3346-84cd-72fa06584589",
                        "target_lang_word": "mix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afffa769-04c2-3123-b99c-9e1487258696",
                                        "entry_id": "1ebbccb2-6118-33e6-bc48-cf97594988a5",
                                        "glosses": [
                                            "To stir together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8b2eac8-db62-4bb4-9989-eef092926f4c",
                                                "sense_id": "afffa769-04c2-3123-b99c-9e1487258696",
                                                "text": "Mix the eggs and milk with the flour until the consistency is smooth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f0b029-2210-3c2d-933d-c9ee1aed2931",
                                        "entry_id": "1ebbccb2-6118-33e6-bc48-cf97594988a5",
                                        "glosses": [
                                            "To combine (items from two or more sources normally kept separate)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aae6c24-1b86-4e4d-911a-6a027ea84677",
                                                "sense_id": "f9f0b029-2210-3c2d-933d-c9ee1aed2931",
                                                "text": "to mix business with pleasure"
                                            },
                                            {
                                                "example_id": "56258e7f-f0e0-47e2-b664-cd89514e9177",
                                                "sense_id": "f9f0b029-2210-3c2d-933d-c9ee1aed2931",
                                                "text": "Don't mix the meat recipes with the dairy recipes."
                                            },
                                            {
                                                "example_id": "f659ce11-fcbf-43b7-8dc5-71e617c0919a",
                                                "sense_id": "f9f0b029-2210-3c2d-933d-c9ee1aed2931",
                                                "text": "What here shall miss, our toil shall strive to mend."
                                            },
                                            {
                                                "example_id": "cf8ec30e-9519-493b-82f5-5d8131347c58",
                                                "sense_id": "f9f0b029-2210-3c2d-933d-c9ee1aed2931",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc322fc-208e-3d1a-b5f5-2ce7f0d74e87",
                                        "entry_id": "1ebbccb2-6118-33e6-bc48-cf97594988a5",
                                        "glosses": [
                                            "To form by mingling; to produce by the stirring together of ingredients; to concoct from different parts."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1e193d6-8003-43df-9fb2-a9e3d780cc5d",
                                                "sense_id": "adc322fc-208e-3d1a-b5f5-2ce7f0d74e87",
                                                "text": "Yellow and blue paint mix to make green."
                                            },
                                            {
                                                "example_id": "526ad04d-ee4b-4a20-8894-34fe17b12787",
                                                "sense_id": "adc322fc-208e-3d1a-b5f5-2ce7f0d74e87",
                                                "text": "Hast thou no poison mixed?"
                                            },
                                            {
                                                "example_id": "46aa0787-e9c3-4a85-889f-b0f617623d70",
                                                "sense_id": "adc322fc-208e-3d1a-b5f5-2ce7f0d74e87",
                                                "text": "Therefore J haue chosen an Argument, mixt of Religious and Ciuill Considerations; And likewise mixt between Contemplatiue, and Actiue."
                                            },
                                            {
                                                "example_id": "b39c1265-ccda-4036-b86b-14efbe506ed4",
                                                "sense_id": "adc322fc-208e-3d1a-b5f5-2ce7f0d74e87",
                                                "text": "In order to the diſcovery of ſome hints of the account, upon which the above mentioned mixtures were more intenſely frigefactive than ſnow alone, we ſealed up a ſingle vial of ſnow unmingled with any other ingredient, and found it to thaw much more ſlowly than any of thoſe parcels of ſnow, which we had mixt with ſalts or ſpirits."
                                            },
                                            {
                                                "example_id": "99cd415e-2bfb-49a3-a441-ca07c93226b4",
                                                "sense_id": "adc322fc-208e-3d1a-b5f5-2ce7f0d74e87",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "820fe290-a11e-31f7-a600-c1170bc77341",
                                        "entry_id": "1ebbccb2-6118-33e6-bc48-cf97594988a5",
                                        "glosses": [
                                            "To blend by the use of a mixer (machine)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe66e5b5-d613-4ffb-a912-b7580a3bcc0c",
                                                "sense_id": "820fe290-a11e-31f7-a600-c1170bc77341",
                                                "text": "Mix the egg whites until they are stiff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e30590d7-d21b-36d3-9208-6a1f50ed9c63",
                                        "entry_id": "1ebbccb2-6118-33e6-bc48-cf97594988a5",
                                        "glosses": [
                                            "To combine (several tracks)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9161964-52c7-4da2-959e-5a57c57a8972",
                                                "sense_id": "e30590d7-d21b-36d3-9208-6a1f50ed9c63",
                                                "text": "I'll mix the rhythm tracks down to a single track."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80c801ab-7bd6-3ce8-8dc8-d7bd3a2bae58",
                                        "entry_id": "1ebbccb2-6118-33e6-bc48-cf97594988a5",
                                        "glosses": [
                                            "To produce a finished version of (a recording)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "851d11f2-95c2-4ac6-9551-2ea1f69e7a82",
                                                "sense_id": "80c801ab-7bd6-3ce8-8dc8-d7bd3a2bae58",
                                                "text": "I'm almost done mixing this song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "089fb7e7-b063-37ab-a2ae-0cfdea3489c7",
                                        "entry_id": "1ebbccb2-6118-33e6-bc48-cf97594988a5",
                                        "glosses": [
                                            "To unite with in company; to join; to associate."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "decced5e-079b-4d67-a876-c4032b1016f9",
                                                "sense_id": "089fb7e7-b063-37ab-a2ae-0cfdea3489c7",
                                                "text": "Ephraim, he hath mixed himself among the people."
                                            },
                                            {
                                                "example_id": "9e06babe-51bc-4c4c-a5f5-2d1231099189",
                                                "sense_id": "089fb7e7-b063-37ab-a2ae-0cfdea3489c7",
                                                "text": "The mention of the six knots of elderwood is curious, for that tree mixes largely in folk lore."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52e83a0b-9f25-3754-a29e-9de0e42722c4",
                                        "entry_id": "eca9d8f5-75bf-3c38-a7aa-7e3264c28955",
                                        "glosses": [
                                            "The result of mixing two or more substances; a mixture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dddf535-7dfe-4607-ac14-977a5b481429",
                                                "sense_id": "52e83a0b-9f25-3754-a29e-9de0e42722c4",
                                                "text": "Now add the raisins to the mix."
                                            },
                                            {
                                                "example_id": "0ad78bde-4e58-42ad-8e66-e13f9cc3117a",
                                                "sense_id": "52e83a0b-9f25-3754-a29e-9de0e42722c4",
                                                "text": "[…] fifteen flavors of powdered mixes in traditional scoop-out packages, seven flavors of single-serve bottled drinks, and three flavors of multiserve bottles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d4148c-aa4f-39f1-9c6d-968760fde51f",
                                        "entry_id": "eca9d8f5-75bf-3c38-a7aa-7e3264c28955",
                                        "glosses": [
                                            "The result of combining items normally kept separate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237a457e-64c7-4a66-bbfb-d7b694ea7840",
                                                "sense_id": "66d4148c-aa4f-39f1-9c6d-968760fde51f",
                                                "text": "My recipe file was now a mix of meat and dairy."
                                            },
                                            {
                                                "example_id": "883594dd-316e-4355-aac2-98d089103b56",
                                                "sense_id": "66d4148c-aa4f-39f1-9c6d-968760fde51f",
                                                "text": "The combination of classical music and hip hop is a surprisingly good mix."
                                            },
                                            {
                                                "example_id": "7d470386-ebb4-48f5-a508-b5b87e41171d",
                                                "sense_id": "66d4148c-aa4f-39f1-9c6d-968760fde51f",
                                                "text": "A Chronicle of Higher Education tracker of nearly 3,000 colleges found that of those with firm plans, 19% are opening primarily in person; 27% are primarily online; and 16% are, like Penn State, a mix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d02622-c496-3a45-834c-c2255f3c7fab",
                                        "entry_id": "eca9d8f5-75bf-3c38-a7aa-7e3264c28955",
                                        "glosses": [
                                            "A preparation, usually in the form of a powder, into which other ingredients can be mixed to prepare a specified foodstuff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2992884-c0a8-4926-9b7d-9963bad9bc7a",
                                                "sense_id": "f7d02622-c496-3a45-834c-c2255f3c7fab",
                                                "text": "Cake mix. Pancake mix. Hot chocolate mix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "843add06-e88e-3652-81aa-0ef36364ad75",
                                        "entry_id": "eca9d8f5-75bf-3c38-a7aa-7e3264c28955",
                                        "glosses": [
                                            "The result of mixing several tracks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "996df2b8-9d13-4ce8-a2ae-ad44d75016db",
                                                "sense_id": "843add06-e88e-3652-81aa-0ef36364ad75",
                                                "text": "The rhythm mix sounds muddy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0e907b-30a0-35e7-9271-8004949b236a",
                                        "entry_id": "eca9d8f5-75bf-3c38-a7aa-7e3264c28955",
                                        "glosses": [
                                            "The finished version of a recording."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ee4427-8072-4f13-bc56-162c920b042c",
                                                "sense_id": "de0e907b-30a0-35e7-9271-8004949b236a",
                                                "text": "I've almost finished the mix for this song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a60256-8698-37a5-acf3-87de95f67e30",
                                        "entry_id": "eca9d8f5-75bf-3c38-a7aa-7e3264c28955",
                                        "glosses": [
                                            "A substance used to dilute or adulterate an illicit drug."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "406f505f-eb38-49ac-8c76-743c2040ba85",
                                                "sense_id": "66a60256-8698-37a5-acf3-87de95f67e30",
                                                "text": "Eventually I could taste different drugs and tell how much mix in it or if there’s too much mix in it or what have you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c241dd2-10a9-4206-b491-89161543a3e7",
                        "source_entry_id": "2cc851a8-b1f2-3346-84cd-72fa06584589",
                        "target_lang_word": "Mischung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mischung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                        "entry_id": "2506ff77-13d5-3fa8-8a94-9fc6079a0eef",
                                        "glosses": [
                                            "Vorgang und Ergebnis des Zusammentuns/-kommens unterschiedlicher Gegenstände"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f85b107-74d5-468a-bb3c-e8f613aedb03",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Auf die Mischung in der Stadt kommt es an.“"
                                            },
                                            {
                                                "example_id": "7469db6c-3298-4065-a3f3-59aae69578ec",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Inzwischen tröpfeln aus den verschiedenen Straßen die Reisegenossen an, keine Menagerie, wie Delius sich das etwas übertrieben vorgestellt hatte, sondern eine brave Mischung von durchaus üblichen Menschen:…“"
                                            },
                                            {
                                                "example_id": "c9a0c332-ebd4-44ea-b315-348debc302dd",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Sie betrachtete ihn mit einer Mischung aus Bewunderung und Skepsis.“"
                                            },
                                            {
                                                "example_id": "0c7e4dab-63b4-4760-a1ed-7c8122cc38a4",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Ihr Hausrat war ein bunte Mischung aus diesem und jenem.“"
                                            },
                                            {
                                                "example_id": "624d6f30-b723-4194-8706-e73518149931",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Mit Kim kehrt ein Spieler zurück, der Mitte der Nullerjahre die Golfwelt im Sturm erobert hatte mit einer wilden Mischung aus Talent, Lässigkeit und Angriffslust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37a4114b-9dd5-355f-9bc0-4b2819053cec",
                                        "entry_id": "2506ff77-13d5-3fa8-8a94-9fc6079a0eef",
                                        "glosses": [
                                            "Gemisch von mindestens zwei Stoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb6ec4f-1635-44c0-8479-b9cf356e9f49",
                                                "sense_id": "37a4114b-9dd5-355f-9bc0-4b2819053cec",
                                                "text": "Salz gelöst in Wasser ist eine homogene Mischung / ein homogenes Gemisch."
                                            },
                                            {
                                                "example_id": "a219e6eb-0340-469e-9750-7b740a5c8070",
                                                "sense_id": "37a4114b-9dd5-355f-9bc0-4b2819053cec",
                                                "text": "„Benzin ist eine Mischung verschiedener Flüssigkeiten, eine davon ist Octan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "461005fa-ce5c-3e7a-b323-ef9502a7c970",
                                        "entry_id": "2506ff77-13d5-3fa8-8a94-9fc6079a0eef",
                                        "glosses": [
                                            "Mischung zweier oder mehrerer Farben"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "803127cd-f3c5-41e7-a6c9-91391ad40b2e",
                                                "sense_id": "461005fa-ce5c-3e7a-b323-ef9502a7c970",
                                                "text": "Die Mischung von Blau und Gelb ergibt grün."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
