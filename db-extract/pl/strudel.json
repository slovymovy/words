                                    {
                                        "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                        "entry_id": "183c24c9-2a05-397e-9e77-2c47dfbf6776",
                                        "glosses": [
                                            "(kleiner) Wasserwirbel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfe762d-19b3-445d-b047-60e0e78f27e0",
                                                "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                                "text": "Durch den Strudel wurde das Boot in die Tiefe gezogen."
                                            },
                                            {
                                                "example_id": "0143b94f-f78f-4165-9ba7-f390fcbf0b04",
                                                "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                                "text": "„Wie benommen waren die Deutschen aus den kataklysmischen Strudeln des Krieges aufgetaucht, taub noch von den Explosionsgeräuschen der Fliegerbomben und Artilleriegranaten, abgestumpft durch die Tristesse der Umstände, erschöpft von der schieren Mühsal des Überlebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                        "entry_id": "183c24c9-2a05-397e-9e77-2c47dfbf6776",
                                        "glosses": [
                                            "gefüllte Teigspeise"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6be6c02-c6e2-43c8-9beb-53a3b6f070c6",
                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "Omas Strudel schmeckt einfach am besten."
                                            },
                                            {
                                                "example_id": "44d2a95c-d2d6-47b7-a377-9eb0590af3b7",
                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "„Sie backte die besten Strudel der Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
