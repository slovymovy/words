                "senses": [
                    {
                        "sense_id": "657aa17f-371d-37fa-84fe-8c3a648d8003",
                        "entry_id": "8e068d04-aab3-3823-af32-3a03733ee439",
                        "glosses": [
                            "Grand arbre des régions tropicales, de la famille des fabacées, atteignant 30 mètres de haut et dont les fruits sont récoltés pour être consommés frais ou cuits et pour confectionner des chutneys, des bonbons, des sirops, des glaces, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcf9746c-52f1-415b-9dd6-74103893b734",
                                "sense_id": "657aa17f-371d-37fa-84fe-8c3a648d8003",
                                "text": "Après avoir traversé Sambarala, village situé sur la rivière, nous continuâmes notre trajet sur un terrain sablonneux, couvert d’une végétation vigoureuse, et entre autres arbres, de tamariniers."
                            },
                            {
                                "example_id": "e97e8c01-9422-4957-806e-d8e281249f11",
                                "sense_id": "657aa17f-371d-37fa-84fe-8c3a648d8003",
                                "text": "Hadé officie sous le tamarinier, assise sur un tabouret en bois de néré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17725624-daa8-4f10-bae5-97085f9a34e9",
                        "source_entry_id": "8e068d04-aab3-3823-af32-3a03733ee439",
