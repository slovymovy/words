                "senses": [
                    {
                        "sense_id": "7ac9a4cd-cbb0-3f2b-a050-b8b07f84097d",
                        "entry_id": "2c8799f0-9906-3997-b4c2-6aee9c8ed273",
                        "glosses": [
                            "S’utilise pour désigner une variété de feutre à reflets brillants, soyeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d4caa3-dba6-4d72-992c-744f929338ad",
                                "sense_id": "7ac9a4cd-cbb0-3f2b-a050-b8b07f84097d",
                                "text": "Un feutre taupé, une moquette taupée."
                            },
                            {
                                "example_id": "90e5ebf3-71be-4097-b3e7-8762baf04727",
                                "sense_id": "7ac9a4cd-cbb0-3f2b-a050-b8b07f84097d",
                                "text": "Il portait\nun feutre taupé\nIl parlait\npar onomatopées\nIl buvait\ndes cafés frappés\nAvec des pailles."
                            },
                            {
                                "example_id": "56b9e9cc-5623-424f-82c2-6ea5b2382c1d",
                                "sense_id": "7ac9a4cd-cbb0-3f2b-a050-b8b07f84097d",
                                "text": "C’était une sorte de hippie avant la lettre. Il s’habillait d’ailleurs, dans de la toile à matelas, ce qui, en ce temps-là, faisait sensation, et portait un éternel chapeau de feutre taupé, agrémenté d’une plume."
                            },
                            {
                                "example_id": "81f842f0-cb8c-4b3c-865f-70d6e231d93c",
                                "sense_id": "7ac9a4cd-cbb0-3f2b-a050-b8b07f84097d",
                                "text": "Il a pris sa tête entre ses mains, elle lui a enfoncé le feutre sur les yeux à force de taper dessus, même qu’il était plus taupé son feutre, mais lapiné !"
                            }
                        ]
                    }
                ],
