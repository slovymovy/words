                "senses": [
                    {
                        "sense_id": "9b4045ba-265b-3284-9d6d-e70ca2d7fce3",
                        "entry_id": "105dfc26-4915-3565-9dac-95b79df819b0",
                        "glosses": [
                            "Herrschertitel von Min Saw, der mit dem Königreich von Bagan erstmals ein Großreich auf dem Gebiet des heutigen Myanmar gründete, und unter dessen Herrschaft der Theravada-Buddhismus erstmals als Staatsreligion etabliert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "678a65f9-d39e-475f-a34d-16c623a00f5a",
                                "sense_id": "9b4045ba-265b-3284-9d6d-e70ca2d7fce3",
                                "text": "König Anawrahta war der Schöpfer des ersten burmesischen Königreichs, das vom 11.–13. Jahrhundert seine Hochblüte erlebte – und Bagan war seine Königsstadt mit tausenden von Tempeln und Pagoden."
                            }
                        ],
                        "sense_index_json": "\"1\""
