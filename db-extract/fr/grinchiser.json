                "senses": [
                    {
                        "sense_id": "f9fc03ec-9055-3014-b3b6-0ca430b6df5c",
                        "entry_id": "64864d06-f4ed-3ded-9e17-77612fa95793",
                        "glosses": [
                            "Donner un caractère grincheux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7124ff7-c1cb-4b4d-ba22-d22c91cd4b22",
                                "sense_id": "f9fc03ec-9055-3014-b3b6-0ca430b6df5c",
                                "text": "Bel automne à tous et n’oubliez pas, vous les vieux fourneaux comme moi qui allez vers beaucoup d’hivers, n’oubliez pas qu’en vieillissant, on a tendance à se grinchiser, à devenir plaignoux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d88ba695-939f-38d7-abce-14b04ba80d66",
                        "entry_id": "64864d06-f4ed-3ded-9e17-77612fa95793",
                        "glosses": [
                            "Se montrer grincheux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5775b543-7f7a-4656-9a86-679fc6229677",
                                "sense_id": "d88ba695-939f-38d7-abce-14b04ba80d66",
                                "text": "J’ajouterai bien volontiers que je n’ai pas le nez coloré ni la barbiche blanche. ça ^([sic : Ça]) ne m’empêche pas de grinchiser…"
                            }
                        ]
                    }
