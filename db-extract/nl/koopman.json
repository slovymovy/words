                                        "sense_id": "ec0c6290-6e5b-34da-92b8-740a13a9eac3",
                                        "entry_id": "f4281165-f6cc-3597-8c31-94eb4ff7ae86",
                                        "glosses": [
                                            "Someone who is noted for a stated type of activity or behaviour."
                                        ],
