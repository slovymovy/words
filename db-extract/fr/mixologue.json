                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mixologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23d4b7f0-3847-332b-b968-d934a361afc6",
                                        "entry_id": "59f8e2b7-7411-35ab-b054-694ba2afc9e9",
                                        "glosses": [
                                            "A person who creates cocktails, especially one considered an artist at it; (loosely) any bartender."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d344cd30-8d4d-41ba-97b2-3dc850ad8691",
                                                "sense_id": "23d4b7f0-3847-332b-b968-d934a361afc6",
                                                "text": "By the way, the difference between a bartender and a mixologist can be confusing, but normally a bartender serves the patrons at a sit-down style bar, where a mixologist would usually work at a very busy service-style bar."
                                            },
                                            {
                                                "example_id": "55083f37-f806-44c9-ba2e-71f2680f5a49",
                                                "sense_id": "23d4b7f0-3847-332b-b968-d934a361afc6",
                                                "text": "But now we see a split in the mixed-drink community. On one hand, cool bars and star mixologists are lauded and awarded as never before. On the other, booze brands are rushing to develop pre-mixed beverages for a burgeoning Ready to Drink (RTD) market."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a443fe2-de63-323a-8dce-cca9935bc7a9",
                                        "entry_id": "59f8e2b7-7411-35ab-b054-694ba2afc9e9",
                                        "glosses": [
                                            "A disc jockey."
                                        ],
