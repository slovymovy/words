                ],
                "senses": [
                    {
                        "sense_id": "b72efaa9-6c21-3a34-b4bd-41fe2bbaffad",
                        "entry_id": "619c5ecc-6ca6-318b-b388-54140c43cebb",
                        "glosses": [
                            "een van de goederen die het leven in stand houden, zoals etenswaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d30152-764f-4022-9557-2e058828d040",
                                "sense_id": "b72efaa9-6c21-3a34-b4bd-41fe2bbaffad",
                                "text": "Hij heeft een rijk assortiment aan levensmiddelen."
                            },
                            {
                                "example_id": "92432963-50a7-457f-ad01-c02e1b4dddc7",
                                "sense_id": "b72efaa9-6c21-3a34-b4bd-41fe2bbaffad",
                                "text": "In grote delen van het centrum van Berlijn hadden de huurpanden winkels op de begane grond, dat kon van alles zijn, van levensmiddelen en kleine naaiateliers tot antiquairs, groentemannen en meubelverkopers, groot en klein door elkaar heen zonder enig systeem, behalve in grote winkelstraten zoals de Leipziger Strasse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00a4bc01-0165-4568-b612-b7ee10d83c15",
                        "source_entry_id": "619c5ecc-6ca6-318b-b388-54140c43cebb",
                        "source_sense_id": "b72efaa9-6c21-3a34-b4bd-41fe2bbaffad",
                        "source_sense_description": "een van de goederen die het leven in stand houden, zoals etenswaren",
                        "target_lang_word": "Lebensmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "611cfc84-cedb-36c9-acee-19ca15876bc1",
                                        "entry_id": "28333fdc-0be5-33a8-a6e5-c84eb334bc5b",
                                        "glosses": [
                                            "Ware zum Essen oder zum Trinken, die zum Bedarf des täglichen Lebens gehört"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7badb461-fe65-4ed5-a279-b40e331e3b22",
                                                "sense_id": "611cfc84-cedb-36c9-acee-19ca15876bc1",
                                                "text": "Lebensmittel sind für Säugetiere die Mittel zum Leben an Land oder in der Luft, also Nahrung 5 %, Süßwasser 16 % und Luft 79 %."
                                            },
                                            {
                                                "example_id": "67d84f0e-2804-49f4-aedc-ecb1eec7e435",
                                                "sense_id": "611cfc84-cedb-36c9-acee-19ca15876bc1",
                                                "text": "Lebensmittel von Meerestieren sind hingegen 99 % Salzwasser und 1 % Nahrung."
                                            },
                                            {
                                                "example_id": "a3dfcce4-090f-4218-b4b5-95a43f8cee3b",
                                                "sense_id": "611cfc84-cedb-36c9-acee-19ca15876bc1",
                                                "text": "„Bei uns in Berlin wundere ich mich seit zwanzig Jahren über die Menge der Lebensmittel, die in den Hallen der großen Supermärkte ausliegt.“"
                                            },
                                            {
                                                "example_id": "b3028b50-bc2d-4bff-84ec-4b55c1225ca9",
                                                "sense_id": "611cfc84-cedb-36c9-acee-19ca15876bc1",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            },
                                            {
                                                "example_id": "b8abfcd6-0e9b-4a1d-b8aa-d7af889e77e8",
                                                "sense_id": "611cfc84-cedb-36c9-acee-19ca15876bc1",
                                                "text": "„Weil für die meisten Lebensmittel inzwischen amtlich festgelegte Höchstpreise galten, nahmen die zu diesen Preisen angebotenen Mengen kontinuierlich ab.“"
                                            },
                                            {
                                                "example_id": "5e26a39e-dcb8-4c0c-bd7b-91ea0e36600d",
                                                "sense_id": "611cfc84-cedb-36c9-acee-19ca15876bc1",
                                                "text": "„Gleichzeitig werden Lebensmittel und weitere Güter des täglichen Bedarfs durch den Krieg immer teurer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
