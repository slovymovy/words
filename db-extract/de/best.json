                ],
                "senses": [
                    {
                        "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                        "entry_id": "8c890c2c-01b3-385a-9598-be7abab61cb6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436ff58b-cc84-48dd-b63f-c536bc7ebce7",
                                "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                                "text": "Die Bests fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "550b12e4-b5a4-410b-8ba8-83895c5d35d0",
                                "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                                "text": "Der Best trägt nie die Schals, die die Best ihm strickt."
                            },
                            {
                                "example_id": "b818411c-1c6f-4d27-b4fd-937734fe7c1c",
                                "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Best kommt, geht der Herr Best.“"
                            },
                            {
                                "example_id": "210242ab-e52b-42e7-a962-d9d04e4fed52",
                                "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                                "text": "Best kommt und geht."
                            },
                            {
                                "example_id": "c2ccd3d7-0039-4afb-9b66-e4eb8a977e12",
                                "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                                "text": "Bests kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f787bb68-d030-4173-b6af-0c94eb665bfc",
                                "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                                "text": "Frau Best ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5947745e-8824-47a5-9f61-11525ce97a9d",
                                "sense_id": "b342e291-caca-328d-94fe-1a82aa27d9f6",
                                "text": "Herr Best wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
