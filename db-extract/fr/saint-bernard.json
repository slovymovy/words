                                "target_senses": [
                                    {
                                        "sense_id": "4edfabfd-e97e-3c49-83c1-9aabe3622490",
                                        "entry_id": "57247d66-fbdb-3e1f-92a2-eb7f16182d96",
                                        "glosses": [
                                            "eine Schweizer Hunderasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61181d33-5e1a-43f8-9e4e-bf63a764af42",
                                                "sense_id": "4edfabfd-e97e-3c49-83c1-9aabe3622490",
                                                "text": "In den vordern Räumen des Klostergebäudes kommen die kräftigen, menschenfreundlichen Hunde der großen Bernhardiner Race den Fremden wie ihren Herrn wedelnd und liebkosend entgegen; ihre Kunst die Wege aufzuspüren im wildesten Schneegestöber ist bekannt; mit der Flasche Wein und einem Brot an den Hals gebunden, kommen sie stundenweit, wie wohlthätige Genien, jeden Abend in der Dämmerung oder der sinkenden Nacht den verirrten oder erschöpften Wanderern auf der unwirthbaren Höhe entgegen, und haben so schon vielen Menschen das Leben gerettet."
                                            },
                                            {
                                                "example_id": "df0ef3c9-9501-43d9-bc9a-7efc9e985361",
                                                "sense_id": "4edfabfd-e97e-3c49-83c1-9aabe3622490",
                                                "text": "Der zum Schweizer Nationalhund avancierte Bernhardiner wurde nach seinem Tod 1814 ausgestopft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "160139d2-eb2e-3f83-a13e-c5e8a270aa75",
                                        "entry_id": "57247d66-fbdb-3e1f-92a2-eb7f16182d96",
                                        "glosses": [
                                            "ein christlicher Mönchsordens, die Zisterzienser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a7e5c5-a909-4dca-8193-cd14e3509d59",
                                                "sense_id": "160139d2-eb2e-3f83-a13e-c5e8a270aa75",
                                                "text": "Cistercienser-Orden, ist von einem Ort in Burgund benahmet worden, darein sich auch Bernhardus begeben, darum er der Bernhardiner-Orden genennet wird."
                                            },
                                            {
                                                "example_id": "5f164b23-a30c-41c9-b10e-c3ea285201e9",
                                                "sense_id": "160139d2-eb2e-3f83-a13e-c5e8a270aa75",
                                                "text": "Fast alle Orden, die Benedictiner etwa ausgenommen, waren zum Sprüchwort geworden. Er säuft, sagte man, wie ein Franciskaner, frißt wie ein Bernhardiner, stinkt wie ein Kapuziner, h.... wie ein Carmeliter, ist pfiffig wie ein Jesuit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
