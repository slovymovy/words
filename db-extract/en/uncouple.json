                        "source_entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                        "source_sense_description": "to disconnect or detach",
                        "target_lang_word": "loslösen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loslösen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a014b2a-5648-3a7c-a4fd-f1165be44754",
                                        "entry_id": "c1f40336-e9e9-37cc-9165-60b9b48f0b05",
                                        "glosses": [
                                            "etwas von etwas anderem (ab-)trennen, lösen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a45d3894-3b02-4205-ae65-7f83a2763da8",
                                                "sense_id": "9a014b2a-5648-3a7c-a4fd-f1165be44754",
                                                "text": "Ich löste die Briefmarke vorsichtig von dem Briefumschlag los."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d457ff80-d392-3dc7-86ea-a7951c45e417",
                                        "entry_id": "c1f40336-e9e9-37cc-9165-60b9b48f0b05",
                                        "glosses": [
                                            "sich von etwas trennen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6b4c248-c8ba-4d3d-8c56-a53df0c7424f",
                                                "sense_id": "d457ff80-d392-3dc7-86ea-a7951c45e417",
                                                "text": "„Da müssen wir uns als Kinder von unseren Eltern loslösen oder auch als Eltern müssen wir unsere Kinder loslassen.“"
                                            },
                                            {
                                                "example_id": "e4294484-965e-4d19-9f60-e4e34621d952",
                                                "sense_id": "d457ff80-d392-3dc7-86ea-a7951c45e417",
                                                "text": "„Finden Sie, wir sollten uns von den Westmächten loslösen und einen Sicherheitspakt mit Rußland abschließen?“"
                                            },
                                            {
                                                "example_id": "738b7d49-b716-4bf2-844e-e7e0e55df937",
                                                "sense_id": "d457ff80-d392-3dc7-86ea-a7951c45e417",
                                                "text": "„Denn warum sollte man sich aus positiven Bindungen loslösen?“"
                                            },
                                            {
                                                "example_id": "92feb0e8-f699-4179-a081-7924e160532f",
                                                "sense_id": "d457ff80-d392-3dc7-86ea-a7951c45e417",
                                                "text": "„Die Katalanen sind nicht das einzige Volk in Europa, die sich von ihrem Mutterland loslösen wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
