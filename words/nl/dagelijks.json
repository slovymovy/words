                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt meestal haar <w>dagelijkse</w> kleren naar kantoor in plaats van een pak.",
                            "target_lang_translations": {
                                "en": "She usually wears her <w>everyday</w> clothes to the office instead of a suit.",
                                "ru": "В офис она обычно носит свою <w>повседневную</w> одежду вместо костюма.",
