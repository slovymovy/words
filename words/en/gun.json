    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af1e02b0-7388-36e0-a54c-68261cb4b311",
                    "sense_definition": "A weapon that shoots projectiles, such as a firearm, rifle, or pistol, using stored energy.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter carefully cleaned his <w>gun</w> before heading into the woods.",
                            "target_lang_translations": {
                                "ru": "Охотник тщательно вычистил своё <w>ружьё</w> перед тем, как отправиться в лес."
                            }
                        },
                        {
                            "text": "Police officers are trained to use a <w>gun</w> only as a last resort.",
                            "target_lang_translations": {
                                "ru": "Полицейских обучают использовать <w>оружие</w> только в крайнем случае."
                            }
                        }
                    ],
                    "synonyms": [
                        "gun down"
                    ],
                    "common_phrases": [
                        "loaded gun",
                        "fire a gun",
                        "handgun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оружие, которое стреляет снарядами, такое как огнестрельное оружие, винтовка или пистолет, используя накопленную энергию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оружие",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "пистолет",
                                "target_lang_sense_clarification": "ручное короткоствольное"
                            },
                            {
                                "target_lang_word": "ружьё",
                                "target_lang_sense_clarification": "длинноствольное"
                            },
                            {
                                "target_lang_word": "пушка",
                                "target_lang_sense_clarification": "разговорное или артиллерийское"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091ee0df-0b49-3063-ad6b-d60bda237f20",
                    "sense_definition": "A device or tool that uses a trigger to project or apply a substance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played in the garden with a colorful water <w>gun</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играли в саду с разноцветным водным <w>пистолетом</w>."
                            }
                        },
                        {
                            "text": "He used a grease <w>gun</w> to lubricate the moving parts of the machine.",
                            "target_lang_translations": {
                                "ru": "Он использовал смазочный <w>шприц</w>, чтобы смазать движущиеся части механизма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glue gun",
                        "spray gun",
                        "water gun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство или инструмент со спусковым механизмом для распыления или нанесения какого-либо вещества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пистолет",
                                "target_lang_sense_clarification": "инструмент (водный, клеевой)"
                            },
                            {
                                "target_lang_word": "распылитель",
                                "target_lang_sense_clarification": "для жидкостей"
                            },
                            {
                                "target_lang_word": "шприц",
                                "target_lang_sense_clarification": "для смазки (grease gun)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cb7303c-7c23-33a2-9180-1539c9fa2646",
                    "sense_definition": "A tool shaped like a firearm used for applying items like nails, rivets, or price tags.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a nail <w>gun</w> to finish the wooden frame quickly.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал гвоздезабивной <w>пистолет</w>, чтобы быстро закончить деревянный каркас."
                            }
                        },
                        {
                            "text": "She used a price-label <w>gun</w> to mark all the items in the store.",
                            "target_lang_translations": {
                                "ru": "Она использовала этикеточный <w>пистолет</w>, чтобы промаркировать все товары в магазине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nail gun",
                        "rivet gun",
                        "staple gun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент в форме пистолета, используемый для забивания гвоздей, заклепок или наклеивания ценников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пистолет",
                                "target_lang_sense_clarification": "строительный или этикеточный"
                            },
                            {
                                "target_lang_word": "нейлер",
                                "target_lang_sense_clarification": "гвоздезабивной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29b3f5c3-0a8d-38d6-bd86-4b0bea70d4a6",
                    "sense_definition": "A person who carries or uses a firearm, often referring to their skill or speed in shooting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old movies, he was known as the fastest <w>gun</w> in the West.",
                            "target_lang_translations": {
                                "ru": "В старых фильмах он был известен как самый быстрый <w>стрелок</w> на Диком Западе."
                            }
                        },
                        {
                            "text": "The gang hired a professional <w>gun</w> to protect their territory.",
                            "target_lang_translations": {
                                "ru": "Банда наняла профессионального <w>убийцу</w> для защиты своей территории."
                            }
                        }
                    ],
                    "synonyms": [
                        "gun down"
                    ],
                    "common_phrases": [
                        "fastest gun",
                        "hired gun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который носит или использует огнестрельное оружие, часто в контексте его мастерства или скорости стрельбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелок",
                                "target_lang_sense_clarification": "мастер стрельбы"
                            },
                            {
                                "target_lang_word": "наёмный убийца",
                                "target_lang_sense_clarification": "hired gun"
                            },
                            {
                                "target_lang_word": "боевик",
                                "target_lang_sense_clarification": "вооруженный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "225bf7c5-9ef1-383f-81ac-7baee750c38a",
                    "sense_definition": "A slang term for the biceps muscles.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent all summer at the gym working on his <w>guns</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел все лето в спортзале, работая над своими <w>банками</w>."
                            }
                        },
                        {
                            "text": "The bodybuilder flexed his <w>guns</w> for the camera.",
                            "target_lang_translations": {
                                "ru": "Бодибилдер напряг свои <w>бицепсы</w> перед камерой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "show off guns"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage referring to muscles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение бицепсов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банки",
                                "target_lang_sense_clarification": "сленг для бицепсов"
                            },
                            {
                                "target_lang_word": "бицуха",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53455086-4506-32b6-93af-8e7a74ec78ba",
                    "sense_definition": "To cause an engine to speed up suddenly by pressing the accelerator.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acceleration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>gunned</w> the engine and the car roared down the street.",
                            "target_lang_translations": {
                                "ru": "Он <w>газанул</w>, и машина с ревом помчалась по улице."
                            }
                        },
                        {
                            "text": "Don't <w>gun</w> the motor while the car is still in park.",
                            "target_lang_translations": {
                                "ru": "Не <w>газуй</w>, пока машина стоит на парковке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gun the engine",
                        "gun the motor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко увеличивать обороты двигателя, нажимая на педаль газа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газовать",
                                "target_lang_sense_clarification": "увеличивать обороты"
                            },
                            {
                                "target_lang_word": "газануть",
                                "target_lang_sense_clarification": "резко нажать на газ"
                            },
                            {
                                "target_lang_word": "прибавить газу",
                                "target_lang_sense_clarification": "ускориться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dafe667-80fe-357e-ace0-7225f4e1c078",
                    "sense_definition": "To seek to attack, criticize, or remove someone from a position; usually used with 'for'.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rival manager has been <w>gunning</w> for his job for months.",
                            "target_lang_translations": {
                                "ru": "Конкурирующий менеджер уже несколько месяцев <w>метит</w> на его место."
                            }
                        },
                        {
                            "text": "After the scandal, the press was <w>gunning</w> for the politician.",
                            "target_lang_translations": {
                                "ru": "После скандала пресса начала <w>охоту</w> на политика."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gunning for someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in competitive or hostile contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремиться атаковать, критиковать или сместить кого-либо с должности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охотиться",
                                "target_lang_sense_clarification": "за чьим-то местом"
                            },
                            {
                                "target_lang_word": "подкапываться",
                                "target_lang_sense_clarification": "под кого-либо"
                            },
                            {
                                "target_lang_word": "метить",
                                "target_lang_sense_clarification": "на чью-то должность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5595e48b-6fd8-383b-b54a-fd847f46ea9e",
                    "sense_definition": "To offer vigorous support or encouragement to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are all <w>gunning</w> for you to win the championship tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мы все <w>болеем</w> за твою победу в чемпионате завтра."
                            }
                        },
                        {
                            "text": "The whole town was <w>gunning</w> for the local hero during the race.",
                            "target_lang_translations": {
                                "ru": "Весь город <w>поддерживал</w> местного героя во время гонки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gunning for you"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal expression of support"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать активную поддержку или подбадривать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болеть",
                                "target_lang_sense_clarification": "за кого-либо"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "желать победы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f0f2e48-d6e6-338d-9726-433607800a43",
                    "sense_definition": "A nonstandard, phonetic spelling of the phrase <w>going to</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech_variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm <w>gun</w> go get my coat from the closet before we leave.",
                            "target_lang_translations": {
                                "ru": "Я <w>собираюсь</w> взять пальто из шкафа перед выходом."
                            }
                        },
                        {
                            "text": "He said he was <w>gun</w> try his best on the exam.",
                            "target_lang_translations": {
                                "ru": "Он сказал, что <w>собирается</w> сделать всё возможное на экзамене."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "nonstandard phonetic representation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нестандартное фонетическое написание фразы 'going to'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "намерение (перевод смысла)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "357d9544-7230-3e64-ba91-25b954135f97",
                    "sense_definition": "A Gbe language spoken primarily in parts of Benin and Nigeria.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He studied the linguistic structure of the <w>Gun</w> language during his research trip.",
                            "target_lang_translations": {
                                "ru": "Во время своей исследовательской поездки он изучал лингвистическую структуру языка <w>гун</w>."
                            }
                        },
                        {
                            "text": "Many people in Porto-Novo are native speakers of <w>Gun</w>.",
                            "target_lang_translations": {
                                "ru": "Многие жители Порто-Ново являются носителями языка <w>гун</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Язык группы гбе, на котором говорят преимущественно в Бенине и Нигерии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гун",
                                "target_lang_sense_clarification": "название языка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}