                                "target_senses": [
                                    {
                                        "sense_id": "c008ae78-80f1-30f5-b8e6-dc9a469bc571",
                                        "entry_id": "d3906b80-2eb7-34b2-b7cf-e2ebd8ed2844",
                                        "glosses": [
                                            "Gefühl der Trauer und schmerzhaft empfundener Melancholie, das jemand über seine eigene Unzulänglichkeit empfindet, die er zugleich als Teil der Unzulänglichkeit der Welt und der bestehenden Verhältnisse betrachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0fd82b-817b-4bbf-a4cc-7b2f6c0918d4",
                                                "sense_id": "c008ae78-80f1-30f5-b8e6-dc9a469bc571",
                                                "text": "Das Lebensgefühl eines umfassenden Weltschmerzes wurde in der europäischen Dichtung besonders in Goethes Werther, bei Byron, Chateubriand, Heine und Lenau zum Ausdruck gebracht."
                                            },
                                            {
                                                "example_id": "588b9991-4622-43f4-9c5e-8acf55fb7ee9",
                                                "sense_id": "c008ae78-80f1-30f5-b8e6-dc9a469bc571",
                                                "text": "„Der Weltschmerz ist verwandt mit der Schwermut, auch Melancholie genannt.“"
                                            },
                                            {
                                                "example_id": "66ccec65-b7e5-4c76-b3ea-061702eb3b05",
                                                "sense_id": "c008ae78-80f1-30f5-b8e6-dc9a469bc571",
                                                "text": "„Mir gefällt das, ein köstliches Gefühl von vergänglichem Weltschmerz macht sich während der Dunkelheit breit.“"
                                            },
                                            {
                                                "example_id": "725c8cad-f7bc-4250-9efe-18b47789d2e0",
                                                "sense_id": "c008ae78-80f1-30f5-b8e6-dc9a469bc571",
                                                "text": "„Die Zeit resignierenden Weltschmerzes sei aber vorbei, ebenso wie alle narzisstischen Spielereien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
