            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b9017a6-ab99-3e5e-971a-e5d2da2334ef",
                    "sense_definition": "Een informele, soms licht spottende benaming voor een Nederlander.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nederlander",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het internationale toernooi noemden de buitenlandse supporters ons gekscherend een <w>kaaskop</w>.",
                            "target_lang_translations": {
                                "en": "During the international tournament, the foreign supporters jokingly called us a <w>cheesehead</w>."
                            }
                        },
                        {
                            "text": "Als rasechte <w>kaaskop</w> eet hij natuurlijk elke dag een boterham met kaas.",
                            "target_lang_translations": {
                                "en": "As a true-born <w>Dutchman</w>, he naturally eats a cheese sandwich every day."
                            }
                        }
                    ],
                    "synonyms": [
                        "Nederlander",
                        "Hollander"
                    ],
                    "common_phrases": [
                        "een rasechte kaaskop"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Licht spottend of informeel gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal, sometimes slightly mocking term for a Dutch person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cloggy",
                                "target_lang_sense_clarification": "slang, derogatory term for a Dutch person"
                            },
                            {
                                "target_lang_word": "cheesehead",
                                "target_lang_sense_clarification": "literal translation, informal term for a Dutch person"
                            },
                            {
                                "target_lang_word": "Dutchman",
                                "target_lang_sense_clarification": "neutral equivalent"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "459facb4-f4b2-3960-bf4b-fdebcc5a12de",
                    "sense_definition": "Een dom of onnozel persoon; een idioot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "domoor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let toch eens op de weg, jij stomme <w>kaaskop</w>!",
                            "target_lang_translations": {
                                "en": "Pay attention to the road, you stupid <w>blockhead</w>!"
                            }
                        },
                        {
                            "text": "Hij gedroeg zich als een <w>kaaskop</w> door zijn sleutels in de auto te laten liggen.",
                            "target_lang_translations": {
                                "en": "He acted like a <w>fool</w> by leaving his keys in the car."
                            }
                        }
                    ],
                    "synonyms": [
                        "domoor",
                        "idioot",
                        "oen"
                    ],
                    "common_phrases": [
                        "stomme kaaskop"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Beledigend of informeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A stupid or foolish person; an idiot."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blockhead",
                                "target_lang_sense_clarification": "a stupid person"
                            },
                            {
                                "target_lang_word": "fool",
                                "target_lang_sense_clarification": "a silly or unwise person"
                            },
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "a very stupid person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d632b13-87de-39bc-a6db-ab36e4ace5d8",
                    "sense_definition": "Een houten of kunststof vorm waarin Edammer kaas wordt geperst.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kaasgereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De traditionele kaasmaker legde de wrongel voorzichtig in de houten <w>kaaskop</w>.",
                            "target_lang_translations": {
                                "en": "The traditional cheesemaker carefully placed the curd into the wooden <w>cheese mold</w>."
                            }
                        },
                        {
                            "text": "In het museum stonden verschillende historische <w>kaaskoppen</w> tentoongesteld.",
                            "target_lang_translations": {
                                "en": "Several historical <w>cheese molds</w> were on display in the museum."
                            }
                        }
                    ],
                    "synonyms": [
                        "kaasvorm"
                    ],
                    "target_lang_definitions": {
                        "en": "A wooden or plastic mold in which Edam cheese is pressed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheese mold",
                                "target_lang_sense_clarification": "vessel used to shape cheese"
                            },
                            {
                                "target_lang_word": "cheese press mold",
                                "target_lang_sense_clarification": "mold used in cheese pressing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
