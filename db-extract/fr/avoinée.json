                "senses": [
                    {
                        "sense_id": "af16a9e8-b40f-3e5a-9b69-4db8a98f78b7",
                        "entry_id": "9d7a48c9-8bcd-3730-8aac-4ec5d8c7b788",
                        "glosses": [
                            "Correction, coups ou sévères réprimandes."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3a8c3ddb-b42f-4704-851c-9dfe5e57c1a4",
                                "sense_id": "af16a9e8-b40f-3e5a-9b69-4db8a98f78b7",
                                "text": "J’allais dire y a pas de mal, mais bonté, qu’est-ce que vous m’avez mis comme avoinée… Dites, vous avez été champion de France des légers ?"
                            },
                            {
                                "example_id": "f42e7a27-fc91-4ab9-8936-679df14e178b",
                                "sense_id": "af16a9e8-b40f-3e5a-9b69-4db8a98f78b7",
                                "text": "J’en voulais à Elmo d’échapper à ces avoinées quotidiennes."
                            },
                            {
                                "example_id": "3ddbbc2a-58c9-4b55-84c2-05687618e6fe",
                                "sense_id": "af16a9e8-b40f-3e5a-9b69-4db8a98f78b7",
                                "text": "Ranimé & soigné, il trouva une défaite ; il était tombé sur sa bêche ou un truc comme ça & ne se vanta pas de l’avoinée."
                            }
                        ]
                    }
                ],
