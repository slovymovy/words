                        "translation_id": "a7fdb3de-c1ce-47f3-884e-2f879dbc1713",
                        "source_entry_id": "a86d3548-1489-34ab-baae-4af089405a96",
                        "source_sense_id": "7ee4acdb-56de-3521-a943-d49ef8b4ca52",
