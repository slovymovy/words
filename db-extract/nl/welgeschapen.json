                "senses": [
                    {
                        "sense_id": "51d3797c-5375-3d73-9f50-84f2a360c7f9",
                        "entry_id": "b95535ec-c398-31e2-91a9-deee505b63a7",
                        "glosses": [
                            "van een persoon dat deze goed gezond en mooi gevormd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5faa5f18-073f-4432-9adb-c2316d20f138",
                                "sense_id": "51d3797c-5375-3d73-9f50-84f2a360c7f9",
                                "text": "Volgende week gaat in Brugge een tentoonstelling open met hedendaagse kunst uit Centraal- en Oost-Europa, en dat zullen de Bruggelingen geweten hebben. Want gisteren werd op het Zand een meer dan twintig meter lange ballon opgeblazen en opgelaten die eruitziet als een welgeschapen, poedelnaakte man."
                            },
                            {
                                "example_id": "aab0e7aa-9426-4f74-b517-c3c5ad1da348",
                                "sense_id": "51d3797c-5375-3d73-9f50-84f2a360c7f9",
                                "text": "Als de gemiddelde Belg zijn aandacht moet verdelen tussen de ellende die in onze straten en stations aanspoelt, en de lotgevallen van pakweg een welgeschapen kandidate uit Komen eten, ligt de keuze immers voor de hand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0607528-04c0-4f14-b5cc-e4ae3ac50de0",
                        "source_entry_id": "b95535ec-c398-31e2-91a9-deee505b63a7",
                        "source_sense_id": "51d3797c-5375-3d73-9f50-84f2a360c7f9",
                        "target_lang_word": "well-built",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "well-built",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ccb2bf-085f-369d-a3e7-506eb12bb4eb",
                                        "entry_id": "940f5ac3-ed28-3fa1-abfe-808525c4c611",
                                        "glosses": [
                                            "Constructed in a pleasing or sound manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2d5f2a-6993-4ae9-aab2-8e68e0d6050b",
                                                "sense_id": "f8ccb2bf-085f-369d-a3e7-506eb12bb4eb",
                                                "text": "The basics of a well-built garden"
                                            },
                                            {
                                                "example_id": "21deb0bb-9b7e-479d-a3d2-29d6f929452b",
                                                "sense_id": "f8ccb2bf-085f-369d-a3e7-506eb12bb4eb",
                                                "text": "It ran derailed for about 500 yards before encountering a set of points, which caused it to veer into the path of an Immingham-Ferrybridge coal train, powered by Freightliner 66521 (one of a class of locomotive well-known for being well-built enough to destroy anything that got in its way)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4968d2f-d429-387e-a826-6877c28212c5",
                                        "entry_id": "940f5ac3-ed28-3fa1-abfe-808525c4c611",
                                        "glosses": [
                                            "Muscular and lean, having a body resembling that of an athlete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9147d6-df4a-44d0-ae27-0256f39c40c4",
                                                "sense_id": "a4968d2f-d429-387e-a826-6877c28212c5",
                                                "text": "James Lassiter was forty years old, a well-built, ruggedly handsome man in the prime of his life, in the best of health."
                                            },
                                            {
                                                "example_id": "ec6191dd-cfa6-4902-911f-9c11aee3ae6e",
                                                "sense_id": "a4968d2f-d429-387e-a826-6877c28212c5",
                                                "text": "A well-built teenage boy in a soiled black leather studded vest and black jeans was crouched in the far corner of the cellar, waiting for us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d729f5d-1e71-41ed-887d-ac3a24c40091",
                        "source_entry_id": "b95535ec-c398-31e2-91a9-deee505b63a7",
                        "source_sense_id": "51d3797c-5375-3d73-9f50-84f2a360c7f9",
