                    "sense_id": "3e463a18-cdd0-3d23-bb9b-67b9ea185225",
                    "sense_definition": "czwarty dzień tygodnia, między środą a piątkiem",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>czwartek</w> biuro jest czynne do godziny 18.",
                            "target_lang_translations": {
                                "ru": "В <w>четверг</w> офис работает до 18 часов.",
                                "en": "On <w>Thursday</w>, the office is open until 6 p.m.",
                                "nl": "Op <w>donderdag</w> is het kantoor open tot 18:00 uur.",
                                "de": "Am <w>Donnerstag</w> ist das Büro bis 18 Uhr geöffnet.",
                                "fr": "Le <w>jeudi</w>, le bureau est ouvert jusqu'à 18 heures.",
                                "it": "Il <w>giovedì</w> l'ufficio è aperto fino alle 18:00.",
                                "cs": "Ve <w>čtvrtek</w> má kancelář otevřeno do 18 hodin.",
                                "tr": "Ofis <w>perşembe</w> günü saat 18.00'e kadar açık.",
                                "es": "El <w>jueves</w> la oficina está abierta hasta las 18:00.",
                                "zh": "办公室<w>星期四</w>营业至18点。"
                            }
                        },
                        {
                            "text": "Pamiętaj, by zamknąć konto przed <w>czwartkiem</w>.",
                            "target_lang_translations": {
                                "ru": "Не забудь закрыть счёт до <w>четверга</w>.",
                                "en": "Remember to close the account before <w>Thursday</w>.",
                                "nl": "Vergeet niet om de rekening voor <w>donderdag</w> te sluiten.",
                                "de": "Denk daran, das Konto vor <w>Donnerstag</w> aufzulösen.",
                                "fr": "N'oublie pas de clôturer le compte avant <w>jeudi</w>.",
                                "it": "Ricordati di chiudere il conto prima di <w>giovedì</w>.",
                                "cs": "Nezapomeň zrušit účet před <w>čtvrtkem</w>.",
                                "tr": "Hesabı <w>perşembeden</w> önce kapatmayı unutma.",
                                "es": "Recuerda cerrar la cuenta antes del <w>jueves</w>.",
                                "zh": "记得在<w>星期四</w>之前销户。"
                            }
                        }
                    ],
