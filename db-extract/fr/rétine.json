                        "entry_id": "bcc27a91-0ba4-328f-84b9-010bff9a382b",
                        "glosses": [
                            "Membrane formée par la terminaison du nerf optique dans le fond de l’œil et sur laquelle viennent se former les images des objets provoquant les sensations lumineuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4912c5c-aa7c-4be1-9642-bff033fce840",
                                "sense_id": "8050291a-6e01-3410-bfc9-78331d3b14c6",
                                "text": "Un décollement de la rétine."
                            },
                            {
                                "example_id": "9caa931b-b1f3-4ac5-ac6a-6c4db011f3af",
                                "sense_id": "8050291a-6e01-3410-bfc9-78331d3b14c6",
                                "text": "La rétine n’est pas de même qualité sur toute la surface du fond de l’œil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08306671-c103-4690-b9c3-a69ece6aa686",
