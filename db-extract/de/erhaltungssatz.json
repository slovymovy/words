                "senses": [
                    {
                        "sense_id": "9fcb2870-aa86-3875-9957-fcc230b31d59",
                        "entry_id": "2b694857-6a8c-342f-81c5-d453369decf5",
                        "glosses": [
                            "grundlegender Satz, nach dem sich der Wert einer Größe, auch Erhaltungsgröße genannt, in bestimmten Prozessen nicht ändert"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "dc9243f5-6de4-4532-9b38-99c8bb915d33",
                                "sense_id": "9fcb2870-aa86-3875-9957-fcc230b31d59",
                                "text": "„Der Massenerhaltungssatz (Lomonossow-Lavoisier-Gesetz) ist ein Erhaltungssatz im Bereich der Chemie, der besagt, dass sich bei chemischen Reaktionen die Masse nicht spürbar ändert.“"
                            },
                            {
                                "example_id": "eda02076-a697-4b9f-bffc-bf7e8c029ac2",
                                "sense_id": "9fcb2870-aa86-3875-9957-fcc230b31d59",
                                "text": "„Der Impulserhaltungssatz ist einer der wichtigsten Erhaltungssätze der Physik und besagt, dass der Gesamtimpuls in einem abgeschlossenen System konstant ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
