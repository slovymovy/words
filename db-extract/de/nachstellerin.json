                "senses": [
                    {
                        "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                        "entry_id": "675905c1-baad-3b26-9d5c-e525c3c2eff6",
                        "glosses": [
                            "weibliche Person, die einer anderen Person nachstellt durch Verfolgungen oder Belästigungen (Stalking)"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2619374f-bc83-42bd-b330-2fb0566e9e9b",
                                "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                                "text": "„Sie hielt sich später von Kalandra fern, weil diese sie nach ihrem Unterricht abfing und sie sich nicht mit einer Nachstellerin abgeben wollte.“"
                            },
                            {
                                "example_id": "0773b901-59fd-45ed-8a90-8d9ed5edb901",
                                "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                                "text": "„Gegen einen im November 2007 geschlossenen Prozessvergleich, der der Stalkerin das Aufsuchen der Wohnanschrift des Opfers untersagt, hat die Nachstellerin verstoßen, so dass im Januar 2010 ein Ordnungsgeld von 1500 Euro festgesetzt wurde.“"
                            },
                            {
                                "example_id": "045fd801-fcc8-4ee9-9948-36709e7d9f88",
                                "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                                "text": "„Nicht zuletzt dürfte auch das Klangbild eine Rolle spielen. Insbesondere bei der Substantivierung erscheint die Bezeichnung ‚der Nachsteller‘ / ‚die Nachstellerin‘ gegenüber ‚der Stalker‘ / ‚die Stalkerin‘ als ungewöhnlich.“"
                            },
                            {
                                "example_id": "f610b085-217a-4a50-9079-79e1ede40126",
                                "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                                "text": "„Im Jahr 2018 rief eine [Nachstellerin bei einem Telekommunikationsanbieter] an und bat um die Übermittlung der neuen Handynummer ihres Ex-Mannes, dabei nannte die [Nachstellerin] lediglich den Namen sowie das Geburtsdatum ihres Ex-Mannes und bekam daraufhin die neue Handynummer [illegal] vom Callcenter-Agenten mitgeteilt.“"
                            },
                            {
                                "example_id": "56f5c9e8-9a41-4820-8a28-8e7d93f4bf62",
                                "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                                "text": "„Am Ende wird die wahnsinnig gewordene Nachstellerin (Stalkerin) Alex, die sich mit dem riesigen Messer selbst verwundet, ohne das herabfließende Blut zu merken, vom Ehemann in die überlaufende Badewanne gedrückt, bis die Großaufnahme eine scheinbar Ertrunkene zeigt.“"
                            },
                            {
                                "example_id": "3b017877-302d-4225-b313-641fc8a5c31d",
                                "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                                "text": "„Dann eilte er weg und drehte sich nach ihr um, als ob sie die Nachstellerin wäre.“"
                            },
                            {
                                "example_id": "786ae8ff-9b98-487e-ad9d-08113e187879",
                                "sense_id": "f6cfff91-a027-3e48-aa45-689384b99269",
                                "text": "Durch ihre nervige und nachstellenden Neugierde stellte sie sich als belästigende Nachstellerin mit Sockenschuss heraus, er wünschte sich, er hätte auf sein erstes Bauchgefühl vertraut und sie von Anfang an ignoriert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
