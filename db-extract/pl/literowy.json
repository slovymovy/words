                        "examples": [
                            {
                                "example_id": "a518dfc7-2db3-461d-a875-619815e95f1b",
                                "sense_id": "162ec5ec-58fb-3617-acbe-1b73f3069583",
                                "text": "Różne były ich rodzaje: mówiące, które przedstawiały jakieś przedmioty, literowe, składające się z liter lub monogramu, a wreszcie t. zw. godła nieme, przedstawiające kreski proste i krzywe w różnych kombinacyach.",
                                "translation": "They had various types: speaking, which displayed some items, letter, consisting of letters or a monogram, and finally the so-called mute emblems, displaying straight and curvy lines in various combinations.",
                                "english": "They had various types: speaking, which displayed some items, letter, consisting of letters or a monogram, and finally the so-called mute emblems, displaying straight and curvy lines in various combinations."
                            }
                        ]
