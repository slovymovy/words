                            {
                                "example_id": "e354e2b6-836b-41bb-b1ad-c4d6c7e1b518",
                                "sense_id": "2f0df2a8-19e5-3261-b5ac-8a4718c2dd58",
                                "text": "De 44-jarige Ford is ernstig in opspraak. Dinsdag bekende hij eerst dat hij crack heeft gerookt. Daarna dook ook nog een video op waarin de ziedende en stampvoetende burgervader iemand met de dood bedreigde."
                            },
                            {
                                "example_id": "f2af55d0-80bb-43bc-a9dc-9b1cf0f8d0f2",
                                "sense_id": "2f0df2a8-19e5-3261-b5ac-8a4718c2dd58",
                                "text": "Op de spotprent was een woedende en stampvoetende Williams te zien, met dik aangezette lippen en een grote bos kroeshaar."
                            }
                        ]
                    }
