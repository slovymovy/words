                            {
                                "example_id": "e4b67e32-29a2-42b9-b731-f51d9e41ef70",
                                "sense_id": "df2dfc76-de26-3e5e-9a25-7343afc50f6a",
                                "text": "Berkeley był drugim z „wielkiej trójki” oświeceniowych empiryków brytyjskich"
                            }
