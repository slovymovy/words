                            {
                                "target_word": "multilinguisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eee3f897-e09b-368f-9c40-7c64aab14ca0",
                                        "entry_id": "60d6b66c-2e89-38f8-9e36-bea656276a07",
