        "fr-extract.jsonl": [
            {
                "entry_id": "1f6e52d9-8d34-37c0-bf03-e827e24e2a7f",
                "word": "pardieu",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                        "entry_id": "1f6e52d9-8d34-37c0-bf03-e827e24e2a7f",
                        "glosses": [
                            "Juron familier employé pour renforcer une affirmation ou une négation."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5dfa1931-d726-48b9-b2f8-d0c66614fd5d",
                                "sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                                "text": "Tiens, ce que je fais, je fais que la tête me tourne, pardieu !"
                            },
                            {
                                "example_id": "ceeec1a9-2461-4b4a-b6fb-3d4d5462c421",
                                "sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                                "text": "— Ce qu’il y a de bien singulier, c’est que votre maîtresse ne veut pas le voir.\n— Je le crois pardieu bien, dit Anne-Marie, après un tel cadeau !"
                            },
                            {
                                "example_id": "91c02564-61c0-4a02-9477-155ea1e070c1",
                                "sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                                "text": "Le Duc. – Vous êtes, pardieu ! le seul prêtre honnête homme que j’aie vu de ma vie."
                            },
                            {
                                "example_id": "d97bc2bf-ee45-47ea-8714-491759f3a12e",
                                "sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                                "text": "Est-ce qu’il réciterait des Oremus avec elle ? Il en est pardieu bien capable…"
                            },
                            {
                                "example_id": "198cceae-7fc5-4994-9060-17e8486930cc",
                                "sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                                "text": "Comme l’argent est fort rare en Espagne, l’ingénieux administrateur, homme de ressources s’il en fut, avisa les chaînes historiques de San Juan de los Reyes, et se dit : « Pardieu, voilà mon affaire toute trouvée ! »"
                            },
                            {
                                "example_id": "0ac835ab-1311-436b-970f-b5ccc001f49a",
                                "sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                                "text": "— À cheval ! à cheval ! messieurs. Eh ! pardieu, vous aurez le temps de vous embrasser, si vous êtes si tendres ; mais ne vous faites pas arrêter, et songeons à en finir bien vite avec nos bons amis qui arrivent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca08683b-34ab-4e47-af00-1127b876568d",
                        "source_entry_id": "1f6e52d9-8d34-37c0-bf03-e827e24e2a7f",
                        "source_sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                        "target_lang_word": "bei Gott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4c369e4e-1c2b-4418-8a92-33950da8a60f",
                        "source_entry_id": "1f6e52d9-8d34-37c0-bf03-e827e24e2a7f",
                        "source_sense_id": "0610e456-b839-3087-9249-38ac64234cc1",
                        "target_lang_word": "by God",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by God",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee5f8df8-8fdd-3b67-aea8-9ecf7c2b2c72",
                                        "entry_id": "85bba0e9-468b-3f27-92ee-2aa5820a107f",
                                        "glosses": [
                                            "Used as an oath to emphasize the veracity of an associated statement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b41f30-f117-468b-80fb-97619839e067",
                                                "sense_id": "ee5f8df8-8fdd-3b67-aea8-9ecf7c2b2c72",
                                                "text": "I should not wonder if you had your orders to-morrow; but you cannot sail with this wind, if you are to cruize to the westward; Captain Walsh thinks you will certainly have a cruize to the westward, with the Elephant. By G⁠—, I wish you may."
                                            },
                                            {
                                                "example_id": "89815fa8-4404-4f1c-b5ff-c58682723740",
                                                "sense_id": "ee5f8df8-8fdd-3b67-aea8-9ecf7c2b2c72",
                                                "text": "With a frown, Rye studies my face. He disengages my arm in order to take my hand in both of his and squeeze it tight. \"Why don't you go back and confront him, sweetheart? I'll go with you, by God. I don't like the idea of him bullying you, and he needs to hear that.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c098a42-16a1-30a3-8be9-e170077629ea",
                                        "entry_id": "85bba0e9-468b-3f27-92ee-2aa5820a107f",
                                        "glosses": [
                                            "Used as an intensifier."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f294e70a-6d34-47de-9624-34df222c4693",
                                                "sense_id": "6c098a42-16a1-30a3-8be9-e170077629ea",
                                                "text": "I saw that map and I said right then, 'Someday I'm going to make a map of how it was that day, make a drawing of Pearl Harbor, and I'll make it right.' And I did, by God."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "by God",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c7a55e-e246-35ed-af1d-ca65951a4438",
                                        "entry_id": "b36b4891-0ed2-3e3d-9dea-bb9811a14c79",
                                        "glosses": [
                                            "Genuine, actual."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ab3ae0-df3d-4e7a-a720-11d0577ccb90",
                                                "sense_id": "a7c7a55e-e246-35ed-af1d-ca65951a4438",
                                                "text": "I’ll tell you one thing he was if he wasn’t no soldier. He was a by god White Cap."
                                            },
                                            {
                                                "example_id": "36de58a2-4b3e-4120-807a-79c05c6d47d0",
                                                "sense_id": "a7c7a55e-e246-35ed-af1d-ca65951a4438",
                                                "text": "Fleeson was known as “God’s angry woman,” and she called herself a “by God practicing liberal.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "by God",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c84da31c-ad5b-3e0d-a78d-82063906c81a",
                                        "entry_id": "2afb2ca2-9c02-307b-a189-08ab46f6b6e9",
                                        "glosses": [
                                            "An exclamation of surprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183ef087-6c9b-489e-aacd-020478a262f4",
                                                "sense_id": "c84da31c-ad5b-3e0d-a78d-82063906c81a",
                                                "text": "By God! That chicken has no head!"
                                            },
                                            {
                                                "example_id": "893177f6-ee8f-4222-83ea-79da738e7651",
                                                "sense_id": "c84da31c-ad5b-3e0d-a78d-82063906c81a",
                                                "text": "[…] having made a cross cut, so as to ascertain the depth of the fat upon the chest, exclaimed, in a sort of rapture, “Three inches of white fat on the brisket!—prime—prime, as I am a crowded sinner—and de’il ane o’ the lazy loons in but mysell! Seven—aught—aught tines on the antlers. By G⁠—⁠d, a hart of aught tines, and the first of the season![…]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
