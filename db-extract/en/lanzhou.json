                    {
                        "sense_id": "106ea7c1-297b-3757-a325-2acd7643d5e3",
                        "entry_id": "f88515b9-631e-3857-b3b3-eb8b1683bc54",
                        "glosses": [
                            "A prefecture-level city, the provincial capital of Gansu, in northwestern China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5bfdfa0-2811-4d72-adc9-d555e19f029f",
                                "sense_id": "106ea7c1-297b-3757-a325-2acd7643d5e3",
                                "text": "Construction of this expressway, linking Lanzhou with Wulumuchi, has continued further west as part of the central government’s attempt to equalize the balance of economic development between the prosperous east and the less developed western interior."
                            },
                            {
                                "example_id": "00a82527-2c3e-4db7-b41a-1312a5a27e10",
                                "sense_id": "106ea7c1-297b-3757-a325-2acd7643d5e3",
                                "text": "In northwestern Gansu province, where nine local confirmed cases have been reported in the past week, primary and high schools in the provincial capital of Lanzhou, as well as in one county in Jiuquan city, have suspended offline classes."
                            }
                        ]
                    }
