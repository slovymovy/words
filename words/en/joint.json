                                "target_lang_word": "заведе́ние",
                                "target_lang_sense_clarification": "общее название (кафе, бар)"
                            },
                            {
                                "target_lang_word": "каба́к",
                                "target_lang_sense_clarification": "разговорное, питейное заведение"
