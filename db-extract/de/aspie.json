                ],
                "senses": [
                    {
                        "sense_id": "7ebfc374-2396-356b-a097-73a81a1b5370",
                        "entry_id": "fa0c965b-5294-3d07-acc8-632d312da171",
                        "glosses": [
                            "Person mit Asperger-Syndrom"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7c1c78e9-09f5-43df-85e9-9bcc87884b44",
                                "sense_id": "7ebfc374-2396-356b-a097-73a81a1b5370",
                                "text": "Der Aspie ist eine eigensinnige Person und kann es gar nicht leiden, wenn man ihn stört."
                            },
                            {
                                "example_id": "02b89667-338a-4815-9cb1-69e2a32e938c",
                                "sense_id": "7ebfc374-2396-356b-a097-73a81a1b5370",
                                "text": "„Aspies gelten als schüchtern, leicht exzentrisch, sie reden entweder gar nicht oder sie sind nicht zu stoppen und spicken ihre Sätze mit technischen Termini.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1ff34dc-cc05-44e1-becd-796c2394380d",
                        "source_entry_id": "fa0c965b-5294-3d07-acc8-632d312da171",
                        "source_sense_id": "7ebfc374-2396-356b-a097-73a81a1b5370",
                        "source_sense_description": "umgangssprachlich: Person mit Asperger-Syndrom",
                        "target_lang_word": "aspie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a8e544c-50a4-37fb-90f5-d95fa72e136e",
                                        "entry_id": "3112f65b-15dd-39d6-8852-58dc199f89df",
                                        "glosses": [
                                            "An Aspergerian: a person with Asperger’s syndrome."
                                        ],
                                        "tags": [
                                            "dated",
                                            "endearing",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb2d632b-52d5-439b-86a2-b29ffc5ea841",
                                                "sense_id": "9a8e544c-50a4-37fb-90f5-d95fa72e136e",
                                                "text": "Occasionally, my Aspie traits are recognised by people who don't know that I have the condition."
                                            },
                                            {
                                                "example_id": "afbd3c53-a2a4-48e9-b917-aae597235065",
                                                "sense_id": "9a8e544c-50a4-37fb-90f5-d95fa72e136e",
                                                "text": "For example, I'm a 33 year-old Aspie and Aspergers wasn't even known about when I was at school. They're getting better at spotting Aspie kids now, but adults who are doing really well and achieving lots aren't anywhere in the statistics because no-one has spotted them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
