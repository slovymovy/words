                        "sense_id": "c91adf80-d052-3abf-afe4-16e4a1145d7c",
                        "entry_id": "a77777af-f764-3dac-83dc-4fcea3e301d3",
                        "glosses": [
                            "Troisième andouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d221489-b3df-438c-af58-ff3f7d7ce9fa",
                                "sense_id": "c91adf80-d052-3abf-afe4-16e4a1145d7c",
                                "text": "La chevillure existe sur 80 % des bois, mais elle est parfois très peu développée."
                            },
                            {
                                "example_id": "2301e7f5-fd97-4183-97ea-af6a1f8ac4dc",
                                "sense_id": "c91adf80-d052-3abf-afe4-16e4a1145d7c",
                                "text": "Généralement le premier andouiller est le maître andouiller, ou andouiller de massacre, le second le surandouiller, le troisième la chevillure, et le quatrième la trochure. Au-dessus, c’est l'enfourchure ou empaumure."
                            }
                        ]
                    }
