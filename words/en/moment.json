                                "target_lang_sense_clarification": "точка во времени"
                            },
                            {
                                "target_lang_word": "мгновение",
                                "target_lang_sense_clarification": "конкретный миг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29df8965-9421-3ea7-bfba-e969431fa798",
                    "sense_definition": "The current center of public attention; a period of being highly fashionable or relevant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cultural_relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new singer is really having a <w>moment</w> right now.",
                            "target_lang_translations": {
                                "ru": "У этого нового певца сейчас настоящий <w>звездный час</w>."
                            }
                        },
                        {
                            "text": "She is an icon and she is the <w>moment</w> in the fashion world.",
                            "target_lang_translations": {
                                "ru": "Она икона, и она — само <w>воплощение</w> момента в мире моды."
                            }
