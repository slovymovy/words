                "senses": [
                    {
                        "sense_id": "944cd306-6654-3217-8b3c-1d943d10b450",
                        "entry_id": "5e616bb8-4258-3ccb-86e6-db6ec37d6a58",
                        "glosses": [
                            "Verlangen, das Streben nach etwas"
                        ],
                        "tags": [
                            "archaic",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "aeaca052-956d-45a2-a8ca-2e9dd60ebbfc",
                                "sense_id": "944cd306-6654-3217-8b3c-1d943d10b450",
                                "text": "Der Sekretär des Firmenchefs fragte mich höflich nach meinem Begehr und ließ mich dann eine Stunde warten."
                            },
                            {
                                "example_id": "2cfc95b3-3def-41dd-92cd-a7c2ebfdf7ec",
                                "sense_id": "944cd306-6654-3217-8b3c-1d943d10b450",
                                "text": "„Als man seinem Begehr nicht willfahrte, verließ er trotzig die Versammlung.“"
                            },
                            {
                                "example_id": "b14fcddc-4e90-46c1-97ba-cff9204ab8f3",
                                "sense_id": "944cd306-6654-3217-8b3c-1d943d10b450",
                                "text": "„Ich mußte Begehr und Namen auf sein Papier schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
