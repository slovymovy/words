                                "target_senses": [
                                    {
                                        "sense_id": "19592cdc-cd0d-3a34-b2ac-e852d337dcd9",
                                        "entry_id": "160a6c1e-ae3b-3260-b94e-ac5f670741b6",
                                        "glosses": [
                                            "ботан. южное дерево или кустарник семейства эбеновых со сладкими, слегка вяжущими оранжево-красными плодами, покрытыми восковым налётом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d3a695-551d-41f7-ac5c-f337e4b13e0f",
                                                "sense_id": "19592cdc-cd0d-3a34-b2ac-e852d337dcd9",
                                                "text": "К плодам хурмы, карминным, покрытым сизым потом, нельзя было прикасаться: они от этого портились."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c623574-71cc-3acb-a7a9-07d8c5fd9459",
                                        "entry_id": "160a6c1e-ae3b-3260-b94e-ac5f670741b6",
                                        "glosses": [
                                            "собир. плоды такого дерева (кустарника)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50f64fe-6593-4d1c-b76e-0186d73e25ab",
                                                "sense_id": "2c623574-71cc-3acb-a7a9-07d8c5fd9459",
                                                "text": "Многие предпочитают есть свежую хурму, некоторые любят её в замороженном виде, неплох и сок из хурмы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "434cf8af-45bb-3a70-b65f-2257699abf42",
                                        "entry_id": "160a6c1e-ae3b-3260-b94e-ac5f670741b6",
