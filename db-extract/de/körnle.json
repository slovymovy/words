                "senses": [
                    {
                        "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                        "entry_id": "3a7f0752-ba17-30e9-b191-1be413f533db",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcf52b2-dcba-4c02-a7fa-0ce3a5ec0d04",
                                "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                                "text": "Frau Körnle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "597b26f9-1190-4c30-a015-5b1cc61ec68a",
                                "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                                "text": "Herr Körnle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b9b28dac-160c-48e2-b3cd-a947d3ba2369",
                                "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                                "text": "Die Körnles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "133c12c4-7339-4cea-ba7d-b1d4b72c9fa4",
                                "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                                "text": "Der Körnle trägt nie die Pullover, die die Körnle ihm strickt."
                            },
                            {
                                "example_id": "e74cf1d1-8631-4fe5-b4f6-8fae150b370d",
                                "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Körnle kommt, geht der Herr Körnle.“"
                            },
                            {
                                "example_id": "c318f3c8-e9ed-47e6-8bc0-50faddb51158",
                                "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                                "text": "Körnle kommt und geht."
                            },
                            {
                                "example_id": "da1e3df4-4c28-44fe-8ce3-b3ebd6ee3856",
                                "sense_id": "7f642867-1272-3a4a-b73b-77f3cba087d9",
                                "text": "Körnles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
