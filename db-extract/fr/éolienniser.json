                        "glosses": [
                            "Équiper d’éoliennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f89d49-c366-4d79-b5e2-c2727a4de878",
                                "sense_id": "6c21f822-74dd-378e-92af-30be8549b6b9",
                                "text": "Pour les études scientifiques, je vous ai déjà indiqué que plusieurs études espagnoles (pays fortement \"éoliennisé\") ont montré que l'impact pouvait être important sur certaines espèces protégées!"
                            },
                            {
                                "example_id": "3dff0ab2-9e31-4a0c-ae27-065c2b7aeb4f",
                                "sense_id": "6c21f822-74dd-378e-92af-30be8549b6b9",
                                "text": "Pourquoi « éolienniser » Sainte-Luce-sur-Mer, joyau du tourisme, ou le champ d'un agriculteur de Lacolle?"
                            },
                            {
                                "example_id": "ea3cdbda-c9fb-4c5a-8a7a-4751b8cb6da7",
                                "sense_id": "6c21f822-74dd-378e-92af-30be8549b6b9",
                                "text": "La campagne éoliennisée par le Crédit agricole est rarement cultivée."
                            }
                        ]
                    }
