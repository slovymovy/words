                ],
                "senses": [
                    {
                        "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                        "entry_id": "5b0d1c4b-ae5d-32fe-b060-e866c3efe6f2",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec4ea5d-34ac-4e10-a36b-b7199bca1307",
                                "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                                "text": "Frau Honigmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "27982d98-cee6-4f0f-8743-f6415e045a12",
                                "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                                "text": "Herr Honigmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2502bd93-d077-4e76-837b-5d85843df180",
                                "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                                "text": "Die Honigmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "938ccb68-8d53-4625-9a0d-7efadc4de6a4",
                                "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                                "text": "Der Honigmann trägt nie die Schals, die die Honigmann ihm strickt."
                            },
                            {
                                "example_id": "e82de21b-1d3e-4d48-a9d4-875cad0ccf8c",
                                "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Honigmann kommt, geht der Herr Honigmann.“"
                            },
                            {
                                "example_id": "1ec7bfd3-547a-4225-b83a-14bf0082ef2a",
                                "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                                "text": "Honigmann kommt und geht."
                            },
                            {
                                "example_id": "0adeb7f6-f9c5-4fd5-b2ac-41f1b64e210a",
                                "sense_id": "a1c57096-acf2-3e58-a689-99fa1096c66e",
                                "text": "Honigmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
