                    {
                        "translation_id": "5bfe6bef-e2fd-45b4-8747-b4a33841e274",
                        "source_entry_id": "ec473aa5-33c1-3dc9-a13d-dd24e50311dd",
                        "source_sense_description": "One who battles against an enemy",
                        "target_lang_word": "Kämpfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kämpfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "jemand, der kämpft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa03399b-d716-4905-a565-354de87d3ac1",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "Wer sich nicht ohne Gegenwehr unterkriegen lässt, ist ein Kämpfer."
                                            },
                                            {
                                                "example_id": "2ac29ff5-70a4-42d0-8964-3ac0881c3192",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                                            },
                                            {
                                                "example_id": "45f1ea3c-ec93-4e53-b009-29823f2ddd81",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Doch auch diesmal kann Wladimir seine Kämpfer nicht bezahlen, wieder muss er die nun lästigen Krieger loswerden.“"
                                            },
                                            {
                                                "example_id": "ac588b5f-7d4e-44a5-ab63-7f15dcb47487",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Die Kämpfer attackieren jeden, den sie für einen Verräter halten.“"
                                            },
                                            {
                                                "example_id": "42aadb53-fc78-494f-b9d3-eb426dc174b4",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Unter den Bäumen war ein Ring aufgebaut, in dem die Kämpfer bei gutem Wetter trainierten, und im Tanzsaal gab es einen großen und einen kleinen Sandsack und eine Matte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38bc7dad-4254-3618-b28f-ed629ca43332",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "die obere vorspringende Platte eines Pfeilers oder einer Säule"
                                        ],
                                        "tags": [
                                            "Mittelalter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eec3d97-31e8-4f22-91ab-d3141df0b2bd",
                                                "sense_id": "38bc7dad-4254-3618-b28f-ed629ca43332",
                                                "text": "\"Über einem Kapitell kann der Kämpfer auch als Block ausgebildet sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6b633c08-2883-322b-8fd6-ce9a8d085cfa",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "das waagerechte Trennungsteil eines mehrflügeligen Fensters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58440fde-0bb8-490f-8cfb-4f911d99ae28",
                                                "sense_id": "6b633c08-2883-322b-8fd6-ce9a8d085cfa",
                                                "text": "„Rund um Fenster und Türen gibt es zahlreiche Begriffe, die sicher nicht jedem geläufig sind wie Kämpfer, Gangflügel, Gehflügel oder Stulpfenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cc77561-8e54-419a-a3f6-b19367439ae9",
                        "source_entry_id": "ec473aa5-33c1-3dc9-a13d-dd24e50311dd",
                        "source_sense_description": "One who battles against an enemy",
                        "target_lang_word": "Soldat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soldat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                        "entry_id": "e963d0af-a604-3829-92f5-072779de5f89",
                                        "glosses": [
                                            "Angehöriger des militärischen Personals von Streitkräften eines Landes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef27c59-9d9a-418e-af4b-efb78f6db23e",
                                                "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                                "text": "Der Soldat steht in seiner Uniform vor der Kaserne."
                                            },
                                            {
                                                "example_id": "8887102b-b114-4735-8229-4203b54060f9",
                                                "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                                "text": "„Im Krieg sind alle Väter Soldat.“"
                                            },
                                            {
                                                "example_id": "68b3a873-593f-47d2-8b6e-da9017bccd87",
                                                "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                                "text": "„Daneben wird eine Schlacht gegen die Daker dargestellt, die durch die Überlegenheit der römischen Soldaten siegreich endet.“"
                                            },
                                            {
                                                "example_id": "c0eed763-1a4d-429d-b29c-39d095b1a619",
                                                "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                                "text": "„An diesem Tag flog der Kalifornier Mike Harker, der als Soldat in Deutschland stationiert war, mit einem Hängegleiter von der Zugspitze.“"
                                            },
                                            {
                                                "example_id": "c28260a7-4c00-4bc6-b661-dcd4cb4a8262",
                                                "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                                "text": "„Er sei gern Soldat gewesen, glaubt sie, zumal er den ganzen Krieg über in Deutschland blieb und nicht an die Front musste.“"
                                            },
                                            {
                                                "example_id": "20899e32-ad2c-47e3-a229-28346b970dfe",
                                                "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                                "text": "„Das Gefängnis ist mit Deserteuren überfüllt, um Platz für neue Gefangene zu schaffen, stellt man die Soldaten vor die Wahl, sich für die Front oder fürs Zuchthaus zu entscheiden.“"
                                            },
                                            {
                                                "example_id": "60ea8a27-0797-4cc3-98e1-ef69cc083b16",
                                                "sense_id": "2b7ffafa-8f70-3144-92dc-31f4e1a95479",
                                                "text": "„Dieser Teekasten war mir wohlbekannt; mein Vater hatte ihn von einem Soldaten gekauft, der aus dem Chinafeldzug heimkehrte und der ihn beim Brande des Kaiserpalastes erbeutet haben wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
