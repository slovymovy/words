                "translations": [
                    {
                        "translation_id": "2c303a23-6d92-4d32-87c2-2e157d751cc2",
                        "source_entry_id": "c147a034-efbc-3ff9-ac26-f7272c1a0754",
                        "source_sense_id": "7091d99e-5571-384a-9dd9-9a723d60d36c",
                        "source_sense_description": "is van origine een regeringsvorm waarbij alle macht bij één persoon berust",
                        "target_lang_word": "Monarchie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monarchie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                        "entry_id": "bd9c16f8-0c27-3614-8634-0a19f4221283",
                                        "glosses": [
                                            "Staatsform mit einem durch seine Herkunft berechtigten Herrscher an der Spitze"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34cce5f-87db-4b5b-91e9-0d0a0991df73",
                                                "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                                "text": "Die Monarchie in Großbritannien ist größtenteils repräsentativ."
                                            },
                                            {
                                                "example_id": "93cd5ddc-4f3b-4ea7-b46b-70a73c391ead",
                                                "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                                "text": "„Dass es die Oranjes mit dem Rauchverbot nicht allzu genau nahmen, machte ihm die Monarchie fast schon wieder sympathisch.“"
                                            },
                                            {
                                                "example_id": "92a16ecc-85f6-448e-b7e6-967b49961e8b",
                                                "sense_id": "a5042236-adc8-34b0-8946-8a380f4e0325",
                                                "text": "„Wenn der Kaiser abdankt, glauben sie, ist die Monarchie zu retten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0552659e-cb24-3938-b8a2-8dc947f856c8",
                                        "entry_id": "bd9c16f8-0c27-3614-8634-0a19f4221283",
                                        "glosses": [
                                            "Staat mit einer Monarchie [1] als Staatsform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195b12d1-9ca2-4499-899f-9da319fd3f1f",
                                                "sense_id": "0552659e-cb24-3938-b8a2-8dc947f856c8",
                                                "text": "Die Beneluxstaaten sind allesamt parlamentarische Monarchien."
                                            },
                                            {
                                                "example_id": "3d9a9edc-699f-4147-be74-d0a54f243a27",
                                                "sense_id": "0552659e-cb24-3938-b8a2-8dc947f856c8",
                                                "text": "„Die Monarchie brach zusammen, weil sie unfähig war, sich selbst zu reformieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5577949f-459f-4216-a078-6d6ede7f8b3c",
                        "source_entry_id": "c147a034-efbc-3ff9-ac26-f7272c1a0754",
                        "source_sense_id": "7091d99e-5571-384a-9dd9-9a723d60d36c",
                        "source_sense_description": "is van origine een regeringsvorm waarbij alle macht bij één persoon berust",
                        "target_lang_word": "monarchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb738d75-caf9-3838-a597-97251cecaafc",
                                        "entry_id": "8ddc6feb-1fa0-3ea4-8ed5-740d70eda65e",
                                        "glosses": [
                                            "A government in which sovereignty is embodied within a single, today usually hereditary head of state (whether as a figurehead or as a powerful ruler)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64299203-7db8-4fdb-9293-885924109408",
                                                "sense_id": "fb738d75-caf9-3838-a597-97251cecaafc",
                                                "text": "An absolute monarchy is a monarchy where the monarch is legally the ultimate authority in all temporal matters."
                                            },
                                            {
                                                "example_id": "51c550e9-1a86-4173-aa0d-cd79914f50b5",
                                                "sense_id": "fb738d75-caf9-3838-a597-97251cecaafc",
                                                "text": "A constitutional monarchy is a monarchy in which the monarch's power is legally constrained, ranging from where minor concessions have been made to appease certain factions to where the monarch is a figurehead with all real power in the hands of a legislative body."
                                            },
                                            {
                                                "example_id": "af956d90-6f87-4edd-bb94-589a289488a0",
                                                "sense_id": "fb738d75-caf9-3838-a597-97251cecaafc",
                                                "text": "He that with ſhepheards and a litle ſpoyle,\nDurſt in diſdaine of wrong and tyrannie,\nDefend his freedome gainſt a Monarchie:\nWhat will he doe ſupported by a king?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b6c5d9-d4a7-3ccc-bdb6-d4e3152be93d",
                                        "entry_id": "8ddc6feb-1fa0-3ea4-8ed5-740d70eda65e",
                                        "glosses": [
                                            "The territory ruled over by a monarch; a kingdom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1777486f-f965-423e-b8f0-9b79ae875a5c",
                                                "sense_id": "94b6c5d9-d4a7-3ccc-bdb6-d4e3152be93d",
                                                "text": "What scourge for perjury / Can this dark monarchy afford false Clarence?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1b1bb59-a340-347a-a496-fb494dd409e7",
                                        "entry_id": "8ddc6feb-1fa0-3ea4-8ed5-740d70eda65e",
                                        "glosses": [
                                            "A form of government where sovereignty is embodied by a single ruler in a state and his high aristocracy representing their separate divided lands within the state and their low aristocracy representing their separate divided fiefs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d61afede-0911-3fca-915e-96d8e647f69b",
                                        "entry_id": "8ddc6feb-1fa0-3ea4-8ed5-740d70eda65e",
                                        "glosses": [
                                            "States based on a system of governance headed by a king or a queen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd36dc3c-834e-4484-94f2-2cd51902dee6",
                        "source_entry_id": "c147a034-efbc-3ff9-ac26-f7272c1a0754",
                        "source_sense_id": "7091d99e-5571-384a-9dd9-9a723d60d36c",
                        "source_sense_description": "is van origine een regeringsvorm waarbij alle macht bij één persoon berust",
                        "target_lang_word": "monarchie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarchie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bb5331-8281-3fd5-bab7-60713ca83ed1",
                                        "entry_id": "3626f5cb-6d39-3b5f-ab17-acf4f381fdda",
                                        "glosses": [
                                            "Organisation politique dans laquelle les pouvoirs législatif, exécutif et judiciaire sont concentrés entre les mains ou émanent d’un seul individu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25eaed03-9a02-426d-b3ad-5c6d90fce894",
                                                "sense_id": "f8bb5331-8281-3fd5-bab7-60713ca83ed1",
                                                "text": "Monarchie héréditaire, élective, absolue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                        "entry_id": "3626f5cb-6d39-3b5f-ab17-acf4f381fdda",
                                        "glosses": [
                                            "Système politique dans lequel le pouvoir appartient à un monarque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9f6baa-96bf-427e-a649-d4238c3e0b28",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "A l’origine des monarchies européennes, la féodalité ne donnait au pouvoir royal que deux sortes de fonctions; l’exercice de la puissance militaire, pour la défense de l’État, et l’administration de la justice, pour la protection des droits des sujets."
                                            },
                                            {
                                                "example_id": "934ac218-a531-4786-b28c-a96bfa0af14f",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "Le duché de Salzbourg, avec ses 7000 kilomètres carrés et ses 150000 habitants, est la plus petite des provinces de la monarchie austro-hongroise."
                                            },
                                            {
                                                "example_id": "802e53fd-42d1-4f57-843a-3870485f846b",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "Les Constituants de 1789 et de 1791, même les Législateurs de 1792 croyaient que la monarchie traditionnelle était l'enveloppe nécessaire de la société nouvelle."
                                            },
                                            {
                                                "example_id": "853dabc4-7818-42a7-a574-04f1f9d51f4a",
                                                "sense_id": "6d7558e5-fdd9-35f5-91ea-3c267d2ea69c",
                                                "text": "Son père, […], est surnommé « Camélinat le Rouge » pour ses convictions républicaines. Cet austère paysan a élevé ses enfants dans l’aversion de la monarchie, puis de l’Empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
