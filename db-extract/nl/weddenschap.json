                                        "sense_id": "40c36f29-bcbe-38e9-8a4d-99a275e337d0",
                                        "entry_id": "8449c611-8185-304f-a64b-2ed26aca4e11",
                                        "glosses": [
                                            "Indicating a degree of certainty, or that something can be relied upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f481138-af6f-435b-80bd-3d5a084babba",
                                                "sense_id": "40c36f29-bcbe-38e9-8a4d-99a275e337d0",
                                                "text": "It’s a safe bet that it will rain tomorrow."
                                            },
                                            {
                                                "example_id": "2383be34-026a-41e3-93e2-6e829598d1ae",
                                                "sense_id": "40c36f29-bcbe-38e9-8a4d-99a275e337d0",
                                                "text": "There's a decent bet that we'll be able to reach the top of that hill in an hour."
                                            },
                                            {
                                                "example_id": "e23e8662-2228-4d29-aba3-b505370de2bf",
                                                "sense_id": "40c36f29-bcbe-38e9-8a4d-99a275e337d0",
                                                "text": "It’s an even bet that Jim will come top of the maths test tomorrow."
                                            },
                                            {
                                                "example_id": "ec5e81e2-01f4-4d3c-93f2-3c892242f0e8",
                                                "sense_id": "40c36f29-bcbe-38e9-8a4d-99a275e337d0",
                                                "text": "There's a good bet that Sally will arrive later."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f19d807e-8bcc-3283-81f7-f5c6c7ce97fb",
                                        "entry_id": "97353459-f5ff-3a67-8838-8b76fd0d08d6",
                                        "glosses": [
                                            "To stake or pledge upon the outcome of an event; to wager."
                                        ],
                                        "tags": [
                                            "ditransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc9b24a6-9b84-4170-88ca-4874bfa80a71",
                                                "sense_id": "f19d807e-8bcc-3283-81f7-f5c6c7ce97fb",
                                                "text": "I('ll) bet I can run faster than you."
                                            },
                                            {
                                                "example_id": "b8b052f8-545a-4867-9c70-6e92183aeab0",
                                                "sense_id": "f19d807e-8bcc-3283-81f7-f5c6c7ce97fb",
                                                "text": "I bet you dinner at the Ritz that you can't run faster than me."
                                            },
                                            {
                                                "example_id": "25f9fe11-02a7-4d6b-9f3d-ea91897ae8a1",
                                                "sense_id": "f19d807e-8bcc-3283-81f7-f5c6c7ce97fb",
                                                "text": "I bet(ted) her £5 it wouldn't rain all week."
                                            },
                                            {
                                                "example_id": "0f0a8cbd-a80b-4125-a61c-f93875dff62d",
                                                "sense_id": "f19d807e-8bcc-3283-81f7-f5c6c7ce97fb",
                                                "text": "John a Gaunt loved him well, and betted much money on his head."
                                            },
                                            {
                                                "example_id": "3086d12a-c479-4704-9e49-fddfc7a6fba1",
                                                "sense_id": "f19d807e-8bcc-3283-81f7-f5c6c7ce97fb",
                                                "text": "I'll bet you two to one I'll make him do it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f263d31c-e72c-36ff-9053-7bc8040f12f7",
                                        "entry_id": "97353459-f5ff-3a67-8838-8b76fd0d08d6",
                                        "glosses": [
                                            "To be sure of something; to be able to count on something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccfa1aff-4005-4cf4-893a-90a6cf964ec2",
                                                "sense_id": "f263d31c-e72c-36ff-9053-7bc8040f12f7",
                                                "text": "Fancy going for a drink after work? / You bet I do!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2d84df-11c6-36f1-a66b-9fb7afe3310e",
                                        "entry_id": "97353459-f5ff-3a67-8838-8b76fd0d08d6",
                                        "glosses": [
                                            "To place money into the pot in order to require others do the same, usually only used for the first person to place money in the pot on each round."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f18d0c-2872-3233-8518-cd35c933cafa",
                                        "entry_id": "995c6a90-d87b-31c9-9261-95a37df9ed59",
                                        "glosses": [
                                            "Expression of general agreement or acceptance."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5f341d9-0d91-40c2-a247-4ee49312a354",
                                                "sense_id": "c7f18d0c-2872-3233-8518-cd35c933cafa",
                                                "text": "Let me bust a freestyle then (Alright, bet)"
                                            },
                                            {
                                                "example_id": "e8167084-1f1d-47ee-a0fe-5b95cdb54969",
                                                "sense_id": "c7f18d0c-2872-3233-8518-cd35c933cafa",
                                                "text": "He asked if KRS could come by and meet up with a few of us there on Monday night, as he wanted to show him the church and have me build with him. Aight, bet."
                                            },
                                            {
                                                "example_id": "a3f6339c-2721-4624-8e27-27e6958baff7",
                                                "sense_id": "c7f18d0c-2872-3233-8518-cd35c933cafa",
                                                "text": "Then I rocked the Kansas show and after Jay said, ‘Look, if you want, you can go on tour with us and open and close the shows, but we can’t pay you, but we’ll make sure you get the exposure.’ So I said bet […]"
                                            },
                                            {
                                                "example_id": "eb31816a-562e-4409-96b7-eb8b461c2047",
                                                "sense_id": "c7f18d0c-2872-3233-8518-cd35c933cafa",
                                                "text": "She texted Jimenez and told him it was a nice time, but she wasn’t feeling him and apologized. “Bet,” Jimenez replied, because she kind of pissed him off with that comment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a652f3b8-8fb6-3be0-89ee-71064c5f1728",
                                        "entry_id": "995c6a90-d87b-31c9-9261-95a37df9ed59",
                                        "glosses": [
                                            "Exclamation indicating acceptance of a challenge or an absurd proposal."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf15bd3-f142-408f-8683-851fcf159e5a",
                                                "sense_id": "a652f3b8-8fb6-3be0-89ee-71064c5f1728",
                                                "text": "What you may not have stopped to consider is that Big Clit Energy (here referred to as B.C.E.) has been around since... BCE! Eve? She looked sin in the eye and said, “Bet.”"
                                            },
                                            {
                                                "example_id": "6fbfeb73-4f62-4657-b550-aa7997c9aa52",
                                                "sense_id": "a652f3b8-8fb6-3be0-89ee-71064c5f1728",
                                                "text": "“(Drummer Brenden Accettura) texted me that and was like, ‘Should we name our band The Hot Mess Express?’ and I said, ‘Bet.’ So now that’s our name,” Abbie said, getting words out between laughs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66fb058c-a204-37c2-af0c-5ae00c74ddd7",
                                        "entry_id": "995c6a90-d87b-31c9-9261-95a37df9ed59",
                                        "glosses": [
                                            "Exclamation of joy at good fortune."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93538f3e-f5af-4b8a-8a19-13e9bd3fd5c1",
                                                "sense_id": "66fb058c-a204-37c2-af0c-5ae00c74ddd7",
                                                "text": "I started making jokes about him feeling like tough sh*t after that presentation haha. Everyone at school geeked his head up [inflated his ego]. He probably got two fruit cups from the lunch lady that day and said, “Bet! I’m gonna keep doing this!”"
                                            }
                                        ]
                                    }
                                ]
                            },
