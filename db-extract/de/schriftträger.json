                "senses": [
                    {
                        "sense_id": "c3bccade-fb9c-3b11-a80d-6bf184ee0505",
                        "entry_id": "c3ab91b0-f00d-332f-a592-26f25b091d19",
                        "glosses": [
                            "Material, auf dem geschrieben wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e47be5e-56ce-4456-b1f3-81c6898d41b9",
                                "sense_id": "c3bccade-fb9c-3b11-a80d-6bf184ee0505",
                                "text": "„Der älteste pflanzliche Schriftträger war wohl der Papyrus, das Mark der gleichnamigen Staude, die vornehmlich im Nildelta wächst.“"
                            },
                            {
                                "example_id": "b5a69a62-8647-417e-8b56-09679402966d",
                                "sense_id": "c3bccade-fb9c-3b11-a80d-6bf184ee0505",
                                "text": "„Er nutzte die Möglichkeit, Schriftträger (Tontafeln, Papyri, Pergamente, Briefe, Postkarten) von einem Ort an den anderen zu befördern und für diese Leistung musste der Überbringer der Schrift eben bezahlt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
