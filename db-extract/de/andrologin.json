                "senses": [
                    {
                        "sense_id": "2eb74cdf-65c2-3be1-9670-07cd190927a2",
                        "entry_id": "4f20ab67-7614-3cee-8e7b-c37fc5a2593d",
                        "glosses": [
                            "eine Fachärztin für Andrologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a8ac7eb-ab61-4bee-bceb-287beae2184e",
                                "sense_id": "2eb74cdf-65c2-3be1-9670-07cd190927a2",
                                "text": "„Wenn uns sozusagen der männliche ›Gynäkologe‹ eine gewohnheitsmäßige Selbstverständlichkeit ist, so wird doch den meisten von uns eine weibliche ›Andrologin‹ lächerlich, bedrohlich oder pervers erscheinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3faea450-4644-4e78-8e11-d04a6fce4c8f",
                        "source_entry_id": "4f20ab67-7614-3cee-8e7b-c37fc5a2593d",
                        "source_sense_id": "2eb74cdf-65c2-3be1-9670-07cd190927a2",
                        "source_sense_description": "Medizin: eine Fachärztin für Andrologie",
                        "target_lang_word": "andrologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "andrologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ada4b27-6db6-3153-9932-9f6cff530cd6",
                                        "entry_id": "09b8a388-8151-32f4-9b55-c3dfd8c5806c",
                                        "glosses": [
                                            "A person who studies andrology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4095291f-5937-46a0-90b5-58bd4b6c67d0",
                                                "sense_id": "0ada4b27-6db6-3153-9932-9f6cff530cd6",
                                                "text": "Dr. Schirren: The members of this round table keep on speaking about urologists and gynecologists but you never mention andrologists."
                                            },
                                            {
                                                "example_id": "76a3c1b0-6cd9-4511-bb68-7fd0776b8b26",
                                                "sense_id": "0ada4b27-6db6-3153-9932-9f6cff530cd6",
                                                "text": "It may not be easy to find an andrologist or get an appointment with one. Women can call a gynecologist for routine check-ups, but it is not the same with andrologists."
                                            },
                                            {
                                                "example_id": "59095e06-3f7c-40a6-aafe-f025db34329b",
                                                "sense_id": "0ada4b27-6db6-3153-9932-9f6cff530cd6",
                                                "text": "Male infertility specialists are either andrologists (M.D.s or Ph.D. scientists specializing in male fertility and in assisted reproductive technology) or urologists (doctors who specialize in male and female urinary tract problems but are particularly knowledgeable about penis and testicle \"design\"). Many urologists are also andrologists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
