    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c00ce170-f18a-3638-bace-d4e6b9f4ce33",
                    "sense_definition": "A container used for carrying a meal to school or work.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child packed a healthy sandwich inside his <w>lunchbox</w>.",
                            "target_lang_translations": {
                                "zh": "孩子把一个健康的三明治装进了他的<w>饭盒</w>里。"
                            }
                        },
                        {
                            "text": "She placed her <w>lunchbox</w> on the kitchen counter before leaving for school.",
                            "target_lang_translations": {
                                "zh": "她上学前把<w>饭盒</w>放在厨房操作台上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "basket"
                    ],
                    "common_phrases": [
                        "metal lunchbox",
                        "plastic lunchbox"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于把一餐饭带到学校或工作地点的容器。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "饭盒",
                                "target_lang_sense_clarification": "指可重复使用、用来把饭菜带去学校或上班地点的容器"
                            },
                            {
                                "target_lang_word": "午餐盒",
                                "target_lang_sense_clarification": "较正式地指装午餐的盒子"
                            },
                            {
                                "target_lang_word": "便当盒",
                                "target_lang_sense_clarification": "常指日式或便携式餐盒"
                            }
                        ]
