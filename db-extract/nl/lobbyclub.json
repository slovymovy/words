                "senses": [
                    {
                        "sense_id": "29f73fa1-b0d9-3d4f-b732-2821ef643e5b",
                        "entry_id": "c4d4977f-df75-36ee-b9e5-ff8bd86c85b5",
                        "glosses": [
                            "belangenorganisatie voor grote bedrijven en organisaties die probeert politieke besluitvorming te beïnvloeden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f01d880-6dd6-4c5e-985c-619852519d0c",
                                "sense_id": "29f73fa1-b0d9-3d4f-b732-2821ef643e5b",
                                "text": "Verschillende luchtvaartmaatschappijen en autoverhuurbedrijven geven geen korting meer aan leden van de NRA, de lobbyclub van de wapenproducenten."
                            },
                            {
                                "example_id": "c079976e-3b92-42e0-8346-ca6c5fe92145",
                                "sense_id": "29f73fa1-b0d9-3d4f-b732-2821ef643e5b",
                                "text": "Als het Verenigd Koninkrijk de Europese Unie verlaat, kost dat het land 128 miljard euro (100 miljard Britse ponden) aan productiviteit en nog eens 950.000 mensen hun baan. Dat nieuwe doemscenario zal een lobbyclub namens de Britse industrie, samenwerkend in de Confederation of British Industry (CBI), maandag aanvoeren in een opgevoerde campagne tegen een 'Brexit'."
                            },
                            {
                                "example_id": "3812fa73-1874-47c5-b433-941e07a2bcf5",
                                "sense_id": "29f73fa1-b0d9-3d4f-b732-2821ef643e5b",
                                "text": "Banken die in Londen gevestigd zijn willen volgens Anthony Browne, die aan het hoofd van de lobbyclub staat, de toegang tot de interne Europese markt niet verliezen."
                            },
                            {
                                "example_id": "85338f0b-fcb3-44a8-ad77-21f30d4cd990",
                                "sense_id": "29f73fa1-b0d9-3d4f-b732-2821ef643e5b",
                                "text": "Hans de Boer blijft in ieder geval tot halverwege 2020 voorzitter van werkgeversorganisatie VNO-NCW. Het dagelijks bestuur van de belangrijke lobbyclub voor bedrijven heeft hem bereid gevonden voor een tweede termijn."
                            }
                        ]
                    }
