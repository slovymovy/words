                        "glosses": [
                            "Sas étanche de petite taille pour déplacer les échantillons depuis la zone d'échantillonnage vers la zone d'analyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19469881-fa47-49aa-99cf-94e1075fc1ac",
                                "sense_id": "eff1eb1d-3d40-3531-b753-b8eb2a09b0b1",
                                "text": "La boite à gants abrite une tournette (spin-coating), adaptée au dépôt de molécules ou polymères en solution, et elle est reliée à un évaporateur par un passe-échantillon (diamètre 63 mm)."
                            },
                            {
                                "example_id": "d9526901-bfcd-46b5-bbf0-ba50c8be4ff4",
                                "sense_id": "eff1eb1d-3d40-3531-b753-b8eb2a09b0b1",
                                "text": "De la paillasse, il est possible dans certains cas de communiquer avec au moins l'une des cellules d'étude environnementale par un mini-sas passe-échantillon."
                            }
                        ]
                    }
