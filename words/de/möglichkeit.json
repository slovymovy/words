                    ]
                },
                {
                    "sense_id": "aeeb98af-7a00-38ec-b4ee-21727a510146",
                    "sense_definition": "Die Wahrscheinlichkeit oder denkbare Chance, dass ein bestimmtes Ereignis eintritt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es besteht die <w>Möglichkeit</w>, dass der Zug heute wegen des Schnees Verspätung hat."
