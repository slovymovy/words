                                "target_senses": [
                                    {
                                        "sense_id": "b2ac7bda-e671-3a10-9c30-d15f2c1094ae",
                                        "entry_id": "90153a67-429f-393f-ac1a-afe07572815d",
                                        "glosses": [
                                            "To restore a friendly relationship; to bring back or return to harmony."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d9f047-b5d9-4de6-befc-9c84e5336c12",
                                                "sense_id": "b2ac7bda-e671-3a10-9c30-d15f2c1094ae",
                                                "text": "to reconcile people who have quarrelled"
                                            },
                                            {
                                                "example_id": "25e44f25-908f-4759-bb73-2edf7d4e576b",
                                                "sense_id": "b2ac7bda-e671-3a10-9c30-d15f2c1094ae",
                                                "text": "to wait until others have reconciled"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f574f881-9060-3e04-9486-44b66c2771c2",
                                        "entry_id": "90153a67-429f-393f-ac1a-afe07572815d",
                                        "glosses": [
                                            "To make things compatible or consistent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f70fab-6ae5-4f0c-8cdc-f167889f400b",
                                                "sense_id": "f574f881-9060-3e04-9486-44b66c2771c2",
                                                "text": "to reconcile differences"
                                            },
                                            {
                                                "example_id": "3ebeaf04-4056-480a-811d-eaa09f1fcd08",
                                                "sense_id": "f574f881-9060-3e04-9486-44b66c2771c2",
                                                "text": "Some Figures monstrous and mis-shap'd appear,\n Consider'd singly, or beheld too near,\n Which, but proportion'd to their Light, or Place,\n Due Distance reconciles to Form and Grace"
                                            },
                                            {
                                                "example_id": "11f1d75b-0877-41c0-9629-671fc6a4da45",
                                                "sense_id": "f574f881-9060-3e04-9486-44b66c2771c2",
                                                "text": "The great men among the ancients understood how to reconcile manual labour with affairs of state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb2f260-d630-3f93-95fc-67b33560f4e4",
                                        "entry_id": "90153a67-429f-393f-ac1a-afe07572815d",
                                        "glosses": [
                                            "To make the net difference in credits and debits of a financial account agree with the balance."
                                        ],
