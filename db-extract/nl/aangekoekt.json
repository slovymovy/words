                        "glosses": [
                            "dat iets ergens aan vastgeplakt zit zonder dat dat echt de bedoeling was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a8dc7c1-648c-4bef-a82f-4fd2a84eb827",
                                "sense_id": "41b4fb2e-d654-3217-b82b-493fcb5e1d64",
                                "text": "Het was moeilijk om het aangekoekte vuil te verwijderen."
                            },
                            {
                                "example_id": "3f0dda71-6f15-4ffd-a59b-12f2083b7462",
                                "sense_id": "41b4fb2e-d654-3217-b82b-493fcb5e1d64",
                                "text": "De grote dag werd voorbereid met de inkoop van sponsjes. Sponsjes met, en zonder schuurvlak. Twee flessen bleekwater, een literfles ammoniak en een agressief bijtmiddel voor aangekoekte resten in het algemeen."
                            },
                            {
                                "example_id": "4ff5e12d-b8f2-4133-98b0-7e282d1578f0",
                                "sense_id": "41b4fb2e-d654-3217-b82b-493fcb5e1d64",
                                "text": "Ik marcheer door naar de keuken en inspecteer de schade. Een aangekoekt pannetje havermout. Een paar borden met resten sla en hummus. Vier gebruikte koffiekopjes. 'Je kunt ook koffiedrinken uit een en hetzelfde kopje,' mompel ik'."
                            }
                        ]
                    }
