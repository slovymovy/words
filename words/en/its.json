{
    "word_family": [
        "itself"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "63bef8dc-38ec-32d3-a673-5fcd8a6b3b8a",
                    "sense_definition": "Belonging to or associated with a thing, animal, or idea.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog wagged <w>its</w> tail when I came home.",
                            "target_lang_translations": {
                                "ru": "Собака виляла <w>своим</w> хвостом, когда я пришёл домой.",
                                "zh": "我回家时，那只狗摇了摇<w>它的</w>尾巴。"
                            }
                        },
                        {
                            "text": "Every city has <w>its</w> own unique atmosphere and culture.",
                            "target_lang_translations": {
                                "ru": "У каждого города есть <w>своя</w> собственная уникальная атмосфера и культура.",
                                "zh": "每座城市都有<w>其</w>独特的氛围和文化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "its own",
                        "at its best",
                        "on its way",
                        "in its place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий или относящийся к предмету, животному или понятию",
                        "zh": "属于或与某事物、动物或概念相关联的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "его",
                                "target_lang_sense_clarification": "мужской или средний род обладателя"
                            },
                            {
                                "target_lang_word": "её",
                                "target_lang_sense_clarification": "женский род обладателя"
                            },
                            {
                                "target_lang_word": "свой",
                                "target_lang_sense_clarification": "когда относится к подлежащему"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "它的",
                                "target_lang_sense_clarification": "指代非人称事物的所属关系"
                            },
                            {
                                "target_lang_word": "其",
                                "target_lang_sense_clarification": "书面语中指代前文提到的事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "0ba69c3a-f2c7-3756-89c2-6708bb1101e2",
                    "sense_definition": "The one or ones belonging to a specific thing or animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The robot identified the missing part as <w>its</w>.",
                            "target_lang_translations": {
                                "ru": "Робот опознал недостающую деталь как <w>свою</w>.",
                                "zh": "机器人确认那个丢失的零件是<w>它的</w>。"
                            }
                        },
                        {
                            "text": "History has <w>its</w> secrets, and the future has <w>its</w>.",
                            "target_lang_translations": {
                                "ru": "У истории есть <w>свои</w> секреты, а у будущего — <w>свои</w>.",
                                "zh": "历史有<w>它的</w>秘密，未来也有<w>它的</w>秘密。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, который принадлежит определенному предмету или животному",
                        "zh": "属于特定事物或动物的那个或那些东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свой",
                                "target_lang_sense_clarification": "принадлежащий субъекту"
                            },
                            {
                                "target_lang_word": "его",
                                "target_lang_sense_clarification": "принадлежащий ему"
                            },
                            {
                                "target_lang_word": "её",
                                "target_lang_sense_clarification": "принадлежащий ей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "它的",
                                "target_lang_sense_clarification": "指代所属物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78d15148-4c92-3f44-831d-28c7fd297fd4",
