                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515dcf7c-1027-47bf-9385-cbb758b56ca7",
                                "sense_id": "e774e1e8-7ae6-3c22-9d1b-b324ca91d8f8",
                                "text": "„Die Hallstattkultur ist benannt nach dem bekanntesten Fundort eines Gräberfeldes bei Hallstatt am Hallstätter See (Österreich), das von 8. bis 4. Jahrhundert vor Christus benutzt wurde.“"
                            },
                            {
                                "example_id": "c48a8ed9-2563-491c-a995-7f90850eec2f",
                                "sense_id": "e774e1e8-7ae6-3c22-9d1b-b324ca91d8f8",
                                "text": "„Die Hallstattkultur war über weite Teile Mitteleuropas verbreitet, es gibt aus dieser Zeit jedoch keine schriftlichen Quellen.“"
                            }
                        ],
