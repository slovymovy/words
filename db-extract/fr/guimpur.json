                        "examples": [
                            {
                                "example_id": "e5d1e74f-1169-4d77-8d00-554b8e7a6cac",
                                "sense_id": "fe30dd57-d817-3a35-a6ff-f4a8275b60b0",
                                "text": "— M’en fous ! cria l’ivrogne. Les emmerde ! Tas de salauds ! Pourriture et compagnie ! Vive la France ! De Gaulle au pouvoir ! Allons enfants de la Patrie, qu’un sang guimpur abreuve nos sillons ! ."
                            },
                            {
                                "example_id": "b84e8ca9-47d7-4f53-9400-0018da922699",
                                "sense_id": "fe30dd57-d817-3a35-a6ff-f4a8275b60b0",
                                "text": "Lâche mon, lâche mon\nCaleçon guimpur\nJ’approche de ton sillon"
                            },
                            {
                                "example_id": "d8bf8741-d9a3-4dcc-8e7e-9234c4102c45",
                                "sense_id": "fe30dd57-d817-3a35-a6ff-f4a8275b60b0",
                                "text": "Dites, on n’en a pas plein les narines ? On sent pas se réveiller nos ardeurs juvéniles ? Allez ! Qu’un sang… pur ou guimpur… abreuve nos sillons…"
                            }
                        ]
                    }
