                                                "sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                                                "text": "In Tansania werden über 120 verschiedene Sprachen, vor allem Bantusprachen, gesprochen."
                                            },
                                            {
                                                "example_id": "7cc5f354-dd44-4e62-8f21-261a9f840361",
                                                "sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                                                "text": "Daressalam ist die größte Stadt Tansanias."
                                            },
                                            {
                                                "example_id": "a49bae82-a2c2-4285-ba9d-15333b5ac42f",
                                                "sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                                                "text": "Dodoma ist die Hauptstadt von Tansania."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
