                        "sense_id": "06502b9c-5825-3614-9f0e-bae446727180",
                        "entry_id": "6c42b909-79be-3781-a67c-1991443fbb54",
                        "glosses": [
                            "Plateau rocheux désertique ayant généralement subi une érosion éolienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095acde8-8498-4bca-b2ca-d5f7d90f29c2",
                                "sense_id": "06502b9c-5825-3614-9f0e-bae446727180",
                                "text": "Le Fezzan possède les 3 formes des régions sahariennes : la hamada (désert rocheux) , le serir (désert de cailloux) et l’erg (désert de sable)."
                            },
                            {
                                "example_id": "37637030-6325-455d-9252-8d2b3267a642",
                                "sense_id": "06502b9c-5825-3614-9f0e-bae446727180",
                                "text": "Le 16 février 1881, dans une sorte de hamada sur lequel le vent déferle sans cesse, les guides touareg s'arrêtent brusquement en déclarant qu'ils se sont égarés."
                            }
                        ]
                    }
