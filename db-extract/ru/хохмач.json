                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jokester",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7015c1f0-ad23-3a8d-9e0f-a19b8a784e9f",
                                        "entry_id": "7ae51b87-4b9d-3546-8c55-3573cd14a8fa",
                                        "glosses": [
                                            "A person who tells jokes; a joker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8192a82-afd9-4e4f-8728-93c6be2323cd",
                                                "sense_id": "7015c1f0-ad23-3a8d-9e0f-a19b8a784e9f",
                                                "text": "Our uncle is always being a jokester and cracking jokes about how much he eats and makes messes."
                                            },
                                            {
                                                "example_id": "3fb3c70e-cf5f-4e19-a37d-95938a4bbd34",
                                                "sense_id": "7015c1f0-ad23-3a8d-9e0f-a19b8a784e9f",
                                                "text": "Characters commenting on their own predicament as though they were the armchair jokesters of MST3K is almost never as smart as a film’s creative team thinks it is—something for which Urban Legend serves as Exhibit A."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b733b847-d67b-394a-8d4d-7cc6e6fe2bba",
                                        "entry_id": "7ae51b87-4b9d-3546-8c55-3573cd14a8fa",
                                        "glosses": [
                                            "A person who plays practical jokes; a prankster."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "714dd5fe-8b01-3a23-9495-f807e642c8f4",
                                        "entry_id": "7ae51b87-4b9d-3546-8c55-3573cd14a8fa",
                                        "glosses": [
                                            "Jester, court jester."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
