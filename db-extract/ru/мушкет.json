                    },
                    {
                        "translation_id": "9219c6f2-3a55-446a-b111-768bf8428d50",
                        "source_entry_id": "b0d2ac35-0e5c-3c4b-9948-e04d42ce0d34",
                        "source_sense_id": "c3b85db1-7a2a-36d4-beb3-a040f384aea3",
                        "target_lang_word": "Muskete",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64dfc9b8-9dd5-3ec3-920c-53564ff513ec",
                                        "entry_id": "ec773fea-08c3-38a4-8582-4afa4dd71163",
                                        "glosses": [
                                            "schweres, langes Vorderladergewehr mit glattem (zuglosen) Lauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff69435-087d-45b6-ab57-4780f6d41811",
                                                "sense_id": "64dfc9b8-9dd5-3ec3-920c-53564ff513ec",
                                                "text": "Mit seiner Muskete kann er gut umgehen."
                                            },
                                            {
                                                "example_id": "17c40980-faf5-404f-9820-aef34c897285",
                                                "sense_id": "64dfc9b8-9dd5-3ec3-920c-53564ff513ec",
                                                "text": "Die wichtigste Waffe wurde die Muskete, und er vermehrte die Kontingente der Musketiere auf Kosten der Pikenträger."
                                            },
                                            {
                                                "example_id": "a35cdc63-141d-4b14-baac-e52d6fa8a797",
                                                "sense_id": "64dfc9b8-9dd5-3ec3-920c-53564ff513ec",
                                                "text": "„Da er fürchtete, sein Schiff könne angegriffen werden, befahl Kapitän Mary, die Decks gefechtsklar zu machen, die Musketen zu laden und die Kanonen feuerbereit zu halten.“"
                                            },
                                            {
                                                "example_id": "04ab12b1-7dbe-4ac1-aed2-7b898ed6762a",
                                                "sense_id": "64dfc9b8-9dd5-3ec3-920c-53564ff513ec",
                                                "text": "„Und im selben Augenblick, in dem ich die Stimme erkannte, trat Kapitän Smollett auch schon mit einer Muskete im Anschlag hinter dem Felsen hervor und mit ihm drei Soldaten.“"
                                            },
                                            {
                                                "example_id": "d90ad281-1447-4481-abc2-dd412b44b49c",
                                                "sense_id": "64dfc9b8-9dd5-3ec3-920c-53564ff513ec",
                                                "text": "„Kinkel erscheint mit einer Muskete, Schurz mit Säbel und Kugelbüchse, diese jedoch ohne Munition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
