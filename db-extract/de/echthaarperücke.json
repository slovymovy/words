                        "examples": [
                            {
                                "example_id": "2bee8936-adef-49f1-96b3-211c938f6e47",
                                "sense_id": "8858175a-ef22-351c-ba1a-5aaceab09ba3",
                                "text": "„Ob die Erfindung der Echthaarperücke aus jener Zeit stammt, so wie die Erfindung des amerikanischen Blondheitskults in die vierziger Jahre fällt?“"
                            },
                            {
                                "example_id": "58ceb012-5fad-4bcd-a68b-5181d05d1a52",
                                "sense_id": "8858175a-ef22-351c-ba1a-5aaceab09ba3",
                                "text": "„Nach den Regeln der Ultraorthodoxen müssen verheiratete Frauen in der Öffentlichkeit ihr Haar bedecken, Ibenboim setzt auf eine Echthaarperücke über dem rasierten Kopf.“"
                            }
                        ],
