                "senses": [
                    {
                        "sense_id": "cac30505-79a5-37af-bf45-cf180bc4e9ad",
                        "entry_id": "92fed2f2-1696-3bcb-b180-076263ca646f",
                        "glosses": [
                            "Rebsorte, die aus den Sorten Spätburgunder (französisch Pinot Noir) und Cinsault gezüchtet wurde und vor allem in Südafrika angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc11b59f-c69d-4868-9dd5-7a9ad73cdee7",
                                "sense_id": "cac30505-79a5-37af-bf45-cf180bc4e9ad",
                                "text": "„Pinotage ist früh reifend und sehr zuckerhaltig. Er gedeiht am besten in heißen und trockenen Weinbergslagen. Üblicherweise wird Pinotage sortenrein gekeltert, doch auch Cuvées mit dem spät reifenden Cabernet Sauvignon sind für ihre samtige Struktur und das Aroma von roten Beeren bekannt.“"
                            },
                            {
                                "example_id": "1d47780d-f4b0-43bc-b4ef-dfd9585729db",
                                "sense_id": "cac30505-79a5-37af-bf45-cf180bc4e9ad",
                                "text": "„Aus der südafrikanischen Weinbauregion Western Cape kommt dieser fruchtige Rotwein der Rebsorte Pinotage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c68f430-33c7-3d03-8a5c-9fcfdd97ba4f",
                        "entry_id": "92fed2f2-1696-3bcb-b180-076263ca646f",
                        "glosses": [
                            "Wein, der aus der Rebsorte Pinotage (siehe [1]) hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0a1cbf-38e7-467c-b55b-8652339ad078",
                                "sense_id": "8c68f430-33c7-3d03-8a5c-9fcfdd97ba4f",
                                "text": "„Pinotage – Südafrikanische Traubenzüchtung (Pinot noir x Cinsaut). Manchmal sehr fruchtig und schön entwicklungsfähig, oft aber dicklich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
