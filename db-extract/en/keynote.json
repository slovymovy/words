                    },
                    {
                        "translation_id": "b2153f0d-e017-4c21-8d4a-3a3545fa4db1",
                        "source_entry_id": "b8404a28-8e1a-3805-8147-e1a713fe3e93",
                        "source_sense_description": "main theme",
                        "target_lang_word": "Hauptthema",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauptthema",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cead18a-5e7e-3a6f-b191-42d01e56b2a4",
                                        "entry_id": "2961b3f4-5795-3de8-b3b3-a1aaf502e20b",
                                        "glosses": [
                                            "zentraler gedanklicher Schwerpunkt (zum Beispiel eines Gesprächs)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aa92680-254e-4e85-9e69-70fc248ea519",
                                                "sense_id": "0cead18a-5e7e-3a6f-b191-42d01e56b2a4",
                                                "text": "„Der Ablauf jeder Stunde wird auf ein Hauptthema, das Lernziel der jeweiligen Stunde, abgestimmt.“"
                                            },
                                            {
                                                "example_id": "147ec120-e4b1-4cc3-b3b6-224ad749af34",
                                                "sense_id": "0cead18a-5e7e-3a6f-b191-42d01e56b2a4",
                                                "text": "„Die Homepage zeigt das Hauptthema Ihrer Website, darunter liegen Kategorieseiten, eventuelle Subkategorien und Detailseiten.“"
                                            },
                                            {
                                                "example_id": "807a27db-9557-4ae0-9ad1-5d5247ead195",
                                                "sense_id": "0cead18a-5e7e-3a6f-b191-42d01e56b2a4",
                                                "text": "„Als Hauptthema für das Coaching gab sie an, die Dissertation in den nächsten Monaten abzuschließen, aber noch nicht zu wissen, wie es danach weitergehen solle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b15b1d3-dd0e-35e8-afb5-2854584951f5",
                                        "entry_id": "2961b3f4-5795-3de8-b3b3-a1aaf502e20b",
                                        "glosses": [
                                            "in der Grundtonart stehendes Thema (Hauptteil)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f3d3cb-0ed7-40d9-94b5-8773621884d3",
                                                "sense_id": "1b15b1d3-dd0e-35e8-afb5-2854584951f5",
                                                "text": "„Das markante Hauptthema des Eingangs-Allegros hat Mozart elf Jahre später für seine rasante Ouvertüre der Zauberflöte adaptiert – fast könnte man sagen: gestohlen.“"
                                            },
                                            {
                                                "example_id": "23abd2b5-739e-49d6-a0a5-89f3cdfa9904",
                                                "sense_id": "1b15b1d3-dd0e-35e8-afb5-2854584951f5",
                                                "text": "„Bereits zu Beginn der Sonate, die gewohnter Weise mit dem Hauptthema in der Tonika, in diesem Fall F-Dur, beginnt, spielt Mozart mit der Form. Obwohl es für den Rezipienten zunächst keine musikalischen“"
                                            },
                                            {
                                                "example_id": "f12874d5-5ebd-48dd-afb8-0f34524dfbdb",
                                                "sense_id": "1b15b1d3-dd0e-35e8-afb5-2854584951f5",
                                                "text": "„War sie bei Berlioz zugleich Hauptthema des ersten Satzes und in den Folgesätzen gemäß dem unsteten Charakter der dargestellten Figur höchst unterschiedlich dargestellt, so bleibt das Motto-Thema bei Tschaikowsky stets unverändert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
