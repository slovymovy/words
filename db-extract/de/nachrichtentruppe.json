                "senses": [
                    {
                        "sense_id": "b5630025-44d7-349f-b99b-d080af62dbaa",
                        "entry_id": "ffc8d37e-5054-3b69-b394-bb23f3ccb699",
                        "glosses": [
                            "für die militärische Informationsübermittlung und -verarbeitung zuständige Truppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1e168d-df06-4c08-911c-a4c5460efcae",
                                "sense_id": "b5630025-44d7-349f-b99b-d080af62dbaa",
                                "text": "„General Erich Fellgiebel, Mitverschwörer und Chef der Nachrichtentruppe des Heeres, sieht Hitler Minuten nach der Explosion und meldet in den Bendlerblock: Es ist etwas Furchtbares passiert – der Führer lebt.“"
                            },
                            {
                                "example_id": "6c750705-a214-41e6-8160-b1a003bac49d",
                                "sense_id": "b5630025-44d7-349f-b99b-d080af62dbaa",
                                "text": "„Der spätere Berlin-Kenner hatte in Harvard studiert, danach als Journalist für Magazine gearbeitet und im Krieg bei der Nachrichtentruppe der U.S. Army gedient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
