                    }
                ],
                "senses": [
                    {
                        "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                        "entry_id": "b6fe9b69-bba8-3b31-92e7-1fc9b9c2218a",
                        "glosses": [
                            "тело покойного; прах, труп"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c1bd09-5233-4139-abab-36370c7ad905",
                                "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                                "text": ".. останки покойника бросаются в нарочно сделанную для того яму, и место для нового очищается."
                            },
                            {
                                "example_id": "f2fe7058-a36a-4251-a363-8704a6459994",
                                "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                                "text": "Тело её было разрублено пополам, а несчастные останки повешены на уличном фонаре."
                            },
                            {
                                "example_id": "711890fd-661a-4b3a-b681-4a694cc7ef69",
                                "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                                "text": "Эти останки были вынуты из склепа и поставлены в другой гроб, царски украшенный."
                            }
                        ]
                    },
                    {
                        "sense_id": "34abfecb-8cc5-3483-bc82-4b04e52eeb7a",
                        "entry_id": "b6fe9b69-bba8-3b31-92e7-1fc9b9c2218a",
                        "glosses": [
                            "то, что осталось, сохранилось от чего-либо; остатки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee4fe13-1f7d-41ca-a11c-7beaa8ef8644",
                                "sense_id": "34abfecb-8cc5-3483-bc82-4b04e52eeb7a",
                                "text": "Но запомнились не останки самолёта, а то, как раненый летчик всё время просил пить."
                            },
                            {
                                "example_id": "9a0726f3-8f8e-442a-b70f-11c8114c7901",
                                "sense_id": "34abfecb-8cc5-3483-bc82-4b04e52eeb7a",
                                "text": "Всё это было. А теперь останки парка, руины построек. Всё надо начинать заново."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a1452af-c5f5-4ebd-b6fe-579d00e5d54b",
                        "source_entry_id": "b6fe9b69-bba8-3b31-92e7-1fc9b9c2218a",
                        "target_lang_word": "remains",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remains",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c45a0cb-71e8-3313-9eb6-4b4af540913f",
                                        "entry_id": "1900dc02-3520-38fd-a9b8-a5b3bc93683d",
                                        "glosses": [
                                            "The body or any of its matter that are left after a person (or any organism) dies; a corpse."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53dad681-f60f-4035-99d2-5946efa589ba",
                                                "sense_id": "7c45a0cb-71e8-3313-9eb6-4b4af540913f",
                                                "text": "They buried the remains of their longtime friend in the town cemetery."
                                            },
                                            {
                                                "example_id": "965c3f46-b5e4-4536-b89a-53d0af3ba089",
                                                "sense_id": "7c45a0cb-71e8-3313-9eb6-4b4af540913f",
                                                "text": "The victim's remains were one small piece of bone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e895210-911f-3314-bf41-6bebaeb1d68c",
                                        "entry_id": "1900dc02-3520-38fd-a9b8-a5b3bc93683d",
                                        "glosses": [
                                            "Historical or archaeological relics."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a74387c-5047-3683-a318-4797e7ce24e3",
                                        "entry_id": "1900dc02-3520-38fd-a9b8-a5b3bc93683d",
                                        "glosses": [
                                            "The extant writings of a deceased person."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9068d24f-23b0-4f3a-bb51-b27982bbccea",
                                                "sense_id": "2a74387c-5047-3683-a318-4797e7ce24e3",
                                                "text": "To his great intellectual powers his published remains bear abundant witness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e123a1-255b-3667-bd53-7adc933e68e7",
                                        "entry_id": "1900dc02-3520-38fd-a9b8-a5b3bc93683d",
                                        "glosses": [
                                            "All that is left of the stock of some things; remnants."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "993b3722-1cb5-4829-9f35-180148eba883",
                                                "sense_id": "18e123a1-255b-3667-bd53-7adc933e68e7",
                                                "text": "He couldn't bring himself to eat the remains of the chicken dinner."
                                            },
                                            {
                                                "example_id": "0c0f4b45-2ca4-4add-9a01-3332182ae4fb",
                                                "sense_id": "18e123a1-255b-3667-bd53-7adc933e68e7",
                                                "text": "Everything a living animal could do to destroy and to desecrate bed and walls had been done. […] A canister of flour from the kitchen had been thrown at the looking-glass and lay like trampled snow over the remains of a decent blue suit with the lining ripped out which lay on top of the ruin of a plastic wardrobe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remains",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e77b99df-0d51-37fb-97d0-e95e1a771566",
                                        "entry_id": "49225318-2c8f-32b3-a14e-8a9f83e466a1",
                                        "glosses": [
                                            "plural of remain"
                                        ],
                                        "tags": [
