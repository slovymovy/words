        "fr-extract.jsonl": [
            {
                "entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                "word": "rugosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a82daaf6-e41d-4bdd-be57-614e0e655f74",
                        "entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                        "tags": [
                            "plural"
                        ],
                        "form": "rugosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2a7a006-078f-3740-9889-1a340baed317",
                        "entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                        "glosses": [
                            "État d’une surface raboteuse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                        "entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                        "glosses": [
                            "Petite aspérité que présente cette surface."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4444eefa-a587-4176-aac1-712b0ad99ca9",
                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                "text": "Le front pointu, mal caché par des cheveux plats, rares, et qui tombaient comme des filaments de verre soufflé, couronnait par des rugosités rougeâtres une face grimaude."
                            },
                            {
                                "example_id": "f43d729d-87df-46b4-ab03-edbcc93768bc",
                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                "text": "Autour du foyer, sur trois faces seulement, pour laisser au cuisinier la libre approche de la marmite, des bancs de bois s’équilibraient sur les rugosités du plancher calleux comme la peau d’une monstrueuse orange, à l’aide de tessons de pots ou de fragments de brique."
                            },
                            {
                                "example_id": "72044e12-b44e-4428-b1e5-b9c08e2db97e",
                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                "text": "Le stylet rencontre des rugosités du plancher orbital vers son angle externe."
                            },
                            {
                                "example_id": "cba91465-8aab-4638-b71b-927bf19d31f4",
                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                "text": "La lueur de leurs cigarettes brillait sur les rugosités mordorées du goulot de la bouteille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77e5af6d-e04b-4d05-89f7-f6ce61d2acd0",
                        "source_entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                        "target_lang_word": "roughness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roughness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37dacd54-e63d-3ba4-95d3-53732b2a24b7",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "The property of being rough, coarseness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31aa7178-2c66-4b4e-86a4-f808dfad0bdc",
                                                "sense_id": "37dacd54-e63d-3ba4-95d3-53732b2a24b7",
                                                "text": "The roughness of the road made me wonder if my car would fall apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f632a3-d0c4-3395-9fa3-c41f67b791f1",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "Something that is rough; a rough spot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff92052-290f-4f19-8dc6-9a7e966492c9",
                                                "sense_id": "58f632a3-d0c4-3395-9fa3-c41f67b791f1",
                                                "text": "A variety of suitable methods for surface inspection are available to detect topographical defects induced by surface roughnesses such as scratches, digs, inclusions and spatters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5460a0e3-40f3-3920-a5f6-b82e29012200",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "Roughage; coarse fodder."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3759e737-3172-4c78-b0d6-deba80b6393f",
                                                "sense_id": "5460a0e3-40f3-3920-a5f6-b82e29012200",
                                                "text": "With this latter implement, the corn stalk fodder, shucks, oats, hay and other \"roughness\" may be finely cut up […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd32169-7d36-3a37-8856-9e2f14517d9e",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "Abundance, especially of food."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a3a46af-1f87-3f4a-bc5c-20830ddf6878",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "A measure of how rough something is, such as a surface"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19253243-fbbf-4122-ba09-7c707979dfc3",
                                                "sense_id": "5a3a46af-1f87-3f4a-bc5c-20830ddf6878",
                                                "text": "The surface roughness was low."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "356fdd70-b8de-47af-a953-0e670b3fb468",
                        "source_entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                        "target_lang_word": "harshness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harshness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                        "entry_id": "ebbe658f-30fb-345e-8d26-f3cb8c06bfcc",
                                        "glosses": [
                                            "The quality of being harsh."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c88f5d-ea3c-4336-bc89-80716edac67b",
                                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                                "text": "And yet these harshnesses are tenderness itself when compared with the universal harshness out of which they grow; the harshness of the position towards the temperament, of the means towards the aims, of to-day towards yesterday, of hereafter towards to-day."
                                            },
                                            {
                                                "example_id": "d06d9a76-a1af-47b3-b315-51a21e681c54",
                                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfb23d2b-7190-4165-bdcf-a3b15f19992f",
                        "source_entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                        "target_lang_word": "ruwheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruwheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d052b180-5e9e-3eab-b2e9-e3ee74293397",
                                        "entry_id": "9725714b-8879-38b9-a7c1-efe90119b982",
                                        "glosses": [
                                            "het niet prettig in de omgang zijn van een persoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c57f7594-3900-494f-abbc-7461fb8e59b6",
                                                "sense_id": "d052b180-5e9e-3eab-b2e9-e3ee74293397",
                                                "text": "Optie één is de Europese tot nu toe. Hij wordt gedoseerd ingevoerd binnen bestaande politieke verhoudingen en soepel aangepast aan de hoogte van de dreiging. Hij bestaat gedeeltelijk uit symboliek, uit veiligheidsgebaren die niet veel kosten en geruststellen. Dat lukt alleen wanneer het terrorisme en de dreiging ervan niet blijvend hoog zijn. Is dat wel het geval, dan wordt het op den duur zaak om naar een rijke sponsor te zoeken. Is die er niet, dan treden ruwe tijden aan. Want ruwheid is het kenmerk van de alternatieven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c63f68ce-ad3d-3c26-a4f4-b65940d3482a",
                                        "entry_id": "9725714b-8879-38b9-a7c1-efe90119b982",
                                        "glosses": [
                                            "het niet glad zijn van een voorwerp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac2e5ab7-e7ef-4a1f-b404-2563dbb5353c",
                                                "sense_id": "c63f68ce-ad3d-3c26-a4f4-b65940d3482a",
                                                "text": "Ik vond de ruwheid van de handdoek wel prettig bij het afdrogen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e180874a-6895-43de-9a17-2841fcd9daaa",
                        "source_entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                        "target_lang_word": "oneffenheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oneffenheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e9888f-27f2-3470-bd96-cc1b22c3a59c",
                                        "entry_id": "bf0c56ab-1abd-3ebb-9303-7c66878b0675",
                                        "glosses": [
                                            "een plaats waar het ruw, niet vlak is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc38ad8-dede-4225-b7da-b18153060e06",
                                                "sense_id": "c7e9888f-27f2-3470-bd96-cc1b22c3a59c",
                                                "text": "De schokdemping is flink stug, waardoor je elke oneffenheid in het wegdek voelt. Volvo heeft met de V40 vól ingezet op een lagere bijtelling. Dat ging met name om diesels. Hierdoor is het aantal aangeboden exemplaren groter dan de vraag. Goed nieuws dus voor de occasionkoperBij de Volvo-dealer in Groningen stuiten wij op een zwarte D2 Kinetic die nog maar net is ingereden. De zakenauto (2016, 18.000 km) kost €21.900."
                                            },
                                            {
                                                "example_id": "18b21d6d-54f3-4217-8d55-be210eaedcb4",
                                                "sense_id": "c7e9888f-27f2-3470-bd96-cc1b22c3a59c",
                                                "text": "Eerst lag er vrijwel alleen grind, maar nu is er zand toegevoegd en een pletwals strijkt wat oneffenheden weg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20011b8-9fdc-39d6-94bc-8c0520e0e7d1",
                                        "entry_id": "bf0c56ab-1abd-3ebb-9303-7c66878b0675",
                                        "glosses": [
                                            "een kleine fout"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7aa26b-f1e2-4604-8156-f5a02fb2ffb0",
                                                "sense_id": "a20011b8-9fdc-39d6-94bc-8c0520e0e7d1",
                                                "text": "Toch zijn er vanuit het origineel ook enkele minpuntjes bij in geslopen. Zo blijven enkele technische oneffenheden aanwezig zoals gebieden die in het zicht inladen en muziek of tekst die ineens stopt. Bovendien zie je ondanks de hogere resolutie en toevoeging van HDR wel dat het om een wat oudere game gaat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
