                "senses": [
                    {
                        "sense_id": "de571188-b351-3141-b53a-77ce2969abe0",
                        "entry_id": "11cafe77-97de-3f22-88c6-4af760b09590",
                        "glosses": [
                            "To grow or progress too quickly, resulting in the crash of (something)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "267c03ea-2f4e-4120-a4db-c1daa89b83b8",
                                "sense_id": "de571188-b351-3141-b53a-77ce2969abe0",
                                "text": "Its various resources are so vast that there is no possibility of overbooming the country. There is now a limitless demand for people of at least average intelligence and industry and with some money with which to get a fair start."
                            },
                            {
                                "example_id": "4670f864-2731-46fa-b923-85bf48473287",
                                "sense_id": "de571188-b351-3141-b53a-77ce2969abe0",
                                "text": "There is always a possibility that too much competition will result in overbooming the market, and result in a break, which will set things down for a time."
                            },
                            {
                                "example_id": "fc9475a0-96a9-4254-9998-e8b1fc118dbd",
                                "sense_id": "de571188-b351-3141-b53a-77ce2969abe0",
                                "text": "Are we in danger of overbooming the boom? There are good reasons to believe that we are making good progress toward depression-proofing the economy."
                            }
                        ]
                    }
                ],
