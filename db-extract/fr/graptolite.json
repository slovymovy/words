                                        "entry_id": "737aaa45-5d04-3062-be84-ac9c9a157262",
                                        "glosses": [
                                            "Any of a group of extinct aquatic colonial invertebrates, of the class Graptolithina, from the Cambrian and Carboniferous periods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14b10105-8f3c-4841-a775-c57be1df2992",
                                                "sense_id": "2b8c6876-e937-3cd8-9f92-e1775b4d71e9",
                                                "text": "The samples were black shale, and on the shales were some ancient fossils called graptolites."
                                            }
                                        ]
