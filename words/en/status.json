{
    "word_family": [
        "state",
        "station",
        "statute",
        "stature"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aaf8152a-0cb2-386d-9e2c-3e46b02cc944",
                    "sense_definition": "The current situation or state of affairs at a particular time, especially regarding progress.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to check the <w>status</w> of the project before the meeting.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проверить <w>статус</w> проекта перед собранием.",
                                "zh": "开会前我们需要检查一下项目的<w>状态</w>。"
                            }
                        },
                        {
                            "text": "The flight <w>status</w> on the screen changed from on time to delayed.",
                            "target_lang_translations": {
                                "ru": "<w>Статус</w> рейса на табло изменился с «по расписанию» на «задержан».",
                                "zh": "屏幕上的航班<w>状态</w>从准点变为了延误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "state",
                        "condition",
                        "situation",
                        "standing",
                        "stage"
                    ],
                    "common_phrases": [
                        "current status",
                        "status report",
                        "check the status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Текущая ситуация или состояние дел в определенный момент времени, особенно касающееся прогресса.",
                        "zh": "指某事在特定时间的情况或进展程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статус",
                                "target_lang_sense_clarification": "текущее состояние проекта или процесса"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "положение дел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "状态",
                                "target_lang_sense_clarification": "事物所处的状况或进展"
                            },
                            {
                                "target_lang_word": "情况",
                                "target_lang_sense_clarification": "事物发展的态势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "befb06a6-6ee9-3eaf-8610-c4c33ce5c705",
                    "sense_definition": "A person’s professional, social, or other position relative to others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "rank_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please indicate your marital <w>status</w> by checking the appropriate box.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, укажите свое семейное <w>положение</w>, отметив соответствующий пункт.",
                                "zh": "他在公司里的<w>地位</w>比我高。"
                            }
                        },
                        {
                            "text": "Her economic <w>status</w> improved significantly after she got the promotion.",
                            "target_lang_translations": {
                                "ru": "Ее экономическое <w>положение</w> значительно улучшилось после повышения.",
                                "zh": "她升职后，经济<w>地位</w>有了显著提高。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rank",
                        "standing",
                        "position",
                        "grade"
                    ],
                    "common_phrases": [
                        "marital status",
                        "social status",
                        "employment status",
                        "economic status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональное, социальное или иное положение человека по отношению к другим.",
                        "zh": "指一个人在社会、职业或其他方面相对于他人的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "место в обществе, семейное положение"
                            },
                            {
                                "target_lang_word": "статус",
                                "target_lang_sense_clarification": "официальный или общественный ранг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身份",
                                "target_lang_sense_clarification": "个人的社会属性或资格"
                            },
                            {
                                "target_lang_word": "地位",
                                "target_lang_sense_clarification": "在社会或组织中的等级位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b778d263-4f7e-3181-931b-dbe1c2a59608",
                    "sense_definition": "A message or update posted on a social media platform to share one's current thoughts or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I just posted a new <w>status</w> about my vacation photos.",
                            "target_lang_translations": {
                                "ru": "Я только что опубликовал новый <w>статус</w> о своих фотографиях с отпуска.",
                                "zh": "我刚发了一条关于度假照片的<w>动态</w>。"
                            }
                        },
                        {
                            "text": "He rarely updates his <w>status</w> on social networking sites.",
                            "target_lang_translations": {
                                "ru": "Он редко обновляет свой <w>статус</w> в социальных сетях.",
                                "zh": "他很少在社交网站上更新自己的<w>动态</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "update",
                        "post"
                    ],
                    "common_phrases": [
                        "status update",
                        "update status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщение или обновление на платформе социальной сети, отражающее текущие мысли или действия.",
                        "zh": "在社交媒体平台上发布的消息或更新，用于分享当前的想法或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статус",
                                "target_lang_sense_clarification": "сообщение в соцсети"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动态",
                                "target_lang_sense_clarification": "社交媒体上的个人更新"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34745c92-37c2-38d3-b82a-43c06afb097f",
                    "sense_definition": "High rank, importance, or prestige in the eyes of others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rank_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Driving a luxury car is often seen as a <w>status</w> symbol in this neighborhood.",
                            "target_lang_translations": {
                                "ru": "Вождение роскошного автомобиля часто рассматривается как символ <w>статуса</w> в этом районе.",
                                "zh": "在这个社区，开豪车常被视为一种<w>地位</w>象征。"
                            }
                        },
                        {
                            "text": "He was very concerned about losing <w>status</w> among his peers.",
                            "target_lang_translations": {
                                "ru": "Он был очень обеспокоен потерей <w>статуса</w> среди сверстников.",
                                "zh": "他非常担心在同龄人中失去<w>地位</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prestige",
                        "prominence",
                        "eminence",
                        "cachet"
                    ],
                    "common_phrases": [
                        "status symbol",
                        "lose status",
                        "gain status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий ранг, важность или престиж в глазах окружающих.",
                        "zh": "在他人眼中所拥有的高等级、重要性或声望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статус",
                                "target_lang_sense_clarification": "престиж, вес в обществе"
                            },
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "авторитет и влияние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地位",
                                "target_lang_sense_clarification": "社会声望或等级"
                            },
                            {
                                "target_lang_word": "身份",
                                "target_lang_sense_clarification": "象征性的社会高度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "550643c2-6522-34dd-a689-ff341fa94a08",
                    "sense_definition": "The official legal condition or classification of a person or entity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rank_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained the legal <w>status</w> of the contract to the clients.",
                            "target_lang_translations": {
                                "ru": "Юрист объяснил клиентам правовой <w>статус</w> договора.",
                                "zh": "律师向客户解释了合同的法律<w>地位</w>。"
                            }
                        },
                        {
                            "text": "They finally received refugee <w>status</w> after a long application process.",
                            "target_lang_translations": {
                                "ru": "Они наконец получили <w>статус</w> беженцев после долгого процесса подачи заявления.",
                                "zh": "经过漫长的申请过程，他们最终获得了难民<w>身份</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "standing",
                        "classification"
                    ],
                    "common_phrases": [
                        "legal status",
                        "immigration status",
                        "refugee status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное правовое состояние или классификация лица или организации.",
                        "zh": "个人或实体的官方法律条件或分类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статус",
                                "target_lang_sense_clarification": "правовое положение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身份",
                                "target_lang_sense_clarification": "法律上的资格或类别"
                            },
                            {
                                "target_lang_word": "地位",
                                "target_lang_sense_clarification": "法律上的认可状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96ad3aa8-47eb-34c8-964f-d2773257a6b4",
                    "sense_definition": "A continuous state of a medical condition, such as a seizure or asthma attack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "state_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient went into <w>status</w> and required immediate emergency intervention.",
                            "target_lang_translations": {
                                "ru": "У пациента развился <w>статус</w>, и потребовалось немедленное экстренное вмешательство.",
                                "zh": "病人进入了<w>持续状态</w>，需要立即进行紧急干预。"
                            }
                        },
                        {
                            "text": "Doctors worked quickly to treat the <w>status</w> epilepticus.",
                            "target_lang_translations": {
                                "ru": "Врачи быстро начали лечить эпилептический <w>статус</w>.",
                                "zh": "医生们迅速采取行动治疗癫痫<w>持续状态</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительное непрерывное состояние медицинского расстройства, например, приступа.",
                        "zh": "医学上指某种病症的持续发作状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статус",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "持续状态",
                                "target_lang_sense_clarification": "医学术语，指病症连续发作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}