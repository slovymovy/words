{
    "word_family": [
        "hof",
        "leverancier",
        "leveren",
        "levering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b4bdf4a-55b8-37df-9c76-f69c2073010a",
                    "sense_definition": "Een persoon of bedrijf dat goederen of diensten levert aan het koninklijk hof.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leverancier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze bakkerij is al sinds de negentiende eeuw een officiële <w>hofleverancier</w>.",
                            "target_lang_translations": {
                                "en": "This bakery has been an official <w>purveyor to the royal household</w> since the nineteenth century."
                            }
                        },
                        {
                            "text": "Als <w>hofleverancier</w> mag het bedrijf het koninklijk wapen voeren.",
                            "target_lang_translations": {
                                "en": "As a <w>royal warrant holder</w>, the company is allowed to display the royal coat of arms."
                            }
                        }
                    ],
                    "common_phrases": [
                        "officiële hofleverancier",
                        "benoemd tot hofleverancier"
                    ],
                    "target_lang_definitions": {
                        "en": "A person or company that supplies goods or services to the royal court."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purveyor to the royal household",
                                "target_lang_sense_clarification": "official supplier to royalty"
                            },
                            {
                                "target_lang_word": "royal warrant holder",
                                "target_lang_sense_clarification": "business holding a royal warrant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc29cfd8-618c-3321-97bc-c006b6b66831",
                    "sense_definition": "Een eretitel die door de koning of koningin aan een gerespecteerd bedrijf wordt toegekend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "titel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het predicaat <w>Hofleverancier</w> is een van de oudste koninklijke onderscheidingen voor bedrijven.",
                            "target_lang_translations": {
                                "en": "The designation <w>Purveyor to the Royal Court</w> is one of the oldest royal awards for businesses."
                            }
                        },
                        {
                            "text": "Om de titel <w>hofleverancier</w> te krijgen, moet een onderneming minstens honderd jaar bestaan.",
                            "target_lang_translations": {
                                "en": "To receive the title of <w>royal warrant holder</w>, a company must have existed for at least one hundred years."
                            }
                        }
                    ],
                    "common_phrases": [
                        "predicaat hofleverancier"
                    ],
                    "target_lang_definitions": {
                        "en": "An honorary title awarded by the king or queen to a respected company."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Royal Warrant",
                                "target_lang_sense_clarification": "the title or designation itself"
                            },
                            {
                                "target_lang_word": "Purveyor to the Royal Court",
                                "target_lang_sense_clarification": "honorary title for a business"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34bc828e-15d1-3093-8405-9c33f0ab7d64",
                    "sense_definition": "De belangrijkste of grootste leverancier of bron van iets (vaak figuurlijk gebruikt).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bron",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die voetbalclub staat bekend als de <w>hofleverancier</w> van het nationale elftal.",
                            "target_lang_translations": {
                                "en": "That football club is known as the <w>main supplier</w> of players to the national team."
                            }
                        },
                        {
                            "text": "Volgens het rapport is ons land de <w>hofleverancier</w> van nieuwe talenten in deze sector.",
                            "target_lang_translations": {
                                "en": "According to the report, our country is the <w>primary source</w> of new talent in this sector."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoofdleverancier"
                    ],
                    "common_phrases": [
                        "hofleverancier van het nationale"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Figurative usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The main or largest supplier or source of something (often used figuratively)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "main supplier",
                                "target_lang_sense_clarification": "primary source or provider"
                            },
                            {
                                "target_lang_word": "chief supplier",
                                "target_lang_sense_clarification": "major contributor or source"
                            },
                            {
                                "target_lang_word": "primary source",
                                "target_lang_sense_clarification": "main origin of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}