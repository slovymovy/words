                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The condition of grief caused by losing someone or something, especially someone who has died."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb3e35a8-06cc-48ee-a567-81157c5308fd",
                                                "sense_id": "351b781c-ca22-38b0-b482-d66f64937f9e",
                                                "text": "Her daughter's sense of loss eventually led to depression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1dedf55-63f9-305f-ad4b-41f036c9b7ff",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
