                "translations": [
                    {
                        "translation_id": "e18ec22f-d46e-4f3a-8110-8634df2035cc",
                        "source_entry_id": "3d304970-d5ce-3148-9eab-d4e6de6384dd",
                        "source_sense_id": "be8e56d8-7e1e-363c-9e5a-fc6ddc343671",
                        "source_sense_description": "unreliable or impractical",
                        "target_lang_word": "planlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                        "entry_id": "ba507b28-b750-3f1f-8c0a-fc208857a6c3",
                                        "glosses": [
                                            "ziellos, aufs Geratewohl, unüberlegt, ohne Struktur, ohne System, ohne Plan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28641c47-b00e-44bd-8f58-16003af584e0",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Sein planloses Herangehen an dieses Projekt ließ es dann auch scheitern."
                                            },
                                            {
                                                "example_id": "906c5bbe-44d9-4213-97c5-efae5dcfb82d",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "„Wie kann man nur so planlos sein, sich so überhaupt keine Gedanken machen? Du bist mir ein Rätsel!“"
                                            },
                                            {
                                                "example_id": "ca43e1cd-330a-4a06-861d-928be380a77d",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Über eine Milliarde US-Dollar sind nach Angaben des neuen Finanzministers Hoshiar Zebari seit Juni an schiitische Milizen geflossen. Das Geld sei planlos verteilt worden, die Vorgängerregierung von Nuri Al-Maliki habe darüber nicht Buch geführt."
                                            },
                                            {
                                                "example_id": "105dd2b7-05fd-4c69-a72a-05b8201c663f",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Von dem Tor erholte sich Kamerun lange nicht. Noch planloser wurde der Ball nach vorne gedroschen und in Trauben aus Abwehrspielern hineingedribbelt."
                                            },
                                            {
                                                "example_id": "45039e7e-ec2f-4007-b1af-b8a9e19f9195",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Marschbefehle erreichen die Truppe, sie muss Stellungen ausheben, die sie gleich wieder verlässt, um weiter – planlos – durch menschenleere und doch unter Artilleriebeschuss liegende Wasserlandschaften zu ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3afd8ae2-276d-4026-9ac0-660200d40438",
                        "source_entry_id": "3d304970-d5ce-3148-9eab-d4e6de6384dd",
                        "source_sense_id": "be8e56d8-7e1e-363c-9e5a-fc6ddc343671",
                        "source_sense_description": "unreliable or impractical",
                        "target_lang_word": "verpeilt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verpeilt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                        "entry_id": "2a5873bb-a53e-3e30-a159-5f400d1f2ab3",
                                        "glosses": [
                                            "auf eine schräge Art merkwürdig und unpassend, unangepasst"
                                        ],
                                        "tags": [
                                            "über eine Person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c193b559-ef7f-47f2-9ddd-47df1a340fc3",
                                                "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                                "text": "„Eine temporäre Personalrochade in der Firma gibt ihm die Chance, seinem Schwarm, dem ebenso hübschen wie verpeilten Simon, näher zu kommen.“"
                                            },
                                            {
                                                "example_id": "f7cdb7d0-2a36-479c-ae60-06c958dad993",
                                                "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                                "text": "„So richtig leid kann einem ja auch sein gesunder Bruder tun, der jetzt irgendwo im schönen Australien bei zwei verpeilten Eltern mit Herzfehler und Geistesstörung aber ohne jeden moralischen Kompass aufwachsen muss.“"
                                            },
                                            {
                                                "example_id": "e4512aaa-685a-4cc1-b7d9-80df8d36fdb1",
                                                "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                                "text": "„‚[…] Ich bin halt doch ein blondes, manchmal verpeiltes Mädchen‘ lächelt sie.“"
                                            },
                                            {
                                                "example_id": "b6b1dbec-9fd8-4292-ba92-4be62151f9b8",
                                                "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                                "text": "„„Ja, also...“ Oh Gott! Ich war ja noch verpeilter als Sina.“"
                                            },
                                            {
                                                "example_id": "4f838472-d8ef-454b-a1ed-300dbe008f40",
                                                "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                                "text": "„Charlotte Meininger, du bist die verpeilteste, nervigste, komplizierteste Frau unter der Sonne.“"
                                            },
                                            {
                                                "example_id": "156ca34f-ba08-41b5-bc27-177f631e8641",
                                                "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                                "text": "„Die anderen schlafen zu viel und sind dann trotzdem immer irgendwie müde, verpeilt und – auch nicht so leistungsfähig.“"
                                            },
                                            {
                                                "example_id": "251a708e-63b9-4022-bbf9-801e60f5af7b",
                                                "sense_id": "2a00eb07-09dd-3df7-b40b-d3d19a784b53",
                                                "text": "„Unser Geo-Lehrer ist ziemlich verpeilt und merkt nie, dass wir uns vorher Tipps geben. Oder wir sind verpeilt genug, nicht zu merken, dass unser Geo-Lehrer ein guter Mensch ist und ahnt, dass man mit sechzehn nicht zu wissen braucht, wo Kamtschatka liegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
