                "senses": [
                    {
                        "sense_id": "cfba5fc0-5571-3b28-aacb-5ab5326aabc6",
                        "entry_id": "5d286faa-e7d7-3153-bfc9-ceac549c9fbf",
                        "glosses": [
                            "to talk loudly, to babble"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "234e520c-92ca-4565-81e5-58c7ebef7da1",
                                "sense_id": "cfba5fc0-5571-3b28-aacb-5ab5326aabc6",
                                "text": "Дава́й побаза́рим.",
                                "translation": "Let's talk.",
                                "english": "Let's talk."
                            },
                            {
                                "example_id": "60be06de-7075-4c53-a685-fadf0d58d7eb",
                                "sense_id": "cfba5fc0-5571-3b28-aacb-5ab5326aabc6",
                                "text": "Следи́ за свои́м база́ром.",
                                "translation": "Watch your tongue.",
                                "english": "Watch your tongue."
                            },
                            {
                                "example_id": "ed5f8c87-5e88-4d85-86d0-e86b6ac2c89c",
                                "sense_id": "cfba5fc0-5571-3b28-aacb-5ab5326aabc6",
                                "text": "Эй, хва́тит устра́ивать тут база́р!",
                                "translation": "Hey, enough with the babbling!",
                                "english": "Hey, enough with the babbling!"
                            }
                        ]
                    }
                ],
