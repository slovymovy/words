                                        "entry_id": "e06126f2-c620-396e-8491-98d7aaa1ab5b",
                                        "glosses": [
                                            "The planet Venus as seen in the western sky in the evening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c36bce0-aeb4-4759-aecb-2d2dede67185",
                                                "sense_id": "7183dc41-3896-3a4e-bd79-c94d56985e55",
                                                "text": "Near-synonym: Phosphorus"
                                            },
                                            {
                                                "example_id": "7338ad06-9061-43d2-aa81-efb9c2363131",
                                                "sense_id": "7183dc41-3896-3a4e-bd79-c94d56985e55",
                                                "text": "We now know that the evening star is the morning star – that is, Hesperus is Phosphorus."
                                            }
                                        ]
                                    }
