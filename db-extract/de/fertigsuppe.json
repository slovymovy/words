                "senses": [
                    {
                        "sense_id": "70ec0bbf-e6a5-3b36-8312-d270d0e8be71",
                        "entry_id": "9e8c3b07-74bb-31da-b8f4-8a6b6efce806",
                        "glosses": [
                            "vorbereitete und haltbar gemachte Suppe, die mit nur geringem Aufwand (etwa Erhitzen oder Zugabe von heißem Wasser) verzehrfertig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a33460-2360-43a7-85d3-7467a07ed58e",
                                "sense_id": "70ec0bbf-e6a5-3b36-8312-d270d0e8be71",
                                "text": "„Ob auf Zugfahrten, auf den Baustellen oder einfach in der Mittagszeit am Pekinger Straßenrand: Überall sieht man Menschen die zumeist überwürzten Fertigsuppen essen.“"
                            },
                            {
                                "example_id": "1ab81cc0-00b9-40b5-a56a-74004265f002",
                                "sense_id": "70ec0bbf-e6a5-3b36-8312-d270d0e8be71",
                                "text": "„Bobbys Vater wärmte Fertigsuppe auf, sehr viel Fertigsuppe, so viel, dass irgendwann die Küchenwände rosaroten Tomatensud auszudünsten schienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
