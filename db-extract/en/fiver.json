                            {
                                "target_word": "Fünfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                        "entry_id": "464c692b-2a8c-34bc-986b-3adef6517492",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc6126bd-50a4-4306-b1cb-a36e9721720c",
                                                "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                                "text": "Frau Fünfer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "09cfb6d6-b850-450e-b76a-61edf55923ac",
                                                "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                                "text": "Herr Fünfer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "e7120922-57bc-433c-ab49-1e8664a2e907",
                                                "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                                "text": "Die Fünfers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "c6263c7f-a7b6-437b-82b4-7a09f32a4fd6",
                                                "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                                "text": "Der Fünfer trägt nie die Schals, die die Fünfer ihm strickt."
                                            },
                                            {
                                                "example_id": "b48051bf-072c-414a-acb2-ae2734affc90",
                                                "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fünfer kommt, geht der Herr Fünfer.“"
                                            },
                                            {
                                                "example_id": "88f17e42-e6c1-4b1e-8960-7e664a91fc04",
                                                "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                                "text": "Fünfer kommt und geht."
                                            },
                                            {
                                                "example_id": "363b4bb6-2e73-4299-a794-8aecd0c3be43",
                                                "sense_id": "1a77b24d-a4da-35af-8e8e-c5a7bea77a04",
                                                "text": "Fünfers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "878b674a-b4c1-4aac-8f0f-2cfc6d1938ff",
