                        {
                            "text": "Unlike WIMPs, a <w>SIMP</w> interacts strongly with other particles in the early universe.",
                            "target_lang_translations": {
                                "ru": "В отличие от вимпов, <w>СИМП</w> сильно взаимодействует с другими частицами в ранней Вселенной."
                            }
                        }
                    ],
                    "target_lang_definitions": {
