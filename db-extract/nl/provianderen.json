                                                "sense_id": "c2dd99e9-98d1-3e98-926a-680f5f6be144",
                                                "text": "Rivers are supplied by smaller streams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3fb381d-323b-3e44-a0db-f98da932f63c",
                                        "entry_id": "9df564e8-3d2f-3cca-8788-2427f702afc9",
                                        "glosses": [
                                            "To compensate for, or make up a deficiency of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41f9f47-b1f9-4c6b-acff-d83fd43bbb21",
                                                "sense_id": "c3fb381d-323b-3e44-a0db-f98da932f63c",
                                                "text": "It was objected against him that he had never experienced love. Whereupon he arose, left the society, and made it a point not to return to it until he considered that he had supplied the defect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30eaf17b-bbb8-3b27-a2a4-e5bf412ac9b0",
                                        "entry_id": "9df564e8-3d2f-3cca-8788-2427f702afc9",
                                        "glosses": [
                                            "To serve instead of; to take the place of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b8abe8-c9e0-4462-a52e-1c663e88a26b",
                                                "sense_id": "30eaf17b-bbb8-3b27-a2a4-e5bf412ac9b0",
                                                "text": "Burning ships the banished sun supply."
                                            },
                                            {
                                                "example_id": "2064c0a6-8290-48dc-b4c1-d6d0622ba1dc",
                                                "sense_id": "30eaf17b-bbb8-3b27-a2a4-e5bf412ac9b0",
                                                "text": "The sun was set, and Vesper, to supply\n His absent beams, had lighted up the sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e8fd52-24d2-3ab0-945e-9bb4fcdd8975",
                                        "entry_id": "9df564e8-3d2f-3cca-8788-2427f702afc9",
                                        "glosses": [
                                            "To act as a substitute."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "139fc33e-f6ea-3cd1-a78a-a0ff6c06768b",
                                        "entry_id": "9df564e8-3d2f-3cca-8788-2427f702afc9",
                                        "glosses": [
                                            "To fill temporarily; to serve as substitute for another in, as a vacant place or office; to occupy; to have possession of."
