{
    "word_family": [
        "percent",
        "percentage",
        "perhaps",
        "perchance"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "094dd3d6-8063-34e5-b849-e4a2c9fadb8f",
                    "sense_definition": "For each unit of time, distance, or quantity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rate_distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was traveling at sixty miles <w>per</w> hour.",
                            "target_lang_translations": {
                                "ru": "Машина ехала со скоростью шестьдесят миль <w>в</w> час.",
                                "zh": "这辆车当时以<w>每</w>小时六十英里的速度行驶。"
                            }
                        },
                        {
                            "text": "The entrance fee is ten dollars <w>per</w> person.",
                            "target_lang_translations": {
                                "ru": "Входная плата составляет десять долларов <w>с</w> человека.",
                                "zh": "入场费是<w>每</w>人十美元。"
                            }
                        }
                    ],
                    "synonyms": [
                        "a",
                        "an",
                        "each"
                    ],
                    "common_phrases": [
                        "per person",
                        "per day",
                        "per year",
                        "miles per hour",
                        "per cent"
                    ],
                    "target_lang_definitions": {
                        "ru": "За каждую единицу времени, расстояния или количества.",
                        "zh": "用于表示每一单位的时间、距离或数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в",
                                "target_lang_sense_clarification": "при указании скорости или частоты (напр., миль в час)"
                            },
                            {
                                "target_lang_word": "за",
                                "target_lang_sense_clarification": "при указании цены за единицу"
                            },
                            {
                                "target_lang_word": "с",
                                "target_lang_sense_clarification": "при указании сбора с человека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每",
                                "target_lang_sense_clarification": "表示每一单位"
                            },
                            {
                                "target_lang_word": "按",
                                "target_lang_sense_clarification": "表示按单位计算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "637dff31-87d6-3eef-9eda-3d2c5b3a9e33",
                    "sense_definition": "In accordance with or according to.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accordance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have completed the project <w>per</w> your instructions.",
                            "target_lang_translations": {
                                "ru": "Мы завершили проект <w>согласно</w> вашим инструкциям.",
                                "zh": "我们已经<w>按照</w>您的指示完成了项目。"
                            }
                        },
                        {
                            "text": "As <w>per</w> the agreement, the payment is due tomorrow.",
                            "target_lang_translations": {
                                "ru": "<w>Согласно</w> договору, оплата должна быть произведена завтра.",
                                "zh": "<w>根据</w>协议，付款期限是明天。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "as per",
                        "per request"
                    ],
                    "target_lang_definitions": {
                        "ru": "В соответствии с или согласно чему-либо.",
                        "zh": "按照或根据某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласно",
                                "target_lang_sense_clarification": "в соответствии с документом или правилом"
                            },
                            {
                                "target_lang_word": "по",
                                "target_lang_sense_clarification": "на основании чего-либо (напр., по вашим инструкциям)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按照",
                                "target_lang_sense_clarification": "根据某项规定或指示"
                            },
                            {
                                "target_lang_word": "根据",
                                "target_lang_sense_clarification": "依据某项协议或要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "068f95d4-224f-3d7a-aeb4-15077defb63a",
                    "sense_definition": "By means of or through; often used in medical or technical contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "means",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medication should be administered <w>per</w> os, which means by mouth.",
                            "target_lang_translations": {
                                "ru": "Лекарство следует принимать <w>через</w> рот (per os), что означает перорально.",
                                "zh": "这种药物应<w>经由</w>口服，即通过嘴服用。"
                            }
                        },
                        {
                            "text": "The goods were shipped <w>per</w> rail across the country.",
                            "target_lang_translations": {
                                "ru": "Товары были отправлены <w>по</w> железной дороге через всю страну.",
                                "zh": "货物是<w>通过</w>铁路运往全国各地的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in general use"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "medical or technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посредством или через; часто используется в медицинских или технических контекстах.",
                        "zh": "通过或经由某种方式，常用于医学或技术领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "через",
                                "target_lang_sense_clarification": "сквозь, посредством"
                            },
                            {
                                "target_lang_word": "по",
                                "target_lang_sense_clarification": "указание на путь или средство транспортировки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经由",
                                "target_lang_sense_clarification": "通过某种途径"
                            },
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "使用某种手段或路径"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea8a8703-0d29-3c17-997d-d8789e263f18",
                    "sense_definition": "Initialism of price-earnings ratio, a measure used in finance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance_acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors often look at the <w>PER</w> to determine if a stock is overvalued.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто смотрят на <w>коэффициент цена/прибыль</w>, чтобы определить, не переоценены ли акции.",
                                "zh": "投资者经常查看<w>市盈率</w>来判断股票是否被高估。"
                            }
                        },
                        {
                            "text": "A low <w>PER</w> might indicate that the company is currently undervalued.",
                            "target_lang_translations": {
                                "ru": "Низкий <w>P/E</w> может указывать на то, что компания в настоящее время недооценена.",
                                "zh": "较低的<w>市盈率</w>可能表明该公司目前被低估了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от «price-earnings ratio» (отношение цены к прибыли), финансовый показатель.",
                        "zh": "市盈率，一种金融衡量指标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коэффициент цена/прибыль",
                                "target_lang_sense_clarification": "финансовый термин"
                            },
                            {
                                "target_lang_word": "P/E",
                                "target_lang_sense_clarification": "общепринятое международное обозначение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "市盈率",
                                "target_lang_sense_clarification": "金融术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "f9e190cb-1f88-3724-85ac-a702330afcbc",
                    "sense_definition": "Gender-neutral third-person singular subject pronoun (neologism).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pronoun_subject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If a person wants to join, <w>per</w> must sign the form first.",
                            "target_lang_translations": {
                                "ru": "Если человек хочет присоединиться, <w>он (или она)</w> должен сначала подписать форму.",
                                "zh": "如果有人想加入，<w>他/她</w>必须先签署表格。"
                            }
                        },
                        {
                            "text": "My friend said <w>per</w> would arrive at the station by noon.",
                            "target_lang_translations": {
                                "ru": "Мой друг сказал, что <w>он</w> прибудет на станцию к полудню.",
                                "zh": "我的朋友说<w>他/她</w>会在中午前到达车站。"
                            }
                        }
                    ],
                    "synonyms": [
                        "they",
                        "ey",
                        "sie",
                        "ze"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "neologism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гендерно-нейтральное личное местоимение третьего лица единственного числа (неологизм).",
                        "zh": "性别中立的第三人称单数主格代词（新词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "он/она",
                                "target_lang_sense_clarification": "неологизм: гендерно-нейтральное личное местоимение (подлежащее); в рус. аналога нет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "他/她",
                                "target_lang_sense_clarification": "性别中立代词，中文通常根据语境使用他或她"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8fdf761-68fe-3534-a708-8727e1493313",
                    "sense_definition": "Gender-neutral third-person singular object pronoun (neologism).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pronoun_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I called my friend and asked <w>per</w> to come over.",
                            "target_lang_translations": {
                                "ru": "Я позвонил своему другу и попросил <w>его</w> прийти.",
                                "zh": "我给朋友打了电话，并请<w>他/她</w>过来。"
                            }
                        },
                        {
                            "text": "We should invite <w>per</w> to the meeting tomorrow.",
                            "target_lang_translations": {
                                "ru": "Нам следует пригласить <w>этого человека</w> на завтрашнее собрание.",
                                "zh": "我们应该邀请<w>他/她</w>参加明天的会议。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "neologism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гендерно-нейтральное личное местоимение третьего лица единственного числа в объектном падеже (неологизм).",
                        "zh": "性别中立的第三人称单数宾格代词（新词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "его/её",
                                "target_lang_sense_clarification": "неологизм: гендерно-нейтральное местоимение (дополнение, him/her)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "他/她",
                                "target_lang_sense_clarification": "性别中立代词，作为宾语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "992a1c21-5323-3cb0-94a0-d98d885c792a",
                    "sense_definition": "Gender-neutral third-person singular possessive adjective (neologism).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "possessive_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student left <w>per</w> book on the desk.",
                            "target_lang_translations": {
                                "ru": "Студент оставил <w>свою</w> книгу на столе.",
                                "zh": "学生把<w>他/她的</w>书留在了桌子上。"
                            }
                        },
                        {
                            "text": "Each participant should bring <w>per</w> own lunch.",
                            "target_lang_translations": {
                                "ru": "Каждый участник должен принести <w>свой</w> собственный обед.",
                                "zh": "每位参与者都应该自带<w>他/她的</w>午餐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "their",
                        "eir",
                        "hir"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "neologism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гендерно-нейтральное притяжательное прилагательное третьего лица единственного числа (неологизм).",
                        "zh": "性别中立的第三人称单数所有格形容词（新词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "его/её",
                                "target_lang_sense_clarification": "неологизм: гендерно-нейтральное притяжательное (his/her)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "他/她的",
                                "target_lang_sense_clarification": "性别中立代词，表示所属关系"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}