                {
                    "sense_id": "d6e38233-9951-3c8a-bd56-8ad5ae4d8938",
                    "sense_definition": "To help oneself or advance through one's own efforts without the aid of others",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-advancement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years <w>bootstrapping</w> himself through college by working two part-time jobs.",
                            "target_lang_translations": {
                                "ru": "Он годами <w>самостоятельно пробивался</w> во время учебы в колледже, работая на двух работах."
                            }
                        },
                        {
                            "text": "The entrepreneur managed to <w>bootstrap</w> his way to success without any outside investment.",
                            "target_lang_translations": {
                                "ru": "Предпринимателю удалось <w>добиться успеха своими силами</w> без каких-либо внешних инвестиций."
                            }
