                "senses": [
                    {
                        "sense_id": "f33700a8-8c6a-3868-88b6-eea9127f269d",
                        "entry_id": "c9dbcd5f-a94b-3d56-b3be-efa6565dd58e",
                        "glosses": [
                            "to belong, to be in one's preferred or appropriate place"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a949edd-5245-4801-8a95-ac2e4adbfab2",
                                "sense_id": "f33700a8-8c6a-3868-88b6-eea9127f269d",
                                "text": "Deze borden horen in de servieskast thuis.",
                                "translation": "These plates belong in the cupboard.",
