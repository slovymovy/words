{
    "word_family": [
        "finger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                    "sense_definition": "The end of a human finger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She touched the screen with her <w>fingertip</w> to select the icon.",
                            "target_lang_translations": {
                                "cs": "Dotkla se obrazovky <w>konečkem prstu</w>, aby vybrala ikonu."
                            }
                        },
                        {
                            "text": "The musician felt the strings with her <w>fingertips</w> while playing the guitar.",
                            "target_lang_translations": {
                                "cs": "Hudebnice cítila struny svými <w>konečky prstů</w>, zatímco hrála na kytaru."
                            }
                        }
                    ],
                    "synonyms": [
                        "finger-end"
                    ],
                    "common_phrases": [
                        "at your fingertips"
                    ],
                    "target_lang_definitions": {
                        "cs": "Koneček lidského prstu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "koneček prstu",
                                "target_lang_sense_clarification": "anatomická část prstu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90a772cf-632b-3542-94f8-5d3dbf7d9092",
                    "sense_definition": "To touch or deflect something lightly using the tips of the fingers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper managed to <w>fingertip</w> the ball over the crossbar.",
                            "target_lang_translations": {
                                "cs": "Brankáři se podařilo <w>konečky prstů odrazit</w> míč nad břevno."
                            }
                        },
                        {
                            "text": "He <w>fingertipped</w> the falling vase to keep it from breaking.",
                            "target_lang_translations": {
                                "cs": "Padající vázy se <w>konečky prstů lehce dotkl</w>, aby zabránil jejímu rozbití."
                            }
                        }
                    ],
                    "synonyms": [
                        "tap",
                        "touch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Lehce se něčeho dotknout nebo to odrazit konečky prstů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "konečky prstů lehce odrazit",
                                "target_lang_sense_clarification": "sportovní kontext, např. brankář"
                            },
                            {
                                "target_lang_word": "lehce se dotknout",
                                "target_lang_sense_clarification": "obecný pohyb"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}