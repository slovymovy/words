                                "target_senses": [
                                    {
                                        "sense_id": "c9ada052-51c4-3f52-a0e8-989d8dc13cc0",
                                        "entry_id": "b08093fe-0e00-3861-b2e2-18ccf9233149",
                                        "glosses": [
                                            "Art et commerce des joailliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b46921-bf5a-42fe-b08b-7504de9fd02d",
                                                "sense_id": "c9ada052-51c4-3f52-a0e8-989d8dc13cc0",
                                                "text": "Il s’est enrichi dans la joaillerie."
                                            },
                                            {
                                                "example_id": "e4caefec-2db5-40a3-8239-d962bb7b2c1a",
                                                "sense_id": "c9ada052-51c4-3f52-a0e8-989d8dc13cc0",
                                                "text": "Sous Louis XIV seulement , la joaillerie acquit une certaine perfection, et les joailliers, sous le nom de metteurs en œuvre, furent, sous Louis XV, considérés comme artistes et admis à la jouissance de quelques priviléges."
                                            },
                                            {
                                                "example_id": "9091e730-f47e-4aae-ac18-1e6a3a0dace3",
                                                "sense_id": "c9ada052-51c4-3f52-a0e8-989d8dc13cc0",
                                                "text": "Après une première incursion dans la joaillerie, cinq ans plus tard Vuitton frappe un grand coup en s’adjoignant le talent de Lorenz Baümer, arraché par Bernard Arnault aux griffes de Chanel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d99f98a-6d8e-3f34-9048-24ab98b06124",
                                        "entry_id": "b08093fe-0e00-3861-b2e2-18ccf9233149",
                                        "glosses": [
                                            "Joyaux, pierreries que vend le joaillier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47cf00cc-a60c-465c-9cea-6ad3cc74be27",
                                                "sense_id": "2d99f98a-6d8e-3f34-9048-24ab98b06124",
                                                "text": "Des articles de joaillerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a886ae7e-fbf0-311b-89f3-a29c4a73a7ef",
                                        "entry_id": "b08093fe-0e00-3861-b2e2-18ccf9233149",
                                        "glosses": [
                                            "Endroit, le magasin où se vendent ces joyaux, ces pierreries."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
