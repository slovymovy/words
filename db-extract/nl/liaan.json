                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3cd5e31-06ad-4bf8-9bea-c64e0d13e4cb",
                                "sense_id": "f895a39c-e64c-34a0-82fc-8a91a28a35e2",
                                "text": "Tarzan slingerde met lianen van boom tot boom."
                            },
                            {
                                "example_id": "35e7a27d-357d-441d-9074-28de4eb30151",
                                "sense_id": "f895a39c-e64c-34a0-82fc-8a91a28a35e2",
                                "text": "Dus nu zou het zwemmen worden, daar liep het altijd op uit. Eerst zou Tarzan een beetje aan lianen slingeren tot hij bij een rivier of meer kwam, waar hij in dook en wegzwom van de krokodillen alsof het een makkie was."
                            }
                        ]
                    }
