                ],
                "senses": [
                    {
                        "sense_id": "7ff20f2f-f9de-3fd0-8511-2d8c9b1626b4",
                        "entry_id": "518cd421-6dce-3250-bac6-2d1dc8c2fefa",
                        "glosses": [
                            "aus Juden und Arabern bestehend, Juden und Araber betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9812382e-91fc-474c-bdca-4366eb70810e",
                                "sense_id": "7ff20f2f-f9de-3fd0-8511-2d8c9b1626b4",
                                "text": "„Er befürwortete eine jüdisch-arabische Koexistenz.“"
                            },
                            {
                                "example_id": "55cff591-4bfa-440e-8f77-959962c43510",
                                "sense_id": "7ff20f2f-f9de-3fd0-8511-2d8c9b1626b4",
                                "text": "„Aus diesem jüdisch-arabischen Kern entstand die israelische kommunistische Partei, die ab den 1950er-Jahren eine Plattform für die politischen Bestrebungen vieler palästinensischer Bürger Israels wurde, da rein arabische Gruppierungen durch das bis 1966 geltende Kriegsrecht verboten waren.“"
                            },
                            {
                                "example_id": "e7ad2ee9-b21d-4211-8ef0-53209e04c267",
                                "sense_id": "7ff20f2f-f9de-3fd0-8511-2d8c9b1626b4",
                                "text": "„Mit Ende des Zweiten Weltkriegs spitzten sich sowohl die jüdisch-arabischen Auseinandersetzungen als auch Angriffe beider Seiten auf britische Einrichtungen zu.“"
