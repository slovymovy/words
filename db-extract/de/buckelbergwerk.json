                    {
                        "sense_id": "0102dafd-e780-33ad-89e2-a0bec4e81aa2",
                        "entry_id": "b8e4d0f4-1aca-31d0-b1d7-dbc3c28b66b8",
                        "glosses": [
                            "kleines Modell eines Bergwerks, das Bergleute, die nicht mehr im Bergwerk arbeiten konnten, schnitzten und auf dem Rücken (Buckel) zu Jahrmärkten trugen, um so etwas Geld zu verdienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0d4bc8-2037-445c-b926-fbe159e4d5d4",
                                "sense_id": "0102dafd-e780-33ad-89e2-a0bec4e81aa2",
                                "text": "Ein beliebtes Sujet waren dabei Bergwerke, große Gruben \"en miniature\", die ihren Ursprung den tragbaren „Buckelbergwerken“ hatten, mit denen (invalide) arbeitslose Bergleute aus dem Erzgebirge herumzogen."
                            }
                        ],
