                                        "glosses": [
                                            "Grade donné dans la Marine nationale française à un officier général situé entre son supérieur hiérarchique, le vice-amiral d’escadre, et son subordonné, le contre-amiral. Le code OTAN : OF-7."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a4cfd15-6aa0-4d1e-8d22-3530900402d2",
                                                "sense_id": "34441b93-a166-31be-94d1-54e9df8290df",
                                                "text": "Le grade de vice-amiral."
                                            },
                                            {
                                                "example_id": "a1a822f4-d655-4d60-9b15-8cb36be51e03",
                                                "sense_id": "34441b93-a166-31be-94d1-54e9df8290df",
                                                "text": "Il fut nommé vice-amiral."
                                            },
                                            {
                                                "example_id": "2859e369-b8e4-4e4c-81c1-785df4ef3329",
                                                "sense_id": "34441b93-a166-31be-94d1-54e9df8290df",
                                                "text": "Je frappe. Une voix de Capitaine Haddock m’invite à entrer. Je pousse la porte et me trouve face à une demi-douzaine d’amiraux ou contre- ou vice-amiraux en retraite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1999750-1b06-369e-b665-5d813436d399",
