                    },
                    {
                        "translation_id": "83842d94-7865-4456-b0e9-36d988852f3d",
                        "source_entry_id": "d0d5f52c-b069-3d6a-8e1e-aa8fa6cf88ad",
                        "source_sense_id": "c78e8e95-a673-341e-b00c-026f1f17c734",
