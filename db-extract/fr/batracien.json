            {
                "entry_id": "330966e3-8a94-36fd-97ed-1e963ea2335c",
                "word": "batracien",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9d2acb7d-cd9d-424a-9534-e11039214a00",
                        "entry_id": "330966e3-8a94-36fd-97ed-1e963ea2335c",
                        "tags": [
