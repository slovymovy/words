                                            {
                                                "example_id": "a09bf459-1b63-49a6-a540-28d769496c8f",
                                                "sense_id": "90f2ce87-ed04-3628-a46e-ff8fed4836b3",
                                                "text": "Das Nachspiel hatte meist eine fröhlichere Note und war nicht so ernst, wie die Hauptdarbietung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a425ad1-6fbe-390c-99a0-55db604aa131",
                                        "entry_id": "5a79ff1f-1ffe-398e-bbc2-ac5da796ad4b",
                                        "glosses": [
                                            "(meist unangenehme) Folge, Konsequenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7fcd454-6988-4fe8-a724-52874ff1c71a",
                                                "sense_id": "0a425ad1-6fbe-390c-99a0-55db604aa131",
                                                "text": "Das wird noch ein Nachspiel haben!"
                                            },
                                            {
                                                "example_id": "1ed8b664-0075-44b7-a3a3-cca4e5a58d24",
                                                "sense_id": "0a425ad1-6fbe-390c-99a0-55db604aa131",
                                                "text": "„Buschs Satire und Polemik gegen Repräsentanten der katholischen Kirche sollte für ihn ein unangenehmes Nachspiel haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5a0ed8fb-99d3-3e94-91fe-a096e86d7c46",
                                        "entry_id": "5a79ff1f-1ffe-398e-bbc2-ac5da796ad4b",
                                        "glosses": [
                                            "Spielzeit nach der regulären Spielzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d5187d-0947-46c1-a4b5-f6abfc8218bf",
                                                "sense_id": "5a0ed8fb-99d3-3e94-91fe-a096e86d7c46",
                                                "text": "Im Nachspiel waren nur noch 10 Spieler auf dem Platz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "abf171c7-241f-3091-a519-06948296ca7d",
                                        "entry_id": "5a79ff1f-1ffe-398e-bbc2-ac5da796ad4b",
                                        "glosses": [
                                            "Austausch von Zärtlichkeiten nach dem Geschlechtsverkehr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83ba4cc-27b9-498e-aade-a913461452ce",
                                                "sense_id": "abf171c7-241f-3091-a519-06948296ca7d",
                                                "text": "Das Nachspiel ist der Zigarette danach vorzuziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
