                "senses": [
                    {
                        "sense_id": "4ec57bb2-7e5d-3078-9e3f-c1ce427381a4",
                        "entry_id": "011915d0-8bb0-3f73-944a-4a9b661d50df",
                        "glosses": [
                            "A spacecraft used for scouting."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "219f32c4-35ce-48f0-a664-f706bb1138fc",
                                "sense_id": "4ec57bb2-7e5d-3078-9e3f-c1ce427381a4",
                                "text": "Enemy scoutcraft, extreme range."
                            },
                            {
                                "example_id": "e582fd62-2cc6-44cd-a1f2-43acbac115a0",
                                "sense_id": "4ec57bb2-7e5d-3078-9e3f-c1ce427381a4",
                                "text": "In August 1954 a Venusian scoutcraft allegedly flew Adamski around the moon, showing him extraterrestrial cities and hangars as well as forests, lakes, and rivers."
                            },
                            {
                                "example_id": "6f57bb0e-a330-43a9-82fe-ebcd5a376908",
                                "sense_id": "4ec57bb2-7e5d-3078-9e3f-c1ce427381a4",
                                "text": "He flies around the Galaxy all alone in just a little tiny scoutcraft?"
                            },
                            {
                                "example_id": "23ad8b76-4617-44ee-be38-ea0d7c50aa59",
                                "sense_id": "4ec57bb2-7e5d-3078-9e3f-c1ce427381a4",
                                "text": "In the ensuing years it had never come to that, yet every scoutcraft was equipped with a self-destruct mechanism, and every commander was prepared at all times to activate it."
                            },
                            {
                                "example_id": "9326adb3-eafe-40b6-bc5e-4e5131b367a9",
                                "sense_id": "4ec57bb2-7e5d-3078-9e3f-c1ce427381a4",
                                "text": "The nearer they closed in; tiny scoutcrafts could be seen continuingly migrating to and from them."
                            }
                        ]
                    }
                ],
