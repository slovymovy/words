                "senses": [
                    {
                        "sense_id": "9403f0a8-1d9a-307f-92f5-e19d6f37dafb",
                        "entry_id": "8bdf94ec-524f-3d87-b26b-bdf1be40f72e",
                        "glosses": [
                            "Qui lustre, fait briller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d80f26-995d-43a8-be90-227b4101d7bc",
                                "sense_id": "9403f0a8-1d9a-307f-92f5-e19d6f37dafb",
                                "text": "Parfois, tôt le matin, je bavarde avec la concierge : elle me surprend avec sa tête plantée de bigoudis, son sarrau rapiécé, ses poches gonflées d’un tas de produits lustrants et ses charentaises, trouées par commodité aux orteils."
                            },
                            {
                                "example_id": "8656e933-acd6-4850-b3c5-5e3d860ba70e",
                                "sense_id": "9403f0a8-1d9a-307f-92f5-e19d6f37dafb",
                                "text": "Elle a rangé les assiettes, donné un coup de pschitt lustrant sur la table et a trempé un doigt dans le chocolat qu’elle a léché, le linge attendrait lundi, la femme de ménage."
                            },
                            {
                                "example_id": "a237fa3f-7031-4f4a-867a-7befdbc7abc1",
                                "sense_id": "9403f0a8-1d9a-307f-92f5-e19d6f37dafb",
                                "text": "Une cire lustrante."
                            },
                            {
                                "example_id": "a0f6ea21-badd-47fb-9392-55054129f172",
                                "sense_id": "9403f0a8-1d9a-307f-92f5-e19d6f37dafb",
                                "text": "Un shampoing lustrant."
                            },
                            {
                                "example_id": "4965178d-248d-4e2b-841b-b3294a84d1c8",
                                "sense_id": "9403f0a8-1d9a-307f-92f5-e19d6f37dafb",
                                "text": "Une lingette lustrante."
                            }
                        ]
                    }
