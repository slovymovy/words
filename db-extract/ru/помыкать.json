                "senses": [
                    {
                        "sense_id": "d859efc5-c5f9-3c9a-bce9-faed18e4159a",
                        "entry_id": "613488ba-cff8-3986-a65e-40f3925a1c72",
                        "glosses": [
                            "деспотически обращаться с кем-либо, распоряжаясь по своему произволу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9cf9741-3840-4650-9c58-69ad0faf922e",
                                "sense_id": "d859efc5-c5f9-3c9a-bce9-faed18e4159a",
                                "text": "Отец им помыка́ет по-прежнему, а жена считает его дурачком… и литератором."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6481ad6c-25e5-4f60-af1e-00cb17d48f9f",
                        "source_entry_id": "613488ba-cff8-3986-a65e-40f3925a1c72",
                        "source_sense_id": "d859efc5-c5f9-3c9a-bce9-faed18e4159a",
                        "target_lang_word": "gängeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gängeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c4d2a76-e124-3ae1-bd8d-27bf58582b92",
                                        "entry_id": "3efa23db-5439-36b1-ab0a-6f775266e378",
                                        "glosses": [
                                            "jemandem ständig Vorschriften machen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c7a3cbe-7d92-488c-b78f-c62d64392314",
                                                "sense_id": "0c4d2a76-e124-3ae1-bd8d-27bf58582b92",
                                                "text": "Sie wollten ihn nicht gängeln, sondern überzeugen."
                                            },
                                            {
                                                "example_id": "04fc5a6b-cd16-4c26-9197-8e2b035f25f6",
                                                "sense_id": "0c4d2a76-e124-3ae1-bd8d-27bf58582b92",
                                                "text": "Immer häufiger gibt es bei den Pressekonferenzen im Weißen Haus in Washington die Anweisung an Journalisten, ihre Kameras auszuschalten. … Selbst Reporter beim konservativen Sender Fox News sind zunehmend genervt, von der Regierung Trump gegängelt zu werden."
                                            },
                                            {
                                                "example_id": "3339fb9c-2695-4bea-a04c-908f7a8e237d",
                                                "sense_id": "0c4d2a76-e124-3ae1-bd8d-27bf58582b92",
                                                "text": "Die autonome Region [Katalonien] mit 7,5 Millionen Einwohnern sieht sich von der Zentralregierung in Madrid gegängelt und wirtschaftlich ausgenutzt."
                                            },
                                            {
                                                "example_id": "bb025495-ce3a-4a56-9633-56a559e6fab6",
                                                "sense_id": "0c4d2a76-e124-3ae1-bd8d-27bf58582b92",
                                                "text": "„Jalkotzy fiel ihm ins Wort. «Wie viele Gelegenheiten will die Partei noch verstreichen, wie oft sich noch von den Faschisten gängeln und erniedrigen lassen?»“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82bcfdd6-1ad1-3ab7-8a01-1a26ddea6800",
                                        "entry_id": "3efa23db-5439-36b1-ab0a-6f775266e378",
                                        "glosses": [
                                            "jemanden das Gehen lehren"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f614744-bd05-4cc3-9c6f-c6709ffd3e03",
                                                "sense_id": "82bcfdd6-1ad1-3ab7-8a01-1a26ddea6800",
                                                "text": "„[…] und Christus uns muß gängeln, wie die Mutter oder Magd ein Kind gängelt […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
