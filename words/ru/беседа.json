                                "target_lang_sense_clarification": "informal conversation"
                            },
                            {
                                "target_lang_word": "chat",
                                "target_lang_sense_clarification": "friendly, informal talk"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Unterhaltung",
                                "target_lang_sense_clarification": "allgemeiner Austausch von Gedanken"
                            },
                            {
                                "target_lang_word": "Gespräch",
                                "target_lang_sense_clarification": "allgemeiner Austausch von Worten"
                            },
                            {
                                "target_lang_word": "Plauderei",
                                "target_lang_sense_clarification": "freundschaftliches, informelles Gespräch"
                            }
