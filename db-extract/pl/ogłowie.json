                                    {
                                        "sense_id": "0b165be2-c270-37dc-9236-d3446f6528ed",
                                        "entry_id": "0316b10a-59e9-310a-892b-0c15bd44840c",
                                        "glosses": [
                                            "To put a bridle on."
                                        ],
