                "senses": [
                    {
                        "sense_id": "e70b7c62-c0be-3c27-a281-b9c7b1af5571",
                        "entry_id": "8c798987-c980-3d47-a076-f258c34e9663",
                        "glosses": [
                            "Grand dinosaure carnivore du Campanien et du Maastrichtien, de la famille des tyrannosauridés."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc6de023-4122-4340-b6a2-622aaad0ade8",
                        "source_entry_id": "8c798987-c980-3d47-a076-f258c34e9663",
                        "source_sense_id": "e70b7c62-c0be-3c27-a281-b9c7b1af5571",
                        "target_lang_word": "Tyrannosaurus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tyrannosaurus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c666a72-72c6-36a2-8eaf-00764f1982cd",
                                        "entry_id": "880763bb-5b4a-3564-a049-30cfe430f60f",
                                        "glosses": [
                                            "Vertreter einer Gattung großer fleischfressender Dinosaurier aus der späten Kreidezeit"
                                        ],
                                        "tags": [
                                            "Paläontologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "061679cb-b1d8-417b-b6a0-97fe5866a0be",
                                                "sense_id": "2c666a72-72c6-36a2-8eaf-00764f1982cd",
                                                "text": "„Tyrannosaurus ist sicher einer der bekanntesten Dinosaurier und gehörte zu den letzten großen Fleischfressern vor dem großen Aussterben vor ca. 66 Millionen Jahren. Er war nicht das größte, sicher aber eines der gefährlichsten Raubtiere dieser Zeit.“"
                                            },
                                            {
                                                "example_id": "a7c94b3d-83df-4eb4-85c2-60c33c77a0fb",
                                                "sense_id": "2c666a72-72c6-36a2-8eaf-00764f1982cd",
                                                "text": "„Dinosaurier wie der Tyrannosaurus rex werden oft als furchteinflößende Kreaturen dargestellt: Sie reißen ihr Maul auf, fletschen die Zähne und strecken ihre Zunge weit heraus, so als wären sie gigantische Eidechsen. Forscher der Universität von Texas in Austin und der Chinesischen Akademie der Wissenschaften haben aber nun entdeckt, dass die Dinosaurier gar nicht so züngeln konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdf75e1b-5d79-435c-9a90-52f4ff98c461",
                        "source_entry_id": "8c798987-c980-3d47-a076-f258c34e9663",
                        "source_sense_id": "e70b7c62-c0be-3c27-a281-b9c7b1af5571",
                        "target_lang_word": "tyrannosaurus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
