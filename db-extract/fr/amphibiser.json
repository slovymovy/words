                "senses": [
                    {
                        "sense_id": "0502ac44-6d13-3dfa-ad69-53678dc678ce",
                        "entry_id": "9bbeee10-630c-31ee-96e4-a44b189e954c",
                        "glosses": [
                            "Rendre amphibie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da60821-8427-497d-ae58-f28749bd5f50",
                                "sense_id": "0502ac44-6d13-3dfa-ad69-53678dc678ce",
                                "text": "Tout ce que j'en sais c'est que j'obtiendrais ainsi de quoi « amphibiser » buggy et pilote et m'offrir le presque magique kit acrobatique de contrôle aérodynamique."
                            },
                            {
                                "example_id": "ce9667a2-4626-468a-aba3-c70b31532cee",
                                "sense_id": "0502ac44-6d13-3dfa-ad69-53678dc678ce",
                                "text": "Le danger est de se faire amphibiser."
                            },
                            {
                                "example_id": "0ad7dce6-b1bb-434c-b10b-da31ce4fbebe",
                                "sense_id": "0502ac44-6d13-3dfa-ad69-53678dc678ce",
                                "text": "Si on voulait aller au-delà, il fallait s'amphibiser, soit en apportant de l’air, soit en utilisant une coque, parce que l’on ne pouvait pas survivre dans l’eau."
                            }
                        ]
                    }
