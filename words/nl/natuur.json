                {
                    "sense_id": "0fb68265-1c76-3e47-a13a-80405d79f21d",
                    "sense_definition": "De wereld van planten, dieren, bergen en zeeën zoals die oorspronkelijk is en niet door mensen is gemaakt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het weekend wandelen wij graag in de <w>natuur</w>.",
                            "target_lang_translations": {
                                "en": "On weekends, we like to walk in <w>nature</w>.",
                                "ru": "В выходные мы любим гулять на <w>природе</w>.",
                                "pl": "W weekendy chętnie spacerujemy na <w>łonie natury</w>.",
                                "de": "Am Wochenende wandern wir gerne in der <w>Natur</w>.",
                                "fr": "Le week-end, nous aimons nous promener dans la <w>nature</w>.",
                                "it": "Nel fine settimana ci piace camminare nella <w>natura</w>.",
                                "cs": "O víkendu se rádi procházíme v <w>přírodě</w>.",
                                "tr": "Hafta sonları <w>doğada</w> yürüyüş yapmayı severiz.",
                                "es": "Los fines de semana nos gusta caminar en la <w>naturaleza</w>."
                            }
                        },
                        {
                            "text": "Na jaren in de stad had hij behoefte aan meer <w>natuur</w> om zich heen.",
                            "target_lang_translations": {
                                "en": "After years in the city, he felt the need for more <w>nature</w> around him.",
                                "ru": "После многих лет в городе он испытывал потребность в большем количестве <w>природы</w> вокруг себя.",
                                "pl": "Po latach spędzonych w mieście potrzebował wokół siebie więcej <w>przyrody</w>.",
                                "de": "Nach Jahren in der Stadt hatte er das Bedürfnis nach mehr <w>Natur</w> um sich herum.",
                                "fr": "Après des années en ville, il avait besoin de plus de <w>nature</w> autour de lui.",
                                "it": "Dopo anni in città, sentiva il bisogno di avere più <w>natura</w> intorno a sé.",
                                "cs": "Po letech ve městě měl potřebu mít kolem sebe více <w>přírody</w>.",
                                "tr": "Şehirde geçen yıllardan sonra etrafında daha fazla <w>doğa</w> olmasına ihtiyaç duyuyordu.",
                                "es": "Después de años en la ciudad, sentía la necesidad de tener más <w>naturaleza</w> a su alrededor."
                            }
                        }
                    ],
                    "antonyms": [
                        "cultuur"
                    ],
                    "common_phrases": [
                        "in de natuur",
                        "de vrije natuur",
                        "terug naar de natuur",
                        "moeder natuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The world of plants, animals, mountains, and seas as it originally is and not created by humans.",
                        "ru": "Мир растений, животных, гор и морей в его естественном состоянии, не созданный человеком.",
                        "pl": "Świat roślin, zwierząt, gór i mórz w swoim pierwotnym stanie, niestworzony przez człowieka.",
                        "de": "Die Welt der Pflanzen, Tiere, Berge und Meere, wie sie ursprünglich ist und nicht vom Menschen geschaffen wurde.",
                        "fr": "Le monde des plantes, des animaux, des montagnes et des mers tel qu'il est à l'origine et non créé par l'homme.",
                        "it": "Il mondo delle piante, degli animali, delle montagne e dei mari così com'è in origine e non creato dall'uomo.",
                        "cs": "Svět rostlin, zvířat, hor a moří v jeho původní podobě, který nevytvořili lidé.",
                        "tr": "Bitkilerin, hayvanların, dağların ve denizlerin oluşturduğu, insanlar tarafından yapılmamış olan doğal dünya.",
                        "es": "El mundo de las plantas, los animales, las montañas y los mares tal como es originalmente y no creado por el ser humano."
                    },
