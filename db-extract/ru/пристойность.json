                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7071bf7-2c5a-4868-b431-ea40074fbefb",
                                                "sense_id": "3f3df1a1-7e76-36eb-9eec-54bf952ae4a8",
                                                "text": "Correction de dessin,"
