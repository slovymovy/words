            {
                "entry_id": "626cd4dc-0ec8-3b23-b88a-257e58291e3d",
                "word": "mineuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27d4989e-144a-4f18-81be-19fab2d93907",
                        "entry_id": "626cd4dc-0ec8-3b23-b88a-257e58291e3d",
                        "tags": [
