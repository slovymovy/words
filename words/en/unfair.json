{
    "word_family": [
        "fair",
        "fairness",
        "fairly",
        "unfairness",
        "unfairly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d3f57a64-012d-3f10-995d-d9266f7a24a0",
                    "sense_definition": "Not treating people in an equal way, or not morally right according to the principles of justice.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>unfair</w> for the boss to give larger bonuses to his friends.",
                            "target_lang_translations": {
                                "ru": "Было <w>несправедливо</w> со стороны начальника давать более крупные бонусы своим друзьям.",
                                "zh": "老板给他的朋友发更多的奖金，这太<w>不公平</w>了。"
                            }
                        },
                        {
                            "text": "The team felt that the referee gave them an <w>unfair</w> penalty during the match.",
                            "target_lang_translations": {
                                "ru": "Команда чувствовала, что судья назначил им <w>несправедливый</w> пенальти во время матча.",
                                "zh": "球队觉得裁判在比赛中判给他们的点球是<w>不公正</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unjust",
                        "biased",
                        "inequitable",
                        "partial",
                        "one-sided"
                    ],
                    "antonyms": [
                        "fair",
                        "just",
                        "equitable"
                    ],
                    "common_phrases": [
                        "unfair advantage",
                        "unfair treatment",
                        "unfair dismissal",
                        "life is unfair",
                        "unfair competition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не основанный на принципах равенства или морально неправильный с точки зрения справедливости.",
                        "zh": "指不平等对待他人，或不符合公正原则，在道德上是不对的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несправедливый",
                                "target_lang_sense_clarification": "нарушающий принципы справедливости"
                            },
                            {
                                "target_lang_word": "нечестный",
                                "target_lang_sense_clarification": "нарушающий правила или этические нормы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不公平",
                                "target_lang_sense_clarification": "指缺乏公正或平等"
                            },
                            {
                                "target_lang_word": "不公正",
                                "target_lang_sense_clarification": "指违背正义或道德原则"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "272751c7-de15-3cc6-9fa9-108d3b730e0b",
                    "sense_definition": "Lacking beauty or attractiveness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old poem, the witch was described as <w>unfair</w> and terrifying to behold.",
                            "target_lang_translations": {
                                "ru": "В старой поэме ведьма описывалась как <w>безобразная</w> и ужасающая на вид.",
                                "zh": "在那首古诗中，女巫被描述为<w>丑陋</w>且令人望而生畏。"
                            }
                        },
                        {
                            "text": "He feared that the scar would make his face <w>unfair</w> to those who looked upon him.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что шрам сделает его лицо <w>некрасивым</w> для тех, кто на него смотрит.",
                                "zh": "他担心那道伤疤会让他人在看他时觉得他的脸<w>不美</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unattractive",
                        "ugly",
                        "uncomely"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный красоты или привлекательности (устаревшее значение).",
                        "zh": "缺乏美感或吸引力（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "некрасивый",
                                "target_lang_sense_clarification": "лишенный внешней привлекательности"
                            },
                            {
                                "target_lang_word": "безобразный",
                                "target_lang_sense_clarification": "уродливый, отталкивающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不美",
                                "target_lang_sense_clarification": "指缺乏外在美感"
                            },
                            {
                                "target_lang_word": "丑陋",
                                "target_lang_sense_clarification": "指外貌令人不悦"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ac45b04-dd96-3c8f-b1d3-13480ad59d01",
                    "sense_definition": "To cause someone or something to lose their beauty or become ugly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote that time would eventually <w>unfair</w> her youthful beauty.",
                            "target_lang_translations": {
                                "ru": "Поэт писал, что время в конце концов <w>лишит красоты</w> её юную прелесть.",
                                "zh": "诗人写道，时间终将<w>夺去</w>她青春的美貌。"
                            }
                        },
                        {
                            "text": "Sorrow and hardship did <w>unfair</w> her face more than age ever could.",
                            "target_lang_translations": {
                                "ru": "Горе и лишения <w>обезобразили</w> её лицо больше, чем когда-либо могла бы старость.",
                                "zh": "悲伤和苦难比岁月更能<w>毁掉</w>她的容颜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Found in Shakespearean and literary texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать кого-либо или что-либо красоты; делать уродливым (устаревшее значение).",
                        "zh": "使某人或某物失去美感或变得丑陋（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезображивать",
                                "target_lang_sense_clarification": "делать некрасивым, портить внешность"
                            },
                            {
                                "target_lang_word": "лишать красоты",
                                "target_lang_sense_clarification": "отнимать привлекательность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使变丑",
                                "target_lang_sense_clarification": "导致失去美貌"
                            },
                            {
                                "target_lang_word": "毁容",
                                "target_lang_sense_clarification": "指破坏面容的完整或美观"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}