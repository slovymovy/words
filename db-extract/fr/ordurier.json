                        "sense_id": "1a0c90ba-1856-32d8-be6f-829fe6224fe3",
                        "entry_id": "b5574943-4222-346b-bdfa-ca1295369c3d",
                        "glosses": [
                            "Qui se plaît à dire ou à écrire des choses grossières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903a5320-9685-4480-9d21-7037c122693d",
                                "sense_id": "1a0c90ba-1856-32d8-be6f-829fe6224fe3",
                                "text": "Un auteur, un écrivain ordurier."
                            },
                            {
                                "example_id": "5de28ae7-dbec-4bc0-8cf6-e8fbeae67f2c",
                                "sense_id": "1a0c90ba-1856-32d8-be6f-829fe6224fe3",
                                "text": "Un conte ordurier."
                            },
                            {
                                "example_id": "8105c10c-b501-4435-8ad3-a001d64691b8",
                                "sense_id": "1a0c90ba-1856-32d8-be6f-829fe6224fe3",
                                "text": "Des chansons ordurières."
                            },
                            {
                                "example_id": "a004564a-cb2e-406b-a4af-0a9864f006c8",
                                "sense_id": "1a0c90ba-1856-32d8-be6f-829fe6224fe3",
                                "text": "Propos orduriers."
                            },
                            {
                                "example_id": "5aa099d3-565e-4576-b0fe-8e73b0d01477",
                                "sense_id": "1a0c90ba-1856-32d8-be6f-829fe6224fe3",
                                "text": "L’ingratitude de la Sarriette acheva d’aigrir madame Lecœur, qui la traitait avec une furie de paroles ordurières."
                            },
                            {
                                "example_id": "abec5d83-94c8-478f-90a0-3ecc76d937d8",
                                "sense_id": "1a0c90ba-1856-32d8-be6f-829fe6224fe3",
                                "text": "Parce qu’ils attendent paradoxalement moins de réponses que les caresses, les mots orduriers sont toujours plus stéréotypés et tiennent peut-être leur pouvoir d’appartenir précisément au plus immuable des patrimoines."
                            }
                        ]
                    }
