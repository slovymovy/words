                "senses": [
                    {
                        "sense_id": "0a7e1dd0-8fca-34bc-86a2-32be6bd54a1e",
                        "entry_id": "7f4c45e9-d0ec-3e4a-9421-eeb7ea74e993",
                        "glosses": [
                            "die höchste Spielklasse (Liga) in einer Sportart in Deutschland und in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b031f79-69de-44a8-9ab2-d57168096b78",
                                "sense_id": "0a7e1dd0-8fca-34bc-86a2-32be6bd54a1e",
                                "text": "In der Regel wird in der Bundesliga jedes Jahr der Deutsche Meister bzw. Österreichische Meister ermittelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3116929b-3ff2-34a4-b4ec-a2638445a8f2",
                        "entry_id": "7f4c45e9-d0ec-3e4a-9421-eeb7ea74e993",
                        "glosses": [
                            "die Fußball-Bundesliga, die höchste Liga im Fußball in Deutschland und Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efcdb5e4-cbf9-40f6-a1ef-7062ead350fd",
                                "sense_id": "3116929b-3ff2-34a4-b4ec-a2638445a8f2",
                                "text": "Der Sinsheimer Stadtteil Hoffenheim ist vor allem durch seine erste Fußball-Herrenmannschaft bekannt, die seit 2008 in der Bundesliga spielt."
                            },
                            {
                                "example_id": "a4d932f4-b8f7-403a-a933-4c92885c94a0",
                                "sense_id": "3116929b-3ff2-34a4-b4ec-a2638445a8f2",
                                "text": "„Nach dieser Pleite mußte Gladbach in der Bundesliga alles geben.“"
                            },
                            {
                                "example_id": "0f32efca-2da9-4543-8d61-a78fc1e687da",
                                "sense_id": "3116929b-3ff2-34a4-b4ec-a2638445a8f2",
                                "text": "„Samstags lud er alle zu sich ein, und gemeinsam schauten sie per Satellit die Bundesliga.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
