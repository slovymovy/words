                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur la plage, nous profitions de la douce <w>caresse</w> du vent marin."
                        },
                        {
                            "text": "Les promeneurs apprécient la tiède <w>caresse</w> des premiers rayons de soleil printanier."
                        }
                    ],
                    "synonyms": [
