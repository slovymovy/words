                                    },
                                    {
                                        "sense_id": "0e1b4647-0c21-3587-aa70-d3c60fc90af6",
                                        "entry_id": "0dbc749b-b1be-3982-a2be-8d237749bf85",
                                        "glosses": [
                                            "Having lost a component, an ingredient, a faculty or a feature; rendered poor in something; depleted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c6b9608-9890-440a-94a8-5af45641ffe4",
                                                "sense_id": "0e1b4647-0c21-3587-aa70-d3c60fc90af6",
                                                "text": "English has an impoverished inflectional system."
                                            },
                                            {
                                                "example_id": "e7e1112f-4d98-409e-9d4a-179a29482440",
                                                "sense_id": "0e1b4647-0c21-3587-aa70-d3c60fc90af6",
                                                "text": "[I]t was out of print for 28 years, before an edition (now rare) was published in 1960, impoverished by having all citations removed."
                                            }
                                        ]
                                    }
                                ]
