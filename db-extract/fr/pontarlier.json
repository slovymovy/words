                        "entry_id": "ff9ef04d-f7a6-3c99-8f55-fcbef24d1a18",
                        "glosses": [
                            "Anisette produite par la distillerie Pierre Guy de Pontarlier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df47056-5e95-412f-90cc-81eb5c1c4653",
                                "sense_id": "6976ff92-d2a8-348e-9ded-8dbe3ec1d7e8",
                                "text": "Mais les traditions avaient la vie dure; les hommes se retrouvaient toujours pour une partie de quilles ou d'anneaux avant d'aller boire un pontarlier ou un kir au café."
                            },
                            {
                                "example_id": "ba0d8ef3-473a-4f0c-b0b6-24c479558681",
                                "sense_id": "6976ff92-d2a8-348e-9ded-8dbe3ec1d7e8",
                                "text": "Il avait un penchant pour le pontarlier, une sorte de pastis de son pays, là-bas, à Besac comme il disait, à Besançon, mais elle le connaissait"
                            },
                            {
                                "example_id": "b840b68b-ad36-428e-9b11-285330444a20",
                                "sense_id": "6976ff92-d2a8-348e-9ded-8dbe3ec1d7e8",
                                "text": "Il y a des pontarliers très léger."
                            }
                        ]
                    }
