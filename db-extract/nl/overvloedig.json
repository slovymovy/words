                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abondant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79ca87e5-e1d8-310b-ace0-820d1151f5d9",
                                        "entry_id": "7b9fa91c-b1e4-34b1-81a9-cda9f80b1af6",
                                        "glosses": [
                                            "Qui abonde, qui dépasse nettement en quantité ce qui est suffisant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a662c5-c67e-4fc6-af50-1808e69ae11c",
                                                "sense_id": "79ca87e5-e1d8-310b-ace0-820d1151f5d9",
                                                "text": "L’abondante littérature idyllique des professeurs de rhétorique est évidem­ment une pure vanité."
                                            },
                                            {
                                                "example_id": "9bfcbf6f-5104-41b6-aeb4-1fa445a7834f",
                                                "sense_id": "79ca87e5-e1d8-310b-ace0-820d1151f5d9",
                                                "text": "La nitratation s’opère dans des cuves en grès par 5 kilogrammes à la fois. Il se dégage d’abondantes vapeurs rutilantes qu’on récupère dans des tours de condensation."
                                            },
                                            {
                                                "example_id": "89217cdd-e48d-4b30-8cdd-079f76a81e4c",
                                                "sense_id": "79ca87e5-e1d8-310b-ace0-820d1151f5d9",
                                                "text": "La noirceur de la tourbe et des basaltes est coupée par des taches d’un gazon vert et abondant qui, bien que coriace, sert cependant de nourriture à près de 200.000 moutons sauvages, venus on ne sait d’où."
                                            },
                                            {
                                                "example_id": "d39f48af-f9c1-4f53-8323-530c79cc2648",
                                                "sense_id": "79ca87e5-e1d8-310b-ace0-820d1151f5d9",
                                                "text": "Naturellement, de tout l’hiver, le crapaud ne prend aucune nourriture. Une abondante alimentation estivale a entreposé dans son organisme quantité de matériaux nutritifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3faf051e-73dd-3998-9cf9-64f5cb0c0312",
                                        "entry_id": "7b9fa91c-b1e4-34b1-81a9-cda9f80b1af6",
                                        "glosses": [
                                            "Qui est copieux, intense."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e5a3fb-c090-4baf-9e11-cce7c5c0ad95",
                                                "sense_id": "3faf051e-73dd-3998-9cf9-64f5cb0c0312",
                                                "text": "Une récolte abondante."
                                            },
                                            {
                                                "example_id": "38fc2632-c325-4e03-a38a-0bef5ac22ff3",
                                                "sense_id": "3faf051e-73dd-3998-9cf9-64f5cb0c0312",
                                                "text": "C’est une pluie abondante."
                                            },
                                            {
                                                "example_id": "cb0542fe-8abd-4886-90c3-acf649b324bb",
                                                "sense_id": "3faf051e-73dd-3998-9cf9-64f5cb0c0312",
                                                "text": "L’Inde, en dépit de sa main-d’œuvre abondante et bon marché, n’a pas pu ou su se spécialiser dans des secteurs manufacturiers à faible contenu en compétences mais à fort contenu en emplois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bf0831-02ec-3841-8fcf-33de005d29c5",
                                        "entry_id": "7b9fa91c-b1e4-34b1-81a9-cda9f80b1af6",
                                        "glosses": [
                                            "Riche."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0167a2fe-3a3f-4ad2-b35c-2b293aa6d3e5",
                                                "sense_id": "e1bf0831-02ec-3841-8fcf-33de005d29c5",
                                                "text": "Une langue abondante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c047d260-ae12-3152-ac82-a9ab3d88ca07",
                                        "entry_id": "7b9fa91c-b1e4-34b1-81a9-cda9f80b1af6",
                                        "glosses": [
                                            "Aux formes généreuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b424d7-0444-4c48-b4b1-012b5822f60c",
                                                "sense_id": "c047d260-ae12-3152-ac82-a9ab3d88ca07",
                                                "text": "Et, pour être juste, elle avait de quoi plaire, telle qu’elle était, robuste, la poitrine abondante, le teint encore assez frais bien que hâlé par le grand air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb46192-ca7f-3f5c-ac7a-6d5e6ca96924",
                                        "entry_id": "7b9fa91c-b1e4-34b1-81a9-cda9f80b1af6",
                                        "glosses": [
                                            "Prolixe."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "note": "Souvent péjoratif pour indiquer une production exagérée où la qualité n’est pas le critère principal",
                                        "examples": [
                                            {
                                                "example_id": "e825c733-5a5e-43b6-b3ac-0bfc32ff4412",
                                                "sense_id": "ceb46192-ca7f-3f5c-ac7a-6d5e6ca96924",
                                                "text": "En apparence, ce turbulent apôtre des lumières fait contraste avec ses ancêtres confits en dévotion et abondants en patenôtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57509c4b-f4de-3581-b647-f6825cbc6b31",
                                        "entry_id": "7b9fa91c-b1e4-34b1-81a9-cda9f80b1af6",
                                        "glosses": [
                                            "Nombre abondant : Nombre entier naturel dont la somme des diviseurs excède son double."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd583a97-43f4-4964-a9c6-c5d160e9483d",
                                                "sense_id": "57509c4b-f4de-3581-b647-f6825cbc6b31",
                                                "text": "12, 18, 20 sont des nombres abondants."
                                            }
                                        ]
                                    }
                                ]
                            },
