                ],
                "senses": [
                    {
                        "sense_id": "af6db1e5-fc26-3aa3-a5dd-13146a631d3c",
                        "entry_id": "80259a8c-dcbd-36ab-b782-6be6f10aef18",
                        "glosses": [
                            "A very righteous person, especially a Hassidic spiritual leader."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "9f9c761f-6c0e-4b07-943c-6e743fc735d6",
                                "sense_id": "af6db1e5-fc26-3aa3-a5dd-13146a631d3c",
                                "text": "For in dreams one thinks with the eyes and the ears; speech has no nouns, just verbs; only in dreams is every person a zaddik, never a murderer…."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8417fbc-1e73-41f0-a5fc-0a613a1957ea",
                        "source_entry_id": "80259a8c-dcbd-36ab-b782-6be6f10aef18",
                        "source_sense_id": "af6db1e5-fc26-3aa3-a5dd-13146a631d3c",
                        "source_sense_description": "a very righteous person",
                        "target_lang_word": "cadik",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadik",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f06972b8-2dd2-3a5b-9ab0-6d8f052f65af",
                                        "entry_id": "243e0136-2afe-3bb4-a10a-b9cf6c6be379",
                                        "glosses": [
                                            "chasidský rabín považovaný za světce"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dbc34f5-7f51-412c-8394-e033d2d54aef",
                                                "sense_id": "f06972b8-2dd2-3a5b-9ab0-6d8f052f65af",
                                                "text": "Jistý cadik vstával vždy časně zrána, vyhlédl z okna a s údivem zvolal: „Ještě před chvilkou byla noc a najednou je den – Bůh nám dává den!“"
                                            },
                                            {
                                                "example_id": "ef14509d-8595-4a8e-bc44-d041f79879c8",
                                                "sense_id": "f06972b8-2dd2-3a5b-9ab0-6d8f052f65af",
                                                "text": "O jednom cadikovi se říkalo: „U něj je nauka i modlitba, jídlo i spánek jedním, a proto pozvedá svou duši k jejímu kořeni.“"
                                            },
                                            {
                                                "example_id": "4b794bf8-afb9-4bac-9095-4b6ad0dc84d3",
                                                "sense_id": "f06972b8-2dd2-3a5b-9ab0-6d8f052f65af",
                                                "text": "Vidíme zde cadika, moudrého, zbožného, mocného muže, jak si ve dnech stáří dělá výčitky, že ještě nevykonal pravé obrácení."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfb38187-a24b-429e-82c2-a230d48dda0c",
                        "source_entry_id": "80259a8c-dcbd-36ab-b782-6be6f10aef18",
                        "source_sense_id": "af6db1e5-fc26-3aa3-a5dd-13146a631d3c",
                        "source_sense_description": "a very righteous person",
                        "target_lang_word": "Zaddik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zaddik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7ec74b-a27e-39c7-83c9-d86e94641e38",
                                        "entry_id": "384bc3e8-60fd-3702-b35f-bad5e522dab8",
                                        "glosses": [
                                            "(als heilig verehrter) chassidischer Lehrer"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b22163-d3ad-4f32-b31f-a86b6e3a9069",
                                                "sense_id": "2e7ec74b-a27e-39c7-83c9-d86e94641e38",
                                                "text": "„Der große chassidische Zaddik (Heilige) hatte sich als eine Art protozionistischer Pilger ins Heilige Land aufgemacht und auf eine Tikkun (Restauration) gesetzt.“"
                                            },
                                            {
                                                "example_id": "a548022d-a932-4d27-84dc-5921c97eeaf3",
                                                "sense_id": "2e7ec74b-a27e-39c7-83c9-d86e94641e38",
                                                "text": "„Die Chassidim schlossen sich zu Gemeinden zusammen, die einem geistlichen Meister, dem Zaddik, dem Gerechten, huldigten.[…]Sadagora war eine Hochburg der Chassidim und inmitten dieses armen Städtchens stand der prunkvollste aller Höfe, den sich je ein Zaddik, ein Wunderrabbi, hat leisten können, ein jüdisches „Adelsschloss\", hat es der jiddische Dichter Nathan Birnbaum genannt.“"
                                            },
                                            {
                                                "example_id": "aee3f6d3-36ea-40d6-acba-3c0884850ea5",
                                                "sense_id": "2e7ec74b-a27e-39c7-83c9-d86e94641e38",
                                                "text": "„Roman - mit kurzen Bewegungen von der Hüfte ab vor und zurück schnellend, ein Zaddik, ein Wunderrabbiner, an der Klagemauer zu Jerusalem, die Augen geschlossen, die Lippen gespitzt vorgeschoben zum Kusse auf den Tempelstein, ein hingerissen Betender, auch er immer wieder mit der Rechten aufs Haar greifend, um das Taschentuch oben zu behalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
