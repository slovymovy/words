    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "60047127-901c-3460-afaf-f8ff1f3ca2de",
                "word": "meantime",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                        "entry_id": "60047127-901c-3460-afaf-f8ff1f3ca2de",
                        "glosses": [
                            "During the interval; meanwhile."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6bdb12ad-7e5c-435b-beff-6fc10bf66a78",
                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                "text": "Repairs will be done tomorrow so meantime restrain from using the bath."
                            },
                            {
                                "example_id": "5baf04b6-459e-4adf-b744-062c3d3dbf5b",
                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                "text": "Meantime Pope Urban II convoked two councils, one after another."
                            },
                            {
                                "example_id": "2d70673c-bc7c-498a-ad6a-7d5476aaa0e2",
                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                "text": "Lunch will be in twenty minutes. Meantime: I have[…]"
                            },
                            {
                                "example_id": "7c75ef10-cb6e-42e2-8080-510bf6afffb1",
                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                "text": "Meantime, the train went on to Brighton without further incident. No small stir was caused by its arrival with No. 61 at its head, resplendent with \"East London Line Special\" head boards, which at once caught the eye of William Stroudley, who was observing the traffic working from his office window."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61d88b37-87fe-41d0-9b57-f4d4242e5420",
                        "source_entry_id": "60047127-901c-3460-afaf-f8ff1f3ca2de",
                        "source_sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                        "source_sense_description": "meanwhile",
                        "target_lang_word": "unterdessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterdessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                        "entry_id": "54fd7e95-0f92-3d1a-9fd5-9c87df442c85",
                                        "glosses": [
                                            "im selben Zeitraum wie ein anderer Vorgang stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a2e9e8-a5df-427d-8043-3ac5ee83c6f8",
                                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                                "text": "Ich erledigte wichtige Korrespondenz. Unterdessen verwüstete meine kleine Tochter die gesamte Wohnung."
                                            },
                                            {
                                                "example_id": "1c863fae-86f7-4865-a1cb-e40c1381366c",
                                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                                "text": "„Unterdessen stand in Davos der Sonderzug für den Sarg bereit.“"
                                            },
                                            {
                                                "example_id": "3f592b09-ab4e-440e-b24b-1410403c4373",
                                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                                "text": "„Ich watete durch Schneematsch und kämpfte gegen den Sturm, unterdessen überschüttete mich der Verkehr auf der Nördlichen Ringstraße mit Widerwärtigkeiten.“"
                                            },
                                            {
                                                "example_id": "73f35aff-aab4-4df8-b556-86f6abb963d3",
                                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                                "text": "„Während sich unsere Kavalkade in Richtung auf die Berge in Bewegung setzte, gesellte ich mich zu Vanderbrecken und ließ mir von ihm erzählen, was sich unterdessen ereignet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
