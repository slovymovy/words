                                    {
                                        "sense_id": "e2aecdfb-9ca5-3073-b4cc-1183c54e9500",
                                        "entry_id": "1776010f-ecad-3cbc-b958-aea9dd2879e3",
                                        "glosses": [
                                            "Aligned or connected side by side, instead of end to end."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74d136e1-c585-4f69-ba0e-1a1c59a32399",
                                                "sense_id": "e2aecdfb-9ca5-3073-b4cc-1183c54e9500",
                                                "text": "The total resistance of two resistors connected in parallel is easily calculated using a simple formula."
