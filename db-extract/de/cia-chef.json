                "senses": [
                    {
                        "sense_id": "c8506930-711c-3d13-96c4-3cc0990dfd40",
                        "entry_id": "7e7aa73d-8eb1-3d06-ad97-8d772b824cbf",
                        "glosses": [
                            "Leiter des US-amerikanischen Auslandsnachrichtendienstes CIA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4466bb76-e083-41b5-9ecc-5727a8f5b965",
                                "sense_id": "c8506930-711c-3d13-96c4-3cc0990dfd40",
                                "text": "„Präsident Eisenhower forderte den CIA-Chef zu einer Stellungnahme auf.“"
                            },
                            {
                                "example_id": "79accada-66fd-45a1-985e-35867085ba68",
                                "sense_id": "c8506930-711c-3d13-96c4-3cc0990dfd40",
                                "text": "„Obendrein stimmten die Morde oft mit neuesten Erkenntnissen überein, die Centra Spike an CIA-Chef Wagner übermittelte, der sie an den Fahndungsblock weitergab.“"
                            },
                            {
                                "example_id": "e4746680-cbb7-45e6-84d4-3f39f1b02ed1",
                                "sense_id": "c8506930-711c-3d13-96c4-3cc0990dfd40",
                                "text": "„General Akhtars Büro sah aus wie das jedes höheren Beamten, der an der Spitze der Macht steht. Ein riesiger Schreibtisch mit fünf Telefonen und einer Nationalflagge, ein gerahmtes Foto von ihm und Bill Casey, auf dem der General dem lachenden CIA-Chef die Hülle der ersten Stinger-Rakete präsentiert, die einen russischen Hind abgeschossen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
