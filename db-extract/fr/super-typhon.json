                        "examples": [
                            {
                                "example_id": "61475b4f-5fc9-40be-a4c7-afad9597559a",
                                "sense_id": "17d4c9e3-ba0c-339d-a37d-75f59f8d6aaa",
                                "text": "Le « super-typhon » Usagi, la plus puissante tempête tropicale de l’année, fouette les Philippines et Taïwan de pluies torrentielles et de rafales de vent, déracinant des arbres et provoquant des pannes de courant, tout en menaçant Hong Kong."
                            },
                            {
                                "example_id": "9ffce617-d18f-4127-8a75-59c704f47630",
                                "sense_id": "17d4c9e3-ba0c-339d-a37d-75f59f8d6aaa",
                                "text": "Si le pays se préparait depuis plusieurs jours à l’arrivée du super-typhon, les dégâts matériels sont pour le moins importants."
                            },
                            {
                                "example_id": "efb37f08-04da-4386-a1fa-f7a22bb66009",
                                "sense_id": "17d4c9e3-ba0c-339d-a37d-75f59f8d6aaa",
                                "text": "Le super-typhon, le plus puissant cette année, s'est abattu vers 4h50 locale aux Philippines où les autorités font état de conditions catastrophiques, après avoir évacué près d'un million d'habitants, en prévision d'inondations et de vents destructeurs."
                            }
                        ]
                    }
