{
    "word_family": [
        "cataloguer",
        "cataloguing",
        "subcatalogue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0406095-acc6-3ff0-b108-6badb8bb0845",
                    "sense_definition": "A magazine or book published by a retailer that shows products for sale, often allowing customers to order them for delivery.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "listing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent the whole evening looking through the clothing <w>catalogue</w> to find a new winter coat.",
                            "target_lang_translations": {
                                "ru": "Я провел весь вечер, просматривая <w>каталог</w> одежды, чтобы найти новое зимнее пальто."
                            }
                        },
                        {
                            "text": "You can order the furniture directly from the mail-order <w>catalogue</w> without visiting the store.",
                            "target_lang_translations": {
                                "ru": "Вы можете заказать мебель прямо через <w>каталог</w> почтовых заказов, не посещая магазин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mail-order catalogue",
                        "clothing catalogue",
                        "christmas catalogue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Журнал или книга, издаваемая розничным продавцом, в которой представлены товары для продажи, часто с возможностью заказа с доставкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катало́г",
                                "target_lang_sense_clarification": "рекламный журнал с продукцией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6db15e8-63c8-3f4d-a073-f954824ebe0a",
                    "sense_definition": "A complete and systematic list of items, such as books in a library or paintings in a gallery, usually arranged in alphabetical or chronological order.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "listing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The librarian showed me how to search the online <w>catalogue</w> for the book I needed.",
                            "target_lang_translations": {
                                "ru": "Библиотекарь показал мне, как искать нужную книгу в электронном <w>каталоге</w>."
                            }
                        },
                        {
                            "text": "The museum published a full exhibition <w>catalogue</w> featuring all the works on display.",
                            "target_lang_translations": {
                                "ru": "Музей опубликовал полный <w>каталог</w> выставки, в котором представлены все экспонируемые работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "list"
                    ],
                    "common_phrases": [
                        "online catalogue",
                        "library catalogue",
                        "exhibition catalogue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный и систематический список предметов, таких как книги в библиотеке или картины в галерее, обычно расположенный в алфавитном или хронологическом порядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катало́г",
                                "target_lang_sense_clarification": "упорядоченный список предметов"
                            },
                            {
                                "target_lang_word": "спи́сок",
                                "target_lang_sense_clarification": "перечень чего-либо"
                            },
                            {
                                "target_lang_word": "пе́речень",
                                "target_lang_sense_clarification": "систематизированный список"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1229270-782e-3d53-a611-defb5a9c4267",
                    "sense_definition": "The complete collection of works or recordings produced by a specific artist, musician, or composer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "listing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer sold her entire back <w>catalogue</w> to a major music publishing company.",
                            "target_lang_translations": {
                                "ru": "Певица продала весь свой старый <w>каталог</w> записей крупной музыкальной издательской компании."
                            }
                        },
                        {
                            "text": "His entire <w>catalogue</w> of songs is now available on all streaming platforms.",
                            "target_lang_translations": {
                                "ru": "Весь его <w>каталог</w> песен теперь доступен на всех стриминговых платформах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "back catalogue",
                        "entire catalogue",
                        "music catalogue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полное собрание произведений или записей, созданных конкретным художником, музыкантом или композитором."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катало́г",
                                "target_lang_sense_clarification": "собрание всех работ артиста"
                            },
                            {
                                "target_lang_word": "дискогра́фия",
                                "target_lang_sense_clarification": "в контексте музыкантов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7f13291-243a-3410-a161-f65744aa023a",
                    "sense_definition": "A series or sequence of many unpleasant or unwelcome events.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project failed due to a <w>catalogue</w> of errors made by the management team.",
                            "target_lang_translations": {
                                "ru": "Проект провалился из-за <w>череды</w> ошибок, допущенных руководством."
                            }
                        },
                        {
                            "text": "The report detailed a <w>catalogue</w> of disasters that led to the environmental crisis.",
                            "target_lang_translations": {
                                "ru": "В отчете подробно описывается <w>целый ряд</w> катастроф, приведших к экологическому кризису."
                            }
                        }
                    ],
                    "common_phrases": [
                        "catalogue of errors",
                        "catalogue of disasters",
                        "catalogue of failures"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия или последовательность многих неприятных или нежелательных событий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "череда́",
                                "target_lang_sense_clarification": "последовательность событий"
                            },
                            {
                                "target_lang_word": "це́лая верени́ца",
                                "target_lang_sense_clarification": "длинный ряд неприятностей"
                            },
                            {
                                "target_lang_word": "спи́сок",
                                "target_lang_sense_clarification": "перечень (ошибок, неудач)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5dc592e-c147-3557-a691-eb65cb660f2d",
                    "sense_definition": "A list of files or data entries stored on a computer disk or storage medium.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "listing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software automatically generates a disk <w>catalogue</w> to help users organize their files.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение автоматически создает <w>каталог</w> диска, чтобы помочь пользователям организовать свои файлы."
                            }
                        },
                        {
                            "text": "The system failed to read the file <w>catalogue</w> from the corrupted cartridge.",
                            "target_lang_translations": {
                                "ru": "Системе не удалось прочитать <w>каталог</w> файлов с поврежденного картриджа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disk catalogue",
                        "file catalogue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Список файлов или записей данных, хранящихся на компьютерном диске или носителе информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катало́г",
                                "target_lang_sense_clarification": "раздел носителя информации, хранилище файлов"
                            },
                            {
                                "target_lang_word": "директо́рия",
                                "target_lang_sense_clarification": "компьютерная папка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1abc3506-e29b-39a9-8531-ebc70d9a79fd",
                    "sense_definition": "To create a systematic list of items or to record things in a list.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "listing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers spent months trying to <w>catalogue</w> the collection of rare plants found in the rainforest.",
                            "target_lang_translations": {
                                "ru": "Исследователи потратили месяцы, пытаясь <w>каталогизировать</w> коллекцию редких растений, найденных в тропическом лесу."
                            }
                        },
                        {
                            "text": "It is important to <w>catalogue</w> carefully every artifact found at the archaeological site.",
                            "target_lang_translations": {
                                "ru": "Важно тщательно <w>заносить в каталог</w> каждый артефакт, найденный на месте археологических раскопок."
                            }
                        }
                    ],
                    "synonyms": [
                        "list",
                        "enlist"
                    ],
                    "common_phrases": [
                        "catalogue the collection",
                        "catalogue carefully"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать систематический список предметов или записывать вещи в список."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каталогизи́ровать",
                                "target_lang_sense_clarification": "составлять каталог"
                            },
                            {
                                "target_lang_word": "заноси́ть в катало́г",
                                "target_lang_sense_clarification": "регистрировать в списке"
                            },
                            {
                                "target_lang_word": "систематизи́ровать",
                                "target_lang_sense_clarification": "приводить в систему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f6b959-482c-38a0-a98d-2c5d0ddf7b57",
                    "sense_definition": "To add new items to an existing list or database.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "listing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new acquisitions must be <w>catalogued</w> alphabetically before they can be placed on the library shelves.",
                            "target_lang_translations": {
                                "ru": "Новые поступления должны быть <w>каталогизированы</w> в алфавитном порядке, прежде чем их можно будет разместить на библиотечных полках."
                            }
                        },
                        {
                            "text": "The assistant will <w>catalogue</w> new items as they arrive at the warehouse.",
                            "target_lang_translations": {
                                "ru": "Ассистент будет <w>вносить в каталог</w> новые товары по мере их поступления на склад."
                            }
                        }
                    ],
                    "synonyms": [
                        "put down"
                    ],
                    "common_phrases": [
                        "catalogue alphabetically",
                        "catalogue new items"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять новые элементы в существующий список или базу данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вноси́ть в катало́г",
                                "target_lang_sense_clarification": "добавлять в список"
                            },
                            {
                                "target_lang_word": "регистри́ровать",
                                "target_lang_sense_clarification": "записывать новые поступления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}