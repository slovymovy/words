{
    "word_family": [
        "hochement",
        "hochet",
        "hochequeue",
        "hoche"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b6c99d8-e1a0-3694-a856-addf22f18059",
                    "sense_definition": "Remuer ou secouer, particulièrement la tête, de haut en bas ou de gauche à droite pour marquer un sentiment ou un signe d'assentiment ou de doute.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il écoutait son ami attentivement sans dire un mot, se contentant de <w>hocher</w> la tête."
                        },
                        {
                            "text": "Elle <w>hocha</w> la tête avec lenteur pour indiquer qu'elle comprenait parfaitement le problème."
                        }
                    ],
                    "synonyms": [
                        "secouer",
                        "remuer"
                    ],
                    "common_phrases": [
                        "hocher la tête"
                    ]
                },
                {
                    "sense_id": "5e5068dc-086e-3b00-8894-df1c6aa348bf",
                    "sense_definition": "Secouer vigoureusement un arbre fruitier pour faire tomber ses fruits mûrs.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'automne, les fermiers allaient <w>hocher</w> les pommiers pour récolter les fruits destinés au cidre."
                        },
                        {
                            "text": "Ils ont <w>hoché</w> les branches du verger pour faire choir les mirabelles sur de grandes toiles."
                        }
                    ],
                    "synonyms": [
                        "secouer",
                        "gauler"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Normandie, Lorraine"
                        }
                    ]
                },
                {
                    "sense_id": "59169127-44a3-3422-b7e7-d2e85e5d8677",
                    "sense_definition": "Marquer d'une entaille pour faire une encoche ou tenir un compte.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le meunier prenait soin de <w>hocher</w> chaque morceau de bois pour noter les sacs livrés."
                        },
                        {
                            "text": "L'artisan <w>hocha</w> le bâtonnet à l'aide d'un canif pour garder une trace chiffrée."
                        }
                    ],
                    "synonyms": [
                        "cocher",
                        "entailler"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "8d817d2d-4269-38b7-820d-c24ed74c77da",
                    "sense_definition": "Faire une petite entaille sur le bord d'une pièce de tissu pour servir de repère d'assemblage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière devait <w>hocher</w> le patron avant d'entamer l'assemblage minutieux de la robe."
                        },
                        {
                            "text": "Il faut <w>hocher</w> légèrement la lisière de l'étoffe pour marquer l'emplacement exact de la couture."
                        }
                    ],
                    "synonyms": [
                        "cranter",
                        "entailler"
                    ]
                }
            ]
        }
    ]
}