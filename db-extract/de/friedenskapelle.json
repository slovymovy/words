                ],
                "senses": [
                    {
                        "sense_id": "c6f24abb-18d8-368e-b919-e9c91bc254f2",
                        "entry_id": "df86287e-f61a-378e-a3a4-d35b562c5087",
                        "glosses": [
                            "im kirchlichen Stil gestaltete, kleine Kapelle, die für Andachten zum Gedenken an den Frieden erbaut wurde und auch für Gottesdienste genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d456d5c8-efce-4304-b5fa-28f709d6a077",
                                "sense_id": "c6f24abb-18d8-368e-b919-e9c91bc254f2",
                                "text": "„Die Friedenskapelle ist ein Gemeinschaftsprojekt der beiden örtlichen Kolpingfamilien in Kooperation mit einem eigens gegründeten Bauverein.“"
                            },
                            {
                                "example_id": "57f4ce8e-cc98-433b-8825-2c17e2cfbb93",
                                "sense_id": "c6f24abb-18d8-368e-b919-e9c91bc254f2",
                                "text": "„Die Friedenskapelle dient unserer Gemeinde sowohl für Gottesdienste als auch für diverse Aktivitäten der Familienarbeit.“"
                            },
                            {
                                "example_id": "3bd1f885-5d7c-41a0-890d-dc972e791dbf",
                                "sense_id": "c6f24abb-18d8-368e-b919-e9c91bc254f2",
                                "text": "„Zum zehnjährigen Bestehen der Friedenskapelle als Veranstaltungsraum im vorigen Jahr wurde die Auslastung um mehr als zehn Prozent auf 80 Prozent gesteigert.“"
                            },
                            {
                                "example_id": "bec7a817-84c8-40bf-a8bf-327b944624ba",
                                "sense_id": "c6f24abb-18d8-368e-b919-e9c91bc254f2",
                                "text": "„Die Friedenskapelle wurde gebaut, um einen Ort der Stille, der Besinnung und des Gebetes zu schaffen. Sie ist ökumenisch ausgerichtet, im Geiste von Taizé.“"
                            },
                            {
                                "example_id": "50b5b5d4-7eff-4407-96d9-37fc19d191ab",
                                "sense_id": "c6f24abb-18d8-368e-b919-e9c91bc254f2",
                                "text": "„Der Architekt Jürgen von Reuß, er plant Rossoschka seit 1994, hat eine überzeugende Skizze entwickelt, ein geeigneter Standort wurde gefunden, die Kirchen, insbesondere auch die russisch-orthodoxe Kirche, die Stadt und die Gebietskörperschaften, auf deren Grundstück die Friedenskapelle gebaut werden soll, und die russischen Veteranen unterstützen das Projekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
