            "senses": [
                {
                    "sense_id": "4e012869-0367-3a79-af6d-d74a8bf5d85a",
                    "sense_definition": "Grote zoetwaterroofvis met baarddraden rond de bek, in het bijzonder de soort Silurus glanis.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser ving een enorme <w>meerval</w> in de diepe rivier.",
                            "target_lang_translations": {
                                "ru": "Рыбак поймал огромного <w>сома</w> в глубокой реке."
                            }
                        },
                        {
                            "text": "In dit meer leeft een grote populatie van de Europese <w>meerval</w>.",
                            "target_lang_translations": {
                                "ru": "В этом озере обитает большая популяция европейского <w>сома</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Europese meerval"
                    ],
                    "common_phrases": [
                        "Europese meerval"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная пресноводная хищная рыба с усами вокруг рта, в частности вид Silurus glanis (обыкновенный сом)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сом",
                                "target_lang_sense_clarification": "обыкновенный или европейский сом (Silurus glanis)"
                            },
                            {
                                "target_lang_word": "европейский сом",
                                "target_lang_sense_clarification": "биологический вид Silurus glanis"
                            },
                            {
                                "target_lang_word": "обыкновенный сом",
                                "target_lang_sense_clarification": "биологический вид Silurus glanis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22d4f882-0431-3a79-8273-575fda811653",
                    "sense_definition": "Verzamelnaam voor straalvinnige vissen behorend tot de orde Siluriformes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel soorten <w>meerval</w> zijn nachtactief en speuren de bodem af met hun tasters.",
                            "target_lang_translations": {
                                "ru": "Многие виды <w>сомов</w> активны ночью и обследуют дно с помощью усов."
                            }
                        },
                        {
                            "text": "<w>Meervallen</w> zijn roofvissen die voorkomen in heel Eurazië.",
                            "target_lang_translations": {
                                "ru": "<w>Сомы</w> — это хищные рыбы, обитающие по всей Евразии."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее название лучепёрых рыб отряда сомообразных (Siluriformes)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сом",
