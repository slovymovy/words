                    {
                        "form_id": "c3c410e8-93a1-41b4-8b8c-7e9c84de2e6d",
                        "entry_id": "06c34173-cd4b-357d-9398-0f2e705c1468",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hochämter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11801f02-98f5-3021-8b17-be050f9dbad7",
                        "entry_id": "06c34173-cd4b-357d-9398-0f2e705c1468",
                        "glosses": [
                            "feierliche Form der Eucharistiefeier (Missa solemnis)"
                        ],
                        "tags": [
                            "katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "937a1c39-0148-4a59-abbb-0cd78177d1f8",
                                "sense_id": "11801f02-98f5-3021-8b17-be050f9dbad7",
                                "text": "Die Unterscheidung zwischen dem Hochamt und anderen Formen der Messfeier (Singmesse, stille Messe) spielt besonders in der Liturgie vor dem Zweiten Vatikanischen Konzil eine Rolle."
                            },
                            {
                                "example_id": "c4c78bfd-8c6a-476e-b939-5ef834343f71",
                                "sense_id": "11801f02-98f5-3021-8b17-be050f9dbad7",
                                "text": "„Vielleicht erzählte ich Skral an diesem Nachmittag noch, daß meine Mutter mich jeden Sonntag zum Hochamt in die Kirche zerrte.“"
                            },
                            {
                                "example_id": "96b186e3-4b89-4d17-a873-2732f085537f",
                                "sense_id": "11801f02-98f5-3021-8b17-be050f9dbad7",
                                "text": "„Nach dem Hochamt passte ich ihn vor der Kirchentür ab.“"
                            },
                            {
                                "example_id": "cba15549-46f7-4071-af1d-69e4b31b0dbf",
                                "sense_id": "11801f02-98f5-3021-8b17-be050f9dbad7",
                                "text": "„Als aber am Sonntag nach dem Hochamt der Diener im Salon meldete, Graf Rostow sei da, liess die Prinzessin sich doch keine Verwirrung oder Verlegenheit anmerken; nur eine leichte Röte trat ihr auf die Wangen, und ihre Augen gewannen einen neuen, leuchtenden Glanz.“"
                            },
                            {
                                "example_id": "cc6a294d-3fd3-48e3-b857-2eed17adbc83",
                                "sense_id": "11801f02-98f5-3021-8b17-be050f9dbad7",
                                "text": "„Zur üblichen Alltagsbetriebsamkeit an den Seitenaltären großer Kirchen kamen die feierlichen Sonntagsmessen und die feierlichen Hochämter an den Prunktagen des Kirchenjahrs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f5fd45e-6ea5-3cc5-afef-306b75d98a64",
                        "entry_id": "06c34173-cd4b-357d-9398-0f2e705c1468",
                        "glosses": [
                            "besonders wichtiges oder herausragendes Ereignis; besonders wichtige oder herausragende Veranstaltung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "4460ad87-53e1-4413-94d4-ba9961847a61",
                                "sense_id": "4f5fd45e-6ea5-3cc5-afef-306b75d98a64",
                                "text": "„In der nächsten Woche folgt in Berlin der CDU-Parteitag, nicht als Ort der Selbstzerknirschung, sondern mehr denn je als Hochamt geplant.“"
                            },
                            {
                                "example_id": "bfb2ceee-ecfa-4edc-a3fe-7004eeb3046f",
                                "sense_id": "4f5fd45e-6ea5-3cc5-afef-306b75d98a64",
                                "text": "„Premieren mit dem früheren Countertenor René Jacobs am Pult sind musikalische Hochämter.“"
                            },
                            {
                                "example_id": "56cdf265-0ebe-4fb1-8909-c9f1d8787ff7",
                                "sense_id": "4f5fd45e-6ea5-3cc5-afef-306b75d98a64",
                                "text": "„Das zweitägige Schinkenfest, ein fresskulturelles Hochamt für den lokal produzierten ‚Vulcano‘-Schinken, hat heuer 10.000 Vulkanier nach Auersbach gelockt.“"
                            },
                            {
                                "example_id": "89b9cede-37cf-4ee4-8c74-0007942ef3e2",
                                "sense_id": "4f5fd45e-6ea5-3cc5-afef-306b75d98a64",
                                "text": "„‚Wetten dass…?‘ war auch ein Hochamt der bürgerlichen Tugend, hart an sich zu arbeiten und eine Sache perfekt zu können.“"
                            },
                            {
                                "example_id": "bbac8f7b-89c0-4efb-bc76-36ffa6db8132",
                                "sense_id": "4f5fd45e-6ea5-3cc5-afef-306b75d98a64",
                                "text": "„Zu der neuen Linie passt, dass Trump demnächst zum Hochamt der von Bannon so verhassten ‚Globalisten‘, dem Weltwirtschaftsforum in Davos, reisen will.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
