                    "frequency": "Low",
                    "semantic_group_id": "fete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses amis d'enfance ont organisé tout un week-end pour <w>enterrer</w> sa vie de garçon."
                        },
                        {
                            "text": "Elles ont réservé un gîte pour <w>enterrer</w> joyeusement la vie de jeune fille de leur amie."
                        }
                    ],
                    "common_phrases": [
                        "enterrer sa vie de garçon",
                        "enterrer sa vie de célibataire"
                    ],
                    "traits": [
