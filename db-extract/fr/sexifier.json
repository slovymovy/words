                "senses": [
                    {
                        "sense_id": "ed70fbf6-0033-3914-b81e-510c1c8dc9ca",
                        "entry_id": "0183e13a-23c0-3125-bc22-29f6e486fe2a",
                        "glosses": [
                            "Rendre sexy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e7bf55-184c-4893-946e-a02f83d207e8",
                                "sense_id": "ed70fbf6-0033-3914-b81e-510c1c8dc9ca",
                                "text": "À se demander s’ils ne sont pas recrutés précisément par ces industriels pour sexifier le libre-échange (enjeu globaux, réponses globales), faire beaucoup de mousse autour du réchauffement et ainsi détourner notre attention surinvestie des véritables enjeux : ceux qui nous pendent au nez."
                            },
                            {
                                "example_id": "06f168ee-fac7-41a6-a841-7b5c713fa7b7",
                                "sense_id": "ed70fbf6-0033-3914-b81e-510c1c8dc9ca",
                                "text": "De manière récurrente, ils sont obligés de sexifier l'insexifiable."
                            },
                            {
                                "example_id": "5ae7078d-d65f-4077-b380-2574602863cd",
                                "sense_id": "ed70fbf6-0033-3914-b81e-510c1c8dc9ca",
                                "text": "Je suis en phase d'écriture avancée, mais je commence déjà à peindre pour me sexifier un petit peu et garder le feu sacré sur le projet."
                            }
                        ]
                    }
