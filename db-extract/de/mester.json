                "senses": [
                    {
                        "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                        "entry_id": "6eff92f4-be15-385f-9b0d-a4cfd35d9717",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "259bd622-51af-455e-b62a-72c83b1e7b31",
                                "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                                "text": "Frau Mester ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "39b9fd4a-caee-4e0c-9511-6548e5ee9986",
                                "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                                "text": "Herr Mester wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "77f399b1-a7d7-4ba8-a69f-f83d0ab80791",
                                "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                                "text": "Die Mesters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f8871dbb-8686-48f6-bf51-925719cc222e",
                                "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                                "text": "Der Mester trägt nie die Schals, die die Mester ihm strickt."
                            },
                            {
                                "example_id": "d87630b0-c284-47bd-a3df-ec103078a7ed",
                                "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mester kommt, geht der Herr Mester.“"
                            },
                            {
                                "example_id": "413a1ee8-cae0-4e2b-b943-2583aee8744a",
                                "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                                "text": "Mester kommt und geht."
                            },
                            {
                                "example_id": "00c38c2d-f3d4-4873-9c7e-831e5f2105c7",
                                "sense_id": "3ee85b7a-e5f1-3e37-8c17-bc65f9e24217",
                                "text": "Mesters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
