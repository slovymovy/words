                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef d'orchestre exigeant fait de la précision musicale une véritable <w>religion</w> au quotidien."
