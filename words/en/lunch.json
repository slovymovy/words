{
    "word_family": [
        "luncheon",
        "lunchtime",
        "lunchbox",
        "lunchroom",
        "luncher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d94ded60-0623-397d-999e-ba086e899962",
                    "sense_definition": "A light meal usually eaten around midday, notably when not as main meal of the day.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meal_midday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We usually have <w>lunch</w> together at the cafeteria.",
                            "target_lang_translations": {
                                "ru": "Мы обычно <w>обедаем</w> вместе в кафетерии.",
                                "zh": "我们通常在食堂一起<w>吃午饭</w>。"
                            }
                        },
                        {
                            "text": "She packed a healthy <w>lunch</w> to take to work.",
                            "target_lang_translations": {
                                "ru": "Она собрала полезный <w>обед</w> с собой на работу.",
                                "zh": "她打包了一份健康的<w>午餐</w>带去上班。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have lunch",
                        "eat lunch",
                        "lunch break",
                        "go for lunch",
                        "packed lunch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прием пищи в середине дня",
                        "zh": "通常在中午左右吃的轻便餐点，通常不是一天中的主餐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "основной прием пищи в середине дня"
                            },
                            {
                                "target_lang_word": "ланч",
                                "target_lang_sense_clarification": "второй завтрак или легкий обед"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "午餐",
                                "target_lang_sense_clarification": "中午吃的正餐"
                            },
                            {
                                "target_lang_word": "午饭",
                                "target_lang_sense_clarification": "口语中常用的午间餐点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baaa2a15-bf37-3466-bed1-c30570d4c734",
                    "sense_definition": "Any small meal, especially one eaten at a social gathering.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "meal_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the meeting, there was a light <w>lunch</w> for the attendees.",
                            "target_lang_translations": {
                                "ru": "После собрания для присутствующих был легкий <w>обед</w>.",
                                "zh": "会议结束后，为与会者准备了简单的<w>便餐</w>。"
                            }
                        },
                        {
                            "text": "They served a cold <w>lunch</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "В саду подали холодный <w>обед</w>.",
                                "zh": "他们在花园里供应了冷<w>午餐</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "light lunch",
                        "buffet lunch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой прием пищи, часто во время официальных или общественных мероприятий",
                        "zh": "任何小份餐点，尤指在社交聚会上提供的餐点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "прием пищи"
                            },
                            {
                                "target_lang_word": "ланч",
                                "target_lang_sense_clarification": "легкая закуска, фуршет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便餐",
                                "target_lang_sense_clarification": "简单、非正式的餐点"
                            },
                            {
                                "target_lang_word": "茶点",
                                "target_lang_sense_clarification": "社交场合提供的轻食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22fe3a45-5354-34f7-822c-596a91584f82",
                    "sense_definition": "A break in play between the first and second sessions of a cricket match.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sport_break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players left the field for <w>lunch</w> with the score at 100.",
                            "target_lang_translations": {
                                "ru": "Игроки ушли с поля на <w>обед</w> со счетом 100.",
                                "zh": "球员们在比分达到100时离场去<w>午餐休息</w>。"
                            }
                        },
                        {
                            "text": "It began to rain just before <w>lunch</w> was taken.",
                            "target_lang_translations": {
                                "ru": "Дождь пошел как раз перед <w>обеденным перерывом</w>.",
                                "zh": "就在<w>午餐休息</w>前开始下雨了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "at lunch",
                        "lunch interval"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перерыв в игре в крикет между первой и второй сессиями",
                        "zh": "板球比赛第一阶段和第二阶段之间的休息时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеденный перерыв",
                                "target_lang_sense_clarification": "пауза в игре"
                            },
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "время приема пищи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "午餐休息",
                                "target_lang_sense_clarification": "板球比赛中的午间暂停"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61fb3a3c-3128-34b2-a6e8-3d0ad89eeedd",
                    "sense_definition": "A thin piece or hunk of bread, meat, or cheese.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "piece_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cut a <w>lunch</w> of cheese to eat with his bread.",
                            "target_lang_translations": {
                                "ru": "Он отрезал <w>кусок</w> сыра, чтобы съесть его с хлебом.",
                                "zh": "他切了<w>一块</w>奶酪配着面包吃。"
                            }
                        },
                        {
                            "text": "The farmer took a <w>lunch</w> of bread from his pocket.",
                            "target_lang_translations": {
                                "ru": "Фермер достал из кармана <w>ломоть</w> хлеба.",
                                "zh": "农夫从口袋里拿出<w>一块</w>面包当午餐。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок или ломоть хлеба, мяса или сыра",
                        "zh": "一小块面包、肉或奶酪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "часть продукта"
                            },
                            {
                                "target_lang_word": "ломоть",
                                "target_lang_sense_clarification": "большой кусок хлеба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一块",
                                "target_lang_sense_clarification": "指代食物的量词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5beee17e-678c-31b6-b976-d3553373dcbc",
                    "sense_definition": "To eat the midday meal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_eat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>lunch</w> at a small Italian restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>пообедать</w> в маленьком итальянском ресторане.",
                                "zh": "我们决定在一家意大利小餐馆<w>吃午饭</w>。"
                            }
                        },
                        {
                            "text": "He often <w>lunches</w> with his business partners.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>обедает</w> со своими деловыми партнерами.",
                                "zh": "他经常和商业伙伴一起<w>吃午饭</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lunch out",
                        "lunch with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть обед; принимать пищу в середине дня",
                        "zh": "吃午餐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обедать",
                                "target_lang_sense_clarification": "принимать пищу днем"
                            },
                            {
                                "target_lang_word": "пообедать",
                                "target_lang_sense_clarification": "совершить прием пищи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吃午饭",
                                "target_lang_sense_clarification": "进行午间进食的动作"
                            },
                            {
                                "target_lang_word": "用午餐",
                                "target_lang_sense_clarification": "较为正式的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e2d5933-b935-362b-b17d-fc7f1273399b",
                    "sense_definition": "To treat someone to a midday meal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_treat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>lunched</w> the potential clients at a fancy hotel.",
                            "target_lang_translations": {
                                "ru": "Компания <w>угостила обедом</w> потенциальных клиентов в шикарном отеле.",
                                "zh": "公司在一家高档酒店<w>请</w>潜在客户<w>吃午饭</w>。"
                            }
                        },
                        {
                            "text": "They were <w>lunched</w> and dined by the organizers.",
                            "target_lang_translations": {
                                "ru": "Организаторы <w>угощали</w> их <w>обедом</w> и ужином.",
                                "zh": "组织者<w>请</w>他们<w>吃了午饭</w>和晚饭。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угощать кого-либо обедом",
                        "zh": "请某人吃午餐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать обедом",
                                "target_lang_sense_clarification": "оплатить обед для кого-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "请吃午饭",
                                "target_lang_sense_clarification": "招待某人吃午餐"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}