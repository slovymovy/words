                                    {
                                        "sense_id": "eb8ead8f-1da0-3b54-8b62-cf3680ebe3bc",
                                        "entry_id": "78407b18-b97d-3c1c-8230-5e085a57aee7",
                                        "glosses": [
                                            "A child member of the St John Ambulance medical volunteering organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01abf482-9627-419d-96a2-5583253bfbe0",
                                                "sense_id": "eb8ead8f-1da0-3b54-8b62-cf3680ebe3bc",
                                                "text": "She was also a leader, trainer and supervisor of the children's arm of St John's Ambulance (“the Badgers”). She worked over 50 hours a year but received no salary and was not required to attend events."
                                            },
                                            {
                                                "example_id": "e8fde2d5-2fc7-41fb-8d09-01d54b51fe36",
                                                "sense_id": "eb8ead8f-1da0-3b54-8b62-cf3680ebe3bc",
                                                "text": "St John's Ambulance encourages 7-10-year-olds to join their Badger Setts and earn badges, learning skills in first aid and helping local communities as well as leadership and communication. Known as 'Badgers', their sweatshirts and badges use a badger logo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
