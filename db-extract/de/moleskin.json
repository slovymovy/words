                                "target_senses": [
                                    {
                                        "sense_id": "74abfd5f-5837-38d8-8dbc-18dca359f0c8",
                                        "entry_id": "63eb9e80-7fdc-3183-b84b-1536e7712bd7",
                                        "glosses": [
                                            "To cover with a moleskin bandage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e98628-1b71-4f4c-8d2a-6f10609cfb67",
                                                "sense_id": "74abfd5f-5837-38d8-8dbc-18dca359f0c8",
                                                "text": "Sadler has already wrapped an ace bandage around a badly sprained wrist (sustained in a fall on a desert trail), tweezered out a few cactus spines, moleskinned some blisters, and doled out all the pastillas de dolor —painkillers..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21a3e878-9f49-4f16-93cb-8b380bf1352a",
                        "source_entry_id": "e56f0732-2639-3dd0-9d51-f717db1100a0",
                        "source_sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                        "target_lang_word": "moleskine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moleskine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61450611-1ff0-3de4-b448-51ecb1c925b3",
                                        "entry_id": "3a4c1098-3680-32c0-b3a8-e81a1d668526",
                                        "glosses": [
                                            "Étoffe de coton, lustrée, qui sert à doubler les vêtements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                        "entry_id": "3a4c1098-3680-32c0-b3a8-e81a1d668526",
                                        "glosses": [
                                            "Toile vernie imitant le cuir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb7433d-f073-4cbc-8b3b-8546664302d8",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "C’est ce rond de cuir qui l’a perdu. Il se trouvait si bien dessus, sa place était si bien faite sur ce coussinet de moleskine, qu’il a mieux aimé devenir Prussien que de bouger de là."
                                            },
                                            {
                                                "example_id": "7a9a9c61-5086-441f-876e-6e25d5e98816",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "La salle étroite et noire, avec ses banquettes de moleskine, ses chaises, sa fenêtre, ses glaces ternies, sa clientèle de buveurs préoccupés, lui serrait le coeur."
                                            },
                                            {
                                                "example_id": "8223a7d7-340c-48f8-8727-c3901343e82b",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "Par une double porte, capitonnée de moleskine, nous pénétrâmes dans une pièce carrelée, aux murs blancs à encadrements rouges, et que les habitués appellent « la chapelle »."
                                            },
                                            {
                                                "example_id": "0191bc6b-689f-4659-8e99-25010bab5dfe",
                                                "sense_id": "79355579-68be-38b4-b276-29a94124c6d4",
                                                "text": "Vous croyez donc que les bandits se tiennent à plaisir dans ces caves vermineuses et dans ces pièces ouvertes à la pluie et au vent ? Soyez certain qu'ils préfèrent quelque chaude taverne, avec de bonnes banquettes de moleskine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63c8e244-98f3-3ff8-baa9-0223c2bacf90",
                                        "entry_id": "3a4c1098-3680-32c0-b3a8-e81a1d668526",
                                        "glosses": [
                                            "Couverture de petit carnet faite dans cette toile vernie."
                                        ],
                                        "tags": [
                                            "Papeterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f92e363-6b0b-4b56-b20f-c2e371c22a27",
                                                "sense_id": "63c8e244-98f3-3ff8-baa9-0223c2bacf90",
                                                "text": "Il sortit de l’une des poches de sa veste un stylo bille et le carnet de moleskine noire qu’il gardait toujours sur lui depuis qu’il avait commencé son livre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e10e67fc-c561-4bee-b744-d94b7d4d448f",
                        "source_entry_id": "e56f0732-2639-3dd0-9d51-f717db1100a0",
                        "source_sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                        "target_lang_word": "molesquine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molesquine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3400dd40-16ad-34de-b04b-a25075eb135b",
                                        "entry_id": "20b3d62b-b414-3bc3-9915-08491ad74b56",
                                        "glosses": [
                                            "Variante de moleskine."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded91b40-1c9f-46f1-9d30-672caabc4d8d",
                                                "sense_id": "3400dd40-16ad-34de-b04b-a25075eb135b",
                                                "text": "M. Roux ôta de dessus un vieux fauteuil de molesquine le Dictionnaire de Freund et fit asseoir madame Bergeret."
                                            },
                                            {
                                                "example_id": "76b3ee55-6eaa-4660-8a65-67868e3314fc",
                                                "sense_id": "3400dd40-16ad-34de-b04b-a25075eb135b",
                                                "text": "Julius, gardant à la main son chapeau plutôt que de le poser sur la douteuse toile cirée qui recouvrait une table ovale, et restant debout par horreur de la molesquine, saisit le bras d’Anthime et s’écria :\n– Vous ne pouvez rester ici, mon pauvre ami."
                                            },
                                            {
                                                "example_id": "32a3bc0f-f96f-4690-ac5a-4c6d95305413",
                                                "sense_id": "3400dd40-16ad-34de-b04b-a25075eb135b",
                                                "text": "Un instant, la découverte d’un carnet de molesquine, et qui paraissait intact, me bouleversa ; mais aucune des feuilles n’en avait été épargnée."
                                            },
                                            {
                                                "example_id": "2009d354-5144-4ed6-b442-48655aa13ad1",
                                                "sense_id": "3400dd40-16ad-34de-b04b-a25075eb135b",
                                                "text": "Mais à mesure que nous descendions, sa marche se faisait de plus en plus hésitante, de sorte que sur le palier je le dépassai sans vergogne, cʼest moi qui frappai au bureau du docteur, et moi encore, dès quʼon eut répondu, qui ouvris la lourde porte, matelassée de molesquine."
                                            },
                                            {
                                                "example_id": "4f84a41a-314a-4f4b-8740-75c6ddd13cbd",
                                                "sense_id": "3400dd40-16ad-34de-b04b-a25075eb135b",
                                                "text": "C’était le rendez-vous des gens tranquilles, avec des tables de marbre à l’ancienne mode, des banquettes de molesquine, un poêle émaillé et un billard dans le fond de la salle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
