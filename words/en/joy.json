{
    "word_family": [
        "joyful",
        "joyous",
        "enjoy",
        "joyless",
        "overjoy",
        "joyfully",
        "joyously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d307fc30-8f7b-3937-9e8f-2a351a4a6e66",
                    "sense_definition": "A feeling of extreme happiness or cheerfulness, especially related to the acquisition or expectation of something good.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children's faces were full of <w>joy</w> on Christmas morning when they saw the gifts.",
                            "target_lang_translations": {
                                "ru": "Лица детей светились <w>радостью</w> рождественским утром, когда они увидели подарки."
                            }
                        },
                        {
                            "text": "She could not hide her <w>joy</w> at the news of her brother's safe return.",
                            "target_lang_translations": {
                                "ru": "Она не могла скрыть своей <w>радости</w> при известии о благополучном возвращении брата."
                            }
                        }
                    ],
                    "synonyms": [
                        "happiness",
                        "gladness",
                        "delight",
                        "elation",
                        "glee"
                    ],
                    "antonyms": [
                        "unhappiness",
                        "joylessness"
                    ],
                    "common_phrases": [
                        "tears of joy",
                        "jump for joy",
                        "full of joy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильного счастья или бодрости, особенно связанное с получением или ожиданием чего-то хорошего."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "чувство удовольствия и удовлетворения"
                            },
                            {
                                "target_lang_word": "восторг",
                                "target_lang_sense_clarification": "сильный подъем чувств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ca1356f-ec9c-3e5e-971b-a18643064c66",
                    "sense_definition": "Anything that causes a feeling of extreme happiness or satisfaction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "source_of_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their new baby is a constant <w>joy</w> to the entire family.",
                            "target_lang_translations": {
                                "ru": "Их новорожденный малыш — постоянная <w>радость</w> для всей семьи."
                            }
                        },
                        {
                            "text": "The garden was a <w>joy</w> to behold during the peak of the spring season.",
                            "target_lang_translations": {
                                "ru": "Сад был настоящей <w>отрадой</w> для глаз в самый разгар весны."
                            }
                        }
                    ],
                    "synonyms": [
                        "delight",
                        "pleasure",
                        "blessing"
                    ],
                    "common_phrases": [
                        "bundle of joy",
                        "pride and joy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо, вызывающее чувство сильного счастья или удовлетворения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "предмет или событие, приносящее счастье"
                            },
                            {
                                "target_lang_word": "отрада",
                                "target_lang_sense_clarification": "утешение или удовольствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4abd4391-5abe-30dd-9942-010d946c65c8",
                    "sense_definition": "Luck or success; a positive outcome or progress in a task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried calling the office several times but had no <w>joy</w> getting through.",
                            "target_lang_translations": {
                                "ru": "Я несколько раз пытался дозвониться в офис, но без особого <w>успеха</w>."
                            }
                        },
                        {
                            "text": "Are you having any <w>joy</w> with your job search lately?",
                            "target_lang_translations": {
                                "ru": "Есть ли какие-нибудь <w>успехи</w> в поисках работы в последнее время?"
                            }
                        }
                    ],
                    "synonyms": [
                        "success",
                        "luck",
                        "progress"
                    ],
                    "common_phrases": [
                        "no joy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the negative 'no joy'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удача или успех; положительный результат или прогресс в выполнении задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успех",
                                "target_lang_sense_clarification": "положительный результат"
                            },
                            {
                                "target_lang_word": "удача",
                                "target_lang_sense_clarification": "везение в делах"
                            },
                            {
                                "target_lang_word": "прок",
                                "target_lang_sense_clarification": "польза или результат (часто в отриц. смысле)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00014b8d-2db6-31c9-a9fd-d593b5d7865b",
                    "sense_definition": "The outward sign or exhibition of happiness, such as gaiety, merriment, or festivity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hall resounded with <w>joy</w> and laughter during the wedding feast.",
                            "target_lang_translations": {
                                "ru": "Зал оглашался <w>весельем</w> и смехом во время свадебного пира."
                            }
                        },
                        {
                            "text": "The town was filled with <w>joy</w> as the festival began.",
                            "target_lang_translations": {
                                "ru": "Город наполнился <w>ликованием</w> с началом фестиваля."
                            }
                        }
                    ],
                    "synonyms": [
                        "merriment",
                        "gaiety",
                        "festivity",
                        "mirth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешнее проявление счастья, такое как веселье, ликование или праздничное настроение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веселье",
                                "target_lang_sense_clarification": "радостное настроение и смех"
                            },
                            {
                                "target_lang_word": "ликование",
                                "target_lang_sense_clarification": "торжествующая радость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9e7fc6d6-0e84-34cd-9fad-4ff49bf09cf7",
                    "sense_definition": "An exclamation expressing appreciation, happiness, or sometimes used sarcastically to express the opposite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh, <w>joy</w>! I just realized I have to work this weekend.",
                            "target_lang_translations": {
                                "ru": "О, какая <w>радость</w>! Я только что понял, что мне придется работать в эти выходные."
                            }
                        },
                        {
                            "text": "He shouted, \"<w>Joy</w>!\" when he finally finished the difficult project.",
                            "target_lang_translations": {
                                "ru": "Он закричал: «<w>Ура</w>!», когда наконец закончил сложный проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "yay",
                        "hooray",
                        "whoopee"
                    ],
                    "common_phrases": [
                        "oh joy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used sarcastically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее признательность, счастье или иногда используемое саркастически для выражения противоположного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "какая радость",
                                "target_lang_sense_clarification": "восклицание, часто саркастичное"
                            },
                            {
                                "target_lang_word": "ура",
                                "target_lang_sense_clarification": "выражение восторга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1645ddab-33ca-3d5a-a03b-3aa5fc2b08da",
                    "sense_definition": "A female given name from English.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Joy</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Джой</w> придет сегодня к нам на ужин."
                            }
                        },
                        {
                            "text": "They decided to name their daughter <w>Joy</w> because she brought them so much happiness.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать дочь <w>Джой</w>, потому что она принесла им столько счастья."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя английского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джой",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7c25645-c17c-3e55-8d43-f711ef35e72c",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Joy</w> will be giving the lecture on linguistics today.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Джой</w> сегодня будет читать лекцию по лингвистике."
                            }
                        },
                        {
                            "text": "The <w>Joy</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Джой</w> живет в этом городе уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джой",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0415c15a-f5df-3f21-b3d5-24211338247f",
                    "sense_definition": "To feel joy or to rejoice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rejoice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>joy</w> to see you healthy and happy after your long journey.",
                            "target_lang_translations": {
                                "ru": "Я <w>радуюсь</w>, видя тебя здоровым и счастливым после долгого путешествия."
                            }
                        },
                        {
                            "text": "The people <w>joyed</w> at the news of the victory.",
                            "target_lang_translations": {
                                "ru": "Народ <w>ликовал</w> при известии о победе."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejoice",
                        "exult"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать радость или радоваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радоваться",
                                "target_lang_sense_clarification": "испытывать чувство радости"
                            },
                            {
                                "target_lang_word": "ликовать",
                                "target_lang_sense_clarification": "торжественно радоваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a3cc8ea-f764-31ef-aa41-b1036d830c3f",
                    "sense_definition": "To <w>enjoy</w> something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>joyed</w> the sight of the beautiful landscape from the mountain top.",
                            "target_lang_translations": {
                                "ru": "Он <w>наслаждался</w> видом прекрасного пейзажа с вершины горы."
                            }
                        },
                        {
                            "text": "She never <w>joyed</w> a single day of peace during the war.",
                            "target_lang_translations": {
                                "ru": "За все время войны она не <w>видела</w> ни одного мирного дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "enjoy",
                        "relish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наслаждаться чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наслаждаться",
                                "target_lang_sense_clarification": "получать удовольствие"
                            },
                            {
                                "target_lang_word": "радоваться",
                                "target_lang_sense_clarification": "получать радость от чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}