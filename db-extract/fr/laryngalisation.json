                    }
                ],
                "senses": [
                    {
                        "sense_id": "991272a3-de9d-3efd-9caf-b9f216e942f3",
                        "entry_id": "00a5016b-f23e-3358-bf16-a996190e6c64",
                        "glosses": [
                            "Compression des cordes vocales, rendant les sons plus rauques et craquants."
                        ],
                        "tags": [
                            "Phonétique"
                        ],
                        "examples": [
                            {
                                "example_id": "1713290f-1ccf-4768-a999-9905b6d18df1",
                                "sense_id": "991272a3-de9d-3efd-9caf-b9f216e942f3",
                                "text": "En somme, les occlusives, dites sonores aspirées, des dialectes arméniens ne sont pas des phonèmes indépendants, car leur trait distinctif, la laryngalisation ou l’aspiration voisée, apparaît dans le cadre d’une syllabe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b20ffa29-6ad8-4242-bfc4-41c03c2bb48a",
                        "source_entry_id": "00a5016b-f23e-3358-bf16-a996190e6c64",
                        "source_sense_id": "991272a3-de9d-3efd-9caf-b9f216e942f3",
                        "target_lang_word": "vocal fry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vocal fry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12371bfb-4628-3982-ac26-dea645317d57",
                                        "entry_id": "27cc18e6-f230-3e44-9cad-a14deb9860e1",
                                        "glosses": [
                                            "A low creaky vocal vibration caused by rapid vibration of the vocal chords, common in some languages such as Finnish. In English, often associated with older Received Pronunciation and more recent North American speech patterns."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d026ed5-cdf4-4fa9-9180-bfa4ada1fac6",
                                                "sense_id": "12371bfb-4628-3982-ac26-dea645317d57",
                                                "text": "Some individuals have overlooked the fact that at such low pitch their voices fade to inaudibility at the ends of sentences, or scrape down to vocal fry."
                                            },
                                            {
                                                "example_id": "9eba0efa-fdd4-474a-822b-84b966a6ec27",
                                                "sense_id": "12371bfb-4628-3982-ac26-dea645317d57",
                                                "text": "It is perhaps easiest to see the superimposition of vocal fry, so we will begin with this behavior."
                                            },
                                            {
                                                "example_id": "6af972f6-824f-4695-8328-eff5997f129f",
                                                "sense_id": "12371bfb-4628-3982-ac26-dea645317d57",
                                                "text": "Pop singers, such as Britney Spears, slip vocal fry into their music as a way to reach low notes and add style."
                                            },
                                            {
                                                "example_id": "abb23343-d18d-43cb-96fd-6229435bb507",
                                                "sense_id": "12371bfb-4628-3982-ac26-dea645317d57",
                                                "text": "Vocal fry is safe as long as you do not do it too loudly or for too long."
                                            },
                                            {
                                                "example_id": "ddfd9546-8f34-4bc8-813d-ed5c81bad40b",
                                                "sense_id": "12371bfb-4628-3982-ac26-dea645317d57",
                                                "text": "Vocal fry or creaky voice refers to a voice quality characterized by irregular glottal opening and low pitch. It occurs in diverse languages and is prevalent in American English, where it is used not only to mark phrase finality, but also sociolinguistic factors and affect."
                                            },
                                            {
                                                "example_id": "859f8d5a-5f6c-4618-bd76-2f92e6549668",
                                                "sense_id": "12371bfb-4628-3982-ac26-dea645317d57",
                                                "text": "Yes, you can detect a bit of Johansson’s clear, low tone and a hint of vocal fry, though at times that just sounds like some grainy digitalization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
