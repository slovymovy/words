                                "target_senses": [
                                    {
                                        "sense_id": "054e724c-87a0-3af8-82c2-e4f1b243f4e0",
                                        "entry_id": "c6e4ffce-ca15-30f3-931a-33589e0a963b",
                                        "glosses": [
                                            "Rebellious or defiant to authority; contumacious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac91311e-f5c2-4832-83c7-ca20bf0a4f36",
                                                "sense_id": "054e724c-87a0-3af8-82c2-e4f1b243f4e0",
                                                "text": "I remembered with confusion my insubordinate and stealthy conduct, and when I saw where it had brought me […] I felt ashamed to look him in the face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insubordinate",
