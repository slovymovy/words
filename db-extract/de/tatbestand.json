                    },
                    {
                        "translation_id": "d2333ca8-9e07-4af4-a4be-7544f2e49ea0",
                        "source_entry_id": "4c4cf7f6-567a-34e7-b433-6461d041ad95",
                        "source_sense_id": "f362ed79-9b76-3bd8-b0f4-3aefde03263c",
                        "source_sense_description": "Recht: im Gesetz festgelegte Merkmale für eine bestimmte Handlung",
                        "target_lang_word": "matter of fact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matter of fact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82cce43e-11bd-3cbd-be0e-6def9a593131",
                                        "entry_id": "26c6251d-d944-3091-8a2c-754662fd00c5",
                                        "glosses": [
                                            "An issue concerning the factual circumstances of a cause of action that is to be tried or proved; an allegation forming the basis of a claim or defense, as opposed to a matter of law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30aa9411-85c1-46e3-bc16-cd7e7172c869",
                                                "sense_id": "82cce43e-11bd-3cbd-be0e-6def9a593131",
                                                "text": "Whether he left his house on the night of the murder is a matter of fact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b69060a-4638-3a2f-a278-0ef636887457",
                                        "entry_id": "26c6251d-d944-3091-8a2c-754662fd00c5",
                                        "glosses": [
                                            "A point of fact; a claim or statement about (empirical) facts, as opposed to conjecture or opinion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fcd4d5a-2efa-41c1-a143-026d6d1b2169",
                                                "sense_id": "8b69060a-4638-3a2f-a278-0ef636887457",
                                                "text": "It’s a matter of fact that I came into work yesterday."
                                            },
                                            {
                                                "example_id": "6bff254b-031e-4c2f-be6c-2b9aa5486be1",
                                                "sense_id": "8b69060a-4638-3a2f-a278-0ef636887457",
                                                "text": "And all that I pretend to in this ensueing Treatise, is only to poynt with the finger from the Text unto the mater of fact, shewing how here & there, these & those words of the Text were fulfilled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matter of fact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36b1e60c-e5be-31f7-8c35-b5b58c77b83b",
                                        "entry_id": "c81d5c0e-76f0-3550-a9f5-376358aa8a88",
                                        "glosses": [
                                            "Ellipsis of as a matter of fact."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "adverbial",
                                            "alt-of",
                                            "colloquial",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e01256b-59aa-4914-92f2-07947aa282e2",
                                                "sense_id": "36b1e60c-e5be-31f7-8c35-b5b58c77b83b",
                                                "text": "“Are you familiar with the Trade Mart building?” ¶ “Yes,” I replied. “Matter of fact, I had drinks up at the top of the Mart only a few nights ago.”"
                                            },
                                            {
                                                "example_id": "40337f28-c44e-4fe6-b3de-068e5aef4d59",
                                                "sense_id": "36b1e60c-e5be-31f7-8c35-b5b58c77b83b",
                                                "text": "Matter of fact, I vaguely recall interviewing him at a public appearance at The New York Times Building on Wednesday evening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
