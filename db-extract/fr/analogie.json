                                        "glosses": [
                                            "σχέση δύο ή περισσότερων μεγεθών μεταξύ τους, ο λόγος της τιμής ή του μεγέθους του ενός προς το άλλο, σε μια πραγματική ή υποθετική διαίρεση ή σε έναν άτυπο πολλαπλασιασμό"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "172e47e3-48fd-41cb-b17b-d32b4b0522a7",
                                                "sense_id": "0199be14-5e7a-3769-93b5-ae17424d61a2",
                                                "text": "Στην αστυφιλία η αναλογία του αστικού προς τον αγροτικό πληθυσμό μπορεί να είναι ακόμα και 2 προς 1. (δηλαδή οι αστοί να είναι διπλάσιοι)"
                                            },
                                            {
                                                "example_id": "67b8ffc5-b390-4269-9829-18c38c640d2a",
                                                "sense_id": "0199be14-5e7a-3769-93b5-ae17424d61a2",
                                                "text": "oι αναλογίες του ανθρώπινου σώματος"
                                            },
                                            {
                                                "example_id": "37ef385e-361f-4975-a542-97741bace2bc",
                                                "sense_id": "0199be14-5e7a-3769-93b5-ae17424d61a2",
                                                "text": "πρέπει να τηρούνται οι αναλογίες διαφορετικά χαλάει η συνταγή"
                                            },
                                            {
                                                "example_id": "f51ab03a-05b6-4dcf-9aaa-b42a9bcbba10",
                                                "sense_id": "0199be14-5e7a-3769-93b5-ae17424d61a2",
                                                "text": "sτην ταινία τηρούνται θαυμάσια οι αναλογίες μυστηρίου και δράσης"
                                            },
                                            {
                                                "example_id": "997900a9-2a39-4470-a2f9-ee559a7c5362",
                                                "sense_id": "0199be14-5e7a-3769-93b5-ae17424d61a2",
                                                "text": "Εξαιρετικό έργο στο είδος του, μου θύμιζε τον «Άμλετ», τηρουμένων βέβαια των αναλογιών."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "896bc8b0-16ef-3d86-af31-5c4e53793ac2",
                                        "entry_id": "0fb16ee1-c4ee-3447-92bd-217ec6f5b433",
                                        "glosses": [
                                            "ομοιότητα, παραλληλισμό"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819711fd-901a-48db-8247-cccb22ab0965",
                                                "sense_id": "896bc8b0-16ef-3d86-af31-5c4e53793ac2",
                                                "text": "Πολλοί διακρίνουν μια αναλογία ανάμεσα στην πτώχευση μιας χώρας και στην κήρυξη πολέμου εναντίον της."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "829adfd3-00c4-3e5a-a1a3-38fbc68da76e",
                                        "entry_id": "0fb16ee1-c4ee-3447-92bd-217ec6f5b433",
                                        "glosses": [
                                            "μέτρο, σύνεση, η τοποθέτηση ενός ζητήματος σε αντικειμενικές, πραγματικές διαστάσεις"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "add75806-046f-4f29-97c2-76937f83c9ab",
                                                "sense_id": "829adfd3-00c4-3e5a-a1a3-38fbc68da76e",
                                                "text": "Έχασες κάθε αίσθηση του μέτρου και των αναλογιών. Πρέπει να ανακτήσεις την ψυχραιμία σου!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
