                ],
                "senses": [
                    {
                        "sense_id": "828dac7b-fac3-36bc-9276-99ec669f0f48",
                        "entry_id": "15883c48-14c7-39ca-85d9-d590328d1159",
                        "glosses": [
                            "ohne Augenlider, keine Augenlider habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e40d6ab-d5cc-42ca-a1fc-46782db2374e",
                                "sense_id": "828dac7b-fac3-36bc-9276-99ec669f0f48",
                                "text": "„Sein Begleiter deutete mit einem dürren Arm durch den Schutt der Bauruine, in der sie sich versteckt hielten, und seine großen, lidlosen Augen waren voller Furcht beim Anblick dessen, worauf er zeigte.“"
                            },
                            {
                                "example_id": "1fb88700-7ac4-4e43-9fac-8dae2a283771",
                                "sense_id": "828dac7b-fac3-36bc-9276-99ec669f0f48",
                                "text": "„Die Schlange lag in einer Ecke, eng zusammengerollt, nur Kopf und Schwanzspitze ragten heraus. Ihre flinke Zunge schnellte unablässig aus dem Maul und wieder zurück. Ihre lidlosen Augen starrten Joe Lon an.“"
                            },
                            {
                                "example_id": "6f0272b0-f976-4889-95a3-9d7363876356",
                                "sense_id": "828dac7b-fac3-36bc-9276-99ec669f0f48",
                                "text": "„Wenn man nur ein paar Tropfen Coca-Cola auf seinen schmierigen Holztischen verschüttete, riss er die lidlosen Augen auf und beschimpfte einen minutenlang mit schriller Stimme, ohne Rücksicht auf die Spieler, die sich zu konzentrieren versuchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
