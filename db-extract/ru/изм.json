                    },
                    {
                        "translation_id": "ff0e8fba-f395-427d-b3fb-367ae16bf0b4",
                        "source_entry_id": "f98f5ff2-4cd7-3445-927f-ab3750121be6",
                        "source_sense_id": "d732f871-ccbe-3f14-85e0-00625ff5438e",
