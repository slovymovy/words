{
    "word_family": [
        "crier",
        "outcry",
        "decry",
        "crying"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1dbeec7c-116a-3c95-bf01-a14ce23b6d3b",
                    "sense_definition": "To shed tears, especially as an expression of sadness, pain, or anger.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "weeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy started to <w>cry</w> when he fell down and scraped his knee.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик начал <w>плакать</w>, когда упал и ободрал колено."
                            }
                        },
                        {
                            "text": "It is okay to <w>cry</w> for help when you feel overwhelmed by your emotions.",
                            "target_lang_translations": {
                                "ru": "Это нормально — <w>взывать</w> о помощи, когда эмоции переполняют тебя."
                            }
                        }
                    ],
                    "synonyms": [
                        "weep",
                        "sob",
                        "bawl",
                        "blubber",
                        "whimper"
                    ],
                    "antonyms": [
                        "laugh"
                    ],
                    "common_phrases": [
                        "cry for help",
                        "cry with joy",
                        "make someone cry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проливать слезы, особенно как выражение печали, боли или гнева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плакать",
                                "target_lang_sense_clarification": "проливать слезы"
                            },
                            {
                                "target_lang_word": "рыдать",
                                "target_lang_sense_clarification": "громко и сильно плакать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcb5131d-5974-3d16-846c-1a37088ce107",
                    "sense_definition": "To shout, scream, or yell loudly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vocalizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>cry</w> out in pain when the heavy box landed on his foot.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>вскрикнуть</w> от боли, когда тяжелая коробка упала ему на ногу."
                            }
                        },
                        {
                            "text": "The captain would <w>cry</w> aloud to give orders over the sound of the storm.",
                            "target_lang_translations": {
                                "ru": "Капитан <w>кричал</w> во весь голос, чтобы отдавать приказы сквозь шум шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "wail"
                    ],
                    "common_phrases": [
                        "cry out",
                        "cry aloud",
                        "cry for mercy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко кричать, вопить или орать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкий звук голосом"
                            },
                            {
                                "target_lang_word": "вскрикнуть",
                                "target_lang_sense_clarification": "издать резкий короткий крик"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "очень громко кричать (разг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67c62ffe-ade1-3acd-888d-5ee277a80f38",
                    "sense_definition": "To utter the characteristic inarticulate sounds of an animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the seagulls <w>cry</w> as they flew over the harbor looking for fish.",
                            "target_lang_translations": {
                                "ru": "Мы слышали, как <w>кричат</w> чайки, летая над гаванью в поисках рыбы."
                            }
                        },
                        {
                            "text": "In the distance, a lone wolf began to <w>cry</w> at the rising moon.",
                            "target_lang_translations": {
                                "ru": "Вдалеке одинокий волк начал <w>выть</w> на восходящую луну."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать характерные нечленораздельные звуки (о животных или птицах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "о звуках птиц или животных"
                            },
                            {
                                "target_lang_word": "выть",
                                "target_lang_sense_clarification": "о протяжном крике волка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67cc9a82-2b85-399a-9a61-4272d9d96504",
                    "sense_definition": "To bring oneself into a certain state by weeping.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long argument, she went to her room to <w>cry</w> herself to sleep.",
                            "target_lang_translations": {
                                "ru": "После долгой ссоры она пошла в свою комнату, чтобы <w>уснуть</w> в слезах."
                            }
                        },
                        {
                            "text": "The exhausted toddler would often <w>cry</w> himself into a state of calm.",
                            "target_lang_translations": {
                                "ru": "Измученный малыш часто <w>плакал</w> до тех пор, пока не успокаивался."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cry oneself to sleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доводить себя до определенного состояния плачем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плакать",
                                "target_lang_sense_clarification": "в контексте доведения до состояния"
                            },
                            {
                                "target_lang_word": "выплакаться",
                                "target_lang_sense_clarification": "дойти до состояния облегчения или изнеможения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a8f3716-7b20-37ee-8ec4-29e440f0fcb6",
                    "sense_definition": "To announce or advertise goods or news by shouting in public.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vocalizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street vendors would <w>cry</w> their wares to attract customers in the busy market.",
                            "target_lang_translations": {
                                "ru": "Уличные торговцы <w>выкрикивали</w> названия своих товаров, чтобы привлечь покупателей на оживленном рынке."
                            }
                        },
                        {
                            "text": "In the old days, a town crier would <w>cry</w> the news in the village square.",
                            "target_lang_translations": {
                                "ru": "В прежние времена глашатай <w>объявлял</w> новости на деревенской площади."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cry one's wares"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical practices of public announcement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять или рекламировать товары или новости, выкрикивая их на публике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкрикивать",
                                "target_lang_sense_clarification": "громко объявлять товары или новости"
                            },
                            {
                                "target_lang_word": "зазывать",
                                "target_lang_sense_clarification": "привлекать покупателей криками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c35204c-cbe5-388d-b0ac-7d0001540d90",
                    "sense_definition": "An episode or act of shedding tears.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weeping_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sometimes you just need a good <w>cry</w> to feel better after a stressful day.",
                            "target_lang_translations": {
                                "ru": "Иногда нужно просто хорошенько <w>поплакать</w>, чтобы почувствовать себя лучше после напряженного дня."
                            }
                        },
                        {
                            "text": "She had a long <w>cry</w> in her car before going inside to face her family.",
                            "target_lang_translations": {
                                "ru": "Она долго <w>плакала</w> в машине, прежде чем войти в дом к семье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good cry",
                        "long cry",
                        "have a cry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эпизод или акт пролития слез."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плач",
                                "target_lang_sense_clarification": "процесс пролития слез"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bca53370-c457-3b90-9348-dd38ea4f7a03",
                    "sense_definition": "A loud shout, scream, or vocal sound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vocalizing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>cry</w> of pain echoed through the hallway, startling everyone.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>крик</w> боли эхом разнесся по коридору, напугав всех."
                            }
                        },
                        {
                            "text": "The hunters let out a <w>cry</w> of victory when they finally spotted their target.",
                            "target_lang_translations": {
                                "ru": "Охотники издали победный <w>клич</w>, когда наконец заметили свою цель."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cry of pain",
                        "cry of joy",
                        "battle cry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий возглас, вопль или вокальный звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "громкий звук голоса"
                            },
                            {
                                "target_lang_word": "возглас",
                                "target_lang_sense_clarification": "громкое восклицание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3eeaadc2-7541-338f-9c13-9df002ce36f8",
                    "sense_definition": "The characteristic call or sound made by an animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The haunting <w>cry</w> of the owl could be heard throughout the dark forest.",
                            "target_lang_translations": {
                                "ru": "Жуткий <w>крик</w> совы был слышен по всему темному лесу."
                            }
                        },
                        {
                            "text": "We recognized the distinct <w>cry</w> of the eagle as it soared above the cliffs.",
                            "target_lang_translations": {
                                "ru": "Мы узнали отчетливый <w>клич</w> орла, парящего над скалами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный зов или звук, издаваемый животным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "звук, издаваемый птицей или зверем"
                            },
                            {
                                "target_lang_word": "клич",
                                "target_lang_sense_clarification": "призывный звук животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dded9567-a003-3543-b126-152025fd9ce2",
                    "sense_definition": "An urgent or desperate appeal or request for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protest was a desperate <w>cry</w> for justice from the local community.",
                            "target_lang_translations": {
                                "ru": "Протест был отчаянным <w>призывом</w> к справедливости со стороны местной общины."
                            }
                        },
                        {
                            "text": "The charity issued a <w>cry</w> for help to provide food for the refugees.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация выступила с <w>призывом</w> о помощи, чтобы обеспечить беженцев едой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cry for help",
                        "cry for justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настойчивый или отчаянный призыв или просьба о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призыв",
                                "target_lang_sense_clarification": "обращение за помощью или к действию"
                            },
                            {
                                "target_lang_word": "мольба",
                                "target_lang_sense_clarification": "отчаянная просьба"
                            },
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "в переносном смысле: крик души, крик о помощи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}