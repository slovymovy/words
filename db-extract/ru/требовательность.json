                "senses": [
                    {
                        "sense_id": "d556040f-fded-3aea-955d-7906b4ce49c2",
                        "entry_id": "f260a15f-f1aa-3b9e-bbab-c4a543854b2e",
                        "glosses": [
                            "свойство по значению прилагательного требовательный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656e287b-faed-4ab6-b383-de59e527515c",
                                "sense_id": "d556040f-fded-3aea-955d-7906b4ce49c2",
                                "text": "Лёвин уже давно сделал замечание, что когда с людьми бывает неловко от их излишней уступчивости, покорности, то очень скоро сделается невыносимо от их излишней требовательности и придирчивости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80c04217-b93d-4c03-8cc2-b522531a46ba",
                        "source_entry_id": "f260a15f-f1aa-3b9e-bbab-c4a543854b2e",
                        "source_sense_id": "d556040f-fded-3aea-955d-7906b4ce49c2",
                        "target_lang_word": "exactingness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
