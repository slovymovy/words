                ],
                "senses": [
                    {
                        "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                        "entry_id": "b8067413-403a-30f4-be15-4350f6877177",
                        "glosses": [
                            "Person, die etwas (für andere als Hilfe oder Vorlage) vorher aufgeschrieben hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4323fd7e-38fe-4e6b-b403-2a4639afd38e",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„Allein auch hier liegt vielleicht ein Schreibfehler des Vorschreibers der Inschrift vor.“"
                            },
                            {
                                "example_id": "ca660871-2401-4286-a431-dca7ad0e2c8e",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„Er versucht eine weitergehende Deutung mit seinem Evangelium und er korrigiert offenkundige Fehler, die er bei seinen Vorschreibern entdeckt hat.“"
                            },
                            {
                                "example_id": "72dcf745-17ac-4f59-adc2-6a44380133f6",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„Hierbei hat der Vorschreiber des lat. Textes offenbar seiner Phantasie mehrfach nachgegeben […].“"
                            },
                            {
                                "example_id": "7b5c0389-abb4-48b3-b108-ed3d8d73ada0",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„Die Initialen sind von dem Vorschreiber teils geschrieben, teils weggelassen und vom Rubrikator nicht ausgeführt worden.“"
                            },
                            {
                                "example_id": "86606f7d-d346-47dc-8da3-42285bf805cf",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„Mittag-Leffler notiert: ‚[…] Er war deshalb gezwungen, das Schreiben an der Tafel immer an einen Vorschreiber abzugeben.‘“"
                            },
                            {
                                "example_id": "029c3876-329c-4d4f-9e58-0bac6583a915",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„In der Schweiz hieß der Schreiblehrer auch «Vorschreiber».“"
                            },
                            {
                                "example_id": "6fec0710-b384-4fbe-881a-06f38b7c267c",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„In vielen Gedichten spricht der Dichter als Kommentator der literarischen Tradition mit den ‚Vorschreibern‘, den literarischen Vorgängern […].“"
                            },
                            {
                                "example_id": "ecadccf1-5525-40b0-b12f-2420b34e646f",
                                "sense_id": "a1fb5bfe-d218-37b8-b376-9da76218a959",
                                "text": "„Was kann man solchen Vorrednern – Vorschreibern – noch hinzufügen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b19002a9-9c46-32e3-a8a4-c060e662847e",
                        "entry_id": "b8067413-403a-30f4-be15-4350f6877177",
                        "glosses": [
                            "Person, der jemandem Vorschriften macht; jemand, der sagt, was er zu tun hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4370ed2a-683b-42af-9b8e-5330705ca184",
                                "sense_id": "b19002a9-9c46-32e3-a8a4-c060e662847e",
                                "text": "„Wolf Schneider, der Vorschreiber der Nation, wird nicht müde, uns die Regeln einzubleuen.“"
                            },
                            {
                                "example_id": "4a1f3d95-99e6-44ab-9a94-8e75e48136c1",
                                "sense_id": "b19002a9-9c46-32e3-a8a4-c060e662847e",
                                "text": "„Der ‚rasende Reporter‘ war und ist Vorbild, Vordenker und Vorschreiber für Generationen von Journalistinnen und Journalisten.“"
                            },
                            {
                                "example_id": "47e4363b-8d48-42b0-9305-d6e9ce49acef",
                                "sense_id": "b19002a9-9c46-32e3-a8a4-c060e662847e",
                                "text": "„Sollen sie in Frieden ruhen, meine Vorbilder, Vorreiter, Vorschreiber.“"
                            },
                            {
                                "example_id": "82536214-463a-475b-b3b4-f92268f3759b",
                                "sense_id": "b19002a9-9c46-32e3-a8a4-c060e662847e",
                                "text": "„Deshalb müssen wir, ausgehend vom mündigen und verantwortlichen Menschen, den Vorschreibern und Regulierern aller Parteien Paroli bieten!“"
                            },
                            {
                                "example_id": "7e18ceee-131b-4e38-8807-0ccda14455e1",
                                "sense_id": "b19002a9-9c46-32e3-a8a4-c060e662847e",
                                "text": "„Wir sind weder Vorschreiber noch Besserwisser, wir stehen neben Ihnen im Zug oder sitzen im Auto an der Ampelkreuzung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
