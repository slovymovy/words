                "senses": [
                    {
                        "sense_id": "fc9cc31e-082a-3953-99ad-87bda01a4254",
                        "entry_id": "8f3ac8b2-4e52-312c-9e77-2e468207a647",
                        "glosses": [
                            "zeitliche Spanne eines Musikstücks, Schauspiels oder Wettspiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0dc858e-0f56-4190-9133-d37f8c17869a",
                                "sense_id": "fc9cc31e-082a-3953-99ad-87bda01a4254",
                                "text": "„Ausgangspunkt bildet dabei die Hypothese, daß Videospiele nach längerer Spieldauer signifikante Veränderungen in den Gefühlen der Spieler bewirken, und zwar im Gefühlsbereich der vitalen Antriebe.“"
                            },
                            {
                                "example_id": "90a0f140-1b3b-4e7b-a94c-6b33d3befd5c",
                                "sense_id": "fc9cc31e-082a-3953-99ad-87bda01a4254",
                                "text": "„Der Trompetenbaum ist fast während der gesamten Spieldauer in einem Dialog mit den Schauspielern, die vom Regisseur Herbert Fritsch auf Slapstick und Bewegungshysterie gedrillt wurden.“"
                            },
                            {
                                "example_id": "57beab17-8295-4eca-8285-b5a6b5f6190e",
                                "sense_id": "fc9cc31e-082a-3953-99ad-87bda01a4254",
                                "text": "„Blackstar besteht aus nur sieben meist langen Songs mit insgesamt gut 40 Minuten Spieldauer.“"
                            },
                            {
                                "example_id": "b74928e9-d8a0-4605-b8da-397a67626f8e",
                                "sense_id": "fc9cc31e-082a-3953-99ad-87bda01a4254",
                                "text": "„Bei den Warriors wurde Curry mit zunehmender Spieldauer immer besser, verbuchte 17 seiner 37 Punkte im Schlussviertel.“"
                            },
                            {
                                "example_id": "94f3b8e2-d790-4e51-a9c1-658eb096feb5",
                                "sense_id": "fc9cc31e-082a-3953-99ad-87bda01a4254",
                                "text": "„Mit zunehmender Spieldauer schlichen sich immer mehr Fehler im Mittelfeld ein - unter anderem wegen dem durch Regen lädierten Rasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
