{
    "word_family": [
        "trailer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2d61b1e-b5d4-37ac-81f8-efb693f12332",
                    "sense_definition": "A route for travel over land, especially a narrow, unpaved pathway for use by hikers or horseback riders.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "path_route",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked along a steep mountain <w>trail</w> to reach the summit.",
                            "target_lang_translations": {
                                "ru": "Мы шли по крутой горной <w>тропе</w>, чтобы добраться до вершины.",
                                "tr": "Zirveye ulaşmak için dik bir dağ <w>patikası</w> boyunca yürüdük.",
                                "zh": "为了到达山顶，我们沿着一条陡峭的山间<w>小路</w>前行。"
                            }
                        },
                        {
                            "text": "The hiking <w>trail</w> winds through the dense forest.",
                            "target_lang_translations": {
                                "ru": "Туристическая <w>тропа</w> петляет через густой лес.",
                                "tr": "Yürüyüş <w>patikası</w> yoğun ormanın içinden kıvrılarak geçiyor.",
                                "zh": "这条徒步<w>步道</w>蜿蜒穿过茂密的森林。"
                            }
                        }
                    ],
                    "synonyms": [
                        "path",
                        "footpath",
                        "track",
                        "dirt track"
                    ],
                    "common_phrases": [
                        "hiking trail",
                        "nature trail",
                        "mountain trail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маршрут для путешествия по суше, особенно узкая, немощеная дорожка для туристов или всадников.",
                        "tr": "Kara yoluyla seyahat için kullanılan, özellikle yürüyüşçüler veya süvariler için patika veya asfaltlanmamış dar yol.",
                        "zh": "陆地上的行进路线，尤其指供徒步者或骑马者使用的狭窄、未铺砌的小路。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тропа",
                                "target_lang_sense_clarification": "узкая протоптанная дорожка"
                            },
                            {
                                "target_lang_word": "тропинка",
                                "target_lang_sense_clarification": "маленькая узкая тропа"
                            },
                            {
                                "target_lang_word": "маршрут",
                                "target_lang_sense_clarification": "путь следования"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "patika",
                                "target_lang_sense_clarification": "dar yürüyüş yolu"
                            },
                            {
                                "target_lang_word": "parkur",
                                "target_lang_sense_clarification": "yürüyüş veya spor rotası"
                            },
                            {
                                "target_lang_word": "patika yolu",
                                "target_lang_sense_clarification": "toprak yol"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小路",
                                "target_lang_sense_clarification": "尤指山林中供步行的狭窄土路"
                            },
                            {
                                "target_lang_word": "步道",
                                "target_lang_sense_clarification": "供徒步行走的路线或小径"
                            },
                            {
                                "target_lang_word": "山路",
                                "target_lang_sense_clarification": "山地上的小路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34114803-841c-311b-8f89-e46a40104cac",
                    "sense_definition": "The track, marks, or scent left behind by someone or something that has passed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "marks_signs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters followed the <w>trail</w> of the wounded animal.",
                            "target_lang_translations": {
                                "ru": "Охотники шли по <w>следу</w> раненого животного.",
                                "tr": "Avcılar yaralı hayvanın <w>izini</w> takip etti.",
                                "zh": "猎人们循着那只受伤动物的<w>踪迹</w>追了过去。"
                            }
                        },
                        {
                            "text": "The jet left a white vapour <w>trail</w> across the blue sky.",
                            "target_lang_translations": {
                                "ru": "Реактивный самолет оставил белый инверсионный <w>след</w> в голубом небе.",
                                "tr": "Jet, mavi gökyüzünde beyaz bir buhar <w>izi</w> bıraktı.",
                                "zh": "喷气式飞机在蓝天上留下了一道白色的蒸汽<w>尾迹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "track",
                        "spoor",
                        "sign"
                    ],
                    "common_phrases": [
                        "paper trail",
                        "trail of blood",
                        "trail of destruction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следы, метки или запах, оставленные кем-то или чем-то прошедшим.",
                        "tr": "Geçen birinin veya bir şeyin arkasında bıraktığı iz, işaret veya koku.",
                        "zh": "某人或某物经过后留下的足迹、痕迹或气味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "отпечаток или признак присутствия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iz",
                                "target_lang_sense_clarification": "arkada bırakılan belirti veya işaret"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "痕迹",
                                "target_lang_sense_clarification": "留下来的印记或迹象"
                            },
                            {
                                "target_lang_word": "踪迹",
                                "target_lang_sense_clarification": "人或动物经过后留下的线索"
                            },
                            {
                                "target_lang_word": "尾迹",
                                "target_lang_sense_clarification": "飞行物或移动物体后方留下的带状痕迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a17bd80c-8924-3305-aac4-7aa2cbc67030",
                    "sense_definition": "A route or series of places visited in a specific order, often for a particular purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "path_route",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politicians are busy on the campaign <w>trail</w> before the election.",
                            "target_lang_translations": {
                                "ru": "Политики заняты в предвыборной <w>поездке</w> перед выборами.",
                                "tr": "Politikacılar seçim öncesinde kampanya <w>turunda</w> meşguller.",
                                "zh": "选举前，政客们正忙于竞选<w>活动</w>。"
                            }
                        },
                        {
                            "text": "Tourists often follow the famous whisky <w>trail</w> in Scotland.",
                            "target_lang_translations": {
                                "ru": "Туристы часто следуют по знаменитому <w>маршруту</w> виски в Шотландии.",
                                "tr": "Turistler İskoçya'da sık sık ünlü viski <w>rotasını</w> takip eder.",
                                "zh": "游客常常会走苏格兰那条著名的威士忌<w>路线</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "track",
                        "path"
                    ],
                    "common_phrases": [
                        "campaign trail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маршрут или ряд мест, посещаемых в определенном порядке, часто с конкретной целью.",
                        "tr": "Genellikle belirli bir amaçla belirli bir sırayla ziyaret edilen rota veya yerler dizisi.",
                        "zh": "按特定顺序经过的一条路线或一系列地点，通常带有某种特定目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маршрут",
                                "target_lang_sense_clarification": "путь следования по местам"
                            },
                            {
                                "target_lang_word": "поездка",
                                "target_lang_sense_clarification": "путешествие по ряду мест"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rota",
                                "target_lang_sense_clarification": "gezi veya seyahat güzergahı"
                            },
                            {
                                "target_lang_word": "tur",
                                "target_lang_sense_clarification": "ziyaret rotası"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "路线",
                                "target_lang_sense_clarification": "按一定顺序经过多个地点的线路"
                            },
                            {
                                "target_lang_word": "行程",
                                "target_lang_sense_clarification": "为特定目的安排的访问线路"
                            },
                            {
                                "target_lang_word": "巡回路线",
                                "target_lang_sense_clarification": "巡回经过多个地点的线路"
                            },
                            {
                                "target_lang_word": "活动",
                                "target_lang_sense_clarification": "仅用于 campaign trail，指竞选期间四处拉票的活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8665390b-89d0-38ca-a935-3eaf0427773c",
                    "sense_definition": "To follow behind someone or something, often to track or hunt them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "follow_track",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective <w>trailed</w> the suspect through the city streets.",
                            "target_lang_translations": {
                                "ru": "Детектив <w>выслеживал</w> подозреваемого на улицах города.",
                                "tr": "Dedektif, şehir sokaklarında şüpheliyi <w>takip etti</w>.",
                                "zh": "侦探在城市街道上一路<w>跟踪</w>那名嫌疑人。"
                            }
                        },
                        {
                            "text": "Wolves <w>trailed</w> the herd for miles before attacking.",
                            "target_lang_translations": {
                                "ru": "Волки <w>шли по следу</w> стада много миль перед нападением.",
                                "tr": "Kurtlar saldırmadan önce millerce sürünün <w>izini sürdü</w>.",
                                "zh": "狼群在发动攻击前，先<i></i>连续几英里<w>追踪</w>着那群牲口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "track"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следовать за кем-то или чем-то, часто с целью выслеживания или охоты.",
                        "tr": "Genellikle izini sürmek veya avlamak için birinin veya bir şeyin arkasından gitmek.",
                        "zh": "跟在某人或某物后面，常指为了追查、追踪或猎捕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выслеживать",
                                "target_lang_sense_clarification": "искать, идя по следам"
                            },
                            {
                                "target_lang_word": "идти по следу",
                                "target_lang_sense_clarification": "преследовать по оставленным знакам"
                            },
                            {
                                "target_lang_word": "следить",
                                "target_lang_sense_clarification": "наблюдать, следуя сзади"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "izini sürmek",
                                "target_lang_sense_clarification": "iz takip etmek"
                            },
                            {
                                "target_lang_word": "takip etmek",
                                "target_lang_sense_clarification": "arkasından gitmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跟踪",
                                "target_lang_sense_clarification": "在后面一路追随并监视"
                            },
                            {
                                "target_lang_word": "追踪",
                                "target_lang_sense_clarification": "沿着线索或痕迹追查"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5089eb9-70e4-31f0-ad6f-61e979a4942c",
                    "sense_definition": "To be losing or behind an opponent in a competition or score.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "losing_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team was <w>trailing</w> by ten points at halftime.",
                            "target_lang_translations": {
                                "ru": "Наша команда <w>отставала</w> на десять очков в перерыве.",
                                "tr": "Takımımız devre arasında on sayı <w>gerideydi</w>.",
                                "zh": "中场休息时，我们队<w>落后</w>十分。"
                            }
                        },
                        {
                            "text": "The candidate is currently <w>trailing</w> in the opinion polls.",
                            "target_lang_translations": {
                                "ru": "Кандидат в настоящее время <w>отстает</w> в опросах общественного мнения.",
                                "tr": "Aday şu anda kamuoyu yoklamalarında <w>geride kalıyor</w>.",
                                "zh": "这位候选人目前在民调中<w>落后</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "lead"
                    ],
                    "common_phrases": [
                        "trail behind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проигрывать или отставать от соперника в соревновании или счете.",
                        "tr": "Bir yarışmada veya skorda rakibin gerisinde olmak veya yenilmekte olmak.",
                        "zh": "在比赛或比分上落在对手后面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отставать",
                                "target_lang_sense_clarification": "быть позади в развитии или счете"
                            },
                            {
                                "target_lang_word": "проигрывать",
                                "target_lang_sense_clarification": "уступать в счете"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geride olmak",
                                "target_lang_sense_clarification": "skorda arkada kalmak"
                            },
                            {
                                "target_lang_word": "geriden gelmek",
                                "target_lang_sense_clarification": "skorda geride bulunmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "落后",
                                "target_lang_sense_clarification": "在比赛、得分或民调中处于后面"
                            },
                            {
                                "target_lang_word": "处于劣势",
                                "target_lang_sense_clarification": "处于不领先的位置，较正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e53f242-caf5-330e-84fc-20bcd34c3cd2",
                    "sense_definition": "To drag something behind on the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drag_hang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child walked sadly, <w>trailing</w> his blanket in the dirt.",
                            "target_lang_translations": {
                                "ru": "Ребенок грустно шел, <w>волоча</w> свое одеяло по грязи.",
                                "tr": "Çocuk, battaniyesini çamurda <w>sürükleyerek</w> üzgün üzgün yürüdü.",
                                "zh": "那个孩子伤心地走着，<w>拖着</w>他的毯子在泥地上蹭。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>trail</w> your coat through the mud.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>волочи</w> свое пальто по грязи.",
                                "tr": "Paltonu çamura <w>sürümeyecek</w> şekilde dikkatli ol.",
                                "zh": "小心别让你的外套在泥里<w>拖着</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тащить что-то сзади по земле.",
                        "tr": "Bir şeyi yerde arkasından sürüklemek.",
                        "zh": "把某物拖在后面，使其在地面上拖行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волочить",
                                "target_lang_sense_clarification": "тянуть по земле"
                            },
                            {
                                "target_lang_word": "тащить",
                                "target_lang_sense_clarification": "перемещать с усилием"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürüklemek",
                                "target_lang_sense_clarification": "yerde çekerek götürmek"
                            },
                            {
                                "target_lang_word": "sürümek",
                                "target_lang_sense_clarification": "yerde arkasından çekmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖着",
                                "target_lang_sense_clarification": "把某物拖在身后、在地上拖行"
                            },
                            {
                                "target_lang_word": "拖",
                                "target_lang_sense_clarification": "使某物在地上被拖行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8cbc930-18e1-3117-a0ba-638c2f7b2b6c",
                    "sense_definition": "To hang loosely and drag along the ground or behind something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "drag_hang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bride's long white dress <w>trailed</w> behind her.",
                            "target_lang_translations": {
                                "ru": "Длинное белое платье невесты <w>тянулось</w> за ней.",
                                "tr": "Gelinin uzun beyaz elbisesi arkasından <w>sürünüyordu</w>.",
                                "zh": "新娘的白色长裙在她身后<w>拖曳</w>着。"
                            }
                        },
                        {
                            "text": "Ivy vines <w>trailed</w> down the old stone wall.",
                            "target_lang_translations": {
                                "ru": "Плющ <w>свисал</w> вниз по старой каменной стене.",
                                "tr": "Sarmaşıklar eski taş duvardan aşağıya <w>sarkıyordu</w>.",
                                "zh": "常春藤顺着那面老石墙向下<w>垂下</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свисать свободно и волочиться по земле или позади чего-то.",
                        "tr": "Serbestçe sarkmak ve yerde veya bir şeyin arkasında sürüklenmek.",
                        "zh": "松松地垂着，并在地上或某物后方拖行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тянуться",
                                "target_lang_sense_clarification": "простираться вслед"
                            },
                            {
                                "target_lang_word": "свисать",
                                "target_lang_sense_clarification": "висеть вниз"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürünmek",
                                "target_lang_sense_clarification": "yer boyunca uzanıp arkadan gelmek"
                            },
                            {
                                "target_lang_word": "sarkmak",
                                "target_lang_sense_clarification": "aşağı doğru uzanmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖曳",
                                "target_lang_sense_clarification": "松松地下垂或在后面拖着"
                            },
                            {
                                "target_lang_word": "垂下",
                                "target_lang_sense_clarification": "向下悬垂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b824fd2d-e686-329e-92aa-3660e06b8347",
                    "sense_definition": "To move or walk slowly and wearily, often falling behind others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "move_slowly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired children <w>trailed</w> behind their parents on the way home.",
                            "target_lang_translations": {
                                "ru": "Уставшие дети <w>плелись</w> позади родителей по дороге домой.",
                                "tr": "Yorgun çocuklar eve dönerken ebeveynlerinin arkasından <w>ağır ağır yürüdü</w>.",
                                "zh": "疲惫的孩子们在回家路上跟在父母后面，<w>慢腾腾地走</w>着。"
                            }
                        },
                        {
                            "text": "He <w>trailed</w> into the office late after a sleepless night.",
                            "target_lang_translations": {
                                "ru": "Он <w>притащился</w> в офис с опозданием после бессонной ночи.",
                                "tr": "Uykusuz bir gecenin ardından ofise geç bir şekilde <w>sürünerek girdi</w>.",
                                "zh": "一夜未眠后，他很晚才<w>拖着步子走</w>进办公室。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или идти медленно и устало, часто отставая от других.",
                        "tr": "Genellikle diğerlerinin gerisinde kalarak yavaş ve yorgun bir şekilde hareket etmek veya yürümek.",
