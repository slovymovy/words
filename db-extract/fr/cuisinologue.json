                        "examples": [
                            {
                                "example_id": "39d2f7fd-5e16-45de-a4a1-e6d510c4cd81",
                                "sense_id": "f38487ab-1f7f-3383-9d34-8151a35544f9",
                                "text": "Cependant, le premier dîner des Goncourt ne fut servi que le 26 février 1903, au Grand Hôtel, préparé par le célèbre cuisinier, on devrait dire « cuisinologue », Auguste Escoffier."
                            },
                            {
                                "example_id": "64f597c3-7fa9-4df5-a5fd-29ecd90d8967",
                                "sense_id": "f38487ab-1f7f-3383-9d34-8151a35544f9",
                                "text": "Là-bas, on appelle ça «tapear», «aller de taverne en taverne pour goûter des «tapas» et boire des «chacos», petits verres de vin blanc, rouge ou rosé», écrivait Xavier Domingo, fameux «cuisinologue» (décédé en 1996), dans son très bel ouvrage dédié au Goût de l'Espagne et aujourd'hui enfin réédité."
                            }
                        ]
                    }
