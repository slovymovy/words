                ],
                "senses": [
                    {
                        "sense_id": "d3abdb44-4cb2-3d7f-a28f-5f2adb362a18",
                        "entry_id": "b58f25b9-cc37-3af7-94cd-c46b2cd18c69",
                        "glosses": [
                            "Grumeau, tas."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c1e82441-5ca0-4f0e-acd1-8205cd556ae4",
                                "sense_id": "d3abdb44-4cb2-3d7f-a28f-5f2adb362a18",
                                "text": "Du gruau avec des mottons, ça passe pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "52c1ca2c-66b6-3710-b4de-a7296954e7f7",
                        "entry_id": "b58f25b9-cc37-3af7-94cd-c46b2cd18c69",
                        "glosses": [
                            "Grosse somme d’argent."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "58e9e86e-be60-4686-85af-0f6514987781",
                                "sense_id": "52c1ca2c-66b6-3710-b4de-a7296954e7f7",
                                "text": "Il a fait un beau motton avec ça."
                            }
                        ]
                    },
                    {
                        "sense_id": "3022af32-2dee-3fe6-8d41-086488683a37",
                        "entry_id": "b58f25b9-cc37-3af7-94cd-c46b2cd18c69",
                        "glosses": [
                            "Symptôme d’un grand trouble psychologique ou émotionnel."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "ed5737b3-5a9a-406a-a848-5e0a9b66bb1a",
                                "sense_id": "3022af32-2dee-3fe6-8d41-086488683a37",
                                "text": "«C’était vraiment dur. Vraiment, vraiment dur à filmer, insiste Pascale Renaud-Hébert. Je t’en parle, et j’ai encore le motton. […]. C’était très émotif.»"
                            },
                            {
                                "example_id": "3b7f86df-83b0-4113-9808-18f16aa1078d",
                                "sense_id": "3022af32-2dee-3fe6-8d41-086488683a37",
                                "text": "« J’ai trop le motton, Madame », lâche-t-il avec beaucoup de douceur dans la voix."
                            },
                            {
                                "example_id": "2a67eefb-2b0f-4fb6-8791-1998c58147a4",
                                "sense_id": "3022af32-2dee-3fe6-8d41-086488683a37",
                                "text": "On a le motton."
                            },
                            {
                                "example_id": "1cdaf1f1-4342-4887-9b12-259aaf8e7dbd",
                                "sense_id": "3022af32-2dee-3fe6-8d41-086488683a37",
                                "text": "Lors de l’éloge funèbre, on entendait bien qu’elle avait un motton dans la gorge."
                            },
                            {
                                "example_id": "e14bb6ec-7029-4123-bad9-e8986d57a6bb",
                                "sense_id": "3022af32-2dee-3fe6-8d41-086488683a37",
                                "text": "Ça m’a laissé comme un motton sur l’estomac."
                            }
                        ]
                    }
                ],
