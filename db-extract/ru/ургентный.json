                                "sense_id": "2f1dab5d-ef19-3bf7-8be8-750afcfa95c6",
                                "text": "Ургентное оперативное вмешательство."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e675ca0-a99d-43b8-853f-5ba6d4df2682",
