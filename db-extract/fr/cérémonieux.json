                                        "sense_id": "0897a797-0cb3-33c0-b519-c56132104bf9",
                                        "entry_id": "5c180879-37c4-3813-8638-6738686c62a9",
                                        "glosses": [
                                            "in der Art und Weise einer Feier, auf eine Feier bezogen; mit festlicher Stimmung oder Ausstattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7251bb-fd17-4e50-9099-7fcc0b43d055",
                                                "sense_id": "0897a797-0cb3-33c0-b519-c56132104bf9",
                                                "text": "Mit feierlicher Stimme verkündete der Chef den neuen Großauftrag."
                                            },
                                            {
                                                "example_id": "04b94200-9577-441c-b123-42559b0c18da",
                                                "sense_id": "0897a797-0cb3-33c0-b519-c56132104bf9",
