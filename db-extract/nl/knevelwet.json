                        "examples": [
                            {
                                "example_id": "bda6b64a-d1b0-4200-a386-532cf6106031",
                                "sense_id": "a0057666-f2e6-3600-b6a9-49bf6c8995ef",
                                "text": "Daarom hebben veel gemeenten lokaal knevelwetjes aangenomen die eigenaren van gevels verplichten om hun puien graffitivrij te houden. Een oer-Nederlandse aanpak: het slachtoffer draait op voor de kosten!"
                            },
                            {
                                "example_id": "d86dac0f-451a-48ec-abdc-a75e78374bc6",
                                "sense_id": "a0057666-f2e6-3600-b6a9-49bf6c8995ef",
                                "text": "Veel Braziliaanse leraren zijn bang dat het opnemen van hun lessen de vrijheid in het klaslokaal beperkt en dat de kwaliteit van het onderwijs zal verslechteren. Critici noemen het wetsvoorstel van de 'Partijloze Schoolbeweging' spottend de 'knevelwet', bedoeld om hen de mond te snoeren."
                            },
                            {
                                "example_id": "5d8fcc1e-fedb-4ed8-9bad-d9bd6c542366",
                                "sense_id": "a0057666-f2e6-3600-b6a9-49bf6c8995ef",
                                "text": "De krant La Repubblica protesteert vrijdag met een lege voorpagina. In het midden van het blad staat alleen een gele post-it met de mededeling: 'Deze knevelwet ontzegt de burgers hun recht op informatie'."
                            }
                        ]
                    }
