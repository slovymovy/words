                        "examples": [
                            {
                                "example_id": "fed5f796-8633-41c8-9627-002e0027765a",
                                "sense_id": "c37d5fd9-b2aa-3990-a9bb-4f31915cda8c",
                                "text": "The Duchess of Fitz-Fulke, who loved \"tracasserie,\" Began to treat him with some small \"agacerie.\""
                            },
                            {
                                "example_id": "a85b6417-5847-42f7-af14-b12f43e62126",
                                "sense_id": "c37d5fd9-b2aa-3990-a9bb-4f31915cda8c",
                                "text": "How can any man be well,\" replied the Count, holding his hand in such a position, as to make the performance of this little agacerie as difficult as possible ; \" how can any man be well, overwhelmed by sorrow and disgrace as I am?"
                            },
                            {
                                "example_id": "b30ff759-323a-4308-971a-bd1a35265965",
                                "sense_id": "c37d5fd9-b2aa-3990-a9bb-4f31915cda8c",
                                "text": "She was merry, witty, and even learned; and her manners were enticing and full of agacerie."
                            }
                        ]
                    }
                ],
