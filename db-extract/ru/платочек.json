                        "examples": [
                            {
                                "example_id": "c85a65e7-e8bd-478d-9224-b7a7448991e7",
                                "sense_id": "479608ae-2cbe-36ca-965f-e4d463ab0f84",
                                "text": "Мака́р Кузьми́ч молчи́т и стои́т недви́жим, пото́м достаёт из карма́на плато́чек и начина́ет пла́кать.",
                                "translation": "Makar Kuzmitch is silent and remains motionless, then he takes a handkerchief out of his pocket and begins to cry.",
                                "english": "Makar Kuzmitch is silent and remains motionless, then he takes a handkerchief out of his pocket and begins to cry."
