                "senses": [
                    {
                        "sense_id": "1f0c9384-1e7d-3453-9ff1-a69c4f09e608",
                        "entry_id": "946e7b25-23e2-39e1-97b1-328b5bc01988",
                        "glosses": [
                            "Vorsteher eines Produktionsbetriebes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1bed944-9b44-4f4d-a170-5b949808984c",
                                "sense_id": "1f0c9384-1e7d-3453-9ff1-a69c4f09e608",
                                "text": "„„Der in Deutschland vertriebene Landliebe-Grießpudding wird in Heilbronn hergestellt“, sagt der Werksleiter.“"
                            },
                            {
                                "example_id": "d2dd8ec7-3787-49e1-8f9d-76a19f71bb89",
                                "sense_id": "1f0c9384-1e7d-3453-9ff1-a69c4f09e608",
                                "text": "„„Die Tiere dürfen im Stall nicht angebunden sein und es muss Boxenlaufställe oder Flächen für den Weidegang geben“, sagt der Werksleiter.“"
                            },
                            {
                                "example_id": "991c018c-32ac-419a-9ae2-3c5ecc69e906",
                                "sense_id": "1f0c9384-1e7d-3453-9ff1-a69c4f09e608",
                                "text": "„„Durch den etwas höheren Preis sichern wir die hohe Qualität der Milch“, sagt der Werksleiter.“"
                            },
                            {
                                "example_id": "0071e529-9e80-4658-bf63-f86106f81fc9",
                                "sense_id": "1f0c9384-1e7d-3453-9ff1-a69c4f09e608",
                                "text": "„Werksleiter Marcus Heil steht an einem Fließband, über das kartonweise mit Landliebegrießpudding gefüllte Becher geschoben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
