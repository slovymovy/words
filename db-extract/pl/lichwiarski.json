                "senses": [
                    {
                        "sense_id": "f4572089-551e-3a2f-bc8e-e6115e40025a",
                        "entry_id": "c7cce570-9fb5-3719-a9cd-fddbbe13ad21",
                        "glosses": [
                            "dotyczący lichwy albo lichwiarza"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c62ec3eb-f7fd-4bec-9a64-011a503eff42",
                                "sense_id": "f4572089-551e-3a2f-bc8e-e6115e40025a",
                                "text": "To jest przede wszystkim efekt lichwiarskiego mechanizmu, który został uruchomiony w Polsce"
                            },
                            {
                                "example_id": "f42bb1b2-0e6a-400c-96a5-99380a3b3260",
                                "sense_id": "f4572089-551e-3a2f-bc8e-e6115e40025a",
                                "text": "Kredytów udzielano głównie na spłatę lichwiarskich długów, na dokupienie gruntu oraz na inwestycje"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92139ee3-c74b-4366-953a-a8944ecd7fe1",
                        "source_entry_id": "c7cce570-9fb5-3719-a9cd-fddbbe13ad21",
                        "source_sense_id": "f4572089-551e-3a2f-bc8e-e6115e40025a",
                        "target_lang_word": "usuraire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usuraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b50521c-4d17-3270-b423-92b6826ba8b6",
                                        "entry_id": "3d925b79-2b5c-34db-be5f-b13f634e6451",
                                        "glosses": [
                                            "Où il y a manifestement de l’usure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f914c7-c8de-448c-8cc3-21bb71bb3e11",
                                                "sense_id": "7b50521c-4d17-3270-b423-92b6826ba8b6",
                                                "text": "L’officier entreprit de faire une distinction entre les créanciers de l’état, d’exclure du droit absolu à la bonne foi du gouvernement ceux qui avaient prêté à un taux trop élevé, à un taux usuraire ; […]."
                                            },
                                            {
                                                "example_id": "65a4d853-5dd1-4cdd-8b01-c973c5d50215",
                                                "sense_id": "7b50521c-4d17-3270-b423-92b6826ba8b6",
                                                "text": "Il ne refusait jamais d'accéder aux demandes de petits prêts d'argent qu'il consentait à des taux point trop usuraires pour l'époque."
                                            },
                                            {
                                                "example_id": "44c01a5e-32f5-4db7-93fc-4de390a926bf",
                                                "sense_id": "7b50521c-4d17-3270-b423-92b6826ba8b6",
                                                "text": "Aux cultivateurs de la région, il prêtait sur hypothèques, comme pour leur rendre service et avec une bonhomie qui faisait oublier, sur le moment, ses taux usuraires."
                                            },
                                            {
                                                "example_id": "d75cbe14-f5f4-4081-a6f8-08a266fcb747",
                                                "sense_id": "7b50521c-4d17-3270-b423-92b6826ba8b6",
                                                "text": "– Huit pour cent ! Ça va bien. Je veux bien laisser Courtois répéter à tout bout de champ que ce n’est pas usuraire. C’est, en tout cas, terriblement lourd et, je peux le dire, entre nous, à la limite de l’honnêteté."
                                            },
                                            {
                                                "example_id": "286edf44-8108-4f2b-8630-0d0378322eb1",
                                                "sense_id": "7b50521c-4d17-3270-b423-92b6826ba8b6",
                                                "text": "Les serfs qui ne pouvaient payer les taxes exigées s’endettaient, souvent à des taux usuraires."
                                            },
                                            {
                                                "example_id": "c4fa6bed-3ecc-44a7-ab4b-07d29bf3865a",
                                                "sense_id": "7b50521c-4d17-3270-b423-92b6826ba8b6",
                                                "text": "Aux entreprises, il demande d’autre part de ne pas réclamer de « compensations usuraires » liées à ces arrêts de chantier pour cas de force majeure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
