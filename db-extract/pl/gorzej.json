                                        "sense_id": "24873fa9-91f3-357e-9345-70bd89e9df60",
                                        "entry_id": "8a4f8056-6cea-36b2-bce9-8834595d57c0",
                                        "glosses": [
                                            "comparative form of badly (adverb): more badly"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dbc336e-e650-4380-a055-c7e493ca72f6",
                                                "sense_id": "24873fa9-91f3-357e-9345-70bd89e9df60",
                                                "text": "The harder you try, the worse you do."
                                            },
                                            {
                                                "example_id": "6e87fc44-d2a7-4ed7-8e2f-21cecc130fc6",
                                                "sense_id": "24873fa9-91f3-357e-9345-70bd89e9df60",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377f4cd7-f807-3ad6-b7df-b84108e545fd",
                                        "entry_id": "8a4f8056-6cea-36b2-bce9-8834595d57c0",
                                        "glosses": [
                                            "Less skillfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "130f9cd8-97e0-4436-b46f-ae1975f0f751",
                                                "sense_id": "377f4cd7-f807-3ad6-b7df-b84108e545fd",
                                                "text": "He drives worse than anyone else I know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94aa518f-d6a7-3a58-b878-d4192e1dcf77",
                                        "entry_id": "8a4f8056-6cea-36b2-bce9-8834595d57c0",
                                        "glosses": [
                                            "More severely or seriously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e46075-d992-409e-b3af-da3068c7035a",
                                                "sense_id": "94aa518f-d6a7-3a58-b878-d4192e1dcf77",
                                                "text": "The bad news affected me worse than it did my brother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d54bb753-6dec-328e-ba1c-cb069fe183e9",
                                        "entry_id": "8a4f8056-6cea-36b2-bce9-8834595d57c0",
                                        "glosses": [
                                            "Used to start a sentence describing something that is worse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07b03d2-71bc-48ee-bb89-a5b068e44716",
                                                "sense_id": "d54bb753-6dec-328e-ba1c-cb069fe183e9",
                                                "text": "Her leg is infected. Still worse, she's developing a fever."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
