                    {
                        "translation_id": "379d3cdb-1499-479f-b76e-f1d65fb6ab13",
                        "source_entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
                        "target_lang_word": "profetie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profetie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "64efde3f-ea79-34b2-9439-d74f788a9649",
                                        "entry_id": "a0ea5844-ba4a-3b46-9334-b35b730b6d73",
                                        "glosses": [
                                            "een uitspraak uit naam van een godheid die de toekomst voorspelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9a22f6-5f3e-48c8-a0e9-1f2c6205b388",
                                                "sense_id": "64efde3f-ea79-34b2-9439-d74f788a9649",
                                                "text": "Over de profetieën in de Openbaring van Johannes is in de loop der eeuwen al veel te doen geweest."
                                            },
                                            {
                                                "example_id": "8070ec71-39c6-4db7-b756-69a9f49ae789",
                                                "sense_id": "64efde3f-ea79-34b2-9439-d74f788a9649",
                                                "text": "Maar wij hebben steeds meer energie gestoken in het rationeel doorgronden van natuurlijke gebeurtenissen: er zijn geen voortekenen of openbaringen meer, geen vloeken of profetieën; onze toekomst zal niet in godshuizen maar in laboratoria worden ontsluierd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6af0e578-8364-44b1-bfa1-924ee2c99b54",
                        "source_entry_id": "e60dfddd-a83f-32c5-bf34-a60f2f3b3686",
