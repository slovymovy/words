                ],
                "senses": [
                    {
                        "sense_id": "f01ae862-371b-3cc1-bd97-b8720e7ae620",
                        "entry_id": "8d664b3d-1bb6-39b0-8d0a-466199f78f70",
                        "glosses": [
                            "Gegenstand, der in einer Ausstellung präsentiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de075f33-42ad-4ccc-8f9a-83a8a29e0078",
                                "sense_id": "f01ae862-371b-3cc1-bd97-b8720e7ae620",
                                "text": "Wertvolle Exponate, die an andere Museen ausgeliehen werden, müssen versichert sein."
                            },
                            {
                                "example_id": "0a8ce0e0-ed5e-40a4-9ca2-463a27f61f17",
                                "sense_id": "f01ae862-371b-3cc1-bd97-b8720e7ae620",
                                "text": "„Unter den Exponaten im U-Boot-Archiv Cuxhaven befindet sich ein Gedicht aus Kriegstagen.“"
                            },
                            {
                                "example_id": "fb27b627-b90a-4651-8d6a-c14a07c6eae0",
                                "sense_id": "f01ae862-371b-3cc1-bd97-b8720e7ae620",
                                "text": "„Die Museen haben Angst, dass sie bei Echtheitsprüfungen ihre schönsten Exponate verlieren könnten.“"
                            },
                            {
                                "example_id": "2348ecd8-37b7-499f-98da-f9c675cd6f39",
                                "sense_id": "f01ae862-371b-3cc1-bd97-b8720e7ae620",
                                "text": "„Auch die Exponate in Museen weltweit kommen für Analysen in Betracht.“"
                            },
                            {
                                "example_id": "caac25af-783b-4c61-b671-a0c7f0386257",
                                "sense_id": "f01ae862-371b-3cc1-bd97-b8720e7ae620",
                                "text": "„Im Gegensatz zu den Exponaten der alten Wunderkammern haben sich die nunmehr vorgestellten Blaufunde in kaum einem Fall als Raritäten auszuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4757d2fb-bad0-43b7-a086-eacabe67312b",
                        "source_entry_id": "8d664b3d-1bb6-39b0-8d0a-466199f78f70",
                        "source_sense_id": "f01ae862-371b-3cc1-bd97-b8720e7ae620",
                        "source_sense_description": "Gegenstand, der in einer Ausstellung präsentiert wird",
                        "target_lang_word": "exhibit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhibit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e99081d1-0f27-3360-9228-e4e991382c38",
                                        "entry_id": "ec545239-a5ad-36c4-a1a6-7a58f053ca4f",
                                        "glosses": [
                                            "To display or show (something) for others to see, especially at an exhibition or contest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e06695-bcc0-462f-9b13-91ceaac9a970",
                                                "sense_id": "e99081d1-0f27-3360-9228-e4e991382c38",
                                                "text": "He wanted to exhibit his baseball cards."
                                            },
                                            {
                                                "example_id": "80b29764-3b80-4e74-86fe-23fecc67a85b",
                                                "sense_id": "e99081d1-0f27-3360-9228-e4e991382c38",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "b57cd636-6d38-45c1-acc3-35e4056d62cc",
                                                "sense_id": "e99081d1-0f27-3360-9228-e4e991382c38",
                                                "text": "The swimmer who is an expert does not exhibit his muscular force by violent movements, but exhibits some power which is invisible and which shows itself in perfect grace and reposefulness."
                                            },
                                            {
                                                "example_id": "cffbbbc3-5c01-4e64-bb34-0b29557e3dce",
                                                "sense_id": "e99081d1-0f27-3360-9228-e4e991382c38",
                                                "text": "A considerable number of derived nominals, especially thematic nouns, also exhibited o-grade roots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ddfa1d3-09f3-3744-ad67-d9302a0332eb",
                                        "entry_id": "ec545239-a5ad-36c4-a1a6-7a58f053ca4f",
                                        "glosses": [
                                            "To demonstrate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1cdb868-bba9-42a0-8364-bace16bbe476",
                                                "sense_id": "7ddfa1d3-09f3-3744-ad67-d9302a0332eb",
                                                "text": "The players exhibited great skill."
                                            },
                                            {
                                                "example_id": "f5791872-f9c2-485d-b382-51577fe46d5b",
                                                "sense_id": "7ddfa1d3-09f3-3744-ad67-d9302a0332eb",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them."
                                            },
                                            {
                                                "example_id": "5e0768c1-5899-49c2-9fe2-0b70b84e0dd5",
                                                "sense_id": "7ddfa1d3-09f3-3744-ad67-d9302a0332eb",
                                                "text": "“Because of the risk to public safety, efforts will be made to locate this group of river otters and remove them,” authorities said. “Care will be taken to only remove the animals exhibiting these unusual behaviors.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb9c4c4-ca08-325b-9fbe-64f1d61809e2",
                                        "entry_id": "ec545239-a5ad-36c4-a1a6-7a58f053ca4f",
                                        "glosses": [
                                            "To submit (a physical object) to a court as evidence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb7f5ad-ac00-4cbf-87ef-35ba792e1595",
                                                "sense_id": "ceb9c4c4-ca08-325b-9fbe-64f1d61809e2",
                                                "text": "I now exhibit this bloody hammer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44650e72-c6c5-3088-bc9c-ef5df49e993d",
                                        "entry_id": "ec545239-a5ad-36c4-a1a6-7a58f053ca4f",
                                        "glosses": [
                                            "To put on a public display."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2732b2-8b16-4c95-97ec-961212f8ee0f",
                                                "sense_id": "44650e72-c6c5-3088-bc9c-ef5df49e993d",
                                                "text": "Will you be exhibiting this year?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffed2d49-ec56-369f-8cc1-cd5301033526",
                                        "entry_id": "ec545239-a5ad-36c4-a1a6-7a58f053ca4f",
                                        "glosses": [
                                            "To administer as a remedy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae6ef51-811e-4946-9f32-3dd1b3529c17",
                                                "sense_id": "ffed2d49-ec56-369f-8cc1-cd5301033526",
                                                "text": "to exhibit calomel"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exhibit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9652f4c7-35ee-356d-a7de-358409f70104",
                                        "entry_id": "b3c1c41b-06e8-3a02-922f-7a208b35ef22",
                                        "glosses": [
                                            "An instance of exhibiting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f23c5015-00f3-3e10-a392-b7d1280766f0",
                                        "entry_id": "b3c1c41b-06e8-3a02-922f-7a208b35ef22",
                                        "glosses": [
                                            "That which is exhibited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9417c3ad-0248-4d56-8dc9-d3e6161895ac",
                                                "sense_id": "f23c5015-00f3-3e10-a392-b7d1280766f0",
                                                "text": "Mention must be made of the Valdres Folk Museum, situated just outside the town—one of those fascinating open-air museums for which Scandinavia is justly famed, to which have been transplanted a number of ancient buildings, such as farmhouses and storehouses, full of appropriate furniture, costumes and other exhibits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969c0566-b890-38ba-9970-ca0a23ea13b5",
                                        "entry_id": "b3c1c41b-06e8-3a02-922f-7a208b35ef22",
                                        "glosses": [
                                            "A public showing; an exhibition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd1f14f-cde8-4bc2-8265-77cfe7950e36",
                                                "sense_id": "969c0566-b890-38ba-9970-ca0a23ea13b5",
                                                "text": "The museum's new exhibit is drawing quite a crowd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "830354aa-1300-3c74-b836-f35a0ab04d1b",
                                        "entry_id": "b3c1c41b-06e8-3a02-922f-7a208b35ef22",
                                        "glosses": [
                                            "An article formally introduced as evidence in a court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed52a9c6-d24e-4544-8d20-6c42933f9450",
                                                "sense_id": "830354aa-1300-3c74-b836-f35a0ab04d1b",
                                                "text": "Exhibit A is this photograph of the corpse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
