{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef387647-c541-3f85-9737-b5b6d76a5728",
                    "sense_definition": "A domestic cat, especially one that is of mixed or non-pedigree breed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray <w>moggy</w> curled up comfortably on the front porch to escape the cold rain.",
                            "target_lang_translations": {
                                "es": "El <w>gato callejero</w> se acurrucó cómodamente en el porche delantero para refugiarse de la fría lluvia."
                            }
                        },
                        {
                            "text": "Instead of buying an expensive pedigree cat, they decided to adopt a friendly <w>moggy</w> from the shelter.",
                            "target_lang_translations": {
                                "es": "En vez de comprar un gato de raza caro, decidieron adoptar un cariñoso <w>gato común</w> del refugio."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Gato doméstico común, en especial uno que no es de raza pura o es mestizo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "gato común",
                                "target_lang_sense_clarification": "gato mestizo o sin pedigrí"
                            },
                            {
                                "target_lang_word": "gato mestizo",
                                "target_lang_sense_clarification": "animal sin pedigrí"
                            },
                            {
                                "target_lang_word": "minino",
                                "target_lang_sense_clarification": "coloquial para gato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1962877c-96f8-3a70-8de2-bfd46ed429a1",
                    "sense_definition": "A mouse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat waited patiently beside the skirting board hoping to catch a little <w>moggy</w>.",
                            "target_lang_translations": {
                                "es": "El gato esperó pacientemente junto al rodapié con la esperanza de atrapar a un pequeño <w>ratón</w>."
                            }
                        },
                        {
                            "text": "He thought he heard a tiny <w>moggy</w> scurrying across the floor of the barn.",
                            "target_lang_translations": {
                                "es": "Creyó oír a un diminuto <w>ratoncito</w> correteando por el suelo del granero."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Ratón (uso dialectal)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ratón",
                                "target_lang_sense_clarification": "roedor pequeño"
                            },
                            {
                                "target_lang_word": "ratoncito",
                                "target_lang_sense_clarification": "diminutivo afectuoso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2afe8281-cb02-3894-bbe4-bdc9b5c73cb2",
                    "sense_definition": "A young bovine animal; a calf.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer led the newborn <w>moggy</w> into the warm stable with its mother.",
                            "target_lang_translations": {
                                "es": "El granjero guio al <w>ternero</w> recién nacido hacia el establo cálido junto a su madre."
                            }
                        },
                        {
                            "text": "In the local dialect, a young cow was commonly referred to as a <w>moggy</w>.",
                            "target_lang_translations": {
                                "es": "En el dialecto local, se solía denominar <w>becerro</w> a una vaca joven."
                            }
                        }
                    ],
                    "synonyms": [
                        "calf"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Cría de la vaca; ternero o ternera (uso dialectal)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ternero",
                                "target_lang_sense_clarification": "cría de la vaca macho"
                            },
                            {
                                "target_lang_word": "becerro",
                                "target_lang_sense_clarification": "cría de la vaca"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21bdfc44-f4fc-37c9-abba-ffaadee32236",
                    "sense_definition": "A figure made to look like a human and set up in a field to frighten birds away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They erected a ragged <w>moggy</w> in the middle of the cornfield to scare the crows.",
                            "target_lang_translations": {
                                "es": "Montaron un <w>espantapájaros</w> andrajoso en medio del maizal para asustar a los cuervos."
                            }
                        },
                        {
                            "text": "Dressed in an old coat and hat, the <w>moggy</w> stood silently among the crops.",
                            "target_lang_translations": {
                                "es": "Vestido con un abrigo viejo y un sombrero, el <w>espantapájaros</w> permanecía en silencio entre los cultivos."
                            }
                        }
                    ],
                    "synonyms": [
                        "scarecrow"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Muñeco con figura humana que se pone en los sembrados para ahuyentar a los pájaros; espantapájaros."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "espantapájaros",
                                "target_lang_sense_clarification": "figura para espantar aves"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd0f5c7e-919f-3a96-a474-21cb8f6aa41c",
                    "sense_definition": "A traditional cake baked with treacle or golden syrup and ginger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She baked a traditional Yorkshire <w>moggy</w> filled with rich treacle for tea.",
                            "target_lang_translations": {
                                "es": "Horneó para el té un tradicional <w>pastel de jengibre y melaza</w> de Yorkshire repleto de rica melaza."
                            }
                        },
                        {
                            "text": "The sweet aroma of ginger filled the kitchen as the <w>moggy</w> cooled on the rack.",
                            "target_lang_translations": {
                                "es": "El dulce aroma a jengibre llenó la cocina mientras el <w>bizcocho de melaza</w> se enfriaba sobre la rejilla."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pastel o bizcocho tradicional del norte de Inglaterra elaborado con melaza o sirope dorado y jengibre."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pastel de jengibre y melaza",
                                "target_lang_sense_clarification": "pastel tradicional de Yorkshire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff5791c8-a259-3a09-9862-7124f0d7c7d0",
                    "sense_definition": "A girl or young woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old Scottish song, the pedlar traveled across the hills with his young <w>moggy</w>.",
                            "target_lang_translations": {
                                "es": "En la vieja canción escocesa, el buhonero viajaba por las colinas con su joven <w>muchacha</w>."
                            }
                        },
                        {
                            "text": "The traditional tale tells of a spirited <w>moggy</w> who disguised herself as a soldier.",
                            "target_lang_translations": {
                                "es": "El cuento tradicional narra la historia de una intrépida <w>moza</w> que se disfrazó de soldado."
                            }
                        }
                    ],
                    "synonyms": [
                        "girl"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Muchacha o mujer joven (término arcaico o dialectal)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "muchacha",
                                "target_lang_sense_clarification": "mujer joven"
                            },
                            {
                                "target_lang_word": "chica",
                                "target_lang_sense_clarification": "joven"
                            },
                            {
                                "target_lang_word": "moza",
                                "target_lang_sense_clarification": "mujer joven (arcaico o rural)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "963b12de-a07e-3a86-b68c-8474572eca35",
                    "sense_definition": "An untidily dressed or slovenly woman; a slattern.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her clothes were torn and disheveled, making her look like an absolute <w>moggy</w>.",
                            "target_lang_translations": {
                                "es": "Llevaba la ropa rota y desaliñada, lo que la hacía parecer una auténtica <w>zarrapastrosa</w>."
                            }
                        },
                        {
                            "text": "The festival parade featured a troupe of raggedly attired figures known as <w>moggies</w>.",
                            "target_lang_translations": {
                                "es": "El desfile del festival incluía una comparsa de figuras andrajosas conocidas como <w>desastrados</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slattern"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Mujer desaliñada, desastrada o andrajosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "zarrapastrosa",
                                "target_lang_sense_clarification": "mujer desaliñada o andrajosa"
                            },
                            {
                                "target_lang_word": "desastrada",
                                "target_lang_sense_clarification": "persona desarreglada"
                            },
                            {
                                "target_lang_word": "marimanta",
                                "target_lang_sense_clarification": "mujer desaliñada (anticuado)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d16e4b54-e441-3e61-a506-8c0d687b2fb2",
                    "sense_definition": "Irrational, confused, or out of touch with reality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hours under the blazing sun, he started speaking nonsense and seemed completely <w>moggy</w>.",
                            "target_lang_translations": {
                                "es": "Tras horas bajo el sol abrasador, empezó a decir tonterías y parecía completamente <w>chiflado</w>."
                            }
                        },
                        {
                            "text": "I could not follow his <w>moggy</w> explanation because none of his arguments made any sense.",
                            "target_lang_translations": {
                                "es": "No pude seguir su <w>disparatada</w> explicación porque ninguno de sus argumentos tenía sentido."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "South Africa"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Irracional, confuso o desconectado de la realidad (coloquial sudafricano)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "chiflado",
                                "target_lang_sense_clarification": "coloquial para loco o confuso"
                            },
                            {
                                "target_lang_word": "desvariado",
                                "target_lang_sense_clarification": "que dice desatinos"
                            },
                            {
                                "target_lang_word": "despistado",
                                "target_lang_sense_clarification": "desorientado o confundido"
                            }
                        ]
                    }
                }
            ]
        }
    ]
