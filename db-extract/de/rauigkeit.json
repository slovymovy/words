                "senses": [
                    {
                        "sense_id": "b74e7954-6acd-3e97-b6e6-77a037f5a0e2",
                        "entry_id": "782f551b-34d0-303f-8034-923028dd1a45",
                        "glosses": [
                            "Eigenschaft, rau zu sein, also nicht glatt, ebenmäßig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9be79dac-c8cf-4051-8617-ad9d2138e53d",
                                "sense_id": "b74e7954-6acd-3e97-b6e6-77a037f5a0e2",
                                "text": "„Ohne unseren Tastsinn wüssten wir nichts von Rauigkeit und Härte, Gewicht und Temperatur.“"
                            },
                            {
                                "example_id": "b4e13a5e-ce6c-45f5-bbe3-5e63cd3bd507",
                                "sense_id": "b74e7954-6acd-3e97-b6e6-77a037f5a0e2",
                                "text": "„Mit weicher werdender Konsistenz nimmt die Rauigkeit ab.“"
                            },
                            {
                                "example_id": "a8eff70d-2bde-4c9b-9289-cc57563f0329",
                                "sense_id": "b74e7954-6acd-3e97-b6e6-77a037f5a0e2",
                                "text": "„Vielmehr zeichnet sich menschliches Schreien durch eine Eigenschaft aus, die als Rauigkeit bezeichnet wird.“"
                            },
                            {
                                "example_id": "e231b94a-68fa-43ca-a6e7-657fc5a1ee5b",
                                "sense_id": "b74e7954-6acd-3e97-b6e6-77a037f5a0e2",
                                "text": "„Studien haben gezeigt, dass zum Beispiel Lycopin aus Tomaten und Tomatenprodukten die Rauigkeit der Haut reduziert und die Oberfläche, die Epidermis, glättet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
