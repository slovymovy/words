                                                "sense_id": "57d9bb82-ba53-3028-8d1d-94e5d0beae6a",
                                                "text": "„Basis eines Hologramms ist die Aufzeichnung von sich überlagernden Lichtwellen einer Lichtquelle.“"
                                            },
                                            {
                                                "example_id": "46b5cc41-bd3f-46bc-878e-ab0aafedae76",
                                                "sense_id": "57d9bb82-ba53-3028-8d1d-94e5d0beae6a",
                                                "text": "Beim Kippen des Geldscheins werden im Hologramm abwechselnd die Wertzahl und das €-Symbol sichtbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
