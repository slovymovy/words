                        "glosses": [
                            "ein Vertreter der Gibbonähnlichen oder kleinen Affen (Hylobatidae), der die Wälder Sumatras bewohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf30b14-c364-4084-a7b4-21a55cd688d1",
                                "sense_id": "d2564538-c3b4-3492-bc30-56801314233f",
                                "text": "Die Unkas sind wohl die seltenste Art von Gibbons."
                            },
                            {
