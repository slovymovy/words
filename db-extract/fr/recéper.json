                    }
                ],
                "senses": [
                    {
                        "sense_id": "b732a561-3450-36d3-94cb-a0aba4895c8e",
                        "entry_id": "132dc046-02a0-3da9-89e3-ebe0c44fcf97",
                        "glosses": [
                            "Couper au pied les ceps de vigne afin qu’ils poussent mieux."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "02606ff0-b7f2-4080-8b18-adf8e897e003",
                                "sense_id": "b732a561-3450-36d3-94cb-a0aba4895c8e",
                                "text": "Les vignerons recèpent la vigne tous les ans et ne laissent qu’un moignon hideux et sans échalas au milieu d’un entonnoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6f3e278-fc9d-3dde-b77f-0cb18e8ccb8a",
                        "entry_id": "132dc046-02a0-3da9-89e3-ebe0c44fcf97",
                        "glosses": [
                            "Tailler des arbres, des arbustes en ne gardant que les branches principales pour leur donner plus de vigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1894f66b-202d-4554-a810-ada7c45fc701",
                                "sense_id": "d6f3e278-fc9d-3dde-b77f-0cb18e8ccb8a",
                                "text": "Puis, ordonner à cet homme d’être implacable, de retrancher les branches pourries, de recéper l’arbre aristocratique."
                            },
                            {
                                "example_id": "3de64e1e-8e21-45a4-8427-2432123b8917",
                                "sense_id": "d6f3e278-fc9d-3dde-b77f-0cb18e8ccb8a",
                                "text": "Quelques arbres peuvent être traités comme des arbustes s'ils sont recépés : j'ai, par exemple, quelques tilleuls (Tilia spp.) en cépée dans mon jardin pour leurs feuilles délicieuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "1eac005a-157e-37c5-bb8c-ccba3fc2a59f",
                        "entry_id": "132dc046-02a0-3da9-89e3-ebe0c44fcf97",
                        "glosses": [
                            "Couper la tête des pieux, des pilotis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474cffb9-a449-492b-90a2-c0205927d52f",
                                "sense_id": "1eac005a-157e-37c5-bb8c-ccba3fc2a59f",
                                "text": "Machine à recéper."
                            }
                        ]
                    }
                ],
