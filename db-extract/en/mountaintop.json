                                                "sense_id": "fef906e0-7409-3d60-bf54-08b069582d55",
                                                "text": "Die Bergspitze wurde abgetragen, damit darauf ein Hotel gebaut werden kann."
                                            },
                                            {
                                                "example_id": "6935cf12-b6c5-4201-a3e6-d9788f52aa9d",
                                                "sense_id": "fef906e0-7409-3d60-bf54-08b069582d55",
                                                "text": "Auf der Bergspitze liegt ganzjährig Schnee."
                                            }
