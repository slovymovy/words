                                    {
                                        "sense_id": "f94dbb89-cc0b-33e9-9c64-6ac7c84fe95e",
                                        "entry_id": "e89f22e6-6c41-3633-bf30-bbdf79a6b387",
                                        "glosses": [
                                            "Ramener, par réchauffement progressif, un corps congelé à son état primitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f44ac9-471b-4ad0-8fde-6a2b9dc1e32b",
                                                "sense_id": "f94dbb89-cc0b-33e9-9c64-6ac7c84fe95e",
                                                "text": "Après six mois et plus, en la [la viande] laissant se décongeler lentement à l’air, elle reprend l’aspect, l'élasticité et le goût qu’elle avait à l’origine ; […]."
                                            }
                                        ]
                                    }
                                ]
