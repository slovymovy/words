                "senses": [
                    {
                        "sense_id": "46deb83d-3679-3f22-86f4-b1e50266716d",
                        "entry_id": "9909e7ba-c64b-3a45-ace9-e5e98e42698f",
                        "glosses": [
                            "zły duch, złośliwy duszek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50194284-f652-4ea2-b695-c6e9aa774cf5",
                                "sense_id": "46deb83d-3679-3f22-86f4-b1e50266716d",
                                "text": "Rzucił się do [tych] piesków z dziwną pasją, wyganiał je[,] jakby to była grupka szatanków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ff45bac5-b415-3e5d-80fc-41e9f352e42e",
                        "entry_id": "9909e7ba-c64b-3a45-ace9-e5e98e42698f",
                        "glosses": [
                            "o dziewczynie ( chłopcu/dziecku): figlarka, trzpiotka, dziewczyna zalotna"
                        ],
                        "tags": [
                            "metaphoric",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6d121347-2e04-4234-b585-726d5e743693",
                                "sense_id": "ff45bac5-b415-3e5d-80fc-41e9f352e42e",
                                "text": "Figlarny szatanek wabił mię kusząco"
                            },
                            {
                                "example_id": "ed1c9419-ceff-48e8-b80f-bc73226e5e19",
                                "sense_id": "ff45bac5-b415-3e5d-80fc-41e9f352e42e",
                                "text": "Ten szatanek wyglądający z[ ]za pleców księżny [księżnej] tyle miał ponęt, te oczki tak świeciły jasno, że pana Longina aż ciągnęło coś, by w nie choć jeszcze raz tylko spojrzeć"
                            },
                            {
                                "example_id": "4683f7dd-6c98-4b6c-8b68-54c4e577eb3b",
                                "sense_id": "ff45bac5-b415-3e5d-80fc-41e9f352e42e",
                                "text": "— Ale to skończony szatanek! — zawołała Ciotka… [—] Moja droga… ją trzeba wydać co najrychlej… bo… no — zobaczysz"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
