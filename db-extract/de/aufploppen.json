                "senses": [
                    {
                        "sense_id": "151b95f2-a688-3737-911f-476454a52e3e",
                        "entry_id": "0aae5f9b-da82-3866-ae25-97328db6ba18",
                        "glosses": [
                            "geräuschvoll (mit einem Plopp) erscheinen"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bd8513c9-013c-4edf-93cf-ae5d85b5082a",
                                "sense_id": "151b95f2-a688-3737-911f-476454a52e3e",
                                "text": "Außerdem ist es schwer, sich auf Grammatik zu konzentrieren, wenn in der Kurspause Kriegsnachrichten aufploppen."
                            },
                            {
                                "example_id": "ae076cfc-041c-4b57-8b99-ab257c68a30d",
                                "sense_id": "151b95f2-a688-3737-911f-476454a52e3e",
                                "text": "Ich öffnete die Messenger-App und die Nachricht ploppte auf, aber sie hatte jetzt keinen Absender mehr, es gab nur noch einen anonymen Facebook-Nutzer, ich konnte auf die Unterhaltung nicht antworten."
                            },
                            {
                                "example_id": "7e8eb6fa-5ba6-47ad-b4af-91400dcd0247",
                                "sense_id": "151b95f2-a688-3737-911f-476454a52e3e",
                                "text": "Die Nachricht ploppte auf dem Sperrbildschirm auf."
                            },
                            {
                                "example_id": "9c1eda19-8cbb-4ee0-8246-d6c607f2ec72",
                                "sense_id": "151b95f2-a688-3737-911f-476454a52e3e",
                                "text": "Die Nachricht ploppte auf dem Handy von Nadja alle Namen geändert um 3.29 Uhr auf."
                            },
                            {
                                "example_id": "c0541067-ccf0-4fd2-9baa-a2295cfae2b3",
                                "sense_id": "151b95f2-a688-3737-911f-476454a52e3e",
                                "text": "Nachdem sie auf Amazon und Zalando geschaut hatte, ploppte auf einmal auf Facebook eine Werbeanzeige in ihrem Feed auf: ein Foto von sechs Models in Dirndl, die im Stechschritt einen Park durchqueren, dazu der Text: \"Es tut uns leid, dass unser Bekleidungsgeschäft diese Katastrophe nicht überlebt hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
