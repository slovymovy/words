                    {
                        "translation_id": "32c30ebe-26a9-487d-852a-de152c12c85b",
                        "source_entry_id": "365caa38-1259-3182-b8b6-bbc997bf5e9d",
                        "source_sense_description": "of radio waves",
                        "target_lang_word": "kurzwellig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurzwellig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                        "entry_id": "19831885-083b-3a8f-b02f-42e1e6e888f4",
                                        "glosses": [
                                            "eine kurze Wellenlänge habend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab43bdb9-9cc5-4805-bedf-c676ca31c365",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„Von der Sonne empfangen wir kurzwellige Strahlung und zwar 342 Watt pro Quadratmeter Erdoberfläche.“"
                                            },
                                            {
                                                "example_id": "caf5fb29-fd27-4281-b103-40134521d0e4",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "Das kurzwellige Sonnenlicht, dass der Treiber für eine warme Erde ist, wird von Wolken und weißen Flächen in Arktis und Antarktis in den Weltraum zurück reflektiert."
                                            },
                                            {
                                                "example_id": "5b6b1f96-fce7-45dc-b0d6-8727669cb761",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„Chiphersteller setzen auf extrem kurzwelliges Ultaviolettlicht (EUV), um ihre Produkte weiter zu verkleinern.“"
                                            },
                                            {
                                                "example_id": "b721c0e3-0a9e-400c-ae75-5a7e0397603b",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„Der erst kürzlich entdeckte äußerste Ring des Planeten Uranus ist strahlend blau […] Die ungewöhnliche Farbe entsteht, weil der Ring nur aus entsprechend winzigen Partikeln im Mikrometerbereich aufgebaut ist, die das kurzwellige Licht streuen.“"
                                            },
                                            {
                                                "example_id": "032bf62b-6202-44e2-ab7c-f77947d11c17",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„[Die die Erde in 15 km Höhe umhüllende Ozonschicht] absorbiert die schädliche kurzwellige UV-Strahlung der Sonne.“"
                                            },
                                            {
                                                "example_id": "4f50da3d-a8e6-404f-9189-d1f26302140f",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„Die neuen Teleskope sollen nach Gammastrahlen Ausschau halten. Dieses extrem kurzwellige und energiereiche Licht ist noch relativ neu für die Astronomen.“"
                                            },
                                            {
                                                "example_id": "be1e421d-6e95-4bfc-9dc0-29be7d92c2ed",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„Forscher […] haben einen gepulsten Infrarot- Laserstrahl in kurzwellige Lichtblitze umgewandelt, deren Spektrum sich bis in den Röntgenbereich erstreckt.“"
                                            },
                                            {
                                                "example_id": "ec4c052a-c13b-4ea3-b551-3934578606d3",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„[Beim sogenannten Blutmond] werden die kurzwelligen blauen Anteile des Sonnenlichts stark gestreut, die langwelligen roten Anteile gelangen stärker gebündelt bis zum Mond durch.“"
                                            },
                                            {
                                                "example_id": "a480b800-6880-4110-af1a-8b760df1416a",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„Gibts im roten Morgenlicht einen Regenbogen, ist auch dieser rot. Zu dieser Zeit steht die Sonne tief, das Sonnenlicht macht einen langen weg und die kurzwelligen Anteile Violett, Blau und grün werden weg gestreut und so bleibt nur noch Gelb und Rot übrig für den Regenbogen.“"
                                            },
                                            {
                                                "example_id": "980203d2-14a4-4178-a91a-f5ca3e0a2c6e",
                                                "sense_id": "99c1d984-001f-3347-bc53-2ec69d1b0e02",
                                                "text": "„Die oberste Schicht [Anmerkung: der neuen Solarzellen] nutzt die kurzwelligen blauen Anteile des Lichts, die mittlere die grünen Anteile, und die unterste Schicht wandelt den langwelligen Infrarot-Anteil um. Nur so werden Spitzenwirkungsgrade möglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
