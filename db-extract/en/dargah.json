                        "tags": [
                            "South-Asia"
                        ],
                        "examples": [
                            {
                                "example_id": "cde80f50-b223-448d-b06d-f1dc38120f97",
                                "sense_id": "8e4d1422-37d1-3e60-bff2-6a46527239f7",
                                "text": "If not for the fakir's dargah the village might well have melted back into the mud, its inhabitants not being the kind of people to tarry long in one place […]."
                            },
                            {
                                "example_id": "98cdbde2-5e2b-47ca-a63e-b119d9437b5f",
                                "sense_id": "8e4d1422-37d1-3e60-bff2-6a46527239f7",
                                "text": "But beyond the dargah, and the medieval warren in which it sits, north India's present-day politics can be a good deal less accommodating of religious diversity."
                            }
                        ]
                    }
