                    {
                        "sense_id": "091f47cf-7bc0-38b7-a96f-42d909f8e31b",
                        "entry_id": "adc96087-1188-3931-8e52-bb7441ef681f",
                        "glosses": [
                            "deel van een land dat door een vreemde mogenheid wordt bestuurd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5742310b-3d51-49e0-9462-99e026d6c328",
                                "sense_id": "091f47cf-7bc0-38b7-a96f-42d909f8e31b",
                                "text": "De gravure staat op een lijst van kunst die in 1945 spoorloos verdween uit de Franse bezettingszone van Duitsland."
                            },
                            {
                                "example_id": "d9265415-0dee-4356-9c57-97d26797aa50",
                                "sense_id": "091f47cf-7bc0-38b7-a96f-42d909f8e31b",
                                "text": "Maar er waren ook praktische redenen om het proces in Neurenberg te houden, hoewel de stad in puin lag. De stad lag in de Amerikaanse bezettingszone en toevallig was de rechtbank niet verwoest tijdens de oorlog."
                            },
                            {
                                "example_id": "ccc788c3-41c4-4b54-bfca-a0eea0a47a5b",
                                "sense_id": "091f47cf-7bc0-38b7-a96f-42d909f8e31b",
                                "text": "Brandenburg grenst in het oosten aan Polen en is met ongeveer 2,5 miljoen inwoners relatief dunbevolkt. Na de Tweede Wereldoorlog werd het onderdeel van de bezettingszone van de Sovjet Unie. Op 3 oktober 1990 kwam de huidige vorm van de deelstaat, na de val van de DDR, tot stand."
                            }
                        ]
                    }
