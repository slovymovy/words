                        "entry_id": "c65f56db-8728-33b8-8b09-b26d340cb01a",
                        "glosses": [
                            "betrekking hebbend op het zichzelf dingen aanleren zonder tussenkomst van een onderwijsinstelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e76e5d-5b42-475c-ba22-81ec12753d95",
                                "sense_id": "151de21e-910f-3760-a53a-fc848a3181a8",
                                "text": "Groot hoopt verder dat de overheid zijn informatie gaat gebruiken om te kijken of het aantal rondzwervende pet-flessen vermindert. Als autodidactisch zwerfafvaldeskundige vindt hij de huidige methode niet nauwkeurig genoeg."
                            },
                            {
                                "example_id": "75793d72-c28f-4c70-ac78-55ba18779f79",
                                "sense_id": "151de21e-910f-3760-a53a-fc848a3181a8",
                                "text": "Autodidactisch als hij was, schilderde hij het ene na het andere pleidooi voor een eigen, wondere werkelijkheid."
                            }
                        ]
                    }
                ],
