                ],
                "senses": [
                    {
                        "sense_id": "eecf57b9-9479-3d10-8393-0e9f6253c255",
                        "entry_id": "4fc7020a-9dec-3e4a-b073-ff70d724e87c",
                        "glosses": [
                            "Enlever les parcloses d'une fenêtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2402fbbd-21c0-4b86-a032-c8267737b62c",
                                "sense_id": "eecf57b9-9479-3d10-8393-0e9f6253c255",
                                "text": "Quant aux vantaux qui piquent du nez, le meilleur est de connaître l’astuce pour déparcloser et recaler les vitrages mais si on ne sait pas faire cela, on peut tenter de régler les ferrures ou les paumelles en vissant celles du haut."
                            },
                            {
                                "example_id": "2f641286-58d0-45ae-9a02-fbee782edcef",
                                "sense_id": "eecf57b9-9479-3d10-8393-0e9f6253c255",
                                "text": "Il faut déparcloser et caler les vitrages correctement, ce n’est pas en dévissant les gond que l’on règle une fenêtre comme il se doit."
                            },
                            {
                                "example_id": "7921ea11-089d-438f-a5b6-fb387a8c6fe9",
                                "sense_id": "eecf57b9-9479-3d10-8393-0e9f6253c255",
                                "text": "Déparcloser et coller le joint sur l’ailette extérieure."
                            }
                        ]
                    }
