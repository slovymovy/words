                "senses": [
                    {
                        "sense_id": "dc3747a3-8201-321b-83de-21b8c6d62b08",
                        "entry_id": "64fe5f1e-0995-3c96-af06-e17bc727f3fe",
                        "glosses": [
                            "main or central camp; the administrative center of a complex of camps and/or places of forced labour (originally used of prisoner-of-war camps, later also – and now especially – of concentration camps)"
                        ],
                        "tags": [
                            "historical",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5a20adfc-17f4-4cba-b79f-ad1c21c752bf",
                                "sense_id": "dc3747a3-8201-321b-83de-21b8c6d62b08",
                                "text": "In den Stammlagern wurden die Kriegsgefangenen registriert und auf die Betriebe verteilt.",
                                "translation": "In the main camps, the prisoners of war were registered and distributed to the places of labour.",
                                "english": "In the main camps, the prisoners of war were registered and distributed to the places of labour."
                            },
                            {
                                "example_id": "4c611f12-3622-490e-9eab-5d041a383692",
                                "sense_id": "dc3747a3-8201-321b-83de-21b8c6d62b08",
                                "text": "Das Stammlager Auschwitz I diente als Verwaltungszentrum des gesamten Auschwitz-Lagerkomplexes.",
                                "translation": "Auschwitz I, the main camp, served as the administrative centre of the whole Auschwitz camp complex.",
                                "english": "Auschwitz I, the main camp, served as the administrative centre of the whole Auschwitz camp complex."
                            }
                        ]
                    }
