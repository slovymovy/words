                {
                    "sense_id": "55442f6d-5a42-36a7-8bdc-5c8b4da41439",
                    "sense_definition": "An area of land adjoining a house, typically covered with grass or paved.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "area_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children love to play in the <w>yard</w> after school.",
