                "senses": [
                    {
                        "sense_id": "555c302a-b061-3297-a990-ee5422fb5111",
                        "entry_id": "422da879-fda0-3817-b30d-24033121b597",
                        "glosses": [
                            "рег. (сиб.) дикий козёл, самец косули (лат. Cervus pyragrus) [Даль]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2484bf43-4778-4665-9d67-aa7f9ce9ccb3",
                                "sense_id": "555c302a-b061-3297-a990-ee5422fb5111",
                                "text": "Далеко впереди раздаётся изредка глухой, отрывистый голос козла самца, или, как в Сибири его называют, гурана .."
                            },
                            {
                                "example_id": "0a05fa1f-52ba-484d-acd7-f9b35b35c802",
                                "sense_id": "555c302a-b061-3297-a990-ee5422fb5111",
                                "text": "Обыкновенно, прокричав, извергнув гнев, гуран удирает подобру-поздорову."
                            },
                            {
                                "example_id": "8d974705-f714-4fd8-9740-387da36c2a11",
                                "sense_id": "555c302a-b061-3297-a990-ee5422fb5111",
                                "text": "Но вот рогатый гуран коротко мякнул ― и весь табун смешанной толпой бросился к зароду."
                            }
                        ]
                    }
                ],
