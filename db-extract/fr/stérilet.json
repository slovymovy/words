        "fr-extract.jsonl": [
            {
                "entry_id": "7033bda6-f3f8-3a0b-889f-8aef83e70742",
                "word": "stérilet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "98530dec-1225-4e9e-87f1-10761fb0f8a0",
                        "entry_id": "7033bda6-f3f8-3a0b-889f-8aef83e70742",
                        "tags": [
                            "plural"
                        ],
                        "form": "stérilets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da812d67-bd9e-33b3-ad3d-9512a769a31b",
                        "entry_id": "7033bda6-f3f8-3a0b-889f-8aef83e70742",
                        "glosses": [
                            "Contraceptif intra-utérin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ebbb5d-e614-4b64-8b97-06d54d62c675",
                                "sense_id": "da812d67-bd9e-33b3-ad3d-9512a769a31b",
                                "text": "Ainsi, donner une pilule en continu ou poser un stérilet libérant des hormones permet à certaines femmes de ne plus souffrir et de vivre normalement."
                            },
                            {
                                "example_id": "802a49d1-ca3c-49ff-8d25-d119812a02bd",
                                "sense_id": "da812d67-bd9e-33b3-ad3d-9512a769a31b",
                                "text": "C'est en juillet 1964, lors d'une conférence de presse dans le grand amphithéâtre du boulevard des Invalides, prêté pour la circonstance par le laboratoire Roussel, que Pierre Simon présente le « stérilet », selon le néologisme qu'il a lui-même inventé pour désigner l'objet en forme de T mais qu'il préfère décrire par goût de la provocation anticléricale comme « une sorte de crosse d'évêque finissant en grains de chapelet »."
                            },
                            {
                                "example_id": "40caebd2-c8cf-4435-9a90-2fe5428819a4",
                                "sense_id": "da812d67-bd9e-33b3-ad3d-9512a769a31b",
                                "text": "Les stérilets au cuivre contiennent du cuivre qui a un effet spermicide."
                            },
                            {
                                "example_id": "010931fd-8d43-419e-991d-a1c076e864a7",
                                "sense_id": "da812d67-bd9e-33b3-ad3d-9512a769a31b",
                                "text": "Les stérilets ont rendu les pessaires obsolètes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae8f990f-41ea-4f4d-8ac5-dbcd9ffff7f0",
                        "source_entry_id": "7033bda6-f3f8-3a0b-889f-8aef83e70742",
                        "source_sense_id": "da812d67-bd9e-33b3-ad3d-9512a769a31b",
                        "target_lang_word": "intrauterine device",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrauterine device",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5581fb80-b452-3ddc-98c3-c2b114e01b4f",
                                        "entry_id": "bcdf8bf5-805b-3562-8625-3b223ac09f00",
                                        "glosses": [
                                            "A contraceptive device consisting of a spiral or similar shape of plastic or metal inserted through the vagina into the uterus in order to prevent the implantation of a fertilized egg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72fa414e-fd98-4238-90c7-51b4c3e84b98",
                                                "sense_id": "5581fb80-b452-3ddc-98c3-c2b114e01b4f",
                                                "text": "Types of progestagen-only contraceptives available in the UK and US include the implant, the hormonal intrauterine device (IUD), the contraceptive injection and the minipill."
                                            },
                                            {
                                                "example_id": "20541409-b0b2-4f21-aca7-4cc062e96dd4",
                                                "sense_id": "5581fb80-b452-3ddc-98c3-c2b114e01b4f",
                                                "text": "The latest research, published Wednesday in the medical journal JAMA, analyzed years of health records for thousands of Danish women ages 15 to 49, with an even split between those who started using intrauterine devices that release the hormone levonorgestrel for birth control and those who hadn’t used any type of hormonal contraceptive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
