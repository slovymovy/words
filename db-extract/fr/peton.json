                ],
                "senses": [
                    {
                        "sense_id": "2380b408-b54b-3f5c-a38b-8b869ded8e43",
                        "entry_id": "2c5ea94d-7fca-3ce2-aeb7-08213eebe545",
                        "glosses": [
                            "Petit pied."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0f4b4a65-a670-4d93-9982-f28ff02bd90f",
                                "sense_id": "2380b408-b54b-3f5c-a38b-8b869ded8e43",
                                "text": "Oh, le pauvre petit peton tout enflé !"
                            },
                            {
                                "example_id": "7e4dc51c-02c9-4cf1-90d9-8e40790270a8",
                                "sense_id": "2380b408-b54b-3f5c-a38b-8b869ded8e43",
                                "text": "— Les hommes sans chaussures n’ont qu’à se présenter, pieds nus, à l’état-major, et le commandant les mènera lui-même à la mairie. Ils auront mis la baïonnette au canon et des cartouches dans la giberne.\nOn est venus au rendez-vous, petons au vent."
                            },
                            {
                                "example_id": "5eab985e-7f5d-43d9-aea7-1e6151656427",
                                "sense_id": "2380b408-b54b-3f5c-a38b-8b869ded8e43",
                                "text": "Elle avait de tout petits petons, Valentine, Valentine."
                            },
                            {
                                "example_id": "1fadd504-191c-482a-aa0c-05435610817d",
                                "sense_id": "2380b408-b54b-3f5c-a38b-8b869ded8e43",
                                "text": "À tâtons, à petons, Cambronne Mâcheclair récupéra ses chaussures sous la table."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82c1fa3b-6d01-45ec-b728-d43196e8fe55",
                        "source_entry_id": "2c5ea94d-7fca-3ce2-aeb7-08213eebe545",
                        "source_sense_id": "2380b408-b54b-3f5c-a38b-8b869ded8e43",
                        "target_lang_word": "Füßlein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "42f0fe4a-d937-4eae-9281-b32edd2cae72",
                        "source_entry_id": "2c5ea94d-7fca-3ce2-aeb7-08213eebe545",
                        "source_sense_id": "2380b408-b54b-3f5c-a38b-8b869ded8e43",
                        "target_lang_word": "Füßchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Füßchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                        "entry_id": "ad9c3cc0-b773-3a72-a97a-39cf76d14828",
                                        "glosses": [
                                            "kleiner Fuß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7f2c2b4-42f6-4c40-a932-0457fd8cb11f",
                                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                                "text": "Die Mutter zog dem Baby Söckchen über die Füßchen."
                                            },
                                            {
                                                "example_id": "b4705fd0-e0e4-4e57-ac8d-451c61dc8b65",
                                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                                "text": "„Ich nahm sie in der folgenden Nacht wieder auf und erblickte die vier Füßchen bis zum Knöchel.“"
                                            },
                                            {
                                                "example_id": "7633ae69-385b-484a-87f5-d8cbb13b4117",
                                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                                "text": "„Sie saßen auf Acrylstühlen für Erwachsene, so dass ihre Füßchen in den glänzenden Schuhen über dem Fußboden baumelten.“"
                                            },
                                            {
                                                "example_id": "0fee216d-7d26-4644-8cf4-a306deb897d6",
                                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                                "text": "„Blumenschmuck umrahmte ihr gepudertes Antlitz, und unter dem Rocke im Hunan-Schnitte schauten rote Füßchen, winzig wie Mandarinenenten, hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
