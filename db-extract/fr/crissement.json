                ],
                "senses": [
                    {
                        "sense_id": "c9b4f94d-c7df-3b7d-98d8-f8dbe000e235",
                        "entry_id": "698c7e98-7362-3d97-b340-4cd2c6e115cd",
                        "glosses": [
                            "Action des dents qui crissent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6f2a3949-33b2-3290-8ed1-20a062f4502b",
                        "entry_id": "698c7e98-7362-3d97-b340-4cd2c6e115cd",
                        "glosses": [
                            "Grincement aigu et soutenu que font des corps en frottement."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "fbb7a6d0-54d9-4e3b-b398-50f46ae005b6",
                                "sense_id": "6f2a3949-33b2-3290-8ed1-20a062f4502b",
                                "text": "Des clappements, des crissements et d’étranges grincements rythmiques s’éveillaient, aussitôt que l’intrépide pédaleur avait fait quelques tours de roue."
                            },
                            {
                                "example_id": "d10df995-f217-43ad-8d95-060c23dd0e40",
                                "sense_id": "6f2a3949-33b2-3290-8ed1-20a062f4502b",
                                "text": "La place de la Nation […] s’ouvrait à tous les vents. Des tramways éclairés et vides y décrivaient, en piaulant sur leurs rails, une courbe laborieuse et quelques rares taxis, ralentissant l’allure, répondaient du crissement brutal des freins."
                            },
                            {
                                "example_id": "18b47dd1-4476-493c-8656-8d1f21678b19",
                                "sense_id": "6f2a3949-33b2-3290-8ed1-20a062f4502b",
                                "text": "Le châssis grinça encore, puis, dans un crissement horripilant, le levier joua et la roue trembla et retomba dans l'eau dans un fracas tonitruant."
                            }
                        ]
                    },
                    {
                        "sense_id": "954b766a-6664-340e-ac7c-1825792270bb",
                        "entry_id": "698c7e98-7362-3d97-b340-4cd2c6e115cd",
                        "glosses": [
                            "Bruit que fait le grillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356f5302-8b89-4de6-ace2-22aa095459b5",
                                "sense_id": "954b766a-6664-340e-ac7c-1825792270bb",
                                "text": "La fête finie, la foule se disperse, et le silence est si grand qu’il permet d’entendre le crissement des grillons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c42d554-fd0c-44b9-9412-79e2de56d385",
