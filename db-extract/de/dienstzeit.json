                ],
                "senses": [
                    {
                        "sense_id": "b9a3ae0e-68ee-39ea-a6ba-c2708b19cbc2",
                        "entry_id": "b53cb72a-ac7f-36ad-9216-7f2fdf70c8ac",
                        "glosses": [
                            "Zeitraum an einem Tag, an dem gearbeitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc92c8a-9fbd-4475-88ea-8433aadf56da",
                                "sense_id": "b9a3ae0e-68ee-39ea-a6ba-c2708b19cbc2",
                                "text": "„Das dauerte von elf Uhr vormittags bis fünf Minuten vor viertel zwölf. Damit war seine Dienstzeit beendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "10b3e693-c79e-34d7-a911-c483c83d5047",
                        "entry_id": "b53cb72a-ac7f-36ad-9216-7f2fdf70c8ac",
                        "glosses": [
                            "Lebenszeit, während der jemand einer Arbeit nachgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c6d041-7535-4bfc-9489-e58081a1ea3e",
                                "sense_id": "10b3e693-c79e-34d7-a911-c483c83d5047",
                                "text": "„Frolow erhielt im Laufe seiner Dienstzeit sogar zwei Mal eine Auszeichnung für die Erfüllung seiner internationalen Pflicht.“"
                            },
                            {
                                "example_id": "532150b7-796d-43dc-bbfc-40d99907e8e2",
                                "sense_id": "10b3e693-c79e-34d7-a911-c483c83d5047",
                                "text": "„Jüngers politische Einstellung während seiner Pariser Dienstzeit ist grundsätzlich ambivalent, das zeigt folgender Satz, der, auf den Obertitel des Tagebuchkonglomerats zeigend, eine spannungsvolle Identitätsspaltung konstatiert und dabei das romantische Bild des Herzens als mechanisches Werk abwandelt: …“"
                            },
                            {
                                "example_id": "3ccd1f01-50fb-4bc0-b304-b74dfdfbdfd6",
                                "sense_id": "10b3e693-c79e-34d7-a911-c483c83d5047",
                                "text": "„Boris hatte es im Laufe seiner Dienstzeit dank den Bemühungen Anna Michailownas, dank seinen eigenen guten Formen und dank der Eigenart seines Charakters – kluger Zurückhaltung – verstanden, sich eine in jeder Hinsicht hervorragende dienstliche Stellung zu verschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
