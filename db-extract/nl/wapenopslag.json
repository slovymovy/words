                "senses": [
                    {
                        "sense_id": "b8aa8008-df34-39b9-b7a2-75cf5eeff557",
                        "entry_id": "7df24c92-40ae-319e-8c61-b4ab2f005845",
                        "glosses": [
                            "ruimte waarin men wapens herbergt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c7885bf-496a-4e1c-842e-37a4465efd33",
                                "sense_id": "b8aa8008-df34-39b9-b7a2-75cf5eeff557",
                                "text": "Maar wat nou als daar precies op dit moment de nieuwe NSIJ wordt geformeerd? Bier en sterkedrank op campingstoelen en een reusachtige wapenopslag in het woonhuis."
                            },
                            {
                                "example_id": "d5014dd4-dc5f-494e-b439-c1351d36fb45",
                                "sense_id": "b8aa8008-df34-39b9-b7a2-75cf5eeff557",
                                "text": "Onder meer twee brandstofdepots, een wapenopslag en een staalfabriek die dient als militaire basis zijn getroffen, vermoedelijk door artillerie. De explosies veroorzaken volgens het Britse ministerie van Defensie onrust onder de Russische militairen. Door de Russen werd aangenomen dat de stad buiten bereik van de Oekraïense artillerie lag."
                            },
                            {
                                "example_id": "b7a60d94-458d-40fd-ae39-cff799015381",
                                "sense_id": "b8aa8008-df34-39b9-b7a2-75cf5eeff557",
                                "text": "De ongeregeldheden begonnen gistermorgen toen opstandige militairen het vuur openden bij de belangrijkste kazerne van de hoofdstad. Vermoedelijk wilde ze doordringen tot de wapenopslag. Er brak een vuurgevecht uit met de beveiliging dat zo'n twee uur duurde. Uiteindelijk sloegen de aanvallers op de vlucht."
                            }
                        ]
                    }
