                        "target_lang_word": "Intergeschlechtlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intergeschlechtlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18cf148e-f99c-3b01-9044-b34655f1076c",
                                        "entry_id": "0e7876e4-0204-31a7-beea-2e4611cea74f",
                                        "glosses": [
                                            "das Auftreten sowohl von männlichen als auch von weiblichen Geschlechtsmerkmalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa4fdbc-0edf-41dd-9a30-d2cc0b0f7469",
                                                "sense_id": "18cf148e-f99c-3b01-9044-b34655f1076c",
                                                "text": "„Intergeschlechtlichkeit wird gegenwärtig sowohl im familiären als auch im gesellschaftlichen Kontext häufig als Tabuthema behandelt, über das ›man‹ nicht spricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "539c978d-ef4b-4b01-bb80-a1da8b11ec7a",
                        "source_entry_id": "a6a3b6a5-7890-3cb7-a544-3a731609ca06",
                        "source_sense_id": "47969053-8230-3c6b-a561-14dde9b80ed9",
                        "source_sense_description": "the state of having physical features of both sexes",
                        "target_lang_word": "Zwischengeschlechtlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwischengeschlechtlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                                        "glosses": [
                                            "das Auftreten sowohl von männlichen als auch von weiblichen Geschlechtsmerkmalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b0a4295-4a18-4ede-a13f-fd8fbacc9b08",
                                                "sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                                                "text": "„Hinter dem Begriff Intersexualität oder Zwischengeschlechtlichkeit verbergen sich viele unterschiedliche Phänomene nicht eindeutiger Geschlechtszugehörigkeit mit jeweils verschiedenen Ursachen.“"
                                            },
                                            {
                                                "example_id": "37cf9313-4cec-422a-8a7c-f3ecc75058e5",
                                                "sense_id": "ae0f4030-581d-3a12-b7ab-64089b7b6a0e",
                                                "text": "„In der Kirche ist Intersexualität indes kein Thema. Noch nicht. Es gibt keine lehramtlichen Aussagen über die Zwischengeschlechtlichkeit und im theologischen Standardwerk, dem Lexikon für Theologie und Kirche, findet man zwar Einträge zu Homosexualität und Transsexualismus, einen Eintrag unter dem Stichwort Intersexualität sucht man jedoch vergebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                        "entry_id": "fb6c9e33-77a1-3cf1-8125-6fdd83af8b25",
                                        "glosses": [
                                            "weder dem weiblichen noch dem männlichen Geschlecht zuordenbare Geschlechtsidentität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6f78674-ff2f-48cd-b40a-6fb32bba484d",
                                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                                "text": "„Das OLG Frankfurt weitet nun über das AGG das Recht auf ‚korrekte Ansprache‘ auf das Privatrechtsverhältnis aus. Dabei stellt das Gericht nicht auf das ‚Geschlecht‘ im Sinne des Personenstandsgesetzes (PStG) ab, sondern die Geschlechtsidentität im Fall der Zwischengeschlechtlichkeit.“"
                                            },
                                            {
                                                "example_id": "36489678-d0c6-4c8f-9e48-abcfd836d4f9",
                                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                                "text": "„Sich nicht komplett männlich zu fühlen oder Anteile anderer Geschlechter an sich wahrzunehmen, ist also gar nicht so selten. Bei Demiboys ist diese Zwischengeschlechtlichkeit nur eindeutiger ausgeprägt bzw. sie möchten diese unterschiedlichen Geschlechtsidentitäten auch gerne nach außen tragen und ihr Geschlechtsempfinden individuell gestalten.“"
                                            },
                                            {
                                                "example_id": "307c1ae4-b2e9-409d-8b9b-0ac013d87f6c",
                                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                                "text": "„Zwischengeschlechtlichkeit umfasst verschiedene Selbstdefinitionen und Lebensweisen zwischen den üblichen zwei Geschlechtern bzw. jenseits davon.“"
                                            },
                                            {
                                                "example_id": "9d2c7ea9-57c3-4eeb-a0a6-7bdfcd0880e0",
                                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                                "text": "„Fachleute sprechen von nicht-binär, wenn ein Mensch weder ausschließlich männlich noch weiblich ist. Ein anderer Begriff für die Zwischengeschlechtlichkeit ist divers.“"
                                            },
                                            {
                                                "example_id": "f3954166-b19b-4290-a3d8-a694b625a5c0",
                                                "sense_id": "695c6c4c-a256-3325-9c4a-282848930f5c",
                                                "text": "„Dieser iterative Prozess, der das Soziale durchzieht und (re)produziert, schafft geschlechtliche, binäre Subjekte und sondert intelligible Zwischenformen rigoros aus. Zwischengeschlechtlichkeit wird als sozial nicht lesbar verworfen, eliminiert oder diskriminiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
