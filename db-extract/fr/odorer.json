                ],
                "senses": [
                    {
                        "sense_id": "a14ed890-3080-38ca-98fd-bb26ac5156d2",
                        "entry_id": "3ce647c4-f64f-3b0a-87dc-a5dc0927b350",
                        "glosses": [
                            "Avoir de l’odorat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acefe19c-02e3-4943-b092-fee283ad2cba",
                                "sense_id": "a14ed890-3080-38ca-98fd-bb26ac5156d2",
                                "text": "Tous les animaux n’odorent pas, mais tous respirant, l’air est nécessaire à leur existence."
                            }
                        ]
                    },
                    {
                        "sense_id": "9157210b-997f-36f4-a18d-21c655cc7688",
                        "entry_id": "3ce647c4-f64f-3b0a-87dc-a5dc0927b350",
                        "glosses": [
                            "Flairer, sentir par l’odorat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d92f4b6b-a91f-4dfe-b254-badd86f61018",
                                "sense_id": "9157210b-997f-36f4-a18d-21c655cc7688",
                                "text": "Et Dieu a odoré et reçu l’odeur du sacrifice."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3576ba1-813e-3697-8eb4-dc3def10ba84",
                        "entry_id": "3ce647c4-f64f-3b0a-87dc-a5dc0927b350",
                        "glosses": [
                            "Exhaler une odeur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f3eb0a3-a901-4d36-b14f-7be395d494db",
                        "source_entry_id": "3ce647c4-f64f-3b0a-87dc-a5dc0927b350",
                        "target_lang_word": "обонять",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обонять",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3839640f-42e6-3b6b-9d8a-b3de5efb9143",
                                        "entry_id": "9bb3689b-f70a-342d-9e05-58e8bdf3f4fd",
                                        "glosses": [
                                            "книжн. ощущать запах чего-либо; воспринимать обонянием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f707234b-e4b5-4b15-9344-486e57cc6bb4",
                                                "sense_id": "3839640f-42e6-3b6b-9d8a-b3de5efb9143",
                                                "text": "Очи видят, уши слышат, язык вкушает, нос обоняет, осязание распростерто по всей поверхности тела."
                                            },
                                            {
                                                "example_id": "e7ce78f2-36ee-486c-ab17-60e2e8703717",
                                                "sense_id": "3839640f-42e6-3b6b-9d8a-b3de5efb9143",
                                                "text": "Здешнее общество имеет свой запах, а свойство запаха, как вам известно, нельзя объяснить человеку, который никогда его не обонял."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383f7951-7a05-3f83-aab5-f3c6095b4691",
                                        "entry_id": "9bb3689b-f70a-342d-9e05-58e8bdf3f4fd",
                                        "glosses": [
                                            "перен. воспринимать приметы, признаки или черты чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb23aad4-dcda-4645-a79d-0b22dcdba7dd",
                                                "sense_id": "383f7951-7a05-3f83-aab5-f3c6095b4691",
                                                "text": "Несмотря на свою тогдашнюю молодость и неопытность, я во всем этом обонял какой-то противный букет взятки, смешанной с кичливой заносчивостью и внутренним ничтожеством."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
