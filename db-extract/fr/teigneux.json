                    {
                        "form_id": "7a2943c2-5541-4805-8579-f0b8514f0250",
                        "entry_id": "dd3c0131-85c2-3165-aa54-23b5c158e8d2",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "teigneuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d77111e2-788c-311d-98d9-1ea856ad7977",
                        "entry_id": "dd3c0131-85c2-3165-aa54-23b5c158e8d2",
                        "glosses": [
                            "Qui a la teigne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "940041dd-f076-4835-ac4a-8613ff2387f5",
                                "sense_id": "d77111e2-788c-311d-98d9-1ea856ad7977",
                                "text": "Nous avons tué le chien teigneux."
                            },
                            {
                                "example_id": "dbfcd126-78fd-460e-8496-30cff63b7823",
                                "sense_id": "d77111e2-788c-311d-98d9-1ea856ad7977",
                                "text": "Murillo lui-même donne souvent à ses saints des mines patibulaires, et, dans son beau tableau de Sainte Elisabeth, l'enfant teigneux et le mendiant qui a un ulcère à la jambe inspirent trop d’horreur pour laisser de la place à l’admiration."
                            }
                        ]
                    },
                    {
                        "sense_id": "879b8769-bff4-30fe-a46c-b88679d02e94",
                        "entry_id": "dd3c0131-85c2-3165-aa54-23b5c158e8d2",
                        "glosses": [
                            "Dont on ne peut pas se débarrasser à cause de sa persévérance."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "485b737e-a545-4971-84d0-c85a56b15820",
                                "sense_id": "879b8769-bff4-30fe-a46c-b88679d02e94",
                                "text": "J’apprécie que Greta Thunberg, cette jeune fille qui emmerde les vieux cons, incarne l’urgence écologique. Elle est teigneuse et c’est tant mieux."
                            },
                            {
                                "example_id": "f99316ea-3f7f-4c16-b990-cc23f96e616b",
                                "sense_id": "879b8769-bff4-30fe-a46c-b88679d02e94",
                                "text": "Sans talent, mais teigneux, c’est le genre d’homme à la recherche d’un dérapage à dénoncer."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bb36131-0746-3d7b-a760-b35799326461",
                        "entry_id": "dd3c0131-85c2-3165-aa54-23b5c158e8d2",
                        "glosses": [
                            "Méchant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeed8c20-099c-4e2b-a92a-1482ce2ec474",
                                "sense_id": "1bb36131-0746-3d7b-a760-b35799326461",
                                "text": "J’aurais pu réagir par la colère, la hargne. Je ne suis pas un teigneux."
                            },
                            {
                                "example_id": "dff1068b-927a-4e86-a649-8a77fba229a0",
                                "sense_id": "1bb36131-0746-3d7b-a760-b35799326461",
                                "text": "Arrêter les gens de son quartier, c’est rien teigneux !"
                            },
                            {
                                "example_id": "f910cdb1-b62b-4a8b-80d5-6f5848f359d7",
                                "sense_id": "1bb36131-0746-3d7b-a760-b35799326461",
                                "text": "Nous survolâmes de petites vagues teigneuses, à la crête blanche, qui disparaissaient à peine nées."
                            }
                        ]
                    }
                ],
