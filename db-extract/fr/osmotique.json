                "senses": [
                    {
                        "sense_id": "9ee7e9c2-dec4-3493-818e-05f271227d4b",
                        "entry_id": "3991bdda-b84f-3ca4-9f65-2cb9282c51db",
                        "glosses": [
                            "Relatif à l’osmose."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "6f8eae25-7b42-4346-8841-95617b29717f",
                                "sense_id": "9ee7e9c2-dec4-3493-818e-05f271227d4b",
                                "text": "L’action osmotique du carbonate de potasse et d’autres sels alcalins est affectée d’une manière extraordinaire par la présence du chlorure de sodium …"
                            },
                            {
                                "example_id": "1d2e7030-2471-4114-b143-440ff9143f6e",
                                "sense_id": "9ee7e9c2-dec4-3493-818e-05f271227d4b",
                                "text": "Au Japon, une telle “énergie bleue” existe: le pays vient d’ouvrir sa première centrale à énergie osmotique, la seconde et la plus grande au monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a69fd162-3167-446e-b89e-639f89f4eb49",
                        "source_entry_id": "3991bdda-b84f-3ca4-9f65-2cb9282c51db",
                        "source_sense_id": "9ee7e9c2-dec4-3493-818e-05f271227d4b",
                        "source_sense_description": "Relatif à l’osmose",
                        "target_lang_word": "osmotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osmotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6474e7-606f-39bd-b074-4ea2d6fabbaf",
                                        "entry_id": "35a1a907-74f8-3447-b229-87a33a6bae65",
                                        "glosses": [
                                            "Osmose bewirkend, auf Osmose beruhend, zu ihr gehörend, durch halbdurchlässige Wände gehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea712055-4266-4611-995c-53b5f2b33a7c",
                                                "sense_id": "ea6474e7-606f-39bd-b074-4ea2d6fabbaf",
                                                "text": "Der osmotische Druck bewirkte das Durchwandern der Lösung durch die Zellwand."
                                            },
                                            {
                                                "example_id": "2ea83601-c560-4df4-8c34-f2b0421038ca",
                                                "sense_id": "ea6474e7-606f-39bd-b074-4ea2d6fabbaf",
                                                "text": "„Der Hirndruck war durch Verabreichung osmotisch wirksamer Substanzen großteils parallel zum mittleren arteriellen Blutdruck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1951ba5-875a-4f19-86dd-c7ff666ff4e3",
                        "source_entry_id": "3991bdda-b84f-3ca4-9f65-2cb9282c51db",
