                        "glosses": [
                            "met de benen uit elkaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "590b5c6e-37c0-4697-814d-ce6c50c18452",
                                "sense_id": "378613ba-7074-3a9d-a15d-b979b59b4bca",
                                "text": "De jongen probeert, zonder succes, met zijn schrijlingse houding indruk te maken op de politieagent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48c3386c-4689-49a8-a6d0-2c5b17181aa8",
                        "source_entry_id": "9809259c-601d-3629-bfd2-0e0e28bde3e5",
                        "source_sense_id": "378613ba-7074-3a9d-a15d-b979b59b4bca",
                        "source_sense_description": "wijdbeens",
                        "target_lang_word": "rittlings",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rittlings",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1bc0d4e-01c7-33ae-8af1-393ccdf1c9d7",
                                        "entry_id": "7968b234-c1e7-365b-928c-085c842baa12",
                                        "glosses": [
                                            "wie ein Reiter sitzend, in der Haltung eines Reiters, aber verkehrt herum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8156b067-60e7-4ae7-b328-e998fc04c35f",
                                                "sense_id": "f1bc0d4e-01c7-33ae-8af1-393ccdf1c9d7",
                                                "text": "„Anstatt jedoch wie gewohnt in mich einzudringen, zog er mich näher an sich, hob meinen Körper etwas an, ohne daß ich mich versah, so daß ich rittlings auf ihm saß und er mich, tief in mich hineinstoßend, bis an die Grenzen meines Innersten erfüllte.“"
                                            },
                                            {
                                                "example_id": "8d6989f0-923c-4c4c-9317-8c117c12cb36",
                                                "sense_id": "f1bc0d4e-01c7-33ae-8af1-393ccdf1c9d7",
                                                "text": "„Er trat an’s Fenster: was sah er? er sah ein Mägdelein;",
                                                "translation": "Da faßte Kaiser Karl sich gar seltsam in den Bart.“"
                                            },
                                            {
                                                "example_id": "a9c7657d-a1ba-4a01-9026-ff21ce8c4604",
                                                "sense_id": "f1bc0d4e-01c7-33ae-8af1-393ccdf1c9d7",
                                                "text": "„Er hat sich rittlings auf ihre Knie gesetzt und ihr die Hände um den Hals gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77ba0511-c343-4161-a27e-cdfa9beee246",
                        "source_entry_id": "9809259c-601d-3629-bfd2-0e0e28bde3e5",
