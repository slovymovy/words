                                "target_senses": [
                                    {
                                        "sense_id": "d3e423c3-2a6f-3301-810d-6260f294e932",
                                        "entry_id": "d1ec738d-b6c4-3941-921f-4d6c7be6b4b4",
                                        "glosses": [
                                            "Something that corrects or counteracts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5bc4f30-47bc-31f2-83d2-cdf6d1304ccb",
                                        "entry_id": "d1ec738d-b6c4-3941-921f-4d6c7be6b4b4",
                                        "glosses": [
                                            "The legal means to recover a right or to prevent or obtain redress for a wrong."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a53685a5-6692-3276-b72a-de433c276902",
                                        "entry_id": "d1ec738d-b6c4-3941-921f-4d6c7be6b4b4",
                                        "glosses": [
                                            "A medicine, application, or treatment that relieves or cures a disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09b255d0-77e4-408d-9870-f100e3a29c47",
                                                "sense_id": "a53685a5-6692-3276-b72a-de433c276902",
                                                "text": "Beautie alone is a ſoveraigne remedy againſt feare,griefe,and all melancholy fits; a charm,as Peter de la Seine and many other writers affirme,a banquet it ſelfe;he gives inſtance in diſcontented Menelaus that was ſo often freed by Helenas faire face: and ʰTully, 3 Tusc. cites Epicurus as a chiefe patron of this Tenent."
                                            },
                                            {
                                                "example_id": "eeefb302-2cd6-48b7-93a9-be84197ba536",
                                                "sense_id": "a53685a5-6692-3276-b72a-de433c276902",
                                                "text": "1856: Gustave Flaubert, Madame Bovary, Part III Chapter X, translated by Eleanor Marx-Aveling\nHe said to himself that no doubt they would save her; the doctors would discover some remedy surely. He remembered all the miraculous cures he had been told about. Then she appeared to him dead. She was there; before his eyes, lying on her back in the middle of the road. He reined up, and the hallucination disappeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768d4364-5716-3027-ac4e-6d6cad09effd",
                                        "entry_id": "d1ec738d-b6c4-3941-921f-4d6c7be6b4b4",
                                        "glosses": [
                                            "The accepted tolerance or deviation in fineness or weight in the production of gold coins etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "remedy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a65045-c8ec-3de9-896a-732864dbe51d",
                                        "entry_id": "cae53571-fb8b-3e29-beb7-04336d9fb63f",
                                        "glosses": [
                                            "To provide or serve as a remedy for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a57d9c7a-f1e1-4239-b1f1-3193aa717a7c",
                                                "sense_id": "15a65045-c8ec-3de9-896a-732864dbe51d",
                                                "text": "Nor is geometry, when taken into the assistance of natural philosophy, ever able to remedy this defect,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "369334ae-cb5f-408c-abd4-e67db9ca28f3",
                        "source_entry_id": "f5cb4e61-00cc-3e85-9cc1-cc7c6d2ae025",
                        "source_sense_id": "b57ecc1d-9fde-3752-b6e0-9132bc506cbb",
                        "source_sense_description": "veraltet: Abhilfe; Beseitigung einer Belastung, eines Missstandes",
                        "target_lang_word": "remède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9dca1dc-0995-34c4-92e1-f54d8d965a4a",
                                        "entry_id": "81a62d2d-c60e-32d1-bb88-10f602934040",
                                        "glosses": [
                                            "Substance qui sert à guérir un mal ou une maladie ; médicament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24abacd9-657e-4384-968a-e14dc9698763",
                                                "sense_id": "a9dca1dc-0995-34c4-92e1-f54d8d965a4a",
                                                "text": "Le suc d'une certaine plante appelée par les Caraïbes touloula, et par les Français herbes aux flèches, est, dit-on, le seul remède contre les plaies faites par les flèches empoisonnées avec le suc de mancenilier."
                                            },
                                            {
                                                "example_id": "fd2e2f74-9a42-4c55-9218-978e6ac17b3a",
                                                "sense_id": "a9dca1dc-0995-34c4-92e1-f54d8d965a4a",
                                                "text": "Ce fut M. de Chalvet-Rochemonteix qui apprit aux paysans à se prémunir contre les ravages de la carie dans les grains par le sulfatage de la semence, dont les résultats furent souverains. Le mal cessa avec l’application de ce remède."
                                            },
                                            {
                                                "example_id": "5940fdcb-d399-413d-a895-5276b8631125",
                                                "sense_id": "a9dca1dc-0995-34c4-92e1-f54d8d965a4a",
                                                "text": "Et, s’il acceptait qu’on le soignât, il refusait rudement tout remède, dans le doute où il était tombé de la médecine."
                                            },
                                            {
                                                "example_id": "42b6ab4d-1bd9-4c29-8117-08c65f3fa23d",
                                                "sense_id": "a9dca1dc-0995-34c4-92e1-f54d8d965a4a",
                                                "text": "LA NERVOSITÉ est peut-être bien l'un des maux les plus tourmentables qui frappent l'humanité. Des milliers de remèdes ont déjà été recommandés mais toujours avec peu de succès. — (V. Pitteloud, Sion, dans Journal et Feuille d'avis du Valais, samedi 19 juin 1909, page 1)"
                                            },
                                            {
                                                "example_id": "0e202f64-50d6-4501-b676-79348cfd4d3e",
                                                "sense_id": "a9dca1dc-0995-34c4-92e1-f54d8d965a4a",
                                                "text": "Malgré cette alerte, il guérit et le morticole pontifia, proclamant à qui voulait l'entendre qu'il avait découvert le remède héroïque contre la fièvre typhoïde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "301fe710-04a8-3c9e-a2e0-a0bbc62635c2",
                                        "entry_id": "81a62d2d-c60e-32d1-bb88-10f602934040",
                                        "glosses": [
                                            "Ce qui sert à guérir les maladies de l’âme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cbfec97-38f5-45ef-9ae4-6994d398f125",
                                                "sense_id": "301fe710-04a8-3c9e-a2e0-a0bbc62635c2",
                                                "text": "C'eſt, luy dit-on, Peau d'Aſne, en rien nymphe ni belle, et que Peau d'Aſne l'on appelle, à cauſe de la peau qu'elle met ſur ſon cou ; de l'amour c'eſt le vray remède, la beſte en un mot la plus laide, qu'on puiſſe voir après le loup."
                                            },
                                            {
                                                "example_id": "7270bf36-e99f-41c2-93db-2badbd41a83c",
                                                "sense_id": "301fe710-04a8-3c9e-a2e0-a0bbc62635c2",
                                                "text": "De tous les passagers, le plus amusant est sans contredit un bon bourgeois de Glasgow qui cherche dans les voyages un remède au spleen que lui cause le climat pluvieux de son pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                        "entry_id": "81a62d2d-c60e-32d1-bb88-10f602934040",
                                        "glosses": [
                                            "Ce qui sert à prévenir, surmonter ou faire cesser un malheur, un inconvénient ou une disgrâce."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "548247f5-08d9-4abd-b03c-f740c3d6a1d6",
                                                "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                                "text": "La sagesse est un remède contre les accidents de la vie."
                                            },
                                            {
                                                "example_id": "8974ef95-20fe-4021-b8a6-86b13542a5fc",
                                                "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                                "text": "Il n’est pas impossible de trouver quelque remède au malheur dont vous êtes menacé."
                                            },
                                            {
                                                "example_id": "56a6bdad-4973-4c04-9042-f4ffc6fb3a00",
                                                "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                                "text": "Son malheur est sans remède."
                                            },
                                            {
                                                "example_id": "62d0786b-2541-429a-a71e-3af47c5fa2db",
                                                "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                                "text": "Voyons s’il n’y a pas quelque remède à la perte de votre procès."
                                            },
                                            {
                                                "example_id": "465dc8f3-db7f-4a2c-adae-045883b6e2f9",
                                                "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                                "text": "On ne saurait apporter du remède à tous les maux."
                                            },
                                            {
                                                "example_id": "f35873aa-aca2-4991-af2c-cda0b78a011f",
                                                "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                                "text": "Le mal est fait, il n’y a plus de remède."
                                            },
                                            {
                                                "example_id": "feae66e4-0da9-4df6-9cdb-02ecca818b0d",
                                                "sense_id": "2e662095-a44f-3a64-8d4e-42c05a279d13",
                                                "text": "Non seulement cela, [Samuel Huntington] a tourné le dos à la ligne d’Al Smith. Al Smith disait : « Le remède à la démocratie est plus de démocratie ». Il a déclaré : « Non, le remède à cette démocratie est moins de démocratie »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21aeb41-4a92-3be3-bafb-334a727b96e6",
                                        "entry_id": "81a62d2d-c60e-32d1-bb88-10f602934040",
                                        "glosses": [
                                            "Lavement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d01ae789-8870-4dce-b220-127e75d7565e",
                                                "sense_id": "a21aeb41-4a92-3be3-bafb-334a727b96e6",
                                                "text": "Rendre un remède."
                                            },
                                            {
                                                "example_id": "b272847e-4774-4248-b348-a3f0372ee050",
                                                "sense_id": "a21aeb41-4a92-3be3-bafb-334a727b96e6",
                                                "text": "Prendre un remède."
                                            },
                                            {
                                                "example_id": "b6648364-bf68-4499-97f6-70ca46c8d48b",
                                                "sense_id": "a21aeb41-4a92-3be3-bafb-334a727b96e6",
                                                "text": "Garder longtemps un remède."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
