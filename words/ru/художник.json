{
    "word_family": [
        "художество",
        "художественный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63b92326-831b-3c77-b283-fab4c8a4fc82",
                    "sense_definition": "Человек, занимающийся изобразительным искусством, создающий картины или рисунки.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Знакомый <w>художник</w> написал картину с этой фотографии.",
                            "target_lang_translations": {
                                "de": "Ein bekannter <w>Maler</w> hat nach diesem Foto ein Bild gemalt."
                            }
                        },
                        {
                            "text": "Очень хороший армянский <w>художник</w> рисовал мой портрет.",
                            "target_lang_translations": {
                                "de": "Ein sehr guter armenischer <w>Künstler</w> hat mein Porträt gezeichnet."
                            }
                        }
                    ],
                    "synonyms": [
                        "артист"
                    ],
                    "antonyms": [
                        "ремесленник"
                    ],
                    "common_phrases": [
                        "талантливый художник",
                        "молодой художник"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die bildende Kunst ausübt und Bilder oder Zeichnungen anfertigt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Maler",
                                "target_lang_sense_clarification": "Künstler, der Bilder malt"
                            },
                            {
                                "target_lang_word": "Künstler",
                                "target_lang_sense_clarification": "Person, die Kunstwerke erschafft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6a87ddd-1ef3-3baf-a786-b2284b6736f6",
                    "sense_definition": "Творец, создающий произведения искусства, вкладывающий в них мастерство и вдохновение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Великий <w>художник</w> Рафаэль испустил дух подобным образом.",
                            "target_lang_translations": {
                                "de": "Der große <w>Künstler</w> Raffael hauchte auf ähnliche Weise sein Leben aus."
                            }
                        },
                        {
                            "text": "Настоящий <w>художник</w> всегда ищет новые способы выражения своих чувств.",
                            "target_lang_translations": {
                                "de": "Ein wahrer <w>Künstler</w> sucht immer nach neuen Wegen, seine Gefühle auszudrücken."
                            }
                        }
                    ],
                    "common_phrases": [
                        "душа художника"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Schöpfer, der Kunstwerke mit handwerklichem Geschick und Inspiration erschafft."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Künstler",
                                "target_lang_sense_clarification": "Mensch mit einer besonderen Begabung oder kreativen Vision"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}