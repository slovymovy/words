{
    "word_family": [
        "vary",
        "variable",
        "variation",
        "variance",
        "varied",
        "variety"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c85e5f25-d222-3c63-9698-e21704f2e4e5",
                    "sense_definition": "A form or version of something that differs in some respect from other forms of the same thing or from a standard.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company released a cheaper <w>variant</w> of its flagship smartphone this month.",
                            "target_lang_translations": {
                                "ru": "В этом месяце компания выпустила более дешёвый <w>вариант</w> своего флагманского смартфона."
                            }
                        },
                        {
                            "text": "All breeds of domestic dog are biological <w>variants</w> of the same species.",
                            "target_lang_translations": {
                                "ru": "Все породы домашних собак являются биологическими <w>разновидностями</w> одного и того же вида."
                            }
                        }
                    ],
                    "synonyms": [
                        "variation",
                        "version",
                        "adaptation"
                    ],
                    "common_phrases": [
                        "genetic variant",
                        "cheaper variant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма или версия чего-либо, отличающаяся в некоторых аспектах от других форм того же объекта или от стандарта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "версия, разновидность"
                            },
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "модификация, тип"
                            },
                            {
                                "target_lang_word": "модификация",
                                "target_lang_sense_clarification": "техническая версия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a020c5e5-1463-3299-a243-a7ae8caf2ffd",
                    "sense_definition": "A biological strain, gene sequence, or virus that differs slightly from the original or standard form.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are monitoring a new <w>variant</w> of the virus that spreads more rapidly.",
                            "target_lang_translations": {
                                "ru": "Учёные отслеживают новый <w>штамм</w> вируса, который распространяется быстрее."
                            }
                        },
                        {
                            "text": "Health officials confirmed that the current vaccine offers protection against this latest <w>variant</w>.",
                            "target_lang_translations": {
                                "ru": "Представители органов здравоохранения подтвердили, что текущая вакцина обеспечивает защиту от этого последнего <w>варианта</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "strain",
                        "mutation"
                    ],
                    "common_phrases": [
                        "virus variant",
                        "new variant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Биологический штамм, генетическая последовательность или вирус, слегка отличающийся от исходной или стандартной формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "генетический или вирусный"
                            },
                            {
                                "target_lang_word": "штамм",
                                "target_lang_sense_clarification": "вируса или бактерии"
                            },
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "биологическая линия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4355311-59fb-33f1-a63a-0cce6a57a1da",
                    "sense_definition": "One of two or more alternative spellings, pronunciations, or word forms with the same meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word grey is a spelling <w>variant</w> of gray commonly used in British English.",
                            "target_lang_translations": {
                                "ru": "Слово grey — это орфографический <w>вариант</w> слова gray, обычно используемый в британском английском."
                            }
                        },
                        {
                            "text": "The dictionary lists several dialectal <w>variants</w> for this regional idiom.",
                            "target_lang_translations": {
                                "ru": "В словаре приведено несколько диалектных <w>вариантов</w> этой региональной идиомы."
                            }
                        }
                    ],
                    "synonyms": [
                        "alternate"
                    ],
                    "common_phrases": [
                        "spelling variant",
                        "lexical variant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из нескольких вариантов написания, произношения или грамматических форм слова с одинаковым значением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "написания, произношения или формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b57d425-9d8e-3438-ad14-e4d8061bcdb4",
                    "sense_definition": "A data type or variable capable of storing values of different, unrelated types.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer declared a <w>variant</w> to hold either an integer or a string.",
                            "target_lang_translations": {
                                "ru": "Программист объявил <w>вариантную переменную</w>, чтобы хранить либо целое число, либо строку."
                            }
                        },
                        {
                            "text": "Using a dynamic <w>variant</w> can reduce type safety if not handled with care.",
                            "target_lang_translations": {
                                "ru": "Использование динамического <w>вариантного типа</w> может снизить типобезопасность, если обращаться с ним неосторожно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "variant type"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип данных или переменная, способная хранить значения различных, не связанных между собой типов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "тип Variant в программировании"
                            },
                            {
                                "target_lang_word": "вариантный тип",
                                "target_lang_sense_clarification": "динамический тип данных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ee89748d-0caa-3948-b17c-f14cbf646c9e",
                    "sense_definition": "Differing from others of the same kind or from a standard form; variable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars compared <w>variant</w> readings found in early medieval manuscripts.",
                            "target_lang_translations": {
                                "ru": "Учёные сравнили <w>вариантные</w> прочтения, обнаруженные в раннесредневековых рукописях."
                            }
                        },
                        {
                            "text": "The recipe has several <w>variant</w> forms depending on the country or region.",
                            "target_lang_translations": {
                                "ru": "У этого рецепта есть несколько <w>альтернативных</w> форм в зависимости от страны или региона."
                            }
                        }
                    ],
                    "synonyms": [
                        "alternative",
                        "differing",
                        "divergent"
                    ],
                    "antonyms": [
                        "standard",
                        "uniform"
                    ],
                    "common_phrases": [
                        "variant form",
                        "variant reading",
                        "variant spelling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличающийся от других объектов того же рода или от стандартной формы; вариативный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариантный",
                                "target_lang_sense_clarification": "отличающийся от стандарта"
                            },
                            {
                                "target_lang_word": "альтернативный",
                                "target_lang_sense_clarification": "другой, иной"
                            },
                            {
                                "target_lang_word": "различный",
                                "target_lang_sense_clarification": "отличающийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cbe89d4-96ea-3600-bc5c-e1cda931ae15",
                    "sense_definition": "Exhibiting variety or diversity; diverse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden displayed flowers of <w>variant</w> colors throughout the summer.",
                            "target_lang_translations": {
                                "ru": "В саду всё лето цвели цветы самых <w>разнообразных</w> оттенков."
                            }
                        },
                        {
                            "text": "The committee reviewed the <w>variant</w> opinions voiced during the public consultation.",
                            "target_lang_translations": {
                                "ru": "Комитет рассмотрел <w>различные</w> мнения, высказанные в ходе общественных консультаций."
                            }
                        }
                    ],
                    "synonyms": [
                        "diverse",
                        "various",
                        "manifold"
                    ],
                    "antonyms": [
                        "identical",
                        "uniform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий разнообразие; многообразный, неоднородный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнообразный",
                                "target_lang_sense_clarification": "неоднородный"
                            },
                            {
                                "target_lang_word": "различный",
                                "target_lang_sense_clarification": "многообразный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1596ac25-2c84-31c8-98d6-1635f68d0d7f",
                    "sense_definition": "Showing deviation, difference, or disagreement from an established standard or expectation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His actions were markedly <w>variant</w> from the traditional customs of the community.",
                            "target_lang_translations": {
                                "ru": "Его поступки заметно <w>отклонялись</w> от традиционных обычаев общины."
                            }
                        },
                        {
                            "text": "The newly observed results were strikingly <w>variant</w> with prior scientific predictions.",
                            "target_lang_translations": {
                                "ru": "Вновь полученные результаты разительно <w>расходились</w> с предшествующими научными предсказаниями."
                            }
                        }
                    ],
                    "synonyms": [
                        "deviant",
                        "anomalous",
                        "divergent"
                    ],
                    "antonyms": [
                        "conforming",
                        "consistent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняющийся от установленного стандарта, нормы или ожиданий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклоняющийся",
                                "target_lang_sense_clarification": "от нормы или стандарта"
                            },
                            {
                                "target_lang_word": "несогласующийся",
                                "target_lang_sense_clarification": "противоречащий ожиданиям"
                            },
                            {
                                "target_lang_word": "расходящийся",
                                "target_lang_sense_clarification": "отличающийся от принятого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a85800a6-8a52-33ae-94db-ddc33c15bab7",
                    "sense_definition": "Relating to transformation properties that are covariant or contravariant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematical theory deals with <w>variant</w> vectors under coordinate changes.",
                            "target_lang_translations": {
                                "ru": "Математическая теория рассматривает <w>вариантные</w> векторы при преобразованиях координат."
                            }
                        },
                        {
                            "text": "They studied the <w>variant</w> indices of the tensor under affine transformations.",
                            "target_lang_translations": {
                                "ru": "Они исследовали <w>вариантные</w> индексы тензора при аффинных преобразованиях."
                            }
                        }
                    ],
                    "antonyms": [
                        "invariant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к свойствам преобразования, являющимся ковариантными или контравариантными (в математике)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариантный",
                                "target_lang_sense_clarification": "о математических объектах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}