                    {
                        "sense_id": "d98aef97-414f-309c-994b-e8de8fb00b81",
                        "entry_id": "2729f494-49cb-3a33-b85b-d3814216e684",
                        "glosses": [
                            "(meist Pilz, Bakterium oder niedere Pflanze), der in einer Pflanze lebt"
                        ],
                        "tags": [
                            "Organismus"
                        ],
                        "examples": [
                            {
                                "example_id": "55c0bd05-1163-407b-aef6-7fcc1777c0bb",
                                "sense_id": "d98aef97-414f-309c-994b-e8de8fb00b81",
                                "text": "Die Verfasser beschreiben den Pilz als Endophyt, der aus der Wirtspflanze Eucryphia cordifolia isoliert wurde und der durch Extrakte aus dieser Pflanzenart im Wachstum gefördert wird."
                            },
                            {
                                "example_id": "b18695a1-3d01-4470-b9f2-82dd8cdfd169",
                                "sense_id": "d98aef97-414f-309c-994b-e8de8fb00b81",
                                "text": "Der Endophyt kann aber auch zu einer reduzierten Biomasse des Grases führen (Faeth et al. 2004)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
