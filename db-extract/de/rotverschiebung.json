                ],
                "senses": [
                    {
                        "sense_id": "c8a6d351-c829-3861-a525-cac9f50e7ecf",
                        "entry_id": "b7eafd75-5eae-3783-83f2-a5f0e94a924c",
                        "glosses": [
                            "die Verlängerung der gemessenen Wellenlänge elektromagnetischer Wellen gegenüber der ursprünglich emittierten Strahlung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "13f53420-1a9a-4184-b840-2b69302b4d07",
                                "sense_id": "c8a6d351-c829-3861-a525-cac9f50e7ecf",
                                "text": "„Dies ermöglicht generell ein weites Einsatzgebiet, insbesondere sollen aber Galaxien untersucht werden, die bereits kurz nach dem Urknall entstanden sind und somit eine hohe Rotverschiebung aufweisen.“"
                            },
                            {
                                "example_id": "0062a333-7ab2-40d7-916a-d6ecdd0a719b",
                                "sense_id": "c8a6d351-c829-3861-a525-cac9f50e7ecf",
                                "text": "„Edwin Hubble konnte 1929 die Expansion des Weltalls nachweisen, da Galaxien mit wachsender Entfernung eine zunehmende Rotverschiebung in den Spektrallinien zeigen“"
                            },
                            {
                                "example_id": "bbb4e5db-822b-436b-bbd1-7f584ae95547",
                                "sense_id": "c8a6d351-c829-3861-a525-cac9f50e7ecf",
                                "text": "„Hieran lasse die Rotverschiebung des Lichtes keinen Zweifel, welches uns von zahlreichen Milchstraßensystemen erreiche, deren Entfernung von uns allenfalls bekannt sei, — die um so stärkere Veränderung der Farbe dieses Lichtes nach dem roten Ende des Spektrums hin, in je größerem Abstand von uns sich diese Nebelflecke befänden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
