                                                "example_id": "0a6731da-0236-4824-8438-19f579ca0fda",
                                                "sense_id": "939a26ef-f005-31f9-8ca4-87495629d346",
                                                "text": "„Oder wirkt ein Gift, das ihm ein bestochener Mundschenk auf Geheiß von Basileios möglicherweise eingeflößt hat?“"
                                            },
                                            {
                                                "example_id": "de06df25-396f-4078-8760-49fdd67c031e",
                                                "sense_id": "939a26ef-f005-31f9-8ca4-87495629d346",
                                                "text": "„Und bei ihrer Hochzeit mit Pole hatte Laurits den Mundschenk gegeben, doch an diesem Morgen erwiderte er kaum ihren Gruß.“"
                                            }
