                    "frequency": "Low",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa décision reposait davantage sur une simple <w>prévision</w> que sur des faits avérés."
                        },
                        {
                            "text": "Il possédait une singulière faculté de <w>prévision</w> qui impressionnait souvent ses collègues."
