                        "examples": [
                            {
                                "example_id": "b48516b0-effc-4997-bd90-f321ad08cac7",
                                "sense_id": "35a97d5b-7dc1-3256-9a25-65688bae56a5",
                                "text": "Dit duinachtige terrein ligt in een gebied dat astronomen Sputnik Planum hebben gedoopt. Mogelijk is het landschap gevormd door vervluchtigend ijs, dat is althans wat de wetenschappers denken na het zien van onderstaande detailfoto."
                            },
