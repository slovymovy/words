                "entry_id": "26da658c-0191-3089-93f3-6e21c9cc7c6a",
                "word": "Spielanfang",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac9a37ed-1680-30e9-9dd0-0b9fcb06b7c5",
                        "entry_id": "26da658c-0191-3089-93f3-6e21c9cc7c6a",
                        "glosses": [
                            "Auftakt, Beginn eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77832197-8ba4-4819-a7e1-e1ea2b36db1c",
                                "sense_id": "ac9a37ed-1680-30e9-9dd0-0b9fcb06b7c5",
                                "text": "„Eine Fabrik entschloß sich zum Streik, als die Fabrikleitung 40 Minuten vor Spielanfang ablehnte, den Arbeitsprozeß zu unterbrechen.“"
                            },
                            {
                                "example_id": "efff8702-9a2b-48da-8aeb-ec89d0f3d98b",
                                "sense_id": "ac9a37ed-1680-30e9-9dd0-0b9fcb06b7c5",
                                "text": "„Der Anblick des Spielanfangs frustriert mich so sehr, dass ich anfange, den Hammer sinnlos in alle Richtungen zu schwingen, ohne damit ansatzweise irgendetwas zu bewirken.“"
                            },
                            {
                                "example_id": "38e0f2bc-cc30-4195-b710-5a68ec45ab3a",
                                "sense_id": "ac9a37ed-1680-30e9-9dd0-0b9fcb06b7c5",
                                "text": "„Dass der Spielanfang nicht der Höhepunkt der Spielkunst war, hat jeder mitgekriegt, sagte er.“"
                            },
                            {
                                "example_id": "aaabdb1a-ab7b-4db9-8939-a319913f08b0",
                                "sense_id": "ac9a37ed-1680-30e9-9dd0-0b9fcb06b7c5",
                                "text": "„Nach ausgeglichenem Spielanfang gerieten wir ab der 20. Minute durch eigene Fehler in einen immer größer werdenden Rückstand.“"
                            },
                            {
                                "example_id": "fa56ce32-5510-4c86-8235-32ec8b907cf0",
                                "sense_id": "ac9a37ed-1680-30e9-9dd0-0b9fcb06b7c5",
                                "text": "„Von Spielanfang bis Spielende muß jedes Zehnpfennigstück Kontakt zu mindestens zwei weiteren Münzen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
