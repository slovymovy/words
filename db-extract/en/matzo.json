                    {
                        "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                        "entry_id": "6ff0013e-87ce-3627-968e-bc53d43f6502",
                        "glosses": [
                            "Thin, unleavened bread in Jewish cuisine."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b25585ed-bb65-4b3c-9f47-498177ca2aa1",
                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                "text": "Matzo is eaten by Jews on Passover."
                            },
                            {
                                "example_id": "3b9d667e-9da5-4e6f-bd96-208552279f76",
                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                "text": "Like the Kopelmans, they have a Christmas tree with dreidel ornaments and a menorah, which they light each night. Pham learned to cook matzo ball soup."
                            }
                        ]
                    },
                    {
                        "sense_id": "9966bc04-b6a8-350b-a8ae-e238d3847118",
                        "entry_id": "6ff0013e-87ce-3627-968e-bc53d43f6502",
                        "glosses": [
                            "A piece of the above bread."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc165574-3cd1-4756-af2a-dec201783dc8",
                                "sense_id": "9966bc04-b6a8-350b-a8ae-e238d3847118",
                                "text": "[W]hen a Hamas spokesman recently stood by his statement that Jews used the blood of non-Jewish children for their matzos – one of the oldest anti-Semitic canards around – European elites were largely silent."
                            }
                        ]
                    }
