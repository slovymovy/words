                "senses": [
                    {
                        "sense_id": "05139294-51c9-321a-8d12-752214308f8a",
                        "entry_id": "dd581f77-6f50-3438-bcbb-8e4d1dd74951",
                        "glosses": [
                            "Stadt im US-Bundesstaat Florida"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5df3c66-8f60-4bdf-8c0c-9eae081895cc",
                                "sense_id": "05139294-51c9-321a-8d12-752214308f8a",
                                "text": "Miami liegt am Miami River."
                            },
                            {
                                "example_id": "a8651e75-fd4a-495c-847a-9779ff933b89",
                                "sense_id": "05139294-51c9-321a-8d12-752214308f8a",
                                "text": "„›Ich möchte, dass sie direkt zum Flughafen fahren und die erste Maschine nach Florida nehmen – egal ob sie nach Miami, Tampa oder Orlando fliegt – und von dort aus nach Lakeland fahren.‹“"
                            },
                            {
                                "example_id": "7bda5837-2b5c-4dd3-9272-46a57f1feb4b",
                                "sense_id": "05139294-51c9-321a-8d12-752214308f8a",
                                "text": "„›Der mutmaßliche Anführer des größten südamerikanischen Drogenkartells ist in seinem Penthaus in Miami tot aufgefunden worden‹, sagt die Stimme.“"
                            },
                            {
                                "example_id": "864b2ae7-abe4-411f-92a5-5d92990d0e03",
                                "sense_id": "05139294-51c9-321a-8d12-752214308f8a",
                                "text": "„In den letzten fünfzehn Jahren war es mehr oder weniger sauber geblieben, eine beachtliche Leistung, verglich man es mit den gleichen Stellen in New York, Philadelphia und Miami.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
