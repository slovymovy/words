                        "translation_id": "db54bc15-ca2b-4e96-a9db-592ce0ed6380",
                        "source_entry_id": "b6d8817b-c53b-3200-b5cb-ff46510e3301",
                        "source_sense_id": "61d0544f-1273-3b33-a159-000f8bc67b25",
