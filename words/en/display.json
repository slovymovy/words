                                "target_lang_word": "表演",
                                "target_lang_sense_clarification": "公开的艺术或技能展示"
                            },
                            {
                                "target_lang_word": "展示",
                                "target_lang_sense_clarification": "公开的呈现活动"
                            }
                        ]
