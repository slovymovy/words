                                    {
                                        "sense_id": "8e53571b-d531-3b16-bd19-850c4be4ad30",
                                        "entry_id": "ec1324e7-b0d8-3a96-be17-704af3552c71",
                                        "glosses": [
                                            "eine lange Lebensdauer besitzend"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5148e398-bafe-4e33-a917-23787c7b3a23",
                                                "sense_id": "8e53571b-d531-3b16-bd19-850c4be4ad30",
                                                "text": "„Hartlaubgewächse sind immergrüne Bäume und Sträucher mit meist lederigen, eingerollten oder nadelförmigen Blättern, welche klein gehalten, steif und ziemlich langlebig sind.“"
                                            },
                                            {
                                                "example_id": "e8e0b422-e5ca-4a9a-a667-59ad3d92b305",
                                                "sense_id": "8e53571b-d531-3b16-bd19-850c4be4ad30",
                                                "text": "„Der Grönlandhai ist das langlebigste Wirbeltier der Welt. Etwa 400 Jahre alt können die […] Fische werden, womöglich noch deutlich älter.“"
                                            },
                                            {
                                                "example_id": "bf5af52e-c4b5-4060-9c57-8d5cbfcc39bd",
                                                "sense_id": "8e53571b-d531-3b16-bd19-850c4be4ad30",
                                                "text": "Die langlebigsten Landsäugetiere sind Menschen: Den Altersrekord hält die Französin Jeanne Louise Calment, die am 4. August 1997 im Alter von 122 Jahren und 164 Tagen starb."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf3eaefc-5e7e-3a3e-8fb8-da10ddb35582",
                                        "entry_id": "ec1324e7-b0d8-3a96-be17-704af3552c71",
                                        "glosses": [
                                            "längerfristig gültig/aktuell"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61abcef8-6eb0-3566-86e8-b392949323c7",
                                        "entry_id": "ec1324e7-b0d8-3a96-be17-704af3552c71",
                                        "glosses": [
                                            "längerfristig haltbar, eine große Strapazierfähigkeit aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "904dcf50-9591-47b1-a9db-1b561a966ed8",
                                                "sense_id": "61abcef8-6eb0-3566-86e8-b392949323c7",
                                                "text": "„So verband man mit Produkten wie dem Volkswagen auf dem Weltmarkt bald endgültig Begriffe wie robust, langlebig, technisch ausgereift.“"
                                            },
                                            {
                                                "example_id": "90c6b240-b9e0-4d44-8e26-bb5a83923c32",
                                                "sense_id": "61abcef8-6eb0-3566-86e8-b392949323c7",
                                                "text": "„Ob eine Waschmaschine langlebig und reparabel ist, habe aber genau genommen mit dem Röhrchen zu tun, sagt Eisenriegler. Denn bei Billigwaschmaschinen würden zuerst diese kaputtgehen, um dann in der Folge das Lager der Waschmaschinen zu zerstören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
