                "senses": [
                    {
                        "sense_id": "e724e40f-eb8b-335c-b30f-ee73b4e7c531",
                        "entry_id": "cbdf42bb-24ee-359a-9f91-caeb8ca60763",
                        "glosses": [
                            "für die westlichen Stadtbezirke von Berlin; die nach dem 2. Weltkrieg von den Vereinigten Staaten, Großbritannien und Frankreich gebildeten Sektoren Berlins bis zur Wiedervereinigung 1990"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "74a6a381-ddf4-4723-ba9e-6b851bde89ce",
                                "sense_id": "e724e40f-eb8b-335c-b30f-ee73b4e7c531",
                                "text": "„Deshalb müsse man auch von West-Berlin in den Osten fahren, und das eben nicht selten, sondern immer wieder, als gäbe es nicht die beschämende Mauer und den Todesstreifen und die Todesschützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
