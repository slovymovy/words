                        "sense_id": "105ce953-f94a-3bab-8a24-2d747cdcba27",
                        "entry_id": "fbbefe9f-16f1-3e9c-9b0d-5cc4e96076cb",
                        "glosses": [
                            "iemand die aan de tegenovergestelde zijde van de wereld leeft"
