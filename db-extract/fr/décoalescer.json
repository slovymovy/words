                        "glosses": [
                            "Faire perdre son caractère coalescé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2813ee38-b1c2-48f6-b260-acfc4e33e609",
                                "sense_id": "a4be5717-28ea-3ff1-bacd-be997de1c1e3",
                                "text": "Cependant, il n’a pas été possible de décoalescer les signaux des formes libres et protonées, même à basse température (- 40 °C)."
                            },
                            {
                                "example_id": "2e0edf76-6146-41f2-9998-5aeccfc074bf",
                                "sense_id": "a4be5717-28ea-3ff1-bacd-be997de1c1e3",
                                "text": "Par l’examen des variations des effets Δ-iso, avec la nature du noyau décoalescé i (fig. 6), nous mettons en évidence un transfert électronique vers l’accepteur, plus important dans un des deux isomères présents, quand la densité électronique du système π s’accroît."
                            }
                        ]
                    }
