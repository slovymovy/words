            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39f4525d-e6b2-3f05-aeba-7235a507f749",
                    "sense_definition": "To hint or suggest something unpleasant indirectly without making a direct statement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>insinuated</w> that her colleagues were responsible for the missing files."
                        },
                        {
                            "text": "Do not <w>insinuate</w> that I am lying about what happened yesterday."
                        }
                    ],
                    "synonyms": [
                        "hint",
                        "imply",
                        "intimate",
                        "suggest"
                    ],
                    "common_phrases": [
