                                        "entry_id": "1b942ea9-6b24-3607-9ec1-ce9b25dd1205",
                                        "glosses": [
                                            "Dermatose provoquée par des champignons ou des levures parasites ou saprophytes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7df6e07-5933-49f8-8c10-eed12597e020",
                                                "sense_id": "33cebf31-371f-37f8-9485-fad8e7682209",
                                                "text": "Les mycoses du poisson sont caractérisées par des croissances duveteuses comme du coton en amas."
                                            },
                                            {
                                                "example_id": "32fe85a4-9efc-472f-a357-c7c819ba4b12",
                                                "sense_id": "33cebf31-371f-37f8-9485-fad8e7682209",
                                                "text": "La mycose, colonisation de la bouche, du vagin, de la peau et/ou de l’intestin par un minuscule champignon, est l’illustration parfaite d’un déséquilibre en faveur de l’acide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
